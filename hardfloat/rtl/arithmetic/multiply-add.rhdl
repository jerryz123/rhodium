#lang rhodium
// Implements Berkeley HardFloat fused multiply-add preparation, combination, normalization, and rounding.
// Derived from hardfloat/src/main/scala/MulAddRecFN.scala at upstream commit c1105e6.
// Copyright 2010-2017 The Regents of the University of California.
// SPDX-License-Identifier: BSD-3-Clause; see ../../LICENSE.md.

import:
  "../types.rhdl" open
  "../primitives.rhdl" open
  lib("rhodium/std/bits.rhdl").count_leading_zeros
  "../recode.rhdl" open
  "../round.rhdl".RoundRawFNToRecFN

fun fma_extend(value :: Bits, width :: PosInt) :~ Bits(width):
  if value.type.bit_width() == width
  | value
  | value.zext(width)

fun fma_repeat(value :: Bool, count :: PosInt) :~ Bits(count):
  vec(for List (_index in 0..count): value).as_bits()

bundle MulAddIntermediate(exponent_width :: PosInt, significand_width :: PosInt):
  signaling_nan: Bool
  nan_a_or_b: Bool
  infinite_a: Bool
  zero_a: Bool
  infinite_b: Bool
  zero_b: Bool
  product_sign: Bool
  nan_c: Bool
  infinite_c: Bool
  zero_c: Bool
  exponent_sum: SInt(exponent_width + 2)
  subtract_magnitudes: Bool
  c_dominant: Bool
  c_alignment_distance: Bits(index_width(significand_width + 1))
  high_aligned_c: Bits(significand_width + 2)
  aligned_c_bit_zero: Bool

circuit MulAddRecFNToRawPreMultiply(format :: FloatFormat):
  input operation: MulAddOperation
  input a: RecFloat(format)
  input b: RecFloat(format)
  input c: RecFloat(format)
  output multiply_a: Bits(format.significand_width)
  output multiply_b: Bits(format.significand_width)
  output multiply_c: Bits(format.significand_width * 2)
  output intermediate: MulAddIntermediate(format.exponent_width, format.significand_width)

  def significand_width = format.significand_width
  def exponent_width = format.exponent_width
  def significand_sum_width = (significand_width * 3) + 3
  def raw_a = a.to_raw()
  def raw_b = b.to_raw()
  def raw_c = c.to_raw()
  def operation_bits = operation.as_bits()
  def product_sign = raw_a.sign ^ raw_b.sign ^ operation_bits[1].into(Bool)
  def exponent_sum_width = exponent_width + 3
  def aligned_product_exponent = (
    raw_a.signed_exponent.sext(exponent_sum_width) + raw_b.signed_exponent.sext(exponent_sum_width)
  ) + sint((((-(1 << exponent_width)) + significand_width) + 3), exponent_sum_width)
  def subtract_magnitudes = product_sign ^ raw_c.sign ^ operation_bits[0].into(Bool)

  def natural_c_alignment = aligned_product_exponent - raw_c.signed_exponent.sext(exponent_sum_width)
  def positive_c_alignment = natural_c_alignment.as_bits()[0..=(exponent_width + 1)]
  def minimum_c_alignment = raw_a.is_zero ||| raw_b.is_zero ||| (
    natural_c_alignment < sint(0, exponent_sum_width)
  )
  def c_dominant = !raw_c.is_zero & (
    minimum_c_alignment ||| (positive_c_alignment <= bits(significand_width, exponent_width + 2))
  )
  def full_alignment_width = index_width(significand_sum_width)
  def c_alignment = mux(
    minimum_c_alignment,
    bits(0, full_alignment_width),
    mux(
      positive_c_alignment < bits(significand_sum_width - 1, exponent_width + 2),
      positive_c_alignment[0..full_alignment_width],
      bits(significand_sum_width - 1, full_alignment_width)
    )
  )
  def selected_c_significand = mux(subtract_magnitudes, !raw_c.significand, raw_c.significand)
  def aligned_c_source = (
    selected_c_significand
      ++ fma_repeat(subtract_magnitudes, (significand_sum_width - significand_width) + 2)
  )
  def main_aligned_c = aligned_c_source.into(SInt(significand_sum_width + 3)) >> c_alignment
  def c_extra_shift = ((significand_sum_width - significand_width) - 1) mod 4
  def c_extra_group_count = (significand_width + c_extra_shift + 3) div 4
  def c_extra_source = fma_extend(raw_c.significand, c_extra_group_count * 4) << c_extra_shift
  def c_extra_groups = c_extra_source.as_vec(Bits(4))
  def reduced_c_extra_groups = c_extra_groups.map(fun (group): group =/= bits(0, 4))
  def reduced_c_extra = reduced_c_extra_groups.as_bits()
  def c_extra_mask_top = (significand_sum_width - 1) div 4
  def c_extra_mask_bottom = ((significand_sum_width - significand_width) - 1) div 4
  def reduced_c_extra_bit:
    if c_extra_mask_top == c_extra_mask_bottom
    | Bool(#false)
    | block:
        def mask = low_mask(
          c_alignment[2..full_alignment_width],
          c_extra_mask_top,
          c_extra_mask_bottom
        )
        or_reduce(reduced_c_extra & fma_extend(mask, reduced_c_extra.type.bit_width()))
  def aligned_c_tail = main_aligned_c.as_bits()[0..=2]
  def aligned_c_sticky = mux(
    subtract_magnitudes,
    aligned_c_tail.and_reduce() & !reduced_c_extra_bit,
    aligned_c_tail.or_reduce() ||| reduced_c_extra_bit
  )
  def aligned_c = (
    main_aligned_c.as_bits()[3..=(significand_sum_width + 2)]
      ++ aligned_c_sticky
  )
  def non_dominant_exponent = aligned_product_exponent - sint(significand_width, exponent_sum_width)
  def output_exponent = mux(
    c_dominant,
    raw_c.signed_exponent,
    non_dominant_exponent.as_bits()[0..=(exponent_width + 1)].into(SInt(exponent_width + 2))
  )
  def post_alignment_width = index_width(significand_width + 1)

  multiply_a <== raw_a.significand[0..significand_width]
  multiply_b <== raw_b.significand[0..significand_width]
  multiply_c <== aligned_c[1..=(significand_width * 2)]
  intermediate <== MulAddIntermediate(exponent_width, significand_width):
    signaling_nan: raw_a.is_signaling_nan() ||| raw_b.is_signaling_nan() ||| raw_c.is_signaling_nan()
    nan_a_or_b: raw_a.is_nan ||| raw_b.is_nan
    infinite_a: raw_a.is_infinite
    zero_a: raw_a.is_zero
    infinite_b: raw_b.is_infinite
    zero_b: raw_b.is_zero
    product_sign: product_sign
    nan_c: raw_c.is_nan
    infinite_c: raw_c.is_infinite
    zero_c: raw_c.is_zero
    exponent_sum: output_exponent
    subtract_magnitudes: subtract_magnitudes
    c_dominant: c_dominant
    c_alignment_distance: c_alignment[0..post_alignment_width]
    high_aligned_c: aligned_c[((significand_width * 2) + 1)..significand_sum_width]
    aligned_c_bit_zero: aligned_c[0].into(Bool)

circuit MulAddRecFNToRawPostMultiply(format :: FloatFormat):
  input intermediate: MulAddIntermediate(format.exponent_width, format.significand_width)
  input multiply_add_result: Bits((format.significand_width * 2) + 1)
  input rounding_mode: RoundingMode
  output invalid_exception: Bool
  output raw_out: RawFloat(format.exponent_width, (format.significand_width + 2))

  def significand_width = format.significand_width
  def exponent_width = format.exponent_width
  def significand_sum_width = (significand_width * 3) + 3
  def minimum_rounding = rounding_mode === RoundingMode.Minimum
  def operation_sign_c = intermediate.product_sign ^ intermediate.subtract_magnitudes
  def high_sum = mux(
    multiply_add_result[significand_width * 2].into(Bool),
    intermediate.high_aligned_c + bits(1, significand_width + 2),
    intermediate.high_aligned_c
  )
  def significand_sum = concat(
    high_sum,
    multiply_add_result[0..(significand_width * 2)],
    intermediate.aligned_c_bit_zero
  )

  def c_dominant_sign = operation_sign_c
  def subtract_adjustment = intermediate.subtract_magnitudes.as_bits().zext(exponent_width + 2).into(SInt(exponent_width + 2))
  def c_dominant_exponent = intermediate.exponent_sum - subtract_adjustment
  def c_dominant_absolute_sum = mux(
    intermediate.subtract_magnitudes,
    !significand_sum[(significand_width + 1)..significand_sum_width],
    concat(
      bits(0, 1),
      intermediate.high_aligned_c[significand_width..=(significand_width + 1)],
      significand_sum[(significand_width + 2)..=(significand_sum_width - 3)]
    )
  )
  def c_dominant_extra = mux(
    intermediate.subtract_magnitudes,
    or_reduce(!significand_sum[1..=significand_width]),
    significand_sum[1..=(significand_width + 1)].or_reduce()
  )
  def c_dominant_main:
    (c_dominant_absolute_sum << intermediate.c_alignment_distance)[
      (significand_width - 3)..=((significand_width * 2) + 1)
    ]
  def c_dominant_extra_shift = 3 - (significand_width mod 4)
  def c_dominant_group_count = (significand_width + c_dominant_extra_shift + 3) div 4
  def c_dominant_source = fma_extend(
    c_dominant_absolute_sum[0..significand_width],
    c_dominant_group_count * 4
  ) << c_dominant_extra_shift
  def c_dominant_groups = c_dominant_source.as_vec(Bits(4))
  def c_dominant_reduced_groups = c_dominant_groups.map(fun (group): group =/= bits(0, 4))
  def c_dominant_reduced = c_dominant_reduced_groups.as_bits()
  def c_dominant_mask_width = significand_width div 4
  def c_dominant_reduced_extra:
    if c_dominant_mask_width == 0
    | Bool(#false)
    | block:
        def alignment_width = intermediate.c_alignment_distance.type.bit_width()
        def alignment_quarters = intermediate.c_alignment_distance[2..alignment_width]
        def mask = low_mask(alignment_quarters, 0, c_dominant_mask_width)
        or_reduce(c_dominant_reduced & fma_extend(mask, c_dominant_reduced.type.bit_width()))
  def c_dominant_significand = (
    c_dominant_main[3..=(significand_width + 4)]
      ++ (c_dominant_main[0..=2].or_reduce() ||| c_dominant_reduced_extra ||| c_dominant_extra)
  )

  def non_dominant_sum_sign = significand_sum[(significand_width * 2) + 3].into(Bool)
  def non_dominant_absolute_sum = mux(
    non_dominant_sum_sign,
    !significand_sum[0..=((significand_width * 2) + 2)],
    significand_sum[0..=((significand_width * 2) + 2)] + intermediate.subtract_magnitudes.as_bits().zext((significand_width * 2) + 3)
  )
  def non_dominant_reduced_source = non_dominant_absolute_sum.zext((significand_width * 2) + 4)
  def non_dominant_groups = non_dominant_reduced_source.as_vec(Bits(2))
  def non_dominant_reduced_groups = non_dominant_groups.map(fun (group): group =/= bits(0, 2))
  def non_dominant_reduced = non_dominant_reduced_groups.as_bits()
  def non_dominant_normalization_reduced = non_dominant_reduced.count_leading_zeros()
  def non_dominant_normalization_width = non_dominant_normalization_reduced.type.bit_width() + 1
  def non_dominant_normalization_distance = non_dominant_normalization_reduced.zext(non_dominant_normalization_width) << 1
  def non_dominant_exponent_adjustment = non_dominant_normalization_distance.zext(exponent_width + 2).into(SInt(exponent_width + 2))
  def non_dominant_exponent = intermediate.exponent_sum - non_dominant_exponent_adjustment
  def non_dominant_main_source = non_dominant_absolute_sum.zext((significand_width * 2) + 4)
  def non_dominant_main:
    (non_dominant_main_source << non_dominant_normalization_distance)[
      (significand_width - 1)..=((significand_width * 2) + 3)
    ]
  def non_dominant_reduced_slice = non_dominant_reduced[0..=(significand_width div 2)]
  def non_dominant_reduced_shift = (significand_width div 2) mod 2
  def non_dominant_reduced_again_width = non_dominant_reduced_slice.type.bit_width() + non_dominant_reduced_shift + 1
  def non_dominant_reduced_again_source = fma_extend(
    non_dominant_reduced_slice,
    non_dominant_reduced_again_width
  ) << non_dominant_reduced_shift
  def non_dominant_groups_again = non_dominant_reduced_again_source.as_vec(Bits(2))
  def non_dominant_reduced_groups_again = non_dominant_groups_again.map(fun (group): group =/= bits(0, 2))
  def non_dominant_reduced_again = non_dominant_reduced_groups_again.as_bits()
  def normalization_width = non_dominant_normalization_reduced.type.bit_width()
  def normalization_halves = non_dominant_normalization_reduced[1..normalization_width]
  def non_dominant_mask_width = (significand_width + 2) div 4
  def non_dominant_mask = low_mask(normalization_halves, 0, non_dominant_mask_width)
  def non_dominant_reduced_extra = or_reduce(
    non_dominant_reduced_again & fma_extend(non_dominant_mask, non_dominant_reduced_again.type.bit_width())
  )
  def non_dominant_significand = (
    non_dominant_main[3..=(significand_width + 4)]
      ++ (non_dominant_main[0..=2].or_reduce() ||| non_dominant_reduced_extra)
  )
  def non_dominant_cancellation:
    non_dominant_significand[(significand_width + 1)..=(significand_width + 2)] === bits(0, 2)
  def non_dominant_sign = mux(
    non_dominant_cancellation,
    minimum_rounding,
    intermediate.product_sign ^ non_dominant_sum_sign
  )

  def infinite_product = intermediate.infinite_a ||| intermediate.infinite_b
  def infinite_out = infinite_product ||| intermediate.infinite_c
  def add_zeros = (intermediate.zero_a ||| intermediate.zero_b) & intermediate.zero_c
  def sign_out = (infinite_product & intermediate.product_sign) ||| (
    intermediate.infinite_c & operation_sign_c
  ) ||| (add_zeros & !minimum_rounding & intermediate.product_sign & operation_sign_c) ||| (
    add_zeros & minimum_rounding & (intermediate.product_sign ||| operation_sign_c)
  ) ||| (!infinite_out & !add_zeros & mux(
    intermediate.c_dominant,
    c_dominant_sign,
    non_dominant_sign
  ))

  invalid_exception <== intermediate.signaling_nan ||| (
    intermediate.infinite_a & intermediate.zero_b
  ) ||| (intermediate.zero_a & intermediate.infinite_b) ||| (
    !intermediate.nan_a_or_b & infinite_product & intermediate.infinite_c & intermediate.subtract_magnitudes
  )
  raw_out <== RawFloat(exponent_width, (significand_width + 2)):
    is_nan: intermediate.nan_a_or_b ||| intermediate.nan_c
    is_infinite: infinite_out
    is_zero: add_zeros ||| (!intermediate.c_dominant & non_dominant_cancellation)
    sign: sign_out
    signed_exponent: mux(intermediate.c_dominant, c_dominant_exponent, non_dominant_exponent)
    significand: mux(intermediate.c_dominant, c_dominant_significand, non_dominant_significand)

circuit MulAddRecFN(format :: FloatFormat):
  input operation: MulAddOperation
  input a: RecFloat(format)
  input b: RecFloat(format)
  input c: RecFloat(format)
  input rounding_mode: RoundingMode
  input tininess_mode: TininessMode
  output out: RecFloat(format)
  output exception_flags: ExceptionFlags()

  inst prepare(MulAddRecFNToRawPreMultiply(format))
  prepare.operation <== operation
  prepare.a <== a
  prepare.b <== b
  prepare.c <== c
  def product = prepare.multiply_a *& prepare.multiply_b
  def multiply_add_result = product +& prepare.multiply_c

  inst combine(MulAddRecFNToRawPostMultiply(format))
  combine.intermediate <== prepare.intermediate
  combine.multiply_add_result <== multiply_add_result
  combine.rounding_mode <== rounding_mode

  inst round(RoundRawFNToRecFN(format))
  round.invalid_exception <== combine.invalid_exception
  round.infinite_exception <== Bool(#false)
  round.raw <== combine.raw_out
  round.rounding_mode <== rounding_mode
  round.tininess_mode <== tininess_mode
  out <== round.out
  exception_flags <== round.exception_flags

export:
  MulAddRecFN
