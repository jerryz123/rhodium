#lang rhodium
/* Implements Berkeley HardFloat's generic iterative recoded division and square-root unit. */
// Derived from hardfloat/src/main/scala/DivSqrtRecFN_small.scala at upstream commit c1105e6.
// Copyright 2017 SiFive, Inc.
// SPDX-License-Identifier: BSD-3-Clause; see ../../LICENSE.md.

import:
  "../types.rhdl" open
  "../recode.rhdl" open
  "../round.rhdl".RoundRawFNToRecFN

/* Selects the generic recurrence's compile-time throughput/logic tradeoff
   without adding a runtime mode port. */
class DivSqrtOptions(two_bits_per_cycle :: Boolean = #false):
  implements StableCircuitParam

  /* Retains whether busy cycles may evaluate two recurrence bits instead of one. */
  constructor (two_bits_per_cycle :: Boolean = #false):
    super(two_bits_per_cycle)

namespace ~extend DivSqrtOptions:
  def Default = DivSqrtOptions()
  def TwoBitsPerCycle = DivSqrtOptions(#true)

  export:
    Default
    TwoBitsPerCycle

/* Runs one active restoring division or square-root recurrence over raw
   operands, computing a/b or sqrt(a). Accepts only ready/valid requests,
   retains rounding mode, and emits nonbackpressured completion pulses; special
   values take a shorter path and the optional second trial reduces busy cycles. */
sync_circuit DivSqrtRawFN(format :: FloatFormat,
                          options :: DivSqrtOptions = DivSqrtOptions.Default):
  input input_valid: Bool
  output input_ready: Bool
  input square_root: Bool
  input a: RawFloat(format.exponent_width, format.significand_width)
  input b: RawFloat(format.exponent_width, format.significand_width)
  input rounding_mode: RoundingMode
  output division_valid: Bool
  output square_root_valid: Bool
  output rounding_mode_out: RoundingMode
  output invalid_exception: Bool
  output infinite_exception: Bool
  output raw_out: RawFloat(format.exponent_width, (format.significand_width + 2))

  def exponent_width = format.exponent_width
  def significand_width = format.significand_width
  def cycle_width = index_width(significand_width + 3)
  def remainder_width = significand_width + 2
  def trial_width = significand_width + 4
  def second_trial_width = significand_width + 5

  reg cycle_number(~init: bits(0, cycle_width))
  reg ready_state(~init: Bool(#true))
  reg output_valid_state(~init: Bool(#false))
  reg square_root_state(Bool)
  reg major_exception_state(Bool)
  reg nan_state(Bool)
  reg infinite_state(Bool)
  reg zero_state(Bool)
  reg sign_state(Bool)
  reg exponent_state(SInt(exponent_width + 2))
  reg divisor_fraction_state(Bits(significand_width))
  reg rounding_mode_state(RoundingMode)
  reg remainder_state(Bits(remainder_width))
  reg nonzero_remainder_state(Bool)
  reg significand_state(Bits(remainder_width))

  def division_invalid = (a.is_zero & b.is_zero) ||| (a.is_infinite & b.is_infinite)
  def square_root_invalid = !a.is_nan & !a.is_zero & a.sign
  def input_major_exception = mux(
    square_root,
    a.is_signaling_nan() ||| square_root_invalid,
    a.is_signaling_nan() ||| b.is_signaling_nan() ||| division_invalid ||| (
      !a.is_nan & !a.is_infinite & b.is_zero
    )
  )
  def input_nan = mux(
    square_root,
    a.is_nan ||| square_root_invalid,
    a.is_nan ||| b.is_nan ||| division_invalid
  )
  def input_infinite = mux(square_root, a.is_infinite, a.is_infinite ||| b.is_zero)
  def input_zero = mux(square_root, a.is_zero, a.is_zero ||| b.is_infinite)
  def input_sign = a.sign ^ (!square_root & b.sign)
  def special_a = a.is_nan ||| a.is_infinite ||| a.is_zero
  def special_b = b.is_nan ||| b.is_infinite ||| b.is_zero
  def normal_division = !special_a & !special_b
  def normal_square_root = !special_a & !a.sign
  def normal_input = mux(square_root, normal_square_root, normal_division)

  def quotient_exponent_width = exponent_width + 3
  def negated_b_exponent = (
      b.signed_exponent.as_bits()[exponent_width]
        ++ (!b.signed_exponent.as_bits()[0..exponent_width])
    ).into(SInt(exponent_width + 1))
  def widened_a_exponent = a.signed_exponent.sext(quotient_exponent_width)
  def widened_b_exponent = negated_b_exponent.sext(quotient_exponent_width)
  def quotient_exponent = widened_a_exponent + widened_b_exponent
  def saturated_quotient_exponent = (
      mux(
        sint(7 << (exponent_width - 2), quotient_exponent_width) <= quotient_exponent,
        bits(6, 4),
        quotient_exponent.as_bits()[(exponent_width - 2)..=(exponent_width + 1)]
      )
        ++ quotient_exponent.as_bits()[0..=(exponent_width - 3)]
    ).into(SInt(exponent_width + 2))
  def exponent_is_odd = a.signed_exponent.as_bits()[0].into(Bool)
  def even_square_root = square_root & !exponent_is_odd
  def odd_square_root = square_root & exponent_is_odd

  /* The countdown controls admission and completion, with readiness restored
     for the completion cycle. A following request may replace finished work;
     there is no output queue or downstream-ready input. */
  def idle = cycle_number === bits(0, cycle_width)
  def entering = ready_state & input_valid
  def entering_normal = entering & normal_input
  def process_two_bits:
    if options.two_bits_per_cycle
    | cycle_number >= bits(3, cycle_width)
    | Bool(#false)
  def skip_second_cycle:
    if options.two_bits_per_cycle
    | Bool(#false)
    | (cycle_number === bits(3, cycle_width)) & significand_state[significand_width + 1].into(Bool)
  def decrement = mux(process_two_bits, bits(2, cycle_width), bits(1, cycle_width))
  def normal_initial_cycle = mux(
    square_root,
    mux(
      exponent_is_odd,
      bits(significand_width, cycle_width),
      bits(significand_width + 1, cycle_width)
    ),
    bits(significand_width + 2, cycle_width)
  )
  def next_cycle_number = mux(
    entering,
    mux(entering_normal, normal_initial_cycle, bits(1, cycle_width)),
    mux(skip_second_cycle, bits(1, cycle_width), cycle_number - decrement)
  )

  when (!idle ||| entering):
    cycle_number <== next_cycle_number
    ready_state <== next_cycle_number <= bits(1, cycle_width)
    output_valid_state <== next_cycle_number === bits(1, cycle_width)

  input_ready <== ready_state

  when entering:
    square_root_state <== square_root
    major_exception_state <== input_major_exception
    nan_state <== input_nan
    infinite_state <== input_infinite
    zero_state <== input_zero
    sign_state <== input_sign
    exponent_state <== mux(
      square_root,
      (a.signed_exponent >> 1) + sint(1 << (exponent_width - 1), exponent_width + 2),
      saturated_quotient_exponent
    )
    rounding_mode_state <== rounding_mode

  def input_divisor_fraction = b.significand[0..=(significand_width - 2)].zext(significand_width) << 1
  def odd_root_fraction = bits(1 << (significand_width - 2), significand_width)
  def even_root_fraction = bits(1 << (significand_width - 1), significand_width)
  when entering:
    divisor_fraction_state <== mux(
      square_root,
      mux(exponent_is_odd, odd_root_fraction, even_root_fraction),
      input_divisor_fraction
    )
  elsewhen (!ready_state & square_root_state):
    divisor_fraction_state <== mux(
      process_two_bits,
      divisor_fraction_state >> 2,
      divisor_fraction_state >> 1
    )

  def initial_even_remainder = a.significand.zext(significand_width + 3) << 1
  def initial_odd_remainder = (
    a.significand[(significand_width - 2)..significand_width] - bits(1, 2)
      ++ (a.significand[0..=(significand_width - 3)].zext(significand_width + 1) << 3)
  )
  def busy_remainder = remainder_state.zext(significand_width + 3) << 1
  def remainder = mux(
    ready_state,
    mux(odd_square_root, initial_odd_remainder, initial_even_remainder),
    busy_remainder
  )

  def shifted_cycle_one = bits(1, 1).zext(significand_width + 3) << cycle_number
  def bit_mask = shifted_cycle_one[2..=(significand_width + 2)]
  def initial_division_trial = b.significand.zext(significand_width + 3) << 1
  def initial_even_root_trial = bits(1 << significand_width, significand_width + 3)
  def initial_odd_root_trial = bits(5 << (significand_width - 1), significand_width + 3)
  def busy_trial = divisor_fraction_state.zext(significand_width + 3) ||| mux(
    square_root_state,
    significand_state.zext(significand_width + 3) << 1,
    bits(1 << significand_width, significand_width + 3)
  )
  def trial_term = mux(
    ready_state,
    mux(
      square_root,
      mux(exponent_is_odd, initial_odd_root_trial, initial_even_root_trial),
      initial_division_trial
    ),
    busy_trial
  )
  def signed_remainder = remainder.zext(trial_width).into(SInt(trial_width))
  def signed_trial_term = trial_term.zext(trial_width).into(SInt(trial_width))
  def trial_remainder = signed_remainder - signed_trial_term
  def new_bit :: Bool = sint(0, trial_width) <= trial_remainder
  def next_remainder = mux(
    new_bit,
    trial_remainder.as_bits()[0..=(significand_width + 1)],
    remainder[0..=(significand_width + 1)]
  )

  /* Two-bit mode chains a second trial from the first trial's decision,
     updating both the accumulated significand and nonzero-remainder tracking. */
  def doubled_next_remainder = next_remainder.zext(significand_width + 3) << 1
  def second_trial_base = mux(
    square_root_state,
    (divisor_fraction_state >> 1).zext(significand_width + 3) ||| (
      significand_state.zext(significand_width + 3) << 1
    ),
    divisor_fraction_state.zext(significand_width + 3) ||| bits(
      1 << significand_width,
      significand_width + 3
    )
  )
  def second_trial_with_new_bit = second_trial_base ||| mux(
    square_root_state,
    divisor_fraction_state.zext(significand_width + 3) << 1,
    bits(0, significand_width + 3)
  )
  def second_positive_remainder = trial_remainder.sext(second_trial_width) << 1
  def second_unsubtracted_remainder = (
    remainder_state.zext(significand_width + 4) << 2
  )[0..=(significand_width + 2)].zext(second_trial_width)
  def selected_second_remainder = mux(
    new_bit,
    second_positive_remainder,
    second_unsubtracted_remainder.into(SInt(second_trial_width))
  )
  def selected_second_trial = mux(new_bit, second_trial_with_new_bit, second_trial_base)
  def second_trial_term = selected_second_trial.zext(second_trial_width).into(SInt(second_trial_width))
  def second_trial_remainder = selected_second_remainder - second_trial_term
  def second_new_bit = sint(0, second_trial_width) <= second_trial_remainder
  def next_nonzero_remainder = mux(
    ready_state ||| new_bit,
    trial_remainder =/= sint(0, trial_width),
    nonzero_remainder_state
  )
  def second_positive = sint(0, second_trial_width) < second_trial_remainder
  def next_nonzero_remainder_two = (
    process_two_bits & new_bit & second_positive
  ) ||| (
    process_two_bits & !new_bit & second_positive
  ) ||| (!(process_two_bits & second_new_bit) & next_nonzero_remainder)
  def next_remainder_two = mux(
    process_two_bits,
    mux(
      second_new_bit,
      second_trial_remainder.as_bits()[0..=(significand_width + 1)],
      doubled_next_remainder[0..=(significand_width + 1)]
    ),
    next_remainder
  )

  def initial_division_significand = new_bit.as_bits().zext(remainder_width) << (significand_width + 1)
  def initial_root_significand = bits(1 << significand_width, remainder_width)
  def initial_odd_root_bit = new_bit.as_bits().zext(remainder_width) << (significand_width - 1)
  def continued_significand = significand_state ||| mux(
    new_bit,
    bit_mask.zext(remainder_width),
    bits(0, remainder_width)
  ) ||| mux(
    process_two_bits & second_new_bit,
    (bit_mask >> 1).zext(remainder_width),
    bits(0, remainder_width)
  )
  def next_significand = mux(
    ready_state,
    mux(
      square_root,
      initial_root_significand ||| mux(
        odd_square_root,
        initial_odd_root_bit,
        bits(0, remainder_width)
      ),
      initial_division_significand
    ),
    continued_significand
  )

  when (entering ||| !ready_state):
    nonzero_remainder_state <== next_nonzero_remainder_two
    remainder_state <== next_remainder_two
    significand_state <== next_significand

  /* The raw result appends a sticky bit for a nonzero remainder. Completion
     pulses qualify this state and the wrapper's combinational rounded result. */
  division_valid <== output_valid_state & !square_root_state
  square_root_valid <== output_valid_state & square_root_state
  rounding_mode_out <== rounding_mode_state
  invalid_exception <== major_exception_state & nan_state
  infinite_exception <== major_exception_state & !nan_state
  raw_out <== RawFloat(exponent_width, (significand_width + 2)):
    is_nan: nan_state
    is_infinite: infinite_state
    is_zero: zero_state
    sign: sign_state
    signed_exponent: exponent_state
    significand: (significand_state.zext(significand_width + 3) << 1) ||| (
      nonzero_remainder_state.as_bits().zext(significand_width + 3)
    )

/* Decodes recoded operands for the generic raw recurrence while preserving
   its admission, completion, exception, and saved-rounding-mode signals. */
sync_circuit DivSqrtRecFNToRaw(format :: FloatFormat,
                               options :: DivSqrtOptions = DivSqrtOptions.Default):
  input input_valid: Bool
  output input_ready: Bool
  input square_root: Bool
  input a: RecFloat(format)
  input b: RecFloat(format)
  input rounding_mode: RoundingMode
  output division_valid: Bool
  output square_root_valid: Bool
  output rounding_mode_out: RoundingMode
  output invalid_exception: Bool
  output infinite_exception: Bool
  output raw_out: RawFloat(format.exponent_width, (format.significand_width + 2))

  inst operation(DivSqrtRawFN(format, options))
  operation.input_valid <== input_valid
  input_ready <== operation.input_ready
  operation.square_root <== square_root
  operation.a <== a.to_raw()
  operation.b <== b.to_raw()
  operation.rounding_mode <== rounding_mode
  division_valid <== operation.division_valid
  square_root_valid <== operation.square_root_valid
  rounding_mode_out <== operation.rounding_mode_out
  invalid_exception <== operation.invalid_exception
  infinite_exception <== operation.infinite_exception
  raw_out <== operation.raw_out

/* Adds same-format rounding to the generic iterative unit's completion.
   Rounding mode is retained with the request; tininess is supplied to the
   combinational result rounder. Completion pulses cannot be backpressured. */
sync_circuit DivSqrtRecFN(format :: FloatFormat,
                          options :: DivSqrtOptions = DivSqrtOptions.Default):
  input input_valid: Bool
  output input_ready: Bool
  input square_root: Bool
  input a: RecFloat(format)
  input b: RecFloat(format)
  input rounding_mode: RoundingMode
  input tininess_mode: TininessMode
  output division_valid: Bool
  output square_root_valid: Bool
  output out: RecFloat(format)
  output exception_flags: ExceptionFlags()

  inst operation(DivSqrtRecFNToRaw(format, options))
  operation.input_valid <== input_valid
  input_ready <== operation.input_ready
  operation.square_root <== square_root
  operation.a <== a
  operation.b <== b
  operation.rounding_mode <== rounding_mode
  division_valid <== operation.division_valid
  square_root_valid <== operation.square_root_valid

  inst round(RoundRawFNToRecFN(format))
  round.invalid_exception <== operation.invalid_exception
  round.infinite_exception <== operation.infinite_exception
  round.raw <== operation.raw_out
  round.rounding_mode <== operation.rounding_mode_out
  round.tininess_mode <== tininess_mode
  out <== round.out
  exception_flags <== round.exception_flags

export:
  DivSqrtOptions
  DivSqrtRecFN
