#lang rhodium
// Implements Berkeley HardFloat raw and rounded recoded addition and subtraction.
// Derived from hardfloat/src/main/scala/AddRecFN.scala at upstream commit c1105e6.
// Copyright 2010-2017 The Regents of the University of California.
// SPDX-License-Identifier: BSD-3-Clause; see ../../LICENSE.md.

import:
  "../types.rhdl" open
  "../primitives.rhdl" open
  lib("rhodium/std/bits.rhdl").count_leading_zeros
  "../recode.rhdl" open
  "../round.rhdl".RoundRawFNToRecFN

circuit AddRawFN(format :: FloatFormat):
  input subtract: Bool
  input a: RawFloat(format.exponent_width, format.significand_width)
  input b: RawFloat(format.exponent_width, format.significand_width)
  input rounding_mode: RoundingMode
  output invalid_exception: Bool
  output raw_out: RawFloat(format.exponent_width, (format.significand_width + 2))

  def significand_width = format.significand_width
  def exponent_width = format.exponent_width
  def align_distance_width = index_width(significand_width)
  def effective_sign_b = b.sign ^ subtract
  def equal_signs = a.sign === effective_sign_b
  def unequal_signs_zero_sign = rounding_mode === RoundingMode.Minimum
  def exponent_difference = a.signed_exponent - b.signed_exponent
  def negative_exponent_difference = exponent_difference < sint(0, exponent_width + 2)
  def absolute_exponent_difference = mux(
    negative_exponent_difference,
    b.signed_exponent - a.signed_exponent,
    exponent_difference
  )
  def modular_alignment_distance = absolute_exponent_difference.as_bits()[0..align_distance_width]
  def shifted_exponent_difference = exponent_difference >> align_distance_width
  def maximum_alignment = (shifted_exponent_difference =/= sint(0, exponent_width + 2)) & (
    (shifted_exponent_difference =/= sint(-1, exponent_width + 2)) ||| (
      exponent_difference.as_bits()[0..align_distance_width] === bits(0, align_distance_width)
    )
  )
  def alignment_distance = mux(
    maximum_alignment,
    bits((1 << align_distance_width) - 1, align_distance_width),
    modular_alignment_distance
  )
  def close_subtraction = !equal_signs & !maximum_alignment & (
    modular_alignment_distance <= bits(1, align_distance_width)
  )

  def close_width = significand_width + 3
  def aligned_a = mux(
    !negative_exponent_difference & exponent_difference.as_bits()[0].into(Bool),
    a.significand.zext(close_width) << 2,
    bits(0, close_width)
  ) ||| mux(
    !negative_exponent_difference & !exponent_difference.as_bits()[0].into(Bool),
    a.significand.zext(close_width) << 1,
    bits(0, close_width)
  ) ||| mux(
    negative_exponent_difference,
    a.significand.zext(close_width),
    bits(0, close_width)
  )
  def shifted_b = b.significand.zext(close_width) << 1
  def signed_close_sum = aligned_a.into(SInt(close_width)) - shifted_b.into(SInt(close_width))
  def absolute_close_sum = mux(
    signed_close_sum < sint(0, close_width),
    -signed_close_sum,
    signed_close_sum
  )
  def close_sum = absolute_close_sum.as_bits()[0..=(significand_width + 1)]
  def close_adjusted_sum:
    if (significand_width mod 2) == 1
    | close_sum.zext(significand_width + 3) << 1
    | close_sum
  def close_groups = close_adjusted_sum.as_vec(Bits(2))
  def close_reduced_groups = close_groups.map(fun (group): group =/= bits(0, 2))
  def close_reduced_sum = close_reduced_groups.as_bits()
  def close_normalization_reduced = close_reduced_sum.count_leading_zeros()
  def close_normalization_distance:
    if close_normalization_reduced.type.bit_width() == align_distance_width
    | close_normalization_reduced << 1
    | close_normalization_reduced.zext(align_distance_width) << 1
  def close_significand = (
    close_sum.zext(significand_width + 3) << close_normalization_distance
  ) << 1
  def close_total_cancellation = !close_significand[(significand_width + 1)..=(significand_width + 2)].or_reduce()
  def close_sign = a.sign ^ (signed_close_sum < sint(0, close_width))

  def far_sign = mux(negative_exponent_difference, effective_sign_b, a.sign)
  def far_larger = mux(negative_exponent_difference, b.significand, a.significand)[0..significand_width]
  def far_smaller = mux(negative_exponent_difference, a.significand, b.significand)[0..significand_width]
  def far_main_aligned = (far_smaller.zext(significand_width + 5) << 5) >> alignment_distance
  def far_mask_width = (significand_width + 5) div 4
  def far_reduced_source = far_smaller.zext(far_mask_width * 4) << 2
  def far_groups = far_reduced_source.as_vec(Bits(4))
  def far_reduced_groups = far_groups.map(fun (group): group =/= bits(0, 4))
  def far_reduced = far_reduced_groups.as_bits()
  def far_round_extra_mask:
    if align_distance_width <= 2
    | bits(0, far_mask_width)
    | low_mask(alignment_distance[2..align_distance_width], far_mask_width, 0)
  def far_sticky = far_main_aligned[0..=2].or_reduce() ||| or_reduce(far_reduced & far_round_extra_mask)
  def far_aligned_smaller = (
    far_main_aligned[3..=(significand_width + 4)]
      ++ far_sticky
  )
  def far_subtract = !equal_signs
  def far_negative_smaller = mux(
    far_subtract,
    (Bool(#true) ++ (!far_aligned_smaller)),
    (Bool(#false) ++ far_aligned_smaller)
  )
  def far_larger_shifted = far_larger.zext(significand_width + 4) << 3
  def far_sum = (far_larger_shifted + far_negative_smaller) + far_subtract.as_bits().zext(significand_width + 4)
  def far_added_significand = far_sum[1..=(significand_width + 3)] ||| far_sum[0].zext(significand_width + 3)
  def far_significand = mux(
    far_subtract,
    far_sum[0..=(significand_width + 2)],
    far_added_significand
  )

  def invalid_non_nan = a.is_infinite & b.is_infinite & !equal_signs
  def infinite_out = a.is_infinite ||| b.is_infinite
  def add_zeros = a.is_zero & b.is_zero
  def special_non_nan = infinite_out ||| add_zeros
  def zero_out = add_zeros ||| (!infinite_out & close_subtraction & close_total_cancellation)
  def sign_out = (equal_signs & a.sign) ||| (a.is_infinite & a.sign) ||| (
    b.is_infinite & effective_sign_b
  ) ||| (zero_out & !equal_signs & unequal_signs_zero_sign) ||| (
    !special_non_nan & close_subtraction & !close_total_cancellation & close_sign
  ) ||| (!special_non_nan & !close_subtraction & far_sign)
  def selected_exponent = mux(
    close_subtraction ||| negative_exponent_difference,
    b.signed_exponent,
    a.signed_exponent
  )
  def exponent_adjustment_bits = mux(
    close_subtraction,
    close_normalization_distance,
    far_subtract.as_bits().zext(align_distance_width)
  )
  def exponent_adjustment = exponent_adjustment_bits.zext(exponent_width + 2).into(SInt(exponent_width + 2))
  def exponent_out = selected_exponent - exponent_adjustment

  invalid_exception <== a.is_signaling_nan() ||| b.is_signaling_nan() ||| invalid_non_nan
  raw_out <== RawFloat(exponent_width, (significand_width + 2)):
    is_nan: a.is_nan ||| b.is_nan
    is_infinite: infinite_out
    is_zero: zero_out
    sign: sign_out
    signed_exponent: exponent_out
    significand: mux(close_subtraction, close_significand, far_significand)

circuit AddRecFN(format :: FloatFormat):
  input subtract: Bool
  input a: RecFloat(format)
  input b: RecFloat(format)
  input rounding_mode: RoundingMode
  input tininess_mode: TininessMode
  output out: RecFloat(format)
  output exception_flags: ExceptionFlags()

  inst add(AddRawFN(format))
  add.subtract <== subtract
  add.a <== a.to_raw()
  add.b <== b.to_raw()
  add.rounding_mode <== rounding_mode

  inst round(RoundRawFNToRecFN(format))
  round.invalid_exception <== add.invalid_exception
  round.infinite_exception <== Bool(#false)
  round.raw <== add.raw_out
  round.rounding_mode <== rounding_mode
  round.tininess_mode <== tininess_mode
  out <== round.out
  exception_flags <== round.exception_flags

export:
  AddRecFN
