#lang rhodium
/* Implements ordered comparison over recoded Berkeley HardFloat values. */
// Derived from hardfloat/src/main/scala/CompareRecFN.scala at upstream commit c1105e6.
// Copyright 2010-2016 The Regents of the University of California.
// SPDX-License-Identifier: BSD-3-Clause; see ../../LICENSE.md.

import:
  "../types.rhdl" open
  "../recode.rhdl" open

/* Computes ordered comparisons combinationally, treating signed zeros as equal
   and NaNs as unordered. Signaling NaNs always raise invalid; signaling mode
   also raises it for quiet NaNs. */
circuit CompareRecFN(format :: FloatFormat):
  input a: RecFloat(format)
  input b: RecFloat(format)
  input signaling: Bool
  output lt: Bool
  output eq: Bool
  output gt: Bool
  output exception_flags: ExceptionFlags()

  def raw_a = a.to_raw()
  def raw_b = b.to_raw()
  def ordered = !raw_a.is_nan & !raw_b.is_nan
  def both_infinite = raw_a.is_infinite & raw_b.is_infinite
  def both_zero = raw_a.is_zero & raw_b.is_zero
  def equal_exponents = raw_a.signed_exponent === raw_b.signed_exponent
  def lesser_magnitude = (raw_a.signed_exponent < raw_b.signed_exponent) ||| (
    equal_exponents & (raw_a.significand < raw_b.significand)
  )
  def equal_magnitudes = equal_exponents & (raw_a.significand === raw_b.significand)
  def ordered_less = !both_zero & (
    (raw_a.sign & !raw_b.sign) ||| (
      !both_infinite & (
        (raw_a.sign & !lesser_magnitude & !equal_magnitudes) ||| (!raw_b.sign & lesser_magnitude)
      )
    )
  )
  def ordered_equal = both_zero ||| (
    (raw_a.sign === raw_b.sign) & (both_infinite ||| equal_magnitudes)
  )
  def invalid = raw_a.is_signaling_nan() ||| raw_b.is_signaling_nan() ||| (
    signaling & !ordered
  )

  lt <== ordered & ordered_less
  eq <== ordered & ordered_equal
  gt <== ordered & !ordered_less & !ordered_equal
  exception_flags.invalid <== invalid
  exception_flags.infinite <== Bool(#false)
  exception_flags.overflow <== Bool(#false)
  exception_flags.underflow <== Bool(#false)
  exception_flags.inexact <== Bool(#false)

export:
  CompareRecFN
