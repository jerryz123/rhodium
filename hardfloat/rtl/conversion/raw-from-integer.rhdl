#lang rhodium
// Normalizes a signed or unsigned fixed-width integer into Berkeley HardFloat's raw representation.
// Derived from hardfloat/src/main/scala/rawFloatFromIN.scala at upstream commit c1105e6.
// Copyright 2010-2017 The Regents of the University of California.
// SPDX-License-Identifier: BSD-3-Clause; see ../../LICENSE.md.

import:
  "../types.rhdl" open
  lib("rhodium/std/bits.rhdl").count_leading_zeros

fun raw_float_from_integer(signed_input :: Bool,
                           input :: Bits) :~ RawFloat(index_width(input.type.packed_width()) + 1, input.type.packed_width()):
  def integer_width = input.type.packed_width()
  unless integer_width >= 2
  | error(~who: #'raw_float_from_integer, "integer width must be at least two")
  def exponent_width = index_width(integer_width) + 1
  def extended_integer_width = 1 << (exponent_width - 1)
  def sign = signed_input & input[integer_width - 1].into(Bool)
  def magnitude = mux(sign, -input, input)
  def extended_magnitude:
    if integer_width == extended_integer_width
    | magnitude
    | magnitude.zext(extended_integer_width)
  def normalization_distance = extended_magnitude.count_leading_zeros()
  def normalized = extended_magnitude << normalization_distance
  def significand = normalized[(extended_integer_width - integer_width)..extended_integer_width]
  def exponent_bits = (bits(2, 2) ++ (!normalization_distance[0..=(exponent_width - 2)]))

  RawFloat(exponent_width, integer_width):
    is_nan: Bool(#false)
    is_infinite: Bool(#false)
    is_zero: !significand[integer_width - 1].into(Bool)
    sign: sign
    signed_exponent: exponent_bits.zext(exponent_width + 2).into(SInt(exponent_width + 2))
    significand: significand.zext(integer_width + 1)

export:
  raw_float_from_integer
