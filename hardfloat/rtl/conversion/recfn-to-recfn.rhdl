#lang rhodium
/* Converts between Berkeley HardFloat recoded formats with narrowing handled by the shared rounder. */
// Derived from hardfloat/src/main/scala/RecFNToRecFN.scala at upstream commit c1105e6.
// Copyright 2010-2016 The Regents of the University of California.
// SPDX-License-Identifier: BSD-3-Clause; see ../../LICENSE.md.

import:
  "../types.rhdl" open
  "../recode.rhdl" open
  "../round.rhdl".RoundAnyRawFNToRecFN

/* Converts recoded formats combinationally. Equal-exponent precision widening
   is exact wiring with signaling-NaN flagging; other changes use the shared
   rounder for exponent range, precision, tininess, and exception handling. */
circuit RecFNToRecFN(input_format :: FloatFormat,
                     output_format :: FloatFormat):
  input value: RecFloat(input_format)
  input rounding_mode: RoundingMode
  input tininess_mode: TininessMode
  output out: RecFloat(output_format)
  output exception_flags: ExceptionFlags()

  def raw = value.to_raw()
  if input_format.exponent_width == output_format.exponent_width && input_format.significand_width <= output_format.significand_width
  | block:
      if input_format.significand_width == output_format.significand_width
      | out <== value
      | out <== (
          value.as_bits().zext(output_format.recoded_width) << (
            output_format.significand_width - input_format.significand_width
          )
        ).into(RecFloat(output_format))
      exception_flags <== ExceptionFlags():
        invalid: raw.is_signaling_nan()
        infinite: Bool(#false)
        overflow: Bool(#false)
        underflow: Bool(#false)
        inexact: Bool(#false)
  | block:
      inst round(RoundAnyRawFNToRecFN(
        input_format.exponent_width,
        input_format.significand_width,
        output_format.exponent_width,
        output_format.significand_width,
        RoundingOptions(#true)
      ))
      round.invalid_exception <== raw.is_signaling_nan()
      round.infinite_exception <== Bool(#false)
      round.raw <== raw
      round.rounding_mode <== rounding_mode
      round.tininess_mode <== tininess_mode
      out <== round.out
      exception_flags <== round.exception_flags

export:
  RecFNToRecFN
