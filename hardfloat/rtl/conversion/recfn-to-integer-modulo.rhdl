#lang rhodium
// Converts recoded values to rounded fixed-width integers modulo a power of two.
// This Rhodium extension builds on the Berkeley HardFloat conversion representation and flags.
// SPDX-License-Identifier: BSD-3-Clause; see ../../LICENSE.md.

import:
  "../types.rhdl" open
  "../recode.rhdl" open
  "../round.rhdl" open
  "recfn-to-integer.rhdl" open

fun modulo_unsigned_at_least_host(value :: Bits, constant :: Nat) :~ Bool:
  def width = value.type.packed_width()
  if constant >= (1 << width) | Bool(#false) | value >= bits(constant, width)

circuit RecFNToIntegerModulo(format :: FloatFormat, integer_width :: PosInt):
  unless integer_width >= 3
  | error(~who: #'RecFNToIntegerModulo, "integer width must be at least three")
  input value: RecFloat(format)
  input rounding_mode: RoundingMode
  input signed_output: Bool
  output out: Bits(integer_width)
  output exception_flags: IntegerExceptionFlags()

  def raw = value.to_raw()
  def raw_exponent = raw.signed_exponent.as_bits()
  def magnitude_at_least_one = raw_exponent[format.exponent_width].into(Bool)
  def positive_exponent = raw_exponent[0..format.exponent_width]
  def magnitude_just_below_one = !magnitude_at_least_one & positive_exponent.and_reduce()
  def exponent_index_width = index_width(integer_width + format.significand_width)
  def shift_capacity = (1 << exponent_index_width) - 1
  def shifted_width = format.significand_width + shift_capacity
  def shift_amount = mux(magnitude_at_least_one, raw_exponent[0..exponent_index_width], bits(0, exponent_index_width))
  def shift_source = magnitude_at_least_one ++ raw.significand[0..=(format.significand_width - 2)]
  def shifted_significand = shift_source.zext(shifted_width) << shift_amount
  def aligned_high = shifted_significand[(format.significand_width - 2)..shifted_width]
  def aligned_significand = aligned_high ++ shifted_significand[0..=(format.significand_width - 3)].or_reduce()
  def aligned_for_integer:
    if aligned_significand.type.packed_width() < integer_width + 2 | aligned_significand.zext(integer_width + 2) | aligned_significand
  def exponent_forces_zero = magnitude_at_least_one & positive_exponent.modulo_unsigned_at_least_host(integer_width + format.significand_width - 1)
  def unrounded_integer = mux(exponent_forces_zero, bits(0, integer_width), aligned_for_integer[2..=(integer_width + 1)])
  def retained_lsb = magnitude_at_least_one & !exponent_forces_zero & aligned_significand[2].into(Bool)
  def guard = mux(magnitude_at_least_one, !exponent_forces_zero & aligned_significand[1].into(Bool), magnitude_just_below_one)
  def sticky = mux(magnitude_at_least_one, !exponent_forces_zero & aligned_significand[0].into(Bool), !raw.is_zero & !magnitude_just_below_one) ||| (magnitude_just_below_one & aligned_significand[0..=1].or_reduce())
  def inexact = guard ||| sticky
  def increment = rounding_increment(rounding_mode, raw.sign, retained_lsb, guard, sticky)
  def rounded_magnitude = mux(increment, unrounded_integer + bits(1, integer_width), unrounded_integer) ||| rounding_force_odd(rounding_mode, inexact).as_bits().zext(integer_width)
  def rounded_integer = mux(raw.sign, -rounded_magnitude, rounded_magnitude)

  inst standard(RecFNToInteger(format, integer_width))
  standard.value <== value
  standard.rounding_mode <== rounding_mode
  standard.signed_output <== signed_output
  out <== mux(raw.is_nan ||| raw.is_infinite, bits(0, integer_width), rounded_integer)
  exception_flags <== standard.exception_flags

export:
  RecFNToIntegerModulo
