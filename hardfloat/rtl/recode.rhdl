#lang rhodium
// Converts among IEEE, recoded, and raw Berkeley HardFloat representations.
// Derived from rawFloatFromFN.scala, recFNFromFN.scala, rawFloatFromRecFN.scala,
// and fNFromRecFN.scala at upstream commit c1105e6.
// Copyright 2010-2017 The Regents of the University of California.
// SPDX-License-Identifier: BSD-3-Clause; see ../LICENSE.md.

import:
  "types.rhdl" open
  lib("rhodium/std/bits.rhdl").count_leading_zeros

fun raw_float_from_ieee(value :: IEEEFloat) :~ RawFloat(value.type.format.exponent_width, value.type.format.significand_width):
  def format :: FloatFormat = value.type.format
  def exponent_width = format.exponent_width
  def significand_width = format.significand_width
  def packed_value = value.as_bits()
  def sign = packed_value[format.ieee_width - 1].into(Bool)
  def exponent = packed_value[(significand_width - 1)..=(format.ieee_width - 2)]
  def fraction = packed_value[0..=(significand_width - 2)]
  def zero_exponent = exponent === bits(0, exponent_width)
  def zero_fraction = fraction === bits(0, significand_width - 1)
  def normalization_distance = fraction.count_leading_zeros()
  def shifted_fraction = fraction << normalization_distance
  def subnormal_fraction = (shifted_fraction[0..=(significand_width - 3)] ++ bits(0, 1))
  def exponent_width_plus_one = exponent_width + 1
  def subnormal_exponent = normalization_distance.zext(exponent_width_plus_one) ^ bits(
    (1 << exponent_width_plus_one) - 1,
    exponent_width_plus_one
  )
  def selected_exponent = mux(
    zero_exponent,
    subnormal_exponent,
    exponent.zext(exponent_width_plus_one)
  )
  def exponent_adjustment = bits(1 << (exponent_width - 1), exponent_width_plus_one) ||| mux(
    zero_exponent,
    bits(2, exponent_width_plus_one),
    bits(1, exponent_width_plus_one)
  )
  def adjusted_exponent = selected_exponent + exponent_adjustment
  def zero = zero_exponent & zero_fraction
  def special = adjusted_exponent[(exponent_width - 1)..=exponent_width] === bits(3, 2)

  RawFloat(exponent_width, significand_width):
    is_nan: special & !zero_fraction
    is_infinite: special & zero_fraction
    is_zero: zero
    sign: sign
    signed_exponent: adjusted_exponent.zext(exponent_width + 2).into(SInt(exponent_width + 2))
    significand: concat(bits(0, 1), !zero, mux(zero_exponent, subnormal_fraction, fraction))

fun to_recoded(value :: IEEEFloat) :~ RecFloat(value.type.format):
  def format :: FloatFormat = value.type.format
  def raw = raw_float_from_ieee(value)
  def exponent = raw.signed_exponent.as_bits()
  def recoded_top = mux(
    raw.is_zero,
    bits(0, 3),
    exponent[(format.exponent_width - 2)..=format.exponent_width]
  ) ||| mux(raw.is_nan, bits(1, 3), bits(0, 3))
  concat(
      raw.sign,
      recoded_top,
      exponent[0..=(format.exponent_width - 3)],
      raw.significand[0..=(format.significand_width - 2)]
    ).into(RecFloat(format))

fun raw_float_from_recoded(value :: RecFloat) :~ RawFloat(value.type.format.exponent_width, value.type.format.significand_width):
  def format :: FloatFormat = value.type.format
  def exponent_width = format.exponent_width
  def significand_width = format.significand_width
  def packed_value = value.as_bits()
  def exponent = packed_value[(significand_width - 1)..=(format.recoded_width - 2)]
  def zero = exponent[(exponent_width - 2)..=exponent_width] === bits(0, 3)
  def special = exponent[(exponent_width - 1)..=exponent_width] === bits(3, 2)
  def nan_code = exponent[exponent_width - 2].into(Bool)

  RawFloat(exponent_width, significand_width):
    is_nan: special & nan_code
    is_infinite: special & !nan_code
    is_zero: zero
    sign: packed_value[format.recoded_width - 1].into(Bool)
    signed_exponent: exponent.zext(exponent_width + 2).into(SInt(exponent_width + 2))
    significand: concat(bits(0, 1), !zero, packed_value[0..=(significand_width - 2)])

fun to_raw(value :: IEEEFloat || RecFloat) :~ RawFloat(value.type.format.exponent_width, value.type.format.significand_width):
  if value is_a IEEEFloat
  | raw_float_from_ieee(value)
  | raw_float_from_recoded(value)

fun to_ieee(value :: RecFloat) :~ IEEEFloat(value.type.format):
  def format :: FloatFormat = value.type.format
  def exponent_width = format.exponent_width
  def significand_width = format.significand_width
  def raw = raw_float_from_recoded(value)
  def raw_exponent = raw.signed_exponent.as_bits()
  def minimum_normal_exponent = (1 << (exponent_width - 1)) + 2
  def subnormal = raw.signed_exponent < sint(minimum_normal_exponent, exponent_width + 2)
  def distance_width = index_width(significand_width - 1)
  def denormal_shift_distance = bits(1, distance_width) - raw_exponent[0..distance_width]
  def denormal_fraction = ((raw.significand >> 1) >> denormal_shift_distance)[0..=(significand_width - 2)]
  def finite_exponent = raw_exponent[0..exponent_width] - bits(
    (1 << (exponent_width - 1)) + 1,
    exponent_width
  )
  def special = raw.is_nan ||| raw.is_infinite
  def exponent = mux(subnormal, bits(0, exponent_width), finite_exponent) ||| mux(
    special,
    bits((1 << exponent_width) - 1, exponent_width),
    bits(0, exponent_width)
  )
  def fraction = mux(
    subnormal,
    denormal_fraction,
    mux(raw.is_infinite, bits(0, significand_width - 1), raw.significand[0..=(significand_width - 2)])
  )
  concat(raw.sign, exponent, fraction).into(IEEEFloat(format))

fun is_signaling_nan(raw :: Hardware.packable) :~ Bool:
  def significand_width = raw.significand.type.bit_width() - 1
  raw.is_nan & !raw.significand[significand_width - 2].into(Bool)

fun canonical_recoded_nan(format :: FloatFormat) :~ RecFloat(format):
  concat(bits(0, 1), bits(7 << (format.exponent_width - 2), format.exponent_width + 1), bits(1 << (format.significand_width - 2), format.significand_width - 1)).into(RecFloat(format))

export:
  to_raw
  to_recoded
  to_ieee
  is_signaling_nan
  canonical_recoded_nan
