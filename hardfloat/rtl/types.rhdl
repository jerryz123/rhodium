#lang rhodium
/* Defines host format parameters and packed hardware types for the Berkeley HardFloat port. */
// Derived from hardfloat/src/main/scala/common.scala at upstream commit c1105e6.
// Copyright 2010-2018 The Regents of the University of California.
// SPDX-License-Identifier: BSD-3-Clause; see ../LICENSE.md.

/* Defines a stable host specialization parameter for exponent width and
   precision, including the implicit leading significand bit. */
class FloatFormat(exponent_width :: PosInt, significand_width :: PosInt):
  implements StableCircuitParam

  /* Checks the upstream HardFloat format limits before retaining the widths. */
  constructor (exponent_width :: PosInt, significand_width :: PosInt):
    unless exponent_width >= 3
    | error(~who: #'FloatFormat, "exponent width must be at least three")
    unless significand_width >= 3
    | error(~who: #'FloatFormat, "significand width must be at least three")
    unless significand_width <= ((1 << (exponent_width - 2)) + 3)
    | error(~who: #'FloatFormat,
            "significand width exceeds the HardFloat format limit")
    super(exponent_width, significand_width)

  /* Returns the packed IEEE width: sign, exponent, and explicit fraction bits. */
  property ieee_width :: PosInt:
    exponent_width + significand_width
  /* Returns the recoded width, whose exponent has one extra encoding bit. */
  property recoded_width :: PosInt:
    ieee_width + 1

namespace ~extend FloatFormat:
  def F16 = FloatFormat(5, 11)
  def BF16 = FloatFormat(8, 8)
  def F32 = FloatFormat(8, 24)
  def F64 = FloatFormat(11, 53)

  export:
    F16
    BF16
    F32
    F64

/* Represents a nominal IEEE image keyed by exponent width and precision,
   preventing equal-width but different floating-point formats from connecting. */
hardware_type IEEEFloat(format :: FloatFormat):
  width: format.ieee_width
  type_key: [format.exponent_width, format.significand_width]
  describe:
    "ieee-float<" ++ to_string(format.exponent_width) ++ "," ++ to_string(format.significand_width) ++ ">"

/* Represents HardFloat's nominal recoded image with an extra exponent bit;
   the retained format distinguishes it from IEEE images and other formats. */
hardware_type RecFloat(format :: FloatFormat):
  width: format.recoded_width
  type_key: [format.exponent_width, format.significand_width]
  describe:
    "rec-float<" ++ to_string(format.exponent_width) ++ "," ++ to_string(format.significand_width) ++ ">"

/* Carries trusted host-side invariants used to specialize rounding logic;
   these promises remove unnecessary paths rather than adding control ports. */
class RoundingOptions(significand_msb_always_zero :: Boolean = #false,
                      subnormals_always_exact :: Boolean = #false,
                      never_underflows :: Boolean = #false,
                      never_overflows :: Boolean = #false):
  implements StableCircuitParam

  /* Retains the caller's significand, subnormal, underflow, and overflow promises
     as a stable circuit specialization parameter. */
  constructor (significand_msb_always_zero :: Boolean = #false,
               subnormals_always_exact :: Boolean = #false,
               never_underflows :: Boolean = #false,
               never_overflows :: Boolean = #false):
    super(significand_msb_always_zero,
          subnormals_always_exact,
          never_underflows,
          never_overflows)

namespace ~extend RoundingOptions:
  def Default = RoundingOptions()

  export:
    Default

/* Encodes the six supported rounding policies, including truncation and
   round-to-odd, using the upstream HardFloat mode values. */
hardware_enum RoundingMode(~width: 3):
  NearEven = 0
  MinMagnitude = 1
  Minimum = 2
  Maximum = 3
  NearMaximumMagnitude = 4
  Odd = 6

/* Selects whether underflow tininess is detected before or after rounding. */
hardware_enum TininessMode(~width: 1):
  BeforeRounding = 0
  AfterRounding = 1

/* Selects product and addend sign inversions for the four fused a*b+c variants. */
hardware_enum MulAddOperation(~width: 2):
  MultiplyAdd = 0
  MultiplySubtract = 1
  NegatedMultiplyAdd = 2
  NegatedMultiplySubtract = 3

/* Selects minimum or maximum with either NaN propagation or numeric preference
   when exactly one operand is NaN. */
hardware_enum MinMaxOperation(~width: 2):
  Minimum = 0
  Maximum = 1
  MinimumNumber = 2
  MaximumNumber = 3

/* Selects the seven-bit reciprocal or reciprocal-square-root estimate. */
hardware_enum Estimate7Operation:
  Reciprocal
  ReciprocalSquareRoot

/* Encodes one of ten IEEE value classes, distinguishing signed finite values,
   zeros, infinities, and signaling versus quiet NaNs. */
hardware_enum FloatClass(~encoding: one_hot):
  NegativeInfinity
  NegativeNormal
  NegativeSubnormal
  NegativeZero
  PositiveZero
  PositiveSubnormal
  PositiveNormal
  PositiveInfinity
  SignalingNaN
  QuietNaN

/* Carries floating-point exception status; infinite denotes the divide-by-zero
   exception, not merely an infinite operand or result. */
bundle ExceptionFlags():
  invalid: Bool
  infinite: Bool
  overflow: Bool
  underflow: Bool
  inexact: Bool

/* Carries invalid, out-of-range, and inexact status for conversion to integers. */
bundle IntegerExceptionFlags():
  invalid: Bool
  overflow: Bool
  inexact: Bool

/* Names the four consecutive multiplier pipeline stages. More than one stage
   can be occupied concurrently, so this is deliberately not a one-hot type. */
bundle MultiplyAddPipelineUsage():
  stage_three: Bool
  stage_two: Bool
  stage_one: Bool
  stage_zero: Bool

/* Carries unpacked arithmetic state: special-value tags, sign, a signed recoded
   exponent, and an extended significand. It is not an architectural encoding. */
bundle RawFloat(exponent_width :: PosInt, significand_width :: PosInt):
  is_nan: Bool
  is_infinite: Bool
  is_zero: Bool
  sign: Bool
  signed_exponent: SInt(exponent_width + 2)
  significand: Bits(significand_width + 1)

/* Constructs a floating-point status bundle with every exception deasserted. */
fun no_exception_flags() :~ ExceptionFlags():
  ExceptionFlags():
    invalid: Bool(#false)
    infinite: Bool(#false)
    overflow: Bool(#false)
    underflow: Bool(#false)
    inexact: Bool(#false)

export:
  FloatFormat
  IEEEFloat
  RecFloat
  RoundingOptions
  RoundingMode
  TininessMode
  MulAddOperation
  MinMaxOperation
  Estimate7Operation
  FloatClass
  ExceptionFlags
  IntegerExceptionFlags
  MultiplyAddPipelineUsage
  RawFloat
  no_exception_flags
