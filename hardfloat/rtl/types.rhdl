#lang rhodium
// Defines host format parameters and packed hardware types for the Berkeley HardFloat port.
// Derived from hardfloat/src/main/scala/common.scala at upstream commit c1105e6.
// Copyright 2010-2018 The Regents of the University of California.
// SPDX-License-Identifier: BSD-3-Clause; see ../LICENSE.md.

class FloatFormat(exponent_width :: PosInt, significand_width :: PosInt):
  implements StableCircuitParam

  constructor (exponent_width :: PosInt, significand_width :: PosInt):
    unless exponent_width >= 3
    | error(~who: #'FloatFormat, "exponent width must be at least three")
    unless significand_width >= 3
    | error(~who: #'FloatFormat, "significand width must be at least three")
    unless significand_width <= ((1 << (exponent_width - 2)) + 3)
    | error(~who: #'FloatFormat,
            "significand width exceeds the HardFloat format limit")
    super(exponent_width, significand_width)

  property ieee_width :: PosInt:
    exponent_width + significand_width
  property recoded_width :: PosInt:
    ieee_width + 1

namespace ~extend FloatFormat:
  def F16 = FloatFormat(5, 11)
  def BF16 = FloatFormat(8, 8)
  def F32 = FloatFormat(8, 24)
  def F64 = FloatFormat(11, 53)

  export:
    F16
    BF16
    F32
    F64

// These nominal packed types distinguish an architectural IEEE image from
// HardFloat's recoded representation and retain the exact format in connection
// checking. Both lower as ordinary scalar integers through the core IR.
hardware_type IEEEFloat(format :: FloatFormat):
  width: format.ieee_width
  type_key: [format.exponent_width, format.significand_width]
  describe:
    "ieee-float<" ++ to_string(format.exponent_width) ++ "," ++ to_string(format.significand_width) ++ ">"

hardware_type RecFloat(format :: FloatFormat):
  width: format.recoded_width
  type_key: [format.exponent_width, format.significand_width]
  describe:
    "rec-float<" ++ to_string(format.exponent_width) ++ "," ++ to_string(format.significand_width) ++ ">"

class RoundingOptions(significand_msb_always_zero :: Boolean = #false,
                      subnormals_always_exact :: Boolean = #false,
                      never_underflows :: Boolean = #false,
                      never_overflows :: Boolean = #false):
  implements StableCircuitParam

  constructor (significand_msb_always_zero :: Boolean = #false,
               subnormals_always_exact :: Boolean = #false,
               never_underflows :: Boolean = #false,
               never_overflows :: Boolean = #false):
    super(significand_msb_always_zero,
          subnormals_always_exact,
          never_underflows,
          never_overflows)

namespace ~extend RoundingOptions:
  def Default = RoundingOptions()

  export:
    Default

hardware_enum RoundingMode(~width: 3):
  NearEven = 0
  MinMagnitude = 1
  Minimum = 2
  Maximum = 3
  NearMaximumMagnitude = 4
  Odd = 6

hardware_enum TininessMode(~width: 1):
  BeforeRounding = 0
  AfterRounding = 1

hardware_enum MulAddOperation(~width: 2):
  MultiplyAdd = 0
  MultiplySubtract = 1
  NegatedMultiplyAdd = 2
  NegatedMultiplySubtract = 3

hardware_enum MinMaxOperation(~width: 2):
  Minimum = 0
  Maximum = 1
  MinimumNumber = 2
  MaximumNumber = 3

hardware_enum FloatClass(~encoding: one_hot):
  NegativeInfinity
  NegativeNormal
  NegativeSubnormal
  NegativeZero
  PositiveZero
  PositiveSubnormal
  PositiveNormal
  PositiveInfinity
  SignalingNaN
  QuietNaN

bundle ExceptionFlags():
  invalid: Bool
  infinite: Bool
  overflow: Bool
  underflow: Bool
  inexact: Bool

bundle IntegerExceptionFlags():
  invalid: Bool
  overflow: Bool
  inexact: Bool

// Names the four consecutive multiplier pipeline stages. More than one stage
// can be occupied concurrently, so this is deliberately not a one-hot type.
bundle MultiplyAddPipelineUsage():
  stage_three: Bool
  stage_two: Bool
  stage_one: Bool
  stage_zero: Bool

bundle RawFloat(exponent_width :: PosInt, significand_width :: PosInt):
  is_nan: Bool
  is_infinite: Bool
  is_zero: Bool
  sign: Bool
  signed_exponent: SInt(exponent_width + 2)
  significand: Bits(significand_width + 1)

fun no_exception_flags() :~ ExceptionFlags():
  ExceptionFlags():
    invalid: Bool(#false)
    infinite: Bool(#false)
    overflow: Bool(#false)
    underflow: Bool(#false)
    inexact: Bool(#false)

export:
  FloatFormat
  IEEEFloat
  RecFloat
  RoundingOptions
  RoundingMode
  TininessMode
  MulAddOperation
  MinMaxOperation
  FloatClass
  ExceptionFlags
  IntegerExceptionFlags
  MultiplyAddPipelineUsage
  RawFloat
  no_exception_flags
