#lang rhombus
// Checks permanent HardFloat formats, public types, rounding modes, and validation.
// SPDX-License-Identifier: BSD-3-Clause; see ../LICENSE.md.

import:
  "../../rhodium/core/main.rhm" open
  "../main.rhdl" as hardfloat
def raw_type = hardfloat.RawFloat(5, 11)
def flags_type = hardfloat.ExceptionFlags()
def ieee_type = hardfloat.IEEEFloat(hardfloat.FloatFormat.F16)
def recoded_type = hardfloat.RecFloat(hardfloat.FloatFormat.F16)

check:
  hardfloat.FloatFormat.F16.exponent_width ~is 5
  hardfloat.FloatFormat.F16.significand_width ~is 11
  hardfloat.FloatFormat.F16.ieee_width ~is 16
  hardfloat.FloatFormat.F16.recoded_width ~is 17
  hardfloat.FloatFormat.BF16.ieee_width ~is 16
  hardfloat.FloatFormat.F32.recoded_width ~is 33
  hardfloat.FloatFormat.F64.recoded_width ~is 65
  hardfloat.FloatFormat.F16 == hardfloat.FloatFormat(5, 11) ~is #true
  hardfloat.RoundingOptions.Default == hardfloat.RoundingOptions() ~is #true
  hardfloat.FloatFormat(2, 11) ~throws "exponent width must be at least three"
  hardfloat.FloatFormat(5, 2) ~throws "significand width must be at least three"
  hardfloat.FloatFormat(3, 6) ~throws "significand width exceeds the HardFloat format limit"
  hardfloat.RoundingMode.packed_width() ~is 3
  hardfloat.TininessMode.packed_width() ~is 1
  ieee_type.bit_width() ~is 16
  recoded_type.bit_width() ~is 17
  type_equal(ieee_type, hardfloat.IEEEFloat(hardfloat.FloatFormat(5, 11))) ~is #true
  type_equal(recoded_type, hardfloat.RecFloat(hardfloat.FloatFormat(5, 11))) ~is #true
  type_equal(ieee_type, hardfloat.IEEEFloat(hardfloat.FloatFormat.BF16)) ~is #false
  type_equal(recoded_type, hardfloat.RecFloat(hardfloat.FloatFormat.BF16)) ~is #false
  type_equal(ieee_type, Bits(16)) ~is #false
  raw_type.packed_width() ~is 23
  flags_type.packed_width() ~is 5
  hardfloat.IntegerExceptionFlags().packed_width() ~is 3
  hardfloat.FloatClass.packed_width() ~is 10
