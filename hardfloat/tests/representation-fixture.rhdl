#lang rhodium
// Exercises permanent HardFloat representation, conversion, rounding, and arithmetic contracts in F16.
// SPDX-License-Identifier: BSD-3-Clause; see ../LICENSE.md.

import:
  "../main.rhdl" open
  lib("rhodium/std/bits.rhdl").count_leading_zeros

circuit HardFloatRepresentation():
  def format = FloatFormat.F16
  input a: IEEEFloat(format)
  input b: IEEEFloat(format)
  input signaling: Bool
  input invalid_exception: Bool
  input infinite_exception: Bool
  input rounding_mode: RoundingMode
  input tininess_mode: TininessMode
  input rounding_extra: Bits(2)
  input integer_value: Bits(16)
  input integer_signed: Bool
  input integer_output_signed: Bool
  input wide_ieee: IEEEFloat(FloatFormat.F32)
  input add_subtract: Bool
  input fma_c: IEEEFloat(format)
  input fma_operation: MulAddOperation
  output recoded_a: RecFloat(format)
  output restored_a: IEEEFloat(format)
  output classification: FloatClass
  output leading_zero_count: Bits(index_width(format.significand_width - 1))
  output descending_low_mask: Bits(12)
  output ascending_low_mask: Bits(12)
  output lt: Bool
  output eq: Bool
  output gt: Bool
  output exception_flags: ExceptionFlags()
  output rounded_recoded: RecFloat(format)
  output rounded_ieee: IEEEFloat(format)
  output rounding_flags: ExceptionFlags()
  output integer_as_ieee: IEEEFloat(format)
  output integer_conversion_flags: ExceptionFlags()
  output ieee_as_integer: Bits(16)
  output integer_result_flags: IntegerExceptionFlags()
  output widened_ieee: IEEEFloat(FloatFormat.F32)
  output widened_flags: ExceptionFlags()
  output narrowed_ieee: IEEEFloat(format)
  output narrowed_flags: ExceptionFlags()
  output product_ieee: IEEEFloat(format)
  output product_flags: ExceptionFlags()
  output sum_ieee: IEEEFloat(format)
  output sum_flags: ExceptionFlags()
  output fma_ieee: IEEEFloat(format)
  output fma_flags: ExceptionFlags()

  def encoded_a = a.to_recoded()
  def encoded_b = b.to_recoded()
  def packed_a = a.as_bits()
  recoded_a <== encoded_a
  restored_a <== encoded_a.to_ieee()
  classification <== encoded_a.classify()
  leading_zero_count <== packed_a[0..(format.significand_width - 1)].count_leading_zeros()
  descending_low_mask <== low_mask(packed_a[0..6], 6, 18)
  ascending_low_mask <== low_mask(packed_a[0..6], 18, 6)

  inst compare(CompareRecFN(format))
  compare.a <== encoded_a
  compare.b <== encoded_b
  compare.signaling <== signaling
  lt <== compare.lt
  eq <== compare.eq
  gt <== compare.gt
  exception_flags <== compare.exception_flags

  def expanded_raw = resize_raw_float(
    format.exponent_width,
    format.significand_width,
    format.exponent_width,
    format.significand_width + 2,
    a.to_raw()
  )
  def rounding_raw = RawFloat(format.exponent_width, (format.significand_width + 2)):
    is_nan: expanded_raw.is_nan
    is_infinite: expanded_raw.is_infinite
    is_zero: expanded_raw.is_zero
    sign: expanded_raw.sign
    signed_exponent: expanded_raw.signed_exponent
    significand: expanded_raw.significand ||| rounding_extra.zext(format.significand_width + 3)
  inst round(RoundRawFNToRecFN(format))
  round.invalid_exception <== invalid_exception
  round.infinite_exception <== infinite_exception
  round.raw <== rounding_raw
  round.rounding_mode <== rounding_mode
  round.tininess_mode <== tininess_mode
  rounded_recoded <== round.out
  rounded_ieee <== round.out.to_ieee()
  rounding_flags <== round.exception_flags

  inst integer_to_float(IntegerToRecFN(16, format))
  integer_to_float.signed_input <== integer_signed
  integer_to_float.value <== integer_value
  integer_to_float.rounding_mode <== rounding_mode
  integer_to_float.tininess_mode <== tininess_mode
  integer_as_ieee <== integer_to_float.out.to_ieee()
  integer_conversion_flags <== integer_to_float.exception_flags

  inst float_to_integer(RecFNToInteger(format, 16))
  float_to_integer.value <== encoded_a
  float_to_integer.rounding_mode <== rounding_mode
  float_to_integer.signed_output <== integer_output_signed
  ieee_as_integer <== float_to_integer.out
  integer_result_flags <== float_to_integer.exception_flags

  inst widen(RecFNToRecFN(format, FloatFormat.F32))
  widen.value <== encoded_a
  widen.rounding_mode <== rounding_mode
  widen.tininess_mode <== tininess_mode
  widened_ieee <== widen.out.to_ieee()
  widened_flags <== widen.exception_flags

  inst narrow(RecFNToRecFN(FloatFormat.F32, format))
  narrow.value <== wide_ieee.to_recoded()
  narrow.rounding_mode <== rounding_mode
  narrow.tininess_mode <== tininess_mode
  narrowed_ieee <== narrow.out.to_ieee()
  narrowed_flags <== narrow.exception_flags

  inst multiply(MulRecFN(format))
  multiply.a <== encoded_a
  multiply.b <== encoded_b
  multiply.rounding_mode <== rounding_mode
  multiply.tininess_mode <== tininess_mode
  product_ieee <== multiply.out.to_ieee()
  product_flags <== multiply.exception_flags

  inst add(AddRecFN(format))
  add.subtract <== add_subtract
  add.a <== encoded_a
  add.b <== encoded_b
  add.rounding_mode <== rounding_mode
  add.tininess_mode <== tininess_mode
  sum_ieee <== add.out.to_ieee()
  sum_flags <== add.exception_flags

  inst fused_multiply_add(MulAddRecFN(format))
  fused_multiply_add.operation <== fma_operation
  fused_multiply_add.a <== encoded_a
  fused_multiply_add.b <== encoded_b
  fused_multiply_add.c <== fma_c.to_recoded()
  fused_multiply_add.rounding_mode <== rounding_mode
  fused_multiply_add.tininess_mode <== tininess_mode
  fma_ieee <== fused_multiply_add.out.to_ieee()
  fma_flags <== fused_multiply_add.exception_flags

def design = elaborate(HardFloatRepresentation())
def minimum_add_design = elaborate(AddRecFN(FloatFormat(3, 3)))
def minimum_fma_design = elaborate(MulAddRecFN(FloatFormat(3, 3)))
def wide_integer_conversion_design = elaborate(RecFNToInteger(FloatFormat.F16, 64))

export:
  HardFloatRepresentation
  design
  minimum_add_design
  minimum_fma_design
  wide_integer_conversion_design
