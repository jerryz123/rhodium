#lang rhodium
/* Validates translated or Bare single-page vector proofs against PMA and admission epochs. */
// SPDX-License-Identifier: Apache-2.0

import:
  "vector.rhdl" open
  "vector-window.rhdl".vector_page_permitted
  "translation.rhdl".RiscvTlbLookup
  "protocol.rhdl".RiscvTranslationResult
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/rtl/pma.rhdl").RiscvPhysicalMemoryMap
  lib("riscv/rtl/hypervisor.rhdl").RiscvGuestTranslationContext
  lib("riscv/rtl/svpbmt.rhdl").PageMemoryType
  lib("flow/main.rhdl") open
  lib("rhodium/std/bits.rhdl") open

/* Issues a combinational certificate only for a caller-selected, permission-checked hit.
   The caller owns TLB arbitration and supplies the normal data context independently of
   concurrent explicit-guest requests. Invalidation advances the epoch at the edge;
   it suppresses new proofs immediately but does not change candidate timing.
   Bare specialization checks the full identity address and only candidate epochs;
   translation/current inputs are unused and may be tied off. */
sync_circuit VectorCertificate(xlen :: XLen, physical_map :: RiscvPhysicalMemoryMap, ~bare: bare :: Boolean = #false):
  interface check(VectorFastCheck(xlen), ~role: responder)
  interface translation(Valid(RiscvTranslationResult()), ~role: consumer)
  input current: RiscvTlbLookup()
  input invalidate: Bool

  reg epoch(~init: Bits(2)(0))
  when invalidate:
    epoch <== epoch + Bits(2)(1)

  def context_current = if bare | Bool(#true) | (check.candidate.virtualized === current.virtualized) & (check.candidate.context.as_bits() === current.context.as_bits())
  check.candidate_current <== (check.candidate.invalidation_epoch === epoch) & context_current
  def address :: Bits(64) = if bare | check.request.bits.first | translation.bits.physical_address.zext(64)
  def page = address.align_down(4096)
  def page_permitted = vector_page_permitted(physical_map, page, check.request.bits.store)
  def translation_permitted = if bare | Bool(#true) | translation.valid & !translation.bits.fault & !translation.bits.access_fault & (translation.bits.pbmt === PageMemoryType.PMA)
  def proof = check.request |> filter_valid(_range => !invalidate & translation_permitted & page_permitted)
  (proof |> map_valid(range => VectorFastCertificate(xlen)):
    range: range
    ppn: address[12..56]
    virtualized: if bare | Bool(#false) | current.virtualized
    context: if bare | literal(RiscvGuestTranslationContext(), 0) | current.context
    invalidation_epoch: epoch
  ) |> check.response

  when (check.request.valid):
    assert(check.request.bits.first[12..64] === check.request.bits.last[12..64], "vector_fast_range_is_one_page")

export VectorCertificate
