#lang rhodium
// Resolves conditional and unconditional control transfers from orthogonal controls.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("flow/main.rhdl") open

bundle BranchResolverControl():
  enable: Bool
  unconditional: Bool
  compare_equal: Bool
  signed_mode: Bool
  invert: Bool

bundle BranchResolverRequest(width :: PosInt):
  left: Bits(width)
  right: Bits(width)
  control: BranchResolverControl()

bundle BranchResult():
  taken: Bool

circuit BranchResolver(width :: PosInt):
  interface request(Valid(BranchResolverRequest(width)), ~role: consumer)
  interface result(Valid(BranchResult()), ~role: producer)

  (
    request |> map_valid(request_bits):
      def left = request_bits.left
      def right = request_bits.right
      def control = request_bits.control
      def equal = left === right
      def unsigned_less = left < right
      def left_sign = left[width - 1].into(Bool)
      def right_sign = right[width - 1].into(Bool)
      def sign_diff = left_sign ^ right_sign
      def less = mux(control.signed_mode & sign_diff, left_sign, unsigned_less)
      def comparison = mux(control.compare_equal, equal, less)
      def condition = control.unconditional ||| (comparison ^ control.invert)
      BranchResult():
        taken: control.enable & condition
  ) |> result

export:
  BranchResolverControl
  BranchResolverRequest
  BranchResult
  BranchResolver
