#lang rhodium
// Implements a shared RV32/RV64 integer, B, and Zicond execution datapath.
// SPDX-License-Identifier: Apache-2.0

import:
  "../riscv/isa/xlen.rhm" open

// Decode selects physical resources directly. Controls that do not affect the
// selected result can therefore remain don't-cares in the instruction table.
hardware_enum AluResultSelect:
  Adder
  Shift
  Logic
  Compare
  MinMax
  Count
  Rotate
  Unary

hardware_enum AluLogicSelect:
  And
  Or
  Xor

hardware_enum AluLogicRightSelect:
  Operand
  OneHot
  ConditionalMask

hardware_enum AluCountSelect:
  Leading
  Trailing
  Population

hardware_enum AluUnarySelect:
  OrCombineBytes
  ReverseBytes
  SignExtendByte
  SignExtendHalf
  ZeroExtendHalf

bundle AluControl():
  result_select: AluResultSelect
  logic_select: AluLogicSelect
  count_select: AluCountSelect
  unary_select: AluUnarySelect
  subtract: Bool
  signed_compare: Bool
  maximum: Bool
  shift_right: Bool
  arithmetic_shift: Bool
  extract_bit: Bool
  invert_right: Bool
  logic_right_select: AluLogicRightSelect
  unsigned_word: Bool
  shift_add_amount: Bits(2)
  word: Bool

// RV64 word operations compute modulo 32 bits, then sign-extend their result.
fun sign_extend_word(value :: Bits(32)) :: Bits(64):
  value.into(SInt(32)).sext(64).as_bits()

circuit ALU(xlen :: XLen):
  def width = xlen.width
  def shift_width = if xlen == XLen.X32 | 5 | 6

  input(left, right): Bits(width)
  input control: AluControl()
  output result: Bits(width)

  def low_word :: Bits(32) = if xlen == XLen.X64 | left[0..32] | left
  def unsigned_word_left :: Bits(width) = if xlen == XLen.X64 | low_word.zext(width) | left

  // Zba operand preparation feeds the ordinary adder instead of introducing
  // another shift-add result path.
  def adder_left = mux(control.unsigned_word, unsigned_word_left, left) << control.shift_add_amount
  def adder_right = mux(control.subtract, !right, right)
  def adder_result :: Bits(width) = adder_left + adder_right + control.subtract.as_bits().zext(width)

  // Signed and unsigned comparisons consume the subtraction result. MIN/MAX
  // consequently reuse the same comparison rather than building another one.
  def left_sign = left[width - 1].into(Bool)
  def right_sign = right[width - 1].into(Bool)
  def less = mux(left_sign === right_sign, adder_result[width - 1].into(Bool), mux(control.signed_compare, left_sign, right_sign))
  def minmax_result = mux(less ^ control.maximum, left, right)

  // One-hot and conditional-mask operands turn Zbs and Zicond into ordinary
  // logic operations. Optional inversion also provides ANDN/ORN/XNOR.
  def bit_index = right[0..shift_width]
  def bit_mask = one_hot(bit_index).into(Bits(width))
  def conditional_mask = mux(right.or_reduce(), !bits(0, width), bits(0, width))
  def logic_right_source = mux_lookup(
    control.logic_right_select,
    ~default: right,
    [
      [AluLogicRightSelect.OneHot, bit_mask],
      [AluLogicRightSelect.ConditionalMask, conditional_mask]
    ]
  )
  def logic_right = mux(control.invert_right, !logic_right_source, logic_right_source)
  def xor_result = left ^ logic_right
  def and_result = left & logic_right
  def or_result = xor_result ||| and_result
  def logic_result = mux_lookup(
    control.logic_select,
    ~default: and_result,
    [
      [AluLogicSelect.Or, or_result],
      [AluLogicSelect.Xor, xor_result]
    ]
  )

  // One signed right shifter implements SLL, SRL, SRA, SLLI.UW and BEXT.
  // Left shifts reverse the input and output around that shared shifter.
  def word_shift_amount = right[0..5]
  def shift_amount :: Bits(shift_width) = if xlen == XLen.X64 | right[0..6] | word_shift_amount
  def effective_shift_amount = if xlen == XLen.X64 | mux(control.word, word_shift_amount.zext(6), shift_amount) | shift_amount
  def word_shift_source :: Bits(width):
    if xlen == XLen.X64
    | mux(control.arithmetic_shift, low_word.into(SInt(32)).sext(64).as_bits(), unsigned_word_left)
    | left
  def shift_source = if xlen == XLen.X64 | mux(control.word, word_shift_source, mux(control.unsigned_word, unsigned_word_left, left)) | left
  def reversed_shift_source :: Bits(width) = concat(for List (index in 0..width): shift_source[index])
  def shifter_input = mux(control.shift_right, shift_source, reversed_shift_source)
  def shift_fill = control.arithmetic_shift & shifter_input[width - 1].into(Bool)
  def extended_shift_input = (shift_fill.as_bits() ++ shifter_input).into(SInt(width + 1))
  def shifted_with_fill = (extended_shift_input >> effective_shift_amount).as_bits()
  def shifted_right = shifted_with_fill[0..width]
  def reversed_shift_result :: Bits(width) = concat(for List (index in 0..width): shifted_right[index])
  def shared_shift_result = mux(control.shift_right, shifted_right, reversed_shift_result)
  def shift_result = mux(control.extract_bit, shared_shift_result[0].zext(width), shared_shift_result)
  // Rotates reuse the shared shift result and add only the complementary half.
  def word_shift_complement = -word_shift_amount
  def shift_complement = -shift_amount
  def effective_shift_complement = if xlen == XLen.X64 | mux(control.word, word_shift_complement.zext(6), shift_complement) | shift_complement
  def rotate_other_input = mux(control.shift_right, reversed_shift_source, shift_source)
  def rotate_other_shifted = rotate_other_input >> effective_shift_complement
  def reversed_rotate_other :: Bits(width) = concat(for List (index in 0..width): rotate_other_shifted[index])
  def rotate_other = mux(control.shift_right, reversed_rotate_other, rotate_other_shifted)
  def rotate_result = shared_shift_result ||| rotate_other

  // Word/full and leading/trailing selection happens before counting, leaving
  // one priority encoder and one population-count network in the RV64 ALU.
  def count_source = if xlen == XLen.X64 | mux(control.word, unsigned_word_left, left) | left
  def reversed_full_count_source :: Bits(width) = concat(for List (index in 0..width): left[index])
  def reversed_word_count_source :: Bits(32) = concat(for List (index in 0..32): low_word[index])
  def reversed_count_source:
    if xlen == XLen.X64
    | mux(control.word, reversed_word_count_source.zext(width), reversed_full_count_source)
    | reversed_full_count_source
  def count_input = mux(control.count_select === AluCountSelect.Leading, reversed_count_source, count_source)
  def count_index = priority_encoder(count_input)
  def active_count_width = if xlen == XLen.X64 | mux(control.word, bits(32, width), bits(width, width)) | bits(width, width)
  def zero_count = mux(count_input.or_reduce(), count_index.zext(width), active_count_width)
  def population_count = popcount(count_source).zext(width)
  def count_result = mux(control.count_select === AluCountSelect.Population, population_count, zero_count)

  // These unary transforms are genuinely distinct from the shared arithmetic,
  // logic, shift and count resources.
  def byte_results = for List (byte in 0..(width / 8)):
    mux(left[(byte * 8)..((byte + 1) * 8)].or_reduce(), bits(0xff, 8), bits(0, 8))
  def or_combine_bytes = concat(byte_results.reverse())
  def reversed_bytes = for List (byte in 0..(width / 8)):
    left[(byte * 8)..((byte + 1) * 8)]
  def reverse_bytes = concat(reversed_bytes)
  def unary_result :: Bits(width) = mux_lookup(
    control.unary_select,
    ~default: dont_care(Bits(width)),
    [
      [AluUnarySelect.OrCombineBytes, or_combine_bytes],
      [AluUnarySelect.ReverseBytes, reverse_bytes],
      [AluUnarySelect.SignExtendByte, left[0..8].into(SInt(8)).sext(width).as_bits()],
      [AluUnarySelect.SignExtendHalf, left[0..16].into(SInt(16)).sext(width).as_bits()],
      [AluUnarySelect.ZeroExtendHalf, left[0..16].zext(width)]
    ]
  )

  def selected_result :: Bits(width) = mux_lookup(
    control.result_select,
    ~default: dont_care(Bits(width)),
    [
      [AluResultSelect.Adder, adder_result],
      [AluResultSelect.Shift, shift_result],
      [AluResultSelect.Logic, logic_result],
      [AluResultSelect.Compare, less.as_bits().zext(width)],
      [AluResultSelect.MinMax, minmax_result],
      [AluResultSelect.Count, count_result],
      [AluResultSelect.Rotate, rotate_result],
      [AluResultSelect.Unary, unary_result]
    ]
  )

  result <== if xlen == XLen.X64 | mux(control.word, sign_extend_word(selected_result[0..32]), selected_result) | selected_result

export:
  AluResultSelect
  AluLogicSelect
  AluLogicRightSelect
  AluCountSelect
  AluUnarySelect
  AluControl
  ALU
