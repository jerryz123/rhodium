    source_precision: FloatPrecision.Half
    comparison: FloatComparison.Less
    comparison_signaling: Bool(#false)

/* Joins metadata-derived register controls with exact-one FP execution rows. */
fun compose_floating_point_control_cases(instructions :: List.of(InstructionSpec), execution_cases :: List.of(DecodeCase)):
  for List (instruction in instructions):
    block:
      def input = instruction_pattern(instruction)
      DecodeCase(
        input,
        pattern(FloatingPointControl()):
          registers: register_control(instruction)
          execution: component_output(execution_cases, input)
      )

def RV32FFloatingPointInstructions = f.RV32FInstructions
def RV64FFloatingPointInstructions = f.RV64FInstructions
def RV32FDFloatingPointInstructions = f.RV32FInstructions ++ d.RV32DInstructions
def RV64FDFloatingPointInstructions = f.RV64FInstructions ++ d.RV64DInstructions
def RV32FFloatingPointControlCases = compose_floating_point_control_cases(RV32FFloatingPointInstructions, SingleExecutionCases)
def RV64FFloatingPointControlCases = compose_floating_point_control_cases(RV64FFloatingPointInstructions, RV64SingleExecutionCases)
def RV32FDFloatingPointControlCases = compose_floating_point_control_cases(RV32FDFloatingPointInstructions, SingleExecutionCases ++ DoubleExecutionCases)
def RV64FDFloatingPointControlCases = compose_floating_point_control_cases(RV64FDFloatingPointInstructions, RV64SingleExecutionCases ++ RV64DoubleExecutionCases)
def RV32FFloatingPointDecode = ValidDecodeGen(RV32FFloatingPointControlCases)
def RV64FFloatingPointDecode = ValidDecodeGen(RV64FFloatingPointControlCases)
def RV32FDFloatingPointDecode = ValidDecodeGen(RV32FDFloatingPointControlCases)
def RV64FDFloatingPointDecode = ValidDecodeGen(RV64FDFloatingPointControlCases)

/* Selects minimal/full half-precision catalogs, adding D conversions and XLEN-specific integer
   forms. */
fun fp_half_instructions(xlen :: XLen, profile :: FloatingPointProfile, half_precision :: HalfPrecisionProfile) :: List.of(InstructionSpec):
  cond
  | half_precision == HalfPrecisionProfile.None: []
  | half_precision == HalfPrecisionProfile.Zfhmin:
      zfhmin.ZfhminInstructions ++ if profile == FloatingPointProfile.D | zfhmin.ZfhminDInstructions | []
  | ~else:
      (if xlen == XLen.X32 | zfh.RV32ZfhInstructions | zfh.RV64ZfhInstructions) ++ (
        if profile == FloatingPointProfile.D | zfhmin.ZfhminDInstructions | []
      )

/* Selects matching half-precision physical execution rows for the scalar profile. */
fun fp_half_execution_cases(xlen :: XLen, profile :: FloatingPointProfile, half_precision :: HalfPrecisionProfile) :: List.of(DecodeCase):
  cond
  | half_precision == HalfPrecisionProfile.None: []
  | half_precision == HalfPrecisionProfile.Zfhmin:
      HalfMinimalExecutionCases ++ if profile == FloatingPointProfile.D | HalfDoubleExecutionCases | []
  | ~else:
      HalfMinimalExecutionCases ++ (
        if xlen == XLen.X32 | HalfExecutionCases | RV64HalfExecutionCases
      ) ++ if profile == FloatingPointProfile.D | HalfDoubleExecutionCases | []

/* Selects Zfa catalogs by precision, optionally admitting FLI.H without full scalar Zfh. */
fun fp_zfa_instructions(profile :: FloatingPointProfile,
                        half_precision :: HalfPrecisionProfile,
                        enabled :: Boolean,
                        ~half_immediate: half_immediate_enabled :: Boolean = #false) :: List.of(InstructionSpec):
  if !enabled
  | []
  | zfa.ZfaSingleInstructions ++ (
      if profile == FloatingPointProfile.D | zfa.ZfaDoubleInstructions | []
    ) ++ (
      if half_precision == HalfPrecisionProfile.Zfh | zfa.ZfaHalfInstructions | (if half_immediate_enabled | [zfa.FLI_H] | [])
    )

/* Selects the Zfa execution relation matching the enabled precision/immediate catalog. */
fun fp_zfa_execution_cases(profile :: FloatingPointProfile,
                           half_precision :: HalfPrecisionProfile,
                           enabled :: Boolean,
                           ~half_immediate: half_immediate_enabled :: Boolean = #false) :: List.of(DecodeCase):
  if !enabled
  | []
  | SingleZfaExecutionCases ++ (
      if profile == FloatingPointProfile.D | DoubleZfaExecutionCases | []
    ) ++ (
      if half_precision == HalfPrecisionProfile.Zfh | HalfZfaExecutionCases | (if half_immediate_enabled | [HalfZfaExecutionCases[0]] | [])
    )

/* Combines base FP, half-precision, and Zfa instruction catalogs for the chosen specialization. */
fun fp_instructions(xlen :: XLen,
                    profile :: FloatingPointProfile,
                    half_precision :: HalfPrecisionProfile,
                    ~zfa: zfa_enabled :: Boolean = #false,
                    ~zfa_half_immediate: zfa_half_immediate_enabled :: Boolean = #false) :: List.of(InstructionSpec):
  def base = cond
  | profile == FloatingPointProfile.None: []
  | xlen == XLen.X32: RV32FFloatingPointInstructions
  | ~else: RV64FDFloatingPointInstructions
  base ++ fp_half_instructions(xlen, profile, half_precision) ++ fp_zfa_instructions(profile, half_precision, zfa_enabled, ~half_immediate: zfa_half_immediate_enabled)

/* Builds complete FP controls from selected catalogs and matching execution relations. */
fun fp_control_cases(xlen :: XLen,
                     profile :: FloatingPointProfile,
                     half_precision :: HalfPrecisionProfile,
                     ~zfa: zfa_enabled :: Boolean = #false,
                     ~zfa_half_immediate: zfa_half_immediate_enabled :: Boolean = #false) :: List.of(DecodeCase):
  def base_execution = cond
  | profile == FloatingPointProfile.None: []
  | xlen == XLen.X32: SingleExecutionCases
  | ~else: RV64SingleExecutionCases ++ RV64DoubleExecutionCases
  def execution = base_execution ++ fp_half_execution_cases(xlen, profile, half_precision) ++ fp_zfa_execution_cases(profile, half_precision, zfa_enabled, ~half_immediate: zfa_half_immediate_enabled)
  compose_floating_point_control_cases(
    fp_instructions(xlen, profile, half_precision, ~zfa: zfa_enabled, ~zfa_half_immediate: zfa_half_immediate_enabled),
    execution
  )

/* Validates scalar FP selection and emits its combined register/execution decode; disabled FP
   never matches. */
circuit FloatingPointInstructionDecoder(
  xlen :: XLen,
  profile :: FloatingPointProfile,
  half_precision :: HalfPrecisionProfile = DefaultHalfPrecisionProfile,
  ~zfa: zfa_enabled :: Boolean = #false,
  ~zfa_half_immediate: zfa_half_immediate_enabled :: Boolean = #false
):
  check_fp_profile(xlen, profile, half_precision, ~zfa: zfa_enabled)
  input instruction: Bits(32)
  output valid: Bool
  output control: FloatingPointControl()

  def disabled = DecodeResult(FloatingPointControl()):
    valid: Bool(#false)
    value: dont_care(FloatingPointControl())
  def decoded :: DecodeResult(FloatingPointControl()):
    if profile == FloatingPointProfile.None
    | disabled
    | ValidDecodeGen(
        fp_control_cases(xlen, profile, half_precision, ~zfa: zfa_enabled, ~zfa_half_immediate: zfa_half_immediate_enabled)
      )(instruction)
  valid <== decoded.valid
  control <== decoded.value

