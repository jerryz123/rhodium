#lang rhombus
// Defines a program for the shared double-profile floating-point register file.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../../riscv/isa/fp-profile.rhm" open
  "../../register-file.rhdl" as register_file

def program = elaborate(register_file.FloatingPointRegisterFile(FloatingPointProfile.D))
export program
