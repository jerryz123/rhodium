#lang rhodium
/* Implements shared combinational F/D/half-precision and Zfa execution datapaths. */
// SPDX-License-Identifier: Apache-2.0

import:
  "bundles.rhdl" open
  "types.rhdl" open
  "../../riscv/isa/fp-profile.rhm" open
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/rtl/floating-point.rhdl" open
  lib("hardfloat/main.rhdl") open
  lib("rhodium/std/bits.rhdl") open

/* Transfers raw FP bits to XLEN with RISC-V move extension when the format fits. */
fun fp_move_to_integer(xlen :: XLen,
                       format :: FloatFormat,
                       value :: IEEEFloat(format)) :~ Bits(xlen.width):
  if format.ieee_width <= xlen.width
  | riscv_float_to_integer_move(xlen, format, value)
  | bits(0, xlen.width)

/* Transfers raw integer bits into an IEEE format when XLEN covers that format. */
fun integer_move_to_fp(xlen :: XLen,
                       format :: FloatFormat,
                       value :: Bits(xlen.width)) :~ IEEEFloat(format):
  if xlen.width >= format.ieee_width
  | riscv_integer_to_float_move(format, xlen.width, value)
  | bits(0, format.ieee_width).into(IEEEFloat(format))

/* Normalizes a 32-bit signed or unsigned conversion source to XLEN. */
fun fp_integer_word_input(xlen :: XLen,
                          value :: Bits(xlen.width),
                          unsigned :: Bool) :~ Bits(xlen.width):
  if xlen == XLen.X32
  | value
  | mux(unsigned,
        value[0..32].zext(64),
        value[0..32].into(SInt(32)).sext(64).as_bits())

/* Sign-extends a converted 32-bit result to XLEN, including unsigned word conversions. */
fun fp_integer_word_result(xlen :: XLen,
                           value :: Bits(32)) :~ Bits(xlen.width):
  if xlen == XLen.X32
  | value
  | value.into(SInt(32)).sext(64).as_bits()

/* Normalizes byte, halfword, or word integer sources according to conversion signedness. */
fun fp_integer_narrow_input(xlen :: XLen,
                            value :: Bits(xlen.width),
                            integer_width :: FloatIntegerWidth,
                            unsigned :: Bool) :~ Bits(xlen.width):
  def byte = mux(unsigned, value[0..8].zext(xlen.width), value[0..8].into(SInt(8)).sext(xlen.width).as_bits())
  def half = mux(unsigned, value[0..16].zext(xlen.width), value[0..16].into(SInt(16)).sext(xlen.width).as_bits())
  mux_lookup(integer_width, ~default: value, [[FloatIntegerWidth.Byte, byte], [FloatIntegerWidth.Half, half], [FloatIntegerWidth.Word, fp_integer_word_input(xlen, value, unsigned)]])

/* Extends byte or halfword conversion results according to destination signedness. */
fun fp_integer_narrow_result(xlen :: XLen,
                             value :: Bits(16),
                             integer_width :: FloatIntegerWidth,
                             unsigned :: Bool) :~ Bits(xlen.width):
  def byte = mux(unsigned, value[0..8].zext(xlen.width), value[0..8].into(SInt(8)).sext(xlen.width).as_bits())
  def half = mux(unsigned, value.zext(xlen.width), value.into(SInt(16)).sext(xlen.width).as_bits())
  mux(integer_width === FloatIntegerWidth.Byte, byte, half)

/* Supplies inactive Zfa outputs without instantiating rounding or modulo arithmetic. */
circuit DisabledZfaFormatDatapath(format :: FloatFormat):
  input value: RecFloat(format)
  input rounding_mode: RoundingMode
  input raise_inexact: Bool
  input immediate_index: Bits(5)
  output immediate: IEEEFloat(format)
  output rounded: RecFloat(format)
  output round_exception_flags: Bits(5)
  output modulo: Bits(32)
  output modulo_exception_flags: Bits(5)

  immediate <== dont_care(IEEEFloat(format))
  rounded <== dont_care(RecFloat(format))
  round_exception_flags <== bits(0, 5)
  modulo <== bits(0, 32)
  modulo_exception_flags <== bits(0, 5)

/* Supplies zero modulo outputs when the format has no enabled modulo conversion. */
circuit DisabledZfaModulo(format :: FloatFormat):
  input value: RecFloat(format)
  output result: Bits(32)
  output exception_flags: Bits(5)

  result <== bits(0, 32)
  exception_flags <== bits(0, 5)

/* Implements signed 32-bit modulo conversion with round-toward-zero and RISC-V flags. */
circuit ZfaModulo(format :: FloatFormat):
  input value: RecFloat(format)
  output result: Bits(32)
  output exception_flags: Bits(5)

  inst convert(RecFNToIntegerModulo(format, 32))
  convert.value <== value
  convert.rounding_mode <== RoundingMode.MinMagnitude
  convert.signed_output <== Bool(#true)
  result <== convert.out
  exception_flags <== riscv_integer_exception_flags(convert.exception_flags)

/* Combines Zfa immediates, rounding to integral, and optional modulo conversion for one format. */
circuit ZfaFormatDatapath(format :: FloatFormat,
                          ~modulo: modulo_enabled :: Boolean = #false):
  input value: RecFloat(format)
  input rounding_mode: RoundingMode
  input raise_inexact: Bool
  input immediate_index: Bits(5)
  output immediate: IEEEFloat(format)
  output rounded: RecFloat(format)
  output round_exception_flags: Bits(5)
  output modulo: Bits(32)
  output modulo_exception_flags: Bits(5)

  inst round(RoundToIntegralRecFN(format))
  round.value <== value
  round.rounding_mode <== rounding_mode
  round.raise_inexact <== raise_inexact
  def ModuloModule = if modulo_enabled | ZfaModulo(format) | DisabledZfaModulo(format)
  inst modulo_convert(ModuloModule)
  modulo_convert.value <== value
  immediate <== riscv_float_immediate(format, immediate_index)
  rounded <== round.out
  round_exception_flags <== riscv_exception_flags(round.exception_flags)
  modulo <== modulo_convert.result
  modulo_exception_flags <== modulo_convert.exception_flags

/* Computes one format's fixed-path operations combinationally using HardFloat.
   Unboxes numerical operands, canonicalizes arithmetic NaNs, boxes FP results,
   and selects integer values and exception flags from the decoded unit. */
circuit FpFormatDatapath(
  xlen :: XLen,
  profile :: FloatingPointProfile,
  format :: FloatFormat,
  Tag :: DataType,
  ~zfa: zfa_enabled :: Boolean = #false,
  ~zfa_modulo: zfa_modulo_enabled :: Boolean = #false
):
  def width = xlen.width
  def flen = floating_point_register_width(profile)
  unless flen >= format.ieee_width
  | error(~who: #'FpFormatDatapath,
          "floating-point register width must cover the selected format")

  input request: FpExecutionRequest(xlen, profile, Tag)
  output completion: FpExecutionResult(xlen, profile, Tag)

  def control = request.control.execution
  def left = riscv_unbox(format, flen, request.left)
  def right = riscv_unbox(format, flen, request.right)
  def third = riscv_unbox(format, flen, request.third)
  def left_recoded = left.to_recoded()
  def right_recoded = right.to_recoded()
  def third_recoded = third.to_recoded()

  inst add(AddRecFN(format))
  add.subtract <== control.add_operation === FloatAddOperation.Subtract
  add.a <== left_recoded
  add.b <== right_recoded
  add.rounding_mode <== request.rounding_mode
  add.tininess_mode <== TininessMode.AfterRounding

  inst multiply(MulRecFN(format))
  multiply.a <== left_recoded
  multiply.b <== right_recoded
  multiply.rounding_mode <== request.rounding_mode
  multiply.tininess_mode <== TininessMode.AfterRounding

  inst fused(MulAddRecFN(format))
  fused.operation <== control.fused_operation
  fused.a <== left_recoded
  fused.b <== right_recoded
  fused.c <== third_recoded
  fused.rounding_mode <== request.rounding_mode
  fused.tininess_mode <== TininessMode.AfterRounding

  inst compare(CompareRecFN(format))
  compare.a <== left_recoded
  compare.b <== right_recoded
  compare.signaling <== control.comparison_signaling
  def comparison_value = mux_lookup(
    control.comparison,
    ~default: compare.eq,
    [
      [FloatComparison.NotEqual, !compare.eq],
      [FloatComparison.Less, compare.lt],
      [FloatComparison.LessEqual, compare.lt ||| compare.eq]
    ]
  )

  inst minmax(MinMaxRecFN(format))
  minmax.a <== left_recoded
  minmax.b <== right_recoded
  minmax.operation <== control.minmax_operation

  inst estimate(Estimate7(format))
  estimate.value <== left
  estimate.operation <== control.estimate_operation
  estimate.rounding_mode <== request.rounding_mode

  def ZfaModule = if zfa_enabled | ZfaFormatDatapath(format, ~modulo: zfa_modulo_enabled) | DisabledZfaFormatDatapath(format)
  inst zfa(ZfaModule)
  zfa.value <== left_recoded
  zfa.rounding_mode <== request.rounding_mode
  zfa.raise_inexact <== control.round_raise_inexact
  zfa.immediate_index <== request.immediate_index

  def normalized_integer = fp_integer_narrow_input(xlen, request.integer_operand, control.integer_width, control.integer_unsigned)
  inst integer_to_fp(IntegerToRecFN(width, format))
  integer_to_fp.signed_input <== !control.integer_unsigned
  integer_to_fp.value <== normalized_integer
  integer_to_fp.rounding_mode <== request.rounding_mode
  integer_to_fp.tininess_mode <== TininessMode.AfterRounding

  inst fp_to_byte(RecFNToInteger(format, 8))
  fp_to_byte.value <== left_recoded
  fp_to_byte.rounding_mode <== request.rounding_mode
  fp_to_byte.signed_output <== !control.integer_unsigned
  inst fp_to_half(RecFNToInteger(format, 16))
  fp_to_half.value <== left_recoded
  fp_to_half.rounding_mode <== request.rounding_mode
  fp_to_half.signed_output <== !control.integer_unsigned
  inst fp_to_word(RecFNToInteger(format, 32))
  fp_to_word.value <== left_recoded
  fp_to_word.rounding_mode <== request.rounding_mode
  fp_to_word.signed_output <== !control.integer_unsigned
  inst fp_to_integer(RecFNToInteger(format, width))
  fp_to_integer.value <== left_recoded
  fp_to_integer.rounding_mode <== request.rounding_mode
  fp_to_integer.signed_output <== !control.integer_unsigned
  def converted_narrow = fp_integer_narrow_result(xlen, mux(control.integer_width === FloatIntegerWidth.Byte, fp_to_byte.out.zext(16), fp_to_half.out), control.integer_width, control.integer_unsigned)
  def converted_integer = mux_lookup(control.integer_width, ~default: fp_to_integer.out, [[FloatIntegerWidth.Byte, converted_narrow], [FloatIntegerWidth.Half, converted_narrow], [FloatIntegerWidth.Word, fp_integer_word_result(xlen, fp_to_word.out)]])
  def conversion_flags = mux_lookup(control.integer_width, ~default: riscv_integer_exception_flags(fp_to_integer.exception_flags), [[FloatIntegerWidth.Byte, riscv_integer_exception_flags(fp_to_byte.exception_flags)], [FloatIntegerWidth.Half, riscv_integer_exception_flags(fp_to_half.exception_flags)], [FloatIntegerWidth.Word, riscv_integer_exception_flags(fp_to_word.exception_flags)]])

  def sign_value = riscv_sign_inject(format, left, right, control.sign_operation)
  def move_source = request.left[0..format.ieee_width].into(IEEEFloat(format))
  def integer_move_value = fp_move_to_integer(xlen, format, move_source)
  def fp_move_value = integer_move_to_fp(xlen, format, request.integer_operand)
  def class_value = riscv_classify(format, left).zext(width)
  def fp_destination = request.control.registers.destination === FloatDestination.FloatingPoint
  def converted_fp = riscv_canonicalize_nan(format, integer_to_fp.out.to_ieee())
  def arithmetic_fp = mux_lookup(
    control.unit,
    ~default: riscv_canonical_nan(format),
    [
      [FloatUnit.FusedMultiplyAdd,
       riscv_canonicalize_nan(format, fused.out.to_ieee())],
      [FloatUnit.Add,
       riscv_canonicalize_nan(format, add.out.to_ieee())],
      [FloatUnit.Multiply,
       riscv_canonicalize_nan(format, multiply.out.to_ieee())],
      [FloatUnit.SignInject, sign_value],
      [FloatUnit.MinMax,
       riscv_canonicalize_nan(format, minmax.out.to_ieee())],
      [FloatUnit.Estimate, estimate.out],
      [FloatUnit.Convert, converted_fp],
      [FloatUnit.Move, fp_move_value],
      [FloatUnit.Immediate, zfa.immediate],
      [FloatUnit.RoundToIntegral,
       riscv_canonicalize_nan(format, zfa.rounded.to_ieee())]
    ]
  )
  def integer_value = mux_lookup(
    control.unit,
    ~default: bits(0, width),
    [
      [FloatUnit.Compare, comparison_value.as_bits().zext(width)],
      [FloatUnit.Convert, converted_integer],
      [FloatUnit.IntegerModulo,
       fp_integer_word_result(xlen, zfa.modulo)],
      [FloatUnit.Move, integer_move_value],
      [FloatUnit.Classify, class_value]
    ]
  )
  def exception_flags = mux_lookup(
    control.unit,
    ~default: bits(0, 5),
    [
      [FloatUnit.FusedMultiplyAdd,
       riscv_exception_flags(fused.exception_flags)],
      [FloatUnit.Add, riscv_exception_flags(add.exception_flags)],
      [FloatUnit.Multiply,
       riscv_exception_flags(multiply.exception_flags)],
      [FloatUnit.MinMax,
       riscv_exception_flags(minmax.exception_flags)],
      [FloatUnit.Estimate,
       riscv_exception_flags(estimate.exception_flags)],
      [FloatUnit.Compare,
       riscv_exception_flags(compare.exception_flags)],
      [FloatUnit.Convert,
       mux(fp_destination,
           riscv_exception_flags(integer_to_fp.exception_flags),
           conversion_flags)],
      [FloatUnit.RoundToIntegral, zfa.round_exception_flags],
      [FloatUnit.IntegerModulo, zfa.modulo_exception_flags]
    ]
  )
  def exception_flags_valid = control.unit.is_one_of(
    FloatUnit.FusedMultiplyAdd,
    FloatUnit.Add,
    FloatUnit.Multiply,
    FloatUnit.MinMax,
    FloatUnit.Estimate,
    FloatUnit.Compare,
    FloatUnit.Convert,
    FloatUnit.RoundToIntegral,
    FloatUnit.IntegerModulo
  )

  completion <== FpExecutionResult(xlen, profile, Tag):
    tag: request.tag
    integer_value: integer_value
    fp_value: riscv_nan_box(format, arithmetic_fp, flen)
    exception_flags: exception_flags
    exception_flags_valid: exception_flags_valid

/* Implements raw half-precision moves without arithmetic or accrued exception flags. */
circuit FpHalfMinimalDatapath(xlen :: XLen, profile :: FloatingPointProfile, Tag :: DataType):
  def flen = floating_point_register_width(profile)
  input request: FpExecutionRequest(xlen, profile, Tag)
  output completion: FpExecutionResult(xlen, profile, Tag)

  def format = FloatFormat.F16
  def source = request.left[0..format.ieee_width].into(IEEEFloat(format))
  completion <== FpExecutionResult(xlen, profile, Tag):
    tag: request.tag
    integer_value: fp_move_to_integer(xlen, format, source)
    fp_value: riscv_nan_box(format,
                            integer_move_to_fp(xlen, format, request.integer_operand),
                            flen)
    exception_flags: bits(0, 5)
    exception_flags_valid: Bool(#false)

/* Connects the F profile's combinational fixed path to a single-precision format datapath. */
circuit FpFixedF(xlen :: XLen,
                 Tag :: DataType,
                 ~zfa: zfa_enabled :: Boolean = #false):
  input request: FpExecutionRequest(xlen, FloatingPointProfile.F, Tag)
  output completion: FpExecutionResult(xlen, FloatingPointProfile.F, Tag)

  inst single(FpFormatDatapath(
    xlen,
    FloatingPointProfile.F,
    FloatFormat.F32,
    Tag,
    ~zfa: zfa_enabled
  ))
  single.request <== request
  completion <== single.completion

/* Promotes an unboxed single operand to double and retains promotion exception flags. */
circuit FpWidenSingle():
  input value: Bits(64)
  output widened: Bits(64)
  output exception_flags: Bits(5)

  inst convert(RecFNToRecFN(FloatFormat.F32, FloatFormat.F64))
  convert.value <== riscv_unbox(FloatFormat.F32, 64, value).to_recoded()
  convert.rounding_mode <== RoundingMode.NearEven
  convert.tininess_mode <== TininessMode.AfterRounding
  widened <== riscv_nan_box(FloatFormat.F64, convert.out.to_ieee(), 64)
  exception_flags <== riscv_exception_flags(convert.exception_flags)

/* Promotes an unboxed half operand to single and retains promotion exception flags. */
circuit FpWidenHalf(flen :: PosInt):
  input value: Bits(flen)
  output widened: Bits(flen)
  output exception_flags: Bits(5)

  inst convert(RecFNToRecFN(FloatFormat.F16, FloatFormat.F32))
  convert.value <== riscv_unbox(FloatFormat.F16, flen, value).to_recoded()
  convert.rounding_mode <== RoundingMode.NearEven
  convert.tininess_mode <== TininessMode.AfterRounding
  widened <== riscv_nan_box(FloatFormat.F32, convert.out.to_ieee(), flen)
  exception_flags <== riscv_exception_flags(convert.exception_flags)

/* Selects single/double fixed execution and cross-precision conversions.
   Widening arithmetic promotes each narrow operand independently and merges its flags. */
circuit FpFixedD(xlen :: XLen,
                 Tag :: DataType,
                 ~zfa: zfa_enabled :: Boolean = #false):
  input request: FpExecutionRequest(xlen, FloatingPointProfile.D, Tag)
  output completion: FpExecutionResult(xlen, FloatingPointProfile.D, Tag)

  inst single(FpFormatDatapath(
    xlen,
    FloatingPointProfile.D,
    FloatFormat.F32,
    Tag,
    ~zfa: zfa_enabled
  ))
  inst double(FpFormatDatapath(
    xlen,
    FloatingPointProfile.D,
    FloatFormat.F64,
    Tag,
    ~zfa: zfa_enabled,
    ~zfa_modulo: #true
  ))
  def control = request.control.execution
  def source_single = control.source_precision === FloatPrecision.Single
  def floating_point_destination = request.control.registers.destination === FloatDestination.FloatingPoint
  def widening_arithmetic = floating_point_destination & (control.destination_precision === FloatPrecision.Double) & control.unit.is_one_of(FloatUnit.Add, FloatUnit.Multiply, FloatUnit.FusedMultiplyAdd) & (
    (request.left_precision === FloatPrecision.Single) ||| (request.right_precision === FloatPrecision.Single) ||| ((control.unit === FloatUnit.FusedMultiplyAdd) & (request.third_precision === FloatPrecision.Single))
  )
  inst widen_left(FpWidenSingle())
  inst widen_right(FpWidenSingle())
  inst widen_third(FpWidenSingle())
  widen_left.value <== request.left
  widen_right.value <== request.right
  widen_third.value <== request.third
  def widened_request = request.updated(
    ~left: mux(request.left_precision === FloatPrecision.Single, widen_left.widened, request.left),
    ~right: mux(request.right_precision === FloatPrecision.Single, widen_right.widened, request.right),
    ~third: mux(request.third_precision === FloatPrecision.Single, widen_third.widened, request.third)
  )
  single.request <== request
  double.request <== mux(widening_arithmetic, widened_request, request)

  def ordinary_single = mux(floating_point_destination, control.destination_precision === FloatPrecision.Single, source_single)
  def cross_precision = floating_point_destination & request.control.registers.uses_frs1 & (
    control.unit === FloatUnit.Convert
  ) & (
    control.source_precision =/= control.destination_precision
  )
  def single_source = riscv_unbox(FloatFormat.F32, 64, request.left)
  def double_source = request.left.into(IEEEFloat(FloatFormat.F64))
  inst single_to_double(RecFNToRecFN(FloatFormat.F32, FloatFormat.F64))
  single_to_double.value <== single_source.to_recoded()
  single_to_double.rounding_mode <== request.rounding_mode
  single_to_double.tininess_mode <== TininessMode.AfterRounding
  inst double_to_single(RecFNToRecFN(FloatFormat.F64, FloatFormat.F32))
  double_to_single.value <== double_source.to_recoded()
  double_to_single.rounding_mode <== request.rounding_mode
  double_to_single.tininess_mode <== TininessMode.AfterRounding

  def ordinary = mux(ordinary_single, single.completion, double.completion)
  def converted_value = mux(
    source_single,
    riscv_nan_box(
      FloatFormat.F64,
      riscv_canonicalize_nan(FloatFormat.F64,
                             single_to_double.out.to_ieee()),
      64
    ),
    riscv_nan_box(
      FloatFormat.F32,
      riscv_canonicalize_nan(FloatFormat.F32,
                             double_to_single.out.to_ieee()),
      64
    )
  )
  def converted_flags = mux(
    source_single,
    riscv_exception_flags(single_to_double.exception_flags),
    riscv_exception_flags(double_to_single.exception_flags)
  )
  def left_widening_flags = mux(request.left_precision === FloatPrecision.Single, widen_left.exception_flags, bits(0, 5))
  def right_widening_flags = mux(request.right_precision === FloatPrecision.Single, widen_right.exception_flags, bits(0, 5))
  def third_widening_flags = mux(request.third_precision === FloatPrecision.Single, widen_third.exception_flags, bits(0, 5))
  def widening_flags = mux(
    control.unit === FloatUnit.FusedMultiplyAdd,
    left_widening_flags ||| right_widening_flags ||| third_widening_flags,
    left_widening_flags ||| right_widening_flags
  )
  completion <== ordinary.updated(
    ~fp_value: mux(cross_precision, converted_value, ordinary.fp_value),
    ~exception_flags: mux(cross_precision, converted_flags, ordinary.exception_flags ||| mux(widening_arithmetic, widening_flags, bits(0, 5)))
  )

/* Adds half moves or arithmetic and half/single conversion to the F fixed datapath. */
circuit FpFixedFHalf(xlen :: XLen,
                     Tag :: DataType,
                     ~arithmetic: arithmetic_enabled :: Boolean,
                     ~zfa: zfa_enabled :: Boolean = #false):
  def profile = FloatingPointProfile.F
  input request: FpExecutionRequest(xlen, profile, Tag)
  output completion: FpExecutionResult(xlen, profile, Tag)

  def HalfModule = if arithmetic_enabled | FpFormatDatapath(xlen, profile, FloatFormat.F16, Tag, ~zfa: zfa_enabled) | FpHalfMinimalDatapath(xlen, profile, Tag)
  inst half(HalfModule)
  inst single(FpFixedF(xlen, Tag, ~zfa: zfa_enabled))
  half.request <== request

  def control = request.control.execution
  def fp_destination = request.control.registers.destination === FloatDestination.FloatingPoint
  def widening_arithmetic = fp_destination & (control.destination_precision === FloatPrecision.Single) & control.unit.is_one_of(FloatUnit.Add, FloatUnit.Multiply, FloatUnit.FusedMultiplyAdd) & (
    (request.left_precision === FloatPrecision.Half) ||| (request.right_precision === FloatPrecision.Half) ||| ((control.unit === FloatUnit.FusedMultiplyAdd) & (request.third_precision === FloatPrecision.Half))
  )
  inst widen_left(FpWidenHalf(32))
  inst widen_right(FpWidenHalf(32))
  inst widen_third(FpWidenHalf(32))
  widen_left.value <== request.left
  widen_right.value <== request.right
  widen_third.value <== request.third
  def widened_request = request.updated(
    ~left: mux(request.left_precision === FloatPrecision.Half, widen_left.widened, request.left),
    ~right: mux(request.right_precision === FloatPrecision.Half, widen_right.widened, request.right),
    ~third: mux(request.third_precision === FloatPrecision.Half, widen_third.widened, request.third)
  )
  single.request <== mux(widening_arithmetic, widened_request, request)
  def ordinary_half = mux(fp_destination,
                          control.destination_precision === FloatPrecision.Half,
                          control.source_precision === FloatPrecision.Half)
  def cross_precision = fp_destination & request.control.registers.uses_frs1 & (control.unit === FloatUnit.Convert) & (
    control.source_precision =/= control.destination_precision
  )
  def half_source = riscv_unbox(FloatFormat.F16, 32, request.left)
  def single_source = riscv_unbox(FloatFormat.F32, 32, request.left)
  inst half_to_single(RecFNToRecFN(FloatFormat.F16, FloatFormat.F32))
  half_to_single.value <== half_source.to_recoded()
  half_to_single.rounding_mode <== request.rounding_mode
  half_to_single.tininess_mode <== TininessMode.AfterRounding
  inst single_to_half(RecFNToRecFN(FloatFormat.F32, FloatFormat.F16))
  single_to_half.value <== single_source.to_recoded()
  single_to_half.rounding_mode <== request.rounding_mode
  single_to_half.tininess_mode <== TininessMode.AfterRounding

  def ordinary = mux(ordinary_half, half.completion, single.completion)
  def source_half = control.source_precision === FloatPrecision.Half
  def converted_value = mux(
    source_half,
    riscv_nan_box(FloatFormat.F32, riscv_canonicalize_nan(FloatFormat.F32, half_to_single.out.to_ieee()), 32),
    riscv_nan_box(FloatFormat.F16, riscv_canonicalize_nan(FloatFormat.F16, single_to_half.out.to_ieee()), 32)
  )
  def converted_flags = mux(source_half,
                            riscv_exception_flags(half_to_single.exception_flags),
                            riscv_exception_flags(single_to_half.exception_flags))
  def left_widening_flags = mux(request.left_precision === FloatPrecision.Half, widen_left.exception_flags, bits(0, 5))
  def right_widening_flags = mux(request.right_precision === FloatPrecision.Half, widen_right.exception_flags, bits(0, 5))
  def third_widening_flags = mux(request.third_precision === FloatPrecision.Half, widen_third.exception_flags, bits(0, 5))
  def widening_flags = mux(control.unit === FloatUnit.FusedMultiplyAdd, left_widening_flags ||| right_widening_flags ||| third_widening_flags, left_widening_flags ||| right_widening_flags)
  completion <== ordinary.updated(
    ~fp_value: mux(cross_precision, converted_value, ordinary.fp_value),
    ~exception_flags: mux(cross_precision, converted_flags, ordinary.exception_flags ||| mux(widening_arithmetic, widening_flags, bits(0, 5))),
    ~exception_flags_valid: mux(cross_precision, Bool(#true), ordinary.exception_flags_valid)
  )

/* Adds half moves or arithmetic and half/single/double conversion to the D fixed datapath. */
circuit FpFixedDHalf(xlen :: XLen,
                     Tag :: DataType,
                     ~arithmetic: arithmetic_enabled :: Boolean,
                     ~zfa: zfa_enabled :: Boolean = #false):
  def profile = FloatingPointProfile.D
  input request: FpExecutionRequest(xlen, profile, Tag)
  output completion: FpExecutionResult(xlen, profile, Tag)

  def HalfModule = if arithmetic_enabled | FpFormatDatapath(xlen, profile, FloatFormat.F16, Tag, ~zfa: zfa_enabled) | FpHalfMinimalDatapath(xlen, profile, Tag)
  inst half(HalfModule)
  inst base(FpFixedD(xlen, Tag, ~zfa: zfa_enabled))
  half.request <== request

  def control = request.control.execution
  def fp_destination = request.control.registers.destination === FloatDestination.FloatingPoint
  def widening_arithmetic = fp_destination & (control.destination_precision === FloatPrecision.Single) & control.unit.is_one_of(FloatUnit.Add, FloatUnit.Multiply, FloatUnit.FusedMultiplyAdd) & (
    (request.left_precision === FloatPrecision.Half) ||| (request.right_precision === FloatPrecision.Half) ||| ((control.unit === FloatUnit.FusedMultiplyAdd) & (request.third_precision === FloatPrecision.Half))
  )
  inst widen_left(FpWidenHalf(64))
  inst widen_right(FpWidenHalf(64))
  inst widen_third(FpWidenHalf(64))
  widen_left.value <== request.left
  widen_right.value <== request.right
  widen_third.value <== request.third
  def widened_request = request.updated(
    ~left: mux(request.left_precision === FloatPrecision.Half, widen_left.widened, request.left),
    ~right: mux(request.right_precision === FloatPrecision.Half, widen_right.widened, request.right),
    ~third: mux(request.third_precision === FloatPrecision.Half, widen_third.widened, request.third)
  )
  base.request <== mux(widening_arithmetic, widened_request, request)
  def ordinary_half = mux(fp_destination,
                          control.destination_precision === FloatPrecision.Half,
                          control.source_precision === FloatPrecision.Half)
  def half_cross = fp_destination & request.control.registers.uses_frs1 & (control.unit === FloatUnit.Convert) & (
    (control.source_precision === FloatPrecision.Half) ||| (
      control.destination_precision === FloatPrecision.Half
    )
  )
  def half_source = riscv_unbox(FloatFormat.F16, 64, request.left)
  def single_source = riscv_unbox(FloatFormat.F32, 64, request.left)
  def double_source = request.left.into(IEEEFloat(FloatFormat.F64))
  inst half_to_single(RecFNToRecFN(FloatFormat.F16, FloatFormat.F32))
  inst single_to_half(RecFNToRecFN(FloatFormat.F32, FloatFormat.F16))
  inst half_to_double(RecFNToRecFN(FloatFormat.F16, FloatFormat.F64))
  inst double_to_half(RecFNToRecFN(FloatFormat.F64, FloatFormat.F16))
  half_to_single.value <== half_source.to_recoded()
  single_to_half.value <== single_source.to_recoded()
  half_to_double.value <== half_source.to_recoded()
  double_to_half.value <== double_source.to_recoded()
  half_to_single.rounding_mode <== request.rounding_mode
  single_to_half.rounding_mode <== request.rounding_mode
  half_to_double.rounding_mode <== request.rounding_mode
  double_to_half.rounding_mode <== request.rounding_mode
  half_to_single.tininess_mode <== TininessMode.AfterRounding
  single_to_half.tininess_mode <== TininessMode.AfterRounding
  half_to_double.tininess_mode <== TininessMode.AfterRounding
  double_to_half.tininess_mode <== TininessMode.AfterRounding

  def ordinary = mux(ordinary_half, half.completion, base.completion)
  def source_half = control.source_precision === FloatPrecision.Half
  def other_single = mux(source_half,
                         control.destination_precision === FloatPrecision.Single,
                         control.source_precision === FloatPrecision.Single)
  def converted_value = mux(
    source_half,
    mux(other_single,
        riscv_nan_box(FloatFormat.F32, riscv_canonicalize_nan(FloatFormat.F32, half_to_single.out.to_ieee()), 64),
        riscv_nan_box(FloatFormat.F64, riscv_canonicalize_nan(FloatFormat.F64, half_to_double.out.to_ieee()), 64)),
    mux(other_single,
        riscv_nan_box(FloatFormat.F16, riscv_canonicalize_nan(FloatFormat.F16, single_to_half.out.to_ieee()), 64),
        riscv_nan_box(FloatFormat.F16, riscv_canonicalize_nan(FloatFormat.F16, double_to_half.out.to_ieee()), 64))
  )
  def converted_flags = mux(
    source_half,
    mux(other_single,
        riscv_exception_flags(half_to_single.exception_flags),
        riscv_exception_flags(half_to_double.exception_flags)),
    mux(other_single,
        riscv_exception_flags(single_to_half.exception_flags),
        riscv_exception_flags(double_to_half.exception_flags))
  )
  def left_widening_flags = mux(request.left_precision === FloatPrecision.Half, widen_left.exception_flags, bits(0, 5))
  def right_widening_flags = mux(request.right_precision === FloatPrecision.Half, widen_right.exception_flags, bits(0, 5))
  def third_widening_flags = mux(request.third_precision === FloatPrecision.Half, widen_third.exception_flags, bits(0, 5))
  def widening_flags = mux(control.unit === FloatUnit.FusedMultiplyAdd, left_widening_flags ||| right_widening_flags ||| third_widening_flags, left_widening_flags ||| right_widening_flags)
  completion <== ordinary.updated(
    ~fp_value: mux(half_cross, converted_value, ordinary.fp_value),
    ~exception_flags: mux(half_cross, converted_flags, ordinary.exception_flags ||| mux(widening_arithmetic, widening_flags, bits(0, 5))),
    ~exception_flags_valid: mux(half_cross, Bool(#true), ordinary.exception_flags_valid)
  )

export:
  DisabledZfaFormatDatapath
  DisabledZfaModulo
  ZfaModulo
  ZfaFormatDatapath
  FpFormatDatapath
  FpHalfMinimalDatapath
  FpFixedF
  FpFixedD
  FpFixedFHalf
  FpFixedDHalf
