#lang rhodium
/* Shares operand-level FP execution with scheduled fixed writes or an elastic standalone
   adapter. */
// SPDX-License-Identifier: Apache-2.0

import:
  "profile.rhm".check_fp_profile
  "bundles.rhdl" open
  "datapath.rhdl" open
  "div-sqrt.rhdl" open
  "types.rhdl" open
  "timing.rhdl" open
  "../../riscv/isa/fp-profile.rhm" open
  "../../riscv/isa/xlen.rhm" open
  lib("flow/main.rhdl") open

/* Round-robins two persistent completions without payload storage and locks a blocked
   winner until transfer to preserve the irrevocable output. */
sync_circuit FpCompletionArbiter(T :: DataType):
  interface ingress[2](Irrevocable(T), ~role: consumer)
  interface egress(Irrevocable(T), ~role: producer)

  reg prefer_second(~init: Bool(#false))
  reg locked(~init: Bool(#false))
  reg owner_is_second(Bool)
  def unlocked_is_second = mux(prefer_second, ingress[1].valid, !ingress[0].valid & ingress[1].valid)
  def selected_is_second = mux(locked, owner_is_second, unlocked_is_second)
  def selected_valid = mux(selected_is_second, ingress[1].valid, ingress[0].valid)

  ingress[0].ready <== egress.ready & !selected_is_second
  ingress[1].ready <== egress.ready & selected_is_second
  egress.valid <== selected_valid
  egress.bits <== mux(selected_is_second, ingress[1].bits, ingress[0].bits)
  describe_interface_selection([selected_valid & !selected_is_second, selected_valid & selected_is_second])
  describe_interface_contract(ingress, egress, "data", ~kind: "irrevocable-rr-arbiter", ~trace_model: interface_trace_selection())

  when (selected_valid & egress.ready):
    locked <== Bool(#false)
    prefer_second <== !selected_is_second
  elsewhen (selected_valid & !locked):
    locked <== Bool(#true)
    owner_is_second <== selected_is_second

/* Dispatches fixed and variable arithmetic while preserving opaque execution tags.
   Scheduled fixed returns use the selected timing contract; standalone mode reserves
   completion storage and presents an irrevocable merged result. */
sync_circuit FpExecutionService(
  xlen :: XLen,
  profile :: FloatingPointProfile,
  Tag :: DataType,
  ~half_precision: half_precision :: HalfPrecisionProfile = DefaultHalfPrecisionProfile,
  ~zfa: zfa_enabled :: Boolean = #false,
  ~scheduled_writeback: scheduled_writeback :: Boolean = #false,
  ~timing: timing :: FpExecutionTiming = FpExecutionTiming()
):
  check_fp_profile(xlen, profile, half_precision, ~zfa: zfa_enabled)
  unless floating_point_supports_f(profile)
  | error(~who: #'FpExecutionService, "FP execution requires RV32F or RV64D")
  def ExecutionRequest = FpExecutionRequest(xlen, profile, Tag)
  def Result = FpExecutionResult(xlen, profile, Tag)
  interface request(Decoupled(ExecutionRequest), ~role: consumer)
  interface result(if scheduled_writeback | Decoupled(Result) | Irrevocable(Result), ~role: producer)
  // A scalar caller may book the following cycle's fixed launch. Stop such
  // admissions one cycle before aging stops unreserved current launches.
  output fixed_admission_available: Bool

  def FixedModule = cond
  | !half_precision_supports_zfhmin(half_precision):
      if profile == FloatingPointProfile.F | FpFixedF(xlen, Tag, ~zfa: zfa_enabled) | FpFixedD(xlen, Tag, ~zfa: zfa_enabled)
  | profile == FloatingPointProfile.F:
      FpFixedFHalf(xlen, Tag, ~arithmetic: half_precision_supports_zfh(half_precision), ~zfa: zfa_enabled)
  | ~else:
      FpFixedDHalf(xlen, Tag, ~arithmetic: half_precision_supports_zfh(half_precision), ~zfa: zfa_enabled)
  def DivSqrtModule = cond
  | !half_precision_supports_zfh(half_precision):
      if profile == FloatingPointProfile.F | FpDivSqrtF(xlen, Tag) | FpDivSqrtD(xlen, Tag)
  | profile == FloatingPointProfile.F: FpDivSqrtFHalf(xlen, Tag)
  | ~else: FpDivSqrtDHalf(xlen, Tag)
  inst fixed(FixedModule)
  inst div_sqrt(DivSqrtModule)
  def Array(fixed_request, division_request) = (
    request |> demux_flow(2, issued => issued.control.execution.unit === FloatUnit.DivideSquareRoot)
  )
  reg pending_returns(~init: bits(0, timing.maximum + 1))
  def return_selection = bits(1, timing.maximum + 1) << timing.latency(fixed_request.bits.control.execution)
  def return_available = !(pending_returns & return_selection).or_reduce()
  wire fixed_launch: Bool
  pending_returns <== (pending_returns ||| mux(fixed_launch, return_selection, bits(0, timing.maximum + 1))) >> 1
  /* Routes one combinational result through its selected nonstallable delay. */
  fun timed_result(source :: Endpoint) :: Endpoint:
    def paths = source |> fork_valid(timing.latencies.length())
    def results = for Array (latency in timing.latencies, index in 0..timing.latencies.length()):
      paths[index] |> filter_valid(operation => timing.latency(operation.control.execution) === bits(latency, timing.width)) |> map_valid(_operation => fixed.completion) |> valid_pipe(latency)
    results |> valid_arbiter()
  if scheduled_writeback
  | block:
      reg variable_age(~init: bits(0, 3))
      fixed_admission_available <== variable_age < bits(6, 3)
      fixed.request <== fixed_request.bits
      // Stop new launches long enough for an older variable result to drain;
      // fixed work already in flight still writes on its reserved cycle.
      def fixed_issue = fixed_request |> gate_flow(return_available & !variable_age.and_reduce()) |> to_valid()
      fixed_launch <== fixed_issue.valid
      def fixed_completion = timed_result(fixed_issue)
      // Variable work stays in its lane. Never lock the common result mux
      // against an already-reserved fixed return arriving next cycle.
      Array(fixed_completion |> to_decoupled(), div_sqrt.completion) |> arbiter() |> result
      assert(!fixed_completion.valid ||| result.ready, "scheduled_fp_writes_on_return")
      when (!div_sqrt.completion.valid ||| div_sqrt.completion.ready):
        variable_age <== bits(0, 3)
      elsewhen (!variable_age.and_reduce()):
        variable_age <== variable_age + bits(1, 3)
  | block:
      fixed_admission_available <== Bool(#false)
      inst fixed_responses(CompletionQueue(ExecutionRequest, Result, timing.maximum + 2))
      fixed.request <== fixed_responses.issue.bits
      fixed_launch <== fixed_responses.issue.valid
      timed_result(fixed_responses.issue) |> fixed_responses.completion
      inst completion_merge(FpCompletionArbiter(Result))
      fixed_responses.response |> completion_merge.ingress[0]
      div_sqrt.completion |> completion_merge.ingress[1]
      completion_merge.egress |> result
      fixed_request |> gate_flow(return_available) |> fixed_responses.request
  division_request |> div_sqrt.request
  when (request.valid):
    assert(request.bits.control.execution.unit =/= FloatUnit.Memory, "fp_execution_requires_compute")

export:
  FpExecutionService
