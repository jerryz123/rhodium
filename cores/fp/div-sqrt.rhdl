#lang rhodium
/* Holds one divide/sqrt owner across precisions; numerical data stays in HardFloat. */
// SPDX-License-Identifier: Apache-2.0

import:
  "bundles.rhdl" open
  "profile.rhm".fp_value_width
  "types.rhdl" open
  "../../riscv/isa/fp-profile.rhm" open
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/rtl/floating-point.rhdl" open
  lib("hardfloat/main.rhdl") open
  lib("rhodium/std/ready-valid.rhdl") open

/* Issues to one format at a time. The last format is the profile's fallback.
   The accepted tag and format stay paired until the terminal result transfers. */
sync_circuit FpDivSqrtBank(xlen :: XLen, profile :: FloatingPointProfile, formats :: List.of(FloatFormat), Tag :: DataType):
  interface request(Decoupled(FpExecutionRequest(xlen, profile, Tag)), ~role: consumer)
  interface completion(Irrevocable(FpExecutionResult(xlen, profile, Tag)), ~role: producer)
  def flen = floating_point_register_width(profile)
  def n = formats.length()
  def Index = Bits(index_width(n))
  def cases = for List (i in 0..(n - 1)):
    [if formats[i] == FloatFormat.F16 | FloatPrecision.Half | FloatPrecision.Single, Index(i)]

  def selected = if n == 1 | Index(0) | mux_lookup(request.bits.control.execution.source_precision, ~default: Index(n - 1), cases)
  reg busy(~init: Bool(#false))
  reg done(~init: Bool(#false))
  reg owner_format(Index)
  reg owner_tag(Tag)


  /* Each format keeps its existing numerical datapath and terminal registers.
     Only the selected unit sees the accepted request; no unit stores its tag. */

  wire launch: Bool
  wire ready: Vec(n, Bool)
  wire finished: Vec(n, Bool)
  wire terminal_values: Vec(n, Bits(fp_value_width(xlen, profile)))
  wire flags: Vec(n, Bits(5))
  for (format in formats, i in 0..n):
    unless flen >= format.ieee_width
    | error(~who: #'FpDivSqrtLane, "floating-point register width must cover the selected format")

    inst operation(DivSqrtRecFN(format))
    ready[i] <== operation.input_ready
    operation.input_valid <== launch & (selected === Index(i))
    operation.square_root <== request.bits.control.execution.divide_operation === FloatDivideOperation.SquareRoot
    operation.a <== riscv_unbox(format, flen, request.bits.left[0..flen]).to_recoded()
    operation.b <== riscv_unbox(format, flen, request.bits.right).to_recoded()
    operation.rounding_mode <== request.bits.rounding_mode
    operation.tininess_mode <== TininessMode.AfterRounding
    def result = riscv_canonicalize_nan(format, operation.out.to_ieee())
    def boxed = riscv_nan_box(format, result, flen)
    terminal_values[i] <== boxed.zext(fp_value_width(xlen, profile))
    finished[i] <== operation.division_valid ||| operation.square_root_valid
    flags[i] <== riscv_exception_flags(operation.exception_flags)

  request.ready <== !busy & ready[selected]
  launch <== request.fire()


  /* The first terminal pulse can transfer immediately. Under backpressure
     latch only its validity; the owner and its terminal registers remain stable. */

  completion.valid <== busy & (done ||| finished[owner_format])
  completion.bits <== FpExecutionResult(xlen, profile, Tag):
    tag: owner_tag
    value: terminal_values[owner_format]
    exception_flags: flags[owner_format]
    exception_flags_valid: Bool(#true)

  when (launch):
    owner_tag <== request.bits.tag
    owner_format <== selected
    busy <== Bool(#true)
    done <== Bool(#false)
  elsewhen (completion.fire()):
    busy <== Bool(#false)
    done <== Bool(#false)
  elsewhen (busy & finished[owner_format]):
    done <== Bool(#true)

  describe_interface_retained_storage(launch, completion.fire(), busy, ~name: "arithmetic")
  describe_interface_contract(request, completion, "arithmetic", ~trace_model: interface_trace_retained(~name: "arithmetic"))

/* Runs a single selected HardFloat format with one opaque completion owner. */
sync_circuit FpDivSqrtLane(xlen :: XLen, profile :: FloatingPointProfile, format :: FloatFormat, Tag :: DataType):
  interface request(Decoupled(FpExecutionRequest(xlen, profile, Tag)), ~role: consumer)
  interface completion(Irrevocable(FpExecutionResult(xlen, profile, Tag)), ~role: producer)
  inst bank(FpDivSqrtBank(xlen, profile, [format], Tag))
  request |> bank.request
  bank.completion |> completion

/* Services single-precision variable arithmetic. */
sync_circuit FpDivSqrtF(xlen :: XLen, Tag :: DataType):
  def profile = FloatingPointProfile.F
  interface request(Decoupled(FpExecutionRequest(xlen, profile, Tag)), ~role: consumer)
  interface completion(Irrevocable(FpExecutionResult(xlen, profile, Tag)), ~role: producer)
  inst bank(FpDivSqrtBank(xlen, profile, [FloatFormat.F32], Tag))
  request |> bank.request
  bank.completion |> completion

/* Shares one variable owner across the single and double arithmetic units. */
sync_circuit FpDivSqrtD(xlen :: XLen, Tag :: DataType):
  def profile = FloatingPointProfile.D
  interface request(Decoupled(FpExecutionRequest(xlen, profile, Tag)), ~role: consumer)
  interface completion(Irrevocable(FpExecutionResult(xlen, profile, Tag)), ~role: producer)
  inst bank(FpDivSqrtBank(xlen, profile, [FloatFormat.F32, FloatFormat.F64], Tag))
  request |> bank.request
  bank.completion |> completion

/* Shares one variable owner across the half and single arithmetic units. */
sync_circuit FpDivSqrtFHalf(xlen :: XLen, Tag :: DataType):
  def profile = FloatingPointProfile.F
  interface request(Decoupled(FpExecutionRequest(xlen, profile, Tag)), ~role: consumer)
  interface completion(Irrevocable(FpExecutionResult(xlen, profile, Tag)), ~role: producer)
  inst bank(FpDivSqrtBank(xlen, profile, [FloatFormat.F16, FloatFormat.F32], Tag))
  request |> bank.request
  bank.completion |> completion

/* Shares one variable owner across the half, single, and double arithmetic units. */
sync_circuit FpDivSqrtDHalf(xlen :: XLen, Tag :: DataType):
  def profile = FloatingPointProfile.D
  interface request(Decoupled(FpExecutionRequest(xlen, profile, Tag)), ~role: consumer)
  interface completion(Irrevocable(FpExecutionResult(xlen, profile, Tag)), ~role: producer)
  inst bank(FpDivSqrtBank(xlen, profile, [FloatFormat.F16, FloatFormat.F32, FloatFormat.F64], Tag))
  request |> bank.request
  bank.completion |> completion

export:
  FpDivSqrtLane
  FpDivSqrtF
  FpDivSqrtD
  FpDivSqrtFHalf
  FpDivSqrtDHalf
