#lang rhodium
/* Implements packed integer, fixed-point, extension, widening, and compaction datapaths. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../riscv/isa/xlen.rhm" open
  "../rhodium/std/bits.rhdl" open

/* Select the runtime element width within a 32- or 64-bit packed physical word. */
hardware_enum SimdElementWidth:
  E8
  E16
  E32
  E64

/* Select the packed result resource independently of arithmetic and mask-result controls. */
hardware_enum SimdResultSelect:
  Adder
  Logic
  Shift
  Compare
  MinMax
  Select
  Permute
  Count

/* Select the packed bitwise operation after optional right-operand inversion. */
hardware_enum SimdLogicSelect:
  And
  Or
  Xor

/* Select equality, less-than, or less-or-equal per active element. */
hardware_enum SimdComparisonSelect:
  Equal
  Less
  LessEqual

/* Choose element comparison predicates or unsigned carry/borrow bits for the mask result. */
hardware_enum SimdMaskResultSelect:
  Comparison
  CarryBorrow

/* Select element-local bit reversal, byte-local bit reversal, or element-local byte reversal. */
hardware_enum SimdPermutationSelect:
  ReverseBits
  ReverseBitsInBytes
  ReverseBytes

/* Select per-element leading zeros, trailing zeros, or population count. */
hardware_enum SimdCountSelect:
  LeadingZeros
  TrailingZeros
  Population

/*
 * Declaration order matches the two-bit fixed-point rounding encoding.
 */
hardware_enum SimdRoundingMode:
  NearestUp
  NearestEven
  Down
  Odd

/* Select wrapping, signed/unsigned saturation, or rounded signed/unsigned averaging. */
hardware_enum SimdArithmeticMode:
  Wrap
  SaturateUnsigned
  SaturateSigned
  AverageUnsigned
  AverageSigned

/* Drive packed datapath resources without encoding ISA, vector register, or scheduling policy. */
bundle SimdAluControl():
  result_select: SimdResultSelect
  arithmetic_mode: SimdArithmeticMode
  logic_select: SimdLogicSelect
  comparison_select: SimdComparisonSelect
  mask_result_select: SimdMaskResultSelect
  permutation_select: SimdPermutationSelect
  count_select: SimdCountSelect
  subtract: Bool
  signed_compare: Bool
  maximum: Bool
  shift_right: Bool
  arithmetic_shift: Bool
  rotate: Bool
  invert_right: Bool

/* Return the number of physical byte lanes in an XLEN-wide packed word. */
fun simd_word_bytes(xlen :: XLen) :: PosInt:
  xlen.width / 8

/*
 * Return packed data, element predicates, byte write enables, and enabled-lane saturation
 * status.
 */
bundle SimdAluResult(xlen :: XLen):
  data: Bits(xlen.width)
  mask_result: Mask(simd_word_bytes(xlen))
  write_mask: Mask(simd_word_bytes(xlen))
  saturated: Bool

/*
 * Internal routing metadata expands element predicates into byte-level controls.
 */
bundle SimdRouting(xlen :: XLen):
  comparison: Mask(simd_word_bytes(xlen))
  enabled: Mask(simd_word_bytes(xlen))
  select_right: Mask(simd_word_bytes(xlen))
  select_left: Mask(simd_word_bytes(xlen))
  compare_data: Bits(xlen.width)
  shift_data: Bits(xlen.width)
  permutation_data: Bits(xlen.width)
  count_data: Bits(xlen.width)

/*
 * Internal arithmetic routing retains the extended per-lane sum while one
 * shared incrementer applies fixed-point averaging modes.
 */
bundle SimdFixedArithmetic(xlen :: XLen):
  average: Bits(xlen.width)
  increment: Bits(xlen.width)
  saturated: Bits(xlen.width)
  saturation: Bool
  carry_borrow: Mask(simd_word_bytes(xlen))

/*
 * Internal tapered-bank slice: one barrel shifter serves both directions and
 * every element width routed into this physical slot.
 */
circuit SimdShiftSlice(width :: PosInt, amount_width :: PosInt):
  input source: Bits(width)
  input amount: Bits(amount_width)
  input(shift_right, arithmetic_shift, rotate): Bool
  output result: Bits(width)

  def oriented = mux(shift_right, source, reverse_bits(source))
  def fill = shift_right & arithmetic_shift & source[width - 1].into(Bool)
  // Each barrel stage either fills or wraps the discarded bits. Repeated
  // narrow operands make physical-slot rotation also rotate at element width.
  def mutable shifted = oriented
  for (stage in 0..amount_width):
    def distance = 2 ** stage
    def previous :: Bits(width) = shifted
    def padding = mux(fill, !Bits(distance)(0), Bits(distance)(0))
    def upper = mux(rotate, previous[0..distance], padding)
    shifted := mux(amount[stage].into(Bool), upper ++ previous[distance..width], previous)

  def shifted_result :: Bits(width) = shifted
  result <== mux(shift_right, shifted_result, reverse_bits(shifted_result))

/*
 * Compute packed integer and fixed-point operations combinationally with lane-isolated
 * arithmetic and shared shift/comparison/count resources.
 */
circuit SimdALU(xlen :: XLen):
  def width = xlen.width
  def format_count = if width == 32 | 3 | 4
  input(left, right): Bits(width)
  input element_width: SimdElementWidth
  input control: SimdAluControl()
  input rounding: Bool
  input rounding_mode: SimdRoundingMode
  input enabled: Mask(width / 8)
  input carry_in: Mask(width / 8)
  input select_right: Mask(width / 8)
  output result: SimdAluResult(xlen)


  /* Element boundaries and bitwise logic.
     Guard bits propagate carry within elements and isolate adjacent elements. */

  def boundaries = for List (index in 0..(width / 8)):
    def boundary = cond
    | index == 0: Bool(#true)
    | index mod 4 == 0: element_width =/= SimdElementWidth.E64
    | index mod 2 == 0: element_width.is_one_of(SimdElementWidth.E8, SimdElementWidth.E16)
    | ~else: element_width === SimdElementWidth.E8

    boundary

  def logic_right = mux(control.invert_right, !right, right)
  def logic_value = mux_lookup(control.logic_select, ~default: left & logic_right, [[SimdLogicSelect.Or, left ||| logic_right], [SimdLogicSelect.Xor, left ^ logic_right]])


  /* Shared byte-count tree.
     Each level reuses the previous level for wider elements; byte reversal
     is wiring shared with the permutation path. */

  def reversed_bytes = for List (byte in 0..(width / 8)): reverse_bits(left[byte * 8..(byte + 1) * 8])
  def trailing = control.count_select === SimdCountSelect.TrailingZeros
  def mutable count_nodes = for List (byte in 0..(width / 8)):
    def source = left[byte * 8..(byte + 1) * 8]
    def reversed :: Bits(8) = reversed_bytes[byte]
    [!source.or_reduce(), count_leading_zeros(mux(trailing, reversed, source)), popcount(source)]

  def count_levels = for List (format in 0..format_count):
    def previous = count_nodes
    def nodes:
      if format == 0
      | previous
      | for List (pair in 0..((width / 8) div (2 ** format))):
          def low_zero :: Bool = previous[pair * 2][0]
          def high_zero :: Bool = previous[pair * 2 + 1][0]
          def low_count :: Bits(3 + format) = previous[pair * 2][1]
          def high_count :: Bits(3 + format) = previous[pair * 2 + 1][1]
          def low_population :: Bits(3 + format) = previous[pair * 2][2]
          def high_population :: Bits(3 + format) = previous[pair * 2 + 1][2]
          def first_zero = mux(trailing, low_zero, high_zero)
          def first_count = mux(trailing, low_count, high_count).zext(4 + format)
          def second_count = mux(trailing, high_count, low_count).zext(4 + format)
          [low_zero & high_zero,
           mux(first_zero, Bits(4 + format)(8 * (2 ** (format - 1))) + second_count, first_count),
           low_population.zext(4 + format) + high_population.zext(4 + format)]

    count_nodes := nodes
    nodes


  /* Shared comparison tree.
     Byte predicates combine low/high halves in significance order. Signedness
     is applied only after choosing the element width, not at every tree level. */

  def mutable compare_nodes = for List (byte in 0..(width / 8)):
    def a = left[byte * 8..(byte + 1) * 8]
    def b = right[byte * 8..(byte + 1) * 8]
    [a === b, a < b]

  def compare_levels = for List (element_bytes in [1, 2, 4, 8].take(format_count)):
    def previous = compare_nodes
    def nodes:
      if element_bytes == 1
      | previous
      | for List (pair in 0..((width / 8) div element_bytes)):
          def low_equal :: Bool = previous[pair * 2][0]
          def low_less :: Bool = previous[pair * 2][1]
          def high_equal :: Bool = previous[pair * 2 + 1][0]
          def high_less :: Bool = previous[pair * 2 + 1][1]
          [high_equal & low_equal, high_less ||| (high_equal & low_less)]

    compare_nodes := nodes
    nodes


  /* Tapered shifter bank: 32/16/8/8 or 64/32/16/16/8/8/8/8.
     Slot i serves element i at every supported width instead of replicating
     a complete bank per format. Each slice retains its ordered barrel stages. */

  def widths = SimdElementWidth.values()
  def shifts = for List (slot in 0..(width / 8)):
    def formats = [0, 1, 2, 3].take(format_count).filter(~keep: fun (format :: Nat): slot < ((width / 8) div (2 ** format)))
    def largest = formats[formats.length() - 1]
    def slice_width = 8 * (2 ** largest)
    def operands = for List (format in formats):
      def element_bits = 8 * (2 ** format)
      def source = left[slot * element_bits..(slot + 1) * element_bits]
      def extended :: Bits(slice_width):
        if element_bits == slice_width
        | source
        | mux(control.arithmetic_shift, source.into(SInt(element_bits)).sext(slice_width).as_bits(), source.zext(slice_width))

      def repeated :: Bits(slice_width):
        if element_bits == slice_width
        | source
        | concat(for List (copy in 0..(slice_width div element_bits)): source)

      [widths[format], mux(control.rotate, repeated, extended)]

    def amounts = for List (format in formats):
      def amount = right[slot * 8 * (2 ** format)..slot * 8 * (2 ** format) + 3 + format]
      def extended :: Bits(3 + largest) = if format == largest | amount | amount.zext(3 + largest)
      [widths[format], extended]

    inst shifter(SimdShiftSlice(slice_width, 3 + largest))
    shifter.source <== mux_lookup(element_width, ~default: Bits(slice_width)(0), operands)
    shifter.amount <== mux_lookup(element_width, ~default: Bits(3 + largest)(0), amounts)
    shifter.shift_right <== control.shift_right
    shifter.arithmetic_shift <== control.arithmetic_shift
    shifter.rotate <== control.rotate
    if slice_width == width | shifter.result | shifter.result.zext(width)


  /* Format-dependent byte routing.
     This selects existing comparison/count/shifter results; it does not
     replicate their arithmetic or variable-shift resources. */

  /* Names one element's signed-order and selected comparison predicates. */
  bundle ElementPredicates():
    less: Bool
    comparison: Bool

  /* Names each byte's enables and resource outputs before word concatenation. */
  bundle ByteRouting():
    enabled: Bool
    select_right: Bool
    select_left: Bool
    compare_data: Bits(8)
    shift_data: Bits(8)
    permutation_data: Bits(8)
    count_data: Bits(8)

  def packed = for List (format in 0..format_count):
    def element_bytes = 2 ** format
    def element_bits = 8 * element_bytes
    def count = (width / 8) div element_bytes
    def predicates = for List (lane in 0..count):
      def node = compare_levels[format][lane]
      def equal :: Bool = node[0]
      def unsigned_less :: Bool = node[1]
      def sign_bit = (lane + 1) * element_bits - 1
      def less = mux(control.signed_compare & (left[sign_bit] ^ right[sign_bit]).into(Bool), left[sign_bit].into(Bool), unsigned_less)
      def comparison = mux_lookup(control.comparison_select, ~default: equal, [[SimdComparisonSelect.Less, less], [SimdComparisonSelect.LessEqual, less ||| equal]])
      ElementPredicates():
        less: less
        comparison: comparison

    def lane_comparisons = for List (lane in 0..(width / 8)):
      if lane < count
      | block:
          def selected :: ElementPredicates() = predicates[lane]
          def predicate = selected.comparison
          (enabled[lane] & predicate).as_bits()
      | Bits(1)(0)

    def bytes = for List (byte in 0..(width / 8)):
      def lane = byte div element_bytes
      def selected :: ElementPredicates() = predicates[lane]
      def less = selected.less
      def predicate = selected.comparison
      def shifted :: Bits(width) = shifts[lane]
      def shift_low = (byte mod element_bytes) * 8
      def reverse_byte = lane * element_bytes + element_bytes - 1 - (byte mod element_bytes)
      def reversed_byte :: Bits(8) = reversed_bytes[reverse_byte]
      def local_reversed_byte :: Bits(8) = reversed_bytes[byte]
      def permutation = mux_lookup(control.permutation_select, ~default: reversed_byte, [[SimdPermutationSelect.ReverseBitsInBytes, local_reversed_byte], [SimdPermutationSelect.ReverseBytes, left[reverse_byte * 8..(reverse_byte + 1) * 8]]])
      def zero_count :: Bits(4 + format) = count_levels[format][lane][1]
      def population :: Bits(4 + format) = count_levels[format][lane][2]
      def count = mux(control.count_select === SimdCountSelect.Population, population, zero_count)
      ByteRouting():
        enabled: enabled[lane]
        select_right: select_right[lane]
        select_left: less ^ control.maximum
        compare_data: if byte mod element_bytes == 0 | predicate.as_bits().zext(8) | Bits(8)(0)
        shift_data: shifted[shift_low..shift_low + 8]
        permutation_data: permutation
        count_data: if byte mod element_bytes == 0 | count.zext(8) | Bits(8)(0)

    SimdRouting(xlen):
      comparison: concat(lane_comparisons.reverse()).into(Mask(width / 8))
      enabled: concat(bytes.map(fun (byte :: ByteRouting()): byte.enabled.as_bits()).reverse()).into(Mask(width / 8))
      select_right: concat(bytes.map(fun (byte :: ByteRouting()): byte.select_right.as_bits()).reverse()).into(Mask(width / 8))
      select_left: concat(bytes.map(fun (byte :: ByteRouting()): byte.select_left.as_bits()).reverse()).into(Mask(width / 8))
      compare_data: concat(bytes.map(fun (byte :: ByteRouting()): byte.compare_data).reverse())
      shift_data: concat(bytes.map(fun (byte :: ByteRouting()): byte.shift_data).reverse())
      permutation_data: concat(bytes.map(fun (byte :: ByteRouting()): byte.permutation_data).reverse())
      count_data: concat(bytes.map(fun (byte :: ByteRouting()): byte.count_data).reverse())

  def routing :: SimdRouting(xlen) = mux_lookup(element_width, ~default: packed[0], for List (format in 1..format_count): [widths[format], packed[format]])


  /* Fixed-point shift rounding.
     Discarded-bit selection supplies one increment per element to the same
     guarded adder used by ordinary arithmetic. */

  def rounding_alternatives = for List (format in 0..format_count):
    def element_bits = 8 * (2 ** format)
    def count = (width / 8) div (2 ** format)
    def increments = for List (lane in 0..count):
      def source = left[lane * element_bits..(lane + 1) * element_bits]
      def amount = right[lane * element_bits..lane * element_bits + 3 + format]
      def shifted :: Bits(width) = shifts[lane]
      def cases = for List (distance in 1..element_bits):
        def round_bit = source[distance - 1].into(Bool)
        def lower_nonzero = if distance == 1 | Bool(#false) | source[0..distance - 1].or_reduce()
        def discarded_nonzero = source[0..distance].or_reduce()
        def increment = mux_lookup(rounding_mode, ~default: round_bit, [
          [SimdRoundingMode.NearestEven, round_bit & (lower_nonzero ||| shifted[0].into(Bool))],
          [SimdRoundingMode.Down, Bool(#false)],
          [SimdRoundingMode.Odd, !shifted[0].into(Bool) & discarded_nonzero]
        ])

        [distance, increment.as_bits().zext(element_bits)]

      mux_lookup(amount, ~default: Bits(element_bits)(0), cases)

    if count == 1 | increments[0] | concat(increments.reverse())

  def rounding_increment :: Bits(width) = mux_lookup(element_width, ~default: rounding_alternatives[0], for List (format in 1..format_count): [widths[format], rounding_alternatives[format]])
  def shift_rounding = rounding & (control.result_select === SimdResultSelect.Shift)


  /* Lane-isolated shared adder.
     The byte guard below each boundary supplies carry-in or subtraction's
     complemented borrow-in; interior 1+0 guard pairs propagate carry. */

  def adder_left = mux(shift_rounding, routing.shift_data, left)
  def adder_right = mux(shift_rounding, rounding_increment, right)
  def subtract = control.subtract & !shift_rounding
  def inverted_right = mux(subtract, !adder_right, adder_right)
  def boundary_carries = for List (byte in 0..(width / 8)):
    def lane_carry = mux_lookup(element_width, ~default: carry_in[byte], [[SimdElementWidth.E16, carry_in[byte div 2]], [SimdElementWidth.E32, carry_in[byte div 4]], [SimdElementWidth.E64, carry_in[0]]])
    mux(subtract, !lane_carry, lane_carry)

  def left_chunks = for List (byte in 0..(width / 8)):
    def boundary :: Bool = boundaries[byte]
    adder_left[byte * 8..(byte + 1) * 8] ++ mux(boundary, boundary_carries[byte], Bool(#true)).as_bits()

  def right_chunks = for List (byte in 0..(width / 8)):
    def boundary :: Bool = boundaries[byte]
    inverted_right[byte * 8..(byte + 1) * 8] ++ mux(boundary, boundary_carries[byte], Bool(#false)).as_bits()

  // The extra top bit retains full-word carry/borrow; internal element carries land
  // in the existing boundary guard bits.
  def sum = concat(left_chunks.reverse()).zext((width / 8) * 9 + 1) + concat(right_chunks.reverse()).zext((width / 8) * 9 + 1)
  def sum_bytes = for List (byte in 0..(width / 8)): sum[byte * 9 + 1..byte * 9 + 9]
  def added = concat(sum_bytes.reverse())


  /* Saturation and averaging from the extended per-element sums.
     Retain each element's carry/sign extension until rounding and clipping;
     lane enables gate status, not the shared arithmetic itself. */

  /* Keeps one element's average, increment, clipped value, and status together. */
  bundle FixedLane(element_bits :: PosInt):
    average: Bits(element_bits)
    increment: Bits(element_bits)
    saturated: Bits(element_bits)
    saturation: Bool
    carry_borrow: Bool

  def saturating_unsigned = control.arithmetic_mode === SimdArithmeticMode.SaturateUnsigned
  def saturating_signed = control.arithmetic_mode === SimdArithmeticMode.SaturateSigned
  def average_unsigned = control.arithmetic_mode === SimdArithmeticMode.AverageUnsigned
  def average_signed = control.arithmetic_mode === SimdArithmeticMode.AverageSigned
  def saturating = saturating_unsigned ||| saturating_signed
  def averaging = average_unsigned ||| average_signed
  def fixed_alternatives = for List (format in 0..format_count):
    def element_bits = 8 * (2 ** format)
    def element_bytes = 2 ** format
    def count = (width / 8) div element_bytes
    def lanes = for List (lane in 0..count):
      def low = lane * element_bits
      def high = (lane + 1) * element_bits
      def a = left[low..high]
      def b = right[low..high]
      def wrapped = added[low..high]
      def carry = sum[(lane + 1) * element_bytes * 9].into(Bool)
      def left_negative = a[element_bits - 1].into(Bool)
      def right_negative = b[element_bits - 1].into(Bool)
      def result_negative = wrapped[element_bits - 1].into(Bool)
      def unsigned_overflow = mux(control.subtract, !carry, carry)
      def signed_overflow = (left_negative ^ result_negative) & mux(control.subtract, left_negative ^ right_negative, !(left_negative ^ right_negative))
      def overflow = mux(saturating_unsigned, unsigned_overflow, signed_overflow)
      def unsigned_limit = mux(control.subtract, Bits(element_bits)(0), !Bits(element_bits)(0))
      def signed_limit = mux(left_negative, Bits(element_bits)(1 << (element_bits - 1)), Bits(element_bits)((1 << (element_bits - 1)) - 1))
      def saturated_value = mux(overflow, mux(saturating_unsigned, unsigned_limit, signed_limit), wrapped)
      // The high bit completes the infinite-precision add/subtract before its
      // divide-by-two. Unsigned subtraction uses a sign extension so a
      // negative exact difference wraps only after rounding.
      def signed_high = mux(control.subtract, left_negative ^ !right_negative ^ carry, left_negative ^ right_negative ^ carry)
      def average_high = mux(average_unsigned, mux(control.subtract, !carry, carry), signed_high)
      def average_base = average_high.as_bits() ++ wrapped[1..element_bits]
      def discarded = wrapped[0].into(Bool)
      def increment = mux_lookup(rounding_mode, ~default: discarded, [
        [SimdRoundingMode.NearestEven, discarded & average_base[0].into(Bool)],
        [SimdRoundingMode.Down, Bool(#false)],
        [SimdRoundingMode.Odd, !average_base[0].into(Bool) & discarded]
      ])

      FixedLane(element_bits):
        average: average_base
        increment: increment.as_bits().zext(element_bits)
        saturated: saturated_value
        saturation: enabled[lane] & saturating & overflow
        carry_borrow: enabled[lane] & mux(control.subtract, !carry, carry)

    def first_lane :: FixedLane(element_bits) = lanes[0]
    def average_data = if count == 1 | first_lane.average | concat(lanes.map(fun (lane :: FixedLane(element_bits)): lane.average).reverse())
    def increments = if count == 1 | first_lane.increment | concat(lanes.map(fun (lane :: FixedLane(element_bits)): lane.increment).reverse())
    def saturated_data = if count == 1 | first_lane.saturated | concat(lanes.map(fun (lane :: FixedLane(element_bits)): lane.saturated).reverse())
    def saturation_bits :: Bits(count) = if count == 1 | first_lane.saturation.as_bits() | concat(lanes.map(fun (lane :: FixedLane(element_bits)): lane.saturation.as_bits()).reverse())
    def carries :: Bits(count) = if count == 1 | first_lane.carry_borrow.as_bits() | concat(lanes.map(fun (lane :: FixedLane(element_bits)): lane.carry_borrow.as_bits()).reverse())
    def carry_borrow_bits = if count == width / 8 | carries | carries.zext(width / 8)
    SimdFixedArithmetic(xlen):
      average: average_data
      increment: increments
      saturated: saturated_data
      saturation: saturation_bits.or_reduce()
      carry_borrow: carry_borrow_bits.into(Mask(width / 8))

  def fixed :: SimdFixedArithmetic(xlen) = mux_lookup(element_width, ~default: fixed_alternatives[0], for List (format in 1..format_count): [widths[format], fixed_alternatives[format]])
  def average_left_chunks = for List (byte in 0..(width / 8)):
    def boundary :: Bool = boundaries[byte]
    fixed.average[byte * 8..(byte + 1) * 8] ++ (!boundary).as_bits()

  def average_right_chunks = for List (byte in 0..(width / 8)): fixed.increment[byte * 8..(byte + 1) * 8] ++ Bits(1)(0)
  def average_sum = concat(average_left_chunks.reverse()) + concat(average_right_chunks.reverse())
  def average_bytes = for List (byte in 0..(width / 8)): average_sum[byte * 9 + 1..byte * 9 + 9]
  def averaged = concat(average_bytes.reverse())


  /* Final resource selection and enabled-byte masking. */

  def arithmetic_value = priority_mux(~default: added):
    averaging: averaged
    saturating: fixed.saturated

  def minmax_bytes = for List (byte in 0..(width / 8)): mux(routing.select_left[byte], left[byte * 8..(byte + 1) * 8], right[byte * 8..(byte + 1) * 8])
  def select_bytes = for List (byte in 0..(width / 8)): mux(routing.select_right[byte], right[byte * 8..(byte + 1) * 8], left[byte * 8..(byte + 1) * 8])
  def value = mux_lookup(control.result_select, ~default: arithmetic_value):
    SimdResultSelect.Logic: logic_value
    SimdResultSelect.Shift: mux(shift_rounding, added, routing.shift_data)
    SimdResultSelect.Compare: routing.compare_data
    SimdResultSelect.MinMax: concat(minmax_bytes.reverse())
    SimdResultSelect.Select: concat(select_bytes.reverse())
    SimdResultSelect.Permute: routing.permutation_data
    SimdResultSelect.Count: routing.count_data

  def enabled_bytes = for List (byte in 0..(width / 8)): mux(routing.enabled[byte], value[byte * 8..(byte + 1) * 8], Bits(8)(0))
  result <== SimdAluResult(xlen):
    data: concat(enabled_bytes.reverse())
    mask_result: mux(control.mask_result_select === SimdMaskResultSelect.CarryBorrow, fixed.carry_borrow, routing.comparison)
    write_mask: routing.enabled
    saturated: (control.result_select === SimdResultSelect.Adder) & fixed.saturation

/*
 * Widening prepares one physical destination word from either source half.
 * The caller selects only source widths whose doubled width fits that word.
 */
hardware_enum SimdWidenElementWidth:
  E8
  E16
  E32

/* Carry one widened operand pair, destination element width, and remapped element enables. */
bundle SimdWidenedOperands(xlen :: XLen):
  left: Bits(xlen.width)
  right: Bits(xlen.width)
  element_width: SimdElementWidth
  enabled: Mask(simd_word_bytes(xlen))

/*
 * Extend one source half to doubled-width elements, optionally passing an already-wide left
 * word through.
 */
circuit SimdWidenOperands(xlen :: XLen):
  def width = xlen.width
  def format_count = if width == 32 | 3 | 4
  input(left, right): Bits(width)
  input element_width: SimdWidenElementWidth
  input upper_half: Bool
  input left_wide: Bool
  input(left_signed, right_signed): Bool
  input enabled: Mask(width / 8)
  output operands: SimdWidenedOperands(xlen)

  def source_left = mux(upper_half, left[width / 2..width], left[0..width / 2])
  def source_right = mux(upper_half, right[width / 2..width], right[0..width / 2])
  def widths = SimdWidenElementWidth.values()
  def destination_widths = [SimdElementWidth.E16, SimdElementWidth.E32, SimdElementWidth.E64]
  def prepared = for List (format in 0..(format_count - 1)):
    def source_bits = 8 * (2 ** format)
    def count = (width / 2) div source_bits
    def a = for List (lane in 0..count):
      def source = source_left[lane * source_bits..(lane + 1) * source_bits]
      mux(left_signed, source.into(SInt(source_bits)).sext(2 * source_bits).as_bits(), source.zext(2 * source_bits))

    def b = for List (lane in 0..count):
      def source = source_right[lane * source_bits..(lane + 1) * source_bits]
      mux(right_signed, source.into(SInt(source_bits)).sext(2 * source_bits).as_bits(), source.zext(2 * source_bits))

    def enables = for List (lane in 0..(width / 8)):
      if lane < count | mux(upper_half, enabled[lane + count], enabled[lane]).as_bits() | Bits(1)(0)

    SimdWidenedOperands(xlen):
      left: mux(left_wide, left, if count == 1 | a[0] | concat(a.reverse()))
      right: if count == 1 | b[0] | concat(b.reverse())
      element_width: destination_widths[format]
      enabled: concat(enables.reverse()).into(Mask(width / 8))

  operands <== mux_lookup(element_width, ~default: prepared[0], for List (format in 1..(format_count - 1)): [widths[format], prepared[format]])

/*
 * Expands one selected narrow source fragment into a physical destination word.
 * Ratio and part choose wiring only; extension does not cascade widening lanes.
 */
hardware_enum SimdExtensionRatio:
  By2
  By4
  By8

/*
 * Extend a selected fragment into one destination word and report legal width/ratio/fragment
 * combinations.
 */
circuit SimdExtend(xlen :: XLen):
  def width = xlen.width
  def format_count = if width == 32 | 3 | 4
  input source: Bits(width)
  input destination_width: SimdElementWidth
  input ratio: SimdExtensionRatio
  input part: Bits(3)
  input signed: Bool
  output data: Bits(width)
  output legal: Bool

  def ratios = [2, 4, 8]
  def widths = SimdElementWidth.values()
  def by_ratio:
    for List (ratio_index in 0..3):
      def ratio_value = ratios[ratio_index]
      def by_width:
        for List (destination_format in 0..format_count):
          if destination_format <= ratio_index
          | Bits(width)(0)
          | block:
              def destination_bits = 8 * (2 ** destination_format)
              def source_bits = destination_bits div ratio_value
              def lanes = width div destination_bits
              def fragment = source >> (part ++ Bits(index_width(width) - 1 - ratio_index)(0))
              def elements = for List (lane in 0..lanes):
                def element = fragment[lane * source_bits..(lane + 1) * source_bits]
                mux(signed, element.into(SInt(source_bits)).sext(destination_bits).as_bits(), element.zext(destination_bits))

              if lanes == 1 | elements[0] | concat(elements.reverse())

      mux_lookup(destination_width, ~default: by_width[0], for List (format in 1..format_count): [widths[format], by_width[format]])

  data <== mux_lookup(ratio, ~default: by_ratio[0], for List (ratio_index in 1..3): [SimdExtensionRatio.values()[ratio_index], by_ratio[ratio_index]])
  def minimum_width = ratio.as_bits() + Bits(2)(1)
  def part_limit = mux_lookup(ratio, ~default: Bits(4)(2), [[SimdExtensionRatio.By4, Bits(4)(4)], [SimdExtensionRatio.By8, Bits(4)(8)]])
  legal <== (destination_width.as_bits().zext(3) < Bits(3)(format_count)) & (destination_width.as_bits() >= minimum_width) & (part.zext(4) < part_limit)

/* Size a selected-element count, including the full physical byte-lane count. */
fun simd_count_width(xlen :: XLen) :: PosInt:
  bits.length(xlen.width / 8)

/* Pair a stably compacted physical word with its selected-element count. */
bundle SimdCompressed(xlen :: XLen):
  data: Bits(xlen.width)
  count: Bits(simd_count_width(xlen))

/*
 * Pack selected elements in original order into low lanes, clearing unused lanes and leaving
 * cross-word progress to the caller.
 */
circuit SimdCompress(xlen :: XLen):
  def width = xlen.width
  def format_count = if width == 32 | 3 | 4
  input data: Bits(width)
  input element_width: SimdElementWidth
  input selected: Mask(width / 8)
  output compressed: SimdCompressed(xlen)

  def widths = SimdElementWidth.values()
  def alternatives = for List (format in 0..format_count):
    def element_bits = 8 * (2 ** format)
    def lanes = (width / 8) div (2 ** format)
    def mutable prefix = Bits(bits.length(width / 8))(0)
    def ranked = for List (source in 0..lanes):
      def rank :: Bits(bits.length(width / 8)) = prefix
      prefix := prefix + selected[source].as_bits().zext(bits.length(width / 8))
      [rank, data[source * element_bits..(source + 1) * element_bits], selected[source]]

    def packed = for List (destination in 0..lanes):
      def mutable value = Bits(element_bits)(0)
      for (source in 0..lanes):
        value := mux(ranked[source][2] & (ranked[source][0] === Bits(bits.length(width / 8))(destination)), ranked[source][1], value)

      value

    SimdCompressed(xlen):
      data: if lanes == 1 | packed[0] | concat(packed.reverse())
      count: prefix

  compressed <== mux_lookup(element_width, ~default: alternatives[0], for List (format in 1..format_count): [widths[format], alternatives[format]])

export:
  SimdMaskResultSelect
  SimdElementWidth
  SimdResultSelect
  SimdLogicSelect
  SimdComparisonSelect
  SimdPermutationSelect
  SimdCountSelect
  SimdRoundingMode
  SimdArithmeticMode
  SimdAluControl
