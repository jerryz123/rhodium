#lang rhodium
/* Admits WB-authorized vector descriptors and joins shared execution to RV2Wide's LSU timing. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/cosim-source.rhm").describe_cosim_signals
  lib("cores/vector/admission.rhdl") open
  "bundles.rhdl" open
  "vector-memory.rhdl" open
  lib("cores/vector/bundles.rhdl") open
  lib("cores/vector/pipeline.rhdl") open
  lib("cores/vector/muldiv.rhdl") open
  lib("cores/mmu/vector.rhdl") open
  lib("cores/misaligned-access.rhdl") open
  lib("cores/integer-execution.rhdl") open
  lib("cores/register-write.rhdl") open
  lib("cores/multiplier.rhdl") open
  lib("cores/divider.rhdl") open
  lib("cores/fp/bundles.rhdl") open
  lib("cores/fp/timing.rhdl") open
  lib("cores/fp/register-file.rhdl").FloatingPointRegisterWrite
  lib("riscv/isa/xlen.rhm") open
  lib("riscv/isa/vector.rhm") open
  lib("riscv/isa/fp-profile.rhm") open
  lib("riscv/rtl/pointer-masking.rhdl") open
  lib("riscv/rtl/hypervisor.rhdl") open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

/* Queues six WB-authorized descriptors by default without conflating admission, fault certainty,
   last-beat acceptance, and final execution drain. The scalar core owns age order,
   architectural retirement, and arithmetic/write-port arbitration at these ports. */
sync_circuit RV2WideVectorPipeline(xlen :: XLen, vlen :: VectorLength, ~vector_completion_slots: slots :: Pow2Int = 8, ~dispatch_depth: dispatch_depth :: PosInt = 6, ~multiply_latency: multiply_latency :: maybe(PosInt) = #false, ~fixed_fp: fixed_fp :: Boolean = #false, ~fp_timing: fp_timing :: FpExecutionTiming = FpExecutionTiming()):
  def fp_profile = if xlen == XLen.X32 | FloatingPointProfile.F | FloatingPointProfile.D
  def Tag = Bits(index_width(slots))
  interface request(Decoupled(VectorDescriptor(xlen)), ~role: consumer)
  interface pipeline(RV2WidePipelineAccess(xlen), ~role: requester)
  interface memory(RV2WideMemory(xlen, xlen.width), ~role: requester)
  interface split(RiscvSplitAccess(xlen, Bool), ~role: requester)
  interface precheck(VectorPrecheck(), ~role: requester)
  interface outcome(Valid(VectorCommit(xlen, slots)), ~role: producer)
  output outcome_guest: RiscvGuestFault()
  output(pipeline_physical, request_physical): Bool
  interface fp_request(Decoupled(FpExecutionRequest(xlen, fp_profile, Tag)), ~role: producer)
  interface fp_result(Decoupled(FpExecutionResult(xlen, fp_profile, Tag)), ~role: consumer)
  interface multiply_request(Decoupled(IntegerExecutionRequest(MultiplierRequest(xlen.width), VectorMultiplyTag(slots))), ~role: producer)
  interface multiply_result(Irrevocable(IntegerExecutionResult(Bits(xlen.width * 2), VectorMultiplyTag(slots))), ~role: consumer)
  interface divide_request(Decoupled(IntegerExecutionRequest(DividerRequest(xlen.width), VectorDivideTag(slots))), ~role: producer)
  interface divide_result(Irrevocable(IntegerExecutionResult(DividerResponse(xlen.width), VectorDivideTag(slots))), ~role: consumer)
  interface fp_update(Valid(Bits(5)), ~role: producer)
  interface fault_start(Valid(Bits(xlen.width)), ~role: producer)
  interface truncate(Valid(Bits(xlen.width)), ~role: producer)
  interface retire(Pulse(), ~role: producer)
  interface execution_done(Pulse(), ~role: producer)
  interface saturate(Pulse(), ~role: producer)
  interface scalar_result(Valid(RegisterFileWrite(xlen)), ~role: producer)
  interface scalar_writeback(Decoupled(Bits(4)), ~role: producer)
  interface floating_result(Valid(FloatingPointRegisterWrite(fp_profile)), ~role: producer)
  output(active, sequencing, pending, stores_pending, loads_pending, fp_pending, certification_pending, available): Bool

  inst execution(VectorExecution(xlen, vlen, Bits(xlen.width), ~vector_completion_slots: slots, ~multiply_latency: multiply_latency, ~packed_multiply: #true, ~fixed_fp: fixed_fp, ~fp_timing: fp_timing))
  inst access(RV2WideVectorMemory(xlen, slots))
  inst admission(VectorAdmission(xlen, vlen, slots, RiscvGuestFault(), ~pipe: #false, ~dispatch_depth: dispatch_depth))
  request |> admission.request
  admission.dispatch |> execution.request
  admission.precheck <=> precheck
  execution.sequencing_done |> admission.sequencing_done
  admission.requests_idle <== access.requests_idle
  admission.sequencing <== execution.sequencing
  admission.issue_valid <== execution.issue.valid
  execution.packed_memory <== admission.packed_memory
  access.outcome |> admission.precise
  admission.outcome |> outcome
  available <== admission.available
  admission.precise_fault <== access.outcome_guest
  outcome_guest <== admission.outcome_fault
  when (admission.execution_certified & access.feedback.valid):
    assert(access.feedback.bits.disposition.is_one_of(VectorDisposition.Authorized, VectorDisposition.Retry), "certified_vector_cannot_fault")

  execution.issue |> filter_flow(token => token.memory) |> access.issue
  access.feedback |> execution.decision
  access.completion |> execution.completion
  access.store_completed |> execution.store_completed
  access.pipeline <=> pipeline
  access.memory <=> memory
  access.split <=> split
  pipeline_physical <== access.pipeline_physical
  request_physical <== access.request_physical
  access.pointer_masking <== admission.pointer_masking
  execution.cancel.valid <== Bool(#false)
  execution.memory_drained <== memory.drained & access.idle
  execution.schedule_enable <== Bool(#true)
  execution.fp_request |> fp_request
  fp_result |> execution.fp_result
  execution.multiply_request |> multiply_request
  multiply_result |> execution.multiply_result
  execution.divide_request |> divide_request
  divide_result |> execution.divide_result
  execution.fp_update |> fp_update
  execution.fault_start |> fault_start
  execution.truncate |> truncate
  retire.valid <== outcome.valid & (outcome.bits.disposition =/= VectorDisposition.Fault)
  execution.retire |> execution_done
  execution.saturate |> saturate
  execution.scalar_result |> scalar_result
  execution.scalar_writeback |> scalar_writeback
  execution.floating_result |> floating_result
  active <== execution.active ||| admission.active ||| !access.idle
  sequencing <== execution.sequencing
  pending <== execution.pending
  stores_pending <== execution.stores_pending ||| admission.stores_pending
  loads_pending <== execution.loads_pending ||| admission.loads_pending
  fp_pending <== execution.fp_pending ||| admission.fp_pending
  certification_pending <== admission.certification_pending
  describe_cosim_signals({"admitted": request.fire()}, ~components: {"execution": execution, "memory": access})

/* Terminates the optional vector client without allocating a sequencer, VRF, or execution state. */
sync_circuit RV2WideVectorDisabled(xlen :: XLen, ~vector_completion_slots: slots :: Pow2Int = 8):
  def fp_profile = if xlen == XLen.X32 | FloatingPointProfile.F | FloatingPointProfile.D
  def Tag = Bits(index_width(slots))
  interface request(Decoupled(VectorDescriptor(xlen)), ~role: consumer)
  interface pipeline(RV2WidePipelineAccess(xlen), ~role: requester)
  interface memory(RV2WideMemory(xlen, xlen.width), ~role: requester)
  interface split(RiscvSplitAccess(xlen, Bool), ~role: requester)
  interface precheck(VectorPrecheck(), ~role: requester)
  interface outcome(Valid(VectorCommit(xlen, slots)), ~role: producer)
  output outcome_guest: RiscvGuestFault()
  output(pipeline_physical, request_physical): Bool
  interface fp_request(Decoupled(FpExecutionRequest(xlen, fp_profile, Tag)), ~role: producer)
  interface fp_result(Decoupled(FpExecutionResult(xlen, fp_profile, Tag)), ~role: consumer)
  interface multiply_request(Decoupled(IntegerExecutionRequest(MultiplierRequest(xlen.width), VectorMultiplyTag(slots))), ~role: producer)
  interface multiply_result(Irrevocable(IntegerExecutionResult(Bits(xlen.width * 2), VectorMultiplyTag(slots))), ~role: consumer)
  interface divide_request(Decoupled(IntegerExecutionRequest(DividerRequest(xlen.width), VectorDivideTag(slots))), ~role: producer)
  interface divide_result(Irrevocable(IntegerExecutionResult(DividerResponse(xlen.width), VectorDivideTag(slots))), ~role: consumer)
  interface fp_update(Valid(Bits(5)), ~role: producer)
  interface fault_start(Valid(Bits(xlen.width)), ~role: producer)
  interface truncate(Valid(Bits(xlen.width)), ~role: producer)
  interface retire(Pulse(), ~role: producer)
  interface execution_done(Pulse(), ~role: producer)
  interface saturate(Pulse(), ~role: producer)
  interface scalar_result(Valid(RegisterFileWrite(xlen)), ~role: producer)
  interface scalar_writeback(Decoupled(Bits(4)), ~role: producer)
  interface floating_result(Valid(FloatingPointRegisterWrite(fp_profile)), ~role: producer)
  output(active, sequencing, pending, stores_pending, loads_pending, fp_pending, certification_pending, available): Bool
  for (port :: Endpoint in [pipeline.request, memory.request, split.request, precheck.request, outcome, fp_request, multiply_request, divide_request, fp_update, fault_start, truncate, scalar_result, scalar_writeback, floating_result]):
    port.valid <== Bool(#false)
    port.bits <== dont_care(port.bits.type)

  for (port :: Endpoint in [precheck.release, retire, execution_done, saturate]):
    port.valid <== Bool(#false)

  for (port :: Endpoint in [memory.response, precheck.response, fp_result, multiply_result, divide_result]):
    port.ready <== Bool(#true)

  request.ready <== Bool(#false)
  pipeline.commit <== Bool(#false)
  outcome_guest <== literal(RiscvGuestFault(), 0)
  for (value in [pipeline_physical, request_physical, active, sequencing, pending, stores_pending, loads_pending, fp_pending, certification_pending, available]):
    value <== Bool(#false)

export:
  RV2WideVectorPipeline
  RV2WideVectorDisabled
