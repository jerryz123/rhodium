#lang rhodium
/* Composes physical instruction fetching, dual-issue execution, and shared instruction/data caches. */
// SPDX-License-Identifier: Apache-2.0

import:
  "core.rhdl" open
  "frontend.rhdl" open
  "cache.rhdl" open
  "bundles.rhdl" open
  "../cache/config.rhm" open
  "../cache/l1i/cache.rhdl" open
  "../riscv/chi-hart.rhdl" open
  lib("riscv/isa/xlen.rhm") open
  lib("flow/main.rhdl") open
  lib("chi/protocol/channels.rhdl") open

/* Starts from a physical PC and reports ordered retirement and precise stops.
   Branches/replays restart fetch internally; faults halt until a new start pulse.
   Distinct RN-I and RN-F identities separate retained I/D transactions. */
sync_circuit RV2Wide(cache :: CacheConfig, ~chi: config :: RiscvHartCHIConfig, ~instruction_cache: instruction_cache :: CacheConfig = cache):
  input(instruction_node_id, data_node_id): Bits(config.flit.node_id_width)
  interface start(Valid(Bits(64)), ~role: consumer)
  interface retired[2](Valid(RV2WideRetirement()), ~role: producer)
  interface completed(Valid(RV2WideRetirement()), ~role: producer)
  interface redirect(Valid(RV2WideRedirect()), ~role: producer)
  interface instruction_chi(CHIRNIChannels(config.flit), ~role: node)
  interface data_chi(CHIRNChannels(config.flit), ~role: node)
  output halted: Bool
  output(issued, retired_count): Bits(2)
  inst core(RV2WideCore())
  inst frontend(RV2WideFrontend(config))
  inst instruction(L1ICache(XLen.X64, instruction_cache, ~chi: config, ~fetch_bits: 64))
  inst data(RV2WideL1D(cache, ~chi: config))
  start |> frontend.start
  frontend.instructions |> core.instructions
  frontend.instruction_capacity <== core.instruction_capacity
  core.fetch_flush |> frontend.flush
  frontend.memory <=> instruction.core
  frontend.virtual_lookup |> instruction.virtual_lookup
  instruction.prefetch.valid <== Bool(#false)
  instruction.prefetch.bits <== dont_care(instruction.prefetch.bits.type)
  instruction.chi <=> instruction_chi
  instruction.node_id <== instruction_node_id
  core.retired <=> retired
  core.completed |> completed
  def Array(fetch_redirect, reported_redirect) = core.redirect |> fork_valid(2)
  fetch_redirect |> frontend.redirect
  reported_redirect |> redirect
  core.memory <=> data.memory
  core.pipeline <=> data.pipeline
  data.chi <=> data_chi
  data.node_id <== data_node_id
  reg stopped(~init: Bool(#true))
  when (start.valid):
    stopped <== Bool(#false)
  elsewhen (core.redirect.valid & (core.redirect.bits.resolution.disposition === RV2WideDisposition.Fault)):
    stopped <== Bool(#true)
  halted <== stopped
  when (start.valid):
    assert(stopped & data.memory.drained, "rv2wide_start_at_quiescent_boundary")
  assert(instruction_node_id =/= data_node_id, "rv2wide_distinct_cache_identities")
  issued <== core.issued
  retired_count <== core.retired_count
  for (slot in 0..2):
    core.resolution[slot].valid <== Bool(#false)
    core.resolution[slot].bits <== dont_care(RV2WideResolution())

export:
  RV2Wide
