#lang rhodium
/* Composes the dual-issue execution slice with its shared physical coherent data cache. */
// SPDX-License-Identifier: Apache-2.0

import:
  "core.rhdl" open
  "cache.rhdl" open
  "bundles.rhdl" open
  "../cache/config.rhm" open
  "../riscv/chi-hart.rhdl" open
  lib("flow/main.rhdl") open
  lib("chi/protocol/channels.rhdl").CHIRNChannels

/* Exposes instruction packets, ordered retirement, delayed completion, and one RN-F port.
   This is a physical-address execution slice, not a fetching or privileged hart. */
sync_circuit RV2Wide(cache :: CacheConfig, ~chi: config :: RiscvHartCHIConfig):
  input node_id: Bits(config.flit.node_id_width)
  interface instructions(Decoupled(RV2WidePacket()), ~role: consumer)
  interface retired[2](Valid(RV2WideRetirement()), ~role: producer)
  interface completed(Valid(RV2WideRetirement()), ~role: producer)
  interface redirect(Valid(RV2WideRedirect()), ~role: producer)
  interface chi(CHIRNChannels(config.flit), ~role: node)
  output(issued, retired_count): Bits(2)
  inst core(RV2WideCore())
  inst data(RV2WideL1D(cache, ~chi: config))
  instructions |> core.instructions
  core.retired <=> retired
  core.completed |> completed
  core.redirect |> redirect
  core.memory <=> data.memory
  core.pipeline <=> data.pipeline
  data.chi <=> chi
  data.node_id <== node_id
  issued <== core.issued
  retired_count <== core.retired_count
  for (slot in 0..2):
    core.resolution[slot].valid <== Bool(#false)
    core.resolution[slot].bits <== dont_care(RV2WideResolution())

export:
  RV2Wide
