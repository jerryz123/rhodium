#lang rhodium
/* Fetches credited mixed-width blocks with S1 prediction and same-cycle request selection. */
// SPDX-License-Identifier: Apache-2.0

import:
  "bundles.rhdl" open
  "profile.rhm".RV2WideConfig
  "instruction-assembler.rhdl" open
  "../cache/l1i/protocol.rhdl" open
  "../chi-hart.rhdl" open
  lib("cores/bpred/btb.rhdl").Btb
  lib("cores/bpred/btb.rhdl").DisabledBtb
  lib("cores/bpred/ras.rhdl").Ras
  lib("cores/bpred/ras.rhdl").DisabledRas
  lib("cores/bpred/protocol.rhdl") open
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/trap.rhm").ExceptionCause
  lib("riscv/rtl/trap.rhdl") open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

/* Retains a requested PC and the original prediction for a trailing-instruction continuation. */
bundle RV2WideFetchCursor():
  pc: Bits(64)
  prediction: BranchPrediction(XLen.X64)
  continuation: Bool

/* Retains predictor ownership and permission outcomes through the cache-result stage. */
bundle RV2WideFetchAttempt():
  cursor: RV2WideFetchCursor()
  replay: Bool
  fault: RV2WideFetchFault()

/* Issues one block per cycle on hits, reserving returned-block storage before each lookup.
   Replay kills younger attempts but not older packets. Faults stop fetch until WB recovery.
   Invalidation stops old attempts until a restart; simultaneous redirect supplies the new PC.
   Physical PMA checks precede cache resolution; no rejected address reaches CHI. */
sync_circuit RV2WideFrontend(config :: RiscvHartCHIConfig, profile :: RV2WideConfig = RV2WideConfig()):
  interface start(Valid(Bits(64)), ~role: consumer)
  interface redirect(Valid(RV2WideRedirect()), ~role: consumer)
  interface flush(Pulse(), ~role: consumer)
  interface memory(InstructionCacheLookup(64, 64), ~role: requester)
  interface invalidate(Pulse(), ~role: consumer)
  interface virtual_lookup(Decoupled(Bits(64)), ~role: producer)
  interface translation(RV2WideInstructionTranslation(), ~role: requester)
  interface instructions(Decoupled(RV2WidePacket()), ~role: producer)
  interface branch_update(Valid(BranchUpdate(XLen.X64)), ~role: consumer)
  interface predictor_restore(Pulse(), ~role: consumer)
  interface predictor_clear(Pulse(), ~role: consumer)

  reg active(~init: Bool(#false))
  reg cursor(~init: literal(RV2WideFetchCursor(), 0))
  inst btb(if profile.btb_entries == 0 | DisabledBtb(XLen.X64) | Btb(XLen.X64, profile.btb_entries, ~fetch_bytes: 8))
  inst ras(if profile.ras_entries == 0 | DisabledRas(XLen.X64) | Ras(XLen.X64, profile.ras_entries))
  inst s1(ValidPipeAlwaysCapture(RV2WideFetchCursor(), 1, ~flushable: #true))
  inst s2(ValidPipeAlwaysCapture(RV2WideFetchAttempt(), 1, ~flushable: #true))
  inst assembler(RV2WideInstructionAssembler(profile))
  def command = start.valid ||| redirect.valid ||| flush.valid ||| invalidate.valid
  def repair = assembler.repair.valid
  def restore = command ||| predictor_restore.valid
  btb.cursor <== s1.egress.bits.pc
  btb.invalidate_all.valid <== start.valid ||| invalidate.valid ||| predictor_clear.valid
  ras.clear.valid <== btb.invalidate_all.valid
  ras.restore.valid <== restore
  def Array(training, resolution) = branch_update |> fork_valid(2)
  training |> btb.update
  (resolution |> map_valid(update => RasResolution(XLen.X64)):
    actual:
      RasUpdate(XLen.X64):
        action: update.ras_action
        return_address: update.return_address
    predicted_action: update.predicted_ras_action
  ) |> ras.resolve
  assembler.discover |> btb.discover
  assembler.speculate |> ras.speculate
  btb.invalidate.valid <== repair & assembler.repair.bits.invalidate
  btb.invalidate.bits <== assembler.repair.bits.entry
  assembler.ras_head_valid <== ras.head_valid & !restore
  assembler.ras_head <== ras.head
  assembler.pause <== predictor_restore.valid
  def prediction :: BranchPrediction(XLen.X64) = mux(s1.egress.bits.continuation, s1.egress.bits.prediction, btb.prediction.updated(~target: mux(btb.prediction.ras_action.is_one_of(RasAction.Pop, RasAction.PopPush) & ras.head_valid & !restore, ras.head, btb.prediction.target)))
  def result_fault = s2.egress.bits.fault.valid ||| (memory.response.valid & memory.response.bits.access_fault)
  def replay = s2.egress.valid & !s2.egress.bits.fault.valid & (s2.egress.bits.replay ||| (memory.response.valid & memory.response.bits.replay)) & !command
  def fault = s2.egress.valid & !replay & result_fault & !command
  def stop = replay ||| fault
  def reserved = s1.egress.valid.as_bits().zext(2) + s2.egress.valid.as_bits().zext(2)
  assert(reserved <= assembler.available, "rv2wide_fetch_reservations")
  assembler.clear.valid <== command
  assembler.instructions |> instructions

  // S1's combinational prediction feeds S0 directly. Higher-priority recovery
  // replaces canceled reservations; the saved cursor retains a blocked offer.
  def straddle = prediction.valid & (prediction.pc[0..3] === bits(6, 3)) & !prediction.compressed & !s1.egress.bits.continuation
  def next_cursor = RV2WideFetchCursor():
    pc: mux(s1.egress.bits.continuation ||| (prediction.valid & !straddle), prediction.target, s1.egress.bits.pc.align_down(8) + bits(8, 64))
    prediction: prediction
    continuation: straddle
  def restart = start.valid ||| redirect.valid
  def replace = restart ||| (!command & (repair ||| replay))
  def selected :: RV2WideFetchCursor() = priority_mux(~default: cursor):
    start.valid: cursor.updated(~pc: start.bits, ~continuation: Bool(#false))
    redirect.valid: cursor.updated(~pc: redirect.bits.target, ~continuation: Bool(#false))
    repair: cursor.updated(~pc: assembler.repair.bits.target, ~continuation: Bool(#false))
    replay: s2.egress.bits.cursor
    s1.egress.valid: next_cursor
  def attempt_link :: Handle = interface_link(Decoupled(RV2WideFetchCursor()))
  def attempt :: Endpoint = attempt_link.right
  attempt_link.left.valid <== replace ||| (active & !command & !stop & (assembler.available > reserved))
  attempt_link.left.bits <== selected
  def requested = attempt |> trace_event("frontend/s0.request", ~fields: address):
    pc: address.pc
  def Array(array_index, context) = requested |> atomic_fork(2)
  array_index |> map_flow(address => address.pc.align_down(8)) |> virtual_lookup
  context |> to_valid() |> s1.ingress
  when (start.valid):
    active <== Bool(#true)
  elsewhen (redirect.valid):
    active <== Bool(#true)
  elsewhen (flush.valid ||| invalidate.valid):
    active <== Bool(#false)
  elsewhen repair:
    active <== Bool(#true)
  elsewhen fault:
    active <== Bool(#false)
  when (attempt.fire()):
    cursor <== selected.updated(~pc: selected.pc.align_down(8) + bits(8, 64), ~continuation: Bool(#false))
  elsewhen (replace ||| (active & !command & !stop & s1.egress.valid)):
    cursor <== selected

  // S1 translates while array outputs arrive, then resolves physical permissions. A bad
  // instruction PC becomes a fault token, never an aliased aligned fetch.
  def s1_base = translation.address.align_down(8)
  def physical = config.physical_map.lookup(s1_base, s1_base +& bits(7, 64))
  def permitted = physical.mapped & physical.executable & physical.instruction_cacheable & physical.read_idempotent & !physical.device
  def misaligned = !s1.egress.bits.pc.is_aligned(2)
  s1.egress |> filter_valid(cursor => !command & !repair & !stop & cursor.pc.is_aligned(2)) |> map_valid(cursor => cursor.pc) |> translation.request
  def translation_replay = translation.resolution.disposition === RV2WideDisposition.Replay
  def translation_fault = translation.resolution.disposition === RV2WideDisposition.Fault
  def denied = misaligned ||| (!translation_replay & (translation_fault ||| !permitted))
  def looked_up = s1.egress |> filter_valid(_pc => !command & !repair & !stop) |> trace_valid_event("frontend/s1.lookup", ~fields: address):
    pc: address.pc
    predicted: prediction.valid
    target: prediction.target
    replay: translation_replay
    fault: denied
  def Array(resolutions, contexts) = looked_up |> fork_valid(2)
  (resolutions |> filter_valid(_pc => !denied & !translation_replay) |> map_valid(_address => InstructionCacheReq(64)):
    address: s1_base
  ) |> memory.request
  (contexts |> map_valid(address):
    wire attempt: RV2WideFetchAttempt()
    attempt.cursor <== address.updated(~prediction: prediction)
    attempt.replay <== translation_replay & !misaligned
    attempt.fault <== RV2WideFetchFault():
      valid: denied
      cause: mux(misaligned, exception_cause_bits(ExceptionCause.InstructionAddressMisaligned, 64), mux(translation_fault, translation.resolution.cause, exception_cause_bits(ExceptionCause.InstructionAccessFault, 64)))
      value: address.pc
    attempt
  ) |> s2.ingress
  s1.flush <== (command ||| repair ||| stop) & !attempt.fire()
  s2.flush <== command ||| repair ||| stop
  // Local repair/replay cancel younger lookup contexts, not accepted refills or
  // the current S2 response. Only architectural commands detach cache ownership.
  memory.flush <== command
  memory.invalidate_all <== invalidate.valid
  memory.s1_kill <== command ||| repair ||| stop

  // Cache outcomes enter credited block storage. Assembly owns parcel retention,
  // expansion, and continuation-page faults; no cache result waits on issue.
  def outcome = s2.egress |> filter_valid(_attempt => !command & !replay) |> trace_valid_event("frontend/s2.outcome", ~fields: attempt):
    pc: attempt.cursor.pc
    fault: result_fault
  (outcome |> map_valid(attempt):
         def fetch_fault = RV2WideFetchFault():
           valid: result_fault
           cause: mux(attempt.fault.valid, attempt.fault.cause, exception_cause_bits(ExceptionCause.InstructionAccessFault, 64))
           value: mux(attempt.fault.valid, attempt.fault.value, attempt.cursor.pc)
         RV2WideFetchBlock():
           pc: attempt.cursor.pc
           data: memory.response.bits.data
           fault: fetch_fault
           prediction: attempt.cursor.prediction
  ) |> to_decoupled() |> assembler.blocks
  when (s2.egress.valid & !s2.egress.bits.fault.valid & !s2.egress.bits.replay & !command):
    assert(memory.response.valid, "rv2wide_fetch_has_outcome")
  when (assembler.blocks.valid):
    assert(assembler.blocks.ready, "rv2wide_fetch_reserved_response")

export:
  RV2WideFrontend
