#lang rhodium
/* Fetches mixed-width instruction streams using credited 64-bit blocks and ordered replay. */
// SPDX-License-Identifier: Apache-2.0

import:
  "bundles.rhdl" open
  "instruction-assembler.rhdl" open
  "../cache/l1i/protocol.rhdl" open
  "../riscv/chi-hart.rhdl" open
  lib("riscv/isa/trap.rhm").ExceptionCause
  lib("riscv/rtl/trap.rhdl") open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

/* Retains the original PC, translation replay, and admission fault alongside the array lookup. */
bundle RV2WideFetchAttempt():
  pc: Bits(64)
  replay: Bool
  fault: RV2WideFetchFault()

/* Issues one block per cycle on hits, reserving returned-block storage before each lookup.
   Replay kills younger attempts but not older packets. Faults stop fetch until WB recovery.
   Invalidation stops old attempts until a restart; simultaneous redirect supplies the new PC.
   Physical PMA checks precede cache resolution; no rejected address reaches CHI. */
sync_circuit RV2WideFrontend(config :: RiscvHartCHIConfig):
  interface start(Valid(Bits(64)), ~role: consumer)
  interface redirect(Valid(RV2WideRedirect()), ~role: consumer)
  interface flush(Pulse(), ~role: consumer)
  interface memory(InstructionCacheLookup(64, 64), ~role: requester)
  interface invalidate(Pulse(), ~role: consumer)
  interface virtual_lookup(Decoupled(Bits(64)), ~role: producer)
  interface translation(RV2WideInstructionTranslation(), ~role: requester)
  interface instructions(Decoupled(RV2WidePacket()), ~role: producer)

  reg active(~init: Bool(#false))
  reg pc(Bits(64))
  inst s1(ValidPipeAlwaysCapture(Bits(64), 1, ~flushable: #true))
  inst s2(ValidPipeAlwaysCapture(RV2WideFetchAttempt(), 1, ~flushable: #true))
  inst assembler(RV2WideInstructionAssembler())
  def command = start.valid ||| redirect.valid ||| flush.valid ||| invalidate.valid
  def result_fault = s2.egress.bits.fault.valid ||| (memory.response.valid & memory.response.bits.access_fault)
  def replay = s2.egress.valid & !s2.egress.bits.fault.valid & (s2.egress.bits.replay ||| (memory.response.valid & memory.response.bits.replay)) & !command
  def fault = s2.egress.valid & !replay & result_fault & !command
  def stop = replay ||| fault
  def reserved = s1.egress.valid.as_bits().zext(2) + s2.egress.valid.as_bits().zext(2)
  assert(reserved <= assembler.available, "rv2wide_fetch_reservations")
  assembler.clear.valid <== command
  (assembler.instructions |> trace_event("frontend/packet", ~stalls: #true, ~fields: packet):
    count(~format: "unsigned"): packet.count
    pc0: packet.entries[0].pc
    pc1: packet.entries[1].pc
  ) |> instructions

  // S0 reserves capacity before touching the synchronous arrays. Readiness
  // never depends on S1 tag matching or the core's current issue decision.
  def attempt_link :: Handle = interface_link(Decoupled(Bits(64)))
  def attempt :: Endpoint = attempt_link.right
  attempt_link.left.valid <== active & !command & !stop & (assembler.available > reserved)
  attempt_link.left.bits <== pc
  def requested = attempt |> trace_event("frontend/s0.request", ~fields: address):
    pc: address
  def Array(array_index, context) = requested |> atomic_fork(2)
  array_index |> map_flow(address => address.align_down(8)) |> virtual_lookup
  context |> to_valid() |> s1.ingress
  when (start.valid):
    active <== Bool(#true)
    pc <== start.bits
  elsewhen (redirect.valid):
    active <== Bool(#true)
    pc <== redirect.bits.target
  elsewhen (flush.valid ||| invalidate.valid):
    active <== Bool(#false)
  elsewhen fault:
    active <== Bool(#false)
  elsewhen replay:
    pc <== s2.egress.bits.pc
  elsewhen (attempt.fire()):
    pc <== pc.align_down(8) + bits(8, 64)

  // S1 translates while array outputs arrive, then resolves physical permissions. A bad
  // instruction PC becomes a fault token, never an aliased aligned fetch.
  def s1_base = translation.address.align_down(8)
  def physical = config.physical_map.lookup(s1_base, s1_base +& bits(7, 64))
  def permitted = physical.mapped & physical.executable & physical.instruction_cacheable & physical.read_idempotent & !physical.device
  def misaligned = !s1.egress.bits.is_aligned(2)
  s1.egress |> filter_valid(pc => !command & !stop & pc.is_aligned(2)) |> translation.request
  def translation_replay = translation.resolution.disposition === RV2WideDisposition.Replay
  def translation_fault = translation.resolution.disposition === RV2WideDisposition.Fault
  def denied = misaligned ||| (!translation_replay & (translation_fault ||| !permitted))
  def looked_up = s1.egress |> filter_valid(_pc => !command & !stop) |> trace_valid_event("frontend/s1.lookup", ~fields: address):
    pc: address
    replay: translation_replay
    fault: denied
  def Array(resolutions, contexts) = looked_up |> fork_valid(2)
  (resolutions |> filter_valid(_pc => !denied & !translation_replay) |> map_valid(_address => InstructionCacheReq(64)):
    address: s1_base
  ) |> memory.request
  (contexts |> map_valid(address):
    wire attempt: RV2WideFetchAttempt()
    attempt.pc <== address
    attempt.replay <== translation_replay & !misaligned
    attempt.fault <== RV2WideFetchFault():
      valid: denied
      cause: mux(misaligned, exception_cause_bits(ExceptionCause.InstructionAddressMisaligned, 64), mux(translation_fault, translation.resolution.cause, exception_cause_bits(ExceptionCause.InstructionAccessFault, 64)))
      value: address
    attempt
  ) |> s2.ingress
  s1.flush <== command ||| stop
  s2.flush <== command ||| stop
  memory.flush <== command
  memory.invalidate_all <== invalidate.valid
  memory.s1_kill <== command ||| stop

  // Cache outcomes enter credited block storage. Assembly owns parcel retention,
  // expansion, and continuation-page faults; no cache result waits on issue.
  def outcome = s2.egress |> filter_valid(_attempt => !command & !replay) |> trace_valid_event("frontend/s2.outcome", ~fields: attempt):
    pc: attempt.pc
    fault: result_fault
  (outcome |> map_valid(attempt):
         def fetch_fault = RV2WideFetchFault():
           valid: result_fault
           cause: mux(attempt.fault.valid, attempt.fault.cause, exception_cause_bits(ExceptionCause.InstructionAccessFault, 64))
           value: mux(attempt.fault.valid, attempt.fault.value, attempt.pc)
         RV2WideFetchBlock():
           pc: attempt.pc
           data: memory.response.bits.data
           fault: fetch_fault
  ) |> to_decoupled() |> assembler.blocks
  when (s2.egress.valid & !s2.egress.bits.fault.valid & !s2.egress.bits.replay & !command):
    assert(memory.response.valid, "rv2wide_fetch_has_outcome")
  when (assembler.blocks.valid):
    assert(assembler.blocks.ready, "rv2wide_fetch_reserved_response")

export:
  RV2WideFrontend
