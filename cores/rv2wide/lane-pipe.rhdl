#lang rhodium
/* Stores RV2Wide lane payloads with shared PC regions, successor tags, and compact direction checkpoints. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("flow/main.rhdl") open
  lib("rhodium/frontend/kernel.rhm") as kernel
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/rtl/hypervisor.rhdl").RiscvGuestFault
  "bundles.rhdl" open

def RV2WidePcOffsetBits = 12

/* Derives a storage record from its logical type, retaining every field not explicitly changed. */
fun storage_shape(T :: RecordType, replacements :: Map, omitted :: List = []) :: RecordType:
  def kept = T.fields.filter(~keep: fun (field): !(field.name in omitted))
  def fields = for List (field in kept):
    RecordField(field.name, if replacements.has_key(field.name) | replacements[field.name] | field.type)

  RecordType(fields)

/* Copies unchanged named fields in either direction; the caller supplies only derived values. */
fun copy_fields(T :: RecordType, source :: Hardware.packable, replacements :: Map):
  def fields = for List (field in T.fields):
    [field.name, if replacements.has_key(field.name) | replacements[field.name] | kernel.project(source, field.name)]

  kernel.record_create(T, fields)

/* Omit PC aliases and redundant training indices, and replace the successor by its tag.
   Prediction targets, lookup rows, and recovery histories remain independent. */
fun lane_shape(Full :: RecordType, execute :: Boolean, Fault :: DataType, Step :: DataType) :: RecordType:
  def Fetched = Full.field("fetched").type
  def prediction = storage_shape(Fetched.field("prediction").type, {}, ["pc"])
  def fetched = storage_shape(Fetched, {"pc": Bits(RV2WidePcOffsetBits), "sequential_pc": Step, "prediction": prediction, "fault": Fault, "direction": RV2WideDirectionCheckpoint()})
  if execute
  | storage_shape(Full, {"fetched": fetched, "vector": storage_shape(Full.field("vector").type, {}, ["pc"])})
  | block:
      def Branch = Full.field("branch").type
      def update = storage_shape(Branch.field("update").type, {}, ["pc", "return_address"])
      storage_shape(Full, {"fetched": fetched, "branch": storage_shape(Branch, {"update": update})})

/* Project into storage or back into a full lane. The target schema determines
   which aliases are present; they all use the same reconstructed addresses. */
fun recode_lane(T :: RecordType, source :: Hardware.packable, pc :: Hardware.packable, successor :: Hardware.packable, fault :: Hardware.packable, direction :: Hardware.packable, execute :: Boolean):
  def Fetched = T.field("fetched").type
  def original = kernel.project(source, "fetched")
  def prediction = copy_fields(Fetched.field("prediction").type, kernel.project(original, "prediction"), {"pc": pc})
  def fetched = copy_fields(Fetched, original, {"pc": pc, "sequential_pc": successor, "prediction": prediction, "fault": fault, "direction": direction})
  if execute
  | block:
      def vector = copy_fields(T.field("vector").type, kernel.project(source, "vector"), {"pc": pc})
      copy_fields(T, source, {"fetched": fetched, "vector": vector})
  | block:
      def Branch = T.field("branch").type
      def branch = kernel.project(source, "branch")
      def update = copy_fields(Branch.field("update").type, kernel.project(branch, "update"),
                               {"pc": pc, "return_address": kernel.project(fetched, "sequential_pc")})
      copy_fields(T, source, {"fetched": fetched, "branch": copy_fields(Branch, branch, {"update": update})})

/* Preserves the full lane interface and the one-cycle flushable pipe contract. Both
   lanes reconstruct their PC from the group prefix registered at this same stage. */
sync_circuit RV2WideLanePipe(xlen :: XLen, Full :: RecordType, ~hypervisor: hypervisor :: Boolean = #false):
  def execute = Full.type_equal(RV2WideExecute(xlen, hypervisor))
  unless execute || Full.type_equal(RV2WideResult(xlen, hypervisor))
  | error(~who: #'RV2WideLanePipe, "expected this core's execute or result payload")

  interface ingress(Valid(Full), ~role: consumer)
  interface egress(Valid(Full), ~role: producer)
  input flush: Bool
  input pc_region: Bits(xlen.width - RV2WidePcOffsetBits)
  input ingress_step: RV2WidePcStep(xlen)
  output egress_step: RV2WidePcStep(xlen)

  def Fault = if execute | RV2WideFetchFault(xlen, hypervisor) | Bool
  def Stored = lane_shape(Full, execute, Fault, RV2WidePcStep(xlen))
  inst storage(ValidPipe(Stored, 1, ~flushable: #true))
  storage.flush <== flush

  // These aliases are not stored; guard their producer contract at capture.
  when (ingress.valid):
    def fetched :: RV2WideInstruction(xlen, hypervisor) = ingress.bits.fetched
    assert(fetched.direction_indices_valid(), "rv2wide_lane_direction_indices")

  if execute
  | block:
      def token :: RV2WideExecute(xlen, hypervisor) = ingress.bits
      when (ingress.valid):
        assert(token.vector.pc === token.fetched.pc, "rv2wide_lane_vector_pc")
  | block:
      def token :: RV2WideResult(xlen, hypervisor) = ingress.bits
      when (ingress.valid):
        assert(token.branch.update.pc === token.fetched.pc, "rv2wide_lane_branch_pc")
        assert(token.branch.update.return_address === token.fetched.sequential_pc, "rv2wide_lane_branch_return")
        when (token.fetched.fault.valid()):
          assert(token.resolution.disposition === RV2WideDisposition.Fault, "rv2wide_fetch_fault_disposition")
          assert(token.resolution.cause === token.fetched.fault.cause(), "rv2wide_fetch_fault_cause")
          assert(token.resolution.value === token.fetched.fault.value, "rv2wide_fetch_fault_value")
          if hypervisor
          | assert(token.resolution.guest.as_bits() === token.fetched.fault.guest.as_bits(), "rv2wide_fetch_fault_guest")
          | #void

  // EX still needs the fault payload. Later stages need only its origin bit:
  // resolution owns the surviving cause, value, and guest provenance.
  (ingress |> map_valid(token):
    def fetched :: RV2WideInstruction(xlen, hypervisor) = token.fetched
    def fault = fetched.fault
    def encoded = if execute | fault | fault.valid()
    recode_lane(Stored, token, fetched.pc[0..RV2WidePcOffsetBits], ingress_step, encoded, fetched.retained_direction(), execute)
  ) |> storage.ingress

  egress_step <== storage.egress.bits.fetched.sequential_pc
  (storage.egress |> map_valid(token):
    def fault:
      if execute
      | token.fetched.fault
      | block:
          def resolution :: RV2WideSyncResolution(xlen) = token.resolution
          wire observed: RV2WideFetchFault(xlen, hypervisor)
          observed.kind <== mux(token.fetched.fault, fetch_fault_kind(resolution.cause), RV2WideFetchFaultKind.None)
          observed.value <== mux(token.fetched.fault, resolution.value, Bits(xlen.width)(0))
          if hypervisor
          | observed.guest <== mux(token.fetched.fault, resolution.guest, literal(RiscvGuestFault(), 0))
          | #void

          observed

    def pc = pc_region ++ token.fetched.pc
    def step :: RV2WidePcStep(xlen) = token.fetched.sequential_pc
    def direction :: RV2WideDirectionCheckpoint() = token.fetched.direction
    recode_lane(Full, token, pc, step.apply(pc), fault, direction.expanded(pc), execute)
  ) |> egress

export:
  RV2WidePcOffsetBits
  RV2WideLanePipe
