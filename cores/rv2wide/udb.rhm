#lang rhombus
/* Projects RV2Wide's configuration through the shared superscalar UDB contract. */
// SPDX-License-Identifier: Apache-2.0

import:
  "profile.rhm".RV2WideConfig
  "../superscalar/udb.rhm".superscalar_udb_configuration
  lib("riscv/udb.rhm").UdbConfiguration
  lib("support/annotations.rhm").NonemptyString

/* Uses the same projected configuration for architectural publication and RTL. */
fun rv2wide_udb_configuration(profile :: RV2WideConfig, name :: NonemptyString, description :: NonemptyString, physical_address_width :: PosInt) :: UdbConfiguration:
  superscalar_udb_configuration(profile.pipeline, name, description, physical_address_width)

export:
  rv2wide_udb_configuration
