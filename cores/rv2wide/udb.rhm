#lang rhombus
/* Projects RV2Wide's selected scalar architecture and shared CSR/MMU behavior into UDB. */
// SPDX-License-Identifier: Apache-2.0

import:
  "profile.rhm".RV2WideConfig
  lib("riscv/udb.rhm") open
  lib("support/annotations.rhm").NonemptyString
  lib("riscv/isa/zkt.rhm").ZktVersion
  lib("riscv/isa/fp-profile.rhm") open
  lib("riscv/isa/c.rhm").CompressedExtension

/* Encodes an implemented Boolean architectural choice. */
fun boolean_parameter(name :: NonemptyString, value :: Boolean) :: UdbParameter: UdbParameter(name, UdbBooleanValue(value))
/* Encodes a nonnegative architectural bound. */
fun natural_parameter(name :: NonemptyString, value :: Nat) :: UdbParameter: UdbParameter(name, UdbNaturalValue(value))
/* Encodes a textual implementation policy. */
fun string_parameter(name :: NonemptyString, value :: String) :: UdbParameter: UdbParameter(name, UdbStringValue(value))
/* Encodes a nonempty set of legal architectural values. */
fun natural_list_parameter(name :: NonemptyString, elements :: NonemptyList.of(Nat)) :: UdbParameter: UdbParameter(name, UdbNaturalListValue(elements))
/* Encodes indexed counter capability bits. */
fun boolean_list_parameter(name :: NonemptyString, elements :: NonemptyList.of(Boolean)) :: UdbParameter: UdbParameter(name, UdbBooleanListValue(elements))

/* Publishes the selected scalar profile, optional FP subsets, and Sv39's software A/D update policy. */
fun rv2wide_udb_configuration(profile :: RV2WideConfig, name :: NonemptyString, description :: NonemptyString, physical_address_width :: PosInt) :: UdbConfiguration:
  unless physical_address_width <= 64
  | error(~who: #'rv2wide_udb_configuration, "physical address width must fit RV64")
  def versions = [
    ["I", "2.1"], ["M", "2.0"], ["Zmmul", "1.0.0"], ["A", "2.1.0"],
    ["Zaamo", "1.0.0"], ["Zalrsc", "1.0.0"], ["Za64rs", "1.0.0"], ["Za128rs", "1.0.0"],
    ["C", "2.0"], ["Zca", "1.0.0"], ["B", "1.0.0"], ["Zba", "1.0.0"], ["Zbb", "1.0.0"], ["Zbs", "1.0.0"],
    ["Zic64b", "1.0.0"], ["Zicclsm", "1.0.0"], ["Zicntr", "2.0"], ["Zicond", "1.0.0"],
    ["Zicsr", "2.0"], ["Zifencei", "2.0.0"], ["Zihpm", "2.0"], ["Zimop", "1.0.0"], ["Zkt", ZktVersion],
    ["U", "1.0.0"], ["S", "1.13.0"], ["Sm", "1.13.0"], ["Svbare", "1.0.0"], ["Sv39", "1.0.0"], ["Svade", "1.0.0"],
    ["Ssccptr", "1.0.0"], ["Sstvecd", "1.0.0"], ["Sstvala", "1.0.0"], ["Sscounterenw", "1.0.0"], ["Ssu64xl", "1.0.0"]
  ]
  def fp = profile.floating_point == FloatingPointProfile.D
  def half_versions = (if half_precision_supports_zfhmin(profile.half_precision) | [["Zfhmin", "1.0.0"]] | []) ++ (if half_precision_supports_zfh(profile.half_precision) | [["Zfh", "1.0.0"]] | [])
  def compressed_versions = (if profile.compressed.contains(CompressedExtension.Zcb) | [["Zcb", "1.0.0"]] | []) ++ (if profile.compressed.contains(CompressedExtension.Zcmop) | [["Zcmop", "1.0.0"]] | [])
  def selected_versions = versions ++ (if fp | [["F", "2.2.0"], ["D", "2.2.0"], ["Zcd", "1.0.0"]] | []) ++ (if profile.zfa | [["Zfa", "1.0.0"]] | []) ++ half_versions ++ compressed_versions ++ (if profile.zicboz | [["Zicboz", "1.0.0"]] | [])
  def extensions = selected_versions.map(fun (entry): UdbExtension(entry[0], entry[1]))
  def xlen = profile.xlen.width
  def pma_granularity_log2 = 3
  def hpm_counters = for List (_ in 0..32): #false
  def delegatable_counters = for List (index in 0..32): index < 3
  def parameters = [
    natural_parameter("MXLEN", xlen),
    natural_parameter("PHYS_ADDR_WIDTH", physical_address_width),
    natural_parameter("PMA_GRANULARITY", pma_granularity_log2),
    natural_parameter("CACHE_BLOCK_SIZE", profile.hart_description.cbo_block_bytes),
    boolean_parameter("PRECISE_SYNCHRONOUS_EXCEPTIONS", #true),
    boolean_parameter("NON_STANDARD_EXTENSION_IMPLEMENTED", #false),
    boolean_parameter("WFI_FINITE", #false),
    boolean_parameter("WFI_U_MODE", #false),
    boolean_parameter("MEI_INTR_IMPL", #true),
    boolean_parameter("MSI_INTR_IMPL", #true),
    boolean_parameter("MTI_INTR_IMPL", #true),
    boolean_parameter("SEI_INTR_IMPL", #true),
    boolean_parameter("SSI_INTR_IMPL", #true),
    boolean_parameter("STI_INTR_IMPL", #true),
    boolean_parameter("TRAP_ON_ECALL_FROM_M", #true),
    boolean_parameter("TRAP_ON_EBREAK", #true),
    boolean_parameter("TRAP_ON_ILLEGAL_WLRL", #false),
    boolean_parameter("TRAP_ON_UNIMPLEMENTED_INSTRUCTION", #true),
    boolean_parameter("TRAP_ON_RESERVED_INSTRUCTION", #true),
    boolean_parameter("TRAP_ON_UNIMPLEMENTED_CSR", #true),
    boolean_parameter("REPORT_VA_IN_MTVAL_ON_BREAKPOINT", #false),
    boolean_parameter("REPORT_VA_IN_MTVAL_ON_LOAD_MISALIGNED", #true),
    boolean_parameter("REPORT_VA_IN_MTVAL_ON_STORE_AMO_MISALIGNED", #true),
    boolean_parameter("REPORT_VA_IN_MTVAL_ON_INSTRUCTION_MISALIGNED", #true),
    boolean_parameter("REPORT_VA_IN_MTVAL_ON_LOAD_ACCESS_FAULT", #true),
    boolean_parameter("REPORT_VA_IN_MTVAL_ON_STORE_AMO_ACCESS_FAULT", #true),
    boolean_parameter("REPORT_VA_IN_MTVAL_ON_INSTRUCTION_ACCESS_FAULT", #true),
    boolean_parameter("REPORT_ENCODING_IN_MTVAL_ON_ILLEGAL_INSTRUCTION", #true),
    natural_parameter("MTVAL_WIDTH", xlen),
    boolean_parameter("MARCHID_IMPLEMENTED", #false),
    boolean_parameter("MIMPID_IMPLEMENTED", #false),
    natural_parameter("CONFIG_PTR_ADDRESS", 0),
    natural_parameter("VENDOR_ID_BANK", 0),
    natural_parameter("VENDOR_ID_OFFSET", 0),
    boolean_parameter("MISALIGNED_LDST", #true),
    string_parameter("MISALIGNED_LDST_EXCEPTION_PRIORITY", "high"),
    natural_parameter("MISALIGNED_MAX_ATOMICITY_GRANULE_SIZE", 0),
    string_parameter("MISALIGNED_SPLIT_STRATEGY", "custom"),
    string_parameter("M_MODE_ENDIANNESS", "little"),
    boolean_parameter("MISA_CSR_IMPLEMENTED", #true),
    string_parameter("MTVEC_ACCESS", "rw"),
    natural_list_parameter("MTVEC_MODES", [0]),
    natural_parameter("MTVEC_BASE_ALIGNMENT_DIRECT", 4),
    string_parameter("MTVEC_ILLEGAL_WRITE_BEHAVIOR", "custom"),
    boolean_parameter("MCOUNTINHIBIT_IMPLEMENTED", #false),
    boolean_list_parameter("HPM_COUNTER_EN", hpm_counters),
    boolean_list_parameter("MCOUNTENABLE_EN", delegatable_counters),
    natural_parameter("NUM_PMP_ENTRIES", 0),
    boolean_parameter("MUTABLE_MISA_M", #false),
    boolean_parameter("MUTABLE_MISA_A", #false),
    boolean_parameter("MUTABLE_MISA_B", #false),
    boolean_parameter("MISALIGNED_AMO", #false),
    string_parameter("AMO_MISALIGNED_BEHAVIOR", "always raise misaligned exception"),
    string_parameter("LRSC_RESERVATION_STRATEGY", "reserve exactly enough to cover the access"),
    boolean_parameter("LRSC_FAIL_ON_VA_SYNONYM", #false),
    string_parameter("LRSC_MISALIGNED_BEHAVIOR", "always raise misaligned exception"),
    boolean_parameter("LRSC_FAIL_ON_NON_EXACT_LRSC", #true),
    boolean_parameter("TIME_CSR_IMPLEMENTED", #true),
    boolean_parameter("MUTABLE_MISA_U", #false),
    string_parameter("U_MODE_ENDIANNESS", "little"),
    natural_list_parameter("UXLEN", [xlen]),
    boolean_parameter("TRAP_ON_ECALL_FROM_U", #true),
    boolean_parameter("MUTABLE_MISA_S", #false),
    natural_parameter("ASID_WIDTH", 0),
    string_parameter("S_MODE_ENDIANNESS", "little"),
    natural_list_parameter("SXLEN", [xlen]),
    boolean_parameter("REPORT_VA_IN_MTVAL_ON_LOAD_PAGE_FAULT", #true),
    boolean_parameter("REPORT_VA_IN_MTVAL_ON_STORE_AMO_PAGE_FAULT", #true),
    boolean_parameter("REPORT_VA_IN_MTVAL_ON_INSTRUCTION_PAGE_FAULT", #true),
    boolean_parameter("REPORT_VA_IN_STVAL_ON_BREAKPOINT", #false),
    boolean_parameter("REPORT_VA_IN_STVAL_ON_LOAD_MISALIGNED", #true),
    boolean_parameter("REPORT_VA_IN_STVAL_ON_STORE_AMO_MISALIGNED", #true),
    boolean_parameter("REPORT_VA_IN_STVAL_ON_INSTRUCTION_MISALIGNED", #true),
    boolean_parameter("REPORT_VA_IN_STVAL_ON_LOAD_ACCESS_FAULT", #true),
    boolean_parameter("REPORT_VA_IN_STVAL_ON_STORE_AMO_ACCESS_FAULT", #true),
    boolean_parameter("REPORT_VA_IN_STVAL_ON_INSTRUCTION_ACCESS_FAULT", #true),
    boolean_parameter("REPORT_VA_IN_STVAL_ON_LOAD_PAGE_FAULT", #true),
    boolean_parameter("REPORT_VA_IN_STVAL_ON_STORE_AMO_PAGE_FAULT", #true),
    boolean_parameter("REPORT_VA_IN_STVAL_ON_INSTRUCTION_PAGE_FAULT", #true),
    boolean_parameter("REPORT_ENCODING_IN_STVAL_ON_ILLEGAL_INSTRUCTION", #true),
    natural_parameter("STVAL_WIDTH", xlen),
    boolean_list_parameter("SCOUNTENABLE_EN", delegatable_counters),
    natural_list_parameter("STVEC_MODES", [0]),
    boolean_parameter("SATP_MODE_BARE", #true),
    boolean_parameter("TRAP_ON_ECALL_FROM_S", #true),
    natural_list_parameter("MSTATUS_VS_LEGAL_VALUES", [0]),
    natural_list_parameter("MSTATUS_FS_LEGAL_VALUES", if fp | [0, 1, 2, 3] | [0])
  ]
  def fp_parameters:
    if fp
    | [
        boolean_parameter("MUTABLE_MISA_F", #false),
        boolean_parameter("MUTABLE_MISA_D", #false),
        string_parameter("HW_MSTATUS_FS_DIRTY_UPDATE", "precise")
      ]
    | []
  UdbConfiguration(name, description, extensions, parameters ++ fp_parameters ++ [boolean_parameter("MUTABLE_MISA_C", #false)])

export:
  rv2wide_udb_configuration
