#lang rhodium
/* Owns RV2Wide FPR state, fixed EX launch reservations, and WB-authorized FP completion. */
// SPDX-License-Identifier: Apache-2.0

import:
  "profile.rhm".rv2wide_fp_profile
  lib("cores/fp/launch-calendar.rhdl") open
  lib("cores/fp/authorization.rhdl").align_fp_authorization
  "bundles.rhdl" open
  lib("cores/fp/bundles.rhdl") open
  lib("cores/fp/types.rhdl") open
  lib("cores/fp/timing.rhdl") open
  lib("cores/fp/execute.rhdl") open
  lib("cores/fp/register-file.rhdl") open
  lib("cores/fp/load-store.rhdl") open
  lib("riscv/isa/fp-profile.rhm") open
  lib("riscv/isa/xlen.rhm") open
  lib("flow/main.rhdl") open
  lib("rhodium/std/bits.rhdl").Pow2Int

/* Snapshots operands at RR; fixed returns write only with their aligned WB authorization.
   Accepted variable work and load owners survive all speculative pipeline flushes. */
sync_circuit RV2WideFp(xlen :: XLen, timing :: FpExecutionTiming, ~half_precision: half_precision :: HalfPrecisionProfile = HalfPrecisionProfile.None, ~zfa: zfa :: Boolean = #false, ~vector_slots: slots :: Pow2Int = 8):
  def Request = FpExecutionRequest(xlen, rv2wide_fp_profile(xlen), RV2WideFpOwner(xlen))
  def Result = FpExecutionResult(xlen, rv2wide_fp_profile(xlen), RV2WideFpOwner(xlen))
  input read_addresses: Vec(3, Bits(5))
  output read_values: Vec(3, Bits(floating_point_register_width(rv2wide_fp_profile(xlen))))
  input probe: FloatExecutionControl()
  interface book(Valid(FloatExecutionControl()), ~role: consumer)
  output available: Bool
  interface fixed_issue(Valid(Request), ~role: consumer)
  interface variable_issue(Decoupled(Request), ~role: consumer)
  interface authorize(Valid(Request), ~role: consumer)
  interface completion(Valid(Result), ~role: producer)
  interface load_reserve(Valid(RV2WideFpOwner(xlen)), ~role: consumer)
  interface load_hit(Valid(RV2WideFpLoad(xlen)), ~role: consumer)
  interface load_return(Decoupled(RV2WideFpLoad(xlen)), ~role: consumer)
  interface load_write(Valid(RV2WideFpLoad(xlen)), ~role: producer)
  interface state_update(Valid(Bits(5)), ~role: producer)
  output busy: Mask(32)
  output drained: Bool
  interface vector_request(Decoupled(FpExecutionRequest(xlen, rv2wide_fp_profile(xlen), Bits(index_width(slots)))), ~role: consumer)
  interface vector_result(Decoupled(FpExecutionResult(xlen, rv2wide_fp_profile(xlen), Bits(index_width(slots)))), ~role: producer)
  interface vector_reserve(Valid(Bits(5)), ~role: consumer)
  interface vector_write(Valid(FloatingPointRegisterWrite(rv2wide_fp_profile(xlen))), ~role: consumer)
  interface vector_written(Valid(FloatingPointRegisterWrite(rv2wide_fp_profile(xlen))), ~role: producer)


  /* RR return booking and EX launch ownership.
     The booked slot selects execution even when speculative fixed issue is killed. */

  def span = timing.maximum + 1
  /* Separates speculative scalar authorization from irrevocable vector completion ownership. */
  tagged_union Owner():
    Scalar(RV2WideFpOwner(xlen))
    Vector(Bits(index_width(slots)))

  def SharedRequest = FpExecutionRequest(xlen, rv2wide_fp_profile(xlen), Owner())
  def SharedResult = FpExecutionResult(xlen, rv2wide_fp_profile(xlen), Owner())
  def VectorRequest = FpExecutionRequest(xlen, rv2wide_fp_profile(xlen), Bits(index_width(slots)))
  def VectorResult = FpExecutionResult(xlen, rv2wide_fp_profile(xlen), Bits(index_width(slots)))
  inst vector_returns(CompletionQueue(VectorRequest, VectorResult, slots, ~pipe: #false))
  vector_returns.response |> vector_result
  inst launch_calendar(FpLaunchCalendar(timing, span))
  launch_calendar.probe <== probe
  book |> launch_calendar.book
  inst execution(FpExecutionService(xlen, rv2wide_fp_profile(xlen), Owner(), ~half_precision: half_precision, ~zfa: zfa, ~scheduled_writeback: #true, ~timing: timing))
  launch_calendar.fixed_available <== execution.fixed_admission_available
  launch_calendar.vector_waiting <== vector_request.valid
  available <== launch_calendar.available


  /* Shared launch selection preserves the RR scalar booking.
     An unreserved slot fairly chooses scalar variable or vector work. A killed
     fixed scalar issue does not donate its already booked slot to vector work. */

  def scalar_fixed = fixed_issue |> to_decoupled() |> map_flow(request):
    fp_request_with_tag(xlen, rv2wide_fp_profile(xlen), RV2WideFpOwner(xlen), Owner(), request, Owner().Scalar(request.tag))

  def scalar_variable = variable_issue |> map_flow(request):
    fp_request_with_tag(xlen, rv2wide_fp_profile(xlen), RV2WideFpOwner(xlen), Owner(), request, Owner().Scalar(request.tag))

  def vector = vector_request |> map_flow(request):
    fp_request_with_tag(xlen, rv2wide_fp_profile(xlen), Bits(index_width(slots)), Owner(), request, Owner().Vector(request.tag))

  def unreserved = Array(scalar_variable, vector) |> rr_arbiter()
  inst selection(GrantMerge(SharedRequest, 2))
  selection.grants <== vec([launch_calendar.reserved, !launch_calendar.reserved]).into(MaybeOneHot(2))
  Array(scalar_fixed, unreserved) <=> selection.ingress


  /* Atomic launch, return booking, and vector credit allocation.
     Every launched vector owner has completion storage; tagged replies return
     to that owner rather than the current arbitration winner. */

  def Array(launch, booking, credit) = selection.egress |> atomic_fork(3)
  launch |> execution.request
  booking
    |> filter_flow(request => request.tag.is(Owner().Vector).into(Bool) & (request.control.execution.unit =/= FloatUnit.DivideSquareRoot))
    |> map_flow(request => request.control.execution)
    |> launch_calendar.vector_book
  credit
    |> filter_flow(request => request.tag.is(Owner().Vector).into(Bool))
    |> map_flow(request => fp_request_with_tag(xlen, rv2wide_fp_profile(xlen), Owner(), Bits(index_width(slots)), request, request.tag.view(Owner().Vector).payload))
    |> vector_returns.request
  launch_calendar.vector_accepted <== vector_request.fire()

  def Array(scalar_return, vector_return) = execution.result |> demux_flow(2, result => result.tag.is(Owner().Vector).into(Bool))
  vector_return
    |> map_flow(result => fp_result_with_tag(xlen, rv2wide_fp_profile(xlen), Owner(), Bits(index_width(slots)), result, result.tag.view(Owner().Vector).payload))
    |> to_valid()
    |> vector_returns.completion
  def scalar_result = scalar_return |> map_flow(result):
    fp_result_with_tag(xlen, rv2wide_fp_profile(xlen), Owner(), RV2WideFpOwner(xlen), result, result.tag.view(Owner().Scalar).payload)

  when (fixed_issue.valid):
    assert(launch_calendar.reserved & selection.ingress[0].ready, "rv2wide_fp_ex_launch_reserved")


  /* WB authorization and scheduled return qualification.
     Variable work is already authorized; fixed work writes only with its aligned WB owner. */

  def wb_owner = fixed_issue |> valid_pipe(2)
  def authorization_matches = wb_owner.valid & (wb_owner.bits.tag.as_bits() === authorize.bits.tag.as_bits())
  when (authorize.valid):
    assert(authorization_matches, "rv2wide_fp_wb_owner")

  def authorized = align_fp_authorization(
    authorize, timing,
    fun (operation :: FpExecutionRequest(xlen, rv2wide_fp_profile(xlen), RV2WideFpOwner(xlen))): operation.control.execution,
    ~elapsed: 2
  )

  def return_matches = scalar_result.valid & (scalar_result.bits.tag.as_bits() === authorized.bits.tag.as_bits())
  when (authorized.valid):
    assert(return_matches, "rv2wide_fp_authorized_return")

  def completed = scalar_result |> filter_flow(result => !result.tag.speculative ||| authorized.valid) |> to_valid() |> fork_valid(2)
  completed[0] |> completion


  /* FPR reads and architectural write ports.
     Arithmetic and loads have separate ports; immediate load hits outrank backpressurable returns. */

  inst registers(FloatingPointRegisterFile(rv2wide_fp_profile(xlen)))
  registers.read_address_1 <== read_addresses[0]
  registers.read_address_2 <== read_addresses[1]
  registers.read_address_3 <== read_addresses[2]
  read_values <== vec(registers.read_data_1, registers.read_data_2, registers.read_data_3)
  def arithmetic_write = completed[1] |> filter_valid(result => result.tag.destination === FloatDestination.FloatingPoint)
  (arithmetic_write |> map_valid(result => FloatingPointRegisterWrite(rv2wide_fp_profile(xlen))):
    address: result.tag.rd
    data: result.fp_value
  ) |> registers.writes[1]

  /* Port zero priority is immediate load hit, retained vector move, then delayed load.
     A WB hit cannot wait. Vector moves retain their owner until the actual write;
     an accepted miss response remains backpressured behind either higher priority. */

  inst vector_move(OfferRegister(FloatingPointRegisterWrite(rv2wide_fp_profile(xlen))))
  vector_write |> vector_move.update
  def vector_move_result = vector_move.egress |> gate_flow(!load_hit.valid) |> to_valid()
  vector_move_result |> vector_written

  def delayed_load = load_return |> gate_flow(!load_hit.valid & !vector_written.valid) |> to_valid()
  def loaded = Array(load_hit, delayed_load) |> valid_arbiter() |> fork_valid(2)
  loaded[0] |> load_write
  def load_port = loaded[1] |> map_valid(result => FloatingPointRegisterWrite(rv2wide_fp_profile(xlen))):
    address: result.owner.rd
    data: fp_load_value(rv2wide_fp_profile(xlen), result.precision, result.data)

  Array(load_port, vector_move_result) |> valid_arbiter() |> registers.writes[0]
  when (vector_write.valid):
    assert(!vector_move.egress.valid, "rv2wide_vector_fpr_move_retains_one_owner")


  /* Destination reservations and completion forwarding.
     Same-cycle clears win reservation sets and immediately release the busy view. */

  reg reservations(~init: Mask(32)(0))
  def admitted = mux(authorize.valid, authorize.bits.tag, variable_issue.bits.tag)
  def arithmetic_set = (authorize.valid ||| variable_issue.fire()) & (admitted.destination === FloatDestination.FloatingPoint)
  def arithmetic_reservation = Mask(32).from_index(admitted.rd, ~valid: arithmetic_set)
  def load_reservation = Mask(32).from_index(load_reserve.bits.rd, ~valid: load_reserve.valid)
  def arithmetic_release = Mask(32).from_index(arithmetic_write.bits.tag.rd, ~valid: arithmetic_write.valid)
  def load_release = Mask(32).from_index(delayed_load.bits.owner.rd, ~valid: delayed_load.valid)
  def vector_reservation = Mask(32).from_index(vector_reserve.bits, ~valid: vector_reserve.valid)
  def vector_release = Mask(32).from_index(vector_written.bits.address, ~valid: vector_written.valid)
  def set_mask = arithmetic_reservation ||| load_reservation ||| vector_reservation
  def clear_mask = arithmetic_release ||| load_release ||| vector_release
  reservations <== (reservations ||| set_mask) & !clear_mask
  busy <== reservations & !clear_mask


  /* Accepted-work drain and architectural-state updates.
     Outstanding counts track authorization/load reservation through consumed completion. */

  def count_width = index_width(timing.maximum + 8)
  reg outstanding(~init: Bits(count_width)(0))
  def accepted = authorize.valid.as_bits().zext(count_width) + variable_issue.fire().as_bits().zext(count_width) + load_reserve.valid.as_bits().zext(count_width) + vector_reserve.valid.as_bits().zext(count_width)
  def finished = completion.valid.as_bits().zext(count_width) + delayed_load.valid.as_bits().zext(count_width) + vector_written.valid.as_bits().zext(count_width)
  outstanding <== outstanding + accepted - finished
  drained <== !outstanding.any()
  def flags_update = completion.valid & completion.bits.exception_flags_valid
  state_update.valid <== arithmetic_write.valid ||| load_write.valid ||| flags_update
  state_update.bits <== mux(flags_update, completion.bits.exception_flags, Bits(5)(0))

/* Provides the same pipeline-facing ports without FP state, execution, or accepted work. */
sync_circuit RV2WideFpDisabled(xlen :: XLen = XLen.X64, ~vector_slots: slots :: Pow2Int = 8):
  def Request = FpExecutionRequest(xlen, rv2wide_fp_profile(xlen), RV2WideFpOwner(xlen))
  def Result = FpExecutionResult(xlen, rv2wide_fp_profile(xlen), RV2WideFpOwner(xlen))
  input read_addresses: Vec(3, Bits(5))
  output read_values: Vec(3, Bits(floating_point_register_width(rv2wide_fp_profile(xlen))))
  input probe: FloatExecutionControl()
  interface book(Valid(FloatExecutionControl()), ~role: consumer)
  output available: Bool
  interface fixed_issue(Valid(Request), ~role: consumer)
  interface variable_issue(Decoupled(Request), ~role: consumer)
  interface authorize(Valid(Request), ~role: consumer)
  interface completion(Valid(Result), ~role: producer)
  interface load_reserve(Valid(RV2WideFpOwner(xlen)), ~role: consumer)
  interface load_hit(Valid(RV2WideFpLoad(xlen)), ~role: consumer)
  interface load_return(Decoupled(RV2WideFpLoad(xlen)), ~role: consumer)
  interface load_write(Valid(RV2WideFpLoad(xlen)), ~role: producer)
  interface state_update(Valid(Bits(5)), ~role: producer)
  output busy: Mask(32)
  output drained: Bool
  interface vector_request(Decoupled(FpExecutionRequest(xlen, rv2wide_fp_profile(xlen), Bits(index_width(slots)))), ~role: consumer)
  interface vector_result(Decoupled(FpExecutionResult(xlen, rv2wide_fp_profile(xlen), Bits(index_width(slots)))), ~role: producer)
  interface vector_reserve(Valid(Bits(5)), ~role: consumer)
  interface vector_write(Valid(FloatingPointRegisterWrite(rv2wide_fp_profile(xlen))), ~role: consumer)
  interface vector_written(Valid(FloatingPointRegisterWrite(rv2wide_fp_profile(xlen))), ~role: producer)

  read_values <== literal(Vec(3, Bits(floating_point_register_width(rv2wide_fp_profile(xlen)))), 0)
  available <== Bool(#false)
  variable_issue.ready <== Bool(#false)
  completion.valid <== Bool(#false)
  completion.bits <== dont_care(Result)
  load_return.ready <== Bool(#false)
  load_write.valid <== Bool(#false)
  load_write.bits <== dont_care(RV2WideFpLoad(xlen))
  state_update.valid <== Bool(#false)
  state_update.bits <== Bits(5)(0)
  busy <== Mask(32)(0)
  drained <== Bool(#true)
  vector_request.ready <== Bool(#false)
  vector_result.valid <== Bool(#false)
  vector_result.bits <== dont_care(vector_result.bits.type)
  vector_written.valid <== Bool(#false)
  vector_written.bits <== dont_care(vector_written.bits.type)

export:
  RV2WideFp
  RV2WideFpDisabled
