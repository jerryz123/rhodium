#lang rhodium
/* Compacts fetch packets into one eight-entry instruction buffer with ordered prefix consumption. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("riscv/isa/xlen.rhm").XLen
  "bundles.rhdl" open
  lib("flow/main.rhdl") open

/* Coalesces packet boundaries after partial issue; clear discards resident and live offers. */
sync_circuit RV2WideIssueWindow(xlen :: XLen = XLen.X64):
  interface ingress(Decoupled(RV2WidePacket(xlen)), ~role: consumer)
  interface clear(Pulse(), ~role: consumer)
  output head: RV2WidePacket(xlen)
  interface candidates[2](Valid(RV2WideInstruction(xlen)), ~role: producer)
  output available: Bits(4)
  input consume: Bits(2)

  reg count(~init: bits(0, 4))
  reg entries(Vec(8, RV2WideInstruction(xlen)))
  def remaining = count - consume.zext(4)
  available <== bits(8, 4) - count
  ingress.ready <== !clear.valid & (remaining <= bits(6, 4))
  head.count <== mux(count >= bits(2, 4), bits(2, 2), count[0..2])
  head.entries <== vec([entries[0], entries[1]])
  def added = mux(ingress.fire(), ingress.bits.count.zext(4), bits(0, 4))
  // Observe accepted packets without changing their independent ingress readiness.
  def accepted :: Handle = interface_link(Valid(RV2WidePacket(xlen)))
  accepted.left.valid <== ingress.fire()
  accepted.left.bits <== ingress.bits
  describe_interface_contract(ingress, accepted.left, "packet-acceptance", ~trace_model: interface_trace_combinational())
  def parents = accepted.right |> fork_valid(2)
  for (lane in 0..2):
    candidates[lane].valid <== (count > bits(lane, 4)) & !clear.valid
    candidates[lane].bits <== entries[lane]
    def name = "head" ++ to_string(lane)
    describe_interface_window_storage(8, ingress.fire(), consume.zext(4), count, clear.valid, for List (index in 0..2): Bool(index == lane), ~name: name, ~append_count: ingress.bits.count.zext(4))
    describe_interface_contract(parents[lane], candidates[lane], "instruction-window-" ++ name, ~trace_model: interface_trace_window(~name: name))
  when (clear.valid):
    count <== bits(0, 4)
  otherwise:
    count <== remaining + added
    for (index in 0..8):
      def position = bits(index, 4)
      def append = ingress.fire() & (position >= remaining) & (position < (remaining + added))
      def shifted = position + consume.zext(4)
      def incoming = position - remaining
      when append:
        entries[index] <== ingress.bits.entries[incoming[0..1]]
      elsewhen ((consume =/= bits(0, 2)) & (position < remaining)):
        entries[index] <== entries[shifted[0..3]]
  assert(count <= bits(8, 4), "rv2wide_instruction_capacity")
  assert(consume <= head.count, "rv2wide_issue_prefix")
  when (ingress.valid):
    assert((ingress.bits.count === bits(1, 2)) ||| (ingress.bits.count === bits(2, 2)), "rv2wide_packet_count")

export:
  RV2WideIssueWindow
