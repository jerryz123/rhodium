#lang rhodium
/* Adapts separate instruction/data TLBs and a shared walker to RV2Wide's fixed-latency and WB ports. */
// SPDX-License-Identifier: Apache-2.0

import:
  "bundles.rhdl" open
  "../cache/protocol.rhdl" open
  "../cache/operation.rhdl" open
  "../chi-hart.rhdl" open
  "../load-store.rhdl" open
  "../mmu/protocol.rhdl" open
  "../mmu/translation.rhdl" open
  "../mmu/tlb.rhdl" open
  "../mmu/walker.rhdl" open
  "../misaligned-access.rhdl" open
  "../cosim-source.rhm".describe_cosim_signals
  lib("riscv/isa/xlen.rhm") open
  lib("riscv/isa/csr.rhm") open
  lib("riscv/isa/sv39.rhm").Sv39Mode
  lib("riscv/rtl/csr.rhdl") open
  lib("riscv/rtl/privilege.rhdl") open
  lib("riscv/rtl/sv39.rhdl") open
  lib("flow/main.rhdl") open
  lib("rhodium/std/bits.rhdl") open

/* Distinguishes physical response owners independently of live translation and fragment state. */
hardware_enum RV2WidePhysicalOwner:
  Core
  Split
  Walker

/* Keeps response routing independent of addresses, speculative redirects, and canceled walks. */
bundle RV2WidePhysicalResponse():
  data: Bits(64)
  origin: RV2WidePhysicalOwner

/* Resolves speculative hits without allocation; only WB data misses request walks.
   Instruction walks survive replay, pending WB walks have priority, and physical
   requests arbitrate core-first without locking the cache for a walk's lifetime. */
sync_circuit RV2WideMmu(config :: RiscvHartCHIConfig):
  input state: RV2WideTranslationState()
  input invalidate: Bool
  interface instruction(RV2WideInstructionTranslation(), ~role: responder)
  interface pipeline(RV2WidePipelineAccess(), ~role: responder)
  interface memory(RV2WideMemory(), ~role: responder)
  interface split(RiscvSplitAccess(XLen.X64, Bool), ~role: responder)
  interface pipeline_lookup(Valid(CachePipelineReq(XLen.X64)), ~role: producer)
  interface physical_pipeline(CachePipelineAccess(XLen.X64), ~role: requester)
  interface physical_memory(RV2WideMemory(), ~role: requester)

  inst itlb(RiscvTranslationTlb())
  inst dtlb(RiscvTranslationTlb())
  inst walker(RiscvTranslationWalker())
  inst misaligned(RiscvMisalignedEngine(XLen.X64, Bool))
  split.request |> misaligned.start
  misaligned.completion |> split.response
  misaligned.request_guest <== literal(misaligned.request_guest.type, 0)
  def split_request = misaligned.request |> map_flow(request => RV2WideMemoryReq()):
    address: request.address
    access: request.access
    atomic: request.atomic
    width: request.width
    data: request.data
    mask: request.byte_mask
  reg cancel(~init: Bool(#false))
  cancel <== invalidate
  walker.cancel <== cancel
  itlb.invalidate_all <== invalidate
  dtlb.invalidate_all <== invalidate

  /* Captures effective privilege and permission controls in the shared host lookup shape. */
  fun lookup(address :: Bits(64), access :: Sv39Access, privilege :: PrivilegeMode) :~ RiscvTlbLookup():
    def request = RiscvTranslationRequest():
      virtual_address: address
      root_ppn: csr_field(state.satp, Satp64PPN)
      access: access
      privilege: privilege
      sum: csr_flag(state.mstatus, MstatusSUM)
      mxr: csr_flag(state.mstatus, MstatusMXR)
      pbmte: Bool(#false)
    riscv_host_lookup(request, ~enabled: (privilege =/= PrivilegeMode.Machine) & (csr_field(state.satp, Satp64Mode) === bits(Sv39Mode, 4)))

  def instruction_lookup = lookup(instruction.request.bits, Sv39Access.Fetch, state.privilege)
  def Array(early_index, retained_request) = pipeline.request |> fork_valid(2)
  /* Positions a raw beat without changing the original VA retained by the core. */
  fun cache_request(request :: RV2WideMemoryReq()) :~ CachePipelineReq(XLen.X64):
    CachePipelineReq(XLen.X64):
      byte_mask: request.mask
      address: request.address.align_down(8)
      access: request.access
      width: MemoryWidth.Double
      unsigned: Bool(#true)
      data: request.data
  early_index |> map_valid(request => cache_request(request)) |> pipeline_lookup
  def mem_request = retained_request |> valid_pipe(1)
  def mem :: RV2WideMemoryReq() = mem_request.bits
  def data_request :: RV2WideMemoryReq() = mux(split_request.valid, split_request.bits, mux(memory.request.valid, memory.request.bits, mem))
  def data_virtual_address = mux(split_request.valid, misaligned.fault_address, data_request.address)
  def data_demand = split_request.valid ||| (memory.request.valid & !misaligned.busy)
  def data_lookup = lookup(data_virtual_address, mux(data_request.access.store_fault_class(), Sv39Access.Store, Sv39Access.Load), effective_data_privilege(XLen.X64, state.privilege, state.mstatus))
  itlb.lookup <== instruction_lookup
  itlb.probe <== instruction_lookup
  dtlb.lookup <== data_lookup
  dtlb.probe <== data_lookup

  // Faults are not TLB entries. Retain each port's exact failed request until
  // its replay observes it; context matching prevents reuse after CSR changes.
  reg instruction_fault_valid(~init: Bool(#false))
  reg data_fault_valid(~init: Bool(#false))
  reg instruction_fault(RiscvTlbFill())
  reg data_fault(RiscvTlbFill())
  def instruction_failed = instruction_fault_valid & (instruction_fault.request.as_bits() === instruction_lookup.as_bits())
  def data_failed = data_fault_valid & (data_fault.request.as_bits() === data_lookup.as_bits())
  def instruction_known = itlb.hit ||| instruction_failed
  def data_known = dtlb.hit ||| data_failed
  def instruction_result = mux(instruction_failed, instruction_fault.result, itlb.translation)
  def data_result = mux(data_failed, data_fault.result, dtlb.translation)
  def data_ok = data_known & (data_result.fault === RiscvTranslationFault.None)
  instruction.address <== instruction_result.physical_address.zext(64)
  instruction.resolution <== RV2WideResolution():
    disposition: mux(!instruction_known, RV2WideDisposition.Replay, mux(instruction_result.fault === RiscvTranslationFault.None, RV2WideDisposition.Continue, RV2WideDisposition.Fault))
    cause: riscv_translation_fault_cause(instruction_result)
    value: instruction.request.bits

  // WB takes the demand lookup port. A simultaneous MEM request replays rather
  // than mistaking WB's translation or cache result for its own.
  def mem_address = data_result.physical_address.zext(64)
  def region = config.physical_map.lookup(mem_address, mem_address +& (memory_access_bytes(XLen.X64, mem_request.bits.width) - bits(1, 64)))
  def cacheable = region.cacheable & !region.device & region.read_idempotent
  def atomic_request = !mem.access.is_one_of(CacheOperation.Load, CacheOperation.Store)
  def mem_misaligned = !atomic_request & !mem.width.is_aligned(mem.address)
  def permitted = region.mapped & mux(mem.access.store_fault_class(), region.writable, region.readable) & (!atomic_request ||| (cacheable & region.atomic & region.readable))
  def speculative_ok = !data_demand & !misaligned.busy & !mem_misaligned & data_ok & permitted & cacheable & !atomic_request & !physical_memory.ordered_busy
  (mem_request |> filter_valid(_request => speculative_ok)
    |> map_valid(request => cache_request(request).updated(~address: mem_address.align_down(8)))
  ) |> physical_pipeline.request
  def cache_outcome = mux_lookup(physical_pipeline.response.bits.outcome, ~default: RV2WideCacheOutcome.Replay):
    CachePipelineOutcome.Slow: RV2WideCacheOutcome.Slow
    CachePipelineOutcome.LoadHit: RV2WideCacheOutcome.LoadHit
    CachePipelineOutcome.StoreHit: RV2WideCacheOutcome.StoreHit
  wire outcome: RV2WideCacheOutcome
  when (data_demand ||| misaligned.busy):
    outcome <== RV2WideCacheOutcome.Replay
  elsewhen mem_misaligned:
    outcome <== RV2WideCacheOutcome.Slow
  elsewhen (!data_known):
    outcome <== RV2WideCacheOutcome.Slow
  elsewhen (data_result.fault === RiscvTranslationFault.PageFault):
    outcome <== RV2WideCacheOutcome.PageFault
  elsewhen ((data_result.fault =/= RiscvTranslationFault.None) ||| !permitted):
    outcome <== RV2WideCacheOutcome.AccessFault
  elsewhen (!cacheable ||| atomic_request):
    outcome <== RV2WideCacheOutcome.Slow
  otherwise:
    outcome <== mux(physical_pipeline.response.valid, cache_outcome, RV2WideCacheOutcome.Replay)
  pipeline.response.valid <== mem_request.valid
  pipeline.response.bits <== RV2WideLookupResult():
    outcome: outcome
    data: physical_pipeline.response.bits.data
  physical_pipeline.commit <== pipeline.commit & !misaligned.busy
  pipeline.commit_ready <== physical_pipeline.commit_ready & !misaligned.busy

  reg pending_data(~init: Bool(#false))
  reg pending_lookup(RiscvTlbLookup())
  reg walk_live(~init: Bool(#false))
  reg walk_data(Bool)
  reg walk_lookup(RiscvTlbLookup())
  def data_miss = data_demand & !data_known
  def same_active_data = walk_live & walk_data & (walk_lookup.as_bits() === data_lookup.as_bits())
  def instruction_miss = instruction.request.valid & !instruction_known
  def choose_data = pending_data ||| data_miss
  walker.request.valid <== !walk_live & !cancel & !invalidate & (choose_data ||| instruction_miss)
  walker.request.bits <== mux(choose_data, mux(pending_data, pending_lookup, data_lookup), instruction_lookup)
  walker.completion.ready <== Bool(#true)
  def fill = RiscvTlbFill():
    request: walk_lookup
    result: walker.completion.bits
  itlb.fill.valid <== walker.completion.valid & walk_live & !walk_data & !invalidate
  dtlb.fill.valid <== walker.completion.valid & walk_live & walk_data & !invalidate
  itlb.fill.bits <== fill
  dtlb.fill.bits <== fill
  when invalidate:
    walk_live <== Bool(#false)
  elsewhen (walker.request.fire()):
    walk_live <== Bool(#true)
    walk_data <== choose_data
    walk_lookup <== walker.request.bits
  elsewhen (walker.completion.valid):
    walk_live <== Bool(#false)
  when (invalidate ||| (walker.request.fire() & choose_data)):
    pending_data <== Bool(#false)
  elsewhen (data_miss & !same_active_data & !pending_data):
    pending_data <== Bool(#true)
    pending_lookup <== data_lookup
  when invalidate:
    instruction_fault_valid <== Bool(#false)
  elsewhen (walker.completion.valid & walk_live & !walk_data):
    instruction_fault_valid <== walker.completion.bits.fault =/= RiscvTranslationFault.None
    instruction_fault <== fill
  when invalidate:
    data_fault_valid <== Bool(#false)
  elsewhen (walker.completion.valid & walk_live & walk_data):
    data_fault_valid <== walker.completion.bits.fault =/= RiscvTranslationFault.None
    data_fault <== fill

  // The owner FIFO tracks accepted physical transactions, not live walks.
  // Cancellation suppresses translation publication, never response draining.
  inst requests(Arbiter(RV2WideMemoryReq(), 3))
  inst owners(Queue(RV2WidePhysicalOwner, 8))
  (memory.request |> gate_flow(data_ok & !misaligned.busy)
    |> map_flow(request => request.updated(~address: data_result.physical_address.zext(64)))
  ) |> requests.ingress[0]
  def fragment_address = data_result.physical_address.zext(64).align_down(8)
  def fragment_region = config.physical_map.lookup(fragment_address, fragment_address +& bits(7, 64))
  def fragment_permitted = fragment_region.mapped & fragment_region.cacheable & !fragment_region.device & fragment_region.read_idempotent & mux(data_request.access.store_fault_class(), fragment_region.writable, fragment_region.readable)
  (split_request |> gate_flow(data_ok & fragment_permitted)
    |> map_flow(request => request.updated(~address: fragment_address))
  ) |> requests.ingress[1]
  def pte_region = config.physical_map.lookup(walker.memory.request.bits.address, walker.memory.request.bits.address +& bits(7, 64))
  def pte_permitted = pte_region.mapped & pte_region.cacheable & !pte_region.device & pte_region.read_idempotent & pte_region.readable
  requests.ingress[2].valid <== walker.memory.request.valid & pte_permitted
  requests.ingress[2].bits <== RV2WideMemoryReq():
    address: walker.memory.request.bits.address
    access: CacheOperation.Load
    atomic: dont_care(memory.request.bits.atomic.type)
    width: MemoryWidth.Double
    data: bits(0, 64)
    mask: bits(0xff, 8)
  def origin = requests.chosen.into(RV2WidePhysicalOwner)
  def pte_selected = origin === RV2WidePhysicalOwner.Walker
  def split_selected = origin === RV2WidePhysicalOwner.Split
  def Array(physical_request, owner) = requests.egress |> atomic_fork(2)
  physical_request |> physical_memory.request
  owner |> map_flow(_request => origin) |> owners.ingress
  def pte_fault = (walker.memory.request.valid & !pte_permitted) ||| (physical_memory.fault.valid & pte_selected)
  walker.memory.request.ready <== requests.ingress[2].ready ||| pte_fault
  walker.memory.request_access_fault <== pte_fault
  memory.fault.valid <== memory.request.valid & !misaligned.busy & ((data_known & !data_ok) ||| (physical_memory.fault.valid & (origin === RV2WidePhysicalOwner.Core)))
  memory.fault.bits <== RV2WideResolution():
    disposition: RV2WideDisposition.Fault
    cause: mux(!data_ok, riscv_translation_fault_cause(data_result), physical_memory.fault.bits.cause)
    value: memory.request.bits.address
  misaligned.request_fault <== split_request.valid & data_known & (data_result.fault === RiscvTranslationFault.PageFault)
  misaligned.request_access_fault <== split_request.valid & data_known & !misaligned.request_fault & ((data_result.fault =/= RiscvTranslationFault.None) ||| !fragment_permitted ||| (physical_memory.fault.valid & split_selected))
  memory.drained <== physical_memory.drained & (owners.count === bits(0, owners.count.type.width)) & !misaligned.busy
  memory.ordered_busy <== physical_memory.ordered_busy
  def responses = Array(physical_memory.response, owners.egress) |> zip_flow(data, origin):
    RV2WidePhysicalResponse():
      data: data
      origin: origin
  def Array(core_response, split_response, pte_response) = responses |> demux_flow(3, response => response.origin.as_bits())
  core_response |> map_flow(response => response.data) |> memory.response
  (split_response |> map_flow(response => PhysicalMemoryResp(XLen.X64, Bool)):
    data: response.data
    context: Bool(#false)
    access_fault: Bool(#false)
  ) |> misaligned.physical_response
  pte_response |> map_flow(response => response.data) |> to_valid() |> walker.memory.response

  describe_cosim_signals({
    "pipeline_valid": physical_pipeline.request.valid,
    "pipeline_address": mem_address,
    "request_valid": requests.ingress[0].fire(),
    "request_address": requests.ingress[0].bits.address,
    "fragment_valid": requests.ingress[1].fire(),
    "fragment_address": fragment_address,
    "fragment_virtual": misaligned.fault_address,
    "fragment_mask": split_request.bits.mask,
    "fragment_data": split_request.bits.data,
    "fragment_response": split_response.fire(),
    "fragment_response_data": split_response.bits.data
  })

export:
  RV2WideMmu
