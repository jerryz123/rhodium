#lang rhodium
/* Adapts separate instruction/data TLBs and a shared walker to RV2Wide's fixed-latency and WB ports. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/mmu/context.rhdl").riscv_translation_lookup
  lib("riscv/rtl/hypervisor.rhdl") open
  lib("riscv/rtl/pointer-masking.rhdl") open
  "bundles.rhdl" open
  "../cache/protocol.rhdl" open
  "../cache/config.rhm".CacheLineBytes
  "../cache/operation.rhdl" open
  "../cache-prefetch.rhdl" open
  "../chi-hart.rhdl" open
  "../load-store.rhdl" open
  "../mmu/protocol.rhdl" open
  "../mmu/translation.rhdl" open
  "../mmu/tlb.rhdl" open
  "../mmu/walker.rhdl" open
  "../misaligned-access.rhdl" open
  "../cosim-source.rhm".describe_cosim_signals
  lib("riscv/isa/xlen.rhm") open
  lib("riscv/isa/csr.rhm") open
  lib("riscv/isa/sv39.rhm").Sv39Mode
  lib("riscv/isa/trap.rhm").ExceptionCause
  lib("riscv/rtl/trap.rhdl").exception_cause_bits
  lib("riscv/rtl/csr.rhdl") open
  lib("riscv/rtl/cmo.rhdl") open
  lib("riscv/rtl/zihintntl.rhdl") open
  lib("riscv/rtl/privilege.rhdl") open
  lib("riscv/rtl/sv39.rhdl") open
  lib("riscv/rtl/svpbmt.rhdl") open
  lib("flow/main.rhdl") open
  lib("rhodium/std/bits.rhdl") open
  lib("cores/mmu/vector.rhdl") open
  lib("cores/mmu/vector-window.rhdl").VectorWindow

/* Distinguishes physical response owners independently of live translation and fragment state. */
hardware_enum RV2WidePhysicalOwner:
  Core
  Split
  Walker

/* Keeps response routing independent of addresses, speculative redirects, and canceled walks. */
bundle RV2WidePhysicalResponse():
  data: Bits(64)
  origin: RV2WidePhysicalOwner

/* Resolves speculative hits without allocation; only WB data misses request walks.
   Instruction walks survive replay, pending WB walks have priority, and physical
   requests arbitrate core-first without locking the cache for a walk's lifetime.
   Optional Svnapot enables shared 64 KiB mappings in both translation banks. */
sync_circuit RV2WideMmu(config :: RiscvHartCHIConfig, ~svnapot: svnapot :: Boolean = #false):
  input state: RV2WideTranslationState(XLen.X64)
  input invalidate: Bool
  input split_guest_access: RiscvGuestMemoryAccess
  input(pipeline_vector, request_vector): Bool
  interface vector_precheck(VectorPrecheck(), ~role: responder)
  interface prefetch(Valid(CachePrefetchReq(64)), ~role: consumer)
  interface physical_prefetch(Valid(CachePrefetchReq(64)), ~role: producer)
  interface instruction(RV2WideInstructionTranslation(XLen.X64), ~role: responder)
  interface pipeline(RV2WidePipelineAccess(XLen.X64), ~role: responder)
  interface memory(RV2WideMemory(XLen.X64, 64), ~role: responder)
  interface split(RiscvSplitAccess(XLen.X64, Bool), ~role: responder)
  interface pipeline_lookup(Valid(CachePipelineReq(XLen.X64)), ~role: producer)
  interface physical_pipeline(CachePipelineAccess(XLen.X64), ~role: requester)
  interface physical_memory(RV2WideMemory(XLen.X64, 64), ~role: requester)


  /* Translation and split-access owners */

  inst itlb(RiscvTranslationTlb())
  inst dtlb(RiscvTranslationTlb())
  inst walker(RiscvTranslationWalker(~svnapot: svnapot))
  inst misaligned(RiscvMisalignedEngine(XLen.X64, Bool))
  inst vector_window(VectorWindow(config.physical_map))
  vector_precheck <=> vector_window.check
  reg mem_vector(~init: Bool(#false))
  mem_vector <== pipeline_vector
  assert(!(invalidate & vector_window.owned), "rv2wide_vector_window_drained_before_invalidation")
  split.request |> misaligned.start
  reg split_mode(RiscvGuestMemoryAccess)


  /* Retained split-access context and fault-address normalization */

  def selected_mask :: PointerMaskControl() = mux(split_mode === RiscvGuestMemoryAccess.Normal, state.pointer_masking, state.guest_pointer_masking)
  def split_mask = selected_mask.updated(~mode: mux(split_mode === RiscvGuestMemoryAccess.GuestExecuteRead, PointerMaskMode.Disabled, selected_mask.mode))
  def split_fault_address = apply_pointer_mask(XLen.X64, misaligned.fault_address, split_mask)
  misaligned.completion |> map_valid(result => result.updated(~fault_address: apply_pointer_mask(XLen.X64, result.fault_address, split_mask))) |> split.response
  when (split.request.fire()):
    split_mode <== split_guest_access

  def split_request = misaligned.request |> map_flow(request => RV2WideMemoryReq(XLen.X64, 64)):
    guest_access: split_mode
    address: request.address
    access: request.access
    atomic: request.atomic
    width: request.width
    data: request.data
    mask: request.byte_mask
    locality: request.locality
    pbmt: PageMemoryType.PMA


  /* Architectural invalidation
     Cancel the walker one cycle later; accepted physical response owners remain live. */

  reg cancel(~init: Bool(#false))
  cancel <== invalidate
  walker.cancel <== cancel
  itlb.invalidate_all <== invalidate
  dtlb.invalidate_all <== invalidate


  /* Effective data context and TLB request selection
     Authorized split/WB demand takes the DTLB ahead of speculative MEM lookup. */

  def guest_state :: RiscvHypervisorTranslation() = state.guest
  def data_privilege = effective_data_privilege(XLen.X64, state.privilege, state.mstatus)
  def normal_data_guest = mux((state.privilege === PrivilegeMode.Machine) & csr_flag(state.mstatus, MstatusMPRV), csr_flag(state.mstatus, MstatusMPV) & (data_privilege =/= PrivilegeMode.Machine), guest_state.virtualized)

  /* Captures both translation stages and their independent permission controls in each lookup owner. */
  fun lookup(address :: Bits(64), access :: Sv39Access, privilege :: PrivilegeMode, guest :: Bool) :~ RiscvTlbLookup():
    riscv_translation_lookup(address, access, privilege, (privilege =/= PrivilegeMode.Machine) & (csr_field(state.satp, Satp64Mode) === Bits(4)(Sv39Mode)), csr_field(state.satp, Satp64PPN), csr_flag(state.mstatus, MstatusSUM), csr_flag(state.mstatus, MstatusMXR), state.pbmte, guest, guest_state)

  def instruction_lookup = lookup(instruction.request.bits, Sv39Access.Fetch, state.privilege, guest_state.virtualized)
  def Array(early_index, retained_request) = pipeline.request |> fork_valid(2)

  /* Positions a raw beat without changing the original VA retained by the core. */
  fun cache_request(request :: RV2WideMemoryReq(XLen.X64, 64)) :~ CachePipelineReq(XLen.X64):
    CachePipelineReq(XLen.X64):
      byte_mask: request.mask
      address: request.address.align_down(8)
      access: request.access
      width: MemoryWidth.Double
      unsigned: Bool(#true)
      data: request.data

  early_index |> map_valid(request => cache_request(request)) |> pipeline_lookup
  def mem_request = retained_request |> valid_pipe(1)
  def mem :: RV2WideMemoryReq(XLen.X64, 64) = mem_request.bits
  def data_request :: RV2WideMemoryReq(XLen.X64, 64) = priority_mux(~default: mem):
    split_request.valid: split_request.bits
    memory.request.valid: memory.request.bits

  def data_virtual_address = mux(split_request.valid, split_fault_address, data_request.address)
  def data_demand = split_request.valid ||| (memory.request.valid & !misaligned.busy)
  def vector_probe = vector_window.translation.request.valid & !data_demand & !misaligned.busy
  vector_window.addresses <== vec(mem.address, memory.request.bits.address)
  def window_hit = !split_request.valid & !vector_probe & mux(memory.request.valid, request_vector & vector_window.hits[1], mem_vector & vector_window.hits[0])
  def window_address = mux(memory.request.valid, vector_window.physical_addresses[1], vector_window.physical_addresses[0])
  def explicit_guest = data_request.guest_access =/= RiscvGuestMemoryAccess.Normal
  def execute_read = data_request.guest_access === RiscvGuestMemoryAccess.GuestExecuteRead
  def data_guest = explicit_guest ||| normal_data_guest
  def data_access = priority_mux(~default: Sv39Access.Load):
    data_request.access.is_cache_management(): Sv39Access.CacheManagement
    data_request.access.store_fault_class(): Sv39Access.Store

  def explicit_guest_privilege = mux(csr_flag(guest_state.hstatus, HstatusSPVP), PrivilegeMode.Supervisor, PrivilegeMode.User)
  def selected_data_privilege = mux(explicit_guest, explicit_guest_privilege, data_privilege)
  def normal_lookup = lookup(data_virtual_address, data_access, selected_data_privilege, data_guest).updated(~execute_read: execute_read)
  def data_lookup = mux(vector_probe, lookup(vector_window.translation.request.bits.address, mux(vector_window.translation.request.bits.store, Sv39Access.Store, Sv39Access.Load), data_privilege, normal_data_guest), normal_lookup)
  itlb.lookup <== instruction_lookup
  dtlb.lookup <== data_lookup


  /* Registered hints never contend with demand translation or allocate a walk.
     A context change discards both staged forms, including the outgoing edge. */

  reg prefetch_previous_state(RV2WideTranslationState(XLen.X64), ~init: literal(RV2WideTranslationState(XLen.X64), 0))
  prefetch_previous_state <== state
  def prefetch_flush = invalidate ||| (prefetch_previous_state.as_bits() =/= state.as_bits())
  inst virtual_prefetch_pipe(ValidPipeAlwaysCapture(CachePrefetchReq(64), 1, ~flushable: #true))
  inst physical_prefetch_pipe(ValidPipeAlwaysCapture(CachePrefetchReq(64), 1, ~flushable: #true))
  virtual_prefetch_pipe.flush <== prefetch_flush
  physical_prefetch_pipe.flush <== prefetch_flush
  prefetch |> virtual_prefetch_pipe.ingress
  def prefetch_request :: CachePrefetchReq(64) = virtual_prefetch_pipe.egress.bits
  def prefetch_privilege = effective_data_privilege(XLen.X64, state.privilege, state.mstatus)
  def prefetch_lookup = lookup(prefetch_request.address, Sv39Access.Load, prefetch_privilege, normal_data_guest)
  itlb.probe <== prefetch_lookup
  dtlb.probe <== prefetch_lookup
  def instruction_prefetch = prefetch_request.operation === CachePrefetchOperation.Instruction
  def prefetch_hit = mux(instruction_prefetch, itlb.probe_hit, dtlb.probe_hit)
  def prefetch_fault = mux(instruction_prefetch, itlb.probe_fault, dtlb.probe_fault)
  def prefetch_translated = normal_data_guest ||| (prefetch_privilege =/= PrivilegeMode.Machine) & (csr_field(state.satp, Satp64Mode) === Bits(4)(Sv39Mode))
  def prefetch_address_valid = prefetch_translated ||| !prefetch_request.address[56..64].or_reduce()
  def prefetch_address = mux(instruction_prefetch, itlb.probe_physical_address, dtlb.probe_physical_address).zext(64).align_down(CacheLineBytes)
  def prefetch_region = config.physical_map.lookup(prefetch_address, prefetch_address +& Bits(64)(CacheLineBytes - 1))
  def prefetch_attributes = resolve_memory_attributes(prefetch_region, mux(instruction_prefetch, itlb.probe_pbmt, dtlb.probe_pbmt))
  def prefetch_permission = mux_lookup(prefetch_request.operation, ~default: Bool(#false)):
    CachePrefetchOperation.Instruction: prefetch_region.executable
    CachePrefetchOperation.Read: prefetch_region.readable
    CachePrefetchOperation.Write: prefetch_region.writable

  def prefetch_cacheable = mux(instruction_prefetch, prefetch_attributes.instruction_cacheable, prefetch_attributes.cacheable)
  def prefetch_ordinary_memory = prefetch_region.mapped & prefetch_cacheable & !prefetch_attributes.strongly_ordered & prefetch_attributes.read_idempotent
  def prefetch_eligible = !prefetch_flush & prefetch_hit & !prefetch_fault & prefetch_address_valid & prefetch_ordinary_memory & prefetch_permission
  (virtual_prefetch_pipe.egress |> filter_valid(_request => prefetch_eligible) |> map_valid(request => request.updated(~address: prefetch_address))) |> physical_prefetch_pipe.ingress
  physical_prefetch_pipe.egress |> filter_valid(_request => !prefetch_flush) |> physical_prefetch


  /* Faults are not TLB entries. Retain each port's exact failed request until
     its replay observes it; context matching prevents reuse after CSR changes. */

  reg instruction_fault_valid(~init: Bool(#false))
  reg data_fault_valid(~init: Bool(#false))
  reg instruction_fault(RiscvTlbFill())
  reg data_fault(RiscvTlbFill())
  def instruction_failed = instruction_fault_valid & (instruction_fault.request.as_bits() === instruction_lookup.as_bits())
  def data_failed = data_fault_valid & (data_fault.request.as_bits() === data_lookup.as_bits())
  def instruction_known = itlb.hit ||| instruction_failed
  def data_known = dtlb.hit ||| data_failed ||| window_hit
  def instruction_result = mux(instruction_failed, instruction_fault.result, itlb.translation)
  def translated_result = mux(data_failed, data_fault.result, dtlb.translation)
  def data_result = mux(window_hit, translated_result.updated(~physical_address: window_address[0..56], ~fault: RiscvTranslationFault.None), translated_result)
  def data_ok = data_known & (data_result.fault === RiscvTranslationFault.None)
  def data_guest_fault = data_result.fault_details.updated(~guest_virtual_address: data_guest)
  def data_pbmt = mux(window_hit, PageMemoryType.PMA, riscv_host_result(data_result).pbmt)
  vector_window.translation.request.ready <== vector_probe & data_known & !invalidate
  vector_window.translation.response.valid <== vector_window.translation.request.fire()
  vector_window.translation.response.bits <== riscv_host_result(data_result)
  instruction.pbmt <== riscv_host_result(instruction_result).pbmt
  instruction.address <== instruction_result.physical_address.zext(64)
  instruction.resolution <== RV2WideResolution(XLen.X64):
    guest: instruction_result.fault_details.updated(~guest_virtual_address: guest_state.virtualized)
    disposition: mux(!instruction_known, RV2WideDisposition.Replay, mux(instruction_result.fault === RiscvTranslationFault.None, RV2WideDisposition.Continue, RV2WideDisposition.Fault))
    cause: riscv_translation_fault_cause(instruction_result)
    value: instruction.request.bits


  /* WB takes the demand lookup port. A simultaneous MEM request replays rather
     than mistaking WB's translation or cache result for its own. */

  def mem_address = data_result.physical_address.zext(64)
  def zero_block = mem.access.is_cache_block_zero()
  def cache_block = mem.access.is_cache_block()
  def first_address = mux(data_request.access.is_cache_block(), mem_address.align_down(CacheLineBytes), mem_address)
  def last_address = first_address +& mux(data_request.access.is_cache_block(), Bits(64)(CacheLineBytes - 1), memory_access_bytes(XLen.X64, data_request.width) - Bits(64)(1))
  def region = config.physical_map.lookup(first_address, last_address)
  def attributes = resolve_memory_attributes(region, data_pbmt)
  def cacheable = attributes.cacheable & !attributes.strongly_ordered & attributes.read_idempotent
  def atomic_request = mem.access.is_one_of(CacheOperation.LoadReserved, CacheOperation.StoreConditional, CacheOperation.Atomic)
  def mem_misaligned = mem.access.is_one_of(CacheOperation.Load, CacheOperation.Store) & !mem.width.is_aligned(mem.address)
  def access_permission = mux(mem.access.store_fault_class(), region.writable, region.readable)
  def atomic_permission = !atomic_request ||| (cacheable & region.atomic & region.readable)
  def zero_permission = !zero_block ||| region.cache_block_zero
  def ordinary_permission = region.mapped & access_permission & atomic_permission & zero_permission
  def permitted = (!execute_read ||| region.executable) & mux(mem.access.is_cache_management(), cbo_management_physical_permission(region), ordinary_permission)
  def speculative_ok = !data_demand & !vector_probe & !misaligned.busy & !mem_misaligned & data_ok & permitted & cacheable & !atomic_request & !cache_block & !physical_memory.ordered_busy
  (mem_request |> filter_valid(_request => speculative_ok) |> map_valid(request => cache_request(request).updated(~address: mem_address.align_down(8)))) |> physical_pipeline.request
  def cache_outcome = mux_lookup(physical_pipeline.response.bits.outcome, ~default: RV2WideCacheOutcome.Replay):
    CachePipelineOutcome.Slow: RV2WideCacheOutcome.Slow
    CachePipelineOutcome.LoadHit: RV2WideCacheOutcome.LoadHit
    CachePipelineOutcome.StoreHit: RV2WideCacheOutcome.StoreHit

  wire outcome: RV2WideCacheOutcome
  when (data_demand ||| vector_probe ||| misaligned.busy):
    outcome <== RV2WideCacheOutcome.Replay
  elsewhen mem_misaligned:
    outcome <== RV2WideCacheOutcome.Slow
  elsewhen (!data_known):
    outcome <== RV2WideCacheOutcome.Slow
  elsewhen (data_result.fault === RiscvTranslationFault.GuestPageFault):
    outcome <== RV2WideCacheOutcome.GuestPageFault
  elsewhen (data_result.fault === RiscvTranslationFault.PageFault):
    outcome <== RV2WideCacheOutcome.PageFault
  elsewhen ((data_result.fault =/= RiscvTranslationFault.None) ||| !permitted):
    outcome <== RV2WideCacheOutcome.AccessFault
  elsewhen (!cacheable ||| atomic_request ||| cache_block):
    outcome <== RV2WideCacheOutcome.Slow
  otherwise:
    outcome <== mux(physical_pipeline.response.valid, cache_outcome, RV2WideCacheOutcome.Replay)

  pipeline.response.valid <== mem_request.valid
  pipeline.response.bits <== RV2WideLookupResult(XLen.X64):
    guest: data_guest_fault
    outcome: outcome
    data: physical_pipeline.response.bits.data

  physical_pipeline.commit <== pipeline.commit & !misaligned.busy
  pipeline.commit_ready <== physical_pipeline.commit_ready & !misaligned.busy


  /* Retained miss admission and TLB fills
     An active walk completes first; pending authorized data wins the next walk admission. */

  reg pending_data(~init: Bool(#false))
  reg pending_lookup(RiscvTlbLookup())
  reg walk_live(~init: Bool(#false))
  reg walk_data(Bool)
  reg walk_lookup(RiscvTlbLookup())
  def data_miss = (data_demand ||| vector_probe) & !data_known
  def same_active_data = walk_live & walk_data & (walk_lookup.as_bits() === data_lookup.as_bits())
  def instruction_miss = instruction.request.valid & !instruction_known
  def choose_data = pending_data ||| data_miss
  walker.request.valid <== !walk_live & !cancel & !invalidate & (choose_data ||| instruction_miss)
  def selected_data_walk = mux(pending_data, pending_lookup, data_lookup)
  walker.request.bits <== mux(choose_data, selected_data_walk, instruction_lookup)
  walker.completion.ready <== Bool(#true)
  def fill = RiscvTlbFill():
    request: walk_lookup
    result: walker.completion.bits

  itlb.fill.valid <== walker.completion.valid & walk_live & !walk_data & !invalidate
  dtlb.fill.valid <== walker.completion.valid & walk_live & walk_data & !invalidate
  itlb.fill.bits <== fill
  dtlb.fill.bits <== fill
  when invalidate:
    walk_live <== Bool(#false)
  elsewhen (walker.request.fire()):
    walk_live <== Bool(#true)
    walk_data <== choose_data
    walk_lookup <== walker.request.bits
  elsewhen (walker.completion.valid):
    walk_live <== Bool(#false)

  when (invalidate ||| (walker.request.fire() & choose_data)):
    pending_data <== Bool(#false)
  elsewhen (data_miss & !same_active_data & !pending_data):
    pending_data <== Bool(#true)
    pending_lookup <== data_lookup

  when invalidate:
    instruction_fault_valid <== Bool(#false)
  elsewhen (walker.completion.valid & walk_live & !walk_data):
    instruction_fault_valid <== walker.completion.bits.fault =/= RiscvTranslationFault.None
    instruction_fault <== fill

  when invalidate:
    data_fault_valid <== Bool(#false)
  elsewhen (walker.completion.valid & walk_live & walk_data):
    data_fault_valid <== walker.completion.bits.fault =/= RiscvTranslationFault.None
    data_fault <== fill


  /* The owner FIFO tracks accepted physical transactions, not live walks.
     Cancellation suppresses translation publication, never response draining. */

  inst requests(Arbiter(RV2WideMemoryReq(XLen.X64, 64), 3))
  inst owners(Queue(RV2WidePhysicalOwner, 8))
  (memory.request |> gate_flow(data_ok & !misaligned.busy & (!execute_read ||| region.executable)) |> map_flow(request => rv2wide_physical_request(XLen.X64, request, data_result.physical_address.zext(64), data_pbmt))) |> requests.ingress[0]


  /* Split-fragment physical permission checks */

  def fragment_address = data_result.physical_address.zext(64).align_down(8)
  def fragment_region = config.physical_map.lookup(fragment_address, fragment_address +& Bits(64)(7))
  def fragment_attributes = resolve_memory_attributes(fragment_region, data_pbmt)
  def fragment_normal_memory = fragment_attributes.cacheable & !fragment_attributes.strongly_ordered & fragment_attributes.read_idempotent
  def fragment_access_permitted = mux(data_request.access.store_fault_class(), fragment_region.writable, fragment_region.readable)
  def fragment_execute_permitted = !execute_read ||| fragment_region.executable
  def fragment_permitted = fragment_execute_permitted & fragment_region.mapped & fragment_normal_memory & fragment_access_permitted
  (split_request |> gate_flow(data_ok & fragment_permitted) |> map_flow(request => rv2wide_physical_request(XLen.X64, request, fragment_address, data_pbmt))) |> requests.ingress[1]


  /* Implicit PTE physical permission checks */

  def pte_region = config.physical_map.lookup(walker.memory.request.bits.address, walker.memory.request.bits.address +& Bits(64)(7))
  def pte_attributes = resolve_memory_attributes(pte_region, walker.memory.request.bits.pbmt)
  def pte_normal_memory = pte_attributes.cacheable & !pte_attributes.strongly_ordered & pte_attributes.read_idempotent
  def pte_permitted = pte_region.mapped & pte_normal_memory & pte_region.readable
  requests.ingress[2].valid <== walker.memory.request.valid & pte_permitted
  requests.ingress[2].bits <== RV2WideMemoryReq(XLen.X64, 64):
    guest_access: RiscvGuestMemoryAccess.Normal
    address: walker.memory.request.bits.address
    access: CacheOperation.Load
    atomic: dont_care(memory.request.bits.atomic.type)
    width: MemoryWidth.Double
    data: Bits(64)(0)
    mask: Bits(8)(0xff)
    locality: RiscvMemoryLocality.Default
    pbmt: walker.memory.request.bits.pbmt


  /* Physical admission and accepted-owner capture.
     Live arbitration identifies admission faults; only acceptance queues an owner. */

  def origin = requests.chosen.into(RV2WidePhysicalOwner)
  def pte_selected = origin === RV2WidePhysicalOwner.Walker
  def split_selected = origin === RV2WidePhysicalOwner.Split
  def Array(physical_request, owner) = requests.egress |> atomic_fork(2)
  physical_request |> physical_memory.request
  owner |> map_flow(_request => origin) |> owners.ingress

  /* Walker admission reports either local PTE permission or selected service faults. */

  def pte_local_fault = walker.memory.request.valid & !pte_permitted
  def pte_physical_fault = physical_memory.fault.valid & pte_selected
  def pte_fault = pte_local_fault ||| pte_physical_fault
  walker.memory.request.ready <== requests.ingress[2].ready ||| pte_fault
  walker.memory.request_access_fault <== pte_fault

  /* Core faults retain the virtual address and translation-before-execute priority. */

  def core_execute_denied = execute_read & !region.executable
  def core_physical_fault = physical_memory.fault.valid & (origin === RV2WidePhysicalOwner.Core)
  def core_local_fault = data_known & (!data_ok ||| core_execute_denied)
  memory.fault.valid <== memory.request.valid & !misaligned.busy & (core_local_fault ||| core_physical_fault)
  def core_fault_cause = priority_mux(~default: physical_memory.fault.bits.cause):
    !data_ok: riscv_translation_fault_cause(data_result)
    core_execute_denied: exception_cause_bits(ExceptionCause.LoadAccessFault, 64)

  memory.fault.bits <== RV2WideResolution(XLen.X64):
    guest: data_guest_fault
    disposition: RV2WideDisposition.Fault
    cause: core_fault_cause
    value: memory.request.bits.address

  /* Split fragments distinguish page faults from physical access denial.
     Preserve the original split owner's guest details and full-fragment permissions. */

  misaligned.request_guest <== RiscvGuestException():
    page_fault: data_result.fault === RiscvTranslationFault.GuestPageFault
    details: data_guest_fault

  misaligned.request_fault <== split_request.valid & data_known & data_result.fault.is_one_of(RiscvTranslationFault.PageFault, RiscvTranslationFault.GuestPageFault)
  def split_translation_fault = data_result.fault =/= RiscvTranslationFault.None
  def split_physical_fault = physical_memory.fault.valid & split_selected
  def split_access_denied = split_translation_fault ||| !fragment_permitted ||| split_physical_fault
  misaligned.request_access_fault <== split_request.valid & data_known & !misaligned.request_fault & !misaligned.request_guest.page_fault & split_access_denied

  memory.drained <== physical_memory.drained & (owners.count === Bits(owners.count.type.width)(0)) & !misaligned.busy
  memory.ordered_busy <== physical_memory.ordered_busy
  memory.reservation_valid <== physical_memory.reservation_valid


  /* Response dispatch
     Join each accepted physical reply to the unflushed owner FIFO, not the live request or walker. */

  def responses = Array(physical_memory.response, owners.egress) |> zip_flow(data, origin):
    RV2WidePhysicalResponse():
      data: data
      origin: origin

  def Array(core_response, split_response, pte_response) = responses |> demux_flow(3, response => response.origin.as_bits())
  core_response |> map_flow(response => response.data) |> memory.response
  (split_response |> map_flow(response => PhysicalMemoryResp(XLen.X64, Bool)):
    data: response.data
    context: Bool(#false)
    access_fault: Bool(#false)
  ) |> misaligned.physical_response

  pte_response |> map_flow(response => response.data) |> to_valid() |> walker.memory.response


  /* Passive physical-address observation */

  describe_cosim_signals({
    "pipeline_valid": physical_pipeline.request.valid,
    "pipeline_address": mem_address,
    "request_valid": requests.ingress[0].fire(),
    "request_address": requests.ingress[0].bits.address,
    "fragment_valid": requests.ingress[1].fire(),
    "fragment_address": fragment_address,
    "fragment_virtual": split_fault_address,
    "fragment_mask": split_request.bits.mask,
    "fragment_data": split_request.bits.data,
    "fragment_response": split_response.fire(),
    "fragment_response_data": split_response.bits.data
  })

export:
  RV2WideMmu
