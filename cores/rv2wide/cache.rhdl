#lang rhodium
/* Routes RV2Wide physical accesses through shared coherent L1D or ordered nonallocating CHI service. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../cache/uncached-arbiter.rhdl".UncachedFetchArbiter
  lib("riscv/rtl/hypervisor.rhdl") open
  "bundles.rhdl" open
  "../cache/config.rhm" open
  "../cache/protocol.rhdl" open
  "../cache/l1i/protocol.rhdl".InstructionCacheResult
  "../cache/operation.rhdl" open
  "../cache-prefetch.rhdl" open
  "../cache/l1d/cache.rhdl" open
  "../cache/io-mshr.rhdl" open
  "../cache/chi/uncached.rhdl" open
  "../chi-hart.rhdl" open
  "../load-store.rhdl" open
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/rtl/atomic.rhdl" open
  "../../riscv/rtl/cmo.rhdl" open
  "../../riscv/rtl/svpbmt.rhdl" open
  "../../riscv/rtl/zihintntl.rhdl" open
  lib("flow/main.rhdl") open
  lib("rhodium/std/bits.rhdl") open
  lib("chi/protocol/channels.rhdl") open

/* Admits coherent RAM to L1D and exact-width device/noncacheable accesses to a committed IOMSHR.
   IO drains older cache work and blocks younger accesses through final response consumption.
   Accepted operations retain ordered, nonfaulting completion ownership through all redirects. */
sync_circuit RV2WideL1D(cache :: CacheConfig, ~chi: config :: RiscvHartCHIConfig,
                        ~service_queue_depth: service_queue_depth :: PosInt = 2, ~xlen: xlen :: XLen = XLen.X64):
  def bytes = xlen.width / 8
  input node_id: Bits(config.flit.node_id_width)
  input uncached_node_id: Bits(config.flit.node_id_width)
  interface memory(RV2WideMemory(xlen, 64), ~role: responder)
  interface instruction(RV2WideUncachedInstruction(), ~role: responder)
  interface prefetch(Valid(CachePrefetchReq(64)), ~role: consumer)
  interface pipeline_lookup(Valid(CachePipelineReq(xlen)), ~role: consumer)
  interface pipeline(CachePipelineAccess(xlen), ~role: responder)
  interface chi(CHIRNChannels(config.flit), ~role: node)
  interface uncached_chi(CHIRNIChannels(config.flit), ~role: node)
  inst storage(L1DCache(xlen, cache, ~chi: config, ~context: Bool, ~service_queue_depth: service_queue_depth))
  storage.node_id <== node_id
  chi <=> storage.chi
  inst io(IOMSHR(XLen.X64, Bits(3)))
  inst transport(CHIUncachedMemory(XLen.X64, config, Bits(3)))
  inst ownership(UncachedFetchArbiter(XLen.X64, Bits(3)))
  ownership.flush <== instruction.flush
  io.memory |> ownership.data
  ownership.transport |> transport.core
  instruction.response.valid <== ownership.instruction_response.valid & !instruction.flush
  instruction.response.bits <== InstructionCacheResult(64):
    data: ownership.instruction_response.bits.data
    access_fault: ownership.instruction_response.bits.access_fault
    replay: Bool(#false)
  ownership.instruction_response.ready <== instruction.flush ||| instruction.response.ready
  transport.node_id <== uncached_node_id
  transport.cancel <== ownership.cancel
  transport.chi <=> uncached_chi
  inst uncached_management(Queue(Bits(xlen.width), 1))
  (instruction.request |> gate_flow(storage.core.drained & io.core.drained & !uncached_management.egress.valid)
    |> map_flow(fetch => UncachedMemoryReq(XLen.X64, Bits(3))):
      device: fetch.device
      request:
        PhysicalMemoryReq(XLen.X64, Bits(3)):
          address: fetch.address
          access: CacheOperation.Load
          atomic: dont_care(RiscvAtomicOperation)
          width: MemoryWidth.Double
          unsigned: Bool(#true)
          data: dont_care(Bits(64))
          byte_mask: bits(0xff, 8)
          context: bits(0, 3)
          locality: RiscvMemoryLocality.Default
  ) |> ownership.instruction_request
  (prefetch |> filter_valid(_request => io.core.drained & !uncached_management.egress.valid) |> map_valid(hint):
    def request :: CachePrefetchReq(64) = hint
    CachePrefetchReq(xlen.width):
      address: request.address[0..xlen.width]
      operation: request.operation
  ) |> storage.prefetch
  def ordered_busy = !io.core.request.ready ||| uncached_management.egress.valid
  def request :: RV2WideMemoryReq(xlen, 64) = memory.request.bits
  def atomic_request = request.access.is_one_of(CacheOperation.LoadReserved, CacheOperation.StoreConditional, CacheOperation.Atomic)
  def zero_block = request.access.is_cache_block_zero()
  def management = request.access.is_cache_management()
  def cache_block = request.access.is_cache_block()
  def first_address = mux(cache_block, request.address.align_down(CacheLineBytes), request.address)
  def last_address = first_address +& mux(cache_block, bits(CacheLineBytes - 1, 64), memory_access_bytes(XLen.X64, request.width) - bits(1, 64))
  def physical = config.physical_map.lookup(first_address, last_address)
  def attributes = resolve_memory_attributes(physical, request.pbmt)
  def cacheable = attributes.cacheable & !attributes.strongly_ordered & attributes.read_idempotent
  def permitted = mux(management, cbo_management_physical_permission(physical), physical.mapped & (zero_block ||| request.width.is_aligned(request.address)) & mux(request.access.store_fault_class(), physical.writable, physical.readable) & (!atomic_request ||| (cacheable & physical.atomic & physical.readable)) & (!zero_block ||| physical.cache_block_zero))

  // The MMU owns MEM translation/PMA checks. EX indexing must not depend on
  // a TLB hit; the physical tag arrives alongside the following SRAM result.
  pipeline_lookup |> storage.pipeline_lookup
  pipeline.request |> filter_valid(_request => !ordered_busy) |> storage.pipeline.request
  storage.pipeline.response |> pipeline.response
  storage.pipeline.commit <== pipeline.commit & !ordered_busy
  pipeline.commit_ready <== storage.pipeline.commit_ready & !ordered_busy

  def Array(cached, uncached, local_management) = memory.request |> gate_flow(permitted) |> demux_flow(3, _request => mux(management & !physical.cacheable, bits(2, 2), (!mux(management, physical.cacheable, cacheable)).as_bits().zext(2)))
  // A statically uncached region has no cached copies. Complete after drain,
  // without issuing an invented load/store to a possibly side-effecting device.
  local_management |> gate_flow(storage.core.drained & !ordered_busy) |> map_flow(_request => bits(0, xlen.width)) |> uncached_management.ingress
  def Array(authorized, authorized_index) = cached |> gate_flow(!ordered_busy) |> atomic_fork(2)
  authorized_index |> to_valid() |> map_valid(request => mux(atomic_request, request.address[0..xlen.width], request.address[0..xlen.width].align_down(bytes))) |> storage.virtual_lookup
  (
    authorized |> map_flow(request => PhysicalMemoryReq(xlen, Bool)):
      byte_mask: request.mask
      address: mux(atomic_request, request.address[0..xlen.width], request.address[0..xlen.width].align_down(bytes))
      access: request.access
      atomic: request.atomic
      width: mux(atomic_request, request.width, if xlen == XLen.X32 | MemoryWidth.Word | MemoryWidth.Double)
      unsigned: !atomic_request
      data: request.data
      context: Bool(#false)
      locality: request.locality
  ) |> storage.core.request
  (
    uncached |> gate_flow(storage.core.drained & !uncached_management.egress.valid) |> map_flow(request => UncachedMemoryReq(XLen.X64, Bits(3))):
      device: attributes.strongly_ordered
      request:
        PhysicalMemoryReq(XLen.X64, Bits(3)):
          byte_mask: if xlen == XLen.X64 | request.mask | request.mask.zext(8) << (request.address[2].as_bits() ++ bits(0, 2))
          address: request.address
          access: request.access
          atomic: request.atomic
          width: request.width
          unsigned: Bool(#true)
          data: if xlen == XLen.X64 | request.data >> (request.address[0..3] ++ bits(0, 3)) | (request.data >> (request.address[0..2] ++ bits(0, 3))).zext(64)
          context: if xlen == XLen.X64 | request.address[0..3] | request.address[0..2].zext(3)
          locality: request.locality
  ) |> io.core.request
  memory.fault.valid <== memory.request.valid & !permitted
  memory.fault.bits <== RV2WideResolution(xlen):
    guest: literal(RiscvGuestFault(), 0)
    disposition: RV2WideDisposition.Fault
    cause: mux(request.access.store_fault_class(), bits(7, xlen.width), bits(5, xlen.width))
    value: memory.request.bits.address[0..xlen.width]
  Array(
    uncached_management.egress,
    storage.core.response |> map_flow(response => response.data),
    io.core.response |> map_flow(response => response.data[0..xlen.width] << (response.context ++ bits(0, 3)))
  ) |> arbiter() |> memory.response
  memory.drained <== storage.core.drained & io.core.drained & !uncached_management.egress.valid & !local_management.fire()
  memory.reservation_valid <== storage.core.reservation_valid
  memory.ordered_busy <== ordered_busy
  when (storage.core.response.valid):
    assert(!storage.core.response.bits.access_fault, "rv2wide_l1d_accepted_response_nonfaulting")

export:
  RV2WideL1D
