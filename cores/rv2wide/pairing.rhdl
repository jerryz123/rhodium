#lang rhodium
/* Selects implemented same-group operand routes and retains unsatisfied RAW dependencies. */
// SPDX-License-Identifier: Apache-2.0

import:
  "decode/core-ctrl.rhdl".RV2WideControl
  lib("cores/operand.rhdl").OperandImmediate
  "decode/system-ctrl.rhdl" open
  lib("cores/cache/operation.rhdl").CacheOperation
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/rv32i.rhm") as rv32
  lib("riscv/rtl/instruction-pattern.rhdl").instruction_pattern
  lib("rhodium/std/decode.rhdl") open

/* Names operand rewrites and physical consumer muxes, not a general EX-to-EX bypass. */
hardware_enum RV2WidePairRoute:
  Register
  LoadAddress
  StoreData
  BranchOperand
  AuipcAddi
  VectorScalar

/* Shares one route decision between source interlocks and pipeline mux controls. */
bundle RV2WidePairing():
  routes: Vec(2, RV2WidePairRoute)
  unresolved: Vec(2, Bool)
  /* Only a selected physical bypass may waive a younger source's ordinary readiness check. */
  method replaced(pairing) :: Vec(2, Bool):
    vec(for List (source in 0..2): pairing.routes[source] =/= RV2WidePairRoute.Register)

/* Resolves each younger RAW against an eligible older ALU writer without changing either instruction's resource admission. */
fun rv2wide_pairing(controls :: Vec(2, RV2WideControl()), valid :: Vec(2, Bool), destination :: Bits(5), sources :: Vec(2, Bits(5)), instructions :: Vec(2, Bits(32)), older_deferred :: Bool, ~xlen: xlen :: XLen = XLen.X64) :: RV2WidePairing():
  def older :: RV2WideControl() = controls[0]
  def younger :: RV2WideControl() = controls[1]
  def immediate :: OperandImmediate = younger.operand.immediate
  def writes = valid[0] & older.writeback.enable & destination.any()
  def used = vec(younger.operand.uses_rs1, younger.operand.uses_rs2)
  def dependency = vec(for List (source in 0..2): valid[1] & writes & used[source] & (destination === sources[source]))
  def producer = writes & !older_deferred & !older.fp.valid & !older.system.serializing() & !older.branch.resolver.enable
  def integer_memory = !younger.fp.valid & younger.memory.enable
  def load_address = integer_memory & (younger.memory.access === CacheOperation.Load) & !immediate.decode(instructions[1], xlen.width).any()
  def store_data = integer_memory & (younger.memory.access === CacheOperation.Store)
  def branch_operand = younger.branch.resolver.enable & !younger.branch.resolver.unconditional
  def vector_scalar = !younger.vector.memory & (younger.vector.integer ||| younger.vector.floating_point ||| younger.vector.multiply_divide) & younger.operand.uses_rs1
  def is_auipc = DecodeGen([DecodeCase(instruction_pattern(rv32.AUIPC), Bool(#true))], ~default: Bool(#false))
  def is_addi = DecodeGen([DecodeCase(instruction_pattern(rv32.ADDI), Bool(#true))], ~default: Bool(#false))
  def auipc_addi = is_auipc(instructions[0]) & is_addi(instructions[1])

  /* Only rs1 has the AUIPC+ADDI rewrite or vector scalar capture.
     Memory and branch consumers retain their existing routes; an ineligible producer keeps the RF route. */

  def routes = vec(
    for List (source in 0..2):
      def consumer = if source == 0 | load_address | store_data
      def memory_route = if source == 0 | RV2WidePairRoute.LoadAddress | RV2WidePairRoute.StoreData
      def selected = priority_mux(~default: RV2WidePairRoute.Register):
        Bool(source == 0) & auipc_addi: RV2WidePairRoute.AuipcAddi
        consumer: memory_route
        branch_operand: RV2WidePairRoute.BranchOperand
        Bool(source == 0) & vector_scalar: RV2WidePairRoute.VectorScalar

      mux(producer & dependency[source], selected, RV2WidePairRoute.Register)
  )

  RV2WidePairing():
    routes: routes
    unresolved: vec(for List (source in 0..2): dependency[source] & (routes[source] === RV2WidePairRoute.Register))

export:
  RV2WidePairRoute
  RV2WidePairing
  rv2wide_pairing
