#lang rhodium
/* Implements pipeline-ordered dual issue with explicit WB dispatch, retention, and retirement authority. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("riscv/rtl/hypervisor.rhdl") open
  "profile.rhm" open
  "bundles.rhdl" open
  "issue-window.rhdl" open
  "branch-training.rhdl".RV2WideBranchTrainingBuffer
  "pairing.rhdl" open
  "load-response.rhdl" open
  "long-execution.rhdl" open
  "fp.rhdl" open
  "vector.rhdl" open
  "memory-ports.rhdl" open
  lib("cores/vector/decode.rhdl") open
  lib("cores/vector/bundles.rhdl") open
  lib("cores/mmu/vector.rhdl") open
  lib("riscv/isa/vector-profile.rhm") open
  lib("hardfloat/main.rhdl").RoundingMode
  lib("cores/fp/bundles.rhdl") open
  lib("cores/fp/types.rhdl") open
  lib("cores/fp/timing.rhdl") open
  lib("cores/writeback-calendar.rhdl") open
  lib("riscv/isa/fp-profile.rhm") open
  lib("riscv/rtl/floating-point.rhdl") open
  "observation.rhdl".RV2WideObservationContract
  "../cosim-source.rhm".describe_cosim_hart
  "decode/core-ctrl.rhdl" open
  "decode/operand-ctrl.rhdl" open
  "decode/system-ctrl.rhdl" open
  "decode/long-ctrl.rhdl" open
  lib("cores/multiplier.rhdl").MultiplierRequest
  lib("cores/multiplier.rhdl").PipelinedMultiplierStages
  lib("cores/divider.rhdl").DividerRequest
  lib("cores/csr/file.rhdl").RiscvCsrFile
  lib("cores/csr/protocol.rhdl") open
  lib("cores/alu.rhdl") open
  lib("cores/branch-resolver.rhdl") open
  lib("cores/bpred/protocol.rhdl") open
  lib("cores/bpred/ras.rhdl").riscv_ras_action
  lib("cores/load-store.rhdl") open
  lib("cores/cache/operation.rhdl") open
  lib("cores/cache-prefetch.rhdl") open
  lib("cores/cache/protocol.rhdl").PhysicalMemoryReq
  lib("cores/misaligned-access.rhdl") open
  lib("riscv/isa/xlen.rhm") open
  lib("riscv/isa/trap.rhm").ExceptionCause
  lib("riscv/isa/csr.rhm") open
  lib("riscv/model/formats.rhm") as fields
  lib("riscv/rtl/instruction-fields.rhdl") open
  lib("riscv/rtl/trap.rhdl") open
  lib("riscv/rtl/csr.rhdl") open
  lib("riscv/rtl/privilege.rhdl") open
  lib("riscv/rtl/interrupt.rhdl").RiscvInterrupts
  lib("riscv/rtl/cmo.rhdl") open
  lib("riscv/rtl/zihintntl.rhdl") open
  lib("rhodium/std/decode.rhdl") open
  lib("rhodium/std/scoreboard.rhdl") open
  lib("flow/main.rhdl") open
  lib("riscv/rtl/svpbmt.rhdl").PageMemoryType
  lib("riscv/rtl/pointer-masking.rhdl") open

/* Tracks one nonreplayable WB owner from older-work drain through service completion. */
hardware_enum RV2WideRetainedState:
  Idle
  Draining
  Ready
  Accepted

/* Resolves oldest-to-youngest candidates so a nearer unavailable producer blocks stale data. */
fun forwarded_operand(xlen :: XLen, address :: Bits(5), stored :: Bits(xlen.width), producers :: List.of(Endpoint)) :: RV2WideOperand(xlen):
  def mutable value = stored
  def mutable blocked = Bool(#false)
  for (endpoint in producers):
    def producer :: Endpoint = endpoint
    def token :: RV2WideResult(xlen) = producer.bits
    def matched = producer.valid & token.write & (token.rd === address)
    value := mux(matched, token.data, value)
    blocked := mux(matched, (token.resolution.disposition =/= RV2WideDisposition.Continue) ||| !token.result_ready, blocked)
  RV2WideOperand(xlen):
    data: mux(address.or_reduce(), value, bits(0, xlen.width))
    blocked: address.or_reduce() & blocked

/* Interlocks a younger write against every older result that may complete after WB. */
fun pending_destination(xlen :: XLen, address :: Bits(5), producers :: List.of(Endpoint)) :: Bool:
  def matches = for List (endpoint in producers):
    def producer :: Endpoint = endpoint
    def token :: RV2WideResult(xlen) = producer.bits
    producer.valid & token.write & !token.result_ready & (token.rd === address)
  address.or_reduce() & or_reduce(matches)


/* Executes RV32/RV64 integer, optional RV64 F/D, and system operations with precise WB-owned state.
   Resolution inputs qualify the corresponding live MEM token in the same cycle. */
sync_circuit RV2WideCore(profile :: RV2WideConfig = RV2WideConfig(), ~fp_timing: selected_fp_timing :: FpExecutionTiming = FpExecutionTiming()):
  def xlen = profile.xlen

  /* Encodes guest-page, page, then access faults using the retained operation's fault class. */
  fun memory_fault_cause(access :: CacheOperation, guest_page_fault :: Bool, page_fault :: Bool) :: Bits(xlen.width):
    def store = access.store_fault_class()
    def guest_cause = mux(store, exception_cause_bits(ExceptionCause.StoreGuestPageFault, xlen.width), exception_cause_bits(ExceptionCause.LoadGuestPageFault, xlen.width))
    def page_cause = mux(store, exception_cause_bits(ExceptionCause.StorePageFault, xlen.width), exception_cause_bits(ExceptionCause.LoadPageFault, xlen.width))
    def access_cause = mux(store, exception_cause_bits(ExceptionCause.StoreAccessFault, xlen.width), exception_cause_bits(ExceptionCause.LoadAccessFault, xlen.width))
    priority_mux(~default: access_cause):
      guest_page_fault: guest_cause
      page_fault: page_cause

  input interrupts: RiscvInterrupts()
  input hart_id: Bits(64)
  input time_counter: Bits(64)
  interface instructions(Decoupled(RV2WidePacket(xlen)), ~role: consumer)
  interface resolution[2](Valid(RV2WideResolution(xlen)), ~role: consumer)
  interface memory_stage[2](Valid(RV2WideInstruction(xlen)), ~role: producer)
  interface retired[2](Valid(RV2WideRetirement(xlen)), ~role: producer)
  interface prefetch(Valid(CachePrefetchReq(64)), ~role: producer)
  interface redirect(Valid(RV2WideRedirect(xlen)), ~role: producer)
  interface fetch_flush(Pulse(), ~role: producer)
  interface instruction_invalidate(Pulse(), ~role: producer)
  interface branch_update(Valid(BranchUpdate(xlen)), ~role: producer)
  interface predictor_restore(Pulse(), ~role: producer)
  interface predictor_clear(Pulse(), ~role: producer)
  interface direction_update(Valid(BhtUpdate(10)), ~role: producer)
  interface ras_resolution(Valid(RasResolution(xlen)), ~role: producer)
  interface history_commit(Valid(RV2WideHistoryCommit()), ~role: producer)
  interface history_restore(Valid(Bits(10)), ~role: producer)
  interface memory(RV2WideMemory(xlen, xlen.width), ~role: requester)
  interface split(RiscvSplitAccess(xlen, Bool), ~role: requester)
  output split_guest_access: RiscvGuestMemoryAccess
  interface pipeline(RV2WidePipelineAccess(xlen), ~role: requester)
  interface completed(Valid(RV2WideRetirement(xlen)), ~role: producer)
  output issued: Bits(2)
  output retired_count: Bits(2)
  output instruction_capacity: Bits(4)
  output sleeping: Bool
  output translation_state: RV2WideTranslationState(xlen)
  output translation_flush: Bool
  interface vector_precheck(VectorPrecheck(), ~role: requester)
  output(pipeline_vector, request_vector): Bool

  def fp_enabled = floating_point_supports_f(profile.floating_point)
  def vector_enabled = vector_profile_enabled(profile.vector)
  def vector_slots = profile.vector_completion_slots
  def fp_timing = selected_fp_timing.at_least(2)
  def gpr_span = math.max(5, math.max(PipelinedMultiplierStages + 2, fp_timing.maximum + 2))
  def gpr_delay_width = index_width(gpr_span + 1)
  def trace_letters = ["i", "m", "a"] ++ (if fp_enabled | ["f"] | []) ++ (if floating_point_supports_d(profile.floating_point) | ["d"] | []) ++ ["c", "b"] ++ (if vector_profile_is_v(profile.vector) | ["v"] | [])
  def trace_isa = "rv" ++ to_string(xlen.width) ++ String.join(trace_letters, "") ++ "_" ++ String.join(profile.isa_profile.isa_extensions.filter(~keep: fun (name): name.length() > 1), "_")
  inst memory_ports(RV2WideMemoryPorts(xlen))
  def scalar_memory = memory_ports.scalar_memory
  def scalar_pipeline = memory_ports.scalar_pipeline
  def scalar_split = memory_ports.scalar_split
  memory_ports.memory <=> memory
  memory_ports.pipeline <=> pipeline
  memory_ports.split <=> split
  split_guest_access <== memory_ports.split_guest_access
  pipeline_vector <== memory_ports.pipeline_vector
  request_vector <== memory_ports.request_vector
  inst vector(if vector_enabled | RV2WideVectorPipeline(xlen, profile.vector_length, ~vector_completion_slots: vector_slots) | RV2WideVectorDisabled(xlen, ~vector_completion_slots: vector_slots))
  vector.memory <=> memory_ports.vector_memory
  vector.pipeline <=> memory_ports.vector_pipeline
  vector.split <=> memory_ports.vector_split
  vector.precheck <=> vector_precheck


  /* Pipeline storage and stage paths.
     Flow owns feed-forward registers; the issue window owns prefix retention.
     Backward recovery links do not add pipeline storage. */

  inst rr_window(RV2WideIssueWindow(xlen))
  inst ex_older(ValidPipe(RV2WideExecute(xlen), 1, ~flushable: #true))
  inst ex_younger(ValidPipe(RV2WideExecute(xlen), 1, ~flushable: #true))
  inst mem_older(ValidPipe(RV2WideResult(xlen), 1, ~flushable: #true))
  inst mem_younger(ValidPipe(RV2WideResult(xlen), 1, ~flushable: #true))
  inst wb_older(ValidPipe(RV2WideResult(xlen), 1, ~flushable: #true))
  inst wb_younger(ValidPipe(RV2WideResult(xlen), 1, ~flushable: #true))
  def ex_pipe = [ex_older, ex_younger]
  def mem_pipe = [mem_older, mem_younger]
  def wb_pipe = [wb_older, wb_younger]
  // Retired training survives speculative recovery; RR books its future WB occupancy.
  inst branch_training(RV2WideBranchTrainingBuffer(xlen))
  wire wb_squash: Bool
  wire rr_squash: Bool
  def ex_paths = for List (lane in 0..2):
    def observed = ex_pipe[lane].egress |> filter_valid(_token => !rr_squash) |> trace_valid_event("core/s2.ex.slot" ++ to_string(lane), ~fields: token):
      pc: token.fetched.pc
      instruction(~format: "riscv", ~isa: trace_isa, ~pc: "pc"): token.fetched.raw_instruction
    observed |> fork_valid(4)
  def wb_paths = for List (lane in 0..2): wb_pipe[lane].egress |> fork_valid(2)
  def ex_links = for List (_ in 0..2): interface_link(Valid(RV2WideResult(xlen)))
  def mem_links = for List (_ in 0..2): interface_link(Valid(RV2WideResult(xlen)))
  def ex_results = for List (link in ex_links): link.right
  def mem_results = for List (link in mem_links): link.right
  def wb_redirect_link :: Handle = interface_link(Valid(RV2WideRedirect(xlen)))
  def wb_redirect :: Endpoint = wb_redirect_link.right
  wire mem_branch_redirect: Bool
  wire wb_drained: Bool


  /* Shared architectural and floating-point services.
     WB owns CSR commands and retirement; FP and fixed GPR returns use
     explicit reservations rather than independent lane backpressure. */

  inst wb_csrs(RiscvCsrFile(profile.csr_config))
  def empty_guest :: RiscvGuestFault() = literal(RiscvGuestFault(), 0)
  def guest_state :: RiscvHypervisorTranslation() = if profile.hypervisor | wb_csrs.guest_translation | literal(RiscvHypervisorTranslation(), 0)
  translation_state <== RV2WideTranslationState(xlen):
    guest: guest_state
    pointer_masking: wb_csrs.pointer_masking
    guest_pointer_masking: if profile.hypervisor | wb_csrs.guest_pointer_masking | wb_csrs.pointer_masking
    privilege: wb_csrs.privilege
    mstatus: wb_csrs.mstatus
    satp: wb_csrs.satp
    pbmte: wb_csrs.pbmte
  translation_flush <== wb_csrs.translation_flush
  wb_csrs.interrupts <== interrupts
  wb_csrs.hart_id <== hart_id[0..xlen.width]
  wb_csrs.time_counter <== time_counter
  inst fp(if fp_enabled | RV2WideFp(xlen, fp_timing, ~half_precision: profile.half_precision, ~zfa: profile.zfa, ~vector_slots: vector_slots) | RV2WideFpDisabled(xlen, ~vector_slots: vector_slots))
  wb_csrs.fp_update.valid <== fp.state_update.valid ||| vector.fp_update.valid ||| vector.floating_result.valid
  wb_csrs.fp_update.bits <== mux(fp.state_update.valid, fp.state_update.bits, bits(0, 5)) ||| mux(vector.fp_update.valid, vector.fp_update.bits, bits(0, 5))
  if fp_enabled
  | block:
      vector.fp_request |> fp.vector_request
      fp.vector_result |> vector.fp_result
      vector.floating_result |> fp.vector_write
  | block:
      vector.fp_request.ready <== Bool(#false)
      vector.fp_result.valid <== Bool(#false)
      vector.fp_result.bits <== dont_care(vector.fp_result.bits.type)
      fp.vector_request.valid <== Bool(#false)
      fp.vector_request.bits <== dont_care(fp.vector_request.bits.type)
      fp.vector_result.ready <== Bool(#true)
      fp.vector_write.valid <== Bool(#false)
      fp.vector_write.bits <== dont_care(fp.vector_write.bits.type)
  // Fixed FP and multiply share the younger RF port, booked at RR before EX launch.
  inst wb_gpr_calendar(WritebackCalendar(4, gpr_span))
  wire wb_completion_priority: Bool
  inst wb_fp_gpr_scoreboard(Scoreboard(32))
  def wb_fp_gpr = fp.completion |> filter_valid(result => (result.tag.destination === FloatDestination.Integer) & result.tag.rd.or_reduce())
  def wb_fp_late_gpr = wb_fp_gpr |> filter_valid(result => !result.tag.direct)
  wb_fp_gpr_scoreboard.clear.valid <== wb_fp_late_gpr.valid
  wb_fp_gpr_scoreboard.clear.bits <== wb_fp_late_gpr.bits.tag.rd
  wire wb_fp_variable_accepted: Bool
  wire wb_fp_fixed_authorized: Bool
  vector.saturate |> wb_csrs.vector_saturate
  vector.fault_start |> wb_csrs.vector_fault_start
  vector.truncate |> wb_csrs.vector_truncate
  reg wb_vector_scalar_pending(~init: Bool(#false))
  reg wb_vector_scalar_owner(RV2WideInstruction(xlen))
  reg rr_vector_writeback_waiting(~init: Bool(#false))
  inst wb_vector_scoreboard(Scoreboard(32))
  vector.scalar_result |> filter_valid(result => result.address.or_reduce()) |> map_valid(result => result.address) |> wb_vector_scoreboard.clear
  reg wb_vector_fpr_pending(~init: Bool(#false))
  vector.scalar_writeback |> gate_flow(!wb_completion_priority) |> map_flow(delay => if gpr_delay_width <= 4 | delay[0..gpr_delay_width] | delay.zext(gpr_delay_width)) |> wb_gpr_calendar.reserve[2]
  // Stop new younger-port bookings long enough to create a return slot.
  // A starving scalar completion retains its existing bounded-age priority.
  rr_vector_writeback_waiting <== vector.scalar_writeback.valid & !vector.scalar_writeback.ready
  reg wb_sleeping(~init: Bool(#false))
  reg wb_resume_pc(~init: bits(0, xlen.width))
  reg wb_pc_known(~init: Bool(#false))
  wire wb_reservation_waiting: Bool
  sleeping <== wb_sleeping ||| wb_reservation_waiting
  inst wb_load_response(RV2WideLoadResponse(xlen))
  reg wb_ordered_memory_pending(~init: Bool(#false))
  reg wb_prior_memory_drained(~init: Bool(#false))
  inst ex_multiply(RV2WideMultiply(xlen, ~vector_slots: vector_slots))
  inst wb_divide(RV2WideDivide(xlen, ~vector_slots: vector_slots))
  vector.multiply_request |> ex_multiply.vector_request
  ex_multiply.vector_result |> vector.multiply_result
  vector.divide_request |> wb_divide.vector_request
  wb_divide.vector_result |> vector.divide_result
  inst rr_completions(RRArbiter(RV2WideRetirement(xlen), 2))
  inst wb_scoreboard(Scoreboard(32))
  wire wb_management_response: Bool
  def Array(wb_ordinary_response, wb_management_return) = scalar_memory.response |> demux_flow(2, _data => wb_management_response)
  wb_ordinary_response |> wb_load_response.response
  def wb_management_completed = wb_management_return |> to_valid()
  wb_load_response.fp_completed |> fp.load_return


  /* Committed completion transport.
     Deferred results reserve the younger issue slot and travel to its WB
     write port. Already committed responses never take speculative flush. */

  for (source in [wb_load_response.completed, wb_divide.completed], index in 0..2):
    source |> rr_completions.ingress[index]
  def rr_completion :: Endpoint = rr_completions.egress |> gate_flow(!wb_gpr_calendar.occupied[3].into(Bool) & (!rr_vector_writeback_waiting ||| wb_completion_priority)) |> to_valid()
  reg rr_completion_age(~init: bits(0, 3))
  when (!rr_completions.egress.valid ||| rr_completions.egress.fire()):
    rr_completion_age <== bits(0, 3)
  elsewhen (!rr_completion_age.and_reduce()):
    rr_completion_age <== rr_completion_age + bits(1, 3)
  wb_completion_priority <== rr_completion_age.and_reduce()
  wb_gpr_calendar.pause <== Bool(#false)
  inst ex_completion_pipe(ValidPipe(RV2WideRetirement(xlen), 1))
  inst mem_completion_pipe(ValidPipe(RV2WideRetirement(xlen), 1))
  inst wb_completion_pipe(ValidPipe(RV2WideRetirement(xlen), 1))
  rr_completion |> ex_completion_pipe.ingress
  ex_completion_pipe.egress |> mem_completion_pipe.ingress
  mem_completion_pipe.egress |> wb_completion_pipe.ingress
  def wb_completion :: Endpoint = wb_completion_pipe.egress
  def wb_gpr_return = Array(wb_completion, ex_multiply.completed) |> valid_arbiter()
  def wb_vector_return = vector.scalar_result |> filter_valid(result => result.address.or_reduce()) |> map_valid(result => RV2WideRetirement(xlen)):
    fetched: wb_vector_scalar_owner
    rd: result.address
    write: result.address.or_reduce()
    data: result.data
    deferred: Bool(#false)
  def rr_returns = [wb_gpr_return, mem_completion_pipe.egress, ex_completion_pipe.egress, rr_completion]
  reg wb_completion_count(~init: bits(0, 2))
  when (rr_completion.valid ^ wb_completion.valid):
    wb_completion_count <== mux(rr_completion.valid, wb_completion_count + bits(1, 2), wb_completion_count - bits(1, 2))
  def wb_fp_return = wb_fp_late_gpr |> map_valid(result => RV2WideRetirement(xlen)):
    fetched: result.tag.fetched
    rd: result.tag.rd
    write: Bool(#true)
    data: result.integer_value
    deferred: Bool(#false)
  (Array(wb_gpr_return, wb_fp_return, wb_vector_return) |> valid_arbiter() |> trace_valid_event("core/s4.wb.deferred", ~fields: result):
    pc: result.fetched.pc
    instruction(~format: "riscv", ~isa: trace_isa, ~pc: "pc"): result.fetched.raw_instruction
    rd: result.rd
  ) |> completed
  wb_scoreboard.clear.valid <== wb_gpr_return.valid & wb_gpr_return.bits.write
  wb_scoreboard.clear.bits <== wb_gpr_return.bits.rd
  reg rr_registers(~init: vec(for List (_ in 0..32): bits(0, xlen.width)))
  instructions |> rr_window.ingress
  instruction_capacity <== rr_window.available
  rr_window.clear.valid <== rr_squash


  /* RR: Decode, dependency checks, and prefix admission.
     The issue window owns age and consumption; the younger lane cannot
     advance around an older blocked instruction. */

  def rr_head :: RV2WidePacket(xlen) = rr_window.head
  def rr_decode = ValidDecodeGen(rv2wide_control_cases(profile))
  def rr_decoded :: Vec(2, DecodeResult(RV2WideControl())) = vec(for List (lane in 0..2): rr_decode(rr_head.entries[lane].instruction))
  def rr_controls :: Vec(2, RV2WideControl()) = vec(for List (lane in 0..2): rr_decoded[lane].value)
  def rr_vector = for List (lane in 0..2):
    def control = rr_controls[lane].vector
    control.integer ||| control.memory ||| control.floating_point ||| control.multiply_divide
  def rr_vector_illegal = for List (lane in 0..2):
    inst legality(VectorOperationLegality(xlen, profile.vector_length, if vector_enabled | profile.vector | VectorProfile.Zve32x, profile.vector_extensions))
    legality.instruction <== rr_head.entries[lane].instruction
    legality.control <== rr_controls[lane].vector
    legality.vtype <== wb_csrs.vector_state.vtype
    legality.vstart <== wb_csrs.vector_state.vstart
    def control = rr_controls[lane].vector
    ((rr_vector[lane] ||| (control.configure =/= VectorConfigMode.None)) & !wb_csrs.vector_enabled) ||| (rr_vector[lane] & (!legality.legal ||| (control.floating_point & (!wb_csrs.fp_enabled ||| (control.fp_service & control.fp_execution.uses_rounding_mode & (wb_csrs.frm > bits(4, 3)))))))
  // At most one memory instruction issues per group; the older CMO owns the
  // shared permission probe. A retained younger candidate is probed again.
  def rr_cbo_older_access :: CacheOperation = rr_controls[0].memory.access
  def rr_cbo_lane = mux(rr_controls[0].memory.enable & rr_cbo_older_access.is_cache_management(), bits(0, 1), bits(1, 1))
  wb_csrs.cbo_operation <== mux_lookup(rr_controls[rr_cbo_lane].memory.access, ~default: CboManagementOperation.Clean):
    CacheOperation.CacheBlockInvalidate: CboManagementOperation.Invalidate
    CacheOperation.CacheBlockFlush: CboManagementOperation.Flush
  def rr_rounding :: Vec(2, RiscvRoundingMode()) = vec(for List (lane in 0..2): riscv_rounding_mode(rr_head.entries[lane].instruction[12..15], wb_csrs.frm))
  def rr_fp_illegal = for List (lane in 0..2): rr_controls[lane].fp.valid & (!wb_csrs.fp_enabled ||| (rr_controls[lane].fp.bits.execution.uses_rounding_mode & !rr_rounding[lane].valid))
  def rr_cbo_illegal = for List (lane in 0..2):
    def access :: CacheOperation = rr_controls[lane].memory.access
    rr_controls[lane].memory.enable & ((access.is_cache_block_zero() & (wb_csrs.cbo_zero_access =/= CboAccess.Allowed)) ||| (access.is_cache_management() & (wb_csrs.cbo_permission.access =/= CboAccess.Allowed)))
  def rr_explicit_guest = for List (lane in 0..2): rr_controls[lane].guest_access =/= RiscvGuestMemoryAccess.Normal
  def rr_guest_illegal = for List (lane in 0..2): rr_explicit_guest[lane] & !guest_state.virtualized & (wb_csrs.privilege === PrivilegeMode.User) & !csr_flag(guest_state.hstatus, HstatusHU)
  def rr_virtual_instruction = for List (lane in 0..2):
    def access :: CacheOperation = rr_controls[lane].memory.access
    (rr_explicit_guest[lane] & guest_state.virtualized) ||| (rr_controls[lane].memory.enable & ((access.is_cache_block_zero() & (wb_csrs.cbo_zero_access === CboAccess.VirtualInstruction)) ||| (access.is_cache_management() & (wb_csrs.cbo_permission.access === CboAccess.VirtualInstruction))))
  def rr_decodable :: Vec(2, Bool) = vec(for List (lane in 0..2): rr_decoded[lane].valid & !rr_head.entries[lane].fault.valid & !rr_head.entries[lane].compressed_illegal & !rr_fp_illegal[lane] & !rr_vector_illegal[lane] & !rr_cbo_illegal[lane] & !rr_guest_illegal[lane] & !rr_virtual_instruction[lane])
  def rr_rs1 :: Vec(2, Bits(5)) = vec(for List (lane in 0..2): instruction_field(fields.rs1, rr_head.entries[lane].instruction))
  def rr_rs2 :: Vec(2, Bits(5)) = vec(for List (lane in 0..2): instruction_field(fields.rs2, rr_head.entries[lane].instruction))
  def rr_rd :: Vec(2, Bits(5)) = vec(for List (lane in 0..2): instruction_field(fields.rd, rr_head.entries[lane].instruction))
  def rr_wb_producers = for List (lane in 0..2):
    def returned = wb_fp_gpr.valid & wb_fp_gpr.bits.tag.direct & (wb_fp_gpr.bits.tag.lane === bits(lane, 1))
    wb_pipe[lane].egress |> map_valid(token => token.updated(~data: mux(returned, wb_fp_gpr.bits.integer_value, token.data), ~result_ready: token.result_ready ||| returned))
  def rr_producers = [rr_wb_producers[0], rr_wb_producers[1], mem_results[0], mem_results[1], ex_results[0], ex_results[1]]

  /* Floating-point reads and destination interlocks.
     Read probes may repeat while RR waits; future fixed return capacity
     is reserved only when its instruction is admitted. */

  def rr_vector_frs1 = for List (lane in 0..2): rr_vector[lane] & rr_controls[lane].vector.floating_point & (rr_controls[lane].vector.operand === VectorOperandMode.FloatingScalar)
  def rr_fp_lane = mux(rr_controls[0].fp.valid ||| rr_vector_frs1[0], bits(0, 1), bits(1, 1))
  def rr_fp_control :: FloatingPointControl() = rr_controls[rr_fp_lane].fp.bits
  fp.read_addresses <== vec(rr_rs1[rr_fp_lane], rr_rs2[rr_fp_lane], rr_head.entries[rr_fp_lane].instruction[27..32])
  fp.probe <== rr_fp_control.execution
  wb_gpr_calendar.probe_client <== bits(0, 2)
  wb_gpr_calendar.probe_delay <== fp_timing.latency(rr_fp_control.execution, ~width: gpr_delay_width) + bits(1, gpr_delay_width)
  // Probe registered bookings only. Same-group collisions are checked separately,
  // keeping admission independent of either client's packed reserve handshake.
  def rr_fp_gpr_available = !wb_completion_priority & !rr_vector_writeback_waiting & !(wb_gpr_calendar.occupied & (bits(1, gpr_span) << wb_gpr_calendar.probe_delay)).or_reduce()

  /* Pre-WB producers bridge the architectural scoreboard; both FPR write ports forward. */
  fun rr_fp_busy(address :: Bits(5)) :: Bool:
    def registered_pending = (fp.busy & (bits(1, 32) << address)).or_reduce()
    def producer_matches = for List (endpoint in rr_producers):
      def producer :: Endpoint = endpoint
      def token :: RV2WideResult(xlen) = producer.bits
      producer.valid & ((token.fp.valid & (token.fp.bits.registers.destination === FloatDestination.FloatingPoint)) ||| (token.vector.control.floating_point & token.vector.control.floating_scalar_destination)) & (token.rd === address)
    def pending = registered_pending ||| or_reduce(producer_matches)
    def returned = (fp.completion.valid & (fp.completion.bits.tag.destination === FloatDestination.FloatingPoint) & (fp.completion.bits.tag.rd === address)) ||| (fp.load_write.valid & (fp.load_write.bits.owner.rd === address))
    pending & !returned
  def rr_fp_fixed :: Vec(2, Bool) = vec(for List (lane in 0..2): rr_controls[lane].fp.valid & !rr_controls[lane].fp.bits.execution.unit.is_one_of(FloatUnit.Memory, FloatUnit.DivideSquareRoot))
  def rr_fp_late_gpr :: Vec(2, Bool) = vec(for List (lane in 0..2): rr_fp_fixed[lane] & (rr_controls[lane].fp.bits.registers.destination === FloatDestination.Integer) & rr_rd[lane].or_reduce() & (fp_timing.latency(rr_controls[lane].fp.bits.execution) > bits(2, fp_timing.width)))
  // An older MEM divide owns next cycle's shared request input at WB.
  def rr_fp_wb_reserved = (mem_older.egress.valid & mem_older.egress.bits.fp.valid & (mem_older.egress.bits.fp.bits.execution.unit === FloatUnit.DivideSquareRoot)) ||| (mem_younger.egress.valid & mem_younger.egress.bits.fp.valid & (mem_younger.egress.bits.fp.bits.execution.unit === FloatUnit.DivideSquareRoot))
  def rr_fp_data_blocked = for List (lane in 0..2):
    def control :: FloatingPointControl() = rr_controls[lane].fp.bits
    rr_controls[lane].fp.valid & ((control.registers.uses_frs1 & rr_fp_busy(rr_rs1[lane])) ||| (control.registers.uses_frs2 & rr_fp_busy(rr_rs2[lane])) ||| (control.registers.uses_frs3 & rr_fp_busy(rr_head.entries[lane].instruction[27..32])) ||| ((control.registers.destination === FloatDestination.FloatingPoint) & rr_fp_busy(rr_rd[lane])))
  def rr_fp_structural_blocked = for List (lane in 0..2): rr_decodable[lane] & rr_fp_fixed[lane] & (!fp.available ||| rr_fp_wb_reserved ||| (rr_fp_late_gpr[lane] & !rr_fp_gpr_available))

  /* Deferred returns forward at RR admission and again at the reserved write edge. */
  fun rr_stored(address :: Bits(5)) :: Bits(xlen.width):
    def mutable value = mux(vector.scalar_result.valid & (vector.scalar_result.bits.address === address), vector.scalar_result.bits.data, mux(wb_fp_late_gpr.valid & (wb_fp_late_gpr.bits.tag.rd === address), wb_fp_late_gpr.bits.integer_value, rr_registers[address]))
    for (endpoint in rr_returns):
      def source :: Endpoint = endpoint
      def returned :: RV2WideRetirement(xlen) = source.bits
      value := mux(source.valid & returned.write & (returned.rd === address), returned.data, value)
    value

  /* Completion frees the registered reservation for same-cycle reads and younger writes. */
  fun rr_busy(address :: Bits(5)) :: Bool:
    def integer_completing = wb_gpr_return.valid & wb_gpr_return.bits.write & (wb_gpr_return.bits.rd === address)
    def fp_completing = wb_fp_late_gpr.valid & (wb_fp_late_gpr.bits.tag.rd === address)
    def integer_pending = scoreboard_busy(32, wb_scoreboard.busy, address) & !integer_completing
    def fp_pending = scoreboard_busy(32, wb_fp_gpr_scoreboard.busy, address) & !fp_completing
    address.or_reduce() & (integer_pending ||| fp_pending)

  /* A returned value satisfies reads immediately; younger writes still wait for its RF update. */
  fun rr_source_busy(address :: Bits(5)) :: Bool:
    def return_matches = for List (endpoint in rr_returns):
      def source :: Endpoint = endpoint
      def owner :: RV2WideRetirement(xlen) = source.bits
      source.valid & owner.write & (owner.rd === address)
    def returned = or_reduce(return_matches)
    (rr_busy(address) & !returned) ||| (scoreboard_busy(32, wb_vector_scoreboard.busy, address) & !(vector.scalar_result.valid & (vector.scalar_result.bits.address === address)))


  /* Operand forwarding and same-group dependencies.
     Selects the newest older producer and preserves explicit pairing routes;
     ordered elaboration folds encode forwarding priority. */

  def rr_left :: Vec(2, RV2WideOperand(xlen)) = vec(for List (lane in 0..2): forwarded_operand(xlen, rr_rs1[lane], rr_stored(rr_rs1[lane]), rr_producers))
  def rr_right :: Vec(2, RV2WideOperand(xlen)) = vec(for List (lane in 0..2): forwarded_operand(xlen, rr_rs2[lane], rr_stored(rr_rs2[lane]), rr_producers))
  def rr_older_write = rr_decodable[0] & rr_controls[0].writeback.enable & rr_rd[0].or_reduce()
  def rr_long = for List (lane in 0..2): rr_controls[lane].muldiv.service =/= RV2WideLongOperation.None
  def rr_multiply = for List (lane in 0..2): rr_decodable[lane] & (rr_controls[lane].muldiv.service === RV2WideLongOperation.Multiply) & rr_rd[lane].or_reduce()
  reg rr_vector_multiply_turn(~init: Bool(#false))
  def rr_multiply_available = !wb_completion_priority & !rr_vector_writeback_waiting & !wb_gpr_calendar.occupied[PipelinedMultiplierStages + 1].into(Bool) & !rr_vector_multiply_turn
  // Two independent fixed operations may pair unless their numerical returns coincide.
  def rr_pair_fixed_collision = ((rr_multiply[0] & rr_fp_late_gpr[1]) ||| (rr_fp_late_gpr[0] & rr_multiply[1])) & (wb_gpr_calendar.probe_delay === bits(PipelinedMultiplierStages + 1, gpr_delay_width))
  // Normal WB writes precede every younger write; a deferred older writer may return later.
  def rr_older_deferred = rr_controls[0].memory.enable ||| rr_long[0] ||| rr_fp_late_gpr[0] ||| rr_vector[0]
  def rr_pair_waw = rr_older_write & rr_older_deferred & rr_controls[1].writeback.enable & (rr_rd[0] === rr_rd[1])
  def rr_ras = for List (lane in 0..2): rr_controls[lane].branch.resolver.enable & ((riscv_ras_action(rr_head.entries[lane].instruction) =/= RasAction.None) ||| (rr_head.entries[lane].speculated_ras_action =/= RasAction.None))
  def rr_pair_ras = rr_ras[0] & rr_ras[1]

  /* Branch-training capacity projection.
     Accounts for each fixed-latency retirement group and one write per cycle;
     faults and flushes can only remove records from the projection. */

  def mutable rr_training_projected = branch_training.pending.zext(4)
  for (stage_index in 0..3):
    def stage = [wb_pipe, mem_pipe, ex_pipe][stage_index]
    def mutable arrivals = bits(0, 4)
    for (lane in 0..2):
      def branch :: Bool = if stage_index == 2 | stage[lane].egress.valid & !stage[lane].egress.bits.illegal & !stage[lane].egress.bits.fetched.fault.valid & stage[lane].egress.bits.control.branch.resolver.enable | stage[lane].egress.valid & stage[lane].egress.bits.branch.update.branch
      arrivals := arrivals + branch.as_bits().zext(4)
    def offered :: Bits(4) = rr_training_projected + arrivals
    rr_training_projected := mux(offered.or_reduce(), offered - bits(1, 4), bits(0, 4))
    assert(rr_training_projected <= bits(2, 4), "rv2wide_branch_training_projection")
  def rr_branch :: Vec(2, Bool) = vec(for List (lane in 0..2): rr_decodable[lane] & rr_controls[lane].branch.resolver.enable)
  def rr_training_blocked = [rr_branch[0] & (rr_training_projected >= bits(3, 4)), rr_branch[1] & (rr_training_projected + rr_branch[0].as_bits().zext(4) >= bits(3, 4))]
  def rr_pair_memory = rr_controls[0].memory.enable & rr_controls[1].memory.enable
  def rr_variable_fp = for List (lane in 0..2): rr_controls[lane].fp.valid & (rr_controls[lane].fp.bits.execution.unit === FloatUnit.DivideSquareRoot)
  def rr_pair_deferred = (rr_variable_fp[0] & (rr_long[1] ||| rr_controls[1].memory.enable)) ||| (rr_variable_fp[1] & (rr_long[0] ||| rr_controls[0].memory.enable)) ||| (rr_long[0] & (rr_long[1] ||| rr_controls[1].memory.enable)) ||| (rr_long[1] & rr_controls[0].memory.enable)
  def rr_system = for List (lane in 0..2):
    def system :: RV2WideSystemControl() = rr_controls[lane].system
    rr_decodable[lane] & system.serializing()
  def rr_pairing = rv2wide_pairing(rr_controls, rr_decodable, rr_rd[0], vec(rr_rs1[1], rr_rs2[1]), vec(rr_head.entries[0].instruction, rr_head.entries[1].instruction), rr_older_deferred, ~xlen: xlen)
  def rr_replaced = rr_pairing.replaced()
  def rr_pair_raw = rr_pairing.unresolved.or_reduce()
  def rr_data_blocked = for List (lane in 0..2):
    def rs1_blocked = rr_controls[lane].operand.uses_rs1 & !(Bool(lane == 1) & rr_replaced[0]) & (rr_left[lane].blocked ||| rr_source_busy(rr_rs1[lane]))
    def rs2_blocked = rr_controls[lane].operand.uses_rs2 & !(Bool(lane == 1) & rr_replaced[1]) & (rr_right[lane].blocked ||| rr_source_busy(rr_rs2[lane]))
    def destination_blocked = rr_controls[lane].writeback.enable & (rr_busy(rr_rd[lane]) ||| pending_destination(xlen, rr_rd[lane], rr_producers))
    rr_decodable[lane] & (rr_fp_data_blocked[lane] ||| rs1_blocked ||| rs2_blocked ||| destination_blocked)
  // Fold both immediates before EX so the paired ALUs remain independent.
  def rr_pair_offset = instruction_immediate(fields.UImmediate, rr_head.entries[0].instruction, xlen.width) + instruction_immediate(fields.IImmediate, rr_head.entries[1].instruction, xlen.width)
  def rr_multiply_capacity = for List (lane in 0..2): rr_multiply[lane] & !rr_multiply_available
  def rr_vector_blocked = for List (lane in 0..2):
    def control :: RV2WideControl() = rr_controls[lane]
    vector.certification_pending ||| (rr_vector[lane] & (wb_vector_scalar_pending ||| (rr_vector_frs1[lane] & rr_fp_busy(rr_rs1[lane])) ||| (control.vector.floating_point & control.vector.floating_scalar_destination & !fp.drained))) ||| (control.writeback.enable & scoreboard_busy(32, wb_vector_scoreboard.busy, rr_rd[lane])) ||| (wb_vector_fpr_pending & control.fp.valid) ||| (control.memory.enable & (vector.stores_pending ||| (control.memory.access.store_fault_class() & vector.loads_pending)))
  def rr_capacity_blocked = for List (lane in 0..2): rr_multiply_capacity[lane] ||| rr_fp_structural_blocked[lane] ||| rr_training_blocked[lane]
  def rr_blocked = for List (lane in 0..2): rr_data_blocked[lane] ||| rr_capacity_blocked[lane] ||| rr_vector_blocked[lane]
  def rr_pipeline_empty = !(ex_older.egress.valid ||| ex_younger.egress.valid ||| mem_older.egress.valid ||| mem_younger.egress.valid ||| wb_older.egress.valid ||| wb_younger.egress.valid)

  /* Ordering barriers and issue prefix.
     Atomics and CBO.ZERO drain older memory and hold younger memory through
     completion; PAUSE blocks younger issue without blocking accepted returns. */

  def rr_memory_in_pipeline = (ex_older.egress.valid & ex_older.egress.bits.control.memory.enable) ||| (ex_younger.egress.valid & ex_younger.egress.bits.control.memory.enable) ||| (mem_older.egress.valid & mem_older.egress.bits.memory.enable) ||| (mem_younger.egress.valid & mem_younger.egress.bits.memory.enable) ||| (wb_older.egress.valid & wb_older.egress.bits.memory.enable) ||| (wb_younger.egress.valid & wb_younger.egress.bits.memory.enable)
  def rr_ordered_memory_ready = !rr_memory_in_pipeline & scalar_memory.drained & wb_load_response.drained & !wb_ordered_memory_pending
  def rr_ordered_memory = for List (lane in 0..2): rr_decodable[lane] & rr_controls[lane].memory.enable & !rr_controls[lane].memory.access.is_one_of(CacheOperation.Load, CacheOperation.Store)
  // A PAUSE may follow an older peer, but no younger issue crosses it. Its
  // post-retirement cooldown never blocks accepted service completions.
  reg rr_pause_cycles(~init: bits(0, 5))
  def rr_pause_lanes = for List (lane in 0..2):
    (ex_pipe[lane].egress.valid & ex_pipe[lane].egress.bits.control.pause) ||| (mem_pipe[lane].egress.valid & mem_pipe[lane].egress.bits.pause) ||| (wb_pipe[lane].egress.valid & wb_pipe[lane].egress.bits.pause)
  def rr_pause_blocked = vec(rr_pause_lanes).or_reduce() ||| rr_pause_cycles.or_reduce()
  def rr_serialization_ready = rr_pipeline_empty & wb_drained
  def rr_serialization_clear = for List (lane in 0..2): !rr_system[lane] ||| rr_serialization_ready
  def rr_memory_order_clear = for List (lane in 0..2): !rr_ordered_memory[lane] ||| rr_ordered_memory_ready
  def rr_structural_blocked = for List (lane in 0..2): rr_capacity_blocked[lane] ||| !rr_serialization_clear[lane] ||| !rr_memory_order_clear[lane]

  /* The oldest lane owns the admission prefix. A younger fault may enter
     without ordinary decode/pair eligibility, but cannot bypass its older peer. */

  def rr_first = (rr_head.count =/= bits(0, 2)) & !rr_blocked[0] & !rr_squash & !rr_pause_blocked & rr_serialization_clear[0] & rr_memory_order_clear[0]
  def rr_pair_resource_conflict = rr_pair_ras ||| rr_pair_memory ||| rr_pair_deferred ||| rr_pair_fixed_collision ||| (rr_controls[0].fp.valid & rr_controls[1].fp.valid)
  def rr_pair_conflict = rr_pair_raw ||| rr_pair_waw ||| rr_pair_resource_conflict
  def rr_younger_return_reserved = (rr_completion.valid & rr_completion.bits.write) ||| wb_gpr_calendar.occupied[3].into(Bool)
  def rr_second_decodable = rr_head.entries[1].fault.valid ||| (rr_decodable[1] & !rr_pair_conflict)
  def rr_younger_prefix_allowed = rr_decodable[0] & !rr_controls[0].pause & !rr_system[0] & !rr_system[1]
  def rr_second = rr_first & !rr_vector_writeback_waiting & !rr_vector[0] & !rr_vector[1] & (rr_head.count === bits(2, 2)) & !rr_blocked[1] & rr_younger_prefix_allowed & rr_memory_order_clear[1] & rr_second_decodable & !rr_younger_return_reserved
  issued <== rr_first.as_bits().zext(2) + rr_second.as_bits().zext(2)
  rr_window.consume <== issued
  def rr_fp_admitted = mux(rr_fp_lane === bits(0, 1), rr_first, rr_second) & rr_decodable[rr_fp_lane] & rr_fp_fixed[rr_fp_lane]
  fp.book.valid <== rr_fp_admitted
  fp.book.bits <== rr_fp_control.execution
  wb_gpr_calendar.reserve[0].valid <== rr_fp_admitted & rr_fp_late_gpr[rr_fp_lane]
  wb_gpr_calendar.reserve[0].bits <== wb_gpr_calendar.probe_delay
  when (wb_gpr_calendar.reserve[0].valid):
    assert(wb_gpr_calendar.reserve[0].ready, "rv2wide_fp_booked_gpr_writeback")
  wb_gpr_calendar.reserve[1].valid <== (rr_first & rr_multiply[0]) ||| (rr_second & rr_multiply[1])
  wb_gpr_calendar.reserve[1].bits <== bits(PipelinedMultiplierStages + 1, gpr_delay_width)
  ex_multiply.book.valid <== wb_gpr_calendar.reserve[1].valid
  when (!vector.multiply_request.valid ||| vector.multiply_request.fire()):
    rr_vector_multiply_turn <== Bool(#false)
  elsewhen (wb_gpr_calendar.reserve[1].fire()):
    rr_vector_multiply_turn <== Bool(#true)
  // Ordinary younger writes and deferred ingress also occupy this same physical port.
  wb_gpr_calendar.reserve[3].valid <== rr_second ||| rr_completion.valid
  wb_gpr_calendar.reserve[3].bits <== bits(3, gpr_delay_width)
  when (wb_gpr_calendar.reserve[3].valid):
    assert(wb_gpr_calendar.reserve[3].ready, "rv2wide_younger_write_port_reserved")
  when (wb_gpr_calendar.reserve[1].valid):
    assert(wb_gpr_calendar.reserve[1].ready, "rv2wide_multiply_booked_writeback")
  def rr_fp_request = FpExecutionRequest(xlen, rv2wide_fp_profile(xlen), RV2WideFpSchedule()):
    tag:
      RV2WideFpSchedule():
        lane: rr_fp_lane
        speculative: rr_fp_fixed[rr_fp_lane]
        direct: fp_timing.latency(rr_fp_control.execution) === bits(2, fp_timing.width)
    control: rr_fp_control
    left: fp.read_values[0]
    right: fp.read_values[1]
    third: fp.read_values[2]
    left_precision: rr_fp_control.execution.source_precision
    right_precision: rr_fp_control.execution.source_precision
    third_precision: rr_fp_control.execution.source_precision
    integer_operand: rr_left[rr_fp_lane].data
    immediate_index: rr_rs1[rr_fp_lane]
    rounding_mode: mux(rr_fp_lane === bits(0, 1), rr_rounding[0].mode, rr_rounding[1].mode)

  /* RR/EX capture and issue observations.
     Each lane reports its actual blockers, but only the shared admitted
     prefix consumes instructions and enters the execution pipes. */

  def rr_younger_prefix_excluded = rr_system[0] ||| rr_system[1] ||| !rr_decodable[0] ||| (!rr_head.entries[1].fault.valid & !rr_decodable[1])
  def rr_pair_resources_blocked = rr_decodable[0] & rr_decodable[1] & rr_pair_resource_conflict
  for (lane in 0..2):
    def ex_ingress :: Endpoint = ex_pipe[lane].ingress
    def rr_access :: CacheOperation = rr_controls[lane].memory.access
    def rr_auipc_addi = Bool(lane == 1) & (rr_pairing.routes[0] === RV2WidePairRoute.AuipcAddi)
    ex_pipe[lane].flush <== rr_squash
    // Younger offers inherit the older offer's blockers, not a generic age hazard.
    def data_hazard = rr_data_blocked[lane] ||| (if lane == 0 | Bool(#false) | rr_data_blocked[0] ||| (rr_decodable[0] & rr_decodable[1] & (rr_pair_raw ||| rr_pair_waw)))
    def older_structural_hazard = if lane == 0
    | Bool(#false)
    | rr_structural_blocked[0] ||| rr_younger_prefix_excluded ||| rr_pair_resources_blocked ||| rr_younger_return_reserved
    def structural_hazard = rr_structural_blocked[lane] ||| older_structural_hazard
    def rr_observed = rr_window.candidates[lane] |> offer_decoupled() |> trace_event("core/s1.rr.slot" ++ to_string(lane), ~stalls: #true, ~fields: fetched):
      pc: fetched.pc
      instruction(~format: "riscv", ~isa: trace_isa, ~pc: "pc"): fetched.raw_instruction
      data_hazard: data_hazard
      structural_hazard: structural_hazard ||| rr_pause_blocked ||| (Bool(lane == 1) & rr_decodable[0] & rr_controls[0].pause)
    (rr_observed |> gate_flow(if lane == 0 | rr_first | rr_second) |> to_valid() |> map_valid(fetched => RV2WideExecute(xlen)):
      fetched: fetched
      control: rr_controls[lane].updated(
        ~operand: rr_controls[lane].operand.updated(~right_immediate: rr_controls[lane].operand.right_immediate & !rr_auipc_addi),
        ~memory: rr_controls[lane].memory.updated(~access: mux(rr_access.is_cache_management() & (wb_csrs.cbo_permission.operation === CboManagementOperation.Flush), CacheOperation.CacheBlockFlush, rr_access))
      )
      rs1: mux(rr_auipc_addi, rr_head.entries[0].pc, rr_left[lane].data)
      rs2: mux(rr_auipc_addi, rr_pair_offset, rr_right[lane].data)
      pair_routes: if lane == 1 | rr_pairing.routes | vec(RV2WidePairRoute.Register, RV2WidePairRoute.Register)
      rd: rr_rd[lane]
      illegal: !rr_decoded[lane].valid ||| fetched.compressed_illegal ||| rr_fp_illegal[lane] ||| rr_vector_illegal[lane] ||| (rr_cbo_illegal[lane] & !rr_virtual_instruction[lane]) ||| rr_guest_illegal[lane]
      virtual_instruction: rr_decoded[lane].valid & rr_virtual_instruction[lane]
      fp_request: rr_fp_request
      vector:
        VectorDescriptor(xlen):
          pc: fetched.pc
          precertified: Bool(#false)
          certificate: dont_care(VectorFastCertificate(xlen))
          instruction: fetched.instruction
          state: wb_csrs.vector_state
          control: rr_controls[lane].vector
          scalar: rr_left[lane].data
          floating_scalar: fp.read_values[0][0..xlen.width]
          stride: rr_right[lane].data
          masked: !fetched.instruction[25].into(Bool)
          rounding_mode: wb_csrs.frm.into(RoundingMode)
          pointer_masking: wb_csrs.pointer_masking
    ) |> ex_ingress


  /* EX: Operand execution and speculative lookup.
     Two common ALUs and independent target calculations produce registered
     results; launch validity remains separate from payload computation. */

  def ex_tokens :: Vec(2, RV2WideExecute(xlen)) = vec(for List (lane in 0..2): ex_pipe[lane].egress.bits)
  inst ex_alu_older(ALU(xlen))
  inst ex_alu_younger(ALU(xlen))
  def ex_alus = [ex_alu_older, ex_alu_younger]
  for (lane in 0..2):
    def ex :: RV2WideExecute(xlen) = ex_tokens[lane]
    def ex_input :: Endpoint = ex_paths[lane][0]
    def ex_output :: Endpoint = ex_links[lane].left
    def ex_alu = ex_alus[lane]
    def ex_executable = !ex.illegal & !ex.virtual_instruction & !ex.fetched.fault.valid
    def ex_system :: RV2WideSystemControl() = ex.control.system
    def ex_immediate = ex.control.operand.immediate.decode(ex.fetched.instruction, xlen)
    ex_alu.left <== mux_lookup(ex.control.operand.left, ~default: ex.rs1):
      RV2WideLeft.Pc: ex.fetched.pc
      RV2WideLeft.Zero: bits(0, xlen.width)
    ex_alu.right <== mux(ex.control.operand.right_immediate, ex_immediate, ex.rs2)
    ex_alu.control <== ex.control.alu

    /* Effective data address and guest context.
       Mask after the selected address bypass. Explicit guest execute-reads
       disable guest masking; ordinary MPRV/MPV applies only to data privilege. */

    def ex_raw_address = if lane == 1 | mux(ex.pair_routes[0] === RV2WidePairRoute.LoadAddress, ex_alu_older.result, ex_alu.result) | ex_alu.result
    def ex_explicit_guest = ex.control.guest_access =/= RiscvGuestMemoryAccess.Normal
    // Serialized CSR updates flush younger work before a new masking mode is observed.
    def ex_mask :: PointerMaskControl():
      if profile.hypervisor
      | block:
          def execute_read = ex.control.guest_access === RiscvGuestMemoryAccess.GuestExecuteRead
          def guest_mask = wb_csrs.guest_pointer_masking.updated(
            ~mode: mux(execute_read, PointerMaskMode.Disabled, wb_csrs.guest_pointer_masking.mode)
          )
          mux(ex_explicit_guest, guest_mask, wb_csrs.pointer_masking)
      | wb_csrs.pointer_masking
    def ex_address = apply_pointer_mask(xlen, ex_raw_address, ex_mask)
    def ex_data_guest:
      if profile.hypervisor
      | block:
          def mprv_active = (wb_csrs.privilege === PrivilegeMode.Machine) & csr_flag(wb_csrs.mstatus, MstatusMPRV)
          def mprv_guest = csr_flag(wb_csrs.mstatus, MstatusMPV) & (effective_data_privilege(xlen, wb_csrs.privilege, wb_csrs.mstatus) =/= PrivilegeMode.Machine)
          ex_explicit_guest ||| mux(mprv_active, mprv_guest, guest_state.virtualized)
      | Bool(#false)

    /* Branch target and local fault classification are combinational payloads;
       recovery suppresses lane validity rather than these calculations. */

    def ex_target_sum = mux(ex.control.branch.target_from_rs1, ex.rs1, ex.fetched.pc) + ex_immediate
    def ex_target = mux(ex.control.branch.target_from_rs1, ex_target_sum & !bits(1, xlen.width), ex_target_sum)
    def ex_actual_action = mux(ex_executable & ex.control.branch.resolver.enable, riscv_ras_action(ex.fetched.instruction), RasAction.None)
    def ex_bad_pc = ex.fetched.pc[0].into(Bool)
    def ex_memory = ex_executable & ex.control.memory.enable
    def ex_bad_address = ex_memory & ex.control.memory.access.is_one_of(CacheOperation.LoadReserved, CacheOperation.StoreConditional, CacheOperation.Atomic) & !ex.control.memory.width.is_aligned(ex_address)
    def ex_generated_guest = empty_guest.updated(~guest_virtual_address: !ex.illegal & !ex.virtual_instruction & mux(ex_bad_pc, guest_state.virtualized, ex_bad_address & ex_data_guest))
    def ex_fault = ex.fetched.fault.valid ||| ex.illegal ||| ex.virtual_instruction ||| ex_bad_pc ||| ex_bad_address

    /* Local fault provenance.
       Earlier fetch faults precede target, data alignment, and virtual
       instruction faults; the value follows that same owner's address. */

    def ex_address_cause = mux(ex.control.memory.access.store_fault_class(), exception_cause_bits(ExceptionCause.StoreAddressMisaligned, xlen.width), exception_cause_bits(ExceptionCause.LoadAddressMisaligned, xlen.width))
    def ex_fault_cause = priority_mux(~default: exception_cause_bits(ExceptionCause.IllegalInstruction, xlen.width)):
      ex.fetched.fault.valid: ex.fetched.fault.cause
      ex_bad_pc: exception_cause_bits(ExceptionCause.InstructionAddressMisaligned, xlen.width)
      ex_bad_address: ex_address_cause
      ex.virtual_instruction: exception_cause_bits(ExceptionCause.VirtualInstruction, xlen.width)
    def ex_fault_value = priority_mux(~default: if xlen == XLen.X32 | ex.fetched.raw_instruction | ex.fetched.raw_instruction.zext(64)):
      ex.fetched.fault.valid: ex.fetched.fault.value
      ex_bad_pc: ex.fetched.pc
      ex_bad_address: ex_address
    def ex_store_data = priority_mux(~default: ex.rs2):
      ex.control.fp.valid: ex.fp_request.right[0..xlen.width]
      ex.pair_routes[1] === RV2WidePairRoute.StoreData: ex_alu_older.result

    /* EX/MEM payload capture.
       Cancellation filters the lane's validity without inserting a new
       operand, fault, or memory-response stage. */

    (ex_input |> filter_valid(_operation => !rr_squash) |> map_valid(_operation => RV2WideResult(xlen)):
      fetched: ex.fetched
      rd: ex.rd
      write: ex_executable & ex.control.writeback.enable & ex.rd.or_reduce()
      data: mux(ex.control.writeback.link, ex.fetched.sequential_pc, ex_alu.result)
      result_ready: !(ex_memory & ex.control.memory.access.returns_result()) & !ex_system.serializing() & ((ex.control.muldiv.service === RV2WideLongOperation.None) ||| !ex.rd.or_reduce()) & !ex.control.fp.valid & !(ex.control.vector.integer ||| ex.control.vector.memory ||| ex.control.vector.floating_point ||| ex.control.vector.multiply_divide)
      branch:
        RV2WideBranchResult(xlen):
          taken: Bool(#false)
          target: ex_target
          mispredicted: Bool(#false)
          control: ex.control.branch.resolver
          operands_from_older: vec(for List (source in 0..2): ex.pair_routes[source] === RV2WidePairRoute.BranchOperand)
          update:
            BranchUpdate(xlen):
              pc: ex.fetched.pc
              target: ex_target
              branch: ex_executable & ex.control.branch.resolver.enable
              conditional: ex.fetched.instruction[0..7] === bits(0x63, 7)
              taken: Bool(#false)
              compressed: ex.fetched.sequential_pc === (ex.fetched.pc + bits(2, xlen.width))
              ras_action: ex_actual_action
              predicted_ras_action: ex.fetched.speculated_ras_action
              return_address: ex.fetched.sequential_pc
      memory: ex.control.memory.updated(~enable: ex_memory)
      guest_access: ex.control.guest_access
      prefetch: ex.control.prefetch
      pause: ex.control.pause
      locality_hint: ex.control.locality_hint
      address: ex_address
      store_data: ex_store_data
      cache_outcome: RV2WideCacheOutcome.Slow
      system: ex.control.system
      csr_source: mux(ex.control.system.immediate, instruction_field(fields.rs1, ex.fetched.instruction).zext(xlen.width), ex.rs1)
      muldiv: ex.control.muldiv
      left: ex.rs1
      right: ex.rs2
      fp: ex.control.fp
      fp_request: ex.fp_request
      vector: ex.vector
      resolution:
        RV2WideResolution(xlen):
          guest: mux(ex.fetched.fault.valid, ex.fetched.fault.guest, ex_generated_guest)
          disposition: mux(ex_fault, RV2WideDisposition.Fault, RV2WideDisposition.Continue)
          cause: ex_fault_cause
          value: ex_fault_value
    ) |> ex_output
    ex_results[lane] |> mem_pipe[lane].ingress
    mem_pipe[lane].flush <== rr_squash

  /* Scheduled FP and multiply launches.
     Selects one admitted lane for each shared unit and carries its owner
     through the existing fixed-latency service. */

  def ex_fp_lane = ex_tokens[0].fp_request.tag.lane
  def ex_fp :: RV2WideExecute(xlen) = ex_tokens[ex_fp_lane]
  def ex_fp_link :: Handle = interface_link(Valid(RV2WideExecute(xlen)))
  ex_fp_link.left.valid <== mux(ex_fp_lane === bits(0, 1), ex_older.egress.valid, ex_younger.egress.valid) & !rr_squash
  ex_fp_link.left.bits <== ex_fp
  describe_interface_selection([ex_fp_lane === bits(0, 1), ex_fp_lane === bits(1, 1)], ~name: "fp")
  describe_interface_contract(Array(ex_paths[0][3], ex_paths[1][3]), ex_fp_link.left, "fp-lane", ~trace_model: interface_trace_selection(~name: "fp"))
  ex_fp_link.right |> filter_valid(operation => !operation.illegal & !operation.fetched.fault.valid & !operation.fetched.pc[0].into(Bool) & operation.control.fp.valid & !operation.control.fp.bits.execution.unit.is_one_of(FloatUnit.Memory, FloatUnit.DivideSquareRoot))
    |> map_valid(operation => rv2wide_fp_request(xlen, operation.fetched, operation.rd, operation.fp_request)) |> fp.fixed_issue
  def ex_memory_lane = mux(ex_older.egress.valid & !ex_tokens[0].illegal & !ex_tokens[0].fetched.fault.valid & ex_tokens[0].control.memory.enable, bits(0, 1), bits(1, 1))
  def ex_result_tokens :: Vec(2, RV2WideResult(xlen)) = vec(
    for List (lane in 0..2):
      def result :: Endpoint = ex_results[lane]
      result.bits
  )
  def ex_lookup :: RV2WideResult(xlen) = ex_result_tokens[ex_memory_lane]
  def ex_multiply_lane = mux(ex_older.egress.valid & (ex_tokens[0].control.muldiv.service === RV2WideLongOperation.Multiply), bits(0, 1), bits(1, 1))
  def ex_multiply_link :: Handle = interface_link(Valid(RV2WideExecute(xlen)))
  ex_multiply_link.left.valid <== mux(ex_multiply_lane === bits(0, 1), ex_older.egress.valid, ex_younger.egress.valid)
  ex_multiply_link.left.bits <== ex_tokens[ex_multiply_lane]
  describe_interface_selection([ex_multiply_lane === bits(0, 1), ex_multiply_lane === bits(1, 1)], ~name: "multiply")
  describe_interface_contract(Array(ex_paths[0][1], ex_paths[1][1]), ex_multiply_link.left, "multiply-lane", ~trace_model: interface_trace_selection(~name: "multiply"))
  (ex_multiply_link.right |> filter_valid(operation => !rr_squash & !operation.illegal & !operation.fetched.fault.valid & !operation.fetched.pc[0].into(Bool) & operation.rd.or_reduce() & (operation.control.muldiv.service === RV2WideLongOperation.Multiply))
    |> map_valid(operation):
      def request = MultiplierRequest(xlen.width):
        left: operation.rs1
        right: operation.rs2
        mode: operation.control.muldiv.multiply.mode
      def owner = RV2WideRetirement(xlen):
        fetched: operation.fetched
        rd: operation.rd
        write: Bool(#true)
        data: dont_care(Bits(xlen.width))
        deferred: Bool(#false)
      RV2WideMultiplyIssue(xlen):
        request: request
        control: operation.control.muldiv.multiply
        owner: owner
  ) |> ex_multiply.issue

  /* Speculative memory lookup.
     Byte shaping and the selected physical access use the live EX owner;
     lookup alone cannot authorize a store or external transaction. */

  inst ex_store(StoreGen(xlen, xlen.width / 8))
  ex_store.address <== ex_lookup.address
  ex_store.value <== ex_lookup.store_data
  ex_store.width <== ex_lookup.memory.width
  scalar_pipeline.request.valid <== (mux(ex_memory_lane === bits(0, 1), ex_older.egress.valid, ex_younger.egress.valid)) & ex_lookup.memory.enable & (ex_lookup.resolution.disposition === RV2WideDisposition.Continue) & !rr_squash
  scalar_pipeline.request.bits <== RV2WideMemoryReq(xlen, xlen.width):
    guest_access: ex_lookup.guest_access
    address: ex_lookup.address
    access: ex_lookup.memory.access
    atomic: ex_lookup.memory.atomic
    width: ex_lookup.memory.width
    data: mux(ex_lookup.memory.access.is_store(), ex_store.data, ex_lookup.store_data)
    mask: ex_store.mask.as_bits()
    locality: RiscvMemoryLocality.Default
    pbmt: PageMemoryType.PMA
  describe_interface_selection([ex_memory_lane === bits(0, 1), ex_memory_lane === bits(1, 1)], ~name: "lookup")
  describe_interface_contract(Array(ex_paths[0][2], ex_paths[1][2]), scalar_pipeline.request, "lookup-lane", ~trace_model: interface_trace_selection(~name: "lookup"))


  /* MEM: Branch and physical lookup resolution.
     Retains earlier faults ahead of local target faults, external resolution,
     and cache outcomes; captured hits may complete on the ordinary WB path. */

  def mem_memory_lane = mux(mem_older.egress.valid & mem_older.egress.bits.memory.enable, bits(0, 1), bits(1, 1))
  def mem_memory :: RV2WideResult(xlen) = mux(mem_memory_lane === bits(0, 1), mem_older.egress.bits, mem_younger.egress.bits)
  inst mem_load(LoadGen(xlen, xlen.width / 8))
  mem_load.address <== mem_memory.address
  mem_load.width <== mem_memory.memory.width
  mem_load.unsigned_load <== mem_memory.memory.unsigned
  mem_load.data <== scalar_pipeline.response.bits.data
  wire mem_resolved: Vec(2, RV2WideResult(xlen))
  for (lane in 0..2):
    def Array(mem_input, mem_context, mem_branch_input) = mem_pipe[lane].egress |> fork_valid(3)
    def mem_output :: Endpoint = mem_links[lane].left
    def mem :: RV2WideResult(xlen) = mem_pipe[lane].egress.bits
    inst mem_resolver(BranchResolver(xlen.width))
    (mem_branch_input |> filter_valid(_operation => !wb_squash) |> map_valid(_operation => BranchResolverRequest(xlen.width)):
      left: mux(mem.branch.operands_from_older[0], mem_older.egress.bits.data, mem.left)
      right: mux(mem.branch.operands_from_older[1], mem_older.egress.bits.data, mem.right)
      control: mem.branch.control
    ) |> mem_resolver.request
    (mem_context |> map_valid(token): token.into(RV2WideResult(xlen)).fetched) |> memory_stage[lane]
    def mem_lookup = mem.memory.enable & (mem.resolution.disposition === RV2WideDisposition.Continue)
    def mem_misaligned = mem.memory.access.is_one_of(CacheOperation.Load, CacheOperation.Store) & !mem.memory.width.is_aligned(mem.address)
    def mem_outcome = priority_mux(~default: RV2WideCacheOutcome.Replay):
      mem_misaligned: RV2WideCacheOutcome.Slow
      scalar_pipeline.response.valid: scalar_pipeline.response.bits.outcome
    def mem_hit = mem_lookup & (mem.memory.access === CacheOperation.Load) & (mem_outcome === RV2WideCacheOutcome.LoadHit)
    def mem_page_fault = mem_outcome.is_one_of(RV2WideCacheOutcome.PageFault, RV2WideCacheOutcome.GuestPageFault)
    def mem_fault = mem_outcome.is_one_of(RV2WideCacheOutcome.PageFault, RV2WideCacheOutcome.GuestPageFault, RV2WideCacheOutcome.AccessFault)
    def mem_disposition = priority_mux(~default: RV2WideDisposition.Continue):
      mem_fault: RV2WideDisposition.Fault
      mem_outcome === RV2WideCacheOutcome.Replay: RV2WideDisposition.Replay
    def mem_lookup_resolution = RV2WideResolution(xlen):
      guest: scalar_pipeline.response.bits.guest
      disposition: mem_disposition
      cause: memory_fault_cause(mem.memory.access, mem_outcome === RV2WideCacheOutcome.GuestPageFault, mem_page_fault)
      value: mem.address
    def mem_taken = mem.branch.update.branch & mem_resolver.result.bits.taken
    def mem_next_pc = mux(mem_taken, mem.branch.target, mem.fetched.sequential_pc)
    def mem_predicted_pc = mux(mem.fetched.prediction.valid, mem.fetched.prediction.target, mem.fetched.sequential_pc)
    def mem_bad_target = mem_taken & mem.branch.target[0].into(Bool)
    def mem_target_resolution = RV2WideResolution(xlen):
      guest: empty_guest.updated(~guest_virtual_address: guest_state.virtualized)
      disposition: RV2WideDisposition.Fault
      cause: exception_cause_bits(ExceptionCause.InstructionAddressMisaligned, xlen.width)
      value: mem.branch.target

    /* Final MEM resolution and forwarding.
       Earlier faults win; a permitted load hit joins the ordinary data
       path while branch recovery only cancels younger validity. */

    def mem_final_resolution = priority_mux(~default: mem.resolution):
      mem.resolution.disposition =/= RV2WideDisposition.Continue: mem.resolution
      mem_bad_target: mem_target_resolution
      resolution[lane].valid: resolution[lane].bits
      mem_lookup: mem_lookup_resolution
    mem_resolved[lane] <== mem.updated(
      ~resolution: mem_final_resolution,
      ~branch: mem.branch.updated(
        ~taken: mem_taken,
        ~mispredicted: (mem_next_pc =/= mem_predicted_pc) ||| (mem.fetched.direction.valid & (mem.fetched.direction.taken ^ mem_taken)) ||| (Bool(profile.ras_entries > 0) & (mem.branch.update.ras_action =/= mem.fetched.speculated_ras_action)),
        ~update: mem.branch.update.updated(~taken: mem_taken)
      ),
      ~data: mux(mem_hit, mem_load.value, mem.data),
      ~result_ready: mem.result_ready ||| mem_hit,
      ~cache_outcome: mem_outcome
    )
    mem_input |> filter_valid(_operation => !wb_squash & (if lane == 0 | Bool(#true) | !(mem_branch_redirect & mem_resolved[0].branch.mispredicted & mem_older.egress.valid))) |> map_valid(_operation => mem_resolved[lane]) |> mem_output
    (mem_results[lane] |> trace_valid_event("core/s3.mem.slot" ++ to_string(lane), ~fields: token):
      pc: token.fetched.pc
      instruction(~format: "riscv", ~isa: trace_isa, ~pc: "pc"): token.fetched.raw_instruction
      outcome: token.cache_outcome
      disposition: token.resolution.disposition
      branch: token.branch.update.branch
      mispredicted: token.branch.mispredicted
      predicted_target: token.fetched.prediction.target
      taken: token.branch.taken
    ) |> wb_pipe[lane].ingress
    wb_pipe[lane].flush <== wb_squash

  /* MEM branch recovery.
     Correct predictions preserve target-stream work. A correction keeps its
     resolving token and older peers; older WB recovery still wins. */

  def mem_older_continue = mem_resolved[0].resolution.disposition === RV2WideDisposition.Continue
  def mem_branch_older = mem_older.egress.valid & mem_resolved[0].branch.mispredicted & mem_older_continue
  def mem_branch_younger = mem_younger.egress.valid & mem_resolved[1].branch.mispredicted & (mem_resolved[1].resolution.disposition === RV2WideDisposition.Continue) & (!mem_older.egress.valid ||| (mem_older_continue & !mem_resolved[0].branch.mispredicted))
  mem_branch_redirect <== (mem_branch_older ||| mem_branch_younger) & !wb_squash
  def mem_branch :: RV2WideResult(xlen) = mux(mem_branch_older, mem_resolved[0], mem_resolved[1])
  def mem_redirect_bits = RV2WideRedirect(xlen):
    pc: mem_branch.fetched.pc
    target: mux(mem_branch.branch.taken, mem_branch.branch.target, mem_branch.fetched.sequential_pc)
    resolution: mem_branch.resolution


  /* WB: Retained owners and ordered service admission.
     Hits retire directly; ordinary services allocate deferred owners. Split,
     management, and reservation waits retain context through final completion. */

  reg wb_retained_state(~init: RV2WideRetainedState.Idle)
  def wb_retained_pending = wb_retained_state =/= RV2WideRetainedState.Idle
  def wb_retained_sent = wb_retained_state === RV2WideRetainedState.Accepted
  def wb_retained_ready = wb_retained_state === RV2WideRetainedState.Ready
  reg wb_retained_owner(RV2WideResult(xlen))
  reg wb_retained_vector(~init: Bool(#false))
  reg wb_retained_locality(RiscvMemoryLocality)
  reg wb_pending_locality(~init: RiscvMemoryLocality.Default)
  def wb_management = wb_retained_pending & wb_retained_owner.memory.enable & wb_retained_owner.memory.access.is_cache_management()
  wb_reservation_waiting <== wb_retained_pending & (wb_retained_owner.system.wait =/= RV2WideWait.None)

  /* Reservation-wait completion uses retained instruction context.
     Wake wins over timeout faults; the counter saturates until completion. */

  reg wb_wait_count(~init: bits(0, 12))
  def wb_wait_wake = !scalar_memory.reservation_valid ||| wb_csrs.wfi_wake
  def wb_wait_short = wb_retained_owner.system.wait === RV2WideWait.ShortTimeout
  def wb_wait_tw = (wb_csrs.privilege =/= PrivilegeMode.Machine) & csr_flag(wb_csrs.mstatus, MstatusTW)
  def wb_wait_vtw = guest_state.virtualized & csr_flag(guest_state.hstatus, HstatusVTW)
  def wb_wait_expired = wb_wait_count.and_reduce() & (wb_wait_short ||| wb_wait_tw ||| wb_wait_vtw)
  def wb_wait_complete = wb_reservation_waiting & (wb_wait_wake ||| wb_wait_expired)
  def wb_wait_fault = !wb_wait_wake & !wb_wait_short & (wb_wait_tw ||| wb_wait_vtw)
  def wb_wait_resolution = RV2WideResolution(xlen):
    guest: literal(RiscvGuestFault(), 0)
    disposition: mux(wb_wait_fault, RV2WideDisposition.Fault, RV2WideDisposition.Continue)
    cause: mux(wb_wait_tw, exception_cause_bits(ExceptionCause.IllegalInstruction, xlen.width), exception_cause_bits(ExceptionCause.VirtualInstruction, xlen.width))
    value: if xlen == XLen.X32 | wb_retained_owner.fetched.raw_instruction | wb_retained_owner.fetched.raw_instruction.zext(64)

  /* Split, management, and vector completion resolve the captured owner, not live WB.
     Completion may precede acceptance for a wait or local admission fault. */

  wb_management_response <== wb_management & wb_retained_sent
  wire wb_management_fault: Bool
  wire wb_management_accepted: Bool
  def wb_retained_complete = scalar_split.response.valid ||| wb_management_completed.valid ||| wb_management_fault ||| wb_wait_complete ||| (wb_retained_pending & wb_retained_vector & vector.outcome.valid)
  def wb_split_fault = scalar_split.response.bits.page_fault ||| scalar_split.response.bits.guest.page_fault ||| scalar_split.response.bits.response.access_fault
  def wb_split_resolution = RV2WideResolution(xlen):
    guest: scalar_split.response.bits.guest.details
    disposition: mux(wb_split_fault, RV2WideDisposition.Fault, RV2WideDisposition.Continue)
    cause: memory_fault_cause(wb_retained_owner.memory.access, scalar_split.response.bits.guest.page_fault, scalar_split.response.bits.page_fault)
    value: scalar_split.response.bits.fault_address[0..xlen.width]
  def wb_vector_resolution = RV2WideResolution(xlen):
    guest: vector.outcome_guest
    disposition: mux(vector.outcome.bits.disposition === VectorDisposition.Fault, RV2WideDisposition.Fault, RV2WideDisposition.Continue)
    cause: vector.outcome.bits.cause
    value: vector.outcome.bits.fault_address
  def wb_retained_resolution = priority_mux(~default: wb_split_resolution):
    wb_retained_vector: wb_vector_resolution
    wb_reservation_waiting: wb_wait_resolution
    wb_management: mux(wb_management_fault, scalar_memory.fault.bits, wb_retained_owner.resolution)
  def wb_retained_result = wb_retained_owner.updated(
    ~data: scalar_split.response.bits.response.data,
    ~result_ready: Bool(#true),
    ~resolution: wb_retained_resolution
  )


  /* Precise fault and interrupt retention.
     New dispatch observes live owners before ready/fault feedback;
     synchronous faults precede interrupts at the oldest unretired boundary. */

  inst wb_fault_retention(OfferRegister(RV2WideResult(xlen)))
  reg wb_pending_interrupt(~init: Bool(#false))
  def wb_fault_pending = wb_fault_retention.egress.valid
  def wb_valid :: Vec(2, Bool) = vec(mux(wb_retained_pending, wb_retained_complete, wb_older.egress.valid), !wb_retained_pending & wb_younger.egress.valid)
  def wb_group :: Vec(2, RV2WideResult(xlen)) = vec(mux(wb_retained_pending, wb_retained_result, wb_older.egress.bits), wb_younger.egress.bits)
  // New dispatch observes the live WB pipes, never the returned retained owner.
  // In particular, admission faults cannot feed back into their own request.
  def wb_live_valid :: Vec(2, Bool) = vec(wb_older.egress.valid, wb_younger.egress.valid)
  def wb_live_group :: Vec(2, RV2WideResult(xlen)) = vec(wb_older.egress.bits, wb_younger.egress.bits)
  def wb_raw_fault = (wb_live_valid[0] & (wb_live_group[0].resolution.disposition === RV2WideDisposition.Fault)) ||| (wb_live_valid[1] & (wb_live_group[1].resolution.disposition === RV2WideDisposition.Fault))
  // Interrupts precede the oldest unretired WB instruction, or use the saved
  // next PC at an empty-pipeline/sleep boundary. A synchronous fault wins.
  def wb_idle_boundary = rr_pipeline_empty & wb_pc_known
  def wb_interrupt_stop = wb_csrs.interrupt_request & !wb_retained_pending & !wb_fault_pending & !wb_raw_fault & (wb_live_valid[0] ||| wb_idle_boundary)
  def wb_interrupt_pc = mux(wb_valid[0], wb_group[0].fetched.pc, wb_resume_pc)
  def wb_older_stop = wb_live_valid[0] & (wb_live_group[0].resolution.disposition =/= RV2WideDisposition.Continue)
  def wb_retirement_unblocked = !wb_fault_pending & !wb_interrupt_stop
  def wb_dispatch_unblocked = !wb_retained_pending & wb_retirement_unblocked

  /* Admission prefix: inspect live owners before any ready/fault outcome.
     Final retirement cannot qualify requests without creating feedback.
     Retained completion may retire, but cannot dispatch a new live owner. */

  def wb_dispatch :: Vec(2, Bool) = vec(
    for List (lane in 0..2):
      wb_live_valid[lane] & (wb_live_group[lane].resolution.disposition === RV2WideDisposition.Continue) & (if lane == 0 | Bool(#true) | !wb_older_stop) & wb_dispatch_unblocked
  )
  def wb_vectors = for List (lane in 0..2):
    def control = wb_live_group[lane].vector.control
    control.integer ||| control.memory ||| control.floating_point ||| control.multiply_divide
  def wb_vector_lane = mux(wb_live_valid[0] & wb_vectors[0], bits(0, 1), bits(1, 1))
  def wb_vector = wb_live_group[wb_vector_lane]
  def wb_vector_offer = wb_dispatch[wb_vector_lane] & (if vector_enabled | mux(wb_vector_lane === bits(0, 1), wb_vectors[0], wb_vectors[1]) | Bool(#false))
  def wb_vector_ordered = !wb_vector.vector.control.memory ||| (wb_prior_memory_drained & !wb_load_response.pending & !wb_ordered_memory_pending)
  vector.request.valid <== wb_vector_offer & wb_vector_ordered & !wb_vector_scalar_pending & !wb_vector_fpr_pending & (!wb_vector.vector.control.floating_scalar_destination ||| !wb_vector.vector.control.floating_point ||| fp.drained)
  vector.request.bits <== wb_vector.vector
  def wb_vector_accepted = vector.request.fire()
  def wb_vector_capture = wb_vector_accepted & wb_vector.vector.control.memory
  def wb_vector_replay = wb_vector_offer & !wb_vector_accepted
  wb_vector_scoreboard.set.valid <== wb_vector_accepted & wb_vector.write
  wb_vector_scoreboard.set.bits <== wb_vector.rd
  fp.vector_reserve.valid <== wb_vector_accepted & wb_vector.vector.control.floating_point & wb_vector.vector.control.floating_scalar_destination
  fp.vector_reserve.bits <== wb_vector.rd
  when (wb_vector_accepted & wb_vector.vector.control.integer & wb_vector.vector.control.scalar_destination):
    wb_vector_scalar_pending <== Bool(#true)
    wb_vector_scalar_owner <== wb_vector.fetched
  elsewhen (vector.scalar_result.valid):
    wb_vector_scalar_pending <== Bool(#false)
  when (fp.vector_reserve.valid):
    wb_vector_fpr_pending <== Bool(#true)
  elsewhen (fp.vector_written.valid):
    wb_vector_fpr_pending <== Bool(#false)
  wb_csrs.vector_retire.valid <== vector.retire.valid ||| (wb_vector_accepted & !wb_vector.vector.control.memory)
  def wb_memory_lane = mux(wb_live_valid[0] & wb_live_group[0].memory.enable, bits(0, 1), bits(1, 1))
  def wb_memory :: RV2WideResult(xlen) = wb_live_group[wb_memory_lane]
  // A younger request consumes its older peer's hint on this same WB edge.
  // This selection must not depend on request readiness or retirement feedback.
  def wb_memory_locality = mux(wb_memory_lane === bits(0, 1), wb_pending_locality, wb_live_group[0].locality_hint)
  def wb_memory_active = wb_dispatch[wb_memory_lane] & wb_memory.memory.enable
  def wb_split_capture = wb_memory_active & wb_memory.memory.access.is_one_of(CacheOperation.Load, CacheOperation.Store) & !wb_memory.memory.width.is_aligned(wb_memory.address)
  def wb_management_capture = wb_memory_active & wb_memory.memory.access.is_cache_management()
  def wb_wait_capture = wb_dispatch[0] & (wb_live_group[0].system.wait =/= RV2WideWait.None)
  def wb_retained_capture = wb_split_capture ||| wb_management_capture ||| wb_wait_capture ||| wb_vector_capture
  def wb_retained_lane = mux(wb_vector_capture, wb_vector_lane, mux(wb_wait_capture, bits(0, 1), wb_memory_lane))
  def wb_retained_candidate :: RV2WideResult(xlen) = wb_live_group[wb_retained_lane]

  /* Retained lineage follows capture and final completion.
     Normal retirement selects between the live oldest and returned owner. */

  def wb_retained_input :: Handle = interface_link(Valid(RV2WideResult(xlen)))
  def wb_retained_output :: Handle = interface_link(Valid(RV2WideResult(xlen)))
  wb_retained_input.left.valid <== wb_retained_capture
  wb_retained_input.left.bits <== wb_retained_candidate
  wb_retained_output.left.valid <== wb_retained_pending & wb_retained_complete
  wb_retained_output.left.bits <== wb_retained_result
  describe_interface_selection([wb_retained_lane === bits(0, 1), wb_retained_lane === bits(1, 1)], ~name: "retained-operation-lane")
  describe_interface_contract(Array(wb_paths[0][1], wb_paths[1][1]), wb_retained_input.left, "retained-operation-lane", ~trace_model: interface_trace_selection(~name: "retained-operation-lane"))
  describe_interface_retained_storage(wb_retained_capture, wb_retained_complete, wb_retained_pending, ~name: "retained-operation")
  describe_interface_contract(wb_retained_input.right, wb_retained_output.left, "retained-operation-owner", ~trace_model: interface_trace_retained(~name: "retained-operation"))
  def wb_owners :: Handle = interface_link(Valid(RV2WideResult(xlen)))
  wb_owners.left.valid <== wb_valid[0]
  wb_owners.left.bits <== wb_group[0]
  describe_interface_selection([!wb_retained_pending, wb_retained_pending], ~name: "wb-owner")
  describe_interface_contract(Array(wb_paths[0][0], wb_retained_output.right), wb_owners.left, "wb-owner", ~trace_model: interface_trace_selection(~name: "wb-owner"))

  /* Drain older services before launching retained split work.
     Capture, completion, acceptance, then drain define state-update priority. */

  def wb_slow = wb_memory_active & !wb_retained_capture & (wb_memory.cache_outcome === RV2WideCacheOutcome.Slow)
  def wb_store_hit = wb_memory_active & wb_memory.memory.access.is_store() & (wb_memory.cache_outcome === RV2WideCacheOutcome.StoreHit)
  def wb_memory_blocked = scalar_memory.ordered_busy ||| wb_ordered_memory_pending ||| vector.stores_pending ||| (wb_memory.memory.access.store_fault_class() & vector.loads_pending)
  def wb_prior_drained = wb_load_response.drained & scalar_memory.drained & ex_multiply.drained & wb_divide.drained & !wb_completion_count.or_reduce() & !rr_completion.valid & fp.drained & !vector.active & !wb_vector_scalar_pending & !wb_vector_fpr_pending
  scalar_split.request.valid <== wb_retained_ready & !wb_management & !wb_reservation_waiting & !wb_retained_vector
  memory_ports.scalar_guest_access <== wb_retained_owner.guest_access
  scalar_split.request.bits <== PhysicalMemoryReq(xlen, Bool):
    address: wb_retained_owner.address
    access: wb_retained_owner.memory.access
    atomic: dont_care(scalar_split.request.bits.atomic.type)
    width: wb_retained_owner.memory.width
    unsigned: wb_retained_owner.memory.unsigned
    data: wb_retained_owner.store_data
    byte_mask: dont_care(Bits(xlen.width / 8))
    context: Bool(#false)
    locality: wb_retained_locality
  def wb_retained_accepted = scalar_split.request.fire() ||| wb_management_accepted
  def wb_retained_drained = (wb_retained_state === RV2WideRetainedState.Draining) & wb_prior_drained
  when wb_retained_capture:
    wb_retained_state <== mux(wb_vector_capture, RV2WideRetainedState.Accepted, RV2WideRetainedState.Draining)
    wb_retained_owner <== wb_retained_candidate
    wb_retained_locality <== wb_memory_locality
    wb_retained_vector <== wb_vector_capture
  elsewhen wb_retained_complete:
    wb_retained_state <== RV2WideRetainedState.Idle
  elsewhen wb_retained_accepted:
    wb_retained_state <== RV2WideRetainedState.Accepted
  elsewhen wb_retained_drained:
    wb_retained_state <== RV2WideRetainedState.Ready
  when wb_wait_capture:
    wb_wait_count <== bits(0, 12)
  elsewhen (wb_reservation_waiting & !wb_wait_complete & !wb_wait_count.and_reduce()):
    wb_wait_count <== wb_wait_count + bits(1, 12)
  when (scalar_split.response.valid):
    assert(wb_retained_pending & wb_retained_sent, "rv2wide_split_response_has_retirement_owner")

  /* WB service dispatch and admission outcomes.
     Request offers depend on pre-dispatch owners, not final retirement;
     successful acceptance, admission faults, and replay remain distinct. */

  def wb_request_owner :: RV2WideResult(xlen) = mux(wb_management, wb_retained_owner, wb_memory)
  inst wb_store(StoreGen(xlen, xlen.width / 8))
  wb_store.address <== wb_request_owner.address
  wb_store.value <== wb_request_owner.store_data
  wb_store.width <== wb_request_owner.memory.width
  scalar_memory.request.valid <== (wb_slow & wb_load_response.available & !wb_memory_blocked) ||| (wb_management & wb_retained_ready)
  scalar_memory.request.bits <== RV2WideMemoryReq(xlen, xlen.width):
    guest_access: wb_request_owner.guest_access
    address: wb_request_owner.address
    access: wb_request_owner.memory.access
    atomic: wb_request_owner.memory.atomic
    width: wb_request_owner.memory.width
    data: mux(wb_request_owner.memory.access.is_store(), wb_store.data, wb_request_owner.store_data)
    mask: wb_store.mask.as_bits()
    locality: mux(wb_request_owner.memory.access.is_one_of(CacheOperation.Load, CacheOperation.Store), wb_memory_locality, RiscvMemoryLocality.Default)
    pbmt: PageMemoryType.PMA
  scalar_pipeline.commit <== wb_store_hit & !wb_memory_blocked
  // The physical service's drain may depend on today's admission. Sample a
  // quiet boundary before allowing a vector descriptor to begin page proof.
  wb_prior_memory_drained <== scalar_memory.drained & !scalar_memory.request.fire() & !scalar_pipeline.commit & !scalar_split.request.fire()
  def wb_admission_fault = scalar_memory.request.valid & scalar_memory.fault.valid
  wb_management_fault <== wb_management & wb_admission_fault
  wb_management_accepted <== wb_management & scalar_memory.request.fire()
  def wb_accepted = scalar_memory.request.fire() & !wb_admission_fault & !wb_management
  def wb_memory_replay = (wb_memory_active & !wb_retained_capture & wb_memory_blocked) ||| (wb_slow & !wb_accepted & !wb_admission_fault) ||| (wb_store_hit & !scalar_pipeline.commit_ready)
  wb_load_response.allocate.valid <== wb_accepted
  wb_load_response.allocate.bits <== wb_memory
  when (wb_accepted & !wb_memory.memory.access.is_one_of(CacheOperation.Load, CacheOperation.Store)):
    wb_ordered_memory_pending <== Bool(#true)
  elsewhen (wb_load_response.ordered_completed.valid):
    wb_ordered_memory_pending <== Bool(#false)
  assert(!(scalar_memory.request.fire() & wb_admission_fault), "rv2wide_fault_prevents_acceptance")
  def wb_memory_resolution = RV2WideResolution(xlen):
    guest: literal(RiscvGuestFault(), 0)
    disposition: RV2WideDisposition.Replay
    cause: dont_care(Bits(xlen.width))
    value: dont_care(Bits(xlen.width))
  def wb_fp_lane = mux(wb_valid[0] & wb_group[0].fp.valid, bits(0, 1), bits(1, 1))
  def wb_fp_token :: RV2WideResult(xlen) = wb_group[wb_fp_lane]
  def wb_fp_prefix = (wb_fp_lane === bits(0, 1)) ||| (!wb_older_stop & !(wb_memory_active & (wb_memory_lane === bits(0, 1)) & (wb_memory_replay ||| wb_admission_fault ||| wb_retained_capture)))
  fp.variable_issue.valid <== wb_dispatch[wb_fp_lane] & wb_fp_token.fp.valid & (wb_fp_token.fp.bits.execution.unit === FloatUnit.DivideSquareRoot) & wb_fp_prefix
  fp.variable_issue.bits <== rv2wide_fp_request(xlen, wb_fp_token.fetched, wb_fp_token.rd, wb_fp_token.fp_request)
  wb_fp_variable_accepted <== fp.variable_issue.fire()
  def wb_fp_replay = fp.variable_issue.valid & !fp.variable_issue.ready

  /* Deferred integer arithmetic authorization.
     WB authorizes surviving multiply work and retains divider context;
     accepted services reserve their architectural destination. */

  def wb_long_lane = mux(wb_valid[0] & (wb_group[0].muldiv.service =/= RV2WideLongOperation.None), bits(0, 1), bits(1, 1))
  def wb_long :: RV2WideResult(xlen) = wb_group[wb_long_lane]
  def wb_long_active = wb_dispatch[wb_long_lane] & wb_long.write & (wb_long.muldiv.service =/= RV2WideLongOperation.None)
  def wb_multiply_accepted = wb_long_active & (wb_long.muldiv.service === RV2WideLongOperation.Multiply)
  ex_multiply.authorize <== wb_multiply_accepted
  def wb_divide_link :: Handle = interface_link(Decoupled(RV2WideResult(xlen)))
  wb_divide_link.left.valid <== wb_long_active & (wb_long.muldiv.service === RV2WideLongOperation.Divide)
  wb_divide_link.left.bits <== wb_long
  (wb_divide_link.right |> map_flow(operation):
    def control = operation.muldiv.divide
    def word_left = if xlen == XLen.X32 | operation.left | mux(control.signed_mode, operation.left[0..32].into(SInt(32)).sext(64).into(Bits(64)), operation.left[0..32].zext(64))
    def word_right = if xlen == XLen.X32 | operation.right | mux(control.signed_mode, operation.right[0..32].into(SInt(32)).sext(64).into(Bits(64)), operation.right[0..32].zext(64))
    def request = DividerRequest(xlen.width):
      dividend: mux(control.word_result, word_left, operation.left)
      divisor: mux(control.word_result, word_right, operation.right)
      signed_mode: control.signed_mode
    def owner = RV2WideRetirement(xlen):
      fetched: operation.fetched
      rd: operation.rd
      write: operation.write
      data: dont_care(Bits(xlen.width))
      deferred: Bool(#false)
    RV2WideDivideIssue(xlen):
      request: request
      control: control
      owner: owner
  ) |> wb_divide.issue
  def wb_divide_accepted = wb_divide_link.right.fire()
  def wb_divide_replay = wb_divide_link.right.valid & !wb_divide_accepted
  def wb_long_accepted = wb_multiply_accepted ||| wb_divide_accepted
  wb_scoreboard.set.valid <== (wb_accepted & wb_memory.write) ||| wb_long_accepted
  wb_scoreboard.set.bits <== mux(wb_long_accepted, wb_long.rd, wb_memory.rd)
  assert(!(wb_accepted & wb_long_accepted), "rv2wide_one_deferred_owner_per_group")

  /* Oldest-first stop and retirement decisions.
     Folds service faults and replay into each owner's resolution before
     choosing the successful retirement prefix or a retained precise trap. */

  def wb_tokens :: Vec(2, RV2WideResult(xlen)) = vec(
    for List (lane in 0..2):
      def token :: RV2WideResult(xlen) = wb_group[lane]
      def selected = wb_memory_active & (wb_memory_lane === bits(lane, 1))
      def replay = (selected & wb_memory_replay) ||| (wb_divide_replay & (wb_long_lane === bits(lane, 1))) ||| (wb_fp_replay & (wb_fp_lane === bits(lane, 1))) ||| (wb_vector_replay & (wb_vector_lane === bits(lane, 1)))
      def resolved = priority_mux(~default: token.resolution):
        selected & wb_admission_fault: scalar_memory.fault.bits
        replay: wb_memory_resolution
      token.updated(
        ~resolution: resolved
      )
  )
  def wb_stop = for List (lane in 0..2):
    wb_retirement_unblocked & wb_valid[lane] & (wb_tokens[lane].resolution.disposition =/= RV2WideDisposition.Continue) & !(wb_retained_capture & (wb_retained_lane === bits(0, 1)))
  def wb_selected :: RV2WideResult(xlen) = mux(wb_stop[0], wb_tokens[0], wb_tokens[1])
  def wb_stop_valid = wb_stop[0] ||| wb_stop[1]
  wb_drained <== wb_prior_drained & !wb_accepted & !wb_divide_accepted & !wb_retained_pending & !wb_retained_capture & !wb_fp_variable_accepted & !wb_fp_fixed_authorized
  def wb_explicit_fault = wb_stop_valid & (wb_selected.resolution.disposition === RV2WideDisposition.Fault)
  def wb_hold_fault = (wb_explicit_fault ||| wb_interrupt_stop) & !wb_drained
  wb_fault_retention.update.valid <== wb_hold_fault
  wb_fault_retention.update.bits <== mux(wb_interrupt_stop, wb_group[0].updated(~fetched: wb_group[0].fetched.updated(~pc: wb_interrupt_pc)), wb_selected)
  when wb_hold_fault:
    wb_pending_interrupt <== wb_interrupt_stop
  wb_fault_retention.egress.ready <== wb_drained
  def wb_fault :: RV2WideResult(xlen) = mux(wb_fault_pending, wb_fault_retention.egress.bits, wb_selected)
  def wb_system_control :: RV2WideSystemControl() = wb_group[0].system
  def wb_system = wb_valid[0] & wb_system_control.serializing() & !wb_wait_capture & !wb_fault_pending & !wb_interrupt_stop & !wb_stop_valid
  def wb_fault_command = wb_drained & (wb_explicit_fault ||| (wb_fault_pending & !wb_pending_interrupt))
  def wb_command :: RV2WideResult(xlen) = mux(wb_fault_command, wb_fault, wb_group[0])
  wb_csrs.commit.valid <== wb_fault_command ||| wb_system
  wb_csrs.commit.bits <== RiscvCsrCommand(xlen):
    pc: wb_command.fetched.pc
    instruction: wb_command.fetched.raw_instruction
    rd: wb_command.rd
    csr_operation: mux(wb_fault_command, RiscvCsrOperation.None, wb_command.system.csr)
    action: mux(wb_fault_command, RiscvCsrAction.None, wb_command.system.action)
    csr_address: wb_command.fetched.instruction[20..32]
    csr_source: wb_command.csr_source
    vector_config: vector_configuration_request(xlen, wb_command.vector.control.configure, wb_command.fetched.instruction, wb_command.left, wb_command.right)
    exception_valid: wb_fault_command
    exception_cause: wb_fault.resolution.cause
    exception_value: wb_fault.resolution.value
  if profile.hypervisor
  | block:
      wb_csrs.guest_fault.valid <== wb_fault_command
      wb_csrs.guest_fault.bits <== wb_fault.resolution.guest
  | #void

  /* Architectural redirects and recovery.
     Selects trap, interrupt, wake, and replay targets without canceling
     already accepted services or changing their completion ownership. */

  def wb_interrupt_boundary = wb_drained & (wb_interrupt_stop ||| (wb_fault_pending & wb_pending_interrupt))
  wb_csrs.interrupt_boundary <== wb_interrupt_boundary
  wb_csrs.interrupt_pc <== mux(wb_fault_pending, wb_fault.fetched.pc, wb_interrupt_pc)
  def wb_replay = wb_stop_valid & (wb_selected.resolution.disposition === RV2WideDisposition.Replay)
  def wb_wake = wb_sleeping & wb_csrs.wfi_wake
  def wb_system_resume = wb_system & wb_csrs.command_success & !wb_csrs.wfi
  def wb_retained_resume = wb_retained_pending & wb_retained_complete & (wb_retained_result.resolution.disposition === RV2WideDisposition.Continue)
  instruction_invalidate.valid <== wb_system_resume & (wb_system_control.fence === RV2WideFence.Instruction)
  predictor_clear.valid <== translation_flush ||| wb_csrs.trap_event.valid ||| (wb_system & wb_csrs.command_success & wb_system_control.action.is_one_of(RiscvCsrAction.Mret, RiscvCsrAction.Sret))
  wb_redirect_link.left.valid <== wb_csrs.redirect.valid ||| wb_replay ||| wb_system_resume ||| wb_interrupt_boundary ||| wb_wake ||| wb_retained_resume
  def wb_redirect_disposition = priority_mux(~default: RV2WideDisposition.System):
    wb_csrs.trap_event.valid & !wb_interrupt_boundary: RV2WideDisposition.Fault
    wb_replay: RV2WideDisposition.Replay
  wb_redirect_link.left.bits <== RV2WideRedirect(xlen):
    pc:
      priority_mux(~default: wb_command.fetched.pc):
        wb_interrupt_boundary: wb_csrs.interrupt_pc
        wb_wake: wb_resume_pc
        wb_replay: wb_selected.fetched.pc
    target:
      priority_mux(~default: wb_command.fetched.sequential_pc):
        wb_csrs.redirect.valid: wb_csrs.redirect.bits
        wb_interrupt_boundary: wb_csrs.interrupt_pc
        wb_wake: wb_resume_pc
        wb_replay: wb_selected.fetched.pc
    resolution:
      RV2WideResolution(xlen):
        guest: literal(RiscvGuestFault(), 0)
        disposition: wb_redirect_disposition
        cause: wb_csrs.trap_event.cause
        value: wb_csrs.trap_event.value
  wb_squash <== wb_stop_valid ||| wb_fault_pending ||| wb_interrupt_stop ||| wb_system ||| wb_sleeping ||| wb_retained_capture ||| wb_retained_pending
  rr_squash <== wb_squash ||| mem_branch_redirect
  fetch_flush.valid <== rr_squash
  redirect.valid <== wb_redirect.valid ||| mem_branch_redirect
  redirect.bits <== mux(wb_redirect.valid, wb_redirect.bits, mem_redirect_bits)


  /* Retirement publication and architectural updates.
     Per-lane success controls register writes and predictor observations;
     retirement remains distinct from deferred result completion. */

  wire wb_writes: Vec(2, Bool)
  wire wb_recover_ras: Vec(2, Bool)
  wire wb_train: Vec(2, Bool)
  def wb_retirement_links = for List (_ in 0..2): interface_link(Valid(RV2WideRetirement(xlen)))
  // Publish only the successful retirement prefix; architectural writes and
  // predictor updates below all consume these per-lane decisions.
  def wb_retire = for List (lane in 0..2):
    def token :: RV2WideResult(xlen) = wb_tokens[lane]
    def retained = wb_retained_capture & (if lane == 0 | wb_retained_lane === bits(0, 1) | Bool(#true))
    !retained & wb_retirement_unblocked & wb_valid[lane] & (token.resolution.disposition === RV2WideDisposition.Continue) & (if lane == 0 | !wb_system ||| wb_csrs.command_success | !wb_stop[0] & !wb_system)
  def wb_retirement_paths = for List (lane in 0..2):
    def wb :: RV2WideResult(xlen) = wb_tokens[lane]
    def next_pc = mux(wb.branch.taken, wb.branch.target, wb.fetched.sequential_pc)
    def predicted_pc = mux(wb.fetched.prediction.valid, wb.fetched.prediction.target, wb.fetched.sequential_pc)
    def observed = wb_retirement_links[lane].right |> trace_valid_event("core/s4.wb.slot" ++ to_string(lane), ~fields: result):
      pc: result.fetched.pc
      instruction(~format: "riscv", ~isa: trace_isa, ~pc: "pc"): result.fetched.raw_instruction
      deferred: result.deferred
      rd: result.rd
      branch_prediction(~format: "enum"): mux(wb.branch.update.branch, mux(next_pc =/= predicted_pc, RV2WideBranchPrediction.Mispredicted, RV2WideBranchPrediction.Correct), RV2WideBranchPrediction.NotBranch)
      ras_mismatch: wb.branch.update.ras_action =/= wb.branch.update.predicted_ras_action
    observed |> fork_valid(4)
  for (lane in 0..2):
    def wb :: RV2WideResult(xlen) = wb_tokens[lane]
    def wb_eligible = wb_retire[lane]
    def wb_fp_compute = wb.fp.valid & (wb.fp.bits.execution.unit =/= FloatUnit.Memory)
    def wb_fp_direct = wb_fp_compute & wb.fp_request.tag.speculative & wb.fp_request.tag.direct
    def wb_deferred = (wb_accepted & (wb_memory_lane === bits(lane, 1))) ||| (wb_long_accepted & (wb_long_lane === bits(lane, 1))) ||| (wb_fp_compute & !wb_fp_direct) ||| (wb_vector_accepted & (wb_vector_lane === bits(lane, 1)))
    def wb_data = priority_mux(~default: wb.data):
      wb_system: wb_csrs.writeback_value
      wb_fp_direct & wb.write: fp.completion.bits.integer_value
    def retirement :: Endpoint = wb_retirement_links[lane].left
    retirement.valid <== wb_eligible
    retirement.bits <== RV2WideRetirement(xlen):
      fetched: wb.fetched
      rd: wb.rd
      write: wb.write
      data: wb_data
      deferred: wb_deferred
    describe_interface_contract(if lane == 0 | wb_owners.right | wb_paths[1][0], retirement, "retirement-" ++ to_string(lane), ~trace_model: interface_trace_combinational())
    wb_retirement_paths[lane][0] |> retired[lane]
    wb_writes[lane] <== wb_eligible & wb.write & !wb_deferred & (!wb_system ||| wb_csrs.writeback_valid)
    wb_train[lane] <== wb_eligible & wb.branch.update.branch
    wb_recover_ras[lane] <== wb_eligible & wb.branch.mispredicted

  /* Hints and predictor training.
     Hints are best-effort and never stall a lane. Retired branch training
     is buffered, while architectural history and RAS recovery stay immediate. */

  def wb_prefetch_paths = for List (lane in 0..2):
    def token :: RV2WideResult(xlen) = wb_tokens[lane]
    wb_retirement_paths[lane][2] |> filter_valid(_retired => token.prefetch.is_prefetch()) |> map_valid(_retired => CachePrefetchReq(64)):
      address: if xlen == XLen.X64 | token.address | token.address.zext(64)
      operation: token.prefetch
  Array(wb_prefetch_paths[0], wb_prefetch_paths[1]) |> valid_arbiter() |> prefetch
  def wb_training :: Vec(2, RV2WideBranchTraining(xlen)) = vec(
    for List (lane in 0..2):
      RV2WideBranchTraining(xlen):
        branch: wb_tokens[lane].branch.update
        direction_valid: wb_tokens[lane].branch.update.conditional & wb_tokens[lane].fetched.direction.valid
        direction_index: wb_tokens[lane].fetched.direction.index
  )
  for (lane in 0..2):
    wb_retirement_paths[lane][3] |> filter_valid(_retired => wb_tokens[lane].branch.update.branch) |> map_valid(_retired => wb_training[lane]) |> branch_training.incoming[lane]
  branch_training.clear.valid <== predictor_clear.valid
  def wb_training_head :: RV2WideBranchTraining(xlen) = branch_training.training.bits
  branch_update.valid <== branch_training.training.valid
  branch_update.bits <== wb_training_head.branch
  direction_update.valid <== branch_update.valid & wb_training_head.direction_valid
  direction_update.bits <== BhtUpdate(10):
    index: wb_training_head.direction_index
    taken: branch_update.bits.taken
  // Architectural history and RAS reconciliation are never delayed behind table writes.
  def wb_ras :: Vec(2, Bool) = vec(for List (lane in 0..2): wb_train[lane] & ((wb_tokens[lane].branch.update.ras_action =/= RasAction.None) ||| (wb_tokens[lane].branch.update.predicted_ras_action =/= RasAction.None)))
  def wb_ras_branch = mux(wb_ras[0], wb_tokens[0].branch.update, wb_tokens[1].branch.update)
  ras_resolution.valid <== wb_ras.or_reduce()
  ras_resolution.bits <== RasResolution(xlen):
    actual:
      RasUpdate(xlen):
        action: wb_ras_branch.ras_action
        return_address: wb_ras_branch.return_address
    predicted_action: wb_ras_branch.predicted_ras_action
  history_commit.valid <== wb_train.or_reduce()
  history_commit.bits <== RV2WideHistoryCommit():
    enable: vec(for List (lane in 0..2): wb_train[lane] & wb_training[lane].direction_valid)
    taken: vec(for List (lane in 0..2): wb_tokens[lane].branch.update.taken)
  // A MEM correction keeps its branch. WB rejection is older and instead
  // restores the checkpoint before the oldest instruction being discarded.
  history_restore.valid <== mem_branch_redirect ||| wb_stop_valid ||| wb_retained_capture ||| wb_system
  history_restore.bits <== priority_mux(~default: rv2wide_history_after(mem_branch.fetched.direction, mem_branch.branch.taken)):
    wb_stop_valid: wb_selected.fetched.direction.history
    wb_retained_capture: wb_memory.fetched.direction.history
    wb_system: wb_group[0].fetched.direction.history
  predictor_restore.valid <== wb_squash ||| wb_recover_ras.or_reduce()
  assert(!(wb_ras[0] & wb_ras[1]), "rv2wide_one_ras_resolution_per_group")

  /* Floating-point authorization and load completion.
     Qualifies the successful WB prefix without CSR feedback; accepted loads
     retain FP ownership independently of younger pipeline recovery. */

  // Authorization must not depend on wb_retire or CSR command_success:
  // those outcomes consume the FP authorization/drain decision themselves.
  def wb_fp_older_allows = (wb_fp_lane === bits(0, 1)) ||| !wb_stop[0]
  def wb_fp_not_displaced = !wb_retained_capture ||| ((wb_fp_lane === bits(0, 1)) & (wb_retained_lane === bits(1, 1)))
  def wb_fp_success = wb_valid[wb_fp_lane] & wb_retirement_unblocked & !wb_system & (wb_tokens[wb_fp_lane].resolution.disposition === RV2WideDisposition.Continue) & wb_fp_older_allows & wb_fp_not_displaced
  fp.authorize.valid <== wb_fp_success & wb_fp_token.fp.valid & !wb_fp_token.fp.bits.execution.unit.is_one_of(FloatUnit.Memory, FloatUnit.DivideSquareRoot)
  wb_fp_fixed_authorized <== fp.authorize.valid
  fp.authorize.bits <== rv2wide_fp_request(xlen, wb_fp_token.fetched, wb_fp_token.rd, wb_fp_token.fp_request)
  wb_fp_gpr_scoreboard.set.valid <== fp.authorize.valid & !fp.authorize.bits.tag.direct & (fp.authorize.bits.tag.destination === FloatDestination.Integer) & fp.authorize.bits.tag.rd.or_reduce()
  wb_fp_gpr_scoreboard.set.bits <== fp.authorize.bits.tag.rd
  fp.load_reserve.valid <== wb_accepted & wb_memory.fp.valid & (wb_memory.fp.bits.registers.destination === FloatDestination.FloatingPoint)
  fp.load_reserve.bits <== rv2wide_fp_owner(xlen, wb_memory.fetched, wb_memory.rd, wb_memory.fp_request)
  fp.load_hit.valid <== mux(wb_fp_lane === bits(0, 1), retired[0].valid, retired[1].valid) & wb_fp_token.fp.valid & wb_fp_token.memory.enable & (wb_fp_token.memory.access === CacheOperation.Load) & !wb_accepted
  fp.load_hit.bits <== RV2WideFpLoad(xlen):
    owner: rv2wide_fp_owner(xlen, wb_fp_token.fetched, wb_fp_token.rd, wb_fp_token.fp_request)
    precision: wb_fp_token.fp.bits.execution.destination_precision
    data: if xlen == XLen.X64 | wb_fp_token.data | wb_fp_token.data.zext(64)
  // Accepted services inherit successful WB, never a live lane's later payload.
  def wb_service :: Handle = interface_link(Valid(RV2WideRetirement(xlen)))
  def wb_service_lane = mux(wb_accepted, wb_memory_lane, wb_long_lane)
  wb_service.left.valid <== wb_accepted ||| wb_divide_accepted
  wb_service.left.bits <== mux(wb_service_lane === bits(0, 1), retired[0].bits, retired[1].bits)
  describe_interface_selection([wb_service_lane === bits(0, 1), wb_service_lane === bits(1, 1)], ~name: "service-lane")
  describe_interface_contract(Array(wb_retirement_paths[0][1], wb_retirement_paths[1][1]), wb_service.left, "service-lane", ~trace_model: interface_trace_selection(~name: "service-lane"))
  describe_interface_contract(wb_service.right, Array(wb_load_response.allocate, wb_divide_link.left), "committed-service", ~trace_model: interface_trace_routing([wb_accepted, wb_divide_accepted]))


  /* Architectural GPR write ports.
     Fixed FP, deferred completion, and normal younger WB share the second
     port; successful same-group writes coalesce without merging retirement. */

  def wb_completion_write = wb_gpr_return.valid & wb_gpr_return.bits.write
  def wb_second_address = priority_mux(~default: wb_tokens[1].rd):
    vector.scalar_result.valid: vector.scalar_result.bits.address
    wb_fp_late_gpr.valid: wb_fp_late_gpr.bits.tag.rd
    wb_completion_write: wb_gpr_return.bits.rd
  def wb_second_data = priority_mux(~default: retired[1].bits.data):
    vector.scalar_result.valid: vector.scalar_result.bits.data
    wb_fp_late_gpr.valid: wb_fp_late_gpr.bits.integer_value
    wb_completion_write: wb_gpr_return.bits.data
  def wb_second_write = wb_completion_write ||| wb_writes[1] ||| wb_fp_late_gpr.valid ||| (vector.scalar_result.valid & vector.scalar_result.bits.address.or_reduce())
  assert(!(vector.scalar_result.valid & (wb_completion_write ||| wb_younger.egress.valid ||| wb_fp_late_gpr.valid)), "rv2wide_vector_reserved_younger_slot")
  assert(!(wb_fp_late_gpr.valid & (wb_completion_write ||| wb_younger.egress.valid)), "rv2wide_fixed_fp_reserved_younger_slot")
  assert(!(ex_multiply.completed.valid & (wb_completion.valid ||| wb_younger.egress.valid)), "rv2wide_multiply_reserved_younger_slot")
  when (ex_multiply.completed.valid):
    assert(wb_gpr_calendar.occupied[0].into(Bool), "rv2wide_multiply_booked_return")
  // Coalesce successful same-group writes, not retirement. A fault/replay/deferred
  // younger instruction must leave the older write intact; completion is not younger.
  def wb_first_write = wb_writes[0] & !(wb_writes[1] & (wb_tokens[0].rd === wb_tokens[1].rd))
  assert(!(wb_completion_write & wb_younger.egress.valid), "rv2wide_completion_reserved_younger_slot")
  assert(!(wb_first_write & wb_second_write & (wb_tokens[0].rd === wb_second_address)), "rv2wide_two_write_ports_distinct")
  when (wb_first_write):
    rr_registers[wb_tokens[0].rd] <== retired[0].bits.data
  when wb_second_write:
    rr_registers[wb_second_address] <== wb_second_data
  retired_count <== retired[0].valid.as_bits().zext(2) + retired[1].valid.as_bits().zext(2)
  wb_csrs.retire_count <== retired_count

  /* Retired locality, PAUSE, and resume state.
     Only the successful prefix advances hints and the architectural cursor;
     trap/interrupt recovery clears pending locality and takes wake priority. */

  when (wb_csrs.redirect.valid):
    wb_pending_locality <== RiscvMemoryLocality.Default
  elsewhen (retired[0].valid):
    wb_pending_locality <== mux(retired[1].valid, wb_tokens[1].locality_hint, wb_tokens[0].locality_hint)
  def wb_pause_commit = (retired[0].valid & wb_tokens[0].pause) ||| (retired[1].valid & wb_tokens[1].pause)
  when (rr_squash ||| wb_csrs.interrupt_request):
    rr_pause_cycles <== bits(0, 5)
  elsewhen wb_pause_commit:
    rr_pause_cycles <== bits(16, 5)
  elsewhen (rr_pause_cycles.or_reduce()):
    rr_pause_cycles <== rr_pause_cycles - bits(1, 5)
  when (wb_redirect.valid):
    wb_resume_pc <== wb_redirect.bits.target
    wb_pc_known <== Bool(#true)
    wb_sleeping <== Bool(#false)
  elsewhen (retired[0].valid):
    def last :: RV2WideResult(xlen) = mux(retired[1].valid, wb_tokens[1], wb_tokens[0])
    wb_resume_pc <== mux(last.branch.taken, last.branch.target, last.fetched.sequential_pc)
    wb_pc_known <== Bool(#true)
    wb_sleeping <== wb_csrs.wfi


  /* Passive architectural observations.
     Publishes the declared core contract without adding functional ports,
     retirement state, or simulator-selected policy. */

  describe_cosim_hart(RV2WideObservationContract, {"profile": profile, "fp_timing": fp_timing}, {
    "wb_tokens": wb_tokens,
    "wb_retired": vec(retired[0].valid, retired[1].valid),
    "wb_retirement": vec(retired[0].bits, retired[1].bits),
    "wb_writes": wb_writes,
    "wb_split_capture": wb_split_capture,
    "wb_vector_capture": wb_vector_capture,
    "wb_vector_lane": wb_vector_lane,
    "wb_memory_lane": wb_memory_lane,
    "wb_multiply_accepted": wb_multiply_accepted,
    "fp_valid": fp.completion.valid,
    "fp_completion": fp.completion.bits,
    "fp_load_valid": fp.load_write.valid,
    "fp_load": fp.load_write.bits,
    "wb_command": wb_command,
    "completion_fire": vec(wb_load_response.completed.fire(), ex_multiply.completed.valid, wb_divide.completed.fire(), completed.valid & !wb_vector_return.valid),
    "completion": vec(wb_load_response.completed.bits, ex_multiply.completed.bits, wb_divide.completed.bits, completed.bits)
  }, (if vector_enabled | {"csr": wb_csrs, "vector": vector, "lsu": memory_ports} | {"csr": wb_csrs}))

export:
  RV2WideCore
