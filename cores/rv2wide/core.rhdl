#lang rhodium
/* Implements two-wide feed-forward execution with WB-owned memory, CSR/trap state, and retirement. */
// SPDX-License-Identifier: Apache-2.0

import:
  "profile.rhm" open
  "bundles.rhdl" open
  "issue-window.rhdl" open
  "load-response.rhdl" open
  "long-execution.rhdl" open
  "fp.rhdl" open
  lib("cores/fp/bundles.rhdl") open
  lib("cores/fp/types.rhdl") open
  lib("cores/fp/timing.rhdl") open
  lib("cores/writeback-calendar.rhdl") open
  lib("riscv/isa/fp-profile.rhm") open
  lib("riscv/rtl/floating-point.rhdl") open
  "observation.rhdl".RV2WideObservationContract
  "../cosim-source.rhm".describe_cosim_hart
  "decode/core-ctrl.rhdl" open
  "decode/operand-ctrl.rhdl" open
  "decode/system-ctrl.rhdl" open
  "decode/long-ctrl.rhdl" open
  lib("cores/multiplier.rhdl").MultiplierRequest
  lib("cores/multiplier.rhdl").PipelinedMultiplierStages
  lib("cores/divider.rhdl").DividerRequest
  lib("cores/csr/file.rhdl").RiscvCsrFile
  lib("cores/csr/protocol.rhdl") open
  lib("cores/alu.rhdl") open
  lib("cores/branch-resolver.rhdl") open
  lib("cores/bpred/protocol.rhdl") open
  lib("cores/bpred/ras.rhdl").riscv_ras_action
  lib("cores/load-store.rhdl") open
  lib("cores/cache/operation.rhdl") open
  lib("cores/cache-prefetch.rhdl") open
  lib("cores/cache/protocol.rhdl").PhysicalMemoryReq
  lib("cores/misaligned-access.rhdl") open
  lib("riscv/isa/xlen.rhm") open
  lib("riscv/isa/trap.rhm").ExceptionCause
  lib("riscv/isa/csr.rhm").MstatusTW
  lib("riscv/model/formats.rhm") as fields
  lib("riscv/rtl/instruction-fields.rhdl") open
  lib("riscv/rtl/trap.rhdl") open
  lib("riscv/rtl/csr.rhdl") open
  lib("riscv/rtl/privilege.rhdl").PrivilegeMode
  lib("riscv/rtl/interrupt.rhdl").RiscvInterrupts
  lib("riscv/rtl/cmo.rhdl") open
  lib("rhodium/std/decode.rhdl") open
  lib("rhodium/std/scoreboard.rhdl") open
  lib("flow/main.rhdl") open

/* Resolves oldest-to-youngest candidates so a nearer unavailable producer blocks stale data. */
fun forwarded_operand(address :: Bits(5), stored :: Bits(64), producers :: List.of(Endpoint)) :: RV2WideOperand():
  def mutable value = stored
  def mutable blocked = Bool(#false)
  for (endpoint in producers):
    def producer :: Endpoint = endpoint
    def token :: RV2WideResult() = producer.bits
    def matched = producer.valid & token.write & (token.rd === address)
    value := mux(matched, token.data, value)
    blocked := mux(matched, (token.resolution.disposition =/= RV2WideDisposition.Continue) ||| !token.result_ready, blocked)
  RV2WideOperand():
    data: mux(address.or_reduce(), value, bits(0, 64))
    blocked: address.or_reduce() & blocked

/* Interlocks a younger write against every older result that may complete after WB. */
fun pending_destination(address :: Bits(5), producers :: List.of(Endpoint)) :: Bool:
  def mutable pending = Bool(#false)
  for (endpoint in producers):
    def producer :: Endpoint = endpoint
    def token :: RV2WideResult() = producer.bits
    pending := pending ||| (producer.valid & token.write & !token.result_ready & (token.rd === address))
  address.or_reduce() & pending

/* Executes RV64 integer, optional F/D, and system operations with precise WB-owned state.
   Resolution inputs qualify the corresponding live MEM token in the same cycle. */
sync_circuit RV2WideCore(profile :: RV2WideConfig = RV2WideConfig(), ~fp_timing: selected_fp_timing :: FpExecutionTiming = FpExecutionTiming()):
  input interrupts: RiscvInterrupts()
  input hart_id: Bits(64)
  input time_counter: Bits(64)
  interface instructions(Decoupled(RV2WidePacket()), ~role: consumer)
  interface resolution[2](Valid(RV2WideResolution()), ~role: consumer)
  interface memory_stage[2](Valid(RV2WideInstruction()), ~role: producer)
  interface retired[2](Valid(RV2WideRetirement()), ~role: producer)
  interface prefetch(Valid(CachePrefetchReq(64)), ~role: producer)
  interface redirect(Valid(RV2WideRedirect()), ~role: producer)
  interface fetch_flush(Pulse(), ~role: producer)
  interface instruction_invalidate(Pulse(), ~role: producer)
  interface branch_update(Valid(BranchUpdate(XLen.X64)), ~role: producer)
  interface predictor_restore(Pulse(), ~role: producer)
  interface predictor_clear(Pulse(), ~role: producer)
  interface direction_update(Valid(BhtUpdate(10)), ~role: producer)
  interface history_restore(Valid(Bits(10)), ~role: producer)
  interface memory(RV2WideMemory(), ~role: requester)
  interface split(RiscvSplitAccess(XLen.X64, Bool), ~role: requester)
  interface pipeline(RV2WidePipelineAccess(), ~role: requester)
  interface completed(Valid(RV2WideRetirement()), ~role: producer)
  output issued: Bits(2)
  output retired_count: Bits(2)
  output instruction_capacity: Bits(4)
  output sleeping: Bool
  output translation_state: RV2WideTranslationState()
  output translation_flush: Bool

  def fp_enabled = profile.floating_point == FloatingPointProfile.D
  def fp_timing = selected_fp_timing.at_least(2)
  def gpr_span = math.max(PipelinedMultiplierStages + 2, fp_timing.maximum + 2)
  def gpr_delay_width = index_width(gpr_span + 1)
  def trace_letters = ["i", "m", "a"] ++ (if fp_enabled | ["f", "d"] | []) ++ ["c", "b"]
  def trace_isa = "rv64" ++ String.join(trace_letters, "") ++ "_" ++ String.join(profile.isa_profile.isa_extensions.filter(~keep: fun (name): name.length() > 1), "_")

  inst rr_window(RV2WideIssueWindow())
  inst ex_older(ValidPipe(RV2WideExecute(), 1, ~flushable: #true))
  inst ex_younger(ValidPipe(RV2WideExecute(), 1, ~flushable: #true))
  inst mem_older(ValidPipe(RV2WideResult(), 1, ~flushable: #true))
  inst mem_younger(ValidPipe(RV2WideResult(), 1, ~flushable: #true))
  inst wb_older(ValidPipe(RV2WideResult(), 1, ~flushable: #true))
  inst wb_younger(ValidPipe(RV2WideResult(), 1, ~flushable: #true))
  def ex_pipe = [ex_older, ex_younger]
  def mem_pipe = [mem_older, mem_younger]
  def wb_pipe = [wb_older, wb_younger]
  wire wb_squash: Bool
  wire rr_squash: Bool
  def ex_paths = for List (lane in 0..2):
    def observed = ex_pipe[lane].egress |> filter_valid(_token => !rr_squash) |> trace_valid_event("core/s2.ex.slot" ++ to_string(lane), ~fields: token):
      pc: token.fetched.pc
      instruction(~format: "riscv", ~isa: trace_isa, ~pc: "pc"): token.fetched.raw_instruction
    observed |> fork_valid(4)
  def wb_paths = for List (lane in 0..2): wb_pipe[lane].egress |> fork_valid(2)
  def ex_links = for List (_ in 0..2): interface_link(Valid(RV2WideResult()))
  def mem_links = for List (_ in 0..2): interface_link(Valid(RV2WideResult()))
  def ex_results = for List (link in ex_links): link.right
  def mem_results = for List (link in mem_links): link.right
  def wb_redirect_link :: Handle = interface_link(Valid(RV2WideRedirect()))
  def wb_redirect :: Endpoint = wb_redirect_link.right
  wire mem_branch_redirect: Bool
  wire wb_drained: Bool
  inst wb_csrs(RiscvCsrFile(profile.csr_config))
  translation_state <== RV2WideTranslationState():
    privilege: wb_csrs.privilege
    mstatus: wb_csrs.mstatus
    satp: wb_csrs.satp
  translation_flush <== wb_csrs.translation_flush
  wb_csrs.interrupts <== interrupts
  wb_csrs.hart_id <== hart_id
  wb_csrs.time_counter <== time_counter
  inst fp(if fp_enabled | RV2WideFp(fp_timing, ~half_precision: profile.half_precision, ~zfa: profile.zfa) | RV2WideFpDisabled())
  fp.state_update |> wb_csrs.fp_update
  // Fixed FP and multiply share the younger RF port, booked at RR before EX launch.
  inst wb_gpr_calendar(WritebackCalendar(2, gpr_span))
  inst wb_fp_gpr_scoreboard(Scoreboard(32))
  def wb_fp_gpr = fp.completion |> filter_valid(result => (result.tag.destination === FloatDestination.Integer) & result.tag.rd.or_reduce())
  def wb_fp_late_gpr = wb_fp_gpr |> filter_valid(result => !result.tag.direct)
  wb_fp_gpr_scoreboard.clear.valid <== wb_fp_late_gpr.valid
  wb_fp_gpr_scoreboard.clear.bits <== wb_fp_late_gpr.bits.tag.rd
  wire wb_fp_variable_accepted: Bool
  wire wb_fp_fixed_authorized: Bool
  wb_csrs.vector_retire.valid <== Bool(#false)
  wb_csrs.vector_saturate.valid <== Bool(#false)
  wb_csrs.vector_fault_start.valid <== Bool(#false)
  wb_csrs.vector_fault_start.bits <== dont_care(Bits(64))
  wb_csrs.vector_truncate.valid <== Bool(#false)
  wb_csrs.vector_truncate.bits <== dont_care(Bits(64))
  reg wb_sleeping(~init: Bool(#false))
  reg wb_resume_pc(~init: bits(0, 64))
  reg wb_pc_known(~init: Bool(#false))
  wire wb_reservation_waiting: Bool
  sleeping <== wb_sleeping ||| wb_reservation_waiting
  inst wb_load_response(RV2WideLoadResponse())
  reg wb_ordered_memory_pending(~init: Bool(#false))
  inst ex_multiply(RV2WideMultiply())
  inst wb_divide(RV2WideDivide())
  inst rr_completions(RRArbiter(RV2WideRetirement(), 2))
  inst wb_scoreboard(Scoreboard(32))
  wire wb_management_response: Bool
  def Array(wb_ordinary_response, wb_management_return) = memory.response |> demux_flow(2, _data => wb_management_response)
  wb_ordinary_response |> wb_load_response.response
  def wb_management_completed = wb_management_return |> to_valid()
  wb_load_response.fp_completed |> fp.load_return
  // A deferred result reserves the younger issue slot and travels alongside RR
  // work to its WB write port. Committed responses never take speculative flush.
  for (source in [wb_load_response.completed, wb_divide.completed], index in 0..2):
    source |> rr_completions.ingress[index]
  def rr_completion :: Endpoint = rr_completions.egress |> gate_flow(!wb_gpr_calendar.occupied[3].into(Bool)) |> to_valid()
  reg rr_completion_age(~init: bits(0, 3))
  when (!rr_completions.egress.valid ||| rr_completions.egress.fire()):
    rr_completion_age <== bits(0, 3)
  elsewhen (!rr_completion_age.and_reduce()):
    rr_completion_age <== rr_completion_age + bits(1, 3)
  wb_gpr_calendar.pause <== rr_completion_age.and_reduce()
  inst ex_completion_pipe(ValidPipe(RV2WideRetirement(), 1))
  inst mem_completion_pipe(ValidPipe(RV2WideRetirement(), 1))
  inst wb_completion_pipe(ValidPipe(RV2WideRetirement(), 1))
  rr_completion |> ex_completion_pipe.ingress
  ex_completion_pipe.egress |> mem_completion_pipe.ingress
  mem_completion_pipe.egress |> wb_completion_pipe.ingress
  def wb_completion :: Endpoint = wb_completion_pipe.egress
  def wb_gpr_return = Array(wb_completion, ex_multiply.completed) |> valid_arbiter()
  def rr_returns = [wb_gpr_return, mem_completion_pipe.egress, ex_completion_pipe.egress, rr_completion]
  reg wb_completion_count(~init: bits(0, 2))
  when (rr_completion.valid ^ wb_completion.valid):
    wb_completion_count <== mux(rr_completion.valid, wb_completion_count + bits(1, 2), wb_completion_count - bits(1, 2))
  def wb_fp_return = wb_fp_late_gpr |> map_valid(result => RV2WideRetirement()):
    fetched: result.tag.fetched
    rd: result.tag.rd
    write: Bool(#true)
    data: result.integer_value
    deferred: Bool(#false)
  (Array(wb_gpr_return, wb_fp_return) |> valid_arbiter() |> trace_valid_event("core/s4.wb.deferred", ~fields: result):
    pc: result.fetched.pc
    instruction(~format: "riscv", ~isa: trace_isa, ~pc: "pc"): result.fetched.raw_instruction
    rd: result.rd
  ) |> completed
  wb_scoreboard.clear.valid <== wb_gpr_return.valid & wb_gpr_return.bits.write
  wb_scoreboard.clear.bits <== wb_gpr_return.bits.rd
  reg rr_registers(~init: vec(for List (_ in 0..32): bits(0, 64)))
  instructions |> rr_window.ingress
  instruction_capacity <== rr_window.available
  rr_window.clear.valid <== rr_squash

  // RR: the issue window, not independent lane readiness, owns instruction age.
  def rr_head :: RV2WidePacket() = rr_window.head
  def rr_decode = ValidDecodeGen(rv2wide_control_cases(profile.floating_point, ~half_precision: profile.half_precision, ~zfa: profile.zfa, ~zicboz: profile.zicboz, ~zicbom: profile.zicbom, ~zicbop: profile.zicbop, ~zawrs: profile.zawrs, ~zihintpause: profile.zihintpause))
  def rr_decoded :: Vec(2, DecodeResult(RV2WideControl())) = vec(for List (lane in 0..2): rr_decode(rr_head.entries[lane].instruction))
  def rr_controls :: Vec(2, RV2WideControl()) = vec(for List (lane in 0..2): rr_decoded[lane].value)
  // At most one memory instruction issues per group; the older CMO owns the
  // shared permission probe. A retained younger candidate is probed again.
  def rr_cbo_older_access :: CacheOperation = rr_controls[0].memory.access
  def rr_cbo_lane = mux(rr_controls[0].memory.enable & rr_cbo_older_access.is_cache_management(), bits(0, 1), bits(1, 1))
  wb_csrs.cbo_operation <== mux_lookup(rr_controls[rr_cbo_lane].memory.access, ~default: CboManagementOperation.Clean):
    CacheOperation.CacheBlockInvalidate: CboManagementOperation.Invalidate
    CacheOperation.CacheBlockFlush: CboManagementOperation.Flush
  def rr_rounding :: Vec(2, RiscvRoundingMode()) = vec(for List (lane in 0..2): riscv_rounding_mode(rr_head.entries[lane].instruction[12..15], wb_csrs.frm))
  def rr_fp_illegal = for List (lane in 0..2): rr_controls[lane].fp.valid & (!wb_csrs.fp_enabled ||| (rr_controls[lane].fp.bits.execution.uses_rounding_mode & !rr_rounding[lane].valid))
  def rr_cbo_illegal = for List (lane in 0..2):
    def access :: CacheOperation = rr_controls[lane].memory.access
    rr_controls[lane].memory.enable & ((access.is_cache_block_zero() & (wb_csrs.cbo_zero_access =/= CboAccess.Allowed)) ||| (access.is_cache_management() & (wb_csrs.cbo_permission.access =/= CboAccess.Allowed)))
  def rr_decodable :: Vec(2, Bool) = vec(for List (lane in 0..2): rr_decoded[lane].valid & !rr_head.entries[lane].fault.valid & !rr_head.entries[lane].compressed_illegal & !rr_fp_illegal[lane] & !rr_cbo_illegal[lane])
  def rr_rs1 :: Vec(2, Bits(5)) = vec(for List (lane in 0..2): instruction_field(fields.rs1, rr_head.entries[lane].instruction))
  def rr_rs2 :: Vec(2, Bits(5)) = vec(for List (lane in 0..2): instruction_field(fields.rs2, rr_head.entries[lane].instruction))
  def rr_rd :: Vec(2, Bits(5)) = vec(for List (lane in 0..2): instruction_field(fields.rd, rr_head.entries[lane].instruction))
  def rr_wb_producers = for List (lane in 0..2):
    def returned = wb_fp_gpr.valid & wb_fp_gpr.bits.tag.direct & (wb_fp_gpr.bits.tag.lane === bits(lane, 1))
    wb_pipe[lane].egress |> map_valid(token => token.updated(~data: mux(returned, wb_fp_gpr.bits.integer_value, token.data), ~result_ready: token.result_ready ||| returned))
  def rr_producers = [rr_wb_producers[0], rr_wb_producers[1], mem_results[0], mem_results[1], ex_results[0], ex_results[1]]
  def rr_fp_lane = mux(rr_controls[0].fp.valid, bits(0, 1), bits(1, 1))
  def rr_fp_control :: FloatingPointControl() = rr_controls[rr_fp_lane].fp.bits
  fp.read_addresses <== vec(rr_rs1[rr_fp_lane], rr_rs2[rr_fp_lane], rr_head.entries[rr_fp_lane].instruction[27..32])
  fp.probe <== rr_fp_control.execution
  wb_gpr_calendar.probe_client <== bits(0, 1)
  wb_gpr_calendar.probe_delay <== fp_timing.latency(rr_fp_control.execution, ~width: gpr_delay_width) + bits(1, gpr_delay_width)
  // Probe registered bookings only. Same-group collisions are checked separately,
  // keeping admission independent of either client's packed reserve handshake.
  def rr_fp_gpr_available = !wb_gpr_calendar.pause & !(wb_gpr_calendar.occupied & (bits(1, gpr_span) << wb_gpr_calendar.probe_delay)).or_reduce()
  /* Pre-WB producers bridge the architectural scoreboard; both FPR write ports forward. */
  fun rr_fp_busy(address :: Bits(5)) :: Bool:
    def mutable pending = (fp.busy & (bits(1, 32) << address)).or_reduce()
    for (endpoint in rr_producers):
      def producer :: Endpoint = endpoint
      def token :: RV2WideResult() = producer.bits
      pending := pending ||| (producer.valid & token.fp.valid & (token.fp.bits.registers.destination === FloatDestination.FloatingPoint) & (token.rd === address))
    def returned = (fp.completion.valid & (fp.completion.bits.tag.destination === FloatDestination.FloatingPoint) & (fp.completion.bits.tag.rd === address)) ||| (fp.load_write.valid & (fp.load_write.bits.owner.rd === address))
    pending & !returned
  def rr_fp_fixed :: Vec(2, Bool) = vec(for List (lane in 0..2): rr_controls[lane].fp.valid & !rr_controls[lane].fp.bits.execution.unit.is_one_of(FloatUnit.Memory, FloatUnit.DivideSquareRoot))
  def rr_fp_late_gpr :: Vec(2, Bool) = vec(for List (lane in 0..2): rr_fp_fixed[lane] & (rr_controls[lane].fp.bits.registers.destination === FloatDestination.Integer) & rr_rd[lane].or_reduce() & (fp_timing.latency(rr_controls[lane].fp.bits.execution) > bits(2, fp_timing.width)))
  // An older MEM divide owns next cycle's shared request input at WB.
  def rr_fp_wb_reserved = (mem_older.egress.valid & mem_older.egress.bits.fp.valid & (mem_older.egress.bits.fp.bits.execution.unit === FloatUnit.DivideSquareRoot)) ||| (mem_younger.egress.valid & mem_younger.egress.bits.fp.valid & (mem_younger.egress.bits.fp.bits.execution.unit === FloatUnit.DivideSquareRoot))
  def rr_fp_data_blocked = for List (lane in 0..2):
    def control :: FloatingPointControl() = rr_controls[lane].fp.bits
    rr_controls[lane].fp.valid & ((control.registers.uses_frs1 & rr_fp_busy(rr_rs1[lane])) ||| (control.registers.uses_frs2 & rr_fp_busy(rr_rs2[lane])) ||| (control.registers.uses_frs3 & rr_fp_busy(rr_head.entries[lane].instruction[27..32])) ||| ((control.registers.destination === FloatDestination.FloatingPoint) & rr_fp_busy(rr_rd[lane])))
  def rr_fp_structural_blocked = for List (lane in 0..2): rr_decodable[lane] & rr_fp_fixed[lane] & (!fp.available ||| rr_fp_wb_reserved ||| (rr_fp_late_gpr[lane] & !rr_fp_gpr_available))
  /* Deferred returns forward at RR admission and again at the reserved write edge. */
  fun rr_stored(address :: Bits(5)) :: Bits(64):
    def mutable value = mux(wb_fp_late_gpr.valid & (wb_fp_late_gpr.bits.tag.rd === address), wb_fp_late_gpr.bits.integer_value, rr_registers[address])
    for (endpoint in rr_returns):
      def source :: Endpoint = endpoint
      def returned :: RV2WideRetirement() = source.bits
      value := mux(source.valid & returned.write & (returned.rd === address), returned.data, value)
    value
  /* Completion frees the registered reservation for same-cycle reads and younger writes. */
  fun rr_busy(address :: Bits(5)) :: Bool:
    address.or_reduce() & ((scoreboard_busy(32, wb_scoreboard.busy, address) & !(wb_gpr_return.valid & wb_gpr_return.bits.write & (wb_gpr_return.bits.rd === address))) ||| (scoreboard_busy(32, wb_fp_gpr_scoreboard.busy, address) & !(wb_fp_late_gpr.valid & (wb_fp_late_gpr.bits.tag.rd === address))))
  /* A returned value satisfies reads immediately; younger writes still wait for its RF update. */
  fun rr_source_busy(address :: Bits(5)) :: Bool:
    def mutable returned = Bool(#false)
    for (endpoint in rr_returns):
      def source :: Endpoint = endpoint
      def owner :: RV2WideRetirement() = source.bits
      returned := returned ||| (source.valid & owner.write & (owner.rd === address))
    rr_busy(address) & !returned
  def rr_left :: Vec(2, RV2WideOperand()) = vec(for List (lane in 0..2): forwarded_operand(rr_rs1[lane], rr_stored(rr_rs1[lane]), rr_producers))
  def rr_right :: Vec(2, RV2WideOperand()) = vec(for List (lane in 0..2): forwarded_operand(rr_rs2[lane], rr_stored(rr_rs2[lane]), rr_producers))
  def rr_older_write = rr_decodable[0] & rr_controls[0].writeback.enable & rr_rd[0].or_reduce()
  def rr_long = for List (lane in 0..2): rr_controls[lane].muldiv.service =/= RV2WideLongOperation.None
  def rr_multiply = for List (lane in 0..2): rr_decodable[lane] & (rr_controls[lane].muldiv.service === RV2WideLongOperation.Multiply) & rr_rd[lane].or_reduce()
  def rr_multiply_available = !wb_gpr_calendar.pause & !wb_gpr_calendar.occupied[PipelinedMultiplierStages + 1].into(Bool)
  // Two independent fixed operations may pair unless their numerical returns coincide.
  def rr_pair_fixed_collision = ((rr_multiply[0] & rr_fp_late_gpr[1]) ||| (rr_fp_late_gpr[0] & rr_multiply[1])) & (wb_gpr_calendar.probe_delay === bits(PipelinedMultiplierStages + 1, gpr_delay_width))
  // Normal WB writes precede every younger write; a deferred older writer may return later.
  def rr_older_deferred = rr_controls[0].memory.enable ||| rr_long[0] ||| rr_fp_late_gpr[0]
  def rr_pair_waw = rr_older_write & rr_older_deferred & rr_controls[1].writeback.enable & (rr_rd[0] === rr_rd[1])
  def rr_pair_branch = rr_controls[0].branch.resolver.enable & rr_controls[1].branch.resolver.enable
  def rr_pair_memory = rr_controls[0].memory.enable & rr_controls[1].memory.enable
  def rr_variable_fp = for List (lane in 0..2): rr_controls[lane].fp.valid & (rr_controls[lane].fp.bits.execution.unit === FloatUnit.DivideSquareRoot)
  def rr_pair_deferred = (rr_variable_fp[0] & (rr_long[1] ||| rr_controls[1].memory.enable)) ||| (rr_variable_fp[1] & (rr_long[0] ||| rr_controls[0].memory.enable)) ||| (rr_long[0] & (rr_long[1] ||| rr_controls[1].memory.enable)) ||| (rr_long[1] & rr_controls[0].memory.enable)
  def rr_system = for List (lane in 0..2):
    def system :: RV2WideSystemControl() = rr_controls[lane].system
    rr_decodable[lane] & system.serializing()
  def rr_pair_alu = rr_older_write & !rr_older_deferred & !rr_controls[0].fp.valid & !rr_system[0] & !rr_controls[0].branch.resolver.enable
  // The older ALU result is the entire zero-offset address: no second dependent adder.
  def rr_pair_address = rr_pair_alu & rr_decodable[1] & !rr_controls[1].fp.valid & rr_controls[1].memory.enable & (rr_controls[1].memory.access === CacheOperation.Load) & (rr_rd[0] === rr_rs1[1]) & (rr_head.entries[1].instruction[20..32] === bits(0, 12))
  // Store data bypasses independently of address calculation and immediate offset.
  def rr_pair_store_data = rr_pair_alu & rr_decodable[1] & !rr_controls[1].fp.valid & rr_controls[1].memory.enable & (rr_controls[1].memory.access === CacheOperation.Store) & (rr_rd[0] === rr_rs2[1])
  def rr_pair_raw = rr_older_write & ((rr_controls[1].operand.uses_rs1 & (rr_rd[0] === rr_rs1[1]) & !rr_pair_address) ||| (rr_controls[1].operand.uses_rs2 & (rr_rd[0] === rr_rs2[1]) & !rr_pair_store_data))
  def rr_data_blocked = for List (lane in 0..2):
    rr_decodable[lane] & (rr_fp_data_blocked[lane] ||| (rr_controls[lane].operand.uses_rs1 & !(Bool(lane == 1) & rr_pair_address) & (rr_left[lane].blocked ||| rr_source_busy(rr_rs1[lane]))) ||| (rr_controls[lane].operand.uses_rs2 & !(Bool(lane == 1) & rr_pair_store_data) & (rr_right[lane].blocked ||| rr_source_busy(rr_rs2[lane]))) ||| (rr_controls[lane].writeback.enable & (rr_busy(rr_rd[lane]) ||| pending_destination(rr_rd[lane], rr_producers))))
  def rr_multiply_capacity = for List (lane in 0..2): rr_multiply[lane] & !rr_multiply_available
  def rr_blocked = for List (lane in 0..2): rr_data_blocked[lane] ||| rr_multiply_capacity[lane] ||| rr_fp_structural_blocked[lane]
  def rr_pipeline_empty = !(ex_older.egress.valid ||| ex_younger.egress.valid ||| mem_older.egress.valid ||| mem_younger.egress.valid ||| wb_older.egress.valid ||| wb_younger.egress.valid)
  // Atomics and CBO.ZERO drain older memory before issue and hold younger
  // memory through completion. All aq/rl combinations use this stronger order.
  def rr_memory_in_pipeline = (ex_older.egress.valid & ex_older.egress.bits.control.memory.enable) ||| (ex_younger.egress.valid & ex_younger.egress.bits.control.memory.enable) ||| (mem_older.egress.valid & mem_older.egress.bits.memory.enable) ||| (mem_younger.egress.valid & mem_younger.egress.bits.memory.enable) ||| (wb_older.egress.valid & wb_older.egress.bits.memory.enable) ||| (wb_younger.egress.valid & wb_younger.egress.bits.memory.enable)
  def rr_ordered_memory_ready = !rr_memory_in_pipeline & memory.drained & wb_load_response.drained & !wb_ordered_memory_pending
  def rr_ordered_memory = for List (lane in 0..2): rr_decodable[lane] & rr_controls[lane].memory.enable & !rr_controls[lane].memory.access.is_one_of(CacheOperation.Load, CacheOperation.Store)
  // A PAUSE may follow an older peer, but no younger issue crosses it. Its
  // post-retirement cooldown never blocks accepted service completions.
  reg rr_pause_cycles(~init: bits(0, 5))
  def rr_pause_lanes = for List (lane in 0..2):
    (ex_pipe[lane].egress.valid & ex_pipe[lane].egress.bits.control.pause) ||| (mem_pipe[lane].egress.valid & mem_pipe[lane].egress.bits.pause) ||| (wb_pipe[lane].egress.valid & wb_pipe[lane].egress.bits.pause)
  def rr_pause_blocked = vec(rr_pause_lanes).or_reduce() ||| rr_pause_cycles.or_reduce()
  def rr_structural_blocked = for List (lane in 0..2): rr_multiply_capacity[lane] ||| rr_fp_structural_blocked[lane] ||| (rr_system[lane] & !(rr_pipeline_empty & wb_drained)) ||| (rr_ordered_memory[lane] & !rr_ordered_memory_ready)
  def rr_first = (rr_head.count =/= bits(0, 2)) & !rr_blocked[0] & !rr_squash & !rr_pause_blocked & (!rr_system[0] ||| (rr_pipeline_empty & wb_drained)) & (!rr_ordered_memory[0] ||| rr_ordered_memory_ready)
  def rr_second = rr_first & (rr_head.count === bits(2, 2)) & !rr_blocked[1] & rr_decodable[0] & !rr_controls[0].pause & !rr_system[0] & !rr_system[1] & (!rr_ordered_memory[1] ||| rr_ordered_memory_ready) & (rr_head.entries[1].fault.valid ||| (rr_decodable[1] & !rr_pair_raw & !rr_pair_waw & !rr_pair_branch & !rr_pair_memory & !rr_pair_deferred & !rr_pair_fixed_collision & !(rr_controls[0].fp.valid & rr_controls[1].fp.valid))) & !(rr_completion.valid & rr_completion.bits.write) & !wb_gpr_calendar.occupied[3].into(Bool)
  issued <== rr_first.as_bits().zext(2) + rr_second.as_bits().zext(2)
  rr_window.consume <== issued
  def rr_fp_admitted = mux(rr_fp_lane === bits(0, 1), rr_first, rr_second) & rr_decodable[rr_fp_lane] & rr_fp_fixed[rr_fp_lane]
  fp.book.valid <== rr_fp_admitted
  fp.book.bits <== rr_fp_control.execution
  wb_gpr_calendar.reserve[0].valid <== rr_fp_admitted & rr_fp_late_gpr[rr_fp_lane]
  wb_gpr_calendar.reserve[0].bits <== wb_gpr_calendar.probe_delay
  when (wb_gpr_calendar.reserve[0].valid):
    assert(wb_gpr_calendar.reserve[0].ready, "rv2wide_fp_booked_gpr_writeback")
  wb_gpr_calendar.reserve[1].valid <== (rr_first & rr_multiply[0]) ||| (rr_second & rr_multiply[1])
  wb_gpr_calendar.reserve[1].bits <== bits(PipelinedMultiplierStages + 1, gpr_delay_width)
  when (wb_gpr_calendar.reserve[1].valid):
    assert(wb_gpr_calendar.reserve[1].ready, "rv2wide_multiply_booked_writeback")
  def rr_fp_request = FpExecutionRequest(XLen.X64, FloatingPointProfile.D, RV2WideFpOwner()):
    tag:
      RV2WideFpOwner():
        fetched: rr_head.entries[rr_fp_lane]
        lane: rr_fp_lane
        rd: rr_rd[rr_fp_lane]
        destination: rr_fp_control.registers.destination
        speculative: rr_fp_fixed[rr_fp_lane]
        direct: fp_timing.latency(rr_fp_control.execution) === bits(2, fp_timing.width)
    control: rr_fp_control
    left: fp.read_values[0]
    right: fp.read_values[1]
    third: fp.read_values[2]
    left_precision: rr_fp_control.execution.source_precision
    right_precision: rr_fp_control.execution.source_precision
    third_precision: rr_fp_control.execution.source_precision
    integer_operand: rr_left[rr_fp_lane].data
    immediate_index: rr_rs1[rr_fp_lane]
    rounding_mode: mux(rr_fp_lane === bits(0, 1), rr_rounding[0].mode, rr_rounding[1].mode)
  for (lane in 0..2):
    def ex_ingress :: Endpoint = ex_pipe[lane].ingress
    def rr_access :: CacheOperation = rr_controls[lane].memory.access
    ex_pipe[lane].flush <== rr_squash
    // Younger offers inherit the older offer's blockers, not a generic age hazard.
    def data_hazard = rr_data_blocked[lane] ||| (if lane == 0 | Bool(#false) | rr_data_blocked[0] ||| (rr_decodable[0] & rr_decodable[1] & (rr_pair_raw ||| rr_pair_waw)))
    def structural_hazard = rr_structural_blocked[lane] ||| (if lane == 0 | Bool(#false) | rr_structural_blocked[0] ||| rr_system[0] ||| rr_system[1] ||| !rr_decodable[0] ||| (!rr_head.entries[1].fault.valid & !rr_decodable[1]) ||| (rr_decodable[0] & rr_decodable[1] & (rr_pair_branch ||| rr_pair_memory ||| rr_pair_deferred ||| rr_pair_fixed_collision ||| (rr_controls[0].fp.valid & rr_controls[1].fp.valid))) ||| (rr_completion.valid & rr_completion.bits.write) ||| wb_gpr_calendar.occupied[3].into(Bool))
    def offer :: Handle = interface_link(Decoupled(RV2WideInstruction()))
    offer.left.valid <== rr_window.candidates[lane].valid
    offer.left.bits <== rr_window.candidates[lane].bits
    describe_interface_contract(rr_window.candidates[lane], offer.left, "issue-offer-" ++ to_string(lane), ~trace_model: interface_trace_combinational())
    def rr_observed = offer.right |> trace_event("core/s1.rr.slot" ++ to_string(lane), ~stalls: #true, ~fields: fetched):
      pc: fetched.pc
      instruction(~format: "riscv", ~isa: trace_isa, ~pc: "pc"): fetched.raw_instruction
      data_hazard: data_hazard
      structural_hazard: structural_hazard ||| rr_pause_blocked ||| (Bool(lane == 1) & rr_decodable[0] & rr_controls[0].pause)
    (rr_observed |> gate_flow(if lane == 0 | rr_first | rr_second) |> to_valid() |> map_valid(fetched => RV2WideExecute()):
      fetched: fetched
      control: rr_controls[lane].updated(~memory: rr_controls[lane].memory.updated(~access: mux(rr_access.is_cache_management() & (wb_csrs.cbo_permission.operation === CboManagementOperation.Flush), CacheOperation.CacheBlockFlush, rr_access)))
      rs1: rr_left[lane].data
      rs2: rr_right[lane].data
      address_from_older: Bool(lane == 1) & rr_pair_address
      store_data_from_older: Bool(lane == 1) & rr_pair_store_data
      rd: rr_rd[lane]
      illegal: !rr_decoded[lane].valid ||| fetched.compressed_illegal ||| rr_fp_illegal[lane] ||| rr_cbo_illegal[lane]
      fp_request: rr_fp_request
    ) |> ex_ingress

  // EX: two common ALUs and one steered common branch resolver.
  def ex_tokens :: Vec(2, RV2WideExecute()) = vec(for List (lane in 0..2): ex_pipe[lane].egress.bits)
  def ex_branch_lane = mux(ex_older.egress.valid & !ex_tokens[0].illegal & !ex_tokens[0].fetched.fault.valid & ex_tokens[0].control.branch.resolver.enable, bits(0, 1), bits(1, 1))
  def ex_branch :: RV2WideExecute() = ex_tokens[ex_branch_lane]
  inst ex_resolver(BranchResolver(64))
  inst ex_alu_older(ALU(XLen.X64))
  inst ex_alu_younger(ALU(XLen.X64))
  def ex_alus = [ex_alu_older, ex_alu_younger]
  ex_resolver.request.valid <== (ex_older.egress.valid ||| ex_younger.egress.valid) & !rr_squash
  ex_resolver.request.bits <== BranchResolverRequest(64):
    left: ex_branch.rs1
    right: ex_branch.rs2
    control: ex_branch.control.branch.resolver
  for (lane in 0..2):
    def ex :: RV2WideExecute() = ex_tokens[lane]
    def ex_input :: Endpoint = ex_paths[lane][0]
    def ex_output :: Endpoint = ex_links[lane].left
    def ex_alu = ex_alus[lane]
    def ex_executable = !ex.illegal & !ex.fetched.fault.valid
    def ex_system :: RV2WideSystemControl() = ex.control.system
    def ex_immediate = ex.control.operand.immediate.decode(ex.fetched.instruction)
    ex_alu.left <== mux_lookup(ex.control.operand.left, ~default: ex.rs1):
      RV2WideLeft.Pc: ex.fetched.pc
      RV2WideLeft.Zero: bits(0, 64)
    ex_alu.right <== mux(ex.control.operand.right_immediate, ex_immediate, ex.rs2)
    ex_alu.control <== ex.control.alu
    def ex_address = if lane == 1 | mux(ex.address_from_older, ex_alu_older.result, ex_alu.result) | ex_alu.result
    def ex_target_sum = mux(ex.control.branch.target_from_rs1, ex.rs1, ex.fetched.pc) + ex_immediate
    def ex_target = mux(ex.control.branch.target_from_rs1, ex_target_sum & !bits(1, 64), ex_target_sum)
    def ex_taken = ex_executable & ex.control.branch.resolver.enable & (ex_branch_lane === bits(lane, 1)) & ex_resolver.result.bits.taken
    def ex_actual_action = mux(ex_executable & ex.control.branch.resolver.enable, riscv_ras_action(ex.fetched.instruction), RasAction.None)
    def ex_next_pc = mux(ex_taken, ex_target, ex.fetched.sequential_pc)
    def ex_predicted_pc = mux(ex.fetched.prediction.valid, ex.fetched.prediction.target, ex.fetched.sequential_pc)
    def ex_bad_pc = ex.fetched.pc[0].into(Bool)
    def ex_bad_target = ex_taken & ex_target[0].into(Bool)
    def ex_memory = ex_executable & ex.control.memory.enable
    def ex_bad_address = ex_memory & ex.control.memory.access.is_one_of(CacheOperation.LoadReserved, CacheOperation.StoreConditional, CacheOperation.Atomic) & !ex.control.memory.width.is_aligned(ex_address)
    def ex_fault = ex.fetched.fault.valid ||| ex.illegal ||| ex_bad_pc ||| ex_bad_target ||| ex_bad_address
    ex_output.valid <== ex_input.valid & !rr_squash
    ex_output.bits <== RV2WideResult():
      fetched: ex.fetched
      rd: ex.rd
      write: ex_executable & ex.control.writeback.enable & ex.rd.or_reduce()
      data: mux(ex.control.writeback.link, ex.fetched.sequential_pc, ex_alu.result)
      result_ready: !(ex_memory & ex.control.memory.access.returns_result()) & !ex_system.serializing() & ((ex.control.muldiv.service === RV2WideLongOperation.None) ||| !ex.rd.or_reduce()) & !ex.control.fp.valid
      taken: ex_taken
      target: ex_target
      mispredicted: (ex_next_pc =/= ex_predicted_pc) ||| (ex.fetched.direction.valid & (ex.fetched.direction.taken ^ ex_taken)) ||| (Bool(profile.ras_entries > 0) & (ex_actual_action =/= ex.fetched.speculated_ras_action))
      branch_update:
        BranchUpdate(XLen.X64):
          pc: ex.fetched.pc
          target: ex_target
          branch: ex_executable & ex.control.branch.resolver.enable
          conditional: ex.fetched.instruction[0..7] === bits(0x63, 7)
          taken: ex_taken
          compressed: ex.fetched.sequential_pc === (ex.fetched.pc + bits(2, 64))
          ras_action: ex_actual_action
          predicted_ras_action: ex.fetched.speculated_ras_action
          return_address: ex.fetched.sequential_pc
      memory: ex.control.memory.updated(~enable: ex_memory)
      prefetch: ex.control.prefetch
      pause: ex.control.pause
      address: ex_address
      store_data: mux(ex.control.fp.valid, ex.fp_request.right, mux(ex.store_data_from_older, ex_alu_older.result, ex.rs2))
      cache_outcome: RV2WideCacheOutcome.Slow
      system: ex.control.system
      csr_source: mux(ex.control.system.immediate, instruction_field(fields.rs1, ex.fetched.instruction).zext(64), ex.rs1)
      muldiv: ex.control.muldiv
      left: ex.rs1
      right: ex.rs2
      fp: ex.control.fp
      fp_request: ex.fp_request
      resolution:
        RV2WideResolution():
          disposition: mux(ex_fault, RV2WideDisposition.Fault, RV2WideDisposition.Continue)
          cause: mux(ex.fetched.fault.valid, ex.fetched.fault.cause, mux(ex_bad_pc ||| ex_bad_target, exception_cause_bits(ExceptionCause.InstructionAddressMisaligned, 64), mux(ex_bad_address, mux(ex.control.memory.access.store_fault_class(), exception_cause_bits(ExceptionCause.StoreAddressMisaligned, 64), exception_cause_bits(ExceptionCause.LoadAddressMisaligned, 64)), exception_cause_bits(ExceptionCause.IllegalInstruction, 64))))
          value: mux(ex.fetched.fault.valid, ex.fetched.fault.value, mux(ex_bad_pc, ex.fetched.pc, mux(ex_bad_target, ex_target, mux(ex_bad_address, ex_address, ex.fetched.raw_instruction.zext(64)))))
    describe_interface_contract(ex_input, ex_output, "integer-execution-" ++ to_string(lane), ~trace_model: interface_trace_combinational())
    ex_results[lane] |> mem_pipe[lane].ingress
    mem_pipe[lane].flush <== rr_squash

  def ex_fp_lane = ex_tokens[0].fp_request.tag.lane
  def ex_fp :: RV2WideExecute() = ex_tokens[ex_fp_lane]
  def ex_fp_link :: Handle = interface_link(Valid(RV2WideExecute()))
  ex_fp_link.left.valid <== mux(ex_fp_lane === bits(0, 1), ex_older.egress.valid, ex_younger.egress.valid) & !rr_squash
  ex_fp_link.left.bits <== ex_fp
  describe_interface_selection([ex_fp_lane === bits(0, 1), ex_fp_lane === bits(1, 1)], ~name: "fp")
  describe_interface_contract(Array(ex_paths[0][3], ex_paths[1][3]), ex_fp_link.left, "fp-lane", ~trace_model: interface_trace_selection(~name: "fp"))
  ex_fp_link.right |> filter_valid(operation => !operation.illegal & !operation.fetched.fault.valid & !operation.fetched.pc[0].into(Bool) & operation.control.fp.valid & !operation.control.fp.bits.execution.unit.is_one_of(FloatUnit.Memory, FloatUnit.DivideSquareRoot))
    |> map_valid(operation => operation.fp_request) |> fp.fixed_issue
  def ex_memory_lane = mux(ex_older.egress.valid & !ex_tokens[0].illegal & !ex_tokens[0].fetched.fault.valid & ex_tokens[0].control.memory.enable, bits(0, 1), bits(1, 1))
  def ex_result_tokens :: Vec(2, RV2WideResult()) = vec(
    for List (lane in 0..2):
      def result :: Endpoint = ex_results[lane]
      result.bits
  )
  def ex_lookup :: RV2WideResult() = ex_result_tokens[ex_memory_lane]
  def ex_multiply_lane = mux(ex_older.egress.valid & (ex_tokens[0].control.muldiv.service === RV2WideLongOperation.Multiply), bits(0, 1), bits(1, 1))
  def ex_multiply_link :: Handle = interface_link(Valid(RV2WideExecute()))
  ex_multiply_link.left.valid <== mux(ex_multiply_lane === bits(0, 1), ex_older.egress.valid, ex_younger.egress.valid)
  ex_multiply_link.left.bits <== ex_tokens[ex_multiply_lane]
  describe_interface_selection([ex_multiply_lane === bits(0, 1), ex_multiply_lane === bits(1, 1)], ~name: "multiply")
  describe_interface_contract(Array(ex_paths[0][1], ex_paths[1][1]), ex_multiply_link.left, "multiply-lane", ~trace_model: interface_trace_selection(~name: "multiply"))
  (ex_multiply_link.right |> filter_valid(operation => !rr_squash & !operation.illegal & !operation.fetched.fault.valid & !operation.fetched.pc[0].into(Bool) & operation.rd.or_reduce() & (operation.control.muldiv.service === RV2WideLongOperation.Multiply))
    |> map_valid(operation):
      def request = MultiplierRequest(64):
        left: operation.rs1
        right: operation.rs2
        mode: operation.control.muldiv.multiply.mode
      def owner = RV2WideRetirement():
        fetched: operation.fetched
        rd: operation.rd
        write: Bool(#true)
        data: dont_care(Bits(64))
        deferred: Bool(#false)
      RV2WideMultiplyIssue():
        request: request
        control: operation.control.muldiv.multiply
        owner: owner
  ) |> ex_multiply.issue
  inst ex_store(StoreGen(XLen.X64))
  ex_store.address <== ex_lookup.address
  ex_store.value <== ex_lookup.store_data
  ex_store.width <== ex_lookup.memory.width
  pipeline.request.valid <== (mux(ex_memory_lane === bits(0, 1), ex_older.egress.valid, ex_younger.egress.valid)) & ex_lookup.memory.enable & (ex_lookup.resolution.disposition === RV2WideDisposition.Continue) & !rr_squash
  pipeline.request.bits <== RV2WideMemoryReq():
    address: ex_lookup.address
    access: ex_lookup.memory.access
    atomic: ex_lookup.memory.atomic
    width: ex_lookup.memory.width
    data: mux(ex_lookup.memory.access.is_store(), ex_store.data, ex_lookup.store_data)
    mask: ex_store.mask.as_bits()
  describe_interface_selection([ex_memory_lane === bits(0, 1), ex_memory_lane === bits(1, 1)], ~name: "lookup")
  describe_interface_contract(Array(ex_paths[0][2], ex_paths[1][2]), pipeline.request, "lookup-lane", ~trace_model: interface_trace_selection(~name: "lookup"))

  // MEM: retain the earlier fault ahead of an externally supplied resolution.
  def mem_memory_lane = mux(mem_older.egress.valid & mem_older.egress.bits.memory.enable, bits(0, 1), bits(1, 1))
  def mem_memory :: RV2WideResult() = mux(mem_memory_lane === bits(0, 1), mem_older.egress.bits, mem_younger.egress.bits)
  inst mem_load(LoadGen(XLen.X64))
  mem_load.address <== mem_memory.address
  mem_load.width <== mem_memory.memory.width
  mem_load.unsigned_load <== mem_memory.memory.unsigned
  mem_load.data <== pipeline.response.bits.data
  wire mem_resolved: Vec(2, RV2WideResult())
  for (lane in 0..2):
    def Array(mem_input, mem_context) = mem_pipe[lane].egress |> fork_valid(2)
    def mem_output :: Endpoint = mem_links[lane].left
    def mem :: RV2WideResult() = mem_pipe[lane].egress.bits
    (mem_context |> map_valid(token): token.into(RV2WideResult()).fetched) |> memory_stage[lane]
    def mem_lookup = mem.memory.enable & (mem.resolution.disposition === RV2WideDisposition.Continue)
    def mem_misaligned = mem.memory.access.is_one_of(CacheOperation.Load, CacheOperation.Store) & !mem.memory.width.is_aligned(mem.address)
    def mem_outcome = mux(mem_misaligned, RV2WideCacheOutcome.Slow, mux(pipeline.response.valid, pipeline.response.bits.outcome, RV2WideCacheOutcome.Replay))
    def mem_hit = mem_lookup & (mem.memory.access === CacheOperation.Load) & (mem_outcome === RV2WideCacheOutcome.LoadHit)
    def mem_page_fault = mem_outcome === RV2WideCacheOutcome.PageFault
    def mem_fault = mem_outcome.is_one_of(RV2WideCacheOutcome.PageFault, RV2WideCacheOutcome.AccessFault)
    def mem_lookup_resolution = RV2WideResolution():
      disposition: mux(mem_fault, RV2WideDisposition.Fault, mux(mem_outcome === RV2WideCacheOutcome.Replay, RV2WideDisposition.Replay, RV2WideDisposition.Continue))
      cause: mux(mem_page_fault, mux(mem.memory.access.store_fault_class(), exception_cause_bits(ExceptionCause.StorePageFault, 64), exception_cause_bits(ExceptionCause.LoadPageFault, 64)), mux(mem.memory.access.store_fault_class(), exception_cause_bits(ExceptionCause.StoreAccessFault, 64), exception_cause_bits(ExceptionCause.LoadAccessFault, 64)))
      value: mem.address
    mem_resolved[lane] <== mem.updated(
      ~resolution: mux(mem.resolution.disposition =/= RV2WideDisposition.Continue, mem.resolution, mux(resolution[lane].valid, resolution[lane].bits, mux(mem_lookup, mem_lookup_resolution, mem.resolution))),
      ~data: mux(mem_hit, mem_load.value, mem.data),
      ~result_ready: mem.result_ready ||| mem_hit,
      ~cache_outcome: mem_outcome
    )
    mem_output.valid <== mem_input.valid & !wb_squash & (if lane == 0 | Bool(#true) | !(mem_branch_redirect & mem_resolved[0].mispredicted & mem_older.egress.valid))
    mem_output.bits <== mem_resolved[lane]
    describe_interface_contract(mem_input, mem_output, "memory-resolution-" ++ to_string(lane), ~trace_model: interface_trace_combinational())
    (mem_results[lane] |> trace_valid_event("core/s3.mem.slot" ++ to_string(lane), ~fields: token):
      pc: token.fetched.pc
      instruction(~format: "riscv", ~isa: trace_isa, ~pc: "pc"): token.fetched.raw_instruction
      outcome: token.cache_outcome
      disposition: token.resolution.disposition
      branch: token.branch_update.branch
      mispredicted: token.mispredicted
      predicted_target: token.fetched.prediction.target
      taken: token.taken
    ) |> wb_pipe[lane].ingress
    wb_pipe[lane].flush <== wb_squash

  // Correct predictions preserve target-stream work, including a paired younger
  // instruction. Recovery retains the resolving token and older peers for WB.
  def mem_older_continue = mem_resolved[0].resolution.disposition === RV2WideDisposition.Continue
  def mem_branch_older = mem_older.egress.valid & mem_resolved[0].mispredicted & mem_older_continue
  def mem_branch_younger = mem_younger.egress.valid & mem_resolved[1].mispredicted & (mem_resolved[1].resolution.disposition === RV2WideDisposition.Continue) & (!mem_older.egress.valid ||| (mem_older_continue & !mem_resolved[0].mispredicted))
  mem_branch_redirect <== (mem_branch_older ||| mem_branch_younger) & !wb_squash
  def mem_branch :: RV2WideResult() = mux(mem_branch_older, mem_resolved[0], mem_resolved[1])
  def mem_redirect_bits = RV2WideRedirect():
    pc: mem_branch.fetched.pc
    target: mux(mem_branch.taken, mem_branch.target, mem_branch.fetched.sequential_pc)
    resolution: mem_branch.resolution

  // WB: hits retire and ordinary services allocate deferred owners. Split,
  // management, and reservation waits retain their owner until completion.
  reg wb_retained_pending(~init: Bool(#false))
  reg wb_retained_sent(~init: Bool(#false))
  reg wb_retained_drained(~init: Bool(#false))
  reg wb_retained_owner(RV2WideResult())
  def wb_management = wb_retained_pending & wb_retained_owner.memory.enable & wb_retained_owner.memory.access.is_cache_management()
  wb_reservation_waiting <== wb_retained_pending & (wb_retained_owner.system.wait =/= RV2WideWait.None)
  reg wb_wait_count(~init: bits(0, 12))
  def wb_wait_wake = !memory.reservation_valid ||| wb_csrs.wfi_wake
  def wb_wait_short = wb_retained_owner.system.wait === RV2WideWait.ShortTimeout
  def wb_wait_tw = (wb_csrs.privilege =/= PrivilegeMode.Machine) & csr_flag(wb_csrs.mstatus, MstatusTW)
  def wb_wait_expired = wb_wait_count.and_reduce() & (wb_wait_short ||| wb_wait_tw)
  def wb_wait_complete = wb_reservation_waiting & (wb_wait_wake ||| wb_wait_expired)
  def wb_wait_fault = !wb_wait_wake & !wb_wait_short & wb_wait_tw
  def wb_wait_resolution = RV2WideResolution():
    disposition: mux(wb_wait_fault, RV2WideDisposition.Fault, RV2WideDisposition.Continue)
    cause: exception_cause_bits(ExceptionCause.IllegalInstruction, 64)
    value: wb_retained_owner.fetched.raw_instruction.zext(64)
  wb_management_response <== wb_management & wb_retained_sent
  wire wb_management_fault: Bool
  wire wb_management_accepted: Bool
  def wb_retained_complete = split.response.valid ||| wb_management_completed.valid ||| wb_management_fault ||| wb_wait_complete
  def wb_split_fault = split.response.bits.page_fault ||| split.response.bits.response.access_fault
  def wb_split_resolution = RV2WideResolution():
    disposition: mux(wb_split_fault, RV2WideDisposition.Fault, RV2WideDisposition.Continue)
    cause: mux(split.response.bits.page_fault, mux(wb_retained_owner.memory.access.store_fault_class(), exception_cause_bits(ExceptionCause.StorePageFault, 64), exception_cause_bits(ExceptionCause.LoadPageFault, 64)), mux(wb_retained_owner.memory.access.store_fault_class(), exception_cause_bits(ExceptionCause.StoreAccessFault, 64), exception_cause_bits(ExceptionCause.LoadAccessFault, 64)))
    value: split.response.bits.fault_address
  def wb_retained_result = wb_retained_owner.updated(
    ~data: split.response.bits.response.data,
    ~result_ready: Bool(#true),
    ~resolution: mux(wb_reservation_waiting, wb_wait_resolution, mux(wb_management, mux(wb_management_fault, memory.fault.bits, wb_retained_owner.resolution), wb_split_resolution))
  )
  inst wb_fault_retention(OfferRegister(RV2WideResult()))
  reg wb_pending_interrupt(~init: Bool(#false))
  def wb_fault_pending = wb_fault_retention.egress.valid
  def wb_valid :: Vec(2, Bool) = vec(mux(wb_retained_pending, wb_retained_complete, wb_older.egress.valid), !wb_retained_pending & wb_younger.egress.valid)
  def wb_group :: Vec(2, RV2WideResult()) = vec(mux(wb_retained_pending, wb_retained_result, wb_older.egress.bits), wb_younger.egress.bits)
  // New dispatch observes the live WB pipes, never the returned retained owner.
  // In particular, admission faults cannot feed back into their own request.
  def wb_live_valid :: Vec(2, Bool) = vec(wb_older.egress.valid, wb_younger.egress.valid)
  def wb_live_group :: Vec(2, RV2WideResult()) = vec(wb_older.egress.bits, wb_younger.egress.bits)
  def wb_raw_fault = (wb_live_valid[0] & (wb_live_group[0].resolution.disposition === RV2WideDisposition.Fault)) ||| (wb_live_valid[1] & (wb_live_group[1].resolution.disposition === RV2WideDisposition.Fault))
  // Interrupts precede the oldest unretired WB instruction, or use the saved
  // next PC at an empty-pipeline/sleep boundary. A synchronous fault wins.
  def wb_idle_boundary = rr_pipeline_empty & wb_pc_known
  def wb_interrupt_stop = wb_csrs.interrupt_request & !wb_retained_pending & !wb_fault_pending & !wb_raw_fault & (wb_live_valid[0] ||| wb_idle_boundary)
  def wb_interrupt_pc = mux(wb_valid[0], wb_group[0].fetched.pc, wb_resume_pc)
  def wb_older_stop = wb_live_valid[0] & (wb_live_group[0].resolution.disposition =/= RV2WideDisposition.Continue)
  def wb_memory_lane = mux(wb_live_valid[0] & wb_live_group[0].memory.enable, bits(0, 1), bits(1, 1))
  def wb_memory :: RV2WideResult() = wb_live_group[wb_memory_lane]
  def wb_memory_active = wb_live_valid[wb_memory_lane] & wb_memory.memory.enable & (wb_memory.resolution.disposition === RV2WideDisposition.Continue) & ((wb_memory_lane === bits(0, 1)) ||| !wb_older_stop) & !wb_retained_pending & !wb_fault_pending & !wb_interrupt_stop
  def wb_split_capture = wb_memory_active & wb_memory.memory.access.is_one_of(CacheOperation.Load, CacheOperation.Store) & !wb_memory.memory.width.is_aligned(wb_memory.address)
  def wb_management_capture = wb_memory_active & wb_memory.memory.access.is_cache_management()
  def wb_wait_capture = wb_live_valid[0] & (wb_live_group[0].system.wait =/= RV2WideWait.None) & !wb_older_stop & !wb_retained_pending & !wb_fault_pending & !wb_interrupt_stop
  def wb_retained_capture = wb_split_capture ||| wb_management_capture ||| wb_wait_capture
  def wb_retained_lane = mux(wb_wait_capture, bits(0, 1), wb_memory_lane)
  def wb_retained_candidate :: RV2WideResult() = wb_live_group[wb_retained_lane]
  def wb_retained_input :: Handle = interface_link(Valid(RV2WideResult()))
  def wb_retained_output :: Handle = interface_link(Valid(RV2WideResult()))
  wb_retained_input.left.valid <== wb_retained_capture
  wb_retained_input.left.bits <== wb_retained_candidate
  wb_retained_output.left.valid <== wb_retained_pending & wb_retained_complete
  wb_retained_output.left.bits <== wb_retained_result
  describe_interface_selection([wb_retained_lane === bits(0, 1), wb_retained_lane === bits(1, 1)], ~name: "retained-operation-lane")
  describe_interface_contract(Array(wb_paths[0][1], wb_paths[1][1]), wb_retained_input.left, "retained-operation-lane", ~trace_model: interface_trace_selection(~name: "retained-operation-lane"))
  describe_interface_retained_storage(wb_retained_capture, wb_retained_complete, wb_retained_pending, ~name: "retained-operation")
  describe_interface_contract(wb_retained_input.right, wb_retained_output.left, "retained-operation-owner", ~trace_model: interface_trace_retained(~name: "retained-operation"))
  def wb_owners :: Handle = interface_link(Valid(RV2WideResult()))
  wb_owners.left.valid <== wb_valid[0]
  wb_owners.left.bits <== wb_group[0]
  describe_interface_selection([!wb_retained_pending, wb_retained_pending], ~name: "wb-owner")
  describe_interface_contract(Array(wb_paths[0][0], wb_retained_output.right), wb_owners.left, "wb-owner", ~trace_model: interface_trace_selection(~name: "wb-owner"))
  def wb_slow = wb_memory_active & !wb_retained_capture & (wb_memory.cache_outcome === RV2WideCacheOutcome.Slow)
  def wb_store_hit = wb_memory_active & wb_memory.memory.access.is_store() & (wb_memory.cache_outcome === RV2WideCacheOutcome.StoreHit)
  def wb_memory_blocked = memory.ordered_busy ||| wb_ordered_memory_pending
  def wb_prior_drained = wb_load_response.drained & memory.drained & ex_multiply.drained & wb_divide.drained & !wb_completion_count.or_reduce() & !rr_completion.valid & fp.drained
  split.request.valid <== wb_retained_pending & !wb_management & !wb_reservation_waiting & !wb_retained_sent & wb_retained_drained
  split.request.bits <== PhysicalMemoryReq(XLen.X64, Bool):
    address: wb_retained_owner.address
    access: wb_retained_owner.memory.access
    atomic: dont_care(split.request.bits.atomic.type)
    width: wb_retained_owner.memory.width
    unsigned: wb_retained_owner.memory.unsigned
    data: wb_retained_owner.store_data
    byte_mask: dont_care(Bits(8))
    context: Bool(#false)
    locality: dont_care(split.request.bits.locality.type)
  when wb_retained_capture:
    wb_retained_pending <== Bool(#true)
    wb_retained_sent <== Bool(#false)
    wb_retained_drained <== Bool(#false)
    wb_retained_owner <== wb_retained_candidate
  elsewhen wb_retained_complete:
    wb_retained_pending <== Bool(#false)
  elsewhen (split.request.fire() ||| wb_management_accepted):
    wb_retained_sent <== Bool(#true)
  elsewhen (wb_retained_pending & wb_prior_drained):
    wb_retained_drained <== Bool(#true)
  when wb_wait_capture:
    wb_wait_count <== bits(0, 12)
  elsewhen (wb_reservation_waiting & !wb_wait_complete & !wb_wait_count.and_reduce()):
    wb_wait_count <== wb_wait_count + bits(1, 12)
  when (split.response.valid):
    assert(wb_retained_pending & wb_retained_sent, "rv2wide_split_response_has_retirement_owner")
  def wb_request_owner :: RV2WideResult() = mux(wb_management, wb_retained_owner, wb_memory)
  inst wb_store(StoreGen(XLen.X64))
  wb_store.address <== wb_request_owner.address
  wb_store.value <== wb_request_owner.store_data
  wb_store.width <== wb_request_owner.memory.width
  memory.request.valid <== (wb_slow & wb_load_response.available & !wb_memory_blocked) ||| (wb_management & !wb_retained_sent & wb_retained_drained)
  memory.request.bits <== RV2WideMemoryReq():
    address: wb_request_owner.address
    access: wb_request_owner.memory.access
    atomic: wb_request_owner.memory.atomic
    width: wb_request_owner.memory.width
    data: mux(wb_request_owner.memory.access.is_store(), wb_store.data, wb_request_owner.store_data)
    mask: wb_store.mask.as_bits()
  pipeline.commit <== wb_store_hit & !wb_memory_blocked
  def wb_admission_fault = memory.request.valid & memory.fault.valid
  wb_management_fault <== wb_management & wb_admission_fault
  wb_management_accepted <== wb_management & memory.request.fire()
  def wb_accepted = memory.request.fire() & !wb_admission_fault & !wb_management
  def wb_memory_replay = (wb_memory_active & !wb_retained_capture & wb_memory_blocked) ||| (wb_slow & !wb_accepted & !wb_admission_fault) ||| (wb_store_hit & !pipeline.commit_ready)
  wb_load_response.allocate.valid <== wb_accepted
  wb_load_response.allocate.bits <== wb_memory
  when (wb_accepted & !wb_memory.memory.access.is_one_of(CacheOperation.Load, CacheOperation.Store)):
    wb_ordered_memory_pending <== Bool(#true)
  elsewhen (wb_load_response.ordered_completed.valid):
    wb_ordered_memory_pending <== Bool(#false)
  assert(!(memory.request.fire() & wb_admission_fault), "rv2wide_fault_prevents_acceptance")
  def wb_memory_resolution = RV2WideResolution():
    disposition: RV2WideDisposition.Replay
    cause: dont_care(Bits(64))
    value: dont_care(Bits(64))
  def wb_fp_lane = mux(wb_valid[0] & wb_group[0].fp.valid, bits(0, 1), bits(1, 1))
  def wb_fp_token :: RV2WideResult() = wb_group[wb_fp_lane]
  def wb_fp_prefix = (wb_fp_lane === bits(0, 1)) ||| (!wb_older_stop & !(wb_memory_active & (wb_memory_lane === bits(0, 1)) & (wb_memory_replay ||| wb_admission_fault ||| wb_retained_capture)))
  fp.variable_issue.valid <== wb_valid[wb_fp_lane] & wb_fp_token.fp.valid & (wb_fp_token.fp.bits.execution.unit === FloatUnit.DivideSquareRoot) & (wb_fp_token.resolution.disposition === RV2WideDisposition.Continue) & wb_fp_prefix & !wb_fault_pending & !wb_interrupt_stop & !wb_retained_pending
  fp.variable_issue.bits <== wb_fp_token.fp_request
  wb_fp_variable_accepted <== fp.variable_issue.fire()
  def wb_fp_replay = fp.variable_issue.valid & !fp.variable_issue.ready
  def wb_long_lane = mux(wb_valid[0] & (wb_group[0].muldiv.service =/= RV2WideLongOperation.None), bits(0, 1), bits(1, 1))
  def wb_long :: RV2WideResult() = wb_group[wb_long_lane]
  def wb_long_active = wb_valid[wb_long_lane] & wb_long.write & (wb_long.muldiv.service =/= RV2WideLongOperation.None) & (wb_long.resolution.disposition === RV2WideDisposition.Continue) & ((wb_long_lane === bits(0, 1)) ||| !wb_older_stop) & !wb_fault_pending & !wb_interrupt_stop
  def wb_multiply_accepted = wb_long_active & (wb_long.muldiv.service === RV2WideLongOperation.Multiply)
  ex_multiply.authorize <== wb_multiply_accepted
  def wb_divide_link :: Handle = interface_link(Decoupled(RV2WideResult()))
  wb_divide_link.left.valid <== wb_long_active & (wb_long.muldiv.service === RV2WideLongOperation.Divide)
  wb_divide_link.left.bits <== wb_long
  (wb_divide_link.right |> map_flow(operation):
    def control = operation.muldiv.divide
    def word_left = mux(control.signed_mode, operation.left[0..32].into(SInt(32)).sext(64).into(Bits(64)), operation.left[0..32].zext(64))
    def word_right = mux(control.signed_mode, operation.right[0..32].into(SInt(32)).sext(64).into(Bits(64)), operation.right[0..32].zext(64))
    def request = DividerRequest(64):
      dividend: mux(control.word_result, word_left, operation.left)
      divisor: mux(control.word_result, word_right, operation.right)
      signed_mode: control.signed_mode
    def owner = RV2WideRetirement():
      fetched: operation.fetched
      rd: operation.rd
      write: operation.write
      data: dont_care(Bits(64))
      deferred: Bool(#false)
    RV2WideDivideIssue():
      request: request
      control: control
      owner: owner
  ) |> wb_divide.issue
  def wb_divide_accepted = wb_divide_link.right.fire()
  def wb_divide_replay = wb_divide_link.right.valid & !wb_divide_accepted
  def wb_long_accepted = wb_multiply_accepted ||| wb_divide_accepted
  wb_scoreboard.set.valid <== (wb_accepted & wb_memory.write) ||| wb_long_accepted
  wb_scoreboard.set.bits <== mux(wb_long_accepted, wb_long.rd, wb_memory.rd)
  assert(!(wb_accepted & wb_long_accepted), "rv2wide_one_deferred_owner_per_group")
  def wb_tokens :: Vec(2, RV2WideResult()) = vec(
    for List (lane in 0..2):
      def token :: RV2WideResult() = wb_group[lane]
      def selected = wb_memory_active & (wb_memory_lane === bits(lane, 1))
      token.updated(
        ~resolution: mux(selected & wb_admission_fault, memory.fault.bits, mux((selected & wb_memory_replay) ||| (wb_divide_replay & (wb_long_lane === bits(lane, 1))) ||| (wb_fp_replay & (wb_fp_lane === bits(lane, 1))), wb_memory_resolution, token.resolution))
      )
  )
  def wb_stop = for List (lane in 0..2):
    !wb_fault_pending & !wb_interrupt_stop & wb_valid[lane] & (wb_tokens[lane].resolution.disposition =/= RV2WideDisposition.Continue) & !(wb_retained_capture & (wb_retained_lane === bits(0, 1)))
  def wb_selected :: RV2WideResult() = mux(wb_stop[0], wb_tokens[0], wb_tokens[1])
  def wb_stop_valid = wb_stop[0] ||| wb_stop[1]
  wb_drained <== wb_prior_drained & !wb_accepted & !wb_divide_accepted & !wb_retained_pending & !wb_retained_capture & !wb_fp_variable_accepted & !wb_fp_fixed_authorized
  def wb_explicit_fault = wb_stop_valid & (wb_selected.resolution.disposition === RV2WideDisposition.Fault)
  def wb_hold_fault = (wb_explicit_fault ||| wb_interrupt_stop) & !wb_drained
  wb_fault_retention.update.valid <== wb_hold_fault
  wb_fault_retention.update.bits <== mux(wb_interrupt_stop, wb_group[0].updated(~fetched: wb_group[0].fetched.updated(~pc: wb_interrupt_pc)), wb_selected)
  when wb_hold_fault:
    wb_pending_interrupt <== wb_interrupt_stop
  wb_fault_retention.egress.ready <== wb_drained
  def wb_fault :: RV2WideResult() = mux(wb_fault_pending, wb_fault_retention.egress.bits, wb_selected)
  def wb_system_control :: RV2WideSystemControl() = wb_group[0].system
  def wb_system = wb_valid[0] & wb_system_control.serializing() & !wb_wait_capture & !wb_fault_pending & !wb_interrupt_stop & !wb_stop_valid
  def wb_fault_command = wb_drained & (wb_explicit_fault ||| (wb_fault_pending & !wb_pending_interrupt))
  def wb_command :: RV2WideResult() = mux(wb_fault_command, wb_fault, wb_group[0])
  wb_csrs.commit.valid <== wb_fault_command ||| wb_system
  wb_csrs.commit.bits <== RiscvCsrCommand(XLen.X64):
    pc: wb_command.fetched.pc
    instruction: wb_command.fetched.raw_instruction
    rd: wb_command.rd
    csr_operation: mux(wb_fault_command, RiscvCsrOperation.None, wb_command.system.csr)
    action: mux(wb_fault_command, RiscvCsrAction.None, wb_command.system.action)
    csr_address: wb_command.fetched.instruction[20..32]
    csr_source: wb_command.csr_source
    vector_config: dont_care(wb_csrs.commit.bits.vector_config.type)
    exception_valid: wb_fault_command
    exception_cause: wb_fault.resolution.cause
    exception_value: wb_fault.resolution.value
  def wb_interrupt_boundary = wb_drained & (wb_interrupt_stop ||| (wb_fault_pending & wb_pending_interrupt))
  wb_csrs.interrupt_boundary <== wb_interrupt_boundary
  wb_csrs.interrupt_pc <== mux(wb_fault_pending, wb_fault.fetched.pc, wb_interrupt_pc)
  def wb_replay = wb_stop_valid & (wb_selected.resolution.disposition === RV2WideDisposition.Replay)
  def wb_wake = wb_sleeping & wb_csrs.wfi_wake
  def wb_system_resume = wb_system & wb_csrs.command_success & !wb_csrs.wfi
  def wb_retained_resume = wb_retained_pending & wb_retained_complete & (wb_retained_result.resolution.disposition === RV2WideDisposition.Continue)
  instruction_invalidate.valid <== wb_system_resume & (wb_system_control.fence === RV2WideFence.Instruction)
  predictor_clear.valid <== translation_flush ||| wb_csrs.trap_event.valid ||| (wb_system & wb_csrs.command_success & wb_system_control.action.is_one_of(RiscvCsrAction.Mret, RiscvCsrAction.Sret))
  wb_redirect_link.left.valid <== wb_csrs.redirect.valid ||| wb_replay ||| wb_system_resume ||| wb_interrupt_boundary ||| wb_wake ||| wb_retained_resume
  wb_redirect_link.left.bits <== RV2WideRedirect():
    pc:
      priority_mux(~default: wb_command.fetched.pc):
        wb_interrupt_boundary: wb_csrs.interrupt_pc
        wb_wake: wb_resume_pc
        wb_replay: wb_selected.fetched.pc
    target:
      priority_mux(~default: wb_command.fetched.sequential_pc):
        wb_csrs.redirect.valid: wb_csrs.redirect.bits
        wb_interrupt_boundary: wb_csrs.interrupt_pc
        wb_wake: wb_resume_pc
        wb_replay: wb_selected.fetched.pc
    resolution:
      RV2WideResolution():
        disposition: mux(wb_csrs.trap_event.valid & !wb_interrupt_boundary, RV2WideDisposition.Fault, mux(wb_replay, RV2WideDisposition.Replay, RV2WideDisposition.System))
        cause: wb_csrs.trap_event.cause
        value: wb_csrs.trap_event.value
  wb_squash <== wb_stop_valid ||| wb_fault_pending ||| wb_interrupt_stop ||| wb_system ||| wb_sleeping ||| wb_retained_capture ||| wb_retained_pending
  rr_squash <== wb_squash ||| mem_branch_redirect
  fetch_flush.valid <== rr_squash
  redirect.valid <== wb_redirect.valid ||| mem_branch_redirect
  redirect.bits <== mux(wb_redirect.valid, wb_redirect.bits, mem_redirect_bits)
  wire wb_writes: Vec(2, Bool)
  wire wb_recover_ras: Vec(2, Bool)
  wire wb_train: Vec(2, Bool)
  def wb_retirement_links = for List (_ in 0..2): interface_link(Valid(RV2WideRetirement()))
  def wb_retirement_paths = for List (lane in 0..2):
    def wb :: RV2WideResult() = wb_tokens[lane]
    def next_pc = mux(wb.taken, wb.target, wb.fetched.sequential_pc)
    def predicted_pc = mux(wb.fetched.prediction.valid, wb.fetched.prediction.target, wb.fetched.sequential_pc)
    def observed = wb_retirement_links[lane].right |> trace_valid_event("core/s4.wb.slot" ++ to_string(lane), ~fields: result):
      pc: result.fetched.pc
      instruction(~format: "riscv", ~isa: trace_isa, ~pc: "pc"): result.fetched.raw_instruction
      deferred: result.deferred
      rd: result.rd
      branch_prediction(~format: "enum"): mux(wb.branch_update.branch, mux(next_pc =/= predicted_pc, RV2WideBranchPrediction.Mispredicted, RV2WideBranchPrediction.Correct), RV2WideBranchPrediction.NotBranch)
      ras_mismatch: wb.branch_update.ras_action =/= wb.branch_update.predicted_ras_action
    observed |> fork_valid(3)
  for (lane in 0..2):
    def wb :: RV2WideResult() = wb_tokens[lane]
    def wb_retained_suppressed = wb_retained_capture & (if lane == 0 | wb_retained_lane === bits(0, 1) | Bool(#true))
    def wb_eligible = !wb_retained_suppressed & !wb_fault_pending & !wb_interrupt_stop & wb_valid[lane] & (wb.resolution.disposition === RV2WideDisposition.Continue) & (if lane == 0 | !wb_system ||| wb_csrs.command_success | !wb_stop[0] & !wb_system)
    def wb_fp_compute = wb.fp.valid & (wb.fp.bits.execution.unit =/= FloatUnit.Memory)
    def wb_fp_direct = wb_fp_compute & wb.fp_request.tag.speculative & wb.fp_request.tag.direct
    def wb_deferred = (wb_accepted & (wb_memory_lane === bits(lane, 1))) ||| (wb_long_accepted & (wb_long_lane === bits(lane, 1))) ||| (wb_fp_compute & !wb_fp_direct)
    def retirement :: Endpoint = wb_retirement_links[lane].left
    retirement.valid <== wb_eligible
    retirement.bits <== RV2WideRetirement():
      fetched: wb.fetched
      rd: wb.rd
      write: wb.write
      data: mux(wb_system, wb_csrs.writeback_value, mux(wb_fp_direct & wb.write, fp.completion.bits.integer_value, wb.data))
      deferred: wb_deferred
    describe_interface_contract(if lane == 0 | wb_owners.right | wb_paths[1][0], retirement, "retirement-" ++ to_string(lane), ~trace_model: interface_trace_combinational())
    wb_retirement_paths[lane][0] |> retired[lane]
    wb_writes[lane] <== wb_eligible & wb.write & !wb_deferred & (!wb_system ||| wb_csrs.writeback_valid)
    wb_train[lane] <== wb_eligible & wb.branch_update.branch
    wb_recover_ras[lane] <== wb_eligible & wb.mispredicted
  // Best-effort arbitration drops a simultaneous younger hint; neither slot stalls.
  def wb_prefetch_paths = for List (lane in 0..2):
    def token :: RV2WideResult() = wb_tokens[lane]
    wb_retirement_paths[lane][2] |> filter_valid(_retired => token.prefetch.is_prefetch()) |> map_valid(_retired => CachePrefetchReq(64)):
      address: token.address
      operation: token.prefetch
  Array(wb_prefetch_paths[0], wb_prefetch_paths[1]) |> valid_arbiter() |> prefetch
  def wb_branch_lane = mux(wb_train[0], bits(0, 1), bits(1, 1))
  branch_update.valid <== wb_train.or_reduce()
  branch_update.bits <== wb_tokens[wb_branch_lane].branch_update
  direction_update.valid <== branch_update.valid & branch_update.bits.conditional & wb_tokens[wb_branch_lane].fetched.direction.valid
  direction_update.bits <== BhtUpdate(10):
    index: wb_tokens[wb_branch_lane].fetched.direction.index
    taken: branch_update.bits.taken
  // A MEM correction keeps its branch. WB rejection is older and instead
  // restores the checkpoint before the oldest instruction being discarded.
  history_restore.valid <== mem_branch_redirect ||| wb_stop_valid ||| wb_retained_capture ||| wb_system
  history_restore.bits <== priority_mux(~default: rv2wide_history_after(mem_branch.fetched.direction, mem_branch.taken)):
    wb_stop_valid: wb_selected.fetched.direction.history
    wb_retained_capture: wb_memory.fetched.direction.history
    wb_system: wb_group[0].fetched.direction.history
  predictor_restore.valid <== wb_squash ||| wb_recover_ras.or_reduce()
  assert(!(wb_train[0] & wb_train[1]), "rv2wide_one_branch_update_per_group")
  // FP cannot be a serializing CSR command; qualify the same successful prefix without CSR feedback.
  def wb_fp_success = wb_valid[wb_fp_lane] & !wb_fault_pending & !wb_interrupt_stop & !wb_system & (wb_tokens[wb_fp_lane].resolution.disposition === RV2WideDisposition.Continue) & ((wb_fp_lane === bits(0, 1)) ||| !wb_stop[0]) & (!wb_retained_capture ||| ((wb_fp_lane === bits(0, 1)) & (wb_retained_lane === bits(1, 1))))
  fp.authorize.valid <== wb_fp_success & wb_fp_token.fp.valid & !wb_fp_token.fp.bits.execution.unit.is_one_of(FloatUnit.Memory, FloatUnit.DivideSquareRoot)
  wb_fp_fixed_authorized <== fp.authorize.valid
  fp.authorize.bits <== wb_fp_token.fp_request
  wb_fp_gpr_scoreboard.set.valid <== fp.authorize.valid & !fp.authorize.bits.tag.direct & (fp.authorize.bits.tag.destination === FloatDestination.Integer) & fp.authorize.bits.tag.rd.or_reduce()
  wb_fp_gpr_scoreboard.set.bits <== fp.authorize.bits.tag.rd
  fp.load_reserve.valid <== wb_accepted & wb_memory.fp.valid & (wb_memory.fp.bits.registers.destination === FloatDestination.FloatingPoint)
  fp.load_reserve.bits <== wb_memory.fp_request.tag
  fp.load_hit.valid <== mux(wb_fp_lane === bits(0, 1), retired[0].valid, retired[1].valid) & wb_fp_token.fp.valid & wb_fp_token.memory.enable & (wb_fp_token.memory.access === CacheOperation.Load) & !wb_accepted
  fp.load_hit.bits <== RV2WideFpLoad():
    owner: wb_fp_token.fp_request.tag
    precision: wb_fp_token.fp.bits.execution.destination_precision
    data: wb_fp_token.data
  // Accepted services inherit successful WB, never a live lane's later payload.
  def wb_service :: Handle = interface_link(Valid(RV2WideRetirement()))
  def wb_service_lane = mux(wb_accepted, wb_memory_lane, wb_long_lane)
  wb_service.left.valid <== wb_accepted ||| wb_divide_accepted
  wb_service.left.bits <== mux(wb_service_lane === bits(0, 1), retired[0].bits, retired[1].bits)
  describe_interface_selection([wb_service_lane === bits(0, 1), wb_service_lane === bits(1, 1)], ~name: "service-lane")
  describe_interface_contract(Array(wb_retirement_paths[0][1], wb_retirement_paths[1][1]), wb_service.left, "service-lane", ~trace_model: interface_trace_selection(~name: "service-lane"))
  describe_interface_contract(wb_service.right, Array(wb_load_response.allocate, wb_divide_link.left), "committed-service", ~trace_model: interface_trace_routing([wb_accepted, wb_divide_accepted]))
  def wb_completion_write = wb_gpr_return.valid & wb_gpr_return.bits.write
  def wb_second_address = mux(wb_fp_late_gpr.valid, wb_fp_late_gpr.bits.tag.rd, mux(wb_completion_write, wb_gpr_return.bits.rd, wb_tokens[1].rd))
  def wb_second_data = mux(wb_fp_late_gpr.valid, wb_fp_late_gpr.bits.integer_value, mux(wb_completion_write, wb_gpr_return.bits.data, retired[1].bits.data))
  def wb_second_write = wb_completion_write ||| wb_writes[1] ||| wb_fp_late_gpr.valid
  assert(!(wb_fp_late_gpr.valid & (wb_completion_write ||| wb_younger.egress.valid)), "rv2wide_fixed_fp_reserved_younger_slot")
  assert(!(ex_multiply.completed.valid & (wb_completion.valid ||| wb_younger.egress.valid)), "rv2wide_multiply_reserved_younger_slot")
  when (ex_multiply.completed.valid):
    assert(wb_gpr_calendar.occupied[0].into(Bool), "rv2wide_multiply_booked_return")
  // Coalesce successful same-group writes, not retirement. A fault/replay/deferred
  // younger instruction must leave the older write intact; completion is not younger.
  def wb_first_write = wb_writes[0] & !(wb_writes[1] & (wb_tokens[0].rd === wb_tokens[1].rd))
  assert(!(wb_completion_write & wb_younger.egress.valid), "rv2wide_completion_reserved_younger_slot")
  assert(!(wb_first_write & wb_second_write & (wb_tokens[0].rd === wb_second_address)), "rv2wide_two_write_ports_distinct")
  when (wb_first_write):
    rr_registers[wb_tokens[0].rd] <== retired[0].bits.data
  when wb_second_write:
    rr_registers[wb_second_address] <== wb_second_data
  retired_count <== retired[0].valid.as_bits().zext(2) + retired[1].valid.as_bits().zext(2)
  wb_csrs.retire_count <== retired_count
  def wb_pause_commit = (retired[0].valid & wb_tokens[0].pause) ||| (retired[1].valid & wb_tokens[1].pause)
  when (rr_squash ||| wb_csrs.interrupt_request):
    rr_pause_cycles <== bits(0, 5)
  elsewhen wb_pause_commit:
    rr_pause_cycles <== bits(16, 5)
  elsewhen (rr_pause_cycles.or_reduce()):
    rr_pause_cycles <== rr_pause_cycles - bits(1, 5)
  when (wb_redirect.valid):
    wb_resume_pc <== wb_redirect.bits.target
    wb_pc_known <== Bool(#true)
    wb_sleeping <== Bool(#false)
  elsewhen (retired[0].valid):
    def last :: RV2WideResult() = mux(retired[1].valid, wb_tokens[1], wb_tokens[0])
    wb_resume_pc <== mux(last.taken, last.target, last.fetched.sequential_pc)
    wb_pc_known <== Bool(#true)
    wb_sleeping <== wb_csrs.wfi

  describe_cosim_hart(RV2WideObservationContract, {"profile": profile, "fp_timing": fp_timing}, {
    "wb_tokens": wb_tokens,
    "wb_retired": vec(retired[0].valid, retired[1].valid),
    "wb_retirement": vec(retired[0].bits, retired[1].bits),
    "wb_writes": wb_writes,
    "wb_split_capture": wb_split_capture,
    "wb_memory_lane": wb_memory_lane,
    "wb_multiply_accepted": wb_multiply_accepted,
    "fp_valid": fp.completion.valid,
    "fp_completion": fp.completion.bits,
    "fp_load_valid": fp.load_write.valid,
    "fp_load": fp.load_write.bits,
    "wb_command": wb_command,
    "completion_fire": vec(wb_load_response.completed.fire(), ex_multiply.completed.valid, wb_divide.completed.fire(), completed.valid),
    "completion": vec(wb_load_response.completed.bits, ex_multiply.completed.bits, wb_divide.completed.bits, completed.bits)
  }, {"csr": wb_csrs})

export:
  RV2WideCore
