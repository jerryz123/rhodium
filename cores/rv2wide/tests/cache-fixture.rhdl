import:
  "../core.rhdl" open
  "../cache.rhdl" open
  "../mmu.rhdl" open
  "../bundles.rhdl" open
  "../../cache/config.rhm" open
  "../../riscv/chi-hart.rhdl" open
  lib("rhodium/std/interconnect.rhdl").AddressSet
  lib("chi/protocol/params.rhdl").CHIFlitParams
  lib("chi/protocol/link.rhdl").CHINodeKind
  lib("chi/protocol/fabric.rhdl") open
  lib("riscv/rtl/pma.rhdl") open
  lib("chi/protocol/channels.rhdl").CHIRNChannels
  lib("flow/main.rhdl") open

def test_cache = CacheConfig(4, 2)
def test_flit = CHIFlitParams()
def test_home = CHIHomeParams("rv2wide-test-home", 1, CHINodeKind.HNF, ~max_outstanding: 2)
def test_chi = RiscvHartCHIConfig(test_flit, CacheLineBytes, [
  RiscvHartCHIRegion(RiscvPhysicalMemoryRegion(AddressSet(0, 4095),
                                               RiscvPhysicalMemoryAttributes(#true, #true, #true, #true, #true, #false, #true)), test_home)
])
def test_fetch_chi = RiscvHartCHIConfig(test_flit, CacheLineBytes, test_chi.regions ++ [
  RiscvHartCHIRegion(RiscvPhysicalMemoryRegion(AddressSet(0x10000, 0xffff),
                                               RiscvPhysicalMemoryAttributes(#true, #true, #true, #true, #true, #false, #true)), test_home)
])

sync_circuit RV2WideCacheFixture():
  input node_id: Bits(test_flit.node_id_width)
  interface instructions(Decoupled(RV2WidePacket()), ~role: consumer)
  interface retired[2](Valid(RV2WideRetirement()), ~role: producer)
  interface completed(Valid(RV2WideRetirement()), ~role: producer)
  interface redirect(Valid(RV2WideRedirect()), ~role: producer)
  interface chi(CHIRNChannels(test_flit), ~role: node)
  output(issued, retired_count): Bits(2)
  inst core(RV2WideCore())
  core.interrupts <== literal(core.interrupts.type, 0)
  core.hart_id <== bits(0, 64)
  core.time_counter <== bits(0, 64)
  inst data(RV2WideL1D(test_cache, ~chi: test_chi))
  inst mmu(RV2WideMmu(test_chi))
  mmu.state <== core.translation_state
  mmu.invalidate <== core.translation_flush
  mmu.instruction.request.valid <== Bool(#false)
  mmu.instruction.request.bits <== bits(0, 64)
  instructions |> core.instructions
  core.retired <=> retired
  core.completed |> completed
  core.redirect |> redirect
  core.memory <=> mmu.memory
  core.pipeline <=> mmu.pipeline
  mmu.physical_memory <=> data.memory
  mmu.physical_pipeline <=> data.pipeline
  mmu.pipeline_lookup |> data.pipeline_lookup
  data.chi <=> chi
  data.node_id <== node_id
  issued <== core.issued
  retired_count <== core.retired_count
  for (slot in 0..2):
    core.resolution[slot].valid <== Bool(#false)
    core.resolution[slot].bits <== dont_care(RV2WideResolution())

export:
  RV2WideCacheFixture
  test_cache
  test_chi
  test_fetch_chi
