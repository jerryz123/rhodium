import:
  "../core.rhdl" open
  "../profile.rhm".RV2WideConfig
  "../cache.rhdl" open
  "../mmu.rhdl" open
  "../bundles.rhdl" open
  "../../cache/config.rhm" open
  "../../cache-prefetch.rhdl" open
  "../../chi-hart.rhdl" open
  lib("rhodium/std/interconnect.rhdl").AddressSet
  lib("chi/protocol/params.rhdl").CHIFlitParams
  lib("chi/protocol/link.rhdl").CHINodeKind
  lib("chi/protocol/fabric.rhdl") open
  lib("riscv/rtl/pma.rhdl") open
  lib("chi/protocol/channels.rhdl") open
  lib("flow/main.rhdl") open

def test_cache = CacheConfig(4, 2)
def test_flit = CHIFlitParams()
def test_home = CHIHomeParams("rv2wide-test-home", 1, CHINodeKind.HNF, ~max_outstanding: 2)
def test_io_home = CHIHomeParams("rv2wide-test-io", 5, CHINodeKind.HNI, ~max_outstanding: 1)
def test_chi = RiscvHartCHIConfig(test_flit, CacheLineBytes, [
  RiscvHartCHIRegion(RiscvPhysicalMemoryRegion(AddressSet(0, 4095),
                                               RiscvPhysicalMemoryAttributes(#true, #true, #true, #true, #true, #false, #true, ~cache_block_zero: #true)), test_home)
])
def test_fetch_chi = RiscvHartCHIConfig(test_flit, CacheLineBytes, test_chi.regions ++ [
  RiscvHartCHIRegion(RiscvPhysicalMemoryRegion(AddressSet(0x10000, 0xffff),
                                               RiscvPhysicalMemoryAttributes(#true, #true, #true, #true, #true, #false, #true, ~cache_block_zero: #true)), test_home),
  RiscvHartCHIRegion(RiscvPhysicalMemoryRegion(AddressSet(0x2000, 0xff),
                                               RiscvPhysicalMemoryAttributes(#true, #true, #false, #false, #false, #true, #false)), test_io_home),
  RiscvHartCHIRegion(RiscvPhysicalMemoryRegion(AddressSet(0x2100, 7),
                                               RiscvPhysicalMemoryAttributes(#true, #false, #false, #false, #false, #true, #false)), test_io_home),
  RiscvHartCHIRegion(RiscvPhysicalMemoryRegion(AddressSet(0x2203, 0),
                                               RiscvPhysicalMemoryAttributes(#true, #false, #false, #false, #false, #true, #false)), test_io_home),
  RiscvHartCHIRegion(RiscvPhysicalMemoryRegion(AddressSet(0x2300, 0xff),
                                               RiscvPhysicalMemoryAttributes(#true, #true, #false, #false, #false, #false, #true, ~cache_block_zero: #true)), test_io_home),
  RiscvHartCHIRegion(RiscvPhysicalMemoryRegion(AddressSet(0x2400, 7),
                                               RiscvPhysicalMemoryAttributes(#true, #true, #false, #false, #false, #false, #true, ~cache_block_zero: #true)), test_io_home),
  RiscvHartCHIRegion(RiscvPhysicalMemoryRegion(AddressSet(0x2500, 0xff),
                                               RiscvPhysicalMemoryAttributes(#true, #true, #false, #true, #false, #false, #true, ~cache_block_zero: #true)), test_home)
])

sync_circuit RV2WideCacheFixture():
  input node_id: Bits(test_flit.node_id_width)
  interface instructions(Decoupled(RV2WidePacket()), ~role: consumer)
  interface retired[2](Valid(RV2WideRetirement()), ~role: producer)
  interface completed(Valid(RV2WideRetirement()), ~role: producer)
  interface redirect(Valid(RV2WideRedirect()), ~role: producer)
  interface chi(CHIRNChannels(test_flit), ~role: node)
  interface uncached_chi(CHIRNIChannels(test_flit), ~role: node)
  output(issued, retired_count): Bits(2)
  output uncached_activity: Bool
  inst core(RV2WideCore(RV2WideConfig(~zicboz: #true, ~zicbom: #true, ~zicbop: #true)))
  core.interrupts <== literal(core.interrupts.type, 0)
  core.hart_id <== bits(0, 64)
  core.time_counter <== bits(0, 64)
  inst data(RV2WideL1D(test_cache, ~chi: test_fetch_chi))
  inst mmu(RV2WideMmu(test_fetch_chi))
  mmu.state <== core.translation_state
  mmu.invalidate <== core.translation_flush
  mmu.instruction.request.valid <== Bool(#false)
  mmu.instruction.request.bits <== bits(0, 64)
  instructions |> core.instructions
  core.retired <=> retired
  core.completed |> completed
  core.redirect |> redirect
  core.memory <=> mmu.memory
  core.split <=> mmu.split
  core.pipeline <=> mmu.pipeline
  core.prefetch |> mmu.prefetch
  mmu.physical_prefetch |> filter_valid(request => request.into(CachePrefetchReq(64)).operation.is_one_of(CachePrefetchOperation.Read, CachePrefetchOperation.Write)) |> data.prefetch
  mmu.physical_memory <=> data.memory
  mmu.physical_pipeline <=> data.pipeline
  mmu.pipeline_lookup |> data.pipeline_lookup
  data.chi <=> chi
  data.node_id <== node_id
  data.uncached_node_id <== bits(4, test_flit.node_id_width)
  data.uncached_chi <=> uncached_chi
  uncached_activity <== data.uncached_chi.req.valid ||| data.uncached_chi.dat.request.valid
  issued <== core.issued
  retired_count <== core.retired_count
  for (slot in 0..2):
    core.resolution[slot].valid <== Bool(#false)
    core.resolution[slot].bits <== dont_care(RV2WideResolution())

export:
  RV2WideCacheFixture
  test_cache
  test_chi
  test_fetch_chi
