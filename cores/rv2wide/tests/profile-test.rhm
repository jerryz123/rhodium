#lang rhombus
// Checks RV2Wide configuration selection, ISA publication, and invalid subset combinations.
// SPDX-License-Identifier: Apache-2.0

import:
  "../profile.rhm" open
  "../udb.rhm" open
  lib("riscv/isa/fp-profile.rhm") open
  lib("riscv/isa/c.rhm") open

def integer = RV2WideConfig()
def supervisor = RV2WideConfig(~ssnpm: #true, ~supm: #true, ~sscofpmf: #true, ~smstateen: #true)
def hypervisor = RV2WideConfig(~hypervisor: #true)
def sha = RV2WideConfig(~hypervisor: #true, ~smstateen: #true, ~ssnpm: #true, ~supm: #true, ~sscofpmf: #true, ~sstc: #true, ~svinval: #true)
def zero = RV2WideConfig(~zicboz: #true)
def management = RV2WideConfig(~zicbom: #true)
def cmo = RV2WideConfig(~zicboz: #true, ~zicbom: #true)
def prefetch = RV2WideConfig(~zicbop: #true)
def wait = RV2WideConfig(~zawrs: #true)
def pause = RV2WideConfig(~zihintpause: #true)
def locality = RV2WideConfig(~zihintntl: #true)
def timer = RV2WideConfig(~sstc: #true)
def pbmt = RV2WideConfig(~svpbmt: #true)
def pbmt_napot = RV2WideConfig(~svpbmt: #true, ~svnapot: #true, ~floating_point: FloatingPointProfile.D)
def invalidation = RV2WideConfig(~svinval: #true)
def invalidation_fp = RV2WideConfig(~svinval: #true, ~svnapot: #true, ~svpbmt: #true, ~floating_point: FloatingPointProfile.D)
def napot = RV2WideConfig(~svnapot: #true)
def napot_fp = RV2WideConfig(~svnapot: #true, ~floating_point: FloatingPointProfile.D)
def double = RV2WideConfig(~floating_point: FloatingPointProfile.D)
def zfa = RV2WideConfig(~floating_point: FloatingPointProfile.D, ~zfa: #true)
def half_min = RV2WideConfig(~floating_point: FloatingPointProfile.D, ~half_precision: HalfPrecisionProfile.Zfhmin)
def half = RV2WideConfig(~floating_point: FloatingPointProfile.D, ~half_precision: HalfPrecisionProfile.Zfh, ~zfa: #true)
def zcb = RV2WideConfig(~compressed: compressed_extensions(CompressedExtension.C, CompressedExtension.Zcb))
def zcmop = RV2WideConfig(~compressed: compressed_extensions(CompressedExtension.C, CompressedExtension.Zcmop))
def compressed_fp = RV2WideConfig(~floating_point: FloatingPointProfile.D, ~compressed: compressed_extensions(CompressedExtension.C, CompressedExtension.Zcb, CompressedExtension.Zcmop))

check:
  supervisor.csr_config.ssnpm ~is #true
  supervisor.csr_config.sscofpmf ~is #true
  supervisor.csr_config.smstateen ~is #true
  sha.csr_config.hypervisor ~is #true
  RV2WideConfig(~supm: #true) ~throws "Supm requires Ssnpm"
  supervisor.isa_profile.isa_extensions ~is integer.isa_profile.isa_extensions ++ ["ssnpm", "supm", "sscofpmf", "smstateen", "ssstateen"]
  hypervisor.isa_profile.misa_extension_bits ~is integer.isa_profile.misa_extension_bits + 128
  sha.isa_profile.isa_extensions.contains("sha") ~is #true
  integer.svinval ~is #false
  invalidation.isa_profile.isa_extensions ~is integer.isa_profile.isa_extensions ++ ["svinval"]
  invalidation_fp.isa_profile.isa_extensions ~is pbmt_napot.isa_profile.isa_extensions ++ ["svinval"]
  invalidation.isa_profile.misa_extension_bits ~is integer.isa_profile.misa_extension_bits
  invalidation.hart_description.isa_profile ~is invalidation.isa_profile
  invalidation.csr_config.isa_profile ~is invalidation.isa_profile
  integer.svpbmt ~is #false
  integer.csr_config.svpbmt ~is #false
  pbmt.csr_config.svpbmt ~is #true
  pbmt.isa_profile.isa_extensions ~is integer.isa_profile.isa_extensions ++ ["svpbmt"]
  pbmt_napot.isa_profile.isa_extensions ~is double.isa_profile.isa_extensions ++ ["svnapot", "svpbmt"]
  pbmt.hart_description.isa_profile ~is pbmt.isa_profile
  pbmt.csr_config.isa_profile ~is pbmt.isa_profile
  pbmt.isa_profile.misa_extension_bits ~is integer.isa_profile.misa_extension_bits
  integer.svnapot ~is #false
  napot.isa_profile.isa_extensions ~is integer.isa_profile.isa_extensions ++ ["svnapot"]
  napot_fp.isa_profile.isa_extensions ~is double.isa_profile.isa_extensions ++ ["svnapot"]
  napot.isa_profile.misa_extension_bits ~is integer.isa_profile.misa_extension_bits
  napot.hart_description.isa_profile ~is napot.isa_profile
  napot.csr_config.isa_profile ~is napot.isa_profile
  timer.isa_profile.isa_extensions ~is integer.isa_profile.isa_extensions ++ ["sstc"]
  timer.isa_profile.misa_extension_bits ~is integer.isa_profile.misa_extension_bits
  timer.csr_config.sstc ~is #true
  integer.csr_config.sstc ~is #false
  locality.isa_profile.isa_extensions ~is integer.isa_profile.isa_extensions ++ ["zihintntl"]
  locality.isa_profile.misa_extension_bits ~is integer.isa_profile.misa_extension_bits
  pause.isa_profile.isa_extensions ~is integer.isa_profile.isa_extensions ++ ["zihintpause"]
  pause.isa_profile.misa_extension_bits ~is integer.isa_profile.misa_extension_bits
  wait.isa_profile.isa_extensions ~is integer.isa_profile.isa_extensions ++ ["zawrs"]
  wait.isa_profile.misa_extension_bits ~is integer.isa_profile.misa_extension_bits
  integer.bht ~is #true
  RV2WideConfig(~bht: #false).bht ~is #false
  RV2WideConfig(~bht: #false).isa_profile ~is integer.isa_profile
  prefetch.isa_profile.isa_extensions ~is integer.isa_profile.isa_extensions ++ ["zicbop"]
  prefetch.isa_profile.misa_extension_bits ~is integer.isa_profile.misa_extension_bits
  management.isa_profile.isa_extensions ~is integer.isa_profile.isa_extensions ++ ["zicbom"]
  management.csr_config.zicbom ~is #true
  management.csr_config.zicboz ~is #false
  management.isa_profile.misa_extension_bits ~is integer.isa_profile.misa_extension_bits
  cmo.isa_profile.isa_extensions ~is integer.isa_profile.isa_extensions ++ ["zicboz", "zicbom"]
  zero.isa_profile.isa_extensions ~is integer.isa_profile.isa_extensions ++ ["zicboz"]
  zero.isa_profile.misa_extension_bits ~is integer.isa_profile.misa_extension_bits
  zero.csr_config.zicboz ~is #true
  zero.hart_description.cbo_block_bytes ~is 64
  integer.zfa ~is #false
  double.zfa ~is #false
  integer.isa_profile.isa_extensions.contains("zfa") ~is #false
  double.isa_profile.isa_extensions.contains("zfa") ~is #false
  zfa.isa_profile.isa_extensions ~is double.isa_profile.isa_extensions ++ ["zfa"]
  zfa.isa_profile.misa_extension_bits ~is double.isa_profile.misa_extension_bits
  zfa.hart_description.isa_profile ~is zfa.isa_profile
  RV2WideConfig(~zfa: #true) ~throws "Zfa requires floating-point support"
  double.half_precision ~is HalfPrecisionProfile.None
  half_min.isa_profile.isa_extensions ~is double.isa_profile.isa_extensions ++ ["zfhmin"]
  half.isa_profile.isa_extensions ~is zfa.isa_profile.isa_extensions ++ ["zfh"]
  half.isa_profile.misa_extension_bits ~is double.isa_profile.misa_extension_bits
  half.hart_description.isa_profile ~is half.isa_profile
  RV2WideConfig(~half_precision: HalfPrecisionProfile.Zfhmin) ~throws "require a base F or D"
  RV2WideConfig(~half_precision: HalfPrecisionProfile.Zfh) ~throws "require a base F or D"
  integer.compressed ~is CCompressedExtensions
  zcb.isa_profile.isa_extensions ~is integer.isa_profile.isa_extensions ++ ["zcb"]
  zcmop.isa_profile.isa_extensions ~is integer.isa_profile.isa_extensions ++ ["zcmop"]
  compressed_fp.isa_profile.isa_extensions ~is double.isa_profile.isa_extensions ++ ["zcb", "zcmop"]
  zcb.isa_profile.misa_extension_bits ~is integer.isa_profile.misa_extension_bits
  compressed_fp.isa_profile.misa_extension_bits ~is double.isa_profile.misa_extension_bits
  compressed_fp.csr_config.compressed ~is compressed_fp.compressed
  compressed_fp.hart_description.isa_profile ~is compressed_fp.isa_profile
  RV2WideConfig(~compressed: []) ~throws "requires C"
  RV2WideConfig(~compressed: [CompressedExtension.Zca, CompressedExtension.Zcb]) ~throws "requires C"
  RV2WideConfig(~compressed: [CompressedExtension.Zcb]) ~throws "requires Zca or C"
  RV2WideConfig(~compressed: [CompressedExtension.C, CompressedExtension.Zcb, CompressedExtension.Zcb]) ~throws "duplicate"
  RV2WideConfig(~compressed: [CompressedExtension.C, CompressedExtension.Zcd]) ~throws "already supplies"

for (profile in [supervisor, hypervisor, sha, integer, zero, management, cmo, prefetch, wait, pause, locality, timer, invalidation, invalidation_fp, napot, napot_fp, pbmt, pbmt_napot, double, zfa, half_min, half, zcb, zcmop, compressed_fp]):
  def configuration = rv2wide_udb_configuration(profile, "rv2wide-test", "RV2Wide profile contract", 44)
  def extensions = configuration.extensions.map(fun (extension): extension.name)
  check:
    extensions.contains("Ssnpm") ~is profile.ssnpm
    extensions.contains("Supm") ~is profile.supm
    extensions.contains("Sscofpmf") ~is profile.sscofpmf
    extensions.contains("Smstateen") ~is profile.smstateen
    extensions.contains("Ssstateen") ~is profile.smstateen
    extensions.contains("H") ~is profile.hypervisor
    extensions.contains("Sha") ~is (profile.hypervisor && profile.smstateen)
    extensions.contains("Svinval") ~is profile.svinval
    configuration.extensions.filter(~keep: fun (extension): extension.name == "Svinval").map(fun (extension): extension.version) ~is (if profile.svinval | ["1.0.0"] | [])
    extensions.contains("Svpbmt") ~is profile.svpbmt
    configuration.extensions.filter(~keep: fun (extension): extension.name == "Svpbmt").map(fun (extension): extension.version) ~is (if profile.svpbmt | ["1.0.0"] | [])
    extensions.contains("Svnapot") ~is profile.svnapot
    configuration.extensions.filter(~keep: fun (extension): extension.name == "Svnapot").map(fun (extension): extension.version) ~is (if profile.svnapot | ["1.0.0"] | [])
    extensions.contains("Sstc") ~is profile.sstc
    extensions.contains("Zihintntl") ~is profile.zihintntl
    extensions.contains("Zihintpause") ~is profile.zihintpause
    extensions.contains("Zawrs") ~is profile.zawrs
    extensions.contains("Zicbop") ~is profile.zicbop
    extensions.contains("Zicbom") ~is profile.zicbom
    extensions.contains("Zicboz") ~is profile.zicboz
    extensions.contains("Zfa") ~is profile.zfa
    extensions.contains("F") ~is (profile.floating_point == FloatingPointProfile.D)
    extensions.contains("D") ~is (profile.floating_point == FloatingPointProfile.D)
    extensions.contains("Zfhmin") ~is half_precision_supports_zfhmin(profile.half_precision)
    extensions.contains("Zfh") ~is half_precision_supports_zfh(profile.half_precision)
    extensions.contains("Zcb") ~is profile.compressed.contains(CompressedExtension.Zcb)
    extensions.contains("Zcmop") ~is profile.compressed.contains(CompressedExtension.Zcmop)
    extensions.contains("C") ~is #true
    extensions.contains("Zcd") ~is (profile.floating_point == FloatingPointProfile.D)
  check:
    configuration.extensions.filter(~keep: fun (extension): extension.name == "Zfa").map(fun (extension): extension.version) ~is (if profile.zfa | ["1.0.0"] | [])

def wait_configuration = rv2wide_udb_configuration(wait, "rv2wide-wait", "RV2Wide reservation waits", 44)
def timer_configuration = rv2wide_udb_configuration(timer, "rv2wide-timer", "RV2Wide supervisor timer", 44)
check:
  timer_configuration.extensions.filter(~keep: fun (extension): extension.name == "Sstc").map(fun (extension): extension.version) ~is ["1.0.0"]
  wait_configuration.parameters.filter(~keep: fun (parameter): parameter.name == "ZAWRS_NTO_IS_NOP").map(fun (parameter): parameter.value.to_yaml()) ~is ["false"]
