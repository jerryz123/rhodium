import:
  lib("flow/main.rhdl") open
  "../mmu.rhdl" open
  "../bundles.rhdl" open
  "cache-fixture.rhdl" open
  "../../cache/protocol.rhdl" open
  "../../cache/operation.rhdl" open
  "../../cache-prefetch.rhdl" open
  lib("riscv/rtl/atomic.rhdl") open
  "../../load-store.rhdl" open
  lib("riscv/rtl/privilege.rhdl") open
  lib("riscv/isa/xlen.rhm") open

sync_circuit RV2WideMmuFixture():
  input privilege: Bits(2)
  input(satp, mstatus): Bits(64)
  input invalidate: Bool
  interface prefetch(Valid(CachePrefetchReq(64)), ~role: consumer)
  interface physical_prefetch(Valid(CachePrefetchReq(64)), ~role: producer)
  input fetch_valid: Bool
  input fetch_address: Bits(64)
  output fetch_resolution: RV2WideResolution()
  output fetch_physical: Bits(64)
  input(ex_valid, wb_valid, commit): Bool
  input access: CacheOperation
  input address: Bits(64)
  input split_valid: Bool
  input split_width: MemoryWidth
  input split_data: Bits(64)
  output split_ready: Bool
  output split_completed: Bool
  output split_result: Bits(64)
  output(split_page_fault, split_access_fault): Bool
  output split_fault_address: Bits(64)
  output(index_valid, resolve_valid, result_valid): Bool
  output(index_address, resolve_address): Bits(64)
  output outcome: RV2WideCacheOutcome
  output wb_fault: Bool
  output wb_fault_bits: RV2WideResolution()
  output wb_ready: Bool
  input(physical_ready, physical_fault, response_valid): Bool
  input response_data: Bits(64)
  output physical_valid: Bool
  output physical_address: Bits(64)
  output physical_access: CacheOperation
  output physical_data: Bits(64)
  output physical_mask: Bits(8)
  output response_ready: Bool
  output completed: Bool
  output completed_data: Bits(64)
  inst mmu(RV2WideMmu(test_fetch_chi))
  mmu.state <== RV2WideTranslationState():
    privilege: privilege.into(PrivilegeMode)
    satp: satp
    mstatus: mstatus
  mmu.invalidate <== invalidate
  prefetch |> mmu.prefetch
  mmu.physical_prefetch |> physical_prefetch
  mmu.instruction.request.valid <== fetch_valid
  mmu.instruction.request.bits <== fetch_address
  fetch_resolution <== mmu.instruction.resolution
  fetch_physical <== mmu.instruction.address
  def request = RV2WideMemoryReq():
    address: address
    access: access
    atomic: RiscvAtomicOperation.Swap
    width: MemoryWidth.Double
    data: bits(0, 64)
    mask: bits(0xff, 8)
  mmu.pipeline.request.valid <== ex_valid
  mmu.pipeline.request.bits <== request
  mmu.pipeline.commit <== commit
  mmu.physical_pipeline.commit_ready <== Bool(#true)
  mmu.physical_pipeline.response.valid <== mmu.physical_pipeline.request.valid
  mmu.physical_pipeline.response.bits <== CachePipelineResult(XLen.X64):
    outcome: CachePipelineOutcome.LoadHit
    reason: CachePipelineReason.None
    data: bits(0xabcd, 64)
  index_valid <== mmu.pipeline_lookup.valid
  index_address <== mmu.pipeline_lookup.bits.address
  resolve_valid <== mmu.physical_pipeline.request.valid
  resolve_address <== mmu.physical_pipeline.request.bits.address
  result_valid <== mmu.pipeline.response.valid
  outcome <== mmu.pipeline.response.bits.outcome
  mmu.memory.request.valid <== wb_valid
  mmu.memory.request.bits <== request
  mmu.split.request.valid <== split_valid
  mmu.split.request.bits <== PhysicalMemoryReq(XLen.X64, Bool):
    address: address
    access: access
    atomic: RiscvAtomicOperation.Swap
    width: split_width
    unsigned: Bool(#true)
    data: split_data
    byte_mask: bits(0, 8)
    context: Bool(#false)
    locality: literal(mmu.split.request.bits.locality.type, 0)
  split_ready <== mmu.split.request.ready
  split_completed <== mmu.split.response.valid
  split_result <== mmu.split.response.bits.response.data
  split_page_fault <== mmu.split.response.bits.page_fault
  split_access_fault <== mmu.split.response.bits.response.access_fault
  split_fault_address <== mmu.split.response.bits.fault_address
  wb_ready <== mmu.memory.request.ready
  wb_fault <== mmu.memory.fault.valid
  wb_fault_bits <== mmu.memory.fault.bits
  mmu.memory.response.ready <== Bool(#true)
  completed <== mmu.memory.response.valid
  completed_data <== mmu.memory.response.bits
  mmu.physical_memory.request.ready <== physical_ready & !physical_fault
  mmu.physical_memory.fault.valid <== mmu.physical_memory.request.valid & physical_fault
  mmu.physical_memory.fault.bits <== RV2WideResolution():
    disposition: RV2WideDisposition.Fault
    cause: bits(5, 64)
    value: mmu.physical_memory.request.bits.address
  mmu.physical_memory.response.valid <== response_valid
  mmu.physical_memory.response.bits <== response_data
  mmu.physical_memory.drained <== Bool(#true)
  mmu.physical_memory.ordered_busy <== Bool(#false)
  mmu.physical_memory.reservation_valid <== Bool(#false)
  physical_valid <== mmu.physical_memory.request.valid
  physical_address <== mmu.physical_memory.request.bits.address
  physical_access <== mmu.physical_memory.request.bits.access
  physical_data <== mmu.physical_memory.request.bits.data
  physical_mask <== mmu.physical_memory.request.bits.mask
  response_ready <== mmu.physical_memory.response.ready

export:
  RV2WideMmuFixture
