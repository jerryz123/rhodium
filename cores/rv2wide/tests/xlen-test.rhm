#lang rhombus
// SPDX-License-Identifier: Apache-2.0
import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/hart.rhm").RiscvMmuType
  "../rv2wide.rhdl".RV2Wide
  "../profile.rhm".RV2WideConfig
  "cache-fixture.rhdl" open

fun child(parent, name):
  parent.operations.find(fun (op): op.opcode == "rtl.instance" && op.attribute("name") == name).attribute("module")

for (xlen in [XLen.X32, XLen.X64]):
  def profile = RV2WideConfig(~xlen: xlen, ~mmu_type: RiscvMmuType.Bare, ~instruction_cache: test_cache, ~data_cache: test_cache, ~ssnpm: xlen == XLen.X64, ~supm: xlen == XLen.X64, ~btb_entries: 0, ~ras_entries: 0, ~bht: #false)
  def design = compile_program(elaborate(RV2Wide(test_cache, ~chi: test_fetch_chi, ~profile: profile)), rtl_target).report.design
  def core = design.modules.find(fun (module_def): module_def.name == "RV2Wide")
  def memory = design.modules.find(fun (module_def): module_def.name == "RV2WideBareMemory")
  def execution = design.modules.find(fun (module_def): module_def.name == "RV2WideCore")
  def retired = core.find_output("retired_0_out").type.field("bits").type
  def completed = core.find_output("completed_out").type.field("bits").type
  def window = child(execution, "rr_window")
  def entries = window.operations.find(fun (op): op.opcode == "rtl.register" && op.attribute("name") == "entries")
  def fetched_width = retired.field("fetched").type.packed_width()
  def full_fault_width = retired.field("fetched").type.field("fault").type.packed_width()
  def compact_fault_width = 3 + xlen.width // Non-H: kind and full fault address.
  def step_width = if xlen == XLen.X32 | 6 | 7 // Last changed bit and short-step flag.
  def fifo = child(child(execution, "wb_load_response"), "owners")
  def queue_storage = fifo.memories.find(fun (mem): mem.name == "storage")
  check:
    entries.results[0].type.element_type.field("fault").type.packed_width() ~is compact_fault_width
    entries.results[0].type.element_type.field("step").type.packed_width() ~is step_width
    entries.results[0].type.packed_width() ~is 8 * (fetched_width - 2 * xlen.width + step_width - full_fault_width + compact_fault_width)
    completed.field("identity").type.packed_width() ~is xlen.width + 32
    completed.packed_width() ~is 2 * xlen.width + 38
    queue_storage.depth ~is 4
    queue_storage.element_type.field("destination").type.field("identity").type.packed_width() ~is xlen.width + 32

  for (stage in ["ex", "mem", "wb"]):
    def prefix_name = stage ++ "_pc_region"
    def prefix = execution.operations.find(fun (op): op.opcode == "rtl.register" && op.attribute("name") == prefix_name)
    check:
      prefix.results[0].type.packed_width() ~is xlen.width - 12

    for (slot in ["older", "younger"]):
      def lane = child(execution, stage ++ "_" ++ slot)
      def full = lane.find_output("egress_out").type.field("bits").type
      def storage = child(lane, "storage")
      def payload = storage.operations.find(fun (op): op.opcode == "rtl.register" && op.attribute("name") == "stage_bits")
      def aliases = if stage == "ex" | 2 | 3 // Includes the prediction PC.
      def fault_width = if stage == "ex" | compact_fault_width | 1
      unless stage == "ex"
      | check: payload.results[0].type.element_type.field("resolution").type.field("cause").type.width ~is 5

      check:
        payload.results[0].type.element_type.field("fetched").type.field("pc").type.width ~is 12
        payload.results[0].type.element_type.field("fetched").type.field("fault").type.packed_width() ~is fault_width
        payload.results[0].type.element_type.field("fetched").type.field("sequential_pc").type.packed_width() ~is step_width
        payload.results[0].type.packed_width() ~is full.packed_width() - (xlen.width - 12) - aliases * xlen.width - (xlen.width - step_width) - full_fault_width + fault_width

  check:
    execution.find_output("redirect_out").type.field("bits").type.field("resolution").type.field("cause").type.width ~is xlen.width
    retired.field("data").type.width ~is xlen.width
    retired.field("fetched").type.field("pc").type.width ~is xlen.width
    core.find_input("start_in").type.field("bits").type.width ~is 64
    memory.find_input("state").type.field("satp").type.width ~is xlen.width
    execution.find_output("memory_out").type.field("request").type.field("bits").type.field("address").type.width ~is xlen.width
    memory.find_output("physical_memory_out").type.field("request").type.field("bits").type.field("address").type.width ~is 64
    design.modules.filter(~keep: fun (module_def): module_def.name == "RiscvTranslationWalker").length() ~is 0
