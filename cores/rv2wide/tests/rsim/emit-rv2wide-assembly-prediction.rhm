#lang rhombus
// Defines production assembly for directed prediction repair and continuation tests.
// SPDX-License-Identifier: Apache-2.0
import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("riscv/isa/fp-profile.rhm").FloatingPointProfile
  "../../profile.rhm".RV2WideConfig
  "../../instruction-assembler.rhdl".RV2WideInstructionAssembler

def program = elaborate(RV2WideInstructionAssembler(RV2WideConfig(~floating_point: FloatingPointProfile.D), ~pc_width: 45))
def guest_program = elaborate(RV2WideInstructionAssembler(RV2WideConfig(~floating_point: FloatingPointProfile.D, ~hypervisor: #true), ~pc_width: 45))
def full_width_program = elaborate(RV2WideInstructionAssembler(RV2WideConfig(~floating_point: FloatingPointProfile.D)))
export program guest_program full_width_program
