#lang rhombus
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/fp-profile.rhm").FloatingPointProfile
  lib("riscv/isa/vector-profile.rhm").VectorProfile
  "../../core.rhdl".RV2WideCore
  "../../profile.rhm".RV2WideConfig

def program = elaborate(RV2WideCore(RV2WideConfig(~floating_point: FloatingPointProfile.D, ~vector: VectorProfile.V)))
def rv32_program = elaborate(RV2WideCore(RV2WideConfig(~xlen: XLen.X32, ~vector: VectorProfile.Zve32x, ~vector_length: 64)))
export:
  program
  rv32_program
