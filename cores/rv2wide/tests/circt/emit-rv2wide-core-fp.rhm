import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("riscv/isa/fp-profile.rhm") open
  lib("cores/fp/timing.rhdl") open
  "../../profile.rhm" open
  "../../core.rhdl" open

def program = elaborate(RV2WideCore(RV2WideConfig(~floating_point: FloatingPointProfile.D), ~fp_timing: FpExecutionTiming(3, 5, 2)))
export program
