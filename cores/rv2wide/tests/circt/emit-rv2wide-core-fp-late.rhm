#lang rhombus
/* Exercises colliding five-cycle integer multiply and FP-to-GPR writeback bookings. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("riscv/isa/fp-profile.rhm") open
  lib("cores/fp/timing.rhdl") open
  "../../profile.rhm" open
  "../../core.rhdl" open

def program = elaborate(RV2WideCore(RV2WideConfig(~floating_point: FloatingPointProfile.D, ~half_precision: HalfPrecisionProfile.Zfhmin, ~zfa: #true, ~zihintntl: #true), ~fp_timing: FpExecutionTiming(3, 5, 5)))
export program
