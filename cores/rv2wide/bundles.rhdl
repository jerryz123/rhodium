#lang rhodium
/* Defines instruction, pipeline, memory transaction, and retirement payloads for RV2Wide. */
// SPDX-License-Identifier: Apache-2.0

import:
  "decode/core-ctrl.rhdl" open
  "decode/mem-ctrl.rhdl" open
  "decode/system-ctrl.rhdl" open
  "decode/long-ctrl.rhdl" open
  lib("flow/main.rhdl") open
  lib("cores/load-store.rhdl").MemoryWidth
  lib("riscv/rtl/privilege.rhdl").PrivilegeMode

/* Exposes WB-owned architectural translation controls without pipeline payload coupling. */
bundle RV2WideTranslationState():
  privilege: PrivilegeMode
  mstatus: Bits(64)
  satp: Bits(64)

/* Resolves an S1 virtual PC combinationally; a miss requests local fetch replay. */
interface RV2WideInstructionTranslation():
  role requester
  role responder
  provider requester
  requester -> responder:
    request: Valid(Bits(64))
  responder -> requester:
    address: Bits(64)
    resolution: RV2WideResolution()

/* Retains the architectural cause and faulting address independently of instruction data. */
bundle RV2WideFetchFault():
  valid: Bool
  cause: Bits(64)
  value: Bits(64)

/* Retains canonical decode bits, original encoding, and the length-derived successor through retirement. */
bundle RV2WideInstruction():
  pc: Bits(64)
  instruction: Bits(32)
  raw_instruction: Bits(32)
  sequential_pc: Bits(64)
  compressed_illegal: Bool
  fault: RV2WideFetchFault()

/* Offers a nonempty prefix of up to two instructions to the issue window. */
bundle RV2WidePacket():
  count: Bits(2)
  entries: Vec(2, RV2WideInstruction())

/* Distinguishes MEM continuation, synchronous trap, preacceptance replay, and WB system recovery. */
hardware_enum RV2WideDisposition:
  Continue
  Fault
  Replay
  System

/* Supplies a same-cycle MEM outcome; fault payload is observed only for Fault. */
bundle RV2WideResolution():
  disposition: RV2WideDisposition
  cause: Bits(64)
  value: Bits(64)

/* Holds RR-selected operands and decoded controls across the EX boundary. */
bundle RV2WideExecute():
  fetched: RV2WideInstruction()
  control: RV2WideControl()
  rs1: Bits(64)
  rs2: Bits(64)
  rd: Bits(5)
  illegal: Bool

/* Distinguishes a fixed-latency hit, retry, authorized slow service, or translation fault. */
hardware_enum RV2WideCacheOutcome:
  Slow
  LoadHit
  StoreHit
  Replay
  PageFault
  AccessFault

/* Retains one result, control transfer, and fault/replay outcome through MEM and WB. */
bundle RV2WideResult():
  fetched: RV2WideInstruction()
  rd: Bits(5)
  write: Bool
  data: Bits(64)
  result_ready: Bool
  taken: Bool
  target: Bits(64)
  memory: RV2WideMemoryControl()
  address: Bits(64)
  store_data: Bits(64)
  cache_outcome: RV2WideCacheOutcome
  system: RV2WideSystemControl()
  csr_source: Bits(64)
  muldiv: RV2WideLongControl()
  left: Bits(64)
  right: Bits(64)
  resolution: RV2WideResolution()

/* Carries exact byte address/width with positioned store data and mask in its aligned beat. */
bundle RV2WideMemoryReq():
  address: Bits(64)
  write: Bool
  width: MemoryWidth
  data: Bits(64)
  mask: Bits(8)

/* Returns the MEM decision and raw aligned load beat; no allocation or mutation occurs here. */
bundle RV2WideLookupResult():
  outcome: RV2WideCacheOutcome
  data: Bits(64)

/* Pairs an EX lookup with next-cycle MEM feedback and a one-cycle WB store candidate. */
interface RV2WidePipelineAccess():
  role requester
  role responder
  provider requester
  requester -> responder:
    request: Valid(RV2WideMemoryReq())
    commit: Bool
  responder -> requester:
    response: Valid(RV2WideLookupResult())
    commit_ready: Bool

/* Authorizes slow transactions at WB. Admission resolves all synchronous faults;
   accepted responses are successful, ordered raw beats, including store acknowledgements.
   A fault prevents request acceptance. Drained also covers committed hit stores;
   registered ordered_busy prevents younger memory effects, including earlier lookup hits.
   Reset must reset both participants together. */
interface RV2WideMemory():
  role requester
  role responder
  provider requester
  requester -> responder:
    request: Decoupled(RV2WideMemoryReq())
  responder -> requester:
    fault: Valid(RV2WideResolution())
    response: Decoupled(Bits(64))
    drained: Bool
    ordered_busy: Bool

/* Reports one successfully retired instruction and its optional architectural GPR write. */
bundle RV2WideRetirement():
  fetched: RV2WideInstruction()
  rd: Bits(5)
  write: Bool
  data: Bits(64)
  deferred: Bool

/* Reports MEM branch recovery or the older WB fault/replay override; Continue is not retirement. */
bundle RV2WideRedirect():
  pc: Bits(64)
  target: Bits(64)
  resolution: RV2WideResolution()

/* Describes a youngest-older operand match, including results not yet usable. */
bundle RV2WideOperand():
  blocked: Bool
  data: Bits(64)

export:
  RV2WideTranslationState
  RV2WideInstructionTranslation
  RV2WideFetchFault
  RV2WideInstruction
  RV2WidePacket
  RV2WideDisposition
  RV2WideResolution
  RV2WideExecute
  RV2WideResult
  RV2WideMemoryReq
  RV2WideCacheOutcome
  RV2WideLookupResult
  RV2WidePipelineAccess
  RV2WideMemory
  RV2WideRetirement
  RV2WideRedirect
  RV2WideOperand
