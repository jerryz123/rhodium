#lang rhodium
/* Maps CSR and privileged instructions to shared architectural actions and core serialization. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/reservation-wait.rhdl").ReservationWaitMode
  "../../csr/decode.rhdl" open
  lib("cores/csr/protocol.rhdl").RiscvCsrAction
  lib("riscv/isa/rv64i.rhm") open
  lib("riscv/isa/m.rhm") open
  lib("riscv/isa/a.rhm") open
  lib("riscv/isa/b.rhm") open
  lib("riscv/isa/zicond.rhm") open
  lib("riscv/isa/zimop.rhm") open
  lib("riscv/isa/zicsr.rhm") open
  lib("riscv/isa/zifencei.rhm") open
  lib("riscv/isa/privileged.rhm") open
  lib("riscv/isa/svinval.rhm") open
  lib("riscv/rtl/csr.rhdl").RiscvCsrOperation
  lib("riscv/rtl/decode.rhdl") open
  lib("rhodium/std/decode.rhdl") open

/* Selects data draining or instruction snapshot invalidation at the WB boundary. */
hardware_enum RV2WideFence:
  None
  Memory
  Instruction

/* Separates source mode from architectural CSR intent, fences, and trap/return/wait action. */
bundle RV2WideSystemControl():
  csr: RiscvCsrOperation
  immediate: Bool
  action: RiscvCsrAction
  fence: RV2WideFence
  wait: ReservationWaitMode

  /* Identifies operations using the single WB command path, independently of read ordering. */
  method uses_command(control) :: Bool:
    (control.csr =/= RiscvCsrOperation.None) ||| (control.action =/= RiscvCsrAction.None) ||| (control.fence =/= RV2WideFence.None) ||| (control.wait =/= ReservationWaitMode.None)

def RV2WidePrivilegedInstructions = [MRET, SRET, WFI, SFENCE_VMA]
def RV2WideSystemInstructions = [ECALL, EBREAK, FENCE, FENCE_I] ++ ZicsrInstructions ++ RV2WidePrivilegedInstructions
def base_system_cases = decode_groups(RV2WideSystemControl(), ~input: instruction_pattern):
  group excluding_instructions(RV64IInstructions ++ RV64MInstructions ++ RV64AInstructions ++ RV64BInstructions ++ ZicondInstructions ++ ZimopInstructions, [ECALL, EBREAK, FENCE]):
    wait: ReservationWaitMode.None
    fence: RV2WideFence.None
    csr: RiscvCsrOperation.None
    action: RiscvCsrAction.None

  [FENCE]:
    wait: ReservationWaitMode.None
    csr: RiscvCsrOperation.None
    action: RiscvCsrAction.None
    fence: RV2WideFence.Memory

  [FENCE_I]:
    wait: ReservationWaitMode.None
    csr: RiscvCsrOperation.None
    action: RiscvCsrAction.None
    fence: RV2WideFence.Instruction

def csr_inactive = partial_pattern(RV2WideSystemControl()):
  wait: ReservationWaitMode.None
  fence: RV2WideFence.None
  action: RiscvCsrAction.None

def system_inactive = partial_pattern(RV2WideSystemControl()):
  wait: ReservationWaitMode.None
  fence: RV2WideFence.None

def RV2WideSystemCases = base_system_cases
  ++ csr_system_cases(RV2WideSystemControl(), system_inactive, [ECALL, EBREAK] ++ RV2WidePrivilegedInstructions)
  ++ csr_access_cases(RV2WideSystemControl(), csr_inactive)

// Full invalidation ignores address/ASID operands; ordering retains its own privilege rule.
def RV2WideInvalidationCases = csr_system_cases(RV2WideSystemControl(), system_inactive, [SINVAL_VMA, SFENCE_W_INVAL, SFENCE_INVAL_IR])

export:
  RV2WideInvalidationCases
  RV2WideFence
  RV2WideSystemControl
  RV2WideSystemInstructions
  RV2WidePrivilegedInstructions
  RV2WideSystemCases
