#lang rhodium
/* Maps scalar, atomic, and cache-block instructions to shared physical cache controls. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../../memory-decode.rhdl" open
  lib("cores/load-store.rhdl") open
  lib("cores/cache/operation.rhdl") open
  lib("riscv/rtl/atomic.rhdl") open
  lib("riscv/isa/a.rhm") open
  lib("riscv/isa/rv64i.rhm") open
  lib("riscv/isa/zicboz.rhm") open
  lib("riscv/isa/zicbom.rhm") open
  lib("riscv/rtl/decode.rhdl") open
  lib("rhodium/std/decode.rhdl") open

/* Enables one memory operation with its ownership class, AMO function, and result projection. */
bundle RV2WideMemoryControl():
  enable: Bool
  access: CacheOperation
  atomic: RiscvAtomicOperation
  width: MemoryWidth
  unsigned: Bool

/* Adds the caller's validity bit without constraining inactive physical controls. */
fun enabled_cases(cases :: List.of(DecodeCase)) :: List.of(DecodeCase):
  for List (entry in cases):
    DecodeCase(entry.input, entry.output.intersection(partial_pattern(RV2WideMemoryControl()): enable: Bool(#true)).terms[0])

def block_cases = cache_block_memory_cases(RV2WideMemoryControl())
/* Keeps the two-wide whole-line token's width while reusing operation mappings. */
fun block_cases_for(instructions :: List.of(InstructionSpec)) :: List.of(DecodeCase):
  def cases = for List (instruction in instructions):
    DecodeCase(instruction_pattern(instruction), component_output(block_cases, instruction_pattern(instruction)).intersection(partial_pattern(RV2WideMemoryControl()): width: MemoryWidth.Double).terms[0])
  enabled_cases(cases)
def RV2WideZeroCases = block_cases_for(ZicbozInstructions)
def RV2WideManagementCases = block_cases_for(ZicbomInstructions)
def RV2WideLoads = RiscvWordLoads ++ RiscvDoubleLoads
def RV2WideStores = RiscvWordStores ++ RiscvDoubleStores
def RV2WideMemoryCases = enabled_cases(scalar_memory_cases(RV2WideMemoryControl(), ~double: #true)) ++ instruction_cases(
  excluding_instructions(RV64IInstructions, RV2WideLoads ++ RV2WideStores),
  partial_pattern(RV2WideMemoryControl()): enable: Bool(#false)
)
def RV2WideAtomicCases = enabled_cases(atomic_memory_cases(RV2WideMemoryControl(), ~double: #true))

export:
  RV2WideMemoryControl
  RV2WideMemoryCases
  RV2WideAtomicCases
  RV2WideZeroCases
  RV2WideManagementCases
  RV2WideLoads
  RV2WideStores
