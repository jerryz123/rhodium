#lang rhodium
/* Composes shared ALU/branch relations and RV2Wide operand, memory, writeback, and system columns. */
// SPDX-License-Identifier: Apache-2.0

import:
  "operand-ctrl.rhdl" open
  "mem-ctrl.rhdl" open
  "system-ctrl.rhdl" open
  lib("cores/alu.rhdl") open
  lib("cores/riscv/alu-decode.rhdl") open
  lib("cores/riscv/branch-decode.rhdl") open
  lib("riscv/isa/rv64i.rhm") open
  lib("riscv/isa/zicsr.rhm") open
  lib("riscv/isa/zifencei.rhm") open
  lib("riscv/rtl/decode.rhdl") open
  lib("rhodium/std/decode.rhdl") open

/* Enables architectural writes and selects the link value instead of an ALU result. */
bundle RV2WideWritebackControl():
  enable: Bool
  link: Bool

/* Carries independently authored physical controls without an instruction-kind enum. */
bundle RV2WideControl():
  alu: AluControl()
  operand: RV2WideOperandControl()
  branch: RiscvBranchControl()
  memory: RV2WideMemoryControl()
  writeback: RV2WideWritebackControl()
  system: RV2WideSystemControl()

def RV2WideInstructions = RV64IInstructions ++ ZicsrInstructions ++ ZifenceiInstructions ++ RV2WidePrivilegedInstructions
def system_alu_cases = instruction_cases(ZicsrInstructions ++ ZifenceiInstructions ++ RV2WidePrivilegedInstructions, unused_alu)
def system_memory_cases = instruction_cases(ZicsrInstructions ++ ZifenceiInstructions ++ RV2WidePrivilegedInstructions, partial_pattern(RV2WideMemoryControl()): enable: Bool(#false))
def core_branch_cases = branch_cases(RV2WideInstructions)
def branches = [BEQ, BNE, BLT, BGE, BLTU, BGEU]
def jumps = [JAL, JALR]
def RV2WideWritebackCases = decode_groups(RV2WideWritebackControl(), ~input: instruction_pattern):
  group branches ++ RV2WideStores ++ [ECALL, EBREAK, FENCE, FENCE_I] ++ RV2WidePrivilegedInstructions:
    enable: Bool(#false)
  group jumps:
    enable: Bool(#true)
    link: Bool(#true)
  group ZicsrInstructions:
    enable: Bool(#true)
  group excluding_instructions(RV2WideInstructions, branches ++ jumps ++ RV2WideStores ++ [ECALL, EBREAK, FENCE, FENCE_I] ++ RV2WidePrivilegedInstructions ++ ZicsrInstructions):
    enable: Bool(#true)
    link: Bool(#false)

/* Joins exact canonical input patterns, preserving each component's inactive care masks. */
fun compose_control_cases(instructions :: List.of(InstructionSpec)):
  for List (instruction in instructions):
    def input = instruction_pattern(instruction)
    DecodeCase(
      input,
      pattern(RV2WideControl()):
        alu: component_output(RV64ICompleteAluCases ++ system_alu_cases, input)
        operand: component_output(RV2WideOperandCases, input)
        branch: component_output(core_branch_cases, input)
        memory: component_output(RV2WideMemoryCases ++ system_memory_cases, input)
        writeback: component_output(RV2WideWritebackCases, input)
        system: component_output(RV2WideSystemCases, input)
    )

def RV2WideControlCases = compose_control_cases(RV2WideInstructions)
def RV2WideDecode = ValidDecodeGen(RV2WideControlCases)

export:
  RV2WideControl
  RV2WideControlCases
  RV2WideInstructions
  RV2WideDecode
