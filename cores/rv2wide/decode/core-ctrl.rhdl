#lang rhodium
/* Composes shared ALU, branch, and FP relations with RV2Wide scalar, atomic, and system controls. */
// SPDX-License-Identifier: Apache-2.0

import:
  "operand-ctrl.rhdl" open
  "mem-ctrl.rhdl" open
  "system-ctrl.rhdl" open
  "long-ctrl.rhdl" open
  lib("cores/alu.rhdl") open
  lib("cores/alu-decode.rhdl") open
  lib("cores/branch-decode.rhdl") open
  lib("cores/fp/decode.rhdl") open
  lib("cores/load-store.rhdl").MemoryWidth
  lib("cores/cache/operation.rhdl").CacheOperation
  lib("riscv/model/main.rhm").RegisterBank
  lib("riscv/isa/fp-profile.rhm") open
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/rv64i.rhm") open
  lib("riscv/isa/m.rhm") open
  lib("riscv/isa/a.rhm") open
  lib("riscv/isa/b.rhm") open
  lib("riscv/isa/zicond.rhm") open
  lib("riscv/isa/zimop.rhm") open
  lib("riscv/isa/zicsr.rhm") open
  lib("riscv/isa/zifencei.rhm") open
  lib("riscv/isa/zicboz.rhm") open
  lib("riscv/rtl/decode.rhdl") open
  lib("rhodium/std/decode.rhdl") open

/* Enables architectural writes and selects the link value instead of an ALU result. */
bundle RV2WideWritebackControl():
  enable: Bool
  link: Bool

/* Qualifies decoded FP controls inside a packed pipeline payload. */
bundle RV2WideFpControl():
  valid: Bool
  bits: FloatingPointControl()

/* Carries independently authored physical controls without an instruction-kind enum. */
bundle RV2WideControl():
  alu: AluControl()
  operand: RV2WideOperandControl()
  branch: RiscvBranchControl()
  memory: RV2WideMemoryControl()
  writeback: RV2WideWritebackControl()
  system: RV2WideSystemControl()
  muldiv: RV2WideLongControl()
  fp: RV2WideFpControl()

def RV2WideInstructions = RV64IInstructions ++ RV64MInstructions ++ RV64AInstructions ++ RV64BInstructions ++ ZicondInstructions ++ ZimopInstructions ++ ZicsrInstructions ++ ZifenceiInstructions ++ RV2WidePrivilegedInstructions
def addition_alu_cases = instruction_cases(RV64AInstructions ++ ZimopInstructions, component_output(RV64ICompleteAluCases, instruction_pattern(ADDI)))
def system_alu_cases = instruction_cases(RV64MInstructions ++ ZicsrInstructions ++ ZifenceiInstructions ++ RV2WidePrivilegedInstructions, unused_alu)
def inactive_memory_cases = instruction_cases(RV64MInstructions ++ RV64BInstructions ++ ZicondInstructions ++ ZimopInstructions ++ ZicsrInstructions ++ ZifenceiInstructions ++ RV2WidePrivilegedInstructions, partial_pattern(RV2WideMemoryControl()): enable: Bool(#false))
def core_long_cases = long_cases(RV2WideInstructions)
def core_branch_cases = branch_cases(RV2WideInstructions)
def branches = [BEQ, BNE, BLT, BGE, BLTU, BGEU]
def jumps = [JAL, JALR]
def RV2WideWritebackCases = decode_groups(RV2WideWritebackControl(), ~input: instruction_pattern):
  group branches ++ RV2WideStores ++ [ECALL, EBREAK, FENCE, FENCE_I] ++ RV2WidePrivilegedInstructions:
    enable: Bool(#false)
  group jumps:
    enable: Bool(#true)
    link: Bool(#true)
  group ZicsrInstructions:
    enable: Bool(#true)
  group excluding_instructions(RV2WideInstructions, branches ++ jumps ++ RV2WideStores ++ [ECALL, EBREAK, FENCE, FENCE_I] ++ RV2WidePrivilegedInstructions ++ ZicsrInstructions):
    enable: Bool(#true)
    link: Bool(#false)

/* Joins exact canonical input patterns, preserving each component's inactive care masks. */
fun compose_control_cases(instructions :: List.of(InstructionSpec)):
  for List (instruction in instructions):
    def input = instruction_pattern(instruction)
    DecodeCase(
      input,
      pattern(RV2WideControl()):
        alu: component_output(RV64ICompleteAluCases ++ RV64BAluCases ++ ZicondAluCases ++ addition_alu_cases ++ system_alu_cases, input)
        operand: component_output(RV2WideOperandCases, input)
        branch: component_output(core_branch_cases, input)
        memory: component_output(RV2WideMemoryCases ++ RV2WideAtomicCases ++ inactive_memory_cases, input)
        writeback: component_output(RV2WideWritebackCases, input)
        system: component_output(RV2WideSystemCases, input)
        muldiv: component_output(core_long_cases, input)
        fp: partial_pattern(RV2WideFpControl()): valid: Bool(#false)
    )

def RV2WideControlCases = compose_control_cases(RV2WideInstructions)
def RV2WideDecode = ValidDecodeGen(RV2WideControlCases)

// CBO.ZERO uses rs1 unchanged and has no register destination or CSR action.
def RV2WideZeroControlCases = for List (instruction in ZicbozInstructions):
  def input = instruction_pattern(instruction)
  def output = pattern(RV2WideControl()):
    alu: component_output(RV64ICompleteAluCases, instruction_pattern(ADDI))
    operand: component_output(RV2WideOperandCases, instruction_pattern(LR_D))
    branch: component_output(branch_cases(ZicbozInstructions), input)
    memory: component_output(RV2WideZeroCases, input)
    writeback: partial_pattern(RV2WideWritebackControl()): enable: Bool(#false)
    system: component_output(RV2WideSystemCases, instruction_pattern(ADDI))
    muldiv: component_output(long_cases(ZicbozInstructions), input)
    fp: partial_pattern(RV2WideFpControl()): valid: Bool(#false)
  DecodeCase(input, output)

/* Selects the exact scalar domain used by decode and compressed expansion. */
fun rv2wide_instructions(profile :: FloatingPointProfile, ~half_precision: half_precision :: HalfPrecisionProfile = HalfPrecisionProfile.None, ~zfa: zfa :: Boolean = #false, ~zicboz: zicboz :: Boolean = #false) :: List.of(InstructionSpec):
  RV2WideInstructions ++ (if zicboz | ZicbozInstructions | []) ++ fp_instructions(XLen.X64, profile, half_precision, ~zfa: zfa)

/* Adds selected Zicboz and shared F/D/half/Zfa controls to the integer decoder. */
fun rv2wide_control_cases(profile :: FloatingPointProfile, ~half_precision: half_precision :: HalfPrecisionProfile = HalfPrecisionProfile.None, ~zfa: zfa :: Boolean = #false, ~zicboz: zicboz :: Boolean = #false) :: List.of(DecodeCase):
  def instructions = fp_instructions(XLen.X64, profile, half_precision, ~zfa: zfa)
  def controls = fp_control_cases(XLen.X64, profile, half_precision, ~zfa: zfa)
  def fp_branches = branch_cases(instructions)
  def fp_long = long_cases(instructions)
  RV2WideControlCases ++ (if zicboz | RV2WideZeroControlCases | []) ++ for List (instruction in instructions):
    def input = instruction_pattern(instruction)
    def load = instruction.name in ["FLH", "FLW", "FLD"]
    def store = instruction.name in ["FSH", "FSW", "FSD"]
    def memory = load || store
    def integer_source = instruction.operands.filter(~keep: fun (operand): operand.name == "rs1" && operand.role == "source" && operand.bank == RegisterBank.Integer).length() > 0
    def integer_destination = instruction.operands.filter(~keep: fun (operand): operand.role == "destination" && operand.bank == RegisterBank.Integer).length() > 0
    def operands = partial_pattern(RV2WideOperandControl()):
      uses_rs1: Bool(integer_source)
      uses_rs2: Bool(#false)
    def memory_operands = partial_pattern(RV2WideOperandControl()):
      uses_rs1: Bool(#true)
      uses_rs2: Bool(#false)
      left: RV2WideLeft.Register
      right_immediate: Bool(#true)
      immediate: if load | RV2WideImmediate.I | RV2WideImmediate.S
    def memory_control = partial_pattern(RV2WideMemoryControl()):
      enable: Bool(#true)
      access: if load | CacheOperation.Load | CacheOperation.Store
      width:
        cond
        | instruction.name in ["FLH", "FSH"]: MemoryWidth.Half
        | instruction.name in ["FLW", "FSW"]: MemoryWidth.Word
        | ~else: MemoryWidth.Double
      unsigned: Bool(#true)
    def output = pattern(RV2WideControl()):
      alu: if memory | component_output(RV64ICompleteAluCases, instruction_pattern(ADDI)) | unused_alu
      operand: if memory | memory_operands | operands
      branch: component_output(fp_branches, input)
      memory: if memory | memory_control | partial_pattern(RV2WideMemoryControl()): enable: Bool(#false)
      writeback:
        partial_pattern(RV2WideWritebackControl()):
          enable: Bool(integer_destination)
          link: Bool(#false)
      system: component_output(RV2WideSystemCases, instruction_pattern(ADDI))
      muldiv: component_output(fp_long, input)
      fp:
        pattern(RV2WideFpControl()):
          valid: Bool(#true)
          bits: component_output(controls, input)
    DecodeCase(input, output)

export:
  RV2WideControl
  RV2WideFpControl
  RV2WideControlCases
  RV2WideInstructions
  RV2WideDecode
  rv2wide_instructions
  rv2wide_control_cases
