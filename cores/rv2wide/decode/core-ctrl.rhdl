#lang rhodium
/* Composes shared ALU, branch, and FP relations with RV2Wide scalar, atomic, and system controls. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/operand.rhdl") open
  lib("cores/vector/instruction-metadata.rhm") open
  "../profile.rhm".RV2WideConfig
  lib("riscv/isa/rv32i.rhm") as rv32
  lib("cores/memory-decode.rhdl") open
  "operand-ctrl.rhdl" open
  "mem-ctrl.rhdl" open
  "system-ctrl.rhdl" open
  "long-ctrl.rhdl" open
  lib("cores/alu.rhdl") open
  lib("cores/alu-decode.rhdl") open
  lib("cores/branch-decode.rhdl") open
  lib("cores/fp/decode.rhdl") open
  lib("cores/vector/decode.rhdl") open
  lib("riscv/isa/v.rhm") as vector_isa
  lib("riscv/isa/zvbb.rhm").ZvbbInstructions
  lib("riscv/isa/vector-profile.rhm") open
  lib("cores/load-store.rhdl").MemoryWidth
  lib("cores/cache/operation.rhdl").CacheOperation
  lib("cores/cache-prefetch.rhdl") open
  lib("riscv/model/main.rhm").RegisterBank
  lib("riscv/isa/fp-profile.rhm") open
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/rv64i.rhm") open
  lib("riscv/isa/m.rhm") open
  lib("riscv/isa/a.rhm") open
  lib("riscv/isa/b.rhm") open
  lib("riscv/isa/zicond.rhm") open
  lib("riscv/isa/zimop.rhm") open
  lib("riscv/isa/zicsr.rhm") open
  lib("riscv/isa/zifencei.rhm") open
  lib("riscv/isa/zicboz.rhm") open
  lib("riscv/isa/zicbom.rhm") open
  lib("riscv/isa/zicbop.rhm") open
  lib("riscv/isa/zawrs.rhm") open
  lib("riscv/isa/zihintpause.rhm") open
  lib("riscv/isa/zihintntl.rhm") open
  lib("riscv/isa/svinval.rhm") open
  lib("riscv/isa/h.rhm") open
  lib("riscv/isa/privileged.rhm").SFENCE_VMA
  lib("riscv/rtl/hypervisor.rhdl") open
  lib("riscv/rtl/zihintntl.rhdl") open
  lib("cores/csr/protocol.rhdl").RiscvCsrAction
  lib("riscv/rtl/csr.rhdl").RiscvCsrOperation
  lib("riscv/rtl/decode.rhdl") open
  lib("rhodium/std/decode.rhdl") open

/* Enables architectural writes and selects the link value instead of an ALU result. */
bundle RV2WideWritebackControl():
  enable: Bool
  link: Bool

/* Qualifies decoded FP controls inside a packed pipeline payload. */
bundle RV2WideFpControl():
  valid: Bool
  bits: FloatingPointControl()

/* Carries independently authored physical controls without an instruction-kind enum. */
bundle RV2WideControl():
  alu: AluControl()
  operand: OperandControl()
  branch: RiscvBranchControl()
  memory: RV2WideMemoryControl()
  guest_access: RiscvGuestMemoryAccess
  prefetch: CachePrefetchOperation
  pause: Bool
  locality_hint: RiscvMemoryLocality
  writeback: RV2WideWritebackControl()
  system: RV2WideSystemControl()
  muldiv: RV2WideLongControl()
  fp: RV2WideFpControl()
  vector: VectorControl()

/* Selects canonical vector rows; runtime legality checks enforce the selected ELEN and FP widths. */
fun rv2wide_vector_instructions(profile :: RV2WideConfig) :: List.of(InstructionSpec):
  vector_base_instructions(profile.vector) ++ (if vector_extensions_support_zvbb(profile.vector_extensions) | ZvbbInstructions | [])

/* Adds vector columns to the same composed decoder without enabling the scalar LSU. */
fun rv2wide_vector_cases(profile :: RV2WideConfig) :: List.of(DecodeCase):
  for List (instruction in rv2wide_vector_instructions(profile)):
    def metadata = vector_scalar_metadata(instruction)
    def configuration = metadata.configuration
    def scalar_destination = metadata.scalar_destination
    def output = pattern(RV2WideControl()):
      alu: unused_alu
      operand:
        partial_pattern(OperandControl()):
          uses_rs1: Bool(metadata.uses_rs1)
          uses_rs2: Bool(metadata.uses_rs2)

      branch: inactive_branch
      memory: partial_pattern(RV2WideMemoryControl()): enable: Bool(#false)
      guest_access: RiscvGuestMemoryAccess.Normal
      prefetch: CachePrefetchOperation.None
      pause: Bool(#false)
      locality_hint: RiscvMemoryLocality.Default
      writeback:
        partial_pattern(RV2WideWritebackControl()):
          enable: Bool(configuration || scalar_destination)
          link: Bool(#false)

      system:
        partial_pattern(RV2WideSystemControl()):
          csr: RiscvCsrOperation.None
          action: if configuration | RiscvCsrAction.VectorConfig | RiscvCsrAction.None
          fence: RV2WideFence.None
          wait: RV2WideWait.None

      muldiv: inactive_long
      fp: partial_pattern(RV2WideFpControl()): valid: Bool(#false)
      vector: component_output(VectorControlCases ++ VectorZvbbCases, instruction_pattern(instruction))

    DecodeCase(instruction_pattern(instruction), output)

/* Inactive controls care only about the enable/valid discriminator.
   Reuse these exact patterns without filling in unobservable payload fields. */
def inactive_core_memory = partial_pattern(RV2WideMemoryControl()): enable: Bool(#false)
def inactive_core_fp = partial_pattern(RV2WideFpControl()): valid: Bool(#false)


/* Selects canonical instruction encodings before joining their control columns. */
fun integer_instructions(xlen :: XLen) :: List.of(InstructionSpec):
  (if xlen == XLen.X32 | rv32.RV32IInstructions ++ RV32MInstructions ++ RV32AInstructions ++ RV32BInstructions | RV64IInstructions ++ RV64MInstructions ++ RV64AInstructions ++ RV64BInstructions) ++ ZicondInstructions ++ ZimopInstructions ++ ZicsrInstructions ++ ZifenceiInstructions ++ RV2WidePrivilegedInstructions

/* Joins exact canonical input patterns, preserving each component's inactive care masks. */
fun compose_control_cases(xlen :: XLen) :: List.of(DecodeCase):
  def base = if xlen == XLen.X32 | rv32.RV32IInstructions | RV64IInstructions
  def multiply = if xlen == XLen.X32 | RV32MInstructions | RV64MInstructions
  def atomic = if xlen == XLen.X32 | RV32AInstructions | RV64AInstructions
  def bitmanip = if xlen == XLen.X32 | RV32BInstructions | RV64BInstructions
  def alu = if xlen == XLen.X32 | RV32ICompleteAluCases | RV64ICompleteAluCases
  def bit_alu = if xlen == XLen.X32 | RV32BAluCases | RV64BAluCases
  def operands = rv2wide_operand_cases(xlen)
  def loads = RiscvWordLoads ++ (if xlen == XLen.X64 | RiscvDoubleLoads | [])
  def RV2WideStores = RiscvWordStores ++ (if xlen == XLen.X64 | RiscvDoubleStores | [])
  def memory = enabled_cases(scalar_memory_cases(RV2WideMemoryControl(), ~double: xlen == XLen.X64)) ++ instruction_cases(excluding_instructions(base, loads ++ RV2WideStores), inactive_core_memory)
  def atomics = enabled_cases(atomic_memory_cases(RV2WideMemoryControl(), ~double: xlen == XLen.X64))
  def instructions = integer_instructions(xlen)
  def addition_alu_cases = instruction_cases(atomic ++ ZimopInstructions, component_output(alu, instruction_pattern(ADDI)))
  def system_alu_cases = instruction_cases(multiply ++ ZicsrInstructions ++ ZifenceiInstructions ++ RV2WidePrivilegedInstructions, unused_alu)
  def inactive_memory_cases = instruction_cases(multiply ++ bitmanip ++ ZicondInstructions ++ ZimopInstructions ++ ZicsrInstructions ++ ZifenceiInstructions ++ RV2WidePrivilegedInstructions, inactive_core_memory)
  def core_long_cases = long_cases(instructions, ~xlen: xlen)
  def core_branch_cases = branch_cases(instructions)
  def branches = [BEQ, BNE, BLT, BGE, BLTU, BGEU]
  def jumps = [JAL, JALR]
  def writeback_cases = decode_groups(RV2WideWritebackControl(), ~input: instruction_pattern):
    group branches ++ RV2WideStores ++ [ECALL, EBREAK, FENCE, FENCE_I] ++ RV2WidePrivilegedInstructions:
      enable: Bool(#false)

    group jumps:
      enable: Bool(#true)
      link: Bool(#true)

    group ZicsrInstructions:
      enable: Bool(#true)

    group excluding_instructions(instructions, branches ++ jumps ++ RV2WideStores ++ [ECALL, EBREAK, FENCE, FENCE_I] ++ RV2WidePrivilegedInstructions ++ ZicsrInstructions):
      enable: Bool(#true)
      link: Bool(#false)

  for List (instruction in instructions):
    def input = instruction_pattern(instruction)
    DecodeCase(
      input,
      pattern(RV2WideControl()):
        guest_access: RiscvGuestMemoryAccess.Normal
        alu: component_output(alu ++ bit_alu ++ ZicondAluCases ++ addition_alu_cases ++ system_alu_cases, input)
        operand: component_output(operands, input)
        branch: component_output(core_branch_cases, input)
        memory: component_output(memory ++ atomics ++ inactive_memory_cases, input)
        writeback: component_output(writeback_cases, input)
        system: component_output(RV2WideSystemCases, if instruction in RV2WideSystemInstructions | input | instruction_pattern(ADDI))
        muldiv: component_output(core_long_cases, input)
        fp: inactive_core_fp
        vector: NoVectorControl
        prefetch: CachePrefetchOperation.None
        pause: Bool(#false)
        locality_hint: RiscvMemoryLocality.Default
    )


/* Optional rows reuse width-independent inactive controls, not another decoder. */

def inactive_branch = component_output(branch_cases([ADDI]), instruction_pattern(ADDI))
def inactive_long = component_output(long_cases([ADDI]), instruction_pattern(ADDI))


/* CBO rows use rs1 unchanged and have no register destination or CSR action. */

def RV2WideCboInstructions = ZicbozInstructions ++ ZicbomInstructions
def RV2WideCboControlCases = for List (instruction in RV2WideCboInstructions):
  def input = instruction_pattern(instruction)
  def output = pattern(RV2WideControl()):
    guest_access: RiscvGuestMemoryAccess.Normal
    alu: component_output(RV64ICompleteAluCases, instruction_pattern(ADDI))
    operand: component_output(RV2WideOperandCases, instruction_pattern(LR_D))
    branch: component_output(branch_cases(RV2WideCboInstructions), input)
    memory: component_output(RV2WideZeroCases ++ RV2WideManagementCases, input)
    writeback: partial_pattern(RV2WideWritebackControl()): enable: Bool(#false)
    system: component_output(RV2WideSystemCases, instruction_pattern(ADDI))
    muldiv: component_output(long_cases(RV2WideCboInstructions), input)
    fp: inactive_core_fp
    vector: NoVectorControl
    prefetch: CachePrefetchOperation.None
    pause: Bool(#false)
    locality_hint: RiscvMemoryLocality.Default

  DecodeCase(input, output)


/* Prefetch rows refine ORI-to-x0; overlay removes only those exact hint cubes. */

def RV2WidePrefetchCases = for List (entry in [[PREFETCH_I, CachePrefetchOperation.Instruction], [PREFETCH_R, CachePrefetchOperation.Read], [PREFETCH_W, CachePrefetchOperation.Write]]):
  def output = pattern(RV2WideControl()):
    guest_access: RiscvGuestMemoryAccess.Normal
    alu: component_output(RV64ICompleteAluCases, instruction_pattern(ADDI))
    operand:
      pattern(OperandControl()):
        uses_rs1: Bool(#true)
        uses_rs2: Bool(#false)
        left: OperandASelect.Register
        right: OperandBSelect.Immediate
        immediate: OperandImmediate.Prefetch

    branch: inactive_branch
    memory: inactive_core_memory
    prefetch: entry[1]
    pause: Bool(#false)
    locality_hint: RiscvMemoryLocality.Default
    writeback: partial_pattern(RV2WideWritebackControl()): enable: Bool(#false)
    system: component_output(RV2WideSystemCases, instruction_pattern(ADDI))
    muldiv: inactive_long
    fp: inactive_core_fp
    vector: NoVectorControl

  DecodeCase(instruction_pattern(entry[0]), output)

/* Selects the exact scalar domain used by decode and compressed expansion. */
fun rv2wide_instructions(profile :: RV2WideConfig) :: List.of(InstructionSpec):
  def cache_instructions = (if profile.zicboz | ZicbozInstructions | []) ++ (if profile.zicbom | ZicbomInstructions | []) ++ (if profile.zicbop | ZicbopInstructions | [])
  def wait_instructions = if profile.zawrs | ZawrsInstructions | []
  def hint_instructions = (if profile.zihintpause | ZihintpauseInstructions | []) ++ (if profile.zihintntl | ZihintntlInstructions | [])
  def invalidation_instructions = if profile.svinval | SvinvalInstructions | []
  def guest_instructions = if profile.hypervisor | RV64HInstructions ++ (if profile.svinval | [HINVAL_VVMA, HINVAL_GVMA] | []) | []
  def floating_instructions = fp_instructions(profile.xlen, profile.floating_point, profile.half_precision, ~zfa: profile.zfa)
  rv2wide_vector_instructions(profile) ++ integer_instructions(profile.xlen) ++ cache_instructions ++ wait_instructions ++ hint_instructions ++ invalidation_instructions ++ guest_instructions ++ floating_instructions


/* WRS is operand-free and uses the core's retained WB owner, not a memory request. */

def RV2WideWaitCases = for List (entry in [[WRS_NTO, RV2WideWait.NoTimeout], [WRS_STO, RV2WideWait.ShortTimeout]]):
  def output = pattern(RV2WideControl()):
    guest_access: RiscvGuestMemoryAccess.Normal
    alu: unused_alu
    operand:
      partial_pattern(OperandControl()):
        uses_rs1: Bool(#false)
        uses_rs2: Bool(#false)

    branch: inactive_branch
    memory: inactive_core_memory
    prefetch: CachePrefetchOperation.None
    pause: Bool(#false)
    locality_hint: RiscvMemoryLocality.Default
    writeback: partial_pattern(RV2WideWritebackControl()): enable: Bool(#false)
    system:
      partial_pattern(RV2WideSystemControl()):
        csr: RiscvCsrOperation.None
        action: RiscvCsrAction.None
        fence: RV2WideFence.None
        wait: entry[1]

    muldiv: inactive_long
    fp: inactive_core_fp
    vector: NoVectorControl

  DecodeCase(instruction_pattern(entry[0]), output)


/* PAUSE refines FENCE into an operand-free hint with no ordering or CSR action. */

def pause_control = pattern(RV2WideControl()):
  guest_access: RiscvGuestMemoryAccess.Normal
  alu: unused_alu
  operand:
    partial_pattern(OperandControl()):
      uses_rs1: Bool(#false)
      uses_rs2: Bool(#false)

  branch: inactive_branch
  memory: inactive_core_memory
  prefetch: CachePrefetchOperation.None
  pause: Bool(#true)
  locality_hint: RiscvMemoryLocality.Default
  writeback: partial_pattern(RV2WideWritebackControl()): enable: Bool(#false)
  system: component_output(RV2WideSystemCases, instruction_pattern(ADDI))
  muldiv: inactive_long
  fp: inactive_core_fp
  vector: NoVectorControl

def RV2WidePauseCases = [DecodeCase(instruction_pattern(PAUSE), pause_control)]


/* Locality hints refine exact ADD-to-x0 words; encoded rs2 is not an operand. */

def RV2WideLocalityCases = for List (entry in [[NTL_P1, RiscvMemoryLocality.P1], [NTL_PALL, RiscvMemoryLocality.Pall], [NTL_S1, RiscvMemoryLocality.S1], [NTL_ALL, RiscvMemoryLocality.All]]):
  def output = pattern(RV2WideControl()):
    guest_access: RiscvGuestMemoryAccess.Normal
    alu: unused_alu
    operand:
      partial_pattern(OperandControl()):
        uses_rs1: Bool(#false)
        uses_rs2: Bool(#false)

    branch: inactive_branch
    memory: inactive_core_memory
    prefetch: CachePrefetchOperation.None
    pause: Bool(#false)
    locality_hint: entry[1]
    writeback: partial_pattern(RV2WideWritebackControl()): enable: Bool(#false)
    system: component_output(RV2WideSystemCases, instruction_pattern(ADDI))
    muldiv: inactive_long
    fp: inactive_core_fp
    vector: NoVectorControl

  DecodeCase(instruction_pattern(entry[0]), output)


/* Serialized invalidation commands share inactive datapaths but retain distinct CSR actions. */

def RV2WideInvalidationControlCases = for List (instruction in SvinvalInstructions):
  def input = instruction_pattern(instruction)
  def output = pattern(RV2WideControl()):
    guest_access: RiscvGuestMemoryAccess.Normal
    alu: unused_alu
    operand:
      partial_pattern(OperandControl()):
        uses_rs1: Bool(#false)
        uses_rs2: Bool(#false)

    branch: inactive_branch
    memory: inactive_core_memory
    prefetch: CachePrefetchOperation.None
    pause: Bool(#false)
    locality_hint: RiscvMemoryLocality.Default
    writeback: partial_pattern(RV2WideWritebackControl()): enable: Bool(#false)
    system: component_output(RV2WideInvalidationCases, input)
    muldiv: inactive_long
    fp: inactive_core_fp
    vector: NoVectorControl

  DecodeCase(input, output)

/* Composes selected memory, hint, hypervisor, and shared FP controls with the integer decoder. */
fun rv2wide_control_cases(profile :: RV2WideConfig) :: List.of(DecodeCase):
  def xlen = profile.xlen
  def selected_fp_instructions = fp_instructions(xlen, profile.floating_point, profile.half_precision, ~zfa: profile.zfa)
  def selected_fp_controls = fp_control_cases(xlen, profile.floating_point, profile.half_precision, ~zfa: profile.zfa)
  def fp_branches = branch_cases(selected_fp_instructions)
  def fp_long = long_cases(selected_fp_instructions)


  /* Integer composition and exact hint overlays.
     Only the hint cubes replace base rows; CBO, wait, and guest rows append
     afterward in their original order. */

  def cbo_instructions = (if profile.zicboz | ZicbozInstructions | []) ++ (if profile.zicbom | ZicbomInstructions | [])
  def cbo_cases = for List (instruction in cbo_instructions):
    def input = instruction_pattern(instruction)
    DecodeCase(input, component_output(RV2WideCboControlCases, input))

  def hint_cases = (if profile.zicbop | RV2WidePrefetchCases | []) ++ (if profile.zihintpause | RV2WidePauseCases | []) ++ (if profile.zihintntl | RV2WideLocalityCases | [])
  def base_cases = compose_control_cases(xlen)
  def integer_cases = if hint_cases.length() > 0 | overlay_decode_cases(base_cases, hint_cases) | base_cases
  def wait_cases = if profile.zawrs | RV2WideWaitCases | []
  def invalidation_cases = if profile.svinval | RV2WideInvalidationControlCases | []
  def guest_cases = if profile.hypervisor | rv2wide_hypervisor_cases(profile.svinval) | []


  /* Floating-point rows add scalar register/address policy to the shared
     execution controls. Nonmemory operands and inactive columns keep their
     existing partial-pattern care masks. */

  def floating_cases = for List (instruction in selected_fp_instructions):
    def input = instruction_pattern(instruction)
    def load = instruction.name in ["FLH", "FLW", "FLD"]
    def store = instruction.name in ["FSH", "FSW", "FSD"]
    def memory = load || store
    def integer_source = instruction.operands.filter(~keep: fun (operand): operand.name == "rs1" && operand.role == "source" && operand.bank == RegisterBank.Integer).length() > 0
    def integer_destination = instruction.operands.filter(~keep: fun (operand): operand.role == "destination" && operand.bank == RegisterBank.Integer).length() > 0
    def operands = partial_pattern(OperandControl()):
      uses_rs1: Bool(integer_source)
      uses_rs2: Bool(#false)

    def memory_operands = partial_pattern(OperandControl()):
      uses_rs1: Bool(#true)
      uses_rs2: Bool(#false)
      left: OperandASelect.Register
      right: OperandBSelect.Immediate
      immediate: if load | OperandImmediate.I | OperandImmediate.S

    def memory_control = partial_pattern(RV2WideMemoryControl()):
      enable: Bool(#true)
      access: if load | CacheOperation.Load | CacheOperation.Store
      width:
        cond
        | instruction.name in ["FLH", "FSH"]: MemoryWidth.Half
        | instruction.name in ["FLW", "FSW"]: MemoryWidth.Word
        | ~else: MemoryWidth.Double

      unsigned: Bool(#true)

    def output = pattern(RV2WideControl()):
      guest_access: RiscvGuestMemoryAccess.Normal
      alu: if memory | component_output(RV64ICompleteAluCases, instruction_pattern(ADDI)) | unused_alu
      operand: if memory | memory_operands | operands
      branch: component_output(fp_branches, input)
      memory: if memory | memory_control | inactive_core_memory
      prefetch: CachePrefetchOperation.None
      pause: Bool(#false)
      locality_hint: RiscvMemoryLocality.Default
      writeback:
        partial_pattern(RV2WideWritebackControl()):
          enable: Bool(integer_destination)
          link: Bool(#false)

      system: component_output(RV2WideSystemCases, instruction_pattern(ADDI))
      muldiv: component_output(fp_long, input)
      vector: NoVectorControl
      fp:
        pattern(RV2WideFpControl()):
          valid: Bool(#true)
          bits: component_output(selected_fp_controls, input)

    DecodeCase(input, output)

  rv2wide_vector_cases(profile) ++ integer_cases ++ cbo_cases ++ wait_cases ++ invalidation_cases ++ guest_cases ++ floating_cases

/* Reuses ordinary LSU controls for explicit guest accesses and serialized CSR actions for fences. */
fun rv2wide_hypervisor_cases(svinval :: Boolean) :: List.of(DecodeCase):
  def memory_cases = for List (entry in RiscvGuestMemoryInstructions):
    def store = entry[1] in RV2WideStores
    def input = instruction_pattern(entry[1])
    def output = pattern(RV2WideControl()):
      alu: component_output(RV64ICompleteAluCases, instruction_pattern(ADDI))
      operand:
        pattern(OperandControl()):
          uses_rs1: Bool(#true)
          uses_rs2: Bool(store)
          left: OperandASelect.Register
          right: OperandBSelect.Immediate
          immediate: OperandImmediate.Zero

      branch: inactive_branch
      memory: component_output(RV2WideMemoryCases, input)
      guest_access: if entry[2] | RiscvGuestMemoryAccess.GuestExecuteRead | RiscvGuestMemoryAccess.Guest
      prefetch: CachePrefetchOperation.None
      pause: Bool(#false)
      locality_hint: RiscvMemoryLocality.Default
      writeback:
        partial_pattern(RV2WideWritebackControl()):
          enable: Bool(!store)
          link: if store | pattern(Bool, _) | Bool(#false)

      system: component_output(RV2WideSystemCases, input)
      muldiv: inactive_long
      fp: inactive_core_fp
      vector: NoVectorControl

    DecodeCase(instruction_pattern(entry[0]), output)

  def fences = [[HFENCE_VVMA, RiscvCsrAction.HfenceVvma], [HFENCE_GVMA, RiscvCsrAction.HfenceGvma]] ++ (if svinval | [[HINVAL_VVMA, RiscvCsrAction.HfenceVvma], [HINVAL_GVMA, RiscvCsrAction.HfenceGvma]] | [])
  memory_cases ++ for List (entry in fences):
    def input = instruction_pattern(SFENCE_VMA)
    def output = pattern(RV2WideControl()):
      alu: component_output(RV64ICompleteAluCases, instruction_pattern(ADDI))
      operand: component_output(RV2WideOperandCases, input)
      branch: inactive_branch
      memory: inactive_core_memory
      guest_access: RiscvGuestMemoryAccess.Normal
      prefetch: CachePrefetchOperation.None
      pause: Bool(#false)
      locality_hint: RiscvMemoryLocality.Default
      writeback: partial_pattern(RV2WideWritebackControl()): enable: Bool(#false)
      system:
        pattern(RV2WideSystemControl()):
          csr: RiscvCsrOperation.None
          immediate: pattern(Bool, _)
          action: entry[1]
          fence: RV2WideFence.None
          wait: RV2WideWait.None

      muldiv: inactive_long
      fp: inactive_core_fp
      vector: NoVectorControl

    DecodeCase(instruction_pattern(entry[0]), output)

export:
  RV2WideControl
  RV2WideFpControl
  rv2wide_instructions
  rv2wide_control_cases
