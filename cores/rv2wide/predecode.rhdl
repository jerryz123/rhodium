#lang rhodium
/* Projects RV2Wide’s decode domain and predictor choices into the shared fetch assembler. */
// SPDX-License-Identifier: Apache-2.0

import:
  "profile.rhm".RV2WideConfig
  "decode/core-ctrl.rhdl".rv2wide_instructions
  "../fetch/predecode.rhdl".FetchDecodeConfig

/* Selects exactly the compressed expansions supported by the core’s canonical decoder. */
fun rv2wide_fetch_config(profile :: RV2WideConfig) :: FetchDecodeConfig:
  FetchDecodeConfig(profile.xlen, profile.floating_point, profile.compressed, rv2wide_instructions(profile).map(fun (instruction): instruction.name), profile.btb_entries > 0, profile.ras_entries > 0)

export rv2wide_fetch_config
