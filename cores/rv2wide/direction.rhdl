#lang rhodium
/* Selects tournament directions at fresh S2 boundaries and retains unfinished instruction predictions. */
// SPDX-License-Identifier: Apache-2.0

import:
  "predecode.rhdl".RV2WidePredecode
  "profile.rhm".RV2WideConfig
  "bundles.rhdl" open
  lib("cores/bpred/protocol.rhdl") open
  lib("riscv/isa/xlen.rhm").XLen
  lib("rhodium/std/bits.rhdl") open

/* Walks a fresh block once, independently of downstream assembly readiness. */
sync_circuit RV2WideDirection(profile :: RV2WideConfig):
  def xlen = profile.xlen
  input(valid, clear, fault): Bool
  input pc: Bits(xlen.width)
  input data: Bits(64)
  input prediction: BranchPrediction(xlen)
  input(row, history): Bits(10)
  input(base_taken, gshare_taken, use_gshare): Vec(4, Bool)
  input(prefix_gshare_taken, prefix_use_gshare): Bool
  output(prefix_row, prefix_choice_row): Bits(10)
  output directions: Vec(4, TournamentPrediction(10))
  output prefix_direction: TournamentPrediction(10)
  output corrected: BranchPrediction(xlen)
  output history_after: Bits(10)
  output next_pc: Bits(xlen.width)
  output invalidate: Bool


  /* Retained prefix ownership.
     A byte-six instruction keeps its first parcel and original prediction
     context until the next block supplies its second parcel. */

  reg partial_valid(~init: Bool(#false))
  reg partial_pc(Bits(xlen.width))
  reg partial_word(Bits(16))
  reg partial_row(Bits(10))
  reg partial_base_taken(Bool)
  reg partial_prediction(BranchPrediction(xlen))
  prefix_row <== partial_row
  prefix_choice_row <== partial_pc[3..13]
  def prefix = partial_valid & (pc === (partial_pc + Bits(xlen.width)(2)))


  /* Ordered parcel prediction and history scan.
     The retained prefix is inspected first, then ordinary instruction boundaries.
     Each candidate consumes the preceding history; a taken branch cuts the suffix. */

  def mutable checkpoint = history
  def mutable cut = Bool(#false)
  def mutable effective :: BranchPrediction(xlen) = literal(BranchPrediction(xlen), 0)
  def mutable matched = Bool(#false)
  def mutable stale_target = Bool(#false)
  def mutable boundary = mux(prefix, Bits(3)(1), pc[1..3].zext(3))
  def mutable pending = Bool(#false)
  for (slot in 0..5):
    def parcel = if slot == 0 | 3 | slot - 1
    def raw = if slot == 0 | data[0..16] ++ partial_word | (data >> (parcel * 16))[0..32]
    def address = if slot == 0 | partial_pc | pc.align_down(8) + Bits(xlen.width)(parcel * 2)
    inst decoded(RV2WidePredecode(profile))
    decoded.raw <== raw
    def at_boundary = if slot == 0 | prefix | boundary === Bits(3)(parcel)
    def complete = if slot == 0 | Bool(#true) | decoded.compressed ||| Bool(parcel < 3)
    def live = at_boundary & !cut & !fault
    def candidate :: BranchPrediction(xlen) = if slot == 0 | partial_prediction | prediction
    def known = live & complete & decoded.control_flow & candidate.valid & (candidate.pc === address) & (candidate.compressed === decoded.compressed)
    def base = if slot == 0 | partial_base_taken | base_taken[parcel]
    def history_direction = if slot == 0 | prefix_gshare_taken | gshare_taken[parcel]
    def selected_history = if slot == 0 | prefix_use_gshare | use_gshare[parcel]
    def conditional_taken = mux(selected_history, history_direction, base)
    def taken = mux(decoded.conditional, conditional_taken, known)
    def metadata = TournamentPrediction(10):
      valid: live & complete & decoded.conditional
      index: (if slot == 0 | partial_row | row) ++ Bits(2)(parcel)
      history: checkpoint
      taken: taken
      base_index: address[1..13]
      base_taken: base
      gshare_taken: history_direction

    if slot == 0
    | prefix_direction <== metadata
    | directions[parcel] <== metadata

    def selected = BranchPrediction(xlen):
      valid: Bool(#true)
      pc: address
      target: mux(decoded.immediate, address + decoded.offset, candidate.target)
      compressed: decoded.compressed
      ras_action: decoded.action

    effective := mux(live & complete & decoded.control_flow & taken, selected, effective)
    checkpoint := mux(live & complete, rv2wide_history_after(metadata, taken), checkpoint)
    matched := matched ||| known ||| (live & !complete & candidate.valid & (candidate.pc === address) & !candidate.compressed)
    stale_target := stale_target ||| (known & decoded.immediate & (candidate.target =/= (address + decoded.offset)))
    cut := cut ||| (live & complete & decoded.control_flow & taken)
    pending := pending ||| (live & !complete)
    if slot > 0
    | boundary := mux(live, Bits(3)(parcel) + mux(decoded.compressed, Bits(3)(1), Bits(3)(2)), boundary)
    | #void


  /* Correction and invalidation.
     An incomplete byte-six prediction remains provisional. Complete conditional
     branches update history; the selected taken control flow changes next_pc. */

  def provisional_prefix = pending & prediction.valid & !prediction.compressed & (prediction.pc === (pc.align_down(8) + Bits(xlen.width)(6)))
  corrected <== mux(provisional_prefix, prediction, effective)
  next_pc <== mux(effective.valid, effective.target, pc.align_down(8) + Bits(xlen.width)(8))
  history_after <== checkpoint
  invalidate <== !fault & ((prediction.valid & !matched & !prefix) ||| stale_target)


  /* Prefix capture and cancellation.
     Clear wins; fresh valid blocks replace prefix ownership, never downstream stalls. */

  when clear:
    partial_valid <== Bool(#false)
  elsewhen valid:
    partial_valid <== pending
    when pending:
      partial_pc <== pc.align_down(8) + Bits(xlen.width)(6)
      partial_word <== data[48..64]
      partial_row <== row
      partial_base_taken <== base_taken[3]
      partial_prediction <== prediction

/* Passes provisional BTB metadata without allocating predecode or history-prefix state. */
sync_circuit DisabledRV2WideDirection(profile :: RV2WideConfig):
  def xlen = profile.xlen
  input(valid, clear, fault): Bool
  input pc: Bits(xlen.width)
  input data: Bits(64)
  input prediction: BranchPrediction(xlen)
  input(row, history): Bits(10)
  input(base_taken, gshare_taken, use_gshare): Vec(4, Bool)
  input(prefix_gshare_taken, prefix_use_gshare): Bool
  output(prefix_row, prefix_choice_row): Bits(10)
  output directions: Vec(4, TournamentPrediction(10))
  output prefix_direction: TournamentPrediction(10)
  output corrected: BranchPrediction(xlen)
  output history_after: Bits(10)
  output next_pc: Bits(xlen.width)
  output invalidate: Bool
  prefix_row <== row
  prefix_choice_row <== pc[3..13]
  directions <== literal(Vec(4, TournamentPrediction(10)), 0)
  prefix_direction <== literal(TournamentPrediction(10), 0)
  corrected <== prediction
  history_after <== history
  next_pc <== pc.align_down(8) + Bits(xlen.width)(8)
  invalidate <== Bool(#false)

export:
  RV2WideDirection
  DisabledRV2WideDirection
