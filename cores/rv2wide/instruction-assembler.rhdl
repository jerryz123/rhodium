#lang rhodium
/* Assembles mixed-width instructions and corrects immediate targets without losing boundary fault ownership. */
// SPDX-License-Identifier: Apache-2.0

import:
  "bundles.rhdl" open
  "decode/core-ctrl.rhdl".rv2wide_instructions
  "profile.rhm".RV2WideConfig
  lib("cores/bpred/protocol.rhdl") open
  lib("cores/bpred/ras.rhdl").riscv_ras_action
  lib("riscv/model/formats.rhm") as fields
  lib("riscv/rtl/instruction-fields.rhdl").instruction_immediate
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/rtl/compressed.rhdl") open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

/* Carries one aligned block's contents, first requested byte, and any block admission/read fault. */
bundle RV2WideFetchBlock():
  pc: Bits(64)
  data: Bits(64)
  fault: RV2WideFetchFault()
  prediction: BranchPrediction(XLen.X64)

/* Emits up to two expanded instructions per cycle, retaining a trailing 32-bit prefix across blocks.
   Registered block credits cover non-backpressurable lookups; live bypass adds no hit-path stage.
   Clear discards the speculative epoch, while local cache/translation replay leaves this state intact. */
sync_circuit RV2WideInstructionAssembler(profile :: RV2WideConfig = RV2WideConfig()):
  interface blocks(Decoupled(RV2WideFetchBlock()), ~role: consumer)
  interface clear(Pulse(), ~role: consumer)
  interface instructions(Decoupled(RV2WidePacket()), ~role: producer)
  interface repair(Valid(RV2WideFetchRepair()), ~role: producer)
  interface discover(Valid(BranchPrediction(XLen.X64)), ~role: producer)
  interface speculate(Valid(RasUpdate(XLen.X64)), ~role: producer)
  input ras_head_valid: Bool
  input ras_head: Bits(64)
  input pause: Bool
  output available: Bits(2)

  inst returned(ShiftQueue(RV2WideFetchBlock(), 3, ~flow: #true, ~flushable: #true))
  blocks |> returned.ingress
  available <== bits(3, 2) - returned.count
  def head :: Endpoint = returned.egress
  reg repairing(~init: Bool(#false))
  def discard = clear.valid ||| repairing
  reg consumed(~init: bits(0, 3))
  reg partial_valid(~init: Bool(#false))
  reg partial_pc(Bits(64))
  reg partial_word(Bits(16))
  reg partial_prediction(BranchPrediction(XLen.X64))
  def start = head.bits.pc[1..3].zext(3) + consumed
  def window = mux(partial_valid, head.bits.data ++ partial_word, (head.bits.data >> (start ++ bits(0, 4))).zext(80))
  def parcels = bits(4, 3) - start + partial_valid.as_bits().zext(3)
  def first_pc = mux(partial_valid, partial_pc, head.bits.pc + (consumed.zext(64) << 1))
  def first_compressed = window[0..2] =/= bits(3, 2)
  def first_size = mux(first_compressed, bits(1, 3), bits(2, 3))
  def first_valid = head.valid & (head.bits.fault.valid ||| (parcels >= first_size))
  def second_window = window >> (first_size ++ bits(0, 4))
  def second_compressed = second_window[0..2] =/= bits(3, 2)
  def second_size = mux(second_compressed, bits(1, 3), bits(2, 3))
  wire fetched: Vec(2, RV2WideInstruction())
  wire actions: Vec(2, RasAction)
  wire known_predictions: Vec(2, Bool)
  wire target_repairs: Vec(2, Bool)
  def first_cut = first_valid & fetched[0].prediction.valid
  def second_valid = first_valid & !head.bits.fault.valid & (parcels >= (first_size + second_size)) & !first_cut & !(actions[0].is_one_of(RasAction.Push, RasAction.Pop, RasAction.PopPush) & actions[1].is_one_of(RasAction.Push, RasAction.Pop, RasAction.PopPush))
  def used = mux(first_valid, first_size + mux(second_valid, second_size, bits(0, 3)), bits(0, 3))
  def remaining = parcels - used
  def tail = window >> (used ++ bits(0, 4))
  def cut = first_cut ||| (second_valid & fetched[1].prediction.valid)
  def capture_partial = (remaining === bits(1, 3)) & (tail[0..2] === bits(3, 2)) & !head.bits.fault.valid & !cut
  instructions.valid <== first_valid & !discard & !pause
  instructions.bits.count <== mux(second_valid, bits(2, 2), bits(1, 2))
  for (lane in 0..2):
    def raw = if lane == 0 | window[0..32] | second_window[0..32]
    def compressed = if lane == 0 | first_compressed | second_compressed
    def size = if lane == 0 | first_size | second_size
    def pc = if lane == 0 | first_pc | first_pc + (first_size.zext(64) << 1)
    inst expander(RiscvCompressedExpander(XLen.X64, profile.floating_point, profile.compressed, ~supported_instructions: rv2wide_instructions(profile.floating_point, ~half_precision: profile.half_precision, ~zfa: profile.zfa, ~zicboz: profile.zicboz, ~zicbom: profile.zicbom, ~zicbop: profile.zicbop, ~zawrs: profile.zawrs, ~zihintpause: profile.zihintpause).map(fun (instruction): instruction.name)))
    expander.compressed <== raw[0..16]
    def canonical = mux(compressed, expander.expansion.instruction, raw)
    def legal = !head.bits.fault.valid & (!compressed ||| expander.expansion.valid)
    def opcode = canonical[0..7]
    def control_flow = legal & ((opcode === bits(0x6f, 7)) ||| ((opcode === bits(0x67, 7)) & (canonical[12..15] === bits(0, 3))) ||| ((opcode === bits(0x63, 7)) & !canonical[12..15].is_one_of(bits(2, 3), bits(3, 3))))
    def action = mux(control_flow, riscv_ras_action(canonical), RasAction.None)
    def predicted :: BranchPrediction(XLen.X64) = if lane == 0 | mux(partial_valid & partial_prediction.valid, partial_prediction, head.bits.prediction) | head.bits.prediction
    def known = predicted.valid & (predicted.pc === pc) & (predicted.compressed === compressed) & control_flow
    def immediate_control_flow = legal & opcode.is_one_of(bits(0x6f, 7), bits(0x63, 7))
    def immediate_target = pc + mux(opcode === bits(0x6f, 7), instruction_immediate(fields.JImmediate, canonical, 64), instruction_immediate(fields.BImmediate, canonical, 64))
    def direct = legal & (opcode === bits(0x6f, 7)) & Bool(profile.btb_entries > 0)
    def returning = legal & action.is_one_of(RasAction.Pop, RasAction.PopPush) & ras_head_valid
    def fallback = !known & (direct ||| returning)
    def sequential_pc = pc + (size.zext(64) << 1)
    actions[lane] <== action
    known_predictions[lane] <== known
    target_repairs[lane] <== known & immediate_control_flow & (predicted.target =/= immediate_target)
    fetched[lane] <== RV2WideInstruction():
      pc: pc
      instruction: canonical
      raw_instruction: mux(compressed, raw[0..16].zext(32), raw)
      sequential_pc: sequential_pc
      compressed_illegal: compressed & !expander.expansion.valid
      fault: head.bits.fault
      prediction:
        BranchPrediction(XLen.X64):
          valid: known ||| fallback
          pc: pc
          target: mux(immediate_control_flow, immediate_target, mux(known, predicted.target, ras_head))
          compressed: compressed
          ras_action: action
      speculated_ras_action: mux(Bool(profile.ras_entries > 0), action, RasAction.None)
    instructions.bits.entries[lane] <== fetched[lane]

  def advance = !discard & !pause & (instructions.fire() ||| (head.valid & !first_valid))
  def tail_pc = first_pc + (used.zext(64) << 1)
  def inspected_end = tail_pc + mux(capture_partial, bits(2, 64), bits(0, 64))
  def tail_prediction = capture_partial & (head.bits.prediction.pc === tail_pc) & !head.bits.prediction.compressed
  def head_known = ((head.bits.prediction.pc === fetched[0].pc) & known_predictions[0]) ||| (second_valid & (head.bits.prediction.pc === fetched[1].pc) & known_predictions[1]) ||| tail_prediction
  def bad_head = head.bits.prediction.valid & (head.bits.prediction.pc < inspected_end) & !head_known & !head.bits.fault.valid
  def bad_partial = partial_valid & partial_prediction.valid & !known_predictions[0] & !head.bits.fault.valid
  def selected :: RV2WideInstruction() = mux(first_cut, fetched[0], fetched[1])
  def fallback = cut & !mux(first_cut, known_predictions[0], known_predictions[1])
  def target_repair = cut & mux(first_cut, target_repairs[0], target_repairs[1])
  repair.valid <== advance & (bad_head ||| bad_partial ||| fallback ||| target_repair)
  repair.bits <== RV2WideFetchRepair():
    target: mux(cut, selected.prediction.target, tail_pc)
    invalidate: bad_head ||| bad_partial ||| target_repair
    entry: mux(target_repair, selected.pc, mux(bad_partial, partial_prediction.pc, head.bits.prediction.pc))
  // A local repair preserves this edge's accepted prefix; discard its queued
  // suffix on the following edge, not during the transfer that owns the repair.
  repairing <== repair.valid
  returned.flush <== discard
  discover.valid <== instructions.fire() & fallback & !bad_partial
  discover.bits <== selected.prediction
  def action_lane = mux(actions[0] =/= RasAction.None, bits(0, 1), bits(1, 1))
  speculate.valid <== instructions.fire() & Bool(profile.ras_entries > 0) & (fetched[action_lane].speculated_ras_action =/= RasAction.None) & ((action_lane === bits(0, 1)) ||| second_valid)
  speculate.bits <== RasUpdate(XLen.X64):
    action: fetched[action_lane].speculated_ras_action
    return_address: fetched[action_lane].sequential_pc
  head.ready <== advance & ((remaining === bits(0, 3)) ||| capture_partial ||| head.bits.fault.valid ||| cut ||| repair.valid)
  // Every packet uses the current block; a straddling first instruction also
  // retains the preceding block's prefix until this assembly attempt advances.
  describe_interface_window_storage(1, head.fire() & capture_partial & !repair.valid, (partial_valid & advance).as_bits(), partial_valid.as_bits(), discard, [partial_valid], ~live: Bool(#true))
  describe_interface_contract(head, instructions, "instruction-assembly", ~trace_model: interface_trace_window())
  when (discard ||| repair.valid):
    consumed <== bits(0, 3)
    partial_valid <== Bool(#false)
  elsewhen advance:
    when (head.fire()):
      consumed <== bits(0, 3)
    otherwise:
      consumed <== consumed + used - partial_valid.as_bits().zext(3)
    partial_valid <== capture_partial
    when capture_partial:
      partial_pc <== first_pc + (used.zext(64) << 1)
      partial_word <== tail[0..16]
      partial_prediction <== head.bits.prediction.updated(~valid: head.bits.prediction.valid & (head.bits.prediction.pc === tail_pc))
  when (head.valid & partial_valid & !discard):
    assert(head.bits.pc === (partial_pc + bits(2, 64)), "rv2wide_contiguous_fetch_suffix")

export:
  RV2WideFetchBlock
  RV2WideInstructionAssembler
