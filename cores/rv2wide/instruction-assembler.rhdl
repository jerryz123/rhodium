#lang rhodium
/* Assembles two instructions across credited fetch blocks while preserving prediction and fault ownership. */
// SPDX-License-Identifier: Apache-2.0

import:
  "bundles.rhdl" open
  "predecode.rhdl".RV2WidePredecode
  "profile.rhm".RV2WideConfig
  lib("cores/bpred/protocol.rhdl") open
  lib("riscv/isa/xlen.rhm").XLen
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

/* Carries one aligned block's contents, first requested byte, and any block admission/read fault. */
bundle RV2WideFetchBlock(xlen :: XLen):
  pc: Bits(xlen.width)
  data: Bits(64)
  fault: RV2WideFetchFault(xlen)
  prediction: BranchPrediction(xlen)
  directions: Vec(4, TournamentPrediction(10))
  prefix_direction: TournamentPrediction(10)

/* Decodes a two-block parcel window into an ordered one/two-instruction packet.
   Three retained blocks plus live bypass cover fixed-cycle fetch reservations.
   Accepted packets release exhausted blocks; a missing continuation retains its original block. */
sync_circuit RV2WideInstructionAssembler(profile :: RV2WideConfig = RV2WideConfig()):
  def xlen = profile.xlen
  interface blocks(Decoupled(RV2WideFetchBlock(xlen)), ~role: consumer)
  interface clear(Pulse(), ~role: consumer)
  interface instructions(Decoupled(RV2WidePacket(xlen)), ~role: producer)
  interface repair(Valid(RV2WideFetchRepair(xlen)), ~role: producer)
  interface discover(Valid(BranchPrediction(xlen)), ~role: producer)
  interface speculate(Valid(RasUpdate(xlen)), ~role: producer)
  input ras_head_valid: Bool
  input ras_head: Bits(xlen.width)
  input pause: Bool
  output available: Bits(2)


  /* Parcel window and packet boundaries.
     Retained blocks precede live bypass; incomplete continuations keep their owner. */

  reg count(~init: Bits(2)(0))
  reg retained(Vec(3, RV2WideFetchBlock(xlen)))
  // Input admission is independent of current instruction readiness: every S2 result is reserved.
  blocks.ready <== count < Bits(2)(3)
  def first_present = count.any() ||| blocks.valid
  def first_block = mux(count.any(), retained[0], blocks.bits)
  def second_block = mux(count > Bits(2)(1), retained[1], blocks.bits)
  def second_present = ((count > Bits(2)(1)) ||| ((count === Bits(2)(1)) & blocks.valid)) & (second_block.pc === (first_block.pc.align_down(8) + Bits(xlen.width)(8)))
  reg repairing(~init: Bool(#false))
  def discard = clear.valid ||| repairing
  reg consumed(~init: Bits(3)(0))
  def start = first_block.pc[1..3].zext(4) + consumed.zext(4)
  def window = (second_block.data ++ first_block.data) >> (start ++ Bits(4)(0))
  def parcels = Bits(4)(4) - start + mux(second_present, Bits(4)(4), Bits(4)(0))
  def first_pc = first_block.pc + (consumed.zext(xlen.width) << 1)
  def first_compressed = window[0..2] =/= Bits(2)(3)
  def first_size = mux(first_compressed ||| first_block.fault.valid, Bits(4)(1), Bits(4)(2))
  def first_crosses = (start + first_size) > Bits(4)(4)
  def first_fault = first_block.fault.valid ||| (first_crosses & second_present & second_block.fault.valid)
  def first_valid = first_present & (first_block.fault.valid ||| (parcels >= first_size))
  def second_window = window >> (first_size ++ Bits(4)(0))
  def second_compressed = second_window[0..2] =/= Bits(2)(3)
  def second_start = start + first_size
  def second_size = mux(second_compressed ||| ((second_start >= Bits(4)(4)) & second_block.fault.valid), Bits(4)(1), Bits(4)(2))
  wire fetched: Vec(2, RV2WideInstruction(xlen))
  wire actions: Vec(2, RasAction)
  wire known_predictions: Vec(2, Bool)
  wire target_repairs: Vec(2, Bool)
  wire entry_repairs: Vec(2, Bool)
  def first_cut = first_valid & fetched[0].prediction.valid
  def both_update_ras = actions[0].is_one_of(RasAction.Push, RasAction.Pop, RasAction.PopPush) & actions[1].is_one_of(RasAction.Push, RasAction.Pop, RasAction.PopPush)
  def second_complete = parcels >= (first_size + second_size)
  def second_valid = first_valid & !first_fault & second_complete & !first_cut & !both_update_ras
  def used = first_size + mux(second_valid, second_size, Bits(4)(0))
  def end = start + used
  def uses_second = end > Bits(4)(4)
  def cut = first_cut ||| (second_valid & fetched[1].prediction.valid)
  instructions.valid <== first_valid & !discard & !pause
  instructions.bits.count <== mux(second_valid, Bits(2)(2), Bits(2)(1))


  /* Per-lane predecode and prediction validation.
     Preserve block/fault ownership across a straddling instruction. */

  for (lane in 0..2):
    def raw = if lane == 0 | window[0..32] | second_window[0..32]
    def compressed = if lane == 0 | first_compressed | second_compressed
    def size = if lane == 0 | first_size | second_size
    def pc = if lane == 0 | first_pc | first_pc + (first_size.zext(xlen.width) << 1)
    def position = if lane == 0 | start | second_start
    def in_second = position >= Bits(4)(4)
    def crosses = (position < Bits(4)(4)) & ((position + size) > Bits(4)(4))
    def owner = mux(in_second, second_block, first_block)
    def fetch_fault = mux(in_second ||| crosses, second_block.fault, first_block.fault)
    def fault = mux(first_block.fault.valid, first_block.fault, fetch_fault)
    inst decoded(RV2WidePredecode(profile))
    decoded.raw <== raw
    def canonical = decoded.canonical
    def legal = !fault.valid & decoded.legal
    def control_flow = !fault.valid & decoded.control_flow
    def action = mux(control_flow, decoded.action, RasAction.None)
    def predicted :: BranchPrediction(xlen) = mux(crosses & !owner.prediction.valid, second_block.prediction, owner.prediction)
    def direction :: TournamentPrediction(10) = mux(crosses, second_block.prefix_direction, owner.directions[pc[1..3]])
    def bht_branch = direction.valid & control_flow & decoded.conditional
    def known = mux(bht_branch, direction.taken, predicted.valid & (predicted.pc === pc) & (predicted.compressed === compressed) & control_flow)
    def immediate_control_flow = legal & decoded.immediate
    def immediate_target = pc + decoded.offset
    def direct = legal & (canonical[0..7] === Bits(7)(0x6f)) & Bool(profile.btb_entries > 0)
    def returning = legal & action.is_one_of(RasAction.Pop, RasAction.PopPush) & ras_head_valid
    def fallback = !known & (direct ||| returning)
    def sequential_pc = pc + (size.zext(xlen.width) << 1)
    def prediction_target :: Bits(xlen.width) = priority_mux(~default: ras_head):
      immediate_control_flow: immediate_target
      returning: ras_head
      known: predicted.target

    actions[lane] <== action
    // Fresh direction metadata recognizes a not-taken conditional too; it is not a stale BTB entry.
    known_predictions[lane] <== known ||| bht_branch
    entry_repairs[lane] <== known & !bht_branch & immediate_control_flow & (predicted.target =/= immediate_target)
    target_repairs[lane] <== entry_repairs[lane] ||| (known & returning & (predicted.target =/= ras_head))
    fetched[lane] <== RV2WideInstruction(xlen):
      pc: pc
      instruction: canonical
      raw_instruction: mux(compressed, raw[0..16].zext(32), raw)
      sequential_pc: sequential_pc
      compressed_illegal: !decoded.legal
      fault: fault
      prediction:
        BranchPrediction(xlen):
          valid: known ||| fallback
          pc: pc
          target: prediction_target
          compressed: compressed
          ras_action: action

      speculated_ras_action: mux(Bool(profile.ras_entries > 0), action, RasAction.None)
      direction: direction

    instructions.bits.entries[lane] <== fetched[lane]


  /* Accepted-prefix repair and predictor updates.
     This edge's packet survives repair; only the queued suffix is discarded next edge. */

  def advance = instructions.fire()
  def tail_pc = first_pc + (used.zext(xlen.width) << 1)
  def bad_entries = for List (index in 0..2):
    def owner = if index == 0 | first_block | second_block
    def known = ((owner.prediction.pc === fetched[0].pc) & known_predictions[0]) ||| (second_valid & (owner.prediction.pc === fetched[1].pc) & known_predictions[1])
    def visited = if index == 0 | first_present | second_present & uses_second
    visited & owner.prediction.valid & (owner.prediction.pc >= first_pc) & (owner.prediction.pc < tail_pc) & !known & !owner.fault.valid

  def packet_fault = fetched[0].fault.valid ||| (second_valid & fetched[1].fault.valid)
  def bad_entry = (bad_entries[0] ||| bad_entries[1]) & !packet_fault
  def selected :: RV2WideInstruction(xlen) = mux(first_cut, fetched[0], fetched[1])
  def fallback = cut & !mux(first_cut, known_predictions[0], known_predictions[1])
  def target_repair = cut & mux(first_cut, target_repairs[0], target_repairs[1])
  def entry_repair = cut & mux(first_cut, entry_repairs[0], entry_repairs[1])
  def accepted_tail :: RV2WideInstruction(xlen) = mux(second_valid, fetched[1], fetched[0])
  def repair_entry :: Bits(xlen.width) = priority_mux(~default: second_block.prediction.pc):
    target_repair: selected.pc
    bad_entries[0]: first_block.prediction.pc

  repair.valid <== advance & (bad_entry ||| fallback ||| target_repair)
  repair.bits <== RV2WideFetchRepair(xlen):
    target: mux(cut, selected.prediction.target, tail_pc)
    invalidate: bad_entry ||| entry_repair
    entry: repair_entry
    history: rv2wide_history_after(accepted_tail.direction, accepted_tail.direction.taken)

  // A local repair preserves this edge's accepted prefix; discard its queued
  // suffix on the following edge, not during the transfer that owns the repair.
  repairing <== repair.valid
  discover.valid <== instructions.fire() & fallback & !bad_entry
  discover.bits <== selected.prediction
  def action_lane = mux(actions[0] =/= RasAction.None, Bits(1)(0), Bits(1)(1))
  speculate.valid <== instructions.fire() & Bool(profile.ras_entries > 0) & (fetched[action_lane].speculated_ras_action =/= RasAction.None) & ((action_lane === Bits(1)(0)) ||| second_valid)
  speculate.bits <== RasUpdate(xlen):
    action: fetched[action_lane].speculated_ras_action
    return_address: fetched[action_lane].sequential_pc


  /* Block credits and causal parents.
     A live-bypassed block may be consumed without ever occupying retained storage. */

  def exhausted = priority_mux(~default: (end >> 2)[0..2]):
    cut ||| packet_fault: mux(uses_second, Bits(2)(2), Bits(2)(1))

  def released = mux(advance, exhausted, Bits(2)(0))
  def resident_release = mux(released > count, count, released)
  def remaining = count - resident_release
  def enqueue = blocks.fire() & (released <= count)
  available <== Bits(2)(3) - count + resident_release
  // A packet selects both parents only when its bytes or continuation fault use both blocks.
  describe_interface_window_storage(3, enqueue, resident_release, count, discard, [count.any(), (count > Bits(2)(1)) & uses_second], ~live: (count === Bits(2)(0)) ||| ((count === Bits(2)(1)) & uses_second))
  describe_interface_contract(blocks, instructions, "instruction-assembly", ~trace_model: interface_trace_window())


  /* Retained-block compaction and parcel cursor updates.
     Discard wins over compaction; ordinary acceptance keeps an unfinished suffix. */

  when discard:
    count <== Bits(2)(0)
    consumed <== Bits(3)(0)
  otherwise:
    count <== remaining + enqueue.as_bits().zext(2)
    for (index in 0..3):
      def position = Bits(2)(index)
      when (enqueue & (position === remaining)):
        retained[index] <== blocks.bits
      elsewhen (position < remaining):
        retained[index] <== retained[(position + resident_release)[0..2]]

    when (advance & !repair.valid):
      def next_consumed :: Bits(3) = priority_mux(~default: consumed + used[0..3]):
        cut ||| packet_fault: Bits(3)(0)
        released.any(): (end - (released.zext(4) << 2))[0..3]

      consumed <== next_consumed
    elsewhen (repair.valid):
      consumed <== Bits(3)(0)

  assert(count <= Bits(2)(3), "rv2wide_assembly_capacity")

export:
  RV2WideFetchBlock
  RV2WideInstructionAssembler
