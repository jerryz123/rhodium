#lang rhodium
/* Serializes two retirement-lane predictor updates through a two-entry ordered buffer. */
// SPDX-License-Identifier: Apache-2.0

import:
  "bundles.rhdl".RV2WideBranchTraining
  lib("flow/main.rhdl") open

/* Accepts age-ordered Valid offers and emits one update every cycle, bypassing when empty.
   The caller must reserve capacity before issue; clear discards both queued and live offers. */
sync_circuit RV2WideBranchTrainingBuffer():
  interface incoming[2](Valid(RV2WideBranchTraining()), ~role: consumer)
  interface training(Valid(RV2WideBranchTraining()), ~role: producer)
  interface clear(Pulse(), ~role: consumer)
  output pending: Bits(2)

  reg count(~init: bits(0, 2))
  reg entries(Vec(2, RV2WideBranchTraining()))
  def queued = count.or_reduce()
  def offered = incoming[0].valid ||| incoming[1].valid
  def first = mux(incoming[0].valid, incoming[0].bits, incoming[1].bits)
  def added = incoming[0].valid.as_bits().zext(3) + incoming[1].valid.as_bits().zext(3)
  def bypass = !queued & offered
  def remaining = count.zext(3) - queued.as_bits().zext(3)
  def next_count = remaining + added - bypass.as_bits().zext(3)
  pending <== count
  training.valid <== (queued ||| offered) & !clear.valid
  training.bits <== mux(queued, entries[0], first)
  assert(clear.valid ||| (next_count <= bits(2, 3)), "rv2wide_branch_training_capacity")
  when (clear.valid):
    count <== bits(0, 2)
  otherwise:
    count <== next_count[0..2]
    when (next_count > bits(0, 3)):
      entries[0] <== mux(remaining.or_reduce(), entries[1], mux(bypass, incoming[1].bits, first))
    when (next_count === bits(2, 3)):
      entries[1] <== mux(remaining.or_reduce(), first, incoming[1].bits)

export:
  RV2WideBranchTrainingBuffer
