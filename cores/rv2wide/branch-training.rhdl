#lang rhodium
/* Serializes two retirement-lane predictor updates through a two-entry ordered buffer. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("riscv/isa/xlen.rhm").XLen
  "bundles.rhdl".RV2WideBranchTraining
  lib("flow/main.rhdl") open

/* Accepts age-ordered Valid offers and emits one update every cycle, bypassing when empty.
   The caller must reserve capacity before issue; clear discards both queued and live offers. */
sync_circuit RV2WideBranchTrainingBuffer(xlen :: XLen = XLen.X64):
  interface incoming[2](Valid(RV2WideBranchTraining(xlen)), ~role: consumer)
  interface training(Valid(RV2WideBranchTraining(xlen)), ~role: producer)
  interface clear(Pulse(), ~role: consumer)
  output pending: Bits(2)

  reg count(~init: Bits(2)(0))
  reg entries(Vec(2, RV2WideBranchTraining(xlen)))


  /* Output selection and occupancy accounting.
     A queued head wins; when empty the oldest incoming offer bypasses storage. */

  def queued = count.any()
  def offered = incoming[0].valid ||| incoming[1].valid
  def first = mux(incoming[0].valid, incoming[0].bits, incoming[1].bits)
  def added = incoming[0].valid.as_bits().zext(3) + incoming[1].valid.as_bits().zext(3)
  def bypass = !queued & offered
  def remaining = count.zext(3) - queued.as_bits().zext(3)
  def next_count = remaining + added - bypass.as_bits().zext(3)
  pending <== count
  training.valid <== (queued ||| offered) & !clear.valid
  training.bits <== mux(queued, entries[0], first)
  assert(clear.valid ||| (next_count <= Bits(3)(2)), "rv2wide_branch_training_capacity")


  /* Ordered compaction after the one emitted update.
     A retained tail stays ahead of incoming updates. Clear discards all owners. */

  def retained_tail = remaining.any()
  def next_head = priority_mux(~default: first):
    retained_tail: entries[1]
    bypass: incoming[1].bits

  def next_tail = mux(retained_tail, first, incoming[1].bits)
  when (clear.valid):
    count <== Bits(2)(0)
  otherwise:
    count <== next_count[0..2]
    when (next_count > Bits(3)(0)):
      entries[0] <== next_head

    when (next_count === Bits(3)(2)):
      entries[1] <== next_tail

export:
  RV2WideBranchTrainingBuffer
