#lang rhodium
/* Implements width-generic iterative and pipelined signed or unsigned integer multipliers. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("flow/main.rhdl") open
  lib("rhodium/std/bits.rhdl").Pow2Int
  lib("rhodium/std/ready-valid.rhdl") open

def PipelinedMultiplierStages :: PosInt = 3

/* Select independent signed or unsigned interpretation of each operand. */
bundle MultiplierMode():
  left_signed: Bool
  right_signed: Bool

/*
 * Carry two fixed-width operands and their signedness without architectural destination
 * metadata.
 */
bundle MultiplierRequest(width :: PosInt):
  left: Bits(width)
  right: Bits(width)
  mode: MultiplierMode()

/* Represent three terms modulo 2^width by their sum bits and already-shifted carries. */
bundle MultiplierCarrySave(width :: PosInt):
  sum: Bits(width)
  carry: Bits(width)

/* Compress three terms into sum and shifted carry without full-width carry propagation. */
fun multiplier_carry_save(width :: PosInt, a :: Bits(width), b :: Bits(width), c :: Bits(width)) :~ MultiplierCarrySave(width):
  MultiplierCarrySave(width):
    sum: a ^ b ^ c
    carry: ((a & b) ||| (a & c) ||| (b & c)) << 1

/*
 * Captures one request, prepares magnitudes for one cycle, then consumes one
 * multiplier bit per cycle. The accumulator holds the signed product under backpressure;
 * a replacement request can be accepted as the prior response is consumed.
 */
sync_circuit IterativeMultiplier(width :: PosInt):
  def product_width = width * 2
  def count_width = index_width(width)

  interface request(Decoupled(MultiplierRequest(width)), ~role: consumer)
  interface response(Irrevocable(Bits(product_width)), ~role: producer)

  reg active(~init: Bool(#false))
  reg preparing(~init: Bool(#false))
  reg left_negative(Bool)
  reg right_negative(Bool)
  reg count(~init: Bits(count_width)(0))
  reg multiplicand(Bits(width))
  reg accumulator(Bits(product_width))
  reg negate_result(Bool)
  reg response_valid(~init: Bool(#false))

  request.ready <== !active & (!response_valid ||| response.ready)
  response.valid <== response_valid
  response.bits <== accumulator

  def request_fire = request.fire()
  def response_fire = response.fire()
  def request_left_negative = request.bits.mode.left_signed & request.bits.left[width - 1].into(Bool)
  def request_right_negative = request.bits.mode.right_signed & request.bits.right[width - 1].into(Bool)
  def low_word = accumulator[0..width]
  def left_magnitude = mux(left_negative, -multiplicand, multiplicand)
  def right_magnitude = mux(right_negative, -low_word, low_word)

  /* The low half starts with the multiplier. Each step consumes its low bit
     and shifts the upper sum, including its carry, into the combined product. */

  def addend = mux(low_word[0].into(Bool), multiplicand, Bits(width)(0))
  def upper_sum = accumulator[width..product_width] +& addend
  def shifted_product = (upper_sum ++ low_word)[1..(product_width + 1)]
  def last_iteration = count === Bits(count_width)(width - 1)

  when request_fire:
    active <== Bool(#true)
    preparing <== Bool(#true)
    left_negative <== request_left_negative
    right_negative <== request_right_negative
    count <== Bits(count_width)(0)
    multiplicand <== request.bits.left
    accumulator <== request.bits.right.zext(product_width)
    negate_result <== request_left_negative ^ request_right_negative
    response_valid <== Bool(#false)
  elsewhen preparing:
    preparing <== Bool(#false)
    multiplicand <== left_magnitude
    accumulator <== right_magnitude.zext(product_width)
  elsewhen (active & last_iteration):
    active <== Bool(#false)
    response_valid <== Bool(#true)
    accumulator <== mux(negate_result, -shifted_product, shifted_product)
  elsewhen active:
    count <== count + Bits(count_width)(1)
    accumulator <== shifted_product
  elsewhen response_fire:
    response_valid <== Bool(#false)

/* Carries the requested product half with the operation that selects it. */
bundle MultiplierHalfRequest(width :: PosInt):
  operands: MultiplierRequest(width)
  high_result: Bool

/* Retains one product half and the carry entering its least significant chunk. */
bundle MultiplierHalfSubtotals(count :: PosInt, chunk_width :: PosInt):
  chunks: Vec(count, Bits(chunk_width + 1))
  carry_in: Bool

/* Merges unsigned partial products and signed corrections, then adds each chunk
   independently. Each subtotal includes its outgoing carry. */
fun multiplier_subtotals(width :: Pow2Int, chunk_width :: PosInt, operation :: MultiplierRequest(width)) :~ Vec(2 * width / chunk_width, Bits(chunk_width + 1)):
  unless width >= 2
  | error(~who: #'PipelinedMultiplier, "width must be at least two")

  def half_width = width / 2
  def product_width = width * 2
  def chunk_count = product_width / chunk_width
  def low_low = operation.left[0..half_width] *& operation.right[0..half_width]
  def low_high = operation.left[0..half_width] *& operation.right[half_width..width]
  def high_low = operation.left[half_width..width] *& operation.right[0..half_width]
  def low = multiplier_carry_save(product_width, low_low.zext(product_width),
                                  low_high.zext(product_width) << half_width,
                                  high_low.zext(product_width) << half_width)

  def left_negative = operation.mode.left_signed & operation.left[width - 1].into(Bool)
  def right_negative = operation.mode.right_signed & operation.right[width - 1].into(Bool)
  def high_high = operation.left[half_width..width] *& operation.right[half_width..width]
  def left_correction = mux(left_negative, !operation.right, Bits(width)(0))
  def right_correction = mux(right_negative, !operation.left, Bits(width)(0))

  def upper = multiplier_carry_save(width, high_high, left_correction, right_correction)
  // Each complemented operand needs a +1 in the upper half to complete its negation.
  def correction_count = (left_negative & right_negative).as_bits() ++ (left_negative ^ right_negative).as_bits()
  def combined = multiplier_carry_save(product_width, low.sum, low.carry, upper.sum ++ Bits(width)(0))
  def folded = multiplier_carry_save(product_width, combined.sum, combined.carry, upper.carry ++ Bits(width)(0))
  def pair = multiplier_carry_save(product_width, folded.sum, folded.carry, correction_count.zext(product_width) << width)

  def chunks = for List (chunk in 0..chunk_count):
    def lo = chunk * chunk_width
    def hi = lo + chunk_width
    pair.sum[lo..hi] +& pair.carry[lo..hi]

  vec(chunks)

/* Propagates chunk carries across the retained result, dropping overflow at its top. */
fun finish_multiplier_chunks(count :: PosInt, chunk_width :: PosInt, parts :: Vec(count, Bits(chunk_width + 1)), carry_in :: Bool):
  def sums = vec(for List (chunk in 0..count): parts[chunk][0..chunk_width])
  def carries = for List (chunk in 0..count):
    if chunk == 0 | carry_in.as_bits().zext(chunk_width) | parts[chunk - 1][chunk_width].zext(chunk_width)

  sums.as_bits() + vec(carries).as_bits()

/* Registers all chunk subtotals, then the full double-width product for vector users. */
fun pipelined_product_sum(width :: Pow2Int, request :: Endpoint) :: Endpoint:
  def chunk_width = math.min(16, 2 * width)
  def count = 2 * width / chunk_width
  def subtotals = request |> map_valid(operation => multiplier_subtotals(width, chunk_width, operation))
  def product = subtotals |> valid_pipe(1) |> map_valid(parts => finish_multiplier_chunks(count, chunk_width, parts, Bool(#false)))
  product |> valid_pipe(1)

/* Registers only the requested half's subtotals, then its XLEN result. A high
   product also needs the carry generated by the discarded low half. */
fun pipelined_product_half(width :: Pow2Int, request :: Endpoint) :: Endpoint:
  def chunk_width = math.min(16, width)
  def count = width / chunk_width
  def subtotals = request |> map_valid(payload):
    def operation :: MultiplierHalfRequest(width) = payload
    def parts = multiplier_subtotals(width, chunk_width, operation.operands)
    def chunks = for List (i in 0..count):
      mux(operation.high_result, parts[count + i], parts[i])

    def mutable carry = Bool(#false)
    for (i in 0..count):
      carry := parts[i][chunk_width].into(Bool) ||| (parts[i][0..chunk_width].all() & carry)

    MultiplierHalfSubtotals(count, chunk_width):
      chunks: vec(chunks)
      carry_in: operation.high_result & carry

  def product = subtotals |> valid_pipe(1) |> map_valid(payload):
    def half :: MultiplierHalfSubtotals(count, chunk_width) = payload
    finish_multiplier_chunks(count, chunk_width, half.chunks, half.carry_in)

  product |> valid_pipe(1)

/* Delivers one double-width product per cycle after three registered stages. */
sync_circuit PipelinedMultiplier(width :: Pow2Int):
  interface request(Valid(MultiplierRequest(width)), ~role: consumer)
  interface response(Valid(Bits(width * 2)), ~role: producer)

  pipelined_product_sum(width, request) |> valid_pipe(1) |> response

export:
  MultiplierMode
  MultiplierRequest
  MultiplierHalfRequest
  PipelinedMultiplierStages
  IterativeMultiplier
  pipelined_product_sum
  pipelined_product_half
  PipelinedMultiplier
