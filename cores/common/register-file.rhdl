#lang rhodium
/* Provides shared GPR storage with configurable read and synchronous write ports. */
// SPDX-License-Identifier: Apache-2.0

import:
  "register-write.rhdl".RegisterFileWrite
  lib("riscv/isa/xlen.rhm").XLen
  lib("rhodium/std/ready-valid.rhdl") open

/* Stores unreset GPRs with the selected combinational pre-edge reads and synchronous writes.
   Reads do not bypass live writes: pipeline forwarding belongs to the caller. x0 is hardwired
   to zero; simultaneous nonzero writes must have distinct destinations. */
sync_circuit RegisterFile(xlen :: XLen, ~read_ports: read_ports :: PosInt, ~write_ports: write_ports :: PosInt = 2):
  input read_addresses: Vec(read_ports, Bits(5))
  output read_data: Vec(read_ports, Bits(xlen.width))
  interface writes[write_ports](Valid(RegisterFileWrite(xlen)), ~role: consumer)

  def Word = Bits(xlen.width)
  reg registers(Vec(31, Word))
  def words = [Word(0)] ++ (for List (row in 0..31): registers[row])

  /* Each read port shares its low-bit decode across four groups of eight.
     The high bits select the group; x0 is a constant input to group zero. */

  for (port in 0..read_ports):
    def address = read_addresses[port]
    def lane = one_hot(address[0..3])
    def groups = for List (group in 0..4):
      lane.mux(words.drop(8 * group).take(8))

    read_data[port] <== vec(groups)[address[3..5]]

  /* Decode writes by architectural address. Only x1 through x31 have a
     destination, and the collision check ensures at most one writer per row. */

  def write_data = for List (port in 0..write_ports): writes[port].bits.data
  for (address in 1..32):
    def claims = for List (port in 0..write_ports):
      writes[port].valid & (writes[port].bits.address === Bits(5)(address))

    def writer = vec(claims).into(MaybeOneHot(write_ports))
    when (writer.valid):
      registers[address - 1] <== writer.mux(write_data, ~default: Word(0))

  for (port in 0..write_ports):
    for (other in port + 1..write_ports):
      assert(!(writes[port].valid & writes[other].valid & writes[port].bits.address.any() & (writes[port].bits.address === writes[other].bits.address)), "register_file_distinct_writes_" ++ to_string(port) ++ "_" ++ to_string(other))

export RegisterFile
