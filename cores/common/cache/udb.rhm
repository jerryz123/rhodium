#lang rhombus
/* Describes shared L1D reservation and cache-maintenance behavior. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("riscv/udb.rhm") open

/* Describes the delivered L1D policies; the caller still supplies memory-map and address-width constraints. */
fun cache_udb_parameters(zicbom :: Boolean) :: NonemptyList.of(UdbParameter):
  [
    string_parameter("LRSC_RESERVATION_STRATEGY", "reserve exactly enough to cover the access"),
    boolean_parameter("LRSC_FAIL_ON_VA_SYNONYM", #false),
    boolean_parameter("LRSC_FAIL_ON_NON_EXACT_LRSC", #true)
  ] ++ (if zicbom | [boolean_parameter("FORCE_UPGRADE_CBO_INVAL_TO_FLUSH", #false)] | [])

export cache_udb_parameters
