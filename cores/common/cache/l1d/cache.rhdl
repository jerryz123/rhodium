#lang rhodium
/* Implements and traces shared L1D lookup resolution, transaction transport, and coherent miss
   service. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/layers/statistics.rhm").stat_count
  "../../cache-prefetch.rhdl" open
  "../protocol.rhdl" open
  "arrays.rhdl" open
  "store-buffer.rhdl" open
  "../operation.rhdl" open
  "../geometry.rhdl" open
  "../chi/flits.rhdl" open
  "../chi/refill.rhdl" open
  "../chi/snoop.rhdl" open
  "../chi/writeback.rhdl" open
  "../../load-store.rhdl" open
  "../../../../riscv/isa/xlen.rhm" open
  "../../../../riscv/rtl/atomic.rhdl" open
  "../../../../riscv/rtl/zihintntl.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/plru.rhdl") open
  lib("rhodium/std/read-write.rhdl") open
  lib("flow/main.rhdl") open
  lib("chi/protocol/flits.rhdl") open
  lib("chi/protocol/coherence.rhdl") open
  lib("chi/transactions/cache-maintenance.rhdl") open
  lib("chi/protocol/channels.rhdl").CHIRNChannels

/* Owns word-at-a-time line gathering for dirty eviction or snoop data handoff. */
hardware_enum L1DGatherState:
  Idle
  EvictionRead
  EvictionReady
  SnoopRead
  SnoopReady

/* Labels the winning physical SRAM user independently of scalar instruction ownership. */
hardware_enum L1DArrayOwner:
  Pipeline
  Service
  Snoop
  Refill
  Mutation
  Gather
  StoreDrain

/* Pairs an authorized physical request with demand or best-effort prefetch intent. */
bundle L1DLookup(xlen :: XLen, Context :: DataType, beat_bytes :: Pow2Int):
  request: PhysicalMemoryBeatReq(xlen, Context, beat_bytes)
  prefetch: Bool
  prefetch_write: Bool

/* Captures tag/state/data resolution and the chosen replacement victim for elastic S4 service. */
bundle L1DResolved(xlen :: XLen, way_width :: PosInt, Context :: DataType, beat_bytes :: Pow2Int):
  lookup: L1DLookup(xlen, Context, beat_bytes)
  hit: Bool
  hit_way: Bits(way_width)
  state: CHICacheState
  word: Bits(beat_bytes * 8)
  allocation_way: Bits(way_width)
  victim_valid: Bool
  victim_state: CHICacheState
  victim_address: Bits(xlen.width)

/* Rejects address widths lacking tag bits beyond the line offset and set index. */
fun check_l1d_geometry(width :: PosInt, cache :: CacheConfig):
  unless width > (alignment_bits(CacheLineBytes) + cache.set_width)
  | error(~who: #'L1DCache,
          "address width must include line offset, set, and tag bits")


/* Combines a fixed-cycle speculative hit path, explicitly authorized stores, and queued S3/S4 slow service.
   One miss reserves its set while independent loads may hit; coherent snoops, LR/SC, and refill
   installation own explicit SRAM turns. */
sync_circuit L1DCache(xlen :: XLen,
                      cache :: CacheConfig,
                      ~chi: config :: RiscvHartCHIConfig,
                      ~service_queue_depth: service_queue_depth :: PosInt = 2,
                      ~context: Context :: DataType,
                      ~beat_bytes: beat_bytes :: Pow2Int = xlen.width / 8):
  def width = xlen.width
  def p = config.flit
  unless config.cache_line_bytes == CacheLineBytes
  | error(~who: #'L1DCache, "CHI region geometry must use 64-byte cache lines")

  def physical_width = math.min(width, p.request_address_width)
  def snoop_width = math.max(width, p.request_address_width)
  check_l1d_geometry(physical_width, cache)
  def sets = cache.sets
  def ways = cache.ways
  unless beat_bytes == width / 8 || beat_bytes == 16
  | error(~who: #'L1DCache, "beat size must be XLEN bytes or 16")

  def beat_width = beat_bytes * 8
  def words_per_line = cache_line_rows(beat_bytes)
  def data_depth = sets * words_per_line
  def data_lanes = ways * beat_bytes
  def offset_width = alignment_bits(CacheLineBytes)
  def row_offset_width = alignment_bits(beat_bytes)
  def set_width = cache.set_width
  def way_width = cache.way_width
  def tag_width = physical_width - offset_width - set_width
  def word_index_width = index_width(words_per_line)
  def data_address_width = index_width(data_depth)

  /* Selects an explicitly row-oriented transfer; scalar specializations have no mode bit. */
  fun is_raw_beat(request :: CachePipelineBeatReq(xlen, beat_bytes) || PhysicalMemoryBeatReq(xlen, Context, beat_bytes)) :~ Bool:
    if beat_bytes == width / 8 | Bool(#false) | request.raw_beat

  /* Returns scalar results in the low XLEN bits, including sign-extended subword loads. */
  fun scalar_response(value :: Bits(width)) :~ Bits(beat_width):
    value.zext(beat_width)

  input node_id: Bits(p.node_id_width)
  interface core(CacheAccess(xlen, Context, beat_bytes), ~role: responder)
  interface virtual_lookup(Valid(Bits(width)), ~role: consumer)
  interface pipeline_lookup(Valid(CachePipelineBeatReq(xlen, beat_bytes)), ~role: consumer)
  interface pipeline(CachePipelineAccess(xlen, beat_bytes), ~role: responder)
  interface prefetch(Valid(CachePrefetchReq(width)), ~role: consumer)
  interface chi(CHIRNChannels(p), ~role: node)

  /* Raw transfers cover one aligned coherent row and never reinterpret atomic or management operations. */
  fun check_raw_request(valid :: Bool, address :: Bits(width), access :: CacheOperation):
    when valid:
      assert(address.is_aligned(beat_bytes) & access.is_one_of(CacheOperation.Load, CacheOperation.Store), "l1d_raw_beat_is_aligned_load_or_store")

  if beat_width > width
  | block:
      check_raw_request(pipeline.request.valid & is_raw_beat(pipeline.request.bits), pipeline.request.bits.address, pipeline.request.bits.access)
      check_raw_request(core.request.valid & is_raw_beat(core.request.bits), core.request.bits.address, core.request.bits.access)
  | #void

  /* Array storage and transaction services.
     Independent synchronous ports serve tags, state, and byte-masked data;
     refill, snoop, and writeback engines retain their own CHI lifetimes. */

  inst arrays(CacheDCacheArrays(xlen, cache, tag_width, beat_bytes))
  inst stores(CacheStoreBuffer(xlen, way_width, ~beat_bytes: beat_bytes))
  def StoreBufferEntry = CacheStoreBufferEntry(xlen, way_width, beat_bytes)
  inst s2_store_candidate(ValidPipeAlwaysCapture(StoreBufferEntry, 1))
  inst s1_store_gen(StoreGen(xlen, beat_bytes))
  inst service_load_gen(LoadGen(xlen, beat_bytes))
  inst s1_load_gen(LoadGen(xlen, beat_bytes))
  reg s1_read_valid(~init: Bool(#false))
  reg s1_read_address(Bits(width))
  inst local_store_gen(StoreGen(xlen, beat_bytes))
  inst local_atomic_alu(RiscvAtomicALU(xlen))
  inst refill_load_gen(LoadGen(xlen, beat_bytes))
  inst refill_store_gen(StoreGen(xlen, beat_bytes))
  inst refill_atomic_alu(RiscvAtomicALU(xlen))
  inst refill(CacheLineRefill(Bool, width, config))
  inst snoop(CacheDataSnoop(snoop_width, config, ~beat_bytes: beat_bytes))
  inst writeback(CacheLineWriteback(Bool, width, config, 1))
  inst maintenance(CHICacheMaintenance(p, PhysicalMemoryBeatReq(xlen, Context, beat_bytes)))
  maintenance.node_id <== node_id
  maintenance.txn_id <== Bits(12)(2)
  refill.node_id <== node_id
  snoop.node_id <== node_id
  writeback.node_id <== node_id
  // Registered capacity owns acceptance even when a paired virtual lookup can
  // bypass this buffer. Busy arrays retain permitted physical requests here.
  inst service_requests(Queue(PhysicalMemoryBeatReq(xlen, Context, beat_bytes), service_queue_depth, ~flow: #true))
  // S3 retains its request if older S4 work takes the arrays. Its returned
  // data is discarded and reread before retry, including across snoop service.
  inst s3_lookup(Pipe(L1DLookup(xlen, Context, beat_bytes), 1))
  inst s4_result(Pipe(L1DResolved(xlen, way_width, Context, beat_bytes), 1))
  reg s3_read_valid(~init: Bool(#false))
  // Retain a slow completion until its downstream writeback path accepts it.
  // Registered-only input capacity keeps response backpressure out of request
  // admission and the core's translation-flush ready path.
  inst service_responses(Queue(PhysicalMemoryBeatResp(xlen, Context, beat_bytes), 2))


  /* Persistent cache and engine state.
     Metadata, reservations, mutation, miss ownership, and gathering span
     transactions rather than fixed core pipeline stages. */

  reg valid_lines(~init: vec(for List (_set in 0..sets): Bits(ways)(0).as_vec(Bool)))
  reg replacement_state(~init: vec(for List (_set in 0..sets): plru_initial_state(ways)))
  reg snoop_way(~init: Bits(way_width)(0))
  // Fixed microarchitectural budget, not an ISA promise about cycle counts.
  // Give local LR/SC a turn, then admit probes even if the core is stalled.
  // This bounds probe deferral, not reservation lifetime; repeated LR cannot renew it.
  def reservation_cycles = 128
  def reservation_backoff = 3
  def reservation_count_width = index_width(reservation_cycles + reservation_backoff + 1)
  reg reservation_count(~init: Bits(reservation_count_width)(0))
  reg core_service_count(~init: Bits(4)(0))
  def reservation_protected = reservation_count > Bits(reservation_count_width)(reservation_backoff)
  reg reservation_valid(~init: Bool(#false))
  core.reservation_valid <== reservation_valid
  reg reservation_address(~init: Bits(width)(0))
  reg reservation_width(~init: MemoryWidth.Word)


  /* Retained S4 service. A local mutation and a miss share the original request
     and selected way; each keeps its own progress and completion state. */

  reg retained_request(PhysicalMemoryBeatReq(xlen, Context, beat_bytes))
  reg retained_way(Bits(way_width))
  reg pending_mutation_valid(~init: Bool(#false))
  reg pending_mutation_old_value(Bits(width))
  reg pending_zero_index(~init: Bits(word_index_width)(0))
  reg refill_installing(~init: Bool(#false))
  reg refill_install_index(~init: Bits(word_index_width)(0))
  // Reserve the whole set across victim gather, writeback, retry, and install.
  // Only ordinary demand loads/stores permit independent pipeline load hits.
  reg miss_active(~init: Bool(#false))
  reg miss_allows_hits(~init: Bool(#false))
  reg miss_allocation(Bool)
  reg miss_install(Bool)
  reg miss_prefetch(Bool)
  // Every row is written before its owner can publish the victim or the replacement.
  reg backing_line(Vec(words_per_line, Bits(beat_width)))
  writeback.line <== backing_line.as_bits()
  def retained_set = retained_request.address[offset_width..(offset_width + set_width)]
  def retained_line_address = retained_request.address.align_down(CacheLineBytes)
  reg gather_state(~init: L1DGatherState.Idle)
  reg gather_issue_index(~init: Bits(word_index_width)(0))
  reg gather_response_pending(~init: Bool(#false))
  reg gather_response_index(~init: Bits(word_index_width)(0))
  reg gather_last_issued(~init: Bool(#false))
  reg gather_set(Bits(set_width))
  reg gather_way(Bits(way_width))
  reg eviction_line_address(Bits(width))
  reg eviction_state(~init: CHICacheState.Invalid)
  reg gathered_snoop_state(~init: CHICacheState.Invalid)
  reg snoop_metadata_pending(~init: Bool(#false))


  /* Speculative hit-path grants.
     Registers are named for their consuming stage. Scheduler grants below
     are combinational and add no buffering to the fixed-cycle hit path. */

  wire hit_path_available: Bool
  wire hit_under_miss: Bool
  wire store_drain: Bool
  def store_state_write = store_drain & stores.drain.bits.mark_dirty
  def snoop_pending = snoop.pending
  def snoop_lookup_start = snoop.lookup.valid


  /* S0: Speculative array-read admission.
     Indexes by virtual page offset without reserving a transaction;
     older authorized work and coherence retain SRAM priority. */

  def s0_load = pipeline_lookup.valid & (pipeline_lookup.bits.access === CacheOperation.Load)
  def s0_miss_set_clear = s0_load & (pipeline_lookup.bits.address[offset_width..(offset_width + set_width)] =/= retained_set)
  def s0_read_issue = pipeline_lookup.valid & (hit_path_available ||| (hit_under_miss & s0_miss_set_clear)) & !snoop_lookup_start & !snoop_metadata_pending & !snoop.update.valid & !store_state_write & !(store_drain & s0_load)
  s1_read_valid <== s0_read_issue
  when s0_read_issue:
    s1_read_address <== pipeline_lookup.bits.address


  /* S1: Physical resolution and hit response.
     Pairs SRAM outputs with the translated tag. Hit data is combinational
     for the caller's capture register, not a second cache response stage. */

  def s1_array_words = arrays.data.response.bits.as_bits().as_vec(Bits(beat_width))
  def s1_store = pipeline.request.bits.access === CacheOperation.Store
  def s1_set = pipeline.request.bits.address[offset_width..(offset_width + set_width)]
  def s1_tag = pipeline.request.bits.address[(offset_width + set_width)..physical_width]
  def s1_address_fits = cache_chi_address_fits(pipeline.request.bits.address, p)
  def s1_tag_matches = vec(for List (way in 0..ways): s1_address_fits & valid_lines[s1_set][way] & (arrays.tags.response.bits[way] === s1_tag))
  def s1_hit_way = priority_encoder_oh(s1_tag_matches)
  def s1_row = s1_hit_way.mux(for List (way in 0..ways): s1_array_words[way], ~default: Bits(beat_width)(0))
  s1_load_gen.data <== s1_row
  s1_load_gen.address <== pipeline.request.bits.address
  s1_load_gen.width <== pipeline.request.bits.width
  s1_load_gen.unsigned_load <== pipeline.request.bits.unsigned
  def s1_state = s1_hit_way.mux(for List (way in 0..ways): arrays.states.response.bits[way], ~default: CHICacheState.Invalid).into(CHICacheState)
  s1_store_gen.address <== pipeline.request.bits.address
  s1_store_gen.width <== pipeline.request.bits.width
  s1_store_gen.value <== pipeline.request.bits.data[0..width]
  stores.query_address <== pipeline.request.bits.address
  stores.query_mask <== mux(is_raw_beat(pipeline.request.bits) & !s1_store, !Bits(beat_bytes)(0), pipeline.request.bits.byte_mask)
  def s1_probe_conflict = snoop_pending & (snoop.address[6..snoop_width] === pipeline.request.bits.address.zext(snoop_width)[6..snoop_width])
  def s1_read_matches = s1_read_valid & arrays.tags.response.valid & arrays.states.response.valid & (s1_store ||| arrays.data.response.valid) & (s1_read_address[0..12] === pipeline.request.bits.address[0..12])
  wire s1_outcome: CachePipelineOutcome
  wire s1_reason: CachePipelineReason
  def s1_miss_set_clear = (pipeline.request.bits.access === CacheOperation.Load) & (s1_set =/= retained_set)
  // Ordinary accesses to the one outstanding line become authorized waiters.
  // They do not consume a partial refill: authorization queues them, and the transaction
  // path performs a fresh authoritative lookup after installation completes.
  def s1_same_line_waiter = miss_active & pipeline.request.bits.access.is_one_of(CacheOperation.Load, CacheOperation.Store) & (pipeline.request.bits.address.align_down(CacheLineBytes) === retained_line_address)
  when (!s1_address_fits):
    s1_outcome <== CachePipelineOutcome.AccessFault
    s1_reason <== CachePipelineReason.Translation
  elsewhen s1_same_line_waiter:
    s1_outcome <== CachePipelineOutcome.Slow
    s1_reason <== CachePipelineReason.Miss
  elsewhen (!(hit_path_available ||| (hit_under_miss & s1_miss_set_clear))):
    s1_outcome <== CachePipelineOutcome.Replay
    s1_reason <== mux(snoop_pending, CachePipelineReason.Probe, CachePipelineReason.Miss)
  elsewhen s1_probe_conflict:
    s1_outcome <== CachePipelineOutcome.Replay
    s1_reason <== CachePipelineReason.Probe
  elsewhen (!s1_read_matches):
    s1_outcome <== CachePipelineOutcome.Replay
    s1_reason <== CachePipelineReason.ArrayPort
  elsewhen (!s1_hit_way.valid ||| (s1_store & !s1_state.is_unique())):
    // A second miss cannot allocate or enter the authorized request queue.
    s1_outcome <== mux(miss_active, CachePipelineOutcome.Replay, CachePipelineOutcome.Slow)
    s1_reason <== CachePipelineReason.Miss
  elsewhen (!s1_store & stores.word_hazard):
    s1_outcome <== CachePipelineOutcome.Replay
    s1_reason <== CachePipelineReason.StoreDependency
  elsewhen (s1_store & !stores.enqueue.ready):
    s1_outcome <== CachePipelineOutcome.Replay
    s1_reason <== CachePipelineReason.StoreCapacity
  otherwise:
    s1_outcome <== mux(s1_store, CachePipelineOutcome.StoreHit, CachePipelineOutcome.LoadHit)
    s1_reason <== CachePipelineReason.None

  def resolved_access = pipeline.request |> trace_valid_event("dcache/s1.access", ~fields: request):
    address: request.address
    access(~format: "enum"): request.access
    width(~format: "enum"): request.width
    byte_mask: request.byte_mask
    outcome(~format: "enum"): s1_outcome
    reason(~format: "enum"): s1_reason

  def Array(response_path, store_candidate_path) = resolved_access |> fork_valid(2)
  (
    response_path |> map_valid(_request => CachePipelineBeatResult(xlen, beat_bytes)):
      outcome: s1_outcome
      reason: s1_reason
      data: mux(is_raw_beat(pipeline.request.bits), s1_row, scalar_response(s1_load_gen.value))
  ) |> pipeline.response

  when (pipeline.request.valid & miss_active & (s1_outcome === CachePipelineOutcome.LoadHit)):
    assert(miss_allows_hits & s1_miss_set_clear & s1_read_matches, "l1d_hit_under_miss_isolated")

  (
    store_candidate_path
      |> filter_valid(_request => s1_outcome === CachePipelineOutcome.StoreHit)
      |> map_valid(request => CacheStoreBufferEntry(xlen, way_width, beat_bytes)):
        address: request.address
        way: s1_hit_way.index
        data: mux(is_raw_beat(request), request.data, s1_store_gen.data)
        mask: pipeline.request.bits.byte_mask
        mark_dirty: !s1_state.is_dirty()
  ) |> s2_store_candidate.ingress


  /* S2: Store authorization.
     Enqueues only the matching retained store candidate. A same-line probe
     revokes the ownership proof; unrelated probes do not reject this store. */

  def s2_probe_conflict = snoop_pending & (snoop.address[6..snoop_width] === s2_store_candidate.egress.bits.address.zext(snoop_width)[6..snoop_width])
  pipeline.commit_ready <== s2_store_candidate.egress.valid & stores.enqueue.ready & hit_path_available & !s2_probe_conflict
  stores.enqueue.valid <== pipeline.commit & pipeline.commit_ready
  stores.enqueue.bits <== s2_store_candidate.egress.bits


  /* Authorized service ingress and maintenance.
     Retained requests and coherence are independent of core-stage progress;
     maintenance waits for older arrays, stores, and responses to drain. */

  service_responses.egress |> core.response
  core.request_fault <== Bool(#false)
  def service_address_fits = cache_chi_address_fits(core.request.bits.address, p)
  core.request_access_fault <== core.request.valid & !service_address_fits

  def maintenance_active = !maintenance.command.ready
  def Array(ordinary_requests, management_requests) = service_requests.egress |> demux_flow(2, request => request.access.into(CacheOperation).is_cache_management().as_bits())
  def management_waiting = management_requests.valid
  def management_address = cache_chi_address(management_requests.bits.address.align_down(CacheLineBytes), p)
  def management_home = config.home_map.lookup(management_address)
  def maintenance_engines_drained = refill.command.ready & writeback.command.ready & !pending_mutation_valid & !refill_installing & (gather_state === L1DGatherState.Idle)
  def maintenance_lookups_drained = !s2_store_candidate.egress.valid & !s3_lookup.egress.valid & !s4_result.egress.valid & !service_responses.egress.valid
  (
    management_requests |> gate_flow(stores.empty & maintenance_engines_drained & maintenance_lookups_drained)
      |> map_flow(request => CHICacheMaintenanceCommand(p, PhysicalMemoryBeatReq(xlen, Context, beat_bytes))):
         address: management_address
         opcode: mux(request.access === CacheOperation.CacheBlockClean, CHIReqOpcode.CleanShared, CHIReqOpcode.CleanInvalid)
         snoop_me: Bool(#true)
         home_id: management_home.node_id
         pas: CHIPAS.Secure
         context: request
  ) |> maintenance.command

  def maintenance_done = maintenance.completion |> gate_flow(service_responses.ingress.ready) |> to_valid()
  def maintenance_complete = maintenance_done.valid
  def prefetch_request = prefetch.bits.into(CachePrefetchReq(width))
  def prefetch_valid = prefetch.valid & cache_chi_address_fits(prefetch_request.address, p) & prefetch_request.operation.is_one_of(CachePrefetchOperation.Read, CachePrefetchOperation.Write)


  /* S2 service indexing and hint selection.
     Queued physical demands precede best-effort prefetches. Retry and
     retained service stages below may stall independently of core cycles. */

  def s2_queued = service_requests.count.any()
  def s2_prefetch = prefetch_valid & !virtual_lookup.valid & !s2_queued & !reservation_count.any() & !pipeline_lookup.valid & !pipeline.request.valid & !s2_store_candidate.egress.valid & stores.empty
  // Buffered requests and hints are already physical; their page offsets are
  // the same index as the original VA. A fresh demand indexes directly by VA.
  def s2_index_address = priority_mux(~default: virtual_lookup.bits):
    s2_queued: service_requests.egress.bits.address
    s2_prefetch: prefetch_request.address


  /* S3: Retained authorized lookup.
     Pairs the retained request with its current synchronous SRAM response;
     blocked work must reread after older mutation or coherence service. */

  def s3_request = s3_lookup.egress.bits.request
  def s3_set = s3_request.address[offset_width..(offset_width + set_width)]
  def s3_tag = s3_request.address[(offset_width + set_width)..physical_width]
  def s3_valids = valid_lines[s3_set]
  def s3_matches = vec(for List (way in 0..ways): s3_valids[way] & (arrays.tags.response.bits[way] === s3_tag))
  def s3_hit_way = priority_encoder_oh(s3_matches)
  def s3_state = s3_hit_way.mux(for List (way in 0..ways): arrays.states.response.bits[way], ~default: CHICacheState.Invalid).into(CHICacheState)
  def s3_allocation_way = plru_replacement_way(ways, s3_valids, replacement_state[s3_set])
  def s3_word = s3_hit_way.mux(for List (way in 0..ways): s1_array_words[way], ~default: Bits(beat_width)(0))


  /* S4: Retained permission and transaction resolution.
     Uses captured lookup results to choose a local hit, refill, or eviction.
     This elastic service stage is not a fixed requester-cycle boundary. */

  def s4_context = s4_result.egress.bits.lookup.into(L1DLookup(xlen, Context, beat_bytes))
  wire s4_refill_accepted: Bool
  wire s4_refill_opcode: CHIReqOpcode
  wire s4_refill_address: Bits(width)
  def s4_observed = s4_result.egress |> trace_event("dcache/s4.resolve", ~fields: result):
    address: s4_context.request.address
    prefetch: s4_context.prefetch
    hit: result.hit
    refill_accepted: s4_refill_accepted
    refill_opcode(~format: "enum"): s4_refill_opcode
    refill_address: s4_refill_address

  def s4_path = s4_observed
  def s4_request :: PhysicalMemoryBeatReq(xlen, Context, beat_bytes) = s4_context.request
  def s4_prefetch = s4_context.prefetch
  def s4_prefetch_write = s4_context.prefetch_write
  def s4_set = s4_request.address[offset_width..(offset_width + set_width)]
  def s4_hit = s4_result.egress.bits.hit
  def s4_state = s4_result.egress.bits.state.into(CHICacheState)
  def s4_victim_valid = s4_result.egress.bits.victim_valid
  def s4_victim_state = s4_result.egress.bits.victim_state.into(CHICacheState)
  def s4_access = s4_request.access
  def s4_valid = s4_result.egress.valid
  def s4_load = s4_valid & !s4_prefetch & s4_access.is_load()
  def s4_store = s4_valid & !s4_prefetch & s4_access.is_store()
  def s4_zero = s4_valid & !s4_prefetch & s4_access.is_cache_block_zero()
  def s4_atomic = s4_valid & !s4_prefetch & s4_access.is_atomic()
  def s4_sc = s4_valid & !s4_prefetch & s4_access.is_store_conditional()
  def s4_lr = s4_load & (s4_access === CacheOperation.LoadReserved)
  def s4_reservation_matches = reservation_valid & (reservation_address === s4_request.address) & (reservation_width === s4_request.width)
  def s4_sc_authorized = s4_reservation_matches & s4_hit & s4_state.is_unique()
  def s4_mutation = s4_store ||| s4_zero ||| s4_atomic ||| (s4_sc & s4_sc_authorized)
  def s4_owned_mutation = s4_mutation & s4_hit & s4_state.is_unique()
  def s4_prefetch_needs_refill = s4_valid & s4_prefetch & !reservation_count.any() & (!s4_hit ||| (s4_prefetch_write & !s4_state.is_unique()))
  def s4_prefetch_dirty_victim = s4_prefetch_needs_refill & !s4_hit & s4_victim_valid & s4_victim_state.is_dirty()
  def s4_needs_refill = s4_load & (!s4_hit ||| (s4_lr & !s4_state.is_unique())) ||| s4_mutation & !s4_owned_mutation ||| (s4_prefetch_needs_refill & !s4_prefetch_dirty_victim)

  /* Makes nondefault-locality ordinary load misses consume the clean refill buffer without
     installing. LR, mutations, and prefetches retain their independent allocation policy. */
  fun bypass_allocation(result :: L1DResolved(xlen, way_width, Context, beat_bytes)):
    def lookup = result.lookup.into(L1DLookup(xlen, Context, beat_bytes))
    !lookup.prefetch & !result.hit & (lookup.request.access === CacheOperation.Load) & (lookup.request.locality =/= RiscvMemoryLocality.Default)

  def s4_bypass_refill = bypass_allocation(s4_result.egress.bits)
  def s4_dirty_victim = s4_needs_refill & !s4_bypass_refill & !s4_prefetch & !s4_hit & s4_victim_valid & s4_victim_state.is_dirty()
  def s4_word = s4_result.egress.bits.word
  def gather_idle = gather_state === L1DGatherState.Idle
  def gather_read = gather_state.is_one_of(L1DGatherState.EvictionRead, L1DGatherState.SnoopRead)
  def gather_issue = gather_read & !gather_last_issued
  def gather_issue_final = gather_issue_index === Bits(word_index_width)(words_per_line - 1)
  def gather_response_final = gather_response_index === Bits(word_index_width)(words_per_line - 1)

  // Every branch retains the complete resolved result until its consumer
  // constructs a command or captures state from the accepted event.
  def Array(s4_hit_path, s4_transaction_path) = s4_path |> demux_flow(2, _result => s4_needs_refill.as_bits())
  def Array(s4_refill_path, s4_eviction_path) = s4_transaction_path |> demux_flow(2, _result => s4_dirty_victim.as_bits())
  def s4_local = s4_hit_path |> gate_flow(service_responses.ingress.ready) |> to_valid()

  /* Refill and victim-writeback commands.
     Direct acquisition uses live S4 data; a completed eviction resumes the
     same miss from its L1D record. Neither engine owns a copy of that record. */

  /* Selects the acquisition and supplies the prefetch flag for launch accounting. */
  fun refill_command(request :: PhysicalMemoryBeatReq(xlen, Context, beat_bytes), prefetch :: Bool, prefetch_write :: Bool) :~ CacheLineRefillCommand(Bool, width):
    CacheLineRefillCommand(Bool, width):
      line_address: request.address.as_bits().align_down(CacheLineBytes)
      opcode: mux(prefetch_write ||| request.access.into(CacheOperation).needs_unique() ||| (request.access === CacheOperation.LoadReserved), CHIReqOpcode.ReadUnique, CHIReqOpcode.ReadClean)
      context: prefetch

  def direct_refill_commands = (
    s4_refill_path
      |> map_flow(result):
        def lookup = result.lookup.into(L1DLookup(xlen, Context, beat_bytes))
        refill_command(lookup.request, lookup.prefetch, lookup.prefetch_write)
  )

  def s4_victim_address = s4_result.egress.bits.victim_address
  def eviction_start = s4_eviction_path |> gate_flow(gather_idle & !refill_installing) |> to_valid()
  def eviction_gather_start = eviction_start.valid
  def eviction_command = CacheLineWritebackCommand(Bool, width):
    line_address: eviction_line_address
    context: Bool(#false)

  def eviction_command_valid = gather_state === L1DGatherState.EvictionReady
  wire eviction_command_ready: Bool
  inject_interface(Decoupled(hardware_value_type(eviction_command)), ~valid: eviction_command_valid, ~bits: eviction_command, ~ready: eviction_command_ready) |> writeback.command
  def writeback_command_fire = writeback.command.fire()
  writeback.victim_state <== eviction_state
  writeback.snoop_pending <== snoop_pending
  when eviction_gather_start:
    eviction_state <== eviction_start.bits.victim_state
  elsewhen (snoop.update.valid & (snoop.update.bits.address.align_down(CacheLineBytes) === eviction_line_address.zext(snoop_width))):
    eviction_state <== mux(snoop.update.bits.invalidate, CHICacheState.Invalid, snoop.update.bits.state)

  // Only a demand can evict a dirty victim. Resume the requested line, not the victim.
  def post_eviction_refills = writeback.completion |> map_flow(_done => refill_command(retained_request, Bool(#false), Bool(#false)))

  // Direct launch is an S4 decision, not another pipeline stage. The command
  // fields are meaningful when accepted; the refill contract retains ancestry.
  s4_refill_accepted <== direct_refill_commands.fire()
  s4_refill_opcode <== direct_refill_commands.bits.opcode
  s4_refill_address <== direct_refill_commands.bits.line_address
  // Gather ancestry is not yet modeled; writeback supplies its own resident owner.
  Array(direct_refill_commands, post_eviction_refills) |> arbiter() |> refill.command
  stat_count("dcache_miss", refill.command.fire() & !refill.command.bits.context)
  def writeback_complete = writeback.completion.fire()
  when (writeback.completion.valid):
    assert(miss_active, "l1d_copyback_retains_miss")


  /* Refill completion and installation.
     Finishes accepted snoops before installing. New probes wait through the
     acknowledged grant and word-at-a-time installation interval. */

  def refill_can_complete = !snoop_pending & gather_idle & !refill_installing & !pending_mutation_valid
  def refill_install_start = refill.completion.valid & miss_install & refill_can_complete
  def refill_install_final = refill_install_index === Bits(word_index_width)(words_per_line - 1)
  def refill_install_word = refill_installing
  // ReadClean returns a clean copy, which CHI permits us to silently discard.
  // A bypass consumes the acknowledged transaction buffer without touching
  // arrays, replacement state, or any resident line's reservation.
  refill.completion.ready <== mux(miss_install, refill_installing & refill_install_final, refill_can_complete) & (miss_prefetch ||| service_responses.ingress.ready)
  def complete_refill = refill.completion.fire()
  def install_refill = complete_refill & miss_install
  when (refill.completion.valid):
    assert(miss_active & (refill.completion.bits.line_address === retained_line_address), "l1d_refill_matches_miss")

  when complete_refill:
    assert(!refill.completion.bits.pass_dirty, "l1d_refill_not_dirty")
    assert(!retained_request.access.is_store_conditional(), "l1d_sc_never_refills")
    when (retained_request.access === CacheOperation.LoadReserved):
      assert(refill.completion.bits.state === CHIResponseState.Unique, "l1d_lr_refill_owned")

  def refill_access = retained_request.access
  def refill_tag = retained_request.address[(offset_width + set_width)..physical_width]
  def refill_word_index = retained_request.address[row_offset_width..offset_width]
  def service_load_request :: PhysicalMemoryBeatReq(xlen, Context, beat_bytes) = mux(complete_refill, retained_request, s4_request)
  def service_load_unsigned = mux(service_load_request.access === CacheOperation.Load, service_load_request.unsigned, Bool(#false))
  def refilled_word = backing_line[refill_word_index]
  service_load_gen.address <== service_load_request.address
  def service_row = mux(complete_refill, refilled_word, s4_word)
  service_load_gen.data <== service_row
  service_load_gen.width <== service_load_request.width
  service_load_gen.unsigned_load <== service_load_unsigned
  def refill_mutation = refill.completion.valid & !miss_prefetch & refill_access.needs_unique()

  /* Local mutation datapath.
     An authorized owned hit retains its request and old value through the
     SRAM write or final block-zero word; no new CHI owner is allocated. */

  def local_mutation = s4_mutation & s4_owned_mutation
  def local_mutation_capture = local_mutation & s4_local.valid
  def pending_mutation_access = retained_request.access
  // Owned hits keep the SRAM until the complete block is zero. No new CHI
  // transaction is held up by this bounded interval; snoops resume afterward.
  def pending_zero = pending_mutation_access.is_cache_block_zero()
  def local_mutation_commit = pending_mutation_valid & (!pending_zero ||| (pending_zero_index =/= Bits(word_index_width)(words_per_line - 1)) ||| service_responses.ingress.ready)
  def local_mutation_complete = local_mutation_commit & (!pending_zero ||| (pending_zero_index === Bits(word_index_width)(words_per_line - 1)))
  local_atomic_alu.old_value <== pending_mutation_old_value
  local_atomic_alu.operand <== retained_request.data[0..width]
  local_atomic_alu.word <== retained_request.width === MemoryWidth.Word
  local_atomic_alu.operation <== retained_request.atomic
  local_store_gen.address <== retained_request.address
  local_store_gen.value <== mux(pending_mutation_access.is_atomic(), local_atomic_alu.value, retained_request.data[0..width])
  local_store_gen.width <== retained_request.width
  def local_store_word_data = mux(pending_zero, Bits(beat_width)(0), mux(is_raw_beat(retained_request), retained_request.data, local_store_gen.data)).as_vec(Bits(8))

  /* Refill mutation and byte merge.
     AMO/store/zero updates are applied to the selected refill word before
     publishing the complete line. */

  refill_load_gen.address <== retained_request.address
  refill_load_gen.data <== refilled_word
  refill_load_gen.width <== retained_request.width
  refill_load_gen.unsigned_load <== Bool(#false)
  refill_atomic_alu.old_value <== refill_load_gen.value
  refill_atomic_alu.operand <== retained_request.data[0..width]
  refill_atomic_alu.word <== retained_request.width === MemoryWidth.Word
  refill_atomic_alu.operation <== retained_request.atomic
  refill_store_gen.address <== retained_request.address
  refill_store_gen.value <== mux(refill_access.is_atomic(), refill_atomic_alu.value, retained_request.data[0..width])
  refill_store_gen.width <== retained_request.width
  def refill_store_word_data = mux(is_raw_beat(retained_request), retained_request.data, refill_store_gen.data).as_vec(Bits(8))
  def refill_store_byte_mask = retained_request.byte_mask.as_vec(Bool)
  def refill_install_bytes = backing_line[refill_install_index].as_vec(Bits(8))
  def mutate_refill_word = refill_mutation & (refill_install_index === refill_word_index)
  def merged_refill_word = vec(
    for List (byte_index in 0..beat_bytes):
      mux(refill_store_byte_mask[byte_index], refill_store_word_data[byte_index], refill_install_bytes[byte_index])
  )

  def refill_install_data = priority_mux(~default: refill_install_bytes):
    refill_access.is_cache_block_zero(): Bits(beat_width)(0).as_vec(Bits(8))
    mutate_refill_word: merged_refill_word

  def cache_write = refill_install_word ||| local_mutation_commit
  assert(refill.command.ready ||| writeback.command.ready, "l1d_backing_owner_exclusive")


  /* Snoop lookup and data handoff.
     Backing transactions retain their context without occupying the SRAMs.
     Accepted snoops can proceed around queued work, preventing a Home/RN-F
     wait cycle; dirty data gathers before the lookup result is returned. */

  stores.probe_address <== snoop.address[0..width]
  snoop.cache_ready <== !s3_read_valid & !s4_result.egress.valid & !pending_mutation_valid & gather_idle & !refill_installing & !stores.queued_line_hazard
  def snoop_address = snoop.address
  def snoop_set = snoop_address[offset_width..(offset_width + set_width)]
  // Compare the full CHI tag: an RV32 hart must miss snoops above its address space.
  def snoop_tag = snoop_address[(offset_width + set_width)..snoop_width]
  def snoop_valids = valid_lines[snoop_set]
  def snoop_matches = vec(for List (way in 0..ways): snoop_valids[way] & (arrays.tags.response.bits[way].zext(snoop_width - offset_width - set_width) === snoop_tag))
  def snoop_selection = priority_encoder_oh(snoop_matches)
  def snoop_line_hit = snoop_selection.valid
  def snoop_lookup_state = snoop_selection.mux(for List (way in 0..ways): arrays.states.response.bits[way], ~default: CHICacheState.Invalid).into(CHICacheState)
  def snoop_metadata_valid = snoop_metadata_pending & arrays.tags.response.valid & arrays.states.response.valid
  when (snoop_metadata_valid & snoop_line_hit):
    snoop_way <== snoop_selection.index

  for (left in 0..ways):
    for (right in (left + 1)..ways):
      when snoop_metadata_valid:
        assert(!(snoop_matches[left] & snoop_matches[right]), "l1d_snoop_hit_unique")

  def snoop_dirty_hit = snoop_line_hit & snoop_lookup_state.is_dirty()
  def snoop_gather_start = snoop_metadata_valid & snoop_dirty_hit
  def snoop_direct_result = snoop_metadata_valid & !snoop_dirty_hit
  def snoop_gather_result = gather_state === L1DGatherState.SnoopReady
  def snoop_result = CacheDataSnoopLookupResult():
    hit: mux(snoop_gather_result, Bool(#true), snoop_line_hit)
    state: mux(snoop_gather_result, gathered_snoop_state, snoop_lookup_state)

  inject_interface(Valid(CacheDataSnoopLookupResult()), ~valid: snoop_direct_result ||| snoop_gather_result, ~bits: snoop_result) |> snoop.lookup_result


  /* Lookup scheduling and retained advancement.
     S4 reserves the backing engines; blocked S3 work retains its request,
     then rereads instead of consuming stale array data. */

  def retained_array_work_idle = !maintenance_active & gather_idle & !refill_installing & !pending_mutation_valid
  def backing_engines_ready = refill.command.ready & writeback.command.ready
  def arrays_available = retained_array_work_idle & !s4_needs_refill & !local_mutation
  def s3_can_advance = s4_result.ingress.ready & arrays_available & backing_engines_ready & !snoop_pending
  // Gating retains blocked requests; only admitted reads enter the elastic S4
  // result register. A stalled request is reread when S4 has capacity.
  def s3_observed = s3_lookup.egress |> trace_event("dcache/s3.lookup", ~stalls: #true, ~fields: lookup):
    address: lookup.request.address
    prefetch: lookup.prefetch
    access(~format: "enum"): lookup.request.access

  (
    s3_observed
      |> gate_flow(s3_can_advance & s3_read_valid)
      |> map_flow(request => L1DResolved(xlen, way_width, Context, beat_bytes)):
        lookup: request
        hit: s3_hit_way.valid
        hit_way: s3_hit_way.index
        state: s3_state
        word: s3_word
        allocation_way: s3_allocation_way
        victim_valid: s3_valids[s3_allocation_way]
        victim_state: arrays.states.response.bits[s3_allocation_way]
        victim_address: concat(arrays.tags.response.bits[s3_allocation_way], s3_set, Bits(offset_width)(0)).zext(width)
  ) |> s4_result.ingress

  for (left in 0..ways):
    for (right in (left + 1)..ways):
      when (s3_lookup.egress.fire()):
        assert(!(s3_matches[left] & s3_matches[right]), "l1d_core_hit_unique")

  def s2_retry = s3_lookup.egress.valid & !s3_read_valid & s3_can_advance

  /* Shared read admission and store draining.
     Speculative reads cannot take an SRAM port from older work or establish
     transaction/reservation ownership. A same-line waiter behind the active
     miss owns no array port and need not block independent load hits. */

  def engines_idle = arrays_available & !miss_active & backing_engines_ready
  def parked_same_line_waiter = ordinary_requests.valid & miss_active & ordinary_requests.bits.access.is_one_of(CacheOperation.Load, CacheOperation.Store) & (ordinary_requests.bits.address.align_down(CacheLineBytes) === retained_line_address)
  def service_order_clear = (!service_requests.egress.valid ||| parked_same_line_waiter) & !s3_lookup.egress.valid & !s4_result.egress.valid & !virtual_lookup.valid
  hit_path_available <== engines_idle & service_order_clear
  hit_under_miss <== miss_active & miss_allows_hits & arrays_available & service_order_clear & !snoop_pending
  def store_drain_available = engines_idle & !s3_read_valid & !s4_result.egress.valid & !snoop_metadata_pending & !snoop_lookup_start & !snoop.update.valid
  def full_store_drain = stores.full & store_drain_available
  def force_store_drain = stores.urgent ||| service_requests.egress.valid ||| management_waiting ||| (snoop_pending & stores.queued_line_hazard) ||| (pipeline.request.valid & !s1_store & stores.queued_word_hazard)
  stores.full_drain <== full_store_drain
  stores.drain.ready <== full_store_drain ||| (store_drain_available & (force_store_drain ||| !s0_load))
  store_drain <== stores.drain.fire()
  def array_read_address = priority_mux(~default: s2_index_address):
    s0_read_issue: pipeline_lookup.bits.address
    s2_retry: s3_lookup.egress.bits.request.address

  def array_read_set = array_read_address[offset_width..(offset_width + set_width)]
  def array_read_data_address = array_read_address[row_offset_width..(offset_width + set_width)]
  def s2_admit = !management_waiting & s3_can_advance & !s2_retry & stores.empty & !s2_store_candidate.egress.valid
  core.request |> gate_flow(!core.request.valid ||| service_address_fits) |> service_requests.ingress
  def s2_demand = ordinary_requests |> map_flow(request => L1DLookup(xlen, Context, beat_bytes)):
    request: request
    prefetch: Bool(#false)
    prefetch_write: Bool(#false)

  // Drop a best-effort hint before the checked conversion unless it can win
  // and enter S3 now. Never retain it or let its ready path reach core admission.
  def s2_hint = (
    prefetch
      |> filter_valid(_hint => s2_prefetch & s2_admit & s3_lookup.ingress.ready & !ordinary_requests.valid)
      |> map_valid(payload):
        def hint = payload.into(CachePrefetchReq(width))
        def empty :: PhysicalMemoryBeatReq(xlen, Context, beat_bytes) = literal(PhysicalMemoryBeatReq(xlen, Context, beat_bytes), 0)
        def request = empty.updated(
          ~address: hint.address, ~access: CacheOperation.Load, ~atomic: RiscvAtomicOperation.Swap,
          ~width: MemoryWidth.Byte, ~unsigned: Bool(#true), ~byte_mask: Bits(beat_bytes)(1) << hint.address[0..row_offset_width],
          ~context: dont_care(Context), ~locality: RiscvMemoryLocality.Default
        )

        L1DLookup(xlen, Context, beat_bytes):
          request: request
          prefetch: Bool(#true)
          prefetch_write: hint.operation === CachePrefetchOperation.Write
  ) |> to_decoupled() |> trace_event("dcache/prefetch")

  Array(s2_demand, s2_hint) |> arbiter() |> gate_flow(s2_admit) |> s3_lookup.ingress
  def service_request_accept = core.request.fire()
  def s2_issue = s3_lookup.ingress.fire()
  def array_lookup_issue = s0_read_issue ||| s2_retry ||| (s2_admit & s3_lookup.ingress.ready & (s2_queued ||| virtual_lookup.valid ||| s2_prefetch))
  s3_read_valid <== s2_issue ||| s2_retry
  when (s3_lookup.egress.fire()):
    assert(arrays.tags.response.valid & arrays.states.response.valid & arrays.data.response.valid, "l1d_s3_array_response_valid")

  when service_request_accept:
    assert(virtual_lookup.valid, "l1d_physical_request_has_virtual_lookup")
    assert(virtual_lookup.bits[0..12] === core.request.bits.address[0..12], "l1d_vipt_page_offset_matches")

  when s2_issue:
    assert(array_lookup_issue, "l1d_resolution_has_array_read")


  /* Slow completions and drain accounting.
     Pairs each completion with its request context and retains the response
     under backpressure; same-cycle admission prevents a false drained result. */

  def s4_load_hit = s4_local.valid & s4_load & s4_hit & (!s4_lr ||| s4_state.is_unique())
  def s4_failed_sc = s4_local.valid & s4_sc & !s4_sc_authorized
  def produces_response = maintenance_complete ||| s4_load_hit ||| local_mutation_complete ||| s4_failed_sc ||| (complete_refill & !miss_prefetch)
  def response_request :: PhysicalMemoryBeatReq(xlen, Context, beat_bytes) = priority_mux(~default: s4_request):
    maintenance_complete: maintenance_done.bits.context
    complete_refill ||| local_mutation_commit: retained_request

  def response_access = response_request.access
  def response_address = response_request.address
  def response_width = response_request.width
  def response_old_value = mux(local_mutation_commit, pending_mutation_old_value, service_load_gen.value)
  def response_data = priority_mux(~default: Bits(width)(0)):
    response_access.returns_old_value(): response_old_value
    response_access.is_store_conditional() & s4_failed_sc: Bits(width)(1)

  def response = PhysicalMemoryBeatResp(xlen, Context, beat_bytes):
    access_fault: maintenance_complete & (maintenance_done.bits.error =/= CHIRespErr.OK)
    data: mux(is_raw_beat(response_request) & (response_access === CacheOperation.Load), service_row, scalar_response(response_data))
    context: response_request.context

  inject_interface(Valid(PhysicalMemoryBeatResp(xlen, Context, beat_bytes)), ~valid: produces_response, ~bits: response) |> to_decoupled() |> service_responses.ingress
  when produces_response:
    assert(service_responses.ingress.ready, "l1d_slow_response_capacity")

  // A fence observes accepted or queued requests, lookup work, active refills,
  // and the backing store buffer. Same-cycle acceptance is included so no
  // request can cross the reported quiescent boundary.
  def store_buffer_quiet = stores.empty & !stores.enqueue.fire()
  def service_pipeline_empty = !service_requests.egress.valid & !s3_lookup.egress.valid & !s4_result.egress.valid & !service_responses.egress.valid
  def backing_work_drained = retained_array_work_idle & !miss_active & backing_engines_ready
  core.drained <== store_buffer_quiet & !service_request_accept & service_pipeline_empty & backing_work_drained


  /* Shared SRAM port scheduling.
     Selects physical address, data, and lane masks for each port while
     preserving the existing priority among independent engine owners. */

  def retained_way_mask = cache_way_mask(cache, retained_way)
  def snoop_update_way_mask = cache_way_mask(cache, snoop_way)
  def full_byte_mask = !Mask(beat_bytes)(0)
  def refill_lane_mask = cache_lane_mask(cache, retained_way, beat_bytes, full_byte_mask)
  def local_mutation_lane_mask = cache_lane_mask(cache, retained_way, beat_bytes, mux(pending_zero, full_byte_mask, retained_request.byte_mask.into(Mask(beat_bytes))))
  def line_write_bytes = priority_mux(~default: refill_install_data):
    store_drain: stores.drain.bits.data.as_vec(Bits(8))
    local_mutation_commit: local_store_word_data

  def store_way_mask = cache_way_mask(cache, stores.drain.bits.way)
  def store_lane_mask = cache_lane_mask(cache, stores.drain.bits.way, beat_bytes, stores.drain.bits.mask.into(Mask(beat_bytes)))
  def repeated_line_write_bytes = for List (lane in 0..data_lanes): line_write_bytes[lane % beat_bytes]

  def tag_port_owner = priority_mux(~default: L1DArrayOwner.Pipeline):
    install_refill: L1DArrayOwner.Refill
    snoop_lookup_start: L1DArrayOwner.Snoop
    !s0_read_issue: L1DArrayOwner.Service

  def tag_port_request = ReadWriteRequest(set_width, Bits(tag_width), ways):
    address: (
      priority_mux(~default: array_read_set):
        install_refill: retained_set
        snoop_lookup_start: snoop_set
    )

    write: install_refill
    data: vec(for List (_way in 0..ways): refill_tag)
    mask: retained_way_mask

  def traced_tag_port = (
    inject_interface(Valid(ReadWriteRequest(set_width, Bits(tag_width), ways)), ~valid: array_lookup_issue ||| install_refill ||| snoop_lookup_start, ~bits: tag_port_request)
      |> trace_valid_event("dcache/arrays.tags", ~fields: request):
        index: request.address
        write: request.write
        owner(~format: "enum"): tag_port_owner
  )

  traced_tag_port |> arrays.tags.request

  /* Coherence-state writes.
     Selects store drain, refill mutation, local mutation, or snoop updates
     with the same owner priority as the corresponding address and way mask. */

  def update_snoop_state = snoop.update.valid & !snoop.update.bits.invalidate
  arrays.states.request.valid <== array_lookup_issue ||| install_refill ||| local_mutation_commit ||| snoop_lookup_start ||| update_snoop_state ||| store_state_write
  def refill_cache_state = mux(refill.completion.bits.state === CHIResponseState.Unique, CHICacheState.UniqueClean, CHICacheState.SharedClean)
  def state_write_data = priority_mux(~default: refill_cache_state):
    store_state_write: CHICacheState.UniqueDirty
    install_refill & refill_access.needs_unique(): CHICacheState.UniqueDirty
    local_mutation_commit: CHICacheState.UniqueDirty
    update_snoop_state: snoop.update.bits.state

  def state_write_mask = priority_mux(~default: snoop_update_way_mask):
    store_state_write: store_way_mask
    install_refill ||| local_mutation_commit: retained_way_mask

  arrays.states.request.bits <== ReadWriteRequest(set_width, CHICacheState, ways):
    address: (
      priority_mux(~default: array_read_set):
        store_state_write: stores.drain.bits.address[offset_width..(offset_width + set_width)]
        install_refill ||| local_mutation_commit: retained_set
        snoop_lookup_start: snoop_set
        update_snoop_state: snoop.update.bits.address[offset_width..(offset_width + set_width)]
    )

    write: install_refill ||| local_mutation_commit ||| update_snoop_state ||| store_state_write
    data: vec(for List (_way in 0..ways): state_write_data)
    mask: state_write_mask

  /* Byte-masked data port.
     Routes gather reads and store/refill/mutation writes; tracing observes
     the actual SRAM use rather than merely the logical request. */

  def local_mutation_address = mux(pending_zero, retained_set ++ pending_zero_index, retained_request.address[row_offset_width..(offset_width + set_width)])
  def refill_install_address = retained_set ++ refill_install_index
  def gather_address = gather_set ++ gather_issue_index
  def array_data_read = (s0_read_issue & s0_load) ||| s2_retry ||| (array_lookup_issue & !s0_read_issue)
  def data_port_owner = priority_mux(~default: L1DArrayOwner.Service):
    s0_read_issue: L1DArrayOwner.Pipeline
    gather_issue: L1DArrayOwner.Gather
    refill_install_word: L1DArrayOwner.Refill
    local_mutation_commit: L1DArrayOwner.Mutation
    store_drain: L1DArrayOwner.StoreDrain

  def data_port_request = ReadWriteRequest(data_address_width, Bits(8), data_lanes):
    address: (
      priority_mux(~default: array_read_data_address):
        store_drain: stores.drain.bits.address[row_offset_width..(offset_width + set_width)]
        local_mutation_commit: local_mutation_address
        cache_write: refill_install_address
        gather_issue: gather_address
    )

    write: cache_write ||| store_drain
    data: vec(repeated_line_write_bytes)
    mask: (
      priority_mux(~default: refill_lane_mask):
        store_drain: store_lane_mask
        local_mutation_commit: local_mutation_lane_mask
    )

  def traced_data_port = (
    inject_interface(Valid(ReadWriteRequest(data_address_width, Bits(8), data_lanes)), ~valid: array_data_read ||| cache_write ||| gather_issue ||| store_drain, ~bits: data_port_request)
      |> trace_valid_event("dcache/arrays.data", ~fields: request):
        index: request.address
        write: request.write
        owner(~format: "enum"): data_port_owner
  )

  traced_data_port |> arrays.data.request

  assert(!(store_drain & (array_data_read ||| cache_write ||| gather_issue)), "l1d_store_drain_data_port_exclusive")
  assert(!(store_state_write & (array_lookup_issue ||| install_refill ||| local_mutation_commit ||| snoop_lookup_start ||| update_snoop_state)), "l1d_store_drain_state_port_exclusive")

  assert(!(local_mutation_commit & (array_lookup_issue ||| install_refill ||| snoop_lookup_start ||| update_snoop_state ||| gather_issue)), "l1d_local_mutation_port_exclusive")


  /* Persistent mutation, miss, and gather updates.
     Event-oriented state transitions preserve same-edge priorities;
     independent engine lifetimes remain separate conditional chains. */

  snoop_metadata_pending <== snoop_lookup_start

  def miss_capture = s4_refill_path.fire() ||| eviction_gather_start
  assert(!(pending_mutation_valid & miss_active), "l1d_retained_owners_exclusive")
  when (local_mutation_capture ||| miss_capture):
    assert(!(local_mutation_capture & miss_capture), "l1d_one_retained_capture")
    assert(!pending_mutation_valid & !miss_active, "l1d_retained_capture_when_idle")
    retained_request <== s4_request
    retained_way <== mux(s4_hit, s4_result.egress.bits.hit_way, s4_result.egress.bits.allocation_way)

  when local_mutation_capture:
    pending_mutation_valid <== Bool(#true)
    pending_mutation_old_value <== service_load_gen.value
    pending_zero_index <== Bits(word_index_width)(0)
  elsewhen local_mutation_complete:
    pending_mutation_valid <== Bool(#false)
  elsewhen local_mutation_commit:
    pending_zero_index <== pending_zero_index + Bits(word_index_width)(1)

  when miss_capture:
    miss_active <== Bool(#true)
    miss_allows_hits <== !s4_prefetch & s4_access.is_one_of(CacheOperation.Load, CacheOperation.Store)
    miss_allocation <== !s4_hit & !s4_bypass_refill
    miss_install <== !s4_bypass_refill
    miss_prefetch <== s4_prefetch
  elsewhen complete_refill:
    miss_active <== Bool(#false)
    miss_allows_hits <== Bool(#false)

  when refill_install_start:
    refill_installing <== Bool(#true)
    refill_install_index <== Bits(word_index_width)(0)
  elsewhen install_refill:
    refill_installing <== Bool(#false)
    refill_install_index <== Bits(word_index_width)(0)
  elsewhen (refill_install_word & !refill_install_final):
    refill_install_index <== refill_install_index + Bits(word_index_width)(1)

  /* Word-at-a-time gathering.
     Eviction and dirty snoops share the reader, but retain separate owners;
     issued reads and returning words can progress on the same edge. */

  // Every word is written before publication. The two owners retain separate
  // snapshots so gathering for one never disturbs the other's stalled DAT.
  def gathered_response_words = arrays.data.response.bits.as_bits().as_vec(Bits(beat_width))
  def word = CacheLineChunk(beat_bytes):
    index: gather_response_index
    data: gathered_response_words[gather_way]

  def returning_word = inject_interface(Valid(CacheLineChunk(beat_bytes)), ~valid: gather_response_pending, ~bits: word)
  def Array(eviction_words, snoop_words) = returning_word |> fork_valid(2)
  def victim_row = eviction_words |> filter_valid(_word => gather_state === L1DGatherState.EvictionRead)
  snoop_words |> filter_valid(_word => gather_state === L1DGatherState.SnoopRead) |> snoop.gather


  /* Backing line writes. Victim rows precede the copyback command; refill packets
     replace them by DataID only after copyback completes. Snoops never write this bank. */

  def acquiring_victim = eviction_gather_start ||| gather_state.is_one_of(L1DGatherState.EvictionRead, L1DGatherState.EvictionReady)
  when acquiring_victim:
    assert(refill.command.ready & !refill.command.valid & writeback.command.ready, "l1d_victim_gather_owns_backing_line")

  def packet = refill.packet_write
  when (packet.valid):
    assert(miss_active & writeback.command.ready & !acquiring_victim & !refill_installing, "l1d_refill_owns_backing_line")

  def rows_per_packet = p.data_bytes / beat_bytes
  def PacketIndex = Bits(index_width(cache_line_rows(p.data_bytes)))
  def packet_rows = packet.bits.data.as_vec(Bits(beat_width))
  for (row in 0..words_per_line):
    when (victim_row.valid & (victim_row.bits.index === Bits(word_index_width)(row))):
      backing_line[row] <== victim_row.bits.data
    elsewhen (packet.valid & (packet.bits.index === PacketIndex(row div rows_per_packet))):
      backing_line[row] <== packet_rows[row % rows_per_packet]


  /* Gather progress. Hand the complete line to its owner on the existing Ready boundary. */

  // Both captures initialize the same reader. Eviction wins a simultaneous
  // start; the inactive owner's payload remains unchanged.
  when (eviction_gather_start ||| snoop_gather_start):
    gather_state <== mux(eviction_gather_start, L1DGatherState.EvictionRead, L1DGatherState.SnoopRead)
    gather_issue_index <== Bits(word_index_width)(0)
    gather_response_pending <== Bool(#false)
    gather_last_issued <== Bool(#false)
    gather_set <== mux(eviction_gather_start, eviction_start.bits.lookup.into(L1DLookup(xlen, Context, beat_bytes)).request.address[offset_width..(offset_width + set_width)], snoop_set)
    gather_way <== mux(eviction_gather_start, eviction_start.bits.allocation_way, snoop_selection.index)
    when eviction_gather_start:
      eviction_line_address <== eviction_start.bits.victim_address

    when (!eviction_gather_start):
      gathered_snoop_state <== snoop_lookup_state
  elsewhen gather_read:
    gather_response_pending <== gather_issue
    when gather_issue:
      gather_response_index <== gather_issue_index
      gather_issue_index <== mux(gather_issue_final, gather_issue_index, gather_issue_index + Bits(word_index_width)(1))
      gather_last_issued <== gather_issue_final

    when gather_response_pending:
      assert(arrays.data.response.valid, "l1d_gather_read_response_valid")
      when gather_response_final:
        gather_state <== mux(gather_state === L1DGatherState.EvictionRead, L1DGatherState.EvictionReady, L1DGatherState.SnoopReady)
  elsewhen writeback_command_fire:
    gather_state <== L1DGatherState.Idle
  elsewhen snoop_gather_result:
    gather_state <== L1DGatherState.Idle


  /* LR/SC reservation and bounded probe protection.
     Reservation lifetime follows accesses/coherence. The fairness timer
     bounds probe deferral separately and cannot be renewed by repeated LR. */

  def reservation_line_address = reservation_address.align_down(CacheLineBytes)
  def s4_line_address = s4_request.address.align_down(CacheLineBytes)
  def completing_lr = (s4_load_hit & (s4_access === CacheOperation.LoadReserved)) ||| (install_refill & (refill_access === CacheOperation.LoadReserved))
  def s4_reservation_clear = s4_path.fire() & !local_mutation_capture & (s4_sc ||| ((s4_store ||| s4_zero ||| s4_atomic) & (s4_line_address === reservation_line_address)))
  def mutation_touches_reservation = (pending_mutation_access.is_store() ||| pending_zero ||| pending_mutation_access.is_atomic()) & (retained_line_address === reservation_line_address)
  def mutation_reservation_clear = local_mutation_commit & (pending_mutation_access.is_store_conditional() ||| mutation_touches_reservation)
  def snoop_reservation_clear = snoop.update.valid & (snoop.update.bits.address.align_down(CacheLineBytes) === reservation_line_address.zext(snoop_width))
  def replacement_reservation_clear = s4_path.fire() & s4_needs_refill & !s4_bypass_refill & !s4_hit & s4_victim_valid & (s4_victim_address === reservation_line_address)
  def buffered_store_reservation_clear = stores.enqueue.fire() & (stores.enqueue.bits.address.align_down(CacheLineBytes) === reservation_line_address)
  def reservation_clear = s4_reservation_clear ||| mutation_reservation_clear ||| snoop_reservation_clear ||| replacement_reservation_clear ||| buffered_store_reservation_clear
  // Reservation lifetime follows accesses and coherence, not the fairness timer.
  // A slow SC may still succeed after probes have been allowed to proceed.
  when completing_lr:
    reservation_valid <== Bool(#true)
    reservation_address <== response_address
    reservation_width <== response_width
  elsewhen reservation_clear:
    reservation_valid <== Bool(#false)

  // A repeated LR may replace the reservation, but cannot renew protection.
  when (completing_lr & !reservation_count.any()):
    reservation_count <== Bits(reservation_count_width)(reservation_cycles + reservation_backoff)
  elsewhen ((reservation_valid & reservation_clear) ||| (completing_lr & reservation_protected)):
    reservation_count <== Bits(reservation_count_width)(reservation_backoff)
  elsewhen (reservation_count.any()):
    reservation_count <== reservation_count - Bits(reservation_count_width)(1)

  // A completed probe also gives a waiting local lookup a bounded turn.
  // Otherwise an endless stream of unrelated probes could prevent even the
  // first LR from reaching S4. Active CHI engines remain independently live.
  def waiting_lookup = service_requests.egress.valid ||| s3_lookup.egress.valid ||| virtual_lookup.valid
  when (install_refill ||| (snoop.completed & waiting_lookup)):
    core_service_count <== Bits(4)(8)
  elsewhen (core_service_count.any()):
    core_service_count <== core_service_count - Bits(4)(1)


  /* Line validity and replacement metadata.
     Snoop retirement and copyback completion may invalidate different ways
     together; a victim stays visible until its entire data handoff finishes. */

  def snoop_invalidates = snoop.update.valid & snoop.update.bits.invalidate
  def snoop_update_set = snoop.update.bits.address[offset_width..(offset_width + set_width)]
  def snooped_set_valids = valid_lines[snoop_update_set].updated(snoop_way, Bool(#false))
  def snooped_valid_lines = mux(snoop_invalidates, valid_lines.updated(snoop_update_set, snooped_set_valids), valid_lines)
  def eviction_set = eviction_line_address[offset_width..(offset_width + set_width)]
  when writeback_complete:
    valid_lines <== snooped_valid_lines.updated(eviction_set, snooped_valid_lines[eviction_set].updated(retained_way, Bool(#false)))
  elsewhen snoop_invalidates:
    valid_lines <== snooped_valid_lines
  elsewhen install_refill:
    valid_lines <== valid_lines.updated(retained_set, valid_lines[retained_set].updated(retained_way, Bool(#true)))

  def pipeline_replacement_touch = pipeline.request.valid & s1_outcome.is_one_of(CachePipelineOutcome.LoadHit, CachePipelineOutcome.StoreHit)
  def transaction_replacement_touch = s4_path.fire() & s4_hit
  def replacement_touch = pipeline_replacement_touch ||| transaction_replacement_touch
  def replacement_touch_set = mux(pipeline_replacement_touch, s1_set, s4_set)
  def replacement_touch_way = mux(pipeline_replacement_touch, s1_hit_way.index, s4_result.egress.bits.hit_way)
  assert(!(replacement_touch & install_refill), "l1d_replacement_update_unique")
  when replacement_touch:
    replacement_state <== replacement_state.updated(replacement_touch_set, plru_touch(ways, replacement_state[replacement_touch_set], replacement_touch_way))
  elsewhen (install_refill & miss_allocation):
    replacement_state <== replacement_state.updated(retained_set, plru_touch(ways, replacement_state[retained_set], retained_way))


  /* CHI transport and probe admission.
     Arbiter input order defines fixed priority. New probes may be deferred,
     but accepted snoops and transaction response owners remain live. */

  Array(refill.requests, writeback.requests, maintenance.requests) |> arbiter() |> chi.requests
  Array(refill.acknowledgements, snoop.responses) |> arbiter() |> chi.requester_responses
  Array(writeback.data, snoop.data) |> arbiter() |> chi.request_data
  chi.response_data |> refill.response_data
  // Stop new probes, not an already accepted snoop. In particular protect the
  // acknowledged grant until SRAM installation; Home may probe after CompAck.
  def protect_refill = refill.acknowledgements.valid ||| refill.completion.valid
  def protect_core = reservation_protected ||| core_service_count.any()
  def protect_copyback = writeback.granted & (cache_chi_snoop_address(p, snoop_width, chi.snoops.bits.address).align_down(CacheLineBytes) === eviction_line_address.zext(snoop_width))
  chi.snoops |> gate_flow(!(protect_refill ||| protect_core ||| protect_copyback)) |> snoop.snoops
  def writeback_active = !writeback.command.ready
  def Array(refill_response, writeback_response, maintenance_response) = (
    chi.responses |> demux_flow(3, _response => mux(maintenance_active, Bits(2)(2), writeback_active.as_bits().zext(2)))
  )
  refill_response |> refill.responses
  writeback_response |> writeback.responses
  maintenance_response |> maintenance.responses

export:
  L1DCache
