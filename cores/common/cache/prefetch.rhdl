#lang rhodium
/* Classifies complete physical prefetch lines and stages admitted hints without changing caller policy. */
// SPDX-License-Identifier: Apache-2.0

import:
  "config.rhm".CacheLineBytes
  "../cache-prefetch.rhdl" open
  lib("flow/main.rhdl") open
  lib("riscv/rtl/pma.rhdl") open
  lib("riscv/rtl/svpbmt.rhdl") open
  lib("rhodium/std/bits.rhdl") open

/* Separates physical permission/cacheability from the stronger ordinary-memory restriction. */
bundle CachePrefetchPhysical(address_width :: PosInt):
  address: Bits(address_width)
  permitted: Bool
  cacheable: Bool
  ordinary_memory: Bool
  ordinary_data_memory: Bool

  /* A nonfaulting translation probe may prefetch a permitted line only from ordinary,
     read-idempotent memory, including when a write hint requests exclusive ownership. */
  method allows_translated_hint(physical, ~hit: hit :: Bool, ~fault: fault :: Bool) :: Bool:
    hit & !fault & physical.ordinary_memory & physical.permitted

/* Aligns the line, retains end-address overflow, and resolves PBMT without granting PMA permissions. */
fun cache_prefetch_physical(address_width :: PosInt, physical_map :: RiscvPhysicalMemoryMap,
                            address :: Bits(address_width), operation :: CachePrefetchOperation,
                            pbmt :: PageMemoryType) :~ CachePrefetchPhysical(address_width):
  def first = address.align_down(CacheLineBytes)
  def region = physical_map.lookup(first, first +& Bits(address_width)(CacheLineBytes - 1))
  def attributes = resolve_memory_attributes(region, pbmt)
  def permitted = mux_lookup(operation):
    CachePrefetchOperation.None: Bool(#false)
    CachePrefetchOperation.Instruction: region.executable
    CachePrefetchOperation.Read: region.readable
    CachePrefetchOperation.Write: region.writable

  def cacheable = mux(operation === CachePrefetchOperation.Instruction, attributes.instruction_cacheable, attributes.cacheable)
  def ordinary = region.mapped & !attributes.strongly_ordered & attributes.read_idempotent
  CachePrefetchPhysical(address_width):
    address: first
    permitted: permitted
    cacheable: cacheable
    ordinary_memory: ordinary & cacheable
    ordinary_data_memory: ordinary & attributes.cacheable

/* Routes instruction hints to L1I and read/write hints to L1D in the same cycle. */
fun dispatch_physical_prefetch(address_width :: PosInt, source :: Endpoint.of(Valid(CachePrefetchReq(address_width))),
                               instruction :: Endpoint, data :: Endpoint):
  def request :: CachePrefetchReq(address_width) = source.bits
  def Array(instruction_hint, data_hint) = source |> fork_valid(2)
  instruction_hint |> filter_valid(_ => request.operation === CachePrefetchOperation.Instruction) |> instruction
  data_hint |> filter_valid(_ => request.operation.is_one_of(CachePrefetchOperation.Read, CachePrefetchOperation.Write)) |> data

/* Carries only a physical line number and its original instruction/read/write intent. */
bundle PhysicalPrefetchLine(number_width :: PosInt):
  number: Bits(number_width)
  operation: CachePrefetchOperation

/* Registers an already admitted physical hint. Flush clears validity at the edge;
   each caller retains its own permission checks and outgoing cancellation policy. */
sync_circuit PhysicalPrefetchPipe(address_width :: PosInt, cacheable_width :: Nat):
  interface ingress(Valid(CachePrefetchReq(address_width)), ~role: consumer)
  interface egress(Valid(CachePrefetchReq(address_width)), ~role: producer)
  input flush: Bool

  def offset = alignment_bits(CacheLineBytes)
  def end_bit = math.min(address_width, cacheable_width)
  def number_width = math.max(1, end_bit - offset)
  inst line(ValidPipeAlwaysCapture(PhysicalPrefetchLine(number_width), 1, ~flushable: #true))
  line.flush <== flush

  when (ingress.valid):
    assert(ingress.bits.address.is_aligned(CacheLineBytes), "physical_prefetch_line_aligned")
    if end_bit < address_width
    | assert(!ingress.bits.address[end_bit..address_width].any(), "physical_prefetch_fits_map")
    | #void

  def request :: CachePrefetchReq(address_width) = ingress.bits
  (ingress |> map_valid(_ => PhysicalPrefetchLine(number_width)):
    number: if end_bit > offset | request.address[offset..end_bit] | Bits(1)(0)
    operation: request.operation
  ) |> line.ingress

  def stored :: PhysicalPrefetchLine(number_width) = line.egress.bits
  (line.egress |> map_valid(_ => CachePrefetchReq(address_width)):
    address: if end_bit > offset | (stored.number ++ Bits(offset)(0)).zext(address_width) | Bits(address_width)(0)
    operation: stored.operation
  ) |> egress

export:
  PhysicalPrefetchPipe
  CachePrefetchPhysical
  cache_prefetch_physical
  dispatch_physical_prefetch
