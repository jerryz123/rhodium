#lang rhodium
/* Retains one non-cacheable data operation from admission through RN-I completion. */
// SPDX-License-Identifier: Apache-2.0

import:
  "protocol.rhdl" open
  "operation.rhdl".CacheOperation
  "../load-store.rhdl" open
  "../../../riscv/isa/xlen.rhm".XLen
  lib("flow/main.rhdl") open

/* Separates an empty data slot, a retained request awaiting RN-I issue, and accepted engine
   work. */
hardware_enum IOMSHRState:
  Idle
  Queued
  Active

/* Admits one supported committed request independently of downstream availability.
   Returns the original context on final completion; the transport only supplies data and status.
   Unsupported operations never allocate. */
sync_circuit IOMSHR(xlen :: XLen, Context :: DataType):
  interface core(UncachedMemoryAccess(xlen, Context), ~role: responder)
  interface memory(UncachedTransportAccess(xlen, Bool), ~role: requester)

  reg state(~init: IOMSHRState.Idle)
  reg command(UncachedCommand(xlen, Bool))
  reg context(Context)
  reg store_payload(UncachedStorePayload())
  def idle = state === IOMSHRState.Idle
  def queued = state === IOMSHRState.Queued
  def active = state === IOMSHRState.Active
  def request :: PhysicalMemoryReq(xlen, Context) = core.request.bits.request
  def operation = request.access
  def supported = operation.is_one_of(CacheOperation.Load, CacheOperation.Store, CacheOperation.CacheBlockZero)

  // Admission depends on this data slot, not the shared engine's fetch owner.
  // Unsupported requests fault before admission and cannot acquire the slot.
  core.request.ready <== idle
  core.request_fault <== Bool(#false)
  core.request_access_fault <== core.request.valid & !supported
  def accept = core.request.fire() & supported
  core.drained <== idle & !accept


  /* The slot owns the caller's context until the response transfers. The RN-I
     still owns transaction routing and can drain an unrelated detached fetch. */

  memory.request.valid <== queued
  memory.request.bits <== command
  memory.store_payload <== store_payload

  (memory.response |> map_flow(reply => PhysicalMemoryResp(xlen, Context)):
    data: reply.data
    access_fault: reply.access_fault
    context: context
  ) |> core.response

  /* Form the write lane once at admission. RV32 masks already include the
     byte offset within a word; address bit two selects the word in the lane. */

  inst store_gen(StoreGen(xlen))
  store_gen.address <== request.address
  store_gen.value <== request.data
  store_gen.width <== request.width
  def zero = operation.is_cache_block_zero()
  def lane_mask = place_word_byte_mask(request.address, request.byte_mask, 8)

  when accept:
    command <== UncachedCommand(xlen, Bool):
      address: request.address
      access: operation
      width: request.width
      unsigned: request.unsigned
      device: core.request.bits.device
      locality: request.locality
      context: Bool(#false)

    context <== request.context
    store_payload <== UncachedStorePayload():
      data: mux(zero, Bits(64)(0), store_gen.data)
      byte_mask: mux(zero, !Bits(8)(0), lane_mask).into(Mask(8))

    state <== IOMSHRState.Queued
  elsewhen (memory.request.fire()):
    state <== IOMSHRState.Active
  elsewhen (memory.response.fire()):
    state <== IOMSHRState.Idle

  // An accepted operation is irrevocable. The engine cannot report a late
  // admission fault, and only its final data completion releases the slot.
  when queued:
    assert(!memory.request_fault & !memory.request_access_fault, "io_mshr_no_late_fault")

  when (memory.response.valid):
    assert(active, "io_mshr_completion_expected")

export:
  IOMSHR
