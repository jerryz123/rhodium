#lang rhodium
/* Orders cached, uncached, and local-management service without owning admission policy. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("flow/main.rhdl") open
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/rtl/pma.rhdl").RiscvPhysicalMemoryMap
  "access.rhdl".CacheServiceRoute
  "io-mshr.rhdl".IOMSHR
  "protocol.rhdl".UncachedMemoryReq

/* Excludes younger cached work while committed IO or local maintenance owns completion.
   Callers classify requests, adapt byte lanes, and retain the IO owner. This boundary
   adds only the existing one-entry local completion queue; ordinary paths are wires. */
sync_circuit OrderedMemoryService(CachedRequest :: DataType, UncachedRequest :: DataType, Response :: DataType):
  interface cached(Decoupled(CachedRequest), ~role: consumer)
  interface uncached(Decoupled(UncachedRequest), ~role: consumer)
  interface management(Decoupled(Response), ~role: consumer)
  interface cache_request(Decoupled(CachedRequest), ~role: producer)
  interface io_request(Decoupled(UncachedRequest), ~role: producer)
  interface cache_response(Decoupled(Response), ~role: consumer)
  interface io_response(Decoupled(Response), ~role: consumer)
  interface response(Decoupled(Response), ~role: producer)
  input(cache_drained, io_drained, io_available): Bool
  output(ordered_busy, background_ready, hints_ready, drained): Bool

  inst local(Queue(Response, 1))
  def cache_available = io_available & !local.egress.valid
  ordered_busy <== !cache_available
  hints_ready <== io_drained & !local.egress.valid
  background_ready <== cache_drained & io_drained & !local.egress.valid
  cached |> gate_flow(cache_available) |> cache_request
  uncached |> gate_flow(cache_drained & !local.egress.valid) |> io_request
  management |> gate_flow(cache_drained & cache_available) |> local.ingress
  Array(local.egress, cache_response, io_response) |> arbiter() |> response
  drained <== cache_drained & io_drained & !local.egress.valid & !management.fire()

/* Unwraps an admitted physical request and selects the cached, uncached, or local management sink.
   The caller controls how its input acknowledges an admission fault. */
fun route_committed_request(admitted :: Endpoint.supports(DecoupledCtrl()), route :: CacheServiceRoute):
  admitted |> map_flow(request => request.memory) |> demux_flow(3, _request => route.as_bits())

/* Classified request sinks, ordering status, and precise IO admission faults for the core. */
class OrderedMemoryAttachment(cached :: Endpoint, uncached :: Endpoint, management :: Endpoint,
                              ordered_busy :: Bool, hints_ready :: Bool, background_ready :: Bool, drained :: Bool,
                              io_request_fault :: Bool, io_request_access_fault :: Bool)

/* Connects the cache port and retained IO slot to a single ordered service. The
   two optional Flow transforms adapt native replies before arbitration. Registered
   slot capacity gates new cached work independently of same-cycle IO admission. */
fun attach_ordered_memory(cache :: Endpoint, transport :: Endpoint, response :: Endpoint.supports(DecoupledCtrl()),
                          io_xlen :: XLen, IOContext :: DataType, ~physical_map: physical_map :: RiscvPhysicalMemoryMap,
                          ~cache_reply: cache_reply :: Function = values, ~io_reply: io_reply :: Function = values) :~ OrderedMemoryAttachment:
  def cache_request :: Endpoint.supports(DecoupledCtrl()) = cache.field("request")
  inst ordering(OrderedMemoryService(decoupled_payload_type(cache_request), UncachedMemoryReq(io_xlen, IOContext), decoupled_payload_type(response)))
  // PBMT can send cacheable RAM through RN-I as well as statically uncached regions.
  def admitted_width = physical_map.address_width_for(fun (_attributes): #true)
  inst io_mshr(IOMSHR(io_xlen, IOContext, ~admitted_address_width: admitted_width))
  io_mshr.memory |> transport
  ordering.cache_drained <== cache.field("drained")
  ordering.io_drained <== io_mshr.core.drained
  ordering.io_available <== io_mshr.core.request.ready
  ordering.cache_request |> cache_request
  ordering.io_request |> io_mshr.core.request
  def cache_response :: Endpoint.supports(DecoupledCtrl()) = cache.field("response")
  cache_reply(cache_response) |> ordering.cache_response
  io_reply(io_mshr.core.response) |> ordering.io_response
  ordering.response |> response
  assert(!(cache_response.valid & io_mshr.core.response.valid), "ordered_memory_response_paths_exclusive")
  OrderedMemoryAttachment(ordering.cached, ordering.uncached, ordering.management,
                          ordering.ordered_busy, ordering.hints_ready, ordering.background_ready, ordering.drained,
                          io_mshr.core.request_fault, io_mshr.core.request_access_fault)

export:
  OrderedMemoryService
  route_committed_request
  attach_ordered_memory
