#lang rhodium
/* Defines shared physical memory payloads and cache/uncached service contracts. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../memory-lookup.rhdl".MemoryLookupPort
  rhombus/meta open
  lib("rhodium/std/bits.rhdl").Pow2Int
  lib("riscv/rtl/svpbmt.rhdl").PageMemoryType
  "operation.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/rtl/atomic.rhdl" open
  "../../../riscv/rtl/zihintntl.rhdl" open
  "../load-store.rhdl" open
  lib("rhodium/std/ready-valid.rhdl") open

/* Distinguishes speculative hit, replay, slow-service, and translation/permission fault
   outcomes. */
hardware_enum CachePipelineOutcome:
  Slow
  LoadHit
  StoreHit
  Replay
  PageFault
  AccessFault

/* Records why a speculative access could not complete on its hit path. */
hardware_enum CachePipelineReason:
  None
  ArrayPort
  StoreDependency
  StoreCapacity
  Probe
  Miss
  Translation
  Ordered

/* Supply the final width (in bits or bytes) consistently in descriptor,
   record-constructor, and annotation syntax for a native specialization. */
defn.macro 'native_width $(name :: Identifier)($(xlen :: Identifier), $(arg :: Identifier), ...) = $(family :: Identifier) / $bits_per_unit':
  '«
     expr.macro
     | '$name($('$')$xlen, $('$')$arg, ...): $('$')field; $('...')':
         '$family($('$')$xlen, $('$')$arg, ..., ($('$')$xlen).width / $bits_per_unit): $('$')field; $('...')'
     | '$name($('$')$xlen, $('$')$arg, ...)':
         '$family($('$')$xlen, $('$')$arg, ..., ($('$')$xlen).width / $bits_per_unit)'
     | '$name': '$family'
     annot.macro '$name($('$')$xlen, $('$')$arg, ...)':
       '$family($('$')$xlen, $('$')$arg, ..., ($('$')$xlen).width / $bits_per_unit)'
   »'

/* Carries the translated speculative access controls without permission to mutate or allocate. */
bundle CachePipelineBeatReq(xlen :: XLen, beat_bytes :: Pow2Int = xlen.width / 8):
  if beat_bytes > xlen.width / 8:
    raw_beat: Bool
  byte_mask: Bits(beat_bytes)
  address: Bits(xlen.width)
  access: CacheOperation
  width: MemoryWidth
  unsigned: Bool
  data: Bits(8 * beat_bytes)

/* Returns the physical-resolution decision, diagnostic reason, and selected load data. */
bundle CachePipelineBeatResult(xlen :: XLen, beat_bytes :: Pow2Int = xlen.width / 8):
  outcome: CachePipelineOutcome
  reason: CachePipelineReason
  data: Bits(8 * beat_bytes)

/* Carries an authorized transaction and opaque caller context. External ports use
   XLEN addresses; checked internal storage can specialize just the address width. */
bundle AddressedPhysicalMemoryBeatReq(xlen :: XLen, Context :: DataType, beat_bytes :: Pow2Int = xlen.width / 8,
                                      address_width :: PosInt = xlen.width):
  if beat_bytes > xlen.width / 8:
    raw_beat: Bool
  byte_mask: Bits(beat_bytes)
  address: Bits(address_width)
  access: CacheOperation
  atomic: RiscvAtomicOperation
  width: MemoryWidth
  unsigned: Bool
  data: Bits(8 * beat_bytes)
  context: Context
  locality: RiscvMemoryLocality

  /* Rebinds address width and return context while preserving the access and byte lanes. */
  method with_address_context(request, address :: Bits, context :: Hardware.packable) :: AddressedPhysicalMemoryBeatReq(xlen, context.type, beat_bytes, address.type.packed_width()):
    def To = AddressedPhysicalMemoryBeatReq(xlen, context.type, beat_bytes, address.type.packed_width())
    def empty :: AddressedPhysicalMemoryBeatReq(xlen, context.type, beat_bytes, address.type.packed_width()) = literal(To, 0)
    def result = empty.updated(
      ~address: address, ~byte_mask: request.byte_mask, ~context: context,
      ~access: request.access, ~atomic: request.atomic, ~width: request.width,
      ~unsigned: request.unsigned, ~data: request.data, ~locality: request.locality
    )
    if beat_bytes > xlen.width / 8 | result.updated(~raw_beat: request.raw_beat) | result

/* Returns completion status and load data with the caller's context unchanged. */
bundle PhysicalMemoryBeatResp(xlen :: XLen, Context :: DataType, beat_bytes :: Pow2Int = xlen.width / 8):
  // Management retains retirement context for delayed faults. Other current
  // engines report rejection before acceptance and return successful responses.
  access_fault: Bool
  data: Bits(8 * beat_bytes)
  context: Context

native_width CachePipelineReq(xlen) = CachePipelineBeatReq / 8
native_width CachePipelineResult(xlen) = CachePipelineBeatResult / 8

native_width PhysicalMemoryBeatReq(xlen, Context, beat_bytes) = AddressedPhysicalMemoryBeatReq / 1
native_width PhysicalMemoryReq(xlen, Context) = PhysicalMemoryBeatReq / 8
native_width PhysicalMemoryResp(xlen, Context) = PhysicalMemoryBeatResp / 8

/* Carries one translated native-word transaction and its effective page memory type to the physical router.
   PA width is independent of XLEN. The opaque context follows the request through completion. */
bundle PhysicalDataReq(xlen :: XLen, Context :: DataType, address_width :: PosInt):
  memory: AddressedPhysicalMemoryBeatReq(xlen, Context, memory_word_bytes(xlen), address_width)
  pbmt: PageMemoryType

  /* Replaces the return context when arbitration adds a client tag, preserving the original access. */
  method with_context(request, To :: DataType, context :: Hardware.of(To)) :: PhysicalDataReq(xlen, To, address_width):
    def access :: AddressedPhysicalMemoryBeatReq(xlen, Context, memory_word_bytes(xlen), address_width) = request.memory
    PhysicalDataReq(xlen, To, address_width):
      pbmt: request.pbmt
      memory: access.with_address_context(access.address, context)

/* Builds an eight-byte page-table read with the walker's resolved PA, PBMT, and return tag. */
fun pte_read_request(xlen :: XLen, address :: Bits, pbmt :: PageMemoryType, context :: Hardware.packable) :~ PhysicalDataReq(xlen, context.type, address.type.packed_width()):
  PhysicalDataReq(xlen, context.type, address.type.packed_width()):
    pbmt: pbmt
    memory:
      AddressedPhysicalMemoryBeatReq(xlen, context.type, memory_word_bytes(xlen), address.type.packed_width()):
        address: address
        byte_mask: !Bits(memory_word_bytes(xlen))(0)
        access: CacheOperation.Load
        atomic: RiscvAtomicOperation.Swap
        width: MemoryWidth.Double
        unsigned: Bool(#true)
        data: Bits(xlen.width)(0)
        context: context
        locality: RiscvMemoryLocality.Default

/* Exposes authorized request admission, preacceptance faults, tagged completion, drain, and
   reservation. */
interface CacheBeatAccess(xlen :: XLen, Context :: DataType, beat_bytes :: Pow2Int):
  role requester
  role responder
  provider requester

  requester -> responder:
    request: Decoupled(PhysicalMemoryBeatReq(xlen, Context, beat_bytes))

  responder -> requester:
    request_fault: Bool
    request_access_fault: Bool
    response: Decoupled(PhysicalMemoryBeatResp(xlen, Context, beat_bytes))
    drained: Bool
    reservation_valid: Bool

/* Preserves the named interface surface while defaulting speculative accesses to native words. */
expr.macro
| 'CachePipelineAccess($xlen, $beat_bytes)':
    'MemoryLookupPort(CachePipelineBeatReq($xlen, $beat_bytes), CachePipelineBeatResult($xlen, $beat_bytes))'
| 'CachePipelineAccess($xlen)':
    'CachePipelineAccess($xlen, ($xlen).width / 8)'
| 'CachePipelineAccess': 'fun (xlen :: XLen, beat_bytes :: Pow2Int): CachePipelineAccess(xlen, beat_bytes)'

/* Preserves hierarchical authorized-port fields for native-word and explicit beat widths. */
expr.macro
| 'CacheAccess($xlen, $Context, $beat_bytes)':
    'CacheBeatAccess($xlen, $Context, $beat_bytes)'
| 'CacheAccess($xlen, $Context)':
    'CacheBeatAccess($xlen, $Context, ($xlen).width / 8)'
| 'CacheAccess': 'CacheBeatAccess'

export:
  CachePipelineBeatReq
  CachePipelineReq
  CachePipelineBeatResult
  CachePipelineResult
  CachePipelineAccess
  CachePipelineOutcome
  CachePipelineReason
  PhysicalMemoryBeatReq
  AddressedPhysicalMemoryBeatReq
  PhysicalDataReq
  pte_read_request
  PhysicalMemoryReq
  PhysicalMemoryBeatResp
  PhysicalMemoryResp
  CacheAccess

/* Pairs a physical transaction with its resolved strongly ordered attribute. */
bundle UncachedMemoryReq(xlen :: XLen, Context :: DataType):
  request: PhysicalMemoryReq(xlen, Context)
  device: Bool

/* Exposes nonallocating admission, opaque-context completion, and transaction drain. */
interface UncachedMemoryAccess(xlen :: XLen, Context :: DataType):
  role requester
  role responder
  provider requester
  requester -> responder:
    request: Decoupled(UncachedMemoryReq(xlen, Context))

  responder -> requester:
    request_fault: Bool
    request_access_fault: Bool
    response: Decoupled(PhysicalMemoryResp(xlen, Context))
    drained: Bool

export:
  UncachedMemoryReq
  UncachedMemoryAccess

/* Arbitrates the command, independently of the committed store's data lifetime. */
bundle UncachedCommand(xlen :: XLen, Context :: DataType):
  address: Bits(xlen.width)
  access: CacheOperation
  width: MemoryWidth
  unsigned: Bool
  device: Bool
  locality: RiscvMemoryLocality
  context: Context

/* Data and byte enables positioned within the addressed eight-byte transfer lane. */
bundle UncachedStorePayload():
  data: Bits(64)
  byte_mask: Mask(8)

/* The data owner holds store_payload from command transfer through final response.
   Block zero supplies all-zero data and all enables for each of its eight writes. */
interface UncachedTransportAccess(xlen :: XLen, Context :: DataType):
  role requester
  role responder
  provider requester
  requester -> responder:
    request: Decoupled(UncachedCommand(xlen, Context))
    store_payload: UncachedStorePayload()

  responder -> requester:
    request_fault: Bool
    request_access_fault: Bool
    response: Decoupled(PhysicalMemoryResp(xlen, Context))
    drained: Bool

export:
  UncachedCommand
  UncachedStorePayload
  UncachedTransportAccess
