#lang rhodium
/* Caches instruction snapshots from coherent RAM or immutable ROM until FENCE.I. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/layers/statistics.rhm").stat_count
  "../../cache-prefetch.rhdl" open
  "protocol.rhdl" open
  "../geometry.rhdl" open
  "../chi/flits.rhdl" open
  "../chi/line-read.rhdl" open
  "../../../../riscv/isa/xlen.rhm" open
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/plru.rhdl") open
  lib("rhodium/std/read-write.rhdl") open
  lib("rhodium/std/sync-ram.rhdl") open
  lib("flow/main.rhdl") open
  lib("chi/protocol/flits.rhdl") open
  lib("chi/protocol/channels.rhdl").CHIRNIChannels

/* Rejects address widths lacking tag bits beyond the line offset and set index. */
fun check_l1i_geometry(width :: PosInt, cache :: CacheConfig):
  unless width > (alignment_bits(CacheLineBytes) + cache.set_width)
  | error(~who: #'L1ICache, "address width must include line offset, set, and tag bits")

/* Only a matching refill fault consumes a saved line error; an address fault is independent. */
hardware_enum L1ILookupOutcome:
  Hit
  Miss
  AddressFault
  RefillFault

/* Pairs a virtual SRAM index with demand or response-free prefetch intent. */
bundle L1ILookup(address_width :: PosInt):
  address: Bits(address_width)
  prefetch: Bool

/* Carries the fixed-cycle lookup outcome and the physical line and way needed to start a miss. */
bundle L1IResolved(line_number_width :: PosInt, way_width :: PosInt, fetch_bits :: PosInt):
  line_number: Bits(line_number_width)
  way: Bits(way_width)
  prefetch: Bool
  outcome: L1ILookupOutcome
  data: Bits(fetch_bits)

/* Caches ownership-free instruction snapshots with VIPT lookup and one retained line read.
   Misses replay; tags become valid only after final installation. Flush detaches demand
   context, while FENCE.I also invalidates residency. */
sync_circuit L1ICache(xlen :: XLen, cache :: CacheConfig, ~chi: config :: RiscvHartCHIConfig, ~fetch_bits: fetch_bits :: PosInt):
  def width = xlen.width
  def p = config.flit
  def physical_width = math.min(width, p.request_address_width)
  check_l1i_geometry(physical_width, cache)
  unless fetch_bits == 32 || fetch_bits == 64
  | error(~who: #'L1ICache, "fetch block must be 32 or 64 bits")

  unless config.cache_line_bytes == CacheLineBytes
  | error(~who: #'L1ICache, "CHI region geometry must use 64-byte cache lines")

  def fetch_bytes = fetch_bits / 8
  def row_bits = if width > fetch_bits | width | fetch_bits
  def sets = cache.sets
  def ways = cache.ways
  def word_bytes = row_bits / 8
  def words_per_line = CacheLineBytes / word_bytes
  def rows_per_packet = p.data_bytes / word_bytes
  def packet_offset_width = alignment_bits(rows_per_packet)
  def data_depth = sets * words_per_line
  def data_lanes = ways * word_bytes
  def offset_width = alignment_bits(CacheLineBytes)
  def line_number_width = physical_width - offset_width
  def refill_line_bits = instruction_refill_line_bits(config, physical_width)
  def word_offset_width = alignment_bits(word_bytes)
  def set_width = cache.set_width
  def way_width = cache.way_width
  def tag_width = physical_width - offset_width - set_width
  def word_index_width = index_width(words_per_line)
  def data_address_width = index_width(data_depth)

  input node_id: Bits(p.node_id_width)
  interface core(InstructionCacheLookup(width, fetch_bits), ~role: responder)
  interface virtual_lookup(Decoupled(Bits(width)), ~role: consumer)
  interface prefetch(Valid(CachePrefetchReq(width)), ~role: consumer)
  interface chi(CHIRNIChannels(p), ~role: node)


  /* Synchronous arrays and independent refill engine */

  inst tags(SyncRam1RW(sets, Bits(tag_width), ways))
  inst lines(SyncRam1RW(data_depth, Bits(8), data_lanes))
  inst refill(CacheLineRead(Bits(way_width), width, config))
  refill.node_id <== node_id
  def cache_flush = core.flush ||| core.invalidate_all
  inst array_read(ValidPipeAlwaysCapture(L1ILookup(width), 1, ~flushable: #true))
  inst lookup(ValidPipeAlwaysCapture(L1IResolved(line_number_width, way_width, fetch_bits), 1, ~flushable: #true))
  lookup.flush <== cache_flush


  /* Resident validity and refill ownership */

  reg valid_lines(~init: vec(
    for List (_set in 0..sets): Bits(ways)(0).as_vec(Bool)
  ))

  reg replacement_state(~init: vec(
    for List (_set in 0..sets): plru_initial_state(ways)
  ))

  reg refill_live(~init: Bool(#false))
  reg refill_installable(~init: Bool(#false))
  reg tail_pending(~init: Bool(#false))
  reg tail_row(Bits(word_index_width))
  reg tail_data(Bits(p.data_width - row_bits))
  reg refill_error_valid(~init: Bool(#false))
  reg refill_error_line(Bits(math.max(1, refill_line_bits)))


  /* CHI line-read attachment */

  refill.requests |> chi.req
  chi.rsp.response |> refill.responses
  chi.dat.response |> refill.response_data
  refill.acknowledgements |> chi.rsp.requester
  chi.dat.request.valid <== Bool(#false)
  chi.dat.request.bits <== literal(CHIDatFlit(p), 0)


  /* Demand and prefetch lookup intent
     S0 arbitration gives demand priority; prefetch never produces a core response. */

  def demand_lookup = virtual_lookup |> map_flow(address => L1ILookup(width)):
    address: address
    prefetch: Bool(#false)

  def hinted_lookup:
    (prefetch |> filter_valid(request => !cache_flush & (request.into(CachePrefetchReq(width)).operation === CachePrefetchOperation.Instruction))
      |> map_valid(request => L1ILookup(width)):
           address: request.address
           prefetch: Bool(#true)
    ) |> offer_decoupled()


  /* S1 returned arrays and physical tag selection */

  def array_context = array_read.egress.bits.into(L1ILookup(width))
  def lookup_address = mux(array_context.prefetch, array_context.address, core.request.bits.address)
  def lookup_set = lookup_address[offset_width..(offset_width + set_width)]
  def lookup_fits = cache_chi_address_fits(lookup_address, p)
  def lookup_line = lookup_address[offset_width..physical_width]
  def lookup_tag = lookup_address[(offset_width + set_width)..physical_width]
  def lookup_valids = valid_lines[lookup_set]
  def lookup_matches = vec(
    for List (way in 0..ways):
      lookup_fits & lookup_valids[way] & (tags.port.response.bits[way] === lookup_tag)
  )

  def lookup_selection = priority_encoder_oh(lookup_matches)
  def line_hit = lookup_selection.valid
  def cached_words = lines.port.response.bits.as_bits().as_vec(Bits(row_bits))
  def cached_word = lookup_selection.mux(
    for List (way in 0..ways): cached_words[way],
    ~default: Bits(row_bits)(0)
  )

  def cached_fetch_word:
    if row_bits == fetch_bits
    | cached_word
    | mux(lookup_address[2].into(Bool), cached_word[32..64], cached_word[0..32])

  def lookup_has_context = array_read.egress.valid & tags.port.response.valid & (core.request.valid ||| array_context.prefetch)
  for (left in 0..ways):
    for (right in (left + 1)..ways):
      when lookup_has_context:
        assert(!(lookup_matches[left] & lookup_matches[right]), "l1i_core_hit_unique")


  /* The first row bypasses directly from DAT to SRAM. Only the remainder of
     this packet needs storage; its DataID, not arrival order, selects the rows. */

  def completion_address = refill.owner.line_address
  def completion_way = refill.owner.context
  def completion_set = completion_address[offset_width..(offset_width + set_width)]
  def completion_tag = completion_address[(offset_width + set_width)..physical_width]
  def write_allowed = refill_installable & !core.invalidate_all
  refill.packet.ready <== !tail_pending ||| !write_allowed
  def first_write = refill.packet.fire() & write_allowed
  def tail_write = tail_pending & write_allowed
  def first_row = refill.packet.bits.index.zext(word_index_width) << packet_offset_width
  def write_row = mux(tail_pending, tail_row, first_row)
  def last_row = if rows_per_packet == 2 | Bool(#true) | tail_row[0..packet_offset_width].all()
  def write_data = mux(tail_pending, tail_data[0..row_bits], refill.packet.bits.data[0..row_bits])

  when first_write:
    tail_data <== refill.packet.bits.data[row_bits..p.data_width]
    tail_row <== first_row + Bits(word_index_width)(1)
  elsewhen (tail_write & Bool(rows_per_packet > 2)):
    tail_data <== tail_data >> row_bits
    tail_row <== tail_row + Bits(word_index_width)(1)

  when first_write:
    tail_pending <== Bool(#true)
  elsewhen tail_pending:
    tail_pending <== write_allowed & !last_row


  /* S0 admission depends only on transaction/installation state, not S1 tags,
     translation, or the consuming instruction pipeline. */

  def array_accepts_input = refill.command.ready
  def Array(array_contexts, tag_reads, line_reads) = Array(demand_lookup, hinted_lookup)
    |> arbiter() |> gate_flow(array_accepts_input) |> to_valid() |> fork_valid(3)
  array_contexts |> array_read.ingress
  // A demand admitted with flush replaces the old virtual lookup at the edge.
  // Prefetch cannot use this exception, and a stalled demand leaves the pipe clear.
  array_read.flush <== cache_flush & !array_contexts.valid


  /* S1 captures a physical lookup; local replay kills younger SRAM results. */

  def lookup_survives = !cache_flush & !core.s1_kill & tags.port.response.valid & (core.request.valid ||| array_context.prefetch)
  def lookup_issue = array_read.egress.valid & lookup_survives
  def retained_error = refill_error_valid & !array_context.prefetch & (refill_error_line.zext(line_number_width) === lookup_line)
  def outcome = priority_mux(~default: L1ILookupOutcome.Miss):
    !lookup_fits: L1ILookupOutcome.AddressFault
    retained_error: L1ILookupOutcome.RefillFault
    line_hit: L1ILookupOutcome.Hit

  def resolved_lookup = L1IResolved(line_number_width, way_width, fetch_bits):
    line_number: lookup_line
    way: plru_replacement_way(ways, lookup_valids, replacement_state[lookup_set])
    prefetch: array_context.prefetch
    outcome: outcome
    data: cached_fetch_word

  array_read.egress |> filter_valid(_context => lookup_survives)
    |> map_valid(_context => resolved_lookup) |> lookup.ingress
  def request_fire = core.request.valid & !core.s1_kill & !cache_flush
  when request_fire:
    assert(core.request.bits.address.is_aligned(fetch_bytes), "l1i_fetch_block_aligned")
    assert(array_read.egress.valid & !array_context.prefetch, "l1i_physical_request_has_virtual_lookup")
    assert(array_context.address[0..12] === core.request.bits.address[0..12], "l1i_vipt_page_offset_matches")

  when lookup_issue:
    assert(tags.port.response.valid & lines.port.response.valid, "l1i_resolution_has_array_read")


  /* S2 misses return replay immediately. The refill engine alone owns the
     accepted CHI transaction; successful installation is observed by a retry. */

  def Array(refill_attempts, lookup_results) = lookup.egress |> filter_valid(_result => !cache_flush) |> fork_valid(2)
  (refill_attempts |> filter_valid(result => result.outcome === L1ILookupOutcome.Miss)
    |> map_valid(result => CacheLineReadCommand(Bits(way_width), width)):
         line_address: (result.line_number ++ Bits(offset_width)(0)).zext(width)
         context: result.way
  ) |> offer_decoupled() |> refill.command

  (lookup_results |> filter_valid(result => !result.prefetch) |> map_valid(result => InstructionCacheResult(fetch_bits)):
    data: result.data
    access_fault: result.outcome.is_one_of(L1ILookupOutcome.AddressFault, L1ILookupOutcome.RefillFault)
    replay: result.outcome === L1ILookupOutcome.Miss
  ) |> core.response

  // ROM completion can precede the last SRAM write. Never release its owner early.
  def refill_completed = refill.completion |> gate_flow(!tail_write ||| last_row) |> to_valid()


  /* Refill installation data and write masks */

  def refill_start = refill.command.fire()
  def demand_refill = !lookup.egress.bits.prefetch
  stat_count("icache_miss", refill_start & demand_refill)
  def refill_complete = refill_completed.valid
  def publishable = write_allowed & !refill.completion.bits
  def install = refill_complete & publishable
  def install_way_mask = cache_way_mask(cache, completion_way)
  def refill_word_bytes = write_data.as_vec(Bits(8))
  def line_write_mask = cache_lane_mask(cache, completion_way, word_bytes, !Mask(word_bytes)(0))
  def line_write_bytes = for List (lane in 0..data_lanes): refill_word_bytes[lane % word_bytes]


  /* Tag and data SRAM port arbitration
     Lookup and installation must remain mutually exclusive on each single read/write port. */

  def tag_read_commands = tag_reads |> map_valid(request => ReadWriteRequest(set_width, Bits(tag_width), ways)):
    address: request.address[offset_width..(offset_width + set_width)]
    write: Bool(#false)
    data: dont_care(Vec(ways, Bits(tag_width)))
    mask: dont_care(Mask(ways))

  def tag_write_commands = refill_completed |> filter_valid(_fault => publishable)
    |> map_valid(_completion => ReadWriteRequest(set_width, Bits(tag_width), ways)):
         address: completion_set
         write: Bool(#true)
         data: vec(for List (_way in 0..ways): completion_tag)
         mask: install_way_mask

  assert(!(tag_read_commands.valid & tag_write_commands.valid), "l1i_tag_ports_exclusive")
  Array(tag_write_commands, tag_read_commands) |> valid_arbiter() |> tags.port.request

  def line_read_commands = line_reads |> map_valid(request => ReadWriteRequest(data_address_width, Bits(8), data_lanes)):
    address: request.address[word_offset_width..(offset_width + set_width)]
    write: Bool(#false)
    data: dont_care(Vec(data_lanes, Bits(8)))
    mask: dont_care(Mask(data_lanes))

  def line_install_bits = ReadWriteRequest(data_address_width, Bits(8), data_lanes):
    address: completion_set ++ write_row
    write: Bool(#true)
    data: vec(line_write_bytes)
    mask: line_write_mask

  def line_install = inject_interface(Valid(ReadWriteRequest(data_address_width, Bits(8), data_lanes)), ~valid: first_write ||| tail_write, ~bits: line_install_bits)
  assert(!(line_read_commands.valid & line_install.valid), "l1i_data_ports_exclusive")
  Array(line_install, line_read_commands) |> valid_arbiter() |> lines.port.request


  /* Resident publication and replacement updates
     Retire the victim before the first destructive write, even if the read later
     faults. Only successful completion can publish the new tag and touch PLRU. */

  def validity_set = mux(refill_start, lookup.egress.bits.line_number[0..set_width], completion_set)
  def validity_way = mux(refill_start, lookup.egress.bits.way, completion_way)

  when (core.invalidate_all):
    valid_lines <== vec(
      for List (_set in 0..sets): Bits(ways)(0).as_vec(Bool)
    )
  elsewhen (refill_start ||| install):
    valid_lines <== valid_lines.updated(validity_set, valid_lines[validity_set].updated(validity_way, install))

  when (core.invalidate_all):
    replacement_state <== vec(
      for List (_set in 0..sets): plru_initial_state(ways)
    )
  elsewhen install:
    replacement_state <== replacement_state.updated(completion_set, plru_touch(ways, replacement_state[completion_set], completion_way))
  elsewhen (lookup_issue & line_hit):
    replacement_state <== replacement_state.updated(lookup_set, plru_touch(ways, replacement_state[lookup_set], lookup_selection.index))

  assert(!(install & lookup_issue & line_hit), "l1i_replacement_update_unique")


  /* Demand error retention and refill installability
     Speculative flush detaches demand faults; only architectural invalidation cancels installation. */

  when cache_flush:
    refill_live <== Bool(#false)
    refill_error_valid <== Bool(#false)
  otherwise:
    when refill_start:
      refill_live <== demand_refill
    elsewhen refill_complete:
      refill_live <== Bool(#false)

    when (refill_complete & refill_live & refill.completion.bits):
      refill_error_valid <== Bool(#true)
      refill_error_line <== if refill_line_bits == 0 | Bits(1)(0) | completion_address[offset_width..(offset_width + refill_line_bits)]
    elsewhen (core.response.valid & (lookup.egress.bits.outcome === L1ILookupOutcome.RefillFault)):
      refill_error_valid <== Bool(#false)

  when (core.invalidate_all):
    refill_installable <== Bool(#false)
  elsewhen refill_start:
    refill_installable <== Bool(#true)
  elsewhen refill_complete:
    refill_installable <== Bool(#false)

export:
  L1ICache
