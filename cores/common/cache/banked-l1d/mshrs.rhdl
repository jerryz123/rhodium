#lang rhodium
/* Owns the banked L1D's interchangeable miss slots and pending victims. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../chi/flits.rhdl" open
  "../chi/refill.rhdl" open
  "../chi/writeback.rhdl" open
  "../geometry.rhdl" open
  lib("chi/protocol/flits.rhdl") open
  lib("chi/protocol/coherence.rhdl") open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open
  lib("flow/circular-priority.rhdl") open

/* Reserves a line and way. Only an acquisition issued for the service head
   consumes its response destination or applies the retained mutation. */
bundle L1DMissTarget(width :: PosInt, ways :: PosInt):
  address: Bits(width)
  way: Bits(index_width(ways))
  ordered: Bool
  install: Bool

/* Describes a physical line and its coherence state at allocation or snoop update. */
bundle L1DLineState(width :: PosInt):
  address: Bits(width)
  state: CHICacheState

/* Carries a replacement and its victim atomically. Invalid denotes no copyback. */
bundle L1DMissAllocation(width :: PosInt, ways :: PosInt):
  opcode: CHIReqOpcode
  target: L1DMissTarget(width, ways)
  victim: L1DLineState(width)

/* Selects a victim row, or releases the same line and way after the final DAT transfer. */
bundle L1DVictimRead(width :: PosInt, ways :: PosInt, packets :: PosInt):
  address: Bits(width)
  way: Bits(index_width(ways))
  index: Bits(index_width(packets))
  release: Bool

/* The selected copyback owns the reader through release, including packet backpressure. */
interface L1DVictimReader(width :: PosInt, ways :: PosInt, data_bytes :: PosInt):
  role copyback
  role reader
  provider copyback
  copyback -> reader:
    request: Valid(L1DVictimRead(width, ways, cache_line_rows(data_bytes)))
  reader -> copyback:
    packet: Decoupled(Bits(data_bytes * 8))

/* Owns one miss's replacement, dirty victim, and the trace scope shared by both engines. */
sync_circuit L1DMissSlot(i :: Nat, count :: PosInt, width :: PosInt, ways :: PosInt, config :: RiscvHartCHIConfig):
  def p = config.flit
  def Target = L1DMissTarget(width, ways)
  def Command = CacheLineRefillCommand(Target)
  def Result = CacheLineRefillResult(Target, width)
  trace_instance("mshr", Bits(12)(i), ~under: "dcache")
  input node_id: Bits(p.node_id_width)
  input allow_early_acquire: Bool
  input snoop_pending: Bool
  interface snoop_update(Valid(L1DLineState(width)), ~role: consumer)
  interface protected_line(Valid(Bits(width)), ~role: producer)
  output free: Bool
  output pinned: Bool
  output target: Target
  output acquiring_unique: Bool
  interface command(Decoupled(L1DMissAllocation(width, ways)), ~role: consumer)
  interface reader(L1DVictimReader(width, ways, p.data_bytes), ~role: copyback)
  interface packet(Valid(CacheLineChunk(p.data_bytes)), ~role: producer)
  interface read_data(Decoupled(CHIDatFlit(p)), ~role: consumer)
  interface read_response(Decoupled(CHIRspFlit(p)), ~role: consumer)
  interface copy_response(Decoupled(CHIRspFlit(p)), ~role: consumer)
  interface read_request(Decoupled(CHIReqFlit(p)), ~role: producer)
  interface copy_request(Decoupled(CHIReqFlit(p)), ~role: producer)
  interface copy_data(Decoupled(CHIDatFlit(p)), ~role: producer)
  interface ack(Decoupled(CHIRspFlit(p)), ~role: producer)
  interface completion(Decoupled(Result), ~role: producer)

  reg pending(~init: Bool(#false))
  reg saved(Command)
  reg victim_line(L1DLineState(width))
  wire early_ready: Bool
  wire resume_ready: Bool

  inst engine(CacheLineRefill(Target, width, config, ~slot: i))
  engine.node_id <== node_id
  inst wb(CacheLineWriteback(Bits(index_width(count)), width, config, cache_copyback_txn_id(i, count)))
  def active = !wb.command.ready
  pinned <== active
  free <== engine.command.ready & !pending & !active
  target <== mux(pending, saved.context, engine.active_context)
  acquiring_unique <== mux(pending, saved.opcode === CHIReqOpcode.ReadUnique, engine.acquiring_unique)
  def id = Bits(index_width(count))(i)
  def Array(direct, eviction) = command |> demux_flow(2, request => (request.victim.state =/= CHICacheState.Invalid).as_bits())
  /* Drops victim metadata once the allocation has been routed. */
  fun as_refill(request :: L1DMissAllocation(width, ways)):
    CacheLineRefillCommand(Target):
      opcode: request.opcode
      context: request.target

  def clean = direct |> map_flow(request => as_refill(request))
  def Array(victim, acquisition) = eviction |> atomic_fork(2)
  acquisition.ready <== Bool(#true)
  def copyback = victim |> map_flow(_request):
    CacheLineWritebackCommand(Bits(index_width(count))):
      context: id
  copyback |> wb.command
  wb.node_id <== node_id
  wb.line_address <== mux(active, victim_line.address, command.bits.victim.address)
  wb.victim_state <== victim_line.state
  wb.snoop_pending <== snoop_pending
  copy_response |> wb.responses
  wb.requests |> copy_request
  wb.data |> copy_data
  reader.packet |> wb.packet
  wb.completion.ready <== Bool(#true)
  reader.request.valid <== wb.packet_needed ||| wb.completion.valid
  reader.request.bits <== L1DVictimRead(width, ways, cache_line_rows(p.data_bytes)):
    address: victim_line.address
    way: saved.context.way
    index: wb.packet_index
    release: wb.completion.valid

  protected_line.valid <== wb.granted
  protected_line.bits <== victim_line.address

  def early = inject_interface(Decoupled(Command), ~valid: pending & allow_early_acquire, ~bits: saved, ~ready: early_ready)
  def early_name = "buffered-replacement-" ++ to_string(i)
  describe_interface_retained_storage(victim.fire() & allow_early_acquire, early.fire(), pending & allow_early_acquire, ~name: early_name)
  describe_interface_contract(acquisition, early, early_name, ~trace_model: interface_trace_retained(~name: early_name))
  def launch = pending & !allow_early_acquire & wb.granted
  def resumed = inject_interface(Decoupled(Command), ~valid: launch, ~bits: saved, ~ready: resume_ready)
  def granted_slot = wb.grant |> filter_valid(_slot => !allow_early_acquire)
  def name = "replacement-" ++ to_string(i)
  describe_interface_retained_storage(granted_slot.valid, resumed.fire(), launch, ~name: name)
  describe_interface_contract(granted_slot, resumed, name, ~trace_model: interface_trace_retained(~name: name))
  Array(clean, resumed, early) |> arbiter() |> engine.command
  engine.line_address <== mux(engine.command.ready, engine.command.bits.context.address, engine.active_context.address)
  when (victim.fire()):
    pending <== Bool(#true)
    saved <== as_refill(victim.bits)
  elsewhen (resumed.fire() ||| early.fire()):
    pending <== Bool(#false)
  when (victim.fire()):
    victim_line <== victim.bits.victim
  elsewhen (snoop_update.valid & active & (victim_line.address === snoop_update.bits.address)):
    victim_line <== snoop_update.bits
  read_data |> engine.response_data
  read_response |> engine.responses
  engine.requests |> read_request
  engine.acknowledgements |> ack
  engine.packet_write |> packet
  engine.completion |> completion

/* Each allocated entry owns its destination until all rows install and its
   completion transfers. The request window, not this file, owns response order. */
sync_circuit L1DMSHRs(count :: Int.in(2 ..= 2047), width :: PosInt, ways :: PosInt, config :: RiscvHartCHIConfig):
  def p = config.flit
  def Target = L1DMissTarget(width, ways)
  def Allocation = L1DMissAllocation(width, ways)
  def Row = L1DVictimRead(width, ways, cache_line_rows(p.data_bytes))
  def Result = CacheLineRefillResult(Target, width)
  input node_id: Bits(p.node_id_width)
  input ordered_ready: Bool
  interface snoop_update(Valid(L1DLineState(width)), ~role: consumer)
  input snoop_pending: Bool
  input probe_address: Bits(width)
  output victim_protected: Bool
  input packet_ready: Bool
  interface probe(Valid(Bits(width)), ~role: consumer)
  interface reader(L1DVictimReader(width, ways, p.data_bytes), ~role: copyback)
  interface copy_data(Decoupled(CHIDatFlit(p)), ~role: producer)
  interface allocate(Decoupled(Allocation), ~role: consumer)
  interface complete(Decoupled(Result), ~role: producer)
  interface packet(Valid(CacheLineChunk(p.data_bytes)), ~role: producer)
  output packet_target: Target
  output pinned: Vec(count, Bool)
  output occupied: Vec(count, Bool)
  output targets: Vec(count, Target)
  output acquiring_unique: Vec(count, Bool)
  output protect: Bool
  output install_pending: Bool
  interface requests(Decoupled(CHIReqFlit(p)), ~role: producer)
  interface acknowledgements(Decoupled(CHIRspFlit(p)), ~role: producer)
  interface responses(Decoupled(CHIRspFlit(p)), ~role: consumer)
  interface data(Decoupled(CHIDatFlit(p)), ~role: consumer)

  wire free: Vec(count, Bool)
  occupied <== (!free.as_bits()).as_vec(Bool)
  reg next_slot(~init: Bits(index_width(count))(0))
  def chosen :: CircularPriorityChoice(count, index_width(count)) = circular_priority_onehot(free, next_slot)
  def commands = allocate |> gate_flow(chosen.valid) |> demux_flow(count, _request => chosen.index)
  when (allocate.fire()):
    next_slot <== wrap_increment(chosen.index, count)
  def returns = data |> demux_flow(count, dat => priority_encoder(vec(for List (i in 0..count): dat.txn_id === Bits(12)(cache_mshr_txn_id(i)))))
  // Only the SRAM reader is serialized. Once selected, its slot owns
  // the row cursor, including stalled DAT, through victim invalidation.
  wire needed: Vec(count, Bool)
  wire done: Vec(count, Bool)
  wire protected_victims: Vec(count, Bool)
  wire victim_rows: Vec(count, Row)
  reg reading(~init: Bool(#false))
  reg reader_slot(Bits(index_width(count)))
  reg next_reader(~init: Bits(index_width(count))(0))
  def choice :: CircularPriorityChoice(count, index_width(count)) = circular_priority_onehot(needed, next_reader)
  def owner = mux(reading, reader_slot, choice.index)
  def complete_copy = done.any()
  when complete_copy:
    reading <== Bool(#false)
    next_reader <== wrap_increment(owner, count)
  elsewhen (!reading & choice.valid):
    reading <== Bool(#true)
    reader_slot <== choice.index
  reader.request.valid <== (needed[owner] ||| done[owner]) & (reading ||| choice.valid)
  reader.request.bits <== victim_rows[owner]
  victim_protected <== protected_victims.any()
  def victim_packets = reader.packet |> demux_flow(count, _packet => owner)
  inst credits(CacheRefillRetryRouter(p, count))
  credits.node_id <== node_id
  responses |> credits.incoming
  inst copies(Arbiter(CHIReqFlit(p), count))
  inst outgoing(Arbiter(CHIDatFlit(p), count))
  outgoing.egress |> copy_data
  inst reads(Arbiter(CHIReqFlit(p), count))
  inst acks(Arbiter(CHIRspFlit(p), count))
  inst results(Arbiter(Result, count))
  Array(reads.egress, copies.egress) |> arbiter() |> requests
  acks.egress |> acknowledgements
  results.egress |> complete

  wire metadata_pending: Vec(count, Bool)
  wire installing: Vec(count, Bool)
  wire writes: Vec(count, Bool)
  wire chunks: Vec(count, CacheLineChunk(p.data_bytes))
  // Only unordered ReadClean acquisitions can silently drop an uninstalled
  // clean copy and let their original demand replay from the ordered window.
  def packets = cache_line_rows(p.data_bytes)
  reg buffered(~init: Bool(#false))
  reg buffer_slot(Bits(index_width(count)))
  reg released(~init: Bool(#false))
  reg discarded(~init: Bool(#false))
  reg present(~init: Bits(packets)(0))
  reg payload(Vec(packets, Bits(p.data_width)))
  def offer_buffer = !buffered & (allocate.bits.victim.state =/= CHICacheState.Invalid) & !allocate.bits.target.ordered & (allocate.bits.opcode === CHIReqOpcode.ReadClean)
  def reserve = allocate.fire() & offer_buffer
  wire buffered_write: Vec(count, Bool)
  wire finished: Vec(count, Bool)
  def next_packet = priority_encoder_oh(present.as_vec(Bool))
  def drain = buffered & released & !discarded & next_packet.valid & packet_ready & !writes.any()

  def snoop_updates = snoop_update |> fork_valid(count)
  def slot_packets :: Array.later_of(Endpoint) = for Array (i in 0..count):
    inst slot(L1DMissSlot(i, count, width, ways, config))
    def id = Bits(index_width(count))(i)
    def staged = buffered & (buffer_slot === id)
    slot.node_id <== node_id
    slot.allow_early_acquire <== staged ||| (offer_buffer & free[i])
    slot.snoop_pending <== snoop_pending
    snoop_updates[i] |> slot.snoop_update
    protected_victims[i] <== slot.protected_line.valid & (slot.protected_line.bits === probe_address)
    commands[i] |> slot.command
    free[i] <== slot.free
    pinned[i] <== slot.pinned
    targets[i] <== slot.target
    acquiring_unique[i] <== slot.acquiring_unique

    victim_rows[i] <== slot.reader.request.bits
    needed[i] <== slot.reader.request.valid & !slot.reader.request.bits.release
    done[i] <== slot.reader.request.valid & slot.reader.request.bits.release
    victim_packets[i] |> slot.reader.packet
    when (done[i]):
      assert(reading & (owner === id), "copyback_completes_with_reader_ownership")

    credits.outgoing[count + i] |> slot.copy_response
    credits.outgoing[i] |> slot.read_response
    slot.copy_request |> copies.ingress[i]
    slot.copy_data |> outgoing.ingress[i]
    slot.read_request |> reads.ingress[i]
    slot.ack |> acks.ingress[i]

    /* The bank accepts DAT only when its destination can take the packet.
       A staged clean line is not visible until the victim is released and the rows drain. */

    returns[i] |> gate_flow(staged ||| (!slot.pinned & packet_ready)) |> slot.read_data
    buffered_write[i] <== staged & slot.packet.valid
    writes[i] <== !staged & slot.packet.valid
    chunks[i] <== slot.packet.bits
    def publishable = !slot.pinned & (!staged ||| (released & (discarded ||| !present.any())))
    def install = slot.completion.bits.context.install & !(staged & discarded)
    metadata_pending[i] <== !staged & (slot.ack.valid ||| slot.completion.valid)
    installing[i] <== slot.completion.valid & publishable & install
    slot.completion
      |> gate_flow(publishable & (!slot.completion.bits.context.ordered ||| ordered_ready))
      |> map_flow(r => r.updated(~context: r.context.updated(~install: install)))
      |> results.ingress[i]
    finished[i] <== staged & slot.completion.fire()
    slot.packet

  def buffer_target = targets[buffer_slot]
  def drop = probe.valid & (probe.bits.align_down(CacheLineBytes) === buffer_target.address)
  when reserve:
    buffered <== Bool(#true)
    buffer_slot <== chosen.index
    released <== Bool(#false)
    discarded <== Bool(#false)
  elsewhen buffered:
    when (finished.any()): buffered <== Bool(#false)
    when (done[buffer_slot]): released <== Bool(#true)
    when drop: discarded <== Bool(#true)

  def arrival = buffered_write.any()
  def writer = priority_encoder_oh(writes)
  // Observe the single DAT acceptance without putting an extra wide mux on
  // either the direct install path or the staged packet write port.
  def accepted = inject_interface(Valid(Bool), ~valid: writer.valid ||| arrival, ~bits: arrival)
  describe_interface_selection(for List (i in 0..count): writes[i] ||| buffered_write[i])
  describe_interface_contract(slot_packets, accepted, "packet-source", ~trace_model: interface_trace_selection())
  def Array(direct, staged_input) = accepted |> fork_valid(2)
  def incoming = chunks[buffer_slot]
  when arrival: payload[incoming.index] <== incoming.data
  when reserve:
    present <== Bits(packets)(0)
  otherwise:
    def received = mux(arrival, Bits(packets)(1) << incoming.index, Bits(packets)(0))
    present <== (present & !mux(drain, next_packet.as_bits(), Bits(packets)(0))) ||| received

  protect <== metadata_pending.any()
  install_pending <== installing.any()
  packet.valid <== writer.valid ||| drain
  def staged_packet = CacheLineChunk(p.data_bytes):
    index: next_packet.index
    data: payload[next_packet.index]
  def staged_output = inject_interface(Valid(CacheLineChunk(p.data_bytes)), ~valid: drain, ~bits: staged_packet)
  packet.bits <== mux(drain, staged_output.bits, chunks[writer.index])
  packet_target <== targets[mux(drain, buffer_slot, writer.index)]
  // Staged packets may drain in a different order than DAT arrival. Use
  // the same DataID-indexed ownership and discard rules as the payload bank.
  describe_interface_retained_bank(
    for List (i in 0..packets): arrival & (incoming.index === Bits(index_width(packets))(i)),
    for List (i in 0..packets): present.as_vec(Bool)[i] & (reserve ||| (drain & next_packet[i])),
    for List (i in 0..packets): present.as_vec(Bool)[i],
    ~grants: [for List (i in 0..packets): drain & next_packet[i]],
    ~name: "staged-packets"
  )
  describe_interface_contract(staged_input, staged_output, "staged-packets", ~trace_model: interface_trace_retained_bank(~name: "staged-packets"))
  describe_interface_selection([writer.valid, drain], ~name: "install-source")
  describe_interface_contract(Array(direct, staged_output), packet, "install-source", ~trace_model: interface_trace_selection(~name: "install-source"))

export:
  L1DVictimReader
  L1DLineState
  L1DMissAllocation
  L1DMissTarget
  L1DMSHRs
