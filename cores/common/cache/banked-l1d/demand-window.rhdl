#lang rhodium
/* Retains authorized L1D requests in order, with separate storage for write operands. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../protocol.rhdl" open
  "../operation.rhdl".CacheOperation
  "../../load-store.rhdl".MemoryWidth
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/rtl/atomic.rhdl").RiscvAtomicOperation
  lib("riscv/rtl/zihintntl.rhdl").RiscvMemoryLocality
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

def DemandEntries = 16
def WriteEntries = 8
def DemandIndex = Bits(index_width(DemandEntries))
def WriteIndex = Bits(index_width(WriteEntries))

/* Describes an ordered demand even before its hit way or miss slot is known. */
bundle DemandDescriptor(address_width :: PosInt, Context :: DataType):
  address: Bits(address_width)
  context: Context
  access: CacheOperation
  width: MemoryWidth
  unsigned: Bool
  locality: RiscvMemoryLocality
  write_slot: WriteIndex
  raw_beat: Bool

/* Keeps byte enables and an AMO's operation alongside its write operand. */
bundle WriteOperand(beat_bytes :: Pow2Int):
  data: Bits(8 * beat_bytes)
  byte_mask: Bits(beat_bytes)
  atomic: RiscvAtomicOperation

/* A head-relative issue port can classify younger descriptors without freeing
   either ring. Only removal of the ordered head releases its operand slot. */
sync_circuit L1DDemandWindow(xlen :: XLen, Context :: DataType, beat_bytes :: Pow2Int,
                             address_width :: PosInt, offset_width :: PosInt, set_width :: PosInt):
  def Request = AddressedPhysicalMemoryBeatReq(xlen, Context, beat_bytes, address_width)
  def raw = beat_bytes > xlen.width / 8
  def Descriptor = DemandDescriptor(address_width, Context)
  interface ingress(Decoupled(Request), ~role: consumer)
  interface egress(Irrevocable(Request), ~role: producer)
  input (classifying, classified, lookup_in_flight, lookup_off_head): Bool
  output issue_request: Request
  input probe_set: Bits(set_width)
  output independent: Bool
  def Count = Bits(index_width(DemandEntries + 1))
  output count: Count
  output (classified_count, issue_offset): Count
  output retired_classified: Bool
  input wait_for_acquisition: Bool
  interface wake(Valid(Bits(set_width)), ~role: consumer)
  output (head_waiting, issue_waiting): Bool

  reg head(~init: DemandIndex(0))
  reg tail(~init: DemandIndex(0))
  reg occupancy(~init: Count(0))
  reg entries(Vec(DemandEntries, Descriptor))
  reg live(~init: Bits(DemandEntries)(0).as_vec(Bool))
  def Operand = WriteOperand(beat_bytes)
  mem operands(WriteEntries, Operand)
  def WriteCount = Bits(index_width(WriteEntries + 1))
  reg write_count(~init: WriteCount(0))
  reg write_tail(~init: WriteIndex(0))

  /* CBO.ZERO synthesizes bytes locally; only these three operations need a slot. */
  fun has_operand(op :: CacheOperation) :~ Bool:
    op.is_one_of(CacheOperation.Store, CacheOperation.StoreConditional, CacheOperation.Atomic)

  def request :: AddressedPhysicalMemoryBeatReq(xlen, Context, beat_bytes, address_width) = ingress.bits
  def writing = has_operand(request.access)
  ingress.ready <== (occupancy < Count(DemandEntries)) & (!writing ||| (write_count < WriteCount(WriteEntries)))
  egress.valid <== occupancy.any()
  count <== occupancy
  def enqueue = ingress.fire()
  def dequeue = egress.fire()
  // Classification advances issue without retiring an entry or its operand.
  // Replay starts at the head; an in-flight lookup accounts for one position.
  reg prefix(~init: Count(0))
  def removing = dequeue & prefix.any()
  when (classified ^ removing):
    prefix <== mux(classified, prefix + Count(1), prefix - Count(1))
  def cursor = mux(classifying, prefix, Count(0)) + (lookup_in_flight & (classifying ||| !lookup_off_head)).as_bits().zext(Count.width)
  classified_count <== prefix
  retired_classified <== removing
  issue_offset <== cursor
  assert(prefix <= occupancy, "l1d_classified_prefix_within_window")
  // The queue, not a reusable MSHR number, owns each waiter. Distinct live
  // acquisitions reserve distinct sets, so completion wakes by set even on
  // discard. A woken descriptor still rechecks tag and permission at replay.
  reg waiting(~init: Bits(DemandEntries)(0).as_vec(Bool))
  def next_class = head + prefix[0..index_width(DemandEntries)]
  def issue_slot = head + cursor[0..index_width(DemandEntries)]
  head_waiting <== waiting[head]
  issue_waiting <== waiting[issue_slot]
  def first :: DemandDescriptor(address_width, Context) = entries[head]
  def allocate = enqueue & writing
  def release = dequeue & has_operand(first.access)

  when enqueue:
    tail <== wrap_increment(tail, DemandEntries)
    entries[tail] <== DemandDescriptor(address_width, Context):
      address: request.address
      access: request.access
      width: request.width
      unsigned: request.unsigned
      context: request.context
      locality: request.locality
      write_slot: write_tail
      raw_beat: if raw | request.raw_beat | Bool(#false)
  when dequeue: head <== wrap_increment(head, DemandEntries)
  when (enqueue ^ dequeue): occupancy <== mux(enqueue, occupancy + Count(1), occupancy - Count(1))
  when allocate: write_tail <== wrap_increment(write_tail, WriteEntries)
  when (allocate ^ release): write_count <== mux(allocate, write_count + WriteCount(1), write_count - WriteCount(1))
  def operand = WriteOperand(beat_bytes):
    data: request.data
    byte_mask: request.byte_mask
    atomic: request.atomic
  operands.write(write_tail, operand, ~enable: allocate)

  /* Recover a service request only at its read port. Write bytes and controls
     are unobservable on loads and locally generated block operations. */
  fun expand(d :: DemandDescriptor(address_width, Context)) :~ AddressedPhysicalMemoryBeatReq(xlen, Context, beat_bytes, address_width):
    def w :: WriteOperand(beat_bytes) = mux(has_operand(d.access), operands[d.write_slot], literal(Operand, 0))
    def empty :: AddressedPhysicalMemoryBeatReq(xlen, Context, beat_bytes, address_width) = literal(Request, 0)
    def restored = empty.updated(~address: d.address, ~access: d.access,
                                 ~width: d.width, ~unsigned: d.unsigned, ~context: d.context,
                                 ~locality: d.locality, ~data: w.data, ~byte_mask: w.byte_mask, ~atomic: w.atomic)
    if raw | restored.updated(~raw_beat: d.raw_beat) | restored

  egress.bits <== expand(first)
  issue_request <== expand(entries[issue_slot])
  for (i in 0..DemandEntries):
    when (enqueue & (tail === DemandIndex(i))): live[i] <== Bool(#true)
    elsewhen (dequeue & (head === DemandIndex(i))): live[i] <== Bool(#false)
  def compatible = for List (i in 0..DemandEntries):
    def entry :: DemandDescriptor(address_width, Context) = entries[i]
    def set = entry.address.zext(math.max(address_width, offset_width + set_width))[offset_width..(offset_width + set_width)]
    def woke = wake.valid & (wake.bits === set)
    when (classified & (next_class === DemandIndex(i))):
      waiting[i] <== wait_for_acquisition & !woke
    elsewhen (woke ||| (dequeue & (head === DemandIndex(i)))):
      waiting[i] <== Bool(#false)
    !live[i] ||| (entry.access.is_load_or_store() & (set =/= probe_set))
  independent <== vec(compatible).as_bits().all()

  describe_interface_queue_storage(DemandEntries, enqueue, dequeue, head, tail, occupancy.any(), Bool(#false))
  describe_interface_contract(ingress, egress, "demand-head", ~kind: "queue", ~trace_model: interface_trace_queue())

/* Add the completed acquisition as a second parent of the successful SRAM replay.
   This companion ring follows the *classified prefix*: only an allocation or
   a covered demand waits for an owner. At most one live MSHR owns a set. Take
   its reference on completion, before the slot can be reused. None of these
   controls drive functional valid, ready or payload. */
fun describe_replay_waits(source :: Endpoint, observed :: Endpoint, completion :: Endpoint,
                          completed_set :: Bits, installed :: Bool, classified :: Bool,
                          waits :: Bool, request_set :: Bits, retire :: Bool, hit :: Bool):
  reg head(~init: DemandIndex(0))
  reg tail(~init: DemandIndex(0))
  when retire: head <== head + DemandIndex(1)
  when classified: tail <== tail + DemandIndex(1)

  def arrivals = completion |> fork_valid(DemandEntries)
  wire grants: Vec(DemandEntries, Bool)
  reg waiting(~init: vec(for List (_i in 0..DemandEntries): Bool(#false)))
  reg waiting_set(Vec(DemandEntries, request_set.type))
  reg saved(~init: vec(for List (_i in 0..DemandEntries): Bool(#false)))
  /* Observe a control occurrence without adding a functional interface port. */
  fun pulse(valid :: Bool):
    inject_interface(Valid(Bool), ~valid: valid, ~bits: Bool(#true))
  def parents :: Array.later_of(Endpoint) = for Array (i in 0..DemandEntries):
    def push = classified & (tail === DemandIndex(i))
    def pop = retire & (head === DemandIndex(i))
    def completed = arrivals[i].valid
    def old_match = waiting[i] & !pop & (waiting_set[i] === completed_set)
    def new_match = push & waits & (request_set === completed_set)
    def capture = completed & installed & (old_match ||| new_match)
    when push:
      waiting[i] <== waits & !(completed & new_match)
      waiting_set[i] <== request_set
    elsewhen (pop ||| (completed & old_match)):
      waiting[i] <== Bool(#false)
    when capture: saved[i] <== Bool(#true)
    elsewhen pop: saved[i] <== Bool(#false)
    grants[i] <== hit & (head === DemandIndex(i)) & saved[i]
    def parent = pulse(grants[i])
    def name = "parked-wait-" ++ to_string(i)
    describe_interface_retained_storage(capture, pop & saved[i], saved[i], ~name: name)
    describe_interface_contract(arrivals[i], parent, name, ~trace_model: interface_trace_retained(~name: name))
    parent

  // Describe the lookup transfer: only a successful waited replay
  // joins two causes. Stalls, classification and other lookups pass through.
  def linked = grants.any()
  def ordinary = pulse(source.fire() & !linked)
  def replay = pulse(linked)
  def dependency = pulse(linked)
  def joined = pulse(linked)
  describe_interface_contract(source, Array(ordinary, replay), "lookup-kind",
                              ~trace_model: interface_trace_routing([!linked, linked]))
  describe_interface_selection(for List (i in 0..DemandEntries): grants[i], ~name: "replay-owner")
  describe_interface_contract(parents, dependency, "replay-owner", ~trace_model: interface_trace_selection(~name: "replay-owner"))
  describe_interface_contract(Array(replay, dependency), joined, "waited-hit", ~trace_model: interface_trace_atomic_join(2))
  describe_interface_selection([!linked, linked], ~name: "lookup-parents")
  describe_interface_contract(Array(ordinary, joined), observed, "lookup-parents", ~trace_model: interface_trace_selection(~name: "lookup-parents"))

export DemandEntries L1DDemandWindow describe_replay_waits
