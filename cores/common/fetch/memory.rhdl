#lang rhodium
/* Routes fixed-cycle physical fetches to L1I or one retained uncached read. */
// SPDX-License-Identifier: Apache-2.0

import:
  "protocol.rhdl" open
  "../cache/l1i/protocol.rhdl" open
  lib("flow/main.rhdl") open

/* Returns one S2 outcome per surviving S1 request without waiting for uncached IO.
   Completed reads match all physical attributes; a different uncached retry discards
   stale data. The caller supplies cancellation independently of cache invalidation. */
sync_circuit InstructionMemoryRouter(address_width :: PosInt, fetch_bits :: PosInt):
  interface core(PhysicalInstructionLookup(address_width, fetch_bits), ~role: responder)
  interface cache(InstructionCacheLookup(address_width, fetch_bits), ~role: requester)
  interface uncached(PhysicalInstructionAccess(address_width, fetch_bits), ~role: requester)


  /* Physical S1/S2 lookup.
     Capture every surviving attempt; only cacheable requests reach the L1I port. */

  inst s2(ValidPipeAlwaysCapture(PhysicalInstructionReq(address_width), 1), ~reset_when: core.flush)
  core.request |> filter_valid(_request => !core.s1_kill & !core.flush) |> s2.ingress
  cache.flush <== core.flush
  cache.invalidate_all <== core.invalidate_all
  cache.s1_kill <== core.s1_kill
  (core.request |> filter_valid(request => request.cacheable & !core.s1_kill & !core.flush)
    |> map_valid(request => InstructionCacheReq(address_width)):
      address: request.address
  ) |> cache.request


  /* Retained uncached ownership.
     Pending work suppresses duplicate reads; completed bytes wait for a matching
     retry. Flush detaches this slot while transport drains its accepted owner. */

  reg pending(~init: Bool(#false))
  reg completed(~init: Bool(#false))
  reg request(PhysicalInstructionReq(address_width))
  reg response(PhysicalInstructionResp(fetch_bits))
  def uncached_attempt = s2.egress.valid & !s2.egress.bits.cacheable & !core.flush
  def completed_match = completed & (request.as_bits() === s2.egress.bits.as_bits())
  uncached.flush <== core.flush
  s2.egress |> filter_valid(request => !request.cacheable & !core.flush & !pending & !completed)
    |> offer_decoupled() |> uncached.request
  def returned = uncached.response |> gate_flow(pending & !core.flush) |> to_valid()


  /* S2 response selection.
     Cache misses, missing replies, and stale replies replay without exposing
     a completion belonging to another physical request. */

  def unavailable = InstructionCacheResult(fetch_bits):
    data: Bits(fetch_bits)(0)
    access_fault: Bool(#false)
    replay: Bool(#true)

  def cached_result = mux(cache.response.valid, cache.response.bits, unavailable)
  def uncached_result = InstructionCacheResult(fetch_bits):
    data: mux(completed_match, response.data, Bits(fetch_bits)(0))
    access_fault: completed_match & response.access_fault
    replay: !completed_match

  s2.egress |> filter_valid(_request => !core.flush)
    |> map_valid(request => mux(request.cacheable, cached_result, uncached_result))
    |> core.response


  /* Progress and cancellation priority.
     Flush wins; acceptance precedes completion, then the next uncached attempt
     consumes matching bytes or discards stale ones without reissuing that cycle. */

  when (core.flush):
    pending <== Bool(#false)
    completed <== Bool(#false)
  otherwise:
    when (uncached.request.fire()):
      pending <== Bool(#true)
      request <== s2.egress.bits
    elsewhen (returned.valid):
      pending <== Bool(#false)
      completed <== Bool(#true)
      response <== returned.bits
    elsewhen uncached_attempt:
      completed <== Bool(#false)

export InstructionMemoryRouter
