#lang rhodium
/* Computes physical beat geometry and VRF operand requirements without creating another
   pipeline payload. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/common/vector-layout.rhm") open
  "decode.rhdl" open
  "../fp/types.rhdl".FloatUnit
  "../../../riscv/isa/vector.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  lib("rhodium/std/bits.rhdl") open

/* Recognizes indexed addressing so data EEW and index EEW remain independent. */
fun vector_indexed_memory(control :: VectorControl()) :~ Bool:
  control.memory & control.memory_addressing.is_one_of(VectorMemoryAddressing.IndexedUnordered, VectorMemoryAddressing.IndexedOrdered)

/* Selects physical mask-bit beats for mask logic and nonelement scan results. */
fun vector_mask_word(control :: VectorControl()) :~ Bool:
  control.integer & (control.mask_logic ||| (control.scan & (control.scan_control.result =/= VectorScanResult.Elements)))

/* Selects singleton scheduling for memory, services, reductions, element moves, and vector
   gather. */
fun vector_single_element(control :: VectorControl(), ~packed_multiply: packed_multiply :: Bool = Bool(#false)) :~ Bool:
  def reduction = (control.integer ||| control.fp_service) & control.reduction
  def gather_vector = control.integer & control.gather & (control.operand === VectorOperandMode.Vector)
  control.memory ||| control.fp_service ||| (control.multiply_divide & !packed_multiply) ||| control.element_move ||| reduction ||| gather_vector

/* Packed banks handle subword multiply; full-word multiply and division use scalar services. */
fun vector_packed_multiply(xlen :: XLen, control :: VectorControl(), sew :: Bits(2), enabled :: Boolean) :~ Bool:
  Bool(enabled) & control.multiply_divide & !control.divide & (sew < Bits(2)(vector_format_count(xlen) - 1))

/* Identifies multiply-accumulate and fused FP operations that consume old vd. */
fun vector_reads_destination(control :: VectorControl()) :~ Bool:
  (control.multiply_divide & control.multiply_accumulate) ||| (control.fp_service & (control.fp_execution.unit === FloatUnit.FusedMultiplyAdd))

/* Identifies schedules needing the second general VRF operand read. */
fun vector_reads_second(control :: VectorControl()) :~ Bool:
  control.slide ||| !control.floating_point ||| control.fp_uses_vs1

/* Uses encoded memory EEW for nonindexed transfers and architectural SEW otherwise. */
fun vector_data_width(control :: VectorControl(), sew :: Bits(2)) :~ Bits(2):
  mux(control.memory & !vector_indexed_memory(control), control.memory_data_eew, sew)

/* Adjusts destination width for widening service results that use singleton scheduling. */
fun vector_destination_width(control :: VectorControl(), sew :: Bits(2)) :~ Bits(2):
  def widened = control.widening & ((control.multiply_divide & control.multiply_accumulate) ||| control.fp_service)
  sew + widened.as_bits().zext(2)

/* Selects indexed-memory or EI16-gather index EEW independently of data width. */
fun vector_index_width(control :: VectorControl(), sew :: Bits(2)) :~ Bits(2):
  priority_mux(~default: sew):
    vector_indexed_memory(control): control.memory_index_eew
    control.gather_index16: Bits(2)(1)

/* Selects physical packed, half-row, mask-bit, or singleton progress for one beat. */
fun vector_beat_lanes(xlen :: XLen, vlen :: VectorLength, control :: VectorControl(), sew :: Bits(2), ~packed_multiply: packed_multiply :: Bool = Bool(#false)) :~ Bits(index_width(vlen + 1)):
  def width_change = (control.integer & (control.widening ||| control.narrowing)) ||| (packed_multiply & control.widening)
  def packed = mux(width_change, Bits(index_width(vlen + 1))(vector_word_bytes(xlen) / 2), Bits(index_width(vlen + 1))(vector_word_bytes(xlen))) >> sew
  priority_mux(~default: packed):
    vector_mask_word(control): Bits(index_width(vlen + 1))(xlen.width)
    vector_single_element(control, ~packed_multiply: packed_multiply): Bits(index_width(vlen + 1))(1)

/* Rounds an element cursor down to its containing physical data row. */
fun vector_aligned_first(xlen :: XLen, vlen :: VectorLength, first :: Bits(index_width(vlen + 1)), sew :: Bits(2)) :~ Bits(index_width(vlen + 1)):
  first & !(Bits(index_width(vlen + 1))(vector_word_bytes(xlen) - 1) >> sew)

export:
  vector_indexed_memory
  vector_mask_word
  vector_single_element
  vector_packed_multiply
  vector_reads_destination
  vector_reads_second
  vector_data_width
  vector_destination_width
  vector_index_width
  vector_beat_lanes
  vector_aligned_first
