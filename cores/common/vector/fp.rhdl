#lang rhodium
/* Adapts one packed vector element to the shared scalar-format FP execution contract. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/common/fp/profile.rhm").fp_transport_profile
  "../fp/bundles.rhdl" open
  "bundles.rhdl" open
  "decode.rhdl" open
  "../simd-alu.rhdl".SimdElementWidth
  "../fp/types.rhdl" open
  "../../../riscv/isa/vector.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/isa/fp-profile.rhm" open
  "../../../riscv/rtl/floating-point.rhdl" open
  lib("hardfloat/main.rhdl") open
  lib("rhodium/std/bits.rhdl").Pow2Int

/* Builds a slot-tagged shared FP request with independently boxed operand precisions.
   Captures widening/fused topology and result domain without adding vector-only arithmetic. */
fun vector_fp_request(xlen :: XLen, vlen :: VectorLength, slots :: Pow2Int, beat :: VectorBeat(xlen, vlen), tag :: Bits(index_width(slots))) :~ FpExecutionRequest(xlen, fp_transport_profile(xlen), Bits(index_width(slots))):
  def profile = fp_transport_profile(xlen)
  def flen = floating_point_register_width(profile)

  /* Format mapping and conversion controls.
     Source and destination formats may differ; unused control fields retain
     their don't-care values behind the selected execution/register controls. */

  /* Maps legal FP element widths to IEEE execution precision. */
  fun precision(width :: SimdElementWidth) :~ FloatPrecision:
    mux_lookup(width, ~default: FloatPrecision.Double, [[SimdElementWidth.E16, FloatPrecision.Half], [SimdElementWidth.E32, FloatPrecision.Single]])

  /* Maps an integer source or destination element width to FP conversion controls. */
  fun integer_width(width :: SimdElementWidth) :~ FloatIntegerWidth:
    mux_lookup(width, [[SimdElementWidth.E8, FloatIntegerWidth.Byte], [SimdElementWidth.E16, FloatIntegerWidth.Half], [SimdElementWidth.E32, FloatIntegerWidth.Word], [SimdElementWidth.E64, FloatIntegerWidth.Long]])

  def source_precision = precision(beat.fp_source_width)
  def result_precision = precision(beat.fp_result_width)
  def left_precision = precision(compute_vs2_eew(beat.control.width_shape, beat.element_width.as_bits()).into(SimdElementWidth))
  def right_precision = mux(vector_reduction(beat.control), result_precision, source_precision)
  // The decoder selects the physical FP operation; SEW supplies its format.
  wire unused: FloatingPointControl()
  unused <== dont_care(FloatingPointControl())
  def fp :: VectorFpControl() = beat.control.fp
  def fp_source = !fp.integer_source()
  def fp_destination = !fp.integer_result()
  def register_control = unused.registers.updated(~destination: mux(fp_destination, FloatDestination.FloatingPoint, FloatDestination.Integer), ~uses_frs1: fp_source)
  def conversion_width = mux(fp_source, integer_width(beat.fp_result_width), integer_width(beat.fp_source_width))
  def execution_control = fp.execution.updated(
    ~source_precision: source_precision,
    ~destination_precision: result_precision,
    ~integer_width: conversion_width
  )

  def control = unused.updated(~registers: register_control, ~execution: execution_control)


  /* Operand boxing and fused-operation routing.
     A scalar FPR source is already boxed. Vector elements are boxed according
     to each operand's precision before swapping or selecting old vd. */

  /* NaN-boxes a raw vector element to the shared service's physical FPR width. */
  fun operand(value :: Bits(xlen.width), precision :: FloatPrecision) :~ Bits(flen):
    def half = riscv_nan_box(FloatFormat.F16, value[0..16].into(IEEEFloat(FloatFormat.F16)), flen)
    def single = riscv_nan_box(FloatFormat.F32, value[0..32].into(IEEEFloat(FloatFormat.F32)), flen)
    if xlen == XLen.X32
    | mux(precision === FloatPrecision.Half, half, single)
    | mux_lookup(precision, [[FloatPrecision.Half, half], [FloatPrecision.Single, single], [FloatPrecision.Double, value]])

  def floating_scalar = beat.control.operand === VectorOperandMode.FloatingScalar
  def scalar_operand = if xlen == XLen.X32 | beat.right[0..32] | beat.right
  def vector_left = operand(beat.left, left_precision)
  def source_right = mux(floating_scalar, scalar_operand, operand(beat.right, right_precision))
  def destination_operand = operand(beat.mask_or_old_vd, result_precision)
  def values(left, right, third) = fp.place_operands(Bits(flen), vector_left, source_right, destination_operand)
  def values(lhs_precision, rhs_precision, third_precision) = fp.place_operands(FloatPrecision, left_precision, right_precision, result_precision)


  /* Shared-service request with the persistent completion slot and captured
     rounding policy; no additional execution state belongs in this adapter. */

  FpExecutionRequest(xlen, profile, Bits(index_width(slots))):
    tag: tag
    control: control
    left: mux(fp_source, left, beat.left)
    left_precision: lhs_precision
    right: right
    right_precision: rhs_precision
    third: third
    third_precision: third_precision
    immediate_index: dont_care(Bits(5))
    rounding_mode: fp.resolve_rounding(beat.fp_rounding_mode)

export:
  vector_fp_request
