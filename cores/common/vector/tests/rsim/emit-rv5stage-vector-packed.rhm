#lang rhombus
// Defines packed vector memory with the production VRF and shared SIMD rotator.
// SPDX-License-Identifier: Apache-2.0
import:
  "../vector-packed-fixture.rhdl" open
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("rhodium/event/main.rhm").EventInstrumentationConfig
  lib("rhodium/event/tests/rsim/trace-sites.rhm").traced_target

def program = elaborate(VectorPackedFixture(8))
fun site_header(manifest):
  "namespace packed_sites {\n" ++ String.join(
    for List (label in ["packed/attempt", "vector/complete"], name in ["attempt", "complete"]):
      def matches = (for List (index in 0..manifest.sites.length()): index).filter(~keep: fun (index): manifest.sites[index].label == label)
      unless matches.length() == 1 | error("expected unique packed lineage checkpoint")
      "constexpr unsigned " ++ name ++ " = " ++ to_string(matches[0]) ++ ";\n",
    ""
  ) ++ "}\n"

def target = traced_target(site_header, EventInstrumentationConfig(~partial: #true))
export program target site_header
