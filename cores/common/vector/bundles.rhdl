#lang rhodium
/* Defines vector snapshots, packed beats, local memory attempts, and acceptance feedback. */
// SPDX-License-Identifier: Apache-2.0

import:
  "profile.rhm".DefaultVectorInstructionOwners
  lib("riscv/rtl/instruction-fields.rhdl").immediate_bits
  lib("riscv/isa/zvbb.rhm").VectorRotateImmediate
  lib("riscv/isa/v.rhm") as v_fields
  lib("riscv/rtl/trap.rhdl").ExceptionCause
  lib("cores/common/mmu/vector.rhdl") open
  lib("cores/common/vector-layout.rhm") open
  lib("rhodium/std/bits.rhdl").Pow2Int
  lib("rhodium/std/ready-valid.rhdl").Decoupled
  lib("hardfloat/main.rhdl").RoundingMode
  lib("hardfloat/main.rhdl").FloatFormat
  lib("riscv/rtl/floating-point.rhdl").riscv_unbox
  "packed-bundles.rhdl" open
  "register-file.rhdl" open
  "decode.rhdl" open
  "../simd-alu.rhdl" open
  "../../../riscv/isa/vector.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/model/formats.rhm" as riscv_fields
  "../../../riscv/rtl/instruction-fields.rhdl".instruction_field
  "../../../riscv/rtl/vector.rhdl" open
  "../../../riscv/rtl/pointer-masking.rhdl" open

/* Recognizes an encoded rs2=x0 nonsegmented strided load eligible for single-read splatting. */
fun vector_zero_stride_load_parts(control :: VectorControl(), instruction :: Bits(32)) :~ Bool:
  control.memory & !control.store & (control.memory_addressing === VectorMemoryAddressing.Strided) & !control.memory_nf.any() & !instruction_field(riscv_fields.rs2, instruction).any()

/* Requests packed-memory byte rotation through the existing SIMD full-word alignment slice. */
bundle VectorAlignment(xlen :: XLen):
  data: Bits(xlen.width)
  bytes: Bits(vector_byte_offset_width(xlen))

/* Resolves a slide's immediate, fixed-one, or full-width register distance. */
fun slide_amount(xlen :: XLen, control :: VectorControl(), instruction :: Bits(32), operand :: Bits(xlen.width)) :~ Bits(xlen.width):
  def immediate = instruction_field(riscv_fields.rs1, instruction)
  priority_mux(~default: operand):
    slide_inserts_scalar(control.permutation): Bits(xlen.width)(1)
    control.operand === VectorOperandMode.Immediate: immediate.zext(xlen.width)

/* Resolves the unsigned gather index without truncating a register operand. */
fun gather_operand(xlen :: XLen, control :: VectorControl(), instruction :: Bits(32), operand :: Bits(xlen.width)) :~ Bits(xlen.width):
  def immediate = instruction_field(riscv_fields.rs1, instruction)
  mux(control.operand === VectorOperandMode.Immediate, immediate.zext(xlen.width), operand)

/* Captures the CSR fields used after admission. Only the low byte of vtype is
   meaningful to execution; any set higher bit makes the encoding illegal. */
bundle VectorSequenceState(xlen :: XLen):
  vl: Bits(xlen.width)
  vtype: Bits(8)
  vtype_upper_nonzero: Bool
  vxrm: Bits(2)

  /* Decodes execution geometry with the architectural decoder. One reserved
     bit represents all high bits; this encoding is not for CSR readback. */
  method geometry(state, vlen :: VectorLength) :: RiscvVectorType(xlen, vlen):
    vector_type(xlen, vlen, (state.vtype_upper_nonzero.as_bits() ++ state.vtype).zext(xlen.width))

/* Derives the exclusive element limit for ordinary, whole-register and mask operations. */
fun sequence_limit(xlen :: XLen, vlen :: VectorLength, control :: VectorControl(), state :: RiscvVectorState(xlen) || VectorSequenceState(xlen)) :~ Bits(index_width(vlen + 1)):
  // Whole-register transfers ignore vl and vtype; encoded EEW counts their elements.
  def whole_register_memory = control.memory & (control.memory_mode === VectorMemoryMode.WholeRegister)
  def whole_register_group_shift = mux_lookup(control.memory_nf, ~default: Bits(2)(0), [[1, Bits(2)(1)], [3, Bits(2)(2)], [7, Bits(2)(3)]])
  def whole_register_elements = Bits(index_width(vlen + 1))(vlen / 8) >> control.memory_data_eew
  def whole_register_limit = whole_register_elements << whole_register_group_shift
  def whole_register_move = control.integer & vector_whole_copy(control)
  def whole_register_move_shift = mux_lookup(control.whole_register_count, ~default: Bits(2)(0), [[2, Bits(2)(1)], [4, Bits(2)(2)], [8, Bits(2)(3)]])
  def whole_register_move_limit = (Bits(index_width(vlen + 1))(vlen / 8) >> state.vtype[3..5]) << whole_register_move_shift
  def mask_memory = control.memory & (control.memory_mode === VectorMemoryMode.Mask)
  def mask_memory_limit = (state.vl[0..index_width(vlen + 1)] + Bits(index_width(vlen + 1))(7)) >> 3
  // Element moves have one bookkeeping beat, not a VL-sized iteration space.
  priority_mux(~default: state.vl[0..index_width(vlen + 1)]):
    vector_scalar_move(control): Bits(index_width(vlen + 1))(1)
    whole_register_move: whole_register_move_limit
    whole_register_memory: whole_register_limit
    mask_memory: mask_memory_limit

/* Carries controls, proof, and one XLEN word. The resident descriptor holds a scalar
   or stride; the scheduled offer reuses that field for packed data or a compression suffix. */
bundle VectorSequenceDescriptor(xlen :: XLen):
  pc: Bits(xlen.width)
  precertified: Bool
  certificate: VectorFastCertificate(xlen)
  instruction: Bits(32)
  state: VectorSequenceState(xlen)
  control: VectorControl()
  operand_word: Bits(xlen.width)
  masked: Bool
  rounding_mode: RoundingMode
  pointer_masking: PointerMaskControl()

  /* Destination or store-data source, which share the same instruction field. */
  method vd(d) :: Bits(5): instruction_field(v_fields.vd, d.instruction)

  /* First encoded vector source (also the five low immediate bits in VI forms). */
  method vs1(d) :: Bits(5): instruction_field(v_fields.vs1, d.instruction)

  /* Second encoded vector source. */
  method vs2(d) :: Bits(5): instruction_field(v_fields.vs2, d.instruction)

  /* Unbox a scalar FP operand at SEW for vector moves, without raising flags. */
  method unboxed_scalar(d) :: Bits(xlen.width):
    def cases = for List (n in 1..(vector_format_count(xlen)-1)):
      def format = if n == 1 | FloatFormat.F16 | FloatFormat.F32
      [n, riscv_unbox(format, xlen.width, d.operand_word).as_bits().zext(xlen.width)]
    mux_lookup(d.state.vtype[3..5], ~default: d.operand_word, cases)

  /* Resolve one lane's scalar data before replication. GPRs sign-extend from
     XLEN; FP lane bits zero-extend after unboxing. Raw FP-service operands
     and full-width permutation offsets have their own contracts. */
  method scalar_operand(d, width :: PosInt) :: Bits(width):
    def raw = immediate_bits(VectorRotateImmediate, d.instruction)
    def imm = mux_lookup(d.control.immediate_kind, ~default: raw[0..5].sext(width)):
      VectorImmediateKind.Unsigned5: raw[0..5].zext(width)
      VectorImmediateKind.Unsigned6: raw.zext(width)
    mux_lookup(d.control.operand, ~default: d.operand_word.sext(width)):
      VectorOperandMode.Immediate: imm
      VectorOperandMode.FloatingScalar: d.unboxed_scalar().zext(width)

  /* Tests a captured descriptor for encoded-zero-stride load execution. */
  method zero_stride_load(descriptor) :: Bool:
    vector_zero_stride_load_parts(descriptor.control, descriptor.instruction)

  /* Selects full-XLEN scalar, immediate, or fixed-one slide displacement before bounds checking. */
  method slide_distance(descriptor) :: Bits(xlen.width):
    slide_amount(xlen, descriptor.control, descriptor.instruction, descriptor.operand_word)

  /* Selects an unsigned immediate or full-XLEN scalar gather index. */
  method scalar_index(descriptor) :: Bits(xlen.width):
    gather_operand(xlen, descriptor.control, descriptor.instruction, descriptor.operand_word)

  /* Computes exclusive element progress, including VL-independent whole-register and byte-based
     mask modes. */
  method beat_limit(descriptor, vlen :: VectorLength) :: Bits(index_width(vlen + 1)):
    sequence_limit(xlen, vlen, descriptor.control, descriptor.state)

/* Pairs caller context with the selected operand rather than the original admission inputs. */
bundle VectorSequencedInstruction(xlen :: XLen, Context :: DataType):
  context: Context
  descriptor: VectorSequenceDescriptor(xlen)

/* Snapshots macro controls, architectural vector state, scalar operands, and optional page
   proof. */
bundle VectorDescriptor(xlen :: XLen):
  pc: Bits(xlen.width)
  precertified: Bool
  certificate: VectorFastCertificate(xlen)
  instruction: Bits(32)
  state: RiscvVectorState(xlen)
  control: VectorControl()
  scalar: Bits(xlen.width)
  floating_scalar: Bits(xlen.width)
  stride: Bits(xlen.width)
  masked: Bool
  rounding_mode: RoundingMode
  pointer_masking: PointerMaskControl()

  /* Keeps only the word that later beats consume; the original base seeds the
     two memory frontiers at admission and is not a sequenced operand. */
  method for_sequencing(descriptor) :: VectorSequenceDescriptor(xlen):
    def operand = priority_mux(~default: descriptor.scalar):
      descriptor.control.memory: descriptor.stride
      descriptor.control.floating_point & (descriptor.control.operand === VectorOperandMode.FloatingScalar): descriptor.floating_scalar

    VectorSequenceDescriptor(xlen):
      pc: descriptor.pc
      precertified: descriptor.precertified
      certificate: descriptor.certificate
      instruction: descriptor.instruction
      state:
        VectorSequenceState(xlen):
          vl: descriptor.state.vl
          vtype: descriptor.state.vtype[0..8]
          vtype_upper_nonzero: descriptor.state.vtype[8..xlen.width].any()
          vxrm: descriptor.state.vxrm

      control: descriptor.control
      operand_word: operand
      masked: descriptor.masked
      rounding_mode: descriptor.rounding_mode
      pointer_masking: descriptor.pointer_masking

  /* Destination or store-data source, which share the same instruction field. */
  method vd(d) :: Bits(5): instruction_field(v_fields.vd, d.instruction)

  /* First encoded vector source (also the five low immediate bits in VI forms). */
  method vs1(d) :: Bits(5): instruction_field(v_fields.vs1, d.instruction)

  /* Second encoded vector source. */
  method vs2(d) :: Bits(5): instruction_field(v_fields.vs2, d.instruction)

  /* Tests a captured descriptor for encoded-zero-stride load execution. */
  method zero_stride_load(descriptor) :: Bool:
    vector_zero_stride_load_parts(descriptor.control, descriptor.instruction)

  /* Selects full-XLEN scalar, immediate, or fixed-one slide displacement before bounds checking. */
  method slide_distance(descriptor) :: Bits(xlen.width):
    slide_amount(xlen, descriptor.control, descriptor.instruction, descriptor.scalar)

  /* Selects an unsigned immediate or full-XLEN scalar gather index. */
  method scalar_index(descriptor) :: Bits(xlen.width):
    gather_operand(xlen, descriptor.control, descriptor.instruction, descriptor.scalar)

  /* Unbox a scalar FP operand at SEW for vector moves, without raising flags. */
  method unboxed_scalar(d) :: Bits(xlen.width):
    def cases = for List (n in 1..(vector_format_count(xlen)-1)):
      def format = if n == 1 | FloatFormat.F16 | FloatFormat.F32
      [n, riscv_unbox(format, xlen.width, d.floating_scalar).as_bits().zext(xlen.width)]
    mux_lookup(d.state.sew(), ~default: d.floating_scalar, cases)

  /* Resolve one lane's scalar data before replication. GPRs sign-extend from
     XLEN; FP lane bits zero-extend after unboxing. Raw FP-service operands
     and full-width permutation offsets have their own contracts. */
  method scalar_operand(d, width :: PosInt) :: Bits(width):
    def raw = immediate_bits(VectorRotateImmediate, d.instruction)
    def imm = mux_lookup(d.control.immediate_kind, ~default: raw[0..5].sext(width)):
      VectorImmediateKind.Unsigned5: raw[0..5].zext(width)
      VectorImmediateKind.Unsigned6: raw.zext(width)
    mux_lookup(d.control.operand, ~default: d.scalar.sext(width)):
      VectorOperandMode.Immediate: imm
      VectorOperandMode.FloatingScalar: d.unboxed_scalar().zext(width)

  /* A register copy's effective length comes from its encoded register count, not VL or LMUL. */
  method whole_move_limit(d, vlen :: VectorLength) :: Bits(index_width(vlen + 1)):
    def bytes = d.control.whole_register_count.zext(index_width(vlen + 1)) << bits.length(vlen div 8 - 1)
    bytes >> d.state.sew()

  /* Computes exclusive element progress, including VL-independent whole-register and byte-based
     mask modes. */
  method beat_limit(descriptor, vlen :: VectorLength) :: Bits(index_width(vlen + 1)):
    sequence_limit(xlen, vlen, descriptor.control, descriptor.state)

/* Carries the completed range check separately from WB's physical-address proof. */
bundle VectorCheckedDescriptor(xlen :: XLen):
  descriptor: VectorDescriptor(xlen)
  certified: Bool
  owns_window: Bool

  /* Packed sequencing is safe only for certified unit-stride memory. */
  method packed_memory(entry) :: Bool:
    entry.certified & entry.descriptor.control.memory & (entry.descriptor.control.memory_addressing === VectorMemoryAddressing.UnitStride)

/* Names a checked instruction in the ordered macro ring, not a completion slot. */
bundle VectorDispatchEntry(xlen :: XLen, slots :: Pow2Int):
  checked: VectorCheckedDescriptor(xlen)
  owner: Bits(index_width(slots))

/* Selects the architecturally active bytes of a certified, aligned DLEN row. */
bundle VectorRowRequest(dlen :: PosInt):
  service: VectorMemoryService
  element_width: Bits(2)
  address: Bits(64)
  store: Bool
  byte_mask: Bits(vector_row_bytes(dlen))
  data: Bits(dlen)

/* Echoes the accepted operation kind so a store ACK needs no load destination metadata. */
bundle VectorRowResponse(dlen :: PosInt):
  store: Bool
  data: Bits(dlen)

/* Accepted rows return exactly one load value or store acknowledgement in request order. */
interface VectorRowMemory(dlen :: PosInt):
  role requester
  role responder
  provider requester
  requester -> responder:
    request: Decoupled(VectorRowRequest(dlen))
  responder -> requester:
    response: Decoupled(VectorRowResponse(dlen))

/* Pairs scalar instruction context with an immutable admitted vector descriptor. */
bundle VectorInstruction(xlen :: XLen, Context :: DataType):
  context: Context
  descriptor: VectorDescriptor(xlen)

/* Retains the not-yet-written packed compression suffix and destination progress. */
bundle VectorCompressState(xlen :: XLen, vlen :: VectorLength):
  data: Bits(xlen.width)
  count: Bits(vector_lane_count_width(xlen))
  destination: Bits(index_width(vlen + 1))

/* Schedules a partial final write under the sequencer's still-resident instruction. */
bundle VectorCompressSuffix(xlen :: XLen, vlen :: VectorLength):
  sequence: Bits(vector_sequence_width(vlen))
  end: Bits(index_width(vlen + 1))
  state: VectorCompressState(xlen, vlen)

/* Non-compressing beats have no buffered suffix and start at their first element. */
fun empty_compress_state(xlen :: XLen, vlen :: VectorLength, first :: Bits(index_width(vlen + 1))) :: VectorCompressState(xlen, vlen):
  VectorCompressState(xlen, vlen):
    data: Bits(xlen.width)(0)
    count: Bits(vector_lane_count_width(xlen))(0)
    destination: first

/* Carries memory-attempt context and completion identity without retaining SIMD operands. */
bundle VectorToken(xlen :: XLen, Context :: DataType, vector_completion_slots :: Pow2Int):
  precertified: Bool
  packed: Bool
  physical_address: Bits(xlen.width)
  store: Bool
  byte_mask: Bits(vector_word_bytes(xlen))
  context: Context
  last: Bool
  truncate_on_fault: Bool
  memory: Bool
  memory_width: Bits(2)
  enabled: Bool
  address: Bits(xlen.width)
  store_data: Bits(xlen.width)
  completion_tag: Bits(index_width(vector_completion_slots))

/* Carries resolved operands, per-beat progress, lane masks, and captured execution controls. */
bundle VectorBeat(xlen :: XLen, vlen :: VectorLength):
  sequence: Bits(vector_sequence_width(vlen))
  first: Bits(index_width(vlen + 1))
  end: Bits(index_width(vlen + 1))
  destination_first: Bits(index_width(vlen + 1))
  last: Bool
  empty: Bool
  address: Bits(xlen.width)
  left: Bits(xlen.width)
  right: Bits(xlen.width)
  // Scans and mask logic use element enables; MACs and fused FP use the old destination.
  mask_or_old_vd: Bits(xlen.width)
  enabled: Mask(vector_word_bytes(xlen))
  carry_in: Mask(vector_word_bytes(xlen))
  select_right: Mask(vector_word_bytes(xlen))
  element_width: SimdElementWidth
  fp_source_width: SimdElementWidth
  fp_result_width: SimdElementWidth
  rounding_mode: SimdRoundingMode
  fp_rounding_mode: RoundingMode
  control: VectorControl()
  destination: Bits(5)
  compress_count: Bits(vector_lane_count_width(xlen))
  compress_destination: Bits(index_width(vlen + 1))

  /* Extracts and the final scalar scan beat produce one integer register write. */
  method returns_gpr(beat) :: Bool:
    vector_writes_gpr(beat.control) & (vector_scalar_move(beat.control) ||| (vector_scan(beat.control) & beat.last))

  /* Only a scalar FP extract writes an FPR; vector FP arithmetic writes the VRF. */
  method returns_fpr(beat) :: Bool:
    vector_writes_fpr(beat.control) & vector_scalar_move(beat.control)

  /* Compression emits left and checkpoints right. Other operations use right as an
     operand and must never authorize it as suffix data. */
  method compress_state(beat) :: VectorCompressState(xlen, vlen):
    VectorCompressState(xlen, vlen):
      data: mux(beat.control.integer & (beat.control.permutation === VectorPermutationKind.Compress), beat.right, Bits(xlen.width)(0))
      count: beat.compress_count
      destination: beat.compress_destination

/* Pairs instruction context with an ordinary beat or packed transport metadata. */
bundle VectorMicroOp(xlen :: XLen, vlen :: VectorLength, Context :: DataType):
  context: Context
  beat: VectorBeat(xlen, vlen)
  packed: Bool
  packed_layout: VectorPackedLayout(xlen, vlen)
  byte_mask: Bits(vector_word_bytes(xlen))

/* Carries result metadata with a caller-selected physical or retained write representation. */
bundle VectorResultBeat(xlen :: XLen, vlen :: VectorLength, Write :: DataType):
  sequence: Bits(vector_sequence_width(vlen))
  first: Bits(index_width(vlen + 1))
  end: Bits(index_width(vlen + 1))
  last: Bool
  reduction: Bool
  scan: Bool
  scan_carry: Bits(xlen.width)
  scalar_destination: Bool
  floating_scalar_destination: Bool
  destination: Bits(5)
  element_width: SimdElementWidth
  memory: Bool
  floating_point: Bool
  fp_execute: Bool
  mask_destination: Bool
  fp_result: VectorFloatResult
  multiply_divide: Bool
  multiply_execute: Bool
  divide: Bool
  multiply_accumulate: Bool
  multiply_subtract: Bool
  store: Bool
  saturated: Bool
  shift: Bits(vector_bit_offset_width(xlen))
  write: Write
  compress_state: VectorCompressState(xlen, vlen)

  /* Classifies slot ownership by the issued route, not by whether this beat wrote a result. */
  method needs_completion_slot(beat) :: Bool:
    beat.memory ||| beat.floating_point ||| beat.multiply_divide

  /* Changes write representation without changing the result's owner, routing, or progress. */
  method with_write(beat, To :: DataType, write :: Hardware.of(To)) :: VectorResultBeat(xlen, vlen, To):
    VectorResultBeat(xlen, vlen, To):
      sequence: beat.sequence
      first: beat.first
      end: beat.end
      last: beat.last
      reduction: beat.reduction
      scan: beat.scan
      scan_carry: beat.scan_carry
      scalar_destination: beat.scalar_destination
      floating_scalar_destination: beat.floating_scalar_destination
      destination: beat.destination
      element_width: beat.element_width
      memory: beat.memory
      floating_point: beat.floating_point
      fp_execute: beat.fp_execute
      mask_destination: beat.mask_destination
      fp_result: beat.fp_result
      multiply_divide: beat.multiply_divide
      multiply_execute: beat.multiply_execute
      divide: beat.divide
      multiply_accumulate: beat.multiply_accumulate
      multiply_subtract: beat.multiply_subtract
      store: beat.store
      saturated: beat.saturated
      shift: beat.shift
      write: write
      compress_state: beat.compress_state

/* Reports one slot-tagged LSU attempt's disposition and precise fault information. */
bundle VectorCommit(xlen :: XLen, vector_completion_slots :: Pow2Int):
  tag: Bits(index_width(vector_completion_slots))
  pc: Bits(xlen.width)
  disposition: VectorDisposition
  slow: Bool
  data: Bits(xlen.width)
  cause: ExceptionCause
  fault_address: Bits(xlen.width)

/* Returns delayed LSU data by persistent completion slot, not current sequencing identity. */
bundle VectorCompletion(xlen :: XLen, vector_completion_slots :: Pow2Int):
  tag: Bits(index_width(vector_completion_slots))
  data: Bits(xlen.width)

/* Separates irreversible authorization from retry, precise fault, and fault-only-first
   truncation. */
hardware_enum VectorDisposition:
  Authorized
  Retry
  Fault
  Truncate

/* Returns an exclusive architectural position, not an active-lane count, and a replay
   checkpoint. Authorization is not result drain; accepted effects must never be retried. */
bundle VectorFeedback(xlen :: XLen, vlen :: VectorLength, Context :: DataType):
  packed_layout: VectorPackedLayout(xlen, vlen)
  context: Context
  sequence: Bits(vector_sequence_width(vlen))
  first: Bits(index_width(vlen + 1))
  end: Bits(index_width(vlen + 1))
  disposition: VectorDisposition
  cause: ExceptionCause
  fault_address: Bits(xlen.width)
  last: Bool
  compress_state: VectorCompressState(xlen, vlen)

/* Carries the scheduled beat's bounds, address, and destination through the VRF read. */
bundle VectorBeatControl(xlen :: XLen, vlen :: VectorLength):
  sequence: Bits(vector_sequence_width(vlen))
  first: Bits(index_width(vlen + 1))
  end: Bits(index_width(vlen + 1))
  last: Bool
  empty: Bool
  address: Bits(xlen.width)
  destination: Bits(5)

/* Retains the descriptor, restart bounds, and preparation metadata across fixed VRF latency. */
bundle VectorSequenceContext(xlen :: XLen, vlen :: VectorLength, Context :: DataType):
  instruction: VectorSequencedInstruction(xlen, Context)
  minimum: Bits(index_width(vlen + 1))
  gather_in_range: Bool
  gather_offset: Bits(vector_byte_offset_width(xlen))
  suffix: Bool
  suffix_count: Bits(vector_lane_count_width(xlen))
  suffix_destination: Bits(index_width(vlen + 1))
  packed: Bool
  packed_layout: VectorPackedLayout(xlen, vlen)
  packed_mask: Bits(vector_word_bytes(xlen))
  packed_store_read: Bool
  beat_control: VectorBeatControl(xlen, vlen)
  slide_valid: Bits(vector_slide_bytes(xlen))

/* Schedules enabled general/mask reads atomically with the downstream beat's resources. */
bundle VectorSequenceRequest(xlen :: XLen, vlen :: VectorLength, Context :: DataType):
  context: VectorSequenceContext(xlen, vlen, Context)
  enables: Bits(3)
  addresses: Vec(3, Bits(index_width(VectorRegisterLayout(vlen, xlen.width).depth)))
  mask_enable: Bool
  mask_address: Bits(index_width(VectorRegisterLayout(vlen, xlen.width).rows_per_register))

/* Pairs a mature beat with distinct persistent instruction-owner and completion-slot
   identities. */
bundle VectorOwnedResult(xlen :: XLen, vlen :: VectorLength, slots :: Pow2Int, owners :: Pow2Int = DefaultVectorInstructionOwners):
  beat: VectorResultBeat(xlen, vlen, VectorRegisterWrite(xlen.width, vlen))
  tag: Bits(index_width(slots))
  owner: Bits(index_width(owners))
  pc: Bits(xlen.width)
  splat: Bool

/* Claims a completion slot for one instruction owner and ordinary/packed route. */
bundle VectorSlotAllocation(owners :: Pow2Int):
  owner: Bits(index_width(owners))
  packed: Bool

/* Identifies the completed beat and supplies its unshifted result for a dependent fold. */
bundle VectorDrained(xlen :: XLen, vlen :: VectorLength, owners :: Pow2Int):
  beat: VectorResultBeat(xlen, vlen, VectorRegisterWrite(xlen.width, vlen))
  owner: Bits(index_width(owners))
  data: Bits(xlen.width)

/* Publishes read-only allocation, acceptance, and exact pending-row metadata for routing and
   hazards. */
bundle VectorSlotState(xlen :: XLen, vlen :: VectorLength, owners :: Pow2Int):
  allocated: Bool
  accepted: Bool
  packed: Bool
  owner: Bits(index_width(owners))
  write_address: Bits(index_width(VectorRegisterLayout(vlen, xlen.width).depth))
  writes: Bool

export:
  VectorSequenceDescriptor
  VectorSequencedInstruction
  vector_zero_stride_load_parts
  VectorDrained
  VectorOwnedResult
  VectorSlotAllocation
  VectorSlotState
  VectorBeatControl
  VectorSequenceContext
  VectorSequenceRequest
  VectorAlignment
  vector_sequence_width
  VectorDescriptor
  VectorCheckedDescriptor
  VectorDispatchEntry
  VectorRowMemory
  VectorRowRequest
  VectorRowResponse
  VectorInstruction
  VectorCompressState
  VectorCompressSuffix
  empty_compress_state
  VectorToken
  VectorBeat
  VectorMicroOp
  VectorResultBeat
  VectorDisposition
  VectorFeedback
  VectorCommit
  VectorCompletion
