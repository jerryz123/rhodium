#lang rhodium
/* Scans packed mask chunks and packs prefix counts or indices without owning retirement state. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/common/vector-layout.rhm") open
  lib("riscv/isa/xlen.rhm").XLen
  "../simd-alu.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/reduction.rhdl").prefix_scan

/* Selects a total count, first index, prefix mask, or packed per-element scan result. */
hardware_enum VectorScanResult:
  Count
  First
  Mask
  Elements

/* Projected scan controls: packed_rows sets cursor cadence; the other fields select arithmetic. */
bundle VectorMaskScanControl():
  packed_rows: Bool
  result: VectorScanResult
  index: Bool
  include_first: Bool
  only_first: Bool

/* Computes selected-bit prefixes and next recurrence carry combinationally.
   The caller bounds the enabled bits and owns carry advancement at result maturity. */
circuit VectorMaskScan(xlen :: XLen, ~dlen: width :: PosInt = xlen.width):
  input(source, enabled): Bits(width)
  input(first, carry): Bits(xlen.width)
  input element_width: SimdElementWidth
  input control: VectorMaskScanControl()
  output data: Bits(width)
  output next_carry: Bits(xlen.width)
  def selected = source & enabled
  // A shared parallel prefix network supplies the total and every lane prefix.
  // One extra count bit represents a fully selected physical word.
  def Count = Bits(index_width(width + 1))
  def counts = for List (index in 0..width): selected[index].zext(Count.packed_width())
  def sums = prefix_scan(counts, fun (left, right): left + right)

  def prefixes = [Count(0)] ++ sums
  def total :: Bits(Count.packed_width()) = sums[width - 1]
  def count = carry + total.zext(xlen.width)
  def first_set = count_leading_zeros(reverse_bits(selected)).zext(xlen.width)
  def first_result = mux((carry === !Bits(xlen.width)(0)) & selected.any(), first + first_set, carry)
  def mask = vec(for List (index in 0..width):
                   def preceding :: Bits(Count.packed_width()) = prefixes[index]
                   !carry.any() & !preceding.any() & mux(control.only_first, selected[index].into(Bool), control.include_first ||| !selected[index].into(Bool))).as_bits()

  def elements = for List (format in 0..vector_format_count(xlen)):
    def lane_width = 8 << format
    vec(for List (lane in 0..(width div lane_width)):
          def preceding :: Bits(Count.packed_width()) = prefixes[lane]
          mux(control.index, first + Bits(xlen.width)(lane), carry + preceding.zext(xlen.width))[0..lane_width]).as_bits()

  def packed = mux_lookup(element_width, ~default: elements[0], for List (format in 1..vector_format_count(xlen)): [SimdElementWidth.values()[format], elements[format]])
  next_carry <== mux(control.result === VectorScanResult.First, first_result, count)
  data <== mux_lookup(control.result, ~default: count.zext(width), [[VectorScanResult.First, first_result.zext(width)], [VectorScanResult.Mask, mask], [VectorScanResult.Elements, packed]])

export:
  VectorScanResult
  VectorMaskScanControl
  VectorMaskScan
