/* Project one scan operation into arithmetic, traversal and architectural destination
   columns. Register reads are generated independently from the ISA operand list. */
fun scan_case(instruction :: InstructionSpec, result :: VectorScanResult, ~index: index :: Boolean = #false,
              ~include_first: include_first :: Boolean = #false, ~only_first: only_first :: Boolean = #false):
  def dest:
    cond
    | result == VectorScanResult.Elements: VectorResultKind.Elements
    | result == VectorScanResult.Mask: VectorResultKind.Mask
    | ~else: VectorResultKind.Gpr
  def controls = partial_pattern(VectorMaskScanControl()):
    result: result
    index: Bool(index)
    packed_rows: Bool(result != VectorScanResult.Elements)
    include_first: if result == VectorScanResult.Mask | Bool(include_first) | pattern(Bool, _)
    only_first: if result == VectorScanResult.Mask | Bool(only_first) | pattern(Bool, _)
  integer_case(instruction, vselect_control, ~sequence: VectorSequence.Scan, ~result: dest, ~scan_control: controls)

def VectorMaskScanCases = [
  scan_case(VCPOP_M, VectorScanResult.Count),
  scan_case(VFIRST_M, VectorScanResult.First),
  scan_case(VMSBF_M, VectorScanResult.Mask),
  scan_case(VMSIF_M, VectorScanResult.Mask, ~include_first: #true),
  scan_case(VMSOF_M, VectorScanResult.Mask, ~only_first: #true),
  scan_case(VIOTA_M, VectorScanResult.Elements),
  scan_case(VID_V, VectorScanResult.Elements, ~index: #true)
]

/* A store names VS3 in the ISA catalog; every load names VD instead. This is an elaboration-time choice. */
fun memory_case(instruction :: InstructionSpec, fields :: Pattern):
  def store = instruction.operands.map(fun (operand): operand.name).contains("vs3")
  noncompute_case(instruction, (if store | VectorDispatchKind.Store | VectorDispatchKind.Load), fields)

/* Maps the ordered eight-entry unit/strided catalog to data EEW. */
fun memory_cases(instructions :: List.of(InstructionSpec), addressing :: VectorMemoryAddressing):
  for List (instruction in instructions, index in 0..8):
    memory_case(
      instruction,
      partial_pattern(VectorControl()):
        permutation: VectorPermutationKind.None
        configure: VectorConfigMode.None
        memory_mode: VectorMemoryMode.Ordinary
        memory_data_eew: Bits(2)(index % 4)
        memory_nf: Bits(3)(0)
        memory_addressing: addressing
        operand: VectorOperandMode.Scalar
    )

/* Maps indexed load/store catalogs to index EEW while data width remains runtime SEW. */
fun indexed_memory_cases(instructions :: List.of(InstructionSpec), addressing :: VectorMemoryAddressing):
  for List (instruction in instructions, index in 0..8):
    memory_case(
      instruction,
      partial_pattern(VectorControl()):
        permutation: VectorPermutationKind.None
        configure: VectorConfigMode.None
        memory_mode: VectorMemoryMode.Ordinary
        memory_index_eew: Bits(2)(index % 4)
        memory_nf: Bits(3)(0)
        memory_addressing: addressing
        operand: VectorOperandMode.Vector
    )

/* Derives data EEW and field count from segment-catalog order. */
fun segment_memory_cases(instructions :: List.of(InstructionSpec), addressing :: VectorMemoryAddressing):
  for List (instruction in instructions, index in 0..56):
    memory_case(
      instruction,
      partial_pattern(VectorControl()):
        permutation: VectorPermutationKind.None
        configure: VectorConfigMode.None
        memory_mode: VectorMemoryMode.Ordinary
        memory_data_eew: Bits(2)(index % 4)
        memory_nf: Bits(3)(((index % 28) div 4) + 1)
        memory_addressing: addressing
        operand: VectorOperandMode.Scalar
    )

/* Derives index EEW and field count for ordered/unordered indexed segments. */
fun indexed_segment_memory_cases(instructions :: List.of(InstructionSpec), addressing :: VectorMemoryAddressing):
  for List (instruction in instructions, index in 0..56):
    memory_case(
      instruction,
      partial_pattern(VectorControl()):
        permutation: VectorPermutationKind.None
        configure: VectorConfigMode.None
        memory_mode: VectorMemoryMode.Ordinary
        memory_index_eew: Bits(2)(index % 4)
        memory_nf: Bits(3)(((index % 28) div 4) + 1)
        memory_addressing: addressing
        operand: VectorOperandMode.Vector
    )

/* Builds unit-stride fault-first load rows, including segmented field counts. */
fun fault_only_first_memory_cases(instructions :: List.of(InstructionSpec)):
  for List (instruction in instructions, index in 0..32):
    memory_case(
      instruction,
      partial_pattern(VectorControl()):
        permutation: VectorPermutationKind.None
        configure: VectorConfigMode.None
        memory_mode: VectorMemoryMode.FaultOnlyFirst
        memory_data_eew: Bits(2)(index % 4)
        memory_nf: Bits(3)(if index < 4 | 0 | ((index - 4) div 4) + 1)
        memory_addressing: VectorMemoryAddressing.UnitStride
        operand: VectorOperandMode.Scalar
    )

/* Builds byte-stream mask load/store rows independent of ordinary data SEW. */
fun mask_memory_cases(instructions :: List.of(InstructionSpec)):
  for List (instruction in instructions, index in 0..2):
    memory_case(
      instruction,
      partial_pattern(VectorControl()):
        permutation: VectorPermutationKind.None
        configure: VectorConfigMode.None
        memory_mode: VectorMemoryMode.Mask
        memory_data_eew: Bits(2)(0)
        memory_nf: Bits(3)(0)
        memory_addressing: VectorMemoryAddressing.UnitStride
        operand: VectorOperandMode.Scalar
    )

/* Decodes whole-register transfer count and load EEW from the canonical catalog order. */
fun whole_register_memory_cases(instructions :: List.of(InstructionSpec)):
  for List (instruction in instructions, index in 0..20):
    def register_index = if index < 16 | index div 4 | index - 16
    memory_case(
      instruction,
      partial_pattern(VectorControl()):
        permutation: VectorPermutationKind.None
        configure: VectorConfigMode.None
        memory_mode: VectorMemoryMode.WholeRegister
        memory_data_eew: Bits(2)(if index < 16 | index % 4 | 0)
        memory_nf: Bits(3)([0, 1, 3, 7][register_index])
        memory_addressing: VectorMemoryAddressing.UnitStride
        operand: VectorOperandMode.Scalar
    )

def VectorUnitStrideMemoryCases = memory_cases(VectorUnitStrideMemoryInstructions, VectorMemoryAddressing.UnitStride)
def VectorStridedMemoryCases = memory_cases(VectorStridedMemoryInstructions, VectorMemoryAddressing.Strided)
def VectorIndexedUnorderedMemoryCases = indexed_memory_cases(VectorIndexedUnorderedMemoryInstructions, VectorMemoryAddressing.IndexedUnordered)
def VectorIndexedOrderedMemoryCases = indexed_memory_cases(VectorIndexedOrderedMemoryInstructions, VectorMemoryAddressing.IndexedOrdered)
def VectorIndexedMemoryCases = VectorIndexedUnorderedMemoryCases ++ VectorIndexedOrderedMemoryCases
def VectorUnitStrideSegmentMemoryCases = segment_memory_cases(VectorUnitStrideSegmentMemoryInstructions, VectorMemoryAddressing.UnitStride)
def VectorStridedSegmentMemoryCases = segment_memory_cases(VectorStridedSegmentMemoryInstructions, VectorMemoryAddressing.Strided)
def VectorIndexedUnorderedSegmentMemoryCases = indexed_segment_memory_cases(VectorIndexedUnorderedSegmentMemoryInstructions, VectorMemoryAddressing.IndexedUnordered)
def VectorIndexedOrderedSegmentMemoryCases = indexed_segment_memory_cases(VectorIndexedOrderedSegmentMemoryInstructions, VectorMemoryAddressing.IndexedOrdered)
def VectorIndexedSegmentMemoryCases = VectorIndexedUnorderedSegmentMemoryCases ++ VectorIndexedOrderedSegmentMemoryCases
def VectorFaultOnlyFirstMemoryCases = fault_only_first_memory_cases(VectorFaultOnlyFirstLoadInstructions)
def VectorMaskMemoryCases = mask_memory_cases(VectorMaskMemoryInstructions)
def VectorWholeRegisterMemoryCases = whole_register_memory_cases(VectorWholeRegisterMemoryInstructions)
def VectorMemoryCases = VectorUnitStrideMemoryCases ++ VectorStridedMemoryCases ++ VectorIndexedMemoryCases ++ VectorUnitStrideSegmentMemoryCases ++ VectorStridedSegmentMemoryCases ++ VectorIndexedSegmentMemoryCases ++ VectorFaultOnlyFirstMemoryCases ++ VectorMaskMemoryCases ++ VectorWholeRegisterMemoryCases
/* Generate numerical controls and their local result policy from the same FP unit.
   Iterative operations never consume a local result; only conversions care about signedness. */
fun floating_point_case(instruction :: InstructionSpec, unit :: FloatUnit,
                        ~order: order :: VectorFpOperandOrder = VectorFpOperandOrder.Vs2First,
                        ~operand: operand :: VectorOperandMode = VectorOperandMode.Vector,
                        ~source: source :: VectorFloatSource = VectorFloatSource.Floating,
                        ~result: result :: VectorFloatResult = VectorFloatResult.Floating,
                        ~rounding: rounding :: VectorFloatRounding = VectorFloatRounding.Dynamic,
                        ~sequence: sequence :: VectorSequence = VectorSequence.Rows,
                        ~shape: shape :: VectorWidthShape = VectorWidthShape.Same,
                        ~zvfhmin_e16: zvfhmin_e16 :: Boolean = #false,
                        ~wide_float: wide_float :: Boolean = #false,
                        ~uses_frm: uses_frm :: Boolean = #false,
                        ~fused: fused :: MulAddOperation = MulAddOperation.MultiplyAdd,
                        ~add: add :: FloatAddOperation = FloatAddOperation.Add,
                        ~divide: divide :: FloatDivideOperation = FloatDivideOperation.Divide,
                        ~sign: sign :: FloatSignOperation = FloatSignOperation.Copy,
                        ~minmax: minmax :: MinMaxOperation = MinMaxOperation.MinimumNumber,
                        ~estimate: estimate :: Estimate7Operation = Estimate7Operation.Reciprocal,
                        ~comparison: comparison :: FloatComparison = FloatComparison.Equal,
                        ~signaling: signaling :: Boolean = #false,
                        ~unsigned: unsigned :: Boolean || Pattern = pattern(Bool, _)):
  def local_result = cond
  | [FloatUnit.Add, FloatUnit.Multiply, FloatUnit.FusedMultiplyAdd].contains(unit): VectorLocalFpResult.RawThenRound
  | [FloatUnit.SignInject, FloatUnit.Classify].contains(unit): VectorLocalFpResult.DirectNoFlags
  | [FloatUnit.MinMax, FloatUnit.Compare, FloatUnit.Estimate, FloatUnit.Convert].contains(unit): VectorLocalFpResult.DirectWithFlags
  | unit == FloatUnit.DivideSquareRoot: pattern(VectorLocalFpResult, _)
  | ~else: error(~who: #'floating_point_case, "unsupported vector FP unit")
  def execution = partial_pattern(FloatExecutionControl()):
    unit: unit
    uses_rounding_mode: Bool(uses_frm)
    fused_operation: if unit == FloatUnit.FusedMultiplyAdd | fused | pattern(MulAddOperation, _)
    add_operation: if unit == FloatUnit.Add | add | pattern(FloatAddOperation, _)
    divide_operation: if unit == FloatUnit.DivideSquareRoot | divide | pattern(FloatDivideOperation, _)
    sign_operation: if unit == FloatUnit.SignInject | sign | pattern(FloatSignOperation, _)
    minmax_operation: if unit == FloatUnit.MinMax | minmax | pattern(MinMaxOperation, _)
    estimate_operation: if unit == FloatUnit.Estimate | estimate | pattern(Estimate7Operation, _)
    comparison: if unit == FloatUnit.Compare | comparison | pattern(FloatComparison, _)
    comparison_signaling: if unit == FloatUnit.Compare | Bool(signaling) | pattern(Bool, _)
    integer_unsigned: if unsigned is_a Boolean | Bool(unsigned) | unsigned
  compute_case(
    instruction, (if unit == FloatUnit.DivideSquareRoot | VectorComputeFamily.FpDivSqrt | VectorComputeFamily.FpArithmetic),
    operand, sequence, VectorPermutationKind.None, (if result == VectorFloatResult.Mask | VectorResultKind.Mask | VectorResultKind.Elements),
    partial_pattern(VectorControl()):
      fp_zvfhmin_e16: Bool(zvfhmin_e16)
      fp_wide_float: Bool(wide_float)
      width_shape: shape
      reads: compute_reads(instruction, ~old_vd: VectorFloatingPointFusedMultiplyAddInstructions.contains(instruction))
      fp:
        partial_pattern(VectorFpControl()):
          execution: execution
          local_result: local_result
          source: source
          result: result
          order: order
          rounding: if rounding != VectorFloatRounding.Dynamic || uses_frm | rounding | pattern(VectorFloatRounding, _)
  )

