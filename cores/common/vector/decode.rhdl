  floating_point_case(VFNCVT_XU_F_W, FloatUnit.Convert, ~uses_frm: #true, ~unsigned: #true, ~result: VectorFloatResult.Integer, ~shape: VectorWidthShape.Narrow, ~wide_float: #true),
  floating_point_case(VFNCVT_X_F_W, FloatUnit.Convert, ~uses_frm: #true, ~unsigned: #false, ~result: VectorFloatResult.Integer, ~shape: VectorWidthShape.Narrow, ~wide_float: #true),
  floating_point_case(VFNCVT_F_XU_W, FloatUnit.Convert, ~uses_frm: #true, ~unsigned: #true, ~source: VectorFloatSource.Integer, ~shape: VectorWidthShape.Narrow),
  floating_point_case(VFNCVT_F_X_W, FloatUnit.Convert, ~uses_frm: #true, ~unsigned: #false, ~source: VectorFloatSource.Integer, ~shape: VectorWidthShape.Narrow),
  floating_point_case(VFNCVT_F_F_W, FloatUnit.Convert, ~uses_frm: #true, ~shape: VectorWidthShape.Narrow, ~zvfhmin_e16: #true),
  floating_point_case(VFNCVT_ROD_F_F_W, FloatUnit.Convert, ~rounding: VectorFloatRounding.RoundToOdd, ~shape: VectorWidthShape.Narrow),
  floating_point_case(VFNCVT_RTZ_XU_F_W, FloatUnit.Convert, ~unsigned: #true, ~result: VectorFloatResult.Integer, ~rounding: VectorFloatRounding.TowardZero, ~shape: VectorWidthShape.Narrow, ~wide_float: #true),
  floating_point_case(VFNCVT_RTZ_X_F_W, FloatUnit.Convert, ~unsigned: #false, ~result: VectorFloatResult.Integer, ~rounding: VectorFloatRounding.TowardZero, ~shape: VectorWidthShape.Narrow, ~wide_float: #true)
]

/* Builds FP move/merge/slide controls that use vector routing without issuing FP arithmetic. */
fun floating_move_case(instruction :: InstructionSpec,
                       ~v0: v0 :: VectorV0Role = VectorV0Role.Predicate,
                       ~sequence: sequence :: VectorSequence = VectorSequence.Rows,
                       ~result: result :: VectorResultKind = VectorResultKind.Elements,
                       ~permutation: permutation :: VectorPermutationKind = VectorPermutationKind.None):
  compute_case(
    instruction, VectorComputeFamily.FpData, (if result == VectorResultKind.Fpr | VectorOperandMode.Vector | VectorOperandMode.FloatingScalar), sequence, permutation, result,
    partial_pattern(VectorControl()):
      width_shape: VectorWidthShape.Same
      fp_zvfhmin_e16: Bool(#false)
      fp_wide_float: Bool(#false)
      reads: compute_reads(instruction, ~v0: v0)
      integer_row:
        partial_pattern(VectorIntegerRowControl()):
          swap_operands: Bool(#false)
          alu: if [VectorPermutationKind.SlideOneUp, VectorPermutationKind.SlideOneDown].contains(permutation) | vslide_control | vselect_control
          can_saturate: Bool(#false)
  )

def VectorFloatingPointMoveCases = [
  floating_move_case(VFMERGE_VFM, ~v0: VectorV0Role.Selector),
  floating_move_case(VFMV_V_F),
  floating_move_case(VFMV_F_S, ~sequence: VectorSequence.Extract, ~result: VectorResultKind.Fpr),
  floating_move_case(VFMV_S_F, ~sequence: VectorSequence.Insert),
  floating_move_case(VFSLIDE1UP_VF, ~permutation: VectorPermutationKind.SlideOneUp),
  floating_move_case(VFSLIDE1DOWN_VF, ~permutation: VectorPermutationKind.SlideOneDown)
]

def VectorDivideCases = for List (instruction in VectorDivideInstructions):
  def signed_mode = [VDIV_VV, VDIV_VX, VREM_VV, VREM_VX].contains(instruction)
  compute_case(
    instruction, VectorComputeFamily.IntDivide, (if instruction.format == VectorVXFormat | VectorOperandMode.Scalar | VectorOperandMode.Vector), VectorSequence.Rows, VectorPermutationKind.None, VectorResultKind.Elements,
    partial_pattern(VectorControl()):
      width_shape: VectorWidthShape.Same
      reads: compute_reads(instruction)
      division:
        pattern(VectorDivideControl()):
          signed_mode: Bool(signed_mode)
          remainder: Bool([VREM_VV, VREM_VX, VREMU_VV, VREMU_VX].contains(instruction))
  )

def VectorMultiplyCases = for List (instruction in VectorMultiplyInstructions ++ VectorFractionalMultiplyInstructions ++ VectorWideningMultiplyInstructions ++ VectorMultiplyAccumulateInstructions ++ VectorWideningMultiplyAccumulateInstructions):
  def fractional = VectorFractionalMultiplyInstructions.contains(instruction)
  def widened = (VectorWideningMultiplyInstructions ++ VectorWideningMultiplyAccumulateInstructions).contains(instruction)
  def vd_role:
    cond
    | [VMADD_VV, VMADD_VX, VNMSUB_VV, VNMSUB_VX].contains(instruction): VectorProductVdRole.Factor
    | (VectorMultiplyAccumulateInstructions ++ VectorWideningMultiplyAccumulateInstructions).contains(instruction): VectorProductVdRole.Addend
    | ~else: VectorProductVdRole.Unused
  def accumulate = vd_role != VectorProductVdRole.Unused
  def select:
    cond
    | widened: SimdMultiplySelect.Wide
    | fractional: SimdMultiplySelect.Fractional
    | accumulate || [VMUL_VV, VMUL_VX].contains(instruction): SimdMultiplySelect.Low
    | ~else: SimdMultiplySelect.High
  def signed_left = fractional || [VMULH_VV, VMULH_VX, VMULHSU_VV, VMULHSU_VX, VWMULSU_VV, VWMULSU_VX, VWMUL_VV, VWMUL_VX, VWMACC_VV, VWMACC_VX, VWMACCUS_VX].contains(instruction)
  def signed_right = fractional || [VMULH_VV, VMULH_VX, VWMUL_VV, VWMUL_VX, VWMACC_VV, VWMACC_VX, VWMACCSU_VV, VWMACCSU_VX].contains(instruction)
  compute_case(
    instruction, VectorComputeFamily.IntProduct, (if instruction.format == VectorVXFormat | VectorOperandMode.Scalar | VectorOperandMode.Vector), VectorSequence.Rows, VectorPermutationKind.None, VectorResultKind.Elements,
    partial_pattern(VectorControl()):
      width_shape: if widened | VectorWidthShape.Widen | VectorWidthShape.Same
      reads: compute_reads(instruction, ~old_vd: accumulate)
      product:
        partial_pattern(VectorProductControl()):
          select: select
          mode:
            partial_pattern(MultiplierMode()):
              left_signed: if select == SimdMultiplySelect.Low | pattern(Bool, _) | Bool(signed_left)
              right_signed: if select == SimdMultiplySelect.Low | pattern(Bool, _) | Bool(signed_right)
          vd_role: vd_role
          subtract: if accumulate | Bool([VNMSAC_VV, VNMSAC_VX, VNMSUB_VV, VNMSUB_VX].contains(instruction)) | pattern(Bool, _)
  )

def VectorMultiplyDivideCases = VectorDivideCases ++ VectorMultiplyCases
def VectorControlCases = VectorConfigurationCases ++ VectorIntegerCases ++ VectorSlideCases ++ VectorGatherCases ++ VectorCompressCases ++ VectorMoveMergeCases ++ VectorWholeRegisterMoveCases ++ VectorMaskLogicCases ++ VectorElementMoveCases ++ VectorMaskScanCases ++ VectorIntegerReductionCases ++ VectorMemoryCases ++ VectorFloatingPointCases ++ VectorFloatingPointMoveCases ++ VectorMultiplyDivideCases

/* Resolves vset AVL/vtype sources and the x0 maximum/keep-VL conventions. */
fun vector_configuration_request(xlen :: XLen, mode :: VectorConfigMode, instruction :: Bits(32), scalar1 :: Bits(xlen.width), scalar2 :: Bits(xlen.width)) :~ RiscvVectorConfigRequest(xlen):
  def immediate_avl = mode === VectorConfigMode.AllImmediate
  def source_zero = !instruction_field(vs1, instruction).any()
  def destination_zero = !instruction_field(vd, instruction).any()
  RiscvVectorConfigRequest(xlen):
    vtype: mux(mode === VectorConfigMode.VtypeRegister, scalar2, mux(immediate_avl, instruction_field(vtype10, instruction).zext(xlen.width), instruction_field(vtype11, instruction).zext(xlen.width)))
    avl: mux(immediate_avl, instruction_field(avl5, instruction).zext(xlen.width), scalar1)
    maximum: !immediate_avl & source_zero & !destination_zero
    keep_vl: !immediate_avl & source_zero & destination_zero

/* Checks runtime vtype/vstart, profile widths, register-group alignment/overlap, and mask use.
   Whole-register memory bypasses vill; ordinary operations require a legal runtime vector
   configuration. */
circuit VectorOperationLegality(xlen :: XLen, vlen :: VectorLength, profile :: VectorProfile = VectorProfile.V, extensions :: List.of(VectorExtension) = DefaultVectorExtensions):
  input instruction: Bits(32)
  input control: VectorControl()
  input vtype: Bits(xlen.width)
  input vstart: Bits(xlen.width)
  output legal: Bool
  validate_vector_extensions(profile, extensions)


  /* Runtime geometry and schedule limits */

  def config = vector_type(xlen, vlen, vtype, ~elen: vector_profile_elen(profile))
  def requires_zero_start = vector_reduction(control) ||| (control.integer & ((control.permutation === VectorPermutationKind.Compress) ||| (vector_scan(control) & !control.scan_control.index)))
  def start_legal = !requires_zero_start ||| !vstart.any()
  def elen = Bits(2)(if vector_profile_supports_integer64(profile) | 3 | 2)
  def whole_register_memory = control.memory & (control.memory_mode === VectorMemoryMode.WholeRegister)
  def mask_memory = control.memory & (control.memory_mode === VectorMemoryMode.Mask)
  def indexed_memory = control.memory_addressing.is_one_of(VectorMemoryAddressing.IndexedUnordered, VectorMemoryAddressing.IndexedOrdered)
  def segmented_memory = control.memory & control.memory_nf.any()


  /* LMUL is a signed power-of-two exponent; EMUL = LMUL * EEW / SEW.
     Indexed memory uses SEW/LMUL for data and the encoded EEW for offsets. */

  def data_eew = mux(indexed_memory, config.sew, control.memory_data_eew)
  def emul = config.lmul.into(SInt(3)).sext(5) + data_eew.zext(5).into(SInt(5)) - config.sew.zext(5).into(SInt(5))
  def memory_index_emul = config.lmul.into(SInt(3)).sext(5) + control.memory_index_eew.zext(5).into(SInt(5)) - config.sew.zext(5).into(SInt(5))
  def widening_emul = config.lmul.into(SInt(3)).sext(5) + SInt(5)(1)
  def widening = (control.dispatch_kind === VectorDispatchKind.Execute) & widens_result(control.width_shape)
  def narrowing = control.integer & (control.width_shape === VectorWidthShape.Narrow)
  def fp_widening = control.fp_service & widens_result(control.width_shape)
  def fp_narrowing = control.fp_service & (control.width_shape === VectorWidthShape.Narrow)
  def extension = control.integer & extension_shift(control.width_shape).any()
  def whole_register_move = vector_whole_copy(control)
  def extension_power = extension_shift(control.width_shape).zext(5)
  def extension_emul = config.lmul.into(SInt(3)).sext(5) - extension_power.into(SInt(5))
  def extension_group = extension_emul.into(Bits(5))[0..3]
  def extension_group_mask = mux_lookup(extension_group, ~default: Bits(5)(0), [[1, Bits(5)(1)], [2, Bits(5)(3)], [3, Bits(5)(7)]])
  def group = mux(control.memory, emul.into(Bits(5))[0..3], config.lmul)
  def group_mask = vector_register_group_mask(group)
  def memory_group_shift = mux(emul < SInt(5)(0), Bits(3)(0), emul.into(Bits(5))[0..3])
  def memory_fields = control.memory_nf.zext(4) + Bits(4)(1)
  def memory_register_count = memory_fields.zext(7) << memory_group_shift
  def memory_index_group = memory_index_emul.into(Bits(5))[0..3]
  def memory_index_group_mask = vector_register_group_mask(memory_index_group)
  def wide_group_mask = mux_lookup(widening_emul.into(Bits(5))[0..3], ~default: Bits(5)(0), [[1, Bits(5)(1)], [2, Bits(5)(3)], [3, Bits(5)(7)]])
  def destination_group = mux(widening, widening_emul.into(Bits(5))[0..3], group)
  def destination_group_mask = mux_lookup(destination_group, ~default: Bits(5)(0), [[1, Bits(5)(1)], [2, Bits(5)(3)], [3, Bits(5)(7)]])


  /* Register identities and base alignment */

  def destination = instruction_field(vd, instruction)
  def source1 = instruction_field(vs1, instruction)
  def source2 = instruction_field(vs2, instruction)
  def vector_operand = control.operand === VectorOperandMode.Vector
  def destination_aligned = !(destination & destination_group_mask).any()
  def source1_aligned = !(source1 & group_mask).any()
  def source2_aligned = !(source2 & group_mask).any()


  /* Whole-register move bounds and alignment */

  def whole_register_mask = (control.whole_register_count - Bits(4)(1)).zext(5)
  def whole_register_destination_end = destination.zext(7) + control.whole_register_count.zext(7)
  def whole_register_source_end = source2.zext(7) + control.whole_register_count.zext(7)
  def whole_register_shift = mux_lookup(control.whole_register_count, ~default: Bits(2)(0), [[2, Bits(2)(1)], [4, Bits(2)(2)], [8, Bits(2)(3)]])
  def whole_register_limit = (Bits(index_width(vlen + 1))(vlen / 8) >> config.sew) << whole_register_shift
  def whole_register_move_count_legal = control.whole_register_count.is_one_of(Bits(4)(1), Bits(4)(2), Bits(4)(4), Bits(4)(8))
  def whole_register_move_aligned = !(destination & whole_register_mask).any() & !(source2 & whole_register_mask).any()
  def whole_register_move_in_bounds = (whole_register_destination_end <= Bits(7)(32)) & (whole_register_source_end <= Bits(7)(32))
  def whole_register_move_legal = whole_register_move_count_legal & whole_register_move_aligned & whole_register_move_in_bounds & (vstart < whole_register_limit.zext(xlen.width))


  /* Register-group overlap rules */

  def memory_index_aligned = !(source2 & memory_index_group_mask).any()
  def wide_source2_aligned = !(source2 & wide_group_mask).any()

  /* Allows a mask destination to overlap a source only at that source group's lowest register. */
  fun mask_overlap_legal(source :: Bits(5)) :: Bool:
    ((destination & !group_mask) =/= source) ||| (destination === source)

  /* Allows disjoint groups or overlap at the widened destination's high end for nonfractional
     sources. */
  fun widening_overlap_legal(source :: Bits(5)) :: Bool:
    def source_end = source.zext(6) + group_mask.zext(6) + Bits(6)(1)
    def widened_end = destination.zext(6) + destination_group_mask.zext(6) + Bits(6)(1)
    def disjoint = (destination.zext(6) >= source_end) ||| (source.zext(6) >= widened_end)
    disjoint ||| ((config.lmul.into(SInt(3)) >= SInt(3)(0)) & (source_end === widened_end))

  /* Allows disjoint groups or a narrowed destination at the wide source's low end. */
  fun narrowing_overlap_legal() :: Bool:
    def source_end = source2.zext(6) + wide_group_mask.zext(6) + Bits(6)(1)
    def destination_end = destination.zext(6) + group_mask.zext(6) + Bits(6)(1)
    def disjoint = (destination.zext(6) >= source_end) ||| (source2.zext(6) >= destination_end)
    disjoint ||| (destination === source2)


  /* Mask-source restrictions, scans, and reductions */

  def masked = !instruction_field(vm, instruction).any()
  // Merge reads v0 at EEW=1; the same register cannot also supply SEW data.
  def merge_sources_legal = (control.reads.v0 =/= VectorV0Role.Selector) ||| (source2.any() & (!vector_operand ||| source1.any()))
  // Carry-in uses v0 as EEW=1 data, so the same register cannot also supply a
  // SEW-wide source operand in that instruction.
  def carry_sources_legal = (control.reads.v0 =/= VectorV0Role.Carry) ||| (source2.any() & (!vector_operand ||| source1.any()))
  def reduction_source2_end = source2.zext(6) + group_mask.zext(6) + Bits(6)(1)
  def reduction_sources_disjoint = (source1.zext(6) < source2.zext(6)) ||| (source1.zext(6) >= reduction_source2_end)
  def widening_reduction_legal = !widening ||| ((config.sew < elen) & reduction_sources_disjoint)
  def reduction_sources_legal = source2_aligned & widening_reduction_legal & (!masked ||| (source1.any() & source2.any()))
  def scan_mask = control.result_kind === VectorResultKind.Mask
  def scan_overlap = mux(scan_mask, destination === source2, (source2 & !group_mask) === destination)
  def scan_legal = vector_writes_gpr(control) ||| ((!masked ||| destination.any()) & mux(scan_mask, destination =/= source2, destination_aligned & (!control.reads.vs2 ||| !scan_overlap)))
  // Aligned equal-size groups overlap exactly when their base registers match.
  def slide_overlap_legal = !is_register_slide(control.permutation) ||| ((!slide_moves_up(control.permutation) ||| (destination =/= source2)) & (!masked ||| source2.any()))


  /* Gather's index group may have a different EEW/EMUL. Compare physical
     register intervals before issuing any read, even for an empty body. */

  def index_emul = config.lmul.into(SInt(3)).sext(5) + SInt(5)(1) - config.sew.zext(5).into(SInt(5))
  def ei16 = control.permutation === VectorPermutationKind.GatherVectorEI16
  def index_group = mux(ei16, index_emul.into(Bits(5))[0..3], config.lmul)
  def index_mask = mux_lookup(index_group, ~default: Bits(5)(0), [[1, Bits(5)(1)], [2, Bits(5)(3)], [3, Bits(5)(7)]])
  def index_end = source1.zext(6) + index_mask.zext(6) + Bits(6)(1)
  def data_end = source2.zext(6) + group_mask.zext(6) + Bits(6)(1)
  def destination_end = destination.zext(6) + destination_group_mask.zext(6) + Bits(6)(1)
  def index_disjoint = (destination.zext(6) >= index_end) ||| (source1.zext(6) >= destination_end)
  def sources_disjoint = (source2.zext(6) >= index_end) ||| (source1.zext(6) >= data_end)
  def gather_index_width_legal = !ei16 ||| ((index_emul >= SInt(5)(-3)) & (index_emul <= SInt(5)(3)) & ((config.sew === Bits(2)(1)) ||| sources_disjoint))
  def gather_index_legal = !(source1 & index_mask).any() & index_disjoint & (!masked ||| source1.any()) & gather_index_width_legal
  def gather_data_legal = destination_aligned & source2_aligned & (destination =/= source2) & (!masked ||| (destination.any() & source2.any()))
  def gather_legal = gather_data_legal & (!gather_uses_vs1(control.permutation) ||| gather_index_legal)
  def compress_mask_disjoint = ((source1.zext(6) < destination.zext(6)) ||| (source1.zext(6) >= destination_end)) & ((source1.zext(6) < source2.zext(6)) ||| (source1.zext(6) >= data_end))
  def compress_legal = destination_aligned & source2_aligned & (destination =/= source2) & compress_mask_disjoint


  /* Integer widening, narrowing, and extension legality */

  def narrow_source2_legal = source2_aligned & widening_overlap_legal(source2)
  def wide_source2_legal = wide_source2_aligned
  def widening_legal = !widening ||| ((config.sew < elen) & (widening_emul <= SInt(5)(3)) & mux(has_wide_vs2(control.width_shape), wide_source2_legal, narrow_source2_legal) & (!vector_operand ||| widening_overlap_legal(source1)))
  def source1_end = source1.zext(6) + group_mask.zext(6) + Bits(6)(1)
  def wide_source2_end = source2.zext(6) + wide_group_mask.zext(6) + Bits(6)(1)
  def narrowing_sources_disjoint = !vector_operand ||| (source1.zext(6) >= wide_source2_end) ||| (source2.zext(6) >= source1_end)
  def narrowing_width_legal = (config.sew < elen) & (widening_emul <= SInt(5)(3))
  def narrowing_alignment_legal = wide_source2_aligned & (!vector_operand ||| source1_aligned)
  def narrowing_mask_legal = !masked ||| (source2.any() & (!vector_operand ||| source1.any()))
  def narrowing_legal = !narrowing ||| (narrowing_width_legal & narrowing_alignment_legal & narrowing_overlap_legal() & narrowing_sources_disjoint & narrowing_mask_legal)
  def extension_source_aligned = !(source2 & extension_group_mask).any()
  def extension_source_end = source2.zext(6) + extension_group_mask.zext(6) + Bits(6)(1)
  def extension_destination_end = destination.zext(6) + destination_group_mask.zext(6) + Bits(6)(1)
  def extension_disjoint = (destination.zext(6) >= extension_source_end) ||| (source2.zext(6) >= extension_destination_end)
  def extension_overlap_legal = extension_disjoint ||| ((extension_emul >= SInt(5)(0)) & (extension_source_end === extension_destination_end))
  def extension_width_legal = config.sew.zext(5) >= extension_power
  def extension_legal = extension_width_legal & (extension_emul >= SInt(5)(-3)) & extension_source_aligned & destination_aligned & extension_overlap_legal & (!masked ||| (source2.any() & destination.any()))


  /* Mask logic always names single registers, regardless of the data LMUL. */

  def integer_source2_legal = !control.reads.vs2 ||| mux((widening ||| narrowing) & has_wide_vs2(control.width_shape), wide_source2_aligned, source2_aligned)
  def integer_destination_legal = mux(vector_writes_mask(control), mask_overlap_legal(source2) & (!vector_operand ||| mask_overlap_legal(source1)), destination_aligned & !(masked & !destination.any()))
  def ordinary_integer_sources_legal = integer_source2_legal & (!vector_operand ||| source1_aligned)
  def ordinary_integer_overlap_legal = slide_overlap_legal & merge_sources_legal & carry_sources_legal & widening_legal & narrowing_legal
  def ordinary_integer_legal = ordinary_integer_overlap_legal & ordinary_integer_sources_legal & integer_destination_legal
  def selected_integer_legal = priority_mux(~default: ordinary_integer_legal):
    whole_register_move: whole_register_move_legal
    extension: extension_legal
    control.permutation === VectorPermutationKind.Compress: compress_legal
    is_register_gather(control.permutation): gather_legal
    vector_scan(control): scan_legal
    vector_scalar_move(control): Bool(#true)
    vector_reduction(control): reduction_sources_legal
    vector_packed_mask_rows(control): Bool(#true)

  def integer_legal = control.integer & selected_integer_legal


  /* Memory register groups, index overlap, and segment bounds */

  def memory_data_register_count = mux(segmented_memory, memory_register_count, group_mask.zext(7) + Bits(7)(1))
  def memory_data_end = destination.zext(7) + memory_data_register_count
  def memory_index_end = source2.zext(7) + memory_index_group_mask.zext(7) + Bits(7)(1)
  def memory_groups_disjoint = (destination.zext(7) >= memory_index_end) ||| (source2.zext(7) >= memory_data_end)
  def equal_index_width = control.memory_index_eew === config.sew
  def wide_index_shared_start = (config.sew < control.memory_index_eew) & (destination === source2)
  def narrow_index_shared_end = (config.sew > control.memory_index_eew) & (memory_index_emul >= SInt(5)(0)) & (memory_data_end === memory_index_end)
  def indexed_load_overlap_allowed = !segmented_memory & (equal_index_width ||| wide_index_shared_start ||| narrow_index_shared_end)
  def indexed_load_overlap_legal = memory_groups_disjoint ||| indexed_load_overlap_allowed
  def indexed_store_overlap_legal = equal_index_width ||| memory_groups_disjoint
  def indexed_overlap_legal = mux(control.store, indexed_store_overlap_legal, indexed_load_overlap_legal)
  def indexed_memory_legal = !indexed_memory ||| ((memory_index_emul >= SInt(5)(-3)) & (memory_index_emul <= SInt(5)(3)) & memory_index_aligned & indexed_overlap_legal & (!masked ||| source2.any()))
  def segment_memory_legal = !segmented_memory ||| ((memory_register_count <= Bits(7)(8)) & (memory_data_end <= Bits(7)(32)))
  def memory_eew_legal = (indexed_memory ||| (control.memory_data_eew <= elen)) & (!indexed_memory ||| (control.memory_index_eew <= elen))
  def memory_emul_legal = (emul >= SInt(5)(-3)) & (emul <= SInt(5)(3))
  def memory_destination_mask_legal = (control.store ||| !(masked & !destination.any())) & (!control.store ||| !masked ||| destination.any())
  def memory_groups_legal = destination_aligned & indexed_memory_legal & segment_memory_legal & memory_destination_mask_legal
  def ordinary_memory_legal = control.memory & !whole_register_memory & !mask_memory & memory_eew_legal & memory_emul_legal & memory_groups_legal
  def mask_memory_legal = mask_memory
  def whole_register_count = control.memory_nf.zext(7) + Bits(7)(1)
  def whole_register_end = destination.zext(7) + whole_register_count
  def whole_register_legal = whole_register_memory & (control.memory_data_eew <= elen) & control.memory_nf.is_one_of(Bits(3)(0), Bits(3)(1), Bits(3)(3), Bits(3)(7)) & !(destination & control.memory_nf.zext(5)).any() & (whole_register_end <= Bits(7)(32))


  /* Floating-point widths, overlap, and profile restrictions */

  def fp_width_change = fp_widening ||| fp_narrowing
  def fp_reduction = control.floating_point & vector_reduction(control)
  def fp_wide_source2 = has_wide_vs2(control.width_shape)
  def fp_source2_aligned = mux(fp_wide_source2, wide_source2_aligned, source2_aligned)
  def fp_element_sources_legal = fp_source2_aligned & (!control.reads.vs1 ||| source1_aligned)
  def fp_sources_legal = mux(fp_reduction, reduction_sources_legal, fp_element_sources_legal)
  def fp_destination_legal = fp_reduction ||| mux(vector_writes_mask(control), mask_overlap_legal(source2) & (!control.reads.vs1 ||| mask_overlap_legal(source1)), destination_aligned & !(masked & !destination.any()))
  def fp_widening_overlap_legal = mux(has_wide_vs2(control.width_shape), Bool(#true), widening_overlap_legal(source2)) & (!control.reads.vs1 ||| widening_overlap_legal(source1))
  def fp_zvfhmin = Bool(vector_extensions_support_zvfhmin(extensions))
  def fp_zvfh = Bool(vector_extensions_support_zvfh(extensions))
  def fp_e8_legal = (config.sew === Bits(2)(0)) & control.fp_wide_float & fp_zvfh
  def fp_e16_legal = (config.sew === Bits(2)(1)) & (control.fp_wide_float ||| fp_zvfh ||| (control.fp_zvfhmin_e16 & fp_zvfhmin))
  def fp_narrow_float = (fp_widening & (control.fp.result === VectorFloatResult.Integer)) ||| (fp_narrowing & (control.fp.source === VectorFloatSource.Integer))
  def fp_width_change_profile_legal = mux_lookup(config.sew, ~default: Bool(vector_profile_supports_fp64(profile)) ||| fp_narrow_float, [[0, fp_e8_legal], [1, fp_e16_legal]])
  def fp_width_change_legal = fp_reduction ||| !fp_width_change ||| ((config.sew < elen) & (widening_emul <= SInt(5)(3)) & mux(fp_widening, fp_widening_overlap_legal, narrowing_overlap_legal()))
  def fp_move_sources_legal = (vector_scalar_move(control) ||| !control.reads.vs2 ||| source2_aligned) & slide_overlap_legal
  def fp_move_destination_legal = vector_writes_fpr(control) ||| vector_scalar_move(control) ||| (destination_aligned & !(masked & !destination.any()))
  def fp_service_legal = !(fp_widening & fp_narrowing) & (!fp_width_change ||| fp_width_change_profile_legal) & fp_sources_legal & fp_destination_legal & fp_width_change_legal
  def fp_move_legal = fp_move_sources_legal & fp_move_destination_legal & ((control.reads.v0 =/= VectorV0Role.Selector) ||| merge_sources_legal)
  def fp_width_legal = Bool(vector_profile_supports_fp32(profile)) & (fp_e8_legal ||| fp_e16_legal ||| mux(Bool(vector_profile_supports_fp64(profile)), config.sew >= Bits(2)(2), config.sew === Bits(2)(2)))
  def fp_legal = control.floating_point & fp_width_legal & mux(control.fp_service, fp_service_legal, fp_move_legal)


  /* Multiply/divide profile and register legality */

  def multiply_divide_sources_legal = mux(widening, widening_legal, source2_aligned & (!vector_operand ||| source1_aligned))
  def restricted_elen64_multiply = (control.compute_family === VectorComputeFamily.IntProduct) & control.product.select.is_one_of(SimdMultiplySelect.High, SimdMultiplySelect.Fractional)
  def multiply_profile_legal = Bool(vector_profile_is_v(profile)) ||| !((config.sew === Bits(2)(3)) & restricted_elen64_multiply)
  def multiply_divide_legal = control.multiply_divide & multiply_profile_legal & multiply_divide_sources_legal & destination_aligned & !(masked & !destination.any())


  /* Final legality composition
     Whole-register memory bypasses vill; all operations retain the common restart restriction. */

  legal <== start_legal & (whole_register_legal ||| (!config.vill & (integer_legal ||| ordinary_memory_legal ||| mask_memory_legal ||| fp_legal ||| multiply_divide_legal)))

export:
  widens_result
  has_wide_vs2
  extension_shift
  compute_vs2_eew
  compute_dest_eew
  vector_scalar_move
  vector_whole_copy
  vector_reduction
  vector_scan
