#lang rhodium
/* Decodes partial RVV integer, floating-point, and memory controls with register-group
   legality. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../riscv/isa/vector-profile.rhm" open
  "../../../riscv/isa/v.rhm" open
  "../../../riscv/isa/zvbb.rhm" open
  "../../../riscv/isa/vector.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/rtl/vector.rhdl" open
  "../../../riscv/rtl/instruction-fields.rhdl" open
  "../../../riscv/rtl/instruction-pattern.rhdl" open
  "../../../riscv/model/instruction.rhm".InstructionSpec
  "../fp/types.rhdl" open
  "../simd-alu.rhdl" open
  "../simd-multiplier.rhdl".SimdMultiplySelect
  "../multiplier.rhdl".MultiplierMode
  "mask.rhdl" open
  "../../../riscv/rtl/floating-point.rhdl".FloatSignOperation
  lib("hardfloat/main.rhdl").RoundingMode
  lib("hardfloat/main.rhdl").MulAddOperation
  lib("hardfloat/main.rhdl").MinMaxOperation
  lib("hardfloat/main.rhdl").Estimate7Operation
  lib("rhodium/std/decode.rhdl") open

/* Distinguishes vset forms by register/immediate vtype and AVL sources. */
hardware_enum VectorConfigMode:
  None
  VtypeImmediate
  AllImmediate
  VtypeRegister

/* Identifies register permutations and the source and width of gather indices. */
hardware_enum VectorPermutationKind:
  None
  SlideUp
  SlideDown
  SlideOneUp
  SlideOneDown
  GatherBroadcast
  GatherVector
  GatherVectorEI16
  Compress

/* All slide kinds use a displaced VS2 source. */
fun is_register_slide(kind :: VectorPermutationKind) :: Bool:
  kind.is_one_of(VectorPermutationKind.SlideUp, VectorPermutationKind.SlideDown, VectorPermutationKind.SlideOneUp, VectorPermutationKind.SlideOneDown)

/* Upward slides subtract their displacement and forbid destination/source overlap. */
fun slide_moves_up(kind :: VectorPermutationKind) :: Bool:
  kind.is_one_of(VectorPermutationKind.SlideUp, VectorPermutationKind.SlideOneUp)

/* Slide-one inserts a scalar at the boundary and always displaces by one element. */
fun slide_inserts_scalar(kind :: VectorPermutationKind) :: Bool:
  kind.is_one_of(VectorPermutationKind.SlideOneUp, VectorPermutationKind.SlideOneDown)

/* Only indirect gathers fetch index elements from VS1. */
fun gather_uses_vs1(kind :: VectorPermutationKind) :: Bool:
  kind.is_one_of(VectorPermutationKind.GatherVector, VectorPermutationKind.GatherVectorEI16)

/* Selects register gathers independently of their index source. */
fun is_register_gather(kind :: VectorPermutationKind) :: Bool:
  (kind === VectorPermutationKind.GatherBroadcast) ||| gather_uses_vs1(kind)

/* Identifies backend work independently of instruction family, VL, and translation. */
hardware_enum VectorDispatchKind:
  None
  Execute
  Load
  Store

/* Classifies compute work independently of the executing backend and element width. */
hardware_enum VectorComputeFamily:
  IntegerData
  IntProduct
  IntDivide
  FpArithmetic
  FpDivSqrt
  FpData

/* Operand traversal is independent of the functional unit performing the arithmetic. */
hardware_enum VectorSequence:
  Rows
  Reduction
  Scan
  Extract
  Insert
  WholeCopy

/* Which VXSeq cursor traverses a compute instruction. */
hardware_enum VectorComputeCursor:
  Row
  Fold

/* Why a compute instruction needs VPS; indexed memory allocates it separately. */
hardware_enum VectorVpsUse:
  None
  Permutation
  ReductionSeed

/* Neutral element for the non-seed lanes of a packed integer reduction. */
hardware_enum VectorReductionIdentity:
  Zero
  AllOnes
  SignedMax
  SignedMin

/* Architectural compute destination, independent of source layout and traversal. */
hardware_enum VectorResultKind:
  Elements
  Mask
  Gpr
  Fpr

/* Physical packing of source and destination rows consumed by the compute row cursor. */
hardware_enum VectorRowLayout:
  ElementRows
  PackedMaskRows
  ElementsToMask

/* Selects the payload of a fixed-latency data row, independently of its destination enables. */
hardware_enum VectorDataResult:
  Alu
  MaskBits
  CopyVs2
  Permutation

/* Element-width relationships relative to SEW; packed-mask layout is independent. */
hardware_enum VectorWidthShape:
  Same
  Widen
  WidenWideVs2
  Narrow
  Extend2
  Extend4
  Extend8

/* Widening rows produce a double-SEW destination (also the reduction seed EEW). */
fun widens_result(shape :: VectorWidthShape) :~ Bool:
  shape.is_one_of(VectorWidthShape.Widen, VectorWidthShape.WidenWideVs2)

/* Both a .w widening operand and the input to a narrowing operation occupy double SEW. */
fun has_wide_vs2(shape :: VectorWidthShape) :~ Bool:
  shape.is_one_of(VectorWidthShape.WidenWideVs2, VectorWidthShape.Narrow)

/* Log2 of the SEW-to-source ratio for extension instructions; zero otherwise. */
fun extension_shift(shape :: VectorWidthShape) :~ Bits(2):
  mux_lookup(shape, ~default: Bits(2)(0)):
    VectorWidthShape.Extend2: Bits(2)(1)
    VectorWidthShape.Extend4: Bits(2)(2)
    VectorWidthShape.Extend8: Bits(2)(3)

/* Compute VS2 data EEW, before converting row width to a physical fragment. */
fun compute_vs2_eew(shape :: VectorWidthShape, sew :: Bits(2)) :~ Bits(2):
  sew + has_wide_vs2(shape).as_bits().zext(2) - extension_shift(shape)

/* Width of the destination data element; mask packing is selected separately. */
fun compute_dest_eew(shape :: VectorWidthShape, sew :: Bits(2)) :~ Bits(2):
  sew + widens_result(shape).as_bits().zext(2)

/* Selects vector, integer scalar, immediate, or FP scalar operand sourcing. */
hardware_enum VectorOperandMode:
  Vector
  Scalar
  Immediate
  FloatingScalar

/* Selects the extension and number of encoded bits for VI operands. */
hardware_enum VectorImmediateKind:
  Signed5
  Unsigned5
  Unsigned6

/* Distinguishes floating versus integer source interpretation for vector FP conversion. */
hardware_enum VectorFloatSource:
  Floating
  Integer

/* Distinguishes FP, integer, and mask results returned by shared FP execution. */
hardware_enum VectorFloatResult:
  Floating
  Integer
  Mask

/* Selects dynamic, toward-zero, or round-to-odd vector FP conversion rounding. */
hardware_enum VectorFloatRounding:
  Dynamic
  TowardZero
  RoundToOdd

/* Names the first numerical input; the other two positions follow from the same selection. */
hardware_enum VectorFpOperandOrder:
  Vs2First
  RhsFirst
  VdFirst

/* Selects the local lane result and whether an active direct result publishes flags. */
hardware_enum VectorLocalFpResult:
  RawThenRound
  DirectWithFlags
  DirectNoFlags

/* Instruction-owned vector FP controls. Operand placement applies equally to boxed data and its precision tags. */
bundle VectorFpControl():
  execution: FloatExecutionControl()
  local_result: VectorLocalFpResult
  source: VectorFloatSource
  result: VectorFloatResult
  order: VectorFpOperandOrder
  rounding: VectorFloatRounding

  /* Resolve conversion overrides against this instruction's captured architectural rounding mode. */
  method resolve_rounding(fp, frm :: RoundingMode) :: RoundingMode:
    mux_lookup(fp.rounding, ~default: frm, [[VectorFloatRounding.TowardZero, RoundingMode.MinMagnitude], [VectorFloatRounding.RoundToOdd, RoundingMode.Odd]])

  /* Map vs2, the vector/scalar rhs, and old vd to the numerical unit's left, right, and third inputs. */
  method place_operands(fp, T :: DataType, vs2 :: Hardware.of(T), rhs :: Hardware.of(T), old_vd :: Hardware.of(T)):
    def reversed = fp.order === VectorFpOperandOrder.RhsFirst
    def vd_first = fp.order === VectorFpOperandOrder.VdFirst
    values(mux(vd_first, old_vd, mux(reversed, rhs, vs2)), mux(reversed, vs2, rhs), mux(vd_first, vs2, old_vd))

  /* Classifications and comparisons use the integer return port as well as integer conversions. */
  method integer_result(fp) :: Bool: fp.result =/= VectorFloatResult.Floating

  /* Integer-to-float conversions consume unboxed integer input bits. */
  method integer_source(fp) :: Bool: fp.source === VectorFloatSource.Integer

/* Use of the previous destination in an integer product; the RHS is always a factor. */
hardware_enum VectorProductVdRole:
  Unused
  Addend
  Factor

/* Opcode-owned product controls; SEW, VXRM and the widened half come from the issued beat. */
bundle VectorProductControl():
  select: SimdMultiplySelect
  mode: MultiplierMode()
  vd_role: VectorProductVdRole
  subtract: Bool

  /* Return the left factor and retained addend; plain products ignore the addend. */
  method place_operands(product, width :: PosInt, vs2 :: Bits(width), old_vd :: Bits(width)):
    def swap = product.vd_role === VectorProductVdRole.Factor
    values(mux(swap, old_vd, vs2), mux(swap, vs2, old_vd))

/* Both divide operands have the same signedness; the return tag selects quotient or remainder. */
bundle VectorDivideControl():
  signed_mode: Bool
  remainder: Bool

/* Separates unit-stride, strided, and ordered/unordered indexed address generation. */
hardware_enum VectorMemoryAddressing:
  UnitStride
  Strided
  IndexedUnordered
  IndexedOrdered

/* Low register-number bits occupied by an aligned LMUL or EMUL group.
   Fractional groups reside within one architectural register. */
fun vector_register_group_mask(exponent :: Bits(3)) :~ Bits(5):
  mux_lookup(exponent, ~default: Bits(5)(0), [[1, Bits(5)(1)], [2, Bits(5)(3)], [3, Bits(5)(7)]])

/* Distinguishes ordinary, fault-first, whole-register, and mask memory semantics. */
hardware_enum VectorMemoryMode:
  Ordinary
  FaultOnlyFirst
  WholeRegister
  Mask

/* Distinguishes conditional predication from an explicit v0 data operand. */
hardware_enum VectorV0Role:
  Predicate
  Unused
  Carry
  Selector

/* Architectural compute reads, before assigning a register to VXSeq or VPS. */
bundle VectorReadRoles():
  vs2: Bool
  vs1: Bool
  old_vd: Bool
  v0: VectorV0Role

/* Ordinary vm=1 forms skip the predicate tap; explicit v0 data operands do not. */
fun vector_shadow_role(roles :: VectorReadRoles(), masked :: Bool) :~ VectorV0Role:
  mux((roles.v0 === VectorV0Role.Predicate) & !masked, VectorV0Role.Unused, roles.v0)

/* Use catalog operands, not instruction bit positions: unary selectors and
   scalar/immediate splats do not name a vector register. */
fun compute_reads(instruction :: InstructionSpec,
                  ~old_vd: old_vd :: Boolean = #false,
                  ~v0: v0 :: VectorV0Role = VectorV0Role.Predicate):
  def names = instruction.operands.map(fun (operand): operand.name)
  pattern(VectorReadRoles()):
    vs2: Bool(names.contains("vs2"))
    vs1: Bool(names.contains("vs1"))
    old_vd: Bool(old_vd)
    v0: if v0 == VectorV0Role.Predicate && !instruction.encoding_fields.contains(vm) | VectorV0Role.Unused | v0

/* Instruction constants for a DLEN integer data row. SEW, VXRM, masks and row position belong to the issued context. */
bundle VectorIntegerRowControl():
  alu: SimdAluControl()
  swap_operands: Bool
  round_shift: Bool
  clip: Bool
  clip_unsigned: Bool
  invert_logic_result: Bool
  invert_comparison: Bool
  can_saturate: Bool

  /* Place the prepared VS2 and RHS on the ALU inputs for normal or reversed operations. */
  method place_operands(row, width :: PosInt, vs2 :: Bits(width), rhs :: Bits(width)):
    values(mux(row.swap_operands, rhs, vs2), mux(row.swap_operands, vs2, rhs))

/* Carries vector instruction intent for sequencing, operand packing, shared services, and
   runtime legality. */
bundle VectorControl():
  dispatch_kind: VectorDispatchKind
  configure: VectorConfigMode
  integer: Bool
  floating_point: Bool
  fp_service: Bool
  reads_frs1: Bool
  fp_zvfhmin_e16: Bool
  fp_wide_float: Bool
  multiply_divide: Bool
  division: VectorDivideControl()
  left_signed: Bool
  right_signed: Bool
  product: VectorProductControl()
  fp: VectorFpControl()
  compute_family: VectorComputeFamily
  sequence: VectorSequence
  cursor: VectorComputeCursor
  vps: VectorVpsUse
  result_kind: VectorResultKind
  row_layout: VectorRowLayout
  data_result: VectorDataResult
  width_shape: VectorWidthShape
  reads: VectorReadRoles()
  memory: Bool
  store: Bool
  memory_mode: VectorMemoryMode
  memory_data_eew: Bits(2)
  memory_index_eew: Bits(2)
  memory_nf: Bits(3)
  memory_addressing: VectorMemoryAddressing
  operand: VectorOperandMode
  immediate_kind: VectorImmediateKind
  whole_register_count: Bits(4)
  reduction_identity: VectorReductionIdentity
  scan_control: VectorMaskScanControl()
  permutation: VectorPermutationKind
  integer_row: VectorIntegerRowControl()

  /* Memory and arithmetic services keep a tag even if a particular beat is masked or hits. */
  method needs_completion_slot(control) :: Bool:
    control.memory ||| control.fp_service ||| control.multiply_divide


/* Memory and vset leave sequence uncared; neither moves scalar element zero. */
fun vector_scalar_move(c :: VectorControl()) :~ Bool:
  (c.integer ||| c.floating_point) & c.sequence.is_one_of(VectorSequence.Extract, VectorSequence.Insert)

/* Only integer register copies traverse their encoded group independently of VL. */
fun vector_whole_copy(c :: VectorControl()) :~ Bool: c.integer & (c.sequence === VectorSequence.WholeCopy)

/* Integer and floating reductions consume a seed and fold the active elements. */
fun vector_reduction(c :: VectorControl()) :~ Bool: (c.integer ||| c.floating_point) & (c.sequence === VectorSequence.Reduction)

/* Only integer scans define the scan-control modifiers. */
fun vector_scan(c :: VectorControl()) :~ Bool: c.integer & (c.sequence === VectorSequence.Scan)

/* Noncompute rows leave result_kind free; only integer operations can reserve a GPR. */
fun vector_writes_gpr(c :: VectorControl()) :~ Bool: c.integer & (c.result_kind === VectorResultKind.Gpr)

/* Only floating compute can reserve an FPR, never memory or vset. */
fun vector_writes_fpr(c :: VectorControl()) :~ Bool: c.floating_point & (c.result_kind === VectorResultKind.Fpr)

/* Packed mask inputs exist only on integer row operations, never on folds or memory. */
fun vector_packed_mask_rows(c :: VectorControl()) :~ Bool:
  c.integer & (c.cursor === VectorComputeCursor.Row) & (c.row_layout === VectorRowLayout.PackedMaskRows)

/* Qualify the mask destination for consumers shared with noncompute instructions. */
fun vector_writes_mask(c :: VectorControl()) :~ Bool: (c.integer ||| c.floating_point) & (c.result_kind === VectorResultKind.Mask)

/* Project the authored family into direct decoder columns, not RTL comparisons on the family tag.
   Noncompute rows disable all compute consumers and leave the unused family tag unconstrained. */
fun compute_projection(family :: maybe(VectorComputeFamily), operand :: maybe(VectorOperandMode)):
  def fp_arithmetic = [VectorComputeFamily.FpArithmetic, VectorComputeFamily.FpDivSqrt].contains(family)
  def requires_fp = fp_arithmetic || family == VectorComputeFamily.FpData
  partial_pattern(VectorControl()):
    compute_family: if family | family | pattern(VectorComputeFamily, _)
    integer: Bool(family == VectorComputeFamily.IntegerData)
    floating_point: Bool(requires_fp)
    reads_frs1: Bool(requires_fp && operand == VectorOperandMode.FloatingScalar)
    fp_service: Bool(fp_arithmetic)
    multiply_divide: Bool([VectorComputeFamily.IntProduct, VectorComputeFamily.IntDivide].contains(family))

def InactiveCompute = compute_projection(#false, #false)

/* Generate the memory enable and its qualified direction from the same destination as scalar admission. */
fun dispatch_projection(kind :: VectorDispatchKind):
  def memory = [VectorDispatchKind.Load, VectorDispatchKind.Store].contains(kind)
  partial_pattern(VectorControl()):
    dispatch_kind: kind
    memory: Bool(memory)
    store: if memory | Bool(kind == VectorDispatchKind.Store) | pattern(Bool, _)

def NoVectorControl:
  def inactive = partial_pattern(VectorControl()):
    configure: VectorConfigMode.None
  InactiveCompute.intersection(dispatch_projection(VectorDispatchKind.None)).intersection(inactive).terms[0]

/* All FP families require enabled FP state, but only rounding arithmetic consumes frm. */
fun vector_fp_state_illegal(control :: VectorControl(), enabled :: Bool, frm :: Bits(3)) :: Bool:
  control.floating_point & (!enabled ||| (control.fp_service & control.fp.execution.uses_rounding_mode & (frm > Bits(3)(4))))

/* Memory and configuration retain their own controls without acquiring a compute route. */
fun noncompute_case(instruction :: InstructionSpec, kind :: VectorDispatchKind, fields :: Pattern):
  DecodeCase(instruction_pattern(instruction), InactiveCompute.intersection(dispatch_projection(kind)).intersection(fields).terms[0])

/* Builds one vset row without admitting vector compute or memory effects. */
fun config_case(instruction :: InstructionSpec, mode :: VectorConfigMode):
  noncompute_case(
    instruction, VectorDispatchKind.None,
    partial_pattern(VectorControl()):
      permutation: VectorPermutationKind.None
      configure: mode
  )

def VectorConfigurationCases = [
  config_case(VSETVLI, VectorConfigMode.VtypeImmediate),
  config_case(VSETIVLI, VectorConfigMode.AllImmediate),
  config_case(VSETVL, VectorConfigMode.VtypeRegister)
]

/* Add scheduling columns to the same opcode row as its traversal. Memory and vset do not consume them. */
fun compute_case(instruction :: InstructionSpec, family :: VectorComputeFamily, operand :: VectorOperandMode, sequence :: VectorSequence, permutation :: VectorPermutationKind, result :: VectorResultKind, fields :: Pattern):
  def fold = [VectorSequence.Reduction, VectorSequence.Scan, VectorSequence.Extract].contains(sequence)
  def packed_mask = VectorMaskLogicInstructions.contains(instruction)
  def mask_fragment = result == VectorResultKind.Mask && !packed_mask
  def route = partial_pattern(VectorControl()):
    configure: VectorConfigMode.None
    operand: operand
    sequence: sequence
    permutation: permutation
    result_kind: result
    row_layout:
      cond
      | fold: pattern(VectorRowLayout, _)
      | packed_mask: VectorRowLayout.PackedMaskRows
      | mask_fragment: VectorRowLayout.ElementsToMask
      | ~else: VectorRowLayout.ElementRows
    data_result:
      cond
      | fold || ![VectorComputeFamily.IntegerData, VectorComputeFamily.FpData].contains(family): pattern(VectorDataResult, _)
      | sequence == VectorSequence.WholeCopy: VectorDataResult.CopyVs2
      | permutation != VectorPermutationKind.None: VectorDataResult.Permutation
      | mask_fragment: VectorDataResult.MaskBits
      | ~else: VectorDataResult.Alu
    cursor: if fold | VectorComputeCursor.Fold | VectorComputeCursor.Row
    vps:
      cond
      | sequence == VectorSequence.Reduction: VectorVpsUse.ReductionSeed
      | permutation != VectorPermutationKind.None: VectorVpsUse.Permutation
      | ~else: VectorVpsUse.None
  DecodeCase(instruction_pattern(instruction), compute_projection(family, operand).intersection(dispatch_projection(VectorDispatchKind.Execute)).intersection(route).intersection(fields).terms[0])

/* Builds partial packed-integer controls and derives operand/immediate form. Keep scan,
   slide, clipping, and mask modifiers free outside their consumers; both widening and
   narrowing use the signed operand-preparation controls. */
fun integer_case(instruction :: InstructionSpec, alu :: Pattern,
                 ~result: result :: VectorResultKind = VectorResultKind.Elements,
                 ~v0: v0 :: VectorV0Role = VectorV0Role.Predicate,
                 ~sequence: sequence :: VectorSequence = VectorSequence.Rows,
                 ~whole_register_count: whole_register_count :: PosInt = 1,
                 ~reduction_identity: identity :: VectorReductionIdentity = VectorReductionIdentity.Zero,
                 ~scan_control: scan_control :: Pattern = pattern(VectorMaskScanControl(), _),
                 ~permutation: permutation :: VectorPermutationKind = VectorPermutationKind.None,
                 ~shape: shape :: VectorWidthShape = VectorWidthShape.Same,
                 ~round_shift: round_shift :: Boolean = #false,
                 ~clip: clip :: Boolean = #false,
                 ~clip_unsigned: clip_unsigned :: Boolean = #false,
                 ~left_signed: left_signed :: Boolean = #false,
                 ~right_signed: right_signed :: Boolean = #false,

                 ~invert_logic: invert_logic :: Boolean = #false,
                 ~invert: invert :: Boolean = #false,
                 ~swap: swap :: Boolean = #false):
  def form = instruction.format
  /* Match authored ALU modes at elaboration; wildcard adder bits on a logic
     instruction are not permission to update the architectural saturation flag. */
  fun adder_mode(mode :: SimdArithmeticMode):
    def match_mode = partial_pattern(SimdAluControl()):
      result_select: SimdResultSelect.Adder
      arithmetic_mode: mode
    match_mode.subsumes(alu)
  def logic = partial_pattern(SimdAluControl()):
    result_select: SimdResultSelect.Logic
  def shifts = partial_pattern(SimdAluControl()):
    result_select: SimdResultSelect.Shift
  def adds = partial_pattern(SimdAluControl()):
    result_select: SimdResultSelect.Adder
  def widening = [VectorWidthShape.Widen, VectorWidthShape.WidenWideVs2].contains(shape)
  def narrowing = shape == VectorWidthShape.Narrow
  def extension = [VectorWidthShape.Extend2, VectorWidthShape.Extend4, VectorWidthShape.Extend8].contains(shape)
  def scan = sequence == VectorSequence.Scan
  def operand:
    cond
    | [VectorVVFormat, VectorFixedVVFormat, VectorMoveVFormat, VectorWholeRegisterMoveFormat, VectorReadScalarFormat, VectorMaskScalarFormat, VectorMaskUnaryFormat, VectorIndexFormat].contains(form): VectorOperandMode.Vector
    | [VectorVXFormat, VectorFixedVXFormat, VectorMoveXFormat].contains(form): VectorOperandMode.Scalar
    | ~else: VectorOperandMode.Immediate
  compute_case(
    instruction, VectorComputeFamily.IntegerData, operand, sequence, permutation, result,
    partial_pattern(VectorControl()):
      immediate_kind: if !form.immediate | pattern(VectorImmediateKind, _) | (if form.immediate.width == 6 | VectorImmediateKind.Unsigned6 | (if form.immediate.signed | VectorImmediateKind.Signed5 | VectorImmediateKind.Unsigned5))
      width_shape: shape
      reads: compute_reads(instruction, ~v0: v0)
      whole_register_count: if sequence == VectorSequence.WholeCopy | Bits(4)(whole_register_count) | pattern(Bits(4), _)
      reduction_identity: if sequence == VectorSequence.Reduction | identity | pattern(VectorReductionIdentity, _)
      left_signed: if widening || narrowing || extension | Bool(left_signed) | pattern(Bool, _)
      right_signed: if widening || narrowing | Bool(right_signed) | pattern(Bool, _)
      scan_control: scan_control

      integer_row:
        partial_pattern(VectorIntegerRowControl()):
          alu: alu
          swap_operands: Bool(swap)
          round_shift: if shifts.subsumes(alu) || adds.subsumes(alu) | Bool(round_shift) | pattern(Bool, _)
          clip: Bool(clip)
          clip_unsigned: if clip | Bool(clip_unsigned) | pattern(Bool, _)
          can_saturate: Bool(clip || adder_mode(SimdArithmeticMode.SaturateSigned) || adder_mode(SimdArithmeticMode.SaturateUnsigned))
          invert_logic_result: if logic.subsumes(alu) | Bool(invert_logic) | pattern(Bool, _)
          invert_comparison: if result == VectorResultKind.Mask && (!VectorMaskLogicInstructions.contains(instruction)) && (!scan) | Bool(invert) | pattern(Bool, _)
  )

def vadd_control = partial_pattern(SimdAluControl()):
  result_select: SimdResultSelect.Adder
  arithmetic_mode: SimdArithmeticMode.Wrap
  subtract: Bool(#false)

def vsub_control = partial_pattern(SimdAluControl()):
  result_select: SimdResultSelect.Adder
  arithmetic_mode: SimdArithmeticMode.Wrap
  subtract: Bool(#true)

def vcarry_control = partial_pattern(SimdAluControl()):
  result_select: SimdResultSelect.Adder
  arithmetic_mode: SimdArithmeticMode.Wrap
  mask_result_select: SimdMaskResultSelect.CarryBorrow
  subtract: Bool(#false)

def vborrow_control = partial_pattern(SimdAluControl()):
  result_select: SimdResultSelect.Adder
  arithmetic_mode: SimdArithmeticMode.Wrap
  mask_result_select: SimdMaskResultSelect.CarryBorrow
  subtract: Bool(#true)

def vextension_control = partial_pattern(SimdAluControl()):
  result_select: SimdResultSelect.Select

def vsaddu_control = partial_pattern(SimdAluControl()):
  result_select: SimdResultSelect.Adder
  arithmetic_mode: SimdArithmeticMode.SaturateUnsigned
  subtract: Bool(#false)

def vsadd_control = partial_pattern(SimdAluControl()):
  result_select: SimdResultSelect.Adder
  arithmetic_mode: SimdArithmeticMode.SaturateSigned
  subtract: Bool(#false)

def vssubu_control = partial_pattern(SimdAluControl()):
  result_select: SimdResultSelect.Adder
  arithmetic_mode: SimdArithmeticMode.SaturateUnsigned
  subtract: Bool(#true)

def vssub_control = partial_pattern(SimdAluControl()):
  result_select: SimdResultSelect.Adder
  arithmetic_mode: SimdArithmeticMode.SaturateSigned
  subtract: Bool(#true)

def vaaddu_control = partial_pattern(SimdAluControl()):
  result_select: SimdResultSelect.Adder
  arithmetic_mode: SimdArithmeticMode.AverageUnsigned
  subtract: Bool(#false)

def vaadd_control = partial_pattern(SimdAluControl()):
  result_select: SimdResultSelect.Adder
  arithmetic_mode: SimdArithmeticMode.AverageSigned
  subtract: Bool(#false)

def vasubu_control = partial_pattern(SimdAluControl()):
  result_select: SimdResultSelect.Adder
  arithmetic_mode: SimdArithmeticMode.AverageUnsigned
  subtract: Bool(#true)

def vasub_control = partial_pattern(SimdAluControl()):
  result_select: SimdResultSelect.Adder
  arithmetic_mode: SimdArithmeticMode.AverageSigned
  subtract: Bool(#true)

def vand_control = partial_pattern(SimdAluControl()):
  result_select: SimdResultSelect.Logic
  logic_select: SimdLogicSelect.And
  invert_right: Bool(#false)

def vandn_control = partial_pattern(SimdAluControl()):
  result_select: SimdResultSelect.Logic
  logic_select: SimdLogicSelect.And
  invert_right: Bool(#true)

def vor_control = partial_pattern(SimdAluControl()):
  result_select: SimdResultSelect.Logic
