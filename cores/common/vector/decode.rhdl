/* Integer compares schedule data-width source rows and pack one bit per lane. */
fun compare_case(instruction :: InstructionSpec, alu :: Pattern, ~invert: invert :: Boolean = #false, ~swap: swap :: Boolean = #false):
  integer_case(instruction, alu, ~result: VectorResultKind.Mask, ~invert: invert, ~swap: swap)

