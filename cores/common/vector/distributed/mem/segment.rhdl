#lang rhodium
/* Maps interleaved memory beats to field-row fragments without buffering a register group. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../common/row-types.rhdl" open
  "../common/memory-command.rhdl" open
  "../../geometry.rhdl" open
  "../../backend-kind.rhm" open
  lib("flow/main.rhdl").Valid
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/vector.rhm").VectorLength
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/reduction.rhdl").tree_reduce

def MaxFields = 8
def MaxBeats = MaxFields * DistributedRowsPerRegister

/* Elaborate constant wiring for the small set of segment shapes; no run-time division. */
fun by_shape(dlen :: PosInt, layout :: SegmentLayout(), build :: Function.of_arity(2)):
  def counts = for List (n in 1..(MaxFields+1)):
    def widths = for List (e in 0..math.min(4, bits.length(dlen div 8))): [e, build(n, 2 ** e)]
    [n-1, mux_lookup(layout.eew, ~default: widths[0][1], widths)]
  mux_lookup(layout.nf, ~default: counts[0][1], counts)

/* Position in an interleaved group at the beginning of one logical memory beat. */
bundle SegmentPosition(element_bits :: PosInt):
  group: Bits(index_width(MaxBeats))
  ends_group: Bool
  first_field: Bits(3)
  first_element: Bits(element_bits)
  last_ordinal: Bits(3)

/* Each group of N beats covers one row of every field. A beat touches each
   participating field once, starting at first_field and wrapping at N. */
fun segment_position(dlen :: PosInt, layout :: SegmentLayout(), stream :: Bits(RowAddress.packed_width())) :~ SegmentPosition(index_width(dlen div 8)):
  /* Generate the constant positions for one field count and EEW. */
  fun positions(n :: PosInt, bytes :: PosInt):
    def lanes = dlen div (8*bytes)
    def positions = for List (beat in 0..MaxBeats):
      def slot = (beat mod n)*lanes
      SegmentPosition(index_width(dlen div 8)):
        group: Bits(index_width(MaxBeats))(beat div n)
        ends_group: Bool(beat mod n == n-1)
        first_field: Bits(3)(slot mod n)
        first_element: Bits(index_width(dlen div 8))(slot div n)
        last_ordinal: Bits(3)(math.min(n, lanes)-1)
    vec(positions)[stream[0..index_width(MaxBeats)]]
  by_shape(dlen, layout, positions)

/* Convert visit order into a field number and its starting element in the physical row. */
fun segment_visit(dlen :: PosInt, layout :: SegmentLayout(), pos :: SegmentPosition(index_width(dlen div 8)), ordinal :: Bits(3)):
  def sum = pos.first_field.zext(4) + ordinal.zext(4)
  def wrap = sum > layout.nf.zext(4)
  def field = mux(wrap, sum - layout.nf.zext(4) - Bits(4)(1), sum)[0..3]
  values(field, pos.first_element + wrap.as_bits().zext(index_width(dlen div 8)))

/* Compute the physical base of a field from EMUL register spacing. */
fun segment_base(layout :: SegmentLayout(), field :: Bits(3)) :~ Bits(RowAddress.packed_width()):
  layout.base + ((field.zext(RowAddress.packed_width()) << layout.spacing) << index_width(DistributedRowsPerRegister))

/* Pack or unpack one field using the same strided lane wiring in opposite directions. */
fun segment_fragment(dlen :: PosInt, layout :: SegmentLayout(), data :: Bits(dlen), ordinal :: Bits(3), element :: Bits(index_width(dlen div 8)), ~pack: pack :: Boolean) :~ Bits(dlen):
  def memory_shift = (ordinal.zext(index_width(dlen)) << layout.eew) << 3
  def field_shift = (element.zext(index_width(dlen)) << layout.eew) << 3
  def aligned = data >> (if pack | field_shift | memory_shift)
  /* Connect every Nth element to its contiguous position in the field row. */
  fun route(n :: PosInt, bytes :: PosInt):
    def T = Bits(8*bytes)
    def lanes = aligned.as_vec(T)
    def count = dlen div (8*bytes)
    def parts = for List (i in 0..count):
      if pack
      | (if i mod n == 0 | lanes[i div n] | T(0))
      | (if i*n < count | lanes[i*n] | T(0))
    vec(parts).as_bits()
  by_shape(dlen, layout, route) << (if pack | memory_shift | field_shift)

/* A store need not wait for a source when none of this field's memory lanes
   are enabled. Test only byte strobes; never introduce a data-path dependency. */
fun segment_field_enabled(dlen :: PosInt, layout :: SegmentLayout(), mask :: Bits(dlen div 8), ordinal :: Bits(3)) :~ Bool:
  /* Byte strobes at every Nth element, relative to the first occurrence. */
  fun stripes(n :: PosInt, size :: PosInt):
    def lanes = dlen div (8*size)
    expand_mask(vec(for List (i in 0..lanes): Bool(i mod n == 0)).as_bits(), size)
  def shift = ordinal.zext(index_width(dlen div 8)+1) << layout.eew
  ((mask >> shift) & by_shape(dlen, layout, stripes)).any()

/* Repeat each v0 bit over every field of its element; index using the logical
   stream beat, not the displaced physical cache address. */
fun segment_predicate(dlen :: PosInt, layout :: SegmentLayout(), stream :: Bits(RowAddress.packed_width()), pred :: Bits(dlen)) :~ Bits(dlen div 8):
  def bytes = dlen div 8
  /* Select the predicate slice for this beat within its field group. */
  fun repeated(n :: PosInt, size :: PosInt):
    def lanes = bytes div size
    def expanded = expand_mask(pred[0..lanes], n*size)
    def phases = expanded.as_vec(Bits(bytes))
    def phase = vec(for List (i in 0..MaxBeats): Bits(3)(i mod n))[stream[0..index_width(MaxBeats)]]
    if n == 1 | phases[0] | phases[phase[0..index_width(n)]]
  by_shape(dlen, layout, repeated)

/* Track metadata, not data: a physical field row remains claimed while any of
   its contributing beats is live. A mask skip and an older VRF grant may
   discharge different obligations on the same edge. */
sync_circuit VectorSegmentClaims(xlen :: XLen, vlen :: VectorLength):
  def dlen = vector_dlen(vlen)
  def Beats = Bits(MaxBeats)
  interface install(Valid(MemoryCommand(xlen, vlen)), ~role: consumer)
  input consumed: Bool
  input field: Bits(3)
  input stream: RowAddress
  input skip: Bool
  input skipped_stream: RowAddress
  output claims: RowSet
  def incoming = install.bits.layout
  reg layout(SegmentLayout())
  when (install.valid): layout <== incoming
  def stream_span = memory_command_span(xlen, vlen, install.bits)
  def range = vector_span_cover(vlen, stream_span, dlen div 8, MaxBeats, Bits(index_width(MaxBeats))(0))
  def skipped = mux(skip, Beats(1) << skipped_stream, Beats(0))
  reg pending(~init: literal(Vec(MaxFields, Beats), 0))
  def rows = for List (f in 0..MaxFields):
    /* Only beats containing this field can create a row obligation. */
    fun presence(n :: PosInt, bytes :: PosInt):
      def lanes = dlen div (8*bytes)
      vec(for List (i in 0..MaxBeats): Bool(f < n && ((f - i*lanes) mod n) < lanes)).as_bits()
    def present = by_shape(dlen, incoming, presence)
    def accepted = mux(consumed & (field === Bits(3)(f)), Beats(1) << stream, Beats(0))
    pending[f] <== mux(install.valid, present & range, pending[f] & !(skipped ||| accepted))
    def counts = for List (n in 2..(MaxFields+1)):
      [n-1, vec(for List (i in 0..((MaxBeats+n-1) div n)): pending[f][i*n..math.min((i+1)*n,MaxBeats)].any()).as_bits().zext(MaxBeats)]
    def groups = mux_lookup(layout.nf, ~default: pending[f], counts)
    groups.zext(PhysicalRows) << segment_base(layout, Bits(3)(f))
  claims <== tree_reduce(rows, fun (a,b): a ||| b)

export segment_position segment_visit segment_base segment_fragment segment_field_enabled segment_predicate VectorSegmentClaims
