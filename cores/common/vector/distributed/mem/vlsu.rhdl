#lang rhodium
/* Issues certified physical rows from independent load/store cursors over one ordered L1D port. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/common/mmu/vector.rhdl") open
  "../common/paths.rhm" open
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/vector.rhm").VectorLength
  "../../backend-kind.rhm".vector_dlen
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open
  "../../bundles.rhdl".VectorRowMemory
  "../../bundles.rhdl".VectorRowRequest
  "../common/row-types.rhdl" open
  "beat-packer.rhdl".VectorBeatPacker
  "load-return.rhdl".VectorLoadReturn
  "instruction-queue.rhdl" open
  "../common/memory-command.rhdl" open
  "../../register-file.rhdl".VectorRegisterWrite
  "../common/memory-route.rhdl" open


/* The VLIQ and VSIQ independently allocate instructions, install address
   cursors, and discharge physical obligations on ordered replies. */
sync_circuit VectorVLSU(xlen :: XLen, vlen :: VectorLength, slots :: Pow2Int, ~trace_isa: trace_isa :: maybe(String) = #false):
  def dlen = vector_dlen(vlen)
  def isa = trace_isa || (if xlen == XLen.X32 | "rv32imafdcv" | "rv64imafdcv")
  def row_bytes = dlen div 8
  def Owner = Bits(index_width(slots))
  def Credit = RowCredit(xlen, vlen, Owner)
  input oldest_owner: Owner
  input trace_instructions: Vec(slots, VectorTraceInstruction(xlen))
  interface enqueue[MemoryPaths.length()](Decoupled(MemoryLaunch(xlen, vlen, slots)), ~role: consumer)
  interface checked_element(Decoupled(CheckedIndexElement(xlen, vlen)), ~role: consumer)
  input(stream_live, stream_store): Bool
  interface scatter(ScatterOperand(dlen), ~role: issuer)
  interface indices(Decoupled(Bits(dlen)), ~role: consumer)
  interface masks(Decoupled(OwnedRow(PreparedBeat(vlen), Owner)), ~role: consumer)
  interface store_data(Decoupled(OwnedRow(PreparedRow(vlen), Owner)), ~role: consumer)
  interface load_result(Decoupled(VectorRegisterWrite(dlen, vlen)), ~role: producer)
  interface load_setup(Valid(LoadReturnSetup(dlen)), ~role: consumer)
  interface load_visit(Valid(SegmentFieldVisit()), ~role: producer)
  interface element_loaded(Valid(Owner), ~role: producer)
  interface splat(Decoupled(SplatPosition(dlen)), ~role: consumer)
  interface loaded(Valid(ReturnedRow(xlen, vlen, Owner)), ~role: producer)
  interface memory(VectorRowMemory(dlen), ~role: requester)
  interface issued(Valid(MemoryEvent(slots)), ~role: producer)
  interface delivered(Valid(MemoryEvent(slots)), ~role: producer)
  interface stored(Valid(ReturnedRow(xlen, vlen, Owner)), ~role: producer)
  output resident: Vec(MemoryPaths.length(), Bool)
  inst load_return(VectorLoadReturn(xlen, vlen, Owner))
  input drain_owner: Owner
  load_return.drain_owner <== drain_owner
  load_setup |> load_return.setup
  splat |> load_return.splat
  load_return.result |> load_result
  load_return.visit |> load_visit
  load_return.element_drained |> element_loaded
  def load_credits = load_return.credits
  output returns_pending: Bool
  returns_pending <== load_return.head_pending
  reg occupied(~init: Bits(MemoryPaths.length())(0).as_vec(Bool))
  reg sequencing(~init: Bits(MemoryPaths.length())(0).as_vec(Bool))
  reg owners(Vec(MemoryPaths.length(), Owner))
  reg addresses(Vec(MemoryPaths.length(), Bits(xlen.width)))
  reg kinds(Vec(MemoryPaths.length(), MemoryIssueKind))
  reg steps(Vec(MemoryPaths.length(), Bits(xlen.width)))
  reg services(Vec(MemoryPaths.length(), VectorMemoryService))
  reg eews(Vec(MemoryPaths.length(), Bits(2)))
  def streaming = vec(for List (i in MemoryPaths): kinds[i] === MemoryIssueKind.ResolvedStream)
  reg suffix(~init: Bits(MemoryPaths.length())(0).as_vec(Bool))
  // Admitted fragments touch at most two adjacent virtual pages; VPN bit 0 distinguishes them.
  reg first_page_parity(Vec(MemoryPaths.length(), Bits(1)))
  reg spans(Vec(MemoryPaths.length(), RowFootprint()))
  def older_store = (owners[StorePath] - oldest_owner) < (owners[LoadPath] - oldest_owner)
  def RequestCount = Bits(index_width(MemoryRequestEntries + 1))
  reg awaiting(~init: literal(Vec(MemoryPaths.length(), RequestCount), 0))
  reg independent_load(Bool)
  inst vliq(VectorMemoryInstructions(xlen, vlen, slots, ~store: #false))
  inst vsiq(VectorMemoryInstructions(xlen, vlen, slots, ~store: #true))
  def queues = for InstanceArray (q in [vliq, vsiq]): q
  def start :: Array.later_of(Endpoint) = for Array (i in MemoryPaths): queues[i].issue
  for (i in MemoryPaths):
    enqueue[i] |> queues[i].enqueue
    def peer = queues[1 - i]
    queues[i].peer_live <== peer.live_mask
    queues[i].peer_spans <== peer.spans
    queues[i].peer_release <== peer.release_mask
  resident <== vec(for List (i in MemoryPaths): queues[i].live_mask.any())
  output room: Vec(2, Bool)
  room <== vec(for List (i in MemoryPaths): queues[i].room)
  interface scalar_probe(Valid(RowFootprint()), ~role: consumer)
  output scalar_conflict: Bool
  def conflicts = for List (path in MemoryPaths):
    def q = queues[path]
    (Bool(path == StorePath) ||| scalar_probe.bits.store) & any(for List (i in 0..2): q.live_mask.as_vec(Bool)[i] & (!scalar_probe.valid ||| physical_overlap(xlen, scalar_probe.bits, q.spans[i])))
  scalar_conflict <== any(conflicts)
  def first_rows = for List (i in MemoryPaths):
    def launch = start[i]
    def command = launch.bits.issue.command
    def kind = launch.bits.issue.kind
    def by_element = kind =/= MemoryIssueKind.Contiguous
    def footprint = physical_span(xlen, vlen, slots, launch.bits)
    def stream = kind === MemoryIssueKind.ResolvedStream
    def reuse = stream & streaming[i] & !sequencing[i] & (launch.bits.issue.owner === owners[i])
    launch.ready <== !occupied[i] ||| reuse
    when (launch.fire()):
      kinds[i] <== kind
      services[i] <== launch.bits.service
      eews[i] <== command.layout.eew
      steps[i] <== mux_lookup(kind, ~default: Bits(xlen.width)(0), [[MemoryIssueKind.Stride, command.stride], [MemoryIssueKind.Contiguous, Bits(xlen.width)(row_bytes)]])
      owners[i] <== launch.bits.issue.owner
      first_page_parity[i] <== command.address[VectorPageOffsetBits]
      spans[i] <== footprint
    mux(by_element, command.address, command.address.align_down(row_bytes))
  def load_start = start[LoadPath]
  when (load_start.fire()):
    def issue = load_start.bits.issue
    independent_load <== (issue.kind === MemoryIssueKind.Contiguous) & (load_start.bits.service === VectorMemoryService.Cached) & !issue.command.masked & !issue.command.layout.nf.any()
  assert(!(enqueue[LoadPath].fire() & enqueue[StorePath].fire()), "one_ordered_vector_memory_allocation")
  /* Match prepared operands to their authorized cursor. Only ordered indexed
     elements wait for a reply here; unordered elements share the beat credits. */
  fun admitted_rows(source :: Endpoint, path :: Nat) :~ Endpoint:
    def index_ready = !inline_index_issue(kinds[path]) ||| indices.valid
    def order_ready = !kinds[path].is_one_of(MemoryIssueKind.InlineOrderedIndex, MemoryIssueKind.ResolvedOrderedIndex) ||| !awaiting[path].any()
    source |> gate_flow(index_ready & order_ready & sequencing[path] & (source.bits.owner === owners[path])) |> map_flow(r => r.payload)
  inst store_merger(VectorBeatPacker(vlen, ~store: #true))
  def StoreLane = Bits(index_width(row_bytes))
  reg store_displacement(StoreLane)
  when (start[StorePath].fire()):
    store_displacement <== start[StorePath].bits.issue.command.displacement

  store_merger.eew <== eews[StorePath]
  store_merger.elementwise <== kinds[StorePath] =/= MemoryIssueKind.Contiguous
  store_merger.displacement <== store_displacement
  /* The two ingress slots hold captured VS3 data even before address launch.
     A returning read already owns one slot. Only promise its successor space
     if the FIFO is empty or the merger removes its head on this edge. */
  inst store_buffer(Queue(OwnedRow(PreparedRow(vlen), Owner), 2))
  store_data |> store_buffer.ingress
  admitted_rows(store_buffer.egress, StorePath) |> store_merger.source
  output store_room_after_capture: Bool
  store_room_after_capture <== !store_buffer.count.any() ||| store_buffer.egress.fire()
  output store_data_pending: Bool
  store_data_pending <== store_buffer.egress.valid
  inst load_metadata(Queue(Credit, MemoryRequestEntries))
  /* Acknowledgements carry their original owner after SAS advances. */
  bundle StoreAck():
    owner: Owner
    element_end: Bool
  inst store_acks(Queue(StoreAck(), MemoryStoreAckEntries))
  def oldest_load = independent_load & (owners[LoadPath] === oldest_owner)
  def load_room = load_metadata.ingress.ready & (oldest_load ||| (load_credits < MemoryPendingCount(MemoryRowCredits)))
  // Same-page elements replace the current address and operand lane, not its
  // translation or owner. Split beats hold both fields until their suffix fires.
  reg gathered(~init: Bool(#false))
  reg operand_row(RowAddress)
  reg operand_offset(Bits(index_width(vlen+1)))
  def normal_load = admitted_rows(masks, LoadPath)
  def gathering = gathered & sequencing[LoadPath]
  def path = stream_store.as_bits()
  def scattering = stream_live & stream_store & sequencing[StorePath]
  scatter.demand.valid <== scattering
  scatter.demand.bits <== operand_row
  def byte_count = Bits(index_width(row_bytes)+1)(1) << eews[path]
  def element_beat = PreparedBeat(vlen):
    row: operand_row
    offset: operand_offset
    enabled: !Bits(row_bytes)(0) >> (Bits(index_width(row_bytes)+1)(row_bytes) - byte_count)
    data: mux(stream_store, scatter.operand.bits >> (operand_offset[0..index_width(row_bytes)] ++ Bits(3)(0)), Bits(dlen)(0))
    continues: Bool(#false)
    last: Bool(#true)
  def gather_offer = inject_interface(Valid(PreparedBeat(vlen)), ~valid: gathering, ~bits: element_beat)
  def selected_load = grant_merge(vec([!gathering, gathering]).into(MaybeOneHot(2)),
                                  Array(normal_load, gather_offer |> offer_decoupled()))
  // Every eligible load already has an installed address cursor. Join its
  // provenance with the selected mask/element without adding a readiness gate.
  def load_origin = inject_interface(Valid(Bool), ~valid: Bool(#true), ~bits: Bool(#true))
  def admitted_load = Array(selected_load, load_origin |> offer_decoupled()) |> zip_flow(beat, _origin => beat)
  def load_rows = admitted_load |> gate_flow(load_room ||| !admitted_load.bits.enabled.any())
  def scatter_beat = scatter.operand |> map_valid(_data => element_beat) |> offer_decoupled()
  def admitted_store = grant_merge(vec([!scattering, scattering]).into(MaybeOneHot(2)),
                                   Array(store_merger.beat, scatter_beat))
  def store_rows = admitted_store |> gate_flow(store_acks.ingress.ready ||| !admitted_store.bits.enabled.any())
  // Prefer the older eligible cursor. Never replace a stalled offer.
  reg locked(~init: Bool(#false))
  reg locked_store(Bool)
  def store = mux(locked, locked_store, store_rows.valid & (older_store ||| !load_rows.valid))
  def selected = store.as_bits()
  def grants = vec([!store, store]).into(MaybeOneHot(2))
  def prepared = grant_merge(grants, Array(load_rows, store_rows))
  // VS2 advances one byte per element; the data cursor advances by SEW.
  def lane = (prepared.bits.offset >> eews[selected])[0..index_width(row_bytes)]
  def byte_index = indices.bits.as_vec(Bits(8))[lane]
  def inline_index = inline_index_issue(kinds[selected])
  def checked = resolved_issue(kinds[selected])
  def cursor = addresses[selected] + mux(inline_index, byte_index.zext(xlen.width), Bits(xlen.width)(0))
  def first_lane = cursor[0..index_width(row_bytes)]
  def second = suffix[selected]
  def cut = Bits(index_width(row_bytes)+1)(row_bytes) - first_lane.zext(index_width(row_bytes)+1)
  def spill = prepared.bits.enabled >> cut
  def prefix = (checked ||| inline_index) & !second & spill.any()
  def address = cursor.align_down(row_bytes) + mux(second, Bits(xlen.width)(row_bytes), Bits(xlen.width)(0))
  def memory_lane = mux(second, StoreLane(0), first_lane)
  def enabled = mux(second, spill, prepared.bits.enabled << first_lane)
  def payload = mux(second, prepared.bits.data >> (cut ++ Bits(3)(0)), prepared.bits.data << (first_lane ++ Bits(3)(0)))
  def span = spans[selected]
  def ppn = mux(address[VectorPageOffsetBits] === first_page_parity[selected], span.pages[0], span.pages[1])
  def physical = (ppn ++ address[0..VectorPageOffsetBits]).zext(64)
  // Each physical fragment has a separate grant and credit. Keep the logical
  // element at the packer until its final fragment (or mask skip) transfers.
  def fragments = interface_link(Decoupled(PreparedBeat(vlen)))
  fragments.left.valid <== prepared.valid
  fragments.left.bits <== prepared.bits
  prepared.ready <== fragments.left.ready & !prefix
  // Both fragments use the offered element. Only elementwise paths split
  // here, so both grants inherit the same operand while ready holds it.
  describe_interface_contract(prepared, fragments.left, "physical-fragment", ~trace_model: interface_trace_combinational())
  def Array(empty, live) = fragments.right |> demux_flow(2, r => r.enabled.any())
  empty.ready <== Bool(#true)
  // Arbitration already reserved the selected tracker's capacity, so AGEN
  // stall events still denote only backpressure from the physical memory port.
  def physical_request = live |> map_flow(_r => VectorRowRequest(dlen)):
    service: services[selected]
    element_width: eews[selected]
    address: physical
    store: store
    byte_mask: enabled
    data: payload

  // The VLSU has already chosen and locked the issuing cursor. Split the
  // observation by that grant, then rejoin without arbitration or storage.
  def offers = physical_request |> demux_flow(2, req => req.store)
  def traced_offers = for Array (i in MemoryPaths):
    def identity = trace_instructions[owners[i]]
    def label = if i == LoadPath | "vector/load.agen" | "vector/store.agen"
    offers[i] |> trace_event(label, ~stalls: #true, ~fields: req):
      pc: identity.pc
      instruction(~format: "riscv", ~isa: isa, ~pc: "pc"): identity.instruction
      owner(~format: "unsigned"): owners[i]
      row(~format: "unsigned"): prepared.bits.row
      cursor: cursor
      va: address
      pa: req.address
      byte_mask: req.byte_mask
      split_suffix: second
  def Array(request, metadata) = grant_merge(grants, traced_offers) |> atomic_fork(2)
  request |> memory.request

  def issue_context = RowCredit(xlen, vlen, Owner):
    owner: owners[selected]
    singleton: checked
    row: prepared.bits.row
    offset: prepared.bits.offset + mux(second, cut.zext(index_width(vlen+1)), Bits(index_width(vlen+1))(0))
    memory_lane: memory_lane
    enabled: enabled
    continues: prepared.bits.continues ||| prefix
    element_end: streaming[selected] & prepared.bits.last & !prefix
    va: address
    pa: physical

  def Array(load_issue, store_issue) = metadata |> demux_flow(2, req => req.store)
  load_issue |> map_flow(_r => issue_context) |> load_metadata.ingress
  (store_issue |> map_flow(_r => StoreAck()):
     owner: issue_context.owner
     element_end: issue_context.element_end
  ) |> store_acks.ingress
  def Array(load_reply, store_reply) = memory.response |> demux_flow(2, reply => reply.store)
  def load = Array(load_reply, load_metadata.egress) |> zip_flow(reply, ctx):
    ReturnedRow(xlen, vlen, Owner):
      credit: ctx
      data: reply.data
  def ack = Array(store_reply, store_acks.egress) |> zip_flow(_reply, element_end => element_end)
  (load |> trace_event("vector/load.return", ~stalls: #true, ~fields: reply):
     pc: trace_instructions[reply.credit.owner].pc
     instruction(~format: "riscv", ~isa: isa, ~pc: "pc"): trace_instructions[reply.credit.owner].instruction
     owner(~format: "unsigned"): reply.credit.owner
     row(~format: "unsigned"): reply.credit.row
     offset(~format: "unsigned"): reply.credit.offset
     pa: reply.credit.pa
     byte_mask: reply.credit.enabled
  ) |> load_return.returned
  loaded.valid <== load.fire()
  loaded.bits <== load.bits
  ack.ready <== Bool(#true)
  when (prepared.valid):
    locked <== !fragments.left.ready
    locked_store <== store
  def accepted = memory.request.fire()
  load_return.reserve <== accepted & !store
  load_return.issue_owner <== owners[LoadPath]
  indices.ready <== prepared.fire() & inline_index & ((lane === !StoreLane(0)) ||| prepared.bits.last)
  def tail = prepared.fire() & prepared.bits.last
  checked_element.ready <== occupied[path] & streaming[path] & (!sequencing[path] ||| (tail & (store === stream_store)))
  def replace_element = checked_element.fire() ||| start[LoadPath].fire()
  def capture_gather = checked_element.fire() & !stream_store
  when replace_element: gathered <== capture_gather
  // A split or stalled gather keeps the checked element that installed it.
  // Same-edge replacement takes effect after the outgoing fragment transfers.
  describe_interface_retained_storage(capture_gather, gathered & replace_element, gathered, ~name: "gather")
  describe_interface_contract(checked_element, gather_offer, "gather", ~trace_model: interface_trace_retained(~name: "gather"))
  def store_start = start[StorePath]
  def command = store_start.bits.issue.command
  def initial_offset = command.data.begin
  when (checked_element.fire()):
    operand_row <== checked_element.bits.row
    operand_offset <== checked_element.bits.offset
  elsewhen (store_start.fire() & (store_start.bits.issue.kind === MemoryIssueKind.ResolvedStream)):
    operand_row <== command.layout.base + initial_offset[index_width(row_bytes)..index_width(vlen+1)].zext(RowAddress.packed_width())
    operand_offset <== initial_offset[0..index_width(vlen+1)]
  issued.valid <== tail
  issued.bits <== MemoryEvent(slots):
    owner: owners[selected]
    checked: resolved_issue(kinds[selected])
  stored.valid <== accepted & store
  stored.bits <== ReturnedRow(xlen, vlen, Owner):
    credit: issue_context
    data: payload

  def first_done :: Endpoint = queues[LoadPath].done
  def second_done :: Endpoint = queues[StorePath].done
  first_done.ready <== Bool(#true)
  second_done.ready <== !first_done.valid
  delivered.valid <== first_done.valid ||| second_done.valid
  delivered.bits <== mux(first_done.valid, first_done.bits, second_done.bits)
  output store_delivered: Bool
  store_delivered <== second_done.fire() & !((second_done.bits.owner === owners[StorePath]) & streaming[StorePath])
  interface element_stored(Valid(Owner), ~role: producer)
  element_stored.valid <== ack.fire() & ack.bits.element_end
  element_stored.bits <== ack.bits.owner
  for (i in MemoryPaths):
    def launching = start[i].fire()
    def chosen = selected === Bits(1)(i)
    def q = queues[i]
    def delivering = mux(resolved_issue(kinds[i]), q.done.fire() & (q.done.bits.owner === owners[i]), tail & chosen)
    q.cursor_owner <== owners[i]
    q.last <== tail & chosen
    q.continuation <== checked_element.fire() & (stream_store === Bool(i == StorePath))
    q.stream_live <== stream_live & (stream_store === Bool(i == StorePath))
    q.response_owner <== if i == LoadPath | load.bits.credit.owner | ack.bits.owner
    def issuing = accepted & chosen
    def returning = if i == LoadPath | load.fire() | ack.fire()
    q.request <== issuing
    q.response <== returning
    // A fragment belongs to the installed address cursor even if it uses a
    // checked element rather than a prepared row. Scatter uses that same owner
    // to demand VS3; the store AGEN itself keeps the packer's data lineage.
    def name = if i == LoadPath | "load-cursor" | "scatter-cursor"
    // A checked stream may install its next cursor before older replies drain.
    describe_interface_retained_storage(launching, delivering ||| (launching & occupied[i]), occupied[i], ~name: name)
    describe_interface_contract(start[i], if i == LoadPath | load_origin | scatter.demand,
                                name, ~trace_model: interface_trace_retained(~name: name))
    when issuing: suffix[i] <== prefix
    when (launching ||| delivering): occupied[i] <== launching
    def replacing = (stream_store === Bool(i == StorePath)) & checked_element.fire()
    when (launching ||| replacing ||| (tail & chosen)): sequencing[i] <== launching ||| replacing
    when launching: addresses[i] <== first_rows[i]
    elsewhen replacing: addresses[i] <== checked_element.bits.address
    elsewhen (prepared.fire() & chosen): addresses[i] <== addresses[i] + steps[i]
    when (issuing =/= returning): awaiting[i] <== mux(issuing, awaiting[i] + RequestCount(1), awaiting[i] - RequestCount(1))

export VectorVLSU
