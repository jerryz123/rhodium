#lang rhodium
/* Traverses active rows and captures predicate bits for the load and store sequencers. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/vector.rhm").VectorLength
  "../../backend-kind.rhm".vector_dlen
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open
  "../common/row-claims.rhdl" open
  "../common/row-types.rhdl" open
  "../common/memory-command.rhdl" open
  "../mem/segment.rhdl" open

hardware_enum RowPhase:
  Idle
  PrepareMask
  ReadSource
  DrainFields
  Offer

/* Single-field stores pipeline predicate sampling and issue; other paths use a separate mask phase. */
fun first_phase(masked :: Bool, store :: Bool, segmented :: Bool) :~ RowPhase:
  mux(masked & (!store ||| segmented), RowPhase.PrepareMask, mux(store, RowPhase.ReadSource, RowPhase.Offer))

/* Traverses the active row span. Load geometry feeds the ordered issuer;
   store geometry feeds a reserved FIFO slot directly on VS3 return or mask
   skip. Neither sequencer waits for a cache response to advance. */
sync_circuit VectorMemoryRowSequencer(xlen :: XLen, vlen :: VectorLength, ~store: store_path :: Boolean):
  def dlen = vector_dlen(vlen)
  def row_bytes = dlen div 8
  def lane_bits = index_width(row_bytes)
  def mask_bits = index_width(dlen)
  def offset_bits = index_width(vlen + 1)
  interface launch(Valid(MemoryCommand(xlen, vlen)), ~role: consumer)
  input older_writes: RowSet
  input(capacity, room_after_capture, singleton): Bool
  output captured: Bool
  output captured_field: Bits(3)
  output read_done: RowSet
  output predicate_done: PredicateSet
  interface read(Decoupled(RowAddress), ~role: producer)
  interface read_result(Valid(Bits(dlen)), ~role: consumer)
  interface mask(VectorPredicateTap(dlen), ~role: reader)
  interface prepared(Decoupled(PreparedRow(vlen)), ~role: producer)

  reg phase(~init: RowPhase.Idle)
  def store = Bool(store_path)
  reg masked(Bool)
  reg layout(SegmentLayout())
  def plain_store = store & !layout.nf.any()
  def eew = layout.eew
  reg ordinal(Bits(3))
  reg captured_mask(Bits(row_bytes))
  reg row(RowAddress)
  reg offset(Bits(offset_bits))
  reg last_row_offset(Bits(offset_bits - lane_bits))
  reg head(Bits(row_bytes))
  reg tail(Bits(row_bytes))
  def last = offset[lane_bits..offset_bits] === last_row_offset
  def range_mask = head & mux(last, tail, !Bits(row_bytes)(0))
  def stream = (offset >> lane_bits)[0..RowAddress.packed_width()]
  def pos = segment_position(dlen, layout, stream)
  def next_pos = segment_position(dlen, layout, stream + RowAddress(1))
  def group_start = pos.group.zext(mask_bits+1) << (Bits(4)(lane_bits) - eew.zext(4))
  def predicate_row = group_start[mask_bits..mask_bits+1]
  def busy = older_writes.as_vec(Bool)
  def predicate_safe = !busy[predicate_row.zext(RowAddress.packed_width())]
  def sample = capacity & (phase === RowPhase.PrepareMask) & predicate_safe
  def values(field, element) = segment_visit(dlen, layout, pos, ordinal)
  def enabled = mux(masked, captured_mask, range_mask)
  def field_live = if store_path | segment_field_enabled(dlen, layout, enabled, ordinal) | Bool(#false)
  // The return owns the current beat until it transfers, independently of
  // whether the VRF grants the successor's first field on the same edge.
  reg field_pending(~init: Bool(#false))
  reg issued_skip(Bool)
  reg issued_ordinal(Bits(3))
  reg issued_field(Bits(3))
  reg issued_element(Bits(lane_bits))
  def field_return = field_pending & (issued_skip ||| read_result.valid)
  def at_boundary = phase === RowPhase.DrainFields
  def final_return = field_return & at_boundary
  // A nonempty unmasked successor starts at byte zero, even on a partial tail.
  // The outgoing beat owns today's ingress slot; the next needs its own credit.
  def handoff = final_return & !last & !masked & capacity & room_after_capture
  def issue_field = mux(at_boundary, next_pos.first_field, field)
  def issue_group = mux(at_boundary, next_pos.group, pos.group)
  def physical = segment_base(layout, issue_field) + issue_group.zext(RowAddress.packed_width())
  def visit = store & layout.nf.any() & capacity & (phase === RowPhase.ReadSource) & (!field_pending ||| field_return)
  def skip_field = visit & !field_live
  /* Issue one row decision into a reserved VLSU slot. A skip uses the same
     return stage as a synchronous read: it cannot overtake a live row or
     compete with its response. Only metadata crosses the clock edge. */
  reg pending(~init: Bool(#false))
  reg issued_row(RowAddress)
  reg issued_offset(Bits(offset_bits))
  reg issued_span(Bits(row_bytes))
  reg issued_last(Bool)
  def row_return = pending & (!captured_mask.any() ||| read_result.valid)
  reg mask_valid(~init: Bool(#false))
  reg issue_predicate(Bits(row_bytes))
  def eligible = plain_store & (phase === RowPhase.ReadSource) & capacity & (!pending ||| (row_return & room_after_capture)) & (!masked ||| mask_valid)
  def issue_mask = mux(masked, issue_predicate, range_mask)
  def read_address = mux(plain_store, row, physical)
  read.valid <== ((eligible & issue_mask.any()) ||| (visit & field_live) ||| handoff) & !busy[read_address]
  read.bits <== read_address
  def handoff_grant = handoff & read.fire()
  def field_issue = skip_field ||| (visit & read.fire()) ||| handoff_grant
  when (field_issue ||| field_return): field_pending <== field_issue
  when field_issue:
    issued_skip <== skip_field
    issued_ordinal <== mux(at_boundary, Bits(3)(0), ordinal)
    issued_field <== issue_field
    issued_element <== mux(at_boundary, next_pos.first_element, element)
  def skip = eligible & !issue_mask.any()
  def decided = (plain_store & read.fire()) ||| skip
  /* Register the forwarded v0 slice before it gates VRF arbitration. On issue,
     refill that metadata slot from the following row, including across v0 rows.
     A sampled mask alone reserves neither a VS3 read nor a VLSU data slot. */
  def next_offset = offset + Bits(offset_bits)(row_bytes)
  def next_start = next_pos.group.zext(mask_bits+1) << (Bits(4)(lane_bits) - eew.zext(4))
  def next_last = next_offset[lane_bits..offset_bits] === last_row_offset
  def lookahead = masked & decided & !last
  def sample_start = mux(lookahead, next_start, group_start)
  def sample_row = sample_start[mask_bits..mask_bits+1]
  def sample_range = mux(lookahead, mux(next_last, tail, !Bits(row_bytes)(0)), range_mask)
  def predicate = sample_range & segment_predicate(dlen, layout, mux(lookahead, stream + RowAddress(1), stream), mask.data >> sample_start[0..mask_bits])
  def fill_mask = plain_store & masked & (phase === RowPhase.ReadSource) & (!mask_valid ||| lookahead) & !busy[sample_row.zext(RowAddress.packed_width())]
  def sampled = sample ||| fill_mask
  mask.sample.bits <== sample_row
  mask.sample.valid <== sampled
  when (fill_mask ||| decided): mask_valid <== fill_mask
  when fill_mask: issue_predicate <== predicate
  when (decided ||| row_return): pending <== decided
  when decided:
    issued_row <== row
    issued_offset <== offset
    issued_span <== range_mask
    issued_last <== last
    captured_mask <== issue_mask
  elsewhen sample: captured_mask <== predicate
  // Segmented stores can offer an empty beat at mask capture. VLSeq and
  // single-field stores only offer rows with registered predicate metadata.
  def skip_store = if store_path | sample & !predicate.any() | Bool(#false)
  def offer = phase === RowPhase.Offer
  prepared.valid <== if store_path | mux(plain_store, row_return, offer ||| final_return ||| skip_store) | offer
  prepared.bits <== PreparedRow(vlen):
    row: mux(plain_store, issued_row, row)
    offset: mux(plain_store, issued_offset, offset)
    span: mux(plain_store, issued_span, range_mask)
    enabled: mux(plain_store, captured_mask, mux(skip_store, Bits(row_bytes)(0), enabled))
    data:
      if store_path
      | block:
          reg assembly(Bits(dlen))
          def part = segment_fragment(dlen, layout, read_result.bits, issued_ordinal, issued_element, ~pack: #true)
          def joined = mux(issued_ordinal.any(), assembly, Bits(dlen)(0)) ||| mux(issued_skip, Bits(dlen)(0), part)
          when (field_return & !final_return): assembly <== joined
          mux(layout.nf.any(), joined, read_result.bits)
      | Bits(dlen)(0)
    last: mux(plain_store, issued_last, last)

  def command = launch.bits
  // Both sequencers sample v0 in logical element order before packing beats.
  def incoming = command.layout
  def stream_span = memory_command_span(xlen, vlen, command)
  def start = stream_span.begin[0..offset_bits]
  // Only iterative checker slices arrive with a checked address and exactly
  // one active element. Other commands still start their packer at lane 0.
  def end = stream_span.end[0..offset_bits] - Bits(offset_bits)(1)
  def needs_source = store & predicate.any()
  // A group begins on a predicate boundary only when enough whole groups
  // have elapsed. Retire v0 at the last beat of that predicate row.
  def after_next = next_start + (Bits(mask_bits+1)(row_bytes) >> eew)
  def final_mask_use = mux(lookahead, next_last ||| (after_next[mask_bits..mask_bits+1] =/= sample_row), last ||| (next_start[mask_bits..mask_bits+1] =/= sample_row))
  predicate_done <== (sampled & final_mask_use).as_bits().zext(PredicateSet.packed_width()) << sample_row
  captured <== field_return
  captured_field <== issued_field
  // A captured empty predicate proves VS3 is unused even before its ordered skip enters the VLSU.
  def unused_source = row_event(fill_mask & !predicate.any(), mux(lookahead, row + RowAddress(1), row))
  read_done <== row_event(plain_store & read_result.valid, issued_row) ||| unused_source
  when (launch.valid):
    phase <== first_phase(command.masked, store, incoming.nf.any())
    masked <== command.masked
    layout <== incoming
    ordinal <== Bits(3)(0)
    head <== !Bits(row_bytes)(0) << start[0..lane_bits]
    tail <== !Bits(row_bytes)(0) >> (!end[0..lane_bits])
    row <== mux(incoming.nf.any(), RowAddress(0), incoming.base) + start[lane_bits..offset_bits].zext(RowAddress.packed_width())
    offset <== mux(singleton, start, start.align_down(row_bytes))
    last_row_offset <== end[lane_bits..offset_bits]
  elsewhen (decided ||| (!plain_store & prepared.fire())):
    ordinal <== handoff_grant.as_bits().zext(3)
    phase <== mux(handoff_grant & !next_pos.last_ordinal.any(), RowPhase.DrainFields,
                  mux(last, RowPhase.Idle, first_phase(masked, store, layout.nf.any())))
    head <== !Bits(row_bytes)(0)
    row <== row + RowAddress(1)
    offset <== next_offset
  elsewhen sample:
    phase <== mux(needs_source, RowPhase.ReadSource, RowPhase.Offer)
  elsewhen field_issue:
    ordinal <== ordinal + Bits(3)(1)
    when (ordinal === pos.last_ordinal): phase <== RowPhase.DrainFields
  when (read_result.valid): assert(mux(plain_store, pending & captured_mask.any() & prepared.ready, field_pending & !issued_skip), "store_read_has_reserved_row")
  when final_return: assert(prepared.ready, "store_segment_has_reserved_ingress")
  when row_return: assert(prepared.ready, "store_row_decision_has_reserved_ingress")
  when skip_store: assert(prepared.ready, "store_skip_has_reserved_row")

export VectorMemoryRowSequencer
