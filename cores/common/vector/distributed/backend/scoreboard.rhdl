#lang rhodium
/* Combines age-ordered memory, execute and checked claims for the distributed issue paths. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../common/paths.rhm" open
  "../../backend-kind.rhm".DistributedRowsPerRegister
  "../common/row-types.rhdl" open
  "../../bundles.rhdl" open
  "../../dependencies.rhdl" open
  "../common/row-claims.rhdl" open
  lib("rhodium/std/reduction.rhdl").tree_reduce
  "../../../../../riscv/isa/xlen.rhm" open
  "../../../../../riscv/isa/vector.rhm" open
  lib("rhodium/std/bits.rhdl").Pow2Int
  lib("rhodium/std/bits.rhdl").expand_mask
  lib("flow/main.rhdl") open

/* Orders memory and execute heads by distance from the instruction reclamation frontier. */
sync_circuit DistributedVectorScoreboard(xlen :: XLen, vlen :: VectorLength, vector_completion_slots :: Pow2Int):
  def tag_width = index_width(vector_completion_slots)
  interface request(Valid(VectorDescriptor(xlen)), ~role: consumer)
  input(next_owner, drain_owner): Bits(tag_width)
  input(macro_valid, macro_store, macro_load, macro_issued): Vec(vector_completion_slots, Bool)
  input macro_groups: Vec(vector_completion_slots, RegisterSet)
  def requested_control = request.bits.control
  input(allocation_native, allocation_precise, allocation_empty): Bool
  input head_owner: Vec(DispatchPaths.length(), Bits(tag_width))
  input head_issued: Vec(DispatchPaths.length(), Bool)
  output head_allowed: Vec(DispatchPaths.length(), Bool)
  reg readers(Vec(vector_completion_slots, RegisterSet))
  reg queued(Vec(vector_completion_slots, Bool))
  reg native(Vec(vector_completion_slots, Bool))
  reg precise(Vec(vector_completion_slots, Bool))
  // Checked accesses serialize issue until their fault disposition is known.
  output checked_live: Bool
  checked_live <== (macro_valid.as_bits() & !native.as_bits()).any()
  def source_group = vector_reader_registers(xlen, vlen, request.bits)
  for (i in 0..vector_completion_slots):
    def tag = Bits(tag_width)(i)
    when (request.valid & (next_owner === tag)):
      readers[i] <== mux(allocation_empty, RegisterSet(0), source_group)
      queued[i] <== !allocation_empty & requested_control.memory & !allocation_native
      native[i] <== allocation_native
      precise[i] <== allocation_precise
    elsewhen (any(for List (h in DispatchPaths): head_issued[h] & (head_owner[h] === tag))):
      queued[i] <== Bool(#false)

  interface special_reads(VectorSpecialReadChain(Bits(tag_width)), ~role: scoreboard)
  interface mem_chain(VectorLoadChain(Bits(tag_width)), ~role: scoreboard)
  interface store_reads(VectorStoreReadChain(Bits(tag_width)), ~role: scoreboard)
  interface alu_chain(VectorExecuteChain(Bits(tag_width)), ~role: scoreboard)
  def queued_store_reads = mux(store_reads.waiting, readers[store_reads.waiting_owner], RegisterSet(0))
  def unread_store = store_reads.unread_vs3 ||| store_reads.unread_v0.zext(PhysicalRows)
  /* Compare ages from the reclamation frontier; owner tags can wrap. */
  fun older_than(candidate :: Bits(tag_width), owner :: Bits(tag_width)) :~ Bool:
    (candidate - drain_owner) < (owner - drain_owner)

  /* Readers wait for writes; writers also wait for unread sources and v0. */
  fun hazards(c :: NativeRowClaims(), writing :: Boolean) :~ Bits(PhysicalRows):
    if writing | c.writes ||| c.reads ||| c.predicates.zext(RowSet.packed_width()) | c.writes

  /* Grants move claims between producers on a clock edge. Consult registered
     reports only, including writes from instructions no longer in VXSeq. */
  fun older_native(owner :: Bits(tag_width), writing :: Boolean) :~ Bits(PhysicalRows):
    def load_rows = if writing | mem_chain.unwritten_vd ||| mem_chain.unread_v0.zext(PhysicalRows) | mem_chain.unwritten_vd
    def drain_rows = if writing | mem_chain.draining_vd ||| mem_chain.draining_v0.zext(PhysicalRows) | mem_chain.draining_vd
    def load = mux(older_than(mem_chain.owner, owner), load_rows, RowSet(0)) ||| mux(older_than(mem_chain.write_owner, owner), drain_rows, RowSet(0))
    def store = if writing | mux(older_than(store_reads.owner, owner), unread_store, RowSet(0)) | RowSet(0)
    def queued_store = if writing | mux(older_than(store_reads.waiting_owner, owner), expand_mask(queued_store_reads, DistributedRowsPerRegister), RowSet(0)) | RowSet(0)
    def unissued = mux(older_than(alu_chain.owner, owner), hazards(alu_chain.unissued, writing), RowSet(0))
    def writes = for List (i in 0..ProductWriteDelay):
      def d = alu_chain.destinations[i]
      row_event(alu_chain.reserved[i].into(Bool) & older_than(d.owner, owner), d.row)
    def special = if writing | mux(older_than(special_reads.owner, owner), special_reads.unread, RowSet(0)) | RowSet(0)
    def returning = for List (p in [alu_chain.integer_pending, alu_chain.fp_pending]):
      row_event(p.valid & older_than(p.bits.owner, owner), p.bits.row)
    tree_reduce([load, store, queued_store, special, unissued] ++ returning ++ writes, fun (a, b): a ||| b)

  /* Memory operand capture precedes address admission. Include older checked
     destinations as whole-register hazards when VLSeq or VSSeq reads the VRF. */
  fun capture_hazards(owner :: Bits(tag_width)) :~ Bits(PhysicalRows):
    def checked = for List (i in 0..vector_completion_slots):
      def older_writer = macro_valid[i] & !native[i] & !macro_store[i] & older_than(Bits(tag_width)(i), owner)
      mux(older_writer, macro_groups[i], RegisterSet(0))
    older_native(owner, #false) ||| expand_mask(tree_reduce(checked, fun (a, b): a ||| b), DistributedRowsPerRegister)
  special_reads.older_writes <== capture_hazards(special_reads.owner)
  store_reads.older_writes <== capture_hazards(store_reads.owner)
  mem_chain.older_writes <== capture_hazards(mem_chain.read_owner)
  mem_chain.older_accesses <== older_native(mem_chain.write_owner, #true)
  alu_chain.older_writes <== older_native(alu_chain.owner, #false)
  alu_chain.older_accesses <== older_native(alu_chain.owner, #true)

  def writers = vec(for List (i in 0..vector_completion_slots): mux(macro_store[i], RegisterSet(0), macro_groups[i]))
  /* Once installed, each cursor reports its own live reads. Do not re-claim a
     captured VPS seed or index just because VXSeq still has a source to read. */
  fun register_cover(rows :: Bits(PhysicalRows)) :~ Bits(RegisterSet.packed_width()):
    vec(for List (r in 0..RegisterSet.packed_width()): rows.as_vec(Bits(DistributedRowsPerRegister))[r].any()).as_bits()
  def store_registers = register_cover(unread_store)
  def special_registers = register_cover(special_reads.unread)
  def execute_registers = register_cover(alu_chain.unissued.reads ||| alu_chain.unissued.predicates.zext(PhysicalRows))
  def unread = for List (i in 0..vector_completion_slots):
    def store = mux(store_reads.owner === Bits(tag_width)(i), store_registers, RegisterSet(0))
    def tag = Bits(tag_width)(i)
    def live = priority_mux(~default: mux(alu_chain.owner === tag, execute_registers, RegisterSet(0))):
      !native[i]: readers[i]
      macro_store[i]: store ||| mux(store_reads.waiting_owner === tag, queued_store_reads, RegisterSet(0))
      macro_load[i]: (((mem_chain.owner === tag) & mem_chain.unread_v0.any()) ||| ((mem_chain.write_owner === tag) & mem_chain.draining_v0.any())).as_bits().zext(RegisterSet.packed_width())
    mux(special_reads.owner === tag, special_registers, RegisterSet(0)) ||| live
  def allowed = for List (h in DispatchPaths):
    def head = head_owner[h]
    def head_writes = writers[head]
    def head_uses = readers[head] ||| head_writes
    def conflicts = for List (i in 0..vector_completion_slots):
      def older = older_than(Bits(tag_width)(i), head)
      def register_conflict = (writers[i] & head_uses).any() ||| (unread[i] & head_writes).any()
      // Direct accesses have already reserved their physical footprints in
      // program order. Only an unresolved head needs the coarse memory fence.
      def memory_order = Bool(h != ExecutePath) & !native[head] & (macro_load[i] ||| macro_store[i]) & !macro_issued[i]
      // Only checked heads contend for the fault checker.
      def sequence_order = queued[i] & !native[i] & !native[head]
      macro_valid[i] & older & ((register_conflict & !(native[i] & native[head])) ||| memory_order ||| sequence_order ||| precise[i])
    !any(conflicts)
  head_allowed <== vec(allowed)

export DistributedVectorScoreboard
