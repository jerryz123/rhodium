#lang rhodium
/* Prepares load masks and commits returned rows to the VRF under scoreboard control. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/vector.rhm").VectorLength
  "../../backend-kind.rhm".vector_dlen
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open
  "../common/row-claims.rhdl" open
  "../common/row-types.rhdl" open
  "../common/memory-route.rhdl" open
  "../common/memory-command.rhdl" open
  "../mem/segment.rhdl" open
  "memory-row.rhdl".VectorMemoryRowSequencer
  "../mem/beat-packer.rhdl".VectorBeatPacker
  "../../register-file.rhdl".VectorRegisterWrite

/* VLSeq retains row claims and consumes enabled VLSU fragments only on the VRF grant. */
sync_circuit VectorLoadSequencer(xlen :: XLen, vlen :: VectorLength, slots :: Pow2Int):
  def dlen = vector_dlen(vlen)
  def Owner = Bits(index_width(slots))
  interface prepare(Decoupled(MemoryIssue(xlen, vlen, slots)), ~role: consumer)
  interface rows(Decoupled(OwnedRow(PreparedBeat(vlen), Owner)), ~role: producer)
  interface result(Decoupled(VectorRegisterWrite(dlen, vlen)), ~role: consumer)
  interface return_setup(Valid(LoadReturnSetup(dlen)), ~role: producer)
  interface visit(Valid(SegmentFieldVisit()), ~role: consumer)
  interface write(Decoupled(VectorRegisterWrite(dlen, vlen)), ~role: producer)
  interface mask(VectorPredicateTap(dlen), ~role: reader)
  interface chain(VectorLoadChain(Owner), ~role: engine)
  interface finished(Decoupled(MemoryEvent(slots)), ~role: producer)
  output busy: Bool
  input returns_pending: Bool
  input gather_live: Bool
  def singleton = resolved_issue(prepare.bits.kind)
  interface gather_row(Valid(RowAddress), ~role: consumer)
  reg active(~init: Bool(#false))
  reg closed(~init: Bool(#false))
  reg owner(Owner)
  reg checked(Bool)
  reg streaming(Bool)
  inst operands(VectorMemoryRowSequencer(xlen, vlen, ~store: #false))
  def command = prepare.bits.command
  def values(data_rows, predicate_rows) = memory_command_rows(xlen, vlen, command)
  def unordered_slice = prepare.bits.kind === MemoryIssueKind.ResolvedStream
  def reuse = streaming & unordered_slice & closed & (prepare.bits.owner === owner)
  prepare |> gate_flow(!active ||| reuse) |> map_flow(entry => entry.command) |> to_valid() |> operands.launch
  def lane_bits = index_width(dlen div 8)
  reg displacement(Bits(lane_bits))
  reg elementwise(Bool)
  reg eew(Bits(2))
  inst packer(VectorBeatPacker(vlen, ~store: #false))
  packer.elementwise <== elementwise
  packer.eew <== eew
  packer.displacement <== displacement
  operands.prepared |> packer.source
  (packer.beat |> map_flow(r => OwnedRow(PreparedBeat(vlen), Owner)):
     owner: owner
     payload: r
  ) |> rows
  operands.mask <=> mask
  chain.owner <== owner
  operands.older_writes <== chain.older_writes
  operands.singleton <== singleton
  operands.capacity <== Bool(#true)
  operands.room_after_capture <== Bool(#false)
  operands.read.ready <== Bool(#false)
  operands.read_result.valid <== Bool(#false)
  operands.read_result.bits <== dont_care(Bits(dlen))

  return_setup.valid <== prepare.fire()
  return_setup.bits <== LoadReturnSetup(dlen):
    layout: command.layout
    displacement: command.displacement
    elementwise: prepare.bits.kind =/= MemoryIssueKind.Contiguous
    seed: command.seed
    seed_lane: command.data.begin[0..lane_bits]

  reg segmented(Bool)
  def safe = !chain.older_accesses.as_vec(Bool)[result.bits.address]
  result |> gate_flow(safe) |> write
  chain.write_owner <== owner
  reg unread_v0(~init: PredicateSet(0))
  reg unwritten_vd(~init: RowSet(0))
  def row = operands.prepared
  def skipped = row_event(row.fire() & !row.bits.enabled.any(), row.bits.row)
  def written = row_event(write.fire(), write.bits.address)
  chain.unread_v0 <== unread_v0
  inst segments(VectorSegmentClaims(xlen, vlen))
  segments.install.valid <== prepare.fire()
  segments.install.bits <== command
  visit |> segments.visit
  segments.skip.valid <== row.fire() & !row.bits.enabled.any()
  segments.skip.bits <== row.bits.row
  def outstanding = mux(segmented, segments.claims, unwritten_vd)
  chain.unwritten_vd <== mux(active, outstanding, RowSet(0))
  when (prepare.fire()):
    streaming <== unordered_slice
    eew <== command.layout.eew
    elementwise <== prepare.bits.kind =/= MemoryIssueKind.Contiguous
    owner <== prepare.bits.owner
    checked <== singleton
    segmented <== command.layout.nf.any()
    displacement <== command.displacement
  unread_v0 <== mux(prepare.fire(), predicate_rows, unread_v0 & !operands.predicate_done)
  // The checker owns the oldest macro exclusively. Hold the union of its
  // admitted destinations until drain; adjacent slices can write the same row.
  when (prepare.fire()): unwritten_vd <== data_rows ||| mux(active & reuse, unwritten_vd, RowSet(0))
  elsewhen (gather_row.valid): unwritten_vd <== unwritten_vd ||| row_event(Bool(#true), gather_row.bits)
  elsewhen (!streaming): unwritten_vd <== unwritten_vd & !(skipped ||| written)
  busy <== active

  def stream_idle = streaming & closed & !returns_pending & !gather_live
  finished.valid <== !streaming & closed & !returns_pending & !outstanding.any()
  finished.bits <== MemoryEvent(slots):
    owner: owner
    checked: checked
  when (prepare.fire() ||| finished.fire() ||| stream_idle): active <== prepare.fire()
  when (prepare.fire() ||| finished.fire() ||| stream_idle): closed <== Bool(#false)
  elsewhen (rows.fire() & rows.bits.payload.last): closed <== Bool(#true)

export VectorLoadSequencer
