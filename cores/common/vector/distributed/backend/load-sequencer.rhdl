#lang rhodium
/* Prepares load masks and commits returned rows to the VRF under scoreboard control. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/vector.rhm").VectorLength
  "../../backend-kind.rhm".vector_dlen
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open
  "../common/row-claims.rhdl" open
  "../common/row-types.rhdl" open
  "../common/memory-route.rhdl" open
  "../common/memory-command.rhdl" open
  "../mem/segment.rhdl" open
  "memory-row.rhdl".VectorMemoryRowSequencer
  "../mem/beat-packer.rhdl".VectorBeatPacker
  "../../register-file.rhdl".VectorRegisterWrite

/* VLSeq retains row claims and consumes enabled VLSU fragments only on the VRF grant. */
sync_circuit VectorLoadSequencer(xlen :: XLen, vlen :: VectorLength, slots :: Pow2Int):
  def dlen = vector_dlen(vlen)
  def Owner = Bits(index_width(slots))
  interface input_work(Decoupled(MemoryIssue(xlen, vlen, slots)), ~role: consumer)
  def prepare = input_work |> map_flow(entry => operand_work(xlen, vlen, slots, entry))
  interface rows(Decoupled(OwnedRow(PreparedBeat(vlen), Owner)), ~role: producer)
  interface result(Decoupled(VectorRegisterWrite(dlen, vlen)), ~role: consumer)
  interface return_setup(Valid(LoadReturnSetup(dlen)), ~role: producer)
  interface visit(Valid(SegmentFieldVisit()), ~role: consumer)
  interface write(Decoupled(VectorRegisterWrite(dlen, vlen)), ~role: producer)
  interface mask(VectorPredicateTap(dlen), ~role: reader)
  interface chain(VectorLoadChain(Owner), ~role: engine)
  interface finished(Decoupled(MemoryEvent(slots)), ~role: producer)
  output busy: Bool
  input returns_pending: Bool
  input gather_live: Bool
  interface gather_row(Valid(RowAddress), ~role: consumer)
  reg current(MemoryOperandWork(xlen, vlen, slots))
  reg active(~init: Bool(#false))
  reg issued(~init: Bool(#false))
  def checked = resolved_issue(current.kind)
  def stream = current.kind === MemoryIssueKind.ResolvedStream
  def reuse = active & stream & issued & (prepare.bits.kind === MemoryIssueKind.ResolvedStream) & (prepare.bits.owner === current.owner)
  output room: Bool
  room <== !active
  prepare.ready <== room ||| reuse
  def push = prepare.fire()
  busy <== active
  def start = observe_transfer(prepare)
  def independent = autonomous_rows(prepare.bits.kind, prepare.bits.masked, prepare.bits.layout.nf)
  inst operands(VectorMemoryRowSequencer(xlen, vlen, ~store: #false))
  inst packer(VectorBeatPacker(vlen, ~store: #false))
  def command = operand_geometry(xlen, vlen, slots, current)
  packer.eew <== command.layout.eew
  packer.elementwise <== current.kind =/= MemoryIssueKind.Contiguous
  packer.displacement <== command.displacement
  operands.prepared |> packer.source
  (packer.beat |> map_flow(r => OwnedRow(PreparedBeat(vlen), Owner)):
     owner: current.owner
     payload: r
  ) |> rows
  def last = rows.fire() & rows.bits.payload.last
  (start |> filter_valid(_entry => !independent) |> map_valid(entry => operand_geometry(xlen, vlen, slots, entry))) |> operands.launch
  operands.singleton <== resolved_issue(start.bits.kind)
  operands.mask <=> mask
  operands.older_writes <== chain.older_writes
  operands.capacity <== Bool(#true)
  operands.room_after_capture <== Bool(#false)
  operands.read.ready <== Bool(#false)
  operands.read_result.valid <== Bool(#false)
  operands.read_result.bits <== dont_care(Bits(dlen))

  def format = operand_geometry(xlen, vlen, slots, current)
  return_setup.valid <== push
  return_setup.bits <== LoadReturnSetup(dlen):
    layout: format.layout
    displacement: format.displacement
    elementwise: current.kind =/= MemoryIssueKind.Contiguous
    seed: format.seed
    seed_lane: format.data.begin[0..index_width(dlen div 8)]

  def safe = !chain.older_accesses.as_vec(Bool)[result.bits.address]
  result |> gate_flow(safe) |> write
  chain.owner <== current.owner
  reg predicates(PredicateSet)
  reg unwritten(RowSet)
  def values(data_rows, predicate_rows) = memory_command_rows(xlen, vlen, operand_geometry(xlen, vlen, slots, prepare.bits))
  def row = operands.prepared
  def skip = row.fire() & !row.bits.enabled.any()
  inst segments(VectorSegmentClaims(xlen, vlen))
  segments.install.valid <== push
  segments.install.bits <== operand_geometry(xlen, vlen, slots, prepare.bits)
  visit |> segments.visit
  segments.skip.valid <== skip
  segments.skip.bits <== row.bits.row
  when push: current <== prepare.bits
  predicates <== mux(push, predicate_rows, predicates & !operands.predicate_done)
  when push: unwritten <== data_rows ||| mux(reuse, unwritten, RowSet(0))
  elsewhen (gather_row.valid): unwritten <== unwritten ||| row_event(Bool(#true), gather_row.bits)
  elsewhen (!stream): unwritten <== unwritten & !(row_event(skip, row.bits.row) ||| row_event(write.fire(), write.bits.address))
  chain.unwritten_vd <== mux(active, mux(current.layout.nf.any(), segments.claims, unwritten), RowSet(0))
  chain.unread_v0 <== mux(active, predicates, PredicateSet(0))
  def complete = active & issued & !returns_pending
  finished.valid <== complete & !stream & !chain.unwritten_vd.any()
  finished.bits <== MemoryEvent(slots):
    owner: current.owner
    checked: checked
  def pop = finished.fire() ||| (complete & stream & !gather_live & !(push & reuse))
  when (push ||| pop): active <== push
  when push: issued <== independent
  elsewhen last: issued <== Bool(#true)

export VectorLoadSequencer
