#lang rhodium
/* Sequences store operands and hands captured rows to reserved VLSU ingress slots. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/vector.rhm").VectorLength
  "../../backend-kind.rhm".vector_dlen
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open
  "../common/row-claims.rhdl" open
  "../common/row-types.rhdl" open
  "../common/memory-route.rhdl" open
  "../common/memory-command.rhdl" open
  "../mem/segment.rhdl" open
  "memory-row.rhdl".VectorMemoryRowSequencer

/* Release VSSeq on the last operand capture into the VLSU, independently of cache issue and acknowledgement. */
sync_circuit VectorStoreSequencer(xlen :: XLen, vlen :: VectorLength, slots :: Pow2Int, ~trace_isa: trace_isa :: maybe(String) = #false):
  def dlen = vector_dlen(vlen)
  def Owner = Bits(index_width(slots))
  input trace_instructions: Vec(slots, VectorTraceInstruction(xlen))
  interface prepare(Decoupled(MemoryIssue(xlen, vlen, slots)), ~role: consumer)
  def Row = OwnedRow(PreparedRow(vlen), Owner)
  interface rows(Decoupled(Row), ~role: producer)
  input room_after_capture: Bool
  interface store_reads(VectorStoreReadChain(Owner), ~role: engine)
  interface read(Decoupled(RowAddress), ~role: producer)
  interface read_result(Valid(Bits(dlen)), ~role: consumer)
  interface mask(VectorPredicateTap(dlen), ~role: reader)
  interface scatter(ScatterOperand(dlen), ~role: sequencer)
  input scatter_live: Bool
  def singleton = resolved_issue(prepare.bits.kind)
  input scatter_owner: Owner
  output busy: Bool
  inst capture(VectorMemoryRowSequencer(xlen, vlen, ~store: #true))
  reg capturing(~init: Bool(#false))
  reg capture_owner(Owner)
  reg unread_vs3(RowSet)
  reg unread_v0(PredicateSet)
  def values(data_rows, predicate_rows) = memory_command_rows(xlen, vlen, prepare.bits.command)
  reg segmented(Bool)
  inst segments(VectorSegmentClaims(xlen, vlen))
  prepare |> gate_flow(!capturing) |> map_flow(entry => entry.command) |> to_valid() |> capture.launch
  // Scatter addresses are irregular, but VS3 lanes advance in order. Keep
  // the last demanded row across page changes, never across instructions.
  reg resident(~init: Bool(#false))
  reg row_tag(RowAddress)
  reg row_data(Bits(dlen))
  reg reading(~init: Bool(#false))
  def demand = scatter.demand
  def hit = resident & (row_tag === demand.bits)
  def Array(row_return, scatter_return) = read_result |> fork_valid(2)
  def scatter_data = inject_interface(Valid(Bits(dlen)), ~valid: scatter_return.valid & reading, ~bits: scatter_return.bits)
  def captured = scatter_data |> trace_valid_event("vector/store.sequence", ~when: scatter_live, ~fields: _data):
    pc: trace_instructions[scatter_owner].pc
    instruction(~format: "riscv", ~isa: trace_isa || (if xlen == XLen.X32 | "rv32imafdcv" | "rv64imafdcv"), ~pc: "pc"): trace_instructions[scatter_owner].instruction
    owner(~format: "unsigned"): scatter_owner
    row(~format: "unsigned"): row_tag
  def fill = captured.valid
  scatter.operand.valid <== demand.valid & (hit ||| fill)
  scatter.operand.bits <== mux(fill, captured.bits, row_data)
  def need = demand.valid & !hit
  store_reads.owner <== mux(scatter_live, scatter_owner, capture_owner)
  store_reads.unread_vs3 <== mux(scatter_live, row_event(need, demand.bits), mux(capturing, mux(segmented, segments.claims, unread_vs3), RowSet(0)))
  store_reads.unread_v0 <== mux(capturing, unread_v0, PredicateSet(0))
  capture.older_writes <== store_reads.older_writes
  capture.singleton <== singleton
  capture.capacity <== rows.ready
  capture.room_after_capture <== room_after_capture
  (capture.prepared |> map_flow(r => OwnedRow(PreparedRow(vlen), Owner)):
     owner: capture_owner
     payload: r
  ) |> rows
  segments.install.valid <== prepare.fire()
  segments.install.bits <== prepare.bits.command
  capture.visit |> segments.visit
  segments.skip.valid <== capture.prepared.fire() & !capture.prepared.bits.enabled.any()
  segments.skip.bits <== capture.prepared.bits.row
  when (prepare.fire()):
    capture_owner <== prepare.bits.owner
    capturing <== Bool(#true)
    segmented <== prepare.bits.command.layout.nf.any()
    unread_vs3 <== data_rows
    unread_v0 <== predicate_rows
  elsewhen capturing:
    unread_vs3 <== unread_vs3 & !capture.read_done
    unread_v0 <== unread_v0 & !capture.predicate_done
    when (capture.prepared.fire() & capture.prepared.bits.last): capturing <== Bool(#false)
  def fetch = need & !reading & !store_reads.older_writes.as_vec(Bool)[demand.bits]
  read.valid <== mux(scatter_live, fetch, capture.read.valid)
  read.bits <== mux(scatter_live, demand.bits, capture.read.bits)
  capture.read.ready <== !scatter_live & read.ready
  row_return |> filter_valid(_data => !reading) |> capture.read_result
  def missed = scatter_live & read.fire()
  // Only an accepted scatter read creates a returning VS3 row.
  def fetch_owner = inject_interface(Valid(Bool), ~valid: missed, ~bits: Bool(#true))
  describe_interface_contract(demand, fetch_owner, "scatter-fetch", ~trace_model: interface_trace_combinational())
  describe_interface_retained_storage(missed, fill, reading, ~name: "scatter-fetch")
  describe_interface_contract(fetch_owner, scatter_data, "scatter-return", ~trace_model: interface_trace_retained(~name: "scatter-fetch"))
  reading <== missed
  when missed: row_tag <== demand.bits
  when fill: row_data <== captured.bits
  when (!scatter_live ||| missed ||| fill): resident <== scatter_live & fill
  // On return the operand bypasses the row register. Later elements may
  // reuse its identity until a new read or the end of the scatter stream.
  describe_interface_window_storage(
    1, fill & scatter_live, (resident & (missed ||| fill ||| !scatter_live)).as_bits(),
    resident.as_bits(), Bool(#false), [hit & !fill], ~live: fill
  )
  describe_interface_contract(captured, scatter.operand, "scatter-row", ~trace_model: interface_trace_window())
  capture.mask <=> mask
  busy <== capturing

export VectorStoreSequencer
