#lang rhodium
/* Splits ordered vector dispatch into independently buffered address and register work. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../../geometry.rhdl".compute_extent
  "../common/memory-route.rhdl" open
  "../mem/address-queue.rhdl" open
  lib("cores/common/mmu/vector.rhdl") open
  lib("cores/common/vector/bundles.rhdl") open
  lib("riscv/isa/vector.rhm").VectorLength
  lib("riscv/isa/xlen.rhm").XLen
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

/* Dispatch may close a compute owner without launching only if it owes neither body work nor a scalar result. */
fun vector_dispatch_empty(xlen :: XLen, vlen :: VectorLength, d :: VectorDescriptor(xlen)) :~ Bool:
  def extent = compute_extent(xlen, vlen, d)
  mux(d.control.memory, d.state.vstart >= d.beat_limit(vlen).zext(xlen.width), !extent.has_body() & !extent.scalar_result)

/* Carry the selected datapath route with its owner through a stalled VXDQ. */
bundle VectorDatapathDispatch(xlen :: XLen, slots :: Pow2Int):
  entry: VectorDispatchEntry(xlen, slots)
  direct: Bool

/* Accept a native memory owner into both queues on one edge. VMDQ registers
   the translated command; VXDQ bypasses when empty but never skips its head.
   Checked macros enter only VXDQ; their certified slices subsequently use VMDQ. */
sync_circuit DistributedVectorDispatch(xlen :: XLen, vlen :: VectorLength, slots :: Pow2Int):
  def Entry = VectorDispatchEntry(xlen, slots)
  def Work = VectorDatapathDispatch(xlen, slots)
  def Command = MemoryLaunch(xlen, vlen, slots)
  interface ingress(Decoupled(Entry), ~role: consumer)
  input direct: Bool
  input window_pages: VectorWindowPages
  interface work(Decoupled(Work), ~role: producer)
  interface checked_address(Decoupled(Command), ~role: consumer)
  interface address(Decoupled(Command), ~role: producer)
  inst vmdq(Queue(Command, 1, ~pipe: #true))
  inst vxdq(Queue(Work, 4, ~flow: #true))
  def Array(registers, memory) = ingress |> atomic_fork(2)
  (registers |> map_flow(e => VectorDatapathDispatch(xlen, slots)):
     entry: e
     direct: direct
  ) |> vxdq.ingress
  vxdq.egress |> work
  /* Snapshot the certificate before dispatch can advance the translation window. */
  fun physical_command(e :: VectorDispatchEntry(xlen, slots)) :~ MemoryLaunch(xlen, vlen, slots):
    def d = e.checked.descriptor
    MemoryLaunch(xlen, vlen, slots):
      issue: direct_memory_issue(xlen, vlen, slots, e)
      pages: mux(d.precertified, d.certificate.pages(), window_pages)
      service: VectorMemoryService.Cached
  def physical = memory |> filter_flow(_e => direct) |> map_flow(e => physical_command(e))
  Array(checked_address, physical) |> arbiter() |> vmdq.ingress
  vmdq.egress |> address

  interface scalar_probe(Valid(RowFootprint()), ~role: consumer)
  output scalar_conflict: Bool
  def pending = physical_span(xlen, vlen, slots, address.bits)
  scalar_conflict <== address.valid & (pending.store ||| scalar_probe.bits.store) & (!scalar_probe.valid ||| physical_overlap(xlen, scalar_probe.bits, pending))

export DistributedVectorDispatch VectorDatapathDispatch vector_dispatch_empty
