#lang rhodium
/* Routes execute work and retains checked memory descriptors until the checker can start. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../../geometry.rhdl".compute_extent
  "../../decode.rhdl".VectorDispatchKind
  "../common/paths.rhm" open
  lib("cores/common/vector/bundles.rhdl") open
  lib("riscv/isa/vector.rhm").VectorLength
  lib("riscv/isa/xlen.rhm").XLen
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

/* Dispatch may close a compute owner without launching only if it owes neither body work nor a scalar result. */
fun vector_dispatch_empty(xlen :: XLen, vlen :: VectorLength, d :: VectorDescriptor(xlen)) :~ Bool:
  def extent = compute_extent(xlen, vlen, d)
  mux(d.control.memory, d.state.vstart >= d.beat_limit(vlen).zext(xlen.width), !extent.has_body() & !extent.scalar_result)

/* Only checked memory enters these heads. Reclaim, not starting a slice,
   releases its owner; native memory allocates directly in the VLSU. */
sync_circuit DistributedVectorDispatch(xlen :: XLen, slots :: Pow2Int):
  def Entry = VectorDispatchEntry(xlen, slots)
  interface ingress(Decoupled(Entry), ~role: consumer)
  interface heads[MemoryPaths.length()](Decoupled(Entry), ~role: producer)
  def Owner = Bits(index_width(slots))
  input memory_busy: Vec(MemoryPaths.length(), Bool)
  interface native_execute(Decoupled(Entry), ~role: producer)
  interface reclaimed(Valid(Owner), ~role: consumer)
  def paths = ingress |> demux_flow(VectorDispatchKind.values().length(), entry):
    entry.checked.descriptor.control.dispatch_kind.as_bits()
  paths[VectorDispatchKind.None.packed_value()].ready <== Bool(#false)
  /* A release is addressed, since macro completion and slot reuse are independent. */
  fun releases(event :: Endpoint, owner :: Bits(index_width(slots))) :~ Bool:
    event.valid & (event.bits === owner)
  reg descriptors(Vec(MemoryPaths.length(), Entry))
  reg starting(~init: Bits(MemoryPaths.length())(0).as_vec(Bool))
  // Native memory residency belongs exclusively to the VLSU and VRF sequencers.
  // A checked access retains its kind across its individual element launches.
  reg checked_live(~init: Bits(MemoryPaths.length())(0).as_vec(Bool))
  paths[VectorDispatchKind.Execute.packed_value()] |> native_execute
  for (kind in MemoryPaths):
    def dispatch = if kind == LoadPath | VectorDispatchKind.Load | VectorDispatchKind.Store
    def input_path = paths[dispatch.packed_value()]
    def owner = descriptors[kind].owner
    when (input_path.fire()): checked_live[kind] <== Bool(#true)
    elsewhen (releases(reclaimed, owner)): checked_live[kind] <== Bool(#false)
    def available = !memory_busy[kind] & !checked_live[kind]
    input_path.ready <== !starting[kind] & available
    heads[kind].valid <== starting[kind]
    heads[kind].bits <== descriptors[kind]
    def allocate = input_path.fire()
    when allocate: descriptors[kind] <== input_path.bits
    when (allocate ||| heads[kind].fire()): starting[kind] <== allocate
    def name = "dispatch-head-" ++ to_string(kind)
    describe_interface_retained_storage(allocate, heads[kind].fire(), starting[kind], ~name: name)
    describe_interface_contract(input_path, heads[kind], name, ~trace_model: interface_trace_retained(~name: name))

export DistributedVectorDispatch vector_dispatch_empty
