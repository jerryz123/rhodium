#lang rhombus
// Defines the shared CSR bank for the csr behavioral fixture.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("riscv/isa/xlen.rhm") open
  lib("riscv/isa/hart.rhm").RiscvMmuType
  lib("riscv/isa/fp-profile.rhm") open
  lib("riscv/isa/c.rhm") open
  lib("riscv/isa/vector-profile.rhm") open
  "../../config.rhm".RiscvCsrConfig
  "../../file.rhdl".RiscvCsrFile
  "../csr-profile.rhm".csr_test_isa

def config = RiscvCsrConfig(csr_test_isa(XLen.X64, ~fp: #true, ~compressed: #true), ~mmu_type: RiscvMmuType.Sv39, ~floating_point: FloatingPointProfile.D, ~zicboz: #true, ~ssnpm: #true, ~svpbmt: #true, ~compressed: CCompressedExtensions)
def program = elaborate(RiscvCsrFile(config))
export program
