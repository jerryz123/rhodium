#lang rhodium
/* Provides one reusable PTE datapath and walk state machine for host Sv39 and nested VS/Sv39x4
   translation. */
// SPDX-License-Identifier: Apache-2.0

import:
  "translation.rhdl" open
  "protocol.rhdl" open
  lib("riscv/rtl/hypervisor.rhdl") open
  lib("riscv/rtl/privilege.rhdl") open
  lib("riscv/rtl/sv39.rhdl") open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

/* Distinguishes VS traversal, G translation of a VS PTE, and G translation of the final
   address. */
hardware_enum RiscvPageWalkPhase:
  Virtual
  GuestPte
  GuestFinal

/* Tracks one walk's address checks, PTE ownership, retained completion, and canceled-response
   drain. */
hardware_enum RiscvPageWalkState:
  Idle
  CheckAddress
  PrepareRead
  Request
  Response
  Complete
  Drain

/* Holds the table PPN, level, and inherited global bit during traversal. A successful
   host leaf replaces the table PPN with its own PPN until completion. */
bundle RiscvPageWalkFrame():
  table_ppn: Bits(44)
  level: Bits(2)
  global_mapping: Bool

/* Captures the PTE-dependent outcome; the held walk supplies the completion's address provenance. */
bundle RiscvPageWalkResult():
  physical_address: Bits(56)
  page_size: Sv39PageSize
  vs_leaf: Sv39Pte()
  g_leaf: Sv39Pte()
  fault: RiscvTranslationFault

/* Walks host Sv39 or nested VS/Sv39x4 using one active frame and a saved VS continuation.
   Cancellation suppresses completion but drains an already accepted PTE read. */
sync_circuit RiscvTranslationWalker(~svnapot: svnapot :: Boolean = #false,
                                    ~prechecked_va: prechecked_va :: Boolean = #false):
  interface request(Decoupled(RiscvTlbLookup()), ~role: consumer)
  output accepted_lookup: RiscvTlbLookup()
  interface completion(Irrevocable(RiscvTlbMapping()), ~role: producer)
  interface memory(RiscvTranslationMemory(), ~role: requester)
  input cancel: Bool
  // Multi-source callers can classify each candidate before selecting the
  // request. This bit belongs to the admission edge, not the retained lookup.
  def host_va_canonical :: Bool = if prechecked_va
  | block:
      input request_va_canonical: Bool
      request_va_canonical
  | request.bits.virtual_address.sv39_canonical()


  /* Walk frame, continuation, and physical-read ownership */

  reg state(~init: RiscvPageWalkState.Idle)
  reg phase(RiscvPageWalkPhase)
  reg operation(RiscvTlbLookup())
  accepted_lookup <== operation
  reg nested_gpa(Bits(64))
  reg frame(RiscvPageWalkFrame())
  reg saved_vs(RiscvPageWalkFrame())
  reg vs_leaf(Sv39Pte())
  reg memory_address(Bits(64))
  reg memory_pbmt(PageMemoryType)
  reg result(RiscvPageWalkResult())


  /* Public offers and accepted-response ownership
     Cancellation ends architectural completion but does not abandon an accepted PTE reply. */

  def walking = request |> trace_event("mmu/walk", ~when: !cancel, ~residency: "walk", ~fields: translation):
    virtual_address: translation.virtual_address
    access(~format: "enum"): translation.access
    privilege(~format: "enum"): translation.context.privilege

  def idle = state === RiscvPageWalkState.Idle
  walking.ready <== idle & !cancel
  completion.valid <== (state === RiscvPageWalkState.Complete) & !cancel
  // The accepted lookup, nested GPA and phase all hold through the completion transfer.
  def virtual_stage = phase === RiscvPageWalkPhase.Virtual
  def implicit_access = phase === RiscvPageWalkPhase.GuestPte
  def nested_g_stage = operation.virtualized & !virtual_stage & (operation.context.vs_mode === RiscvVSMode.Sv39)
  def walk_address = mux(nested_g_stage, nested_gpa, operation.virtual_address)
  // A host leaf no longer needs the table that supplied it. Reconstruct its
  // address from the held frame and lookup, never from the next memory response.
  def host_base_ppn = sv39_base_ppn(frame.table_ppn, result.page_size)
  def host_address = priority_mux(~default: operation.virtual_address[0..56]):
    result.fault =/= RiscvTranslationFault.None: Bits(56)(0)
    operation.context.vs_mode === RiscvVSMode.Sv39: sv39_physical_address(operation.virtual_address, host_base_ppn, result.page_size)

  def details = RiscvGuestFault():
    guest_virtual_address: operation.virtualized
    guest_physical_address: mux(virtual_stage, Bits(64)(0), walk_address)
    access: mux(implicit_access, RiscvGuestFaultAccess.PageTableRead, RiscvGuestFaultAccess.Explicit)
  completion.bits <== RiscvTlbMapping():
    virtual_address: operation.virtual_address
    access: operation.access
    physical_address: mux(operation.virtualized, result.physical_address, host_address)
    page_size: result.page_size
    guest_physical_address: mux(operation.virtualized, walk_address, host_address.zext(64))
    vs_leaf: result.vs_leaf
    g_leaf: result.g_leaf
    fault: result.fault
    fault_details: details

  memory.request.valid <== (state === RiscvPageWalkState.Request) & !cancel
  def request_fire = request.fire()
  when request_fire:
    operation <== request.bits
    assert(host_va_canonical === request.bits.virtual_address.sv39_canonical(), "walk_canonical_matches_owner")

  def memory_fire = memory.request.fire()
  def owns_response = (state === RiscvPageWalkState.Response) ||| (state === RiscvPageWalkState.Drain)
  // Also accept a zero-latency response on the request's transfer edge.
  def response_expected = owns_response ||| (memory_fire & !memory.request_access_fault)
  def response_received = memory.response.valid & response_expected
  assert(!memory.response.valid ||| response_expected, "riscv_ptw_response_owned")


  /* Current traversal and PTE validation */

  def guest_bare = !operation.virtualized ||| (operation.context.g_mode === RiscvGMode.Bare)
  def pte = memory.response.bits.into(Sv39Pte())
  def leaf = pte.sv39_leaf()
  def pbmte = mux(virtual_stage, operation.context.vs_pbmte, operation.context.g_pbmte)
  def encoding_fault = !sv39_pte_structurally_valid(pte, ~level: frame.level, ~svnapot: svnapot, ~pbmte: pbmte)
  def superpage_alignment_fault = leaf & !pte.sv39_superpage_aligned(frame.level)
  def nonleaf_fault = !leaf & ((frame.level === Bits(2)(0)) ||| pte.dirty ||| pte.accessed ||| pte.user)
  def structural_fault = encoding_fault ||| superpage_alignment_fault ||| nonleaf_fault
  def checked_access = mux(implicit_access, Sv39Access.Load, operation.access)
  def user = !virtual_stage ||| (operation.context.privilege === PrivilegeMode.User)
  def supervisor = virtual_stage & (operation.context.privilege === PrivilegeMode.Supervisor)
  def sum = virtual_stage & operation.context.vs_sum
  // MXR and HLVX relax explicit loads, never implicit VS page-table reads.
  def mxr = !implicit_access & (operation.context.hs_mxr ||| (virtual_stage & operation.context.vs_mxr))
  def permission_fault = leaf & !sv39_permission_valid(pte, checked_access, user, supervisor, sum, mxr, operation.execute_read & !implicit_access)
  def page_size = sv39_page_size(pte, frame.level)
  def translated_address = sv39_physical_address(walk_address, sv39_base_ppn(pte.ppn, page_size), page_size)
  def pte_offset = mux(virtual_stage, (operation.virtual_address.sv39_vpn(frame.level) ++ Bits(3)(0)).zext(64), (sv39x4_vpn(walk_address, frame.level) ++ Bits(3)(0)).zext(64))
  def pte_address = (frame.table_ppn ++ Bits(12)(0)).zext(64) + pte_offset
  memory.request.bits <== RiscvPteRead():
    address: mux(operation.virtualized, memory_address, pte_address)
    pbmt: mux(operation.virtualized, memory_pbmt, PageMemoryType.PMA)

  def occupied = (state =/= RiscvPageWalkState.Idle) & (state =/= RiscvPageWalkState.Drain)
  describe_interface_retained_storage(request_fire & !cancel, occupied & (completion.fire() ||| cancel), occupied, ~name: "walk")
  describe_interface_contract(walking, Array(memory.request, completion), "walk-outputs", ~trace_model: interface_trace_retained(~name: "walk", ~outputs: 2))


  /* Address checks and retained mapping construction */

  def bad_virtual_address = virtual_stage & !operation.virtual_address.sv39_canonical()
  def bad_guest_address = !virtual_stage & !guest_bare & (!sv39x4_address_valid(walk_address) ||| any(operation.context.g_root_ppn[0..2]))
  def bare_overflow = !virtual_stage & guest_bare & !riscv_bare_address_fits(walk_address)
  def bad_address = bad_virtual_address ||| bad_guest_address ||| bare_overflow
  def bad_pte = structural_fault ||| permission_fault
  def address_fault = priority_mux(~default: RiscvTranslationFault.GuestPageFault):
    bare_overflow: RiscvTranslationFault.AccessFault
    virtual_stage: RiscvTranslationFault.PageFault

  def checking_address = state === RiscvPageWalkState.CheckAddress
  def preparing_read = state === RiscvPageWalkState.PrepareRead
  def zero_leaf = Bits(64)(0).into(Sv39Pte())
  def vs_pte = pte.updated(~global_mapping: frame.global_mapping ||| pte.global_mapping)
  def g_pte = pte.updated(~global_mapping: Bool(#false))

  /* Starts a three-level traversal at the selected root without inherited global permissions. */
  fun root_frame(ppn :: Bits(44)) :~ RiscvPageWalkFrame():
    RiscvPageWalkFrame():
      table_ppn: ppn
      level: Bits(2)(2)
      global_mapping: Bool(#false)

  /* Captures the physical result, leaf snapshots, page size, and fault before the PTE bus changes. */
  fun outcome(fault :: RiscvTranslationFault, physical :: Bits(56), guest_leaf :: Sv39Pte()) :~ RiscvPageWalkResult():
    RiscvPageWalkResult():
      physical_address: physical
      page_size: mux(!operation.virtualized & virtual_stage, page_size, Sv39PageSize.Page4KiB)
      vs_leaf: mux(!operation.virtualized & virtual_stage, vs_pte, vs_leaf)
      g_leaf: guest_leaf
      fault: fault


  /* Result capture
     Prepare the candidate for each phase; only entry into Complete publishes it.
     Idle includes the admission edge. Neither a stalled completion nor Drain writes. */
  when idle:
    result <== RiscvPageWalkResult():
      physical_address: Bits(56)(0)
      page_size: Sv39PageSize.Page4KiB
      vs_leaf: zero_leaf
      g_leaf: zero_leaf
      fault: RiscvTranslationFault.PageFault
  elsewhen checking_address:
    result <== mux(bad_address, outcome(address_fault, Bits(56)(0), zero_leaf),
                   outcome(RiscvTranslationFault.None, walk_address[0..56], zero_leaf))
  elsewhen ((state === RiscvPageWalkState.Request) ||| (state === RiscvPageWalkState.Response)):
    // A rejection belongs to the request phase only. A successful zero-latency
    // PTE reply selects exactly the same candidate as a delayed response.
    result <== priority_mux(~default: outcome(RiscvTranslationFault.None, translated_address, g_pte)):
      memory.request.valid & memory.request_access_fault: outcome(RiscvTranslationFault.AccessFault, Bits(56)(0), zero_leaf)
      bad_pte: outcome(mux(virtual_stage, RiscvTranslationFault.PageFault, RiscvTranslationFault.GuestPageFault), Bits(56)(0), zero_leaf)
      virtual_stage & !operation.virtualized: outcome(RiscvTranslationFault.None, Bits(56)(0), zero_leaf)


  /* Idle prepares the current candidate's root even without an offer. Only
     a transfer admits the lookup; occupied walks never sample the live root. */
  when idle:
    def context = request.bits.context
    def paged_vs = context.vs_mode === RiscvVSMode.Sv39
    frame <== root_frame(mux(paged_vs, context.vs_root_ppn, context.g_root_ppn))
    when request_fire:
      vs_leaf <== zero_leaf
      phase <== mux(paged_vs, RiscvPageWalkPhase.Virtual, RiscvPageWalkPhase.GuestFinal)
      def host_first_state = mux(host_va_canonical, RiscvPageWalkState.Request, RiscvPageWalkState.Complete)
      state <== mux(!request.bits.virtualized & paged_vs, host_first_state, RiscvPageWalkState.CheckAddress)

  /* Once occupied, cancellation and drain precede traversal and completion. */
  elsewhen cancel:
    // Keep the memory owner even after its architectural consumer disappears.
    state <== mux(owns_response & !memory.response.valid, RiscvPageWalkState.Drain, RiscvPageWalkState.Idle)
  elsewhen ((state === RiscvPageWalkState.Drain) & memory.response.valid):
    state <== RiscvPageWalkState.Idle
  elsewhen (checking_address & bad_address):
    state <== RiscvPageWalkState.Complete
  elsewhen (checking_address & !virtual_stage & guest_bare & implicit_access):
    memory_address <== walk_address
    memory_pbmt <== PageMemoryType.PMA
    frame <== saved_vs
    phase <== RiscvPageWalkPhase.Virtual
    state <== RiscvPageWalkState.Request
  elsewhen (checking_address & !virtual_stage & guest_bare):
    state <== RiscvPageWalkState.Complete
  elsewhen checking_address:
    state <== RiscvPageWalkState.PrepareRead
  elsewhen (preparing_read & virtual_stage & operation.virtualized):
    saved_vs <== frame
    nested_gpa <== pte_address
    frame <== root_frame(operation.context.g_root_ppn)
    phase <== RiscvPageWalkPhase.GuestPte
    state <== RiscvPageWalkState.CheckAddress
  elsewhen preparing_read:
    memory_address <== pte_address
    memory_pbmt <== PageMemoryType.PMA
    state <== RiscvPageWalkState.Request
  elsewhen (memory_fire & memory.request_access_fault):
    state <== RiscvPageWalkState.Complete
  elsewhen (response_received & bad_pte):
    state <== RiscvPageWalkState.Complete
  elsewhen (response_received & !leaf):
    frame <== RiscvPageWalkFrame():
      table_ppn: pte.ppn
      level: frame.level - Bits(2)(1)
      global_mapping: frame.global_mapping ||| (virtual_stage & pte.global_mapping)

    state <== mux(operation.virtualized, RiscvPageWalkState.PrepareRead, RiscvPageWalkState.Request)
  elsewhen (response_received & virtual_stage & !operation.virtualized):
    frame <== frame.updated(~table_ppn: pte.ppn)
    state <== RiscvPageWalkState.Complete
  elsewhen (response_received & virtual_stage):
    vs_leaf <== vs_pte
    nested_gpa <== translated_address.zext(64)
    frame <== root_frame(operation.context.g_root_ppn)
    phase <== RiscvPageWalkPhase.GuestFinal
    state <== RiscvPageWalkState.CheckAddress
  elsewhen (response_received & implicit_access):
    memory_address <== translated_address.zext(64)
    memory_pbmt <== pte.pbmt
    frame <== saved_vs
    phase <== RiscvPageWalkPhase.Virtual
    state <== RiscvPageWalkState.Request
  elsewhen response_received:
    state <== RiscvPageWalkState.Complete
  elsewhen memory_fire:
    state <== RiscvPageWalkState.Response
  elsewhen (completion.fire()):
    state <== RiscvPageWalkState.Idle

/* Adapts host-only request, completion, and PTE ports onto the shared translation walker. */
sync_circuit RiscvPageTableWalker(~svnapot: svnapot :: Boolean = #false):
  interface request(Decoupled(RiscvTranslationRequest()), ~role: consumer)
  interface completion(Irrevocable(RiscvTranslationResult()), ~role: producer)
  interface memory(RiscvPageTableMemory(), ~role: requester)
  input cancel: Bool
  inst shared(RiscvTranslationWalker(~svnapot: svnapot))
  request |> map_flow(translation => riscv_host_lookup(translation)) |> shared.request
  shared.completion |> map_flow(~stable: #true, mapping => riscv_host_result(mapping)) |> completion
  shared.memory.request |> map_flow(read => read.address) |> memory.request
  memory.response |> shared.memory.response
  shared.memory.request_access_fault <== memory.request_access_fault
  shared.cancel <== cancel

export:
  RiscvPageWalkState
  RiscvPageTableWalker
  RiscvTranslationWalker
