#lang rhombus
// Exercises both TLB entry formats with a map narrower than a 1 GiB page offset.
// SPDX-License-Identifier: Apache-2.0
import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../tlb.rhdl".RiscvTranslationTlb

def program = elaborate(RiscvTranslationTlb(2, ~host_root_epoch: #true, ~physical_address_width: 20))
def root_tagged = elaborate(RiscvTranslationTlb(2, ~physical_address_width: 20))
export:
  program
  root_tagged
