import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../tlb.rhdl".RiscvTranslationTlb

def program = elaborate(RiscvTranslationTlb(2, ~host_root_epoch: #true, ~physical_address_width: 20))
export program
