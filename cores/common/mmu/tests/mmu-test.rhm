#lang rhombus
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  lib("rhodium/core/main.rhm") open
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("rhodium/frontend/layers/bool.rhm") as bool
  "../tlb.rhdl" as tlb
  "../walker.rhdl" as walker

def tlb_design = compile_program(elaborate(tlb.RiscvTlb()), rtl_target).report.design
def tlb_module = tlb_design.modules[0]
def walker_design = compile_program(elaborate(walker.RiscvPageTableWalker()), rtl_target).report.design
def walker_module = walker_design.modules[0]

check:
  tlb_module.find_input("virtual_address").type.width ~is 64
  tlb_module.find_output("physical_address").type.width ~is 56
  tlb_module.find_input("fill_in").type.field("bits").type.field("base_ppn").type.width ~is 44
  type_equal(
    tlb_module.find_input("fill_in").type.field("bits").type.field("global_mapping").type,
    bool.Bool
  ) ~is #true
  walker_module.find_input("request_in").type.field("bits").type.field("virtual_address").type.width ~is 64
  walker_module.find_output("memory_out").type.field("request").type.field("bits").type.width ~is 64
  walker_module.find_output("completion_out").type.field("bits").type.field("physical_address").type.width ~is 56
