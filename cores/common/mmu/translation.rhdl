#lang rhodium
/* Defines core-neutral host/guest TLB and walker mappings, faults, and host-port projections. */
// SPDX-License-Identifier: Apache-2.0

import:
  "protocol.rhdl" open
  lib("riscv/rtl/privilege.rhdl") open
  lib("riscv/rtl/hypervisor.rhdl") open
  lib("riscv/rtl/sv39.rhdl") open
  lib("riscv/rtl/svpbmt.rhdl").compose_page_memory_type
  lib("riscv/rtl/trap.rhdl").ExceptionCause
  lib("rhodium/std/ready-valid.rhdl") open

/* Separates first-stage, guest-stage, and physical failures for precise trap selection. */
hardware_enum RiscvTranslationFault:
  None
  PageFault
  GuestPageFault
  AccessFault

/* Captures the access and both translation contexts used to match and recheck a mapping. */
bundle RiscvTlbLookup():
  virtualized: Bool
  execute_read: Bool
  virtual_address: Bits(64)
  access: Sv39Access
  context: RiscvGuestTranslationContext()

  /* A replay or an active walk matches only the entire original request, including
     the exact address, access class, execute-read intent, and both translation contexts. */
  method same_request(request, other :: RiscvTlbLookup()) :: Bool:
    request.as_bits() === other.as_bits()

/* Retains independent stage permissions, PBMT, and fault provenance. Bare stages have
   zero leaves; the captured context identifies which stages apply. */
bundle RiscvTlbMapping():
  virtual_address: Bits(64)
  access: Sv39Access
  physical_address: Bits(56)
  page_size: Sv39PageSize
  guest_physical_address: Bits(64)
  vs_leaf: Sv39Pte()
  g_leaf: Sv39Pte()
  fault: RiscvTranslationFault
  fault_details: RiscvGuestFault()

/* Preserves the walker's trap provenance and marks the effective address as guest virtual when applicable. */
fun riscv_guest_exception(mapping :: RiscvTlbMapping(), guest :: Bool) :~ RiscvGuestException():
  RiscvGuestException():
    page_fault: mapping.fault === RiscvTranslationFault.GuestPageFault
    details: mapping.fault_details.updated(~guest_virtual_address: guest)

/* Retains an exact failed lookup and trap provenance, never successful mapping
   addresses or leaf permissions. The original lookup also owns the access class. */
bundle RiscvTranslationFailure():
  request: RiscvTlbLookup()
  kind: RiscvTranslationFault
  details: RiscvGuestFault()

  /* Projects a matched failure onto the common result path. Failed walks have
     no physical destination; zero leaves cannot authorize memory or a window. */
  method mapping(failure) :: RiscvTlbMapping():
    RiscvTlbMapping():
      virtual_address: failure.request.virtual_address
      access: failure.request.access
      physical_address: Bits(56)(0)
      page_size: Sv39PageSize.Page4KiB
      guest_physical_address: Bits(64)(0)
      vs_leaf: literal(Sv39Pte(), 0)
      g_leaf: literal(Sv39Pte(), 0)
      fault: failure.kind
      fault_details: failure.details

/* Pairs a completed mapping with the original lookup context for associative installation. */
bundle RiscvTlbFill():
  request: RiscvTlbLookup()
  result: RiscvTlbMapping()

  /* Captures the failed walk key and provenance for a subsequent matching request. */
  method failure(fill) :: RiscvTranslationFailure():
    RiscvTranslationFailure():
      request: fill.request
      kind: fill.result.fault
      details: fill.result.fault_details

/* For a faulting completion, selects the exception class from the original access,
   not an implicit page-table read. */
fun riscv_translation_fault_cause(result :: RiscvTlbMapping()) :~ ExceptionCause:
  def page = mux_lookup(result.access):
    Sv39Access.Store: ExceptionCause.StorePageFault
    Sv39Access.CacheManagement: ExceptionCause.StorePageFault
    Sv39Access.Fetch: ExceptionCause.InstructionPageFault
    Sv39Access.Load: ExceptionCause.LoadPageFault

  def guest = mux_lookup(result.access):
    Sv39Access.Store: ExceptionCause.StoreGuestPageFault
    Sv39Access.CacheManagement: ExceptionCause.StoreGuestPageFault
    Sv39Access.Fetch: ExceptionCause.InstructionGuestPageFault
    Sv39Access.Load: ExceptionCause.LoadGuestPageFault

  def physical = mux_lookup(result.access):
    Sv39Access.Store: ExceptionCause.StoreAccessFault
    Sv39Access.CacheManagement: ExceptionCause.StoreAccessFault
    Sv39Access.Fetch: ExceptionCause.InstructionAccessFault
    Sv39Access.Load: ExceptionCause.LoadAccessFault

  mux_lookup(result.fault):
    RiscvTranslationFault.None: physical
    RiscvTranslationFault.AccessFault: physical
    RiscvTranslationFault.PageFault: page
    RiscvTranslationFault.GuestPageFault: guest

/* Carries the physical PTE address and G-stage memory-type override for an implicit read. */
bundle RiscvPteRead():
  address: Bits(64)
  pbmt: PageMemoryType

/* Transfers one PTE read with admission-time access faults and an unbackpressured result. */
interface RiscvTranslationMemory():
  role requester
  role responder
  provider requester
  requester -> responder:
    request: Decoupled(RiscvPteRead())

  responder -> requester:
    request_access_fault: Bool
    response: Valid(Bits(64))

/* Projects a host Sv39 request into the shared lookup with G-stage translation disabled. */
fun riscv_host_lookup(request :: RiscvTranslationRequest(), ~enabled: enabled :: Bool = Bool(#true)) :~ RiscvTlbLookup():
  def context = RiscvGuestTranslationContext():
    vs_mode: mux(enabled, RiscvVSMode.Sv39, RiscvVSMode.Bare)
    g_mode: RiscvGMode.Bare
    vs_root_ppn: request.root_ppn
    g_root_ppn: Bits(44)(0)
    privilege: request.privilege
    vs_sum: request.sum
    vs_mxr: request.mxr
    hs_mxr: Bool(#false)
    vs_pbmte: request.pbmte
    g_pbmte: Bool(#false)

  RiscvTlbLookup():
    virtualized: Bool(#false)
    execute_read: Bool(#false)
    virtual_address: request.virtual_address
    access: request.access
    context: context

/* Reconstructs a first-stage leaf and shared mapping from the host-only result shape. */
fun riscv_host_mapping(result :: RiscvTranslationResult()) :~ RiscvTlbMapping():
  def leaf = Sv39Pte():
    ppn: result.base_ppn
    napot: Bool(#false)
    pbmt: result.pbmt
    reserved: Bits(7)(0)
    rsw: Bits(2)(0)
    dirty: result.dirty
    accessed: result.accessed
    global_mapping: result.global_mapping
    user: result.user
    execute: result.execute
    write: result.write
    read: result.read
    valid: Bool(#true)

  RiscvTlbMapping():
    virtual_address: result.virtual_address
    access: Sv39Access.Load
    physical_address: sv39_physical_address(result.virtual_address, result.base_ppn, result.page_size)
    page_size: result.page_size
    guest_physical_address: result.physical_address.zext(64)
    vs_leaf: leaf
    g_leaf: literal(Sv39Pte(), 0)
    fault: mux(result.access_fault, RiscvTranslationFault.AccessFault, mux(result.fault, RiscvTranslationFault.PageFault, RiscvTranslationFault.None))
    fault_details: literal(RiscvGuestFault(), 0)

/* Projects a shared mapping into host result fields, composing the two stages' PBMT. */
fun riscv_host_result(result :: RiscvTlbMapping()) :~ RiscvTranslationResult():
  RiscvTranslationResult():
    virtual_address: result.virtual_address
    physical_address: result.physical_address
    base_ppn: sv39_base_ppn(result.physical_address[12..56], result.page_size)
    page_size: result.page_size
    user: result.vs_leaf.user
    read: result.vs_leaf.read
    write: result.vs_leaf.write
    execute: result.vs_leaf.execute
    global_mapping: result.vs_leaf.global_mapping
    accessed: result.vs_leaf.accessed
    dirty: result.vs_leaf.dirty
    fault: result.fault.is_one_of(RiscvTranslationFault.PageFault, RiscvTranslationFault.GuestPageFault)
    access_fault: result.fault === RiscvTranslationFault.AccessFault
    pbmt: mux(result.fault === RiscvTranslationFault.None, compose_page_memory_type(result.vs_leaf.pbmt, result.g_leaf.pbmt), PageMemoryType.PMA)

export:
  riscv_guest_exception
  riscv_host_lookup
  riscv_host_mapping
  riscv_host_result
  RiscvTranslationFault
  RiscvTlbLookup
  RiscvTlbMapping
  RiscvTlbFill
  RiscvTranslationFailure
  riscv_translation_fault_cause
  RiscvPteRead
  RiscvTranslationMemory
