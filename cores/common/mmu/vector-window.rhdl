#lang rhodium
/* Captures vector ranges before probing pages and retains certified cacheable translations. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/common/mmu/vector.rhdl") open
  "../../../riscv/rtl/pma.rhdl" open
  "../../../riscv/rtl/svpbmt.rhdl".PageMemoryType
  "../../../riscv/rtl/sv39.rhdl".sv39_same_page
  lib("flow/main.rhdl") open

/* Probes the range endpoints, returns a certificate decision, then retains ownership until
   release. */
hardware_enum VectorWindowState:
  Idle
  Request
  Response
  Complete
  Owned

/* Certifies a whole physical page only in a cacheable, idempotent, nondevice address set. */
fun vector_page_permitted(physical_map :: RiscvPhysicalMemoryMap, address :: Bits(64), store :: Bool) :~ Bool:
  def permitted_regions = for List (region in physical_map.regions):
    def attributes = region.attributes
    // Endpoint membership alone cannot certify a sparse physical address set.
    if (region.address_set.mask bits.and (VectorPageBytes - 1)) == (VectorPageBytes - 1) && attributes.cacheable && (!attributes.device) && attributes.read_idempotent
    | region.address_set.matches(address) & mux(store, Bool(attributes.writable), Bool(attributes.readable))
    | Bool(#false)

  def fits = if physical_map.address_width >= 64 | Bool(#true) | !address[physical_map.address_width..64].any()
  vec(permitted_regions).any() & fits

/* Tests candidate == base + 1 without wrapping or putting a VPN-wide incrementer
   before the live hit comparator. A 1-to-0 transition carries into the next bit;
   every changed bit must correspond to its carry-in, with no carry out of the MSB. */
fun following_page(base :: Bits, candidate :: Bits(base.type.packed_width())) :~ Bool:
  (Bits(1)(0) ++ (base ^ candidate)) === ((base & !candidate) ++ Bits(1)(1))

/* Retains up to two endpoint-page mappings for one nonspeculative vector macro.
   A failed check selects exact element execution; it does not raise an architectural fault. */
sync_circuit VectorWindow(physical_map :: RiscvPhysicalMemoryMap):
  interface check(VectorPrecheck(), ~role: responder)
  interface translation(RiscvPageProbe(), ~role: requester)
  input addresses: Vec(2, Bits(64))
  output physical_addresses: Vec(2, Bits(64))
  output hits: Vec(2, Bool)
  output owned: Bool
  output pages: VectorWindowPages

  /* Only certified cacheable pages are observable. Narrow the saved PPNs,
     not the translated addresses used for both endpoint permission checks. */

  def cacheable_width = physical_map.address_width_for(fun (attributes): attributes.cacheable)
  def ppn_width = vector_ppn_width(cacheable_width)
  reg state(~init: VectorWindowState.Idle)
  reg first(Bits(64))
  reg last_offset(Bits(VectorPageOffsetBits))
  reg split(Bool)
  reg store(Bool)
  reg second(~init: Bool(#false))
  reg first_ppn(Bits(ppn_width))
  reg last_ppn(Bits(ppn_width))
  reg safe(~init: Bool(#false))
  pages <== vec([first_ppn.zext(VectorPageNumber.packed_width()), last_ppn.zext(VectorPageNumber.packed_width())])


  /* Probe admission and owned-address lookup.
     Both probe validity and payload come from registered ownership, never
     a live check offer whose admission may depend on MMU readiness. */

  def admitting = state === VectorWindowState.Idle
  def first_page = first[VectorPageOffsetBits..64]
  def first_offset = first[0..VectorPageOffsetBits]
  // Only a split can issue a second probe or consult the covering superpage.
  def next_page_va = (first_page + Bits(first_page.type.packed_width())(1)) ++ last_offset
  check.request.ready <== admitting
  check.response.valid <== state === VectorWindowState.Complete
  check.response.bits <== safe
  translation.request.valid <== state === VectorWindowState.Request
  translation.request.bits <== RiscvPageProbeRequest():
    address: mux(second, next_page_va, first)
    store: store

  owned <== (state === VectorWindowState.Owned) & safe
  for (index in 0..2):
    def address = addresses[index]
    def page = address[VectorPageOffsetBits..64]
    def offset = address[0..VectorPageOffsetBits]
    def on_first = page === first_page
    def first_hit = on_first & (offset >= first_offset) & (split ||| (offset <= last_offset))
    def second_hit = split & following_page(first_page, page) & (offset <= last_offset)
    hits[index] <== owned & (first_hit ||| second_hit)
    physical_addresses[index] <== (mux(on_first, first_ppn, last_ppn) ++ offset).zext(64)


  /* Translation proof and endpoint-page permissions.
     A common superpage leaf can supply both endpoint PPNs without a second
     translation, but both physical pages still require permitted PMAs. */

  def result = translation.response.bits
  def same_leaf = sv39_same_page(first, next_page_va, result.page_size)
  def result_ppn = vector_page_number(result.physical_address.zext(64))
  def result_page = (result_ppn ++ Bits(VectorPageOffsetBits)(0)).zext(64)
  def next_page = result_page + Bits(64)(VectorPageBytes)
  def translation_permitted = !result.fault & !result.access_fault & (result.pbmt === PageMemoryType.PMA)
  def first_page_permitted = vector_page_permitted(physical_map, result_page, store)
  def success = translation_permitted & first_page_permitted
  def needs_second = success & !second & split & !same_leaf
  def shared_leaf_permitted = same_leaf & vector_page_permitted(physical_map, next_page, store)


  /* Range lifetime: release, response, admission, probe transfer, decision.
     Release wins. Translation may respond on its own request-transfer edge;
     the range was already captured on an earlier check-admission edge. */

  def offered = check.request.bits
  def start_page = offered.first[VectorPageOffsetBits..64]
  def end_page = offered.last[VectorPageOffsetBits..64]
  def crosses = start_page =/= end_page
  def representable = mux(crosses, following_page(start_page, end_page), offered.first[0..VectorPageOffsetBits] <= offered.last[0..VectorPageOffsetBits])

  when (check.release.valid):
    state <== VectorWindowState.Idle
    safe <== Bool(#false)
  elsewhen (translation.response.valid):
    assert((state === VectorWindowState.Response) ||| translation.request.fire(), "vector_page_result_has_owner")
    when (!second):
      first_ppn <== result_ppn[0..ppn_width]

    safe <== success & (second ||| !split ||| shared_leaf_permitted)
    state <== mux(needs_second, VectorWindowState.Request, VectorWindowState.Complete)
    when (second ||| (success & split & same_leaf)):
      last_ppn <== mux(second, result_ppn, vector_page_number(next_page))[0..ppn_width]

    second <== needs_second
  elsewhen (check.request.fire()):
    first <== offered.first
    last_offset <== offered.last[0..VectorPageOffsetBits]
    split <== crosses
    store <== offered.store
    second <== Bool(#false)
    safe <== Bool(#false)
    state <== mux(representable, VectorWindowState.Request, VectorWindowState.Complete)
  elsewhen (translation.request.fire()):
    state <== VectorWindowState.Response
  elsewhen (check.response.fire()):
    state <== VectorWindowState.Owned

export:
  VectorWindow
  vector_page_permitted
