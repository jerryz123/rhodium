#lang rhodium
/* Defines live architectural translation controls and constructs host/guest lookups without retained pipeline state. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/rtl/pointer-masking.rhdl").PointerMaskControl
  "translation.rhdl" open
  lib("riscv/rtl/hypervisor.rhdl") open
  lib("riscv/rtl/privilege.rhdl") open
  lib("riscv/rtl/sv39.rhdl") open
  lib("riscv/rtl/csr.rhdl") open
  lib("riscv/isa/csr.rhm") open
  lib("riscv/isa/sv39.rhm").Sv39Mode

/* Wraps a virtual memory request with captured guest-access intent, consumed before cache
   dispatch. */
bundle GuestMemoryReq(T :: DataType):
  memory: T
  translation: RiscvGuestMemoryAccess

/* Carries live committed CSR controls without capturing an instruction or defining invalidation.
   Guest state is zero when H is disabled; callers own pointer-mask capture and prefetch cancellation. */
bundle RiscvTranslationState(xlen :: XLen):
  privilege: PrivilegeMode
  mstatus: Bits(xlen.width)
  satp: Bits(xlen.width)
  pbmte: Bool
  guest: RiscvHypervisorTranslation()
  pointer_masking: PointerMaskControl()
  guest_pointer_masking: PointerMaskControl()

/* Captures independently controlled host and guest roots, permissions, and memory-type enables. */
fun riscv_translation_lookup(address :: Bits(64), access :: Sv39Access, privilege :: PrivilegeMode,
                             enabled :: Bool, root_ppn :: Bits(44), sum :: Bool, mxr :: Bool, pbmte :: Bool,
                             guest :: Bool, state :: RiscvHypervisorTranslation()) :~ RiscvTlbLookup():
  def guest_vs_enabled = csr_field(state.vsatp, Satp64Mode) === Bits(4)(Sv39Mode)
  def vs_enabled = mux(guest, guest_vs_enabled, enabled)
  def g_enabled = guest & (csr_field(state.hgatp, Hgatp64Mode) === Bits(4)(Sv39Mode))
  def vs_root = mux(guest, csr_field(state.vsatp, Satp64PPN), root_ppn)
  def g_root = csr_field(state.hgatp, Hgatp64PPN)
  RiscvTlbLookup():
    virtualized: guest
    execute_read: Bool(#false)
    virtual_address: address
    access: access
    context:
      RiscvGuestTranslationContext():
        vs_mode: mux(vs_enabled, RiscvVSMode.Sv39, RiscvVSMode.Bare)
        g_mode: mux(g_enabled, RiscvGMode.Sv39x4, RiscvGMode.Bare)
        vs_root_ppn: vs_root
        g_root_ppn: g_root
        privilege: privilege
        vs_sum: mux(guest, csr_flag(state.vsstatus, MstatusSUM), sum)
        vs_mxr: mux(guest, csr_flag(state.vsstatus, MstatusMXR), mxr)
        hs_mxr: guest & mxr
        vs_pbmte: mux(guest, state.vs_pbmte, pbmte)
        g_pbmte: guest & pbmte

/* Decodes a core's live translation state once for its demand, prefetch, and vector lookup ports.
   Data lookups use the effective privilege of their owner. No lookup is registered here. */
class RiscvTlbLookupBuilder(host_sv39 :: Bool, root_ppn :: Bits(44), sum :: Bool, mxr :: Bool,
                            pbmte :: Bool, guest_state :: RiscvHypervisorTranslation(),
                            normal_data :: RiscvExecutionContext(), supports_guest :: Boolean):
  /* A Bare configuration ignores SATP mode. RV32 supplies zero for unimplemented Sv39 controls. */
  constructor (xlen :: XLen, state :: RiscvTranslationState(xlen), ~sv39: sv39 :: Boolean, ~hypervisor: hypervisor :: Boolean):
    def mode = if sv39 && xlen == XLen.X64 | csr_field(state.satp, Satp64Mode) === Bits(Satp64Mode.width)(Sv39Mode) | Bool(#false)
    def root = if xlen == XLen.X64 | csr_field(state.satp, Satp64PPN) | Bits(Satp64PPN.width)(0)
    def host_sum = if xlen == XLen.X64 | csr_flag(state.mstatus, MstatusSUM) | Bool(#false)
    def host_mxr = if xlen == XLen.X64 | csr_flag(state.mstatus, MstatusMXR) | Bool(#false)
    def guest = if hypervisor | state.guest | literal(RiscvHypervisorTranslation(), 0)
    def normal = effective_data_context(xlen, state.privilege, state.mstatus, ~virtualized: if hypervisor | state.guest.virtualized | #false)
    super(mode, root, host_sum, host_mxr, state.pbmte, guest, normal, hypervisor)

  /* Guest accesses use the VS/G context even when host translation is Bare. */
  method enabled(privilege :: PrivilegeMode, guest :: Bool) :~ Bool:
    guest ||| (host_sv39 & (privilege =/= PrivilegeMode.Machine))

  /* Constructs the complete lookup key used for permission checks, replay, and TLB fills. */
  method lookup(address :: Bits(64), access :: Sv39Access, privilege :: PrivilegeMode, guest :: Bool) :~ RiscvTlbLookup():
    riscv_translation_lookup(address, access, privilege, host_sv39 & (privilege =/= PrivilegeMode.Machine),
                             root_ppn, sum, mxr, pbmte, guest, guest_state)

  /* Ordinary probes use the MPRV context. An explicit guest demand selects SPVP and
     records HLVX execute permission in the same key used by the TLB and walker. */
  method data_lookup(address :: Bits(64), access :: Sv39Access,
                     mode :: RiscvGuestMemoryAccess = RiscvGuestMemoryAccess.Normal) :~ RiscvTlbLookup():
    def owner :: RiscvExecutionContext() = if supports_guest | guest_data_context(normal_data, mode, guest_state.hstatus) | normal_data
    def key = lookup(address, access, owner.privilege, owner.virtualized)
    if supports_guest | key.updated(~execute_read: mode === RiscvGuestMemoryAccess.GuestExecuteRead) | key

export GuestMemoryReq RiscvTranslationState riscv_translation_lookup RiscvTlbLookupBuilder
