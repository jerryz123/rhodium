#lang rhombus
// Checks eight-byte BTB selection through a public eight-entry instance.
// SPDX-License-Identifier: Apache-2.0
import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("riscv/isa/xlen.rhm").XLen
  lib("cores/common/bpred/btb.rhdl").Btb

def program = elaborate(Btb(XLen.X64, 8, ~fetch_bytes: 8))
def bounded_program = elaborate(Btb(XLen.X64, 8, ~fetch_bytes: 8, ~pc_width: 45, ~target_width: 45))
export program bounded_program
