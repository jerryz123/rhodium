#lang rhodium
/* Predicts the earliest taken branch using compact entries and shared upper-address pages. */
// SPDX-License-Identifier: Apache-2.0

import:
  "protocol.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

/* Stores a shared valid upper-address tag used by branch and target entries. */
bundle BtbPage(tag_width :: PosInt):
  valid: Bool
  tag: Bits(tag_width)

/* Stores low PC/target bits, shared-page indices, local direction counter, length, and RAS
   hint. */
bundle BtbEntry(match_bits :: PosInt, page_count :: PosInt):
  valid: Bool
  pc_low: Bits(match_bits)
  pc_page: Bits(index_width(page_count))
  target_low: Bits(match_bits)
  target_page: Bits(index_width(page_count))
  conditional: Bool
  compressed: Bool
  counter: Bits(2)
  ras_action: RasAction

/* Predicts the earliest taken branch in the configured fetch block using full-address matches via shared
   pages.
   Optional caller directions replace local counters before selecting a conditional target.
   pc_width admits only sign-extendable source PCs; target_width normalizes speculative destinations.
   Shared tags span both widths, while source lookup and invalidation remain exact.
   Resolved training precedes discovery; page replacement invalidates all dependent entries. */
sync_circuit Btb(xlen :: XLen, entry_count :: PosInt = 32, match_bits :: PosInt = 14, page_count :: PosInt = 8, ~fetch_bytes: fetch_bytes :: PosInt = 4, ~external_direction: external_direction :: Boolean = #false, ~pc_width: pc_width :: PosInt = xlen.width, ~target_width: target_width :: PosInt = xlen.width):
  // Lookup is combinational; only predictor state changes are event flows.
  unless fetch_bytes == 4 || fetch_bytes == 8
  | error(~who: #'Btb, "fetch bytes must be four or eight")

  def offset_bits = if fetch_bytes == 4 | 2 | 3
  unless pc_width <= xlen.width && target_width <= xlen.width
  | error(~who: #'Btb, "PC and target storage widths must not exceed XLEN")

  unless match_bits >= offset_bits && match_bits < pc_width
  | error(~who: #'Btb, "match bits must include the fetch-word offset and leave an upper source-address tag")

  unless page_count >= 2
  | error(~who: #'Btb, "shared page count must be at least two")

  input cursor: Bits(xlen.width)
  def caller_taken :: Vec(fetch_bytes / 2, Bool) = if external_direction
  | block:
      input conditional_taken: Vec(fetch_bytes / 2, Bool)
      conditional_taken
  | literal(Vec(fetch_bytes / 2, Bool), 0)

  interface invalidate_all(Pulse(), ~role: consumer)
  interface invalidate(Valid(Bits(xlen.width)), ~role: consumer)
  interface update(Valid(BranchUpdate(xlen)), ~role: consumer)
  interface discover(Valid(BranchPrediction(xlen, xlen.width)), ~role: consumer)
  output prediction: BranchPrediction(xlen, xlen.width)

  def index_bits = index_width(entry_count)
  def page_index_bits = index_width(page_count)
  def address_width = math.max(pc_width, target_width)
  def Page = BtbPage(address_width - match_bits)
  def Entry = BtbEntry(match_bits, page_count)


  /* Shared upper-address pages and low-address branch entries.
     Replacement cursors have independent update events. */

  reg pages(~init: vec(for List (_index in 0..page_count): literal(Page, 0)))
  reg entries(~init: vec(for List (_index in 0..entry_count): literal(Entry, 0)))
  reg replacement(~init: Bits(index_bits)(0))
  reg page_replacement(~init: Bits(page_index_bits)(0))
  /* Rejects nonrepresentable source addresses instead of matching or modifying a low-bit alias. */
  fun source_fits(address :: Bits(xlen.width)) :~ Bool:
    address === prediction_target(xlen, pc_width, address)

  /* Restores exact stored source addresses and normalized destinations without an address adder. */
  fun expand_address(address :: Bits(address_width)) :~ Bits(xlen.width):
    address.sext(xlen.width)

  /* Extracts the common-width upper bits of an admitted source or normalized target. */
  fun page_tag(address :: Bits(xlen.width)) :~ Bits(address_width - match_bits):
    address[match_bits..address_width]

  /* Compares stored upper bits; source users separately qualify representability before any effect. */
  fun page_matches(address :: Bits(xlen.width)) :~ Vec(page_count, Bool):
    vec(for List (index in 0..page_count): pages[index].valid & (pages[index].tag === page_tag(address)))


  /* Combinational prediction lookup.
     Choose the earliest halfword at or after the cursor, independently of
     allocation order; equal-offset matches retain priority-encoder order. */

  def cursor_pages = page_matches(cursor)
  def cursor_fits = source_fits(cursor)
  def candidates = vec(
    for List (index in 0..entry_count):
      def entry = entries[index]
      def block_matches = cursor_pages[entry.pc_page] & (entry.pc_low[offset_bits..match_bits] === cursor[offset_bits..match_bits])
      def at_or_after_cursor = entry.pc_low[0..offset_bits] >= cursor[0..offset_bits]
      def direction = if external_direction | caller_taken[entry.pc_low[1..offset_bits]] | entry.counter[1].into(Bool)
      def predicted_taken = !entry.conditional ||| direction
      cursor_fits & entry.valid & pages[entry.target_page].valid & block_matches & at_or_after_cursor & predicted_taken
  )

  def offsets = for List (offset in 0..(fetch_bytes / 2)):
    vec(for List (index in 0..entry_count): candidates[index] & (entries[index].pc_low[0..offset_bits] === Bits(offset_bits)(offset * 2)))

  def mutable earliest = candidates
  // Visit later offsets first so an earlier nonempty offset wins the fold.
  for (offset :: Vec(entry_count, Bool) in offsets.reverse()):
    earliest := mux(offset.any(), offset, earliest)

  def selected = entries[priority_encoder(earliest)]
  prediction <== BranchPrediction(xlen, xlen.width):
    valid: candidates.any() & !invalidate_all.valid
    pc: expand_address(pages[selected.pc_page].tag ++ selected.pc_low)
    // Shared pages can also contain full source PCs. Normalize the lookup
    // even when invalid, keeping downstream speculative storage width-bounded.
    target: prediction_target(xlen, target_width, expand_address(pages[selected.target_page].tag ++ selected.target_low))
    compressed: selected.compressed
    ras_action: selected.ras_action


  /* Both writers inspect the same pre-edge entries, pages and replacement cursors.
     Empty-row choices and the miss cursor do not depend on either writer. */

  def empty = vec(for List (index in 0..entry_count): !entries[index].valid)
  def miss_index = mux(empty.any(), priority_encoder(empty), replacement)
  def empty_pages = vec(for List (index in 0..page_count): !pages[index].valid)
  def first_empty_page = priority_encoder(empty_pages)
  def next_page = wrap_increment(page_replacement, page_count)

  /* A combinational write plan includes decoded row strobes and page dependents,
     so choosing a writer does not start another associative lookup or allocation. */
  bundle WritePlan():
    entry: Entry
    write_entries: Vec(entry_count, Bool)
    clear_entries: Vec(entry_count, Bool)
    write_pc_pages: Vec(page_count, Bool)
    write_target_pages: Vec(page_count, Bool)
    pc_tag: Bits(address_width - match_bits)
    target_tag: Bits(address_width - match_bits)
    advance_entry: Bool
    advance_page: Bool
    next_page_cursor: Bits(page_index_bits)

  /* Prepares one writer without its valid signal. Training can invalidate an
     old match or do nothing on a miss; discovery installs an unconditional entry. */
  fun prepare(pc :: Bits(xlen.width), destination :: Bits(xlen.width), branch :: Bool, taken :: Bool,
              conditional :: Bool, compressed :: Bool, action :: RasAction, ~training: training :: Boolean) :~ WritePlan():
    def target = prediction_target(xlen, target_width, destination)
    def pc_pages = page_matches(pc)
    def target_pages = page_matches(target)
    def matches = vec(
      for List (index in 0..entry_count):
        entries[index].valid & pc_pages[entries[index].pc_page] & (entries[index].pc_low === pc[0..match_bits])
    )

    def matched = matches.any()
    def entry_index = mux(matched, priority_encoder(matches), miss_index)
    def can_write = source_fits(pc) & (matched ||| (branch & taken))
    def counter = if training
    | block:
        def previous = entries[entry_index].counter
        def trained = mux(taken, saturating_increment(previous, 3), saturating_decrement(previous))
        mux(matched, trained, Bits(2)(2))
    | Bits(2)(2)

    /* Protect an existing target page when placing the source; distinct new
       pages must use distinct rows. Allocation never happens for a nonbranch. */
    def pc_found = pc_pages.any()
    def target_found = target_pages.any()
    def same_page = page_tag(pc) === page_tag(target)
    def existing_target = priority_encoder(target_pages)
    def pc_victim = mux(!same_page & target_found & (page_replacement === existing_target), next_page, page_replacement)
    def pc_page = priority_mux(~default: pc_victim):
      pc_found: priority_encoder(pc_pages)
      empty_pages.any(): first_empty_page

    def remaining = vec(for List (i in 0..page_count): empty_pages[i] & (pc_page =/= Bits(page_index_bits)(i)))
    def target_victim = mux(page_replacement === pc_page, next_page, page_replacement)
    def target_page = priority_mux(~default: target_victim):
      same_page: pc_page
      target_found: existing_target
      remaining.any(): priority_encoder(remaining)

    def new_pc = can_write & branch & !pc_found
    def new_target = can_write & branch & !same_page & !target_found
    def pc_rows = vec(for List (i in 0..page_count): new_pc & (pc_page === Bits(page_index_bits)(i)))
    def target_rows = vec(for List (i in 0..page_count): new_target & (target_page === Bits(page_index_bits)(i)))
    def replaced = vec(for List (i in 0..page_count): pages[i].valid & (pc_rows[i] ||| target_rows[i]))
    def entry = BtbEntry(match_bits, page_count):
      valid: branch
      pc_low: pc[0..match_bits]
      pc_page: pc_page
      target_low: target[0..match_bits]
      target_page: target_page
      conditional: conditional
      compressed: compressed
      counter: counter
      ras_action: action

    WritePlan():
      entry: entry
      write_entries: vec(for List (i in 0..entry_count): can_write & (entry_index === Bits(index_bits)(i)))
      clear_entries: vec(for List (i in 0..entry_count): replaced[entries[i].pc_page] ||| replaced[entries[i].target_page])
      write_pc_pages: pc_rows
      write_target_pages: target_rows
      pc_tag: page_tag(pc)
      target_tag: page_tag(target)
      advance_entry: can_write & !matched
      advance_page: new_pc ||| new_target
      next_page_cursor: wrap_increment(mux(new_target, target_page, pc_page), page_count)


  /* Select at the write edge. Even a training no-op owns the port; neither
     a losing candidate nor an explicit invalidation may move a cursor. */

  def u = update.bits
  def d = discover.bits
  def train = prepare(u.pc, u.target, u.branch, u.taken, u.conditional, u.compressed, u.ras_action, ~training: #true)
  def discovery = prepare(d.pc, d.target, Bool(#true), Bool(#true), Bool(#false), d.compressed, d.ras_action, ~training: #false)
  def plan = mux(update.valid, train, discovery)
  def commit = !invalidate.valid & (update.valid ||| (discover.valid & d.valid))

  when (invalidate_all.valid):
    replacement <== Bits(index_bits)(0)
  elsewhen (commit & plan.advance_entry):
    replacement <== wrap_increment(miss_index, entry_count)

  when (invalidate_all.valid):
    page_replacement <== Bits(page_index_bits)(0)
  elsewhen (commit & plan.advance_page):
    page_replacement <== plan.next_page_cursor

  for (i in 0..page_count):
    when (invalidate_all.valid):
      pages[i] <== literal(Page, 0)
    elsewhen (commit & plan.write_pc_pages[i]):
      pages[i] <== BtbPage(address_width - match_bits):
        valid: Bool(#true)
        tag: plan.pc_tag
    elsewhen (commit & plan.write_target_pages[i]):
      pages[i] <== BtbPage(address_width - match_bits):
        valid: Bool(#true)
        tag: plan.target_tag


  /* Targeted invalidation owns the write port even on a miss. Its address
     match changes only validity, never the payload write enable. An installed
     row survives its own page replacement; other page dependents lose validity. */

  def invalidate_pages = page_matches(invalidate.bits)
  def invalidate_fits = source_fits(invalidate.bits)
  def write_payload = mux(invalidate_all.valid, literal(Entry, 0), plan.entry)
  for (i in 0..entry_count):
    def old = entries[i]
    def write_row = commit & plan.write_entries[i]
    def payload = mux(invalidate_all.valid ||| write_row, write_payload, old)
    def invalidate_match = invalidate_fits & invalidate_pages[old.pc_page] & (old.pc_low === invalidate.bits[0..match_bits])
    def next_valid = priority_mux(~default: old.valid):
      invalidate_all.valid ||| (invalidate.valid & invalidate_match): Bool(#false)
      write_row: plan.entry.valid
      commit & plan.clear_entries[i]: Bool(#false)

    entries[i] <== payload.updated(~valid: next_valid)

export:
  BtbPage
  BtbEntry
  Btb
