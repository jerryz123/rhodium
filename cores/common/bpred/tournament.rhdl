#lang rhodium
/* Stores an early bimodal table and late gshare/chooser tables with caller-owned lookup indices. */
// SPDX-License-Identifier: Apache-2.0

import:
  "counter-table.rhdl" open
  "protocol.rhdl" open
  lib("flow/main.rhdl") open

/* Reads S1 bimodal and S2 history/choice banks independently; retired disagreements train the chooser. */
sync_circuit TournamentBht(row_bits :: PosInt = 10):
  input(base_row, gshare_row, choice_row, prefix_gshare_row, prefix_choice_row): Bits(row_bits)
  interface update(Valid(TournamentUpdate(row_bits)), ~role: consumer)
  output(base_taken, gshare_taken, use_gshare): Vec(4, Bool)
  output(prefix_gshare_taken, prefix_use_gshare): Bool


  /* One reset sweep initializes the three memories in parallel. Lookups and
     training addresses remain independent; no instruction restarts the sweep. */

  inst sweep(BhtResetSweep(row_bits))
  inst base(BhtCounterTable(row_bits, 1))
  inst gshare(BhtCounterTable(row_bits, 1))
  inst chooser(BhtCounterTable(row_bits, 0))
  def Array(base_scrub, gshare_scrub, chooser_scrub) = sweep.scrub |> fork_valid(3)
  base_scrub |> base.scrub
  gshare_scrub |> gshare.scrub
  chooser_scrub |> chooser.scrub
  base.row <== base_row
  base.prefix_row <== base_row
  gshare.row <== gshare_row
  gshare.prefix_row <== prefix_gshare_row
  chooser.row <== choice_row
  chooser.prefix_row <== prefix_choice_row


  /* Both direction tables train on each update. Only a disagreement trains
     the chooser, using the saved bimodal index and the observed predictions. */

  def Array(base_update, gshare_update, chooser_update) = update |> fork_valid(3)
  (base_update |> map_valid(result => BhtUpdate(row_bits)):
    index: result.base_index
    taken: result.taken
  ) |> base.update

  (gshare_update |> map_valid(result => BhtUpdate(row_bits)):
    index: result.index
    taken: result.taken
  ) |> gshare.update

  (chooser_update |> filter_valid(result => result.base_taken =/= result.gshare_taken) |> map_valid(result => BhtUpdate(row_bits)):
    index: result.base_index
    taken: result.gshare_taken === result.taken
  ) |> chooser.update

  for (bank in 0..4):
    base_taken[bank] <== base.counters[bank][1].into(Bool)
    gshare_taken[bank] <== gshare.counters[bank][1].into(Bool)
    use_gshare[bank] <== chooser.counters[bank][1].into(Bool)

  prefix_gshare_taken <== gshare.prefix_counter[1].into(Bool)
  prefix_use_gshare <== chooser.prefix_counter[1].into(Bool)

/* Retains the tournament port contract without allocating prediction or chooser state. */
sync_circuit DisabledTournamentBht(row_bits :: PosInt = 10):
  input(base_row, gshare_row, choice_row, prefix_gshare_row, prefix_choice_row): Bits(row_bits)
  interface update(Valid(TournamentUpdate(row_bits)), ~role: consumer)
  output(base_taken, gshare_taken, use_gshare): Vec(4, Bool)
  output(prefix_gshare_taken, prefix_use_gshare): Bool
  base_taken <== literal(Vec(4, Bool), 0)
  gshare_taken <== literal(Vec(4, Bool), 0)
  use_gshare <== literal(Vec(4, Bool), 0)
  prefix_gshare_taken <== Bool(#false)
  prefix_use_gshare <== Bool(#false)

export:
  TournamentBht
  DisabledTournamentBht
