#lang rhombus
// Checks sparse CaseZ lowering of the RV64I ALU control relation.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/backend/circt-target.rhm").circt_target
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../alu-decode.rhdl" as controls

def program = elaborate(controls.RV64IAluInstructionDecoder())
def circt = compile_program(program, circt_target).artifacts[0].content

check:
  circt.contains("sv.constantX : i1") ~is #true
  circt.contains("sv.case casez") ~is #true
  circt.contains("sv.alwayscomb") ~is #true
  circt.contains("sv.bpassign") ~is #true
  circt.contains("comb.icmp eq") ~is #false
  circt.contains("comb.mux") ~is #false
  circt.contains("_case_") ~is #true
