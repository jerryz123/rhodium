#lang rhodium
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/common/register-file.rhdl").RegisterFile
  lib("cores/common/register-write.rhdl").RegisterFileWrite
  lib("riscv/isa/xlen.rhm").XLen
  lib("rhodium/frontend/foundation.rhm").elaborate

sync_circuit RegisterFileFixture(xlen :: XLen):
  input addresses: Vec(4, Bits(5))
  output data: Vec(4, Bits(xlen.width))
  output two_read_data: Vec(2, Bits(xlen.width))
  output three_write_data: Vec(4, Bits(xlen.width))
  input write_valid: Vec(3, Bool)
  input write_values: Vec(3, RegisterFileWrite(xlen))

  inst registers(RegisterFile(xlen, ~read_ports: 4))
  inst two_read_registers(RegisterFile(xlen, ~read_ports: 2))
  inst three_write_registers(RegisterFile(xlen, ~read_ports: 4, ~write_ports: 3))
  registers.read_addresses <== addresses
  data <== registers.read_data
  two_read_registers.read_addresses <== vec(addresses[0], addresses[1])
  two_read_data <== two_read_registers.read_data
  three_write_registers.read_addresses <== addresses
  three_write_data <== three_write_registers.read_data
  for (port in 0..2):
    registers.writes[port].valid <== write_valid[port]
    registers.writes[port].bits <== write_values[port]
    two_read_registers.writes[port].valid <== write_valid[port]
    two_read_registers.writes[port].bits <== write_values[port]

  for (port in 0..3):
    three_write_registers.writes[port].valid <== write_valid[port]
    three_write_registers.writes[port].bits <== write_values[port]

def program = elaborate(RegisterFileFixture(XLen.X64))
def rv32_program = elaborate(RegisterFileFixture(XLen.X32))
export:
  program
  rv32_program
