#lang rhodium
// Implements a width-generic iterative signed or unsigned integer divider.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/ready-valid.rhdl") open
  lib("rhodium/std/bits.rhdl").count_leading_zeros

bundle DividerRequest(width :: PosInt):
  dividend: Bits(width)
  divisor: Bits(width)
  signed_mode: Bool

bundle DividerResponse(width :: PosInt):
  quotient: Bits(width)
  remainder: Bits(width)

// Accepts one request, skips leading-zero quotient work, resolves each remaining
// quotient bit per cycle, and finalizes signs on a separate cycle. Trivial
// operands complete directly. Division by zero returns an all-one quotient and
// the original dividend; signed overflow wraps to the fixed-width minimum.
sync_circuit IterativeDivider(width :: PosInt):
  def remainder_width = width + 1
  def count_width = index_width(width)

  interface request(Decoupled(DividerRequest(width)), ~role: consumer)
  interface response(Irrevocable(DividerResponse(width)), ~role: producer)

  reg active(~init: Bool(#false))
  reg finalizing(~init: Bool(#false))
  reg count(~init: bits(0, count_width))
  reg dividend(Bits(width))
  reg divisor(Bits(width))
  reg partial_remainder(Bits(remainder_width))
  reg negate_quotient(Bool)
  reg negate_remainder(Bool)
  reg response_valid(~init: Bool(#false))
  reg response_bits(DividerResponse(width))

  request.ready <== !active & !finalizing & (!response_valid ||| response.ready)
  response.valid <== response_valid
  response.bits <== response_bits

  def request_fire = request.fire()
  def response_fire = response.fire()
  def dividend_negative = request.bits.signed_mode & request.bits.dividend[width - 1].into(Bool)
  def divisor_negative = request.bits.signed_mode & request.bits.divisor[width - 1].into(Bool)
  def dividend_magnitude = mux(dividend_negative, -request.bits.dividend, request.bits.dividend)
  def divisor_magnitude = mux(divisor_negative, -request.bits.divisor, request.bits.divisor)
  def request_negate_quotient = dividend_negative ^ divisor_negative
  def request_negate_remainder = dividend_negative
  def divisor_zero = !divisor_magnitude.or_reduce()
  def divisor_one = divisor_magnitude === bits(1, width)
  def dividend_smaller = dividend_magnitude < divisor_magnitude
  def dividend_equal = dividend_magnitude === divisor_magnitude
  def direct_result = divisor_zero ||| divisor_one ||| dividend_smaller ||| dividend_equal
  def signed_dividend_magnitude = mux(request_negate_quotient, -dividend_magnitude, dividend_magnitude)
  def signed_one = mux(request_negate_quotient, -bits(1, width), bits(1, width))
  def direct_quotient = priority_mux(~default: bits(0, width)):
    divisor_zero: !bits(0, width)
    divisor_one: signed_dividend_magnitude
    dividend_equal: signed_one
  def direct_remainder = mux(divisor_zero ||| dividend_smaller, request.bits.dividend, bits(0, width))
  def dividend_leading_zeros = count_leading_zeros(dividend_magnitude)
  def initial_count = dividend_leading_zeros[0..count_width]
  def aligned_dividend = dividend_magnitude << dividend_leading_zeros
  def shifted_remainder :: Bits(remainder_width) = (partial_remainder[0..width] ++ dividend[width - 1])
  def extended_divisor = divisor.zext(remainder_width)
  def difference :: Bits(remainder_width) = shifted_remainder - extended_divisor
  def quotient_bit :: Bool = !difference[width].into(Bool)
  def next_remainder :: Bits(remainder_width) = mux(quotient_bit, difference, shifted_remainder)
  def next_dividend :: Bits(width) = (dividend << 1) ||| quotient_bit.as_bits().zext(width)
  def quotient_value = mux(negate_quotient, -dividend, dividend)
  def remainder_magnitude :: Bits(width) = partial_remainder[0..width]
  def remainder_value = mux(negate_remainder, -remainder_magnitude, remainder_magnitude)
  def last_iteration = count === bits(width - 1, count_width)

  when (request_fire & direct_result):
    active <== Bool(#false)
    finalizing <== Bool(#false)
    response_valid <== Bool(#true)
    response_bits <== DividerResponse(width):
      quotient: direct_quotient
      remainder: direct_remainder
  elsewhen request_fire:
    active <== Bool(#true)
    finalizing <== Bool(#false)
    count <== initial_count
    dividend <== aligned_dividend
    divisor <== divisor_magnitude
    partial_remainder <== bits(0, remainder_width)
    negate_quotient <== request_negate_quotient
    negate_remainder <== request_negate_remainder
    response_valid <== Bool(#false)
  elsewhen (active & last_iteration):
    active <== Bool(#false)
    finalizing <== Bool(#true)
    dividend <== next_dividend
    partial_remainder <== next_remainder
  elsewhen finalizing:
    finalizing <== Bool(#false)
    response_valid <== Bool(#true)
    response_bits <== DividerResponse(width):
      quotient: quotient_value
      remainder: remainder_value
  elsewhen active:
    count <== count + bits(1, count_width)
    dividend <== next_dividend
    partial_remainder <== next_remainder
  elsewhen response_fire:
    response_valid <== Bool(#false)

export:
  DividerRequest
  DividerResponse
  IterativeDivider
