#lang rhodium
/* Returns one snoop-visible victim through a retryable full-line CHI copyback. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../geometry.rhdl" open
  "flits.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open
  lib("chi/protocol/flits.rhdl") open
  lib("chi/protocol/coherence.rhdl") open
  lib("chi/protocol/protocol.rhdl").chi_transfer_data_id
  lib("chi/protocol/messages.rhdl").chi_rn_copyback_data
  lib("chi/transactions/retryable-transaction.rhdl") open

/* Captures the victim line/address and opaque caller context for full-line copyback. */
bundle CacheLineWritebackCommand(Context :: DataType, address_width :: PosInt):
  line_address: Bits(address_width)
  line: Vec(CacheLineBytes / 8, Bits(64))
  context: Context

/* Returns the retained context after all copyback data packets are handed off. */
bundle CacheLineWritebackResult(Context :: DataType):
  context: Context

/* Retries WriteBackFull while the victim remains snoop-visible; freezes its latest state at
   grant.
   After CompDBIDResp, sends every line packet and retains completion until accepted. */
sync_circuit CacheLineWriteback(Context :: DataType, address_width :: PosInt, config :: RiscvHartCHIConfig, txn_id :: Nat):
  def p = config.flit
  def packets = CacheLineBytes / p.data_bytes
  def packet_width = index_width(packets)
  input node_id: Bits(p.node_id_width)
  // Cache-owned state may change under snoops until the grant is accepted.
  input victim_state: CHICacheState
  input snoop_pending: Bool
  output granted: Bool
  interface command(Decoupled(CacheLineWritebackCommand(Context, address_width)), ~role: consumer)
  interface completion(Irrevocable(CacheLineWritebackResult(Context)), ~role: producer)
  interface requests(Decoupled(CHIReqFlit(p)), ~role: producer)
  interface data(Decoupled(CHIDatFlit(p)), ~role: producer)
  interface responses(Decoupled(CHIRspFlit(p)), ~role: consumer)


  /* Retained victim command.
     The cache keeps the victim snoop-visible until grant; this owner retains its data and context. */

  inst control(CHIRetryableTransactionControl(p, CacheCopyBackResponses))
  reg line_address(Bits(address_width))
  reg line(Vec(packets, Bits(p.data_width)))
  reg context(Context)
  reg home_id(Bits(p.node_id_width))
  reg dbid(Bits(12))
  reg response_state(Bits(3))
  reg packet_index(~init: Bits(packet_width)(0))
  reg data_sent(~init: Bool(#false))
  def returning = command |> trace_event("dcache/writeback", ~residency: "data", ~fields: request):
    address: request.line_address

  returning.ready <== !control.active
  def command_fire = command.fire()
  def command_home = config.home_map.lookup(cache_chi_address(command.bits.line_address, p))
  when command_fire:
    assert(command_home.valid, "copyback_address_has_home")
    assert(command.bits.line_address.is_aligned(CacheLineBytes), "copyback_line_aligned")
    assert(cache_chi_address_fits(command.bits.line_address, p), "copyback_address_fits_chi")
    line_address <== command.bits.line_address
    line <== command.bits.line.as_bits().as_vec(Bits(p.data_width))
    context <== command.bits.context
    home_id <== command_home.node_id


  /* Request retry and grant-time state capture.
     Snoop activity delays the grant, not retry/credit handling, so the latest state is frozen. */

  control.attempt
    |> map_flow(attempt => cache_chi_request(
      p, node_id, home_id, line_address, CHITransferSize.Bytes64, CHIReqOpcode.WriteBackFull,
      Bits(12)(txn_id), Bool(#false), Bool(#true), attempt.allow_retry, attempt.pcrd_type
    ))
    |> requests
  def retry_or_credit = responses.bits.opcode.is_one_of(CHIRspOpcode.RetryAck, CHIRspOpcode.PCrdGrant)
  def response_can_advance = !snoop_pending ||| retry_or_credit
  responses |> gate_flow(response_can_advance) |> control.response
  def response = control.event.bits.flit
  def grant = control.event.valid & CacheCopyBackResponses.milestone(control.event.bits.effects, "grant")
  granted <== CacheCopyBackResponses.milestone(control.received, "grant")
  when (control.event.valid):
    assert(response.src_id === home_id, "copyback_response_home")
    assert(response.tgt_id === node_id, "copyback_response_target")
    assert(response.resp_err === CHIRespErr.OK, "copyback_response_ok")
    when (!control.event.bits.protocol_credit):
      assert(response.txn_id === Bits(12)(txn_id), "copyback_response_txn")

  when grant:
    assert(response.resp === Bits(3)(0), "copyback_completion_has_no_state")
    assert(victim_state =/= CHICacheState.UniqueDirtyPartial, "copyback_complete_dirty_line")
    dbid <== response.dbid_or_group_id
    def granted_response_state :: CHIResponseState = priority_mux(~default: CHIResponseState.SharedClean):
      !victim_state.is_valid(): CHIResponseState.Invalid
      victim_state.is_unique(): CHIResponseState.Unique
      victim_state.is_dirty(): CHIResponseState.SharedDirty

    def coherent_response = CHICoherentResponse():
      pass_dirty: victim_state.is_dirty()
      state: granted_response_state

    response_state <== coherent_response.as_bits()


  /* Granted packet stream and caller completion.
     Only accepted data advances the packet cursor; final handoff precedes completion release. */

  data.valid <== granted & !data_sent
  def packet_number = if packet_width == 2 | packet_index | packet_index.zext(2)
  data.bits <== chi_rn_copyback_data(p, node_id, home_id, dbid, chi_transfer_data_id(packet_number, p), line[packet_index], response_state)
  def final_packet = packet_index === Bits(packet_width)(packets - 1)
  def final_data = data.fire() & final_packet
  completion.valid <== control.active & data_sent
  completion.bits <== CacheLineWritebackResult(Context):
    context: context

  control.start <== command_fire
  control.finish <== completion.fire()
  control.external_progress <== data.fire()
  describe_interface_retained_storage(command_fire, completion.fire(), control.active)
  describe_interface_contract(returning, Array(control.attempt, data, completion), "copyback-outputs", ~trace_model: interface_trace_retained(~outputs: 3))
  when command_fire:
    packet_index <== Bits(packet_width)(0)
    data_sent <== Bool(#false)
  elsewhen final_data:
    data_sent <== Bool(#true)
  elsewhen (data.fire()):
    packet_index <== packet_index + Bits(packet_width)(1)

export:
  CacheLineWritebackCommand
  CacheLineWritebackResult
  CacheLineWriteback
