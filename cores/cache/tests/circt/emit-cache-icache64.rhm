#lang rhombus
// Defines the shared instruction cache with 64-bit fetch blocks for behavioral validation.
// SPDX-License-Identifier: Apache-2.0
import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../../riscv/isa/xlen.rhm" open
  "../../l1i/cache.rhdl" open
  "../../config.rhm" open
  "../params.rhdl" open
def program = elaborate(L1ICache(XLen.X64, CacheConfig(4, 2), ~chi: test_instruction_cache_config, ~fetch_bits: 64))
export program
