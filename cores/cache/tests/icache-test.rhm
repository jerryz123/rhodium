#lang rhombus
// Checks shared instruction-cache geometry, public protocol types, and invalid configuration.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  "../../../rhodium/core/main.rhm" open
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../riscv/isa/xlen.rhm" open
  "../geometry.rhdl" open
  "../l1i/cache.rhdl" as l1i
  "../l1i/protocol.rhdl" as protocol
  "params.rhdl" as test_params
  "../chi/flits.rhdl" open
  "../../../riscv/rtl/pma.rhdl" open
  "../../../rhodium/std/interconnect.rhdl".AddressSet

def config = test_params.test_cache_chi_config
def direct_cache = CacheConfig(8, 1)
def associative_cache = CacheConfig(8, 2)
def instruction_design = compile_program(elaborate(l1i.L1ICache(XLen.X64, direct_cache, ~chi: config, ~fetch_bits: 32)), rtl_target).report.design
def instruction_cache = instruction_design.modules.find(fun (module_def): module_def.name == "L1ICache")
def rv32_instruction_design = compile_program(elaborate(l1i.L1ICache(XLen.X32, direct_cache, ~chi: config, ~fetch_bits: 32)), rtl_target).report.design
def rv32_instruction_cache = rv32_instruction_design.modules.find(fun (module_def): module_def.name == "L1ICache")
def wide_design = compile_program(elaborate(l1i.L1ICache(XLen.X32, direct_cache, ~chi: config, ~fetch_bits: 64)), rtl_target).report.design
def wide_cache = wide_design.modules.find(fun (module_def): module_def.name == "L1ICache")
def instruction_access_type = protocol.InstructionCacheLookup(64, 32)
def instruction_request_member = instruction_access_type.members.find(
  fun (member): member.name == "request"
)
def instruction_response_member = instruction_access_type.members.find(
  fun (member): member.name == "response"
)
check:
  wide_cache.find_output("core_out").type.field("response").type.field("bits").type.field("data").type.width ~is 64
  elaborate(l1i.L1ICache(XLen.X64, direct_cache, ~chi: config, ~fetch_bits: 48)) ~throws "fetch block"
  RiscvHartCHIConfig(
    config.flit,
    64,
    [RiscvHartCHIRegion(
       RiscvPhysicalMemoryRegion(AddressSet(0, 0x7fff), RiscvPhysicalMemoryAttributes(#true, #true, #true, #true, #true, #false, #true, ~instruction_cacheable: #false)),
       test_params.test_cache_home)]
  ) ~throws "coherent hart regions require instruction cacheability"
  RiscvHartCHIConfig(
    config.flit,
    64,
    [test_params.test_cache_uncached_config.regions[0],
     RiscvHartCHIRegion(
       RiscvPhysicalMemoryRegion(AddressSet(0xc000, 31), RiscvPhysicalMemoryAttributes(#true, #false, #true, #false, #false, #false, #true, ~instruction_cacheable: #true)),
       test_params.test_cache_uncached_home)]
  ) ~throws "complete cache lines"
  associative_cache.set_width ~is 3
  associative_cache.way_width ~is 1
  associative_cache.line_count ~is 16
  associative_cache.capacity_bytes ~is 1024
  instruction_request_member.type.name ~is "Valid"
  instruction_response_member.type.name ~is "Valid"
  scalar_width(instruction_cache.find_input("core_in").type.field("flush").type) ~is 1
  scalar_width(instruction_cache.find_input("core_in").type.field("invalidate_all").type) ~is 1
  instruction_cache.find_input("core_in").type.field("request").type.field("bits").type.field("address").type.width ~is 64
  instruction_cache.find_input("prefetch_in").type.field("bits").type.field("address").type.width ~is 64
  instruction_cache.find_input("virtual_lookup_in").type.field("bits").type.width ~is 64
  scalar_width(instruction_cache.find_output("virtual_lookup_out").type.field("ready").type) ~is 1
  instruction_cache.find_output("core_out").type.field("response").type.field("bits").type.field("data").type.width ~is 32
  instruction_cache.find_output("chi_out").type.field("req").type.field("bits").type.field("address").type.width ~is 44
  rv32_instruction_cache.find_input("core_in").type.field("request").type.field("bits").type.field("address").type.width ~is 32
  rv32_instruction_cache.find_input("prefetch_in").type.field("bits").type.field("address").type.width ~is 32
  rv32_instruction_cache.find_input("virtual_lookup_in").type.field("bits").type.width ~is 32
  scalar_width(rv32_instruction_cache.find_output("virtual_lookup_out").type.field("ready").type) ~is 1
  rv32_instruction_cache.find_output("core_out").type.field("response").type.field("bits").type.field("data").type.width ~is 32
  elaborate(CacheConfig(3, 1)) ~throws "Pow2Int"
  elaborate(CacheConfig(1, 1)) ~throws "set count"
