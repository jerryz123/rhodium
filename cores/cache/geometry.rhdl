#lang rhodium
/* Defines way and lane selection for shared fixed-line cache geometry. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/bits.rhdl") open
  "config.rhm" open

/* Selects real ways matching a binary index; an unused encoded index selects no way. */
fun cache_way_mask(config :: CacheConfig,
                   way :: Bits(config.way_width)) :: Mask(config.ways):
  vec(
    for List (index in 0..config.ways):
      way === Bits(config.way_width)(index)
  ).into(Mask(config.ways))

/* Replicates a lane mask only into the selected way of a way-major packed array. */
fun cache_lane_mask(config :: CacheConfig,
                    way :: Bits(config.way_width),
                    lanes :: PosInt,
                    lane_mask :: Mask(lanes)) :: Mask(config.ways * lanes):
  vec(
    for List (index in 0..(config.ways * lanes)):
      def selected_way = way === Bits(config.way_width)(index div lanes)
      selected_way & lane_mask[index % lanes]
  ).into(Mask(config.ways * lanes))

export:
  CacheLineBytes
  CacheConfig
  cache_way_mask
  cache_lane_mask
