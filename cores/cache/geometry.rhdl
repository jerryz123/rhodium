#lang rhodium
/* Defines word positions and way/lane selection for shared fixed-line caches. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/bits.rhdl") open
  lib("riscv/isa/xlen.rhm").XLen
  "config.rhm" open

/* Counts XLEN-sized words in one complete cache line. */
fun cache_line_words(xlen :: XLen) :: PosInt: CacheLineBytes * 8 / xlen.width

/* One returned cache-array word and its position within the owner's dirty line. */
bundle CacheGatherWord(xlen :: XLen):
  index: Bits(index_width(cache_line_words(xlen)))
  data: Bits(xlen.width)

/* Selects real ways matching a binary index; an unused encoded index selects no way. */
fun cache_way_mask(config :: CacheConfig,
                   way :: Bits(config.way_width)) :: Mask(config.ways):
  vec(
    for List (index in 0..config.ways):
      way === Bits(config.way_width)(index)
  ).into(Mask(config.ways))

/* Replicates a lane mask only into the selected way of a way-major packed array. */
fun cache_lane_mask(config :: CacheConfig,
                    way :: Bits(config.way_width),
                    lanes :: PosInt,
                    lane_mask :: Mask(lanes)) :: Mask(config.ways * lanes):
  vec(
    for List (index in 0..(config.ways * lanes)):
      def selected_way = way === Bits(config.way_width)(index div lanes)
      selected_way & lane_mask[index % lanes]
  ).into(Mask(config.ways * lanes))

export:
  CacheLineBytes
  CacheConfig
  CacheGatherWord
  cache_line_words
  cache_way_mask
  cache_lane_mask
