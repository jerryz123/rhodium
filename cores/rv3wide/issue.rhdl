#lang rhodium
/* Admits an ordered three-instruction prefix onto three dedicated reads, one floating read, and two write ports. */
// SPDX-License-Identifier: Apache-2.0

/* Describes decoded resource use and externally resolved dependency readiness for one age slot. */
bundle RV3WideIssueCandidate():
  valid: Bool
  ready: Bool
  rs1: Bits(5)
  rs2: Bits(5)
  uses_rs1: Bool
  uses_rs2: Bool
  rd: Bits(5)
  write: Bool
  normal_write: Bool
  deferred: Bool
  memory: Bool
  branch: Bool
  serializing: Bool

/* Selects the longest executable prefix without lending idle dedicated read ports.
   Same-group RAWs split the group. Deferred destinations cannot coalesce with
   another writer; ordinary destinations may coalesce only at successful WB. */
sync_circuit RV3WideIssue():
  input candidates: Vec(3, RV3WideIssueCandidate())
  input normal_write_ports: Bits(2)
  input drained: Bool
  output count: Bits(2)
  output read_addresses: Vec(4, Bits(5))
  output first_is_rs2: Vec(3, Bool)
  output second_read: Vec(3, Bool)

  def first_used = for List (lane in 0..3): candidates[lane].uses_rs1 & candidates[lane].rs1.any()
  def second_used = for List (lane in 0..3): candidates[lane].uses_rs2 & candidates[lane].rs2.any()
  def extra = for List (lane in 0..3): first_used[lane] & second_used[lane] & (candidates[lane].rs1 =/= candidates[lane].rs2)
  def writes = for List (lane in 0..3): candidates[lane].write & candidates[lane].rd.any()

  // This ordered elaboration fold builds prefix admission, not an instruction scheduler.
  def mutable prefix = Bool(#true)
  def mutable reads_taken = Bool(#false)
  def mutable memory_taken = Bool(#false)
  def mutable branch_taken = Bool(#false)
  def mutable deferred_taken = Bool(#false)
  def mutable serializing_taken = Bool(#false)
  def mutable writer_count = Bits(2)(0)
  def mutable accepted = []
  for (lane in 0..3):
    def candidate :: RV3WideIssueCandidate() = candidates[lane]
    def dependencies = for List (older in 0..lane):
      writes[older] & ((first_used[lane] & (candidates[older].rd === candidate.rs1)) ||| (second_used[lane] & (candidates[older].rd === candidate.rs2)))

    def raw = any(dependencies)
    def same_destination = for List (older in 0..lane): writes[older] & (candidates[older].rd === candidate.rd)
    def deferred_waw = writes[lane] & any(for List (older in 0..lane): same_destination[older] & (candidate.deferred ||| candidates[older].deferred))
    def previous_normal = for List (older in 0..lane): same_destination[older] & candidates[older].normal_write
    def new_writer = writes[lane] & candidate.normal_write & !any(previous_normal)
    def next_writers = writer_count + new_writer.as_bits().zext(2)
    def resources = !(extra[lane] & reads_taken) & !(candidate.memory & memory_taken) & !(candidate.branch & branch_taken) & !(candidate.deferred & deferred_taken)
    def alone = !serializing_taken & (!candidate.serializing ||| (Bool(lane == 0) & drained))
    def admit = prefix & candidate.valid & candidate.ready & !raw & !deferred_waw & resources & alone & (next_writers <= normal_write_ports)
    accepted := accepted ++ [admit]
    prefix := admit
    reads_taken := reads_taken ||| extra[lane]
    memory_taken := memory_taken ||| candidate.memory
    branch_taken := branch_taken ||| candidate.branch
    deferred_taken := deferred_taken ||| candidate.deferred
    serializing_taken := serializing_taken ||| candidate.serializing
    writer_count := next_writers

  def accepted_lanes :: Vec(3, Bool) = vec(accepted)
  count <== accepted_lanes[0].as_bits().zext(2) + accepted_lanes[1].as_bits().zext(2) + accepted_lanes[2].as_bits().zext(2)
  for (lane in 0..3):
    read_addresses[lane] <== mux(first_used[lane], candidates[lane].rs1, mux(second_used[lane], candidates[lane].rs2, Bits(5)(0)))
    first_is_rs2[lane] <== !first_used[lane] & second_used[lane]
    second_read[lane] <== extra[lane]

  read_addresses[3] <== priority_mux(~default: Bits(5)(0)):
    accepted[0] & extra[0]: candidates[0].rs2
    accepted[1] & extra[1]: candidates[1].rs2
    accepted[2] & extra[2]: candidates[2].rs2

  assert(normal_write_ports <= Bits(2)(2), "rv3wide_two_physical_writes")

export:
  RV3WideIssueCandidate
  RV3WideIssue
