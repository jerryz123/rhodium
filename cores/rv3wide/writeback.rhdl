#lang rhodium
/* Coalesces successfully retiring GPR writes without discarding per-instruction retirement observations. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("riscv/isa/xlen.rhm").XLen
  "../register-write.rhdl".RegisterFileWrite
  lib("flow/main.rhdl") open

/* Packs up to three age-ordered successful normal writes onto two RF ports.
   A younger successful writer suppresses an older identical destination.
   Deferred completion owns port one and must have a distinct scoreboard owner. */
sync_circuit RV3WideWriteback():
  interface retiring[3](Valid(RegisterFileWrite(XLen.X64)), ~role: consumer)
  interface completed(Valid(RegisterFileWrite(XLen.X64)), ~role: consumer)
  interface writes[2](Valid(RegisterFileWrite(XLen.X64)), ~role: producer)
  output surviving: Vec(3, Bool)

  def live = for List (lane in 0..3): retiring[lane].valid & retiring[lane].bits.address.any()
  def winner_list = for List (lane in 0..3):
    live[lane] & !any(for List (younger in (lane + 1)..3): live[younger] & (retiring[lane].bits.address === retiring[younger].bits.address))

  def winners :: Vec(3, Bool) = vec(winner_list)
  def completion = completed.valid & completed.bits.address.any()
  def normal_count = winners[0].as_bits().zext(3) + winners[1].as_bits().zext(3) + winners[2].as_bits().zext(3)
  surviving <== winners
  writes[0].valid <== winners.any()
  writes[0].bits <== priority_mux(~default: retiring[2].bits):
    winners[0]: retiring[0].bits
    winners[1]: retiring[1].bits

  writes[1].valid <== completion ||| (normal_count === Bits(3)(2))
  writes[1].bits <== priority_mux(~default: retiring[2].bits):
    completion: completed.bits
    winners[0] & winners[1]: retiring[1].bits

  assert(normal_count + completion.as_bits().zext(3) <= Bits(3)(2), "rv3wide_writeback_capacity")
  for (lane in 0..3):
    assert(!(completion & live[lane] & (completed.bits.address === retiring[lane].bits.address)), "rv3wide_deferred_destination_interlock")

export RV3WideWriteback
