import:
  "../dispatch-routing.rhdl".DistributedRouteFixture
  lib("cores/common/vector/backend-kind.rhm") open
  lib("cores/common/vector/distributed/backend/dispatch.rhdl").DistributedVectorDispatch
  lib("cores/superscalar/tests/vector-fixture.rhdl").SuperscalarVectorFixture
  lib("riscv/isa/xlen.rhm").XLen
  lib("rhodium/frontend/foundation.rhm").elaborate

def queues = elaborate(DistributedVectorDispatch(XLen.X64, 4))
def program = elaborate(SuperscalarVectorFixture(~vlen: 128, ~vector_backend: VectorBackendKind.Distributed))
fun geometry(xlen, vlen):
  elaborate(SuperscalarVectorFixture(~xlen: xlen, ~vlen: vlen, ~vector_backend: VectorBackendKind.Distributed))
def smallest = geometry(XLen.X32, 64)
def rv32 = geometry(XLen.X32, 128)
def wider = geometry(XLen.X64, 512)
def route32 = elaborate(DistributedRouteFixture(XLen.X32))
def route64 = elaborate(DistributedRouteFixture(XLen.X64))
export:
  route32
  route64
  queues
  program
  smallest
  rv32
  wider
