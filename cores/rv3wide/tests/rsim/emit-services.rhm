#lang rhombus
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/fp-profile.rhm").FloatingPointProfile
  lib("riscv/isa/vector-profile.rhm").VectorProfile
  lib("cores/fp/timing.rhdl").FpExecutionTiming
  lib("cores/superscalar/core.rhdl").SuperscalarCore
  lib("cores/superscalar/profile.rhm").SuperscalarPipelineConfig
  "../../issue.rhdl".RV3WideIssue

def program = elaborate(SuperscalarCore(
  SuperscalarPipelineConfig(~floating_point: FloatingPointProfile.D, ~vector: VectorProfile.V),
  ~fp_timing: FpExecutionTiming(3, 5, 2), ~issue: RV3WideIssue(XLen.X64)
))
export program
