#lang rhodium
/* Wires RV3Wide's fixed 4R2W register geometry, full forwarding, and qualified retirement coalescing. */
// SPDX-License-Identifier: Apache-2.0

import:
  "issue.rhdl" open
  "writeback.rhdl".RV3WideWriteback
  "../register-file.rhdl".RegisterFile
  "../register-write.rhdl".RegisterFileWrite
  lib("riscv/isa/xlen.rhm").XLen
  lib("flow/main.rhdl") open

/* Describes a live older GPR owner; unavailable youngest matches block stale fallback. */
bundle RV3WideProducer():
  valid: Bool
  rd: Bits(5)
  data: Bits(64)
  ready: Bool

/* Separates operand readiness from its combinational value. */
bundle RV3WideOperand():
  ready: Bool
  data: Bits(64)

/* Selects from oldest to youngest, retaining an unavailable youngest owner's interlock. */
fun rv3wide_forward(address :: Bits(5), stored :: Bits(64), producers :: Vec(9, RV3WideProducer())) :~ RV3WideOperand():
  def mutable data = stored
  def mutable ready = Bool(#true)
  for (index in 0..9):
    def producer :: RV3WideProducer() = producers[index]
    def matched = producer.valid & (producer.rd === address)
    data := mux(matched, producer.data, data)
    ready := mux(matched, producer.ready, ready)

  RV3WideOperand():
    ready: !address.any() ||| ready
    data: mux(address.any(), data, Bits(64)(0))

/* Connects three dedicated reads and one floating read to shared unreset storage.
   Producers are WB[oldest..youngest], MEM[oldest..youngest], EX[oldest..youngest].
   Pending deferred writes interlock destinations until their actual RF write;
   the completion bypass supplies same-cycle source reads without adding a RF port. */
sync_circuit RV3WideRegisterAccess():
  input candidates: Vec(3, RV3WideIssueCandidate())
  input producers: Vec(9, RV3WideProducer())
  input pending: Mask(32)
  input normal_write_ports: Bits(2)
  input drained: Bool
  interface retiring[3](Valid(RegisterFileWrite(XLen.X64)), ~role: consumer)
  interface completed(Valid(RegisterFileWrite(XLen.X64)), ~role: consumer)
  output count: Bits(2)
  output operands: Vec(3, Vec(2, Bits(64)))

  inst issue(RV3WideIssue())
  inst registers(RegisterFile(XLen.X64, ~read_ports: 4))
  inst writeback(RV3WideWriteback())
  for (lane in 0..3):
    retiring[lane] |> writeback.retiring[lane]

  completed |> writeback.completed
  for (port in 0..2):
    writeback.writes[port] |> registers.writes[port]

  registers.read_addresses <== issue.read_addresses
  issue.normal_write_ports <== normal_write_ports
  issue.drained <== drained
  count <== issue.count

  for (lane in 0..3):
    def candidate :: RV3WideIssueCandidate() = candidates[lane]
    def source_addresses :: Vec(2, Bits(5)) = vec(candidate.rs1, candidate.rs2)
    def used :: Vec(2, Bool) = vec(candidate.uses_rs1, candidate.uses_rs2)
    def source_results = for List (source in 0..2):
      def address :: Bits(5) = source_addresses[source]
      def stored = mux(Bool(source == 1) & issue.second_read[lane], registers.read_data[3], registers.read_data[lane])
      // Both current RF writes are older than resident EX/MEM/WB producers.
      def mutable bypassed = stored
      for (port in 0..2):
        def writing = writeback.writes[port]
        bypassed := mux(writing.valid & (writing.bits.address === address), writing.bits.data, bypassed)

      def forwarded = rv3wide_forward(address, bypassed, producers)
      def completing = completed.valid & (completed.bits.address === address)
      RV3WideOperand():
        ready: !used[source] ||| !address.any() ||| (forwarded.ready & (!pending[address] ||| completing))
        data: forwarded.data

    def resolved :: Vec(2, RV3WideOperand()) = vec(source_results)
    operands[lane] <== vec(resolved[0].data, resolved[1].data)
    def pending_destination = pending[candidate.rd] ||| any(for List (index in 0..9): producers[index].valid & !producers[index].ready & (producers[index].rd === candidate.rd))
    def waw = candidate.write & candidate.rd.any() & pending_destination
    issue.candidates[lane] <== candidate.updated(~ready: candidate.ready & resolved[0].ready & resolved[1].ready & !waw)

export:
  RV3WideProducer
  RV3WideRegisterAccess
