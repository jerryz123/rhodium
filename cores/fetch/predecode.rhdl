#lang rhodium
/* Shares length, legality, control-flow classification, and immediate expansion across fetch consumers. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").StableCircuitParam
  lib("riscv/isa/c.rhm").CompressedExtension
  lib("riscv/isa/fp-profile.rhm").FloatingPointProfile
  lib("cores/bpred/protocol.rhdl") open
  lib("cores/bpred/ras.rhdl").riscv_ras_action
  lib("riscv/isa/xlen.rhm").XLen
  "encoding.rhdl" open
  lib("riscv/model/formats.rhm") as fields
  lib("riscv/rtl/instruction-fields.rhdl").instruction_immediate

/* Captures the ISA expansion domain and available early target sources, without named-core pipeline policy. */
class FetchDecodeConfig(xlen :: XLen, floating_point :: FloatingPointProfile, compressed :: List.of(CompressedExtension), instructions :: List.of(String), direct_targets :: Boolean, ras :: Boolean):
  implements StableCircuitParam

/* Expands one candidate without asserting a parcel boundary. Legal excludes compressed-expansion
   failures, not all illegal instructions; full-width control classification also checks funct3. */
circuit FetchPredecode(profile :: FetchDecodeConfig):
  def xlen = profile.xlen
  input raw: Bits(32)
  output canonical: Bits(32)
  output(compressed, legal, control_flow, conditional, immediate): Bool
  output offset: Bits(xlen.width)
  output action: RasAction
  def encoding = expand_fetched_instruction(xlen, profile.floating_point, profile.compressed, profile.instructions, raw)
  compressed <== encoding.compressed
  canonical <== encoding.canonical
  legal <== !encoding.compressed_illegal
  def shape = fetch_opcode_control(canonical[0..7])
  conditional <== legal & shape.conditional & !canonical[12..15].is_one_of(Bits(3)(2), Bits(3)(3))
  def direct = legal & shape.direct
  immediate <== direct ||| conditional
  control_flow <== immediate ||| (legal & shape.indirect & (canonical[12..15] === Bits(3)(0)))
  offset <== mux(direct, instruction_immediate(fields.JImmediate, canonical, xlen.width), instruction_immediate(fields.BImmediate, canonical, xlen.width))
  action <== mux(control_flow, riscv_ras_action(canonical), RasAction.None)

export:
  FetchDecodeConfig
  FetchPredecode
