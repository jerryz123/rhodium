#lang rhodium
/* Defines block and instruction-relative fetch faults with precise parcel and guest provenance. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/rtl/trap.rhdl").ExceptionCause
  lib("riscv/rtl/hypervisor.rhdl").RiscvGuestFault

/* Restricts architectural causes to fetch exceptions supported by this core. */
fun supported_fetch_cause(cause :: ExceptionCause, hypervisor :: Boolean) :: Bool:
  cause.is_one_of(ExceptionCause.InstructionAddressMisaligned, ExceptionCause.InstructionAccessFault, ExceptionCause.InstructionPageFault)
    ||| (Bool(hypervisor) & (cause === ExceptionCause.InstructionGuestPageFault))

/* Translation reports the exact block VA. Assembly checks this against the
   instruction and converts it to parcel ownership before issuing the packet. */
bundle FetchBlockFault(xlen :: XLen, hypervisor :: Boolean):
  valid: Bool
  cause: ExceptionCause
  value: Bits(xlen.width)
  if hypervisor:
    guest: RiscvGuestFault()

  /* Only H-enabled translation may report a guest-page fault. */
  method supported(fault) :: Bool:
    !fault.valid ||| supported_fetch_cause(fault.cause, hypervisor)

  /* Preserve the winning block's cause and guest provenance; a crossing
     instruction owns its second parcel only if that block actually failed. */
  method at_parcel(fault, second :: Bool) :: FetchFault(xlen, hypervisor):
    def continuation = fault.valid & second
    if hypervisor
    | FetchFault(xlen, hypervisor):
        valid: fault.valid
        cause: fault.cause
        continuation: continuation
        guest: fault.guest
    | FetchFault(xlen, hypervisor):
        valid: fault.valid
        cause: fault.cause
        continuation: continuation

/* Instruction-relative fetch fault. The originating PC travels with the
   instruction; only a failed second parcel needs a nonzero displacement. */
bundle FetchFault(xlen :: XLen, hypervisor :: Boolean):
  valid: Bool
  cause: ExceptionCause
  continuation: Bool
  if hypervisor:
    guest: RiscvGuestFault()

  /* Recover the exact trap VA modulo XLEN, including a straddle across zero. */
  method address(fault, pc :: Bits(xlen.width)) :: Bits(xlen.width):
    mux(fault.continuation, pc + Bits(xlen.width)(2), pc)

  /* Rejects unused encodings and guest faults when this specialization omits H. */
  method supported(fault) :: Bool:
    !fault.valid ||| supported_fetch_cause(fault.cause, hypervisor)

export FetchBlockFault FetchFault
