#lang rhodium
/* Compacts fetch packets into one eight-entry instruction buffer with ordered prefix consumption. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("riscv/isa/xlen.rhm").XLen
  "protocol.rhdl" open
  lib("flow/main.rhdl") open

/* Compacts nonempty ingress groups independently of the issue width. Clear discards both resident and live offers. */
sync_circuit IssueWindow(xlen :: XLen, ~enqueue_width: enqueue_width :: PosInt, ~issue_width: issue_width :: PosInt):
  unless enqueue_width <= 8 && issue_width <= 8
  | error(~who: #'IssueWindow, "both widths must fit the eight-entry window")

  interface ingress(Decoupled(InstructionGroup(xlen, enqueue_width)), ~role: consumer)
  interface clear(Pulse(), ~role: consumer)
  output head: InstructionGroup(xlen, issue_width)
  interface candidates[issue_width](Valid(FetchedInstruction(xlen)), ~role: producer)
  output available: Bits(4)
  input consume: Bits(index_width(issue_width + 1))

  reg count(~init: Bits(4)(0))
  reg entries(Vec(8, FetchedInstruction(xlen)))
  def remove_count = if issue_width == 8 | consume | consume.zext(4)
  def append_count = if enqueue_width == 8 | ingress.bits.count | ingress.bits.count.zext(4)
  def remaining = count - remove_count
  available <== Bits(4)(8) - count
  ingress.ready <== !clear.valid & (remaining <= Bits(4)(8 - enqueue_width))
  head.count <== mux(count >= Bits(4)(issue_width), Bits(index_width(issue_width + 1))(issue_width), count[0..index_width(issue_width + 1)])
  head.entries <== vec(for List (lane in 0..issue_width): entries[lane])
  def added = mux(ingress.fire(), append_count, Bits(4)(0))
  // Observe accepted packets without changing their independent ingress readiness.
  def accepted = interface_link(Valid(InstructionGroup(xlen, enqueue_width)))
  accepted.left.valid <== ingress.fire()
  accepted.left.bits <== ingress.bits
  describe_interface_contract(ingress, accepted.left, "packet-acceptance", ~trace_model: interface_trace_combinational())
  def parents = accepted.right |> fork_valid(issue_width)
  for (lane in 0..issue_width):
    candidates[lane].valid <== (count > Bits(4)(lane)) & !clear.valid
    candidates[lane].bits <== entries[lane]
    def name = "head" ++ to_string(lane)
    describe_interface_window_storage(8, ingress.fire(), remove_count, count, clear.valid, for List (index in 0..issue_width): Bool(index == lane), ~name: name, ~append_count: append_count)
    describe_interface_contract(parents[lane], candidates[lane], "instruction-window-" ++ name, ~trace_model: interface_trace_window(~name: name))

  when (clear.valid):
    count <== Bits(4)(0)
  otherwise:
    count <== remaining + added
    for (index in 0..8):
      def position = Bits(4)(index)
      def append = ingress.fire() & (position >= remaining) & (position < (remaining + added))
      def shifted = position + remove_count
      def incoming = position - remaining
      when append:
        entries[index] <== ingress.bits.entries[incoming[0..index_width(enqueue_width)]]
      elsewhen (consume.any() & (position < remaining)):
        entries[index] <== entries[shifted[0..3]]

  assert(count <= Bits(4)(8), "fetch_instruction_capacity")
  assert(consume <= head.count, "fetch_issue_prefix")
  when (ingress.valid):
    assert(ingress.bits.count.any() & (ingress.bits.count <= Bits(index_width(enqueue_width + 1))(enqueue_width)), "fetch_packet_count")

export:
  IssueWindow
