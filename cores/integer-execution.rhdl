#lang rhodium
/* Defines opaque tagged requests and returns for shared integer execution services. */
// SPDX-License-Identifier: Apache-2.0

/* Pairs physical arithmetic operands with a caller-defined completion owner. */
bundle IntegerExecutionRequest(Operands :: DataType, Tag :: DataType):
  tag: Tag
  operands: Operands

  /* Replaces a request's owner type and value without changing its arithmetic operands. */
  method with_tag(request, To :: DataType, tag :: Hardware.of(To)) :: IntegerExecutionRequest(Operands, To):
    IntegerExecutionRequest(Operands, To):
      tag: tag
      operands: request.operands

/* Returns the arithmetic value with the unchanged owner of its accepted request. */
bundle IntegerExecutionResult(Value :: DataType, Tag :: DataType):
  tag: Tag
  value: Value

  /* Replaces a result's owner type and value without changing its arithmetic result. */
  method with_tag(result, To :: DataType, tag :: Hardware.of(To)) :: IntegerExecutionResult(Value, To):
    IntegerExecutionResult(Value, To):
      tag: tag
      value: result.value

export:
  IntegerExecutionRequest
  IntegerExecutionResult
