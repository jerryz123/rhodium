#lang rhodium
// Defines pipelined load/store decisions, WB store authorization, and blocking transactions.

import:
  "../memory.rhdl" open
  "../fp/types.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  "../../load-store.rhdl" open
  lib("rhodium/std/ready-valid.rhdl") open

hardware_enum RV5StageDataDestination:
  None
  Integer
  FloatingPoint

hardware_enum RV5StagePipelineOutcome:
  Slow
  LoadHit
  StoreHit
  Replay
  PageFault
  AccessFault

hardware_enum RV5StagePipelineReason:
  None
  ArrayPort
  StoreDependency
  StoreCapacity
  Probe
  Miss
  Translation
  Ordered

bundle RV5StagePipelineReq(xlen :: XLen):
  address: Bits(xlen.width)
  access: MemoryOperation
  width: MemoryWidth
  unsigned: Bool
  data: Bits(xlen.width)

bundle RV5StagePipelineResult(xlen :: XLen):
  outcome: RV5StagePipelineOutcome
  reason: RV5StagePipelineReason
  data: Bits(xlen.width)

// EX reads, MEM decides, and WB alone may authorize the matching store candidate.
// Replay must repeat lookup; only Slow uses the authorized transaction service.
interface RV5StagePipelineAccess(xlen :: XLen):
  role requester
  role responder
  provider requester

  requester -> responder:
    request: Valid(RV5StagePipelineReq(xlen))
    commit: Bool

  responder -> requester:
    response: Valid(RV5StagePipelineResult(xlen))
    commit_ready: Bool

bundle RV5StageDataReq(xlen :: XLen):
  address: Bits(xlen.width)
  access: MemoryOperation
  atomic: RV5StageAtomicOperation
  width: MemoryWidth
  unsigned: Bool
  data: Bits(xlen.width)
  destination: RV5StageDataDestination
  rd: Bits(5)
  floating_point_precision: RV5StageFloatPrecision
  locality: RV5StageMemoryLocality

bundle RV5StageDataResp(xlen :: XLen):
  // Management retains retirement context for delayed faults. Other current
  // engines report rejection before acceptance and return successful responses.
  access_fault: Bool
  data: Bits(xlen.width)
  destination: RV5StageDataDestination
  rd: Bits(5)
  floating_point_precision: RV5StageFloatPrecision

interface RV5StageDataAccess(xlen :: XLen):
  role requester
  role responder
  provider requester

  requester -> responder:
    request: Decoupled(RV5StageDataReq(xlen))

  responder -> requester:
    request_fault: Bool
    request_access_fault: Bool
    response: Valid(RV5StageDataResp(xlen))
    drained: Bool
    reservation_valid: Bool

export:
  RV5StagePipelineReq
  RV5StagePipelineResult
  RV5StagePipelineAccess
  RV5StagePipelineOutcome
  RV5StagePipelineReason
  RV5StageDataDestination
  RV5StageDataReq
  RV5StageDataResp
  RV5StageDataAccess
