#lang rhodium
// Defines pipelined load/store decisions, WB store authorization, and blocking transactions.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/bits.rhdl").Pow2Int
  "../memory.rhdl" open
  "../fp/types.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/rtl/atomic.rhdl" open
  "../../../riscv/rtl/zihintntl.rhdl" open
  "../../load-store.rhdl" open
  lib("rhodium/std/ready-valid.rhdl") open

bundle RV5StageFpMemoryWriteback():
  rd: Bits(5)
  precision: RV5StageFloatPrecision

tagged_union RV5StageMemoryWriteback(vector_completion_slots :: Pow2Int):
  Ack
  Integer(Bits(5))
  FloatingPoint(RV5StageFpMemoryWriteback())
  Vector(Bits(index_width(vector_completion_slots)))

hardware_enum RV5StagePipelineOutcome:
  Slow
  LoadHit
  StoreHit
  Replay
  PageFault
  AccessFault

hardware_enum RV5StagePipelineReason:
  None
  ArrayPort
  StoreDependency
  StoreCapacity
  Probe
  Miss
  Translation
  Ordered

bundle RV5StagePipelineReq(xlen :: XLen):
  address: Bits(xlen.width)
  access: RV5StageMemoryOperation
  width: MemoryWidth
  unsigned: Bool
  data: Bits(xlen.width)

bundle RV5StagePipelineResult(xlen :: XLen):
  outcome: RV5StagePipelineOutcome
  reason: RV5StagePipelineReason
  data: Bits(xlen.width)

// EX reads, MEM decides, and WB alone may authorize the matching store candidate.
// Replay must repeat lookup; only Slow uses the authorized transaction service.
interface RV5StagePipelineAccess(xlen :: XLen):
  role requester
  role responder
  provider requester

  requester -> responder:
    request: Valid(RV5StagePipelineReq(xlen))
    commit: Bool

  responder -> requester:
    response: Valid(RV5StagePipelineResult(xlen))
    commit_ready: Bool

bundle RV5StageDataReq(xlen :: XLen, vector_completion_slots :: Pow2Int):
  address: Bits(xlen.width)
  access: RV5StageMemoryOperation
  atomic: RiscvAtomicOperation
  width: MemoryWidth
  unsigned: Bool
  data: Bits(xlen.width)
  writeback: RV5StageMemoryWriteback(vector_completion_slots)
  locality: RiscvMemoryLocality

bundle RV5StageDataResp(xlen :: XLen, vector_completion_slots :: Pow2Int):
  // Management retains retirement context for delayed faults. Other current
  // engines report rejection before acceptance and return successful responses.
  access_fault: Bool
  data: Bits(xlen.width)
  writeback: RV5StageMemoryWriteback(vector_completion_slots)

interface RV5StageDataAccess(xlen :: XLen, vector_completion_slots :: Pow2Int):
  role requester
  role responder
  provider requester

  requester -> responder:
    request: Decoupled(RV5StageDataReq(xlen, vector_completion_slots))

  responder -> requester:
    request_fault: Bool
    request_access_fault: Bool
    response: Valid(RV5StageDataResp(xlen, vector_completion_slots))
    drained: Bool
    reservation_valid: Bool

export:
  RV5StagePipelineReq
  RV5StagePipelineResult
  RV5StagePipelineAccess
  RV5StagePipelineOutcome
  RV5StagePipelineReason
  RV5StageFpMemoryWriteback
  RV5StageMemoryWriteback
  RV5StageDataReq
  RV5StageDataResp
  RV5StageDataAccess
