#lang rhodium
/* Defines pipelined load/store decisions, WB store authorization, and blocking transactions. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/bits.rhdl").Pow2Int
  "../memory.rhdl" open
  "../fp/types.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/rtl/atomic.rhdl" open
  "../../../riscv/rtl/zihintntl.rhdl" open
  "../../load-store.rhdl" open
  lib("rhodium/std/ready-valid.rhdl") open

/* Retains the FPR destination and precision needed to box a completed FP load. */
bundle RV5StageFpMemoryWriteback():
  rd: Bits(5)
  precision: RV5StageFloatPrecision

/* Selects acknowledgement-only, GPR, FPR, or vector-slot completion ownership. */
tagged_union RV5StageMemoryWriteback(vector_completion_slots :: Pow2Int):
  Ack
  Integer(Bits(5))
  FloatingPoint(RV5StageFpMemoryWriteback())
  Vector(Bits(index_width(vector_completion_slots)))

/* Physical response routing is independent of the architectural writeback kind. */
hardware_enum RV5StageDataOrigin:
  Core
  Walker

/* Distinguishes speculative hit, replay, slow-service, and translation/permission fault
   outcomes. */
hardware_enum RV5StagePipelineOutcome:
  Slow
  LoadHit
  StoreHit
  Replay
  PageFault
  AccessFault

/* Records why a speculative access could not complete on its hit path. */
hardware_enum RV5StagePipelineReason:
  None
  ArrayPort
  StoreDependency
  StoreCapacity
  Probe
  Miss
  Translation
  Ordered

/* Carries the translated speculative access controls without permission to mutate or allocate. */
bundle RV5StagePipelineReq(xlen :: XLen):
  byte_mask: Bits(memory_word_bytes(xlen))
  address: Bits(xlen.width)
  access: RV5StageMemoryOperation
  width: MemoryWidth
  unsigned: Bool
  data: Bits(xlen.width)

/* Returns the MEM-cycle decision, diagnostic reason, and selected load data. */
bundle RV5StagePipelineResult(xlen :: XLen):
  outcome: RV5StagePipelineOutcome
  reason: RV5StagePipelineReason
  data: Bits(xlen.width)

/* Pairs EX/MEM lookup outcomes with WB authorization of the matching store candidate.
   Replay repeats lookup; only Slow uses the authorized transaction service. */
interface RV5StagePipelineAccess(xlen :: XLen):
  role requester
  role responder
  provider requester

  requester -> responder:
    request: Valid(RV5StagePipelineReq(xlen))
    commit: Bool

  responder -> requester:
    response: Valid(RV5StagePipelineResult(xlen))
    commit_ready: Bool

/* Carries an authorized transaction with complete operation, locality, routing, and writeback
   context. */
bundle RV5StageDataReq(xlen :: XLen, vector_completion_slots :: Pow2Int):
  byte_mask: Bits(memory_word_bytes(xlen))
  address: Bits(xlen.width)
  access: RV5StageMemoryOperation
  atomic: RiscvAtomicOperation
  width: MemoryWidth
  unsigned: Bool
  data: Bits(xlen.width)
  writeback: RV5StageMemoryWriteback(vector_completion_slots)
  origin: RV5StageDataOrigin
  locality: RiscvMemoryLocality

/* Returns completion status and data with unchanged architectural and physical-origin tags. */
bundle RV5StageDataResp(xlen :: XLen, vector_completion_slots :: Pow2Int):
  // Management retains retirement context for delayed faults. Other current
  // engines report rejection before acceptance and return successful responses.
  access_fault: Bool
  data: Bits(xlen.width)
  writeback: RV5StageMemoryWriteback(vector_completion_slots)
  origin: RV5StageDataOrigin

/* Exposes authorized request admission, preacceptance faults, tagged completion, drain, and
   reservation. */
interface RV5StageDataAccess(xlen :: XLen, vector_completion_slots :: Pow2Int):
  role requester
  role responder
  provider requester

  requester -> responder:
    request: Decoupled(RV5StageDataReq(xlen, vector_completion_slots))

  responder -> requester:
    request_fault: Bool
    request_access_fault: Bool
    response: Decoupled(RV5StageDataResp(xlen, vector_completion_slots))
    drained: Bool
    reservation_valid: Bool

export:
  RV5StagePipelineReq
  RV5StagePipelineResult
  RV5StagePipelineAccess
  RV5StagePipelineOutcome
  RV5StagePipelineReason
  RV5StageFpMemoryWriteback
  RV5StageMemoryWriteback
  RV5StageDataOrigin
  RV5StageDataReq
  RV5StageDataResp
  RV5StageDataAccess
