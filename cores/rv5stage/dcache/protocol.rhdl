#lang rhodium
// Defines RV5Stage's ordered core-facing data-cache access protocol.

import:
  "../memory.rhdl" open
  "../fp/types.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  "../../load-store.rhdl" open
  lib("rhodium/std/ready-valid.rhdl") open

hardware_enum RV5StageDataDestination:
  None
  Integer
  FloatingPoint

bundle RV5StageDataReq(xlen :: XLen):
  address: Bits(xlen.width)
  access: MemoryOperation
  atomic: RV5StageAtomicOperation
  width: MemoryWidth
  unsigned: Bool
  data: Bits(xlen.width)
  destination: RV5StageDataDestination
  rd: Bits(5)
  floating_point_precision: RV5StageFloatPrecision
  locality: RV5StageMemoryLocality

bundle RV5StageDataResp(xlen :: XLen):
  // Management retains retirement context for delayed faults. Other current
  // engines report rejection before acceptance and return successful responses.
  access_fault: Bool
  data: Bits(xlen.width)
  destination: RV5StageDataDestination
  rd: Bits(5)
  floating_point_precision: RV5StageFloatPrecision

interface RV5StageDataAccess(xlen :: XLen):
  role requester
  role responder
  provider requester

  requester -> responder:
    request: Decoupled(RV5StageDataReq(xlen))

  responder -> requester:
    request_fault: Bool
    request_access_fault: Bool
    response: Valid(RV5StageDataResp(xlen))
    drained: Bool
    reservation_valid: Bool

export:
  RV5StageDataDestination
  RV5StageDataReq
  RV5StageDataResp
  RV5StageDataAccess
