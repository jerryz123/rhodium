#lang rhodium
// Implements RV5Stage's blocking write-back, write-allocate set-associative data cache.

import:
  "../../cache-prefetch.rhdl" open
  "protocol.rhdl" open
  "../fp/types.rhdl" open
  "../memory.rhdl" open
  "../cache.rhdl" open
  "../chi/foundation.rhdl" open
  "../chi/refill.rhdl" open
  "../chi/snoop.rhdl" open
  "../chi/writeback.rhdl" open
  "../../load-store.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/read-write.rhdl") open
  lib("rhodium/std/sync-ram.rhdl") open
  lib("rhodium/std/flow.rhdl") open
  lib("chi/main.rhdl") open

hardware_enum RV5StageDataGatherState:
  Idle
  EvictionRead
  EvictionReady
  SnoopRead
  SnoopReady

bundle RV5StageL1DTransactionContext(xlen :: XLen,
                                     way_width :: PosInt):
  request: RV5StageDataReq(xlen)
  way: Bits(way_width)
  allocation: Bool
  prefetch: Bool
  prefetch_write: Bool

bundle RV5StageL1DLookup(xlen :: XLen):
  request: RV5StageDataReq(xlen)
  prefetch: Bool
  prefetch_write: Bool

fun check_l1d_geometry(width :: PosInt, cache :: RV5StageCacheConfig):
  unless width > (alignment_bits(RV5StageCacheLineBytes) + cache.set_width)
  | error(~who: #'RV5StageL1DCache,
          "address width must include line offset, set, and tag bits")

sync_circuit RV5StageL1DCache(xlen :: XLen,
                              cache :: RV5StageCacheConfig,
                              ~chi: config :: RV5StageCHIConfig):
  def width = xlen.width
  def p = config.flit
  check_l1d_geometry(width, cache)
  def sets = cache.sets
  def ways = cache.ways
  def word_bytes = width / 8
  def words_per_line = RV5StageCacheLineBytes / word_bytes
  def data_depth = sets * words_per_line
  def data_lanes = ways * word_bytes
  def offset_width = alignment_bits(RV5StageCacheLineBytes)
  def word_offset_width = alignment_bits(word_bytes)
  def set_width = cache.set_width
  def way_width = cache.way_width
  def tag_width = width - offset_width - set_width
  def word_index_width = index_width(words_per_line)
  def data_address_width = index_width(data_depth)

  input node_id: Bits(p.node_id_width)
  interface core(RV5StageDataAccess(xlen), ~role: responder)
  interface prefetch(Valid(CachePrefetchReq(width)), ~role: consumer)
  interface chi(CHIRNChannels(p), ~role: node)

  inst tags(SyncRam1RW(sets, Bits(tag_width), ways))
  inst states(SyncRam1RW(sets, CHICacheState, ways))
  inst lines(SyncRam1RW(data_depth, Bits(8), data_lanes))
  inst load_gen(LoadGen(xlen, word_bytes))
  inst local_store_gen(StoreGen(xlen, word_bytes))
  inst local_atomic_alu(RV5StageAtomicALU(xlen))
  inst refill_load_gen(LoadGen(xlen, word_bytes))
  inst refill_store_gen(StoreGen(xlen, word_bytes))
  inst refill_atomic_alu(RV5StageAtomicALU(xlen))
  inst refill(RV5StageLineRefill(RV5StageL1DTransactionContext(xlen, way_width), width, config))
  inst snoop(RV5StageDataSnoop(width, config))
  inst writeback(RV5StageLineWriteback(RV5StageL1DTransactionContext(xlen, way_width), width, config, 1))
  refill.node_id <== node_id
  snoop.node_id <== node_id
  writeback.node_id <== node_id
  // This non-flow-through queue makes core acceptance depend only on its
  // registered capacity. Lookup results control internal drain but cannot
  // propagate combinationally to core request readiness.
  inst core_requests(Queue(RV5StageDataReq(xlen), 2))
  // Hits leave the lookup stage directly. Ownership acquisitions and misses
  // transfer their complete request context into the refill engine, after a
  // dirty victim has drained when replacement is necessary.
  inst lookup(Pipe(RV5StageL1DLookup(xlen), 1))
  // This mandatory register isolates the SRAM result path. Responses cannot
  // be backpressured.
  inst responses(ValidPipe(RV5StageDataResp(xlen), 1))
  inst protocol_requests(Arbiter(CHIReqFlit(p), 2))
  inst protocol_responses(Arbiter(CHIRspFlit(p), 2))
  inst protocol_data(Arbiter(CHIDatFlit(p), 2))
  inst refill_commands(Arbiter(RV5StageLineRefillCommand(RV5StageL1DTransactionContext(xlen, way_width), width), 2))

  reg valid_lines(~init: vec(
    for List (_set in 0..sets): bits(0, ways).as_vec(Bool)
  ))
  reg replacement_ways(~init: vec(
    for List (_set in 0..sets): bits(0, way_width)
  ))
  reg snoop_way(~init: bits(0, way_width))
  reg reservation_valid(~init: Bool(#false))
  reg reservation_address(~init: bits(0, width))
  reg reservation_width(~init: MemoryWidth.Word)
  // A resolved local store, AMO, or successful SC commits from this register
  // on the cycle after tag and data lookup.
  reg pending_mutation_valid(~init: Bool(#false))
  reg pending_mutation_request(RV5StageDataReq(xlen))
  reg pending_mutation_way(Bits(way_width))
  reg pending_mutation_old_value(Bits(width))
  reg pending_zero_index(~init: bits(0, word_index_width))
  reg refill_installing(~init: Bool(#false))
  reg refill_install_index(~init: bits(0, word_index_width))
  reg gather_state(~init: RV5StageDataGatherState.Idle)
  reg gather_issue_index(~init: bits(0, word_index_width))
  reg gather_response_pending(~init: Bool(#false))
  reg gather_response_index(~init: bits(0, word_index_width))
  reg gather_last_issued(~init: Bool(#false))
  reg gathered_line(~init: bits(0, RV5StageCacheLineBytes * 8))
  reg gather_set(Bits(set_width))
  reg gather_way(Bits(way_width))
  reg eviction_line_address(Bits(width))
  reg eviction_context(RV5StageL1DTransactionContext(xlen, way_width))
  reg gathered_snoop_state(~init: CHICacheState.Invalid)
  reg snoop_metadata_pending(~init: Bool(#false))

  responses.egress |> core.response
  core.request_fault <== Bool(#false)
  core.request_access_fault <== Bool(#false)

  def outgoing_requests = chi.requests
  def outgoing_responses = chi.requester_responses
  def outgoing_data = chi.request_data
  def incoming_responses = chi.responses
  def incoming_data = chi.response_data
  def incoming_snoops = chi.snoops
  refill.requests |> protocol_requests.ingress[0]
  writeback.requests |> protocol_requests.ingress[1]
  protocol_requests.egress |> outgoing_requests
  incoming_data |> refill.response_data
  refill.acknowledgements |> protocol_responses.ingress[0]
  snoop.responses |> protocol_responses.ingress[1]
  protocol_responses.egress |> outgoing_responses
  writeback.data |> protocol_data.ingress[0]
  snoop.data |> protocol_data.ingress[1]
  protocol_data.egress |> outgoing_data
  incoming_snoops |> snoop.snoops
  def snoop_pending = snoop.pending
  def writeback_active = !writeback.command.ready
  def Array(refill_response, writeback_response) = (
    incoming_responses |> demux_flow(2, _response => writeback_active.as_bits())
  )
  refill_response |> refill.responses
  writeback_response |> writeback.responses
  def prefetch_request = prefetch.bits.into(CachePrefetchReq(width))
  def prefetch_valid = prefetch.valid & prefetch_request.operation.is_one_of(CachePrefetchOperation.Read, CachePrefetchOperation.Write)
  def issue_prefetch = prefetch_valid & !core.request.valid & !core_requests.egress.valid
  def issue_request :: RV5StageDataReq(xlen) = mux(
    issue_prefetch,
    RV5StageDataReq(xlen):
      address: prefetch_request.address
      access: MemoryOperation.Load
      atomic: RV5StageAtomicOperation.Swap
      width: MemoryWidth.Byte
      unsigned: Bool(#true)
      data: bits(0, width)
      destination: RV5StageDataDestination.None
      rd: bits(0, 5)
      floating_point_precision: RV5StageFloatPrecision.Single,
    core_requests.egress.bits
  )
  def issue_set = issue_request.address[offset_width..(offset_width + set_width)]
  def issue_data_address = issue_request.address[word_offset_width..(offset_width + set_width)]
  def lookup_context = lookup.egress.bits.into(RV5StageL1DLookup(xlen))
  def lookup_request :: RV5StageDataReq(xlen) = lookup_context.request
  def lookup_prefetch = lookup_context.prefetch
  def lookup_prefetch_write = lookup_context.prefetch_write
  def lookup_set = lookup_request.address[offset_width..(offset_width + set_width)]
  def lookup_tag = lookup_request.address[(offset_width + set_width)..width]
  def lookup_valids = valid_lines[lookup_set]
  def lookup_matches = vec(
    for List (way in 0..ways):
      lookup_valids[way] & (tags.port.response.bits[way] === lookup_tag)
  )
  def lookup_selection = priority_encoder_oh(lookup_matches)
  def line_hit = lookup_selection.valid
  def lookup_state = lookup_selection.mux(
    for List (way in 0..ways): states.port.response.bits[way],
    ~default: CHICacheState.Invalid
  ).into(CHICacheState)
  def allocation_way = rv5stage_cache_replacement_way(cache, lookup_valids, replacement_ways[lookup_set])
  def transaction_way = mux(line_hit, lookup_selection.index, allocation_way)
  def victim_valid = lookup_valids[transaction_way]
  def victim_state = states.port.response.bits[transaction_way].into(CHICacheState)
  def lookup_access :: MemoryOperation = lookup_request.access
  def lookup_ready = lookup.egress.valid & tags.port.response.valid & states.port.response.valid
  def lookup_load = lookup_ready & !lookup_prefetch & lookup_access.is_load()
  def lookup_store = lookup_ready & !lookup_prefetch & lookup_access.is_store()
  def lookup_zero = lookup_ready & !lookup_prefetch & lookup_access.is_cache_block_zero()
  def lookup_atomic = lookup_ready & !lookup_prefetch & lookup_access.is_atomic()
  def lookup_sc = lookup_ready & !lookup_prefetch & lookup_access.is_store_conditional()
  def reservation_matches = reservation_valid & (reservation_address === lookup_request.address) & (reservation_width === lookup_request.width)
  def lookup_mutation = lookup_store ||| lookup_zero ||| lookup_atomic ||| (lookup_sc & reservation_matches)
  def mutation_has_ownership = lookup_mutation & line_hit & lookup_state.is_unique()
  def prefetch_needs_refill = lookup_ready & lookup_prefetch & (!line_hit ||| (lookup_prefetch_write & !lookup_state.is_unique()))
  def prefetch_dirty_victim = prefetch_needs_refill & !line_hit & victim_valid & victim_state.is_dirty()
  def lookup_needs_refill = lookup_load & !line_hit ||| lookup_mutation & !mutation_has_ownership ||| (prefetch_needs_refill & !prefetch_dirty_victim)
  def dirty_victim = lookup_needs_refill & !lookup_prefetch & !line_hit & victim_valid & victim_state.is_dirty()
  def cached_words = lines.port.response.bits.as_bits().as_vec(Bits(width))
  def cached_word = lookup_selection.mux(
    for List (way in 0..ways): cached_words[way],
    ~default: bits(0, width)
  )
  for (left in 0..ways):
    for (right in (left + 1)..ways):
      when lookup_ready:
        assert(!(lookup_matches[left] & lookup_matches[right]),
               "l1d_core_hit_unique")
  def gather_idle = gather_state === RV5StageDataGatherState.Idle
  def gather_read = gather_state.is_one_of(RV5StageDataGatherState.EvictionRead,
                                           RV5StageDataGatherState.SnoopRead)
  def gather_issue = gather_read & !gather_last_issued
  def gather_issue_final = gather_issue_index === bits(words_per_line - 1, word_index_width)
  def gather_response_final = gather_response_index === bits(words_per_line - 1, word_index_width)

  def Array(hit_path, transaction_path) = (
    lookup.egress |> demux_flow(2, _request => lookup_needs_refill.as_bits())
  )
  def Array(direct_refill_path, eviction_path) = (
    transaction_path |> demux_flow(2, _request => dirty_victim.as_bits())
  )
  hit_path.ready <== Bool(#true)
  fun transaction_context(lookup_request :: RV5StageL1DLookup(xlen),
                          way :: Bits(way_width),
                          allocation :: Bool) :~ RV5StageL1DTransactionContext(xlen, way_width):
    RV5StageL1DTransactionContext(xlen, way_width):
      request: lookup_request.request
      way: way
      allocation: allocation
      prefetch: lookup_request.prefetch
      prefetch_write: lookup_request.prefetch_write
  def direct_refill_commands = (
    direct_refill_path
      |> map_flow(request => RV5StageLineRefillCommand(RV5StageL1DTransactionContext(xlen, way_width), width)):
        line_address: align_down(request.request.address.as_bits(), RV5StageCacheLineBytes)
        opcode: mux(request.prefetch_write ||| request.request.access.into(MemoryOperation).needs_unique(),
                    CHIReqOpcode.ReadUnique,
                    CHIReqOpcode.ReadClean)
        context: transaction_context(request, transaction_way, !line_hit)
  )
  direct_refill_commands |> refill_commands.ingress[0]
  def victim_address = concat(tags.port.response.bits[transaction_way], lookup_set, bits(0, offset_width))
  def victim_context = transaction_context(eviction_path.bits.into(RV5StageL1DLookup(xlen)), transaction_way, Bool(#true))
  eviction_path.ready <== gather_idle & !refill_installing
  def eviction_gather_start = eviction_path.fire()
  writeback.command.valid <== gather_state === RV5StageDataGatherState.EvictionReady
  writeback.command.bits <== RV5StageLineWritebackCommand(RV5StageL1DTransactionContext(xlen, way_width), width):
    line_address: eviction_line_address
    line: gathered_line.as_vec(Bits(64))
    context: eviction_context
  def writeback_command_fire = writeback.command.fire()
  def post_eviction_refills = (
    writeback.completion
      |> map_flow(result => RV5StageLineRefillCommand(RV5StageL1DTransactionContext(xlen, way_width), width)):
        line_address: align_down(result.context.request.address.as_bits(), RV5StageCacheLineBytes)
        opcode: mux(result.context.prefetch_write ||| result.context.request.access.into(MemoryOperation).needs_unique(),
                    CHIReqOpcode.ReadUnique,
                    CHIReqOpcode.ReadClean)
        context: result.context
  )
  post_eviction_refills |> refill_commands.ingress[1]
  refill_commands.egress |> refill.command

  // A snoop waiting before installation wins the SRAM. Once installation
  // starts, the refill owns the port until every XLEN word has been written.
  def refill_install_start = refill.completion.valid & !snoop_pending & gather_idle & !refill_installing & !pending_mutation_valid
  def refill_install_final = refill_install_index === bits(words_per_line - 1, word_index_width)
  def refill_install_word = refill_installing
  refill.completion.ready <== refill_installing & refill_install_final
  def install_refill = refill.completion.fire()
  when install_refill:
    assert(!refill.completion.bits.pass_dirty, "l1d_refill_not_dirty")
  def completion_context = refill.completion.bits.context
  def completion_request = completion_context.request
  def completion_prefetch = completion_context.prefetch
  def completion_way = completion_context.way
  def completion_access :: MemoryOperation = completion_request.access
  def completion_set = completion_request.address[offset_width..(offset_width + set_width)]
  def completion_tag = completion_request.address[(offset_width + set_width)..width]
  def completion_word_index = completion_request.address[word_offset_width..offset_width]
  def refill_words = refill.completion.bits.line.as_bits().as_vec(Bits(width))
  def load_request :: RV5StageDataReq(xlen) = mux(refill.completion.valid, completion_request, lookup_request)
  def load_access :: MemoryOperation = load_request.access
  def load_unsigned = mux(load_access === MemoryOperation.Load,
                          load_request.unsigned,
                          Bool(#false))
  def refilled_word = refill_words[completion_word_index]
  load_gen.address <== load_request.address
  load_gen.data <== mux(refill.completion.valid, refilled_word, cached_word)
  load_gen.width <== load_request.width
  load_gen.unsigned_load <== load_unsigned
  def refill_mutation = refill.completion.valid & !completion_prefetch & completion_access.needs_unique()
  def local_mutation = lookup_mutation & mutation_has_ownership
  def local_mutation_capture = local_mutation & lookup.egress.fire()
  def local_mutation_commit = pending_mutation_valid
  def pending_mutation_access :: MemoryOperation = pending_mutation_request.access
  // Owned hits keep the SRAM until the complete block is zero. No new CHI
  // transaction is held up by this bounded interval; snoops resume afterward.
  def pending_zero = pending_mutation_access.is_cache_block_zero()
  def local_mutation_complete = local_mutation_commit & (!pending_zero ||| (pending_zero_index === bits(words_per_line - 1, word_index_width)))
  local_atomic_alu.old_value <== pending_mutation_old_value
  local_atomic_alu.operand <== pending_mutation_request.data
  local_atomic_alu.memory_width <== pending_mutation_request.width
  local_atomic_alu.operation <== pending_mutation_request.atomic
  local_store_gen.address <== pending_mutation_request.address
  local_store_gen.value <== mux(pending_mutation_access.is_atomic(), local_atomic_alu.value, pending_mutation_request.data)
  local_store_gen.width <== pending_mutation_request.width
  def local_store_word_data = mux(pending_zero, bits(0, width), local_store_gen.data).as_vec(Bits(8))

  refill_load_gen.address <== completion_request.address
  refill_load_gen.data <== refilled_word
  refill_load_gen.width <== completion_request.width
  refill_load_gen.unsigned_load <== Bool(#false)
  refill_atomic_alu.old_value <== refill_load_gen.value
  refill_atomic_alu.operand <== completion_request.data
  refill_atomic_alu.memory_width <== completion_request.width
  refill_atomic_alu.operation <== completion_request.atomic
  refill_store_gen.address <== completion_request.address
  refill_store_gen.value <== mux(completion_access.is_atomic(), refill_atomic_alu.value, completion_request.data)
  refill_store_gen.width <== completion_request.width
  def refill_store_word_data = refill_store_gen.data.as_vec(Bits(8))
  def refill_store_byte_mask = refill_store_gen.mask.into(Bits(word_bytes)).as_vec(Bool)
  def refill_install_bytes = refill_words[refill_install_index].as_vec(Bits(8))
  def mutate_refill_word = refill_mutation & (refill_install_index === completion_word_index)
  def merged_refill_word = vec(
    for List (byte_index in 0..word_bytes):
      mux(refill_store_byte_mask[byte_index],
          refill_store_word_data[byte_index],
          refill_install_bytes[byte_index])
  )
  def refill_install_data = mux(completion_access.is_cache_block_zero(), bits(0, width).as_vec(Bits(8)), mux(mutate_refill_word, merged_refill_word, refill_install_bytes))
  def cache_write = refill_install_word ||| local_mutation_commit
  assert(refill.command.ready ||| writeback.command.ready,
         "l1d_backing_owner_exclusive")

  // Once the request queue is primed, loads can follow hit lookups every cycle.
  // A miss blocks queue drain until refill, and a store blocks drain while its
  // one-entry backing write buffer completes the local SRAM update.
  // Active backing transactions have already captured their cache context and
  // do not occupy the SRAM ports. Serving snoops here prevents a Home waiting
  // on this RN-F from deadlocking behind this RN-F's queued request.
  snoop.cache_ready <== !lookup.egress.valid & !pending_mutation_valid & gather_idle & !refill_installing
  def snoop_lookup_start = snoop.lookup.valid
  def snoop_address = snoop.address
  def snoop_set = snoop_address[offset_width..(offset_width + set_width)]
  def snoop_tag = snoop_address[(offset_width + set_width)..width]
  def snoop_valids = valid_lines[snoop_set]
  def snoop_matches = vec(
    for List (way in 0..ways):
      snoop_valids[way] & (tags.port.response.bits[way] === snoop_tag)
  )
  def snoop_selection = priority_encoder_oh(snoop_matches)
  def snoop_line_hit = snoop_selection.valid
  def snoop_lookup_state = snoop_selection.mux(
    for List (way in 0..ways): states.port.response.bits[way],
    ~default: CHICacheState.Invalid
  ).into(CHICacheState)
  def snoop_metadata_valid = snoop_metadata_pending & tags.port.response.valid & states.port.response.valid
  when (snoop_metadata_valid & snoop_line_hit):
    snoop_way <== snoop_selection.index
  for (left in 0..ways):
    for (right in (left + 1)..ways):
      when snoop_metadata_valid:
        assert(!(snoop_matches[left] & snoop_matches[right]),
               "l1d_snoop_hit_unique")
  def snoop_dirty_hit = snoop_line_hit & snoop_lookup_state.is_dirty()
  def snoop_gather_start = snoop_metadata_valid & snoop_dirty_hit
  def snoop_direct_result = snoop_metadata_valid & !snoop_dirty_hit
  def snoop_gather_result = gather_state === RV5StageDataGatherState.SnoopReady
  snoop.lookup_result.valid <== snoop_direct_result ||| snoop_gather_result
  snoop.lookup_result.bits <== RV5StageDataSnoopLookupResult():
    hit: mux(snoop_gather_result, Bool(#true), snoop_line_hit)
    state: mux(snoop_gather_result, gathered_snoop_state, snoop_lookup_state)
    line: mux(snoop_gather_result,
              gathered_line,
              bits(0, RV5StageCacheLineBytes * 8)).as_vec(Bits(64))

  core.request |> core_requests.ingress
  def lookup_accepts_input = refill.command.ready & writeback.command.ready & gather_idle & !refill_installing & !pending_mutation_valid & !snoop_pending & !lookup_needs_refill & !local_mutation
  core_requests.egress.ready <== lookup_accepts_input & lookup.ingress.ready
  lookup.ingress.valid <== lookup_accepts_input & (core_requests.egress.valid ||| issue_prefetch)
  lookup.ingress.bits <== RV5StageL1DLookup(xlen):
    request: issue_request
    prefetch: issue_prefetch
    prefetch_write: issue_prefetch & (prefetch_request.operation === CachePrefetchOperation.Write)
  def request_accept = core.request.fire()
  def lookup_issue = lookup.ingress.fire()
  // A fence observes accepted or queued requests, lookup work, active refills,
  // and the backing store buffer. Same-cycle acceptance is included so no
  // request can cross the reported quiescent boundary.
  core.drained <== !request_accept & !core_requests.egress.valid & !lookup.egress.valid & !pending_mutation_valid & refill.command.ready & writeback.command.ready & gather_idle & !refill_installing
  def produces_load_hit = lookup_load & line_hit
  def produces_failed_sc = lookup_sc & !reservation_matches
  def produces_response = produces_load_hit ||| local_mutation_complete ||| produces_failed_sc ||| (install_refill & !completion_prefetch)
  def response_request :: RV5StageDataReq(xlen) = mux(
    install_refill,
    completion_request,
    mux(local_mutation_commit, pending_mutation_request, lookup_request)
  )
  def response_access :: MemoryOperation = response_request.access
  def response_address = response_request.address
  def response_width = response_request.width
  def response_old_value = mux(local_mutation_commit, pending_mutation_old_value, load_gen.value)
  responses.ingress.valid <== produces_response
  responses.ingress.bits <== RV5StageDataResp(xlen):
    data: mux(response_access.returns_old_value(),
              response_old_value,
              mux(response_access.is_store_conditional() & produces_failed_sc,
                  bits(1, width),
                  bits(0, width)))
    destination: response_request.destination
    rd: response_request.rd
    floating_point_precision: response_request.floating_point_precision

  def install_way_mask = rv5stage_cache_way_mask(cache, completion_way)
  def local_mutation_way_mask = rv5stage_cache_way_mask(cache, pending_mutation_way)
  def snoop_update_way_mask = rv5stage_cache_way_mask(cache, snoop_way)
  def full_byte_mask = (!bits(0, word_bytes)).into(Mask(word_bytes))
  def refill_lane_mask = rv5stage_cache_lane_mask(cache, completion_way, word_bytes, full_byte_mask)
  def local_mutation_lane_mask = rv5stage_cache_lane_mask(cache, pending_mutation_way, word_bytes, mux(pending_zero, full_byte_mask, local_store_gen.mask))
  def line_write_bytes = mux(local_mutation_commit, local_store_word_data, refill_install_data)
  def mutable repeated_line_write_bytes = []
  for (_way in 0..ways):
    for (byte in 0..word_bytes):
      repeated_line_write_bytes := repeated_line_write_bytes ++ [line_write_bytes[byte]]

  tags.port.request.valid <== lookup_issue ||| install_refill ||| snoop_lookup_start
  tags.port.request.bits <== ReadWriteRequest(set_width, Bits(tag_width), ways):
    address: mux(install_refill,
                 completion_set,
                 mux(snoop_lookup_start,
                     snoop_set,
                     issue_set))
    write: install_refill
    data: vec(for List (_way in 0..ways): completion_tag)
    mask: install_way_mask
  def update_snoop_state = snoop.update.valid & !snoop.update.bits.invalidate
  states.port.request.valid <== lookup_issue ||| install_refill ||| local_mutation_commit ||| snoop_lookup_start ||| update_snoop_state
  def refill_cache_state = mux(refill.completion.bits.state === CHIResponseState.Unique,
                               CHICacheState.UniqueClean,
                               CHICacheState.SharedClean)
  def snoop_or_refill_state = mux(update_snoop_state, snoop.update.bits.state, refill_cache_state)
  def mutation_or_refill_state = mux(local_mutation_commit, CHICacheState.UniqueDirty, snoop_or_refill_state)
  def state_write_data = mux(install_refill & completion_access.needs_unique(), CHICacheState.UniqueDirty, mutation_or_refill_state)
  def mutation_or_snoop_mask = mux(local_mutation_commit, local_mutation_way_mask, snoop_update_way_mask)
  def state_write_mask = mux(install_refill, install_way_mask, mutation_or_snoop_mask)
  states.port.request.bits <== ReadWriteRequest(set_width, CHICacheState, ways):
    address: mux(install_refill,
                 completion_set,
                 mux(local_mutation_commit,
                     pending_mutation_request.address[offset_width..(offset_width + set_width)],
                     mux(snoop_lookup_start,
                         snoop_set,
                         mux(update_snoop_state,
                             snoop.update.bits.address[offset_width..(offset_width + set_width)],
                             issue_set))))
    write: install_refill ||| local_mutation_commit ||| update_snoop_state
    data: vec(for List (_way in 0..ways): state_write_data)
    mask: state_write_mask
  def local_mutation_address = mux(pending_zero, pending_mutation_request.address[offset_width..(offset_width + set_width)] ++ pending_zero_index, pending_mutation_request.address[word_offset_width..(offset_width + set_width)])
  def refill_install_address = (completion_set ++ refill_install_index)
  def gather_address = (gather_set ++ gather_issue_index)
  lines.port.request.valid <== lookup_issue ||| cache_write ||| gather_issue
  lines.port.request.bits <== ReadWriteRequest(data_address_width, Bits(8), data_lanes):
    address: mux(cache_write,
                 mux(local_mutation_commit, local_mutation_address, refill_install_address),
                 mux(gather_issue, gather_address, issue_data_address))
    write: cache_write
    data: vec(repeated_line_write_bytes)
    mask: mux(local_mutation_commit, local_mutation_lane_mask, refill_lane_mask)

  assert(!(local_mutation_commit & (lookup_issue ||| install_refill ||| snoop_lookup_start ||| update_snoop_state ||| gather_issue)),
         "l1d_local_mutation_port_exclusive")

  snoop_metadata_pending <== snoop_lookup_start

  when local_mutation_capture:
    pending_mutation_valid <== Bool(#true)
    pending_mutation_request <== lookup_request
    pending_mutation_way <== lookup_selection.index
    pending_mutation_old_value <== load_gen.value
    pending_zero_index <== bits(0, word_index_width)
  elsewhen local_mutation_complete:
    pending_mutation_valid <== Bool(#false)
  elsewhen local_mutation_commit:
    pending_zero_index <== pending_zero_index + bits(1, word_index_width)

  when refill_install_start:
    refill_installing <== Bool(#true)
    refill_install_index <== bits(0, word_index_width)
  elsewhen install_refill:
    refill_installing <== Bool(#false)
    refill_install_index <== bits(0, word_index_width)
  elsewhen (refill_install_word & !refill_install_final):
    refill_install_index <== refill_install_index + bits(1, word_index_width)

  def gathered_words = gathered_line.as_vec(Bits(width))
  def gathered_response_words = lines.port.response.bits.as_bits().as_vec(Bits(width))
  def gathered_response_word = gathered_response_words[gather_way]
  def next_gathered_line = gathered_words.updated(
    gather_response_index,
    gathered_response_word
  ).as_bits()
  when eviction_gather_start:
    gather_state <== RV5StageDataGatherState.EvictionRead
    gather_issue_index <== bits(0, word_index_width)
    gather_response_pending <== Bool(#false)
    gather_last_issued <== Bool(#false)
    gathered_line <== bits(0, RV5StageCacheLineBytes * 8)
    gather_set <== lookup_set
    gather_way <== transaction_way
    eviction_line_address <== victim_address
    eviction_context <== victim_context
  elsewhen snoop_gather_start:
    gather_state <== RV5StageDataGatherState.SnoopRead
    gather_issue_index <== bits(0, word_index_width)
    gather_response_pending <== Bool(#false)
    gather_last_issued <== Bool(#false)
    gathered_line <== bits(0, RV5StageCacheLineBytes * 8)
    gather_set <== snoop_set
    gather_way <== snoop_selection.index
    gathered_snoop_state <== snoop_lookup_state
  elsewhen gather_read:
    gather_response_pending <== gather_issue
    when gather_issue:
      gather_response_index <== gather_issue_index
      gather_issue_index <== mux(gather_issue_final, gather_issue_index, gather_issue_index + bits(1, word_index_width))
      gather_last_issued <== gather_issue_final
    when gather_response_pending:
      assert(lines.port.response.valid, "l1d_gather_read_response_valid")
      gathered_line <== next_gathered_line
      when gather_response_final:
        gather_state <== mux(gather_state === RV5StageDataGatherState.EvictionRead, RV5StageDataGatherState.EvictionReady, RV5StageDataGatherState.SnoopReady)
  elsewhen writeback_command_fire:
    gather_state <== RV5StageDataGatherState.Idle
  elsewhen snoop_gather_result:
    gather_state <== RV5StageDataGatherState.Idle

  def reservation_line_address = align_down(reservation_address, RV5StageCacheLineBytes)
  def lookup_line_address = align_down(lookup_request.address, RV5StageCacheLineBytes)
  def pending_mutation_line_address = align_down(pending_mutation_request.address, RV5StageCacheLineBytes)
  def completing_lr = produces_load_hit & (lookup_access === MemoryOperation.LoadReserved) ||| (
    install_refill & (completion_access === MemoryOperation.LoadReserved)
  )
  def lookup_reservation_clear = lookup.egress.fire() & !local_mutation_capture & (
    lookup_sc ||| ((lookup_store ||| lookup_zero ||| lookup_atomic) & (lookup_line_address === reservation_line_address))
  )
  def mutation_reservation_clear = local_mutation_commit & (
    pending_mutation_access.is_store_conditional() ||| (
      (pending_mutation_access.is_store() ||| pending_zero ||| pending_mutation_access.is_atomic()) & (pending_mutation_line_address === reservation_line_address)
    )
  )
  def snoop_reservation_clear = snoop.update.valid & snoop.update.bits.invalidate & (
    align_down(snoop.update.bits.address, RV5StageCacheLineBytes) === reservation_line_address
  )
  def replacement_reservation_clear = lookup.egress.fire() & lookup_needs_refill & !line_hit & victim_valid & (
    victim_address === reservation_line_address
  )
  when completing_lr:
    reservation_valid <== Bool(#true)
    reservation_address <== response_address
    reservation_width <== response_width
  elsewhen (reservation_valid & (lookup_reservation_clear ||| mutation_reservation_clear ||| snoop_reservation_clear ||| replacement_reservation_clear)):
    reservation_valid <== Bool(#false)

  when (snoop.update.valid & snoop.update.bits.invalidate):
    valid_lines <== valid_lines.updated(
      snoop.update.bits.address[offset_width..(offset_width + set_width)],
      valid_lines[snoop.update.bits.address[offset_width..(offset_width + set_width)]].updated(
        snoop_way,
        Bool(#false)
      )
    )
  elsewhen writeback_command_fire:
    valid_lines <== valid_lines.updated(
      gather_set,
      valid_lines[gather_set].updated(gather_way, Bool(#false))
    )
  elsewhen install_refill:
    valid_lines <== valid_lines.updated(
      completion_set,
      valid_lines[completion_set].updated(completion_way, Bool(#true))
    )

  when (install_refill & completion_context.allocation):
    replacement_ways <== replacement_ways.updated(
      completion_set,
      rv5stage_cache_next_way(cache, completion_way)
    )

export:
  RV5StageL1DCache
