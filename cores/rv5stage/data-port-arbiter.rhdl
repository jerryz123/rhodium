#lang rhodium
/* Arbitrates core and page-table physical data requests while retaining response origin. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../common/cache/protocol.rhdl".PhysicalMemoryResp
  "../common/memory-arbiter.rhdl".arbitrate_memory_clients
  "memory-context.rhdl" open
  "uncached-protocol.rhdl" open
  "../../riscv/isa/xlen.rhm" open
  lib("rhodium/std/bits.rhdl").Pow2Int
  lib("flow/main.rhdl") open

/* Prioritizes core over walker requests, tags accepted origin, and routes completions by that
   tag.
   The early L1D index follows the selected offer; walker accesses never expose LR reservations. */
sync_circuit RV5StageDataPortArbiter(xlen :: XLen, slots :: Pow2Int):
  interface core(RV5StagePhysicalDataAccess(xlen, slots), ~role: responder)
  interface walker(RV5StagePhysicalDataAccess(xlen, slots), ~role: responder)
  interface memory(RV5StagePhysicalDataAccess(xlen, slots), ~role: requester)
  interface core_lookup(Valid(Bits(xlen.width)), ~role: consumer)
  interface walker_lookup(Valid(Bits(xlen.width)), ~role: consumer)
  interface lookup(Valid(Bits(xlen.width)), ~role: producer)

  def Context = RV5StageMemoryContext(slots)

  /* Records the port of origin alongside the existing architectural writeback tag. */
  fun tag_request(request :: RV5StagePhysicalDataReq(xlen, slots), chosen :: Bits(1)):
    def origin = mux(chosen === Bits(1)(1), RV5StageDataOrigin.Walker, RV5StageDataOrigin.Core)
    def context = request.memory.context.updated(~origin: origin)
    request.with_context(Context, context)

  def (chosen, Array(core_responses, walker_responses), drained) = arbitrate_memory_clients(
    Array(core.request, walker.request), memory, ~tag_request: tag_request,
    ~response_client: fun (reply :: PhysicalMemoryResp(xlen, Context)): reply.context.origin === RV5StageDataOrigin.Walker
  )
  def selected_walker = chosen === Bits(1)(1)

  // Admission faults belong to the selected live offer, not a retained response.
  core.request_fault <== memory.request_fault & !selected_walker
  core.request_access_fault <== memory.request_access_fault & !selected_walker
  walker.request_fault <== memory.request_fault & selected_walker
  walker.request_access_fault <== memory.request_access_fault & selected_walker


  /* Retained response routing and shared status
     Completion routing uses the returned origin; the walker never observes LR reservations. */

  core_responses |> core.response
  walker_responses |> walker.response
  core.drained <== drained
  walker.drained <== drained
  core.reservation_valid <== memory.reservation_valid
  walker.reservation_valid <== Bool(#false)


  /* Early lookup selection
     The SRAM index follows the selected offer even under backpressure.
     A lone unresolved core translation may still read by virtual address. */

  lookup.valid <== mux(selected_walker, walker_lookup.valid, core_lookup.valid)
  lookup.bits <== mux(selected_walker, walker_lookup.bits, core_lookup.bits)
  when (memory.request.valid):
    assert(lookup.valid, "rv5stage_physical_data_request_has_lookup")
    assert(lookup.bits[0..12] === memory.request.bits.memory.address[0..12], "rv5stage_physical_data_lookup_page_offset")

export:
  RV5StageDataPortArbiter
