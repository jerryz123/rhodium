#lang rhodium
// Defines physical instruction and data requests carried by RV5Stage's shared uncached path.
// SPDX-License-Identifier: Apache-2.0

import:
  "dcache/protocol.rhdl" open
  "icache/protocol.rhdl" open
  "../../riscv/isa/xlen.rhm".XLen
  lib("rhodium/std/ready-valid.rhdl") open

bundle RV5StagePhysicalInstructionReq(xlen :: XLen):
  address: Bits(xlen.width)
  cacheable: Bool
  device: Bool

interface RV5StagePhysicalInstructionAccess(xlen :: XLen):
  role requester
  role responder
  provider requester

  requester -> responder:
    flush: Bool
    invalidate_all: Bool
    request: Decoupled(RV5StagePhysicalInstructionReq(xlen))

  responder -> requester:
    response: Irrevocable(RV5StageInstructionResp())

bundle RV5StageUncachedDataReq(xlen :: XLen):
  request: RV5StageDataReq(xlen)
  device: Bool

interface RV5StageUncachedDataAccess(xlen :: XLen):
  role requester
  role responder
  provider requester

  requester -> responder:
    request: Decoupled(RV5StageUncachedDataReq(xlen))

  responder -> requester:
    request_fault: Bool
    request_access_fault: Bool
    response: Valid(RV5StageDataResp(xlen))
    drained: Bool

export:
  RV5StagePhysicalInstructionReq
  RV5StagePhysicalInstructionAccess
  RV5StageUncachedDataReq
  RV5StageUncachedDataAccess
