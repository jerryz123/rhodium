#lang rhodium
/* Defines RV5Stage post-translation data routing metadata and admission feedback. */
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/meta open
  "memory-context.rhdl" open
  "../common/cache/protocol.rhdl" open
  lib("rhodium/std/bits.rhdl").Pow2Int
  "../../riscv/isa/xlen.rhm".XLen
  lib("rhodium/std/ready-valid.rhdl") open

/* Specializes the shared physical payload with the RV5Stage return context. */
expr.macro
| 'RV5StagePhysicalDataReq($xlen, $slots): $field; ...':
    'PhysicalDataReq($xlen, RV5StageMemoryContext($slots), ($xlen).width): $field; ...'
| 'RV5StagePhysicalDataReq($xlen, $slots)': 'PhysicalDataReq($xlen, RV5StageMemoryContext($slots), ($xlen).width)'
| 'RV5StagePhysicalDataReq': 'fun (xlen :: XLen, slots :: Pow2Int): RV5StagePhysicalDataReq(xlen, slots)'

annot.macro 'RV5StagePhysicalDataReq($xlen, $slots)': 'PhysicalDataReq($xlen, RV5StageMemoryContext($slots), ($xlen).width)'

/* Couples physical admission/faults with tagged completion, drain, and reservation status. */
interface RV5StagePhysicalDataAccess(xlen :: XLen, slots :: Pow2Int):
  role requester
  role responder
  provider requester
  requester -> responder:
    request: Decoupled(RV5StagePhysicalDataReq(xlen, slots))

  responder -> requester:
    request_fault: Bool
    request_access_fault: Bool
    response: Decoupled(PhysicalMemoryResp(xlen, RV5StageMemoryContext(slots)))
    drained: Bool
    reservation_valid: Bool

export:
  RV5StagePhysicalDataReq
  RV5StagePhysicalDataAccess
