#lang rhodium
/* Defines RV5Stage post-translation routing metadata and cancellable fetch interfaces. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/fetch/protocol.rhdl").PhysicalInstructionReq
  "memory-context.rhdl" open
  "../cache/protocol.rhdl" open
  lib("rhodium/std/bits.rhdl").Pow2Int
  "icache/protocol.rhdl" open
  "../../riscv/isa/xlen.rhm".XLen
  "../../riscv/rtl/svpbmt.rhdl" open
  lib("rhodium/std/ready-valid.rhdl") open

/* Carries a translated data request and its PBMT override into physical-region routing. */
bundle RV5StagePhysicalDataReq(xlen :: XLen, slots :: Pow2Int):
  memory: PhysicalMemoryReq(xlen, RV5StageMemoryContext(slots))
  pbmt: PageMemoryType

/* Couples physical admission/faults with tagged completion, drain, and reservation status. */
interface RV5StagePhysicalDataAccess(xlen :: XLen, slots :: Pow2Int):
  role requester
  role responder
  provider requester
  requester -> responder:
    request: Decoupled(RV5StagePhysicalDataReq(xlen, slots))

  responder -> requester:
    request_fault: Bool
    request_access_fault: Bool
    response: Decoupled(PhysicalMemoryResp(xlen, RV5StageMemoryContext(slots)))
    drained: Bool
    reservation_valid: Bool

/* Offers ordered instruction reads with flush/invalidation and held responses. */
interface RV5StagePhysicalInstructionAccess(xlen :: XLen):
  role requester
  role responder
  provider requester

  requester -> responder:
    flush: Bool
    invalidate_all: Bool
    request: Decoupled(PhysicalInstructionReq(xlen.width))

  responder -> requester:
    response: Irrevocable(RV5StageInstructionResp(#false))

export:
  RV5StagePhysicalDataReq
  RV5StagePhysicalDataAccess
  RV5StagePhysicalInstructionAccess
