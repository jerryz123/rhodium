#lang rhodium
/* Queues nonspeculative vector descriptors and composes execution maturity with head-owned
   memory replay. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/common/vector/service.rhdl").VectorExecutionService
  lib("cores/common/vector/backend.rhdl") open
  lib("cores/common/mmu/vector.rhdl") open
  "../common/fp/timing.rhdl" open
  "memory-context.rhdl" open
  "../common/cache/protocol.rhdl" open
  "../common/cosim-source.rhm".describe_cosim_signals
  "../common/vector/bundles.rhdl" open
  "vector/memory.rhdl" open
  "mmu/protocol.rhdl" open
  "../../riscv/isa/vector.rhm" open
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/rtl/pointer-masking.rhdl" open
  "../../riscv/rtl/hypervisor.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

/* Queues two WB-admitted descriptors and certifies only the head before execution dispatch.
   Keeps page-window ownership, fault-certainty barriers, and registered architectural
   outcomes separate from the older execution owner's retained requests and results. */
sync_circuit RV5StageVectorPipeline(xlen :: XLen, vlen :: VectorLength, ~vector_completion_slots: slots :: Pow2Int = 8, ~trace_isa: trace_isa :: maybe(String) = #false, ~multiply_latency: multiply_latency :: maybe(PosInt) = #false, ~fixed_fp: fixed_fp :: Boolean = #false, ~fp_timing: fp_timing :: FpExecutionTiming = FpExecutionTiming(), ~hypervisor: hypervisor :: Boolean = #false):
  interface service(VectorExecutionService(xlen, slots), ~role: executor)
  interface request(Decoupled(VectorDescriptor(xlen)), ~role: consumer)
  output(pipeline_physical, request_physical): Bool
  interface pipeline(CachePipelineAccess(xlen), ~role: requester)
  interface memory(CacheAccess(xlen, RV5StageMemoryContext(slots)), ~role: requester)
  interface outcome(Valid(VectorCommit(xlen, slots)), ~role: producer)
  interface precheck(VectorPrecheck(), ~role: requester)
  output active: Bool

  inst access(RV5StageVectorMemory(xlen, slots, ~hypervisor: hypervisor))
  inst backend(VectorBackend(xlen, vlen, if hypervisor | RiscvGuestException() | Bool, ~vector_completion_slots: slots, ~pipe: #true, ~trace_isa: trace_isa, ~multiply_latency: multiply_latency, ~fixed_fp: fixed_fp, ~fp_timing: fp_timing))
  input request_fault_address: Bits(xlen.width)
  access.request_fault_address <== request_fault_address
  interface split_completion(Valid(RiscvSplitResult(xlen, RV5StageMemoryContext(slots))), ~role: consumer)
  split_completion |> access.split_completion
  if hypervisor
  | block:
      input(request_guest_fault, pipeline_guest_fault): RiscvGuestException()
      output outcome_guest: RiscvGuestException()
      access.request_guest_fault <== request_guest_fault
      access.pipeline_guest_fault <== pipeline_guest_fault
      backend.precise_fault <== access.outcome_guest
      outcome_guest <== backend.outcome_fault
  | backend.precise_fault <== Bool(#false)

  access.store <== backend.store
  backend.memory_drained <== memory.drained
  active <== backend.active
  request |> backend.request
  backend.precheck <=> precheck
  backend.outcome |> outcome
  backend.issue |> access.issue
  access.feedback |> backend.decision
  access.completion |> backend.completion
  access.store_completed |> backend.store_completed
  access.outcome |> backend.precise
  backend.memory_start_ready <== access.memory_start_ready
  access.pointer_masking <== backend.pointer_masking
  access.pipeline <=> pipeline
  access.memory <=> memory
  pipeline_physical <== access.pipeline_physical
  request_physical <== access.request_physical
  backend.service <=> service
  // The existing single FPR owner excludes scalar arithmetic until its direct write.
  backend.floating_writeback.ready <== Bool(#true)
  describe_cosim_signals({"admitted": request.fire()}, ~components: {"backend": backend, "memory": access})

/* Terminates the vector service boundary without state, requests, or architectural effects. */
sync_circuit DisabledRV5StageVectorPipeline(xlen :: XLen, ~vector_completion_slots: slots :: Pow2Int = 8, ~hypervisor: hypervisor :: Boolean = #false):
  interface service(VectorExecutionService(xlen, slots), ~role: executor)
  interface request(Decoupled(VectorDescriptor(xlen)), ~role: consumer)
  output(pipeline_physical, request_physical): Bool
  interface pipeline(CachePipelineAccess(xlen), ~role: requester)
  interface memory(CacheAccess(xlen, RV5StageMemoryContext(slots)), ~role: requester)
  interface outcome(Valid(VectorCommit(xlen, slots)), ~role: producer)
  interface precheck(VectorPrecheck(), ~role: requester)
  output active: Bool

  input request_fault_address: Bits(xlen.width)
  interface split_completion(Valid(RiscvSplitResult(xlen, RV5StageMemoryContext(slots))), ~role: consumer)
  if hypervisor
  | block:
      input(request_guest_fault, pipeline_guest_fault): RiscvGuestException()
      output outcome_guest: RiscvGuestException()
      outcome_guest <== literal(RiscvGuestException(), 0)
  | #void

  request.ready <== Bool(#false)
  pipeline_physical <== Bool(#false)
  request_physical <== Bool(#false)
  pipeline.request.valid <== Bool(#false)
  pipeline.request.bits <== dont_care(CachePipelineReq(xlen))
  pipeline.commit <== Bool(#false)
  memory.request.valid <== Bool(#false)
  memory.request.bits <== dont_care(PhysicalMemoryReq(xlen, RV5StageMemoryContext(slots)))
  memory.response.ready <== Bool(#true)
  outcome.valid <== Bool(#false)
  outcome.bits <== dont_care(VectorCommit(xlen, slots))
  precheck.request.valid <== Bool(#false)
  precheck.request.bits <== dont_care(VectorRange())
  precheck.response.ready <== Bool(#true)
  precheck.release.valid <== Bool(#false)
  service.fp_request.valid <== Bool(#false)
  service.fp_request.bits <== dont_care(service.fp_request.bits.type)
  service.fp_result.ready <== Bool(#true)
  service.multiply_request.valid <== Bool(#false)
  service.multiply_request.bits <== dont_care(service.multiply_request.bits.type)
  service.multiply_result.ready <== Bool(#true)
  service.divide_request.valid <== Bool(#false)
  service.divide_request.bits <== dont_care(service.divide_request.bits.type)
  service.divide_result.ready <== Bool(#true)
  service.fp_update.valid <== Bool(#false)
  service.fp_update.bits <== Bits(5)(0)
  service.fault_start.valid <== Bool(#false)
  service.fault_start.bits <== Bits(xlen.width)(0)
  service.truncate.valid <== Bool(#false)
  service.truncate.bits <== Bits(xlen.width)(0)
  service.retire.valid <== Bool(#false)
  service.execution_done.valid <== Bool(#false)
  service.saturate.valid <== Bool(#false)
  service.scalar_result.valid <== Bool(#false)
  service.scalar_result.bits <== dont_care(service.scalar_result.bits.type)
  service.scalar_writeback.valid <== Bool(#false)
  service.scalar_writeback.bits <== Bits(4)(1)
  service.floating_result.valid <== Bool(#false)
  service.floating_result.bits <== dont_care(service.floating_result.bits.type)
  active <== Bool(#false)
  service.sequencing <== Bool(#false)
  service.pending <== Bool(#false)
  service.stores_pending <== Bool(#false)
  service.certification_pending <== Bool(#false)
  service.loads_pending <== Bool(#false)
  service.fp_pending <== Bool(#false)
  service.available <== Bool(#false)

export:
  RV5StageVectorPipeline
  DisabledRV5StageVectorPipeline
