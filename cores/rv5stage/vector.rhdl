#lang rhodium
// Queues nonspeculative vector descriptors and composes execution maturity with head-owned memory replay.
// SPDX-License-Identifier: Apache-2.0

import:
  "vector/bundles.rhdl" open
  "vector/pipeline.rhdl" open
  "vector/memory.rhdl" open
  "vector/precheck.rhdl" open
  "mmu/protocol.rhdl" open
  "vector/muldiv.rhdl" open
  "integer-execution.rhdl" open
  "dcache/protocol.rhdl" open
  "../multiplier.rhdl" open
  "../divider.rhdl" open
  "fp/bundles.rhdl" open
  "fp/register-file.rhdl".FloatingPointRegisterWrite
  "register-file.rhdl".RegisterFileWrite
  "../../riscv/isa/fp-profile.rhm" open
  "../../riscv/isa/vector.rhm" open
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/rtl/pointer-masking.rhdl" open
  lib("hardfloat/main.rhdl").RoundingMode
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

sync_circuit RV5StageVectorPipeline(xlen :: XLen, vlen :: VectorLength, ~vector_completion_slots: slots :: Pow2Int = 8, ~trace_isa: trace_isa :: maybe(String) = #false):
  def fp_profile = if xlen == XLen.X32 | FloatingPointProfile.F | FloatingPointProfile.D
  def Tag = Bits(index_width(slots))
  def MultiplyTag = RV5StageVectorMultiplyTag(slots)
  def DivideTag = RV5StageVectorDivideTag(slots)
  interface request(Decoupled(RV5StageVectorDescriptor(xlen)), ~role: consumer)
  interface pipeline(RV5StagePipelineAccess(xlen), ~role: requester)
  interface memory(RV5StageDataAccess(xlen, slots), ~role: requester)
  interface outcome(Valid(RV5StageVectorCommit(xlen, slots)), ~role: producer)
  interface precheck(RV5StageVectorPrecheck(), ~role: requester)
  interface fp_request(Decoupled(RV5StageFpExecutionRequest(xlen, fp_profile, Tag)), ~role: producer)
  interface fp_result(Irrevocable(RV5StageFpExecutionResult(xlen, fp_profile, Tag)), ~role: consumer)
  interface multiply_request(Decoupled(RV5StageExecutionRequest(MultiplierRequest(xlen.width), MultiplyTag)), ~role: producer)
  interface multiply_result(Irrevocable(RV5StageExecutionResult(Bits(xlen.width * 2), MultiplyTag)), ~role: consumer)
  interface divide_request(Decoupled(RV5StageExecutionRequest(DividerRequest(xlen.width), DivideTag)), ~role: producer)
  interface divide_result(Irrevocable(RV5StageExecutionResult(DividerResponse(xlen.width), DivideTag)), ~role: consumer)
  interface fp_update(Valid(Bits(5)), ~role: producer)
  interface fault_start(Valid(Bits(xlen.width)), ~role: producer)
  interface truncate(Valid(Bits(xlen.width)), ~role: producer)
  interface retire(Pulse(), ~role: producer)
  interface execution_done(Pulse(), ~role: producer)
  interface saturate(Pulse(), ~role: producer)
  interface scalar_result(Valid(RegisterFileWrite(xlen)), ~role: producer)
  interface floating_result(Valid(FloatingPointRegisterWrite(fp_profile)), ~role: producer)
  output(active, sequencing, pending, stores_pending): Bool
  output(certification_pending, loads_pending, fp_pending): Bool
  output available: Bool

  inst execution(RV5StageVectorExecution(xlen, vlen, Bits(xlen.width), ~vector_completion_slots: slots, ~trace_isa: trace_isa))
  inst access(RV5StageVectorMemory(xlen, slots))
  // Pending descriptor policy is independent of the older execution owner's
  // LSU policy, so prechecking the next macro cannot perturb active issue.
  reg store(~init: Bool(#false))
  reg captured_pointer_masking(PointerMaskControl())
  reg execution_certified(~init: Bool(#false))
  reg active_precheck(~init: Bool(#false))
  reg check_started(~init: Bool(#false))
  reg check_complete(~init: Bool(#false))
  reg certified(~init: Bool(#false))
  reg waiting_retirement(~init: Bool(#false))
  inst instructions(Queue(RV5StageVectorDescriptor(xlen), 2, ~pipe: #true, ~flow: #true))
  def can_admit = !waiting_retirement
  request |> gate_flow(can_admit) |> instructions.ingress
  def queued_descriptor = instructions.egress
  available <== can_admit & instructions.ingress.ready
  // Only the head owns these controls. Enqueuing another descriptor cannot
  // change a pending certificate or the older execution owner's LSU policy.
  def footprint = vector_footprint(xlen, vlen, queued_descriptor.bits, queued_descriptor.bits.pointer_masking)
  def needs_check = queued_descriptor.bits.control.memory & !footprint.empty & footprint.eligible
  def immediate_certificate = !queued_descriptor.bits.control.memory ||| footprint.empty
  def head_certified = immediate_certificate ||| (check_complete & certified)
  (
    queued_descriptor |> map_flow(descriptor => RV5StageVectorInstruction(xlen, Bits(xlen.width))):
      context: descriptor.pc
      descriptor: descriptor
  ) |> gate_flow(!needs_check ||| check_complete) |> execution.request
  execution.packed_memory <== head_certified & queued_descriptor.bits.control.memory
  precheck.request.valid <== queued_descriptor.valid & needs_check & !check_started
  precheck.request.bits <== footprint.range.updated(~first: footprint.range.first.align_down(xlen.width / 8), ~last: footprint.range.last ||| bits(xlen.width / 8 - 1, 64))
  def checked = precheck.response |> gate_flow(check_started & !check_complete) |> to_valid()
  // The page window belongs to the current sequencer, not an older compute
  // macro whose final beat may issue after a memory descriptor replaces it.
  precheck.release.valid <== execution.sequencing_done.valid & active_precheck
  def empty_memory = inject_flow(Valid(Bits(xlen.width)), ~valid: execution.request.fire() & queued_descriptor.bits.control.memory & footprint.empty, ~bits: queued_descriptor.bits.pc)
  def checked_memory = checked |> filter_valid(safe => safe) |> map_valid(_safe => queued_descriptor.bits.pc)
  def early_outcome = Array(empty_memory, checked_memory) |> valid_arbiter() |> map_valid(pc => RV5StageVectorCommit(xlen, slots)):
    tag: bits(0, index_width(slots))
    pc: pc
    disposition: RV5StageVectorDisposition.Authorized
    slow: Bool(#false)
    data: bits(0, xlen.width)
    cause: bits(0, xlen.width)
    fault_address: bits(0, xlen.width)
  execution.issue |> filter_flow(operation => operation.memory) |> access.issue
  access.feedback |> execution.decision
  access.completion |> execution.completion
  // LSU admission may depend on scalar requests. Register macro retirement so
  // its selection cannot feed scalar WB request formation in that same cycle.
  def final_outcome = access.outcome |> filter_valid(_event => !execution_certified)
  Array(early_outcome, final_outcome) |> valid_arbiter() |> valid_pipe(1) |> outcome
  when (request.fire() & request.bits.control.memory):
    waiting_retirement <== Bool(#true)
  elsewhen (outcome.valid):
    waiting_retirement <== Bool(#false)
  when (execution.request.fire()):
    check_started <== Bool(#false)
    check_complete <== Bool(#false)
    certified <== Bool(#false)
  elsewhen (precheck.request.fire()):
    check_started <== Bool(#true)
  elsewhen (checked.valid):
    check_complete <== Bool(#true)
    certified <== checked.bits
  when (execution.request.fire()):
    store <== queued_descriptor.bits.control.store & queued_descriptor.bits.control.memory
    captured_pointer_masking <== queued_descriptor.bits.pointer_masking
    execution_certified <== head_certified
    active_precheck <== needs_check
  elsewhen (precheck.release.valid):
    active_precheck <== Bool(#false)
  when (precheck.response.fire()):
    assert(queued_descriptor.valid & needs_check, "vector_precheck_has_pending_descriptor")
  when (execution_certified & access.feedback.valid):
    assert(access.feedback.bits.disposition.is_one_of(RV5StageVectorDisposition.Authorized, RV5StageVectorDisposition.Retry), "certified_vector_cannot_fault")
  access.pipeline <=> pipeline
  access.memory <=> memory
  access.store <== store
  access.pointer_masking <== captured_pointer_masking
  // Only local rejection rewinds the allocated macro; younger scalar redirects do not cancel it.
  execution.cancel.valid <== Bool(#false)
  execution.memory_drained <== memory.drained
  execution.fp_request |> fp_request
  fp_result |> execution.fp_result
  execution.multiply_request |> multiply_request
  multiply_result |> execution.multiply_result
  execution.divide_request |> divide_request
  divide_result |> execution.divide_result
  execution.fp_update |> fp_update
  execution.fault_start |> fault_start
  execution.truncate |> truncate
  retire.valid <== outcome.valid & (outcome.bits.disposition =/= RV5StageVectorDisposition.Fault)
  execution.retire |> execution_done
  execution.saturate |> saturate
  execution.scalar_result |> scalar_result
  execution.floating_result |> floating_result
  // Summaries cover both waiting entries, including a non-head FP or memory
  // descriptor. Transfer into execution moves ownership without a status gap.
  reg queued_loads(~init: bits(0, 2))
  reg queued_stores(~init: bits(0, 2))
  reg queued_fp(~init: bits(0, 2))
  def enqueue = instructions.ingress.fire()
  def dequeue = queued_descriptor.fire()
  def incoming = instructions.ingress.bits.control
  def outgoing = queued_descriptor.bits.control
  queued_loads <== queued_loads + (enqueue & incoming.memory & !incoming.store).as_bits().zext(2) - (dequeue & outgoing.memory & !outgoing.store).as_bits().zext(2)
  queued_stores <== queued_stores + (enqueue & incoming.memory & incoming.store).as_bits().zext(2) - (dequeue & outgoing.memory & outgoing.store).as_bits().zext(2)
  queued_fp <== queued_fp + (enqueue & incoming.floating_point).as_bits().zext(2) - (dequeue & outgoing.floating_point).as_bits().zext(2)
  assert((queued_loads <= instructions.count) & (queued_stores <= instructions.count) & (queued_fp <= instructions.count), "vector_queued_kinds_match_occupancy")
  active <== execution.active ||| waiting_retirement ||| queued_descriptor.valid
  sequencing <== execution.sequencing
  pending <== execution.pending
  stores_pending <== execution.stores_pending ||| queued_stores.or_reduce()
  certification_pending <== waiting_retirement
  loads_pending <== execution.loads_pending ||| queued_loads.or_reduce()
  fp_pending <== execution.fp_pending ||| queued_fp.or_reduce()

export:
  RV5StageVectorPipeline
