#lang rhodium
/* Projects RV5Stage configuration and decoded operations onto the shared CSR/trap service. */
// SPDX-License-Identifier: Apache-2.0

import:
  "profile.rhm" open
  "decode/system-ctrl.rhdl" open
  "decode/fence-ctrl.rhdl" open
  "../riscv/csr/config.rhm".RiscvCsrConfig
  "../riscv/csr/protocol.rhdl" open
  lib("riscv/isa/hart.rhm").RiscvMmuType
  lib("rhodium/std/bits.rhdl") open

/* Selects architectural CSR banks without exporting pipeline, cache, or execution configuration. */
fun rv5stage_csr_config(profile :: RV5StageConfig) :: RiscvCsrConfig:
  RiscvCsrConfig(
    profile.isa_profile,
    ~mmu_type: if profile.mmu_mode == RV5StageMmuMode.Bare | RiscvMmuType.Bare | RiscvMmuType.Sv39,
    ~floating_point: profile.extensions.floating_point,
    ~compressed: profile.extensions.compressed,
    ~vector: profile.vector,
    ~vector_length: profile.vector_length,
    ~hypervisor: profile.extensions.hypervisor,
    ~sscofpmf: profile.extensions.sscofpmf,
    ~sstc: profile.extensions.sstc,
    ~smstateen: profile.extensions.smstateen,
    ~zicboz: profile.extensions.zicboz,
    ~zicbom: profile.extensions.zicbom,
    ~ssnpm: profile.extensions.ssnpm,
    ~svpbmt: profile.extensions.svpbmt
  )

/* Maps decoded permission checks and state transitions; WRS and ordinary fences remain core-owned. */
fun rv5stage_csr_action(system :: RV5StageSystemControl(), fence :: RV5StageFenceControl()) :~ RiscvCsrAction:
  def system_action = mux_lookup(system.action, ~default: RiscvCsrAction.None, [
    [RV5StageSystemOperation.Ecall, RiscvCsrAction.Ecall],
    [RV5StageSystemOperation.Ebreak, RiscvCsrAction.Ebreak],
    [RV5StageSystemOperation.Mret, RiscvCsrAction.Mret],
    [RV5StageSystemOperation.Sret, RiscvCsrAction.Sret],
    [RV5StageSystemOperation.Wfi, RiscvCsrAction.Wfi],
    [RV5StageSystemOperation.VectorConfig, RiscvCsrAction.VectorConfig]
  ])
  mux_lookup(fence.action, ~default: system_action, [
    [RV5StageFenceOperation.AddressTranslation, RiscvCsrAction.SfenceVma],
    [RV5StageFenceOperation.GuestVirtualTranslation, RiscvCsrAction.HfenceVvma],
    [RV5StageFenceOperation.GuestPhysicalTranslation, RiscvCsrAction.HfenceGvma],
    [RV5StageFenceOperation.TranslationOrder, RiscvCsrAction.TranslationOrder]
  ])

export:
  rv5stage_csr_config
  rv5stage_csr_action
