#lang rhodium
// Implements RV5Stage's commit-owned CSR, privilege, trap, and interrupt state.

import:
  "profile.rhm".RVCoreProfile
  "decode/fence-ctrl.rhdl" open
  "decode/system-ctrl.rhdl" open
  "interrupt.rhdl" open
  "../../riscv/isa/c.rhm" open
  "../../riscv/isa/csr.rhm" open
  "../../riscv/isa/fp-profile.rhm" open
  "../../riscv/isa/interrupt.rhm" open
  "../../riscv/isa/trap.rhm" open
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/rtl/csr.rhdl" open
  "../../riscv/rtl/counters.rhdl" open
  "../../riscv/rtl/interrupt.rhdl" open
  "../../riscv/rtl/trap.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/ready-valid.rhdl") open

hardware_enum PrivilegeMode(~width: 2):
  User = 0
  Supervisor = 1
  Machine = 3

bundle RV5StageCsrCommit(xlen :: XLen):
  pc: Bits(xlen.width)
  instruction: Bits(32)
  rd: Bits(5)
  system: SystemControl()
  fence: FenceControl()
  csr_address: Bits(12)
  csr_source: Bits(xlen.width)
  exception_valid: Bool
  exception_cause: Bits(xlen.width)
  exception_value: Bits(xlen.width)

bundle RV5StageCsrState(xlen :: XLen):
  menvcfg: Bits(xlen.width)
  senvcfg: Bits(xlen.width)
  mstatus: Bits(xlen.width)
  medeleg: Bits(xlen.width)
  mideleg: Bits(xlen.width)
  mie: Bits(xlen.width)
  mip: Bits(xlen.width)
  mtvec: Bits(xlen.width)
  mcounteren: Bits(xlen.width)
  mscratch: Bits(xlen.width)
  mepc: Bits(xlen.width)
  mcause: Bits(xlen.width)
  mtval: Bits(xlen.width)
  stvec: Bits(xlen.width)
  scounteren: Bits(xlen.width)
  sscratch: Bits(xlen.width)
  sepc: Bits(xlen.width)
  scause: Bits(xlen.width)
  stval: Bits(xlen.width)
  satp: Bits(xlen.width)

bundle RV5StageTrapDecision(xlen :: XLen):
  valid: Bool
  cause: Bits(xlen.width)
  value: Bits(xlen.width)
  to_supervisor: Bool

bundle RV5StageInterruptDecision(xlen :: XLen):
  valid: Bool
  cause: Bits(xlen.width)
  to_supervisor: Bool

bundle RV5StageFpCsrWrite():
  address: Bits(12)
  value: Bits(8)

def RV5StageDelegatableExceptions = [
  ExceptionCause.InstructionAddressMisaligned,
  ExceptionCause.InstructionAccessFault,
  ExceptionCause.IllegalInstruction,
  ExceptionCause.Breakpoint,
  ExceptionCause.LoadAddressMisaligned,
  ExceptionCause.LoadAccessFault,
  ExceptionCause.StoreAddressMisaligned,
  ExceptionCause.StoreAccessFault,
  ExceptionCause.EnvironmentCallFromUser,
  ExceptionCause.InstructionPageFault,
  ExceptionCause.LoadPageFault,
  ExceptionCause.StorePageFault
]

fun resolve_rv5stage_trap(xlen :: XLen,
                          commit_valid :: Bool,
                          operation :: RV5StageCsrCommit(xlen),
                          privilege :: PrivilegeMode,
                          mstatus :: Bits(xlen.width),
                          csr_access_legal :: Bool,
                          medeleg :: Bits(xlen.width)) :~ RV5StageTrapDecision(xlen):
  def width = xlen.width
  def zero = bits(0, width)
  def csr_commit = commit_valid & (operation.system.csr =/= CsrOperation.None)
  def illegal_csr = csr_commit & !csr_access_legal
  def supervisor = privilege === PrivilegeMode.Supervisor
  def less_than_machine = privilege =/= PrivilegeMode.Machine
  def illegal_mret = (operation.system.action === SystemOperation.Mret) & less_than_machine
  def illegal_sret = (operation.system.action === SystemOperation.Sret) & (
    (privilege === PrivilegeMode.User) ||| (supervisor & mstatus[22].into(Bool))
  )
  def illegal_wfi = (operation.system.action === SystemOperation.Wfi) & (
    (privilege === PrivilegeMode.User) ||| (supervisor & mstatus[21].into(Bool))
  )
  def illegal_sfence_vma = (operation.fence.action === FenceOperation.AddressTranslation) & (
    (privilege === PrivilegeMode.User) ||| (supervisor & mstatus[20].into(Bool))
  )
  def illegal_privileged_operation = commit_valid & (
    illegal_mret ||| illegal_sret ||| illegal_wfi ||| illegal_sfence_vma
  )
  def explicit_exception = commit_valid & operation.exception_valid
  def ecall = commit_valid & (operation.system.action === SystemOperation.Ecall)
  def ebreak = commit_valid & (operation.system.action === SystemOperation.Ebreak)
  def trap_event = explicit_exception ||| illegal_csr ||| illegal_privileged_operation ||| ecall ||| ebreak
  def ecall_cause = mux_lookup(
    privilege,
    ~default: exception_cause_bits(ExceptionCause.EnvironmentCallFromMachine, width),
    [
      [PrivilegeMode.User, exception_cause_bits(ExceptionCause.EnvironmentCallFromUser, width)],
      [PrivilegeMode.Supervisor, exception_cause_bits(ExceptionCause.EnvironmentCallFromSupervisor, width)],
      [PrivilegeMode.Machine, exception_cause_bits(ExceptionCause.EnvironmentCallFromMachine, width)]
    ]
  )
  def generated_cause = mux(
    ecall,
    ecall_cause,
    mux(
      ebreak,
      exception_cause_bits(ExceptionCause.Breakpoint, width),
      exception_cause_bits(ExceptionCause.IllegalInstruction, width)
    )
  )
  def cause = mux(explicit_exception, operation.exception_cause, generated_cause)
  def instruction = if width == 32 | operation.instruction | operation.instruction.zext(width)
  def value = mux(
    explicit_exception,
    operation.exception_value,
    mux(illegal_csr ||| illegal_privileged_operation, instruction, zero)
  )
  def delegated = mux_lookup(
    cause,
    ~default: Bool(#false),
    RV5StageDelegatableExceptions.map(
      fun (candidate):
        def code = exception_code(candidate)
        [code, medeleg[code].into(Bool)]
    )
  )
  RV5StageTrapDecision(xlen):
    valid: trap_event
    cause: cause
    value: value
    to_supervisor: trap_event & (privilege =/= PrivilegeMode.Machine) & delegated

fun resolve_rv5stage_interrupt(xlen :: XLen,
                               pending :: Bits(xlen.width),
                               enabled :: Bits(xlen.width),
                               delegated :: Bits(xlen.width),
                               mstatus :: Bits(xlen.width),
                               privilege :: PrivilegeMode) :~ RV5StageInterruptDecision(xlen):
  def width = xlen.width
  def machine_globally_enabled = (privilege =/= PrivilegeMode.Machine) ||| mstatus[3].into(Bool)
  def supervisor_globally_enabled = (privilege === PrivilegeMode.User) ||| (
    (privilege === PrivilegeMode.Supervisor) & mstatus[1].into(Bool)
  )
  fun candidate(cause :: InterruptCause) :~ Bool:
    def code = interrupt_code(cause)
    def to_supervisor = delegated[code].into(Bool)
    pending[code].into(Bool) & enabled[code].into(Bool) & mux(
      to_supervisor,
      supervisor_globally_enabled,
      machine_globally_enabled
    )
  def machine_external = candidate(InterruptCause.MachineExternal)
  def machine_software = candidate(InterruptCause.MachineSoftware)
  def machine_timer = candidate(InterruptCause.MachineTimer)
  def supervisor_external = candidate(InterruptCause.SupervisorExternal)
  def supervisor_software = candidate(InterruptCause.SupervisorSoftware)
  def supervisor_timer = candidate(InterruptCause.SupervisorTimer)
  def valid = machine_external ||| machine_software ||| machine_timer ||| supervisor_external ||| supervisor_software ||| supervisor_timer
  def cause = mux(
    machine_external,
    interrupt_cause_bits(InterruptCause.MachineExternal, width),
    mux(
      machine_software,
      interrupt_cause_bits(InterruptCause.MachineSoftware, width),
      mux(
        machine_timer,
        interrupt_cause_bits(InterruptCause.MachineTimer, width),
        mux(
          supervisor_external,
          interrupt_cause_bits(InterruptCause.SupervisorExternal, width),
          mux(
            supervisor_software,
            interrupt_cause_bits(InterruptCause.SupervisorSoftware, width),
            interrupt_cause_bits(InterruptCause.SupervisorTimer, width)
          )
        )
      )
    )
  )
  def to_supervisor = mux_lookup(
    cause[0..4],
    ~default: Bool(#false),
    [
      [interrupt_code(InterruptCause.SupervisorSoftware), delegated[interrupt_code(InterruptCause.SupervisorSoftware)].into(Bool)],
      [interrupt_code(InterruptCause.SupervisorTimer), delegated[interrupt_code(InterruptCause.SupervisorTimer)].into(Bool)],
      [interrupt_code(InterruptCause.SupervisorExternal), delegated[interrupt_code(InterruptCause.SupervisorExternal)].into(Bool)]
    ]
  )
  RV5StageInterruptDecision(xlen):
    valid: valid
    cause: cause
    to_supervisor: valid & to_supervisor

sync_circuit RV5StageDisabledFpCsrs():
  interface write(Valid(RV5StageFpCsrWrite()), ~role: consumer)
  interface update(Valid(Bits(5)), ~role: consumer)
  interface status_write(Valid(Bits(2)), ~role: consumer)
  output fflags: Bits(5)
  output frm: Bits(3)
  output status: Bits(2)

  fflags <== bits(0, 5)
  frm <== bits(0, 3)
  status <== bits(0, 2)

sync_circuit RV5StageFpCsrs():
  interface write(Valid(RV5StageFpCsrWrite()), ~role: consumer)
  interface update(Valid(Bits(5)), ~role: consumer)
  interface status_write(Valid(Bits(2)), ~role: consumer)
  output fflags: Bits(5)
  output frm: Bits(3)
  output status: Bits(2)

  reg fflags_state(~init: bits(0, 5))
  reg frm_state(~init: bits(0, 3))
  reg status_state(~init: bits(0, 2))
  def write_fflags = write.valid & (write.bits.address === csr_bits(CsrId.Fflags))
  def write_frm = write.valid & (write.bits.address === csr_bits(CsrId.Frm))
  def write_fcsr = write.valid & (write.bits.address === csr_bits(CsrId.Fcsr))

  when write_fcsr:
    fflags_state <== write.bits.value[0..5]
  elsewhen write_fflags:
    fflags_state <== write.bits.value[0..5]
  elsewhen (update.valid):
    fflags_state <== fflags_state ||| update.bits

  when write_fcsr:
    frm_state <== write.bits.value[5..8]
  elsewhen write_frm:
    frm_state <== write.bits.value[0..3]

  when (status_write.valid):
    status_state <== status_write.bits
  elsewhen (write.valid ||| update.valid):
    status_state <== bits(3, 2)

  fflags <== fflags_state
  frm <== frm_state
  status <== status_state

sync_circuit RV5StageCsrFile(core_profile :: RVCoreProfile):
  def xlen = core_profile.xlen
  def profile = core_profile.extensions.floating_point
  def compressed_extensions = core_profile.extensions.compressed
  def width = xlen.width
  def compressed_enabled = compressed_extensions_enabled(compressed_extensions)
  def zero = bits(0, width)
  def mstatus_write_mask = bits(0x7e19bb, width)
  def sstatus_write_mask = bits(0xc0133, width)
  def mstatus_fixed = if xlen == XLen.X32 | zero | bits(0xa00000000, width)
  def sstatus_fixed = if xlen == XLen.X32 | zero | bits(0x200000000, width)
  def medeleg_mask = bits(exception_mask(RV5StageDelegatableExceptions), width)
  def mideleg_mask = bits(0x222, width)
  def interrupt_enable_mask = bits(0xaaa, width)
  def supervisor_interrupt_mask = bits(0x222, width)
  def counter_enable_mask = bits(0x7, width)
  def envcfg_mask = bits(if core_profile.extensions.zicboz | 0x80 | 0, width)
  def tvec_mask = !bits(0x3, width)
  def epc_mask = if compressed_enabled | !bits(0x1, width) | !bits(0x3, width)
  def mpp_mask = bits(0x1800, width)
  def misa_value = bits(core_profile.misa_value, width)

  input interrupts: RV5StageInterrupts()
  input hart_id: Bits(width)
  input time_counter: Bits(64)
  input interrupt_boundary: Bool
  input interrupt_pc: Bits(width)
  interface commit(Valid(RV5StageCsrCommit(xlen)), ~role: consumer)
  interface fp_update(Valid(Bits(5)), ~role: consumer)
  interface redirect(Valid(Bits(width)), ~role: producer)
  output interrupt_request: Bool
  output wfi_retired: Bool
  output wfi_wake: Bool
  output writeback_valid: Bool
  output writeback_value: Bits(width)
  output privilege: PrivilegeMode
  output mstatus: Bits(width)
  output satp: Bits(width)
  output frm: Bits(3)
  output fp_enabled: Bool
  output cbo_zero_enabled: Bool
  output translation_flush: Bool

  reg privilege_state(PrivilegeMode, ~init: PrivilegeMode.Machine)
  reg state(RV5StageCsrState(xlen), ~init: literal(RV5StageCsrState(xlen), 0))
  cbo_zero_enabled <== Bool(core_profile.extensions.zicboz) & (
    (privilege_state === PrivilegeMode.Machine) ||| (
      state.menvcfg[7].into(Bool) & ((privilege_state =/= PrivilegeMode.User) ||| state.senvcfg[7].into(Bool))
    )
  )
  inst counters(RiscvBaseCounters(xlen))
  def FpCsrModule = if floating_point_supports_f(profile) | RV5StageFpCsrs() | RV5StageDisabledFpCsrs()
  inst fp_csrs(FpCsrModule)
  fp_update |> fp_csrs.update

  fun flag_value(original :: Bits(width),
                 mask :: Bits(width),
                 enabled :: Bool):
    mux(enabled, original ||| mask, original & !mask)

  def fp_status_value = fp_csrs.status.zext(width) << 13
  def fp_status_dirty = fp_csrs.status === bits(3, 2)
  def status_dirty_value = mux(fp_status_dirty, bits(1 << (width - 1), width), zero)
  def mstatus_value = state.mstatus ||| mstatus_fixed ||| fp_status_value ||| status_dirty_value
  def sstatus_value = (state.mstatus & sstatus_write_mask) ||| sstatus_fixed ||| fp_status_value ||| status_dirty_value
  def cycle_value = if xlen == XLen.X32 | counters.cycle[0..32] | counters.cycle
  def cycleh_value = if xlen == XLen.X32 | counters.cycle[32..64] | zero
  def time_value = if xlen == XLen.X32 | time_counter[0..32] | time_counter
  def timeh_value = if xlen == XLen.X32 | time_counter[32..64] | zero
  def instret_value = if xlen == XLen.X32 | counters.instret[0..32] | counters.instret
  def instreth_value = if xlen == XLen.X32 | counters.instret[32..64] | zero
  def interrupt_pending = rv5stage_interrupt_pending(xlen, interrupts) ||| state.mip
  def csr = commit.bits.csr_address
  def bank = csr_bank(csr, ~default: zero):
    read CsrId.Fflags: fp_csrs.fflags.zext(width)
    read CsrId.Frm: fp_csrs.frm.zext(width)
    read CsrId.Fcsr: concat(fp_csrs.frm, fp_csrs.fflags).zext(width)
    csr CsrId.Sstatus:
      read: sstatus_value
      write value:
        state.mstatus <== masked_merge(state.mstatus, value, sstatus_write_mask)
    csr CsrId.Sie:
      read: state.mie & state.mideleg
      write value:
        state.mie <== masked_merge(state.mie, value, state.mideleg)
    csr CsrId.Stvec:
      read: state.stvec
      write value:
        state.stvec <== value & tvec_mask
    csr CsrId.Scounteren:
      read: state.scounteren
      write value:
        state.scounteren <== value & counter_enable_mask
    csr CsrId.Senvcfg:
      read: state.senvcfg
      write value:
        state.senvcfg <== value & envcfg_mask
    storage CsrId.Sscratch: state.sscratch
    csr CsrId.Sepc:
      read: state.sepc
      write value:
        state.sepc <== value & epc_mask
    storage CsrId.Scause: state.scause
    storage CsrId.Stval: state.stval
    csr CsrId.Sip:
      read: interrupt_pending & state.mideleg
      write value:
        state.mip <== masked_merge(
          state.mip,
          value,
          state.mideleg & supervisor_interrupt_mask
        )
    csr CsrId.Satp:
      read: state.satp
      write value:
        def satp_replacement = value.as_bits()
        when (if xlen == XLen.X32 | Bool(#false) | satp_replacement[60..64].is_one_of(bits(0, 4), bits(8, 4))):
          state.satp <== if xlen == XLen.X32 | zero | concat(satp_replacement[60..64], bits(0, 16), satp_replacement[0..44])
    read CsrId.Cycle: cycle_value
    read CsrId.Time: time_value
    read CsrId.Instret: instret_value
    read CsrId.Cycleh: cycleh_value
    read CsrId.Timeh: timeh_value
    read CsrId.Instreth: instreth_value
    csr CsrId.Mstatus:
      read: mstatus_value
      write value:
        state.mstatus <== masked_merge(state.mstatus, value, mstatus_write_mask)
    read CsrId.Misa: misa_value
    csr CsrId.Medeleg:
      read: state.medeleg
      write value:
        state.medeleg <== value & medeleg_mask
    csr CsrId.Mideleg:
      read: state.mideleg
      write value:
        state.mideleg <== value & mideleg_mask
    csr CsrId.Mie:
      read: state.mie
      write value:
        state.mie <== value & interrupt_enable_mask
    csr CsrId.Mtvec:
      read: state.mtvec
      write value:
        state.mtvec <== value & tvec_mask
    csr CsrId.Mcounteren:
      read: state.mcounteren
      write value:
        state.mcounteren <== value & counter_enable_mask
    csr CsrId.Menvcfg:
      read: state.menvcfg
      write value:
        state.menvcfg <== value & envcfg_mask
    storage CsrId.Mscratch: state.mscratch
    csr CsrId.Mepc:
      read: state.mepc
      write value:
        state.mepc <== value & epc_mask
    storage CsrId.Mcause: state.mcause
    storage CsrId.Mtval: state.mtval
    csr CsrId.Mip:
      read: interrupt_pending
      write value:
        state.mip <== value & supervisor_interrupt_mask
    read CsrId.Mcycle: cycle_value
    read CsrId.Minstret: instret_value
    read CsrId.Mcycleh: cycleh_value
    read CsrId.Minstreth: instreth_value
    read CsrId.Mvendorid: zero
    read CsrId.Marchid: zero
    read CsrId.Mimpid: zero
    read CsrId.Mhartid: hart_id
  def rv32_counter_halves = if xlen == XLen.X32 | Bool(#true) | Bool(#false)
  def high_counter_unavailable = !rv32_counter_halves & csr.is_one_of(
    csr_bits(CsrId.Cycleh), csr_bits(CsrId.Timeh), csr_bits(CsrId.Instreth),
    csr_bits(CsrId.Mcycleh), csr_bits(CsrId.Minstreth)
  )
  def fp_csr = csr.is_one_of(csr_bits(CsrId.Fflags), csr_bits(CsrId.Frm), csr_bits(CsrId.Fcsr))
  def fp_access_enabled = Bool(floating_point_supports_f(profile)) & or_reduce(fp_csrs.status)
  assert(!fp_update.valid ||| fp_access_enabled, "rv5stage_fp_update_enabled")
  def csr_recognized = bank.recognized & !high_counter_unavailable & (!fp_csr ||| fp_access_enabled)
  def csr_read_value = bank.read_value
  def write_requested = csr_write_requested(commit.bits.system.csr, commit.bits.instruction[15..20])
  def csr_read_only = csr[10..12] === bits(3, 2)
  def required_privilege = csr[8..10]
  def privilege_bits = privilege_state.into(Bits(2))
  def cycle_csr = csr.is_one_of(csr_bits(CsrId.Cycle), csr_bits(CsrId.Cycleh))
  def time_csr = csr.is_one_of(csr_bits(CsrId.Time), csr_bits(CsrId.Timeh))
  def instret_csr = csr.is_one_of(csr_bits(CsrId.Instret), csr_bits(CsrId.Instreth))
  def counter_csr = cycle_csr ||| time_csr ||| instret_csr
  def satp_restricted = (csr === csr_bits(CsrId.Satp)) & (
    privilege_state === PrivilegeMode.Supervisor
  ) & state.mstatus[20].into(Bool)
  def machine_counter_enabled = mux(cycle_csr,
                                    state.mcounteren[0].into(Bool),
                                    mux(time_csr,
                                        state.mcounteren[1].into(Bool),
                                        state.mcounteren[2].into(Bool)))
  def supervisor_counter_enabled = mux(cycle_csr,
                                       state.scounteren[0].into(Bool),
                                       mux(time_csr,
                                           state.scounteren[1].into(Bool),
                                           state.scounteren[2].into(Bool)))
  def counter_access_enabled = mux_lookup(
    privilege_state,
    ~default: machine_counter_enabled & supervisor_counter_enabled,
    [
      [PrivilegeMode.Machine, Bool(#true)],
      [PrivilegeMode.Supervisor, machine_counter_enabled]
    ]
  )
  def csr_access_legal = csr_recognized & !(
    privilege_bits < required_privilege
  ) & !(write_requested & csr_read_only) & !satp_restricted & (!counter_csr ||| counter_access_enabled)
  def csr_commit = commit.valid & (commit.bits.system.csr =/= CsrOperation.None)
  def synchronous_trap = resolve_rv5stage_trap(xlen, commit.valid, commit.bits, privilege_state, state.mstatus, csr_access_legal, state.medeleg)
  def interrupt = resolve_rv5stage_interrupt(
    xlen,
    interrupt_pending,
    state.mie,
    state.mideleg,
    state.mstatus,
    privilege_state
  )
  def interrupt_take = interrupt_boundary & !synchronous_trap.valid & interrupt.valid
  def trap = RV5StageTrapDecision(xlen):
    valid: synchronous_trap.valid ||| interrupt_take
    cause: mux(synchronous_trap.valid, synchronous_trap.cause, interrupt.cause)
    value: mux(synchronous_trap.valid, synchronous_trap.value, zero)
    to_supervisor: mux(
      synchronous_trap.valid,
      synchronous_trap.to_supervisor,
      interrupt.to_supervisor
    )
  def trap_pc = mux(interrupt_take, interrupt_pc, commit.bits.pc)

  def csr_replacement :: Bits(width) = mux_lookup(
    commit.bits.system.csr,
    ~default: csr_read_value,
    [
      [CsrOperation.Write, commit.bits.csr_source],
      [CsrOperation.Set, csr_read_value ||| commit.bits.csr_source],
      [CsrOperation.Clear, csr_read_value & !commit.bits.csr_source]
    ]
  )
  def csr_write = csr_commit & csr_access_legal & write_requested
  def fp_csr_write = csr_write & fp_csr
  fp_csrs.write.valid <== fp_csr_write
  fp_csrs.write.bits <== RV5StageFpCsrWrite():
    address: csr
    value: csr_replacement[0..8]
  fp_csrs.status_write.valid <== csr_write & csr.is_one_of(csr_bits(CsrId.Mstatus), csr_bits(CsrId.Sstatus))
  fp_csrs.status_write.bits <== csr_replacement[13..15]
  def sfence_vma_commit = commit.valid & (commit.bits.fence.action === FenceOperation.AddressTranslation)
  translation_flush <== (sfence_vma_commit & !synchronous_trap.valid) ||| (
    csr_write & (csr === csr_bits(CsrId.Satp))
  )
  def machine_counter_csr = csr.is_one_of(csr_bits(CsrId.Mcycle),
                                          csr_bits(CsrId.Minstret),
                                          csr_bits(CsrId.Mcycleh),
                                          csr_bits(CsrId.Minstreth))
  counters.retire <== commit.valid & !synchronous_trap.valid
  counters.machine_write.valid <== csr_write & machine_counter_csr
  counters.machine_write.bits <== RiscvCounterWrite(xlen):
    address: csr
    value: csr_replacement
  def mret = commit.valid & !trap.valid & (commit.bits.system.action === SystemOperation.Mret)
  def sret = commit.valid & !trap.valid & (commit.bits.system.action === SystemOperation.Sret)
  def mret_privilege = mux_lookup(
    state.mstatus[11..13],
    ~default: PrivilegeMode.User,
    [
      [1, PrivilegeMode.Supervisor],
      [3, PrivilegeMode.Machine]
    ]
  )
  def sret_privilege = mux(state.mstatus[8].into(Bool), PrivilegeMode.Supervisor, PrivilegeMode.User)
  def supervisor_trap_status = flag_value(
    flag_value(
      flag_value(state.mstatus, bits(0x20, width), state.mstatus[1].into(Bool)),
      bits(0x2, width),
      Bool(#false)
    ),
    bits(0x100, width),
    privilege_state === PrivilegeMode.Supervisor
  )
  def machine_trap_status = masked_merge(
    flag_value(
      flag_value(state.mstatus, bits(0x80, width), state.mstatus[3].into(Bool)),
      bits(0x8, width),
      Bool(#false)
    ),
    privilege_bits.zext(width) << 11,
    mpp_mask
  )
  def trap_mstatus = mux(trap.to_supervisor, supervisor_trap_status, machine_trap_status)
  def mret_status = flag_value(
    flag_value(
      masked_merge(state.mstatus, zero, mpp_mask),
      bits(0x8, width),
      state.mstatus[7].into(Bool)
    ),
    bits(0x80, width),
    Bool(#true)
  )
  def normalized_mret_status = mux(
    mret_privilege === PrivilegeMode.Machine,
    mret_status,
    mret_status & !bits(0x20000, width)
  )
  def sret_status = flag_value(
    flag_value(
      flag_value(state.mstatus, bits(0x2, width), state.mstatus[5].into(Bool)),
      bits(0x20, width),
      Bool(#true)
    ),
    bits(0x100, width),
    Bool(#false)
  ) & !bits(0x20000, width)

  writeback_valid <== csr_commit & csr_access_legal & or_reduce(commit.bits.rd)
  writeback_value <== csr_read_value
  interrupt_request <== interrupt.valid
  wfi_retired <== commit.valid & (commit.bits.system.action === SystemOperation.Wfi) & !synchronous_trap.valid
  wfi_wake <== or_reduce(interrupt_pending & state.mie)
  privilege <== privilege_state
  mstatus <== mstatus_value
  satp <== state.satp
  frm <== fp_csrs.frm
  fp_enabled <== fp_access_enabled
  redirect.valid <== trap.valid ||| mret ||| sret
  redirect.bits <== mux(
    trap.valid,
    mux(trap.to_supervisor, state.stvec, state.mtvec),
    mux(mret, state.mepc, state.sepc)
  )

  when (trap.valid):
    privilege_state <== mux(trap.to_supervisor, PrivilegeMode.Supervisor, PrivilegeMode.Machine)
  elsewhen mret:
    privilege_state <== mret_privilege
  elsewhen sret:
    privilege_state <== sret_privilege

  when (trap.valid & trap.to_supervisor):
    state.mstatus <== trap_mstatus
    state.sepc <== trap_pc & epc_mask
    state.scause <== trap.cause
    state.stval <== trap.value
  elsewhen (trap.valid):
    state.mstatus <== trap_mstatus
    state.mepc <== trap_pc & epc_mask
    state.mcause <== trap.cause
    state.mtval <== trap.value
  elsewhen mret:
    state.mstatus <== normalized_mret_status
  elsewhen sret:
    state.mstatus <== sret_status
  elsewhen csr_write:
    bank.write(csr_replacement)

export:
  PrivilegeMode
  RV5StageCsrCommit
  RV5StageCsrState
  RV5StageTrapDecision
  RV5StageInterruptDecision
  RV5StageCsrFile
  resolve_rv5stage_interrupt
  resolve_rv5stage_trap
