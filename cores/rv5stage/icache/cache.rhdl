#lang rhodium
// Caches coherent instruction snapshots until FENCE.I, independently of outer cache residency.

import:
  "../../cache-prefetch.rhdl" open
  "protocol.rhdl" open
  "../cache.rhdl" open
  "../chi/foundation.rhdl" open
  "../chi/line-read.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/read-write.rhdl") open
  lib("rhodium/std/sync-ram.rhdl") open
  lib("flow/main.rhdl") open
  lib("chi/protocol/flits.rhdl") open
  lib("chi/protocol/channels.rhdl").CHIRNIChannels

fun check_l1i_geometry(width :: PosInt, cache :: RV5StageCacheConfig):
  unless width > (alignment_bits(RV5StageCacheLineBytes) + cache.set_width)
  | error(~who: #'RV5StageL1ICache,
          "address width must include line offset, set, and tag bits")

bundle RV5StageL1IRefillContext(address_width :: PosInt,
                                way_width :: PosInt):
  address: Bits(address_width)
  way: Bits(way_width)
  prefetch: Bool

bundle RV5StageL1ILookup(address_width :: PosInt):
  address: Bits(address_width)
  prefetch: Bool

bundle RV5StageL1IResolved(address_width :: PosInt, way_width :: PosInt):
  context: RV5StageL1IRefillContext(address_width, way_width)
  hit: Bool
  word: Bits(32)
  access_fault: Bool

sync_circuit RV5StageL1ICache(xlen :: XLen,
                              cache :: RV5StageCacheConfig,
                              ~chi: config :: RV5StageCHIConfig):
  def width = xlen.width
  def p = config.flit
  check_l1i_geometry(width, cache)
  def sets = cache.sets
  def ways = cache.ways
  def word_bytes = width / 8
  def words_per_line = RV5StageCacheLineBytes / word_bytes
  def data_depth = sets * words_per_line
  def data_lanes = ways * word_bytes
  def offset_width = alignment_bits(RV5StageCacheLineBytes)
  def word_offset_width = alignment_bits(word_bytes)
  def set_width = cache.set_width
  def way_width = cache.way_width
  def tag_width = width - offset_width - set_width
  def word_index_width = index_width(words_per_line)
  def data_address_width = index_width(data_depth)

  input node_id: Bits(p.node_id_width)
  interface core(RV5StageInstructionLookup(RV5StageInstructionReq(xlen)), ~role: responder)
  interface virtual_lookup(Decoupled(Bits(width)), ~role: consumer)
  interface prefetch(Valid(CachePrefetchReq(width)), ~role: consumer)
  interface chi(CHIRNIChannels(p), ~role: node)

  inst tags(SyncRam1RW(sets, Bits(tag_width), ways))
  inst lines(SyncRam1RW(data_depth, Bits(8), data_lanes))
  inst refill(RV5StageLineRead(RV5StageL1IRefillContext(width, way_width), width, config))
  refill.node_id <== node_id
  def cache_flush = core.flush ||| core.invalidate_all
  inst array_read(ValidPipeAlwaysCapture(RV5StageL1ILookup(width), 1), ~reset_when: cache_flush)
  inst lookup(ValidPipeAlwaysCapture(RV5StageL1IResolved(width, way_width), 1), ~reset_when: cache_flush)

  reg valid_lines(~init: vec(
    for List (_set in 0..sets): bits(0, ways).as_vec(Bool)
  ))
  reg replacement_ways(~init: vec(
    for List (_set in 0..sets): bits(0, way_width)
  ))
  reg refill_live(~init: Bool(#false))
  reg refill_installable(~init: Bool(#false))
  reg refill_installing(~init: Bool(#false))
  reg refill_install_index(~init: bits(0, word_index_width))
  reg refill_error_valid(~init: Bool(#false))
  reg refill_error_address(Bits(width))

  refill.requests |> chi.req
  chi.rsp.response |> refill.responses
  chi.dat.response |> refill.response_data
  refill.acknowledgements |> chi.rsp.requester
  chi.dat.request.valid <== Bool(#false)
  chi.dat.request.bits <== literal(CHIDatFlit(p), 0)
  def prefetch_request = prefetch.bits.into(CachePrefetchReq(width))
  def prefetch_valid = prefetch.valid & (prefetch_request.operation === CachePrefetchOperation.Instruction)
  def lookup_input_prefetch = !virtual_lookup.valid & prefetch_valid
  def lookup_index_address = mux(lookup_input_prefetch, prefetch_request.address, virtual_lookup.bits)
  def request_set_value = lookup_index_address[offset_width..(offset_width + set_width)]
  def request_data_address = lookup_index_address[word_offset_width..(offset_width + set_width)]
  def array_context = array_read.egress.bits.into(RV5StageL1ILookup(width))
  def lookup_address = mux(array_context.prefetch, array_context.address, core.request.bits.address)
  def lookup_set = lookup_address[offset_width..(offset_width + set_width)]
  def lookup_tag = lookup_address[(offset_width + set_width)..width]
  def lookup_valids = valid_lines[lookup_set]
  def lookup_matches = vec(
    for List (way in 0..ways):
      lookup_valids[way] & (tags.port.response.bits[way] === lookup_tag)
  )
  def lookup_selection = priority_encoder_oh(lookup_matches)
  def line_hit = lookup_selection.valid
  def lookup_miss = lookup.egress.valid & !lookup.egress.bits.hit & !lookup.egress.bits.access_fault
  def cached_words = lines.port.response.bits.as_bits().as_vec(Bits(width))
  def cached_word = lookup_selection.mux(
    for List (way in 0..ways): cached_words[way],
    ~default: bits(0, width)
  )
  def cached_fetch_word:
    if width == 32
    | cached_word
    | mux(lookup_address[2].into(Bool), cached_word[32..64], cached_word[0..32])
  for (left in 0..ways):
    for (right in (left + 1)..ways):
      when (array_read.egress.valid & tags.port.response.valid & (core.request.valid ||| array_context.prefetch)):
        assert(!(lookup_matches[left] & lookup_matches[right]),
               "l1i_core_hit_unique")
  def completion_address = refill.completion.bits.context.address
  def completion_way = refill.completion.bits.context.way
  def completion_set = completion_address[offset_width..(offset_width + set_width)]
  def completion_tag = completion_address[(offset_width + set_width)..width]
  def completion_words = refill.completion.bits.line.as_bits().as_vec(Bits(width))
  def refill_completion_discard = !refill_installable ||| core.invalidate_all ||| refill.completion.bits.access_fault
  def refill_install_start = refill.completion.valid & !refill_completion_discard & !refill_installing
  def refill_install_final = refill_install_index === bits(words_per_line - 1, word_index_width)
  def refill_install_word = refill_installing & !core.invalidate_all
  def refill_completion_may_finish = refill_completion_discard ||| (refill_installing & refill_install_final)
  // S0 admission depends only on transaction/installation state, not S1 tags,
  // translation, or the consuming instruction pipeline.
  def array_accepts_input = !cache_flush & refill.command.ready & !refill_installing
  virtual_lookup.ready <== array_accepts_input
  def array_lookup_issue = array_accepts_input & (virtual_lookup.valid ||| lookup_input_prefetch)
  def array_request = RV5StageL1ILookup(width):
    address: lookup_index_address
    prefetch: lookup_input_prefetch
  inject_flow(Valid(RV5StageL1ILookup(width)), ~valid: array_lookup_issue, ~bits: array_request) |> array_read.ingress
  // S1 captures a physical lookup; local replay kills younger SRAM results.
  def lookup_issue = !cache_flush & !core.s1_kill & array_read.egress.valid & tags.port.response.valid & (core.request.valid ||| array_context.prefetch)
  def retained_error = refill_error_valid & !array_context.prefetch & (refill_error_address.align_down(RV5StageCacheLineBytes) === lookup_address.align_down(RV5StageCacheLineBytes))
  def resolved_context = RV5StageL1IRefillContext(width, way_width):
    address: lookup_address
    way: rv5stage_cache_replacement_way(cache, lookup_valids, replacement_ways[lookup_set])
    prefetch: array_context.prefetch
  def resolved_lookup = RV5StageL1IResolved(width, way_width):
    context: resolved_context
    hit: line_hit
    word: cached_fetch_word
    access_fault: retained_error
  inject_flow(Valid(RV5StageL1IResolved(width, way_width)), ~valid: lookup_issue, ~bits: resolved_lookup) |> lookup.ingress
  def request_fire = core.request.valid & !core.s1_kill & !cache_flush
  when request_fire:
    assert(array_read.egress.valid & !array_context.prefetch, "l1i_physical_request_has_virtual_lookup")
    assert(array_context.address[0..12] === core.request.bits.address[0..12], "l1i_vipt_page_offset_matches")
  when lookup_issue:
    assert(tags.port.response.valid & lines.port.response.valid, "l1i_resolution_has_array_read")

  // S2 misses return replay immediately. The refill engine alone owns the
  // accepted CHI transaction; successful installation is observed by a retry.
  refill.command.valid <== lookup_miss & !cache_flush
  refill.command.bits <== RV5StageLineReadCommand(RV5StageL1IRefillContext(width, way_width), width):
    line_address: lookup.egress.bits.context.address.align_down(RV5StageCacheLineBytes)
    context: lookup.egress.bits.context
  core.response.valid <== lookup.egress.valid & !lookup.egress.bits.context.prefetch & !cache_flush
  def s2_response = RV5StageInstructionResp():
    word: lookup.egress.bits.word
    page_fault: Bool(#false)
    access_fault: lookup.egress.bits.access_fault
  core.response.bits <== RV5StageFetchResult():
    response: s2_response
    replay: !lookup.egress.bits.hit & !lookup.egress.bits.access_fault
  refill.completion.ready <== refill_completion_may_finish

  def refill_start = refill.command.fire()
  def refill_complete = refill.completion.fire()
  def install = refill_complete & refill_installing & !refill_completion_discard
  def install_way_mask = rv5stage_cache_way_mask(cache, completion_way)
  def refill_word_bytes = completion_words[refill_install_index].as_vec(Bits(8))
  def line_write_mask = rv5stage_cache_lane_mask(
    cache,
    completion_way,
    word_bytes,
    (!bits(0, word_bytes)).into(Mask(word_bytes))
  )
  def mutable line_write_bytes = []
  for (_way in 0..ways):
    for (byte in 0..word_bytes):
      line_write_bytes := line_write_bytes ++ [refill_word_bytes[byte]]

  tags.port.request.valid <== array_lookup_issue ||| install
  tags.port.request.bits <== ReadWriteRequest(set_width, Bits(tag_width), ways):
    address: mux(install, completion_set, request_set_value)
    write: install
    data: vec(for List (_way in 0..ways): completion_tag)
    mask: install_way_mask
  lines.port.request.valid <== array_lookup_issue ||| refill_install_word
  lines.port.request.bits <== ReadWriteRequest(data_address_width, Bits(8), data_lanes):
    address: mux(refill_install_word,
                 (completion_set ++ refill_install_index),
                 request_data_address)
    write: refill_install_word
    data: vec(line_write_bytes)
    mask: line_write_mask

  when (core.invalidate_all):
    valid_lines <== vec(
      for List (_set in 0..sets): bits(0, ways).as_vec(Bool)
    )
  elsewhen install:
    valid_lines <== valid_lines.updated(
      completion_set,
      valid_lines[completion_set].updated(completion_way, Bool(#true))
    )

  when (core.invalidate_all):
    replacement_ways <== vec(
      for List (_set in 0..sets): bits(0, way_width)
    )
  elsewhen install:
    replacement_ways <== replacement_ways.updated(
      completion_set,
      rv5stage_cache_next_way(cache, completion_way)
    )

  when (core.invalidate_all):
    refill_installing <== Bool(#false)
    refill_install_index <== bits(0, word_index_width)
  elsewhen refill_install_start:
    refill_installing <== Bool(#true)
    refill_install_index <== bits(0, word_index_width)
  elsewhen refill_complete:
    refill_installing <== Bool(#false)
    refill_install_index <== bits(0, word_index_width)
  elsewhen (refill_install_word & !refill_install_final):
    refill_install_index <== refill_install_index + bits(1, word_index_width)

  when cache_flush:
    refill_live <== Bool(#false)
    refill_error_valid <== Bool(#false)
  otherwise:
    when refill_start:
      refill_live <== !refill.command.bits.context.prefetch
    elsewhen refill_complete:
      refill_live <== Bool(#false)
    when (refill_complete & refill_live & refill.completion.bits.access_fault):
      refill_error_valid <== Bool(#true)
      refill_error_address <== completion_address
    elsewhen (core.response.valid & lookup.egress.bits.access_fault):
      refill_error_valid <== Bool(#false)

  when (core.invalidate_all):
    refill_installable <== Bool(#false)
  elsewhen refill_start:
    refill_installable <== Bool(#true)
  elsewhen refill_complete:
    refill_installable <== Bool(#false)

export:
  RV5StageL1ICache
