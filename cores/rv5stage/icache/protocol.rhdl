#lang rhodium
/* Defines instruction words, fixed-latency fetch attempts, and ordered slow transactions. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../riscv/rtl/hypervisor.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  lib("rhodium/std/ready-valid.rhdl") open

/* Names the address of one four-byte instruction fetch. */
bundle RV5StageInstructionReq(xlen :: XLen):
  address: Bits(xlen.width)

/* Returns an instruction word with access/page faults and optional guest provenance. */
bundle RV5StageInstructionResp(hypervisor :: Boolean):
  word: Bits(32)
  page_fault: Bool
  access_fault: Bool
  if hypervisor:
    guest: RiscvGuestException()

/* Returns a fixed-cycle attempt outcome; Replay does not promise a later response. */
bundle RV5StageFetchResult(hypervisor :: Boolean):
  response: RV5StageInstructionResp(hypervisor)
  replay: Bool

/* Each accepted S0 request has one S2 outcome unless a later flush or s1_kill cancels it.
   Flush-plus-transfer starts a new epoch and survives that flush; the requester captures
   its context at transfer. Replay is an outcome, not a promise of a later response. */
interface RV5StageFetchAccess(xlen :: XLen, hypervisor :: Boolean):
  role requester
  role responder
  provider requester

  requester -> responder:
    flush: Bool
    invalidate_all: Bool
    s1_kill: Bool
    request: Decoupled(RV5StageInstructionReq(xlen))

  responder -> requester:
    response: Valid(RV5StageFetchResult(hypervisor))

/* Pairs physical S1 resolution with a registered S2 hit/fault/replay outcome.
   Long-lived work survives replay; flush detaches its consumer, not accepted bus traffic. */
interface RV5StageInstructionLookup(RequestType :: HardwareType):
  role requester
  role responder
  provider requester

  requester -> responder:
    flush: Bool
    invalidate_all: Bool
    s1_kill: Bool
    request: Valid(RequestType)

  responder -> requester:
    response: Valid(RV5StageFetchResult(#false))


export:
  RV5StageFetchResult
  RV5StageFetchAccess
  RV5StageInstructionLookup
  RV5StageInstructionReq
  RV5StageInstructionResp
