#lang rhodium
// Defines instruction words, fixed-latency fetch attempts, and ordered slow transactions.

import:
  "../../../riscv/isa/xlen.rhm" open
  lib("rhodium/std/ready-valid.rhdl") open

bundle RV5StageInstructionReq(xlen :: XLen):
  address: Bits(xlen.width)

bundle RV5StageInstructionResp():
  word: Bits(32)
  page_fault: Bool
  access_fault: Bool

bundle RV5StageFetchResult():
  response: RV5StageInstructionResp()
  replay: Bool

// S0 acceptance has exactly one S2 result unless flush or s1_kill cancels it.
// Replay is an outcome, not a promise of a later response for this attempt.
interface RV5StageFetchAccess(xlen :: XLen):
  role requester
  role responder
  provider requester

  requester -> responder:
    flush: Bool
    invalidate_all: Bool
    s1_kill: Bool
    request: Decoupled(RV5StageInstructionReq(xlen))

  responder -> requester:
    response: Valid(RV5StageFetchResult())

// Physical S1 resolution produces a registered S2 outcome. Long-lived work
// survives local replay; flush detaches its consumer, not accepted bus traffic.
interface RV5StageInstructionLookup(RequestType :: HardwareType):
  role requester
  role responder
  provider requester

  requester -> responder:
    flush: Bool
    invalidate_all: Bool
    s1_kill: Bool
    request: Valid(RequestType)

  responder -> requester:
    response: Valid(RV5StageFetchResult())


export:
  RV5StageFetchResult
  RV5StageFetchAccess
  RV5StageInstructionLookup
  RV5StageInstructionReq
  RV5StageInstructionResp
