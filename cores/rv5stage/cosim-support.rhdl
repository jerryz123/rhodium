#lang rhodium
/* Retains passive scalar observation owners and reports architectural effects, not bus beats. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../riscv/cosim.rhdl" open
  "../load-store.rhdl" open
  "dcache/protocol.rhdl" open
  "memory.rhdl" open
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/isa/csr.rhm" open
  "../../riscv/rtl/csr.rhdl".csr_bits
  "../../riscv/rtl/atomic.rhdl" open
  lib("flow/main.rhdl") open
  lib("rhodium/std/bits.rhdl") open

/* Converts an architectural value to a transport lane, retaining RV64 unchanged. */
fun rv5stage_cosim_lane(value :: Bits) :~ Bits(64):
  if value.type.packed_width() == 64 | value | value.zext(64)

/* Keeps acceptance order without ever applying backpressure to the observed service.
   Scalar slow memory and each arithmetic service guarantee ordered responses independently. */
fun rv5stage_cosim_owner(T :: DataType, accepted :: Bool, context :: Hardware.of(T), completed :: Bool) :~ Hardware.of(T):
  inst owners(Queue(T, 64))
  owners.ingress.valid <== accepted
  owners.ingress.bits <== context
  owners.egress.ready <== completed
  assert(!accepted ||| owners.ingress.ready, "cosim_owner_capacity")
  assert(!completed ||| owners.egress.valid, "cosim_completion_has_owner")
  owners.egress.bits

/* Pairs slow memory completion with its accepted architectural ID and complete request. */
bundle RV5StageCosimMemoryOwner(xlen :: XLen, slots :: Pow2Int):
  instruction_id: CosimInstructionId()
  request: RV5StageDataReq(xlen, slots)

/* Pairs arithmetic completion with its authorizing WB instruction, independently of rd reuse. */
bundle RV5StageCosimArithmeticOwner():
  instruction_id: CosimInstructionId()
  rd: Bits(5)

/* Reports a GPR result through producer zero; x0 produces an empty seal instead of a write. */
fun rv5stage_cosim_gpr(hooks :: CosimHart, id :: CosimInstructionId(), valid :: Bool, write :: Bool, rd :: Bits(5), value :: Bits):
  def writes = write & rd.or_reduce()
  def effect = CosimEffectId():
    producer: bits(0, 6)
    index: bits(0, 64)
  def result = CosimRegisterWrite():
    bank: CosimRegisterBank.Integer
    register_index: rd
    bit_offset: bits(0, 16)
    mask: rv5stage_cosim_lane(!bits(0, value.type.packed_width()))
    value: rv5stage_cosim_lane(value)
  hooks.reg_write(valid & writes, id, effect, result)
  hooks.seal(valid, id, bits(0, 6), writes.as_bits().zext(64))

/* Reports a logical access relative to its effective virtual address, never an inferred PA.
   Returned load data is already right-justified; mask excludes sign-extension bits.
   Cache-block operations report eight eight-byte fragments; only CBO.ZERO writes data. */
fun rv5stage_cosim_memory(xlen :: XLen, slots :: Pow2Int, hooks :: CosimHart, id :: CosimInstructionId(), valid :: Bool, request :: RV5StageDataReq(xlen, slots), value :: Bits(xlen.width), fault :: Bool):
  def operation = request.access
  def zero = operation.is_cache_block_zero()
  def block_access = operation.is_cache_block()
  def failed_sc = operation.is_store_conditional() & value.or_reduce()
  def success = !fault & !failed_sc
  inst atomic(RiscvAtomicALU(xlen))
  atomic.old_value <== value
  atomic.operand <== request.data
  atomic.word <== request.width === MemoryWidth.Word
  atomic.operation <== request.atomic
  def kind = mux_lookup(operation, ~default: CosimAccessKind.CacheOperation, [
    [RV5StageMemoryOperation.Load, CosimAccessKind.Load],
    [RV5StageMemoryOperation.Store, CosimAccessKind.Store],
    [RV5StageMemoryOperation.LoadReserved, CosimAccessKind.Lr],
    [RV5StageMemoryOperation.StoreConditional, CosimAccessKind.Sc],
    [RV5StageMemoryOperation.Atomic, CosimAccessKind.Amo]
  ])
  for (fragment in 0..8):
    def effect = CosimEffectId():
      producer: bits(2, 6)
      index: bits(fragment, 64)
    def result = CosimMemoryEffect():
      access_id: bits(0, 64)
      fragment_offset: bits(fragment * 8, 64)
      kind: kind
      virtual_address: rv5stage_cosim_lane(mux(block_access, request.address.align_down(64), request.address)) + bits(fragment * 8, 64)
      physical_valid: Bool(#false)
      physical_address: bits(0, 64)
      byte_mask: mux(block_access, bits(255, 8), if xlen == XLen.X32 | memory_width_mask(xlen, request.width).zext(8) | memory_width_mask(xlen, request.width))
      read_valid: !fault & operation.returns_old_value()
      write_valid: success & operation.needs_unique()
      read_data: rv5stage_cosim_lane(value)
      write_data: mux(zero, bits(0, 64), rv5stage_cosim_lane(mux(operation.is_atomic(), atomic.value, request.data)))
      result: mux(fault, CosimAccessResult.Fault, mux(failed_sc, CosimAccessResult.ScFailure, CosimAccessResult.Success))
    hooks.memory(valid & (Bool(fragment == 0) ||| (block_access & !fault)), id, effect, result)
  hooks.seal(valid, id, bits(2, 6), mux(block_access & !fault, bits(8, 64), bits(1, 64)))

/* Describes one canonical CSR view; eligible excludes autonomous counter/time changes. */
class RV5StageCosimCsr(address :: CsrId, value :: Bits, eligible :: Bool):
  /* Pads a canonical view to the generic fixed-width transport. */
  method snapshot() :~ Bits(64): rv5stage_cosim_lane(value)

/* Samples actual post-edge values before the next instruction changes them. Canonical views
   avoid alias double-reporting; changed masks preserve independent environmental updates. */
fun rv5stage_cosim_csrs(hooks :: CosimHart, valid :: Bool, id :: CosimInstructionId(), entries :: List.of(RV5StageCosimCsr)):
  reg pending(~init: Bool(#false))
  reg owner(CosimInstructionId())
  reg previous(Vec(entries.length(), Bits(64)))
  reg eligible(Vec(entries.length(), Bool), ~init: literal(Vec(entries.length(), Bool), 0))
  pending <== valid
  when valid:
    owner <== id
    previous <== vec(entries.map(fun (entry :: RV5StageCosimCsr): entry.snapshot()))
    eligible <== vec(entries.map(fun (entry :: RV5StageCosimCsr): entry.eligible))
  def mutable count = bits(0, 64)
  for (entry :: RV5StageCosimCsr in entries, index in 0..entries.length()):
    def mask = previous[index] ^ entry.snapshot()
    def changed = eligible[index] & mask.or_reduce()
    def effect = CosimEffectId():
      producer: bits(1, 6)
      index: count
    def result = CosimCsrUpdate():
      address: csr_bits(entry.address)
      operation: CosimCsrOperation.AssignMasked
      mask: mask
      value: entry.snapshot()
    hooks.csr_update(pending & !reset_active().into(Bool) & changed, owner, effect, result)
    count := count + changed.as_bits().zext(64)
  hooks.seal(pending & !reset_active().into(Bool), owner, bits(1, 6), count)

export:
  rv5stage_cosim_lane
  rv5stage_cosim_owner
  RV5StageCosimMemoryOwner
  RV5StageCosimArithmeticOwner
  rv5stage_cosim_gpr
  rv5stage_cosim_memory
  RV5StageCosimCsr
  rv5stage_cosim_csrs
