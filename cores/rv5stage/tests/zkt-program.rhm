#lang rhombus
// Builds a timing-probe ROM from implemented instructions intersected with the architectural Zkt scope.

import:
  "../../../riscv/isa/zkt.rhm" open
  "../../../riscv/isa/c.rhm" open
  "../../../riscv/isa/fp-profile.rhm" open
  "../../../riscv/model/main.rhm" open
  "../profile.rhm" open
  "../decode/core-ctrl.rhdl".rv5stage_instructions

fun zkt_probe_word(instruction :: InstructionSpec) :: Nat:
  def fields = instruction.operands.map(fun (operand): operand.field.constrain(if operand.field == rs2 | 9 | 8))
  def auxiliary = instruction.format.auxiliary_fields.map(fun (field): field.constrain(7))
  def immediate = instruction.immediate
  instruction.encode(fields ++ auxiliary, ~immediate: if immediate | (if immediate.width == 32 | 0x3000 | 1) | #false)

fun zkt_compressed_probe_word(instruction :: CompressedInstructionSpec, ~nop: nop :: Boolean = #false) :: Nat:
  // Select real legal encodings through the descriptor, including split/compact
  // fields. No second assembler or hand-maintained compressed opcode table.
  def candidates = (0..65536).to_list()
  def word = candidates.find(
    fun (word):
      if !instruction.matches(word)
      | #false
      | block:
          def expanded = instruction.expand(word)
          def target = instruction.expansion.target
          (for all (operand in target.operands):
            def actual = operand.field.extract(expanded)
            cond
            | nop: actual == 0
            | operand.field == rd: actual == 8
            | operand.field == rs2: actual == 9 || actual == 0
            | ~else: actual == 8 || actual == 0
          ) && (!target.immediate || (if nop | target.immediate.decode(expanded) == 0 | target.immediate.decode(expanded) != 0))
  )
  unless word
  | error(~who: #'zkt_compressed_probe_word, "no non-HINT operand probe for " ++ instruction.name)
  word

class ZktProgram(words :: NonemptyList.of(Nat), probes :: NonemptyList.of(String))

fun zkt_program(profile :: RVCoreProfile) :: ZktProgram:
  def xlen = profile.xlen
  def fp = profile.extensions.floating_point
  def instructions = rv5stage_instructions(xlen, fp, profile.extensions.half_precision)
  def names = zkt_instruction_names(xlen)
  def ordinary = instructions.filter(~keep: fun (instruction): names.contains(instruction.name))
  def compact = compressed_extensions_instructions(xlen, fp, profile.extensions.compressed, instructions.map(fun (instruction): instruction.name)).filter(~keep: fun (instruction): names.contains(instruction.name))
  // C.NOP is an encoding of the catalog's C.ADDI family, not a separate row.
  def nop = compact.find(fun (instruction): instruction.name == "C.ADDI")
  def probes = ordinary.map(fun (instruction): instruction.name) ++ compact.map(fun (instruction): instruction.name) ++ ["C.NOP"]
  def encodings = ordinary.map(fun (instruction): [zkt_probe_word(instruction), 4]) ++ compact.map(fun (instruction): [zkt_compressed_probe_word(instruction), 2]) ++ [[zkt_compressed_probe_word(nop, ~nop: #true), 2]]
  def catalog = InstructionCatalog("Zkt fixture implementation", "fixture", instructions)
  def load = catalog.find(if xlen.width == 64 | "LD" | "LW")
  def store = catalog.find(if xlen.width == 64 | "SD" | "SW")
  def mutable halves = []
  fun append_word(word :: Nat, size :: PosInt = 4):
    halves := halves ++ [word bits.and 0xffff] ++ (if size == 4 | [word bits.(>>) 16] | [])
  for (encoding in encodings):
    append_word(load.encode([rd.constrain(8), rs1.constrain(0)], ~immediate: 0))
    append_word(load.encode([rd.constrain(9), rs1.constrain(0)], ~immediate: 8))
    // An independent multiply occupies the deferred engine while the probe
    // encounters RAW, WAW, and resource hazards; the consumer exposes completion.
    append_word(catalog.find("MUL").encode([rd.constrain(5), rs1.constrain(8), rs2.constrain(9)]))
    append_word(encoding[0], encoding[1])
    append_word(catalog.find("ADD").encode([rd.constrain(12), rs1.constrain(8), rs2.constrain(9)]))
    append_word(store.encode([rs1.constrain(0), rs2.constrain(12)], ~immediate: 16))
  append_word(catalog.find("JAL").encode([rd.constrain(0)], ~immediate: 0))
  when halves.length() mod 2 == 1
  | halves := halves ++ [0x0001]
  ZktProgram(for List (index in 0..(halves.length() / 2)): halves[index * 2] bits.or (halves[index * 2 + 1] bits.(<<) 16), probes)

export:
  ZktProgram
  zkt_program
