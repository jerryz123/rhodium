#lang rhodium
// Exposes tagged integer services for independent retention and backpressure checks.
// SPDX-License-Identifier: Apache-2.0

import:
  "../integer-execution.rhdl" open
  "../../multiplier.rhdl" open
  "../../divider.rhdl" open
  lib("flow/main.rhdl") open

sync_circuit RV5StageIntegerExecutionFixture():
  interface multiply_request(Decoupled(RV5StageExecutionRequest(MultiplierRequest(64), Bits(8))), ~role: consumer)
  interface multiply_result(Irrevocable(RV5StageExecutionResult(Bits(128), Bits(8))), ~role: producer)
  interface divide_request(Decoupled(RV5StageExecutionRequest(DividerRequest(64), Bits(8))), ~role: consumer)
  interface divide_result(Irrevocable(RV5StageExecutionResult(DividerResponse(64), Bits(8))), ~role: producer)
  inst multiply(RV5StageMultiplyService(64, Bits(8)))
  inst divide(RV5StageDivideService(64, Bits(8)))
  multiply_request |> multiply.request
  multiply.result |> multiply_result
  divide_request |> divide.request
  divide.result |> divide_result

export:
  RV5StageIntegerExecutionFixture
