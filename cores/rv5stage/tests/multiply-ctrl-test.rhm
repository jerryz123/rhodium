#lang rhombus
// Checks the host-side RV32 and RV64 Zmmul decode relation.

import:
  "../../../rhodium/frontend/layers/bool.rhm" as bool
  "../../../rhodium/std/decode/pattern.rhdl" open
  "../../../riscv/isa/zmmul.rhm" open
  "../../multiplier.rhdl" as multiplier
  "../decode/multiply-ctrl.rhdl" as controls

fun control_for(cases, instruction):
  cases.find(
    fun (candidate):
      candidate.input.value_bits == instruction.encoding.value && candidate.input.care_bits == instruction.encoding.care
  ).output

def mul = control_for(controls.RV64ZmmulControlCases, MUL)
def mulh = control_for(controls.RV64ZmmulControlCases, MULH)
def mulhsu = control_for(controls.RV64ZmmulControlCases, MULHSU)
def mulhu = control_for(controls.RV64ZmmulControlCases, MULHU)
def mulw = control_for(controls.RV64ZmmulControlCases, MULW)
def expected_mul = partial_pattern(controls.RV5StageMultiplyControl()):
  high_result: bool.Bool(#false)
  word_result: bool.Bool(#false)
def expected_mulh_mode = pattern(multiplier.MultiplierMode()):
  left_signed: bool.Bool(#true)
  right_signed: bool.Bool(#true)
def expected_mulh = partial_pattern(controls.RV5StageMultiplyControl()):
  mode: expected_mulh_mode
  high_result: bool.Bool(#true)
  word_result: bool.Bool(#false)

check:
  controls.RV32ZmmulControlCases.length() ~is 4
  controls.RV64ZmmulControlCases.length() ~is 5
  controls.RV5StageMultiplyControl().fields.map(fun (field): field.name) ~is [
    "mode", "high_result", "word_result"
  ]
  controls.RV5StageMultiplyControl().field("mode").type.type_equal(multiplier.MultiplierMode()) ~is #true
  mul.care_bits ~is expected_mul.care_bits
  mulh.value_bits ~is expected_mulh.value_bits
  mulhsu.value_bits != mulh.value_bits ~is #true
  mulhu.value_bits != mulhsu.value_bits ~is #true
  mulw.care_bits ~is mul.care_bits
  mulw.value_bits != mul.value_bits ~is #true
