#lang rhodium
// Wraps the public core interfaces with a catalog-generated instruction ROM for timing comparison.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/register-write.rhdl") open
  "../../cache/protocol.rhdl" open
  "zkt-program.rhm" open
  "core-fixture.rhdl" open
  "../profile.rhm" open
  "../../../riscv/rtl/interrupt.rhdl" open
  "../multiply.rhdl" open
  "../decode/multiply-ctrl.rhdl" open
  "../../multiply-decode.rhdl" open
  "../register-file.rhdl" open
  "../icache/protocol.rhdl" open
  "../memory-context.rhdl" open
  lib("riscv/rtl/privilege.rhdl").PrivilegeMode
  lib("flow/main.rhdl") open

sync_circuit RV5StageZkt(profile :: RV5StageConfig):
  def width = profile.xlen.width
  interface instruction_access(RV5StageTestInstructionAccess(profile.xlen), ~role: requester)
  interface data_access(CacheAccess(profile.xlen, RV5StageMemoryContext(profile.vector_completion_slots)), ~role: requester)
  output privilege: PrivilegeMode
  output mstatus: Bits(width)
  output satp: Bits(width)
  output translation_flush: Bool
  output program_word: Bits(32)
  output probe_count: Bits(32)
  // A separate public-component rig forces completion overlap instead of
  // inferring internal arbiter coverage from elapsed program time.
  input multiply_issue: Bool
  input multiply_left: Bits(width)
  input multiply_right: Bits(width)
  input multiply_control: RiscvMultiplyControl()
  input load_valid: Bool
  input load_value: Bits(width)
  input completion_ready: Bool
  output multiply_available: Bool
  output multiply_valid: Bool
  output completion_valid: Bool
  output completion_value: Bits(width)
  output completion_chosen: Bits(2)
  inst multiplier(RV5StageMultiplier(profile.xlen, profile.multiplier))
  inst completions(Arbiter(RegisterFileWrite(profile.xlen), 4))
  multiplier.issue.valid <== multiply_issue
  multiplier.issue.bits <== RV5StageMultiplyIssue(profile.xlen):
    left: multiply_left
    right: multiply_right
    control: multiply_control
    rd: Bits(5)(8)
  multiply_available <== multiplier.available
  multiply_valid <== multiplier.completion.valid
  completions.ingress[0].valid <== load_valid
  completions.ingress[0].bits <== RegisterFileWrite(profile.xlen):
    address: Bits(5)(9)
    data: load_value
  (multiplier.completion |> map_flow(~stable: #true, result => RegisterFileWrite(profile.xlen)):
    address: result.rd
    data: result.value
  ) |> completions.ingress[1]
  for (index in 2..4):
    completions.ingress[index].valid <== Bool(#false)
    completions.ingress[index].bits <== Bits(width + 5)(0).into(RegisterFileWrite(profile.xlen))
  completions.egress.ready <== completion_ready
  completion_valid <== completions.egress.valid
  completion_value <== completions.egress.bits.data
  completion_chosen <== completions.chosen
  inst core(RV5StageCoreFixture(profile, ~reset_address: 0x10000))
  core.interrupts <== Bits(6)(0).into(RiscvInterrupts())
  core.hart_id <== Bits(width)(0)
  core.time_counter <== Bits(64)(0)
  core.instruction_access <=> instruction_access
  core.data_access <=> data_access
  core.pipeline_access.response.valid <== Bool(#false)
  core.pipeline_access.commit_ready <== Bool(#false)
  core.pipeline_access.response.bits <== literal(CachePipelineResult(profile.xlen), 0)
  privilege <== core.privilege
  mstatus <== core.mstatus
  satp <== core.satp
  translation_flush <== core.translation_flush
  def program = zkt_program(profile)
  probe_count <== Bits(32)(program.probes.length())
  program_word <== mux_lookup(instruction_access.request.bits.address, ~default: Bits(32)(0x13), for List (index in 0..program.words.length()): [0x10000 + index * 4, Bits(32)(program.words[index])])

export:
  RV5StageZkt
