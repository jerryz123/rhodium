#lang rhodium
// Checks CBO.ZERO's composed scalar controls and opt-in architectural profile.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../rhodium/std/decode.rhdl" open
  "../../../riscv/isa/zicboz.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/isa/fp-profile.rhm" open
  "../../../riscv/model/formats.rhm" open
  "../profile.rhm" open
  "../decode/core-ctrl.rhdl" open
  "../decode/operand-ctrl.rhdl" open
  "../decode/mem-ctrl.rhdl" open
  "../decode/writeback-ctrl.rhdl" open
  "../../alu.rhdl" open

def expected = partial_pattern(RV5StageControl()):
  alu:
    partial_pattern(AluControl()):
      result_select: AluResultSelect.Adder
      subtract: Bool(#false)
      word: Bool(#false)
  operand:
    pattern(OperandControl()):
      uses_rs1: Bool(#true)
      uses_rs2: Bool(#false)
      left: OperandASelect.Register
      right: OperandBSelect.Immediate
      immediate: ImmediateSelect.None
  memory:
    partial_pattern(MemoryControl()):
      access: MemoryOperation.CacheBlockZero
  writeback:
    partial_pattern(WritebackControl()):
      enable: Bool(#false)
  floating_point_valid: Bool(#false)

for (source in 0..32):
  def word = CBO_ZERO.encode([rs1.constrain(source)])
  def row = ZicbozCoreControlCases.find(fun (candidate): candidate.input.matches(bits(word, 32)))
  check:
    expected.subsumes(row.output) ~is #true

for (xlen in [XLen.X32, XLen.X64]):
  def profile = RVCoreProfile(~xlen: xlen, ~extensions: RV5StageExtensions(~zicboz: #true))
  def instructions = rv5stage_instructions(xlen, FloatingPointProfile.None, HalfPrecisionProfile.None, ~zicboz: #true)
  check:
    profile.isa_extensions.contains("zicboz") ~is #true
    instructions.filter(~keep: fun (instruction): instruction.name == CBO_ZERO.name).length() ~is 1
