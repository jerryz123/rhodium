#lang rhombus
// Checks public widths and types at RV5Stage's Sv39 translation boundaries.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../rhodium/core/main.rhm" open
  "../../../rhodium/frontend/kernel.rhm" as embedded
  "../../../rhodium/frontend/layers/bool.rhm" as bool
  "../mmu/mmu.rhdl" as mmu
  "../profile.rhm".RV5StageMmuMode
  "params.rhdl" as test_params
  "../../../riscv/isa/xlen.rhm" open

def mmu_design = embedded.run_elaboration(
  fun (): mmu.RV5StageMmu(XLen.X64,
                          RV5StageMmuMode.Sv39,
                          test_params.test_rv5stage_chi_config.physical_map)
)
def mmu_module = mmu_design.modules.find(fun (module_def): module_def.name == "RV5StageMmu")

check:
  mmu_module.find_input("satp").type.width ~is 64
  mmu_module.find_output("instruction_lookup_out").type.field("bits").type.width ~is 64
  scalar_width(mmu_module.find_input("instruction_lookup_in").type.field("ready").type) ~is 1
  mmu_module.find_output("core_lookup_out").type.field("bits").type.width ~is 64
  mmu_module.find_output("walker_lookup_out").type.field("bits").type.width ~is 64
  type_equal(
    mmu_module.find_output("instruction_out").type.field("response").type.field("bits").type.field("response").type.field("page_fault").type,
    bool.Bool
  ) ~is #true
  type_equal(
    mmu_module.find_output("instruction_out").type.field("response").type.field("bits").type.field("response").type.field("access_fault").type,
    bool.Bool
  ) ~is #true
  mmu_module.find_output("instruction_memory_out").type.field("request").type.field("bits").type.field("address").type.width ~is 64
  mmu_module.find_input("prefetch_in").type.field("bits").type.field("address").type.width ~is 64
  mmu_module.find_output("physical_prefetch_out").type.field("bits").type.field("address").type.width ~is 64
  type_equal(
    mmu_module.find_output("instruction_memory_out").type.field("request").type.field("bits").type.field("cacheable").type,
    bool.Bool
  ) ~is #true
  type_equal(
    mmu_module.find_output("instruction_memory_out").type.field("request").type.field("bits").type.field("device").type,
    bool.Bool
  ) ~is #true
