#lang rhombus
// Checks public widths and types at RV5Stage's Sv39 translation boundaries.

import:
  "../../../rhodium/core/main.rhm" open
  "../../../rhodium/frontend/kernel.rhm" as embedded
  "../../../rhodium/frontend/layers/bool.rhm" as bool
  "../mmu/tlb.rhdl" as tlb
  "../mmu/walker.rhdl" as walker
  "../mmu/mmu.rhdl" as mmu
  "params.rhdl" as test_params
  "../../../riscv/isa/xlen.rhm" open

def tlb_design = embedded.run_elaboration(fun (): tlb.RV5StageTlb())
def tlb_module = tlb_design.modules[0]
def walker_design = embedded.run_elaboration(fun (): walker.RV5StagePageTableWalker())
def walker_module = walker_design.modules[0]
def mmu_design = embedded.run_elaboration(
  fun (): mmu.RV5StageMmu(XLen.X64, test_params.test_rv5stage_chi_config.physical_map)
)
def mmu_module = mmu_design.modules.find(fun (module_def): module_def.name == "RV5StageMmu")

check:
  tlb_module.find_input("virtual_address").type.width ~is 64
  tlb_module.find_output("physical_address").type.width ~is 56
  tlb_module.find_input("fill_in").type.field("bits").type.field("ppn").type.width ~is 44
  type_equal(
    tlb_module.find_input("fill_in").type.field("bits").type.field("global_mapping").type,
    bool.Bool
  ) ~is #true
  walker_module.find_input("request_in").type.field("bits").type.field("virtual_address").type.width ~is 64
  walker_module.find_output("memory_out").type.field("request").type.field("bits").type.width ~is 64
  walker_module.find_output("completion_out").type.field("bits").type.field("physical_address").type.width ~is 56
  mmu_module.find_input("satp").type.width ~is 64
  type_equal(
    mmu_module.find_output("instruction_out").type.field("response").type.field("bits").type.field("page_fault").type,
    bool.Bool
  ) ~is #true
  type_equal(
    mmu_module.find_output("instruction_out").type.field("response").type.field("bits").type.field("access_fault").type,
    bool.Bool
  ) ~is #true
  mmu_module.find_output("instruction_memory_out").type.field("request").type.field("bits").type.field("address").type.width ~is 64
  type_equal(
    mmu_module.find_output("instruction_memory_out").type.field("request").type.field("bits").type.field("cacheable").type,
    bool.Bool
  ) ~is #true
  type_equal(
    mmu_module.find_output("instruction_memory_out").type.field("request").type.field("bits").type.field("device").type,
    bool.Bool
  ) ~is #true
