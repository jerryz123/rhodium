#lang rhodium
// Exposes fetch-source policy and annotated restart/replay causes for exact lineage testing.
// SPDX-License-Identifier: Apache-2.0
import:
  "../fetch/source.rhdl" open
  "../fetch/bpd/protocol.rhdl" open
  lib("flow/main.rhdl") open
  lib("riscv/isa/xlen.rhm").XLen

sync_circuit EventFetchSource():
  def xlen = XLen.X64
  input(active, space, clear): Bool
  interface restart(Valid(Bits(64)), ~role: consumer)
  interface replay(Valid(RV5StageFetchAttempt(xlen)), ~role: consumer)
  interface attempts(Decoupled(RV5StageFetchAttempt(xlen)), ~role: producer)
  interface stage1(Valid(RV5StageFetchAttempt(xlen)), ~role: producer)
  inst source(RV5StageFetchSource(xlen, 0))
  source.active <== active
  source.space <== space
  source.clear.valid <== clear
  source.redirect.valid <== Bool(#false)
  source.redirect.bits <== bits(0, 64)
  source.ras_speculate.valid <== Bool(#false)
  source.ras_speculate.bits <== literal(RV5StageRasUpdate(xlen), 0)
  source.ras_restore.valid <== Bool(#false)
  source.btb_discover.valid <== Bool(#false)
  source.btb_discover.bits <== literal(RV5StagePrediction(xlen), 0)
  source.predictor_flush.valid <== Bool(#false)
  source.predictor_invalidate.valid <== Bool(#false)
  source.predictor_invalidate.bits <== bits(0, 64)
  source.branch_update.valid <== Bool(#false)
  source.branch_update.bits <== literal(RV5StageBranchUpdate(xlen), 0)
  def restart_event = restart |> trace_valid_event("restart", ~fields: pc):
    pc: pc
  restart_event |> source.restart
  def replay_event = replay |> trace_valid_event("replay", ~fields: attempt):
    pc: attempt.pc
  replay_event |> source.replay
  source.attempts |> attempts
  source.stage1 |> stage1

def traced_fetch_source = elaborate_with_top(EventFetchSource())
export traced_fetch_source
