#lang rhodium
// Observes RXDAT and CompAck on both production line engines, including instruction ROM reads.
// SPDX-License-Identifier: Apache-2.0
import:
  "params.rhdl" open
  "../chi/foundation.rhdl" open
  "../chi/refill.rhdl" open
  "../chi/line-read.rhdl" open
  lib("flow/main.rhdl") open
  lib("chi/protocol/flits.rhdl") open
  lib("rhodium/std/interconnect.rhdl").AddressSet
  lib("riscv/rtl/pma.rhdl") open

def config = RiscvHartCHIConfig(test_rv5stage_flit, 64, [
  RiscvHartCHIRegion(RiscvPhysicalMemoryRegion(AddressSet(0, 0x7fff), test_rv5stage_memory_attributes), test_rv5stage_home),
  RiscvHartCHIRegion(RiscvPhysicalMemoryRegion(AddressSet(0x8000, 0x7fff), RiscvPhysicalMemoryAttributes(#true, #false, #true, #false, #false, #false, #true, ~instruction_cacheable: #true)), test_rv5stage_uncached_home)
])

sync_circuit EventCompAck():
  def p = config.flit
  input command_valid: Bool
  input instruction_rom: Bool
  input completion_ready: Bool
  output command_ready: Bool
  output d_complete: Bool
  output i_complete: Bool
  interface dreq(Decoupled(CHIReqFlit(p)), ~role: producer)
  interface ireq(Decoupled(CHIReqFlit(p)), ~role: producer)
  interface ddata(Decoupled(CHIDatFlit(p)), ~role: consumer)
  interface idata(Decoupled(CHIDatFlit(p)), ~role: consumer)
  interface dack(Decoupled(CHIRspFlit(p)), ~role: producer)
  interface iack(Decoupled(CHIRspFlit(p)), ~role: producer)
  inst refill(RV5StageLineRefill(Bits(8), 32, config))
  inst read(RV5StageLineRead(Bits(8), 32, config))
  refill.node_id <== bits(3, p.node_id_width)
  read.node_id <== bits(2, p.node_id_width)
  command_ready <== refill.command.ready & read.command.ready
  refill.command.valid <== command_valid & read.command.ready
  read.command.valid <== command_valid & refill.command.ready
  refill.command.bits <== RV5StageLineRefillCommand(Bits(8), 32):
    line_address: bits(0x1000, 32)
    opcode: CHIReqOpcode.ReadClean
    context: bits(42, 8)
  read.command.bits <== RV5StageLineReadCommand(Bits(8), 32):
    line_address: mux(instruction_rom, bits(0x8000, 32), bits(0x1000, 32))
    context: bits(42, 8)
  refill.requests |> dreq
  read.requests |> ireq
  for (engine in [refill, read]):
    engine.responses.valid <== Bool(#false)
    engine.responses.bits <== literal(CHIRspFlit(p), 0)
    engine.completion.ready <== completion_ready
  d_complete <== refill.completion.valid
  i_complete <== read.completion.valid
  def ddata_event = ddata |> trace_event("ddata", ~fields: flit):
    packet: flit.data_id
  ddata_event |> refill.response_data
  def idata_event = idata |> trace_event("idata", ~fields: flit):
    packet: flit.data_id
  idata_event |> read.response_data
  def dack_event = refill.acknowledgements |> trace_event("dack", ~fields: flit):
    dbid: flit.txn_id
  dack_event |> dack
  def iack_event = read.acknowledgements |> trace_event("iack", ~fields: flit):
    dbid: flit.txn_id
  iack_event |> iack

def traced_compack = elaborate_with_top(EventCompAck())
export traced_compack
