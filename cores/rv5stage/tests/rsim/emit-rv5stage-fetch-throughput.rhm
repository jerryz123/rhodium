#lang rhombus
// Instruments integrated fetch throughput with accepted-request-to-I-cache-TXREQ lineage.
// SPDX-License-Identifier: Apache-2.0
import:
  "../../../../cores/rv5stage/tests/fetch-throughput-fixture.rhdl".RV5StageFetchThroughput
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../../rhodium/event/main.rhm".EventInstrumentationConfig
  lib("rhodium/event/tests/rsim/trace-sites.rhm").traced_target

def program = elaborate(RV5StageFetchThroughput())
fun site_header(manifest):
  "\nnamespace fetch_sites {\n" ++ String.join(
    for List (label in ["frontend/s0.request", "icache/chi.txreq", "icache/refill"], name in ["request", "txreq", "refill"]):
      def indices = (for List (index in 0..manifest.sites.length()): index).filter(~keep: fun (index): manifest.sites[index].label == label)
      unless indices.length() == 1 | error("expected one fetch trace site: " ++ label)
      "constexpr unsigned " ++ name ++ " = " ++ to_string(indices[0]) ++ ";\n",
    ""
  ) ++ "}\n"
def target = traced_target(site_header, EventInstrumentationConfig(~partial: #true))
export program target
