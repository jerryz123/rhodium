#lang rhombus
// Emits the shared-cache trace regression with SRAM-port, caller, and refill event sites.
// SPDX-License-Identifier: Apache-2.0
import:
  "../../../../cores/rv5stage/tests/load-hit-fixture.rhdl".RV5StageLoadHit
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../../rhodium/event/main.rhm".EventInstrumentationConfig
  lib("rhodium/event/tests/rsim/trace-sites.rhm").traced_target

def program = elaborate(RV5StageLoadHit())
fun site_header(manifest):
  "\nnamespace demand_sites {\n" ++ String.join(
    for List (label in ["core/s3.execute", "core/s4.memory", "core/s5.wb", "dcache/s1.access", "dcache/arrays.tags", "dcache/arrays.data", "dcache/s2.resp", "dcache/s3.lookup", "dcache/s4.resolve", "dcache/chi.txreq", "dcache/refill"], name in ["ex", "mem", "wb", "access", "tags", "memory", "response", "lookup", "resolve", "txreq", "refill"]):
      def indices = (for List (index in 0..manifest.sites.length()): index).filter(~keep: fun (index): manifest.sites[index].label == label)
      unless indices.length() == 1 | error("expected one demand trace site: " ++ label)
      "constexpr unsigned " ++ name ++ " = " ++ to_string(indices[0]) ++ ";\n",
    ""
  ) ++ "}\n"
def target = traced_target(site_header, EventInstrumentationConfig(~partial: #true))
export program target
