import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("cores/common/cache/uncached-instruction.rhdl").UncachedInstructionMemory
  lib("cores/rv5stage/memory-context.rhdl").RV5StageMemoryContext
  "../../../../cores/rv5stage/tests/params.rhdl".test_rv5stage_uncached_config
  "../../../../riscv/isa/xlen.rhm".XLen

def program = elaborate(UncachedInstructionMemory(XLen.X64, test_rv5stage_uncached_config, RV5StageMemoryContext(8), 32)
)
export program
