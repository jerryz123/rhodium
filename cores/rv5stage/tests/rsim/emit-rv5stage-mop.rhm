#lang rhombus
// Defines a program for an RV64 RV5Stage core with Zimop and Zcmop support.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../../riscv/isa/c.rhm" open
  "../../../../riscv/isa/xlen.rhm" open
  "../../../../cores/rv5stage/tests/core-fixture.rhdl" as core
  "../../../../cores/rv5stage/profile.rhm" open

def extensions = compressed_extensions(CompressedExtension.Zca, CompressedExtension.Zcmop)
def program = elaborate(core.RV5StageCoreFixture(RV5StageConfig(
    ~xlen: XLen.X64,
    ~extensions: RV5StageExtensions(~compressed: extensions)
  ), ~reset_address: 0x100000000)
)
export program
