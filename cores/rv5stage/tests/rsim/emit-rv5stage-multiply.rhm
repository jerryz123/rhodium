#lang rhombus
// Emits traced EX multiplication for exact dependency and consecutive-launch timing checks.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../../riscv/isa/xlen.rhm" open
  "../../../../cores/rv5stage/tests/core-fixture.rhdl" as core
  "../../../../cores/rv5stage/profile.rhm" open
  "../../../../rhodium/event/main.rhm".EventInstrumentationConfig

  lib("rhodium/event/tests/rsim/trace-sites.rhm").traced_target

def program = elaborate(core.RV5StageCoreFixture(RV5StageConfig(~xlen: XLen.X64, ~multiplier: RV5StageMultiplierKind.Pipelined), ~reset_address: 0x100000000))
fun site_header(manifest):
  "\nnamespace multiply_sites {\n" ++ String.join(
    for List (label in ["core/s2.decode", "core/s3.execute"], name in ["decode", "execute"]):
      def matches = (for List (index in 0..manifest.sites.length()): index).filter(~keep: fun (index): manifest.sites[index].label == label)
      unless matches.length() == 1 | error("expected one multiply timing site: " ++ label)
      "constexpr unsigned " ++ name ++ " = " ++ to_string(matches[0]) ++ ";\n",
    ""
  ) ++ "}\n"
def target = traced_target(site_header, EventInstrumentationConfig(~partial: #true))
export program target
