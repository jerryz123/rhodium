#lang rhombus
// Defines the composed data IO-MSHR and instruction/data RN-I contention fixture.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("riscv/isa/xlen.rhm").XLen
  "../../../../cores/rv5stage/tests/io-mshr-fixture.rhdl".RV5StageIOMSHRFixture

// Slot fifteen exercises metadata beyond the old three-bit tag on the RN-I path.
def program = elaborate(RV5StageIOMSHRFixture(XLen.X64, ~vector_completion_slots: 16))
def program32 = elaborate(RV5StageIOMSHRFixture(XLen.X32, ~vector_completion_slots: 16))
export:
  program
  program32
