import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../../riscv/isa/xlen.rhm" open
  "../../../../cores/rv5stage/tests/core-fixture.rhdl" as core
  "../../../../cores/rv5stage/profile.rhm" open

def program = elaborate(core.RV5StageCoreFixture(
  RV5StageConfig(~xlen: XLen.X64, ~extensions: RV5StageExtensions(~ssnpm: #true, ~zicbop: #true)),
  ~reset_address: 0x1000, ~split_memory: #true
))
export program
