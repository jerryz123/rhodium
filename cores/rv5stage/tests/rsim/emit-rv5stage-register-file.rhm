import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../../riscv/isa/xlen.rhm" open
  "../../../../cores/rv5stage/register-file.rhdl" as register_file

def program = elaborate(register_file.RV5StageRegisterFile(XLen.X64))
export program
