#lang rhombus
// Defines the opt-in RV64 core for reservation-wait retirement and trap tests.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("rhodium/backend/rsim-target.rhm").rsim_target
  lib("rhodium/compile/pipeline.rhm").rtl_pipeline_target
  lib("cores/common/tests/rsim/port-observers.rhm").port_observer_pass
  "../../../../riscv/isa/xlen.rhm" open
  "../../../../cores/rv5stage/tests/core-fixture.rhdl" as core
  "../../../../cores/rv5stage/profile.rhm" open

def program = elaborate(core.RV5StageCoreFixture(RV5StageConfig(~xlen: XLen.X64, ~extensions: RV5StageExtensions(~zawrs: #true)), ~reset_address: 0))
def target = rtl_pipeline_target(rsim_target, [port_observer_pass([
  ["ReservationWait", "observe_wait", [
    ["capture_in", "valid"], ["active"], ["reservation_valid"], ["interrupt_wake"],
    ["completion_out", "valid"], ["completion_out", "bits", "illegal_instruction"],
    ["completion_out", "bits", "virtual_instruction"]
  ]],
  ["RV5StageInstructionBuffer", "observe_decode", [
    ["fetched_out", "valid"], ["fetched_in", "ready"], ["clear_in", "valid"]
  ]]
])])
export program target
