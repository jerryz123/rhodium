#lang rhombus
// Defines the RV64D core with prefetch hints for WB authorization checks.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/backend/rsim-target.rhm").rsim_target
  lib("rhodium/compile/pipeline.rhm").rtl_pipeline_target
  "port-observers.rhm".port_observer_pass
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../../cores/rv5stage/tests/core-fixture.rhdl" open
  "../../../../cores/rv5stage/profile.rhm" open
  "../../../../cores/fp/timing.rhdl" open
  "../../../../riscv/isa/fp-profile.rhm" open
  "../../../../riscv/isa/xlen.rhm" open

def program = elaborate(RV5StageCoreFixture(RV5StageConfig(
    ~xlen: XLen.X64,
    ~extensions: RV5StageExtensions(~floating_point: FloatingPointProfile.D, ~zicbop: #true)
  ), ~reset_address: 0x100, ~fp_timing: FpExecutionTiming(5, 6, 3))
)
def target = rtl_pipeline_target(rsim_target, [port_observer_pass([
  ["RV5StageFpScalar", "test_fp_observe", [
    ["fixed_issue_in", "valid"],
    ["fixed_issue_in", "bits", "context"],
    ["execution_result_in", "valid"],
    ["execution_result_in", "bits", "tag", "context"],
    ["authorize_in", "valid"],
    ["authorize_in", "bits", "context"]
  ]]
])])
export program target
