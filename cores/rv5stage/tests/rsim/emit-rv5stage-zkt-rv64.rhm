#lang rhombus
// Defines the RV64 integer Zkt timing fixture and its catalog-generated program.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../../riscv/isa/c.rhm" open
  "../../../../riscv/isa/xlen.rhm" open
  "../../../../riscv/isa/fp-profile.rhm" open
  "../../../../cores/rv5stage/profile.rhm" open
  "../../../../cores/rv5stage/tests/zkt.rhdl" open

def profile = RV5StageConfig(
  ~xlen: XLen.X64,
  ~multiplier: RV5StageMultiplierKind.Pipelined,
  ~extensions: RV5StageExtensions(
    ~floating_point: FloatingPointProfile.None,
    ~compressed: compressed_extensions(CompressedExtension.C, CompressedExtension.Zcb)
  )
)
def program = elaborate(RV5StageZkt(profile))
export program
