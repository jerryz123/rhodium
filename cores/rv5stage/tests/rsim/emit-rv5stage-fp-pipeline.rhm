#lang rhombus
// Defines a program for RV5Stage's standalone double-profile FP pipeline.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../../rhodium/core/main.rhm" open
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../../riscv/isa/fp-profile.rhm" open
  "../../../../riscv/isa/xlen.rhm" open
  "../../../../cores/rv5stage/fp/pipeline.rhdl" as pipeline

def program = elaborate(pipeline.RV5StageFpPipeline(
    XLen.X64,
    FloatingPointProfile.D,
    Bits(8),
    ~half_precision: HalfPrecisionProfile.Zfh,
    ~zfa: #true
  )
)
export program
