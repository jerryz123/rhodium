#lang rhodium
// Composes the physical data router and shared RN-I engine for IO-MSHR contention tests.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/common/fetch/protocol.rhdl") open
  "../../common/cache/protocol.rhdl" open
  lib("rhodium/std/bits.rhdl").Pow2Int
  "../memory-router.rhdl".RV5StageMemoryRouter
  lib("cores/common/cache/uncached-instruction.rhdl").UncachedInstructionMemory
  "../memory-context.rhdl".RV5StageMemoryContext
  "../uncached-protocol.rhdl" open
  "params.rhdl".test_rv5stage_uncached_config
  lib("riscv/isa/xlen.rhm").XLen
  lib("chi/protocol/channels.rhdl").CHIRNIChannels

sync_circuit RV5StageIOMSHRFixture(xlen :: XLen, ~vector_completion_slots: vector_completion_slots :: Pow2Int = 8):
  def config = test_rv5stage_uncached_config
  input node_id: Bits(config.flit.node_id_width)
  interface core(RV5StagePhysicalDataAccess(xlen, vector_completion_slots), ~role: responder)
  interface cache(CacheAccess(xlen, RV5StageMemoryContext(vector_completion_slots)), ~role: requester)
  interface instruction(PhysicalInstructionAccess(xlen.width, 32), ~role: responder)
  interface chi(CHIRNIChannels(config.flit), ~role: node)
  inst router(RV5StageMemoryRouter(xlen, config.physical_map, ~vector_completion_slots: vector_completion_slots))
  inst uncached(UncachedInstructionMemory(xlen, config, Bool, 32))
  core |> router.core
  router.cache |> cache
  router.uncached |> uncached.core
  instruction |> uncached.instruction
  uncached.node_id <== node_id
  uncached.chi <=> chi

export:
  RV5StageIOMSHRFixture
