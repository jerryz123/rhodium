#lang rhodium
// Elaborates RV5Stage's uncached engine and physical-memory router with an HN-I range.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  "../chi/uncached.rhdl" open
  "../memory-router.rhdl" open
  "../instruction-memory-router.rhdl" open
  "params.rhdl" as params
  lib("riscv/isa/xlen.rhm").XLen

def uncached_design = compile_program(elaborate(RV5StageUncached(XLen.X64,
                                                 params.test_rv5stage_uncached_config)), rtl_target).report.design
def router_design = compile_program(elaborate(RV5StageMemoryRouter(XLen.X64,
                                                   params.test_rv5stage_uncached_config.physical_map)), rtl_target).report.design
def instruction_router_design = compile_program(elaborate(RV5StageInstructionMemoryRouter(XLen.X64)), rtl_target).report.design

export:
  uncached_design
  router_design
  instruction_router_design
