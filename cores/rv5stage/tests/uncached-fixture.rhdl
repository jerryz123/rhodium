#lang rhodium
// Elaborates RV5Stage's uncached engine and physical-memory router with an HN-I range.

import:
  "../chi/uncached.rhdl" open
  "../memory-router.rhdl" open
  "../instruction-memory-router.rhdl" open
  "params.rhdl" as params
  lib("riscv/isa/xlen.rhm").XLen

def uncached_design = elaborate(RV5StageUncached(XLen.X64,
                                                 params.test_rv5stage_uncached_config))
def router_design = elaborate(RV5StageMemoryRouter(XLen.X64,
                                                   params.test_rv5stage_uncached_config.physical_map))
def instruction_router_design = elaborate(RV5StageInstructionMemoryRouter(XLen.X64))

export:
  uncached_design
  router_design
  instruction_router_design
