#lang rhodium
// Elaborates RV5Stage's uncached engine and physical-memory router with an HN-I range.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  lib("cores/common/cache/uncached-instruction.rhdl") open
  "../memory-context.rhdl".RV5StageMemoryContext
  "../memory-router.rhdl" open
  lib("cores/common/fetch/memory.rhdl") open
  "params.rhdl" as params
  lib("riscv/isa/xlen.rhm").XLen

def uncached_design = compile_program(elaborate(UncachedInstructionMemory(XLen.X64, params.test_rv5stage_uncached_config, RV5StageMemoryContext(8), 32)), rtl_target).report.design
def router_design = compile_program(elaborate(RV5StageMemoryRouter(XLen.X64, params.test_rv5stage_uncached_config.physical_map)), rtl_target).report.design
def instruction_router_design = compile_program(elaborate(InstructionMemoryRouter(64, 32)), rtl_target).report.design

export:
  uncached_design
  router_design
  instruction_router_design
