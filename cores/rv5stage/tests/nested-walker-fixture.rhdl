#lang rhodium
// Exposes the production nested walker's captured context and fault provenance for simulation.
// SPDX-License-Identifier: Apache-2.0

import:
  "../mmu/walker.rhdl" open
  "../mmu/translation.rhdl" open
  lib("riscv/rtl/hypervisor.rhdl") open
  lib("riscv/rtl/privilege.rhdl") open
  lib("riscv/rtl/sv39.rhdl") open

sync_circuit RV5StageNestedWalkerFixture():
  input command_valid: Bool
  output command_ready: Bool
  input virtualized: Bool
  input address: Bits(64)
  input access: Sv39Access
  input vs_mode: RiscvVSMode
  input g_mode: RiscvGMode
  input vs_root: Bits(44)
  input g_root: Bits(44)
  input privilege: PrivilegeMode
  input vs_sum: Bool
  input vs_mxr: Bool
  input hs_mxr: Bool
  input vs_pbmte: Bool
  input g_pbmte: Bool
  input cancel: Bool
  input memory_ready: Bool
  input memory_fault: Bool
  input response_valid: Bool
  input pte: Bits(64)
  output memory_valid: Bool
  output memory_address: Bits(64)
  output memory_pbmt: PageMemoryType
  input completion_ready: Bool
  output completed: Bool
  output fault: RV5StageTranslationFault
  output result_address: Bits(56)
  output result_virtual: Bits(64)
  output result_guest: Bits(64)
  output result_access: Sv39Access
  output fault_guest: Bits(64)
  output implicit_read: RiscvGuestFaultAccess
  output gva: Bool
  output vs_leaf: Bits(64)
  output g_leaf: Bits(64)

  inst walker(RV5StageTranslationWalker(~svnapot: #true))
  walker.cancel <== cancel
  walker.request.valid <== command_valid
  def context = RiscvGuestTranslationContext():
    vs_mode: vs_mode
    g_mode: g_mode
    vs_root_ppn: vs_root
    g_root_ppn: g_root
    privilege: privilege
    vs_sum: vs_sum
    vs_mxr: vs_mxr
    hs_mxr: hs_mxr
    vs_pbmte: vs_pbmte
    g_pbmte: g_pbmte
  walker.request.bits <== RV5StageTlbLookup():
    execute_read: Bool(#false)
    virtualized: virtualized
    virtual_address: address
    access: access
    context: context
  command_ready <== walker.request.ready
  walker.memory.request.ready <== memory_ready
  walker.memory.request_access_fault <== memory_fault
  walker.memory.response.valid <== response_valid
  walker.memory.response.bits <== pte
  memory_valid <== walker.memory.request.valid
  memory_address <== walker.memory.request.bits.address
  memory_pbmt <== walker.memory.request.bits.pbmt
  walker.completion.ready <== completion_ready
  completed <== walker.completion.valid
  fault <== walker.completion.bits.fault
  result_address <== walker.completion.bits.physical_address
  result_virtual <== walker.completion.bits.virtual_address
  result_guest <== walker.completion.bits.guest_physical_address
  result_access <== walker.completion.bits.access
  fault_guest <== walker.completion.bits.fault_details.guest_physical_address
  implicit_read <== walker.completion.bits.fault_details.access
  gva <== walker.completion.bits.fault_details.guest_virtual_address
  vs_leaf <== walker.completion.bits.vs_leaf.into(Bits(64))
  g_leaf <== walker.completion.bits.g_leaf.into(Bits(64))

export RV5StageNestedWalkerFixture
