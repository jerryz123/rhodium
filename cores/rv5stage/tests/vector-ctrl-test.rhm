#lang rhombus
// Checks vector controls including rounding/clipping, inactive care masks, and payload widths.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../riscv/isa/v.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../decode/vector-ctrl.rhdl" open
  "../decode/core-ctrl.rhdl" open
  "../decode/writeback-ctrl.rhdl".WritebackSelect
  "../vector/bundles.rhdl" open
  "../../simd-alu.rhdl" open
  "../../../rhodium/core/main.rhm" open
  "../../../rhodium/frontend/support/hardware-literal.rhm".PackedLiteral

fun field(record, name):
  def mutable offset = record.literal_type().packed_width()
  def mutable selected = #false
  for (entry in record.literal_type().fields):
    def end = offset
    offset := offset - entry.type.packed_width()
    when entry.name == name
    | selected := PackedLiteral(entry.type, bits.field(record.packed_value(), offset, end))
  selected
fun value(record, name):
  field(record, name).packed_value()
fun control_pattern(instruction):
  VectorControlCases.find(fun (row): row.input.value_bits == instruction.encoding.value && row.input.care_bits == instruction.encoding.care).output
fun control(instruction):
  control_pattern(instruction).value
fun core_control(instruction):
  VectorCoreControlCases.find(fun (row): row.input.value_bits == instruction.encoding.value && row.input.care_bits == instruction.encoding.care).output.value

check:
  value(control(VMV_X_S), "scalar_destination") ~is 1
  value(control(VMV_S_X), "element_move") ~is 1
  value(field(core_control(VMV_X_S), "writeback"), "enable") ~is 1
  value(field(core_control(VMV_X_S), "writeback"), "source") ~is WritebackSelect.Vector.packed_value()
  value(field(core_control(VMV_S_X), "operand"), "uses_rs1") ~is 1
  value(field(core_control(VMV_X_S), "operand"), "uses_rs1") ~is 0
  VectorControlCases.length() ~is VectorInitialInstructions.length()
  VectorCoreControlCases.length() ~is VectorInitialInstructions.length()
  value(control(VSETVLI), "configure") ~is VectorConfigMode.VtypeImmediate.packed_value()
  value(control(VSETIVLI), "configure") ~is VectorConfigMode.AllImmediate.packed_value()
  value(control(VSETVL), "configure") ~is VectorConfigMode.VtypeRegister.packed_value()
  value(field(control(VSUB_VV), "alu"), "subtract") ~is 1
  value(field(control(VADD_VX), "alu"), "subtract") ~is 0
  value(field(control(VSADDU_VI), "alu"), "arithmetic_mode") ~is SimdArithmeticMode.SaturateUnsigned.packed_value()
  value(field(control(VSADD_VV), "alu"), "arithmetic_mode") ~is SimdArithmeticMode.SaturateSigned.packed_value()
  value(field(control(VSSUBU_VX), "alu"), "subtract") ~is 1
  value(field(control(VSSUB_VV), "alu"), "arithmetic_mode") ~is SimdArithmeticMode.SaturateSigned.packed_value()
  value(field(control(VAADDU_VV), "alu"), "arithmetic_mode") ~is SimdArithmeticMode.AverageUnsigned.packed_value()
  value(field(control(VAADD_VX), "alu"), "arithmetic_mode") ~is SimdArithmeticMode.AverageSigned.packed_value()
  value(field(control(VASUBU_VV), "alu"), "subtract") ~is 1
  value(control(VASUB_VX), "rounding") ~is 1
  value(control(VWADDU_VV), "widening") ~is 1
  value(control(VWADDU_VV), "left_signed") ~is 0
  value(control(VWADD_VX), "right_signed") ~is 1
  value(field(control(VWSUBU_VV), "alu"), "subtract") ~is 1
  value(field(control(VWADD_VV), "alu"), "subtract") ~is 0
  value(control(VWADDU_WV), "wide_vs2") ~is 1
  value(control(VWADDU_WV), "left_signed") ~is 0
  value(control(VWADD_WX), "right_signed") ~is 1
  value(field(control(VWSUBU_WV), "alu"), "subtract") ~is 1
  value(field(control(VWADD_WV), "alu"), "subtract") ~is 0
  value(control(VNSRL_WV), "narrowing") ~is 1
  value(control(VNSRL_WV), "wide_vs2") ~is 1
  value(field(control(VNSRL_WI), "alu"), "shift_right") ~is 1
  value(field(control(VNSRL_WI), "alu"), "arithmetic_shift") ~is 0
  value(field(control(VNSRA_WX), "alu"), "arithmetic_shift") ~is 1
  value(control(VSSRL_VV), "rounding") ~is 1
  value(control(VSSRL_VV), "narrowing") ~is 0
  value(field(control(VSSRA_VI), "alu"), "arithmetic_shift") ~is 1
  value(control(VNCLIPU_WV), "rounding") ~is 1
  value(control(VNCLIPU_WV), "narrowing") ~is 1
  value(control(VNCLIPU_WV), "clip") ~is 1
  value(control(VNCLIPU_WV), "clip_unsigned") ~is 1
  value(control(VNCLIP_WX), "clip_unsigned") ~is 0
  value(field(control(VAND_VI), "alu"), "logic_select") ~is SimdLogicSelect.And.packed_value()
  value(field(control(VOR_VV), "alu"), "logic_select") ~is SimdLogicSelect.Or.packed_value()
  value(field(control(VXOR_VX), "alu"), "logic_select") ~is SimdLogicSelect.Xor.packed_value()
  value(field(control(VSLL_VI), "alu"), "shift_right") ~is 0
  value(field(control(VSRL_VI), "alu"), "arithmetic_shift") ~is 0
  value(field(control(VSRA_VI), "alu"), "arithmetic_shift") ~is 1
  value(control(VMSNE_VV), "invert_comparison") ~is 1
  value(control(VMSGT_VI), "swap_operands") ~is 1
  value(field(control(VMSLEU_VV), "alu"), "comparison_select") ~is SimdComparisonSelect.LessEqual.packed_value()
  value(field(control(VMSLT_VV), "alu"), "signed_compare") ~is 1
  value(field(control(VMAX_VV), "alu"), "maximum") ~is 1
  value(field(control(VMINU_VX), "alu"), "maximum") ~is 0
  value(control(VCOMPRESS_VM), "compress") ~is 1
  value(control(VCOMPRESS_VM), "operand") ~is VectorOperandMode.Vector.packed_value()
  value(field(core_control(VCOMPRESS_VM), "operand"), "uses_rs1") ~is 0
  value(field(core_control(VCOMPRESS_VM), "writeback"), "enable") ~is 0

for (instruction in VectorGatherInstructions, index in 0..4):
  check:
    value(control(instruction), "gather") ~is 1
    value(control(instruction), "gather_index16") ~is (if index == 1 | 1 | 0)
    value(control(instruction), "operand") ~is (if index < 2 | VectorOperandMode.Vector.packed_value() | (if index == 2 | VectorOperandMode.Scalar.packed_value() | VectorOperandMode.Immediate.packed_value()))
    value(field(control(instruction), "alu"), "rotate") ~is 1
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is (if index == 2 | 1 | 0)
    value(field(core_control(instruction), "writeback"), "enable") ~is 0
for (instruction in VectorSlideInstructions, index in 0..6):
  check:
    value(control(instruction), "slide") ~is 1
    value(control(instruction), "slide_up") ~is (if [0, 1, 4].contains(index) | 1 | 0)
    value(control(instruction), "slide_one") ~is (if index >= 4 | 1 | 0)
    value(control(instruction), "operand") ~is (if [1, 3].contains(index) | VectorOperandMode.Immediate.packed_value() | VectorOperandMode.Scalar.packed_value())
    value(field(control(instruction), "alu"), "result_select") ~is SimdResultSelect.Shift.packed_value()
    value(field(control(instruction), "alu"), "rotate") ~is 1
    value(field(control(instruction), "alu"), "shift_right") ~is 1
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is (if [1, 3].contains(index) | 0 | 1)
    value(field(core_control(instruction), "operand"), "uses_rs2") ~is 0
    value(field(core_control(instruction), "writeback"), "enable") ~is 0
for (instruction in VectorIntegerReductionInstructions):
  check:
    value(control(instruction), "reduction") ~is 1
    value(field(core_control(instruction), "writeback"), "enable") ~is 0
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is 0
for (instruction in VectorMaskScanInstructions, index in 0..7):
  check:
    value(control(instruction), "scan") ~is 1
    value(control(instruction), "scalar_destination") ~is (if index < 2 | 1 | 0)
    value(control(instruction), "mask_destination") ~is (if index >= 2 && index < 5 | 1 | 0)
    value(field(control(instruction), "scan_control"), "index") ~is (if index == 6 | 1 | 0)
    value(field(core_control(instruction), "writeback"), "enable") ~is (if index < 2 | 1 | 0)
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is 0
    value(field(core_control(instruction), "operand"), "uses_rs2") ~is 0
for (instruction in VectorMoveMergeInstructions, index in 0..6):
  check:
    value(control(instruction), "integer") ~is 1
    value(control(instruction), "mask_select") ~is (if index < 3 | 1 | 0)
    value(control(instruction), "uses_vs2") ~is (if index < 3 | 1 | 0)
    value(field(control(instruction), "alu"), "result_select") ~is SimdResultSelect.Select.packed_value()
    value(control(instruction), "operand") ~is index mod 3
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is (if index mod 3 == 1 | 1 | 0)
    value(field(core_control(instruction), "writeback"), "enable") ~is 0

for (instruction in VectorMaskLogicInstructions, index in 0..8):
  check:
    value(control(instruction), "mask_logic") ~is 1
    value(control(instruction), "mask_destination") ~is 1
    value(control(instruction), "invert_logic_result") ~is (if index >= 5 | 1 | 0)
    value(field(control(instruction), "alu"), "invert_right") ~is (if index == 0 || index == 4 | 1 | 0)
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is 0
    value(field(core_control(instruction), "operand"), "uses_rs2") ~is 0

for (instruction in VectorDivideInstructions, index in 0..8):
  def decoded = control(instruction)
  def care = control_pattern(instruction).care
  def operation = index div 2
  check:
    value(decoded, "multiply_divide") ~is 1
    value(decoded, "integer") ~is 0
    value(decoded, "memory") ~is 0
    value(decoded, "floating_point") ~is 0
    value(decoded, "divide") ~is 1
    value(decoded, "left_signed") ~is (if [1, 3].contains(operation) | 1 | 0)
    value(decoded, "right_signed") ~is (if [1, 3].contains(operation) | 1 | 0)
    value(decoded, "remainder") ~is (if operation >= 2 | 1 | 0)
    value(decoded, "operand") ~is (if index mod 2 == 0 | VectorOperandMode.Vector.packed_value() | VectorOperandMode.Scalar.packed_value())
    value(care, "store") ~is 0
    value(care, "mask_destination") ~is 0

for (instruction in VectorMultiplyInstructions, index in 0..8):
  def decoded = control(instruction)
  def operation = index div 2
  check:
    value(decoded, "multiply_divide") ~is 1
    value(decoded, "divide") ~is 0
    value(decoded, "left_signed") ~is (if operation >= 2 | 1 | 0)
    value(decoded, "right_signed") ~is (if operation == 3 | 1 | 0)
    value(decoded, "multiply_result") ~is (if operation == 1 | VectorMultiplyResult.Low.packed_value() | VectorMultiplyResult.High.packed_value())
    value(decoded, "operand") ~is (if index mod 2 == 0 | VectorOperandMode.Vector.packed_value() | VectorOperandMode.Scalar.packed_value())

for (instruction in VectorFractionalMultiplyInstructions, index in 0..2):
  def decoded = control(instruction)
  check:
    value(decoded, "multiply_divide") ~is 1
    value(decoded, "divide") ~is 0
    value(decoded, "left_signed") ~is 1
    value(decoded, "right_signed") ~is 1
    value(decoded, "multiply_result") ~is VectorMultiplyResult.Fractional.packed_value()
    value(decoded, "operand") ~is (if index == 0 | VectorOperandMode.Vector.packed_value() | VectorOperandMode.Scalar.packed_value())

for (instruction in VectorFloatingPointInstructions):
  def decoded = control(instruction)
  def care = control_pattern(instruction).care
  check:
    value(decoded, "floating_point") ~is 1
    value(decoded, "integer") ~is 0
    value(decoded, "memory") ~is 0
    value(decoded, "fp_subtract") ~is (if instruction == VFSUB_VV | 1 | 0)
    value(decoded, "fp_multiply") ~is (if instruction == VFMUL_VV | 1 | 0)
    value(care, "store") ~is 0
    value(care, "mask_destination") ~is 0

for (instruction in VectorIntegerInstructions):
  def decoded = control(instruction)
  def expected_operand = cond
  | instruction.format == VectorVVFormat: VectorOperandMode.Vector
  | instruction.format == VectorVXFormat: VectorOperandMode.Scalar
  | ~else: VectorOperandMode.Immediate
  check:
    value(decoded, "integer") ~is 1
    value(decoded, "memory") ~is 0
    value(decoded, "configure") ~is VectorConfigMode.None.packed_value()
    value(decoded, "operand") ~is expected_operand.packed_value()
    value(decoded, "immediate_unsigned") ~is (if instruction.format == VectorShiftVIFormat | 1 | 0)

for (instruction in VectorMemoryInstructions, index in 0..8):
  def decoded = control(instruction)
  check:
    value(decoded, "integer") ~is 0
    value(decoded, "memory") ~is 1
    value(decoded, "store") ~is (if index >= 4 | 1 | 0)
    value(decoded, "eew") ~is index mod 4

for (vlen in [128, 256, 512, 65536]):
  def micro = RV5StageVectorMicroOp(vlen, Bits(4))
  def feedback = RV5StageVectorFeedback(XLen.X64, vlen, Bits(4))
  def beat = micro.field("beat").type
  check:
    beat.field("left").type.packed_width() ~is 64
    beat.field("right").type.packed_width() ~is 64
    micro.field("context").type.packed_width() ~is 4
    feedback.field("context").type.packed_width() ~is 4
    (1 bits.(<<) beat.field("end").type.packed_width()) > vlen ~is #true
    beat.field("end").type.packed_width() ~is feedback.field("end").type.packed_width()
    beat.field("destination_first").type.packed_width() ~is beat.field("end").type.packed_width()
    beat.field("compress_state").type.field("destination").type.packed_width() ~is beat.field("end").type.packed_width()
    feedback.field("compress_state").type.field("destination").type.packed_width() ~is beat.field("end").type.packed_width()
