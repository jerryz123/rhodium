#lang rhombus
// Checks vector controls including extension, rounding/clipping, inactive care masks, and widths.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../riscv/isa/v.rhm" open
  "../../../riscv/isa/zvbb.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/rtl/floating-point.rhdl".FloatSignOperation
  "../../common/vector/decode.rhdl" open
  "../decode/core-ctrl.rhdl" open
  "../decode/writeback-ctrl.rhdl".RV5StageWritebackSelect
  "../../common/fp/types.rhdl" open
  "../../common/vector/bundles.rhdl" open
  "../../common/simd-alu.rhdl" open
  "../../common/simd-multiplier.rhdl".SimdMultiplySelect
  "../../../rhodium/core/main.rhm" open
  "../../../rhodium/frontend/support/hardware-literal.rhm".PackedLiteral
  lib("hardfloat/main.rhdl").MulAddOperation
  lib("hardfloat/main.rhdl").MinMaxOperation
  lib("hardfloat/main.rhdl").Estimate7Operation

fun field(record, name):
  def mutable offset = record.literal_type().packed_width()
  def mutable selected = #false
  for (entry in record.literal_type().fields):
    def end = offset
    offset := offset - entry.type.packed_width()
    when entry.name == name
    | selected := PackedLiteral(entry.type, bits.field(record.packed_value(), offset, end))

  selected

fun value(record, name):
  field(record, name).packed_value()

fun control_pattern(instruction):
  VectorControlCases.find(fun (row): row.input.value_bits == instruction.encoding.value && row.input.care_bits == instruction.encoding.care).output

fun control(instruction):
  control_pattern(instruction).value

fun zvbb_control(instruction):
  VectorZvbbCases.find(fun (row): row.input.value_bits == instruction.encoding.value && row.input.care_bits == instruction.encoding.care).output.value

fun fp(decoded): field(decoded, "fp")

fun row_alu(decoded): field(field(decoded, "integer_row"), "alu")

fun core_control(instruction):
  VectorCoreControlCases.find(fun (row): row.input.value_bits == instruction.encoding.value && row.input.care_bits == instruction.encoding.care).output.value

fun zvbb_core_control(instruction):
  VectorZvbbCoreControlCases.find(fun (row): row.input.value_bits == instruction.encoding.value && row.input.care_bits == instruction.encoding.care).output.value

for ([kind, instructions] in [
       [VectorSequence.Rows, [VADD_VV, VSLIDEUP_VX, VMUL_VV, VDIV_VX, VFADD_VV, VFMV_V_F]],
       [VectorSequence.Reduction, VectorSameWidthIntegerReductionInstructions ++ VectorFloatingPointReductionInstructions],
       [VectorSequence.Scan, [VCPOP_M, VIOTA_M, VID_V]], [VectorSequence.Extract, [VMV_X_S, VFMV_F_S]],
       [VectorSequence.Insert, [VMV_S_X, VFMV_S_F]], [VectorSequence.WholeCopy, VectorWholeRegisterMoveInstructions]]):
  for (instruction in instructions):
    check:
      value(control(instruction), "sequence") ~is kind.packed_value()
      value(control_pattern(instruction).care, "sequence") ~is 2 ** VectorSequence.packed_width() - 1

for (instruction in VectorConfigInstructions ++ VectorUnitStrideMemoryInstructions ++ VectorIndexedOrderedMemoryInstructions):
  check:
    value(control_pattern(instruction).care, "sequence") ~is 0
    value(control_pattern(instruction).care, "result_kind") ~is 0

// Routing is generated for every compute cube, never constrained for memory or vset.
for ([cursor, vps, examples] in [
       [VectorComputeCursor.Row, VectorVpsUse.None, [VADD_VV, VDIV_VX, VFMV_S_F, VMV4R_V]],
       [VectorComputeCursor.Row, VectorVpsUse.Permutation, [VSLIDEUP_VI, VRGATHER_VV, VFSLIDE1DOWN_VF, VCOMPRESS_VM]],
       [VectorComputeCursor.Fold, VectorVpsUse.ReductionSeed, [VWREDSUM_VS, VFREDMIN_VS]],
       [VectorComputeCursor.Fold, VectorVpsUse.None, [VCPOP_M, VIOTA_M, VMV_X_S, VFMV_F_S]]]):
  for (i in examples):
    check:
      value(control(i), "cursor") ~is cursor.packed_value()
      value(control(i), "vps") ~is vps.packed_value()

for ([identity, instructions] in [
       [VectorReductionIdentity.Zero, [VREDSUM_VS, VREDOR_VS, VREDXOR_VS, VREDMAXU_VS, VWREDSUMU_VS, VWREDSUM_VS]],
       [VectorReductionIdentity.AllOnes, [VREDAND_VS, VREDMINU_VS]],
       [VectorReductionIdentity.SignedMax, [VREDMIN_VS]], [VectorReductionIdentity.SignedMin, [VREDMAX_VS]]]):
  for (i in instructions):
    check: value(control(i), "reduction_identity") ~is identity.packed_value()

for (row in VectorControlCases ++ VectorZvbbCases):
  def compute = value(row.output.value, "configure") == VectorConfigMode.None.packed_value() && value(row.output.value, "memory") == 0
  def row_cursor = compute && value(row.output.value, "cursor") == VectorComputeCursor.Row.packed_value()
  def family = value(row.output.value, "compute_family")
  def data_row = row_cursor && [VectorComputeFamily.IntegerData.packed_value(), VectorComputeFamily.FpData.packed_value()].contains(family)
  for (enable in ["integer", "floating_point", "reads_frs1", "fp_service", "multiply_divide"]):
    check value(row.output.care, enable) ~is 1
    unless compute
    | check value(row.output.value, enable) ~is 0
  def integer_fold = compute && value(row.output.value, "integer") == 1 && value(row.output.value, "sequence") == VectorSequence.Reduction.packed_value()
  check:
    value(row.output.care, "compute_family") ~is (if compute | 2 ** VectorComputeFamily.packed_width() - 1 | 0)
    value(row.output.care, "reduction_identity") ~is (if integer_fold | 2 ** VectorReductionIdentity.packed_width() - 1 | 0)
    value(row.output.care, "row_layout") ~is (if row_cursor | 2 ** VectorRowLayout.packed_width() - 1 | 0)
    value(row.output.care, "data_result") ~is (if data_row | 2 ** VectorDataResult.packed_width() - 1 | 0)
    value(row.output.care, "cursor") ~is (if compute | 1 | 0)
    value(row.output.care, "vps") ~is (if compute | 3 | 0)
    value(row.output.care, "division") ~is (if compute && value(row.output.value, "compute_family") == VectorComputeFamily.IntDivide.packed_value() | 3 | 0)
    value(row.output.care, "permutation") ~is (2 ** VectorPermutationKind.packed_width() - 1)
    value(row.output.care, "result_kind") ~is (if compute | 2 ** VectorResultKind.packed_width() - 1 | 0)

for ([source, examples] in [
       [VectorDataResult.Alu, [VADD_VV, VMXOR_MM, VFMERGE_VFM, VFMV_V_F]],
       [VectorDataResult.MaskBits, [VMSEQ_VV, VMADC_VVM, VMSBC_VVM]],
       [VectorDataResult.CopyVs2, [VMV1R_V, VMV8R_V]],
       [VectorDataResult.Permutation, [VSLIDEUP_VX, VFSLIDE1DOWN_VF, VRGATHER_VV, VCOMPRESS_VM]]]):
  for (i in examples):
    check value(control(i), "data_result") ~is source.packed_value()

for ([layout, examples] in [
       [VectorRowLayout.ElementRows, [VADD_VV, VADC_VVM, VMV4R_V, VFMV_S_F, VDIV_VX]],
       [VectorRowLayout.ElementsToMask, [VMSEQ_VV, VMSNE_VX, VMADC_VVM, VMSBC_VVM, VMFEQ_VV]]]):
  for (i in examples):
    check: value(control(i), "row_layout") ~is layout.packed_value()

for ([kind, instructions] in [
       [VectorComputeFamily.IntegerData, [VSLIDEUP_VX, VADD_VV, VMERGE_VXM]],
       [VectorComputeFamily.FpData, VectorFloatingPointMoveInstructions ++ VectorFloatingPointSlideInstructions],
       [VectorComputeFamily.IntProduct, [VMUL_VV, VMACC_VV, VWMACC_VX]],
       [VectorComputeFamily.IntDivide, VectorDivideInstructions],
       [VectorComputeFamily.FpArithmetic, [VFADD_VV, VFWADD_VV, VFRSQRT7_V]],
       [VectorComputeFamily.FpDivSqrt, [VFDIV_VV, VFDIV_VF, VFRDIV_VF, VFSQRT_V]]]):
  for (instruction in instructions):
    check:
      value(control(instruction), "compute_family") ~is kind.packed_value()
      value(control_pattern(instruction).care, "compute_family") ~is 2 ** VectorComputeFamily.packed_width() - 1

for (instruction in VectorConfigInstructions ++ VectorUnitStrideMemoryInstructions):
  check: value(control_pattern(instruction).care, "compute_family") ~is 0

for ([shape, instructions] in [
       [VectorWidthShape.Same, [VADD_VV, VMADC_VVM, VFMV_V_F, VDIV_VX]],
       [VectorWidthShape.Widen, [VWADD_VV, VWMACC_VV, VFWADD_VV]],
       [VectorWidthShape.WidenWideVs2, [VWADD_WV, VFWADD_WF]],
       [VectorWidthShape.Narrow, [VNCLIP_WV, VFNCVT_F_F_W]],
       [VectorWidthShape.Extend2, [VZEXT_VF2]], [VectorWidthShape.Extend4, [VSEXT_VF4]], [VectorWidthShape.Extend8, [VZEXT_VF8]]]):
  for (instruction in instructions):
    check:
      value(control(instruction), "width_shape") ~is shape.packed_value()
      value(control_pattern(instruction).care, "width_shape") ~is 2 ** VectorWidthShape.packed_width() - 1

for (instruction in VectorConfigInstructions ++ VectorMemoryInstructions):
  check: value(control_pattern(instruction).care, "width_shape") ~is 0

def permutations = VectorGatherInstructions ++ VectorSlideInstructions ++ [VFSLIDE1UP_VF, VFSLIDE1DOWN_VF, VCOMPRESS_VM]
check value(NoVectorControl.value, "dispatch_kind") ~is VectorDispatchKind.None.packed_value()
check value(NoVectorControl.care, "dispatch_kind") ~is 3
for (row in VectorControlCases ++ VectorZvbbCases):
  def encoding = row.input.value_bits
  def expected:
    cond
    | bits.field(encoding, 0, 7) == 0x07: VectorDispatchKind.Load
    | bits.field(encoding, 0, 7) == 0x27: VectorDispatchKind.Store
    | bits.field(encoding, 12, 15) == 7: VectorDispatchKind.None
    | ~else: VectorDispatchKind.Execute
  check:
    value(row.output.care, "dispatch_kind") ~is 3
    value(row.output.value, "dispatch_kind") ~is expected.packed_value()
    value(row.output.value, "memory") ~is (if [VectorDispatchKind.Load, VectorDispatchKind.Store].contains(expected) | 1 | 0)
    value(row.output.care, "store") ~is value(row.output.value, "memory")
  when [VectorDispatchKind.Load, VectorDispatchKind.Store].contains(expected)
  | check value(row.output.value, "store") ~is (if expected == VectorDispatchKind.Store | 1 | 0)

for (instruction in VectorVInstructions):
  check value(control(instruction), "reads_frs1") ~is (if instruction.operands.map(fun (operand): operand.name).contains("frs1") | 1 | 0)
  unless permutations.contains(instruction)
  | check: value(control(instruction), "permutation") ~is VectorPermutationKind.None.packed_value()

for ([instruction, vs2, vs1, old_vd, v0] in [[VMACC_VV, 1, 1, 1, VectorV0Role.Predicate], [VMACC_VX, 1, 0, 1, VectorV0Role.Predicate], [VMV_V_X, 0, 0, 0, VectorV0Role.Unused], [VSLIDEUP_VX, 1, 0, 0, VectorV0Role.Predicate], [VCOMPRESS_VM, 1, 1, 0, VectorV0Role.Unused]]):
  def roles = field(control(instruction), "reads")
  def care = field(control_pattern(instruction).care, "reads")
  check:
    care.packed_value() ~is (2 ** care.literal_type().packed_width()) - 1
    [value(roles, "vs2"), value(roles, "vs1"), value(roles, "old_vd"), value(roles, "v0")] ~is [vs2, vs1, old_vd, v0.packed_value()]

for (instruction in VectorSaturatingAddSubtractInstructions ++ VectorNarrowingClipInstructions ++ [VADD_VV, VAND_VV, VAADD_VV, VNSRA_WV, VSSRA_VV, VFMERGE_VFM]):
  def kind = field(control(instruction), "integer_row")
  def care = field(control_pattern(instruction).care, "integer_row")
  check:
    value(care, "can_saturate") ~is 1
    value(kind, "can_saturate") ~is (if (VectorSaturatingAddSubtractInstructions ++ VectorNarrowingClipInstructions).contains(instruction) | 1 | 0)

for (instruction in [VAND_VV, VXOR_VV, VSSRA_VV, VNCLIP_WV, VNSRA_WV]):
  check: value(row_alu(control_pattern(instruction).care), "arithmetic_mode") ~is 0

// Check the emitted relation, not whichever zero/one a minimizer chooses for a wildcard.
for (instruction in [VADD_VV, VSUB_VX, VAND_VI, VMIN_VV, VMSLT_VV]):
  def care = control_pattern(instruction).care
  for (name in ["scan_control", "left_signed", "right_signed"]):
    check: value(care, name) ~is 0
  check: value(field(care, "integer_row"), "clip_unsigned") ~is 0

for (instruction in [VADD_VV, VAND_VI, VMNAND_MM, VMSBF_M]):
  check: value(field(control_pattern(instruction).care, "integer_row"), "invert_comparison") ~is 0

for (instruction in [VMSEQ_VV, VMSNE_VX]):
  check: value(row_alu(control_pattern(instruction).care), "signed_compare") ~is 0

for (instruction in [VWADD_VV, VNSRL_WV, VNCLIP_WX]):
  check:
    value(control_pattern(instruction).care, "left_signed") ~is 1
    value(control_pattern(instruction).care, "right_signed") ~is 1

for (instruction in [VMSBF_M, VMSIF_M, VMSOF_M]):
  def care = field(control_pattern(instruction).care, "scan_control")
  check:
    value(care, "include_first") ~is 1
    value(care, "only_first") ~is 1

for (instruction in [VCPOP_M, VFIRST_M, VIOTA_M, VID_V]):
  def care = field(control_pattern(instruction).care, "scan_control")
  check:
    value(care, "include_first") ~is 0
    value(care, "only_first") ~is 0
    value(care, "index") ~is 1

for (instruction in [VFSGNJ_VV, VFCLASS_V, VFMIN_VV, VMFEQ_VV, VFRSQRT7_V]):
  check: value(fp(control_pattern(instruction).care), "rounding") ~is 0

for (instruction in [VFADD_VV, VFREC7_V, VFCVT_RTZ_X_F_V, VFNCVT_ROD_F_F_W]):
  check: value(fp(control_pattern(instruction).care), "rounding") ~is 3

for (instruction in [VFWCVT_F_F_V, VFNCVT_F_F_W, VFNCVT_ROD_F_F_W]):
  check: value(field(fp(control_pattern(instruction).care), "execution"), "integer_unsigned") ~is 0

for (instruction in [VFCVT_X_F_V, VFCVT_F_X_V, VFNCVT_RTZ_X_F_W, VFCVT_XU_F_V]):
  check: value(field(fp(control_pattern(instruction).care), "execution"), "integer_unsigned") ~is 1

check:
  value(control(VMV_X_S), "result_kind") ~is VectorResultKind.Gpr.packed_value()
  value(control(VFWCVT_F_F_V), "fp_zvfhmin_e16") ~is 1
  value(control(VFNCVT_F_F_W), "fp_zvfhmin_e16") ~is 1
  value(control(VFWCVT_XU_F_V), "fp_zvfhmin_e16") ~is 0
  value(control(VFWCVT_F_XU_V), "fp_wide_float") ~is 1
  value(control(VFNCVT_XU_F_W), "fp_wide_float") ~is 1
  value(control(VMV_S_X), "sequence") ~is VectorSequence.Insert.packed_value()
  value(field(core_control(VMV_X_S), "writeback"), "enable") ~is 1
  value(field(core_control(VMV_X_S), "writeback"), "source") ~is RV5StageWritebackSelect.Vector.packed_value()
  value(field(core_control(VMV_S_X), "operand"), "uses_rs1") ~is 1
  value(field(core_control(VMV_X_S), "operand"), "uses_rs1") ~is 0
  VectorControlCases.length() ~is VectorVInstructions.length()
  VectorCoreControlCases.length() ~is VectorVInstructions.length()
  VectorZvbbCases.length() ~is ZvbbInstructions.length()
  VectorZvbbCoreControlCases.length() ~is ZvbbInstructions.length()
  value(control(VSETVLI), "configure") ~is VectorConfigMode.VtypeImmediate.packed_value()
  value(control(VSETIVLI), "configure") ~is VectorConfigMode.AllImmediate.packed_value()
  value(control(VSETVL), "configure") ~is VectorConfigMode.VtypeRegister.packed_value()
  value(row_alu(control(VSUB_VV)), "subtract") ~is 1
  value(field(control(VSUB_VX), "integer_row"), "swap_operands") ~is 0
  value(field(control(VRSUB_VX), "integer_row"), "swap_operands") ~is 1
  value(field(control(VRSUB_VI), "integer_row"), "swap_operands") ~is 1
  value(row_alu(control(VRSUB_VI)), "subtract") ~is 1
  value(row_alu(control(VADD_VX)), "subtract") ~is 0
  value(row_alu(control(VSADDU_VI)), "arithmetic_mode") ~is SimdArithmeticMode.SaturateUnsigned.packed_value()
  value(row_alu(control(VSADD_VV)), "arithmetic_mode") ~is SimdArithmeticMode.SaturateSigned.packed_value()
  value(row_alu(control(VSSUBU_VX)), "subtract") ~is 1
  value(row_alu(control(VSSUB_VV)), "arithmetic_mode") ~is SimdArithmeticMode.SaturateSigned.packed_value()
  value(row_alu(control(VAADDU_VV)), "arithmetic_mode") ~is SimdArithmeticMode.AverageUnsigned.packed_value()
  value(row_alu(control(VAADD_VX)), "arithmetic_mode") ~is SimdArithmeticMode.AverageSigned.packed_value()
  value(row_alu(control(VASUBU_VV)), "subtract") ~is 1
  value(field(control(VASUB_VX), "integer_row"), "round_shift") ~is 0
  value(control(VWADDU_VV), "width_shape") ~is VectorWidthShape.Widen.packed_value()
  value(control(VWADDU_VV), "left_signed") ~is 0
  value(control(VWADD_VX), "right_signed") ~is 1
  value(row_alu(control(VWSUBU_VV)), "subtract") ~is 1
  value(row_alu(control(VWADD_VV)), "subtract") ~is 0
  value(control(VWADDU_WV), "width_shape") ~is VectorWidthShape.WidenWideVs2.packed_value()
  value(control(VWADDU_WV), "left_signed") ~is 0
  value(control(VWADD_WX), "right_signed") ~is 1
  value(row_alu(control(VWSUBU_WV)), "subtract") ~is 1
  value(row_alu(control(VWADD_WV)), "subtract") ~is 0
  value(control(VNSRL_WV), "width_shape") ~is VectorWidthShape.Narrow.packed_value()
  value(row_alu(control(VNSRL_WI)), "shift_right") ~is 1
  value(row_alu(control(VNSRL_WI)), "arithmetic_shift") ~is 0
  value(row_alu(control(VNSRA_WX)), "arithmetic_shift") ~is 1
  value(field(control(VSSRL_VV), "integer_row"), "round_shift") ~is 1
  value(control(VSSRL_VV), "width_shape") ~is VectorWidthShape.Same.packed_value()
  value(row_alu(control(VSSRA_VI)), "arithmetic_shift") ~is 1
  value(field(control(VNCLIPU_WV), "integer_row"), "round_shift") ~is 1
  value(control(VNCLIPU_WV), "width_shape") ~is VectorWidthShape.Narrow.packed_value()
  value(field(control(VNCLIPU_WV), "integer_row"), "clip") ~is 1
  value(field(control(VNCLIPU_WV), "integer_row"), "clip_unsigned") ~is 1
  value(field(control(VNCLIP_WX), "integer_row"), "clip_unsigned") ~is 0
  value(row_alu(control(VAND_VI)), "logic_select") ~is SimdLogicSelect.And.packed_value()
  value(row_alu(control(VOR_VV)), "logic_select") ~is SimdLogicSelect.Or.packed_value()
  value(row_alu(control(VXOR_VX)), "logic_select") ~is SimdLogicSelect.Xor.packed_value()
  value(row_alu(control(VSLL_VI)), "shift_right") ~is 0
  value(row_alu(control(VSRL_VI)), "arithmetic_shift") ~is 0
  value(row_alu(control(VSRA_VI)), "arithmetic_shift") ~is 1
  value(field(control(VMSNE_VV), "integer_row"), "invert_comparison") ~is 1
  value(field(control(VMSGT_VI), "integer_row"), "swap_operands") ~is 1
  value(field(control(VMSGTU_VI), "integer_row"), "swap_operands") ~is 1
  value(row_alu(control(VMSLEU_VV)), "comparison_select") ~is SimdComparisonSelect.LessEqual.packed_value()
  value(row_alu(control(VMSLT_VV)), "signed_compare") ~is 1
  value(row_alu(control(VMAX_VV)), "maximum") ~is 1
  value(row_alu(control(VMINU_VX)), "maximum") ~is 0
  value(control(VCOMPRESS_VM), "permutation") ~is VectorPermutationKind.Compress.packed_value()
  value(control(VCOMPRESS_VM), "operand") ~is VectorOperandMode.Vector.packed_value()
  value(field(core_control(VCOMPRESS_VM), "operand"), "uses_rs1") ~is 0
  value(field(core_control(VCOMPRESS_VM), "writeback"), "enable") ~is 0
  value(row_alu(zvbb_control(VANDN_VV)), "logic_select") ~is SimdLogicSelect.And.packed_value()
  value(row_alu(zvbb_control(VANDN_VV)), "invert_right") ~is 1
  value(row_alu(zvbb_control(VBREV_V)), "permutation_select") ~is SimdPermutationSelect.ReverseBits.packed_value()
  value(row_alu(zvbb_control(VBREV8_V)), "permutation_select") ~is SimdPermutationSelect.ReverseBitsInBytes.packed_value()
  value(row_alu(zvbb_control(VREV8_V)), "permutation_select") ~is SimdPermutationSelect.ReverseBytes.packed_value()
  value(row_alu(zvbb_control(VCLZ_V)), "count_select") ~is SimdCountSelect.LeadingZeros.packed_value()
  value(row_alu(zvbb_control(VCTZ_V)), "count_select") ~is SimdCountSelect.TrailingZeros.packed_value()
  value(row_alu(zvbb_control(VCPOP_V)), "count_select") ~is SimdCountSelect.Population.packed_value()
  value(row_alu(zvbb_control(VROL_VV)), "shift_right") ~is 0
  value(row_alu(zvbb_control(VROL_VV)), "rotate") ~is 1
  value(row_alu(zvbb_control(VROR_VX)), "shift_right") ~is 1
  value(row_alu(zvbb_control(VROR_VX)), "rotate") ~is 1
  value(zvbb_control(VROR_VI), "immediate_kind") ~is VectorImmediateKind.Unsigned6.packed_value()
  value(zvbb_control(VWSLL_VI), "immediate_kind") ~is VectorImmediateKind.Unsigned5.packed_value()
  value(zvbb_control(VWSLL_VV), "width_shape") ~is VectorWidthShape.Widen.packed_value()
  value(field(zvbb_core_control(VANDN_VX), "operand"), "uses_rs1") ~is 1
  value(field(zvbb_core_control(VBREV_V), "operand"), "uses_rs1") ~is 0

for (instruction in VectorCarryBorrowInstructions, index in 0..15):
  def decoded = control(instruction)
  def form = instruction.format
  def carry_input = index < 6 || (index >= 9 && index < 13)
  def mask_destination = (index >= 3 && index < 9) || index >= 11
  check:
    value(decoded, "integer") ~is 1
    (value(field(decoded, "reads"), "v0") == VectorV0Role.Carry.packed_value()) ~is carry_input
    value(decoded, "result_kind") ~is (if mask_destination | VectorResultKind.Mask | VectorResultKind.Elements).packed_value()
    value(row_alu(decoded), "result_select") ~is SimdResultSelect.Adder.packed_value()
    value(row_alu(decoded), "mask_result_select") ~is SimdMaskResultSelect.CarryBorrow.packed_value()
    value(row_alu(decoded), "subtract") ~is (if index >= 9 | 1 | 0)
    value(decoded, "operand") ~is (if form == VectorFixedVVFormat | VectorOperandMode.Vector.packed_value() | (if form == VectorFixedVXFormat | VectorOperandMode.Scalar.packed_value() | VectorOperandMode.Immediate.packed_value()))
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is (if form == VectorFixedVXFormat | 1 | 0)
    value(field(core_control(instruction), "writeback"), "enable") ~is 0

for (instruction in VectorExtensionInstructions, index in 0..6):
  def decoded = control(instruction)
  check:
    value(decoded, "integer") ~is 1
    value(decoded, "width_shape") ~is [VectorWidthShape.Extend2, VectorWidthShape.Extend4, VectorWidthShape.Extend8][index mod 3].packed_value()
    value(decoded, "left_signed") ~is (if index >= 3 | 1 | 0)
    value(decoded, "operand") ~is VectorOperandMode.Immediate.packed_value()
    value(row_alu(decoded), "result_select") ~is SimdResultSelect.Select.packed_value()
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is 0
    value(field(core_control(instruction), "operand"), "uses_rs2") ~is 0
    value(field(core_control(instruction), "writeback"), "enable") ~is 0

for (instruction in VectorGatherInstructions, index in 0..4, kind in [VectorPermutationKind.GatherVector, VectorPermutationKind.GatherVectorEI16, VectorPermutationKind.GatherBroadcast, VectorPermutationKind.GatherBroadcast]):
  check:
    value(control(instruction), "permutation") ~is kind.packed_value()
    value(field(control(instruction), "reads"), "vs1") ~is (if index < 2 | 1 | 0)
    value(control(instruction), "operand") ~is (if index < 2 | VectorOperandMode.Vector.packed_value() | (if index == 2 | VectorOperandMode.Scalar.packed_value() | VectorOperandMode.Immediate.packed_value()))
    value(row_alu(control(instruction)), "rotate") ~is 1
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is (if index == 2 | 1 | 0)
    value(field(core_control(instruction), "writeback"), "enable") ~is 0

for (instruction in VectorSlideInstructions, index in 0..6, kind in [VectorPermutationKind.SlideUp, VectorPermutationKind.SlideUp, VectorPermutationKind.SlideDown, VectorPermutationKind.SlideDown, VectorPermutationKind.SlideOneUp, VectorPermutationKind.SlideOneDown]):
  check:
    value(control(instruction), "permutation") ~is kind.packed_value()
    value(control(instruction), "operand") ~is (if [1, 3].contains(index) | VectorOperandMode.Immediate.packed_value() | VectorOperandMode.Scalar.packed_value())
    value(row_alu(control(instruction)), "result_select") ~is SimdResultSelect.Shift.packed_value()
    value(row_alu(control(instruction)), "rotate") ~is 1
    value(row_alu(control(instruction)), "shift_right") ~is 1
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is (if [1, 3].contains(index) | 0 | 1)
    value(field(core_control(instruction), "operand"), "uses_rs2") ~is 0
    value(field(core_control(instruction), "writeback"), "enable") ~is 0

for (instruction in VectorIntegerReductionInstructions):
  check:
    value(control(instruction), "sequence") ~is VectorSequence.Reduction.packed_value()
    value(field(core_control(instruction), "writeback"), "enable") ~is 0
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is 0

for (instruction in VectorWideningIntegerReductionInstructions, index in 0..2):
  check:
    value(control(instruction), "width_shape") ~is VectorWidthShape.Widen.packed_value()
    value(control(instruction), "right_signed") ~is index
    value(row_alu(control(instruction)), "result_select") ~is SimdResultSelect.Adder.packed_value()

for (instruction in VectorMaskScanInstructions, index in 0..7):
  check:
    value(control(instruction), "sequence") ~is VectorSequence.Scan.packed_value()
    value(control(instruction), "result_kind") ~is (if index < 2 | VectorResultKind.Gpr | (if index < 5 | VectorResultKind.Mask | VectorResultKind.Elements)).packed_value()
    value(field(control(instruction), "scan_control"), "index") ~is (if index == 6 | 1 | 0)
    value(field(control(instruction), "scan_control"), "packed_rows") ~is (if index < 5 | 1 | 0)
    value(field(control(instruction), "reads"), "vs2") ~is (if index == 6 | 0 | 1)
    value(field(control(instruction), "reads"), "vs1") ~is 0
    value(field(core_control(instruction), "writeback"), "enable") ~is (if index < 2 | 1 | 0)
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is 0
    value(field(core_control(instruction), "operand"), "uses_rs2") ~is 0

for (instruction in VectorMoveMergeInstructions, index in 0..6):
  check:
    value(control(instruction), "integer") ~is 1
    (value(field(control(instruction), "reads"), "v0") == VectorV0Role.Selector.packed_value()) ~is (index < 3)
    value(field(control(instruction), "reads"), "vs2") ~is (if index < 3 | 1 | 0)
    value(row_alu(control(instruction)), "result_select") ~is SimdResultSelect.Select.packed_value()
    value(control(instruction), "operand") ~is index mod 3
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is (if index mod 3 == 1 | 1 | 0)
    value(field(core_control(instruction), "writeback"), "enable") ~is 0

for (instruction in VectorWholeRegisterMoveInstructions, index in 0..4):
  check:
    value(control(instruction), "integer") ~is 1
    value(control(instruction), "sequence") ~is VectorSequence.WholeCopy.packed_value()
    value(control(instruction), "whole_register_count") ~is [1, 2, 4, 8][index]
    value(control(instruction), "operand") ~is VectorOperandMode.Vector.packed_value()
    value(row_alu(control(instruction)), "result_select") ~is SimdResultSelect.Select.packed_value()
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is 0
    value(field(core_control(instruction), "operand"), "uses_rs2") ~is 0
    value(field(core_control(instruction), "writeback"), "enable") ~is 0

for (instruction in VectorMaskLogicInstructions, index in 0..8):
  check:
    value(control(instruction), "compute_family") ~is VectorComputeFamily.IntegerData.packed_value()
    value(control(instruction), "row_layout") ~is VectorRowLayout.PackedMaskRows.packed_value()
    value(control(instruction), "result_kind") ~is VectorResultKind.Mask.packed_value()
    value(field(control(instruction), "integer_row"), "invert_logic_result") ~is (if index >= 5 | 1 | 0)
    value(row_alu(control(instruction)), "invert_right") ~is (if index == 0 || index == 4 | 1 | 0)
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is 0
    value(field(core_control(instruction), "operand"), "uses_rs2") ~is 0

for (instruction in VectorDivideInstructions, index in 0..8):
  def decoded = control(instruction)
  def care = control_pattern(instruction).care
  def operation = index div 2
  check:
    value(decoded, "multiply_divide") ~is 1
    value(decoded, "integer") ~is 0
    value(decoded, "memory") ~is 0
    value(decoded, "floating_point") ~is 0
    value(decoded, "compute_family") ~is VectorComputeFamily.IntDivide.packed_value()
    value(care, "product") ~is 0
    value(care, "left_signed") ~is 0
    value(field(decoded, "division"), "signed_mode") ~is (if [1, 3].contains(operation) | 1 | 0)
    value(care, "right_signed") ~is 0
    value(field(decoded, "division"), "remainder") ~is (if operation >= 2 | 1 | 0)
    value(decoded, "operand") ~is (if index mod 2 == 0 | VectorOperandMode.Vector.packed_value() | VectorOperandMode.Scalar.packed_value())
    value(care, "store") ~is 0
    value(decoded, "result_kind") ~is VectorResultKind.Elements.packed_value()

for (instruction in VectorMultiplyInstructions, index in 0..8):
  def decoded = control(instruction)
  def care = control_pattern(instruction).care
  def operation = index div 2
  def product = field(decoded, "product")
  def cared = field(care, "product")
  check:
    value(cared, "select") ~is 3
    value(decoded, "multiply_divide") ~is 1
    value(decoded, "compute_family") ~is VectorComputeFamily.IntProduct.packed_value()
    value(cared, "mode") ~is (if operation == 1 | 0 | 3)
    value(product, "select") ~is (if operation == 1 | SimdMultiplySelect.Low.packed_value() | SimdMultiplySelect.High.packed_value())
    value(product, "vd_role") ~is VectorProductVdRole.Unused.packed_value()
    value(cared, "vd_role") ~is 3
    value(field(decoded, "reads"), "old_vd") ~is 0
    value(cared, "subtract") ~is 0
    value(decoded, "operand") ~is (if index mod 2 == 0 | VectorOperandMode.Vector.packed_value() | VectorOperandMode.Scalar.packed_value())

  when operation != 1
  | check:
      value(field(product, "mode"), "left_signed") ~is (if operation >= 2 | 1 | 0)
      value(field(product, "mode"), "right_signed") ~is (if operation == 3 | 1 | 0)

for (instruction in VectorFractionalMultiplyInstructions, index in 0..2):
  def decoded = control(instruction)
  def care = control_pattern(instruction).care
  def product = field(decoded, "product")
  def cared = field(care, "product")
  check:
    value(cared, "select") ~is 3
    value(decoded, "multiply_divide") ~is 1
    value(decoded, "compute_family") ~is VectorComputeFamily.IntProduct.packed_value()
    value(field(product, "mode"), "left_signed") ~is 1
    value(field(product, "mode"), "right_signed") ~is 1
    value(product, "select") ~is SimdMultiplySelect.Fractional.packed_value()
    value(product, "vd_role") ~is VectorProductVdRole.Unused.packed_value()
    value(cared, "vd_role") ~is 3
    value(field(decoded, "reads"), "old_vd") ~is 0
    value(cared, "subtract") ~is 0
    value(decoded, "operand") ~is (if index == 0 | VectorOperandMode.Vector.packed_value() | VectorOperandMode.Scalar.packed_value())

for (instruction in VectorWideningMultiplyInstructions, index in 0..6):
  def decoded = control(instruction)
  def care = control_pattern(instruction).care
  def operation = index div 2
  def product = field(decoded, "product")
  def cared = field(care, "product")
  check:
    value(cared, "select") ~is 3
    value(decoded, "multiply_divide") ~is 1
    value(decoded, "compute_family") ~is VectorComputeFamily.IntProduct.packed_value()
    value(decoded, "width_shape") ~is VectorWidthShape.Widen.packed_value()
    value(field(product, "mode"), "left_signed") ~is (if operation >= 1 | 1 | 0)
    value(field(product, "mode"), "right_signed") ~is (if operation == 2 | 1 | 0)
    value(product, "select") ~is SimdMultiplySelect.Wide.packed_value()
    value(product, "vd_role") ~is VectorProductVdRole.Unused.packed_value()
    value(cared, "vd_role") ~is 3
    value(field(decoded, "reads"), "old_vd") ~is 0
    value(cared, "subtract") ~is 0
    value(decoded, "operand") ~is (if index mod 2 == 0 | VectorOperandMode.Vector.packed_value() | VectorOperandMode.Scalar.packed_value())

for (instruction in VectorMultiplyAccumulateInstructions, index in 0..8):
  def decoded = control(instruction)
  def care = control_pattern(instruction).care
  def operation = index div 2
  def product = field(decoded, "product")
  def cared = field(care, "product")
  check:
    value(cared, "select") ~is 3
    value(decoded, "multiply_divide") ~is 1
    value(decoded, "compute_family") ~is VectorComputeFamily.IntProduct.packed_value()
    value(decoded, "width_shape") ~is VectorWidthShape.Same.packed_value()
    value(product, "vd_role") ~is (if operation >= 2 | VectorProductVdRole.Factor | VectorProductVdRole.Addend).packed_value()
    value(cared, "vd_role") ~is 3
    value(field(decoded, "reads"), "old_vd") ~is 1
    value(product, "subtract") ~is (if operation mod 2 == 1 | 1 | 0)
    value(field(cared, "mode"), "left_signed") ~is 0
    value(field(cared, "mode"), "right_signed") ~is 0
    value(product, "select") ~is SimdMultiplySelect.Low.packed_value()
    value(decoded, "operand") ~is (if index mod 2 == 0 | VectorOperandMode.Vector.packed_value() | VectorOperandMode.Scalar.packed_value())

for (instruction in VectorWideningMultiplyAccumulateInstructions, index in 0..7):
  def decoded = control(instruction)
  def care = control_pattern(instruction).care
  def product = field(decoded, "product")
  def cared = field(care, "product")
  check:
    value(cared, "select") ~is 3
    value(decoded, "multiply_divide") ~is 1
    value(decoded, "compute_family") ~is VectorComputeFamily.IntProduct.packed_value()
    value(decoded, "width_shape") ~is VectorWidthShape.Widen.packed_value()
    value(product, "vd_role") ~is VectorProductVdRole.Addend.packed_value()
    value(cared, "vd_role") ~is 3
    value(field(decoded, "reads"), "old_vd") ~is 1
    value(product, "subtract") ~is 0
    value(field(product, "mode"), "left_signed") ~is (if index == 2 || index == 3 || index == 6 | 1 | 0)
    value(field(product, "mode"), "right_signed") ~is (if index >= 2 && index < 6 | 1 | 0)
    value(product, "select") ~is SimdMultiplySelect.Wide.packed_value()
    value(decoded, "operand") ~is (if index mod 2 == 0 && index < 6 | VectorOperandMode.Vector.packed_value() | VectorOperandMode.Scalar.packed_value())

def VectorFloatingPointMovementInstructions = VectorFloatingPointMoveInstructions ++ VectorFloatingPointSlideInstructions
for ([policy, examples] in [
       [VectorLocalFpResult.RawThenRound, [VFADD_VV, VFMUL_VF, VFWMACC_VV, VFREDOSUM_VS, VFWREDUSUM_VS]],
       [VectorLocalFpResult.DirectWithFlags, [VFMIN_VV, VMFLT_VF, VFREC7_V, VFNCVT_ROD_F_F_W, VFREDMIN_VS]],
       [VectorLocalFpResult.DirectNoFlags, [VFCLASS_V, VFSGNJN_VV]]]):
  for (instruction in examples):
    check value(fp(control(instruction)), "local_result") ~is policy.packed_value()
    check value(fp(control_pattern(instruction).care), "local_result") ~is 3
for (instruction in [VFDIV_VV, VFSQRT_V, VFMV_V_F, VADD_VV]):
  check value(fp(control_pattern(instruction).care), "local_result") ~is 0

def VectorFloatingPointServiceInstructions = VectorFloatingPointInstructions.filter(~keep: fun (instruction): !VectorFloatingPointMovementInstructions.contains(instruction))
check VectorFloatingPointServiceInstructions.length() ~is 95
for (instruction in VectorFloatingPointServiceInstructions):
  def decoded = control(instruction)
  def care = control_pattern(instruction).care
  def order = cond
  | [VFMADD_VV, VFMSUB_VV, VFNMADD_VV, VFNMSUB_VV, VFMADD_VF, VFMSUB_VF, VFNMADD_VF, VFNMSUB_VF].contains(instruction): VectorFpOperandOrder.VdFirst
  | [VFRSUB_VF, VFRDIV_VF, VMFGT_VF, VMFGE_VF].contains(instruction): VectorFpOperandOrder.RhsFirst
  | ~else: VectorFpOperandOrder.Vs2First
  check:
    value(decoded, "floating_point") ~is 1
    value(decoded, "fp_service") ~is 1
    value(decoded, "integer") ~is 0
    value(decoded, "memory") ~is 0
    value(field(decoded, "reads"), "vs1") ~is (if instruction.format == VectorUnaryFormat || instruction.format == VectorVFFormat | 0 | 1)
    value(decoded, "operand") ~is (if instruction.format == VectorVFFormat | VectorOperandMode.FloatingScalar.packed_value() | VectorOperandMode.Vector.packed_value())
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is 0
    value(decoded, "result_kind") ~is (if VectorFloatingPointCompareInstructions.contains(instruction) | VectorResultKind.Mask | VectorResultKind.Elements).packed_value()
    value(fp(decoded), "order") ~is order.packed_value()
    value(fp(care), "order") ~is 3
    value(decoded, "sequence") ~is (if VectorFloatingPointReductionInstructions.contains(instruction) | VectorSequence.Reduction | VectorSequence.Rows).packed_value()
    value(care, "store") ~is 0
    value(care, "result_kind") ~is 3

for (instruction in VectorFloatingPointMovementInstructions):
  def decoded = control(instruction)
  check:
    value(decoded, "floating_point") ~is 1
    value(decoded, "fp_service") ~is 0
    value(decoded, "integer") ~is 0
    value(decoded, "memory") ~is 0
    value(field(decoded, "reads"), "vs1") ~is 0
    value(decoded, "operand") ~is (if instruction == VFMV_F_S | VectorOperandMode.Vector | VectorOperandMode.FloatingScalar).packed_value()
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is 0
    value(field(core_control(instruction), "writeback"), "enable") ~is 0

check:
  value(field(control(VFMERGE_VFM), "reads"), "v0") ~is VectorV0Role.Selector.packed_value()
  value(field(control(VFMV_V_F), "reads"), "vs2") ~is 0
  value(control(VFMV_F_S), "sequence") ~is VectorSequence.Extract.packed_value()
  value(control(VFMV_F_S), "result_kind") ~is VectorResultKind.Fpr.packed_value()
  value(control(VFMV_S_F), "sequence") ~is VectorSequence.Insert.packed_value()
  value(control(VFSLIDE1UP_VF), "permutation") ~is VectorPermutationKind.SlideOneUp.packed_value()
  value(control(VFSLIDE1DOWN_VF), "permutation") ~is VectorPermutationKind.SlideOneDown.packed_value()

for (instruction in VectorFloatingPointAddSubtractInstructions):
  check value(field(fp(control(instruction)), "execution"), "unit") ~is FloatUnit.Add.packed_value()

for (instruction in VectorFloatingPointMultiplyDivideInstructions):
  check value(field(fp(control(instruction)), "execution"), "unit") ~is (if [VFMUL_VV, VFMUL_VF].contains(instruction) || VectorWideningFloatingPointMultiplyInstructions.contains(instruction) | FloatUnit.Multiply | FloatUnit.DivideSquareRoot).packed_value()

for (instruction in VectorFloatingPointAddSubtractInstructions ++ VectorFloatingPointMultiplyDivideInstructions):
  check value(field(fp(control(instruction)), "execution"), "uses_rounding_mode") ~is 1

for (instruction in VectorFloatingPointReductionInstructions):
  def execution = field(fp(control(instruction)), "execution")
  check:
    value(control(instruction), "sequence") ~is VectorSequence.Reduction.packed_value()
    value(execution, "unit") ~is (if [VFREDMIN_VS, VFREDMAX_VS].contains(instruction) | FloatUnit.MinMax | FloatUnit.Add).packed_value()
    value(execution, "uses_rounding_mode") ~is (if [VFREDMIN_VS, VFREDMAX_VS].contains(instruction) | 0 | 1)
    value(field(core_control(instruction), "writeback"), "enable") ~is 0

check:
  value(field(fp(control(VFSUB_VV)), "execution"), "add_operation") ~is FloatAddOperation.Subtract.packed_value()
  value(field(fp(control(VFSQRT_V)), "execution"), "divide_operation") ~is FloatDivideOperation.SquareRoot.packed_value()
  value(field(fp(control(VFRSQRT7_V)), "execution"), "unit") ~is FloatUnit.Estimate.packed_value()
  value(field(fp(control(VFRSQRT7_V)), "execution"), "estimate_operation") ~is Estimate7Operation.ReciprocalSquareRoot.packed_value()
  value(field(fp(control(VFREC7_V)), "execution"), "unit") ~is FloatUnit.Estimate.packed_value()
  value(field(fp(control(VFREC7_V)), "execution"), "uses_rounding_mode") ~is 1
  value(field(fp(control(VFCLASS_V)), "execution"), "unit") ~is FloatUnit.Classify.packed_value()
  value(fp(control(VFCLASS_V)), "result") ~is VectorFloatResult.Integer.packed_value()
  value(field(fp(control(VMFNE_VV)), "execution"), "comparison") ~is FloatComparison.NotEqual.packed_value()
  value(field(fp(control(VMFLT_VV)), "execution"), "comparison_signaling") ~is 1

for (instruction in VectorFloatingPointSignInjectInstructions, index in 0..6):
  def operation = [FloatSignOperation.Copy, FloatSignOperation.Negate, FloatSignOperation.Xor][index mod 3]
  check value(field(fp(control(instruction)), "execution"), "sign_operation") ~is operation.packed_value()

for (instruction in VectorFloatingPointMinMaxInstructions ++ [VFREDMIN_VS, VFREDMAX_VS], index in 0..6):
  def operation = [MinMaxOperation.MinimumNumber, MinMaxOperation.MaximumNumber][index mod 2]
  check value(field(fp(control(instruction)), "execution"), "minmax_operation") ~is operation.packed_value()

for (instruction in VectorFloatingPointFusedMultiplyAddInstructions):
  def execution = field(fp(control(instruction)), "execution")
  def operation = cond
  | [VFMSAC_VV, VFMSUB_VV, VFMSAC_VF, VFMSUB_VF, VFWMSAC_VV, VFWMSAC_VF].contains(instruction): MulAddOperation.MultiplySubtract
  | [VFNMACC_VV, VFNMADD_VV, VFNMACC_VF, VFNMADD_VF, VFWNMACC_VV, VFWNMACC_VF].contains(instruction): MulAddOperation.NegatedMultiplySubtract
  | [VFNMSAC_VV, VFNMSUB_VV, VFNMSAC_VF, VFNMSUB_VF, VFWNMSAC_VV, VFWNMSAC_VF].contains(instruction): MulAddOperation.NegatedMultiplyAdd
  | ~else: MulAddOperation.MultiplyAdd

  check:
    value(execution, "unit") ~is FloatUnit.FusedMultiplyAdd.packed_value()
    value(execution, "fused_operation") ~is operation.packed_value()

for (instruction in VectorWideningFloatingPointAddSubtractInstructions ++ VectorWideningFloatingPointMultiplyInstructions ++ VectorWideningFloatingPointFusedMultiplyAddInstructions ++ VectorWideningFloatingPointReductionInstructions):
  check:
    value(control(instruction), "width_shape") ~is (if [VFWADD_WV, VFWADD_WF, VFWSUB_WV, VFWSUB_WF].contains(instruction) | VectorWidthShape.WidenWideVs2 | VectorWidthShape.Widen).packed_value()

for (instruction in [VFWSUB_VV, VFWSUB_VF, VFWSUB_WV, VFWSUB_WF]):
  check value(field(fp(control(instruction)), "execution"), "add_operation") ~is FloatAddOperation.Subtract.packed_value()

def VectorIntegerToFloatingConversions = [VFCVT_F_XU_V, VFCVT_F_X_V, VFWCVT_F_XU_V, VFWCVT_F_X_V, VFNCVT_F_XU_W, VFNCVT_F_X_W]
def VectorFloatingResultConversions = VectorIntegerToFloatingConversions ++ [VFWCVT_F_F_V, VFNCVT_F_F_W, VFNCVT_ROD_F_F_W]
def VectorRtzConversions = [VFCVT_RTZ_XU_F_V, VFCVT_RTZ_X_F_V, VFWCVT_RTZ_XU_F_V, VFWCVT_RTZ_X_F_V, VFNCVT_RTZ_XU_F_W, VFNCVT_RTZ_X_F_W]
def VectorUnsignedConversions = [VFCVT_XU_F_V, VFCVT_F_XU_V, VFCVT_RTZ_XU_F_V, VFWCVT_XU_F_V, VFWCVT_F_XU_V, VFWCVT_RTZ_XU_F_V, VFNCVT_XU_F_W, VFNCVT_F_XU_W, VFNCVT_RTZ_XU_F_W]
def VectorWideningFloatingPointConversions = [VFWCVT_XU_F_V, VFWCVT_X_F_V, VFWCVT_F_XU_V, VFWCVT_F_X_V, VFWCVT_F_F_V, VFWCVT_RTZ_XU_F_V, VFWCVT_RTZ_X_F_V]
def VectorNarrowingFloatingPointConversions = [VFNCVT_XU_F_W, VFNCVT_X_F_W, VFNCVT_F_XU_W, VFNCVT_F_X_W, VFNCVT_F_F_W, VFNCVT_ROD_F_F_W, VFNCVT_RTZ_XU_F_W, VFNCVT_RTZ_X_F_W]
for (instruction in VectorFloatingPointConversionInstructions):
  def decoded = control(instruction)
  def execution = field(fp(decoded), "execution")
  def fixed_rounding = VectorRtzConversions.contains(instruction) || instruction == VFNCVT_ROD_F_F_W
  check:
    value(execution, "unit") ~is FloatUnit.Convert.packed_value()
    value(fp(decoded), "source") ~is (if VectorIntegerToFloatingConversions.contains(instruction) | VectorFloatSource.Integer | VectorFloatSource.Floating).packed_value()
    value(fp(decoded), "result") ~is (if VectorFloatingResultConversions.contains(instruction) | VectorFloatResult.Floating | VectorFloatResult.Integer).packed_value()
    value(fp(decoded), "rounding") ~is (if instruction == VFNCVT_ROD_F_F_W | VectorFloatRounding.RoundToOdd | (if VectorRtzConversions.contains(instruction) | VectorFloatRounding.TowardZero | VectorFloatRounding.Dynamic)).packed_value()
    value(decoded, "width_shape") ~is (if VectorWideningFloatingPointConversions.contains(instruction) | VectorWidthShape.Widen | (if VectorNarrowingFloatingPointConversions.contains(instruction) | VectorWidthShape.Narrow | VectorWidthShape.Same)).packed_value()
    value(execution, "uses_rounding_mode") ~is (if fixed_rounding | 0 | 1)
    value(execution, "integer_unsigned") ~is (if VectorUnsignedConversions.contains(instruction) | 1 | 0)

for (instruction in VectorIntegerInstructions):
  def decoded = control(instruction)
  def expected_operand = cond
  | [VectorVVFormat, VectorFixedVVFormat].contains(instruction.format): VectorOperandMode.Vector
  | [VectorVXFormat, VectorFixedVXFormat].contains(instruction.format): VectorOperandMode.Scalar
  | ~else: VectorOperandMode.Immediate

  check:
    value(decoded, "integer") ~is 1
    value(decoded, "memory") ~is 0
    value(decoded, "configure") ~is VectorConfigMode.None.packed_value()
    value(decoded, "operand") ~is expected_operand.packed_value()

  when instruction.format.immediate
  | check:
      value(decoded, "immediate_kind") ~is (if instruction.format.immediate.signed | VectorImmediateKind.Signed5 | VectorImmediateKind.Unsigned5).packed_value()

for (row in VectorMemoryCases):
  check:
    value(row.output.care, "fp_service") ~is 1
    value(row.output.value, "fp_service") ~is 0

for (instructions in [VectorUnitStrideMemoryInstructions, VectorStridedMemoryInstructions], addressing in [VectorMemoryAddressing.UnitStride, VectorMemoryAddressing.Strided]):
  for (instruction in instructions, index in 0..8):
    def decoded = control(instruction)
    check:
      value(decoded, "integer") ~is 0
      value(decoded, "memory") ~is 1
      value(decoded, "store") ~is (if index >= 4 | 1 | 0)
      value(decoded, "memory_mode") ~is VectorMemoryMode.Ordinary.packed_value()
      value(decoded, "memory_data_eew") ~is index mod 4
      value(decoded, "memory_addressing") ~is addressing.packed_value()
      value(field(core_control(instruction), "operand"), "uses_rs1") ~is 1
      value(field(core_control(instruction), "operand"), "uses_rs2") ~is (if addressing == VectorMemoryAddressing.Strided | 1 | 0)

for (instructions in [VectorIndexedUnorderedMemoryInstructions, VectorIndexedOrderedMemoryInstructions], addressing in [VectorMemoryAddressing.IndexedUnordered, VectorMemoryAddressing.IndexedOrdered]):
  for (instruction in instructions, index in 0..8):
    def decoded = control(instruction)
    check:
      value(decoded, "integer") ~is 0
      value(decoded, "memory") ~is 1
      value(decoded, "store") ~is (if index >= 4 | 1 | 0)
      value(decoded, "memory_mode") ~is VectorMemoryMode.Ordinary.packed_value()
      value(decoded, "memory_index_eew") ~is index mod 4
      value(decoded, "memory_addressing") ~is addressing.packed_value()
      value(decoded, "operand") ~is VectorOperandMode.Vector.packed_value()
      value(field(core_control(instruction), "operand"), "uses_rs1") ~is 1
      value(field(core_control(instruction), "operand"), "uses_rs2") ~is 0

for (instructions in [VectorUnitStrideSegmentMemoryInstructions, VectorStridedSegmentMemoryInstructions], addressing in [VectorMemoryAddressing.UnitStride, VectorMemoryAddressing.Strided]):
  for (instruction in instructions, index in 0..56):
    def decoded = control(instruction)
    check:
      value(decoded, "integer") ~is 0
      value(decoded, "memory") ~is 1
      value(decoded, "store") ~is (if index >= 28 | 1 | 0)
      value(decoded, "memory_mode") ~is VectorMemoryMode.Ordinary.packed_value()
      value(decoded, "memory_data_eew") ~is index mod 4
      value(decoded, "memory_nf") ~is ((index mod 28) div 4) + 1
      value(decoded, "memory_addressing") ~is addressing.packed_value()
      value(field(core_control(instruction), "operand"), "uses_rs1") ~is 1
      value(field(core_control(instruction), "operand"), "uses_rs2") ~is (if addressing == VectorMemoryAddressing.Strided | 1 | 0)

for (instructions in [VectorIndexedUnorderedSegmentMemoryInstructions, VectorIndexedOrderedSegmentMemoryInstructions], addressing in [VectorMemoryAddressing.IndexedUnordered, VectorMemoryAddressing.IndexedOrdered]):
  for (instruction in instructions, index in 0..56):
    def decoded = control(instruction)
    check:
      value(decoded, "integer") ~is 0
      value(decoded, "memory") ~is 1
      value(decoded, "store") ~is (if index >= 28 | 1 | 0)
      value(decoded, "memory_mode") ~is VectorMemoryMode.Ordinary.packed_value()
      value(decoded, "memory_index_eew") ~is index mod 4
      value(decoded, "memory_nf") ~is ((index mod 28) div 4) + 1
      value(decoded, "memory_addressing") ~is addressing.packed_value()
      value(decoded, "operand") ~is VectorOperandMode.Vector.packed_value()
      value(field(core_control(instruction), "operand"), "uses_rs1") ~is 1
      value(field(core_control(instruction), "operand"), "uses_rs2") ~is 0

for (instruction in VectorFaultOnlyFirstLoadInstructions, index in 0..32):
  def decoded = control(instruction)
  check:
    value(decoded, "integer") ~is 0
    value(decoded, "memory") ~is 1
    value(decoded, "store") ~is 0
    value(decoded, "memory_mode") ~is VectorMemoryMode.FaultOnlyFirst.packed_value()
    value(decoded, "memory_data_eew") ~is index mod 4
    value(decoded, "memory_nf") ~is (if index < 4 | 0 | ((index - 4) div 4) + 1)
    value(decoded, "memory_addressing") ~is VectorMemoryAddressing.UnitStride.packed_value()
    value(decoded, "operand") ~is VectorOperandMode.Scalar.packed_value()
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is 1
    value(field(core_control(instruction), "operand"), "uses_rs2") ~is 0

for (instruction in VectorWholeRegisterMemoryInstructions, index in 0..20):
  def decoded = control(instruction)
  def register_index = if index < 16 | index div 4 | index - 16
  check:
    value(decoded, "integer") ~is 0
    value(decoded, "memory") ~is 1
    value(decoded, "store") ~is (if index >= 16 | 1 | 0)
    value(decoded, "memory_mode") ~is VectorMemoryMode.WholeRegister.packed_value()
    value(decoded, "memory_data_eew") ~is (if index < 16 | index mod 4 | 0)
    value(decoded, "memory_nf") ~is [0, 1, 3, 7][register_index]
    value(decoded, "memory_addressing") ~is VectorMemoryAddressing.UnitStride.packed_value()
    value(decoded, "operand") ~is VectorOperandMode.Scalar.packed_value()
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is 1
    value(field(core_control(instruction), "operand"), "uses_rs2") ~is 0

for (instruction in VectorMaskMemoryInstructions, index in 0..2):
  def decoded = control(instruction)
  check:
    value(decoded, "integer") ~is 0
    value(decoded, "memory") ~is 1
    value(decoded, "store") ~is (if index == 1 | 1 | 0)
    value(decoded, "memory_mode") ~is VectorMemoryMode.Mask.packed_value()
    value(decoded, "memory_data_eew") ~is 0
    value(decoded, "memory_nf") ~is 0
    value(decoded, "memory_addressing") ~is VectorMemoryAddressing.UnitStride.packed_value()
    value(decoded, "operand") ~is VectorOperandMode.Scalar.packed_value()
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is 1
    value(field(core_control(instruction), "operand"), "uses_rs2") ~is 0

for (vlen in [128, 256, 512, 65536]):
  def micro = VectorMicroOp(XLen.X64, vlen, Bits(4))
  def feedback = VectorFeedback(XLen.X64, vlen, Bits(4))
  def beat = micro.field("beat").type
  check:
    beat.field("left").type.packed_width() ~is 64
    beat.field("right").type.packed_width() ~is 64
    beat.field("address").type.packed_width() ~is 64
    beat.field("carry_in").type.packed_width() ~is 8
    beat.field("fp_source_width").type ~is SimdElementWidth
    beat.field("fp_result_width").type ~is SimdElementWidth
    micro.field("context").type.packed_width() ~is 4
    feedback.field("context").type.packed_width() ~is 4
    (1 bits.(<<) beat.field("end").type.packed_width()) > vlen ~is #true
    beat.field("end").type.packed_width() ~is feedback.field("end").type.packed_width()
    beat.field("destination_first").type.packed_width() ~is beat.field("end").type.packed_width()
    beat.field("sequence").type.packed_width() ~is vector_sequence_width(vlen)
    feedback.field("sequence").type.packed_width() ~is beat.field("sequence").type.packed_width()
    beat.field("compress_destination").type.packed_width() ~is beat.field("end").type.packed_width()
    feedback.field("compress_state").type.field("destination").type.packed_width() ~is beat.field("end").type.packed_width()
