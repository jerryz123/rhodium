#lang rhombus
// Checks vector controls including extension, rounding/clipping, inactive care masks, and widths.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../riscv/isa/v.rhm" open
  "../../../riscv/isa/zvbb.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/rtl/floating-point.rhdl".FloatSignOperation
  "../decode/vector-ctrl.rhdl" open
  "../decode/core-ctrl.rhdl" open
  "../decode/writeback-ctrl.rhdl".RV5StageWritebackSelect
  "../fp/types.rhdl" open
  "../vector/bundles.rhdl" open
  "../../simd-alu.rhdl" open
  "../../../rhodium/core/main.rhm" open
  "../../../rhodium/frontend/support/hardware-literal.rhm".PackedLiteral
  lib("hardfloat/main.rhdl").MulAddOperation
  lib("hardfloat/main.rhdl").MinMaxOperation
  lib("hardfloat/main.rhdl").Estimate7Operation

fun field(record, name):
  def mutable offset = record.literal_type().packed_width()
  def mutable selected = #false
  for (entry in record.literal_type().fields):
    def end = offset
    offset := offset - entry.type.packed_width()
    when entry.name == name
    | selected := PackedLiteral(entry.type, bits.field(record.packed_value(), offset, end))
  selected
fun value(record, name):
  field(record, name).packed_value()
fun control_pattern(instruction):
  VectorControlCases.find(fun (row): row.input.value_bits == instruction.encoding.value && row.input.care_bits == instruction.encoding.care).output
fun control(instruction):
  control_pattern(instruction).value
fun zvbb_control(instruction):
  VectorZvbbCases.find(fun (row): row.input.value_bits == instruction.encoding.value && row.input.care_bits == instruction.encoding.care).output.value
fun core_control(instruction):
  VectorCoreControlCases.find(fun (row): row.input.value_bits == instruction.encoding.value && row.input.care_bits == instruction.encoding.care).output.value
fun zvbb_core_control(instruction):
  VectorZvbbCoreControlCases.find(fun (row): row.input.value_bits == instruction.encoding.value && row.input.care_bits == instruction.encoding.care).output.value

check:
  value(control(VMV_X_S), "scalar_destination") ~is 1
  value(control(VFWCVT_F_F_V), "fp_zvfhmin_e16") ~is 1
  value(control(VFNCVT_F_F_W), "fp_zvfhmin_e16") ~is 1
  value(control(VFWCVT_XU_F_V), "fp_zvfhmin_e16") ~is 0
  value(control(VFWCVT_F_XU_V), "fp_zvfh_e8") ~is 1
  value(control(VFNCVT_XU_F_W), "fp_zvfh_e8") ~is 1
  value(control(VMV_S_X), "element_move") ~is 1
  value(field(core_control(VMV_X_S), "writeback"), "enable") ~is 1
  value(field(core_control(VMV_X_S), "writeback"), "source") ~is RV5StageWritebackSelect.Vector.packed_value()
  value(field(core_control(VMV_S_X), "operand"), "uses_rs1") ~is 1
  value(field(core_control(VMV_X_S), "operand"), "uses_rs1") ~is 0
  VectorControlCases.length() ~is VectorVInstructions.length()
  VectorCoreControlCases.length() ~is VectorVInstructions.length()
  VectorZvbbCases.length() ~is ZvbbInstructions.length()
  VectorZvbbCoreControlCases.length() ~is ZvbbInstructions.length()
  value(control(VSETVLI), "configure") ~is VectorConfigMode.VtypeImmediate.packed_value()
  value(control(VSETIVLI), "configure") ~is VectorConfigMode.AllImmediate.packed_value()
  value(control(VSETVL), "configure") ~is VectorConfigMode.VtypeRegister.packed_value()
  value(field(control(VSUB_VV), "alu"), "subtract") ~is 1
  value(control(VRSUB_VX), "swap_operands") ~is 1
  value(control(VRSUB_VI), "swap_operands") ~is 1
  value(field(control(VRSUB_VI), "alu"), "subtract") ~is 1
  value(field(control(VADD_VX), "alu"), "subtract") ~is 0
  value(field(control(VSADDU_VI), "alu"), "arithmetic_mode") ~is SimdArithmeticMode.SaturateUnsigned.packed_value()
  value(field(control(VSADD_VV), "alu"), "arithmetic_mode") ~is SimdArithmeticMode.SaturateSigned.packed_value()
  value(field(control(VSSUBU_VX), "alu"), "subtract") ~is 1
  value(field(control(VSSUB_VV), "alu"), "arithmetic_mode") ~is SimdArithmeticMode.SaturateSigned.packed_value()
  value(field(control(VAADDU_VV), "alu"), "arithmetic_mode") ~is SimdArithmeticMode.AverageUnsigned.packed_value()
  value(field(control(VAADD_VX), "alu"), "arithmetic_mode") ~is SimdArithmeticMode.AverageSigned.packed_value()
  value(field(control(VASUBU_VV), "alu"), "subtract") ~is 1
  value(control(VASUB_VX), "rounding") ~is 1
  value(control(VWADDU_VV), "widening") ~is 1
  value(control(VWADDU_VV), "left_signed") ~is 0
  value(control(VWADD_VX), "right_signed") ~is 1
  value(field(control(VWSUBU_VV), "alu"), "subtract") ~is 1
  value(field(control(VWADD_VV), "alu"), "subtract") ~is 0
  value(control(VWADDU_WV), "wide_vs2") ~is 1
  value(control(VWADDU_WV), "left_signed") ~is 0
  value(control(VWADD_WX), "right_signed") ~is 1
  value(field(control(VWSUBU_WV), "alu"), "subtract") ~is 1
  value(field(control(VWADD_WV), "alu"), "subtract") ~is 0
  value(control(VNSRL_WV), "narrowing") ~is 1
  value(control(VNSRL_WV), "wide_vs2") ~is 1
  value(field(control(VNSRL_WI), "alu"), "shift_right") ~is 1
  value(field(control(VNSRL_WI), "alu"), "arithmetic_shift") ~is 0
  value(field(control(VNSRA_WX), "alu"), "arithmetic_shift") ~is 1
  value(control(VSSRL_VV), "rounding") ~is 1
  value(control(VSSRL_VV), "narrowing") ~is 0
  value(field(control(VSSRA_VI), "alu"), "arithmetic_shift") ~is 1
  value(control(VNCLIPU_WV), "rounding") ~is 1
  value(control(VNCLIPU_WV), "narrowing") ~is 1
  value(control(VNCLIPU_WV), "clip") ~is 1
  value(control(VNCLIPU_WV), "clip_unsigned") ~is 1
  value(control(VNCLIP_WX), "clip_unsigned") ~is 0
  value(field(control(VAND_VI), "alu"), "logic_select") ~is SimdLogicSelect.And.packed_value()
  value(field(control(VOR_VV), "alu"), "logic_select") ~is SimdLogicSelect.Or.packed_value()
  value(field(control(VXOR_VX), "alu"), "logic_select") ~is SimdLogicSelect.Xor.packed_value()
  value(field(control(VSLL_VI), "alu"), "shift_right") ~is 0
  value(field(control(VSRL_VI), "alu"), "arithmetic_shift") ~is 0
  value(field(control(VSRA_VI), "alu"), "arithmetic_shift") ~is 1
  value(control(VMSNE_VV), "invert_comparison") ~is 1
  value(control(VMSGT_VI), "swap_operands") ~is 1
  value(field(control(VMSLEU_VV), "alu"), "comparison_select") ~is SimdComparisonSelect.LessEqual.packed_value()
  value(field(control(VMSLT_VV), "alu"), "signed_compare") ~is 1
  value(field(control(VMAX_VV), "alu"), "maximum") ~is 1
  value(field(control(VMINU_VX), "alu"), "maximum") ~is 0
  value(control(VCOMPRESS_VM), "compress") ~is 1
  value(control(VCOMPRESS_VM), "operand") ~is VectorOperandMode.Vector.packed_value()
  value(field(core_control(VCOMPRESS_VM), "operand"), "uses_rs1") ~is 0
  value(field(core_control(VCOMPRESS_VM), "writeback"), "enable") ~is 0
  value(field(zvbb_control(VANDN_VV), "alu"), "logic_select") ~is SimdLogicSelect.And.packed_value()
  value(field(zvbb_control(VANDN_VV), "alu"), "invert_right") ~is 1
  value(field(zvbb_control(VBREV_V), "alu"), "permutation_select") ~is SimdPermutationSelect.ReverseBits.packed_value()
  value(field(zvbb_control(VBREV8_V), "alu"), "permutation_select") ~is SimdPermutationSelect.ReverseBitsInBytes.packed_value()
  value(field(zvbb_control(VREV8_V), "alu"), "permutation_select") ~is SimdPermutationSelect.ReverseBytes.packed_value()
  value(field(zvbb_control(VCLZ_V), "alu"), "count_select") ~is SimdCountSelect.LeadingZeros.packed_value()
  value(field(zvbb_control(VCTZ_V), "alu"), "count_select") ~is SimdCountSelect.TrailingZeros.packed_value()
  value(field(zvbb_control(VCPOP_V), "alu"), "count_select") ~is SimdCountSelect.Population.packed_value()
  value(field(zvbb_control(VROL_VV), "alu"), "shift_right") ~is 0
  value(field(zvbb_control(VROL_VV), "alu"), "rotate") ~is 1
  value(field(zvbb_control(VROR_VX), "alu"), "shift_right") ~is 1
  value(field(zvbb_control(VROR_VX), "alu"), "rotate") ~is 1
  value(zvbb_control(VROR_VI), "immediate_kind") ~is VectorImmediateKind.Unsigned6.packed_value()
  value(zvbb_control(VWSLL_VI), "immediate_kind") ~is VectorImmediateKind.Unsigned5.packed_value()
  value(zvbb_control(VWSLL_VV), "widening") ~is 1
  value(field(zvbb_core_control(VANDN_VX), "operand"), "uses_rs1") ~is 1
  value(field(zvbb_core_control(VBREV_V), "operand"), "uses_rs1") ~is 0

for (instruction in VectorCarryBorrowInstructions, index in 0..15):
  def decoded = control(instruction)
  def form = instruction.format
  def carry_input = index < 6 || (index >= 9 && index < 13)
  def mask_destination = (index >= 3 && index < 9) || index >= 11
  check:
    value(decoded, "integer") ~is 1
    value(decoded, "carry_input") ~is (if carry_input | 1 | 0)
    value(decoded, "mask_destination") ~is (if mask_destination | 1 | 0)
    value(field(decoded, "alu"), "result_select") ~is SimdResultSelect.Adder.packed_value()
    value(field(decoded, "alu"), "mask_result_select") ~is SimdMaskResultSelect.CarryBorrow.packed_value()
    value(field(decoded, "alu"), "subtract") ~is (if index >= 9 | 1 | 0)
    value(decoded, "operand") ~is (if form == VectorFixedVVFormat | VectorOperandMode.Vector.packed_value() | (if form == VectorFixedVXFormat | VectorOperandMode.Scalar.packed_value() | VectorOperandMode.Immediate.packed_value()))
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is (if form == VectorFixedVXFormat | 1 | 0)
    value(field(core_control(instruction), "writeback"), "enable") ~is 0

for (instruction in VectorExtensionInstructions, index in 0..6):
  def decoded = control(instruction)
  check:
    value(decoded, "integer") ~is 1
    value(decoded, "extension") ~is 1
    value(decoded, "extension_ratio") ~is (index mod 3)
    value(decoded, "extension_signed") ~is (if index >= 3 | 1 | 0)
    value(decoded, "operand") ~is VectorOperandMode.Immediate.packed_value()
    value(field(decoded, "alu"), "result_select") ~is SimdResultSelect.Select.packed_value()
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is 0
    value(field(core_control(instruction), "operand"), "uses_rs2") ~is 0
    value(field(core_control(instruction), "writeback"), "enable") ~is 0

for (instruction in VectorGatherInstructions, index in 0..4):
  check:
    value(control(instruction), "gather") ~is 1
    value(control(instruction), "gather_index16") ~is (if index == 1 | 1 | 0)
    value(control(instruction), "operand") ~is (if index < 2 | VectorOperandMode.Vector.packed_value() | (if index == 2 | VectorOperandMode.Scalar.packed_value() | VectorOperandMode.Immediate.packed_value()))
    value(field(control(instruction), "alu"), "rotate") ~is 1
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is (if index == 2 | 1 | 0)
    value(field(core_control(instruction), "writeback"), "enable") ~is 0
for (instruction in VectorSlideInstructions, index in 0..6):
  check:
    value(control(instruction), "slide") ~is 1
    value(control(instruction), "slide_up") ~is (if [0, 1, 4].contains(index) | 1 | 0)
    value(control(instruction), "slide_one") ~is (if index >= 4 | 1 | 0)
    value(control(instruction), "operand") ~is (if [1, 3].contains(index) | VectorOperandMode.Immediate.packed_value() | VectorOperandMode.Scalar.packed_value())
    value(field(control(instruction), "alu"), "result_select") ~is SimdResultSelect.Shift.packed_value()
    value(field(control(instruction), "alu"), "rotate") ~is 1
    value(field(control(instruction), "alu"), "shift_right") ~is 1
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is (if [1, 3].contains(index) | 0 | 1)
    value(field(core_control(instruction), "operand"), "uses_rs2") ~is 0
    value(field(core_control(instruction), "writeback"), "enable") ~is 0
for (instruction in VectorIntegerReductionInstructions):
  check:
    value(control(instruction), "reduction") ~is 1
    value(field(core_control(instruction), "writeback"), "enable") ~is 0
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is 0
for (instruction in VectorWideningIntegerReductionInstructions, index in 0..2):
  check:
    value(control(instruction), "widening") ~is 1
    value(control(instruction), "right_signed") ~is index
    value(field(control(instruction), "alu"), "result_select") ~is SimdResultSelect.Adder.packed_value()
for (instruction in VectorMaskScanInstructions, index in 0..7):
  check:
    value(control(instruction), "scan") ~is 1
    value(control(instruction), "scalar_destination") ~is (if index < 2 | 1 | 0)
    value(control(instruction), "mask_destination") ~is (if index >= 2 && index < 5 | 1 | 0)
    value(field(control(instruction), "scan_control"), "index") ~is (if index == 6 | 1 | 0)
    value(field(core_control(instruction), "writeback"), "enable") ~is (if index < 2 | 1 | 0)
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is 0
    value(field(core_control(instruction), "operand"), "uses_rs2") ~is 0
for (instruction in VectorMoveMergeInstructions, index in 0..6):
  check:
    value(control(instruction), "integer") ~is 1
    value(control(instruction), "mask_select") ~is (if index < 3 | 1 | 0)
    value(control(instruction), "uses_vs2") ~is (if index < 3 | 1 | 0)
    value(field(control(instruction), "alu"), "result_select") ~is SimdResultSelect.Select.packed_value()
    value(control(instruction), "operand") ~is index mod 3
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is (if index mod 3 == 1 | 1 | 0)
    value(field(core_control(instruction), "writeback"), "enable") ~is 0

for (instruction in VectorWholeRegisterMoveInstructions, index in 0..4):
  check:
    value(control(instruction), "integer") ~is 1
    value(control(instruction), "whole_register_move") ~is 1
    value(control(instruction), "whole_register_count") ~is [1, 2, 4, 8][index]
    value(control(instruction), "operand") ~is VectorOperandMode.Vector.packed_value()
    value(field(control(instruction), "alu"), "result_select") ~is SimdResultSelect.Select.packed_value()
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is 0
    value(field(core_control(instruction), "operand"), "uses_rs2") ~is 0
    value(field(core_control(instruction), "writeback"), "enable") ~is 0

for (instruction in VectorMaskLogicInstructions, index in 0..8):
  check:
    value(control(instruction), "mask_logic") ~is 1
    value(control(instruction), "mask_destination") ~is 1
    value(control(instruction), "invert_logic_result") ~is (if index >= 5 | 1 | 0)
    value(field(control(instruction), "alu"), "invert_right") ~is (if index == 0 || index == 4 | 1 | 0)
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is 0
    value(field(core_control(instruction), "operand"), "uses_rs2") ~is 0

for (instruction in VectorDivideInstructions, index in 0..8):
  def decoded = control(instruction)
  def care = control_pattern(instruction).care
  def operation = index div 2
  check:
    value(decoded, "multiply_divide") ~is 1
    value(decoded, "integer") ~is 0
    value(decoded, "memory") ~is 0
    value(decoded, "floating_point") ~is 0
    value(decoded, "divide") ~is 1
    value(decoded, "multiply_accumulate") ~is 0
    value(decoded, "left_signed") ~is (if [1, 3].contains(operation) | 1 | 0)
    value(decoded, "right_signed") ~is (if [1, 3].contains(operation) | 1 | 0)
    value(decoded, "remainder") ~is (if operation >= 2 | 1 | 0)
    value(decoded, "operand") ~is (if index mod 2 == 0 | VectorOperandMode.Vector.packed_value() | VectorOperandMode.Scalar.packed_value())
    value(care, "store") ~is 0
    value(care, "mask_destination") ~is 0

for (instruction in VectorMultiplyInstructions, index in 0..8):
  def decoded = control(instruction)
  def care = control_pattern(instruction).care
  def operation = index div 2
  check:
    value(decoded, "multiply_divide") ~is 1
    value(decoded, "divide") ~is 0
    value(decoded, "left_signed") ~is (if operation >= 2 | 1 | 0)
    value(decoded, "right_signed") ~is (if operation == 3 | 1 | 0)
    value(decoded, "multiply_result") ~is (if operation == 1 | VectorMultiplyResult.Low.packed_value() | VectorMultiplyResult.High.packed_value())
    value(decoded, "multiply_accumulate") ~is 0
    value(care, "multiply_destination") ~is 0
    value(care, "multiply_subtract") ~is 0
    value(decoded, "operand") ~is (if index mod 2 == 0 | VectorOperandMode.Vector.packed_value() | VectorOperandMode.Scalar.packed_value())

for (instruction in VectorFractionalMultiplyInstructions, index in 0..2):
  def decoded = control(instruction)
  def care = control_pattern(instruction).care
  check:
    value(decoded, "multiply_divide") ~is 1
    value(decoded, "divide") ~is 0
    value(decoded, "left_signed") ~is 1
    value(decoded, "right_signed") ~is 1
    value(decoded, "multiply_result") ~is VectorMultiplyResult.Fractional.packed_value()
    value(decoded, "multiply_accumulate") ~is 0
    value(care, "multiply_destination") ~is 0
    value(care, "multiply_subtract") ~is 0
    value(decoded, "operand") ~is (if index == 0 | VectorOperandMode.Vector.packed_value() | VectorOperandMode.Scalar.packed_value())

for (instruction in VectorWideningMultiplyInstructions, index in 0..6):
  def decoded = control(instruction)
  def care = control_pattern(instruction).care
  def operation = index div 2
  check:
    value(decoded, "multiply_divide") ~is 1
    value(decoded, "divide") ~is 0
    value(decoded, "widening") ~is 1
    value(decoded, "left_signed") ~is (if operation >= 1 | 1 | 0)
    value(decoded, "right_signed") ~is (if operation == 2 | 1 | 0)
    value(decoded, "multiply_result") ~is VectorMultiplyResult.Widened.packed_value()
    value(decoded, "multiply_accumulate") ~is 0
    value(care, "multiply_destination") ~is 0
    value(care, "multiply_subtract") ~is 0
    value(decoded, "operand") ~is (if index mod 2 == 0 | VectorOperandMode.Vector.packed_value() | VectorOperandMode.Scalar.packed_value())

for (instruction in VectorMultiplyAccumulateInstructions, index in 0..8):
  def decoded = control(instruction)
  def care = control_pattern(instruction).care
  def operation = index div 2
  check:
    value(decoded, "multiply_divide") ~is 1
    value(decoded, "divide") ~is 0
    value(decoded, "widening") ~is 0
    value(decoded, "multiply_accumulate") ~is 1
    value(decoded, "multiply_destination") ~is (if operation >= 2 | 1 | 0)
    value(decoded, "multiply_subtract") ~is (if operation mod 2 == 1 | 1 | 0)
    value(care, "left_signed") ~is 0
    value(care, "right_signed") ~is 0
    value(care, "multiply_result") ~is 0
    value(decoded, "operand") ~is (if index mod 2 == 0 | VectorOperandMode.Vector.packed_value() | VectorOperandMode.Scalar.packed_value())

for (instruction in VectorWideningMultiplyAccumulateInstructions, index in 0..7):
  def decoded = control(instruction)
  def care = control_pattern(instruction).care
  check:
    value(decoded, "multiply_divide") ~is 1
    value(decoded, "divide") ~is 0
    value(decoded, "widening") ~is 1
    value(decoded, "multiply_accumulate") ~is 1
    value(decoded, "multiply_destination") ~is 0
    value(decoded, "multiply_subtract") ~is 0
    value(decoded, "left_signed") ~is (if index == 2 || index == 3 || index == 6 | 1 | 0)
    value(decoded, "right_signed") ~is (if index >= 2 && index < 6 | 1 | 0)
    value(care, "multiply_result") ~is 0
    value(decoded, "operand") ~is (if index mod 2 == 0 && index < 6 | VectorOperandMode.Vector.packed_value() | VectorOperandMode.Scalar.packed_value())

def VectorFloatingPointMovementInstructions = VectorFloatingPointMoveInstructions ++ VectorFloatingPointSlideInstructions
def VectorFloatingPointServiceInstructions = VectorFloatingPointInstructions.filter(~keep: fun (instruction): !VectorFloatingPointMovementInstructions.contains(instruction))
for (instruction in VectorFloatingPointServiceInstructions):
  def decoded = control(instruction)
  def care = control_pattern(instruction).care
  check:
    value(decoded, "floating_point") ~is 1
    value(decoded, "fp_service") ~is 1
    value(decoded, "integer") ~is 0
    value(decoded, "memory") ~is 0
    value(decoded, "fp_uses_vs1") ~is (if instruction.format == VectorUnaryFormat || instruction.format == VectorVFFormat | 0 | 1)
    value(decoded, "operand") ~is (if instruction.format == VectorVFFormat | VectorOperandMode.FloatingScalar.packed_value() | VectorOperandMode.Vector.packed_value())
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is 0
    value(decoded, "mask_destination") ~is (if VectorFloatingPointCompareInstructions.contains(instruction) | 1 | 0)
    value(decoded, "multiply_destination") ~is (if [VFMADD_VV, VFMSUB_VV, VFNMADD_VV, VFNMSUB_VV, VFMADD_VF, VFMSUB_VF, VFNMADD_VF, VFNMSUB_VF].contains(instruction) | 1 | 0)
    value(decoded, "reduction") ~is (if VectorFloatingPointReductionInstructions.contains(instruction) | 1 | 0)
    value(care, "store") ~is 0
    value(care, "mask_destination") ~is 1

for (instruction in VectorFloatingPointMovementInstructions):
  def decoded = control(instruction)
  check:
    value(decoded, "floating_point") ~is 1
    value(decoded, "fp_service") ~is 0
    value(decoded, "integer") ~is 0
    value(decoded, "memory") ~is 0
    value(decoded, "fp_uses_vs1") ~is 0
    value(decoded, "operand") ~is (if instruction == VFMV_F_S | VectorOperandMode.Vector | VectorOperandMode.FloatingScalar).packed_value()
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is 0
    value(field(core_control(instruction), "writeback"), "enable") ~is 0
check:
  value(control(VFMERGE_VFM), "mask_select") ~is 1
  value(control(VFMV_V_F), "uses_vs2") ~is 0
  value(control(VFMV_F_S), "element_move") ~is 1
  value(control(VFMV_F_S), "floating_scalar_destination") ~is 1
  value(control(VFMV_S_F), "element_move") ~is 1
  value(control(VFSLIDE1UP_VF), "slide") ~is 1
  value(control(VFSLIDE1UP_VF), "slide_up") ~is 1
  value(control(VFSLIDE1DOWN_VF), "slide") ~is 1

for (instruction in VectorFloatingPointAddSubtractInstructions):
  check value(field(control(instruction), "fp_execution"), "unit") ~is RV5StageFloatUnit.Add.packed_value()
for (instruction in VectorFloatingPointMultiplyDivideInstructions):
  check value(field(control(instruction), "fp_execution"), "unit") ~is (if [VFMUL_VV, VFMUL_VF].contains(instruction) || VectorWideningFloatingPointMultiplyInstructions.contains(instruction) | RV5StageFloatUnit.Multiply | RV5StageFloatUnit.DivideSquareRoot).packed_value()
for (instruction in VectorFloatingPointAddSubtractInstructions ++ VectorFloatingPointMultiplyDivideInstructions):
  check value(field(control(instruction), "fp_execution"), "uses_rounding_mode") ~is 1
for (instruction in VectorFloatingPointReductionInstructions):
  def execution = field(control(instruction), "fp_execution")
  check:
    value(control(instruction), "reduction") ~is 1
    value(execution, "unit") ~is (if [VFREDMIN_VS, VFREDMAX_VS].contains(instruction) | RV5StageFloatUnit.MinMax | RV5StageFloatUnit.Add).packed_value()
    value(execution, "uses_rounding_mode") ~is (if [VFREDMIN_VS, VFREDMAX_VS].contains(instruction) | 0 | 1)
    value(field(core_control(instruction), "writeback"), "enable") ~is 0
check:
  value(field(control(VFSUB_VV), "fp_execution"), "add_operation") ~is RV5StageFloatAddOperation.Subtract.packed_value()
  value(field(control(VFSQRT_V), "fp_execution"), "divide_operation") ~is RV5StageFloatDivideOperation.SquareRoot.packed_value()
  value(field(control(VFRSQRT7_V), "fp_execution"), "unit") ~is RV5StageFloatUnit.Estimate.packed_value()
  value(field(control(VFRSQRT7_V), "fp_execution"), "estimate_operation") ~is Estimate7Operation.ReciprocalSquareRoot.packed_value()
  value(field(control(VFREC7_V), "fp_execution"), "unit") ~is RV5StageFloatUnit.Estimate.packed_value()
  value(field(control(VFREC7_V), "fp_execution"), "uses_rounding_mode") ~is 1
  value(field(control(VFCLASS_V), "fp_execution"), "unit") ~is RV5StageFloatUnit.Classify.packed_value()
  value(control(VFCLASS_V), "fp_result") ~is VectorFloatResult.Integer.packed_value()
  value(field(control(VMFNE_VV), "fp_execution"), "comparison") ~is RV5StageFloatComparison.NotEqual.packed_value()
  value(field(control(VMFLT_VV), "fp_execution"), "comparison_signaling") ~is 1
  value(control(VFRSUB_VF), "swap_operands") ~is 1
  value(control(VFRDIV_VF), "swap_operands") ~is 1
  value(control(VMFGT_VF), "swap_operands") ~is 1
  value(control(VMFGE_VF), "swap_operands") ~is 1
for (instruction in VectorFloatingPointSignInjectInstructions, index in 0..6):
  def operation = [FloatSignOperation.Copy, FloatSignOperation.Negate, FloatSignOperation.Xor][index mod 3]
  check value(field(control(instruction), "fp_execution"), "sign_operation") ~is operation.packed_value()
for (instruction in VectorFloatingPointMinMaxInstructions ++ [VFREDMIN_VS, VFREDMAX_VS], index in 0..6):
  def operation = [MinMaxOperation.MinimumNumber, MinMaxOperation.MaximumNumber][index mod 2]
  check value(field(control(instruction), "fp_execution"), "minmax_operation") ~is operation.packed_value()
for (instruction in VectorFloatingPointFusedMultiplyAddInstructions):
  def execution = field(control(instruction), "fp_execution")
  def operation = cond
  | [VFMSAC_VV, VFMSUB_VV, VFMSAC_VF, VFMSUB_VF, VFWMSAC_VV, VFWMSAC_VF].contains(instruction): MulAddOperation.MultiplySubtract
  | [VFNMACC_VV, VFNMADD_VV, VFNMACC_VF, VFNMADD_VF, VFWNMACC_VV, VFWNMACC_VF].contains(instruction): MulAddOperation.NegatedMultiplySubtract
  | [VFNMSAC_VV, VFNMSUB_VV, VFNMSAC_VF, VFNMSUB_VF, VFWNMSAC_VV, VFWNMSAC_VF].contains(instruction): MulAddOperation.NegatedMultiplyAdd
  | ~else: MulAddOperation.MultiplyAdd
  check:
    value(execution, "unit") ~is RV5StageFloatUnit.FusedMultiplyAdd.packed_value()
    value(execution, "fused_operation") ~is operation.packed_value()
for (instruction in VectorWideningFloatingPointAddSubtractInstructions ++ VectorWideningFloatingPointMultiplyInstructions ++ VectorWideningFloatingPointFusedMultiplyAddInstructions ++ VectorWideningFloatingPointReductionInstructions):
  check:
    value(control(instruction), "widening") ~is 1
    value(control(instruction), "wide_vs2") ~is (if [VFWADD_WV, VFWADD_WF, VFWSUB_WV, VFWSUB_WF].contains(instruction) | 1 | 0)
for (instruction in [VFWSUB_VV, VFWSUB_VF, VFWSUB_WV, VFWSUB_WF]):
  check value(field(control(instruction), "fp_execution"), "add_operation") ~is RV5StageFloatAddOperation.Subtract.packed_value()
def VectorIntegerToFloatingConversions = [VFCVT_F_XU_V, VFCVT_F_X_V, VFWCVT_F_XU_V, VFWCVT_F_X_V, VFNCVT_F_XU_W, VFNCVT_F_X_W]
def VectorFloatingResultConversions = VectorIntegerToFloatingConversions ++ [VFWCVT_F_F_V, VFNCVT_F_F_W, VFNCVT_ROD_F_F_W]
def VectorRtzConversions = [VFCVT_RTZ_XU_F_V, VFCVT_RTZ_X_F_V, VFWCVT_RTZ_XU_F_V, VFWCVT_RTZ_X_F_V, VFNCVT_RTZ_XU_F_W, VFNCVT_RTZ_X_F_W]
def VectorUnsignedConversions = [VFCVT_XU_F_V, VFCVT_F_XU_V, VFCVT_RTZ_XU_F_V, VFWCVT_XU_F_V, VFWCVT_F_XU_V, VFWCVT_RTZ_XU_F_V, VFNCVT_XU_F_W, VFNCVT_F_XU_W, VFNCVT_RTZ_XU_F_W]
def VectorWideningFloatingPointConversions = [VFWCVT_XU_F_V, VFWCVT_X_F_V, VFWCVT_F_XU_V, VFWCVT_F_X_V, VFWCVT_F_F_V, VFWCVT_RTZ_XU_F_V, VFWCVT_RTZ_X_F_V]
def VectorNarrowingFloatingPointConversions = [VFNCVT_XU_F_W, VFNCVT_X_F_W, VFNCVT_F_XU_W, VFNCVT_F_X_W, VFNCVT_F_F_W, VFNCVT_ROD_F_F_W, VFNCVT_RTZ_XU_F_W, VFNCVT_RTZ_X_F_W]
for (instruction in VectorFloatingPointConversionInstructions):
  def decoded = control(instruction)
  def execution = field(decoded, "fp_execution")
  def fixed_rounding = VectorRtzConversions.contains(instruction) || instruction == VFNCVT_ROD_F_F_W
  check:
    value(execution, "unit") ~is RV5StageFloatUnit.Convert.packed_value()
    value(decoded, "fp_source") ~is (if VectorIntegerToFloatingConversions.contains(instruction) | VectorFloatSource.Integer | VectorFloatSource.Floating).packed_value()
    value(decoded, "fp_result") ~is (if VectorFloatingResultConversions.contains(instruction) | VectorFloatResult.Floating | VectorFloatResult.Integer).packed_value()
    value(decoded, "fp_rounding") ~is (if instruction == VFNCVT_ROD_F_F_W | VectorFloatRounding.RoundToOdd | (if VectorRtzConversions.contains(instruction) | VectorFloatRounding.TowardZero | VectorFloatRounding.Dynamic)).packed_value()
    value(decoded, "widening") ~is (if VectorWideningFloatingPointConversions.contains(instruction) | 1 | 0)
    value(decoded, "narrowing") ~is (if VectorNarrowingFloatingPointConversions.contains(instruction) | 1 | 0)
    value(execution, "uses_rounding_mode") ~is (if fixed_rounding | 0 | 1)
    value(execution, "integer_unsigned") ~is (if VectorUnsignedConversions.contains(instruction) | 1 | 0)

for (instruction in VectorIntegerInstructions):
  def decoded = control(instruction)
  def expected_operand = cond
  | [VectorVVFormat, VectorFixedVVFormat].contains(instruction.format): VectorOperandMode.Vector
  | [VectorVXFormat, VectorFixedVXFormat].contains(instruction.format): VectorOperandMode.Scalar
  | ~else: VectorOperandMode.Immediate
  check:
    value(decoded, "integer") ~is 1
    value(decoded, "memory") ~is 0
    value(decoded, "configure") ~is VectorConfigMode.None.packed_value()
    value(decoded, "operand") ~is expected_operand.packed_value()
  when instruction.format.immediate
  | check:
      value(decoded, "immediate_kind") ~is (if instruction.format.immediate.signed | VectorImmediateKind.Signed5 | VectorImmediateKind.Unsigned5).packed_value()

for (instructions in [VectorUnitStrideMemoryInstructions, VectorStridedMemoryInstructions], addressing in [VectorMemoryAddressing.UnitStride, VectorMemoryAddressing.Strided]):
  for (instruction in instructions, index in 0..8):
    def decoded = control(instruction)
    check:
      value(decoded, "integer") ~is 0
      value(decoded, "memory") ~is 1
      value(decoded, "store") ~is (if index >= 4 | 1 | 0)
      value(decoded, "memory_mode") ~is VectorMemoryMode.Ordinary.packed_value()
      value(decoded, "memory_data_eew") ~is index mod 4
      value(decoded, "memory_addressing") ~is addressing.packed_value()
      value(field(core_control(instruction), "operand"), "uses_rs1") ~is 1
      value(field(core_control(instruction), "operand"), "uses_rs2") ~is (if addressing == VectorMemoryAddressing.Strided | 1 | 0)

for (instructions in [VectorIndexedUnorderedMemoryInstructions, VectorIndexedOrderedMemoryInstructions], addressing in [VectorMemoryAddressing.IndexedUnordered, VectorMemoryAddressing.IndexedOrdered]):
  for (instruction in instructions, index in 0..8):
    def decoded = control(instruction)
    check:
      value(decoded, "integer") ~is 0
      value(decoded, "memory") ~is 1
      value(decoded, "store") ~is (if index >= 4 | 1 | 0)
      value(decoded, "memory_mode") ~is VectorMemoryMode.Ordinary.packed_value()
      value(decoded, "memory_index_eew") ~is index mod 4
      value(decoded, "memory_addressing") ~is addressing.packed_value()
      value(decoded, "operand") ~is VectorOperandMode.Vector.packed_value()
      value(field(core_control(instruction), "operand"), "uses_rs1") ~is 1
      value(field(core_control(instruction), "operand"), "uses_rs2") ~is 0

for (instructions in [VectorUnitStrideSegmentMemoryInstructions, VectorStridedSegmentMemoryInstructions], addressing in [VectorMemoryAddressing.UnitStride, VectorMemoryAddressing.Strided]):
  for (instruction in instructions, index in 0..56):
    def decoded = control(instruction)
    check:
      value(decoded, "integer") ~is 0
      value(decoded, "memory") ~is 1
      value(decoded, "store") ~is (if index >= 28 | 1 | 0)
      value(decoded, "memory_mode") ~is VectorMemoryMode.Ordinary.packed_value()
      value(decoded, "memory_data_eew") ~is index mod 4
      value(decoded, "memory_nf") ~is ((index mod 28) div 4) + 1
      value(decoded, "memory_addressing") ~is addressing.packed_value()
      value(field(core_control(instruction), "operand"), "uses_rs1") ~is 1
      value(field(core_control(instruction), "operand"), "uses_rs2") ~is (if addressing == VectorMemoryAddressing.Strided | 1 | 0)

for (instructions in [VectorIndexedUnorderedSegmentMemoryInstructions, VectorIndexedOrderedSegmentMemoryInstructions], addressing in [VectorMemoryAddressing.IndexedUnordered, VectorMemoryAddressing.IndexedOrdered]):
  for (instruction in instructions, index in 0..56):
    def decoded = control(instruction)
    check:
      value(decoded, "integer") ~is 0
      value(decoded, "memory") ~is 1
      value(decoded, "store") ~is (if index >= 28 | 1 | 0)
      value(decoded, "memory_mode") ~is VectorMemoryMode.Ordinary.packed_value()
      value(decoded, "memory_index_eew") ~is index mod 4
      value(decoded, "memory_nf") ~is ((index mod 28) div 4) + 1
      value(decoded, "memory_addressing") ~is addressing.packed_value()
      value(decoded, "operand") ~is VectorOperandMode.Vector.packed_value()
      value(field(core_control(instruction), "operand"), "uses_rs1") ~is 1
      value(field(core_control(instruction), "operand"), "uses_rs2") ~is 0

for (instruction in VectorFaultOnlyFirstLoadInstructions, index in 0..32):
  def decoded = control(instruction)
  check:
    value(decoded, "integer") ~is 0
    value(decoded, "memory") ~is 1
    value(decoded, "store") ~is 0
    value(decoded, "memory_mode") ~is VectorMemoryMode.FaultOnlyFirst.packed_value()
    value(decoded, "memory_data_eew") ~is index mod 4
    value(decoded, "memory_nf") ~is (if index < 4 | 0 | ((index - 4) div 4) + 1)
    value(decoded, "memory_addressing") ~is VectorMemoryAddressing.UnitStride.packed_value()
    value(decoded, "operand") ~is VectorOperandMode.Scalar.packed_value()
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is 1
    value(field(core_control(instruction), "operand"), "uses_rs2") ~is 0

for (instruction in VectorWholeRegisterMemoryInstructions, index in 0..20):
  def decoded = control(instruction)
  def register_index = if index < 16 | index div 4 | index - 16
  check:
    value(decoded, "integer") ~is 0
    value(decoded, "memory") ~is 1
    value(decoded, "store") ~is (if index >= 16 | 1 | 0)
    value(decoded, "memory_mode") ~is VectorMemoryMode.WholeRegister.packed_value()
    value(decoded, "memory_data_eew") ~is (if index < 16 | index mod 4 | 0)
    value(decoded, "memory_nf") ~is [0, 1, 3, 7][register_index]
    value(decoded, "memory_addressing") ~is VectorMemoryAddressing.UnitStride.packed_value()
    value(decoded, "operand") ~is VectorOperandMode.Scalar.packed_value()
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is 1
    value(field(core_control(instruction), "operand"), "uses_rs2") ~is 0

for (instruction in VectorMaskMemoryInstructions, index in 0..2):
  def decoded = control(instruction)
  check:
    value(decoded, "integer") ~is 0
    value(decoded, "memory") ~is 1
    value(decoded, "store") ~is (if index == 1 | 1 | 0)
    value(decoded, "memory_mode") ~is VectorMemoryMode.Mask.packed_value()
    value(decoded, "memory_data_eew") ~is 0
    value(decoded, "memory_nf") ~is 0
    value(decoded, "memory_addressing") ~is VectorMemoryAddressing.UnitStride.packed_value()
    value(decoded, "operand") ~is VectorOperandMode.Scalar.packed_value()
    value(field(core_control(instruction), "operand"), "uses_rs1") ~is 1
    value(field(core_control(instruction), "operand"), "uses_rs2") ~is 0

for (vlen in [128, 256, 512, 65536]):
  def micro = RV5StageVectorMicroOp(vlen, Bits(4))
  def feedback = RV5StageVectorFeedback(XLen.X64, vlen, Bits(4))
  def beat = micro.field("beat").type
  check:
    beat.field("left").type.packed_width() ~is 64
    beat.field("right").type.packed_width() ~is 64
    beat.field("address").type.packed_width() ~is 64
    beat.field("carry_in").type.packed_width() ~is 8
    beat.field("fp_source_width").type ~is SimdElementWidth
    beat.field("fp_result_width").type ~is SimdElementWidth
    micro.field("context").type.packed_width() ~is 4
    feedback.field("context").type.packed_width() ~is 4
    (1 bits.(<<) beat.field("end").type.packed_width()) > vlen ~is #true
    beat.field("end").type.packed_width() ~is feedback.field("end").type.packed_width()
    beat.field("destination_first").type.packed_width() ~is beat.field("end").type.packed_width()
    beat.field("sequence").type.packed_width() ~is vector_sequence_width(vlen)
    feedback.field("sequence").type.packed_width() ~is beat.field("sequence").type.packed_width()
    beat.field("compress_state").type.field("destination").type.packed_width() ~is beat.field("end").type.packed_width()
    feedback.field("compress_state").type.field("destination").type.packed_width() ~is beat.field("end").type.packed_width()
