#lang rhombus
// Checks RV5Stage's host-side CHI response profiles for transaction engines.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("chi/protocol/flits.rhdl").CHIRspOpcode
  "../chi/foundation.rhdl" as core_chi

check:
  core_chi.RV5StageCopyBackResponses.milestones ~is ["grant"]
  core_chi.RV5StageCopyBackResponses.response_opcodes ~is [
    CHIRspOpcode.RetryAck,
    CHIRspOpcode.PCrdGrant,
    CHIRspOpcode.CompDBIDResp
  ]
  core_chi.RV5StageRefillResponses.milestones ~is []
  core_chi.RV5StageRefillResponses.response_opcodes ~is [
    CHIRspOpcode.RetryAck,
    CHIRspOpcode.PCrdGrant
  ]
  core_chi.RV5StageWriteUniqueResponses.milestones ~is ["dbid", "completion"]
  core_chi.RV5StageWriteUniqueResponses.milestone_mask("dbid") ~is 1
  core_chi.RV5StageWriteUniqueResponses.milestone_mask("completion") ~is 2
  core_chi.RV5StageWriteUniqueResponses.response_opcodes ~is [
    CHIRspOpcode.RetryAck,
    CHIRspOpcode.PCrdGrant,
    CHIRspOpcode.DBIDResp,
    CHIRspOpcode.DBIDRespOrd,
    CHIRspOpcode.Comp,
    CHIRspOpcode.CompDBIDResp
  ]
