#lang rhodium
// Exposes production vector transfers for memory replay and completion-lineage tests.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../vector/pipeline.rhdl" open
  "../../vector/bundles.rhdl" open
  "../decode/core-ctrl.rhdl" open
  "../../../riscv/isa/vector-profile.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/rtl/vector.rhdl" open
  "../../../riscv/rtl/pointer-masking.rhdl" open
  lib("hardfloat/main.rhdl").RoundingMode
  lib("rhodium/std/bits.rhdl").Pow2Int
  lib("flow/main.rhdl") open

sync_circuit RV5StageVectorTrace(slots :: Pow2Int):
  def xlen = XLen.X64
  input instruction: Bits(32)
  input(vl, vstart, vtype): Bits(64)
  input(request_valid, issue_ready, cancel, slow, response_valid): Bool
  input disposition: VectorDisposition
  input response_tag: Bits(index_width(slots))
  output(request_ready, active, issued, committed, issue_done, enabled, memory, sequenced): Bool
  output response_ready: Bool
  output issue_tag: Bits(index_width(slots))
  inst decode(RV5StageInstructionDecoder(xlen, ~vector: VectorProfile.V))
  inst vector(VectorExecution(xlen, 128, Bits(64), ~vector_completion_slots: slots))
  vector.schedule_enable <== issue_ready
  vector.scalar_writeback.ready <== Bool(#true)
  vector.packed_memory <== Bool(#false)
  inst tokens(ValidPipe(VectorToken(XLen.X64, Bits(64), slots), 3, ~flushable: #true))
  decode.instruction <== instruction
  vector.request.valid <== request_valid
  vector.request.bits <== VectorInstruction(xlen, Bits(64)):
    context: Bits(64)(0x100)
    descriptor:
      VectorDescriptor(xlen):
        pc: Bits(64)(0x100)
        precertified: Bool(#false)
        certificate: dont_care(vector.request.bits.descriptor.certificate.type)
        instruction: instruction
        state:
          RiscvVectorState(xlen):
            vl: vl
            vtype: vtype
            vstart: vstart
            vxrm: Bits(2)(0)
            vxsat: Bool(#false)
        control: decode.control.vector
        scalar: Bits(64)(0)
        floating_scalar: Bits(64)(0)
        stride: Bits(64)(0)
        masked: !instruction[25].into(Bool)
        rounding_mode: RoundingMode.NearEven
        pointer_masking:
          PointerMaskControl():
            mode: PointerMaskMode.Disabled
            virtual_address: Bool(#false)
  vector.issue |> to_valid() |> tokens.ingress
  def recovering = cancel ||| (tokens.egress.valid & (disposition =/= VectorDisposition.Authorized))
  tokens.flush <== recovering
  vector.cancel.valid <== cancel
  (
    tokens.egress |> filter_valid(token => token.memory & !cancel) |> map_valid(token => VectorCommit(xlen, slots)):
      tag: token.completion_tag
      pc: Bits(64)(0x100)
      disposition: disposition
      slow: slow & token.enabled
      data: Bits(64)(0)
      cause: Bits(64)(0)
      fault_address: Bits(64)(0)
  ) |> vector.decision
  vector.completion.valid <== response_valid
  vector.completion.bits <== VectorCompletion(xlen, slots):
    tag: response_tag
    data: Bits(64)(0)
  response_ready <== vector.completion.ready
  vector.memory_drained <== Bool(#true)
  vector.fp_request.ready <== Bool(#false)
  vector.fp_result.valid <== Bool(#false)
  vector.fp_result.bits <== dont_care(vector.fp_result.bits.type)
  vector.multiply_request.ready <== Bool(#false)
  vector.multiply_result.valid <== Bool(#false)
  vector.multiply_result.bits <== dont_care(vector.multiply_result.bits.type)
  vector.divide_request.ready <== Bool(#false)
  vector.divide_result.valid <== Bool(#false)
  vector.divide_result.bits <== dont_care(vector.divide_result.bits.type)
  request_ready <== vector.request.ready
  active <== vector.active
  sequenced <== vector.sequencing_done.valid
  issued <== vector.issue.fire()
  committed <== tokens.egress.valid & !cancel
  issue_done <== vector.issue_done.valid
  issue_tag <== vector.issue.bits.completion_tag
  enabled <== vector.issue.bits.enabled
  memory <== vector.issue.bits.memory

export RV5StageVectorTrace
