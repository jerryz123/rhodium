#lang rhodium
// Compares otherwise identical RV64 pipelines with enabled and disabled branch prediction.
// SPDX-License-Identifier: Apache-2.0
import:
  "core-fixture.rhdl" open
  "../profile.rhm" open
  "../icache/protocol.rhdl" open
  "../dcache/protocol.rhdl" open
  "../interrupt.rhdl" open
  "../../../riscv/isa/xlen.rhm".XLen
  "../../../riscv/isa/fp-profile.rhm".FloatingPointProfile

sync_circuit BranchPredictionFixture():
  def profile = RVCoreProfile(~xlen: XLen.X64, ~extensions: RV5StageExtensions(~floating_point: FloatingPointProfile.None))
  interface instruction[2](RV5StageTestInstructionAccess(XLen.X64), ~role: requester)
  interface data[2](RV5StageDataAccess(XLen.X64), ~role: requester)
  for (index in 0..2):
    inst core(RV5StageCoreFixture(profile, ~reset_address: 0, ~btb_entries: if index == 0 | 16 | 0))
    core.interrupts <== literal(RV5StageInterrupts(), 0)
    core.hart_id <== bits(0, 64)
    core.time_counter <== bits(0, 64)
    core.instruction_access |> instruction[index]
    core.data_access |> data[index]
    core.pipeline_access.response.valid <== Bool(#false)
    core.pipeline_access.commit_ready <== Bool(#false)
    core.pipeline_access.response.bits <== literal(RV5StagePipelineResult(XLen.X64), 0)

def design = elaborate(BranchPredictionFixture())
export:
  design
