#lang rhodium
// Exercises integrated RV64V decode, extension geometry, vector CSR state, and legality.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("riscv/rtl/trap.rhdl").ExceptionCause
  "../../common/csr/file.rhdl" open
  "../../common/csr/protocol.rhdl" open
  "../profile.rhm" open
  "../../../riscv/rtl/interrupt.rhdl" open
  "../decode/core-ctrl.rhdl" open
  "../../common/vector/decode.rhdl" open
  "../decode/system-ctrl.rhdl" open
  "../../../riscv/isa/vector.rhm" open
  "../../../riscv/isa/vector-profile.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/isa/fp-profile.rhm" open
  "../../../riscv/rtl/vector.rhdl" open
  "../../../riscv/rtl/cmo.rhdl" open

sync_circuit RV5StageVectorControlFixture(vlen :: VectorLength):
  def xlen = XLen.X64
  def selected_vector_extensions = vector_extensions(VectorExtension.Zvfhmin, VectorExtension.Zvbb)
  def full_half_vector_extensions = vector_extensions(VectorExtension.Zvfh, VectorExtension.Zvbb)
  input instruction: Bits(32)
  input(scalar1, scalar2): Bits(xlen.width)
  input(commit_valid, exception_valid): Bool
  input saturate: Bool
  input(test_vtype, test_vstart): Bits(xlen.width)
  output(decoded_valid, base_decoded_valid, legal, full_half_legal, base_fp_legal, wide_integer_fp_legal, writeback_valid, redirect_valid): Bool
  output writeback_value: Bits(xlen.width)
  output mstatus: Bits(xlen.width)
  output state: RiscvVectorState(xlen)
  output(configuration, operand): Bits(2)
  output arithmetic_mode: Bits(3)
  output multiply_result: Bits(2)
  output extension_ratio: Bits(2)
  output(mask_destination, carry_input, extension, extension_signed, mask_result_select, invert_comparison, swap_operands, widening, narrowing, fp_zvfhmin_e16, fp_wide_float, rounding, clip, clip_unsigned, wide_vs2, left_signed, right_signed, subtract, divide, divide_remainder): Bool
  inst decoder(RV5StageInstructionDecoder(xlen, ~vector: VectorProfile.V, ~vector_extensions: selected_vector_extensions))
  inst base_decoder(RV5StageInstructionDecoder(xlen, ~vector: VectorProfile.V))
  inst csrs(RiscvCsrFile(RV5StageConfig(~xlen: xlen, ~extensions: RV5StageExtensions(~floating_point: FloatingPointProfile.D), ~vector: VectorProfile.V, ~vector_extensions: selected_vector_extensions, ~vector_length: vlen).csr_config))
  inst operation_legality(VectorOperationLegality(xlen, vlen, VectorProfile.V, selected_vector_extensions))
  inst full_half_operation_legality(VectorOperationLegality(xlen, vlen, VectorProfile.V, full_half_vector_extensions))
  inst base_fp_operation_legality(VectorOperationLegality(xlen, vlen, VectorProfile.Zve32f, NoVectorExtensions))
  inst wide_integer_fp_operation_legality(VectorOperationLegality(xlen, vlen, VectorProfile.Zve64f, NoVectorExtensions))
  decoder.instruction <== instruction
  base_decoder.instruction <== instruction
  operation_legality.instruction <== instruction
  operation_legality.control <== decoder.control.vector
  operation_legality.vtype <== test_vtype
  operation_legality.vstart <== test_vstart
  full_half_operation_legality.instruction <== instruction
  full_half_operation_legality.control <== decoder.control.vector
  full_half_operation_legality.vtype <== test_vtype
  full_half_operation_legality.vstart <== test_vstart
  base_fp_operation_legality.instruction <== instruction
  base_fp_operation_legality.control <== base_decoder.control.vector
  base_fp_operation_legality.vtype <== test_vtype
  base_fp_operation_legality.vstart <== test_vstart
  wide_integer_fp_operation_legality.instruction <== instruction
  wide_integer_fp_operation_legality.control <== base_decoder.control.vector
  wide_integer_fp_operation_legality.vtype <== test_vtype
  wide_integer_fp_operation_legality.vstart <== test_vstart
  legal <== decoder.valid & operation_legality.legal
  full_half_legal <== decoder.valid & full_half_operation_legality.legal
  base_fp_legal <== base_decoder.valid & base_fp_operation_legality.legal
  wide_integer_fp_legal <== base_decoder.valid & wide_integer_fp_operation_legality.legal
  decoded_valid <== decoder.valid
  base_decoded_valid <== base_decoder.valid
  configuration <== decoder.control.vector.configure.as_bits()
  operand <== decoder.control.vector.operand.as_bits()
  arithmetic_mode <== decoder.control.vector.integer_row.alu.arithmetic_mode.as_bits()
  multiply_result <== decoder.control.vector.product.select.as_bits()
  mask_destination <== vector_writes_mask(decoder.control.vector)
  carry_input <== decoder.control.vector.reads.v0 === VectorV0Role.Carry
  extension <== extension_shift(decoder.control.vector.width_shape).any()
  extension_ratio <== extension_shift(decoder.control.vector.width_shape) - Bits(2)(1)
  extension_signed <== decoder.control.vector.left_signed
  mask_result_select <== decoder.control.vector.integer_row.alu.mask_result_select.as_bits()[0].into(Bool)
  invert_comparison <== decoder.control.vector.integer_row.invert_comparison
  swap_operands <== decoder.control.vector.integer_row.swap_operands
  widening <== widens_result(decoder.control.vector.width_shape)
  narrowing <== (decoder.control.vector.width_shape === VectorWidthShape.Narrow)
  fp_zvfhmin_e16 <== decoder.control.vector.fp_zvfhmin_e16
  fp_wide_float <== decoder.control.vector.fp_wide_float
  rounding <== decoder.control.vector.integer_row.round_shift
  clip <== decoder.control.vector.integer_row.clip
  clip_unsigned <== decoder.control.vector.integer_row.clip_unsigned
  wide_vs2 <== has_wide_vs2(decoder.control.vector.width_shape)
  def product = decoder.control.vector.multiply_divide & (decoder.control.vector.compute_family === VectorComputeFamily.IntProduct)
  left_signed <== mux(product, decoder.control.vector.product.mode.left_signed, decoder.control.vector.left_signed)
  right_signed <== mux(product, decoder.control.vector.product.mode.right_signed, decoder.control.vector.right_signed)
  subtract <== decoder.control.vector.integer_row.alu.subtract
  divide <== decoder.control.vector.multiply_divide & (decoder.control.vector.compute_family === VectorComputeFamily.IntDivide)
  divide_remainder <== decoder.control.vector.division.remainder
  csrs.interrupts <== literal(RiscvInterrupts(), 0)
  csrs.hart_id <== Bits(xlen.width)(0)
  csrs.time_counter <== Bits(64)(0)
  csrs.vector_retire.valid <== Bool(#false)
  csrs.vector_saturate.valid <== saturate
  csrs.vector_fault_start.valid <== Bool(#false)
  csrs.vector_fault_start.bits <== Bits(xlen.width)(0)
  csrs.vector_truncate.valid <== Bool(#false)
  csrs.vector_truncate.bits <== Bits(xlen.width)(0)
  csrs.interrupt_boundary.valid <== Bool(#false)
  csrs.interrupt_boundary.bits <== Bits(xlen.width)(0)
  csrs.fp_update.valid <== Bool(#false)
  csrs.fp_update.bits <== Bits(5)(0)
  csrs.cbo_operation <== CboManagementOperation.Invalidate
  csrs.commit.valid <== commit_valid
  csrs.retire_count <== csrs.command_success.as_bits().zext(2)
  csrs.commit.bits <== RiscvCsrCommand(xlen):
    pc: Bits(xlen.width)(0x100)
    instruction: instruction
    rd: instruction[7..12]
    csr_operation: decoder.control.system.csr
    action: decoder.control.system.action
    csr_address: instruction[20..32]
    csr_source: mux(decoder.control.system.immediate, instruction[15..20].zext(xlen.width), scalar1)
    vector_config: vector_configuration_request(xlen, decoder.control.vector.configure, instruction, scalar1, scalar2)
    exception_valid: exception_valid ||| !decoder.valid ||| decoder.control.vector.integer
    exception_cause: ExceptionCause.IllegalInstruction
    exception_value: instruction.zext(xlen.width)

  writeback_valid <== csrs.writeback.valid
  writeback_value <== csrs.writeback.bits
  redirect_valid <== csrs.redirect.valid
  mstatus <== csrs.mstatus
  state <== csrs.vector_state

export:
  RV5StageVectorControlFixture
