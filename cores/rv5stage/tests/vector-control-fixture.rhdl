#lang rhodium
// Exercises integrated RV64V decode, extension geometry, vector CSR state, and legality.
// SPDX-License-Identifier: Apache-2.0

import:
  "../csr.rhdl" open
  "../profile.rhm" open
  "../../../riscv/rtl/interrupt.rhdl" open
  "../decode/core-ctrl.rhdl" open
  "../decode/vector-ctrl.rhdl" open
  "../decode/system-ctrl.rhdl" open
  "../vector/csr.rhdl" open
  "../../../riscv/isa/vector.rhm" open
  "../../../riscv/isa/vector-profile.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/isa/fp-profile.rhm" open
  "../../../riscv/rtl/vector.rhdl" open
  "../../../riscv/rtl/cmo.rhdl" open

sync_circuit RV5StageVectorControlFixture(vlen :: VectorLength):
  def xlen = XLen.X64
  def selected_vector_extensions = vector_extensions(VectorExtension.Zvfhmin, VectorExtension.Zvbb)
  def full_half_vector_extensions = vector_extensions(VectorExtension.Zvfh, VectorExtension.Zvbb)
  input instruction: Bits(32)
  input(scalar1, scalar2): Bits(xlen.width)
  input(commit_valid, exception_valid): Bool
  input saturate: Bool
  input(test_vtype, test_vstart): Bits(xlen.width)
  output(decoded_valid, base_decoded_valid, legal, full_half_legal, writeback_valid, redirect_valid): Bool
  output writeback_value: Bits(xlen.width)
  output mstatus: Bits(xlen.width)
  output state: RiscvVectorState(xlen)
  output(configuration, operand): Bits(2)
  output arithmetic_mode: Bits(3)
  output multiply_result: Bits(2)
  output extension_ratio: Bits(2)
  output(mask_destination, carry_input, extension, extension_signed, mask_result_select, invert_comparison, swap_operands, widening, narrowing, fp_zvfhmin_e16, fp_zvfh_e8, rounding, clip, clip_unsigned, wide_vs2, left_signed, right_signed, subtract, divide, remainder): Bool
  inst decoder(RV5StageInstructionDecoder(xlen, ~vector: VectorProfile.V, ~vector_extensions: selected_vector_extensions))
  inst base_decoder(RV5StageInstructionDecoder(xlen, ~vector: VectorProfile.V))
  inst csrs(RV5StageCsrFile(RV5StageConfig(~xlen: xlen, ~extensions: RV5StageExtensions(~floating_point: FloatingPointProfile.D), ~vector: VectorProfile.V, ~vector_extensions: selected_vector_extensions, ~vector_length: vlen)))
  inst legality(RV5StageVectorLegality(xlen, vlen, VectorProfile.V, selected_vector_extensions))
  inst full_half_legality(RV5StageVectorLegality(xlen, vlen, VectorProfile.V, full_half_vector_extensions))
  decoder.instruction <== instruction
  base_decoder.instruction <== instruction
  legality.instruction <== instruction
  legality.control <== decoder.control.vector
  legality.vtype <== test_vtype
  legality.vstart <== test_vstart
  full_half_legality.instruction <== instruction
  full_half_legality.control <== decoder.control.vector
  full_half_legality.vtype <== test_vtype
  full_half_legality.vstart <== test_vstart
  legal <== decoder.valid & legality.legal
  full_half_legal <== decoder.valid & full_half_legality.legal
  decoded_valid <== decoder.valid
  base_decoded_valid <== base_decoder.valid
  configuration <== decoder.control.vector.configure.as_bits()
  operand <== decoder.control.vector.operand.as_bits()
  arithmetic_mode <== decoder.control.vector.alu.arithmetic_mode.as_bits()
  multiply_result <== decoder.control.vector.multiply_result.as_bits()
  mask_destination <== decoder.control.vector.mask_destination
  carry_input <== decoder.control.vector.carry_input
  extension <== decoder.control.vector.extension
  extension_ratio <== decoder.control.vector.extension_ratio.as_bits()
  extension_signed <== decoder.control.vector.extension_signed
  mask_result_select <== decoder.control.vector.alu.mask_result_select.as_bits()[0].into(Bool)
  invert_comparison <== decoder.control.vector.invert_comparison
  swap_operands <== decoder.control.vector.swap_operands
  widening <== decoder.control.vector.widening
  narrowing <== decoder.control.vector.narrowing
  fp_zvfhmin_e16 <== decoder.control.vector.fp_zvfhmin_e16
  fp_zvfh_e8 <== decoder.control.vector.fp_zvfh_e8
  rounding <== decoder.control.vector.rounding
  clip <== decoder.control.vector.clip
  clip_unsigned <== decoder.control.vector.clip_unsigned
  wide_vs2 <== decoder.control.vector.wide_vs2
  left_signed <== decoder.control.vector.left_signed
  right_signed <== decoder.control.vector.right_signed
  subtract <== decoder.control.vector.alu.subtract
  divide <== decoder.control.vector.divide
  remainder <== decoder.control.vector.remainder
  csrs.interrupts <== literal(RiscvInterrupts(), 0)
  csrs.hart_id <== bits(0, xlen.width)
  csrs.time_counter <== bits(0, 64)
  csrs.vector_retire.valid <== Bool(#false)
  csrs.vector_saturate.valid <== saturate
  csrs.vector_fault_start.valid <== Bool(#false)
  csrs.vector_fault_start.bits <== bits(0, xlen.width)
  csrs.vector_truncate.valid <== Bool(#false)
  csrs.vector_truncate.bits <== bits(0, xlen.width)
  csrs.interrupt_boundary <== Bool(#false)
  csrs.interrupt_pc <== bits(0, xlen.width)
  csrs.fp_update.valid <== Bool(#false)
  csrs.fp_update.bits <== bits(0, 5)
  csrs.cbo_operation <== CboManagementOperation.Invalidate
  csrs.commit.valid <== commit_valid
  csrs.commit.bits <== RV5StageCsrCommit(xlen):
    pc: bits(0x100, xlen.width)
    instruction: instruction
    rd: instruction[7..12]
    system: decoder.control.system
    fence: decoder.control.fence
    csr_address: instruction[20..32]
    csr_source: mux(decoder.control.system.immediate, instruction[15..20].zext(xlen.width), scalar1)
    vector_config: vector_configuration_request(xlen, decoder.control.vector.configure, instruction, scalar1, scalar2)
    exception_valid: exception_valid ||| !decoder.valid ||| decoder.control.vector.integer
    exception_cause: bits(2, xlen.width)
    exception_value: if xlen == XLen.X32 | instruction | instruction.zext(xlen.width)
  writeback_valid <== csrs.writeback_valid
  writeback_value <== csrs.writeback_value
  redirect_valid <== csrs.redirect.valid
  mstatus <== csrs.mstatus
  state <== csrs.vector_state

export:
  RV5StageVectorControlFixture
