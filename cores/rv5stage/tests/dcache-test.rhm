#lang rhombus
// Checks RV5Stage data-cache geometry, public protocol types, and invalid configuration.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../cache/protocol.rhdl" open
  "../../../rhodium/core/main.rhm" open
  "../../../rhodium/frontend/kernel.rhm" as embedded
  "../../../riscv/isa/xlen.rhm" open
  "../../cache/geometry.rhdl" open
  "../../chi-hart.rhdl" open
  "../../cache/l1d/cache.rhdl" as l1d
  "../memory-context.rhdl" as protocol
  "params.rhdl" as test_params

def config = test_params.test_rv5stage_chi_config
def cache_config = CacheConfig(8, 1)
def associative_cache_config = CacheConfig(8, 2)
def design = embedded.run_elaboration(
  fun (): l1d.L1DCache(XLen.X64, cache_config, ~chi: config, ~context: protocol.RV5StageMemoryContext(8))
)
def cache = design.modules.find(fun (module_def): module_def.name == "L1DCache")
def data_access_type = CacheAccess(XLen.X64, protocol.RV5StageMemoryContext(8))
def data_request_member = data_access_type.members.find(fun (member): member.name == "request")
def data_response_member = data_access_type.members.find(fun (member): member.name == "response")
def rv32_design = embedded.run_elaboration(
  fun (): l1d.L1DCache(XLen.X32, cache_config, ~chi: config, ~service_queue_depth: 1, ~context: protocol.RV5StageMemoryContext(8))
)
def deeper_queue_design = embedded.run_elaboration(
  fun (): l1d.L1DCache(XLen.X64, cache_config, ~chi: config, ~service_queue_depth: 3, ~context: protocol.RV5StageMemoryContext(8))
)
def rv32_cache = rv32_design.modules.find(fun (module_def): module_def.name == "L1DCache")

// The public wire contract grows only when the slot index is the widest variant.
for (slots in [1, 2, 4, 8, 16, 256]):
  def writeback = protocol.RV5StageMemoryWriteback(slots)
  check:
    writeback.packed_width() ~is (if slots == 256 | 10 | 9)
    type_equal(PhysicalMemoryReq(XLen.X64, protocol.RV5StageMemoryContext(slots)).field("context").type.field("writeback").type, writeback) ~is #true
    type_equal(PhysicalMemoryResp(XLen.X64, protocol.RV5StageMemoryContext(slots)).field("context").type.field("writeback").type, writeback) ~is #true
    type_equal(PhysicalMemoryReq(XLen.X64, protocol.RV5StageMemoryContext(slots)).field("context").type.field("origin").type, protocol.RV5StageDataOrigin) ~is #true
    type_equal(PhysicalMemoryResp(XLen.X64, protocol.RV5StageMemoryContext(slots)).field("context").type.field("origin").type, protocol.RV5StageDataOrigin) ~is #true

check:
  associative_cache_config.set_width ~is 3
  associative_cache_config.way_width ~is 1
  associative_cache_config.line_count ~is 16
  associative_cache_config.capacity_bytes ~is 1024
  data_request_member.type.name ~is "Decoupled"
  data_response_member.type.name ~is "Decoupled"
  cache.find_input("core_in").type.field("request").type.field("bits").type.field("data").type.width ~is 64
  cache.find_input("core_in").type.field("request").type.field("bits").type.field("address").type.width ~is 64
  cache.find_input("prefetch_in").type.field("bits").type.field("address").type.width ~is 64
  cache.find_input("virtual_lookup_in").type.field("bits").type.width ~is 64
  cache.find_input("core_in").type.field("request").type.field("bits").type.field("access").type.width ~is 4
  cache.find_input("core_in").type.field("request").type.field("bits").type.field("atomic").type.width ~is 4
  type_equal(cache.find_input("core_in").type.field("request").type.field("bits").type.field("context").type.field("writeback").type, protocol.RV5StageMemoryWriteback(8)) ~is #true
  protocol.RV5StageMemoryWriteback(8).variants ~is ["Ack", "Integer", "FloatingPoint", "Vector"]
  protocol.RV5StageMemoryWriteback(8).packed_width() ~is 9
  scalar_width(cache.find_input("core_in").type.field("request").type.field("bits").type.field("locality").type) ~is 3
  type_equal(cache.find_output("core_out").type.field("response").type.field("bits").type.field("context").type.field("writeback").type, protocol.RV5StageMemoryWriteback(8)) ~is #true
  scalar_width(cache.find_output("core_out").type.field("drained").type) ~is 1
  cache.find_output("chi_out").type.field("request_data").type.field("bits").type.field("byte_enable").type.width ~is 16
  rv32_cache.find_input("core_in").type.field("request").type.field("bits").type.field("data").type.width ~is 32
  rv32_cache.find_input("core_in").type.field("request").type.field("bits").type.field("address").type.width ~is 32
  rv32_cache.find_input("prefetch_in").type.field("bits").type.field("address").type.width ~is 32
  rv32_cache.find_input("virtual_lookup_in").type.field("bits").type.width ~is 32
  rv32_cache.find_output("core_out").type.field("response").type.field("bits").type.field("data").type.width ~is 32
  rv32_cache.find_output("chi_out").type.field("requests").type.field("bits").type.field("address").type.width ~is 44
  embedded.run_elaboration(
    fun (): l1d.L1DCache(64, cache_config, ~chi: config, ~context: protocol.RV5StageMemoryContext(8))
  ) ~throws "XLen"
  embedded.run_elaboration(
    fun (): l1d.L1DCache(XLen.X64, cache_config, ~chi: config, ~service_queue_depth: 0, ~context: protocol.RV5StageMemoryContext(8))
  ) ~throws "PosInt"
  embedded.run_elaboration(
    fun (): l1d.L1DCache(XLen.X64, cache_config, ~chi: RiscvHartCHIConfig(config.flit, 32, config.regions), ~context: Bits(1))
  ) ~throws "64-byte cache lines"
