#lang rhodium
// Compares enabled and disabled return-address stacks under a two-entry BTB working-set conflict.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../cache/protocol.rhdl" open
  "core-fixture.rhdl" open
  "../profile.rhm" open
  "../icache/protocol.rhdl" open
  "../memory-context.rhdl" open
  "../../../riscv/rtl/interrupt.rhdl" open
  "../../../riscv/isa/xlen.rhm".XLen
  "../../../riscv/isa/fp-profile.rhm".FloatingPointProfile

sync_circuit ReturnPredictionFixture():
  def profile = RV5StageConfig(~xlen: XLen.X64, ~extensions: RV5StageExtensions(~floating_point: FloatingPointProfile.None))
  interface instruction[2](RV5StageTestInstructionAccess(XLen.X64), ~role: requester)
  interface data[2](CacheAccess(XLen.X64, RV5StageMemoryContext(8)), ~role: requester)
  for (index in 0..2):
    inst core(RV5StageCoreFixture(profile, ~reset_address: 0, ~btb_entries: 2, ~ras_entries: if index == 0 | 6 | 0))
    core.interrupts <== literal(RiscvInterrupts(), 0)
    core.hart_id <== bits(0, 64)
    core.time_counter <== bits(0, 64)
    core.instruction_access |> instruction[index]
    core.data_access |> data[index]
    core.pipeline_access.response.valid <== Bool(#false)
    core.pipeline_access.commit_ready <== Bool(#false)
    core.pipeline_access.response.bits <== literal(CachePipelineResult(XLen.X64), 0)

def program = elaborate(ReturnPredictionFixture())

export:
  program
