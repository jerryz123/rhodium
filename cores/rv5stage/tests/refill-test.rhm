#lang rhombus
// Checks RV5Stage's public cache-line refill types and geometry validation.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  "../../../rhodium/core/main.rhm" open
  lib("rhodium/frontend/foundation.rhm").elaborate
  "params.rhdl" as test_params
  "../../cache/chi/refill.rhdl" as refill

def config = test_params.test_rv5stage_chi_config
def design = compile_program(elaborate(refill.CacheLineRefill(Bits(5), 32, config)), rtl_target).report.design
def engine = design.modules.find(fun (module_def): module_def.name == "CacheLineRefill")

check:
  engine.find_input("command_in").type.field("bits").type.field("line_address").type.width ~is 32
  engine.find_input("command_in").type.field("bits").type.field("context").type.width ~is 5
  engine.find_output("completion_out").type.field("bits").type.field("context").type.width ~is 5
  engine.find_output("completion_out").type.field("bits").type.field("line").type.length ~is 8
  engine.find_output("completion_out").type.field("bits").type.field("line").type.element_type.width ~is 64
  engine.find_output("requests_out").type.field("bits").type.field("opcode").type.width ~is 7
  engine.find_input("responses_in").type.field("bits").type.field("opcode").type.width ~is 5
  engine.find_input("response_data_in").type.field("bits").type.field("data").type.width ~is 128
  elaborate(refill.CacheLineRefill(Bits(5), 2, config)) ~throws "address width"
