#lang rhodium
// Exposes RV5Stage memory-operation classification and atomic-ALU behavior for tests.
// SPDX-License-Identifier: Apache-2.0

import:
  "../memory.rhdl" open
  "../dcache/protocol.rhdl" open
  "../../../riscv/isa/xlen.rhm" open

circuit RV5StageAtomicFixture(xlen :: XLen):
  def width = xlen.width

  input request: RV5StageDataReq(xlen)
  input old_value: Bits(width)
  output is_load: Bool
  output needs_unique: Bool
  output value: Bits(width)

  def access = request.access
  inst atomic_alu(RV5StageAtomicALU(xlen))
  is_load <== access.is_load()
  needs_unique <== access.needs_unique()
  atomic_alu.old_value <== old_value
  atomic_alu.operand <== request.data
  atomic_alu.memory_width <== request.width
  atomic_alu.operation <== request.atomic
  value <== atomic_alu.value

export:
  RV5StageAtomicFixture
