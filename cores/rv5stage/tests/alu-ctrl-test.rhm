#lang rhombus
// Checks the host-side base, B, and Zicond ALU decode relation.

import:
  rhombus.bits.(<<) as <<
  "../../../rhodium/std/decode/pattern.rhdl" as decode_pattern
  "../../../riscv/isa/rv64i.rhm" open
  "../../../riscv/isa/zbb.rhm" as zbb
  "../../../riscv/isa/zicond.rhm" as zicond
  "../../alu.rhdl" as alu
  "../decode/alu-ctrl.rhdl" as controls

fun control_for(cases, instruction):
  cases.find(
    fun (candidate):
      candidate.input.value_bits == instruction.encoding.value && candidate.input.care_bits == instruction.encoding.care
  ).output
fun base_control(name):
  control_for(controls.RV64IAluCases, RV64I.find(name))
fun record_field(record, name):
  record.fields.find(fun (field): field[0] == name)[1]
fun field_is_constrained(control, name):
  record_field(control.care, name).packed_value() != 0

def add_control = base_control("ADDI")
def bitmanip_control = control_for(controls.RV64BAluCases, zbb.ANDN)
def czero_eqz_control = control_for(controls.ZicondAluCases, zicond.CZERO_EQZ)
def czero_nez_control = control_for(controls.ZicondAluCases, zicond.CZERO_NEZ)
def control_width = alu.AluControl().packed_width()

check:
  controls.RV64IAluCases.length() ~is 28
  controls.RV64BAluCases.length() ~is 40
  controls.ZicondAluCases.length() ~is 2
  add_control is_a decode_pattern.Pattern ~is #true
  field_is_constrained(add_control, "result_select") ~is #true
  field_is_constrained(add_control, "subtract") ~is #true
  field_is_constrained(add_control, "unsigned_word") ~is #true
  field_is_constrained(add_control, "shift_add_amount") ~is #true
  field_is_constrained(add_control, "word") ~is #true
  field_is_constrained(add_control, "logic_select") ~is #false
  field_is_constrained(add_control, "signed_compare") ~is #false
  field_is_constrained(bitmanip_control, "result_select") ~is #true
  field_is_constrained(bitmanip_control, "logic_select") ~is #true
  field_is_constrained(bitmanip_control, "invert_right") ~is #true
  field_is_constrained(bitmanip_control, "logic_right_select") ~is #true
  field_is_constrained(bitmanip_control, "word") ~is #true
  field_is_constrained(bitmanip_control, "subtract") ~is #false
  record_field(czero_eqz_control.value, "result_select").packed_value() ~is alu.AluResultSelect.Logic.packed_value()
  record_field(czero_eqz_control.value, "logic_select").packed_value() ~is alu.AluLogicSelect.And.packed_value()
  record_field(czero_eqz_control.value, "logic_right_select").packed_value() ~is alu.AluLogicRightSelect.ConditionalMask.packed_value()
  record_field(czero_eqz_control.value, "invert_right").packed_value() ~is 0
  record_field(czero_nez_control.value, "invert_right").packed_value() ~is 1
  field_is_constrained(czero_eqz_control, "logic_right_select") ~is #true
  field_is_constrained(czero_eqz_control, "subtract") ~is #false
  controls.RV64IAluDecode.table.packed_cases.length() ~is 28
  controls.RV64IAluDecode.table.packed_cases[0] ~is [
    ADDI.encoding.value,
    ADDI.encoding.care,
    (1 << control_width) + add_control.value_bits,
    (1 << control_width) + add_control.care_bits
  ]
  controls.RV64IAluDecode.table.default.value_bits ~is 0
  controls.RV64IAluDecode.table.default.care_bits ~is (1 << control_width)
  add_control.type.type_equal(alu.AluControl()) ~is #true
