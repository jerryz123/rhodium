#lang rhombus
// Checks RV5Stage's public boundary, CMO and main-memory guarantees, and configuration rejection.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../rhodium/frontend/kernel.rhm" as embedded
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/isa/c.rhm" open
  "../../../riscv/rtl/pma.rhdl" open
  "../cache.rhdl" as cache
  "../chi/foundation.rhdl" as chi
  "../profile.rhm" as core_profile
  "../rv5stage.rhdl" as rv5stage
  "params.rhdl" as test_params

def config = test_params.test_rv5stage_chi_config
def params = test_params.test_rv5stage_chi_params
def extensions = core_profile.RV5StageExtensions(~zicbom: #true, ~ziccif: #true, ~ziccamoa: #true, ~ziccrse: #true)
def rv64_design = embedded.run_elaboration(
  fun (): rv5stage.RV5Stage(
    core_profile.RVCoreProfile(
      ~xlen: XLen.X64,
      ~extensions: core_profile.RV5StageExtensions(~zicbom: #true, ~ziccif: #true, ~ziccamoa: #true, ~ziccrse: #true, ~compressed: compressed_extensions(CompressedExtension.Zca)),
      ~mmu_mode: core_profile.RV5StageMmuMode.Sv39
    ),
    ~chi: config,
    ~reset_address: 2
  )
)
def rv32_design = embedded.run_elaboration(
  fun (): rv5stage.RV5Stage(core_profile.RVCoreProfile(~xlen: XLen.X32, ~extensions: extensions), ~chi: config, ~reset_address: 0)
)
def rv64 = rv64_design.modules.find(fun (module_def): module_def.name == "RV5Stage")
def rv32 = rv32_design.modules.find(fun (module_def): module_def.name == "RV5Stage")

// Valid custom PMAs may omit a capability, but cannot advertise its guarantee.
for ([attributes, diagnostic] in [
  [RiscvPhysicalMemoryAttributes(#true, #true, #false, #true, #true, #false, #true), "Ziccif"],
  [RiscvPhysicalMemoryAttributes(#true, #true, #true, #true, #false, #false, #true), "Ziccamoa"]
]):
  def region = config.regions[0]
  def restricted = chi.RV5StageCHIConfig(config.flit, [chi.RV5StageCHIRegion(
    RiscvPhysicalMemoryRegion(region.physical.address_set, attributes), region.home
  )])
  check:
    embedded.run_elaboration(
      fun (): rv5stage.RV5Stage(core_profile.RVCoreProfile(~xlen: XLen.X64, ~extensions: extensions), ~chi: restricted, ~reset_address: 0)
    ) ~throws diagnostic

// Ziccrse is independent of fetch/AMO advertisements, but still needs LR/SC
// permission and ordinary idempotent memory. Generic CHI maps allow these PMAs.
for (attributes in [
  RiscvPhysicalMemoryAttributes(#true, #true, #true, #true, #false, #false, #true),
  RiscvPhysicalMemoryAttributes(#true, #true, #false, #true, #true, #false, #false)
]):
  def region = config.regions[0]
  def restricted = chi.RV5StageCHIConfig(config.flit, [chi.RV5StageCHIRegion(
    RiscvPhysicalMemoryRegion(region.physical.address_set, attributes), region.home
  )])
  for (xlen in [XLen.X32, XLen.X64]):
    check:
      embedded.run_elaboration(
        fun (): rv5stage.RV5Stage(core_profile.RVCoreProfile(~xlen: xlen, ~extensions: core_profile.RV5StageExtensions(~ziccrse: #true)), ~chi: restricted, ~reset_address: 0)
      ) ~throws "Ziccrse"

check:
  params.config === config ~is #true
  params.instruction_node.node_id ~is 2
  params.data_node.node_id ~is 3
  rv64.inputs.map(fun (port): port.name) ~is [
    "clock", "reset", "chi_identity", "interrupts", "hart_id",
    "time_counter", "imem_in", "dmem_in", "umem_in"
  ]
  rv64.outputs.map(fun (port): port.name) ~is [
    "imem_out", "dmem_out", "umem_out"
  ]
  rv32.find_output("dmem_out").type.field("request_data").type.field("bits").type.field("data").type.width ~is 128
  embedded.run_elaboration(
    fun (): rv5stage.RV5Stage(
      core_profile.RVCoreProfile(
        ~xlen: XLen.X32,
        ~cache_geometry: core_profile.RV5StageCacheGeometry(
          ~instruction: cache.RV5StageCacheConfig(268435456, 1)
        )
      ),
      ~chi: config,
      ~reset_address: 0
    )
  ) ~throws "VIPT"
  embedded.run_elaboration(
    fun (): rv5stage.RV5Stage(core_profile.RVCoreProfile(~xlen: 64), ~chi: config, ~reset_address: 0)
  ) ~throws "XLen"
  embedded.run_elaboration(
    fun (): rv5stage.RV5Stage(core_profile.RVCoreProfile(~xlen: XLen.X32), ~chi: config, ~reset_address: 0x100000000)
  ) ~throws "fit XLEN"
  embedded.run_elaboration(
    fun (): rv5stage.RV5Stage(core_profile.RVCoreProfile(~xlen: XLen.X64, ~extensions: core_profile.RV5StageExtensions(~compressed: compressed_extensions(CompressedExtension.Zca))), ~chi: config, ~reset_address: 1)
  ) ~throws "instruction aligned"
  chi.RV5StageCHIParams(config, 1, 3) ~throws "distinct"
  chi.RV5StageCHIParams(config, 128, 3) ~throws "fit"

for (xlen in [XLen.X32, XLen.X64]):
  check:
    embedded.run_elaboration(
      fun (): rv5stage.RV5Stage(core_profile.RVCoreProfile(~xlen: xlen), ~chi: config, ~reset_address: 0x10000000000000000)
    ) ~throws "fit XLEN"
    embedded.run_elaboration(
      fun (): rv5stage.RV5Stage(core_profile.RVCoreProfile(~xlen: xlen), ~chi: config, ~reset_address: 2)
    ) ~throws "instruction aligned"
