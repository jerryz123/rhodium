#lang rhombus
// Checks RV5Stage's core-cache hierarchy, external ports, and configuration bounds.

import:
  "../../../rhodium/core/main.rhm" open
  "../../../rhodium/frontend/kernel.rhm" as embedded
  "../../../riscv/isa/c.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../cache.rhdl" as cache
  "../chi.rhdl" as chi
  "../rv5stage.rhdl" as rv5stage
  "params.rhdl" as test_params

def config = test_params.test_rv5stage_chi_config
def params = test_params.test_rv5stage_chi_params
def design = embedded.run_elaboration(fun (): rv5stage.RV5Stage(XLen.X64, ~chi: config))
def top = design.modules.find(fun (module_def): module_def.name == "RV5Stage")
def core = design.modules.find(fun (module_def): module_def.name == "RV5StageCore")
def fetch = design.modules.find(fun (module_def): module_def.name == "RV5StageInstructionFetch")
def mmu = design.modules.find(fun (module_def): module_def.name == "RV5StageMmu")
def l1i = design.modules.find(fun (module_def): module_def.name == "RV5StageL1ICache")
def l1d = design.modules.find(fun (module_def): module_def.name == "RV5StageL1DCache")
def register_file = design.modules.find(fun (module_def): module_def.name == "RV5StageRegisterFile")
def scoreboard = design.modules.find(fun (module_def): module_def.name == "Scoreboard")
def multiplier = design.modules.find(fun (module_def): module_def.name == "RV5StageMultiplier")
def divider = design.modules.find(fun (module_def): module_def.name == "RV5StageDivider")
def csr_file = design.modules.find(fun (module_def): module_def.name == "RV5StageCsrFile")
def architectural_registers = register_file.operations.find(fun (operation): operation.attribute("name") == "registers")
def rv32_design = embedded.run_elaboration(fun (): rv5stage.RV5Stage(XLen.X32, ~chi: config))
def rv32_top = rv32_design.modules.find(fun (module_def): module_def.name == "RV5Stage")
def rv32_register_file = rv32_design.modules.find(fun (module_def): module_def.name == "RV5StageRegisterFile")
def zcb_design = embedded.run_elaboration(
  fun (): rv5stage.RV5Stage(
    XLen.X64,
    ~compressed: compressed_extensions(CompressedExtension.Zca, CompressedExtension.Zcb),
    ~chi: config
  )
)
def associative_design = embedded.run_elaboration(
  fun (): rv5stage.RV5Stage(
    XLen.X64,
    ~icache: cache.RV5StageCacheConfig(4, 2),
    ~dcache: cache.RV5StageCacheConfig(8, 2),
    ~chi: config
  )
)
fun instance_names(module_def):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.instance"
  ).map(fun (operation): operation.attribute("module").name)
fun state_names(module_def):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.register" || operation.opcode == "rtl.register_reset"
  ).map(fun (operation): operation.attribute("name"))
fun sync_memories(module_def):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.sync_memory"
  )

def top_instances = instance_names(top)
def core_instances = instance_names(core)
def l1i_instances = instance_names(l1i)
def l1d_instances = instance_names(l1d)
def sync_rams = design.modules.filter(
  ~keep: fun (module_def): module_def.name.starts_with("SyncRam1RW")
)

check:
  params.config === config ~is #true
  params.instruction_node.node_id ~is 2
  params.data_node.node_id ~is 3
  top.inputs.map(fun (port): port.name) ~is [
    "clock", "reset", "chi_identity", "start_in", "interrupts", "hart_id", "time_counter", "imem_in", "dmem_in", "umem_in"
  ]
  top.outputs.map(fun (port): port.name) ~is [
    "start_out", "imem_out", "dmem_out", "umem_out", "fault"
  ]
  top_instances ~is [
    "RV5StageCore", "RV5StageMmu", "RV5StageL1ICache", "RV5StageL1DCache",
    "RV5StageInstructionMemoryRouter", "RV5StageMemoryRouter", "RV5StageUncached"
  ]
  state_names(top) ~is []
  core_instances.filter(
    ~keep: fun (name): name.starts_with("Pipe")
  ).length() ~is 2
  core_instances.filter(
    ~keep: fun (name): name.starts_with("ValidPipe")
  ).length() ~is 2
  core_instances.contains("RV5StageInstructionDecoder") ~is #true
  core_instances.contains("RV5StageRegisterFile") ~is #true
  core_instances.contains("ALU") ~is #true
  core_instances.contains("BranchResolver") ~is #true
  core_instances.contains("RV5StageMultiplier") ~is #true
  core_instances.contains("RV5StageDivider") ~is #true
  core_instances.contains("RV5StageDisabledFpPipeline") ~is #true
  core_instances.contains("RV5StageFpPipeline") ~is #false
  core_instances.filter(~keep: fun (name): name.starts_with("Arbiter")).length() ~is 1
  core_instances.filter(~keep: fun (name): name.starts_with("ValidArbiter")).length() ~is 1
  core_instances.contains("Scoreboard") ~is #true
  core_instances.contains("RV5StageCsrFile") ~is #true
  core_instances.filter(
    ~keep: fun (name): name.starts_with("AtomicFork")
  ).length() ~is 0
  core_instances.contains("LoadGen") ~is #false
  core_instances.contains("StoreGen") ~is #false
  core_instances.contains("RV5StageInstructionFetch") ~is #true
  core_instances.contains("Queue") ~is #false
  instance_names(fetch).filter(~keep: fun (name): name.starts_with("Queue")).length() ~is 1
  design.modules.map(fun (module_def): module_def.name).contains("RiscvCompressedExpander") ~is #false
  zcb_design.modules.map(fun (module_def): module_def.name).contains("RiscvCompressedExpander") ~is #true
  core_instances.length() ~is 17
  l1i_instances.filter(~keep: fun (name): name.starts_with("SyncRam1RW")).length() ~is 3
  l1i_instances.filter(~keep: fun (name): name.starts_with("Queue")).length() ~is 1
  l1d_instances.filter(~keep: fun (name): name.starts_with("SyncRam1RW")).length() ~is 3
  l1d_instances.contains("LoadGen") ~is #true
  l1d_instances.contains("StoreGen") ~is #true
  sync_memories(l1i).length() ~is 0
  sync_memories(l1d).length() ~is 0
  sync_rams.length() ~is 4
  sync_rams.map(fun (module_def): sync_memories(module_def).length()) ~is [1, 1, 1, 1]
  type_equal(architectural_registers.results[0].type,
             VectorType(32, Bits(64))) ~is #true
  state_names(core) ~is [
    "faulted", "fp_store_requested", "pending_exception_valid",
    "pending_exception", "started", "waiting_for_interrupt", "architectural_pc"
  ]
  state_names(fetch) ~is ["pc", "slot0", "slot1"]
  state_names(scoreboard) ~is ["state"]
  state_names(multiplier) ~is ["destination", "high_result", "word_result"]
  state_names(divider) ~is ["destination", "remainder_result", "word_result"]
  state_names(csr_file) ~is ["privilege_state", "state"]
  instance_names(mmu).contains("RV5StagePageTableWalker") ~is #true
  instance_names(mmu).filter(~keep: fun (name): name.starts_with("RV5StageTlb")).length() ~is 2
  top.find_input("start_in").type.field("bits").type.width ~is 64
  top.find_input("interrupts").type.field("machine_timer").type.bit_width() ~is 1
  top.find_output("imem_out").type.field("requests").type.field("bits").type.field("address").type.width ~is 44
  top.find_output("imem_out").type.field("requester_responses").type.field("bits").type.field("opcode").type.width ~is 5
  top.find_output("umem_out").type.field("req").type.field("bits").type.field("address").type.width ~is 44
  rv32_top.find_input("start_in").type.field("bits").type.width ~is 32
  rv32_top.find_output("dmem_out").type.field("request_data").type.field("bits").type.field("data").type.width ~is 128
  rv32_top.find_output("dmem_out").type.field("requests").type.field("bits").type.field("address").type.width ~is 44
  rv32_register_file.operations.find(
    fun (operation): operation.attribute("name") == "registers"
  ).results[0].type.type_equal(VectorType(32, Bits(32))) ~is #true
  verify_design(design) ~is #void
  verify_design(rv32_design) ~is #void
  verify_design(zcb_design) ~is #void
  verify_design(associative_design) ~is #void
  embedded.run_elaboration(
    fun (): rv5stage.RV5Stage(XLen.X32,
                              ~icache: cache.RV5StageCacheConfig(268435456, 1),
                              ~chi: config)
  ) ~throws "address width"
  embedded.run_elaboration(fun (): rv5stage.RV5Stage(64, ~chi: config)) ~throws "XLen"
  chi.RV5StageCHIParams(config, 1, 3) ~throws "distinct"
  chi.RV5StageCHIParams(config, 128, 3) ~throws "fit"
