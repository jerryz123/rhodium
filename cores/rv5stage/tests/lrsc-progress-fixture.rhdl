#lang rhodium
// Connects two real L1Ds, a tiny inclusive Home, and SRAM for LR/SC progress tests.
// SPDX-License-Identifier: Apache-2.0

import:
  "../dcache/cache.rhdl" open
  "../dcache/protocol.rhdl" open
  "../cache.rhdl" open
  "../chi/foundation.rhdl" open
  "params.rhdl" open
  lib("cores/cache-prefetch.rhdl").CachePrefetchReq
  lib("riscv/isa/xlen.rhm") open
  lib("chi/protocol/flits.rhdl") open
  lib("chi/home/home-common.rhdl") open
  lib("chi/home/inclusive-home.rhdl") open
  lib("rhodium/std/interconnect.rhdl").StripedAddressLayout
  lib("chi/subordinate/ram.rhdl") open
  lib("flow/main.rhdl") open

sync_circuit RV5StageLRSCProgress():
  def p = test_rv5stage_flit
  def config = test_rv5stage_chi_config
  def ram_config = CHIRamConfig(p, 4096, ~max_outstanding: 1, ~max_transfer_bytes: 64)
  def left_node = RV5StageCHIParams(config, 2, 3).data_node
  def right_node = RV5StageCHIParams(config, 4, 5).data_node
  def home_config = CHIHNFConfig(p, [left_node.icn_peer(), right_node.icn_peer()], 4095, ram_config.requests)
  interface core[2](RV5StageDataAccess(XLen.X64), ~role: responder)
  output eviction_waiting: Bool

  inst left(RV5StageL1DCache(XLen.X64, RV5StageCacheConfig(4, 2), ~chi: config))
  inst right(RV5StageL1DCache(XLen.X64, RV5StageCacheConfig(4, 2), ~chi: config))
  inst home(CHIInclusiveHNF(CHIInclusiveHNFConfig(home_config, StripedAddressLayout(4096, 64, 1), ~sets: 2, ~ways: 1)))
  inst ram(CHIRam(ram_config))
  home.identity <== CHIHNFIdentity(p):
    home_node_id: bits(1, p.node_id_width)
    subordinate_node_id: bits(9, p.node_id_width)
    service_base: bits(0, p.request_address_width)
  ram.identity <== CHIRamIdentity(p):
    node_id: bits(9, p.node_id_width)
    base_address: bits(0, p.request_address_width)
  // Registered channel boundaries model fabric transport and separate the
  // packed bidirectional ports' independent ready paths for RTL simulation.
  home.port.subordinate.req |> queue(1) |> ram.port.req
  home.port.subordinate.dat.request |> queue(1) |> ram.port.dat.request
  ram.port.rsp |> queue(1) |> home.port.subordinate.rsp
  ram.port.dat.response |> queue(1) |> home.port.subordinate.dat.response
  core[0] <=> left.core
  core[1] <=> right.core
  left.node_id <== bits(3, p.node_id_width)
  right.node_id <== bits(5, p.node_id_width)
  left.virtual_lookup.valid <== core[0].request.valid
  left.virtual_lookup.bits <== core[0].request.bits.address
  right.virtual_lookup.valid <== core[1].request.valid
  right.virtual_lookup.bits <== core[1].request.bits.address
  left.pipeline_lookup.valid <== Bool(#false)
  left.pipeline_lookup.bits <== literal(RV5StagePipelineReq(XLen.X64), 0)
  left.pipeline.request.valid <== Bool(#false)
  left.pipeline.commit <== Bool(#false)
  left.pipeline.request.bits <== literal(RV5StagePipelineReq(XLen.X64), 0)
  right.pipeline_lookup.valid <== Bool(#false)
  right.pipeline_lookup.bits <== literal(RV5StagePipelineReq(XLen.X64), 0)
  right.pipeline.request.valid <== Bool(#false)
  right.pipeline.commit <== Bool(#false)
  right.pipeline.request.bits <== literal(RV5StagePipelineReq(XLen.X64), 0)
  left.prefetch.valid <== Bool(#false)
  left.prefetch.bits <== dont_care(CachePrefetchReq(64))
  right.prefetch.valid <== Bool(#false)
  right.prefetch.bits <== dont_care(CachePrefetchReq(64))

  Array(left.chi.requests, right.chi.requests) |> parallel(queue(1), queue(1)) |> rr_arbiter() |> home.port.requester.requests
  Array(left.chi.requester_responses, right.chi.requester_responses) |> parallel(queue(1), queue(1)) |> rr_arbiter() |> home.port.requester.requester_responses
  Array(left.chi.request_data, right.chi.request_data) |> parallel(queue(1), queue(1)) |> rr_arbiter() |> home.port.requester.request_data
  (home.port.requester.responses |> queue(1) |> demux_flow(2, response => (response.tgt_id === bits(5, p.node_id_width)).as_bits())) <=> Array(left.chi.responses, right.chi.responses)
  (home.port.requester.response_data |> queue(1) |> demux_flow(2, data => (data.tgt_id === bits(5, p.node_id_width)).as_bits())) <=> Array(left.chi.response_data, right.chi.response_data)
  (
    home.port.requester.snoops
      |> queue(1)
      |> demux_flow(2, dispatch => (dispatch.target_id === bits(5, p.node_id_width)).as_bits())
      |> parallel(map_flow(dispatch => dispatch.flit), map_flow(dispatch => dispatch.flit))
  ) <=> Array(left.chi.snoops, right.chi.snoops)
  eviction_waiting <== left.chi.snoops.valid & !left.chi.snoops.ready & (left.chi.snoops.bits.opcode === CHISnpOpcode.SnpCleanInvalid)

export:
  RV5StageLRSCProgress
