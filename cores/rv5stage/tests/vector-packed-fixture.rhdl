#lang rhodium
// Exposes certified beat scheduling, contended VRF writes, and shared SIMD alignment.
// SPDX-License-Identifier: Apache-2.0
import:
  lib("cores/riscv/vector-layout.rhm").VectorRegisterLayout
  "../vector/packed-load.rhdl" open
  "../vector/packed-bundles.rhdl" open
  "../vector/operand-fetch.rhdl" open
  "../vector/sequencer.rhdl" open
  "../vector/slots.rhdl" open
  "../vector/bundles.rhdl" open
  "../vector/register-file.rhdl" open
  "../vector/execute.rhdl" open
  "../decode/vector-ctrl.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/isa/vector.rhm" open
  "../../../riscv/rtl/vector.rhdl" open
  "../../../riscv/rtl/pointer-masking.rhdl" open
  lib("hardfloat/main.rhdl").RoundingMode
  lib("rhodium/std/bits.rhdl").Pow2Int
  lib("flow/main.rhdl") open

sync_circuit RV5StageVectorPackedFixture(slots :: Pow2Int, ~xlen: xlen :: XLen = XLen.X64):
  def vlen = 128
  input(base, vl, vstart, vtype): Bits(64)
  input nf: Bits(3)
  input eew: Bits(2)
  input mode: VectorMemoryMode
  input(store, masked, request_valid, issue_ready, retry, slow, alignment_available, write_available): Bool
  input hit_data: Bits(64)
  interface response(Valid(RV5StageVectorCompletion(xlen, slots)), ~role: consumer)
  interface initialize(Valid(VectorRegisterWrite(xlen, vlen)), ~role: consumer)
  interface written(Valid(VectorRegisterWrite(xlen, vlen)), ~role: producer)
  output(request_ready, active, issued, retired, sequenced): Bool
  output sequence_address: Bits(xlen.width)
  output token: RV5StageVectorToken(xlen, Bits(64), slots)
  interface attempt(Valid(RV5StageVectorToken(xlen, Bits(64), slots)), ~role: producer)
  inst engine(RV5StageVectorPackedLoad(xlen, vlen, slots, 2))
  inst sequencer(RV5StageVectorSequencer(xlen, vlen, Bits(64)))
  inst operand_fetch(RV5StageVectorOperandFetch(xlen, vlen, Bits(64)))
  def issue_link :: Handle = interface_link(Decoupled(RV5StageVectorToken(xlen, Bits(64), slots)))
  def issue_path = issue_link.right
  sequencer.packed_memory <== Bool(#true)
  sequencer.cancel.valid <== Bool(#false)
  sequencer.blocked_rows <== bits(0, VectorRegisterLayout(vlen, xlen.width).depth).as_vec(Bool)
  engine.closed_owners <== vec([!sequencer.active, Bool(#true)])
  reg tail(~init: bits(0, index_width(slots)))
  reg head(~init: bits(0, index_width(slots)))
  inst slots_owner(RV5StageVectorSlots(slots))
  engine.head <== head
  def next_tail = if slots == 1 | bits(0, index_width(slots)) | tail + operand_fetch.scheduled_return.as_bits().zext(index_width(slots))
  def slot_available = !slots_owner.allocated[next_tail] & (Bool(slots != 1) ||| !operand_fetch.scheduled_return)
  sequencer.sequence_request |> gate_flow(issue_ready & slot_available & alignment_available) |> operand_fetch.request
  operand_fetch.flush <== sequencer.read_flush
  operand_fetch.suffix |> sequencer.suffix
  operand_fetch.feedback.valid <== Bool(#false)
  operand_fetch.feedback.bits <== dont_care(operand_fetch.feedback.bits.type)
  engine.accepted_slots <== slots_owner.accepted
  engine.drain_enable <== Bool(#true)
  engine.alignment_available <== alignment_available & !operand_fetch.alignment.valid & !sequencer.prepare_alignment.valid
  engine.write_available <== write_available
  engine.owner <== bits(0, 1)
  inst registers(RV5StageVectorRegisterFile(xlen, vlen))
  inst execute(RV5StageVectorExecute(xlen, vlen))
  inst attempts(ValidPipe(RV5StageVectorToken(xlen, Bits(64), slots), 3, ~flushable: #true))
  def control :: RV5StageVectorControl() = literal(RV5StageVectorControl(), 0)
  def launches :: Handle = interface_link(Decoupled(RV5StageVectorInstruction(xlen, Bits(64))))
  launches.left.valid <== request_valid
  launches.left.bits <== RV5StageVectorInstruction(xlen, Bits(64)):
    context: bits(0x100, 64)
    descriptor:
      RV5StageVectorDescriptor(xlen):
        pc: bits(0x100, xlen.width)
        precertified: Bool(#false)
        certificate: dont_care(sequencer.request.bits.descriptor.certificate.type)
        instruction: bits(8, 32) << 7
        state:
          RiscvVectorState(xlen):
            vl: vl[0..xlen.width]
            vtype: vtype[0..xlen.width]
            vstart: vstart[0..xlen.width]
            vxrm: bits(0, 2)
            vxsat: Bool(#false)
        control: control.updated(~memory: Bool(#true), ~store: store, ~memory_data_eew: eew, ~memory_nf: nf, ~memory_mode: mode)
        scalar: base[0..xlen.width]
        floating_scalar: bits(0, xlen.width)
        stride: bits(0, xlen.width)
        masked: masked
        rounding_mode: RoundingMode.NearEven
        pointer_masking:
          PointerMaskControl():
            mode: PointerMaskMode.Disabled
            virtual_address: Bool(#false)
  launches.right |> sequencer.request
  operand_fetch.begin_macro <== sequencer.request.fire()
  def Array(scheduled, reservation) = operand_fetch.issue |> atomic_fork(2)
  (
    scheduled |> map_flow(operation => RV5StageVectorToken(xlen, Bits(64), slots)):
      precertified: Bool(#false)
      physical_address: bits(0, xlen.width)
      store: store
      byte_mask: operation.byte_mask
      context: operation.context
      last: operation.beat.last
      truncate_on_fault: Bool(#false)
      memory: Bool(#true)
      memory_width: bits(if xlen == XLen.X64 | 3 | 2, 2)
      enabled: operation.byte_mask.or_reduce()
      address: operation.beat.address
      store_data: operation.beat.left
      completion_tag: tail
  ) |> issue_link.left
  (
    reservation |> to_valid() |> map_valid(operation => RV5StageVectorPackedReservation(xlen, vlen, slots, 2)):
      tag: tail
      entry:
        RV5StageVectorPackedEntry(xlen, vlen, 2):
          sequence: operation.beat.sequence
          layout: operation.packed_layout
          mask: operation.byte_mask
          store: operation.beat.control.store
          segmented: operation.beat.control.memory_nf.or_reduce() & !operation.beat.control.memory_mode.is_one_of(VectorMemoryMode.WholeRegister, VectorMemoryMode.Mask)
          owner: bits(0, 1)
  ) |> engine.reserve
  issue_path |> to_valid() |> attempts.ingress
  attempts.egress |> attempt
  attempts.flush <== attempts.egress.valid & retry
  when (attempts.egress.valid & retry):
    tail <== attempts.egress.bits.completion_tag
  elsewhen (issue_path.fire()):
    tail <== if slots == 1 | bits(0, 1) | tail + bits(1, index_width(slots))
  when (engine.released.valid):
    head <== if slots == 1 | bits(0, 1) | head + bits(1, index_width(slots))
  slots_owner.reserve.valid <== issue_path.fire()
  slots_owner.reserve.bits <== tail
  slots_owner.accept.valid <== attempts.egress.valid & !retry
  slots_owner.accept.bits <== attempts.egress.bits.completion_tag
  engine.released |> slots_owner.release
  slots_owner.replay.valid <== attempts.egress.valid & retry
  (
    attempts.egress |> map_valid(token => RV5StageVectorCommit(xlen, slots)):
      tag: token.completion_tag
      pc: bits(0x100, xlen.width)
      disposition: mux(retry, RV5StageVectorDisposition.Retry, RV5StageVectorDisposition.Authorized)
      slow: slow
      data: hit_data[0..xlen.width]
      cause: bits(0, xlen.width)
      fault_address: bits(0, xlen.width)
  ) |> engine.commit
  response |> engine.completion
  for (port in 0..3):
    Array(operand_fetch.reads[port], sequencer.prepare_reads[port]) |> valid_arbiter() |> registers.reads[port]
    def Array(operands, preparation) = registers.results[port] |> fork_valid(2)
    operands |> operand_fetch.results[port]
    preparation |> sequencer.prepare_results[port]
  Array(operand_fetch.mask_read, sequencer.prepare_mask_read) |> valid_arbiter() |> registers.mask_read
  def Array(operand_mask, prepare_mask) = registers.mask_result |> fork_valid(2)
  operand_mask |> operand_fetch.mask_result
  prepare_mask |> sequencer.prepare_mask_result
  sequencer.feedback.valid <== engine.commit.valid
  sequencer.feedback.bits <== RV5StageVectorFeedback(xlen, vlen, Bits(xlen.width)):
    context: engine.commit.bits.pc
    sequence: engine.resolved.sequence
    first: engine.resolved.layout.before.element
    end: engine.resolved.layout.after.element
    disposition: engine.commit.bits.disposition
    cause: bits(0, xlen.width)
    fault_address: bits(0, xlen.width)
    last: engine.resolved.layout.last
    compress_state: literal(RV5StageVectorCompressState(xlen, vlen), 0)
    packed_layout: engine.resolved.layout
  def Array(bank_write, observed_write) = engine.write |> fork_valid(2)
  Array(initialize, bank_write) |> valid_arbiter() |> registers.write
  observed_write |> written
  sequencer.alignment_available <== alignment_available & !operand_fetch.alignment.valid
  Array(operand_fetch.alignment, sequencer.prepare_alignment, engine.alignment) |> valid_arbiter() |> execute.alignment
  operand_fetch.aligned <== execute.aligned
  sequencer.aligned <== execute.aligned
  engine.aligned <== execute.aligned
  assert(!engine.alignment.valid ||| alignment_available, "packed_alignment_obeys_availability")
  execute.beat <== literal(RV5StageVectorBeat(xlen, vlen), 0)
  execute.scan_carry <== bits(0, xlen.width)
  request_ready <== launches.left.ready
  active <== sequencer.active ||| operand_fetch.active ||| engine.active
  issued <== issue_path.fire()
  sequenced <== sequencer.sequence_request.fire()
  sequence_address <== sequencer.sequence_request.bits.context.beat_control.address
  token <== issue_path.bits
  reg was_active(~init: Bool(#false))
  was_active <== active
  retired <== was_active & !active

export RV5StageVectorPackedFixture
