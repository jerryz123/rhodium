import:
  "../../../../rhodium/backend/circt.rhm" open
  "../../../../rhodium/frontend/kernel.rhm" as embedded
  "../../../../riscv/isa/xlen.rhm" open
  "../../../../cores/rv5stage/tests/vector-sequencer-fixture.rhdl" as fixture

def design = embedded.run_elaboration(fun (): fixture.RV5StageVectorSequencerFixture(XLen.X32, 256))
print(emit_circt(design))
