  "../../../../riscv/isa/fp-profile.rhm" open
  "../../../../riscv/isa/vector-profile.rhm" open
  "../../../../riscv/isa/xlen.rhm" open

def design = embedded.run_elaboration(fun (): RV5StageCoreFixture(RV5StageConfig(~xlen: XLen.X64, ~extensions: RV5StageExtensions(~floating_point: FloatingPointProfile.D), ~vector: VectorProfile.V, ~vector_length: 128, ~vector_completion_slots: 8), ~reset_address: 0))
print(emit_circt(design))
