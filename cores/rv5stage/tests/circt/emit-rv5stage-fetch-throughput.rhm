#lang rhombus
// Instruments integrated fetch throughput with accepted-request-to-I-cache-TXREQ lineage.
// SPDX-License-Identifier: Apache-2.0
import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/backend/circt-target.rhm").circt_target
  lib("rhodium/compile/pipeline.rhm").rtl_pipeline_target
  lib("rhodium/event/trace-pass.rhm").event_trace_pass
  "../../../../cores/rv5stage/tests/fetch-throughput-fixture.rhdl".RV5StageFetchThroughput
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../../rhodium/event/main.rhm".EventInstrumentationConfig
def compiled = compile_program(elaborate(RV5StageFetchThroughput()), rtl_pipeline_target(circt_target, [event_trace_pass(EventInstrumentationConfig(~partial: #true))]))
def manifest = compiled.report.stages[0].findings.manifest
def event_manifest_cpp = compiled.artifacts.find(fun (artifact): artifact.name == "events.h").content ++ "\nnamespace fetch_sites {\n" ++ String.join(
  for List (label in ["frontend/s0.request", "icache/chi.txreq", "icache/refill"], name in ["request", "txreq", "refill"]):
    def indices = (for List (index in 0..manifest.sites.length()): index).filter(~keep: fun (index): manifest.sites[index].label == label)
    unless indices.length() == 1 | error("expected one fetch trace site: " ++ label)
    "constexpr unsigned " ++ name ++ " = " ++ to_string(indices[0]) ++ ";\n",
  ""
) ++ "}\n"
export event_manifest_cpp
print(compiled.artifacts[0].content)
