#lang rhombus
// Defines a program for the RV32 specialization of RV5Stage's data cache.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../memory-context.rhdl" open
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../../riscv/isa/xlen.rhm" open
  "../../../cache/geometry.rhdl" open
  "../../../cache/l1d/cache.rhdl" as cache
  "../../../../cores/rv5stage/tests/params.rhdl" as test_params

def program = elaborate(cache.L1DCache(XLen.X32, CacheConfig(4, 1), ~chi: test_params.test_rv5stage_chi_config, ~service_queue_depth: 1, ~context: RV5StageMemoryContext(8))
)
export program
