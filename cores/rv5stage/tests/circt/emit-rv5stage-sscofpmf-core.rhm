import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../../riscv/isa/xlen.rhm" open
  "../../profile.rhm" open
  "../core-fixture.rhdl" as core

def profile = RV5StageConfig(~xlen: XLen.X64, ~extensions: RV5StageExtensions(~sscofpmf: #true))
def program = elaborate(core.RV5StageCoreFixture(profile, ~reset_address: 0))
export program
