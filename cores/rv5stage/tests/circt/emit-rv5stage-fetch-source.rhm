#lang rhombus
// Emits fetch candidate selection and held-cursor instrumentation with its descriptor.
// SPDX-License-Identifier: Apache-2.0
import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/backend/circt-target.rhm").circt_target
  lib("rhodium/compile/pipeline.rhm").rtl_pipeline_target
  lib("rhodium/event/trace-pass.rhm").event_trace_pass
  "../../../../cores/rv5stage/tests/fetch-source-trace-fixture.rhdl".traced_fetch_source
  "../../../../rhodium/event/main.rhm".EventInstrumentationConfig
def compiled = compile_program(traced_fetch_source, rtl_pipeline_target(circt_target, [event_trace_pass(EventInstrumentationConfig(~partial: #true))]))
def manifest = compiled.report.stages[0].findings.manifest
def site_constants = for List (site in manifest.sites, index in 0..manifest.sites.length()):
  "inline constexpr unsigned " ++ site.label.replace("/", "_").replace(".", "_") ++ " = " ++ to_string(index) ++ ";\n"
def event_manifest_cpp = compiled.artifacts.find(fun (artifact): artifact.name == "events.h").content ++ "\nnamespace test_sites {\n" ++ String.join(site_constants, "") ++ "}\n"
export event_manifest_cpp
print(compiled.artifacts[0].content)
