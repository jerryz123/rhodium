#lang rhombus
// Emits the traced RV64V core for architectural retirement and vector admission ownership tests.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../../rhodium/backend/circt.rhm" open
  "../../../../rhodium/frontend/kernel.rhm" as embedded
  "../../../../riscv/isa/xlen.rhm" open
  "../../../../riscv/isa/fp-profile.rhm" open
  "../../../../riscv/isa/vector-profile.rhm" open
  "../../../../cores/rv5stage/tests/core-fixture.rhdl" as core
  "../../../../cores/rv5stage/profile.rhm" open
  "../../../../rhodium/event/main.rhm" open

def traced = instrument_events(embedded.run_elaboration_with_top(fun (): core.RV5StageCoreFixture(RV5StageConfig(~xlen: XLen.X64, ~extensions: RV5StageExtensions(~floating_point: FloatingPointProfile.D), ~vector: VectorProfile.V, ~vector_length: 128), ~reset_address: 0)), EventInstrumentationConfig(~partial: #true))
def event_manifest_cpp = event_manifest_to_cpp(traced.manifest) ++ "\nnamespace vector_core_sites {\n" ++ String.join(
  for List (label in ["core/s5.wb", "core/s4.memory", "core/s3.execute", "vector/s1.sequence"], name in ["wb", "mem", "ex", "sequence"]):
    def matches = (for List (index in 0..traced.manifest.sites.length()): index).filter(~keep: fun (index): traced.manifest.sites[index].label == label)
    unless matches.length() == 1 | error("expected one core/vector site: " ++ label)
    "constexpr unsigned " ++ name ++ " = " ++ to_string(matches[0]) ++ ";\n",
  ""
) ++ "}\n"
export event_manifest_cpp
print(emit_circt(traced.instrumented.design))
