#lang rhombus
// Emits the controlled prediction/retirement fixture with the production event graph and descriptor.
// SPDX-License-Identifier: Apache-2.0
import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/backend/circt-target.rhm").circt_target
  lib("rhodium/compile/pipeline.rhm").rtl_pipeline_target
  lib("rhodium/event/trace-pass.rhm").event_trace_pass
  "../retirement-trace-fixture.rhdl".RV5StageRetirementTrace
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../../rhodium/event/main.rhm".EventInstrumentationConfig
def compiled = compile_program(elaborate(RV5StageRetirementTrace()), rtl_pipeline_target(circt_target, [event_trace_pass(EventInstrumentationConfig(~partial: #true))]))
def manifest = compiled.report.stages[0].findings.manifest
def event_manifest_cpp = compiled.artifacts.find(fun (artifact): artifact.name == "events.h").content ++ "\nnamespace retirement_sites {\n" ++ String.join(
  for List (label in ["core/s5.wb", "core/s4.memory", "core/s3.execute"], name in ["wb", "mem", "ex"]):
    def indices = (for List (index in 0..manifest.sites.length()): index).filter(~keep: fun (index): manifest.sites[index].label == label)
    unless indices.length() == 1 | error("expected one retirement trace site: " ++ label)
    "constexpr unsigned " ++ name ++ " = " ++ to_string(indices[0]) ++ ";\n",
  ""
) ++ "}\n"
export event_manifest_cpp
print(compiled.artifacts[0].content)
