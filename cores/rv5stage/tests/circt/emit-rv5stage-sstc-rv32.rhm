#lang rhombus
// Emits the RV32 CSR file for Sstc and state-enable split-register tests.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../../rhodium/backend/circt.rhm" open
  "../../../../rhodium/frontend/kernel.rhm" as embedded
  "../../../../riscv/isa/xlen.rhm" open
  "../../csr.rhdl" as csr
  "../../profile.rhm" open

def design = embedded.run_elaboration(fun (): csr.RV5StageCsrFile(RV5StageConfig(~xlen: XLen.X32, ~extensions: RV5StageExtensions(~sstc: #true, ~smstateen: #true))))
print(emit_circt(design))
