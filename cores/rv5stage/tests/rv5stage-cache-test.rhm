#lang rhombus
// Checks that RV5Stage's XLEN-wide cache arrays lower through the CIRCT backend.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/backend/circt-target.rhm").circt_target
  "../memory-context.rhdl" open
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../riscv/isa/xlen.rhm" open
  "../../cache/geometry.rhdl" open
  "../../cache/protocol.rhdl".PhysicalMemoryResp
  "../../../cores/cache/l1i/cache.rhdl" as l1i
  "../../cache/l1d/cache.rhdl" as l1d
  "../../../cores/rv5stage/tests/params.rhdl" as test_params

def config = test_params.test_rv5stage_chi_config

def instruction_program = elaborate(l1i.L1ICache(XLen.X64, CacheConfig(8, 1), ~chi: config, ~fetch_bits: 32))
def data_program = elaborate(l1d.L1DCache(XLen.X64, CacheConfig(8, 1), ~chi: config, ~context: RV5StageMemoryContext(8)))
// Thirty-two 64-byte lines make the intended 2 KiB RV32 private-cache shape.
def rv32_instruction_program = elaborate(l1i.L1ICache(XLen.X32, CacheConfig(32, 1), ~chi: config, ~fetch_bits: 32))
def associative_instruction_program = elaborate(l1i.L1ICache(XLen.X64, CacheConfig(8, 2), ~chi: config, ~fetch_bits: 32))
def rv32_data_program = elaborate(l1d.L1DCache(XLen.X32, CacheConfig(32, 1), ~chi: config, ~context: RV5StageMemoryContext(8)))
def associative_data_program = elaborate(l1d.L1DCache(XLen.X64, CacheConfig(8, 2), ~chi: config, ~context: RV5StageMemoryContext(8)))
def three_way_data_program = elaborate(l1d.L1DCache(XLen.X64, CacheConfig(8, 3), ~chi: config, ~context: RV5StageMemoryContext(8)))
def rv32_core_output = rv32_data_program.top.outputs.find(fun (port): port.name == "core_out")
def rv32_response_type = rv32_core_output.type.field("response").type.field("bits").type
def instruction_circt = compile_program(instruction_program, circt_target).artifacts[0].content
def data_circt = compile_program(data_program, circt_target).artifacts[0].content
def rv32_instruction_circt = compile_program(rv32_instruction_program, circt_target).artifacts[0].content
def rv32_data_circt = compile_program(rv32_data_program, circt_target).artifacts[0].content
def associative_instruction_circt = compile_program(associative_instruction_program, circt_target).artifacts[0].content
def associative_data_circt = compile_program(associative_data_program, circt_target).artifacts[0].content
def three_way_data_circt = compile_program(three_way_data_program, circt_target).artifacts[0].content

check:
  instruction_circt.contains("seq.firmem") ~is #true
  instruction_circt.contains("seq.firmem.read_write_port") ~is #true
  instruction_circt.contains("hw.array_get") ~is #true
  data_circt.contains("seq.firmem") ~is #true
  data_circt.contains("mask") ~is #true
  data_circt.contains("hw.array_get") ~is #true
  instruction_circt.contains("!seq.firmem<64 x 64, mask 8>") ~is #true
  associative_instruction_circt.contains("!seq.firmem<64 x 128, mask 16>") ~is #true
  associative_data_circt.contains("!seq.firmem<64 x 128, mask 16>") ~is #true
  three_way_data_circt.contains("!seq.firmem<64 x 192, mask 24>") ~is #true
  data_circt.contains("!seq.firmem<64 x 64, mask 8>") ~is #true
  rv32_instruction_circt.contains("!seq.firmem<512 x 32, mask 4>") ~is #true
  rv32_data_circt.contains("!seq.firmem<512 x 32, mask 4>") ~is #true
  instruction_circt.contains("!seq.firmem<8 x 512") ~is #false
  data_circt.contains("!seq.firmem<8 x 512") ~is #false
  instruction_circt.contains("rtl.sync_memory") ~is #false
  data_circt.contains("rtl.sync_memory") ~is #false
  rv32_instruction_circt.contains("rtl.sync_memory") ~is #false
  rv32_data_circt.contains("rtl.sync_memory") ~is #false
  rv32_data_circt.contains("seq.firmem") ~is #true
  rv32_response_type.type_equal(PhysicalMemoryResp(XLen.X32, RV5StageMemoryContext(8))) ~is #true
