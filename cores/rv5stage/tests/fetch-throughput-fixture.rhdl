#lang rhodium
// Exercises cold-refill recovery and steady-state frontend/MMU/L1I throughput.
// SPDX-License-Identifier: Apache-2.0
import:
  "fetch-fixture.rhdl" open
  lib("cores/rv5stage/profile.rhm") open
  lib("cores/rv5stage/btb.rhdl") open
  lib("cores/rv5stage/mmu/mmu.rhdl") open
  lib("cores/rv5stage/csr.rhdl").PrivilegeMode
  lib("cores/rv5stage/instruction-memory-router.rhdl") open
  lib("cores/rv5stage/icache/cache.rhdl") open
  lib("cores/rv5stage/icache/protocol.rhdl") open
  lib("cores/rv5stage/dcache/protocol.rhdl") open
  lib("cores/rv5stage/cache.rhdl") open
  lib("cores/rv5stage/tests/params.rhdl") open
  lib("cores/cache-prefetch.rhdl") open
  lib("riscv/isa/c.rhm").CCompressedExtensions
  lib("riscv/isa/fp-profile.rhm") open
  lib("riscv/isa/xlen.rhm").XLen
  lib("chi/main.rhdl") open
  lib("flow/main.rhdl") open

sync_circuit RV5StageFetchThroughput():
  input(active, restart, sink_ready): Bool
  input start_pc: Bits(64)
  output(valid, fault): Bool
  output pc: Bits(64)
  output instruction: Bits(32)
  output(trace_admit, trace_clear, trace_kill, trace_outcome, trace_replay): Bool
  output trace_address: Bits(64)
  interface chi(CHIRNIChannels(test_rv5stage_flit), ~role: node)
  inst fetch(RV5StageFetchFixture(RVCoreProfile(~xlen: XLen.X64, ~extensions: RV5StageExtensions(~floating_point: FloatingPointProfile.D, ~compressed: CCompressedExtensions))))
  inst mmu(RV5StageMmu(XLen.X64, RV5StageMmuMode.Sv39, test_rv5stage_chi_config.physical_map))
  inst router(RV5StageInstructionMemoryRouter(XLen.X64))
  inst cache(RV5StageL1ICache(XLen.X64, RV5StageCacheConfig(32, 1), ~chi: test_rv5stage_chi_config))
  fetch.control.active <== active
  inject_flow(Pulse(), ~valid: Bool(#false)) |> fetch.control.flush
  inject_flow(Valid(Bits(64)), ~valid: restart, ~bits: start_pc) |> fetch.control.restart
  inject_flow(Pulse(), ~valid: Bool(#false)) |> fetch.control.invalidate_all
  inject_flow(Pulse(), ~valid: Bool(#false)) |> fetch.control.predictor_flush
  inject_flow(
    Valid(RV5StageBranchUpdate(XLen.X64)),
    ~valid: Bool(#false),
    ~bits: literal(RV5StageBranchUpdate(XLen.X64), 0)
  ) |> fetch.control.branch_update
  fetch.fetched.ready <== sink_ready
  valid <== fetch.fetched.valid
  pc <== fetch.fetched.bits.pc
  instruction <== fetch.fetched.bits.instruction
  fault <== fetch.fetched.bits.instruction_page_fault ||| fetch.fetched.bits.instruction_access_fault ||| fetch.fetched.bits.compressed_illegal
  fetch.memory |> mmu.instruction
  mmu.instruction_lookup |> cache.virtual_lookup
  mmu.instruction_memory |> router.core
  router.cache |> cache.core
  router.uncached.request.ready <== Bool(#true)
  router.uncached.response.valid <== Bool(#false)
  router.uncached.response.bits <== literal(RV5StageInstructionResp(), 0)
  mmu.privilege <== PrivilegeMode.Machine
  mmu.mstatus <== bits(0, 64)
  mmu.satp <== bits(0, 64)
  mmu.invalidate_all <== Bool(#false)
  mmu.ordered_busy <== Bool(#false)
  mmu.prefetch.valid <== Bool(#false)
  mmu.prefetch.bits <== literal(CachePrefetchReq(64), 0)
  mmu.data.request.valid <== Bool(#false)
  mmu.pipeline.request.valid <== Bool(#false)
  mmu.pipeline.commit <== Bool(#false)
  mmu.pipeline.request.bits <== literal(RV5StagePipelineReq(XLen.X64), 0)
  mmu.pipeline_memory.response.valid <== Bool(#false)
  mmu.pipeline_memory.commit_ready <== Bool(#false)
  mmu.pipeline_memory.response.bits <== literal(RV5StagePipelineResult(XLen.X64), 0)
  mmu.data.request.bits <== literal(RV5StageDataReq(XLen.X64), 0)
  mmu.data_memory.request.ready <== Bool(#true)
  mmu.data_memory.request_fault <== Bool(#false)
  mmu.data_memory.request_access_fault <== Bool(#false)
  mmu.data_memory.response.valid <== Bool(#false)
  mmu.data_memory.response.bits <== literal(RV5StageDataResp(XLen.X64), 0)
  mmu.data_memory.drained <== Bool(#true)
  mmu.data_memory.reservation_valid <== Bool(#false)
  cache.node_id <== bits(2, 7)
  cache.prefetch.valid <== Bool(#false)
  cache.prefetch.bits <== literal(CachePrefetchReq(64), 0)
  def requests = cache.chi.req |> trace_event("icache/chi.txreq", ~fields: flit):
    address: flit.address
    allow_retry: flit.allow_retry
  requests |> chi.req
  chi.rsp.response |> cache.chi.rsp.response
  chi.dat.response |> cache.chi.dat.response
  cache.chi.rsp.requester |> chi.rsp.requester
  cache.chi.dat.request |> chi.dat.request
  trace_admit <== fetch.memory.request.fire()
  trace_address <== fetch.memory.request.bits.address
  trace_clear <== cache.core.flush ||| cache.core.invalidate_all
  trace_kill <== cache.core.s1_kill
  trace_outcome <== cache.core.response.valid
  trace_replay <== cache.core.response.bits.replay

export:
  RV5StageFetchThroughput
