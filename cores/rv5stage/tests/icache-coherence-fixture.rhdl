#lang rhodium
// Exercises nonsnooping instruction snapshots against a real dirty L1D and either Home implementation.
import:
  "../cache.rhdl" open
  "../icache/cache.rhdl" open
  "../icache/protocol.rhdl" open
  "../dcache/cache.rhdl" open
  "../dcache/protocol.rhdl" open
  "../chi/foundation.rhdl" open
  "params.rhdl" open
  lib("cores/cache-prefetch.rhdl").CachePrefetchReq
  lib("riscv/isa/xlen.rhm") open
  lib("chi/protocol/flits.rhdl") open
  lib("chi/home/coherent-home.rhdl") open
  lib("chi/home/inclusive-home.rhdl") open
  lib("rhodium/std/interconnect.rhdl").StripedAddressLayout
  lib("chi/subordinate/ram.rhdl") open
  lib("flow/main.rhdl") open

sync_circuit RV5StageInstructionCoherence(inclusive :: Boolean):
  def p = test_rv5stage_flit
  def config = test_rv5stage_chi_config
  def ram_config = CHIRamConfig(p, 65536, ~max_outstanding: 1, ~max_transfer_bytes: 64)
  def nodes = RV5StageCHIParams(config, 2, 3)
  def home_config = CHIHNFConfig(p, [nodes.instruction_home_port(~coherent: #true), nodes.data_node.icn_peer()], 65535, ram_config.requests)
  interface fetch(RV5StageInstructionLookup(RV5StageInstructionReq(XLen.X64)), ~role: responder)
  interface virtual_lookup(Decoupled(Bits(64)), ~role: consumer)
  interface host(RV5StageDataAccess(XLen.X64), ~role: responder)
  output instruction_request: Bool
  output instruction_fence: Bool
  inst icache(RV5StageL1ICache(XLen.X64, RV5StageCacheConfig(32, 1), ~chi: config))
  inst dcache(RV5StageL1DCache(XLen.X64, RV5StageCacheConfig(2, 1), ~chi: config))
  inst home(if inclusive | CHIInclusiveHNF(CHIInclusiveHNFConfig(home_config, StripedAddressLayout(65536, 64, 1), ~sets: 2, ~ways: 2)) | CHIHNF(home_config))
  inst ram(CHIRam(ram_config))
  fetch <=> icache.core
  virtual_lookup <=> icache.virtual_lookup
  host <=> dcache.core
  icache.node_id <== bits(2, p.node_id_width)
  dcache.node_id <== bits(3, p.node_id_width)
  icache.prefetch.valid <== Bool(#false)
  icache.prefetch.bits <== dont_care(CachePrefetchReq(64))
  dcache.virtual_lookup.valid <== host.request.valid
  dcache.virtual_lookup.bits <== host.request.bits.address
  dcache.pipeline_lookup.valid <== Bool(#false)
  dcache.pipeline_lookup.bits <== literal(RV5StagePipelineReq(XLen.X64), 0)
  dcache.pipeline.request.valid <== Bool(#false)
  dcache.pipeline.request.bits <== literal(RV5StagePipelineReq(XLen.X64), 0)
  dcache.pipeline.commit <== Bool(#false)
  dcache.prefetch.valid <== Bool(#false)
  dcache.prefetch.bits <== dont_care(CachePrefetchReq(64))
  home.identity <== CHIHNFIdentity(p):
    home_node_id: bits(1, p.node_id_width)
    subordinate_node_id: bits(9, p.node_id_width)
    service_base: bits(0, p.request_address_width)
  ram.identity <== CHIRamIdentity(p):
    node_id: bits(9, p.node_id_width)
    base_address: bits(0, p.request_address_width)
  home.port.subordinate.req |> queue(1) |> ram.port.req
  home.port.subordinate.dat.request |> queue(1) |> ram.port.dat.request
  ram.port.rsp |> queue(1) |> home.port.subordinate.rsp
  ram.port.dat.response |> queue(1) |> home.port.subordinate.dat.response
  Array(icache.chi.req, dcache.chi.requests) |> parallel(queue(1), queue(1)) |> rr_arbiter() |> home.port.requester.requests
  Array(icache.chi.rsp.requester, dcache.chi.requester_responses) |> parallel(queue(1), queue(1)) |> rr_arbiter() |> home.port.requester.requester_responses
  Array(icache.chi.dat.request, dcache.chi.request_data) |> parallel(queue(1), queue(1)) |> rr_arbiter() |> home.port.requester.request_data
  (home.port.requester.responses |> queue(1) |> demux_flow(2, response => (response.tgt_id === bits(3, p.node_id_width)).as_bits())) <=> Array(icache.chi.rsp.response, dcache.chi.responses)
  (home.port.requester.response_data |> queue(1) |> demux_flow(2, data => (data.tgt_id === bits(3, p.node_id_width)).as_bits())) <=> Array(icache.chi.dat.response, dcache.chi.response_data)
  home.port.requester.snoops |> queue(1) |> map_flow(dispatch => dispatch.flit) |> dcache.chi.snoops
  when (home.port.requester.snoops.valid):
    assert(home.port.requester.snoops.bits.target_id === bits(3, p.node_id_width), "instruction_snapshot_has_no_snoop_target")
  instruction_request <== icache.chi.req.fire()
  instruction_fence <== fetch.invalidate_all

export:
  RV5StageInstructionCoherence
