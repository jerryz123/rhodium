#lang rhombus
// Checks RV5Stage's host-side F/D control domains and operand metadata.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus.bits.(<<) as <<
  rhombus.bits.(>>) as >>
  "../../../rhodium/frontend/layers/bool.rhm" as bool
  "../../../rhodium/frontend/support/hardware-literal.rhm".PackedLiteral
  "../../../riscv/isa/fp-profile.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/isa/f.rhm" as f
  "../../../riscv/isa/d.rhm" as d
  "../../../riscv/isa/zfhmin.rhm" as zfhmin
  "../../../riscv/isa/zfh.rhm" as zfh
  "../../../riscv/isa/zfa.rhm" as zfa
  "../../../riscv/rtl/instruction-pattern.rhdl" open
  "../decode/fp-ctrl.rhdl" as controls
  lib("rhodium/std/decode.rhdl") open
  lib("hardfloat/main.rhdl").MinMaxOperation

fun exact_pattern_equal(left, right):
  left.type.type_equal(right.type) && right.type.type_equal(left.type) && left.width == right.width && left.value_bits == right.value_bits && left.care_bits == right.care_bits

fun has_domain(cases, instructions):
  def domain = instructions.map(instruction_pattern)
  cases.length() == domain.length() && (
    for all (expected in domain):
      cases.filter(~keep: fun (candidate): exact_pattern_equal(candidate.input, expected)).length() == 1
  )

fun control_for(cases, instruction):
  cases.find(fun (candidate): exact_pattern_equal(candidate.input, instruction_pattern(instruction))).output

fun field_pattern(cube, name):
  def mutable field = #false
  def mutable lower_width = 0
  for (declared in cube.type.fields):
    cond
    | field: lower_width := lower_width + declared.type.packed_width()
    | declared.name == name: field := declared
    | ~else: #void
  unless field
  | error(~who: #'field_pattern, "unknown record field")
  def width = field.type.packed_width()
  def mask = (1 << width) - 1
  Pattern(
    ~value: PackedLiteral(field.type, (cube.value_bits >> lower_width) bits.and mask),
    ~care: PackedLiteral(field.type, (cube.care_bits >> lower_width) bits.and mask)
  )

def fmadd = control_for(controls.RV64FDFloatingPointControlCases, f.FMADD_S)
def fmadd_registers = field_pattern(fmadd, "registers")
def fmadd_execution = field_pattern(fmadd, "execution")
def store_registers = field_pattern(control_for(controls.RV64FDFloatingPointControlCases, d.FSD), "registers")
def compare_registers = field_pattern(control_for(controls.RV64FDFloatingPointControlCases, d.FEQ_D), "registers")
def base_min_execution = field_pattern(control_for(controls.RV64FDFloatingPointControlCases, f.FMIN_S), "execution")
def base_equal_execution = field_pattern(control_for(controls.RV64FDFloatingPointControlCases, f.FEQ_S), "execution")
def base_less_execution = field_pattern(control_for(controls.RV64FDFloatingPointControlCases, f.FLT_S), "execution")
def convert_execution = field_pattern(control_for(controls.RV64FDFloatingPointControlCases, d.FCVT_S_D), "execution")
def zfhmin_cases = controls.rv5stage_floating_point_control_cases(XLen.X32, FloatingPointProfile.F, HalfPrecisionProfile.Zfhmin)
def zfh_cases = controls.rv5stage_floating_point_control_cases(XLen.X64, FloatingPointProfile.D, HalfPrecisionProfile.Zfh)
def half_add_execution = field_pattern(control_for(zfh_cases, zfh.FADD_H), "execution")
def half_load_execution = field_pattern(control_for(zfhmin_cases, zfhmin.FLH), "execution")
def zfa_f_cases = controls.rv5stage_floating_point_control_cases(XLen.X32, FloatingPointProfile.F, HalfPrecisionProfile.None, ~zfa: #true)
def zfa_d_half_cases = controls.rv5stage_floating_point_control_cases(XLen.X64, FloatingPointProfile.D, HalfPrecisionProfile.Zfh, ~zfa: #true)
def fli_registers = field_pattern(control_for(zfa_f_cases, zfa.FLI_S), "registers")
def fli_execution = field_pattern(control_for(zfa_f_cases, zfa.FLI_S), "execution")
def minm_execution = field_pattern(control_for(zfa_f_cases, zfa.FMINM_S), "execution")
def round_execution = field_pattern(control_for(zfa_f_cases, zfa.FROUNDNX_S), "execution")
def quiet_execution = field_pattern(control_for(zfa_f_cases, zfa.FLTQ_S), "execution")
def modulo_control = control_for(zfa_d_half_cases, zfa.FCVTMOD_W_D)
def modulo_registers = field_pattern(modulo_control, "registers")
def modulo_execution = field_pattern(modulo_control, "execution")

check:
  controls.SingleExecutionCases.length() ~is 26
  controls.RV64SingleExecutionCases.length() ~is 30
  controls.DoubleExecutionCases.length() ~is 26
  controls.RV64DoubleExecutionCases.length() ~is 32
  has_domain(controls.RV32FFloatingPointControlCases, controls.RV32FFloatingPointInstructions) ~is #true
  has_domain(controls.RV64FFloatingPointControlCases, controls.RV64FFloatingPointInstructions) ~is #true
  has_domain(controls.RV32FDFloatingPointControlCases, controls.RV32FDFloatingPointInstructions) ~is #true
  has_domain(controls.RV64FDFloatingPointControlCases, controls.RV64FDFloatingPointInstructions) ~is #true
  controls.RV32FFloatingPointControlCases.length() ~is 26
  controls.RV64FFloatingPointControlCases.length() ~is 30
  controls.RV32FDFloatingPointControlCases.length() ~is 52
  controls.RV64FDFloatingPointControlCases.length() ~is 62
  has_domain(zfhmin_cases, controls.rv5stage_floating_point_instructions(XLen.X32, FloatingPointProfile.F, HalfPrecisionProfile.Zfhmin)) ~is #true
  has_domain(zfh_cases, controls.rv5stage_floating_point_instructions(XLen.X64, FloatingPointProfile.D, HalfPrecisionProfile.Zfh)) ~is #true
  zfhmin_cases.length() ~is 32
  zfh_cases.length() ~is 96
  zfa_f_cases.length() ~is 33
  zfa_d_half_cases.length() ~is 118
  has_domain(zfa_f_cases, controls.rv5stage_floating_point_instructions(XLen.X32, FloatingPointProfile.F, HalfPrecisionProfile.None, ~zfa: #true)) ~is #true
  has_domain(zfa_d_half_cases, controls.rv5stage_floating_point_instructions(XLen.X64, FloatingPointProfile.D, HalfPrecisionProfile.Zfh, ~zfa: #true)) ~is #true
  field_pattern(half_load_execution, "destination_precision").matches(controls.RV5StageFloatPrecision.Half) ~is #true
  field_pattern(half_add_execution, "unit").matches(controls.RV5StageFloatUnit.Add) ~is #true
  field_pattern(half_add_execution, "source_precision").matches(controls.RV5StageFloatPrecision.Half) ~is #true
  field_pattern(fmadd_registers, "uses_integer_rs1").matches(bool.Bool(#false)) ~is #true
  field_pattern(fmadd_registers, "uses_frs1").matches(bool.Bool(#true)) ~is #true
  field_pattern(fmadd_registers, "uses_frs2").matches(bool.Bool(#true)) ~is #true
  field_pattern(fmadd_registers, "uses_frs3").matches(bool.Bool(#true)) ~is #true
  field_pattern(fmadd_registers, "destination").matches(controls.RV5StageFloatDestination.FloatingPoint) ~is #true
  field_pattern(fmadd_execution, "unit").matches(controls.RV5StageFloatUnit.FusedMultiplyAdd) ~is #true
  field_pattern(fmadd_execution, "uses_rounding_mode").matches(bool.Bool(#true)) ~is #true
  field_pattern(store_registers, "uses_integer_rs1").matches(bool.Bool(#true)) ~is #true
  field_pattern(store_registers, "uses_frs2").matches(bool.Bool(#true)) ~is #true
  field_pattern(store_registers, "destination").matches(controls.RV5StageFloatDestination.None) ~is #true
  field_pattern(compare_registers, "destination").matches(controls.RV5StageFloatDestination.Integer) ~is #true
  field_pattern(base_min_execution, "minmax_operation").matches(MinMaxOperation.MinimumNumber) ~is #true
  field_pattern(base_equal_execution, "comparison_signaling").matches(bool.Bool(#false)) ~is #true
  field_pattern(base_less_execution, "comparison_signaling").matches(bool.Bool(#true)) ~is #true
  field_pattern(convert_execution, "source_precision").matches(controls.RV5StageFloatPrecision.Double) ~is #true
  field_pattern(convert_execution, "destination_precision").matches(controls.RV5StageFloatPrecision.Single) ~is #true
  field_pattern(fli_registers, "uses_integer_rs1").matches(bool.Bool(#false)) ~is #true
  field_pattern(fli_registers, "uses_frs1").matches(bool.Bool(#false)) ~is #true
  field_pattern(fli_registers, "destination").matches(controls.RV5StageFloatDestination.FloatingPoint) ~is #true
  field_pattern(fli_execution, "unit").matches(controls.RV5StageFloatUnit.Immediate) ~is #true
  field_pattern(minm_execution, "minmax_operation").matches(MinMaxOperation.Minimum) ~is #true
  field_pattern(round_execution, "unit").matches(controls.RV5StageFloatUnit.RoundToIntegral) ~is #true
  field_pattern(round_execution, "uses_rounding_mode").matches(bool.Bool(#true)) ~is #true
  field_pattern(round_execution, "round_raise_inexact").matches(bool.Bool(#true)) ~is #true
  field_pattern(quiet_execution, "comparison_signaling").matches(bool.Bool(#false)) ~is #true
  field_pattern(modulo_registers, "destination").matches(controls.RV5StageFloatDestination.Integer) ~is #true
  field_pattern(modulo_execution, "unit").matches(controls.RV5StageFloatUnit.IntegerModulo) ~is #true
  controls.rv5stage_floating_point_profile_supported(XLen.X32, FloatingPointProfile.F) ~is #true
  controls.rv5stage_floating_point_profile_supported(XLen.X64, FloatingPointProfile.D) ~is #true
  controls.rv5stage_floating_point_profile_supported(XLen.X32, FloatingPointProfile.D) ~is #false
  controls.rv5stage_floating_point_profile_supported(XLen.X64, FloatingPointProfile.F) ~is #false
  controls.rv5stage_floating_point_profile_supported(XLen.X64, FloatingPointProfile.None, ~zfa: #true) ~is #false
