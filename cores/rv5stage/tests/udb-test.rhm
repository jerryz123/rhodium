#lang rhombus
// Checks RV5Stage profile projection into UDB extension and parameter claims.

import:
  "../profile.rhm" open
  "../udb.rhm" open
  "../../../riscv/isa/c.rhm" open
  "../../../riscv/isa/fp-profile.rhm" open
  "../../../riscv/isa/xlen.rhm".XLen

def rv64_double = RVCoreProfile(
  ~xlen: XLen.X64,
  ~extensions: RV5StageExtensions(
    ~floating_point: FloatingPointProfile.D,
    ~zicbop: #true,
    ~zicboz: #true,
    ~compressed: CCompressedExtensions
  ),
  ~mmu_mode: RV5StageMmuMode.Sv39
)
def rv64_yaml = rv5stage_udb_configuration(
  rv64_double,
  "rhodium-rv5stage-rv64dc",
  "RV5Stage RV64D+C configuration",
  44
).to_yaml()

check:
  rv64_yaml.contains("{ name: \"Zicboz\", version: \"= 1.0.0\" }") ~is #true
  rv64_yaml.contains("name: \"rhodium-rv5stage-rv64dc\"") ~is #true
  rv64_yaml.contains("{ name: \"D\", version: \"= 2.2.0\" }") ~is #true
  rv64_yaml.contains("{ name: \"C\", version: \"= 2.0\" }") ~is #true
  rv64_yaml.contains("{ name: \"Zca\", version: \"= 1.0.0\" }") ~is #true
  rv64_yaml.contains("{ name: \"Zcd\", version: \"= 1.0.0\" }") ~is #true
  rv64_yaml.contains("{ name: \"Zicbop\", version: \"= 1.0.0\" }") ~is #true
  rv64_yaml.contains("{ name: \"Zimop\", version: \"= 1.0.0\" }") ~is #true
  rv64_yaml.contains("{ name: \"S\", version: \"= 1.11.0\" }") ~is #true
  rv64_yaml.contains("{ name: \"Sm\", version: \"= 1.11.0\" }") ~is #true
  rv64_yaml.contains("{ name: \"Sv39\", version: \"= 1.0.0\" }") ~is #true
  rv64_yaml.contains("{ name: \"Svade\",") ~is #false
  rv64_yaml.contains("  PHYS_ADDR_WIDTH: 44") ~is #true
  rv64_yaml.contains("  CACHE_BLOCK_SIZE: 64") ~is #true
  rv64_yaml.contains("  ASID_WIDTH: 0") ~is #true
  rv64_yaml.contains("  NUM_PMP_ENTRIES: 0") ~is #true
  rv64_yaml.contains("  MISALIGNED_LDST: false") ~is #true
  rv64_yaml.contains("  LRSC_FAIL_ON_NON_EXACT_LRSC: true") ~is #true
  rv64_yaml.contains("  MSTATUS_FS_LEGAL_VALUES: [0, 1, 2, 3]") ~is #true

def rv32_integer = RVCoreProfile(~xlen: XLen.X32)
def rv32_yaml = rv5stage_udb_configuration(
  rv32_integer,
  "rhodium-rv5stage-rv32",
  "RV5Stage RV32 integer configuration",
  32
).to_yaml()

check:
  rv32_yaml.contains("{ name: \"F\",") ~is #false
  rv32_yaml.contains("{ name: \"C\",") ~is #false
  rv32_yaml.contains("{ name: \"Sv39\",") ~is #false
  rv32_yaml.contains("{ name: \"Svbare\", version: \"= 1.0.0\" }") ~is #true
  rv32_yaml.contains("  MSTATUS_FS_LEGAL_VALUES: [0]") ~is #true
  rv5stage_udb_configuration(
    rv32_integer,
    "invalid-rv32-address-width",
    "Invalid RV32 address width",
    33
  ) ~throws "must not exceed 32"
