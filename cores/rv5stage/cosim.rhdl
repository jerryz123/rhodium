#lang rhodium
/* Builds the deferred scalar hart observer from explicit taps when selected by an RTL pass. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/kernel.rhm").input as observer_input
  "cosim-support.rhdl" open
  "profile.rhm".RV5StageConfig
  "bundles.rhdl".MemoryWriteback
  "../../riscv/isa/trap.rhm".ExceptionCause
  "../../riscv/rtl/trap.rhdl" open
  "../../riscv/rtl/privilege.rhdl".RiscvTrapTarget
  "../../riscv/rtl/privilege.rhdl".PrivilegeMode
  "../riscv/cosim.rhdl" open
  "../load-store.rhdl" open
  "dcache/protocol.rhdl" open
  "memory.rhdl" open
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/isa/csr.rhm" open
  "../../riscv/rtl/csr.rhdl".csr_bits
  "../../riscv/rtl/atomic.rhdl" open
  lib("flow/main.rhdl") open
  lib("rhodium/std/bits.rhdl") open

/* Resolve the host-owned reset epoch while reset is asserted; no functional input is added. */
dpi_import function rhodium_cosim_epoch(instance: Bits(64)) -> epoch: Bits(64)

/* Capture only host configuration; all live values are supplied as explicit remapped ports. */
fun rv5stage_cosim_recipe(profile :: RV5StageConfig):
  fun (types :: Map, parameters :: Map, instance :: Nat):
    elaborate_with_top(RV5StageCosimObserver(profile, types, parameters["csr"], instance))

/* Realizes scalar architectural ownership only when selected by the compilation pass. */
sync_circuit RV5StageCosimObserver(profile :: RV5StageConfig, tap_types :: Map, csr_addresses :: List.of(CsrId), instance :: Nat):
  def xlen = profile.xlen
  def width = xlen.width
  def hypervisor = profile.extensions.hypervisor
  def vector_completion_slots = profile.vector_completion_slots
  def cosim_instance = bits(instance, 64)
  dpi_reg cosim_epoch = rhodium_cosim_epoch(cosim_instance, ~enable: reset_active().into(Bool))
  def wb_maintenance_accepted :: Bool = observer_input("wb_maintenance_accepted", tap_types["wb_maintenance_accepted"])
  def wb_reservation_wait_accept :: Bool = observer_input("wb_reservation_wait_accept", tap_types["wb_reservation_wait_accept"])
  def wb_commit_valid :: Bool = observer_input("wb_commit_valid", tap_types["wb_commit_valid"])
  def wb_maintenance_pending :: Bool = observer_input("wb_maintenance_pending", tap_types["wb_maintenance_pending"])
  def wb_reservation_wait_pending :: Bool = observer_input("wb_reservation_wait_pending", tap_types["wb_reservation_wait_pending"])
  def wb_pending_exception_valid :: Bool = observer_input("wb_pending_exception_valid", tap_types["wb_pending_exception_valid"])
  def wb_current_exception_wait :: Bool = observer_input("wb_current_exception_wait", tap_types["wb_current_exception_wait"])
  def wb_memory_accepted :: Bool = observer_input("wb_memory_accepted", tap_types["wb_memory_accepted"])
  def wb_attempt :: Bool = observer_input("wb_attempt", tap_types["wb_attempt"])
  def wb_data_fault :: Bool = observer_input("wb_data_fault", tap_types["wb_data_fault"])
  def wb_commit_has_multiply :: Bool = observer_input("wb_commit_has_multiply", tap_types["wb_commit_has_multiply"])
  def wb_commit_has_divide :: Bool = observer_input("wb_commit_has_divide", tap_types["wb_commit_has_divide"])
  def wb_offer_bits :: MemoryWriteback(xlen, vector_completion_slots, hypervisor) = observer_input("wb_offer_bits", tap_types["wb_offer_bits"])
  def wb_commit_bits :: MemoryWriteback(xlen, vector_completion_slots, hypervisor) = observer_input("wb_commit_bits", tap_types["wb_commit_bits"])
  def wb_input_bits :: MemoryWriteback(xlen, vector_completion_slots, hypervisor) = observer_input("wb_input_bits", tap_types["wb_input_bits"])
  def resume_pc :: Bits(width) = observer_input("resume_pc", tap_types["resume_pc"])
  def response_fire :: Bool = observer_input("response_fire", tap_types["response_fire"])
  def memory_request :: RV5StageDataReq(xlen, vector_completion_slots) = observer_input("memory_request", tap_types["memory_request"])
  def memory_response :: RV5StageDataResp(xlen, vector_completion_slots) = observer_input("memory_response", tap_types["memory_response"])
  def write_valid :: Bool = observer_input("write_valid", tap_types["write_valid"])
  def write_rd :: Bits(5) = observer_input("write_rd", tap_types["write_rd"])
  def write_data :: Bits(width) = observer_input("write_data", tap_types["write_data"])
  def arithmetic_done :: Vec(2, Bool) = observer_input("arithmetic_done", tap_types["arithmetic_done"])
  def arithmetic_rd :: Vec(2, Bits(5)) = observer_input("arithmetic_rd", tap_types["arithmetic_rd"])
  def arithmetic_value :: Vec(2, Bits(width)) = observer_input("arithmetic_value", tap_types["arithmetic_value"])
  def csr_interrupt_take :: Bool = observer_input("csr_interrupt_take", tap_types["csr_interrupt_take"])
  def csr_synchronous_trap :: Bool = observer_input("csr_synchronous_trap", tap_types["csr_synchronous_trap"])
  def csr_commit :: Bool = observer_input("csr_commit", tap_types["csr_commit"])
  def csr_retired :: Bool = observer_input("csr_retired", tap_types["csr_retired"])
  def csr_privilege :: PrivilegeMode = observer_input("csr_privilege", tap_types["csr_privilege"])
  def csr_virtualized :: Bool = observer_input("csr_virtualized", tap_types["csr_virtualized"])
  def csr_trap_cause :: Bits(width) = observer_input("csr_trap_cause", tap_types["csr_trap_cause"])
  def csr_trap_target :: RiscvTrapTarget = observer_input("csr_trap_target", tap_types["csr_trap_target"])
  def csr_trap_pc :: Bits(width) = observer_input("csr_trap_pc", tap_types["csr_trap_pc"])
  def csr_trap_value :: Bits(width) = observer_input("csr_trap_value", tap_types["csr_trap_value"])
  def csr_redirect :: Bits(width) = observer_input("csr_redirect", tap_types["csr_redirect"])
  def csr_mret :: Bool = observer_input("csr_mret", tap_types["csr_mret"])
  def csr_sret :: Bool = observer_input("csr_sret", tap_types["csr_sret"])
  def csr_mret_privilege :: PrivilegeMode = observer_input("csr_mret_privilege", tap_types["csr_mret_privilege"])
  def csr_sret_privilege :: PrivilegeMode = observer_input("csr_sret_privilege", tap_types["csr_sret_privilege"])
  def csr_trap_to_guest :: Bool = observer_input("csr_trap_to_guest", tap_types["csr_trap_to_guest"])
  def csr_fault_details_valid :: Bool = observer_input("csr_fault_details_valid", tap_types["csr_fault_details_valid"])
  def csr_guest_page_fault :: Bool = observer_input("csr_guest_page_fault", tap_types["csr_guest_page_fault"])
  def csr_fault_gpa :: Bits(64) = observer_input("csr_fault_gpa", tap_types["csr_fault_gpa"])
  def csr_fault_inst :: Bits(64) = observer_input("csr_fault_inst", tap_types["csr_fault_inst"])
  def csr_returned_virtual :: Bool = observer_input("csr_returned_virtual", tap_types["csr_returned_virtual"])
  def wb_cosim_hooks = CosimHart(#false, cosim_instance)
  def wb_cosim_active = !reset_active().into(Bool)
  reg wb_cosim_order(~init: bits(0, 64))
  def wb_cosim_allocate = wb_cosim_active & (wb_maintenance_accepted ||| wb_reservation_wait_accept ||| (wb_commit_valid & !wb_maintenance_pending & !wb_reservation_wait_pending))
  def wb_cosim_new_id = CosimInstructionId():
    epoch: cosim_epoch
    order: wb_cosim_order
  reg wb_cosim_retained(CosimInstructionId())
  reg wb_cosim_exception(CosimInstructionId())
  def wb_cosim_id = mux(wb_pending_exception_valid, wb_cosim_exception, mux(wb_maintenance_pending ||| wb_reservation_wait_pending, wb_cosim_retained, wb_cosim_new_id))
  when (wb_cosim_allocate ||| (wb_cosim_active & csr_interrupt_take)):
    assert(!wb_cosim_order.and_reduce(), "cosim_order_does_not_wrap")
    wb_cosim_order <== wb_cosim_order + bits(1, 64)
  when (wb_maintenance_accepted ||| wb_reservation_wait_accept):
    wb_cosim_retained <== wb_cosim_new_id
  when wb_current_exception_wait:
    wb_cosim_exception <== wb_cosim_id
  def wb_cosim_instruction = mux(wb_reservation_wait_accept, wb_input_bits, wb_offer_bits)
  def wb_cosim_fetch_fault = wb_cosim_instruction.exception_valid & wb_cosim_instruction.exception_cause.is_one_of([ExceptionCause.InstructionAccessFault, ExceptionCause.InstructionPageFault, ExceptionCause.InstructionGuestPageFault].map(fun (cause): exception_cause_bits(cause, width)))
  def wb_cosim_bytes = mux(wb_cosim_instruction.raw_instruction[0..2] === bits(3, 2), bits(4, 3), bits(2, 3))
  def wb_cosim_header = CosimInstruction():
    pc: rv5stage_cosim_lane(wb_cosim_instruction.pc)
    encoding: wb_cosim_instruction.raw_instruction
    encoding_valid_bytes: mux(wb_cosim_fetch_fault, bits(0, 3), wb_cosim_bytes)
    instruction_bytes: mux(wb_cosim_fetch_fault, bits(0, 3), wb_cosim_bytes)
    privilege: csr_privilege
    virtualized: csr_virtualized
    producers: bits(7, 64)
  wb_cosim_hooks.instruction(wb_cosim_allocate, wb_cosim_new_id, wb_cosim_header)

  def wb_cosim_slow = wb_cosim_active & wb_memory_accepted
  def wb_cosim_response = wb_cosim_active & response_fire
  def wb_cosim_memory_context = RV5StageCosimMemoryOwner(xlen, vector_completion_slots):
    instruction_id: wb_cosim_id
    request: memory_request
  def wb_cosim_memory_owner :: RV5StageCosimMemoryOwner(xlen, vector_completion_slots) = rv5stage_cosim_owner(RV5StageCosimMemoryOwner(xlen, vector_completion_slots), wb_cosim_slow, wb_cosim_memory_context, wb_cosim_response)
  when wb_cosim_response:
    assert(wb_cosim_memory_owner.request.writeback === memory_response.writeback, "cosim_memory_response_order")
  rv5stage_cosim_memory(xlen, vector_completion_slots, wb_cosim_hooks, wb_cosim_memory_owner.instruction_id, wb_cosim_response, wb_cosim_memory_owner.request, memory_response.data, memory_response.access_fault)
  def wb_cosim_memory_gpr = wb_cosim_memory_owner.request.writeback.is(RV5StageMemoryWriteback(vector_completion_slots).Integer).into(Bool)
  def wb_cosim_memory_rd = wb_cosim_memory_owner.request.writeback.view(RV5StageMemoryWriteback(vector_completion_slots).Integer).payload
  rv5stage_cosim_gpr(wb_cosim_hooks, wb_cosim_memory_owner.instruction_id, wb_cosim_response & wb_cosim_memory_gpr & wb_cosim_memory_rd.or_reduce(), Bool(#true), wb_cosim_memory_rd, memory_response.data)
  def wb_cosim_access = wb_attempt & wb_offer_bits.data_request.access.into(RV5StageMemoryOperation).is_memory()
  rv5stage_cosim_memory(xlen, vector_completion_slots, wb_cosim_hooks, wb_cosim_id, wb_cosim_allocate & wb_cosim_access & !wb_cosim_slow, wb_offer_bits.data_request, wb_commit_bits.value, wb_data_fault)
  wb_cosim_hooks.seal(wb_cosim_allocate & !wb_cosim_access, wb_cosim_id, bits(2, 6), bits(0, 64))
  def wb_cosim_load_result = wb_cosim_slow & memory_request.writeback.is(RV5StageMemoryWriteback(vector_completion_slots).Integer).into(Bool) & wb_commit_bits.rd.or_reduce()
  rv5stage_cosim_gpr(wb_cosim_hooks, wb_cosim_id, wb_cosim_allocate & !wb_cosim_load_result & !wb_commit_has_multiply & !wb_commit_has_divide, write_valid & csr_retired, write_rd, write_data)
  for (index in 0..2, accepted in [wb_commit_has_multiply, wb_commit_has_divide]):
    def completed = wb_cosim_active & arithmetic_done[index]
    def context = RV5StageCosimArithmeticOwner():
      instruction_id: wb_cosim_id
      rd: wb_commit_bits.rd
    def owner :: RV5StageCosimArithmeticOwner() = rv5stage_cosim_owner(RV5StageCosimArithmeticOwner(), wb_cosim_active & accepted, context, completed)
    when completed:
      assert(owner.rd === arithmetic_rd[index], "cosim_arithmetic_response_order")
    rv5stage_cosim_gpr(wb_cosim_hooks, owner.instruction_id, completed, Bool(#true), arithmetic_rd[index], arithmetic_value[index])

  def target_privilege = mux(csr_trap_target === RiscvTrapTarget.Machine, PrivilegeMode.Machine, PrivilegeMode.Supervisor)
  def trap_observation = CosimTrap():
    cause: rv5stage_cosim_lane(csr_trap_cause & !(bits(1, width) << (width - 1)))
    epc: rv5stage_cosim_lane(csr_trap_pc)
    tval: rv5stage_cosim_lane(csr_trap_value)
    target_pc: rv5stage_cosim_lane(csr_redirect)
    privilege: target_privilege
    virtualized: csr_trap_to_guest
    guest_valid: Bool(hypervisor) & csr_fault_details_valid & csr_guest_page_fault
    htval: csr_fault_gpa
    htinst: csr_fault_inst
  wb_cosim_hooks.exception(wb_cosim_active & csr_synchronous_trap, wb_cosim_id, trap_observation)
  wb_cosim_hooks.interrupt(wb_cosim_active & csr_interrupt_take, wb_cosim_id, trap_observation, bits(2, 64))
  def cosim_retirement = CosimRetirement():
    next_pc: rv5stage_cosim_lane(mux(csr_mret ||| csr_sret, csr_redirect, resume_pc))
    privilege: mux(csr_mret, csr_mret_privilege, mux(csr_sret, csr_sret_privilege, csr_privilege))
    virtualized: mux(csr_mret ||| csr_sret, csr_returned_virtual, csr_virtualized)
  wb_cosim_hooks.retire(wb_cosim_active & csr_retired, wb_cosim_id, cosim_retirement)

  def entries = for List (address in csr_addresses, index in 0..csr_addresses.length()):
    RV5StageCosimCsr(address, observer_input("csr_value_" ++ to_string(index), tap_types["csr_value_" ++ to_string(index)]), observer_input("csr_eligible_" ++ to_string(index), Bool))
  rv5stage_cosim_csrs(wb_cosim_hooks, wb_cosim_active & (csr_commit ||| csr_interrupt_take), wb_cosim_id, entries)

export rv5stage_cosim_recipe
