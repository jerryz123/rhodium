#lang rhodium
// Routes permitted data accesses between L1D and a completion-owned IO-MSHR.

import:
  "../load-store.rhdl".MemoryWidth
  "memory.rhdl" open
  "profile.rhm".RV5StageCacheLineBytes
  "dcache/protocol.rhdl" open
  "dcache/io-mshr.rhdl".RV5StageIOMSHR
  "uncached-protocol.rhdl" open
  "../../riscv/isa/xlen.rhm".XLen
  "../../riscv/rtl/pma.rhdl" open
  "../../riscv/rtl/cmo.rhdl" open
  lib("flow/main.rhdl") open
  lib("rhodium/std/bits.rhdl") open

sync_circuit RV5StageMemoryRouter(xlen :: XLen,
                                  physical_map :: RiscvPhysicalMemoryMap):
  interface core(RV5StageDataAccess(xlen), ~role: responder)
  interface cache(RV5StageDataAccess(xlen), ~role: requester)
  interface uncached(RV5StageUncachedDataAccess(xlen), ~role: requester)
  inst uncached_management(ValidPipe(RV5StageDataResp(xlen), 1))

  inst io_mshr(RV5StageIOMSHR(xlen))
  io_mshr.memory |> uncached

  def request :: RV5StageDataReq(xlen) = core.request.bits
  def operation = request.access
  def last_byte_offset :: Bits(xlen.width) = mux_lookup(
    request.width,
    ~default: bits(7, xlen.width),
    [[MemoryWidth.Byte, bits(0, xlen.width)],
     [MemoryWidth.Half, bits(1, xlen.width)],
     [MemoryWidth.Word, bits(3, xlen.width)]]
  )
  def zero_block = operation.is_cache_block_zero()
  def management = operation.is_cache_management()
  def first_address = mux(operation.is_cache_block(), request.address.align_down(RV5StageCacheLineBytes), request.address)
  def last_address = first_address +& mux(operation.is_cache_block(), bits(RV5StageCacheLineBytes - 1, xlen.width), last_byte_offset)
  def physical = physical_map.lookup(first_address, last_address)
  def request_reads = operation.is_load() ||| operation.is_atomic()
  def request_writes = operation.needs_unique()
  def request_is_atomic = operation.is_one_of(MemoryOperation.LoadReserved,
                                              MemoryOperation.StoreConditional,
                                              MemoryOperation.Atomic)
  def ordinary_permitted = physical.mapped & (!request_reads ||| physical.readable) & (
    !request_writes ||| physical.writable
  ) & (!request_is_atomic ||| physical.atomic) & (!zero_block ||| physical.cache_block_zero)
  def request_permitted = mux(management, cbo_management_physical_permission(physical), ordinary_permitted)
  def request_is_uncached = !physical.cacheable
  // Readiness reports registered slot availability. Unlike drained it does
  // not include a same-cycle acceptance, avoiding a cross-path ready loop.
  def cache_available = io_mshr.core.request.ready & !uncached_management.egress.valid
  def uncached_available = cache.drained & !uncached_management.egress.valid
  def Array(cache_requests, uncached_requests, management_requests) = (
    core.request
      |> filter_flow(_request => request_permitted)
      |> demux_flow(3, _request => mux(management & request_is_uncached, bits(2, 2), request_is_uncached.as_bits().zext(2)))
  )
  // The static physical map forbids cached copies of these regions. After
  // permission checks and older traffic drain, maintenance needs no device IO.
  (
    management_requests |> gate_flow(cache.drained & io_mshr.core.request.ready)
      |> to_valid() |> map_valid(request => RV5StageDataResp(xlen)):
         access_fault: Bool(#false)
         data: bits(0, xlen.width)
         destination: request.destination
         rd: request.rd
         floating_point_precision: request.floating_point_precision
  ) |> uncached_management.ingress
  cache_requests |> gate_flow(cache_available) |> cache.request
  (
    uncached_requests
      |> gate_flow(uncached_available)
      |> map_flow(request => RV5StageUncachedDataReq(xlen)):
          request: request
          device: physical.device
  ) |> io_mshr.core.request
  core.request_fault <== core.request.valid & request_permitted & !(management & request_is_uncached) & mux(
    request_is_uncached,
    io_mshr.core.request_fault,
    cache.request_fault
  )
  core.request_access_fault <== core.request.valid & (!request_permitted ||| (!(management & request_is_uncached) & mux(
    request_is_uncached,
    io_mshr.core.request_access_fault,
    cache.request_access_fault
  )))
  Array(uncached_management.egress, io_mshr.core.response, cache.response) |> valid_arbiter() |> core.response
  core.drained <== cache.drained & io_mshr.core.drained & !uncached_management.egress.valid & !management_requests.fire()
  core.reservation_valid <== cache.reservation_valid
  assert(!(cache.response.valid & io_mshr.core.response.valid),
         "rv5stage_memory_response_paths_exclusive")

export:
  RV5StageMemoryRouter
