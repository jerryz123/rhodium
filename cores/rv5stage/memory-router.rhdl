#lang rhodium
/* Routes permitted data accesses between L1D and a completion-owned IO-MSHR. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../common/cache/access.rhdl" open
  "memory-context.rhdl" open
  "../common/cache/protocol.rhdl" open
  "../common/cache/operation.rhdl" open
  "../common/cache/io-mshr.rhdl".IOMSHR
  "../common/cache/ordered-service.rhdl".OrderedMemoryService
  "uncached-protocol.rhdl" open
  "../../riscv/isa/xlen.rhm".XLen
  "../../riscv/rtl/pma.rhdl" open
  "../../riscv/rtl/svpbmt.rhdl" open
  lib("flow/main.rhdl") open
  lib("rhodium/std/bits.rhdl") open

/* Resolves PMA/PBMT permissions over the whole access and excludes cached/uncached overlap.
   Permitted uncached maintenance completes locally after older traffic drains. */
sync_circuit RV5StageMemoryRouter(xlen :: XLen,
                                  physical_map :: RiscvPhysicalMemoryMap,
                                  ~vector_completion_slots: vector_completion_slots :: Pow2Int = 8):
  interface core(RV5StagePhysicalDataAccess(xlen, vector_completion_slots), ~role: responder)
  interface cache(CacheAccess(xlen, RV5StageMemoryContext(vector_completion_slots)), ~role: requester)
  interface uncached(UncachedMemoryAccess(xlen, RV5StageMemoryContext(vector_completion_slots)), ~role: requester)
  output ordered_busy: Bool


  /* Retained uncached capacity
     Request capacity is independent of the response sink to avoid a flush-ready loop. */

  inst ordering(OrderedMemoryService(PhysicalMemoryReq(xlen, RV5StageMemoryContext(vector_completion_slots)), UncachedMemoryReq(xlen, RV5StageMemoryContext(vector_completion_slots)), PhysicalMemoryResp(xlen, RV5StageMemoryContext(vector_completion_slots))))
  inst io_mshr(IOMSHR(xlen, RV5StageMemoryContext(vector_completion_slots)))
  io_mshr.memory |> uncached


  /* Full-access permission classification
     Check both endpoints of a scalar access or the complete cache-block operation. */

  def request :: PhysicalMemoryReq(xlen, RV5StageMemoryContext(vector_completion_slots)) = core.request.bits.memory
  def operation = request.access
  def management = operation.is_cache_management()
  def physical = cache_access_region(xlen, physical_map, request.address, request.width, operation)
  def attributes = resolve_memory_attributes(physical, core.request.bits.pbmt)
  def request_permitted = cache_access_permitted(physical, operation, ~reads: operation.returns_old_value(), ~writes: operation.needs_unique())
  // Maintenance must still reach cached aliases when PBMT disables allocation.
  def request_is_uncached = !mux(management, physical.cacheable, attributes.cacheable)
  def local_management = management & request_is_uncached


  /* Ordered path admission
     Cached and uncached traffic exclude one another; local maintenance waits for both to drain. */

  // Readiness reports registered slot availability. Unlike drained it does
  // not include a same-cycle acceptance, avoiding a cross-path ready loop.
  ordering.cache_drained <== cache.drained
  ordering.io_drained <== io_mshr.core.drained
  ordering.io_available <== io_mshr.core.request.ready
  ordered_busy <== ordering.ordered_busy
  ordering.cache_request |> cache.request
  ordering.io_request |> io_mshr.core.request
  def Array(cache_requests, uncached_requests, management_requests) = (
    core.request
      |> filter_flow(_request => request_permitted)
      |> map_flow(request => request.memory)
      |> demux_flow(3, _request => mux(local_management, Bits(2)(2), request_is_uncached.as_bits().zext(2)))
  )

  // The static physical map forbids cached copies of these regions. After
  // permission checks and older traffic drain, maintenance needs no device IO.
  (
    management_requests
      |> map_flow(request => PhysicalMemoryResp(xlen, RV5StageMemoryContext(vector_completion_slots))):
         access_fault: Bool(#false)
         data: Bits(xlen.width)(0)
         context: request.context
  ) |> ordering.management

  cache_requests |> ordering.cached
  (
    uncached_requests
      |> map_flow(request => UncachedMemoryReq(xlen, RV5StageMemoryContext(vector_completion_slots))):
          request: request
          device: attributes.strongly_ordered
  ) |> ordering.uncached


  /* Fault reporting and completion return
     Local maintenance has no path fault; all retained completions return through one arbiter. */

  def selected_request_fault = mux(request_is_uncached, io_mshr.core.request_fault, cache.request_fault)
  def selected_access_fault = mux(request_is_uncached, io_mshr.core.request_access_fault, cache.request_access_fault)
  core.request_fault <== core.request.valid & request_permitted & !local_management & selected_request_fault
  core.request_access_fault <== core.request.valid & (!request_permitted ||| (!local_management & selected_access_fault))

  cache.response |> ordering.cache_response
  io_mshr.core.response |> ordering.io_response
  ordering.response |> core.response
  core.drained <== ordering.drained
  core.reservation_valid <== cache.reservation_valid
  assert(!(cache.response.valid & io_mshr.core.response.valid),
         "rv5stage_memory_response_paths_exclusive")

export:
  RV5StageMemoryRouter
