#lang rhodium
/* Routes permitted data accesses between L1D and a completion-owned IO-MSHR. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../common/cache/access.rhdl" open
  "memory-context.rhdl" open
  "../common/cache/protocol.rhdl" open
  "../common/cache/operation.rhdl" open
  "../common/cache/ordered-service.rhdl" open
  "uncached-protocol.rhdl" open
  "../../riscv/isa/xlen.rhm".XLen
  "../../riscv/rtl/pma.rhdl" open
  lib("flow/main.rhdl") open
  lib("rhodium/std/bits.rhdl") open

/* Resolves PMA/PBMT permissions over the whole access and excludes cached/uncached overlap.
   Permitted uncached maintenance completes locally after older traffic drains. */
sync_circuit RV5StageMemoryRouter(xlen :: XLen,
                                  physical_map :: RiscvPhysicalMemoryMap,
                                  ~vector_completion_slots: vector_completion_slots :: Pow2Int = 8):
  interface core(RV5StagePhysicalDataAccess(xlen, vector_completion_slots), ~role: responder)
  interface cache(CacheAccess(xlen, RV5StageMemoryContext(vector_completion_slots)), ~role: requester)
  interface uncached(UncachedTransportAccess(xlen, Bool), ~role: requester)
  output ordered_busy: Bool


  /* Retained uncached capacity
     Request capacity is independent of the response sink to avoid a flush-ready loop. */

  def ordering = attach_ordered_memory(cache, uncached, core.response, xlen, RV5StageMemoryContext(vector_completion_slots))


  /* Full-access permission classification
     Check both endpoints of a scalar access or the complete cache-block operation. */

  def request :: PhysicalMemoryReq(xlen, RV5StageMemoryContext(vector_completion_slots)) = core.request.bits.memory
  def operation = request.access
  def admission = classify_committed_cache_access(
    xlen, physical_map, request.address, request.width, operation, core.request.bits.pbmt,
    ~reads: operation.returns_old_value(), ~require_alignment: #false
  )


  /* Ordered path admission
     Cached and uncached traffic exclude one another; local maintenance waits for both to drain. */

  ordered_busy <== ordering.ordered_busy
  def admitted = core.request |> filter_flow(_request => admission.permitted)
  def Array(cache_requests, uncached_requests, management_requests) = route_committed_request(admitted, admission.route)

  // The static physical map forbids cached copies of these regions. After
  // permission checks and older traffic drain, maintenance needs no device IO.
  (
    management_requests
      |> map_flow(request => PhysicalMemoryResp(xlen, RV5StageMemoryContext(vector_completion_slots))):
         access_fault: Bool(#false)
         data: Bits(xlen.width)(0)
         context: request.context
  ) |> ordering.management

  cache_requests |> ordering.cached
  (
    uncached_requests
      |> map_flow(request => UncachedMemoryReq(xlen, RV5StageMemoryContext(vector_completion_slots))):
          request: request
          device: admission.strongly_ordered
  ) |> ordering.uncached


  /* Fault reporting and completion return
     Local maintenance has no path fault; all retained completions return through one arbiter. */

  def cached = admission.route === CacheServiceRoute.Cached
  def uncached_io = admission.route === CacheServiceRoute.Uncached
  def selected_request_fault = (cached & cache.request_fault) ||| (uncached_io & ordering.io_request_fault)
  def selected_access_fault = (cached & cache.request_access_fault) ||| (uncached_io & ordering.io_request_access_fault)
  core.request_fault <== core.request.valid & admission.permitted & selected_request_fault
  core.request_access_fault <== core.request.valid & (!admission.permitted ||| selected_access_fault)

  core.drained <== ordering.drained
  core.reservation_valid <== cache.reservation_valid

export:
  RV5StageMemoryRouter
