#lang rhodium
// Implements RV5Stage's two-read, two-write integer register file with x0 hardwired to zero.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../riscv/isa/xlen.rhm" open
  lib("rhodium/std/ready-valid.rhdl") open

bundle RegisterFileWrite(xlen :: XLen):
  address: Bits(5)
  data: Bits(xlen.width)

sync_circuit RV5StageRegisterFile(xlen :: XLen):
  def width = xlen.width

  input read_address_1: Bits(5)
  input read_address_2: Bits(5)
  interface writes[2](Valid(RegisterFileWrite(xlen)), ~role: consumer)
  output read_data_1: Bits(width)
  output read_data_2: Bits(width)

  def zero = bits(0, width)
  def initial = vec(for List (_index in 0..32): zero)
  reg registers(~init: initial)

  def Array(first_write, second_write) = writes
  def writing_first = first_write.valid & first_write.bits.address.or_reduce()
  def writing_second = second_write.valid & second_write.bits.address.or_reduce()
  // Scoreboard WAW gating keeps enabled architectural writes distinct. If that
  // invariant is violated, same-destination write behavior is undefined.
  when writing_first:
    registers[first_write.bits.address] <== first_write.bits.data
  when writing_second:
    registers[second_write.bits.address] <== second_write.bits.data

  // Forward each valid write to same-cycle reads; colliding writes are invalid.
  def read_1_zero = !read_address_1.or_reduce()
  def read_2_zero = !read_address_2.or_reduce()
  def read_1_from_first_write = writing_first & (first_write.bits.address === read_address_1)
  def read_1_from_second_write = writing_second & (second_write.bits.address === read_address_1)
  def read_2_from_first_write = writing_first & (first_write.bits.address === read_address_2)
  def read_2_from_second_write = writing_second & (second_write.bits.address === read_address_2)
  read_data_1 <== mux(
    read_1_zero,
    zero,
    mux(
      read_1_from_second_write,
      second_write.bits.data,
      mux(read_1_from_first_write, first_write.bits.data, registers[read_address_1])
    )
  )
  read_data_2 <== mux(
    read_2_zero,
    zero,
    mux(
      read_2_from_second_write,
      second_write.bits.data,
      mux(read_2_from_first_write, first_write.bits.data, registers[read_address_2])
    )
  )

export:
  RegisterFileWrite
  RV5StageRegisterFile
