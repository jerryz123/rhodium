#lang rhodium
/* Validates S2 predictions, refreshes live RAS targets, and discovers jump/return fallbacks. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/bpred/protocol.rhdl") open
  lib("cores/bpred/ras.rhdl").riscv_compressed_ras_action
  lib("cores/bpred/ras.rhdl").riscv_ras_action
  "packet.rhdl" open
  "../profile.rhm".RV5StageConfig
  "../../../riscv/isa/c.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/model/formats.rhm" as riscv_fields
  "../../../riscv/rtl/instruction-fields.rhdl".instruction_immediate
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

/* Reassembles a compressed direct-jump immediate and sign-extends its even byte offset. */
fun compressed_jump_offset(instruction :: Bits(16), output_width :: PosInt) :~ Bits(output_width):
  def immediate = (
    instruction[12..13] ++ instruction[8..9] ++ instruction[9..11] ++ instruction[6..7]
      ++ instruction[7..8] ++ instruction[2..3] ++ instruction[11..12] ++ instruction[3..6] ++ Bits(1)(0)
  )
  immediate.into(SInt(12)).sext(output_width).as_bits()

/* Validates predicted boundaries, refreshes warm RAS targets, and discovers direct jumps/returns.
   Its private partial-word state supports straddles independently of Decode's residual storage. */
sync_circuit RV5StageFetchScan(core_profile :: RV5StageConfig):
  def hypervisor = core_profile.extensions.hypervisor
  def xlen = core_profile.xlen
  def compressed_enabled = compressed_extensions_enabled(core_profile.extensions.compressed)
  interface ingress(Valid(RV5StageFetchPacket(xlen, hypervisor)), ~role: consumer)
  interface egress(Valid(RV5StageFetchPacket(xlen, hypervisor)), ~role: producer)
  interface repair(Valid(RV5StageFetchRepair(xlen)), ~role: producer)
  interface fallback(Valid(BranchPrediction(xlen)), ~role: producer)
  interface clear(Pulse(), ~role: consumer)
  input ras_head_valid: Bool
  input ras_head: Bits(xlen.width)


  /* Packet boundaries and prediction validation.
     Scanner-owned partial state tracks S2 prefixes independently of Decode's residual parcel. */

  reg partial(~init: Bool(#false))
  reg partial_halfword(Bits(16))
  reg partial_prediction_seen(~init: Bool(#false))
  reg partial_return_repair(~init: Bool(#false))
  reg partial_return_prediction(BranchPrediction(xlen))
  def packet = ingress.bits
  def packet_clean = !packet.page_fault & !packet.access_fault
  def lower_compressed = if compressed_enabled | packet.word[0..2] =/= Bits(2)(3) | Bool(#false)
  def upper_compressed = if compressed_enabled | packet.word[16..18] =/= Bits(2)(3) | Bool(#false)
  def lower_start = packet.mask[0].into(Bool) & !partial
  def upper_start = packet.pc[1].into(Bool) ||| partial ||| lower_compressed
  def predicted_upper = packet.prediction.pc[1].into(Bool)
  def predicted_half = mux(predicted_upper, packet.word[16..32], packet.word[0..16])
  def predicted_compressed = mux(predicted_upper, upper_compressed, lower_compressed)
  def compressed_jump_function = predicted_half[13..16].is_one_of(Bits(3)(5), Bits(3)(6), Bits(3)(7)) ||| (
    Bool(xlen == XLen.X32) & (predicted_half[13..16] === Bits(3)(1))
  )
  def compressed_jump = (predicted_half[0..2] === Bits(2)(1)) & compressed_jump_function
  def compressed_indirect = (predicted_half[0..2] === Bits(2)(2)) & (predicted_half[13..16] === Bits(3)(4)) & (predicted_half[2..7] === Bits(5)(0)) & predicted_half[7..12].or_reduce()
  def control_flow = mux(predicted_compressed, compressed_jump ||| compressed_indirect, predicted_half[0..7].is_one_of(Bits(7)(0x63), Bits(7)(0x6f), Bits(7)(0x67)))
  def boundary = mux(predicted_upper, upper_start, lower_start)
  def prediction_shape_mismatch = !boundary ||| (packet.prediction.compressed ^ predicted_compressed) ||| !control_flow
  def bad_prediction = packet.prediction.valid & packet_clean & prediction_shape_mismatch
  def prediction = packet.prediction.updated(~valid: packet.prediction.valid & !bad_prediction)


  /* First instruction and optional upper compressed successor.
     A retained prefix completes from this packet before a following upper instruction is considered. */

  def first_upper = !partial & packet.pc[1].into(Bool)
  def first_halfword :: Bits(16) = priority_mux(~default: packet.word[0..16]):
    partial: partial_halfword
    first_upper: packet.word[16..32]
  def first_compressed = if compressed_enabled | first_halfword[0..2] =/= Bits(2)(3) | Bool(#false)
  def first_complete = first_compressed ||| partial ||| !first_upper
  def first_instruction = mux(partial, packet.word[0..16] ++ partial_halfword, packet.word)
  def first_action = mux(first_compressed, riscv_compressed_ras_action(xlen, first_halfword), riscv_ras_action(first_instruction))
  def first_valid = mux(!partial & first_upper, packet.mask[1].into(Bool), packet.mask[0].into(Bool))
  def first_pc = mux(partial, packet.pc - Bits(xlen.width)(2), packet.pc)
  def first_return = first_valid & first_complete & first_action.is_one_of(RasAction.Pop, RasAction.PopPush)
  def first_compressed_direct = (first_halfword[0..2] === Bits(2)(1)) & ((first_halfword[13..16] === Bits(3)(5)) ||| (Bool(xlen == XLen.X32) & (first_halfword[13..16] === Bits(3)(1))))
  def first_compressed_conditional = (first_halfword[0..2] === Bits(2)(1)) & first_halfword[13..16].is_one_of(Bits(3)(6), Bits(3)(7))
  def first_compressed_indirect = (first_halfword[0..2] === Bits(2)(2)) & (first_halfword[13..16] === Bits(3)(4)) & (first_halfword[2..7] === Bits(5)(0)) & first_halfword[7..12].or_reduce()
  def first_compressed_control_flow = first_compressed & (first_compressed_direct ||| first_compressed_conditional ||| first_compressed_indirect)
  def first_full_control_flow = !first_compressed & first_instruction[0..7].is_one_of(Bits(7)(0x63), Bits(7)(0x6f), Bits(7)(0x67))
  def first_full_jump = !first_compressed & (first_instruction[0..7] === Bits(7)(0x6f))
  def first_direct_jump = first_valid & first_complete & ((first_compressed & first_compressed_direct) ||| first_full_jump)
  def first_direct_target = first_pc + mux(first_compressed, compressed_jump_offset(first_halfword, xlen.width), instruction_immediate(riscv_fields.JImmediate, first_instruction, xlen.width))
  def second_follows = mux(partial, !first_full_control_flow, !first_upper & first_compressed & !first_compressed_control_flow)
  def second_valid = packet.mask[1].into(Bool) & upper_compressed & second_follows
  def second_pc = packet.pc.align_down(4) + Bits(xlen.width)(2)
  def second_action = riscv_compressed_ras_action(xlen, packet.word[16..32])
  def second_return = second_valid & second_action.is_one_of(RasAction.Pop, RasAction.PopPush)
  def second_compressed_direct = (packet.word[16..18] === Bits(2)(1)) & ((packet.word[29..32] === Bits(3)(5)) ||| (Bool(xlen == XLen.X32) & (packet.word[29..32] === Bits(3)(1))))
  def second_direct_jump = second_valid & second_compressed_direct
  def second_direct_target = second_pc + compressed_jump_offset(packet.word[16..32], xlen.width)
  def first_fallback = first_direct_jump ||| (first_return & ras_head_valid)
  def second_fallback = second_direct_jump ||| (second_return & ras_head_valid)
  def prediction_missing = !packet.prediction.valid & (!partial ||| !partial_prediction_seen)


  /* Fallback selection and live-RAS repair.
     Refresh the hint before this packet's RAS action. A straddling return acts once,
     but its redirect waits for the continuation and retains the pre-action target. */

  def predicted_return = prediction.ras_action.is_one_of(RasAction.Pop, RasAction.PopPush)
  def return_repair = prediction.valid & predicted_return & ras_head_valid & (prediction.target =/= ras_head) & packet_clean
  def return_prefix = prediction.pc[1].into(Bool) & !prediction.compressed
  def continued_return_repair = partial & partial_return_repair & first_complete & packet_clean
  def missing_fallback = prediction_missing & (first_fallback ||| second_fallback)
  def fallback_valid = ingress.valid & (missing_fallback ||| (return_repair & !return_prefix) ||| continued_return_repair)
  def fallback_pc = mux(first_fallback, first_pc, second_pc)
  def first_fallback_target = mux(first_direct_jump, first_direct_target, ras_head)
  def second_fallback_target = mux(second_direct_jump, second_direct_target, ras_head)
  def fallback_target = mux(first_fallback, first_fallback_target, second_fallback_target)
  def fallback_prediction = BranchPrediction(xlen):
    valid: ingress.valid & missing_fallback & packet_clean
    pc: fallback_pc
    target: fallback_target
    compressed: mux(first_fallback, first_compressed, Bool(#true))
    ras_action: mux(first_fallback, first_action, second_action)
  def refreshed_prediction = prediction.updated(~target: ras_head)
  def effective_prediction :: BranchPrediction(xlen) = priority_mux(~default: prediction):
    return_repair: refreshed_prediction
    fallback_prediction.valid: fallback_prediction
  def redirect_prediction :: BranchPrediction(xlen) = priority_mux(~default: fallback_prediction):
    continued_return_repair: partial_return_prediction
    return_repair: refreshed_prediction


  /* Packet cut, repair, and fallback publication.
     A valid lower compressed prediction cuts the upper parcel; a stale cut retains
     the complete word and restarts after it, not before it. */

  def cut_upper = effective_prediction.valid & !effective_prediction.pc[1].into(Bool) & effective_prediction.compressed
  def cut_after_straddle = continued_return_repair ||| (fallback_prediction.valid & partial & first_fallback)
  def mask = mux(cut_upper ||| cut_after_straddle, Bits(2)(1), packet.mask)
  def Array(packets, repairs, fallbacks) = ingress |> fork_valid(3)
  (packets |> filter_valid(_packet => !clear.valid) |> map_valid(packet => packet.updated(~mask: mask, ~prediction: effective_prediction))) |> egress
  (fallbacks |> filter_valid(_packet => fallback_valid & packet_clean & !clear.valid) |> map_valid(_packet => redirect_prediction)) |> fallback
  (repairs |> filter_valid(_packet => !clear.valid & bad_prediction) |> map_valid(packet => RV5StageFetchRepair(xlen)):
    pc: packet.pc.align_down(4) + Bits(xlen.width)(4)
    entry: packet.prediction.pc
  ) |> repair


  /* Scanner prefix updates.
     Epoch clear wins new input; an admitted prefix retains any deferred return repair. */

  when (clear.valid):
    partial <== Bool(#false)
    partial_prediction_seen <== Bool(#false)
    partial_return_repair <== Bool(#false)
  elsewhen (ingress.valid):
    partial <== mask[1].into(Bool) & upper_start & !upper_compressed & packet_clean
    partial_halfword <== packet.word[16..32]
    partial_prediction_seen <== packet.prediction.valid
    partial_return_repair <== return_repair & return_prefix
    partial_return_prediction <== refreshed_prediction

export:
  RV5StageFetchScan
