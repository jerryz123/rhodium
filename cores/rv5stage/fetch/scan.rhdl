#lang rhodium
// Validates S2 predictions and discovers direct-jump and return fallbacks.
// SPDX-License-Identifier: Apache-2.0

import:
  "bpd/protocol.rhdl" open
  "bpd/ras.rhdl".rv5stage_compressed_ras_action
  "bpd/ras.rhdl".rv5stage_ras_action
  "packet.rhdl" open
  "../profile.rhm".RVCoreProfile
  "../../../riscv/isa/c.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/model/formats.rhm" as riscv_fields
  "../../../riscv/rtl/instruction-fields.rhdl".instruction_immediate
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

fun compressed_jump_offset(instruction :: Bits(16), output_width :: PosInt) :~ Bits(output_width):
  def immediate = instruction[12..13] ++ instruction[8..9] ++ instruction[9..11] ++ instruction[6..7] ++ instruction[7..8] ++ instruction[2..3] ++ instruction[11..12] ++ instruction[3..6] ++ bits(0, 1)
  immediate.into(SInt(12)).sext(output_width).as_bits()

sync_circuit RV5StageFetchScan(core_profile :: RVCoreProfile):
  def xlen = core_profile.xlen
  def compressed_enabled = compressed_extensions_enabled(core_profile.extensions.compressed)
  interface ingress(Valid(RV5StageFetchPacket(xlen)), ~role: consumer)
  interface egress(Valid(RV5StageFetchPacket(xlen)), ~role: producer)
  interface repair(Valid(RV5StageFetchRepair(xlen)), ~role: producer)
  interface fallback(Valid(RV5StagePrediction(xlen)), ~role: producer)
  interface clear(Pulse(), ~role: consumer)
  input ras_head_valid: Bool
  input ras_head: Bits(xlen.width)
  reg partial(~init: Bool(#false))
  reg partial_halfword(Bits(16))
  reg partial_prediction_seen(~init: Bool(#false))
  def packet = ingress.bits
  def lower_compressed = if compressed_enabled | packet.word[0..2] =/= bits(3, 2) | Bool(#false)
  def upper_compressed = if compressed_enabled | packet.word[16..18] =/= bits(3, 2) | Bool(#false)
  def lower_start = packet.mask[0].into(Bool) & !partial
  def upper_start = packet.pc[1].into(Bool) ||| partial ||| lower_compressed
  def predicted_upper = packet.prediction.pc[1].into(Bool)
  def predicted_half = mux(predicted_upper, packet.word[16..32], packet.word[0..16])
  def predicted_compressed = mux(predicted_upper, upper_compressed, lower_compressed)
  def compressed_jump = (predicted_half[0..2] === bits(1, 2)) & (predicted_half[13..16].is_one_of(bits(5, 3), bits(6, 3), bits(7, 3)) ||| (Bool(xlen == XLen.X32) & (predicted_half[13..16] === bits(1, 3))))
  def compressed_indirect = (predicted_half[0..2] === bits(2, 2)) & (predicted_half[13..16] === bits(4, 3)) & (predicted_half[2..7] === bits(0, 5)) & predicted_half[7..12].or_reduce()
  def control_flow = mux(predicted_compressed, compressed_jump ||| compressed_indirect, predicted_half[0..7].is_one_of(bits(0x63, 7), bits(0x6f, 7), bits(0x67, 7)))
  def boundary = mux(predicted_upper, upper_start, lower_start)
  def bad_prediction = packet.prediction.valid & !packet.page_fault & !packet.access_fault & (!boundary ||| (packet.prediction.compressed ^ predicted_compressed) ||| !control_flow)
  def prediction = packet.prediction.updated(~valid: packet.prediction.valid & !bad_prediction)
  def first_upper = !partial & packet.pc[1].into(Bool)
  def first_halfword = mux(partial, partial_halfword, mux(first_upper, packet.word[16..32], packet.word[0..16]))
  def first_compressed = if compressed_enabled | first_halfword[0..2] =/= bits(3, 2) | Bool(#false)
  def first_complete = first_compressed ||| partial ||| !first_upper
  def first_instruction = mux(partial, packet.word[0..16] ++ partial_halfword, packet.word)
  def first_action = mux(first_compressed, rv5stage_compressed_ras_action(xlen, first_halfword), rv5stage_ras_action(first_instruction))
  def first_valid = mux(partial, packet.mask[0].into(Bool), mux(first_upper, packet.mask[1].into(Bool), packet.mask[0].into(Bool)))
  def first_pc = mux(partial, packet.pc - bits(2, xlen.width), packet.pc)
  def first_return = first_valid & first_complete & first_action.is_one_of(RV5StageRasAction.Pop, RV5StageRasAction.PopPush)
  def first_compressed_direct = (first_halfword[0..2] === bits(1, 2)) & ((first_halfword[13..16] === bits(5, 3)) ||| (Bool(xlen == XLen.X32) & (first_halfword[13..16] === bits(1, 3))))
  def first_compressed_conditional = (first_halfword[0..2] === bits(1, 2)) & first_halfword[13..16].is_one_of(bits(6, 3), bits(7, 3))
  def first_compressed_indirect = (first_halfword[0..2] === bits(2, 2)) & (first_halfword[13..16] === bits(4, 3)) & (first_halfword[2..7] === bits(0, 5)) & first_halfword[7..12].or_reduce()
  def first_compressed_control_flow = first_compressed & (first_compressed_direct ||| first_compressed_conditional ||| first_compressed_indirect)
  def first_full_control_flow = !first_compressed & first_instruction[0..7].is_one_of(bits(0x63, 7), bits(0x6f, 7), bits(0x67, 7))
  def first_full_jump = !first_compressed & (first_instruction[0..7] === bits(0x6f, 7))
  def first_direct_jump = first_valid & first_complete & ((first_compressed & first_compressed_direct) ||| first_full_jump)
  def first_direct_target = first_pc + mux(first_compressed, compressed_jump_offset(first_halfword, xlen.width), instruction_immediate(riscv_fields.JImmediate, first_instruction, xlen.width))
  def second_follows = mux(partial, !first_full_control_flow, !first_upper & first_compressed & !first_compressed_control_flow)
  def second_valid = packet.mask[1].into(Bool) & upper_compressed & second_follows
  def second_pc = packet.pc.align_down(4) + bits(2, xlen.width)
  def second_action = rv5stage_compressed_ras_action(xlen, packet.word[16..32])
  def second_return = second_valid & second_action.is_one_of(RV5StageRasAction.Pop, RV5StageRasAction.PopPush)
  def second_compressed_direct = (packet.word[16..18] === bits(1, 2)) & ((packet.word[29..32] === bits(5, 3)) ||| (Bool(xlen == XLen.X32) & (packet.word[29..32] === bits(1, 3))))
  def second_direct_jump = second_valid & second_compressed_direct
  def second_direct_target = second_pc + compressed_jump_offset(packet.word[16..32], xlen.width)
  def first_fallback = first_direct_jump ||| (first_return & ras_head_valid)
  def second_fallback = second_direct_jump ||| (second_return & ras_head_valid)
  def prediction_missing = !packet.prediction.valid & (!partial ||| !partial_prediction_seen)
  def fallback_valid = ingress.valid & prediction_missing & !packet.page_fault & !packet.access_fault & (first_fallback ||| second_fallback)
  def fallback_pc = mux(first_fallback, first_pc, second_pc)
  def fallback_target = mux(first_fallback, mux(first_direct_jump, first_direct_target, ras_head), mux(second_direct_jump, second_direct_target, ras_head))
  def fallback_prediction = RV5StagePrediction(xlen):
    valid: fallback_valid
    pc: fallback_pc
    target: fallback_target
    compressed: mux(first_fallback, first_compressed, Bool(#true))
    ras_action: mux(first_fallback, first_action, second_action)
  def effective_prediction = mux(fallback_valid, fallback_prediction, prediction)
  // A valid lower compressed prediction cuts the upper parcel. A stale cut
  // instead retains the complete word and restarts after it, not before it.
  def cut_upper = effective_prediction.valid & !effective_prediction.pc[1].into(Bool) & effective_prediction.compressed
  def cut_after_straddle = fallback_valid & partial & first_fallback
  def mask = mux(cut_upper ||| cut_after_straddle, bits(1, 2), packet.mask)
  def Array(packets, repairs, fallbacks) = ingress |> fork_valid(3)
  (packets |> filter_valid(_packet => !clear.valid) |> map_valid(packet => packet.updated(~mask: mask, ~prediction: effective_prediction))) |> egress
  (fallbacks |> filter_valid(_packet => fallback_valid & !clear.valid) |> map_valid(_packet => fallback_prediction)) |> fallback
  (repairs |> filter_valid(_packet => !clear.valid & bad_prediction) |> map_valid(packet => RV5StageFetchRepair(xlen)):
    pc: packet.pc.align_down(4) + bits(4, xlen.width)
    entry: packet.prediction.pc
  ) |> repair
  when (clear.valid):
    partial <== Bool(#false)
    partial_prediction_seen <== Bool(#false)
  elsewhen (ingress.valid):
    partial <== mask[1].into(Bool) & upper_start & !upper_compressed & !packet.page_fault & !packet.access_fault
    partial_halfword <== packet.word[16..32]
    partial_prediction_seen <== packet.prediction.valid

export:
  RV5StageFetchScan
