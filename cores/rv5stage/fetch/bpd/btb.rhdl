#lang rhodium
// Predicts the earliest taken branch using compact entries and shared upper-address pages.
// SPDX-License-Identifier: Apache-2.0

import:
  "protocol.rhdl" open
  "../../../../riscv/isa/xlen.rhm" open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

bundle RV5StageBtbPage(tag_width :: PosInt):
  valid: Bool
  tag: Bits(tag_width)

bundle RV5StageBtbEntry(match_bits :: PosInt, page_count :: PosInt):
  valid: Bool
  pc_low: Bits(match_bits)
  pc_page: Bits(index_width(page_count))
  target_low: Bits(match_bits)
  target_page: Bits(index_width(page_count))
  conditional: Bool
  compressed: Bool
  counter: Bits(2)
  ras_action: RV5StageRasAction

sync_circuit RV5StageBtb(xlen :: XLen,
                         entry_count :: Nat = 32,
                         match_bits :: PosInt = 14,
                         page_count :: PosInt = 8):
  // Lookup is combinational; only predictor state changes are event flows.
  unless match_bits >= 2 && match_bits < xlen.width
  | error(~who: #'RV5StageBtb, "match bits must include the fetch-word offset and leave an upper address tag")
  unless page_count >= 2
  | error(~who: #'RV5StageBtb, "shared page count must be at least two")
  input cursor: Bits(xlen.width)
  interface invalidate_all(Pulse(), ~role: consumer)
  interface invalidate(Valid(Bits(xlen.width)), ~role: consumer)
  interface update(Valid(RV5StageBranchUpdate(xlen)), ~role: consumer)
  interface discover(Valid(RV5StagePrediction(xlen)), ~role: consumer)
  output prediction: RV5StagePrediction(xlen)

  if entry_count == 0
  | prediction <== literal(RV5StagePrediction(xlen), 0)
  | block:
      def index_bits = index_width(entry_count)
      def page_index_bits = index_width(page_count)
      def Page = RV5StageBtbPage(xlen.width - match_bits)
      def Entry = RV5StageBtbEntry(match_bits, page_count)
      reg pages(~init: vec(for List (_index in 0..page_count): literal(Page, 0)))
      reg entries(~init: vec(for List (_index in 0..entry_count): literal(Entry, 0)))
      reg replacement(~init: bits(0, index_bits))
      reg page_replacement(~init: bits(0, page_index_bits))
      fun page_tag(address :: Bits(xlen.width)) :~ Bits(xlen.width - match_bits):
        address[match_bits..xlen.width]
      fun page_matches(address :: Bits(xlen.width)) :~ Vec(page_count, Bool):
        vec(for List (index in 0..page_count): pages[index].valid & (pages[index].tag === page_tag(address)))
      fun next_page(index :: Bits(page_index_bits)) :~ Bits(page_index_bits):
        mux(index === bits(page_count - 1, page_index_bits), bits(0, page_index_bits), index + bits(1, page_index_bits))

      def cursor_pages = page_matches(cursor)
      def candidates = vec(
        for List (index in 0..entry_count):
          def entry = entries[index]
          entry.valid & pages[entry.target_page].valid & cursor_pages[entry.pc_page] & (entry.pc_low[2..match_bits] === cursor[2..match_bits]) & (!cursor[1].into(Bool) ||| entry.pc_low[1].into(Bool)) & (!entry.conditional ||| entry.counter[1].into(Bool))
      )
      def lower = vec(for List (index in 0..entry_count): candidates[index] & !entries[index].pc_low[1].into(Bool))
      def selected = entries[priority_encoder(mux(lower.or_reduce(), lower, candidates))]
      prediction <== RV5StagePrediction(xlen):
        valid: candidates.or_reduce() & !invalidate_all.valid
        pc: pages[selected.pc_page].tag ++ selected.pc_low
        target: pages[selected.target_page].tag ++ selected.target_low
        compressed: selected.compressed
        ras_action: selected.ras_action

      def discovering = discover.valid & discover.bits.valid & !update.valid
      def write_pc = mux(update.valid, update.bits.pc, discover.bits.pc)
      def write_target = mux(update.valid, update.bits.target, discover.bits.target)
      def write_compressed = mux(update.valid, update.bits.compressed, discover.bits.compressed)
      def write_ras_action = mux(update.valid, update.bits.ras_action, discover.bits.ras_action)
      def write_pc_pages = page_matches(write_pc)
      def write_target_pages = page_matches(write_target)
      def matches = vec(for List (index in 0..entry_count): entries[index].valid & write_pc_pages[entries[index].pc_page] & (entries[index].pc_low === write_pc[0..match_bits]))
      def empty = vec(for List (index in 0..entry_count): !entries[index].valid)
      def matched = matches.or_reduce()
      def selected_index = priority_mux(~default: replacement):
        matched: priority_encoder(matches)
        empty.or_reduce(): priority_encoder(empty)
      def previous = entries[selected_index]
      def incremented = mux(previous.counter === bits(3, 2), previous.counter, previous.counter + bits(1, 2))
      def decremented = mux(previous.counter === bits(0, 2), previous.counter, previous.counter - bits(1, 2))
      def write = (update.valid & (matched ||| (update.bits.branch & update.bits.taken))) ||| discovering
      def commit_write = write & !invalidate.valid
      def write_valid = mux(update.valid, update.bits.branch, Bool(#true))
      def allocate_pages = commit_write & write_valid
      def pc_page_found = write_pc_pages.or_reduce()
      def target_page_found = write_target_pages.or_reduce()
      def empty_pages = vec(for List (index in 0..page_count): !pages[index].valid)
      def same_page = page_tag(write_pc) === page_tag(write_target)
      def target_existing_page = priority_encoder(write_target_pages)
      def pc_replacement = mux(!same_page & target_page_found & (page_replacement === target_existing_page), next_page(page_replacement), page_replacement)
      def pc_page = priority_mux(~default: pc_replacement):
        pc_page_found: priority_encoder(write_pc_pages)
        empty_pages.or_reduce(): priority_encoder(empty_pages)
      def target_empty_pages = vec(for List (index in 0..page_count): empty_pages[index] & (pc_page =/= bits(index, page_index_bits)))
      def target_replacement = mux(page_replacement === pc_page, next_page(page_replacement), page_replacement)
      def target_page = priority_mux(~default: target_replacement):
        same_page: pc_page
        target_page_found: target_existing_page
        target_empty_pages.or_reduce(): priority_encoder(target_empty_pages)
      def replace_pc_page = allocate_pages & !pc_page_found & pages[pc_page].valid
      def replace_target_page = allocate_pages & !same_page & !target_page_found & pages[target_page].valid
      def replaced_page = vec(
        for List (index in 0..page_count):
          (replace_pc_page & (pc_page === bits(index, page_index_bits))) ||| (replace_target_page & (target_page === bits(index, page_index_bits)))
      )
      def invalidated_entries = vec(
        for List (index in 0..entry_count):
          replaced_page[entries[index].pc_page] ||| replaced_page[entries[index].target_page]
      )
      def invalidate_pages = page_matches(invalidate.bits)
      def invalidate_matches = vec(
        for List (index in 0..entry_count):
          entries[index].valid & invalidate_pages[entries[index].pc_page] & (entries[index].pc_low === invalidate.bits[0..match_bits])
      )
      when (invalidate_all.valid):
        replacement <== bits(0, index_bits)
      elsewhen (commit_write & !matched):
        replacement <== mux(selected_index === bits(entry_count - 1, index_bits), bits(0, index_bits), selected_index + bits(1, index_bits))
      when (invalidate_all.valid):
        page_replacement <== bits(0, page_index_bits)
      elsewhen (allocate_pages & (!pc_page_found ||| (!same_page & !target_page_found))):
        page_replacement <== next_page(mux(!same_page & !target_page_found, target_page, pc_page))
      for (index in 0..page_count):
        when (invalidate_all.valid):
          pages[index] <== literal(Page, 0)
        elsewhen (allocate_pages & !pc_page_found & (pc_page === bits(index, page_index_bits))):
          pages[index] <== RV5StageBtbPage(xlen.width - match_bits):
            valid: Bool(#true)
            tag: page_tag(write_pc)
        elsewhen (allocate_pages & !same_page & !target_page_found & (target_page === bits(index, page_index_bits))):
          pages[index] <== RV5StageBtbPage(xlen.width - match_bits):
            valid: Bool(#true)
            tag: page_tag(write_target)
      for (index in 0..entry_count):
        when (invalidate_all.valid):
          entries[index] <== literal(Entry, 0)
        elsewhen (invalidate.valid & invalidate_matches[index]):
          entries[index] <== entries[index].updated(~valid: Bool(#false))
        elsewhen (commit_write & (selected_index === bits(index, index_bits))):
          entries[index] <== RV5StageBtbEntry(match_bits, page_count):
            valid: write_valid
            pc_low: write_pc[0..match_bits]
            pc_page: pc_page
            target_low: write_target[0..match_bits]
            target_page: target_page
            conditional: mux(update.valid, update.bits.conditional, Bool(#false))
            compressed: write_compressed
            counter: mux(update.valid & matched, mux(update.bits.taken, incremented, decremented), bits(2, 2))
            ras_action: write_ras_action
        elsewhen (invalidated_entries[index]):
          entries[index] <== entries[index].updated(~valid: Bool(#false))

export:
  RV5StageBtbPage
  RV5StageBtbEntry
  RV5StageBtb
