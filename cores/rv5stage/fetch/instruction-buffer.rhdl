#lang rhodium
/* Feeds Decode directly from fetch packets, retaining only an unconsumed halfword. */
// SPDX-License-Identifier: Apache-2.0

import:
  "bpd/protocol.rhdl" open
  "packet.rhdl" open
  "protocol.rhdl" open
  "../profile.rhm".RV5StageConfig
  "../decode/core-ctrl.rhdl".rv5stage_instructions
  "../../../riscv/isa/c.rhm" open
  "../../../riscv/isa/fp-profile.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/rtl/compressed.rhdl" open
  lib("riscv/rtl/hypervisor.rhdl") open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

/* Retains one upper halfword with its PC and prediction when a packet is only partly consumed. */
bundle RV5StageFetchParcel(xlen :: XLen):
  pc: Bits(xlen.width)
  halfword: Bits(16)
  prediction: RV5StagePrediction(xlen)

/* Assembles word-aligned and straddling instructions directly into Decode, expanding enabled C
   forms.
   Stores only a leftover halfword; preserves precise continuation faults and distinct
   packet/instruction consumption. */
sync_circuit RV5StageInstructionBuffer(core_profile :: RV5StageConfig):
  def hypervisor = core_profile.extensions.hypervisor
  def xlen = core_profile.xlen
  def extensions = core_profile.extensions
  def profile = extensions.floating_point
  def compressed_extensions = extensions.compressed
  def supported_instruction_names = rv5stage_instructions(xlen, profile, extensions.half_precision, ~zfa: extensions.zfa, ~zicbop: extensions.zicbop, ~zicboz: extensions.zicboz, ~zicbom: extensions.zicbom, ~svinval: extensions.svinval, ~hypervisor: hypervisor, ~zawrs: extensions.zawrs, ~zihintpause: extensions.zihintpause, ~zihintntl: extensions.zihintntl).map(fun (instruction): instruction.name)
  def width = xlen.width
  def compressed_enabled = compressed_extensions_enabled(compressed_extensions)
  interface packets(Decoupled(RV5StageFetchPacket(xlen, hypervisor)), ~role: consumer)
  interface clear(Pulse(), ~role: consumer)
  interface fetched(Decoupled(FetchDecode(xlen, hypervisor)), ~role: producer)

  reg residual_valid(~init: Bool(#false))
  reg residual(RV5StageFetchParcel(xlen))
  def pc = mux(residual_valid, residual.pc, packets.bits.pc)
  def upper = pc[1].into(Bool)
  def halfword = mux(residual_valid, residual.halfword, mux(upper, packets.bits.word[16..32], packets.bits.word[0..16]))
  def compressed = if compressed_enabled | halfword[0..2] =/= bits(3, 2) | Bool(#false)
  def head_fault = !residual_valid & (packets.bits.page_fault ||| packets.bits.access_fault)
  def straddle = upper & !compressed & !head_fault
  def head_valid = residual_valid ||| packets.valid
  def following = residual_valid & packets.valid
  def available = head_valid & (!straddle ||| following)
  def raw = mux(compressed, halfword.zext(32), mux(straddle, packets.bits.word[0..16] ++ halfword, packets.bits.word))
  def instruction_is_compressed = compressed & !head_fault
  wire expanded_instruction: Bits(32)
  wire compressed_legal: Bool
  if compressed_enabled
  | block:
      inst expander(RiscvCompressedExpander(xlen, profile, compressed_extensions, ~supported_instructions: supported_instruction_names))
      expander.compressed <== raw[0..16]
      expanded_instruction <== mux(instruction_is_compressed, expander.expansion.instruction, raw)
      compressed_legal <== expander.expansion.valid
  | block:
      expanded_instruction <== raw
      compressed_legal <== Bool(#true)
  def page_fault = (!residual_valid ||| straddle) & packets.bits.page_fault
  def access_fault = (!residual_valid ||| straddle) & packets.bits.access_fault
  def sequential_pc = pc + mux(instruction_is_compressed, bits(2, width), bits(4, width))
  def continuation_prediction = residual_valid & packets.bits.prediction.valid & (packets.bits.prediction.pc === pc)
  def prediction = mux(continuation_prediction, packets.bits.prediction, mux(residual_valid, residual.prediction, packets.bits.prediction))
  def predicted_taken = prediction.valid & (prediction.pc === pc) & !page_fault & !access_fault & !(instruction_is_compressed & !compressed_legal)
  fetched.valid <== available & !clear.valid
  fetched.bits.pc <== pc
  fetched.bits.instruction <== expanded_instruction
  fetched.bits.raw_instruction <== raw
  fetched.bits.sequential_pc <== sequential_pc
  fetched.bits.predicted_next_pc <== mux(predicted_taken, prediction.target, sequential_pc)
  fetched.bits.predicted_ras_action <== mux(predicted_taken, prediction.ras_action, RV5StageRasAction.None)
  fetched.bits.compressed_illegal <== instruction_is_compressed & !compressed_legal
  fetched.bits.instruction_page_fault <== page_fault
  fetched.bits.instruction_access_fault <== access_fault
  fetched.bits.instruction_fault_address <== mux(straddle & (packets.bits.page_fault ||| packets.bits.access_fault), packets.bits.pc.align_down(4), pc)

  if hypervisor
  | block:
      // A fault on the upper parcel names that byte, but an implicit PTE fault
      // must retain the PTE GPA rather than replacing its low bits with the PC.
      def fault_pc = fetched.bits.instruction_fault_address
      def details = packets.bits.guest.details
      fetched.bits.guest <== packets.bits.guest.updated(~details: details.updated(
        ~guest_physical_address: mux(details.access === RiscvGuestFaultAccess.Explicit, details.guest_physical_address.align_down(4) ||| fault_pc[0..2].zext(64), details.guest_physical_address)
      ))
  | #void

  // An incomplete upper-half instruction may enter residual storage without
  // issuing to Decode. A retained compressed instruction consumes no new packet.
  def capture_partial = !residual_valid & straddle
  packets.ready <== !clear.valid & mux(residual_valid, straddle & fetched.ready, capture_partial ||| fetched.ready)
  def keep_upper = packets.bits.mask[1].into(Bool) & !packets.bits.pc[1].into(Bool) & !packets.bits.page_fault & !packets.bits.access_fault & mux(residual_valid, straddle, compressed)
  // Assembly may use the resident parcel, the live packet, or both. Capturing
  // an upper parcel is independent of consuming the instruction being offered.
  describe_interface_window_storage(1, packets.fire() & (capture_partial ||| keep_upper), (residual_valid & fetched.fire()).as_bits(), residual_valid.as_bits(), clear.valid, [residual_valid], ~live: !residual_valid ||| straddle)
  describe_interface_contract(packets, fetched, "instruction-assembly", ~trace_model: interface_trace_window())
  when (clear.valid):
    residual_valid <== Bool(#false)
  elsewhen (packets.fire()):
    residual_valid <== capture_partial ||| keep_upper
    residual <== RV5StageFetchParcel(xlen):
      pc: packets.bits.pc.align_down(4) + bits(2, width)
      halfword: packets.bits.word[16..32]
      prediction: packets.bits.prediction
  elsewhen (fetched.fire()):
    residual_valid <== Bool(#false)
  when (fetched.valid & straddle):
    assert(packets.bits.mask[0].into(Bool) & (packets.bits.pc.align_down(4) === (pc.align_down(4) + bits(4, width))), "ibuf_contiguous_instruction")

export:
  RV5StageInstructionBuffer
