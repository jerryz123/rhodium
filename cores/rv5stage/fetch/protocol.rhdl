#lang rhodium
// Defines the instruction and control contracts crossing between RV5Stage fetch and execution.
// SPDX-License-Identifier: Apache-2.0

import:
  "bpd/protocol.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  lib("rhodium/std/ready-valid.rhdl") open

bundle FetchDecode(xlen :: XLen):
  pc: Bits(xlen.width)
  instruction: Bits(32)
  raw_instruction: Bits(32)
  sequential_pc: Bits(xlen.width)
  predicted_next_pc: Bits(xlen.width)
  predicted_ras_action: RV5StageRasAction
  compressed_illegal: Bool
  instruction_page_fault: Bool
  instruction_access_fault: Bool
  instruction_fault_address: Bits(xlen.width)

interface RV5StageFrontendControl(xlen :: XLen):
  role core
  role frontend
  provider core

  core -> frontend:
    // IF owns the persistent fetch-admission level.
    active: Bool
    // MEM reports a squash after its exception and replay filtering.
    flush: Pulse()
    // The core orders MEM branch recovery with WB redirects and restarts.
    restart: Valid(Bits(xlen.width))
    // WB commits instruction-cache invalidation.
    invalidate_all: Pulse()
    // WB invalidates predictor state for serialized architectural changes.
    predictor_flush: Pulse()
    // MEM publishes the uncanceled branch outcome resolved in EX.
    branch_update: Valid(RV5StageBranchUpdate(xlen))

export:
  FetchDecode
  RV5StageFrontendControl
