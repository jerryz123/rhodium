#lang rhodium
/* Defines raw fetch occurrences crossing from the speculative frontend into core Decode. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("riscv/rtl/hypervisor.rhdl") open
  lib("cores/bpred/protocol.rhdl") open
  "../../../riscv/isa/xlen.rhm" open

/* Carries one raw fetch word with valid-parcel mask, prediction, and optional guest-fault
   provenance. */
bundle RV5StageFetchPacket(xlen :: XLen, hypervisor :: Boolean):
  if hypervisor:
    guest: RiscvGuestException()
  pc: Bits(xlen.width)
  word: Bits(32)
  mask: Bits(2)
  page_fault: Bool
  access_fault: Bool
  prediction: BranchPrediction(xlen)

/* Names the restart PC and stale predictor PC when S2 repairs a prediction cut. */
bundle RV5StageFetchRepair(xlen :: XLen):
  pc: Bits(xlen.width)
  entry: Bits(xlen.width)

export:
  RV5StageFetchPacket
  RV5StageFetchRepair
