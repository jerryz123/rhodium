#lang rhodium
/* Defines raw fetch occurrences crossing from the speculative frontend into core Decode. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("riscv/rtl/hypervisor.rhdl") open
  lib("cores/bpred/protocol.rhdl") open
  lib("cores/pc.rhdl") open
  "../../../riscv/isa/xlen.rhm".XLen

/* Names the predicted instruction relative to this word. Previous is the
   upper parcel of the preceding word, completed by this word's lower parcel. */
hardware_enum RV5StagePredictionOwner:
  None
  Lower
  Upper
  Previous

/* Keeps only the target and RAS hint needed by the predicted parcel in Decode. */
bundle RV5StagePacketPrediction(xlen :: XLen):
  owner: RV5StagePredictionOwner
  target: Bits(xlen.width)
  ras_action: RasAction

/* Names the restart PC and stale predictor PC when S2 repairs a prediction cut. */
bundle RV5StageFetchRepair(xlen :: XLen):
  pc: Bits(xlen.width)
  entry: Bits(xlen.width)

/* Marks a positive sequential boundary crossing alongside the response's fault flags. */
bundle RV5StageQueueFault():
  boundary: Bool
  page_fault: Bool
  access_fault: Bool

/* Faults never predict, so the prediction and fault details share queue storage. */
tagged_union RV5StageQueueOutcome(xlen :: XLen):
  Success(RV5StagePacketPrediction(xlen))
  Fault(RV5StageQueueFault())

/* Canonical scanner, queue, and Decode packet. A fault's boundary bit selects
   zero extension instead of sign extension; RV32 needs no boundary encoding. */
bundle RV5StageFetchPacket(xlen :: XLen, hypervisor :: Boolean):
  if hypervisor:
    guest: RiscvGuestException()

  if xlen == XLen.X64:
    pc: CompactPc(xlen)
    outcome: RV5StageQueueOutcome(xlen)

  if xlen == XLen.X32:
    pc: Bits(xlen.width)

  word: Bits(32)
  mask: Bits(2)
  if xlen == XLen.X32:
    page_fault: Bool
    access_fault: Bool
    prediction: RV5StagePacketPrediction(xlen)

  /* Restores the requested address, including a positive sequential-boundary fault. */
  method address(packet) :: Bits(xlen.width):
    if xlen == XLen.X64
    | block:
        def low :: CompactPc(xlen) = packet.pc
        def Outcome = RV5StageQueueOutcome(xlen)
        def details = packet.outcome.view(Outcome.Fault).payload
        low.fetch_address(packet.outcome.is(Outcome.Fault) & details.boundary)
    | packet.pc

  /* Qualifies the page-fault payload by the mutually exclusive outcome tag. */
  method page_faulted(packet) :: Bool:
    if xlen == XLen.X64
    | packet.outcome.is(RV5StageQueueOutcome(xlen).Fault) & packet.outcome.view(RV5StageQueueOutcome(xlen).Fault).payload.page_fault
    | packet.page_fault

  /* Qualifies the access-fault payload by the mutually exclusive outcome tag. */
  method access_faulted(packet) :: Bool:
    if xlen == XLen.X64
    | packet.outcome.is(RV5StageQueueOutcome(xlen).Fault) & packet.outcome.view(RV5StageQueueOutcome(xlen).Fault).payload.access_fault
    | packet.access_fault

  /* Reads the packet hint, with no prediction on a faulting packet. */
  method prediction_value(packet) :: RV5StagePacketPrediction(xlen):
    if xlen == XLen.X64
    | mux(packet.outcome.is(RV5StageQueueOutcome(xlen).Fault), literal(RV5StagePacketPrediction(xlen), 0), packet.outcome.view(RV5StageQueueOutcome(xlen).Success).payload)
    | packet.prediction

namespace RV5StageFetchPacket:
  /* Forms the canonical packet directly from scanner results, before any queue or bypass. */
  export fun create(xlen :: XLen, hypervisor :: Boolean, address :: Bits(xlen.width), word :: Bits(32), mask :: Bits(2), page_fault :: Bool, access_fault :: Bool, prediction :: RV5StagePacketPrediction(xlen), guest :: RiscvGuestException()) :~ RV5StageFetchPacket(xlen, hypervisor):
    if xlen == XLen.X64
    | block:
        def Outcome = RV5StageQueueOutcome(xlen)
        def details = RV5StageQueueFault():
          boundary: !CompactPc.fits(xlen, address)
          page_fault: page_fault
          access_fault: access_fault

        def outcome = mux(page_fault ||| access_fault, Outcome.Fault(details), Outcome.Success(prediction))
        if hypervisor
        | RV5StageFetchPacket(xlen, hypervisor):
            pc: CompactPc.capture(xlen, address)
            outcome: outcome
            word: word
            mask: mask
            guest: guest
        | RV5StageFetchPacket(xlen, hypervisor):
            pc: CompactPc.capture(xlen, address)
            outcome: outcome
            word: word
            mask: mask
    | if hypervisor
      | RV5StageFetchPacket(xlen, hypervisor):
          guest: guest
          pc: address
          word: word
          mask: mask
          page_fault: page_fault
          access_fault: access_fault
          prediction: prediction
      | RV5StageFetchPacket(xlen, hypervisor):
          pc: address
          word: word
          mask: mask
          page_fault: page_fault
          access_fault: access_fault
          prediction: prediction

export:
  RV5StagePredictionOwner
  RV5StagePacketPrediction
  RV5StageFetchPacket
  RV5StageFetchRepair
