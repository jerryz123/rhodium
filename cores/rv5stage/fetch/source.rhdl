#lang rhodium
// Selects S0 candidates through Flow, retaining cursor ancestry across blocked issuance.
// SPDX-License-Identifier: Apache-2.0

import:
  "bpd/protocol.rhdl" open
  "bpd/btb.rhdl" open
  "bpd/ras.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

bundle RV5StageFetchAttempt(xlen :: XLen):
  pc: Bits(xlen.width)
  continuation: Bool
  continuation_target: Bits(xlen.width)
  prediction: RV5StagePrediction(xlen)

// Repeated cursor observations keep the last update's owner until replacement.
// An empty cursor is supplied by the reset seed in the caller, not invented lineage.
sync_circuit RV5StageFetchCursor(xlen :: XLen):
  interface update(Valid(RV5StageFetchAttempt(xlen)), ~role: consumer)
  interface stored(Valid(RV5StageFetchAttempt(xlen)), ~role: producer)
  reg occupied(~init: Bool(#false))
  reg payload(RV5StageFetchAttempt(xlen))
  stored.valid <== occupied
  stored.bits <== payload
  when (update.valid):
    occupied <== Bool(#true)
    payload <== update.bits
  describe_interface_retained_storage(update.valid, occupied & update.valid, occupied)
  describe_interface_contract(update, stored, "cursor", ~trace_model: interface_trace_retained())

// Admission is independent of replay/candidate validity; the fallback guarantees
// a candidate. Keep the assertion rather than feeding selection into admission.
sync_circuit RV5StageFetchOffer(xlen :: XLen):
  input enabled: Bool
  interface candidate(Valid(RV5StageFetchAttempt(xlen)), ~role: consumer)
  interface egress(Decoupled(RV5StageFetchAttempt(xlen)), ~role: producer)
  egress.valid <== enabled
  egress.bits <== candidate.bits
  assert(!enabled ||| candidate.valid, "fetch_offer_has_candidate")
  describe_interface_contract(candidate, egress, "admission", ~trace_model: interface_trace_combinational(~guard: enabled))

// S0 offers are Decoupled. Acceptance captures PC/continuation into S1;
// prediction is resolved there and captured with the S2 occurrence.
sync_circuit RV5StageFetchSource(xlen :: XLen, btb_entries :: Nat = 32, ras_entries :: Nat = 6):
  def width = xlen.width
  input active: Bool
  input space: Bool
  interface clear(Pulse(), ~role: consumer)
  interface restart(Valid(Bits(width)), ~role: consumer)
  interface redirect(Valid(Bits(width)), ~role: consumer)
  interface replay(Valid(RV5StageFetchAttempt(xlen)), ~role: consumer)
  interface predictor_flush(Pulse(), ~role: consumer)
  interface predictor_invalidate(Valid(Bits(width)), ~role: consumer)
  interface branch_update(Valid(RV5StageBranchUpdate(xlen)), ~role: consumer)
  interface ras_speculate(Valid(RV5StageRasUpdate(xlen)), ~role: consumer)
  interface ras_restore(Pulse(), ~role: consumer)
  interface btb_discover(Valid(RV5StagePrediction(xlen)), ~role: consumer)
  interface attempts(Decoupled(RV5StageFetchAttempt(xlen)), ~role: producer)
  interface stage1(Valid(RV5StageFetchAttempt(xlen)), ~role: producer)
  output ras_head_valid: Bool
  output ras_head: Bits(width)

  reg running(~init: Bool(#true))
  inst cursor(RV5StageFetchCursor(xlen))
  inst offer(RV5StageFetchOffer(xlen))
  inst btb(RV5StageBtb(xlen, btb_entries))
  inst ras(RV5StageRas(xlen, if btb_entries == 0 | 0 | ras_entries))
  def command = clear.valid ||| restart.valid ||| redirect.valid
  inst s1(ValidPipeAlwaysCapture(RV5StageFetchAttempt(xlen), 1, ~flushable: #true))
  btb.cursor <== s1.egress.bits.pc
  btb.invalidate_all.valid <== predictor_flush.valid
  ras.clear.valid <== predictor_flush.valid
  predictor_invalidate |> btb.invalidate
  btb_discover |> btb.discover
  def Array(btb_update, ras_resolution) = branch_update |> fork_valid(2)
  btb_update |> btb.update
  (ras_resolution |> map_valid(update => RV5StageRasResolution(xlen)):
    actual:
      RV5StageRasUpdate(xlen):
        action: update.ras_action
        return_address: update.return_address
    predicted_action: update.predicted_ras_action
  ) |> ras.resolve
  ras_speculate |> ras.speculate
  ras_restore |> ras.restore
  ras_head_valid <== ras.head_valid
  ras_head <== ras.head
  def stored_prediction = btb.prediction
  def predicted_return = stored_prediction.ras_action.is_one_of(RV5StageRasAction.Pop, RV5StageRasAction.PopPush) & ras.head_valid
  def btb_prediction = stored_prediction.updated(~target: mux(predicted_return, ras.head, stored_prediction.target))
  def prediction = mux(s1.egress.bits.continuation, literal(RV5StagePrediction(xlen), 0), btb_prediction)
  def predicted_straddle = prediction.valid & prediction.pc[1].into(Bool) & !prediction.compressed
  def next_pc = mux(s1.egress.bits.continuation, s1.egress.bits.continuation_target, mux(prediction.valid & !predicted_straddle, prediction.target, s1.egress.bits.pc.align_down(4) + bits(4, width)))
  def redirecting = restart.valid ||| redirect.valid
  def restart_candidates = Array(restart, redirect) |> valid_arbiter() |> map_valid(pc => RV5StageFetchAttempt(xlen)):
    pc: pc
    continuation: Bool(#false)
    continuation_target: pc
    prediction: literal(RV5StagePrediction(xlen), 0)
  def Array(restart_offer, restart_update) = restart_candidates |> fork_valid(2)
  def Array(replay_offer, replay_update) = (replay |> map_valid(attempt => attempt.updated(~prediction: literal(RV5StagePrediction(xlen), 0)))) |> fork_valid(2)
  def Array(prediction_source, lookup_source) = s1.egress |> fork_valid(2)
  def next_candidates = prediction_source |> map_valid(_attempt => RV5StageFetchAttempt(xlen)):
    pc: next_pc
    continuation: predicted_straddle
    continuation_target: prediction.target
    prediction: literal(RV5StagePrediction(xlen), 0)
  def Array(next_offer, next_update) = next_candidates |> fork_valid(2)
  def seed :: Handle = interface_link(Valid(RV5StageFetchAttempt(xlen)))
  seed.left.valid <== Bool(#true)
  seed.left.bits <== literal(RV5StageFetchAttempt(xlen), 0)
  def saved = Array(cursor.stored, seed.right) |> valid_arbiter()
  def Array(saved_offer, saved_clear) = saved |> fork_valid(2)
  Array(restart_offer, replay_offer, next_offer, saved_offer) |> valid_arbiter() |> offer.candidate
  // Restart bypasses old-epoch reservation; a late redirect preserves the epoch
  // and issues only with space. Neither admission depends on candidate validity.
  offer.enabled <== restart.valid ||| (redirect.valid & space) ||| (active & running & !command & space)
  // The S1 lookup result is captured with this occurrence at the S2 boundary.
  (lookup_source |> map_valid(attempt => attempt.updated(~prediction: prediction))) |> stage1
  // Acceptance alone advances S1; an unaccepted offer owns no pipeline slot.
  def accepted = offer.egress |> trace_event("frontend/s0.request", ~fields: attempt):
    pc: attempt.pc
  // A transferred restart replaces the old S1 occurrence at this edge.
  // Otherwise command clears S1 and the cursor retains the restart for retry.
  def Array(requests, contexts, advanced) = accepted |> atomic_fork(3)
  requests |> attempts
  contexts |> to_valid() |> s1.ingress
  s1.flush <== command & !attempts.fire()

  // Preserve the original state-update priority, distinct from live PC selection.
  // Restart stores its target even when that same-cycle replacement transfers.
  Array(
    restart_update |> map_valid(attempt => attempt.updated(~continuation_target: saved.bits.continuation_target)),
    saved_clear |> filter_valid(_attempt => clear.valid) |> map_valid(attempt => attempt.updated(~continuation: Bool(#false))),
    advanced |> to_valid() |> filter_valid(_attempt => !command) |> map_valid(attempt => attempt.updated(~pc: attempt.pc.align_down(4) + bits(4, width), ~continuation: Bool(#false), ~continuation_target: saved.bits.continuation_target)),
    replay_update |> filter_valid(_attempt => !command),
    next_update |> filter_valid(_attempt => !command)
  ) |> valid_arbiter() |> cursor.update
  when command: running <== redirecting

export:
  RV5StageFetchAttempt
  RV5StageFetchSource
