#lang rhodium
/* Shares LSU ports and carries selected lookup lineage through fixed-cycle response routing. */
// SPDX-License-Identifier: Apache-2.0

import:
  "memory-context.rhdl" open
  "../common/cache/protocol.rhdl" open
  "../common/memory-arbiter.rhdl" open
  "../../riscv/isa/xlen.rhm" open
  lib("rhodium/std/bits.rhdl").Pow2Int
  lib("flow/main.rhdl") open

/* Prioritizes admitted vector transactions but scalar speculative lookups.
   Losing lookups use authorized transaction service; retained selection routes store commit and tagged responses. */
sync_circuit RV5StageMemoryArbiter(xlen :: XLen, slots :: Pow2Int):
  interface scalar(CacheAccess(xlen, RV5StageMemoryContext(slots)), ~role: responder)
  interface vector(CacheAccess(xlen, RV5StageMemoryContext(slots)), ~role: responder)
  interface memory(CacheAccess(xlen, RV5StageMemoryContext(slots)), ~role: requester)
  interface scalar_pipeline(CachePipelineAccess(xlen), ~role: responder)
  interface vector_pipeline(CachePipelineAccess(xlen), ~role: responder)
  interface pipeline(CachePipelineAccess(xlen), ~role: requester)
  output pipeline_vector: Bool

  /* Authorized requests: admitted vector work precedes younger scalar WB.
     Return routing uses retained writeback tags, not the live arbiter choice. */

  def selected_vector = arbitrate_memory_transactions(
    scalar, vector, memory,
    ~vector_response: fun (reply :: PhysicalMemoryResp(xlen, RV5StageMemoryContext(slots))): reply.context.writeback.is(RV5StageMemoryWriteback(slots).Vector).as_bits()
  )
  scalar.request_fault <== memory.request_fault & !selected_vector
  scalar.request_access_fault <== memory.request_access_fault & !selected_vector
  vector.request_fault <== memory.request_fault & selected_vector
  vector.request_access_fault <== memory.request_access_fault & selected_vector


  def slow = CachePipelineResult(xlen):
    outcome: CachePipelineOutcome.Slow
    reason: CachePipelineReason.ArrayPort
    data: Bits(xlen.width)(0)

  def (lookup_vector, _) = arbitrate_memory_lookups(
    CachePipelineReq(xlen), CachePipelineResult(xlen), scalar_pipeline, vector_pipeline, pipeline, ~slow: slow, ~slow_on_absence: #true
  )
  pipeline_vector <== lookup_vector

export:
  RV5StageMemoryArbiter
