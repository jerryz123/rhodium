#lang rhodium
// Defines RV5Stage's semantic memory operations and local atomic-update datapath.

import:
  "../load-store.rhdl" open
  "../../riscv/isa/xlen.rhm" open
  lib("rhodium/std/bits.rhdl") open

// Architectural intent, independent of a cache's allocation/replacement policy.
hardware_enum RV5StageMemoryLocality:
  Default
  P1
  Pall
  S1
  All

hardware_enum MemoryOperation:
  None
  Load
  Store
  LoadReserved
  StoreConditional
  Atomic
  CacheBlockZero
  CacheBlockInvalidate
  CacheBlockClean
  CacheBlockFlush

  method is_memory(operation) :: Bool:
    operation =/= MemoryOperation.None

  method is_load(operation) :: Bool:
    operation.is_one_of(MemoryOperation.Load,
                        MemoryOperation.LoadReserved)

  method is_store(operation) :: Bool:
    operation === MemoryOperation.Store

  method is_atomic(operation) :: Bool:
    operation === MemoryOperation.Atomic

  method is_cache_block_zero(operation) :: Bool:
    operation === MemoryOperation.CacheBlockZero

  method is_cache_management(operation) :: Bool:
    operation.is_one_of(MemoryOperation.CacheBlockInvalidate, MemoryOperation.CacheBlockClean, MemoryOperation.CacheBlockFlush)

  method is_cache_block(operation) :: Bool:
    operation.is_cache_block_zero() ||| operation.is_cache_management()

  method store_fault_class(operation) :: Bool:
    operation.needs_unique() ||| operation.is_cache_management()

  method is_store_conditional(operation) :: Bool:
    operation === MemoryOperation.StoreConditional

  method needs_unique(operation) :: Bool:
    operation.is_one_of(MemoryOperation.Store,
                        MemoryOperation.StoreConditional,
                        MemoryOperation.Atomic,
                        MemoryOperation.CacheBlockZero)

  method returns_old_value(operation) :: Bool:
    operation.is_one_of(MemoryOperation.Load,
                        MemoryOperation.LoadReserved,
                        MemoryOperation.Atomic)

  method returns_result(operation) :: Bool:
    operation.is_one_of(MemoryOperation.Load,
                        MemoryOperation.LoadReserved,
                        MemoryOperation.StoreConditional,
                        MemoryOperation.Atomic)

hardware_enum RV5StageAtomicOperation:
  Swap
  Add
  Xor
  And
  Or
  Min
  Max
  MinUnsigned
  MaxUnsigned

circuit RV5StageAtomicALU(xlen :: XLen):
  def width = xlen.width

  input old_value: Bits(width)
  input operand: Bits(width)
  input memory_width: MemoryWidth
  input operation: RV5StageAtomicOperation
  output value: Bits(width)

  def word_operation = if xlen == XLen.X64 | memory_width === MemoryWidth.Word | Bool(#false)
  def left = if xlen == XLen.X64 | mux(word_operation, old_value[0..32].zext(64), old_value) | old_value
  def right = if xlen == XLen.X64 | mux(word_operation, operand[0..32].zext(64), operand) | operand
  def unsigned_less = left < right
  def left_sign = if xlen == XLen.X64 | mux(word_operation, left[31].into(Bool), left[63].into(Bool)) | left[31].into(Bool)
  def right_sign = if xlen == XLen.X64 | mux(word_operation, right[31].into(Bool), right[63].into(Bool)) | right[31].into(Bool)
  def signed_less = mux(left_sign ^ right_sign, left_sign, unsigned_less)
  def selected_value :: Bits(width) = mux_lookup(
    operation,
    ~default: right,
    [
      [RV5StageAtomicOperation.Add, left + right],
      [RV5StageAtomicOperation.Xor, left ^ right],
      [RV5StageAtomicOperation.And, left & right],
      [RV5StageAtomicOperation.Or, left ||| right],
      [RV5StageAtomicOperation.Min, mux(signed_less, left, right)],
      [RV5StageAtomicOperation.Max, mux(signed_less, right, left)],
      [RV5StageAtomicOperation.MinUnsigned, mux(unsigned_less, left, right)],
      [RV5StageAtomicOperation.MaxUnsigned, mux(unsigned_less, right, left)]
    ]
  )
  value <== if xlen == XLen.X64 | mux(word_operation, selected_value[0..32].zext(64), selected_value) | selected_value

export:
  RV5StageMemoryLocality
  MemoryOperation
  RV5StageAtomicOperation
  RV5StageAtomicALU
