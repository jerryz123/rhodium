#lang rhodium
// Routes physical instruction fetches between the allocating L1I and ordered uncached path.

import:
  "icache/protocol.rhdl" open
  "uncached-protocol.rhdl" open
  "../../riscv/isa/xlen.rhm".XLen
  lib("flow/main.rhdl") open

sync_circuit RV5StageInstructionMemoryRouter(xlen :: XLen):
  interface core(RV5StagePhysicalInstructionAccess(xlen), ~role: responder)
  interface cache(RV5StageInstructionAccess(xlen), ~role: requester)
  interface uncached(RV5StagePhysicalInstructionAccess(xlen), ~role: requester)

  inst owners(Queue(Bool, 2), ~reset_when: core.flush)
  def request = core.request.bits
  def request_uncached = !request.cacheable
  def Array(cache_requests, uncached_requests) = (
    core.request |> gate_flow(!core.flush & owners.ingress.ready)
      |> demux_flow(2, request => (!request.cacheable).as_bits())
  )
  cache.flush <== core.flush
  cache.invalidate_all <== core.invalidate_all
  (cache_requests |> map_flow(request => RV5StageInstructionReq(xlen)):
    address: request.address
  ) |> cache.request
  uncached.flush <== core.flush
  uncached.invalidate_all <== core.invalidate_all
  uncached_requests |> uncached.request
  owners.ingress.valid <== core.request.fire()
  owners.ingress.bits <== request_uncached

  def owner_valid = owners.egress.valid
  def owner_uncached = owners.egress.bits
  // Keep the ordered response boundary explicit: generic gated arbitration
  // exposes Decoupled, while the physical instruction interface is Irrevocable.
  def selected_valid = mux(owner_uncached, uncached.response.valid, cache.response.valid)
  core.response.valid <== owner_valid & selected_valid & !core.flush
  core.response.bits <== mux(owner_uncached, uncached.response.bits, cache.response.bits)
  cache.response.ready <== owner_valid & !owner_uncached & core.response.ready & !core.flush
  uncached.response.ready <== owner_valid & owner_uncached & core.response.ready & !core.flush
  owners.egress.ready <== core.response.fire()

export:
  RV5StageInstructionMemoryRouter
