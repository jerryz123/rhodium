#lang rhodium
/* Selects fixed-latency cache outcomes and retains one ordered uncached fetch. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../cache/l1i/protocol.rhdl" open
  "icache/protocol.rhdl" open
  "uncached-protocol.rhdl" open
  "../../riscv/isa/xlen.rhm".XLen
  lib("flow/main.rhdl") open

/* Returns an outcome for every live S2 attempt, replaying until uncached data is available.
   Redirects detach uncached consumers while the engine drains accepted traffic. */
sync_circuit RV5StageInstructionMemoryRouter(xlen :: XLen):
  interface core(RV5StageInstructionLookup(RV5StagePhysicalInstructionReq(xlen)), ~role: responder)
  interface cache(InstructionCacheLookup(xlen.width, 32), ~role: requester)
  interface uncached(RV5StagePhysicalInstructionAccess(xlen), ~role: requester)


  /* S1/S2 cached lookup.
     Capture every surviving attempt while only cacheable requests reach L1I. */

  inst s2(ValidPipeAlwaysCapture(RV5StagePhysicalInstructionReq(xlen), 1), ~reset_when: core.flush)
  core.request |> filter_valid(_request => !core.s1_kill & !core.flush) |> s2.ingress
  cache.flush <== core.flush
  cache.invalidate_all <== core.invalidate_all
  cache.s1_kill <== core.s1_kill
  (core.request |> filter_valid(request => request.cacheable & !core.s1_kill & !core.flush)
    |> map_valid(request => InstructionCacheReq(xlen.width)):
      address: request.address
  ) |> cache.request


  /* Retained uncached fetch ownership.
     These registers do not hold cache hits. Redirect detaches the consumer;
     the downstream engine still drains accepted traffic. */

  reg pending(~init: Bool(#false))
  reg completed(~init: Bool(#false))
  reg address(Bits(xlen.width))
  reg response(RV5StageInstructionResp(#false))
  def uncached_attempt = s2.egress.valid & !s2.egress.bits.cacheable & !core.flush
  def completed_match = completed & (address === s2.egress.bits.address)
  uncached.flush <== core.flush
  uncached.invalidate_all <== core.invalidate_all
  s2.egress |> filter_valid(request => !request.cacheable & !core.flush & !pending & !completed)
    |> offer_decoupled() |> uncached.request
  def uncached_completed = uncached.response |> gate_flow(pending & !core.flush) |> to_valid()


  /* S2 outcome selection.
     Every live attempt receives an outcome, even when its selected path has
     no result yet. Missing cached data and unmatched uncached data replay. */

  def unavailable = RV5StageFetchResult(#false):
    response: literal(RV5StageInstructionResp(#false), 0)
    replay: Bool(#true)

  def uncached_result = RV5StageFetchResult(#false):
    response: response
    replay: !completed_match

  def cached_result = RV5StageFetchResult(#false):
    response:
      RV5StageInstructionResp(#false):
        word: cache.response.bits.data
        page_fault: Bool(#false)
        access_fault: cache.response.bits.access_fault

    replay: cache.response.bits.replay

  def cached_outcome = mux(cache.response.valid, cached_result, unavailable)
  s2.egress |> filter_valid(_request => !core.flush)
    |> map_valid(request => mux(request.cacheable, cached_outcome, uncached_result))
    |> core.response


  /* Uncached lifecycle and cancellation.
     Flush wins; otherwise capture, completion, and matching consumption are
     ordered. Completed data remains retained until the matching attempt. */

  when (core.flush):
    pending <== Bool(#false)
    completed <== Bool(#false)
  otherwise:
    when (uncached.request.fire()):
      pending <== Bool(#true)
      address <== s2.egress.bits.address
    elsewhen (uncached_completed.valid):
      pending <== Bool(#false)
      completed <== Bool(#true)
      response <== uncached_completed.bits
    elsewhen (uncached_attempt & completed_match):
      completed <== Bool(#false)

export:
  RV5StageInstructionMemoryRouter
