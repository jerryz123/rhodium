#lang rhodium
/* Defines floating-point execution controls shared by RV5Stage scalar and vector decode. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../riscv/rtl/floating-point.rhdl".FloatSignOperation
  lib("hardfloat/main.rhdl").MulAddOperation
  lib("hardfloat/main.rhdl").MinMaxOperation
  lib("hardfloat/main.rhdl").Estimate7Operation

/* Selects operand or result IEEE precision independently of architectural register width. */
hardware_enum RV5StageFloatPrecision:
  Half
  Single
  Double

/* Routes a decoded FP operation to memory, arithmetic, conversion, or bit-manipulation
   execution. */
hardware_enum RV5StageFloatUnit:
  Memory
  FusedMultiplyAdd
  Add
  Multiply
  DivideSquareRoot
  SignInject
  MinMax
  Compare
  Convert
  Move
  Classify
  Estimate
  Immediate
  RoundToIntegral
  IntegerModulo

/* Selects addition or subtraction in the shared format datapath. */
hardware_enum RV5StageFloatAddOperation:
  Add
  Subtract

/* Selects division or square root in a variable-latency lane. */
hardware_enum RV5StageFloatDivideOperation:
  Divide
  SquareRoot

/* Selects the Boolean comparison result after HardFloat evaluates ordering. */
hardware_enum RV5StageFloatComparison:
  Equal
  NotEqual
  Less
  LessEqual

/* Selects integer conversion width before XLEN normalization. */
hardware_enum RV5StageFloatIntegerWidth:
  Byte
  Half
  Word
  Long

/* Carries numerical operation controls independently of register hazards and destination
   ownership. */
bundle RV5StageFloatExecutionControl():
  unit: RV5StageFloatUnit
  source_precision: RV5StageFloatPrecision
  destination_precision: RV5StageFloatPrecision
  uses_rounding_mode: Bool
  memory_write: Bool
  fused_operation: MulAddOperation
  add_operation: RV5StageFloatAddOperation
  divide_operation: RV5StageFloatDivideOperation
  sign_operation: FloatSignOperation
  minmax_operation: MinMaxOperation
  estimate_operation: Estimate7Operation
  comparison: RV5StageFloatComparison
  comparison_signaling: Bool
  round_raise_inexact: Bool
  integer_width: RV5StageFloatIntegerWidth
  integer_unsigned: Bool

export:
  RV5StageFloatPrecision
  RV5StageFloatUnit
  RV5StageFloatAddOperation
  RV5StageFloatDivideOperation
  RV5StageFloatComparison
  RV5StageFloatIntegerWidth
  RV5StageFloatExecutionControl
