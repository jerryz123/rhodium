#lang rhodium
// Shares operand-level FP execution and retained results without architectural register ownership.
// SPDX-License-Identifier: Apache-2.0

import:
  "bundles.rhdl" open
  "datapath.rhdl" open
  "div-sqrt.rhdl" open
  "../decode/fp-ctrl.rhdl" open
  "../../../riscv/isa/fp-profile.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  lib("flow/main.rhdl") open

sync_circuit RV5StageFpExecutionService(
  xlen :: XLen,
  profile :: FloatingPointProfile,
  Tag :: DataType,
  ~half_precision: half_precision :: HalfPrecisionProfile = DefaultHalfPrecisionProfile,
  ~zfa: zfa_enabled :: Boolean = #false
):
  check_rv5stage_floating_point_profile(xlen, profile, half_precision, ~zfa: zfa_enabled)
  unless floating_point_supports_f(profile)
  | error(~who: #'RV5StageFpExecutionService, "FP execution requires RV32F or RV64D")
  def ExecutionRequest = RV5StageFpExecutionRequest(xlen, profile, Tag)
  def Result = RV5StageFpExecutionResult(xlen, profile, Tag)
  interface request(Decoupled(ExecutionRequest), ~role: consumer)
  interface result(Irrevocable(Result), ~role: producer)

  def FixedModule = cond
  | !half_precision_supports_zfhmin(half_precision):
      if profile == FloatingPointProfile.F | RV5StageFpFixedF(xlen, Tag, ~zfa: zfa_enabled) | RV5StageFpFixedD(xlen, Tag, ~zfa: zfa_enabled)
  | profile == FloatingPointProfile.F:
      RV5StageFpFixedFHalf(xlen, Tag, ~arithmetic: half_precision_supports_zfh(half_precision), ~zfa: zfa_enabled)
  | ~else:
      RV5StageFpFixedDHalf(xlen, Tag, ~arithmetic: half_precision_supports_zfh(half_precision), ~zfa: zfa_enabled)
  def DivSqrtModule = cond
  | !half_precision_supports_zfh(half_precision):
      if profile == FloatingPointProfile.F | RV5StageFpDivSqrtF(xlen, Tag) | RV5StageFpDivSqrtD(xlen, Tag)
  | profile == FloatingPointProfile.F: RV5StageFpDivSqrtFHalf(xlen, Tag)
  | ~else: RV5StageFpDivSqrtDHalf(xlen, Tag)
  inst fixed(FixedModule)
  inst div_sqrt(DivSqrtModule)
  inst fixed_responses(CompletionQueue(ExecutionRequest, Result, 4))
  fixed.request <== fixed_responses.issue.bits
  fixed_responses.issue |> map_valid(_request => fixed.completion)
    |> valid_pipe(2)
    |> fixed_responses.completion

  inst completion_merge(RRArbiter(Result, 2))
  fixed_responses.response |> completion_merge.ingress[0]
  div_sqrt.completion |> completion_merge.ingress[1]
  inst completed(Queue(Result, 2, ~pipe: #true))
  completion_merge.egress |> completed.ingress
  completed.egress |> result

  // Admission reserves completion space before launching nonstallable work.
  // Callers arbitrate authorized operands and retain their own destination state.
  def Array(fixed_request, division_request) = (
    request |> demux_flow(2, issued => issued.control.execution.unit === RV5StageFloatUnit.DivideSquareRoot)
  )
  fixed_request |> fixed_responses.request
  division_request |> div_sqrt.request
  when (request.valid):
    assert(request.bits.control.execution.unit =/= RV5StageFloatUnit.Memory, "rv5stage_fp_execution_requires_compute")

export:
  RV5StageFpExecutionService
