#lang rhodium
// Implements RV5Stage's combinational fixed-latency floating-point execution datapaths.
// SPDX-License-Identifier: Apache-2.0

import:
  "bundles.rhdl" open
  "../decode/fp-ctrl.rhdl" open
  "../../../riscv/isa/fp-profile.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/rtl/floating-point.rhdl" open
  lib("hardfloat/main.rhdl") open
  lib("rhodium/std/bits.rhdl") open

fun fp_move_to_integer(xlen :: XLen,
                       format :: FloatFormat,
                       value :: IEEEFloat(format)) :~ Bits(xlen.width):
  if format.ieee_width <= xlen.width
  | riscv_float_to_integer_move(xlen, format, value)
  | bits(0, xlen.width)

fun integer_move_to_fp(xlen :: XLen,
                       format :: FloatFormat,
                       value :: Bits(xlen.width)) :~ IEEEFloat(format):
  if xlen.width >= format.ieee_width
  | riscv_integer_to_float_move(format, xlen.width, value)
  | bits(0, format.ieee_width).into(IEEEFloat(format))

fun fp_integer_word_input(xlen :: XLen,
                          value :: Bits(xlen.width),
                          unsigned :: Bool) :~ Bits(xlen.width):
  if xlen == XLen.X32
  | value
  | mux(unsigned,
        value[0..32].zext(64),
        value[0..32].into(SInt(32)).sext(64).as_bits())

fun fp_integer_word_result(xlen :: XLen,
                           value :: Bits(32)) :~ Bits(xlen.width):
  if xlen == XLen.X32
  | value
  | value.into(SInt(32)).sext(64).as_bits()

circuit RV5StageDisabledZfaFormatDatapath(format :: FloatFormat):
  input value: RecFloat(format)
  input rounding_mode: RoundingMode
  input raise_inexact: Bool
  input immediate_index: Bits(5)
  output immediate: IEEEFloat(format)
  output rounded: RecFloat(format)
  output round_exception_flags: Bits(5)
  output modulo: Bits(32)
  output modulo_exception_flags: Bits(5)

  immediate <== dont_care(IEEEFloat(format))
  rounded <== dont_care(RecFloat(format))
  round_exception_flags <== bits(0, 5)
  modulo <== bits(0, 32)
  modulo_exception_flags <== bits(0, 5)

circuit RV5StageDisabledZfaModulo(format :: FloatFormat):
  input value: RecFloat(format)
  output result: Bits(32)
  output exception_flags: Bits(5)

  result <== bits(0, 32)
  exception_flags <== bits(0, 5)

circuit RV5StageZfaModulo(format :: FloatFormat):
  input value: RecFloat(format)
  output result: Bits(32)
  output exception_flags: Bits(5)

  inst convert(RecFNToIntegerModulo(format, 32))
  convert.value <== value
  convert.rounding_mode <== RoundingMode.MinMagnitude
  convert.signed_output <== Bool(#true)
  result <== convert.out
  exception_flags <== riscv_integer_exception_flags(convert.exception_flags)

circuit RV5StageZfaFormatDatapath(format :: FloatFormat,
                                  ~modulo: modulo_enabled :: Boolean = #false):
  input value: RecFloat(format)
  input rounding_mode: RoundingMode
  input raise_inexact: Bool
  input immediate_index: Bits(5)
  output immediate: IEEEFloat(format)
  output rounded: RecFloat(format)
  output round_exception_flags: Bits(5)
  output modulo: Bits(32)
  output modulo_exception_flags: Bits(5)

  inst round(RoundToIntegralRecFN(format))
  round.value <== value
  round.rounding_mode <== rounding_mode
  round.raise_inexact <== raise_inexact
  def ModuloModule = if modulo_enabled | RV5StageZfaModulo(format) | RV5StageDisabledZfaModulo(format)
  inst modulo_convert(ModuloModule)
  modulo_convert.value <== value
  immediate <== riscv_float_immediate(format, immediate_index)
  rounded <== round.out
  round_exception_flags <== riscv_exception_flags(round.exception_flags)
  modulo <== modulo_convert.result
  modulo_exception_flags <== modulo_convert.exception_flags

circuit RV5StageFpFormatDatapath(
  xlen :: XLen,
  profile :: FloatingPointProfile,
  format :: FloatFormat,
  Context :: DataType,
  ~zfa: zfa_enabled :: Boolean = #false,
  ~zfa_modulo: zfa_modulo_enabled :: Boolean = #false
):
  def width = xlen.width
  def flen = floating_point_register_width(profile)
  unless flen >= format.ieee_width
  | error(~who: #'RV5StageFpFormatDatapath,
          "floating-point register width must cover the selected format")

  input request: RV5StageFpExecutionRequest(xlen, profile, Context)
  output completion: RV5StageFpCompletion(xlen, profile, Context)

  def control = request.control.execution
  def left = riscv_unbox(format, flen, request.left)
  def right = riscv_unbox(format, flen, request.right)
  def third = riscv_unbox(format, flen, request.third)
  def left_recoded = left.to_recoded()
  def right_recoded = right.to_recoded()
  def third_recoded = third.to_recoded()

  inst add(AddRecFN(format))
  add.subtract <== control.add_operation === RV5StageFloatAddOperation.Subtract
  add.a <== left_recoded
  add.b <== right_recoded
  add.rounding_mode <== request.rounding_mode
  add.tininess_mode <== TininessMode.AfterRounding

  inst multiply(MulRecFN(format))
  multiply.a <== left_recoded
  multiply.b <== right_recoded
  multiply.rounding_mode <== request.rounding_mode
  multiply.tininess_mode <== TininessMode.AfterRounding

  inst fused(MulAddRecFN(format))
  fused.operation <== control.fused_operation
  fused.a <== left_recoded
  fused.b <== right_recoded
  fused.c <== third_recoded
  fused.rounding_mode <== request.rounding_mode
  fused.tininess_mode <== TininessMode.AfterRounding

  inst compare(CompareRecFN(format))
  compare.a <== left_recoded
  compare.b <== right_recoded
  compare.signaling <== control.comparison_signaling
  def comparison_value = mux_lookup(
    control.comparison,
    ~default: compare.eq,
    [
      [RV5StageFloatComparison.Less, compare.lt],
      [RV5StageFloatComparison.LessEqual, compare.lt ||| compare.eq]
    ]
  )

  inst minmax(MinMaxRecFN(format))
  minmax.a <== left_recoded
  minmax.b <== right_recoded
  minmax.operation <== control.minmax_operation

  def ZfaModule = if zfa_enabled | RV5StageZfaFormatDatapath(format, ~modulo: zfa_modulo_enabled) | RV5StageDisabledZfaFormatDatapath(format)
  inst zfa(ZfaModule)
  zfa.value <== left_recoded
  zfa.rounding_mode <== request.rounding_mode
  zfa.raise_inexact <== control.round_raise_inexact
  zfa.immediate_index <== request.immediate_index

  def normalized_word = fp_integer_word_input(
    xlen,
    request.integer_operand,
    control.integer_unsigned
  )
  def normalized_integer = mux(
    control.integer_width === RV5StageFloatIntegerWidth.Word,
    normalized_word,
    request.integer_operand
  )
  inst integer_to_fp(IntegerToRecFN(width, format))
  integer_to_fp.signed_input <== !control.integer_unsigned
  integer_to_fp.value <== normalized_integer
  integer_to_fp.rounding_mode <== request.rounding_mode
  integer_to_fp.tininess_mode <== TininessMode.AfterRounding

  inst fp_to_word(RecFNToInteger(format, 32))
  fp_to_word.value <== left_recoded
  fp_to_word.rounding_mode <== request.rounding_mode
  fp_to_word.signed_output <== !control.integer_unsigned
  inst fp_to_integer(RecFNToInteger(format, width))
  fp_to_integer.value <== left_recoded
  fp_to_integer.rounding_mode <== request.rounding_mode
  fp_to_integer.signed_output <== !control.integer_unsigned
  def converted_word = fp_integer_word_result(xlen, fp_to_word.out)
  def converted_integer = mux(
    control.integer_width === RV5StageFloatIntegerWidth.Word,
    converted_word,
    fp_to_integer.out
  )
  def conversion_flags = mux(
    control.integer_width === RV5StageFloatIntegerWidth.Word,
    riscv_integer_exception_flags(fp_to_word.exception_flags),
    riscv_integer_exception_flags(fp_to_integer.exception_flags)
  )

  def sign_value = riscv_sign_inject(format, left, right, control.sign_operation)
  def move_source = request.left[0..format.ieee_width].into(IEEEFloat(format))
  def integer_move_value = fp_move_to_integer(xlen, format, move_source)
  def fp_move_value = integer_move_to_fp(xlen, format, request.integer_operand)
  def class_value = riscv_classify(format, left).zext(width)
  def fp_destination = request.control.registers.destination === RV5StageFloatDestination.FloatingPoint
  def converted_fp = riscv_canonicalize_nan(format, integer_to_fp.out.to_ieee())
  def arithmetic_fp = mux_lookup(
    control.unit,
    ~default: riscv_canonical_nan(format),
    [
      [RV5StageFloatUnit.FusedMultiplyAdd,
       riscv_canonicalize_nan(format, fused.out.to_ieee())],
      [RV5StageFloatUnit.Add,
       riscv_canonicalize_nan(format, add.out.to_ieee())],
      [RV5StageFloatUnit.Multiply,
       riscv_canonicalize_nan(format, multiply.out.to_ieee())],
      [RV5StageFloatUnit.SignInject, sign_value],
      [RV5StageFloatUnit.MinMax,
       riscv_canonicalize_nan(format, minmax.out.to_ieee())],
      [RV5StageFloatUnit.Convert, converted_fp],
      [RV5StageFloatUnit.Move, fp_move_value],
      [RV5StageFloatUnit.Immediate, zfa.immediate],
      [RV5StageFloatUnit.RoundToIntegral,
       riscv_canonicalize_nan(format, zfa.rounded.to_ieee())]
    ]
  )
  def integer_value = mux_lookup(
    control.unit,
    ~default: bits(0, width),
    [
      [RV5StageFloatUnit.Compare, comparison_value.as_bits().zext(width)],
      [RV5StageFloatUnit.Convert, converted_integer],
      [RV5StageFloatUnit.IntegerModulo,
       fp_integer_word_result(xlen, zfa.modulo)],
      [RV5StageFloatUnit.Move, integer_move_value],
      [RV5StageFloatUnit.Classify, class_value]
    ]
  )
  def exception_flags = mux_lookup(
    control.unit,
    ~default: bits(0, 5),
    [
      [RV5StageFloatUnit.FusedMultiplyAdd,
       riscv_exception_flags(fused.exception_flags)],
      [RV5StageFloatUnit.Add, riscv_exception_flags(add.exception_flags)],
      [RV5StageFloatUnit.Multiply,
       riscv_exception_flags(multiply.exception_flags)],
      [RV5StageFloatUnit.MinMax,
       riscv_exception_flags(minmax.exception_flags)],
      [RV5StageFloatUnit.Compare,
       riscv_exception_flags(compare.exception_flags)],
      [RV5StageFloatUnit.Convert,
       mux(fp_destination,
           riscv_exception_flags(integer_to_fp.exception_flags),
           conversion_flags)],
      [RV5StageFloatUnit.RoundToIntegral, zfa.round_exception_flags],
      [RV5StageFloatUnit.IntegerModulo, zfa.modulo_exception_flags]
    ]
  )
  def exception_flags_valid = control.unit.is_one_of(
    RV5StageFloatUnit.FusedMultiplyAdd,
    RV5StageFloatUnit.Add,
    RV5StageFloatUnit.Multiply,
    RV5StageFloatUnit.MinMax,
    RV5StageFloatUnit.Compare,
    RV5StageFloatUnit.Convert,
    RV5StageFloatUnit.RoundToIntegral,
    RV5StageFloatUnit.IntegerModulo
  )

  completion <== RV5StageFpCompletion(xlen, profile, Context):
    context: request.context
    destination: request.control.registers.destination
    rd: request.rd
    integer_value: integer_value
    fp_value: riscv_nan_box(format, arithmetic_fp, flen)
    exception_flags: exception_flags
    exception_flags_valid: exception_flags_valid

circuit RV5StageFpHalfMinimalDatapath(xlen :: XLen, profile :: FloatingPointProfile, Context :: DataType):
  def flen = floating_point_register_width(profile)
  input request: RV5StageFpExecutionRequest(xlen, profile, Context)
  output completion: RV5StageFpCompletion(xlen, profile, Context)

  def format = FloatFormat.F16
  def source = request.left[0..format.ieee_width].into(IEEEFloat(format))
  completion <== RV5StageFpCompletion(xlen, profile, Context):
    context: request.context
    destination: request.control.registers.destination
    rd: request.rd
    integer_value: fp_move_to_integer(xlen, format, source)
    fp_value: riscv_nan_box(format,
                            integer_move_to_fp(xlen, format, request.integer_operand),
                            flen)
    exception_flags: bits(0, 5)
    exception_flags_valid: Bool(#false)

circuit RV5StageFpFixedF(xlen :: XLen,
                         Context :: DataType,
                         ~zfa: zfa_enabled :: Boolean = #false):
  input request: RV5StageFpExecutionRequest(xlen, FloatingPointProfile.F, Context)
  output completion: RV5StageFpCompletion(xlen, FloatingPointProfile.F, Context)

  inst single(RV5StageFpFormatDatapath(
    xlen,
    FloatingPointProfile.F,
    FloatFormat.F32,
    Context,
    ~zfa: zfa_enabled
  ))
  single.request <== request
  completion <== single.completion

circuit RV5StageFpFixedD(xlen :: XLen,
                         Context :: DataType,
                         ~zfa: zfa_enabled :: Boolean = #false):
  input request: RV5StageFpExecutionRequest(xlen, FloatingPointProfile.D, Context)
  output completion: RV5StageFpCompletion(xlen, FloatingPointProfile.D, Context)

  inst single(RV5StageFpFormatDatapath(
    xlen,
    FloatingPointProfile.D,
    FloatFormat.F32,
    Context,
    ~zfa: zfa_enabled
  ))
  inst double(RV5StageFpFormatDatapath(
    xlen,
    FloatingPointProfile.D,
    FloatFormat.F64,
    Context,
    ~zfa: zfa_enabled,
    ~zfa_modulo: #true
  ))
  single.request <== request
  double.request <== request

  def control = request.control.execution
  def source_single = control.source_precision === RV5StageFloatPrecision.Single
  def floating_point_destination = request.control.registers.destination === RV5StageFloatDestination.FloatingPoint
  def ordinary_single = mux(floating_point_destination, control.destination_precision === RV5StageFloatPrecision.Single, source_single)
  def cross_precision = floating_point_destination & request.control.registers.uses_frs1 & (
    control.unit === RV5StageFloatUnit.Convert
  ) & (
    control.source_precision =/= control.destination_precision
  )
  def single_source = riscv_unbox(FloatFormat.F32, 64, request.left)
  def double_source = request.left.into(IEEEFloat(FloatFormat.F64))
  inst single_to_double(RecFNToRecFN(FloatFormat.F32, FloatFormat.F64))
  single_to_double.value <== single_source.to_recoded()
  single_to_double.rounding_mode <== request.rounding_mode
  single_to_double.tininess_mode <== TininessMode.AfterRounding
  inst double_to_single(RecFNToRecFN(FloatFormat.F64, FloatFormat.F32))
  double_to_single.value <== double_source.to_recoded()
  double_to_single.rounding_mode <== request.rounding_mode
  double_to_single.tininess_mode <== TininessMode.AfterRounding

  def ordinary = mux(ordinary_single, single.completion, double.completion)
  def converted_value = mux(
    source_single,
    riscv_nan_box(
      FloatFormat.F64,
      riscv_canonicalize_nan(FloatFormat.F64,
                             single_to_double.out.to_ieee()),
      64
    ),
    riscv_nan_box(
      FloatFormat.F32,
      riscv_canonicalize_nan(FloatFormat.F32,
                             double_to_single.out.to_ieee()),
      64
    )
  )
  def converted_flags = mux(
    source_single,
    riscv_exception_flags(single_to_double.exception_flags),
    riscv_exception_flags(double_to_single.exception_flags)
  )
  completion <== ordinary.updated(
    ~fp_value: mux(cross_precision, converted_value, ordinary.fp_value),
    ~exception_flags: mux(cross_precision, converted_flags, ordinary.exception_flags)
  )

circuit RV5StageFpFixedFHalf(xlen :: XLen,
                             Context :: DataType,
                             ~arithmetic: arithmetic_enabled :: Boolean,
                             ~zfa: zfa_enabled :: Boolean = #false):
  def profile = FloatingPointProfile.F
  input request: RV5StageFpExecutionRequest(xlen, profile, Context)
  output completion: RV5StageFpCompletion(xlen, profile, Context)

  def HalfModule = if arithmetic_enabled | RV5StageFpFormatDatapath(xlen, profile, FloatFormat.F16, Context, ~zfa: zfa_enabled) | RV5StageFpHalfMinimalDatapath(xlen, profile, Context)
  inst half(HalfModule)
  inst single(RV5StageFpFixedF(xlen, Context, ~zfa: zfa_enabled))
  half.request <== request
  single.request <== request

  def control = request.control.execution
  def fp_destination = request.control.registers.destination === RV5StageFloatDestination.FloatingPoint
  def ordinary_half = mux(fp_destination,
                          control.destination_precision === RV5StageFloatPrecision.Half,
                          control.source_precision === RV5StageFloatPrecision.Half)
  def cross_precision = fp_destination & request.control.registers.uses_frs1 & (control.unit === RV5StageFloatUnit.Convert) & (
    control.source_precision =/= control.destination_precision
  )
  def half_source = riscv_unbox(FloatFormat.F16, 32, request.left)
  def single_source = riscv_unbox(FloatFormat.F32, 32, request.left)
  inst half_to_single(RecFNToRecFN(FloatFormat.F16, FloatFormat.F32))
  half_to_single.value <== half_source.to_recoded()
  half_to_single.rounding_mode <== request.rounding_mode
  half_to_single.tininess_mode <== TininessMode.AfterRounding
  inst single_to_half(RecFNToRecFN(FloatFormat.F32, FloatFormat.F16))
  single_to_half.value <== single_source.to_recoded()
  single_to_half.rounding_mode <== request.rounding_mode
  single_to_half.tininess_mode <== TininessMode.AfterRounding

  def ordinary = mux(ordinary_half, half.completion, single.completion)
  def source_half = control.source_precision === RV5StageFloatPrecision.Half
  def converted_value = mux(
    source_half,
    riscv_nan_box(FloatFormat.F32, riscv_canonicalize_nan(FloatFormat.F32, half_to_single.out.to_ieee()), 32),
    riscv_nan_box(FloatFormat.F16, riscv_canonicalize_nan(FloatFormat.F16, single_to_half.out.to_ieee()), 32)
  )
  def converted_flags = mux(source_half,
                            riscv_exception_flags(half_to_single.exception_flags),
                            riscv_exception_flags(single_to_half.exception_flags))
  completion <== ordinary.updated(
    ~fp_value: mux(cross_precision, converted_value, ordinary.fp_value),
    ~exception_flags: mux(cross_precision, converted_flags, ordinary.exception_flags)
  )

circuit RV5StageFpFixedDHalf(xlen :: XLen,
                             Context :: DataType,
                             ~arithmetic: arithmetic_enabled :: Boolean,
                             ~zfa: zfa_enabled :: Boolean = #false):
  def profile = FloatingPointProfile.D
  input request: RV5StageFpExecutionRequest(xlen, profile, Context)
  output completion: RV5StageFpCompletion(xlen, profile, Context)

  def HalfModule = if arithmetic_enabled | RV5StageFpFormatDatapath(xlen, profile, FloatFormat.F16, Context, ~zfa: zfa_enabled) | RV5StageFpHalfMinimalDatapath(xlen, profile, Context)
  inst half(HalfModule)
  inst base(RV5StageFpFixedD(xlen, Context, ~zfa: zfa_enabled))
  half.request <== request
  base.request <== request

  def control = request.control.execution
  def fp_destination = request.control.registers.destination === RV5StageFloatDestination.FloatingPoint
  def ordinary_half = mux(fp_destination,
                          control.destination_precision === RV5StageFloatPrecision.Half,
                          control.source_precision === RV5StageFloatPrecision.Half)
  def half_cross = fp_destination & request.control.registers.uses_frs1 & (control.unit === RV5StageFloatUnit.Convert) & (
    (control.source_precision === RV5StageFloatPrecision.Half) ||| (
      control.destination_precision === RV5StageFloatPrecision.Half
    )
  )
  def half_source = riscv_unbox(FloatFormat.F16, 64, request.left)
  def single_source = riscv_unbox(FloatFormat.F32, 64, request.left)
  def double_source = request.left.into(IEEEFloat(FloatFormat.F64))
  inst half_to_single(RecFNToRecFN(FloatFormat.F16, FloatFormat.F32))
  inst single_to_half(RecFNToRecFN(FloatFormat.F32, FloatFormat.F16))
  inst half_to_double(RecFNToRecFN(FloatFormat.F16, FloatFormat.F64))
  inst double_to_half(RecFNToRecFN(FloatFormat.F64, FloatFormat.F16))
  half_to_single.value <== half_source.to_recoded()
  single_to_half.value <== single_source.to_recoded()
  half_to_double.value <== half_source.to_recoded()
  double_to_half.value <== double_source.to_recoded()
  half_to_single.rounding_mode <== request.rounding_mode
  single_to_half.rounding_mode <== request.rounding_mode
  half_to_double.rounding_mode <== request.rounding_mode
  double_to_half.rounding_mode <== request.rounding_mode
  half_to_single.tininess_mode <== TininessMode.AfterRounding
  single_to_half.tininess_mode <== TininessMode.AfterRounding
  half_to_double.tininess_mode <== TininessMode.AfterRounding
  double_to_half.tininess_mode <== TininessMode.AfterRounding

  def ordinary = mux(ordinary_half, half.completion, base.completion)
  def source_half = control.source_precision === RV5StageFloatPrecision.Half
  def other_single = mux(source_half,
                         control.destination_precision === RV5StageFloatPrecision.Single,
                         control.source_precision === RV5StageFloatPrecision.Single)
  def converted_value = mux(
    source_half,
    mux(other_single,
        riscv_nan_box(FloatFormat.F32, riscv_canonicalize_nan(FloatFormat.F32, half_to_single.out.to_ieee()), 64),
        riscv_nan_box(FloatFormat.F64, riscv_canonicalize_nan(FloatFormat.F64, half_to_double.out.to_ieee()), 64)),
    mux(other_single,
        riscv_nan_box(FloatFormat.F16, riscv_canonicalize_nan(FloatFormat.F16, single_to_half.out.to_ieee()), 64),
        riscv_nan_box(FloatFormat.F16, riscv_canonicalize_nan(FloatFormat.F16, double_to_half.out.to_ieee()), 64))
  )
  def converted_flags = mux(
    source_half,
    mux(other_single,
        riscv_exception_flags(half_to_single.exception_flags),
        riscv_exception_flags(half_to_double.exception_flags)),
    mux(other_single,
        riscv_exception_flags(single_to_half.exception_flags),
        riscv_exception_flags(double_to_half.exception_flags))
  )
  completion <== ordinary.updated(
    ~fp_value: mux(half_cross, converted_value, ordinary.fp_value),
    ~exception_flags: mux(half_cross, converted_flags, ordinary.exception_flags)
  )

export:
  RV5StageDisabledZfaFormatDatapath
  RV5StageDisabledZfaModulo
  RV5StageZfaModulo
  RV5StageZfaFormatDatapath
  RV5StageFpFormatDatapath
  RV5StageFpHalfMinimalDatapath
  RV5StageFpFixedF
  RV5StageFpFixedD
  RV5StageFpFixedFHalf
  RV5StageFpFixedDHalf
