#lang rhodium
// Implements scalar FP architectural state and its standalone execution-service composition.
// SPDX-License-Identifier: Apache-2.0

import:
  "bundles.rhdl" open
  "execute.rhdl" open
  "register-file.rhdl" open
  "../decode/fp-ctrl.rhdl" open
  "../../../riscv/isa/fp-profile.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/rtl/floating-point.rhdl" open
  lib("hardfloat/main.rhdl") open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open
  lib("rhodium/std/scoreboard.rhdl") open

fun fp_load_value(profile :: FloatingPointProfile,
                  precision :: RV5StageFloatPrecision,
                  data :: Bits(64)) :~ Bits(floating_point_register_width(profile)):
  def half = riscv_nan_box(
    FloatFormat.F16,
    data[0..16].into(IEEEFloat(FloatFormat.F16)),
    floating_point_register_width(profile)
  )
  def single = riscv_nan_box(
    FloatFormat.F32,
    data[0..32].into(IEEEFloat(FloatFormat.F32)),
    floating_point_register_width(profile)
  )
  if profile == FloatingPointProfile.F
  | mux(precision === RV5StageFloatPrecision.Half, half, single)
  | mux_lookup(
      precision,
      ~default: data,
      [[RV5StageFloatPrecision.Half, half],
       [RV5StageFloatPrecision.Single, single]]
    )

fun fp_store_value(profile :: FloatingPointProfile,
                   precision :: RV5StageFloatPrecision,
                   data :: Bits(floating_point_register_width(profile))) :~ Bits(64):
  if profile == FloatingPointProfile.F
  | mux(precision === RV5StageFloatPrecision.Half,
        data[0..16].zext(64),
        data.zext(64))
  | mux_lookup(
      precision,
      ~default: data,
      [[RV5StageFloatPrecision.Half, data[0..16].zext(64)],
       [RV5StageFloatPrecision.Single, data[0..32].zext(64)]]
    )

sync_circuit RV5StageDisabledFpPipeline(xlen :: XLen,
                                        profile :: FloatingPointProfile,
                                        Context :: DataType):
  def register_count = 32
  def Issue = RV5StageFpIssue(xlen, profile, Context)
  def Completion = RV5StageFpCompletion(xlen, profile, Context)
  interface issue(Decoupled(Issue), ~role: consumer)
  interface completion(Decoupled(Completion), ~role: producer)
  interface load_reserve(Decoupled(RV5StageFpLoadReservation(Context)), ~role: consumer)
  interface load_completion(Valid(RV5StageFpLoadCompletion(Context)), ~role: consumer)
  interface load_hit(Valid(RV5StageFpLoadCompletion(Context)), ~role: consumer)
  interface store_request(Valid(RV5StageFpStoreRequest(Context)), ~role: consumer)
  interface store_response(Valid(RV5StageFpStoreResponse(Context)), ~role: producer)
  interface state_update(Valid(Bits(5)), ~role: producer)
  interface vector_reserve(Decoupled(Bits(5)), ~role: consumer)
  interface vector_write(Valid(FloatingPointRegisterWrite(profile)), ~role: consumer)
  input snapshot_read_address: Bits(5)
  output snapshot_read_data: Bits(64)
  output busy: Mask(register_count)
  output drained: Bool

  issue.ready <== Bool(#false)
  completion.valid <== Bool(#false)
  completion.bits <== dont_care(Completion)
  load_reserve.ready <== Bool(#false)
  store_response.valid <== Bool(#false)
  store_response.bits <== dont_care(RV5StageFpStoreResponse(Context))
  state_update.valid <== Bool(#false)
  state_update.bits <== bits(0, 5)
  vector_reserve.ready <== Bool(#false)
  snapshot_read_data <== bits(0, 64)
  busy <== Mask(register_count)(0)
  drained <== Bool(#true)

sync_circuit RV5StageFpScalar(
  xlen :: XLen,
  profile :: FloatingPointProfile,
  Context :: DataType,
  ~half_precision: half_precision :: HalfPrecisionProfile = DefaultHalfPrecisionProfile,
  ~zfa: zfa_enabled :: Boolean = #false
):
  check_rv5stage_floating_point_profile(xlen, profile, half_precision, ~zfa: zfa_enabled)
  unless floating_point_supports_f(profile)
  | error(~who: #'RV5StageFpScalar, "the scalar FP adapter requires RV32F or RV64D")
  def register_count = 32
  def flen = floating_point_register_width(profile)
  def Issue = RV5StageFpIssue(xlen, profile, Context)
  def Completion = RV5StageFpCompletion(xlen, profile, Context)

  interface issue(Decoupled(Issue), ~role: consumer)
  interface completion(Decoupled(Completion), ~role: producer)
  interface load_reserve(Decoupled(RV5StageFpLoadReservation(Context)), ~role: consumer)
  interface load_completion(Valid(RV5StageFpLoadCompletion(Context)), ~role: consumer)
  interface load_hit(Valid(RV5StageFpLoadCompletion(Context)), ~role: consumer)
  interface store_request(Valid(RV5StageFpStoreRequest(Context)), ~role: consumer)
  interface store_response(Valid(RV5StageFpStoreResponse(Context)), ~role: producer)
  interface state_update(Valid(Bits(5)), ~role: producer)
  interface vector_reserve(Decoupled(Bits(5)), ~role: consumer)
  interface vector_write(Valid(FloatingPointRegisterWrite(profile)), ~role: consumer)
  input snapshot_read_address: Bits(5)
  output snapshot_read_data: Bits(64)
  output busy: Mask(register_count)
  output drained: Bool

  inst registers(RV5StageFloatingPointRegisterFile(profile))
  def Array(load_write :: Endpoint, execution_write :: Endpoint) = registers.writes
  reg busy_state(~init: Mask(register_count)(0))
  reg outstanding(~init: bits(0, 4))
  reg vector_pending(~init: Bool(#false))
  fun register_bit(index :: Bits(5)) :~ Mask(register_count):
    one_hot(index).into(Mask(register_count))

  interface execution_request(Decoupled(RV5StageFpExecutionRequest(xlen, profile, RV5StageFpScalarTag(Context))), ~role: producer)
  interface execution_result(Decoupled(RV5StageFpExecutionResult(xlen, profile, RV5StageFpScalarTag(Context))), ~role: consumer)
  (
    execution_result |> map_flow(~stable: #true, completed):
      RV5StageFpCompletion(xlen, profile, Context):
        context: completed.tag.context
        destination: completed.tag.destination
        rd: completed.tag.rd
        integer_value: completed.integer_value
        fp_value: completed.fp_value
        exception_flags: completed.exception_flags
        exception_flags_valid: completed.exception_flags_valid
  ) |> completion

  def execution_completion = completion.bits
  def execution_write_valid = completion.fire() & (
    execution_completion.destination === RV5StageFloatDestination.FloatingPoint
  )
  def scalar_execution_write = FloatingPointRegisterWrite(profile):
    address: execution_completion.rd
    data: execution_completion.fp_value
  assert(!(execution_write_valid & vector_write.valid), "rv5stage_fp_execution_and_vector_writes_exclusive")
  execution_write.valid <== execution_write_valid ||| vector_write.valid
  execution_write.bits <== mux(vector_write.valid, vector_write.bits, scalar_execution_write)

  // A scalar WB hit has no deferred reservation. The memory pipeline admits
  // this path only after older transactions drain, so it cannot collide with
  // their non-backpressurable load completion on the shared FPR write port.
  assert(!(load_hit.valid & load_completion.valid), "rv5stage_fp_load_paths_exclusive")
  when (load_hit.valid):
    assert(!scoreboard_busy(register_count, busy_state, load_hit.bits.rd), "rv5stage_fp_load_hit_destination_free")
  def completed_loads = Array(load_completion, load_hit) |> valid_arbiter()
  assert(!(completed_loads.valid & vector_write.valid), "rv5stage_fp_load_and_vector_writes_exclusive")
  (
    completed_loads |> map_valid(completed_load):
      FloatingPointRegisterWrite(profile):
        address: completed_load.rd
        data: fp_load_value(profile, completed_load.precision, completed_load.data)
  ) |> load_write
  when (completed_loads.valid):
    assert((completed_loads.bits.precision =/= RV5StageFloatPrecision.Double) ||| Bool(profile == FloatingPointProfile.D), "rv5stage_fp_load_precision_supported")
    assert((completed_loads.bits.precision =/= RV5StageFloatPrecision.Half) ||| Bool(half_precision_supports_zfhmin(half_precision)), "rv5stage_fp_half_load_supported")

  def execution_clear = execution_write_valid
  def load_clear = load_completion.valid
  def vector_clear = vector_write.valid
  def execution_clear_bit = register_bit(execution_completion.rd)
  def load_clear_bit = register_bit(load_completion.bits.rd)
  def vector_clear_bit = register_bit(vector_write.bits.address)
  def completion_clear_mask = mux(execution_clear,
                                  execution_clear_bit,
                                  Mask(register_count)(0)) ||| mux(
    load_clear,
    load_clear_bit,
    Mask(register_count)(0)
  )
  def clear_mask = completion_clear_mask ||| mux(
    vector_clear,
    vector_clear_bit,
    Mask(register_count)(0)
  )
  // Scalar completions may feed a same-cycle replacement. Vector retirement
  // must not feed issue readiness back into its own WB disposition.
  def currently_busy = busy_state & !completion_clear_mask

  fun register_busy(index :: Bits(5)) :~ Bool:
    scoreboard_busy(register_count, currently_busy, index)
  def control = issue.bits.control
  def source_hazard = (
    control.registers.uses_frs1 & register_busy(issue.bits.frs1)
  ) ||| (
    control.registers.uses_frs2 & register_busy(issue.bits.frs2)
  ) ||| (
    control.registers.uses_frs3 & register_busy(issue.bits.frs3)
  )
  def fp_destination = control.registers.destination === RV5StageFloatDestination.FloatingPoint
  def destination_hazard = fp_destination & register_busy(issue.bits.frd)
  def issue_hazard = source_hazard ||| destination_hazard
  def memory_request = control.execution.unit === RV5StageFloatUnit.Memory
  (
    issue |> gate_flow(!issue_hazard & !memory_request & !vector_pending) |> map_flow(issued):
      RV5StageFpExecutionRequest(xlen, profile, RV5StageFpScalarTag(Context)):
        tag:
          RV5StageFpScalarTag(Context):
            context: issued.context
            destination: issued.control.registers.destination
            rd: issued.frd
        control: issued.control
        left: registers.read_data_1
        left_precision: issued.control.execution.source_precision
        right: registers.read_data_2
        right_precision: issued.control.execution.source_precision
        third: registers.read_data_3
        third_precision: issued.control.execution.source_precision
        integer_operand: issued.integer_operand
        immediate_index: issued.frs1
        rounding_mode: issued.rounding_mode
  ) |> execution_request
  def issue_fire = issue.fire()

  // The third read port is shared by accepted execution and store-read events.
  // Store reads are speculative operand preparation; execution issue and load
  // reservations are authorized by scalar WB before they can modify FP state.
  def store_source_free = !register_busy(store_request.bits.rs)
  def store_request_safe = !issue.valid & !vector_pending & store_source_free
  inst stores(ValidPipe(RV5StageFpStoreResponse(Context), 1))
  stores.egress |> store_response
  (
    store_request |> filter_valid(_request => store_request_safe) |> map_valid(request):
      RV5StageFpStoreResponse(Context):
        context: request.context
        data: fp_store_value(profile, request.precision, registers.read_data_3)
  ) |> stores.ingress
  registers.read_address_1 <== mux(issue.valid, issue.bits.frs1, snapshot_read_address)
  registers.read_address_2 <== issue.bits.frs2
  registers.read_address_3 <== mux(
    issue.valid,
    issue.bits.frs3,
    store_request.bits.rs
  )
  snapshot_read_data <== if flen == 64 | registers.read_data_1 | registers.read_data_1.zext(64)
  when (store_request.valid & store_request_safe):
    assert((store_request.bits.precision =/= RV5StageFloatPrecision.Double) ||| Bool(profile == FloatingPointProfile.D), "rv5stage_fp_store_precision_supported")
    assert((store_request.bits.precision =/= RV5StageFloatPrecision.Half) ||| Bool(half_precision_supports_zfhmin(half_precision)), "rv5stage_fp_half_store_supported")

  load_reserve.ready <== !vector_pending & !register_busy(load_reserve.bits.rd)
  def load_reserve_fire = load_reserve.fire()
  vector_reserve.ready <== !vector_pending & !outstanding.or_reduce() & !busy_state.or_reduce()
  def vector_reserve_fire = vector_reserve.fire()
  def execution_set = issue_fire & fp_destination
  def execution_set_bit = register_bit(issue.bits.frd)
  def load_set_bit = register_bit(load_reserve.bits.rd)
  def vector_set_bit = register_bit(vector_reserve.bits)
  def set_mask = mux(execution_set,
                     execution_set_bit,
                     Mask(register_count)(0)) ||| mux(
    load_reserve_fire,
    load_set_bit,
    Mask(register_count)(0)
  ) ||| mux(
    vector_reserve_fire,
    vector_set_bit,
    Mask(register_count)(0)
  )
  when execution_set:
    assert(!scoreboard_busy(register_count, currently_busy, issue.bits.frd),
           "rv5stage_fp_execution_destination_free")
  when load_reserve_fire:
    assert(!scoreboard_busy(register_count, currently_busy, load_reserve.bits.rd),
           "rv5stage_fp_load_destination_free")
  when vector_reserve_fire:
    assert(!scoreboard_busy(register_count, currently_busy, vector_reserve.bits),
           "rv5stage_fp_vector_destination_free")
  when (execution_set & load_reserve_fire):
    assert(issue.bits.frd =/= load_reserve.bits.rd,
           "rv5stage_fp_reservations_distinct")
  when execution_clear:
    assert(scoreboard_busy(register_count, busy_state, execution_completion.rd),
           "rv5stage_fp_execution_destination_reserved")
  when load_clear:
    assert(scoreboard_busy(register_count, busy_state, load_completion.bits.rd) ||| (
      load_reserve_fire & (load_reserve.bits.rd === load_completion.bits.rd)
    ), "rv5stage_fp_load_destination_reserved")
  when vector_clear:
    assert(vector_pending & scoreboard_busy(register_count, busy_state, vector_write.bits.address),
           "rv5stage_fp_vector_destination_reserved")
  when (execution_clear & load_clear):
    assert(execution_completion.rd =/= load_completion.bits.rd,
           "rv5stage_fp_completions_distinct")
  when vector_reserve_fire:
    vector_pending <== Bool(#true)
  elsewhen vector_clear:
    vector_pending <== Bool(#false)

  // A same-cycle completion may feed and release a replacement for the same
  // register. Apply clears to the old state before reserving the new writer.
  def next_busy = (busy_state & !clear_mask) ||| set_mask
  when (set_mask.or_reduce() ||| clear_mask.or_reduce()):
    busy_state <== next_busy
  busy <== busy_state

  def completion_fire = completion.fire()
  def execution_flags_update = completion_fire & execution_completion.exception_flags_valid
  state_update.valid <== vector_write.valid ||| completed_loads.valid ||| execution_flags_update ||| (
    completion_fire & (execution_completion.destination === RV5StageFloatDestination.FloatingPoint)
  )
  state_update.bits <== mux(
    execution_flags_update,
    execution_completion.exception_flags,
    bits(0, 5)
  )
  def next_outstanding = mux(
    issue_fire,
    outstanding + bits(1, 4),
    outstanding - bits(1, 4)
  )
  when (issue_fire ^ completion_fire):
    outstanding <== next_outstanding
  when completion_fire:
    assert(outstanding.or_reduce() ||| issue_fire,
           "rv5stage_fp_completion_has_issue")
  assert(outstanding <= bits(8, 4), "rv5stage_fp_outstanding_in_range")
  // Speculative store-operand probes are not authorized work and must not
  // prevent a trap or interrupt from draining accepted FP operations.
  drained <== !outstanding.or_reduce() & !busy_state.or_reduce()

sync_circuit RV5StageFpPipeline(xlen :: XLen, profile :: FloatingPointProfile, Context :: DataType, ~half_precision: half_precision :: HalfPrecisionProfile = DefaultHalfPrecisionProfile, ~zfa: zfa_enabled :: Boolean = #false):
  def register_count = 32
  def Issue = RV5StageFpIssue(xlen, profile, Context)
  def Completion = RV5StageFpCompletion(xlen, profile, Context)
  interface issue(Decoupled(Issue), ~role: consumer)
  interface completion(Decoupled(Completion), ~role: producer)
  interface load_reserve(Decoupled(RV5StageFpLoadReservation(Context)), ~role: consumer)
  interface load_completion(Valid(RV5StageFpLoadCompletion(Context)), ~role: consumer)
  interface load_hit(Valid(RV5StageFpLoadCompletion(Context)), ~role: consumer)
  interface store_request(Valid(RV5StageFpStoreRequest(Context)), ~role: consumer)
  interface store_response(Valid(RV5StageFpStoreResponse(Context)), ~role: producer)
  interface state_update(Valid(Bits(5)), ~role: producer)
  interface vector_reserve(Decoupled(Bits(5)), ~role: consumer)
  interface vector_write(Valid(FloatingPointRegisterWrite(profile)), ~role: consumer)
  input snapshot_read_address: Bits(5)
  output snapshot_read_data: Bits(64)
  output busy: Mask(register_count)
  output drained: Bool

  inst scalar(RV5StageFpScalar(xlen, profile, Context, ~half_precision: half_precision, ~zfa: zfa_enabled))
  inst execution(RV5StageFpExecutionService(xlen, profile, RV5StageFpScalarTag(Context), ~half_precision: half_precision, ~zfa: zfa_enabled))
  scalar.execution_request |> execution.request
  execution.result |> scalar.execution_result
  issue |> scalar.issue
  scalar.completion |> completion
  load_reserve |> scalar.load_reserve
  load_completion |> scalar.load_completion
  load_hit |> scalar.load_hit
  store_request |> scalar.store_request
  scalar.store_response |> store_response
  scalar.state_update |> state_update
  vector_reserve |> scalar.vector_reserve
  vector_write |> scalar.vector_write
  scalar.snapshot_read_address <== snapshot_read_address
  snapshot_read_data <== scalar.snapshot_read_data
  busy <== scalar.busy
  drained <== scalar.drained

export:
  RV5StageFpScalar
  RV5StageDisabledFpPipeline
  RV5StageFpPipeline
