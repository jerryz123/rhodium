#lang rhodium
/* Arbitrates RV5Stage scalar/vector FP execution and reserves fixed return cycles at ID. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/fp/launch-calendar.rhdl") open
  "../../fp/bundles.rhdl" open
  "../../fp/execute.rhdl" open
  "../../fp/timing.rhdl" open
  "../../fp/types.rhdl" open
  lib("riscv/isa/xlen.rhm") open
  lib("riscv/isa/fp-profile.rhm") open
  lib("flow/main.rhdl") open

/* Books scalar EX launches in ID while fairly sharing unreserved cycles with vector work. */
sync_circuit RV5StageFpService(xlen :: XLen, profile :: FloatingPointProfile, ScalarTag :: DataType, VectorTag :: DataType, ~half_precision: half_precision :: HalfPrecisionProfile, ~zfa: zfa_enabled :: Boolean, ~timing: fp_timing :: FpExecutionTiming):
  interface scalar_request(Decoupled(FpExecutionRequest(xlen, profile, ScalarTag)), ~role: consumer)
  interface scalar_result(Decoupled(FpExecutionResult(xlen, profile, ScalarTag)), ~role: producer)
  interface vector_request(Decoupled(FpExecutionRequest(xlen, profile, VectorTag)), ~role: consumer)
  interface vector_result(Decoupled(FpExecutionResult(xlen, profile, VectorTag)), ~role: producer)
  input id_execution: FloatExecutionControl()
  input(id_admitted, gpr_available): Bool
  output(id_available, ex_granted): Bool
  def calendar_span = math.max(8, fp_timing.maximum + 1)
  /* Keeps scalar destination context and vector completion-slot identity distinct in the
     shared FP service. */
  tagged_union FpOwner():
    Scalar(ScalarTag)
    Vector(VectorTag)
  inst wb_fp_execution(FpExecutionService(xlen, profile, FpOwner(), ~half_precision: half_precision, ~zfa: zfa_enabled, ~scheduled_writeback: #true, ~timing: fp_timing))
  inst launch_calendar(FpLaunchCalendar(fp_timing, calendar_span))
  launch_calendar.probe <== id_execution
  launch_calendar.book.valid <== id_admitted
  launch_calendar.book.bits <== id_execution
  launch_calendar.fixed_available <== wb_fp_execution.fixed_admission_available & gpr_available
  ex_granted <== launch_calendar.reserved
  def tagged_scalar_request = scalar_request |> map_flow(request => fp_request_with_tag(xlen, profile, ScalarTag, FpOwner(), request, FpOwner().Scalar(request.tag)))
  def tagged_vector_request = vector_request |> map_flow(request => fp_request_with_tag(xlen, profile, VectorTag, FpOwner(), request, FpOwner().Vector(request.tag)))
  def vector_waiting = tagged_vector_request.valid & !tagged_vector_request.ready
  launch_calendar.vector_waiting <== vector_waiting
  id_available <== launch_calendar.available
  inst ex_fp_selection(GrantMerge(FpExecutionRequest(xlen, profile, FpOwner()), 2))
  // The registered EX grant cannot be displaced by WB or vector traffic.
  // Otherwise give an already-authorized vector offer the next turn.
  ex_fp_selection.grants <== vec([launch_calendar.reserved ||| !tagged_vector_request.valid, !launch_calendar.reserved & tagged_vector_request.valid]).into(MaybeOneHot(2))
  Array(tagged_scalar_request, tagged_vector_request) <=> ex_fp_selection.ingress
  launch_calendar.vector_accepted <== tagged_vector_request.fire()
  def Array(fp_launch, fp_reservation) = ex_fp_selection.egress |> atomic_fork(2)
  fp_launch |> wb_fp_execution.request
  fp_reservation |> filter_flow(operation => operation.tag.is(FpOwner().Vector).into(Bool) & (operation.control.execution.unit =/= FloatUnit.DivideSquareRoot)) |> map_flow(operation => operation.control.execution) |> launch_calendar.vector_book
  (
    wb_fp_execution.result |> demux_flow(2, ~stable: #true, result => result.tag.is(FpOwner().Vector).into(Bool))
      |> parallel(
           map_flow(~stable: #true, result => fp_result_with_tag(xlen, profile, FpOwner(), ScalarTag, result, result.tag.view(FpOwner().Scalar).payload)),
           map_flow(~stable: #true, result => fp_result_with_tag(xlen, profile, FpOwner(), VectorTag, result, result.tag.view(FpOwner().Vector).payload))
         )
  ) <=> Array(scalar_result, vector_result)

/* Keeps both execution clients inactive without allocating arithmetic or reservation state. */
sync_circuit DisabledRV5StageFpService(xlen :: XLen, profile :: FloatingPointProfile, ScalarTag :: DataType, VectorTag :: DataType):
  interface scalar_request(Decoupled(FpExecutionRequest(xlen, profile, ScalarTag)), ~role: consumer)
  interface scalar_result(Decoupled(FpExecutionResult(xlen, profile, ScalarTag)), ~role: producer)
  interface vector_request(Decoupled(FpExecutionRequest(xlen, profile, VectorTag)), ~role: consumer)
  interface vector_result(Decoupled(FpExecutionResult(xlen, profile, VectorTag)), ~role: producer)
  input id_execution: FloatExecutionControl()
  input(id_admitted, gpr_available): Bool
  output(id_available, ex_granted): Bool
  scalar_request.ready <== Bool(#false)
  scalar_result.valid <== Bool(#false)
  scalar_result.bits <== dont_care(FpExecutionResult(xlen, profile, ScalarTag))
  vector_request.ready <== Bool(#false)
  vector_result.valid <== Bool(#false)
  vector_result.bits <== dont_care(FpExecutionResult(xlen, profile, VectorTag))
  id_available <== Bool(#false)
  ex_granted <== Bool(#false)

export:
  RV5StageFpService
  DisabledRV5StageFpService
