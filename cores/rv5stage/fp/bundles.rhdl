#lang rhodium
// Defines scalar FP/LSU payloads and opaque-tag operand execution transactions.
// SPDX-License-Identifier: Apache-2.0

import:
  "../decode/fp-ctrl.rhdl" open
  "../../../riscv/isa/fp-profile.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  lib("hardfloat/main.rhdl").RoundingMode

bundle RV5StageFpIssue(xlen :: XLen, profile :: FloatingPointProfile, Context :: DataType):
  context: Context
  control: RV5StageFloatingPointControl()
  frs1: Bits(5)
  frs2: Bits(5)
  frs3: Bits(5)
  frd: Bits(5)
  integer_operand: Bits(xlen.width)
  rounding_mode: RoundingMode

// Execution tags belong to the caller; lanes never interpret them as registers.
bundle RV5StageFpExecutionRequest(xlen :: XLen, profile :: FloatingPointProfile, Tag :: DataType):
  tag: Tag
  control: RV5StageFloatingPointControl()
  left: Bits(floating_point_register_width(profile))
  right: Bits(floating_point_register_width(profile))
  third: Bits(floating_point_register_width(profile))
  integer_operand: Bits(xlen.width)
  immediate_index: Bits(5)
  rounding_mode: RoundingMode

bundle RV5StageFpExecutionResult(xlen :: XLen, profile :: FloatingPointProfile, Tag :: DataType):
  tag: Tag
  integer_value: Bits(xlen.width)
  fp_value: Bits(floating_point_register_width(profile))
  exception_flags: Bits(5)
  exception_flags_valid: Bool

bundle RV5StageFpScalarTag(Context :: DataType):
  context: Context
  destination: RV5StageFloatDestination
  rd: Bits(5)

bundle RV5StageFpCompletion(xlen :: XLen, profile :: FloatingPointProfile, Context :: DataType):
  context: Context
  destination: RV5StageFloatDestination
  rd: Bits(5)
  integer_value: Bits(xlen.width)
  fp_value: Bits(floating_point_register_width(profile))
  exception_flags: Bits(5)
  exception_flags_valid: Bool

bundle RV5StageFpLoadReservation(Context :: DataType):
  context: Context
  precision: RV5StageFloatPrecision
  rd: Bits(5)

bundle RV5StageFpLoadCompletion(Context :: DataType):
  context: Context
  precision: RV5StageFloatPrecision
  rd: Bits(5)
  data: Bits(64)

bundle RV5StageFpStoreRequest(Context :: DataType):
  context: Context
  precision: RV5StageFloatPrecision
  rs: Bits(5)

bundle RV5StageFpStoreResponse(Context :: DataType):
  context: Context
  data: Bits(64)

// Retagging changes only caller ownership, never the numeric execution payload.
fun fp_request_with_tag(xlen :: XLen, profile :: FloatingPointProfile, From :: DataType, To :: DataType, request :: RV5StageFpExecutionRequest(xlen, profile, From), tag :: Hardware.of(To)) :~ RV5StageFpExecutionRequest(xlen, profile, To):
  RV5StageFpExecutionRequest(xlen, profile, To):
    tag: tag
    control: request.control
    left: request.left
    right: request.right
    third: request.third
    integer_operand: request.integer_operand
    immediate_index: request.immediate_index
    rounding_mode: request.rounding_mode

fun fp_result_with_tag(xlen :: XLen, profile :: FloatingPointProfile, From :: DataType, To :: DataType, result :: RV5StageFpExecutionResult(xlen, profile, From), tag :: Hardware.of(To)) :~ RV5StageFpExecutionResult(xlen, profile, To):
  RV5StageFpExecutionResult(xlen, profile, To):
    tag: tag
    integer_value: result.integer_value
    fp_value: result.fp_value
    exception_flags: result.exception_flags
    exception_flags_valid: result.exception_flags_valid

export:
  fp_request_with_tag
  fp_result_with_tag
  RV5StageFpIssue
  RV5StageFpExecutionRequest
  RV5StageFpExecutionResult
  RV5StageFpCompletion
  RV5StageFpScalarTag
  RV5StageFpLoadReservation
  RV5StageFpLoadCompletion
  RV5StageFpStoreRequest
  RV5StageFpStoreResponse
