#lang rhodium
/* Defines RV5Stage-owned scalar FP issue, completion, and LSU payloads. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../../fp/types.rhdl" open
  "../../../riscv/isa/fp-profile.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  lib("hardfloat/main.rhdl").RoundingMode

/* Carries scalar register indices and captured instruction context for launch or WB admission. */
bundle RV5StageFpIssue(xlen :: XLen, profile :: FloatingPointProfile, Context :: DataType):
  context: Context
  control: FloatingPointControl()
  frs1: Bits(5)
  frs2: Bits(5)
  frs3: Bits(5)
  frd: Bits(5)
  integer_operand: Bits(xlen.width)
  rounding_mode: RoundingMode

/* Retains scalar instruction context and destination through operand-level execution. */
bundle RV5StageFpScalarTag(Context :: DataType):
  context: Context
  destination: FloatDestination
  rd: Bits(5)
  speculative: Bool

/* Returns scalar destination metadata alongside values and optional accrued exception flags. */
bundle RV5StageFpCompletion(xlen :: XLen, profile :: FloatingPointProfile, Context :: DataType):
  context: Context
  destination: FloatDestination
  rd: Bits(5)
  integer_value: Bits(xlen.width)
  fp_value: Bits(floating_point_register_width(profile))
  exception_flags: Bits(5)
  exception_flags_valid: Bool

/* Reserves an FPR destination before an authorized deferred load. */
bundle RV5StageFpLoadReservation(Context :: DataType):
  context: Context
  precision: FloatPrecision
  rd: Bits(5)

/* Identifies a load destination and precision for NaN-boxing its returned memory bits. */
bundle RV5StageFpLoadCompletion(Context :: DataType):
  context: Context
  precision: FloatPrecision
  rd: Bits(5)
  data: Bits(64)

/* Requests a speculative FPR source snapshot for store preparation. */
bundle RV5StageFpStoreRequest(Context :: DataType):
  context: Context
  precision: FloatPrecision
  rs: Bits(5)

/* Returns the store operand bits with the requesting instruction's context. */
bundle RV5StageFpStoreResponse(Context :: DataType):
  context: Context
  data: Bits(64)

export:
  RV5StageFpIssue
  RV5StageFpCompletion
  RV5StageFpScalarTag
  RV5StageFpLoadReservation
  RV5StageFpLoadCompletion
  RV5StageFpStoreRequest
  RV5StageFpStoreResponse
