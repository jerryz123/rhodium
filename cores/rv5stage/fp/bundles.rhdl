#lang rhodium
// Defines RV5Stage's standalone floating-point pipeline and LSU bridge payloads.
// SPDX-License-Identifier: Apache-2.0

import:
  "../decode/fp-ctrl.rhdl" open
  "../../../riscv/isa/fp-profile.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  lib("hardfloat/main.rhdl").RoundingMode

bundle RV5StageFpIssue(xlen :: XLen, profile :: FloatingPointProfile, Context :: DataType):
  context: Context
  control: RV5StageFloatingPointControl()
  frs1: Bits(5)
  frs2: Bits(5)
  frs3: Bits(5)
  frd: Bits(5)
  integer_operand: Bits(xlen.width)
  rounding_mode: RoundingMode

bundle RV5StageFpExecutionRequest(xlen :: XLen, profile :: FloatingPointProfile, Context :: DataType):
  context: Context
  control: RV5StageFloatingPointControl()
  left: Bits(floating_point_register_width(profile))
  right: Bits(floating_point_register_width(profile))
  third: Bits(floating_point_register_width(profile))
  integer_operand: Bits(xlen.width)
  immediate_index: Bits(5)
  rounding_mode: RoundingMode
  rd: Bits(5)

bundle RV5StageFpCompletion(xlen :: XLen, profile :: FloatingPointProfile, Context :: DataType):
  context: Context
  destination: RV5StageFloatDestination
  rd: Bits(5)
  integer_value: Bits(xlen.width)
  fp_value: Bits(floating_point_register_width(profile))
  exception_flags: Bits(5)
  exception_flags_valid: Bool

bundle RV5StageFpLoadReservation(Context :: DataType):
  context: Context
  precision: RV5StageFloatPrecision
  rd: Bits(5)

bundle RV5StageFpLoadCompletion(Context :: DataType):
  context: Context
  precision: RV5StageFloatPrecision
  rd: Bits(5)
  data: Bits(64)

bundle RV5StageFpStoreRequest(Context :: DataType):
  context: Context
  precision: RV5StageFloatPrecision
  rs: Bits(5)

bundle RV5StageFpStoreResponse(Context :: DataType):
  context: Context
  data: Bits(64)

export:
  RV5StageFpIssue
  RV5StageFpExecutionRequest
  RV5StageFpCompletion
  RV5StageFpLoadReservation
  RV5StageFpLoadCompletion
  RV5StageFpStoreRequest
  RV5StageFpStoreResponse
