#lang rhodium
// Holds variable-latency FP completion in the arithmetic lane until writeback accepts it.
// SPDX-License-Identifier: Apache-2.0

import:
  "bundles.rhdl" open
  "../decode/fp-ctrl.rhdl" open
  "../../../riscv/isa/fp-profile.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/rtl/floating-point.rhdl" open
  lib("hardfloat/main.rhdl") open
  lib("rhodium/std/ready-valid.rhdl") open
  lib("flow/rr-arbiter.rhdl").RRArbiter
  lib("flow/demux.rhdl").demux_flow
  lib("flow/gate.rhdl").gate_flow

sync_circuit RV5StageFpDivSqrtLane(xlen :: XLen, profile :: FloatingPointProfile, format :: FloatFormat, Tag :: DataType):
  def flen = floating_point_register_width(profile)
  unless flen >= format.ieee_width
  | error(~who: #'RV5StageFpDivSqrtLane,
          "floating-point register width must cover the selected format")

  interface request(Decoupled(RV5StageFpExecutionRequest(
    xlen,
    profile,
    Tag
  )), ~role: consumer)
  interface completion(Irrevocable(RV5StageFpExecutionResult(
    xlen,
    profile,
    Tag
  )), ~role: producer)

  def Request = RV5StageFpExecutionRequest(xlen, profile, Tag)
  def Completion = RV5StageFpExecutionResult(xlen, profile, Tag)
  inst operation(DivSqrtRecFN(format))
  reg busy(~init: Bool(#false))
  reg done(~init: Bool(#false))
  request.ready <== !busy & operation.input_ready
  operation.input_valid <== request.fire()
  operation.square_root <== request.bits.control.execution.divide_operation === RV5StageFloatDivideOperation.SquareRoot
  operation.a <== riscv_unbox(format, flen, request.bits.left).to_recoded()
  operation.b <== riscv_unbox(format, flen, request.bits.right).to_recoded()
  operation.rounding_mode <== request.bits.rounding_mode
  operation.tininess_mode <== TininessMode.AfterRounding
  assert(!request.fire() ||| operation.input_ready,
         "rv5stage_fp_div_sqrt_issue_available")

  reg tag(Tag)

  def result_valid = operation.division_valid ||| operation.square_root_valid
  def result = riscv_canonicalize_nan(format, operation.out.to_ieee())
  // HardFloat's terminal arithmetic registers remain unchanged until the next
  // input. Retain only completion validity and ownership, never copy its data.
  completion.valid <== busy & (done ||| result_valid)
  completion.bits <== RV5StageFpExecutionResult(xlen, profile, Tag):
    tag: tag
    integer_value: bits(0, xlen.width)
    fp_value: riscv_nan_box(format, result, flen)
    exception_flags: riscv_exception_flags(operation.exception_flags)
    exception_flags_valid: Bool(#true)

  when (request.fire()):
    tag <== request.bits.tag
    busy <== Bool(#true)
    done <== Bool(#false)
  elsewhen (completion.fire()):
    busy <== Bool(#false)
    done <== Bool(#false)
  elsewhen (operation.division_valid ||| operation.square_root_valid):
    done <== Bool(#true)
  describe_interface_retained_storage(request.fire(), completion.fire(), busy, ~name: "arithmetic")
  describe_interface_contract(request, completion, "arithmetic", ~trace_model: interface_trace_retained(~name: "arithmetic"))

sync_circuit RV5StageFpDivSqrtF(xlen :: XLen, Tag :: DataType):
  interface request(Decoupled(RV5StageFpExecutionRequest(
    xlen,
    FloatingPointProfile.F,
    Tag
  )), ~role: consumer)
  interface completion(Irrevocable(RV5StageFpExecutionResult(
    xlen,
    FloatingPointProfile.F,
    Tag
  )), ~role: producer)

  inst lane(RV5StageFpDivSqrtLane(
    xlen,
    FloatingPointProfile.F,
    FloatFormat.F32,
    Tag
  ))
  request |> lane.request
  lane.completion |> completion

sync_circuit RV5StageFpDivSqrtD(xlen :: XLen, Tag :: DataType):
  def Request = RV5StageFpExecutionRequest(xlen, FloatingPointProfile.D, Tag)
  def Completion = RV5StageFpExecutionResult(xlen, FloatingPointProfile.D, Tag)
  interface request(Decoupled(Request), ~role: consumer)
  interface completion(Irrevocable(Completion), ~role: producer)

  inst single(RV5StageFpDivSqrtLane(
    xlen,
    FloatingPointProfile.D,
    FloatFormat.F32,
    Tag
  ))
  inst double(RV5StageFpDivSqrtLane(
    xlen,
    FloatingPointProfile.D,
    FloatFormat.F64,
    Tag
  ))
  reg active(~init: Bool(#false))
  def Array(double_request, single_request) = request |> gate_flow(!active) |> demux_flow(
    2,
    issued => issued.control.execution.source_precision === RV5StageFloatPrecision.Single
  )
  single_request |> single.request
  double_request |> double.request

  inst merge(RRArbiter(Completion, 2))
  single.completion |> merge.ingress[0]
  double.completion |> merge.ingress[1]
  // Only one precision owns the shared variable lane at a time.
  merge.egress.ready <== completion.ready
  completion.valid <== merge.egress.valid
  completion.bits <== merge.egress.bits
  describe_interface_contract(merge.egress, completion, "data", ~trace_model: interface_trace_combinational())
  when (request.fire()):
    active <== Bool(#true)
  elsewhen (completion.fire()):
    active <== Bool(#false)

sync_circuit RV5StageFpDivSqrtFHalf(xlen :: XLen, Tag :: DataType):
  def profile = FloatingPointProfile.F
  def Request = RV5StageFpExecutionRequest(xlen, profile, Tag)
  def Completion = RV5StageFpExecutionResult(xlen, profile, Tag)
  interface request(Decoupled(Request), ~role: consumer)
  interface completion(Irrevocable(Completion), ~role: producer)

  inst half(RV5StageFpDivSqrtLane(xlen, profile, FloatFormat.F16, Tag))
  inst base(RV5StageFpDivSqrtF(xlen, Tag))
  reg active(~init: Bool(#false))
  def Array(base_request, half_request) = request |> gate_flow(!active) |> demux_flow(
    2,
    issued => issued.control.execution.source_precision === RV5StageFloatPrecision.Half
  )
  half_request |> half.request
  base_request |> base.request
  inst merge(RRArbiter(Completion, 2))
  half.completion |> merge.ingress[0]
  base.completion |> merge.ingress[1]
  // Only one precision owns the shared variable lane at a time.
  merge.egress.ready <== completion.ready
  completion.valid <== merge.egress.valid
  completion.bits <== merge.egress.bits
  describe_interface_contract(merge.egress, completion, "data", ~trace_model: interface_trace_combinational())
  when (request.fire()):
    active <== Bool(#true)
  elsewhen (completion.fire()):
    active <== Bool(#false)

