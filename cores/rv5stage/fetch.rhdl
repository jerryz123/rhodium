#lang rhodium
// Fetches aligned words independently of variable-length instruction assembly.

import:
  "bundles.rhdl" open
  "icache/protocol.rhdl" open
  "../../riscv/isa/c.rhm" open
  "../../riscv/isa/fp-profile.rhm" open
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/rtl/compressed.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

hardware_enum RV5StageFetchWordState:
  Empty
  Requested
  Valid

bundle RV5StageFetchWord(xlen :: XLen):
  state: RV5StageFetchWordState
  base: Bits(xlen.width)
  word: Bits(32)
  page_fault: Bool
  access_fault: Bool

sync_circuit RV5StageInstructionFetch(xlen :: XLen,
                                      profile :: FloatingPointProfile = DefaultFloatingPointProfile,
                                      ~compressed: compressed_extensions :: List.of(CompressedExtension) = DefaultCompressedExtensions,
                                      ~supported_instructions: supported_instruction_names :: List.of(String)):
  def width = xlen.width
  def compressed_enabled = compressed_extensions_enabled(compressed_extensions)
  input active: Bool
  input flush: Bool
  input restart_valid: Bool
  input restart_pc: Bits(width)
  input invalidate_all: Bool
  interface memory(RV5StageInstructionAccess(xlen), ~role: requester)
  interface fetched(Decoupled(FetchDecode(xlen)), ~role: producer)

  reg pc(~init: bits(0, width))
  reg request_pc(~init: bits(0, width))
  def empty_word = RV5StageFetchWord(xlen):
    state: RV5StageFetchWordState.Empty
    base: bits(0, width)
    word: bits(0, 32)
    page_fault: Bool(#false)
    access_fault: Bool(#false)
  reg words(~init: vec(for List (_index in 0..4): empty_word))
  reg read_pointer(~init: bits(0, 2))
  reg response_pointer(~init: bits(0, 2))
  reg request_pointer(~init: bits(0, 2))
  reg reserved(~init: bits(0, 3))
  def slot0 = words[read_pointer]
  def slot1 = words[read_pointer + bits(1, 2)]

  def command = flush ||| restart_valid
  inst instructions(Queue(FetchDecode(xlen), 5, ~flow: #true), ~reset_when: command)
  def slot0_valid = slot0.state === RV5StageFetchWordState.Valid
  def slot1_valid = slot1.state === RV5StageFetchWordState.Valid
  def slot0_fault = slot0.page_fault ||| slot0.access_fault
  assert(reserved <= bits(4, 3), "fetch_word_reservations_in_range")
  assert((reserved < bits(2, 3)) ||| (slot1.base === (slot0.base + bits(4, width))),
         "fetch_words_are_contiguous")
  def upper_half = pc[1].into(Bool)
  def selected_halfword = mux(upper_half, slot0.word[16..32], slot0.word[0..16])
  def selected_is_compressed = if compressed_enabled | selected_halfword[0..2] =/= bits(3, 2) | Bool(#false)
  def needs_following_word = slot0_valid & !slot0_fault & upper_half & !selected_is_compressed
  def output_available = slot0_valid & (!needs_following_word ||| slot1_valid)
  def current_raw_instruction = mux(selected_is_compressed, selected_halfword.zext(32), slot0.word)
  def following_raw_instruction = slot1.word[0..16] ++ slot0.word[16..32]
  def raw_instruction = mux(needs_following_word, following_raw_instruction, current_raw_instruction)
  def instruction_is_compressed = slot0_valid & selected_is_compressed & !slot0_fault
  wire expanded_instruction: Bits(32)
  wire compressed_legal: Bool
  if compressed_enabled
  | block:
      inst expander(RiscvCompressedExpander(xlen, profile, compressed_extensions, ~supported_instructions: supported_instruction_names))
      expander.compressed <== raw_instruction[0..16]
      expanded_instruction <== mux(instruction_is_compressed, expander.expansion.instruction, raw_instruction)
      compressed_legal <== expander.expansion.valid
  | block:
      expanded_instruction <== raw_instruction
      compressed_legal <== Bool(#true)
  def instruction_page_fault = slot0.page_fault ||| (needs_following_word & slot1.page_fault)
  def instruction_access_fault = slot0.access_fault ||| (needs_following_word & slot1.access_fault)
  def instruction_bytes = mux(instruction_is_compressed, bits(2, width), bits(4, width))
  def sequential_pc = pc + instruction_bytes
  def instruction_fault_address = mux(needs_following_word & (slot1.page_fault ||| slot1.access_fault), slot1.base, pc)

  instructions.ingress.valid <== active & !command & output_available
  instructions.ingress.bits <== FetchDecode(xlen):
    pc: pc
    instruction: expanded_instruction
    raw_instruction: raw_instruction
    sequential_pc: sequential_pc
    compressed_illegal: instruction_is_compressed & !compressed_legal
    instruction_page_fault: instruction_page_fault
    instruction_access_fault: instruction_access_fault
    instruction_fault_address: instruction_fault_address
  instructions.egress |> gate_flow(active & !command) |> fetched

  def instruction_enqueue = instructions.ingress.fire()
  def retain_lower_word = instruction_is_compressed & !upper_half
  def pop_word = instruction_enqueue & !retain_lower_word
  memory.response.ready <== !command & (words[response_pointer].state === RV5StageFetchWordState.Requested)
  def response_fire = memory.response.fire()

  memory.flush <== command
  memory.invalidate_all <== invalidate_all
  // A dequeue only returns credit at the edge; it cannot select this cycle's address.
  memory.request.valid <== active & !command & (reserved < bits(4, 3))
  memory.request.bits <== RV5StageInstructionReq(xlen):
    address: request_pc

  def request_fire = memory.request.fire()
  when command:
    pc <== mux(restart_valid, restart_pc, pc)
    request_pc <== align_down(mux(restart_valid, restart_pc, pc), 4)
    read_pointer <== bits(0, 2)
    response_pointer <== bits(0, 2)
    request_pointer <== bits(0, 2)
    reserved <== bits(0, 3)
  otherwise:
    when instruction_enqueue:
      pc <== sequential_pc
    when pop_word:
      read_pointer <== read_pointer + bits(1, 2)
    when response_fire:
      response_pointer <== response_pointer + bits(1, 2)
    when request_fire:
      request_pointer <== request_pointer + bits(1, 2)
      request_pc <== request_pc + bits(4, width)
    when (request_fire ^ pop_word):
      reserved <== mux(request_fire, reserved + bits(1, 3), reserved - bits(1, 3))
  for (index in 0..4):
    when command:
      words[index] <== empty_word
    elsewhen (pop_word & (read_pointer === bits(index, 2))):
      words[index] <== empty_word
    elsewhen (response_fire & (response_pointer === bits(index, 2))):
      words[index] <== RV5StageFetchWord(xlen):
        state: RV5StageFetchWordState.Valid
        base: words[index].base
        word: memory.response.bits.word
        page_fault: memory.response.bits.page_fault
        access_fault: memory.response.bits.access_fault
    elsewhen (request_fire & (request_pointer === bits(index, 2))):
      words[index] <== RV5StageFetchWord(xlen):
        state: RV5StageFetchWordState.Requested
        base: request_pc
        word: bits(0, 32)
        page_fault: Bool(#false)
        access_fault: Bool(#false)

export:
  RV5StageFetchWordState
  RV5StageFetchWord
  RV5StageInstructionFetch
