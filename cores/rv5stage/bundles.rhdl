#lang rhodium
/* Defines RV5Stage's pipeline payload and sideband bundle types. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/fetch/fault.rhdl").FetchFault
  lib("riscv/rtl/trap.rhdl").ExceptionCause
  lib("cores/bpred/statistics.rhdl").PredictionFailure
  lib("cores/fp/profile.rhm").fp_transport_profile
  lib("cores/operand.rhdl") open
  lib("cores/mmu/vector.rhdl") open
  lib("cores/register-write.rhdl") open
  "memory-context.rhdl" open
  "../cache/protocol.rhdl" open
  lib("riscv/rtl/hypervisor.rhdl") open
  lib("rhodium/std/bits.rhdl").Pow2Int
  lib("cores/bpred/protocol.rhdl") open
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/rtl/pointer-masking.rhdl" open
  "../../riscv/rtl/vector.rhdl" open
  "../../riscv/rtl/atomic.rhdl" open
  "../branch-decode.rhdl" open
  "../multiply-decode.rhdl" open
  "../divide-decode.rhdl" open
  "../vector/decode.rhdl" open
  "../alu.rhdl" open
  "../branch-resolver.rhdl" open
  "../cache-prefetch.rhdl" open
  "../load-store.rhdl" open
  "../cache/operation.rhdl" open
  "decode/mem-ctrl.rhdl" open
  "decode/multiply-ctrl.rhdl" open
  "decode/divide-ctrl.rhdl" open
  "decode/writeback-ctrl.rhdl" open
  "decode/system-ctrl.rhdl" open
  "decode/fence-ctrl.rhdl" open
  "decode/hint-ctrl.rhdl" open
  "../fp/types.rhdl" open
  "mmu/protocol.rhdl" open
  "../vector/precheck.rhdl".VectorFootprintGeometry
  "multiply.rhdl" open
  "divide.rhdl" open
  "fp/bundles.rhdl" open
  lib("hardfloat/main.rhdl").RoundingMode

/* Selects captured GPR data, current MEM, or normal WB with a legal one-hot mux. */
hardware_enum RV5StageBypassStage(~encoding: one_hot):
  RegisterFile
  Memory
  Writeback

/* Identifies the producer of a deferred completion. Keeping this nominal on
   the payload avoids coupling scoreboard routing to an arbiter index. */
hardware_enum RV5StageCompletionSource:
  VectorInteger
  IntegerLoad
  Multiply
  Divide
  FpInteger

/* Associates a deferred GPR write with its producer for scoreboard release. */
bundle RV5StageDeferredCompletion(xlen :: XLen):
  write: RegisterFileWrite(xlen)
  source: RV5StageCompletionSource

/* Captures the independent reasons that can hold Decode. These are retained as
   separate fields for traceability; the core combines them only at admission. */
bundle RV5StageHazardReasons():
  deferred_dependency: Bool
  scoreboard_raw: Bool
  scoreboard_waw: Bool
  fp_source: Bool
  fp_destination: Bool
  resource: Bool
  pause: Bool
  serialization: Bool
  wfi: Bool
  interrupt_pending: Bool
  exception: Bool

/* Captures a register operand and Decode's newest-producer bypass selection. */
bundle RV5StageOperand(xlen :: XLen):
  stage_sel: RV5StageBypassStage
  value: Bits(xlen.width)

/* Carries the vector-only decode and resolved scalar operands with one scalar
   pipeline occurrence instead of retaining a singleton side context. */
bundle RV5StageVectorLaunchContext(xlen :: XLen):
  pointer_masking: PointerMaskControl()
  instruction: Bits(32)
  control: VectorControl()
  state: RiscvVectorState(xlen)
  scalar: Bits(xlen.width)
  stride: Bits(xlen.width)

/* Carries the admitted instruction, operands, controls, and precise fault context into EX. */
bundle DecodeExecute(xlen :: XLen, vector_completion_slots :: Pow2Int, hypervisor :: Boolean):
  if hypervisor:
    guest_access: RiscvGuestMemoryAccess
    virtual_instruction: Bool

  vector_launch: Bool
  pointer_masking: PointerMaskControl()
  pc: Bits(xlen.width)
  instruction: Bits(32)
  raw_instruction: Bits(32)
  sequential_pc: Bits(xlen.width)
  predicted_next_pc: Bits(xlen.width)
  predicted_ras_action: RasAction
  alu_control: AluControl()
  vector_control: VectorControl()
  operand_left: OperandASelect
  operand_right: OperandBSelect
  branch_control: BranchResolverControl()
  target_from_rs1: Bool
  memory_operation: CacheOperation
  prefetch_operation: CachePrefetchOperation
  memory_atomic: RiscvAtomicOperation
  memory_width: MemoryWidth
  memory_unsigned: Bool
  multiply_control: RiscvMultiplyControl()
  divide_control: RiscvDivideControl()
  floating_point_valid: Bool
  floating_point_control: FloatingPointControl()
  floating_point_rounding_mode_valid: Bool
  floating_point_rounding_mode: RoundingMode
  writeback_enable: Bool
  writeback_source: RV5StageWritebackSelect
  system: RV5StageSystemControl()
  fence: RV5StageFenceControl()
  hint: RV5StageHintOperation
  illegal: Bool
  fault: FetchFault(xlen, hypervisor)
  immediate: Bits(xlen.width)
  rs1: Bits(5)
  rs2: Bits(5)
  operand_rs1: RV5StageOperand(xlen)
  operand_rs2: RV5StageOperand(xlen)
  rd: Bits(5)
  frs3: Bits(5)

/* Carries an exception-valid bit, cause, and XLEN-wide trap value. */
bundle RV5StageException(xlen :: XLen):
  valid: Bool
  cause: ExceptionCause
  value: Bits(xlen.width)

/* Carries EX results, branch recovery, memory intent, and vector certification inputs. */
bundle ExecuteMemory(xlen :: XLen, vector_completion_slots :: Pow2Int, hypervisor :: Boolean):
  if hypervisor:
    guest: RiscvGuestException()
    guest_access: RiscvGuestMemoryAccess

  vector_launch: Bool
  vector_context: RV5StageVectorLaunchContext(xlen)
  vector_fast_first: Bits(xlen.width)
  vector_fast_no_wrap: Bool
  vector_fast_geometry: VectorFootprintGeometry()
  pc: Bits(xlen.width)
  resume_pc: Bits(xlen.width)
  redirect_valid: Bool
  prediction_failure: PredictionFailure
  branch_update: BranchUpdate(xlen)
  branch_prediction: BranchPredictionStatus
  raw_instruction: Bits(32)
  replay: Bool
  data_request_valid: Bool
  data_request: PhysicalMemoryReq(xlen, RV5StageMemoryContext(vector_completion_slots))
  fp_compute: Bool
  fp_issue: RV5StageFpIssue(xlen, fp_transport_profile(xlen), Bits(xlen.width))
  prefetch: CachePrefetchReq(xlen.width)
  writeback_source: RV5StageWritebackSelect
  writeback_enable: Bool
  rd: Bits(5)
  result: Bits(xlen.width)
  multiply_issue: RV5StageMultiplyIssue(xlen)
  divide_issue: RV5StageDivideIssue(xlen)
  system: RV5StageSystemControl()
  fence: RV5StageFenceControl()
  hint: RV5StageHintOperation
  csr_address: Bits(12)
  csr_source: Bits(xlen.width)
  vector_config: RiscvVectorConfigRequest(xlen)
  exception_valid: Bool
  exception_cause: ExceptionCause
  exception_value: Bits(xlen.width)

/* Carries instruction context and deferred issue payloads to WB; LSU outcome capture stays separate. */
bundle MemoryWriteback(xlen :: XLen, vector_completion_slots :: Pow2Int, hypervisor :: Boolean):
  if hypervisor:
    guest: RiscvGuestException()
    guest_access: RiscvGuestMemoryAccess

  vector_launch: Bool
  vector_context: RV5StageVectorLaunchContext(xlen)
  vector_fast_valid: Bool
  vector_fast: VectorFastCertificate(xlen)
  pc: Bits(xlen.width)
  resume_pc: Bits(xlen.width)
  branch_prediction: BranchPredictionStatus
  ras_mismatch: Bool
  raw_instruction: Bits(32)
  replay: Bool
  data_request_valid: Bool
  data_request: PhysicalMemoryReq(xlen, RV5StageMemoryContext(vector_completion_slots))
  fp_compute: Bool
  fp_issue: RV5StageFpIssue(xlen, fp_transport_profile(xlen), Bits(xlen.width))
  prefetch: CachePrefetchReq(xlen.width)
  writeback_source: RV5StageWritebackSelect
  write_enable: Bool
  rd: Bits(5)
  value: Bits(xlen.width)
  multiply_issue: RV5StageMultiplyIssue(xlen)
  divide_issue: RV5StageDivideIssue(xlen)
  system: RV5StageSystemControl()
  fence: RV5StageFenceControl()
  hint: RV5StageHintOperation
  csr_address: Bits(12)
  csr_source: Bits(xlen.width)
  vector_config: RiscvVectorConfigRequest(xlen)
  exception_valid: Bool
  exception_cause: ExceptionCause
  exception_value: Bits(xlen.width)

  /* Removes live launch operands and certificates before selecting a retirement owner. */
  method retirement(operation) :: RV5StageRetirementCommand(xlen, vector_completion_slots, hypervisor):
    def empty :: RV5StageRetirementCommand(xlen, vector_completion_slots, hypervisor) = literal(RV5StageRetirementCommand(xlen, vector_completion_slots, hypervisor), 0)
    def command = empty.updated(
      ~vector_launch: operation.vector_launch,
      ~pc: operation.pc,
      ~resume_pc: operation.resume_pc,
      ~branch_prediction: operation.branch_prediction,
      ~ras_mismatch: operation.ras_mismatch,
      ~raw_instruction: operation.raw_instruction,
      ~replay: operation.replay,
      ~data_request_valid: operation.data_request_valid,
      ~data_request: operation.data_request,
      ~fp_compute: operation.fp_compute,
      ~prefetch: operation.prefetch,
      ~writeback_source: operation.writeback_source,
      ~write_enable: operation.write_enable,
      ~rd: operation.rd,
      ~value: operation.value,
      ~system: operation.system,
      ~fence: operation.fence,
      ~hint: operation.hint,
      ~csr_address: operation.csr_address,
      ~csr_source: operation.csr_source,
      ~vector_config: operation.vector_config,
      ~exception_valid: operation.exception_valid,
      ~exception_cause: operation.exception_cause,
      ~exception_value: operation.exception_value
    )
    if hypervisor | command.updated(~guest: operation.guest, ~guest_access: operation.guest_access) | command

  /* Replaces the ALU value only for a captured load hit; no outcome or duplicate context is stored. */
  method with_response(context, response :: CachePipelineResult(xlen)) :: MemoryWriteback(xlen, vector_completion_slots, hypervisor):
    context.updated(~value: mux(response.outcome === CachePipelineOutcome.LoadHit, response.data, context.value))

/* Common WB retirement and trap command. Deferred arithmetic/vector launch payloads
   remain at the live pipeline owner, never padded into a completed scalar service. */
bundle RV5StageRetirementCommand(xlen :: XLen, vector_completion_slots :: Pow2Int, hypervisor :: Boolean):
  if hypervisor:
    guest: RiscvGuestException()
    guest_access: RiscvGuestMemoryAccess

  vector_launch: Bool
  pc: Bits(xlen.width)
  resume_pc: Bits(xlen.width)
  branch_prediction: BranchPredictionStatus
  ras_mismatch: Bool
  raw_instruction: Bits(32)
  replay: Bool
  data_request_valid: Bool
  data_request: PhysicalMemoryReq(xlen, RV5StageMemoryContext(vector_completion_slots))
  fp_compute: Bool
  prefetch: CachePrefetchReq(xlen.width)
  writeback_source: RV5StageWritebackSelect
  write_enable: Bool
  rd: Bits(5)
  value: Bits(xlen.width)
  system: RV5StageSystemControl()
  fence: RV5StageFenceControl()
  hint: RV5StageHintOperation
  csr_address: Bits(12)
  csr_source: Bits(xlen.width)
  vector_config: RiscvVectorConfigRequest(xlen)
  exception_valid: Bool
  exception_cause: ExceptionCause
  exception_value: Bits(xlen.width)


/* Holds an already-classified synchronous trap until older work drains. The resume PC
   preserves the observed instruction boundary; guest provenance exists only with H. */
bundle RV5StagePendingTrap(xlen :: XLen, hypervisor :: Boolean):
  pc: Bits(xlen.width)
  resume_pc: Bits(xlen.width)
  cause: ExceptionCause
  value: Bits(xlen.width)
  if hypervisor:
    guest: RiscvGuestFault()

/* Retains an accepted scalar memory operation or WRS until it can retire.
   The wait mode discriminates WRS from memory. Keep the original request for
   precise split faults, FP load routing and cosim, but no deferred issue operands. */
bundle RetainedScalarWriteback(xlen :: XLen, vector_completion_slots :: Pow2Int, hypervisor :: Boolean):
  if hypervisor:
    guest: RiscvGuestException()
    guest_access: RiscvGuestMemoryAccess

  pc: Bits(xlen.width)
  resume_pc: Bits(xlen.width)
  raw_instruction: Bits(32)
  branch_prediction: BranchPredictionStatus
  ras_mismatch: Bool
  data_request_valid: Bool
  data_request: PhysicalMemoryReq(xlen, RV5StageMemoryContext(vector_completion_slots))
  writeback_source: RV5StageWritebackSelect
  write_enable: Bool
  rd: Bits(5)
  value: Bits(xlen.width)
  system: RV5StageSystemControl()
  fence: RV5StageFenceControl()
  hint: RV5StageHintOperation


export:
  RV5StageBypassStage
  RV5StageCompletionSource
  RV5StageDeferredCompletion
  RV5StageHazardReasons
  RV5StageOperand
  RV5StageVectorLaunchContext
  DecodeExecute
  RV5StageException
  ExecuteMemory
  MemoryWriteback
  RV5StageRetirementCommand
  RV5StagePendingTrap
  RetainedScalarWriteback
