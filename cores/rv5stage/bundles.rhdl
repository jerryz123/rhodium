#lang rhodium
// Defines RV5Stage's pipeline payload and sideband bundle types.

import:
  "btb.rhdl" open
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/isa/fp-profile.rhm" open
  "../../riscv/rtl/pointer-masking.rhdl" open
  "../alu.rhdl" open
  "../branch-resolver.rhdl" open
  "../cache-prefetch.rhdl" open
  "../load-store.rhdl" open
  "memory.rhdl" open
  "decode/operand-ctrl.rhdl" open
  "decode/mem-ctrl.rhdl" open
  "decode/multiply-ctrl.rhdl" open
  "decode/divide-ctrl.rhdl" open
  "decode/writeback-ctrl.rhdl" open
  "decode/system-ctrl.rhdl" open
  "decode/fence-ctrl.rhdl" open
  "decode/hint-ctrl.rhdl" open
  "decode/fp-ctrl.rhdl" open
  "dcache/protocol.rhdl" open
  "register-file.rhdl" open
  "multiply.rhdl" open
  "divide.rhdl" open
  "fp/bundles.rhdl" open
  lib("hardfloat/main.rhdl").RoundingMode

bundle FetchDecode(xlen :: XLen):
  pc: Bits(xlen.width)
  instruction: Bits(32)
  raw_instruction: Bits(32)
  sequential_pc: Bits(xlen.width)
  predicted_next_pc: Bits(xlen.width)
  compressed_illegal: Bool
  instruction_page_fault: Bool
  instruction_access_fault: Bool
  instruction_fault_address: Bits(xlen.width)

hardware_enum RV5StageBypassStage(~encoding: one_hot):
  RegisterFile
  Memory
  Writeback

// Identifies the producer of a deferred completion. Keeping this nominal on
// the payload avoids coupling scoreboard routing to an arbiter index.
hardware_enum RV5StageCompletionSource:
  IntegerLoad
  Multiply
  Divide
  FpInteger

bundle RV5StageDeferredCompletion(xlen :: XLen):
  write: RegisterFileWrite(xlen)
  source: RV5StageCompletionSource

// Captures the independent reasons that can hold Decode. These are retained as
// separate fields for traceability; the core combines them only at admission.
bundle RV5StageHazardReasons():
  deferred_dependency: Bool
  scoreboard_raw: Bool
  scoreboard_waw: Bool
  fp_source: Bool
  fp_destination: Bool
  resource: Bool
  pause: Bool
  serialization: Bool
  wfi: Bool
  interrupt_pending: Bool
  exception: Bool

bundle RV5StageOperand(xlen :: XLen):
  stage_sel: RV5StageBypassStage
  value: Bits(xlen.width)

bundle DecodeExecute(xlen :: XLen):
  pointer_masking: PointerMaskControl()
  pc: Bits(xlen.width)
  instruction: Bits(32)
  raw_instruction: Bits(32)
  sequential_pc: Bits(xlen.width)
  predicted_next_pc: Bits(xlen.width)
  alu_control: AluControl()
  operand_left: OperandASelect
  operand_right: OperandBSelect
  branch_control: BranchResolverControl()
  target_from_rs1: Bool
  memory_operation: MemoryOperation
  prefetch_operation: CachePrefetchOperation
  memory_atomic: RV5StageAtomicOperation
  memory_width: MemoryWidth
  memory_unsigned: Bool
  multiply_control: RV5StageMultiplyControl()
  divide_control: RV5StageDivideControl()
  floating_point_valid: Bool
  floating_point_control: RV5StageFloatingPointControl()
  floating_point_rounding_mode_valid: Bool
  floating_point_rounding_mode: RoundingMode
  writeback_enable: Bool
  writeback_source: WritebackSelect
  system: SystemControl()
  fence: FenceControl()
  hint: HintOperation
  illegal: Bool
  instruction_page_fault: Bool
  instruction_access_fault: Bool
  instruction_fault_address: Bits(xlen.width)
  immediate: Bits(xlen.width)
  rs1: Bits(5)
  rs2: Bits(5)
  operand_rs1: RV5StageOperand(xlen)
  operand_rs2: RV5StageOperand(xlen)
  rd: Bits(5)
  frs3: Bits(5)

bundle RV5StageException(xlen :: XLen):
  valid: Bool
  cause: Bits(xlen.width)
  value: Bits(xlen.width)

bundle ExecuteMemory(xlen :: XLen):
  pc: Bits(xlen.width)
  resume_pc: Bits(xlen.width)
  redirect_valid: Bool
  branch_update: RV5StageBranchUpdate(xlen)
  instruction: Bits(32)
  replay: Bool
  data_request_valid: Bool
  data_request: RV5StageDataReq(xlen)
  fp_compute: Bool
  fp_issue: RV5StageFpIssue(xlen, if xlen == XLen.X32 | FloatingPointProfile.F | FloatingPointProfile.D, Bits(xlen.width))
  prefetch: CachePrefetchReq(xlen.width)
  writeback_source: WritebackSelect
  writeback_enable: Bool
  rd: Bits(5)
  result: Bits(xlen.width)
  multiply_issue: RV5StageMultiplyIssue(xlen)
  divide_issue: RV5StageDivideIssue(xlen)
  system: SystemControl()
  fence: FenceControl()
  hint: HintOperation
  csr_address: Bits(12)
  csr_source: Bits(xlen.width)
  exception_valid: Bool
  exception_cause: Bits(xlen.width)
  exception_value: Bits(xlen.width)

bundle MemoryWriteback(xlen :: XLen):
  pc: Bits(xlen.width)
  resume_pc: Bits(xlen.width)
  instruction: Bits(32)
  replay: Bool
  load_hit: Bool
  cache_outcome: RV5StagePipelineOutcome
  data_request_valid: Bool
  data_request: RV5StageDataReq(xlen)
  fp_compute: Bool
  fp_issue: RV5StageFpIssue(xlen, if xlen == XLen.X32 | FloatingPointProfile.F | FloatingPointProfile.D, Bits(xlen.width))
  prefetch: CachePrefetchReq(xlen.width)
  writeback_source: WritebackSelect
  write_enable: Bool
  rd: Bits(5)
  value: Bits(xlen.width)
  multiply_issue: RV5StageMultiplyIssue(xlen)
  divide_issue: RV5StageDivideIssue(xlen)
  system: SystemControl()
  fence: FenceControl()
  hint: HintOperation
  csr_address: Bits(12)
  csr_source: Bits(xlen.width)
  exception_valid: Bool
  exception_cause: Bits(xlen.width)
  exception_value: Bits(xlen.width)

export:
  FetchDecode
  RV5StageBypassStage
  RV5StageCompletionSource
  RV5StageDeferredCompletion
  RV5StageHazardReasons
  RV5StageOperand
  DecodeExecute
  RV5StageException
  ExecuteMemory
  MemoryWriteback
