#lang rhodium
/* Arbitrates RV5Stage fetch/data ownership around the shared nonallocating CHI service. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../../cache/uncached-arbiter.rhdl".UncachedFetchArbiter
  "../../cache/chi/uncached.rhdl" open
  "../../cache/chi/flits.rhdl" open
  "../../cache/protocol.rhdl" open
  "../../cache/operation.rhdl" open
  "../memory-context.rhdl" open
  "../icache/protocol.rhdl".RV5StageInstructionResp
  "../uncached-protocol.rhdl" open
  "../../load-store.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/rtl/atomic.rhdl".RiscvAtomicOperation
  "../../../riscv/rtl/zihintntl.rhdl".RiscvMemoryLocality
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open
  lib("chi/protocol/channels.rhdl").CHIRNIChannels

/* Gives committed data priority over fetch, withdraws unissued flushed fetches, and drains
   accepted fetch traffic without publishing orphan replies. Adds no request/response stage. */
sync_circuit RV5StageUncached(xlen :: XLen, config :: RiscvHartCHIConfig,
                              ~vector_completion_slots: vector_completion_slots :: Pow2Int = 8):
  def Context = RV5StageMemoryContext(vector_completion_slots)
  input node_id: Bits(config.flit.node_id_width)
  interface instruction(RV5StagePhysicalInstructionAccess(xlen), ~role: responder)
  interface core(UncachedMemoryAccess(xlen, Context), ~role: responder)
  interface chi(CHIRNIChannels(config.flit), ~role: node)
  inst transport(CHIUncachedMemory(xlen, config, Context))
  inst ownership(UncachedFetchArbiter(xlen, Context))
  ownership.flush <== instruction.flush

  transport.node_id <== node_id
  chi <=> transport.chi
  core |> ownership.data
  (
    instruction.request
      |> map_flow(fetch => UncachedMemoryReq(xlen, Context)):
          request:
            PhysicalMemoryReq(xlen, Context):
              byte_mask: dont_care(Bits(memory_word_bytes(xlen)))
              address: fetch.address
              access: CacheOperation.Load
              atomic: dont_care(RiscvAtomicOperation)
              width: MemoryWidth.Word
              unsigned: Bool(#true)
              data: dont_care(Bits(xlen.width))
              context: dont_care(Context)
              locality: dont_care(RiscvMemoryLocality)
          device: fetch.device
  ) |> ownership.instruction_request
  ownership.transport |> transport.core
  transport.cancel <== ownership.cancel
  instruction.response.valid <== ownership.instruction_response.valid
  instruction.response.bits <== RV5StageInstructionResp(#false):
    word: ownership.instruction_response.bits.data[0..32]
    page_fault: Bool(#false)
    access_fault: ownership.instruction_response.bits.access_fault
  ownership.instruction_response.ready <== instruction.response.ready

  when (instruction.request.valid & transport.core.drained & !core.request.valid & !instruction.flush):
    assert(!instruction.request.bits.cacheable, "rv5stage_uncached_instruction_not_cacheable")
    assert(instruction.request.bits.address.is_aligned(4), "rv5stage_uncached_instruction_aligned")

export:
  RV5StageUncached
