#lang rhodium
// Implements RV5Stage's one-outstanding non-cacheable CHI RN-I transaction path.

import:
  "foundation.rhdl" open
  "../profile.rhm".RV5StageCacheLineBytes
  "../fp/types.rhdl" open
  "../memory.rhdl" open
  "../dcache/protocol.rhdl" open
  "../icache/protocol.rhdl".RV5StageInstructionResp
  "../uncached-protocol.rhdl" open
  "../../load-store.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/ready-valid.rhdl") open
  lib("chi/main.rhdl") open

hardware_enum RV5StageUncachedState:
  Idle
  Request
  ReadResponse
  WriteDBID
  WriteData
  WriteResponse

sync_circuit RV5StageUncached(xlen :: XLen,
                              config :: RV5StageCHIConfig):
  def width = xlen.width
  def p = config.flit
  def word_lanes = p.data_bytes / 8
  def lane_width = index_width(word_lanes)
  def instruction_word_lanes = p.data_bytes / 4
  def instruction_lane_width = index_width(instruction_word_lanes)

  input node_id: Bits(p.node_id_width)
  interface instruction(RV5StagePhysicalInstructionAccess(xlen), ~role: responder)
  interface core(RV5StageUncachedDataAccess(xlen), ~role: responder)
  interface chi(CHIRNIChannels(p), ~role: node)

  inst load_gen(LoadGen(xlen))
  inst store_gen(StoreGen(xlen))
  reg state(~init: RV5StageUncachedState.Idle)
  reg address(Bits(width))
  reg memory_width(MemoryWidth)
  reg unsigned_load(~init: Bool(#false))
  reg destination(RV5StageDataDestination)
  reg rd(Bits(5))
  reg floating_point_precision(RV5StageFloatPrecision)
  reg owner_is_instruction(~init: Bool(#false))
  reg instruction_live(~init: Bool(#false))
  reg home_id(Bits(p.node_id_width))
  reg request_size(CHITransferSize)
  reg request_opcode(CHIReqOpcode)
  reg request_device(~init: Bool(#false))
  reg dbid(Bits(12))
  reg write_data(Bits(64))
  reg write_mask(Mask(8))
  reg zero_active(~init: Bool(#false))
  reg zero_index(Bits(index_width(RV5StageCacheLineBytes / 8)), ~init: bits(0, index_width(RV5StageCacheLineBytes / 8)))

  def idle = state === RV5StageUncachedState.Idle
  def command :: RV5StageDataReq(xlen) = core.request.bits.request
  def command_access = command.access
  def command_supported = command_access.is_one_of(MemoryOperation.Load,
                                                   MemoryOperation.Store,
                                                   MemoryOperation.CacheBlockZero)
  def command_zero = command_access.is_cache_block_zero()
  def zero_last = zero_index === bits(RV5StageCacheLineBytes / 8 - 1, index_width(RV5StageCacheLineBytes / 8))
  def instruction_command = instruction.request.bits
  def select_data = core.request.valid
  def select_instruction = !select_data
  def command_home = config.home_map.lookup(rv5stage_chi_address(command.address, p))
  def instruction_home = config.home_map.lookup(
    rv5stage_chi_address(instruction_command.address, p)
  )
  def selected_home = mux(select_instruction, instruction_home, command_home)
  def selected_address = mux(select_instruction,
                             instruction_command.address,
                             mux(command_zero, command.address.align_down(RV5StageCacheLineBytes), command.address))
  def selected_size = mux(
    select_instruction,
    CHITransferSize.Bytes4,
    mux(command_zero, CHITransferSize.Bytes8, command.width.as_bits().zext(3).into(CHITransferSize))
  )
  def selected_opcode = mux(
    select_instruction,
    CHIReqOpcode.ReadNoSnp,
    mux(command_access.is_store() ||| command_zero, CHIReqOpcode.WriteNoSnpPtl, CHIReqOpcode.ReadNoSnp)
  )
  def selected_device = mux(select_instruction,
                            instruction_command.device,
                            core.request.bits.device)
  core.request.ready <== idle & mux(command_supported, command_home.valid, Bool(#true))
  instruction.request.ready <== idle & !select_data & !instruction.flush & instruction_home.valid
  core.request_fault <== Bool(#false)
  core.request_access_fault <== core.request.valid & !command_supported
  def data_accept = core.request.fire() & command_supported
  def instruction_accept = instruction.request.fire()
  def request_accept = data_accept ||| instruction_accept
  def request_pending = state === RV5StageUncachedState.Request
  chi.req.valid <== request_pending & (!owner_is_instruction ||| !instruction.flush)
  chi.req.bits <== rv5stage_chi_request(
    p,
    node_id,
    home_id,
    address,
    request_size,
    request_opcode,
    bits(0, 12),
    Bool(#false),
    Bool(#false),
    Bool(#false),
    bits(0, 4),
    ~cacheable: Bool(#false),
    ~device: request_device,
    ~early_write_acknowledge: Bool(#false)
  )
  def request_fire = chi.req.fire()

  store_gen.address <== command.address
  store_gen.value <== command.data
  store_gen.width <== command.width

  def incoming_response = chi.rsp.response.bits
  def response_ordinary = incoming_response.opcode =/= CHIRspOpcode.RespLCrdReturn
  def dbid_expected = state === RV5StageUncachedState.WriteDBID
  def completion_expected = state === RV5StageUncachedState.WriteResponse
  def response_expected = (dbid_expected & (
    incoming_response.opcode === CHIRspOpcode.DBIDResp
  )) ||| (completion_expected & (incoming_response.opcode === CHIRspOpcode.Comp))
  chi.rsp.response.ready <== !response_ordinary ||| response_expected
  def response_fire = chi.rsp.response.fire() & response_ordinary
  def dbid_fire = response_fire & dbid_expected
  def completion_fire = response_fire & completion_expected

  def data_lane = address[3..alignment_bits(p.data_bytes)]
  def bus_data = write_data.zext(p.data_width) << (data_lane ++ bits(0, 6))
  def bus_mask = write_mask.into(Bits(8)).zext(p.data_bytes) << (data_lane ++ bits(0, 3))
  chi.dat.request.valid <== state === RV5StageUncachedState.WriteData
  chi.dat.request.bits <== rv5stage_chi_write_data(
    p,
    node_id,
    home_id,
    dbid,
    address,
    bus_data,
    bus_mask
  )
  def write_data_fire = chi.dat.request.fire()

  def incoming_data = chi.dat.response.bits
  def data_ordinary = incoming_data.opcode =/= CHIDatOpcode.DataLCrdReturn
  def read_expected = state === RV5StageUncachedState.ReadResponse
  def read_lanes = incoming_data.data.into(Vec(word_lanes, Bits(64)))
  def read_lane:
    if word_lanes == 1 | bits(0, lane_width) | address[3..alignment_bits(p.data_bytes)]
  load_gen.address <== address
  load_gen.data <== read_lanes[read_lane]
  load_gen.width <== memory_width
  load_gen.unsigned_load <== unsigned_load
  def instruction_response_valid = chi.dat.response.valid & data_ordinary & read_expected & (
    owner_is_instruction & instruction_live
  )
  chi.dat.response.ready <== !data_ordinary ||| (read_expected & mux(
    owner_is_instruction,
    !instruction_live ||| instruction.response.ready,
    Bool(#true)
  ))
  def read_fire = chi.dat.response.fire() & data_ordinary
  def data_read_valid = chi.dat.response.valid & data_ordinary & read_expected & !owner_is_instruction

  def instruction_words = incoming_data.data.into(Vec(instruction_word_lanes, Bits(32)))
  def instruction_lane:
    if instruction_word_lanes == 1
    | bits(0, instruction_lane_width)
    | address[2..alignment_bits(p.data_bytes)]
  instruction.response.valid <== instruction_response_valid
  instruction.response.bits <== RV5StageInstructionResp():
    word: instruction_words[instruction_lane]
    page_fault: Bool(#false)
    access_fault: Bool(#false)

  core.response.valid <== data_read_valid ||| (completion_fire & (!zero_active ||| zero_last))
  core.response.bits <== RV5StageDataResp(xlen):
    access_fault: Bool(#false)
    data: mux(data_read_valid, load_gen.value, bits(0, width))
    destination: destination
    rd: rd
    floating_point_precision: floating_point_precision
  core.drained <== idle
  chi.rsp.requester.valid <== Bool(#false)
  chi.rsp.requester.bits <== literal(CHIRspFlit(p), 0)

  when request_accept:
    address <== selected_address
    memory_width <== command.width
    unsigned_load <== command.unsigned
    destination <== command.destination
    rd <== command.rd
    floating_point_precision <== command.floating_point_precision
    owner_is_instruction <== select_instruction
    home_id <== selected_home.node_id
    request_size <== selected_size
    request_opcode <== selected_opcode
    request_device <== selected_device
    write_data <== mux(command_zero, bits(0, 64), store_gen.data)
    write_mask <== mux(command_zero, (!bits(0, 8)).into(Mask(8)), store_gen.mask)
    zero_active <== select_data & command_zero
    zero_index <== bits(0, index_width(RV5StageCacheLineBytes / 8))
    state <== RV5StageUncachedState.Request
  elsewhen (request_pending & owner_is_instruction & instruction.flush):
    state <== RV5StageUncachedState.Idle
  elsewhen request_fire:
    state <== mux(request_opcode === CHIReqOpcode.WriteNoSnpPtl,
                  RV5StageUncachedState.WriteDBID,
                  RV5StageUncachedState.ReadResponse)
  elsewhen dbid_fire:
    dbid <== incoming_response.dbid_or_group_id
    state <== RV5StageUncachedState.WriteData
  elsewhen write_data_fire:
    state <== RV5StageUncachedState.WriteResponse
  elsewhen (completion_fire & zero_active & !zero_last):
    address <== address + bits(8, width)
    zero_index <== zero_index + bits(1, index_width(RV5StageCacheLineBytes / 8))
    state <== RV5StageUncachedState.Request
  elsewhen (read_fire ||| completion_fire):
    state <== RV5StageUncachedState.Idle

  when (instruction.flush):
    instruction_live <== Bool(#false)
  elsewhen instruction_accept:
    instruction_live <== Bool(#true)
  elsewhen (read_fire & owner_is_instruction):
    instruction_live <== Bool(#false)

  when (core.request.valid & idle & command_supported):
    assert(rv5stage_chi_address_fits(command.address, p), "rv5stage_uncached_address_fits")
    assert(command_home.valid, "rv5stage_uncached_address_has_home")
  when (instruction.request.valid & idle & !select_data & !instruction.flush):
    assert(!instruction_command.cacheable,
           "rv5stage_uncached_instruction_not_cacheable")
    assert(instruction_command.address.is_aligned(4),
           "rv5stage_uncached_instruction_aligned")
    assert(rv5stage_chi_address_fits(instruction_command.address, p),
           "rv5stage_uncached_instruction_address_fits")
    assert(instruction_home.valid,
           "rv5stage_uncached_instruction_address_has_home")
  when (chi.rsp.response.valid & response_ordinary):
    assert(response_expected, "rv5stage_uncached_response_expected")
    assert(incoming_response.src_id === home_id, "rv5stage_uncached_response_home")
    assert(incoming_response.resp_err === CHIRespErr.OK, "rv5stage_uncached_response_ok")
  when (chi.dat.response.valid & data_ordinary):
    assert(read_expected, "rv5stage_uncached_read_data_expected")
    assert(incoming_data.home_nid_or_pbha_or_mismatched_mecid === home_id,
           "rv5stage_uncached_read_data_home")
    assert(incoming_data.resp_err === CHIRespErr.OK, "rv5stage_uncached_read_data_ok")

export:
  RV5StageUncachedState
  RV5StageUncached
