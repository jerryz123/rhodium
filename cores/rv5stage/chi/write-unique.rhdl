#lang rhodium
// Implements RV5Stage's retry-aware RN-F WriteUniquePtl transaction engine.

import:
  "foundation.rhdl" open
  "../../load-store.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/flow.rhdl") open
  lib("chi/main.rhdl") open

bundle RV5StageWriteUniqueCommand(Context :: DataType,
                                  address_width :: PosInt):
  address: Bits(address_width)
  width: MemoryWidth
  data: Bits(64)
  mask: Mask(8)
  context: Context

bundle RV5StageWriteUniqueResult(Context :: DataType):
  context: Context

sync_circuit RV5StageWriteUnique(Context :: DataType,
                                 address_width :: PosInt,
                                 config :: RV5StageCHIConfig,
                                 txn_id :: Nat):
  def p = config.flit
  unless bits.length(txn_id) <= 12
  | error(~who: #'RV5StageWriteUnique,
          "transaction ID must fit in twelve bits")

  input node_id: Bits(p.node_id_width)
  interface command(Decoupled(RV5StageWriteUniqueCommand(Context, address_width)), ~role: consumer)
  interface completion(Irrevocable(RV5StageWriteUniqueResult(Context)), ~role: producer)
  interface requests(Decoupled(CHIReqFlit(p)), ~role: producer)
  interface data(Decoupled(CHIDatFlit(p)), ~role: producer)
  interface responses(Decoupled(CHIRspFlit(p)), ~role: consumer)

  inst control(CHIRetryableTransactionControl(p, RV5StageWriteUniqueResponses))
  reg data_sent(~init: Bool(#false))
  reg address(~init: bits(0, address_width))
  reg width(~init: MemoryWidth.Byte)
  reg write_data(~init: bits(0, 64))
  reg write_mask(~init: Mask(8)(0))
  reg context(Context)
  reg home_id(~init: bits(0, p.node_id_width))
  reg dbid(~init: bits(0, 12))

  command.ready <== !control.active
  def command_fire = command.fire()
  def command_home = config.home_map.lookup(rv5stage_chi_address(command.bits.address, p))
  when command_fire:
    assert(rv5stage_chi_address_fits(command.bits.address, p),
           "write_unique_address_fits_chi")
    assert(command_home.valid, "write_unique_address_has_home")

  control.attempt
    |> map_flow(attempt => rv5stage_chi_request(
      p,
      node_id,
      home_id,
      address,
      width.as_bits().zext(3).into(CHITransferSize),
      CHIReqOpcode.WriteUniquePtl,
      bits(txn_id, 12),
      Bool(#false),
      Bool(#false),
      attempt.allow_retry,
      attempt.pcrd_type
    ))
    |> requests

  responses |> control.response
  def response_event = control.event
  def incoming_response = response_event.bits.flit
  def response_fire = response_event.valid
  def response_protocol_credit = response_event.bits.protocol_credit
  def dbid_fire = response_fire & chi_response_milestone(
    RV5StageWriteUniqueResponses,
    response_event.bits.effects,
    "dbid"
  )
  def response_completion_fire = response_fire & chi_response_milestone(
    RV5StageWriteUniqueResponses,
    response_event.bits.effects,
    "completion"
  )
  def dbid_received = chi_response_milestone(
    RV5StageWriteUniqueResponses,
    control.received,
    "dbid"
  )
  def completion_received = chi_response_milestone(
    RV5StageWriteUniqueResponses,
    control.received,
    "completion"
  )
  def transaction_id_response_fire = dbid_fire ||| response_completion_fire
  def transaction_id_already_received = dbid_received ||| completion_received
  when response_fire:
    assert(incoming_response.src_id === home_id,
           "write_unique_response_home")
    assert(incoming_response.resp_err === CHIRespErr.OK,
           "write_unique_response_ok")
  when (response_fire & !response_protocol_credit):
    assert(incoming_response.txn_id === bits(txn_id, 12),
           "write_unique_response_txn_id")
  when (transaction_id_response_fire & transaction_id_already_received):
    assert(incoming_response.dbid_or_group_id === dbid,
           "write_unique_response_dbid_consistent")

  def data_lane = address[3..alignment_bits(p.data_bytes)]
  def bus_data = write_data.zext(p.data_width) << (data_lane ++ bits(0, 6))
  def bus_mask = write_mask.into(Bits(8)).zext(p.data_bytes) << (data_lane ++ bits(0, 3))
  data.valid <== control.active & dbid_received & !data_sent
  data.bits <== rv5stage_chi_write_data(
    p,
    node_id,
    home_id,
    dbid,
    address,
    bus_data,
    bus_mask
  )
  def data_fire = data.fire()

  completion.valid <== control.active & data_sent & completion_received
  completion.bits <== RV5StageWriteUniqueResult(Context):
    context: context
  def completion_fire = completion.fire()

  control.start <== command_fire
  control.finish <== completion_fire
  control.external_progress <== Bool(#false)

  when command_fire:
    address <== command.bits.address
    width <== command.bits.width
    write_data <== command.bits.data
    write_mask <== command.bits.mask
    context <== command.bits.context
    home_id <== command_home.node_id
  when (command_fire ||| completion_fire):
    data_sent <== Bool(#false)
  elsewhen data_fire:
    data_sent <== Bool(#true)

  when transaction_id_response_fire:
    dbid <== incoming_response.dbid_or_group_id

export:
  RV5StageWriteUniqueCommand
  RV5StageWriteUniqueResult
  RV5StageWriteUnique
