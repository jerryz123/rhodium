#lang rhodium
// Returns one snoop-visible victim through a retryable full-line CHI copyback.
// SPDX-License-Identifier: Apache-2.0

import:
  "../cache.rhdl" open
  "foundation.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open
  lib("chi/protocol/flits.rhdl") open
  lib("chi/protocol/coherence.rhdl") open
  lib("chi/protocol/protocol.rhdl").chi_transfer_data_id
  lib("chi/protocol/messages.rhdl").chi_rn_copyback_data
  lib("chi/transactions/retryable-transaction.rhdl") open

bundle RV5StageLineWritebackCommand(Context :: DataType, address_width :: PosInt):
  line_address: Bits(address_width)
  line: Vec(RV5StageCacheLineBytes / 8, Bits(64))
  context: Context

bundle RV5StageLineWritebackResult(Context :: DataType):
  context: Context

sync_circuit RV5StageLineWriteback(Context :: DataType, address_width :: PosInt, config :: RV5StageCHIConfig, txn_id :: Nat):
  def p = config.flit
  def packets = RV5StageCacheLineBytes / p.data_bytes
  def packet_width = index_width(packets)
  input node_id: Bits(p.node_id_width)
  // Cache-owned state may change under snoops until the grant is accepted.
  input victim_state: CHICacheState
  input snoop_pending: Bool
  output granted: Bool
  interface command(Decoupled(RV5StageLineWritebackCommand(Context, address_width)), ~role: consumer)
  interface completion(Irrevocable(RV5StageLineWritebackResult(Context)), ~role: producer)
  interface requests(Decoupled(CHIReqFlit(p)), ~role: producer)
  interface data(Decoupled(CHIDatFlit(p)), ~role: producer)
  interface responses(Decoupled(CHIRspFlit(p)), ~role: consumer)

  inst control(CHIRetryableTransactionControl(p, RV5StageCopyBackResponses))
  reg line_address(Bits(address_width))
  reg line(Vec(packets, Bits(p.data_width)))
  reg context(Context)
  reg home_id(Bits(p.node_id_width))
  reg dbid(Bits(12))
  reg response_state(Bits(3))
  reg packet_index(~init: bits(0, packet_width))
  reg data_sent(~init: Bool(#false))
  command.ready <== !control.active
  def command_fire = command.fire()
  def command_home = config.home_map.lookup(rv5stage_chi_address(command.bits.line_address, p))
  when command_fire:
    assert(command_home.valid, "copyback_address_has_home")
    assert(command.bits.line_address.is_aligned(RV5StageCacheLineBytes), "copyback_line_aligned")
    assert(rv5stage_chi_address_fits(command.bits.line_address, p), "copyback_address_fits_chi")
    line_address <== command.bits.line_address
    line <== command.bits.line.as_bits().as_vec(Bits(p.data_width))
    context <== command.bits.context
    home_id <== command_home.node_id

  control.attempt
    |> map_flow(attempt => rv5stage_chi_request(p, node_id, home_id, line_address, CHITransferSize.Bytes64, CHIReqOpcode.WriteBackFull, bits(txn_id, 12), Bool(#false), Bool(#true), attempt.allow_retry, attempt.pcrd_type))
    |> requests
  responses |> gate_flow(!snoop_pending ||| responses.bits.opcode.is_one_of(CHIRspOpcode.RetryAck, CHIRspOpcode.PCrdGrant)) |> control.response
  def response = control.event.bits.flit
  def grant = control.event.valid & RV5StageCopyBackResponses.milestone(control.event.bits.effects, "grant")
  granted <== RV5StageCopyBackResponses.milestone(control.received, "grant")
  when (control.event.valid):
    assert(response.src_id === home_id, "copyback_response_home")
    assert(response.tgt_id === node_id, "copyback_response_target")
    assert(response.resp_err === CHIRespErr.OK, "copyback_response_ok")
    when (!control.event.bits.protocol_credit):
      assert(response.txn_id === bits(txn_id, 12), "copyback_response_txn")
  when grant:
    assert(response.resp === bits(0, 3), "copyback_completion_has_no_state")
    assert(victim_state =/= CHICacheState.UniqueDirtyPartial, "copyback_complete_dirty_line")
    dbid <== response.dbid_or_group_id
    def coherent_response = CHICoherentResponse():
      pass_dirty: victim_state.is_dirty()
      state: mux(!victim_state.is_valid(), CHIResponseState.Invalid, mux(victim_state.is_unique(), CHIResponseState.Unique, mux(victim_state.is_dirty(), CHIResponseState.SharedDirty, CHIResponseState.SharedClean)))
    response_state <== coherent_response.as_bits()

  data.valid <== granted & !data_sent
  def packet_number = if packet_width == 2 | packet_index | packet_index.zext(2)
  data.bits <== chi_rn_copyback_data(p, node_id, home_id, dbid, chi_transfer_data_id(packet_number, p), line[packet_index], response_state)
  def final_packet = packet_index === bits(packets - 1, packet_width)
  def final_data = data.fire() & final_packet
  completion.valid <== control.active & data_sent
  completion.bits <== RV5StageLineWritebackResult(Context):
    context: context
  control.start <== command_fire
  control.finish <== completion.fire()
  control.external_progress <== data.fire()
  when command_fire:
    packet_index <== bits(0, packet_width)
    data_sent <== Bool(#false)
  elsewhen final_data:
    data_sent <== Bool(#true)
  elsewhen (data.fire()):
    packet_index <== packet_index + bits(1, packet_width)

export:
  RV5StageLineWritebackCommand
  RV5StageLineWritebackResult
  RV5StageLineWriteback
