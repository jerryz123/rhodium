#lang rhodium
// Drains one dirty RV5Stage cache line through serialized supported CHI writes.

import:
  "../cache.rhdl" open
  "foundation.rhdl" open
  "write-unique.rhdl" open
  "../../load-store.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/ready-valid.rhdl") open
  lib("chi/main.rhdl") open

bundle RV5StageLineWritebackCommand(Context :: DataType,
                                    address_width :: PosInt):
  line_address: Bits(address_width)
  line: Vec(RV5StageCacheLineBytes / 8, Bits(64))
  context: Context

bundle RV5StageLineWritebackResult(Context :: DataType):
  context: Context

sync_circuit RV5StageLineWriteback(Context :: DataType,
                                   address_width :: PosInt,
                                   config :: RV5StageCHIConfig,
                                   txn_id :: Nat):
  def p = config.flit
  def beats :: PosInt = RV5StageCacheLineBytes / 8
  def beat_width = index_width(beats)

  input node_id: Bits(p.node_id_width)
  interface command(Decoupled(RV5StageLineWritebackCommand(Context, address_width)), ~role: consumer)
  interface completion(Irrevocable(RV5StageLineWritebackResult(Context)), ~role: producer)
  interface requests(Decoupled(CHIReqFlit(p)), ~role: producer)
  interface data(Decoupled(CHIDatFlit(p)), ~role: producer)
  interface responses(Decoupled(CHIRspFlit(p)), ~role: consumer)

  inst beat_write(RV5StageWriteUnique(Context, address_width, config, txn_id))
  beat_write.node_id <== node_id
  reg active_state(~init: Bool(#false))
  reg beat_started(~init: Bool(#false))
  reg beat_index(~init: bits(0, beat_width))
  reg line_address(~init: bits(0, address_width))
  reg line(Vec(beats, Bits(64)))
  reg context(Context)

  command.ready <== !active_state
  def command_fire = command.fire()
  def beat_offset = (beat_index ++ bits(0, 3)).zext(address_width)
  beat_write.command.valid <== active_state & !beat_started
  beat_write.command.bits <== RV5StageWriteUniqueCommand(Context, address_width):
    address: line_address + beat_offset
    width: MemoryWidth.Double
    data: line[beat_index]
    mask: Mask(8)(0xff)
    context: context
  def beat_command_fire = beat_write.command.fire()
  def final_beat = beat_index === bits(beats - 1, beat_width)
  completion.valid <== beat_write.completion.valid & final_beat
  completion.bits <== RV5StageLineWritebackResult(Context):
    context: beat_write.completion.bits.context
  beat_write.completion.ready <== !final_beat ||| completion.ready
  def beat_completion_fire = beat_write.completion.fire()

  beat_write.requests |> requests
  beat_write.data |> data
  responses |> beat_write.responses

  when command_fire:
    active_state <== Bool(#true)
    beat_started <== Bool(#false)
    beat_index <== bits(0, beat_width)
    line_address <== command.bits.line_address
    line <== command.bits.line
    context <== command.bits.context
  elsewhen beat_command_fire:
    beat_started <== Bool(#true)
  elsewhen beat_completion_fire:
    active_state <== !final_beat
    beat_started <== Bool(#false)
    beat_index <== mux(final_beat,
                       beat_index,
                       beat_index + bits(1, beat_width))

export:
  RV5StageLineWritebackCommand
  RV5StageLineWritebackResult
  RV5StageLineWriteback
