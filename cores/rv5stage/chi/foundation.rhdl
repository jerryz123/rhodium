#lang rhodium
/* Defines RV5Stage CHI endpoint capabilities and exposes shared cache transaction helpers. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../../cache/chi/flits.rhdl" open
  "../../cache/chi/attachment.rhdl" open
  "../../chi-hart.rhdl" open

/* Preserves the RV5Stage constructor spelling over shared-cache endpoint descriptions. */
fun RV5StageCHIParams(config :: RiscvHartCHIConfig, instruction_node_id :: Nat, data_node_id :: Nat, ~uncached_node_id: uncached_node_id :: Nat = 0) :: CacheCHIParams:
  CacheCHIParams(config, instruction_node_id, data_node_id, ~uncached_node_id: uncached_node_id)

/* Builds the implementation-specific three-endpoint hart attachment from a shared CHI map. */
fun rv5stage_chi_params(config :: RiscvHartCHIConfig,
                        instruction_node_id :: Nat,
                        data_node_id :: Nat,
                        uncached_node_id :: Nat) :: RiscvHartCHIAttachment:
  RV5StageCHIParams(config, instruction_node_id, data_node_id,
                    ~uncached_node_id: uncached_node_id).attachment

export:
  CacheRefillResponses
  CacheWriteUniqueResponses
  CacheCopyBackResponses
  RiscvHartCHIRegion
  RiscvHartCHIConfig
  RiscvHartCHIParams
  RV5StageCHIParams
  rv5stage_chi_params
  RiscvHartCHIIdentity
  cache_chi_address
  cache_chi_address_fits
  cache_chi_snoop_address
  cache_chi_request
  cache_chi_response
  cache_snoop_shares_cache_state
  cache_snoop_invalidates_cache_state
  cache_chi_write_data
