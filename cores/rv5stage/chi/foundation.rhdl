#lang rhodium
// Defines RV5Stage-specific CHI endpoint capabilities, transaction profiles, and flit constructors.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/bits.rhdl") open
  lib("chi/protocol/params.rhdl").CHIFlitParams
  lib("chi/protocol/flits.rhdl") open
  lib("chi/protocol/protocol.rhdl").chi_line_data_id
  lib("chi/protocol/coherence.rhdl").chi_rnf_snoop_opcodes
  lib("chi/protocol/link.rhdl") open
  lib("chi/protocol/fabric.rhdl") open
  lib("chi/transactions/retryable-transaction.rhdl") open
  lib("chi/transactions/cache-maintenance.rhdl").CHICacheMaintenanceResponses
  lib("chi/protocol/messages.rhdl").chi_response
  lib("chi/protocol/messages.rhdl").chi_rn_write_data
  "../../riscv/chi-hart.rhdl" open

def RV5StageRefillResponses = response_profile("rv5stage_refill"):
  retryable

def RV5StageWriteUniqueResponses = response_profile("rv5stage_write_unique"):
  retryable
  milestone dbid
  milestone completion
  response [CHIRspOpcode.DBIDResp, CHIRspOpcode.DBIDRespOrd]:
    completes [dbid]
  response [CHIRspOpcode.Comp]:
    completes [completion]
  response [CHIRspOpcode.CompDBIDResp]:
    completes [dbid, completion]

def RV5StageCopyBackResponses = response_profile("rv5stage_copyback"):
  retryable
  milestone grant
  response [CHIRspOpcode.CompDBIDResp]:
    completes [grant]

class RV5StageCHIParams(hart :: RiscvHartCHIParams):
  property config: hart.config
  property flit: hart.flit
  property home_map: hart.home_map
  property instruction_node_id: hart.instruction_node_id
  property data_node_id: hart.data_node_id
  property uncached_node_id: hart.uncached_node_id

  property instruction_node:
    CHINodeParams(
      "rv5stage-l1i",
      instruction_node_id,
      CHINodeKind.RNI,
      ~emits: CHIChannelCapabilities(
        ~req: [CHIReqOpcode.ReadOnce, CHIReqOpcode.ReadNoSnp],
        ~rsp: [CHIRspOpcode.CompAck]
      ),
      ~supports: CHIChannelCapabilities(
        ~rsp: RV5StageRefillResponses.response_opcodes,
        ~dat: [CHIDatOpcode.CompData]
      ),
      ~max_outstanding: 2
    )

  method instruction_home_port(~coherent: coherent :: Boolean):
    CHIRequesterHomeParams(
      instruction_node.icn_peer(),
      ~emits: CHIChannelCapabilities(
        ~rsp: (if coherent | RV5StageRefillResponses.response_opcodes | []),
        ~dat: [CHIDatOpcode.CompData]),
      ~supports: CHIChannelCapabilities(
        ~req: [if coherent | CHIReqOpcode.ReadOnce | CHIReqOpcode.ReadNoSnp],
        ~rsp: (if coherent | [CHIRspOpcode.CompAck] | [])))

  property data_node:
    CHINodeParams(
      "rv5stage-l1d",
      data_node_id,
      CHINodeKind.RNF,
      ~emits: CHIChannelCapabilities(
        ~req: [CHIReqOpcode.ReadClean,
               CHIReqOpcode.ReadUnique,
               CHIReqOpcode.WriteUniquePtl,
               CHIReqOpcode.WriteBackFull,
               CHIReqOpcode.CleanShared,
               CHIReqOpcode.CleanInvalid,
               CHIReqOpcode.MakeInvalid],
        ~rsp: [CHIRspOpcode.CompAck, CHIRspOpcode.SnpResp],
        ~dat: [CHIDatOpcode.SnpRespData,
               CHIDatOpcode.CopyBackWriteData,
               CHIDatOpcode.NonCopyBackWriteData]
      ),
      ~supports: CHIChannelCapabilities(
        ~rsp: chi_response_profile_opcodes([
          RV5StageRefillResponses,
          RV5StageWriteUniqueResponses,
          CHICacheMaintenanceResponses
        ]),
        ~snp: chi_rnf_snoop_opcodes,
        ~dat: [CHIDatOpcode.CompData]
      ),
      ~max_outstanding: 2
    )

  property uncached_node:
    CHINodeParams(
      "rv5stage-uncached",
      uncached_node_id,
      CHINodeKind.RNI,
      ~emits: CHIChannelCapabilities(
        ~req: [CHIReqOpcode.ReadNoSnp, CHIReqOpcode.WriteNoSnpPtl],
        ~dat: [CHIDatOpcode.NonCopyBackWriteData]
      ),
      ~supports: CHIChannelCapabilities(
        ~rsp: [CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp],
        ~dat: [CHIDatOpcode.CompData]
      ),
      ~max_outstanding: 1
    )

  property attachment:
    RiscvHartCHIAttachment(hart, instruction_node, data_node, uncached_node,
                           instruction_home_port(~coherent: #true),
                           instruction_home_port(~coherent: #false))

  constructor (config :: RiscvHartCHIConfig,
               instruction_node_id :: Nat,
               data_node_id :: Nat,
               ~uncached_node_id: uncached_node_id :: Nat = 0):
    super(RiscvHartCHIParams(config, instruction_node_id, data_node_id,
                             ~uncached_node_id: uncached_node_id))

fun rv5stage_chi_params(config :: RiscvHartCHIConfig,
                        instruction_node_id :: Nat,
                        data_node_id :: Nat,
                        uncached_node_id :: Nat) :: RiscvHartCHIAttachment:
  RV5StageCHIParams(config, instruction_node_id, data_node_id,
                    ~uncached_node_id: uncached_node_id).attachment

fun rv5stage_chi_address(address :: Bits,
                         p :: CHIFlitParams) :~ Bits(p.request_address_width):
  def width = hardware_value_type(address).packed_width()
  cond
  | width < p.request_address_width: address.zext(p.request_address_width)
  | width == p.request_address_width: address
  | ~else: address[0..p.request_address_width]

fun rv5stage_chi_address_fits(address :: Bits,
                              p :: CHIFlitParams) :~ Bool:
  def width = hardware_value_type(address).packed_width()
  if width <= p.request_address_width
  | Bool(#true)
  | !address[p.request_address_width..width].or_reduce()

fun rv5stage_chi_snoop_address(p :: CHIFlitParams,
                               address_width :: PosInt,
                               snoop_address :: Bits(p.snoop_address_width)) :~ Bits(address_width):
  def raw_address = snoop_address ++ bits(0, 3)
  if address_width <= p.request_address_width
  | raw_address[0..address_width]
  | raw_address.zext(address_width)

fun rv5stage_chi_request(p :: CHIFlitParams,
                         node_id :: Bits(p.node_id_width),
                         home_node_id :: Bits(p.node_id_width),
                         raw_address :: Bits,
                         size :: CHITransferSize,
                         opcode :: CHIReqOpcode,
                         txn_id :: Bits(12),
                         expect_comp_ack :: Bool,
                         allocate_hint :: Bool,
                         allow_retry :: Bool,
                         protocol_credit_type :: Bits(4),
                         ~cacheable: cacheable :: Bool = Bool(#true),
                         ~device: device :: Bool = Bool(#false),
                         ~early_write_acknowledge: early_write_acknowledge :: Bool = Bool(#true)) :~ CHIReqFlit(p):
  // This requester profile leaves inactive and optional fields zero.
  def inactive :: CHIReqFlit(p) = literal(CHIReqFlit(p), 0)
  def attributes = CHIMemAttr():
    allocate: allocate_hint
    cacheable: cacheable
    device: device
    early_write_acknowledge: early_write_acknowledge
  // On WriteNoSnp the shared bit means DoDWT; these engines route DAT through
  // the Home. ReturnTxnID is inapplicable on Requester-to-Home traffic.
  inactive.updated(
    ~tag_op: CHITagOp.Invalid,
    ~exp_comp_ack: expect_comp_ack,
    ~snp_attr_or_do_dwt: !opcode.is_one_of(CHIReqOpcode.WriteNoSnpFull, CHIReqOpcode.WriteNoSnpPtl),
    ~mem_attr: attributes,
    ~pcrd_type: protocol_credit_type,
    ~order: CHIOrder.NoOrder,
    ~allow_retry: allow_retry,
    ~pas: CHIPAS.Secure,
    ~address: rv5stage_chi_address(raw_address, p),
    ~size_or_num_req: size.as_bits().zext(6),
    ~opcode: opcode,
    ~return_nid_or_stash_nid_or_data_target: node_id,
    ~txn_id: txn_id,
    ~src_id: node_id,
    ~tgt_id: home_node_id
  )

fun rv5stage_chi_response(p :: CHIFlitParams,
                          node_id :: Bits(p.node_id_width),
                          target_id :: Bits(p.node_id_width),
                          txn_id :: Bits(12),
                          opcode :: CHIRspOpcode,
                          ~resp: response :: Bits(3) = bits(0, 3))
  :~ CHIRspFlit(p):
  chi_response(p, node_id, target_id, txn_id, opcode,
               ~dbid: bits(0, 12), ~resp: response, ~error: CHIRespErr.OK, ~qos: bits(0, 4))

fun rv5stage_snoop_shares_cache_state(opcode :: CHISnpOpcode) :~ Bool:
  opcode.is_one_of(CHISnpOpcode.SnpShared,
                   CHISnpOpcode.SnpClean,
                   CHISnpOpcode.SnpNotSharedDirty,
                   CHISnpOpcode.SnpCleanShared)

// RV5Stage silently evicts its clean copy before servicing a forwarding snoop.
// Reporting I is legal and lets Home source the data elsewhere without a
// multibeat forwarded-data path in these deliberately small L1s.
fun rv5stage_snoop_invalidates_cache_state(opcode :: CHISnpOpcode) :~ Bool:
  opcode.is_one_of(CHISnpOpcode.SnpUniqueStash,
                   CHISnpOpcode.SnpMakeInvalidStash,
                   CHISnpOpcode.SnpUnique,
                   CHISnpOpcode.SnpCleanInvalid,
                   CHISnpOpcode.SnpMakeInvalid,
                   CHISnpOpcode.SnpPreferUnique,
                   CHISnpOpcode.SnpSharedFwd,
                   CHISnpOpcode.SnpCleanFwd,
                   CHISnpOpcode.SnpOnceFwd,
                   CHISnpOpcode.SnpNotSharedDirtyFwd,
                   CHISnpOpcode.SnpPreferUniqueFwd,
                   CHISnpOpcode.SnpUniqueFwd)

fun rv5stage_chi_write_data(p :: CHIFlitParams,
                            node_id :: Bits(p.node_id_width),
                            home_node_id :: Bits(p.node_id_width),
                            dbid :: Bits(12),
                            raw_address :: Bits,
                            data :: Bits(p.data_width),
                            byte_enable :: Bits(p.byte_enable_width))
  :~ CHIDatFlit(p):
  def address = rv5stage_chi_address(raw_address, p)
  chi_rn_write_data(p, node_id, home_node_id, dbid, data, byte_enable,
                    ~data_id: chi_line_data_id(address, p),
                    ~ccid: address[4..6],
                    ~dbid_or_mecid: dbid.zext(16))

export:
  RV5StageRefillResponses
  RV5StageWriteUniqueResponses
  RV5StageCopyBackResponses
  RiscvHartCHIRegion
  RiscvHartCHIConfig
  RiscvHartCHIParams
  RV5StageCHIParams
  rv5stage_chi_params
  RiscvHartCHIIdentity
  rv5stage_chi_address
  rv5stage_chi_address_fits
  rv5stage_chi_snoop_address
  rv5stage_chi_request
  rv5stage_chi_response
  rv5stage_snoop_shares_cache_state
  rv5stage_snoop_invalidates_cache_state
  rv5stage_chi_write_data
