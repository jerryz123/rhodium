#lang rhodium
/* Retains misaligned operations while authorizing and completing each virtual word in order. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../../cache/protocol.rhdl" open
  "protocol.rhdl" open
  "../../../riscv/rtl/hypervisor.rhdl" open
  "../../cache/operation.rhdl" open
  "../memory-context.rhdl" open
  "../../load-store.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

/* Waits for authorization and response before advancing to the next virtual fragment. */
hardware_enum RV5StageMisalignedState:
  Idle
  Request
  Response
  Complete

/* Executes one or two independently checked fragments without reissuing an accepted prefix.
   The upstream architectural owner remains pending until the single final outcome. */
sync_circuit RV5StageMisalignedEngine(xlen :: XLen, vector_completion_slots :: Pow2Int):
  def width = xlen.width
  def word_bytes = memory_word_bytes(xlen)
  interface start(Decoupled(PhysicalMemoryReq(xlen, RV5StageMemoryContext(vector_completion_slots))), ~role: consumer)
  interface request(Decoupled(PhysicalMemoryReq(xlen, RV5StageMemoryContext(vector_completion_slots))), ~role: producer)
  interface physical_response(Decoupled(PhysicalMemoryResp(xlen, RV5StageMemoryContext(vector_completion_slots))), ~role: consumer)
  interface completion(Valid(RV5StageSplitResult(xlen, vector_completion_slots)), ~role: producer)
  input request_fault: Bool
  input request_access_fault: Bool
  input request_guest: RiscvGuestException()
  output fault_address: Bits(width)
  output busy: Bool

  reg state(RV5StageMisalignedState, ~init: RV5StageMisalignedState.Idle)
  reg saved(PhysicalMemoryReq(xlen, RV5StageMemoryContext(vector_completion_slots)))
  reg second(~init: Bool(#false))
  reg page_fault(~init: Bool(#false))
  reg access_fault(~init: Bool(#false))
  reg guest(RiscvGuestException())
  reg first_data(Bits(width))
  reg second_data(Bits(width))
  busy <== state =/= RV5StageMisalignedState.Idle
  start.ready <== !busy
  def capture = start.fire()

  def offset = saved.address[0..alignment_bits(word_bytes)]
  def shift = offset ++ bits(0, 3)
  def remaining_bytes = bits(word_bytes, alignment_bits(word_bytes) + 1) - offset.zext(alignment_bits(word_bytes) + 1)
  def remaining_shift = remaining_bytes ++ bits(0, 3)
  def crosses_word = memory_crosses_word(xlen, saved.address, saved.width)
  def second_address = saved.address.align_down(word_bytes) + bits(word_bytes, width)
  def first_fragment = saved.updated(
    ~byte_mask: memory_byte_mask(xlen, saved.address, saved.width),
    ~address: saved.address.align_down(word_bytes),
    ~width: if xlen == XLen.X32 | MemoryWidth.Word | MemoryWidth.Double,
    ~unsigned: Bool(#true),
    ~data: saved.data << shift
  )
  def second_fragment = saved.updated(
    ~byte_mask: memory_width_mask(xlen, saved.width) >> remaining_bytes,
    ~address: second_address,
    ~width: if xlen == XLen.X32 | MemoryWidth.Word | MemoryWidth.Double,
    ~unsigned: Bool(#true),
    ~data: saved.data >> remaining_shift
  )
  request.valid <== state === RV5StageMisalignedState.Request
  request.bits <== mux(second, second_fragment, first_fragment)
  fault_address <== mux(second, second_address, saved.address)
  def rejected = request.valid & (request_fault ||| request_access_fault)
  def physical_fire = request.fire() & !rejected

  def Array(first_responses, second_responses) = physical_response |> demux_flow(2, _response => second.as_bits())
  def first_response = first_responses |> to_valid()
  def second_response = second_responses |> to_valid()
  when (first_response.valid):
    first_data <== first_response.bits.data
  when (second_response.valid):
    second_data <== second_response.bits.data
  inst load(LoadGen(xlen, word_bytes))
  load.address <== bits(0, width)
  load.width <== saved.width
  load.unsigned_load <== saved.unsigned
  load.data <== (first_data >> shift) ||| mux(crosses_word, second_data << remaining_shift, bits(0, width))
  completion.valid <== state === RV5StageMisalignedState.Complete
  completion.bits <== RV5StageSplitResult(xlen, vector_completion_slots):
    response:
      PhysicalMemoryResp(xlen, RV5StageMemoryContext(vector_completion_slots)):
        access_fault: access_fault
        data: mux(saved.access === CacheOperation.Store, bits(0, width), load.value)
        context: saved.context
    page_fault: page_fault
    fault_address: fault_address
    guest: guest
  def completion_fire = completion.valid
  describe_interface_retained_storage(capture, completion_fire, busy, ~name: "split_owner")
  describe_interface_contract(start, request, "split_owner", ~trace_model: interface_trace_retained(~name: "split_owner"))

  when capture:
    saved <== start.bits
    second <== Bool(#false)
    page_fault <== Bool(#false)
    access_fault <== Bool(#false)
    guest <== literal(RiscvGuestException(), 0)
    state <== RV5StageMisalignedState.Request
  elsewhen rejected:
    page_fault <== request_fault
    access_fault <== request_access_fault
    guest <== request_guest
    state <== RV5StageMisalignedState.Complete
  elsewhen (physical_fire):
    state <== RV5StageMisalignedState.Response
  elsewhen (first_response.valid):
    access_fault <== first_response.bits.access_fault
    state <== mux(crosses_word & !first_response.bits.access_fault, RV5StageMisalignedState.Request, RV5StageMisalignedState.Complete)
    when (crosses_word & !first_response.bits.access_fault):
      second <== Bool(#true)
  elsewhen (second_response.valid):
    access_fault <== second_response.bits.access_fault
    state <== RV5StageMisalignedState.Complete
  elsewhen (completion_fire):
    state <== RV5StageMisalignedState.Idle
  when (physical_response.valid):
    assert(state === RV5StageMisalignedState.Response, "misaligned_response_has_fragment_owner")

export:
  RV5StageMisalignedEngine
