#lang rhodium
/* Sequences preflighted misaligned data accesses into physical word fragments. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../memory.rhdl" open
  "../dcache/protocol.rhdl" open
  "../../load-store.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

/* Retains the original request and preflighted physical fragment addresses for a split access. */
bundle RV5StageMisalignedAccess(xlen :: XLen, vector_completion_slots :: Pow2Int):
  request: RV5StageDataReq(xlen, vector_completion_slots)
  first_address: Bits(xlen.width)
  second_address: Bits(xlen.width)
  second_virtual: Bits(xlen.width)
  crosses_word: Bool

/* Serializes first and optional second word fragments before returning one completion. */
hardware_enum RV5StageMisalignedState:
  Idle
  FirstRequest
  FirstResponse
  SecondRequest
  SecondResponse
  Complete

/* Executes an already preflighted load or store as one or two physical word requests.
   The caller proves translation, permissions, PMAs, and drain before admission. */
sync_circuit RV5StageMisalignedEngine(xlen :: XLen, vector_completion_slots :: Pow2Int):
  def width = xlen.width
  def word_bytes = memory_word_bytes(xlen)
  interface start(Decoupled(RV5StageMisalignedAccess(xlen, vector_completion_slots)), ~role: consumer)
  interface physical_request(Decoupled(RV5StageDataReq(xlen, vector_completion_slots)), ~role: producer)
  interface physical_response(Decoupled(RV5StageDataResp(xlen, vector_completion_slots)), ~role: consumer)
  interface lookup(Valid(Bits(width)), ~role: producer)
  interface completion(Decoupled(RV5StageDataResp(xlen, vector_completion_slots)), ~role: producer)
  input request_fault: Bool
  input request_access_fault: Bool
  output busy: Bool

  reg state(RV5StageMisalignedState, ~init: RV5StageMisalignedState.Idle)
  reg saved(RV5StageMisalignedAccess(xlen, vector_completion_slots))
  reg first_data(Bits(width))
  reg second_data(Bits(width))
  busy <== state =/= RV5StageMisalignedState.Idle
  start.ready <== !busy
  def capture = start.fire()
  when (capture):
    saved <== start.bits

  def offset = saved.request.address[0..alignment_bits(word_bytes)]
  def shift = offset ++ bits(0, 3)
  def remaining_bytes = bits(word_bytes, alignment_bits(word_bytes) + 1) - offset.zext(alignment_bits(word_bytes) + 1)
  def remaining_shift = remaining_bytes ++ bits(0, 3)
  def first_fragment = saved.request.updated(
    ~byte_mask: memory_byte_mask(xlen, saved.request.address, saved.request.width),
    ~address: saved.first_address,
    ~width: if xlen == XLen.X32 | MemoryWidth.Word | MemoryWidth.Double,
    ~unsigned: Bool(#true),
    ~data: saved.request.data << shift
  )
  def second_fragment = saved.request.updated(
    ~byte_mask: memory_width_mask(xlen, saved.request.width) >> remaining_bytes,
    ~address: saved.second_address,
    ~width: if xlen == XLen.X32 | MemoryWidth.Word | MemoryWidth.Double,
    ~unsigned: Bool(#true),
    ~data: saved.request.data >> remaining_shift
  )
  def first_request = state === RV5StageMisalignedState.FirstRequest
  def second_request = state === RV5StageMisalignedState.SecondRequest
  physical_request.valid <== first_request ||| second_request
  physical_request.bits <== mux(first_request, first_fragment, second_fragment)
  lookup.valid <== physical_request.valid
  lookup.bits <== mux(first_request, saved.request.address.align_down(word_bytes), saved.second_virtual)
  def physical_fire = physical_request.fire()
  when (physical_fire):
    assert(!request_fault & !request_access_fault, "preflighted_misaligned_fragment_is_permitted")

  def Array(first_responses, second_responses) = physical_response |> demux_flow(2, _response => (state === RV5StageMisalignedState.SecondResponse).as_bits())
  def first_response = first_responses |> to_valid()
  def second_response = second_responses |> to_valid()
  when (first_response.valid):
    first_data <== first_response.bits.data
  when (second_response.valid):
    second_data <== second_response.bits.data
  inst load(LoadGen(xlen, word_bytes))
  load.address <== bits(0, width)
  load.width <== saved.request.width
  load.unsigned_load <== saved.request.unsigned
  load.data <== (first_data >> shift) ||| mux(saved.crosses_word, second_data << remaining_shift, bits(0, width))
  completion.valid <== state === RV5StageMisalignedState.Complete
  completion.bits <== RV5StageDataResp(xlen, vector_completion_slots):
    access_fault: Bool(#false)
    data: mux(saved.request.access === RV5StageMemoryOperation.Store, bits(0, width), load.value)
    writeback: saved.request.writeback
    origin: saved.request.origin
  def completion_fire = completion.fire()
  describe_interface_retained_storage(capture, completion_fire, busy, ~name: "split_owner")
  describe_interface_contract(start, physical_request, "split_owner", ~trace_model: interface_trace_retained(~name: "split_owner"))

  when (capture):
    state <== RV5StageMisalignedState.FirstRequest
  elsewhen (physical_fire):
    state <== mux(first_request, RV5StageMisalignedState.FirstResponse, RV5StageMisalignedState.SecondResponse)
  elsewhen (first_response.valid):
    state <== mux(saved.crosses_word, RV5StageMisalignedState.SecondRequest, RV5StageMisalignedState.Complete)
  elsewhen (second_response.valid):
    state <== RV5StageMisalignedState.Complete
  elsewhen (completion_fire):
    state <== RV5StageMisalignedState.Idle
  when (physical_response.valid):
    assert(state.is_one_of(RV5StageMisalignedState.FirstResponse, RV5StageMisalignedState.SecondResponse), "misaligned_response_has_fragment_owner")
    assert(!physical_response.bits.access_fault, "preflighted_misaligned_fragment_has_no_late_fault")

export:
  RV5StageMisalignedAccess
  RV5StageMisalignedEngine
