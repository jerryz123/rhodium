#lang rhodium
/* Resolves registered fetch/load attempts and issues separate core and page-table physical
   requests. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../../cache-prefetch.rhdl" open
  "../fp/types.rhdl" open
  "../profile.rhm".RV5StageMmuMode
  "protocol.rhdl" open
  "translation.rhdl" open
  "../../../riscv/rtl/hypervisor.rhdl" open
  "misaligned-access.rhdl" open
  "tlb.rhdl" open
  "walker.rhdl" open
  "vector-window.rhdl" open
  "../csr.rhdl" open
  "../memory.rhdl" open
  "../icache/protocol.rhdl" open
  "../uncached-protocol.rhdl" open
  "../dcache/protocol.rhdl" open
  "../../load-store.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/isa/csr.rhm" open
  "../../../riscv/isa/sv39.rhm".Sv39Mode
  "../../../riscv/rtl/csr.rhdl" open
  "../../../riscv/rtl/pma.rhdl" open
  "../../../riscv/rtl/sv39.rhdl" open
  "../../../riscv/rtl/svpbmt.rhdl" open
  "../../../riscv/rtl/privilege.rhdl".effective_data_privilege
  "../../../riscv/rtl/atomic.rhdl" open
  "../../../riscv/rtl/zihintntl.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

/* Owns ITLB/DTLB lookup, shared walking, precise translation faults, and physical dispatch.
   Speculative MEM accesses replay on contention; authorized requests and vector checks
   retain their own translations, and misaligned accesses preflight both fragments. */
sync_circuit RV5StageMmu(xlen :: XLen,
                         mmu_mode :: RV5StageMmuMode,
                         physical_map :: RiscvPhysicalMemoryMap,
                         tlb_entries :: Pow2Int = 8,
                         ~svnapot: svnapot :: Boolean = #false,
                         ~hypervisor: hypervisor :: Boolean = #false,
                         ~vector_completion_slots: vector_completion_slots :: Pow2Int = 8):
  def width = xlen.width
  interface instruction(RV5StageFetchAccess(xlen, hypervisor), ~role: responder)
  interface data(if hypervisor | RV5StageGuestDataAccess(xlen, vector_completion_slots) | RV5StageDataAccess(xlen, vector_completion_slots), ~role: responder)
  output request_fault_address: Bits(width)
  interface pipeline(if hypervisor | RV5StageGuestPipelineAccess(xlen) | RV5StagePipelineAccess(xlen), ~role: responder)
  input pipeline_vector: Bool
  interface vector_precheck(RV5StageVectorPrecheck(), ~role: responder)
  interface vector_fast(RV5StageVectorFastCheck(xlen), ~role: responder)
  interface pipeline_memory(RV5StagePipelineAccess(xlen), ~role: requester)
  interface pipeline_lookup(Valid(RV5StagePipelineReq(xlen)), ~role: producer)
  interface instruction_memory(RV5StageInstructionLookup(RV5StagePhysicalInstructionReq(xlen)), ~role: requester)
  interface core_memory(RV5StagePhysicalDataAccess(xlen, vector_completion_slots), ~role: requester)
  interface walker_memory(RV5StagePhysicalDataAccess(xlen, vector_completion_slots), ~role: requester)
  interface instruction_lookup(Decoupled(Bits(width)), ~role: producer)
  interface core_lookup(Valid(Bits(width)), ~role: producer)
  interface walker_lookup(Valid(Bits(width)), ~role: producer)
  interface prefetch(Valid(CachePrefetchReq(width)), ~role: consumer)
  interface physical_prefetch(Valid(CachePrefetchReq(width)), ~role: producer)
  input privilege: PrivilegeMode
  input mstatus: Bits(width)
  input satp: Bits(width)
  input pbmte: Bool
  input invalidate_all: Bool
  input ordered_busy: Bool
  interface instruction_replay_owner(Valid(Bits(width)), ~role: consumer)

  unless (!hypervisor) || (xlen == XLen.X64 && mmu_mode == RV5StageMmuMode.Sv39)
  | error(~who: #'RV5StageMmu, "guest translation requires the RV64 Sv39 MMU")
  def guest_state :: RiscvHypervisorTranslation():
    if hypervisor
    | block:
        input guest_translation: RiscvHypervisorTranslation()
        guest_translation
    | literal(RiscvHypervisorTranslation(), 0)
  inst itlb(RV5StageTranslationTlb(tlb_entries))
  inst dtlb(RV5StageTranslationTlb(tlb_entries))
  inst walker(RV5StageTranslationWalker(~svnapot: svnapot))
  def itlb_result = rv5stage_host_result(itlb.translation)
  // A detached fetch must not trap, but a completed page fault is reusable
  // translation evidence until architectural invalidation. Keep its exact
  // guest-fault metadata separate from successful ITLB mappings and probes.
  reg instruction_fault_cached(~init: Bool(#false))
  reg instruction_fault_lookup(RV5StageTlbLookup())
  reg instruction_fault_mapping(RV5StageTlbMapping())
  def dtlb_result = rv5stage_host_result(dtlb.translation)
  inst vector_window(RV5StageVectorWindow(physical_map))
  inst misaligned(RV5StageMisalignedEngine(xlen, vector_completion_slots))
  vector_precheck |> vector_window.check
  def page_probe = vector_window.translation
  inst instruction_s1(ValidPipeAlwaysCapture(RV5StageInstructionReq(xlen), 1, ~flushable: #true))
  inst instruction_s2(ValidPipeAlwaysCapture(RV5StageFetchResult(hypervisor), 1), ~reset_when: instruction.flush)
  inst load_request(ValidPipeAlwaysCapture(RV5StagePipelineReq(xlen), 1))
  def pipeline_requests = pipeline.request |> map_valid(request => if hypervisor | request.memory | request)
  def Array(load_context, virtual_lookup, owner_context) = pipeline_requests |> fork_valid(3)
  load_context |> load_request.ingress
  virtual_lookup |> pipeline_lookup
  def pipeline_owner = owner_context |> map_valid(_request => pipeline_vector) |> valid_pipe(1)
  def physical_owner = pipeline.request |> map_valid(_request => pipeline_vector & vector_fast.pipeline_physical) |> valid_pipe(1)
  def load_mode = pipeline.request |> map_valid(request => if hypervisor | request.translation | RiscvGuestMemoryAccess.Normal) |> valid_pipe(1)
  def request_mode = if hypervisor | data.request.bits.translation | RiscvGuestMemoryAccess.Normal
  def demand_mode = mux(data.request.valid, request_mode, mux(!page_probe.request.valid & load_request.egress.valid, load_mode.bits, RiscvGuestMemoryAccess.Normal))
  def explicit_guest = demand_mode =/= RiscvGuestMemoryAccess.Normal
  def execute_read = demand_mode === RiscvGuestMemoryAccess.GuestExecuteRead

  def satp_sv39 = if mmu_mode == RV5StageMmuMode.Bare || xlen == XLen.X32 | Bool(#false) | csr_field(satp, Satp64Mode) === bits(Sv39Mode, Satp64Mode.width)
  def root_ppn = if xlen == XLen.X32 | bits(0, Satp64PPN.width) | csr_field(satp, Satp64PPN)
  def supervisor_or_user = privilege =/= PrivilegeMode.Machine
  def instruction_guest = guest_state.virtualized
  def instruction_translation_enabled = (satp_sv39 & supervisor_or_user) ||| instruction_guest
  def normal_data_privilege = effective_data_privilege(xlen, privilege, mstatus)
  def normal_data_guest = if !hypervisor | Bool(#false) | mux((privilege === PrivilegeMode.Machine) & csr_flag(mstatus, MstatusMPRV), csr_flag(mstatus, MstatusMPV) & (normal_data_privilege =/= PrivilegeMode.Machine), guest_state.virtualized)
  def data_privilege = mux(explicit_guest, mux(csr_flag(guest_state.hstatus, HstatusSPVP), PrivilegeMode.Supervisor, PrivilegeMode.User), normal_data_privilege)
  def data_guest = explicit_guest ||| normal_data_guest
  def data_translation_enabled = (satp_sv39 & (data_privilege =/= PrivilegeMode.Machine)) ||| data_guest
  def sum = if xlen == XLen.X32 | Bool(#false) | csr_flag(mstatus, MstatusSUM)
  def mxr = if xlen == XLen.X32 | Bool(#false) | csr_flag(mstatus, MstatusMXR)
  /* Captures host or guest translation roots, privilege, permission controls, and PBMT enables. */
  fun lookup(address :: Bits(64), access :: Sv39Access, effective_privilege :: PrivilegeMode, enabled :: Bool, guest :: Bool) :~ RV5StageTlbLookup():
    def stages = RiscvGuestTranslationContext():
      vs_mode: mux(mux(guest, csr_field(guest_state.vsatp, Satp64Mode) === bits(Sv39Mode, 4), enabled), RiscvVSMode.Sv39, RiscvVSMode.Bare)
      g_mode: mux(guest & (csr_field(guest_state.hgatp, Hgatp64Mode) === bits(Sv39Mode, 4)), RiscvGMode.Sv39x4, RiscvGMode.Bare)
      vs_root_ppn: mux(guest, csr_field(guest_state.vsatp, Satp64PPN), root_ppn)
      g_root_ppn: csr_field(guest_state.hgatp, Hgatp64PPN)
      privilege: effective_privilege
      vs_sum: mux(guest, csr_flag(guest_state.vsstatus, MstatusSUM), sum)
      vs_mxr: mux(guest, csr_flag(guest_state.vsstatus, MstatusMXR), mxr)
      hs_mxr: guest & mxr
      vs_pbmte: mux(guest, guest_state.vs_pbmte, pbmte)
      g_pbmte: guest & pbmte
    RV5StageTlbLookup():
      virtualized: guest
      execute_read: Bool(#false)
      virtual_address: address
      access: access
      context: stages
  reg vector_invalidation_epoch(~init: bits(0, 2))
  when invalidate_all:
    vector_invalidation_epoch <== vector_invalidation_epoch + bits(1, 2)
  // WB validates the MEM snapshot independently of the fallback page window.
  // Certified vector requests carry their own physical address thereafter.
  def vector_context = lookup(bits(0, 64), Sv39Access.Load, normal_data_privilege, satp_sv39 & (normal_data_privilege =/= PrivilegeMode.Machine) & !normal_data_guest, normal_data_guest)
  vector_fast.candidate_current <== (vector_fast.candidate.invalidation_epoch === vector_invalidation_epoch) & (vector_fast.candidate.virtualized === vector_context.virtualized) & (vector_fast.candidate.context.as_bits() === vector_context.context.as_bits())
  def instruction_head = instruction_s1.egress
  def instruction_address = instruction_head.bits.address
  def instruction_virtual_address = if xlen == XLen.X32 | instruction_address.zext(64) | instruction_address
  // One accepted S0 request atomically launches the virtual lookup and
  // captures the MMU's S1 context. The frontend retains its own occurrence.
  def Array(instruction_lookup_request, instruction_admission) = instruction.request |> atomic_fork(2)
  instruction_lookup_request |> map_flow(request => request.address) |> instruction_lookup
  instruction_admission |> to_valid() |> instruction_s1.ingress
  // A request transferred with flush starts the new fetch epoch and replaces
  // the old S1 context; a flush without a transfer clears S1 normally.
  instruction_s1.flush <== instruction.flush & !instruction_admission.valid
  def instruction_s1_valid = instruction_head.valid & !instruction.flush & !instruction.s1_kill
  def data_requests = data.request |> map_flow(request => if hypervisor | request.memory | request)
  def data_request :: RV5StageDataReq(xlen, vector_completion_slots) = data_requests.bits
  def data_memory_operation = data_request.access
  def data_virtual_address = if xlen == XLen.X32 | data_request.address.zext(64) | data_request.address
  def split_busy = misaligned.busy
  def split_candidate = data.request.valid & !split_busy & data_memory_operation.is_one_of(RV5StageMemoryOperation.Load, RV5StageMemoryOperation.Store) & !data_request.width.is_aligned(data_request.address)
  def split_crosses_word = memory_crosses_word(xlen, data_request.address, data_request.width)
  def split_second_virtual = data_request.address.align_down(memory_word_bytes(xlen)) + bits(memory_word_bytes(xlen), width)
  def split_second_virtual_64 = if xlen == XLen.X32 | split_second_virtual.zext(64) | split_second_virtual
  def split_second_page = split_crosses_word & (data_request.address[12..width] =/= split_second_virtual[12..width])
  def data_vector = data_request.writeback.is(RV5StageMemoryWriteback(vector_completion_slots).Vector).into(Bool)
  def data_physical = data_vector & vector_fast.request_physical
  def data_window = vector_window.owned & data_vector & !data_physical & !split_candidate
  def data_pinned = data_window ||| data_physical
  def data_access_kind = mux(data_memory_operation.is_cache_management(), Sv39Access.CacheManagement, mux(data_memory_operation.needs_unique(), Sv39Access.Store, Sv39Access.Load))

  itlb.lookup <== lookup(instruction_virtual_address, Sv39Access.Fetch, privilege, instruction_translation_enabled & !instruction_guest, instruction_guest)
  itlb.invalidate_all <== invalidate_all
  // Authorized WB requests own the DTLB on contention. Younger MEM loads then
  // fall back instead of observing a translation belonging to another token.
  def load_virtual_address = if xlen == XLen.X32 | load_request.egress.bits.address.zext(64) | load_request.egress.bits.address
  vector_window.addresses <== vec([data_virtual_address, load_virtual_address])
  def load_window = vector_window.owned & pipeline_owner.bits & !physical_owner.bits
  def load_pinned = load_window ||| physical_owner.bits
  def probe_selected = page_probe.request.valid & !data.request.valid
  def fast_selected = vector_fast.request.valid & !data.request.valid & !page_probe.request.valid & !load_request.egress.valid
  def demand_address = mux(data.request.valid, data_virtual_address, mux(probe_selected, page_probe.request.bits.address, mux(load_request.egress.valid, load_virtual_address, vector_fast.request.bits.first)))
  def pipeline_is_store = load_request.egress.bits.access === RV5StageMemoryOperation.Store
  def demand_access = mux(data.request.valid, data_access_kind, mux(mux(probe_selected, page_probe.request.bits.store, mux(load_request.egress.valid, pipeline_is_store, vector_fast.request.bits.store)), Sv39Access.Store, Sv39Access.Load))
  dtlb.lookup <== lookup(demand_address, demand_access, data_privilege, data_translation_enabled & !data_guest, data_guest).updated(~execute_read: execute_read)
  dtlb.invalidate_all <== invalidate_all
  def vector_fast_page = (dtlb_result.physical_address[12..56] ++ bits(0, 12)).zext(64)
  vector_fast.response.valid <== fast_selected & !invalidate_all & dtlb.hit & !dtlb_result.fault & !dtlb_result.access_fault & (dtlb_result.pbmt === PageMemoryType.PMA) & vector_page_permitted(physical_map, vector_fast_page, vector_fast.request.bits.store)
  vector_fast.response.bits <== RV5StageVectorFastCertificate(xlen):
    range: vector_fast.request.bits
    ppn: dtlb_result.physical_address[12..56]
    virtualized: vector_context.virtualized
    context: vector_context.context
    invalidation_epoch: vector_invalidation_epoch
  when (vector_fast.request.valid):
    assert(vector_fast.request.bits.first[12..64] === vector_fast.request.bits.last[12..64], "vector_fast_range_is_one_page")

  reg prefetch_previous_privilege(PrivilegeMode, ~init: PrivilegeMode.Machine)
  reg prefetch_previous_satp(~init: bits(0, width))
  reg prefetch_previous_sum(~init: Bool(#false))
  reg prefetch_previous_mxr(~init: Bool(#false))
  prefetch_previous_privilege <== normal_data_privilege
  prefetch_previous_satp <== satp
  prefetch_previous_sum <== sum
  prefetch_previous_mxr <== mxr
  def prefetch_context_changed = (prefetch_previous_privilege =/= normal_data_privilege) ||| (prefetch_previous_satp =/= satp) ||| (prefetch_previous_sum =/= sum) ||| (prefetch_previous_mxr =/= mxr)
  def prefetch_flush = instruction.flush ||| invalidate_all ||| prefetch_context_changed
  inst virtual_prefetch_pipe(ValidPipeAlwaysCapture(CachePrefetchReq(width), 1, ~flushable: #true))
  inst physical_prefetch_pipe(ValidPipeAlwaysCapture(CachePrefetchReq(width), 1, ~flushable: #true))
  virtual_prefetch_pipe.flush <== prefetch_flush
  physical_prefetch_pipe.flush <== prefetch_flush
  prefetch |> virtual_prefetch_pipe.ingress

  def prefetch_request = virtual_prefetch_pipe.egress.bits.into(CachePrefetchReq(width))
  def prefetch_virtual_address = if xlen == XLen.X32 | prefetch_request.address.zext(64) | prefetch_request.address
  def normal_data_translation_enabled = (satp_sv39 & (normal_data_privilege =/= PrivilegeMode.Machine)) ||| normal_data_guest
  def probe = lookup(prefetch_virtual_address, Sv39Access.Load, normal_data_privilege, normal_data_translation_enabled & !normal_data_guest, normal_data_guest)
  itlb.probe <== probe
  def split_probe = lookup(split_second_virtual_64, data_access_kind, data_privilege, data_translation_enabled & !data_guest, data_guest).updated(~execute_read: execute_read)
  dtlb.probe <== mux(split_candidate, split_probe, probe)
  def split_probe_result = rv5stage_host_result(dtlb.probe_translation)

  def instruction_prefetch = prefetch_request.operation === CachePrefetchOperation.Instruction
  def prefetch_translation_hit = !split_candidate & mux(instruction_prefetch, itlb.probe_hit, dtlb.probe_hit)
  def prefetch_translation_fault = mux(instruction_prefetch, itlb.probe_fault, dtlb.probe_fault)
  def prefetch_translated_address = if xlen == XLen.X32 | prefetch_request.address | mux(
    normal_data_translation_enabled,
    mux(instruction_prefetch, itlb.probe_physical_address, dtlb.probe_physical_address).zext(64),
    prefetch_request.address
  )
  def prefetch_line_address = prefetch_translated_address.align_down(64)
  def prefetch_physical = physical_map.lookup(prefetch_line_address, prefetch_line_address +& bits(63, width))
  def prefetch_attributes = resolve_memory_attributes(prefetch_physical, mux(instruction_prefetch, itlb.probe_pbmt, dtlb.probe_pbmt))
  def prefetch_access_permitted = mux_lookup(
    prefetch_request.operation,
    ~default: Bool(#false),
    [
      [CachePrefetchOperation.Instruction, prefetch_physical.executable],
      [CachePrefetchOperation.Read, prefetch_physical.readable],
      [CachePrefetchOperation.Write, prefetch_physical.writable]
    ]
  )
  virtual_prefetch_pipe.egress
    |> filter_valid(_request => prefetch_request.operation.is_prefetch() & prefetch_translation_hit & !prefetch_translation_fault & mux(instruction_prefetch, prefetch_attributes.instruction_cacheable, prefetch_attributes.cacheable) & prefetch_access_permitted)
    |> map_valid(request => request.updated(~address: prefetch_line_address))
    |> physical_prefetch_pipe.ingress
  // Cancel at the clock edge without reconnecting demand squash to cache admission.
  physical_prefetch_pipe.egress |> physical_prefetch

  reg walk_active(~init: Bool(#false))
  reg walk_is_data(~init: Bool(#false))
  reg walk_is_probe(~init: Bool(#false))
  reg walk_instruction_discarded(~init: Bool(#false))
  reg fault_valid(~init: Bool(#false))
  reg fault_is_data(~init: Bool(#false))
  reg fault_is_access(~init: Bool(#false))
  reg fault_address(Bits(64))
  reg fault_mapping(RV5StageTlbMapping())
  reg walker_memory_pending(~init: Bool(#false))

  def load_address = if xlen == XLen.X32 | load_request.egress.bits.address | mux(physical_owner.bits, load_request.egress.bits.address, mux(load_window, vector_window.physical_addresses[1], mux(data_translation_enabled, dtlb.translation.physical_address.zext(64), load_request.egress.bits.address)))
  def load_last_offset = mux_lookup(load_request.egress.bits.width, ~default: bits(7, width), [[MemoryWidth.Byte, bits(0, width)], [MemoryWidth.Half, bits(1, width)], [MemoryWidth.Word, bits(3, width)]])
  def load_physical = physical_map.lookup(load_address, load_address +& load_last_offset)
  def load_attributes = resolve_memory_attributes(load_physical, mux(load_pinned, PageMemoryType.PMA, dtlb_result.pbmt))
  // Translation contention and ordered IO replay without entering miss service.
  // Pending committed cache stores do not make this translation port busy.
  def pipeline_blocked = data.request.valid ||| invalidate_all ||| ordered_busy ||| (probe_selected & !load_pinned)
  def load_translation_hit = load_pinned ||| dtlb.hit
  def load_translation_fault = !load_pinned & dtlb_result.fault
  def load_translation_access_fault = !load_pinned & dtlb_result.access_fault
  def pipeline_permitted = load_physical.mapped & mux(pipeline_is_store, load_physical.writable, load_physical.readable) & (!execute_read ||| load_physical.executable)
  def pipeline_cacheable = load_attributes.cacheable & !load_attributes.strongly_ordered & (pipeline_is_store ||| load_attributes.read_idempotent)
  def pipeline_misaligned = !load_request.egress.bits.width.is_aligned(load_request.egress.bits.address)
  def Array(physical_request, local_result) = load_request.egress |> fork_valid(2)
  def cache_eligible = !pipeline_blocked & load_translation_hit & !load_translation_fault & !load_translation_access_fault & pipeline_permitted & pipeline_cacheable & !pipeline_misaligned
  physical_request |> filter_valid(_request => cache_eligible)
    |> map_valid(request => request.updated(~address: load_address)) |> pipeline_memory.request
  // WB owns squash and serialization. Rechecking its derived flush here would
  // feed fence/trap drain back into the very store authorization being drained.
  pipeline_memory.commit <== pipeline.commit
  pipeline.commit_ready <== pipeline_memory.commit_ready
  wire pipeline_outcome: RV5StagePipelineOutcome
  when pipeline_blocked:
    pipeline_outcome <== RV5StagePipelineOutcome.Replay
  elsewhen (!load_translation_hit):
    pipeline_outcome <== RV5StagePipelineOutcome.Slow
  elsewhen load_translation_fault:
    pipeline_outcome <== RV5StagePipelineOutcome.PageFault
  elsewhen load_translation_access_fault:
    pipeline_outcome <== RV5StagePipelineOutcome.AccessFault
  elsewhen pipeline_misaligned:
    pipeline_outcome <== RV5StagePipelineOutcome.Slow
  elsewhen (!pipeline_permitted):
    pipeline_outcome <== RV5StagePipelineOutcome.AccessFault
  elsewhen (!pipeline_cacheable):
    pipeline_outcome <== RV5StagePipelineOutcome.Slow
  elsewhen (pipeline_memory.response.valid):
    pipeline_outcome <== pipeline_memory.response.bits.outcome
  otherwise:
    pipeline_outcome <== RV5StagePipelineOutcome.Replay
  def pipeline_result = RV5StagePipelineResult(xlen):
    outcome: pipeline_outcome
    reason: mux(pipeline_blocked, mux(ordered_busy, RV5StagePipelineReason.Ordered, RV5StagePipelineReason.Translation), mux(!load_translation_hit, RV5StagePipelineReason.Translation, mux(!pipeline_cacheable, RV5StagePipelineReason.Ordered, pipeline_memory.response.bits.reason)))
    data: pipeline_memory.response.bits.data
  def use_cache_result = cache_eligible & pipeline_memory.response.valid
  def cache_result = pipeline_memory.response |> filter_valid(_response => cache_eligible & load_request.egress.valid)
    |> map_valid(_response => pipeline_result)
  def translation_result = local_result |> filter_valid(_request => !use_cache_result)
    |> map_valid(_request => pipeline_result)
  Array(cache_result, translation_result) |> valid_arbiter() |> pipeline.response
  def can_start_walk = !walk_active & !fault_valid
  def instruction_fault_cache_hit = instruction_fault_cached & (instruction_fault_lookup.as_bits() === itlb.lookup.as_bits())
  // A replaying older instruction may need its own fetch (including a
  // straddling word), but speculative successors must not repeatedly occupy
  // the shared walker before that instruction resolves.
  def replay_first_word = instruction_replay_owner.bits.align_down(4)
  def replay_last_word = (instruction_replay_owner.bits + bits(3, width)).align_down(4)
  def replay_owner_fetch = (instruction_address === replay_first_word) ||| (instruction_address === replay_last_word)
  def instruction_walk_allowed = !instruction_replay_owner.valid ||| replay_owner_fetch
  def instruction_miss = instruction_s1_valid & instruction_translation_enabled & !itlb.hit & !instruction_fault_cache_hit
  def data_miss = data.request.valid & !data_pinned & data_translation_enabled & !dtlb.hit
  def split_second_miss = split_candidate & split_second_page & data_translation_enabled & !data_physical & dtlb.hit & !dtlb_result.fault & !dtlb_result.access_fault & !dtlb.probe_raw_hit
  def start_probe_walk = can_start_walk & !invalidate_all & probe_selected & !dtlb.hit
  def start_instruction_walk = can_start_walk & !start_probe_walk & instruction_miss & instruction_walk_allowed
  def start_data_walk = can_start_walk & !start_probe_walk & !start_instruction_walk & data_miss
  def start_split_walk = can_start_walk & !start_probe_walk & !start_instruction_walk & !start_data_walk & split_second_miss
  walker.request.valid <== start_instruction_walk ||| start_data_walk ||| start_split_walk ||| start_probe_walk
  walker.request.bits <== mux(start_split_walk, split_probe, mux(start_data_walk ||| start_probe_walk, dtlb.lookup, itlb.lookup))
  reg walk_lookup(RV5StageTlbLookup())
  when (walker.request.fire()):
    walk_lookup <== walker.request.bits
  def walker_request_fire = walker.request.fire()
  page_probe.request.ready <== probe_selected & !invalidate_all & (dtlb.hit ||| (start_probe_walk & walker.request.ready))
  def probe_hit_result = inject_interface(Valid(RV5StageTranslationResult()), ~valid: page_probe.request.fire() & dtlb.hit, ~bits: dtlb_result)
  // Fetch recovery discards the consumer, not an accepted translation. Let
  // the walk warm the ITLB and retain ownership of every accepted PTE reply.
  def discard_instruction_walk = instruction.flush & walk_active & !walk_is_data & !walk_is_probe
  // Invalidate TLB/fault ownership at this edge, then notify the walker.
  // A PTE accepted on the invalidation edge remains owned and must drain.
  // This keeps WB's flush decision out of the physical arbiter's ready path.
  reg walker_cancel(~init: Bool(#false))
  walker_cancel <== invalidate_all
  walker.cancel <== walker_cancel

  def walker_completed = walker.completion |> gate_flow(!fault_valid) |> to_valid()
  def walker_completion_fire = walker_completed.valid
  def probe_walk_result = walker_completed |> filter_valid(_result => walk_is_probe) |> map_valid(result => rv5stage_host_result(result))
  Array(probe_hit_result, probe_walk_result) |> valid_arbiter() |> page_probe.response
  def walker_fault_completion = walker_completion_fire & (walker.completion.bits.fault =/= RV5StageTranslationFault.None)
  def fills = walker_completed |> map_valid(result => RV5StageTlbFill()):
    request: walk_lookup
    result: result
  def Array(instruction_fill, data_fill) = fills |> fork_valid(2)
  instruction_fill |> filter_valid(_completion => !walk_is_data & !walk_is_probe) |> itlb.fill
  data_fill |> filter_valid(_completion => walk_is_data ||| walk_is_probe) |> dtlb.fill
  def cache_instruction_page_fault = walker_fault_completion & !walk_is_data & !walk_is_probe & !invalidate_all & walker.completion.bits.fault.is_one_of(RV5StageTranslationFault.PageFault, RV5StageTranslationFault.GuestPageFault)
  when invalidate_all:
    instruction_fault_cached <== Bool(#false)
  elsewhen cache_instruction_page_fault:
    instruction_fault_cached <== Bool(#true)
    instruction_fault_lookup <== walk_lookup
    instruction_fault_mapping <== walker.completion.bits

  def latched_instruction_fault = fault_valid & !fault_is_data & (fault_address === instruction_virtual_address)
  def latched_data_fault = fault_valid & fault_is_data & (fault_address === data_virtual_address)
  def latched_split_fault = fault_valid & fault_is_data & split_candidate & (fault_address === split_second_virtual_64)
  def split_probe_page_fault = split_candidate & split_second_page & !data_physical & dtlb.probe_raw_hit & split_probe_result.fault
  def split_probe_access_fault = split_candidate & split_second_page & !data_physical & dtlb.probe_raw_hit & split_probe_result.access_fault
  def instruction_page_fault = instruction_translation_enabled & (
    (itlb.hit & itlb_result.fault) ||| instruction_fault_cache_hit ||| (latched_instruction_fault & !fault_is_access)
  )
  def data_page_fault = !data_pinned & data_translation_enabled & (
    (dtlb.hit & dtlb_result.fault) ||| (latched_data_fault & !fault_is_access) ||| split_probe_page_fault ||| (latched_split_fault & !fault_is_access)
  )
  def instruction_walk_access_fault = (latched_instruction_fault & fault_is_access) ||| (itlb.hit & itlb_result.access_fault)
  def data_walk_access_fault = !data_pinned & ((latched_data_fault & fault_is_access) ||| (dtlb.hit & dtlb_result.access_fault) ||| split_probe_access_fault ||| (latched_split_fault & fault_is_access))
  // Select the same fragment for trap VA and guest provenance. Page faults
  // retain priority over access faults; within a class the first fragment wins.
  def first_page_fault = (dtlb.hit & dtlb_result.fault) ||| (latched_data_fault & !fault_is_access)
  def first_access_fault = (dtlb.hit & dtlb_result.access_fault) ||| (latched_data_fault & fault_is_access)
  def second_translation_fault = !data_pinned & !first_page_fault & ((data_page_fault & (split_probe_page_fault ||| (latched_split_fault & !fault_is_access))) ||| (!data_page_fault & !first_access_fault & data_walk_access_fault))
  def request_fault_mapping = mux(second_translation_fault,
                                  mux(latched_split_fault, fault_mapping, dtlb.probe_translation),
                                  mux(latched_data_fault, fault_mapping, dtlb.translation))
  /* Projects a selected fragment's mapping fault into guest trap metadata. */
  fun guest_exception(mapping :: RV5StageTlbMapping(), guest :: Bool) :~ RiscvGuestException():
    RiscvGuestException():
      page_fault: mapping.fault === RV5StageTranslationFault.GuestPageFault
      details: mapping.fault_details.updated(~guest_virtual_address: guest)
  def instruction_guest_exception = guest_exception(mux(instruction_fault_cache_hit, instruction_fault_mapping, mux(latched_instruction_fault, fault_mapping, itlb.translation)), instruction_guest)
  if hypervisor
  | block:
      output request_guest_fault: RiscvGuestException()
      output pipeline_guest_fault: RiscvGuestException()
      request_guest_fault <== guest_exception(request_fault_mapping, normal_data_guest ||| (request_mode =/= RiscvGuestMemoryAccess.Normal))
      pipeline_guest_fault <== guest_exception(dtlb.translation, normal_data_guest ||| (load_mode.bits =/= RiscvGuestMemoryAccess.Normal))
  | #void
  def instruction_lookup_ready = !instruction_translation_enabled ||| itlb.hit ||| instruction_fault_cache_hit ||| latched_instruction_fault
  def instruction_physical_address = if xlen == XLen.X32 | instruction_address | mux(
    instruction_translation_enabled,
    itlb.translation.physical_address.zext(64),
    instruction_address
  )
  def instruction_physical = physical_map.lookup(
    instruction_physical_address,
    instruction_physical_address +& bits(3, width)
  )
  def instruction_has_physical_address = !instruction_translation_enabled ||| itlb.hit
  def instruction_attributes = resolve_memory_attributes(instruction_physical, itlb_result.pbmt)
  def instruction_access_fault = instruction_walk_access_fault ||| (
    instruction_has_physical_address & !instruction_page_fault & !instruction_physical.executable
  )
  def instruction_local_fault = instruction_page_fault ||| instruction_access_fault

  // Local S1 translation/PMA decisions are registered beside physical lookup.
  // An ITLB miss starts at most one walk; the frontend regenerates the attempt.
  def Array(instruction_physical_path, instruction_result_path) = instruction_head
    |> filter_valid(_request => !instruction.flush & !instruction.s1_kill) |> fork_valid(2)
  (instruction_physical_path |> filter_valid(_request => instruction_lookup_ready & !instruction_local_fault)
    |> map_valid(_request => RV5StagePhysicalInstructionReq(xlen)):
         address: instruction_physical_address
         cacheable: instruction_attributes.instruction_cacheable
         device: instruction_attributes.strongly_ordered
  ) |> instruction_memory.request
  instruction_memory.flush <== instruction.flush
  instruction_memory.invalidate_all <== instruction.invalidate_all
  instruction_memory.s1_kill <== instruction.s1_kill
  wire local_response: RV5StageInstructionResp(hypervisor)
  local_response.word <== bits(0, 32)
  local_response.page_fault <== instruction_page_fault
  local_response.access_fault <== instruction_access_fault
  if hypervisor
  | local_response.guest <== instruction_guest_exception
  | #void
  (instruction_result_path |> map_valid(_request => RV5StageFetchResult(hypervisor)):
    response: local_response
    replay: !instruction_lookup_ready
  ) |> instruction_s2.ingress
  def s2_local = instruction_s2.egress.bits
  def s2_local_result = s2_local.replay ||| s2_local.response.page_fault ||| s2_local.response.access_fault
  def resolved = instruction_s2.egress |> filter_valid(_result => !instruction.flush) |> map_valid(result):
    wire selected: RV5StageFetchResult(hypervisor)
    selected.replay <== mux(s2_local_result, result.replay, !instruction_memory.response.valid ||| instruction_memory.response.bits.replay)
    selected.response.word <== instruction_memory.response.bits.response.word
    selected.response.page_fault <== result.response.page_fault
    selected.response.access_fault <== result.response.access_fault ||| (!s2_local_result & instruction_memory.response.valid & instruction_memory.response.bits.response.access_fault)
    if hypervisor
    | selected.response.guest <== result.response.guest
    | #void
    selected
  resolved |> instruction.response

  // Core and PTE traffic independently offer physical requests. The outer
  // arbiter tags each accepted transaction and returns it to its origin.
  def word_bytes = memory_word_bytes(xlen)
  def data_physical_address = if xlen == XLen.X32 | data_request.address | mux(data_physical, data_request.address, mux(data_window, vector_window.physical_addresses[0], mux(data_translation_enabled, dtlb.translation.physical_address.zext(64), data_request.address)))
  def data_translated_address = mux(data_translation_enabled, dtlb.translation.physical_address.zext(64), data_virtual_address)
  def data_last_offset = mux_lookup(data_request.width, ~default: bits(7, 64), [[MemoryWidth.Byte, bits(0, 64)], [MemoryWidth.Half, bits(1, 64)], [MemoryWidth.Word, bits(3, 64)]])
  def data_physical_region = physical_map.lookup(data_translated_address, data_translated_address +& data_last_offset)
  def execute_read_denied = execute_read & dtlb.hit & !(data_physical_region.readable & data_physical_region.executable)
  def split_first_word = data_physical_address.align_down(word_bytes)
  def split_second_word = if xlen == XLen.X32 | split_second_virtual | mux(split_second_page & data_translation_enabled & !data_physical, dtlb.probe_translation.physical_address.zext(width).align_down(word_bytes), split_first_word + bits(word_bytes, width))
  def split_first_region = physical_map.lookup(split_first_word, split_first_word +& bits(word_bytes - 1, width))
  def split_second_region = physical_map.lookup(split_second_word, split_second_word +& bits(word_bytes - 1, width))
  def split_first_attributes = resolve_memory_attributes(split_first_region, mux(data_pinned, PageMemoryType.PMA, dtlb_result.pbmt))
  def split_second_attributes = resolve_memory_attributes(split_second_region, mux(data_physical, PageMemoryType.PMA, mux(split_second_page, dtlb.probe_pbmt, dtlb_result.pbmt)))
  def split_store = data_memory_operation === RV5StageMemoryOperation.Store
  def split_first_permitted = split_first_region.mapped & split_first_attributes.cacheable & !split_first_attributes.strongly_ordered & mux(split_store, split_first_region.writable, split_first_region.readable & split_first_attributes.read_idempotent) & (!execute_read ||| split_first_region.executable)
  def split_second_permitted = split_second_region.mapped & split_second_attributes.cacheable & !split_second_attributes.strongly_ordered & mux(split_store, split_second_region.writable, split_second_region.readable & split_second_attributes.read_idempotent) & (!execute_read ||| split_second_region.executable)
  def split_translation_ready = (data_pinned ||| !data_translation_enabled ||| dtlb.hit) & (!split_second_page ||| data_pinned ||| !data_translation_enabled ||| dtlb.probe_raw_hit)
  def split_region_fault = split_candidate & split_translation_ready & !data_page_fault & !data_walk_access_fault & !(split_first_permitted & (!split_crosses_word ||| split_second_permitted))
  request_fault_address <== mux(second_translation_fault ||| (split_region_fault & split_first_permitted), split_second_virtual, data_request.address)
  def split_ready = split_translation_ready & !data_page_fault & !data_walk_access_fault & !split_region_fault & core_memory.drained
  def Array(ordinary_data, split_data) = data_requests |> demux_flow(2, _request => split_candidate.as_bits())
  def split_start = (
    split_data |> gate_flow(split_ready)
      |> map_flow(request => RV5StageMisalignedAccess(xlen, vector_completion_slots)):
        request: request
        first_address: split_first_word
        second_address: split_second_word
        second_virtual: split_second_virtual
        crosses_word: split_crosses_word
  )
  split_start |> misaligned.start
  def split_capture = misaligned.start.fire()
  when (split_capture):
    assert(!invalidate_all, "split_admission_does_not_overlap_translation_flush")
  data.request_fault <== data.request.valid & !split_busy & data_page_fault
  // Local faults consume the core attempt; unresolved translations cannot
  // issue a physical request, even while another walk is in progress.
  def core_data_request = (
    ordinary_data
      |> gate_flow(!split_busy)
      |> filter_flow(_request => !(data_page_fault ||| data_walk_access_fault ||| execute_read_denied))
      |> gate_flow(data_pinned ||| !data_translation_enabled ||| dtlb.hit)
      |> map_flow(request => request.updated(
        ~address: data_physical_address,
        ~access: data_memory_operation
      ))
  )
  def normal_physical_link :: Handle = interface_link(Decoupled(RV5StageDataReq(xlen, vector_completion_slots)), "normal_physical")
  def split_physical_link :: Handle = interface_link(Decoupled(RV5StageDataReq(xlen, vector_completion_slots)), "split_physical")
  core_data_request |> normal_physical_link
  misaligned.physical_request |> split_physical_link
  data.request_access_fault <== data.request.valid & !split_busy & !data_page_fault & (data_walk_access_fault ||| split_region_fault ||| (!split_candidate & execute_read_denied) ||| (core_data_request.valid & core_memory.request_access_fault))
  def walker_memory_request = walker.memory.request |> gate_flow(walk_active & !walker_memory_pending) |> trace_event("mmu/pte.request")
  walker_lookup.valid <== walker_memory_request.valid
  walker_lookup.bits <== if xlen == XLen.X32 | walker_memory_request.bits.address[0..32] | walker_memory_request.bits.address
  def walker_data_request = walker_memory_request |> map_flow(pte => RV5StageDataReq(xlen, vector_completion_slots)):
    byte_mask: !bits(0, width / 8)
    address: if xlen == XLen.X32 | pte.address[0..32] | pte.address
    access: RV5StageMemoryOperation.Load
    atomic: RiscvAtomicOperation.Swap
    width: MemoryWidth.Double
    unsigned: Bool(#true)
    data: bits(0, width)
    writeback: RV5StageMemoryWriteback(vector_completion_slots).Ack
    origin: RV5StageDataOrigin.Walker
    locality: RiscvMemoryLocality.Default
  core_lookup.valid <== (data.request.valid & !split_busy & !split_candidate) ||| split_physical_link.right.valid
  core_lookup.bits <== mux(split_busy, misaligned.lookup.bits, data_request.address)
  core_memory.request.valid <== normal_physical_link.right.valid ||| split_physical_link.right.valid
  core_memory.request.bits <== RV5StagePhysicalDataReq(xlen, vector_completion_slots):
    memory: mux(split_physical_link.right.valid, split_physical_link.right.bits, normal_physical_link.right.bits)
    pbmt: mux(split_physical_link.right.valid, PageMemoryType.PMA, mux(data_pinned, PageMemoryType.PMA, dtlb_result.pbmt))
  normal_physical_link.right.ready <== core_memory.request.ready & !split_physical_link.right.valid
  split_physical_link.right.ready <== core_memory.request.ready & split_physical_link.right.valid
  describe_interface_selection([normal_physical_link.right.valid & !split_physical_link.right.valid, split_physical_link.right.valid], ~name: "physical_dispatch")
  describe_interface_contract(Array(normal_physical_link.right, split_physical_link.right), core_memory.request, "physical_dispatch", ~trace_model: interface_trace_selection(~name: "physical_dispatch", ~pending: #true))
  misaligned.request_fault <== core_memory.request_fault
  misaligned.request_access_fault <== core_memory.request_access_fault
  (walker_data_request |> map_flow(request => RV5StagePhysicalDataReq(xlen, vector_completion_slots)):
    memory: request
    pbmt: walker_memory_request.bits.pbmt
  ) |> walker_memory.request
  walker.memory.request_access_fault <== walker_memory.request_access_fault
  def walker_memory_request_fire = walker_memory.request.fire()
  // The shared walker retains canceled PTE ownership until the reply drains.
  walker_memory.response |> to_valid()
    |> map_valid(response => if xlen == XLen.X32 | response.data.zext(64) | response.data)
    |> walker.memory.response
  def Array(ordinary_responses, split_responses) = core_memory.response |> demux_flow(2, _response => split_busy.as_bits())
  split_responses |> misaligned.physical_response
  data.response.valid <== ordinary_responses.valid ||| misaligned.completion.valid
  data.response.bits <== mux(misaligned.completion.valid, misaligned.completion.bits, ordinary_responses.bits)
  ordinary_responses.ready <== data.response.ready & !misaligned.completion.valid
  misaligned.completion.ready <== data.response.ready
  // A saved fault is replay metadata, not outstanding memory work. Waiting
  // for its replay here would deadlock a WB trap/interrupt draining the LSU.
  data.drained <== !walk_active & !split_busy & !split_capture & core_memory.drained
  data.reservation_valid <== core_memory.reservation_valid

  def fault_latch_reset = invalidate_all ||| (instruction.flush & fault_valid & !fault_is_data)
  def latched_instruction_fault_accepted = instruction_s1_valid & instruction_translation_enabled & latched_instruction_fault
  def latched_data_fault_accepted = data.request.valid & data_translation_enabled & (latched_data_fault ||| latched_split_fault)
  def latched_fault_accepted = latched_instruction_fault_accepted ||| latched_data_fault_accepted
  def capture_walker_fault = walker_fault_completion & !walk_is_probe & !invalidate_all & (walk_is_data ||| !(walk_instruction_discarded ||| instruction.flush))
  when invalidate_all:
    walk_active <== Bool(#false)
  elsewhen walker_request_fire:
    walk_active <== Bool(#true)
    walk_is_data <== start_data_walk ||| start_split_walk
    walk_is_probe <== start_probe_walk
  elsewhen walker_completion_fire:
    walk_active <== Bool(#false)

  when fault_latch_reset:
    fault_valid <== Bool(#false)
  elsewhen capture_walker_fault:
    fault_valid <== Bool(#true)
  elsewhen latched_fault_accepted:
    fault_valid <== Bool(#false)

  when capture_walker_fault:
    fault_is_data <== walk_is_data
    fault_is_access <== walker.completion.bits.fault === RV5StageTranslationFault.AccessFault
    fault_mapping <== walker.completion.bits
    fault_address <== walker.completion.bits.virtual_address

  when walker_request_fire:
    walk_instruction_discarded <== Bool(#false)
  elsewhen walk_active:
    when discard_instruction_walk:
      walk_instruction_discarded <== Bool(#true)
  when (walker_memory_request_fire & !walker.memory.request_access_fault):
    walker_memory_pending <== Bool(#true)
  elsewhen (walker_memory.response.fire()):
    walker_memory_pending <== Bool(#false)
  when (walker_memory.response.valid):
    assert(walker_memory_pending, "rv5stage_mmu_pte_response_has_accepted_request")
  assert(!(invalidate_all & vector_window.owned), "vector_page_window_survives_until_macro_drain")
  when (data.request.valid & data_window):
    assert(vector_window.hits[0], "vector_transaction_inside_certified_range")
  when (load_request.egress.valid & load_window):
    assert(vector_window.hits[1], "vector_lookup_inside_certified_range")

export:
  RV5StageMmu
