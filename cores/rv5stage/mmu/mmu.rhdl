#lang rhodium
/* Resolves registered fetch/load attempts and issues separate core and page-table physical
   requests. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/common/fetch/protocol.rhdl") open
  lib("cores/common/fetch/access.rhdl").qualify_physical_fetch
  lib("riscv/isa/hart.rhm").RiscvMmuType
  lib("cores/common/mmu/vector.rhdl") open
  lib("cores/common/mmu/context.rhdl") open
  "../../common/cache/protocol.rhdl" open
  "../../common/cache/access.rhdl" open
  "../../common/cosim-source.rhm".describe_cosim_signals
  "../../common/cache-prefetch.rhdl" open
  "../../common/cache/prefetch.rhdl" open
  "../../common/fp/types.rhdl" open
  "protocol.rhdl" open
  lib("cores/common/mmu/protocol.rhdl") open
  lib("cores/common/mmu/translation.rhdl") open
  "../../../riscv/rtl/hypervisor.rhdl" open
  "../../common/misaligned-access.rhdl" open
  lib("cores/common/mmu/tlb.rhdl") open
  lib("cores/common/mmu/walker.rhdl") open
  "../../common/mmu/vector-window.rhdl" open
  "../../common/mmu/vector-certificate.rhdl".VectorCertificate
  lib("riscv/rtl/privilege.rhdl").PrivilegeMode
  "../../common/cache/operation.rhdl" open
  "../icache/protocol.rhdl" open
  "../uncached-protocol.rhdl" open
  "../memory-context.rhdl" open
  "../../common/load-store.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/rtl/pma.rhdl" open
  "../../../riscv/rtl/sv39.rhdl" open
  "../../../riscv/rtl/svpbmt.rhdl" open
  "../../../riscv/rtl/privilege.rhdl".effective_data_context
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

/* Owns ITLB/DTLB lookup, shared walking, precise translation faults, and physical dispatch.
   Speculative MEM accesses replay on contention; authorized requests and vector checks
   retain their own translations, and misaligned accesses authorize one fragment at a time. */
sync_circuit RV5StageMmu(xlen :: XLen,
                         mmu_mode :: RiscvMmuType,
                         physical_map :: RiscvPhysicalMemoryMap,
                         tlb_entries :: Pow2Int = 8,
                         ~svnapot: svnapot :: Boolean = #false,
                         ~hypervisor: hypervisor :: Boolean = #false,
                         ~vector_completion_slots: vector_completion_slots :: Pow2Int = 8):
  def width = xlen.width
  interface instruction(RV5StageFetchAccess(xlen, hypervisor), ~role: responder)
  interface data(if hypervisor | RV5StageGuestDataAccess(xlen, vector_completion_slots) | CacheAccess(xlen, RV5StageMemoryContext(vector_completion_slots)), ~role: responder)
  output request_fault_address: Bits(width)
  interface split_completion(Valid(RiscvSplitResult(xlen, RV5StageMemoryContext(vector_completion_slots))), ~role: producer)
  interface pipeline(if hypervisor | RV5StageGuestPipelineAccess(xlen) | CachePipelineAccess(xlen), ~role: responder)
  input pipeline_vector: Bool
  interface vector_precheck(VectorPrecheck(), ~role: responder)
  interface vector_fast(VectorFastCheck(xlen), ~role: responder)
  interface pipeline_memory(CachePipelineAccess(xlen), ~role: requester)
  interface pipeline_lookup(Valid(CachePipelineReq(xlen)), ~role: producer)
  interface instruction_memory(PhysicalInstructionLookup(xlen.width, 32), ~role: requester)
  interface core_memory(RV5StagePhysicalDataAccess(xlen, vector_completion_slots), ~role: requester)
  interface walker_memory(RV5StagePhysicalDataAccess(xlen, vector_completion_slots), ~role: requester)
  interface instruction_lookup(Decoupled(Bits(width)), ~role: producer)
  interface core_lookup(Valid(Bits(width)), ~role: producer)
  interface walker_lookup(Valid(Bits(width)), ~role: producer)
  interface prefetch(Valid(CachePrefetchReq(width)), ~role: consumer)
  interface physical_prefetch(Valid(CachePrefetchReq(width)), ~role: producer)
  input state: RiscvTranslationState(xlen)
  input invalidate_all: Bool
  input ordered_busy: Bool
  interface instruction_replay_owner(Valid(Bits(width)), ~role: consumer)

  unless (!hypervisor) || (xlen == XLen.X64 && mmu_mode == RiscvMmuType.Sv39)
  | error(~who: #'RV5StageMmu, "guest translation requires the RV64 Sv39 MMU")

  def privilege = state.privilege
  def mstatus = state.mstatus
  def satp = state.satp
  def tlb = RiscvTlbLookupBuilder(xlen, state, ~sv39: mmu_mode == RiscvMmuType.Sv39, ~hypervisor: hypervisor)
  def guest_state = tlb.guest_state

  inst itlb(RiscvTranslationTlb(tlb_entries, ~host_root_epoch: !hypervisor))
  inst dtlb(RiscvTranslationTlb(tlb_entries, ~host_root_epoch: !hypervisor))
  inst walker(RiscvTranslationWalker(~svnapot: svnapot))
  def itlb_result = riscv_host_result(itlb.translation)
  // A detached fetch must not trap, but a completed page fault is reusable
  // translation evidence until architectural invalidation. Keep its exact
  // guest-fault metadata separate from successful ITLB mappings and probes.
  reg instruction_fault_cached(~init: Bool(#false))
  reg instruction_failure(RiscvTranslationFailure())
  def dtlb_result = riscv_host_result(dtlb.translation)
  inst vector_window(VectorWindow(physical_map))
  inst misaligned(RiscvMisalignedEngine(xlen, RV5StageMemoryContext(vector_completion_slots)))
  reg split_mode(RiscvGuestMemoryAccess)
  reg split_physical(~init: Bool(#false))
  vector_precheck |> vector_window.check
  def page_probe = vector_window.translation
  inst instruction_s1(ValidPipeAlwaysCapture(RV5StageInstructionReq(xlen), 1, ~flushable: #true))
  inst instruction_s2(ValidPipeAlwaysCapture(RV5StageFetchResult(hypervisor), 1), ~reset_when: instruction.flush)
  inst load_request(ValidPipeAlwaysCapture(CachePipelineReq(xlen), 1))
  def pipeline_requests = pipeline.request |> map_valid(request => if hypervisor | request.memory | request)
  def Array(load_context, virtual_lookup, owner_context) = pipeline_requests |> fork_valid(3)
  load_context |> load_request.ingress
  virtual_lookup |> pipeline_lookup
  def pipeline_owner = owner_context |> map_valid(_request => pipeline_vector) |> valid_pipe(1)
  def physical_owner = pipeline.request |> map_valid(_request => pipeline_vector & vector_fast.pipeline_physical) |> valid_pipe(1)
  def load_mode = pipeline.request |> map_valid(request => if hypervisor | request.translation | RiscvGuestMemoryAccess.Normal) |> valid_pipe(1)
  def incoming_mode = if hypervisor | data.request.bits.translation | RiscvGuestMemoryAccess.Normal
  def request_mode = mux(misaligned.busy, split_mode, incoming_mode)
  def wb_translation_owner = misaligned.busy ||| data.request.valid
  def pipeline_translation_eligible = !page_probe.request.valid & load_request.egress.valid
  def demand_mode = priority_mux(~default: RiscvGuestMemoryAccess.Normal):
    wb_translation_owner: request_mode
    pipeline_translation_eligible: load_mode.bits

  def execute_read = demand_mode === RiscvGuestMemoryAccess.GuestExecuteRead

  def instruction_guest = guest_state.virtualized
  def instruction_translation_enabled = tlb.enabled(privilege, instruction_guest)
  def normal = effective_data_context(xlen, privilege, mstatus, ~virtualized: if hypervisor | guest_state.virtualized | #false)
  def demand = guest_data_context(normal, demand_mode, guest_state.hstatus)
  def data_translation_enabled = tlb.enabled(demand.privilege, demand.virtualized)


  /* Vector certificate context
     Physical certificates are independent of the retained fallback page window. */

  // WB validates the MEM snapshot independently of the fallback page window.
  // Certified vector requests carry their own physical address thereafter.
  inst certificate(VectorCertificate(xlen, physical_map))
  vector_fast <=> certificate.check
  certificate.invalidate <== invalidate_all
  certificate.current <== tlb.lookup(Bits(64)(0), Sv39Access.Load, normal.privilege, normal.virtualized)


  /* Instruction S0 admission and S1 ownership */

  def instruction_head = instruction_s1.egress
  def instruction_address = instruction_head.bits.address
  def instruction_virtual_address = instruction_address.zext(64)
  // One accepted S0 request atomically launches the virtual lookup and
  // captures the MMU's S1 context. The frontend retains its own occurrence.
  def Array(instruction_lookup_request, instruction_admission) = instruction.request |> atomic_fork(2)
  instruction_lookup_request |> map_flow(request => request.address) |> instruction_lookup
  instruction_admission |> to_valid() |> instruction_s1.ingress
  // A request transferred with flush starts the new fetch epoch and replaces
  // the old S1 context; a flush without a transfer clears S1 normally.
  instruction_s1.flush <== instruction.flush & !instruction_admission.valid
  def instruction_s1_valid = instruction_head.valid & !instruction.flush & !instruction.s1_kill


  /* Authorized data demand and split-fragment ownership */

  def data_requests = data.request |> map_flow(request => if hypervisor | request.memory | request)
  def incoming_request :: PhysicalMemoryReq(xlen, RV5StageMemoryContext(vector_completion_slots)) = data_requests.bits
  def split_busy = misaligned.busy
  def data_request :: PhysicalMemoryReq(xlen, RV5StageMemoryContext(vector_completion_slots)) = mux(split_busy, misaligned.request.bits, incoming_request)
  def data_memory_operation = data_request.access
  def data_fault_address = mux(split_busy, misaligned.fault_address, data_request.address)
  def data_virtual_address = data_fault_address.zext(64)
  def split_candidate = data.request.valid & !split_busy & incoming_request.access.requires_split(incoming_request.width, incoming_request.address)
  def data_demand = misaligned.request.valid ||| (data.request.valid & !split_busy & !split_candidate)
  def data_vector = data_request.context.writeback.is(RV5StageMemoryWriteback(vector_completion_slots).Vector)
  def data_physical = mux(split_busy, split_physical, data_vector & vector_fast.request_physical)
  def data_window = vector_window.owned & data_vector & !data_physical & !split_candidate & !split_busy
  def data_pinned = data_window ||| data_physical
  def data_access_kind = data_memory_operation.translation_access()


  /* Translation-port arbitration
     Authorized WB demand precedes page probes, MEM lookup, and vector fast certification. */

  itlb.lookup <== tlb.lookup(instruction_virtual_address, Sv39Access.Fetch, privilege, instruction_guest)
  itlb.invalidate_all <== invalidate_all
  // Authorized WB requests own the DTLB on contention. Younger MEM loads then
  // fall back instead of observing a translation belonging to another token.
  def lookup = load_request.egress.bits
  def load_virtual_address = lookup.address.zext(64)
  vector_window.addresses <== vec([data_virtual_address, load_virtual_address])
  def load_window = vector_window.owned & pipeline_owner.bits & !physical_owner.bits
  def load_pinned = load_window ||| physical_owner.bits
  def probe_selected = page_probe.request.valid & !data.request.valid & !split_busy
  def fast_selected = vector_fast.request.valid & !data.request.valid & !split_busy & !page_probe.request.valid & !load_request.egress.valid
  def demand_address = priority_mux(~default: vector_fast.request.bits.first):
    data_demand: data_virtual_address
    probe_selected: page_probe.request.bits.address
    load_request.egress.valid: load_virtual_address

  def pipeline_is_store = lookup.access === CacheOperation.Store
  def speculative_store = priority_mux(~default: vector_fast.request.bits.store):
    probe_selected: page_probe.request.bits.store
    load_request.egress.valid: pipeline_is_store

  def demand_access = mux(data_demand, data_access_kind, mux(speculative_store, Sv39Access.Store, Sv39Access.Load))
  dtlb.lookup <== tlb.lookup(demand_address, demand_access, demand.privilege, demand.virtualized).updated(~execute_read: execute_read)
  dtlb.invalidate_all <== invalidate_all
  certificate.translation.valid <== fast_selected & dtlb.hit
  certificate.translation.bits <== dtlb_result


  /* Prefetch translation
     Context changes cancel the two probe pipes without feeding demand admission. */

  reg prefetch_previous_privilege(PrivilegeMode, ~init: PrivilegeMode.Machine)
  reg prefetch_previous_satp(~init: Bits(width)(0))
  reg prefetch_previous_sum(~init: Bool(#false))
  reg prefetch_previous_mxr(~init: Bool(#false))
  prefetch_previous_privilege <== normal.privilege
  prefetch_previous_satp <== satp
  prefetch_previous_sum <== tlb.sum
  prefetch_previous_mxr <== tlb.mxr
  def prefetch_context_changed = (prefetch_previous_privilege =/= normal.privilege) ||| (prefetch_previous_satp =/= satp) ||| (prefetch_previous_sum =/= tlb.sum) ||| (prefetch_previous_mxr =/= tlb.mxr)
  def prefetch_flush = instruction.flush ||| invalidate_all ||| prefetch_context_changed
  inst virtual_prefetch_pipe(ValidPipeAlwaysCapture(CachePrefetchReq(width), 1, ~flushable: #true))
  inst physical_prefetch_pipe(PhysicalPrefetchPipe(width, physical_map.cacheable_address_width))
  virtual_prefetch_pipe.flush <== prefetch_flush
  physical_prefetch_pipe.flush <== prefetch_flush
  prefetch |> virtual_prefetch_pipe.ingress

  def prefetch_request = virtual_prefetch_pipe.egress.bits.into(CachePrefetchReq(width))
  def prefetch_virtual_address = prefetch_request.address.zext(64)
  def normal_data_translation_enabled = tlb.enabled(normal.privilege, normal.virtualized)
  def probe = tlb.lookup(prefetch_virtual_address, Sv39Access.Load, normal.privilege, normal.virtualized)
  itlb.probe <== probe
  dtlb.probe <== probe

  def instruction_prefetch = prefetch_request.operation === CachePrefetchOperation.Instruction
  def hint_probe = mux(instruction_prefetch, itlb.prefetch_probe, dtlb.prefetch_probe)
  def prefetch_translated_address = if xlen == XLen.X32 | prefetch_request.address | mux(
    normal_data_translation_enabled,
    hint_probe.physical_address.zext(64),
    prefetch_request.address
  )

  def prefetch_physical = cache_prefetch_physical(width, physical_map, prefetch_translated_address, prefetch_request.operation, hint_probe.pbmt)

  virtual_prefetch_pipe.egress
    |> filter_valid(_request => prefetch_request.operation.is_prefetch() & hint_probe.hit & !hint_probe.fault & prefetch_physical.cacheable & prefetch_physical.permitted)
    |> map_valid(request => request.updated(~address: prefetch_physical.address))
    |> physical_prefetch_pipe.ingress

  // Cancel at the clock edge without reconnecting demand squash to cache admission.
  physical_prefetch_pipe.egress |> physical_prefetch


  /* Retained walker and fault state */

  reg walk_active(~init: Bool(#false))
  reg walk_is_data(~init: Bool(#false))
  reg walk_is_probe(~init: Bool(#false))
  reg walk_instruction_discarded(~init: Bool(#false))
  reg fault_valid(~init: Bool(#false))
  reg fault_is_data(~init: Bool(#false))
  reg fault_is_access(~init: Bool(#false))
  reg fault_address(Bits(64))
  reg fault_mapping(RiscvTlbMapping())
  reg walker_memory_pending(~init: Bool(#false))


  /* MEM pipeline translation and local replay
     Contention and ordered accesses fall back without entering cache miss service. */

  def load_address :: Bits(width):
    if xlen == XLen.X32
    | lookup.address
    | block:
        priority_mux(~default: lookup.address):
          physical_owner.bits: lookup.address
          load_window: vector_window.physical_addresses[1]
          data_translation_enabled: dtlb.translation.physical_address.zext(64)

  def load_physical = cache_access_region(xlen, physical_map, load_address, lookup.width)
  def pipeline_access = classify_speculative_cache_access(
    load_physical, mux(load_pinned, PageMemoryType.PMA, dtlb_result.pbmt),
    mux(pipeline_is_store, CacheOperation.Store, CacheOperation.Load), ~execute_read: execute_read
  )
  // Translation contention and ordered IO replay without entering miss service.
  // Pending committed cache stores do not make this translation port busy.
  def pipeline_blocked = split_busy ||| data.request.valid ||| invalidate_all ||| ordered_busy ||| (probe_selected & !load_pinned)
  def load_translation_hit = load_pinned ||| dtlb.hit
  def load_translation_fault = !load_pinned & dtlb_result.fault
  def load_translation_access_fault = !load_pinned & dtlb_result.access_fault
  def decision = classify_cache_lookup(
    ~blocked: pipeline_blocked, ~split: lookup.access.requires_split(lookup.width, lookup.address), ~known: load_translation_hit,
    ~page_fault: load_translation_fault, ~access_fault: load_translation_access_fault,
    ~permitted: pipeline_access.permitted, ~can_probe: pipeline_access.allocatable
  )
  def Array(physical_request, local_result) = load_request.egress |> fork_valid(2)
  def cache_eligible = decision.is(CacheLookupDecision.Probe)
  physical_request |> filter_valid(_request => cache_eligible)
    |> map_valid(request => request.updated(~address: load_address)) |> pipeline_memory.request

  // WB owns squash and serialization. Rechecking its derived flush here would
  // feed fence/trap drain back into the very store authorization being drained.
  pipeline_memory.commit <== pipeline.commit
  pipeline.commit_ready <== pipeline_memory.commit_ready
  def pipeline_reason = priority_mux(~default: pipeline_memory.response.bits.reason):
    pipeline_blocked: mux(ordered_busy, CachePipelineReason.Ordered, CachePipelineReason.Translation)
    !load_translation_hit: CachePipelineReason.Translation
    !pipeline_access.allocatable: CachePipelineReason.Ordered

  def pipeline_result = CachePipelineResult(xlen):
    outcome: cache_lookup_outcome(decision, pipeline_memory.response.valid, pipeline_memory.response.bits.outcome)
    reason: pipeline_reason
    data: pipeline_memory.response.bits.data

  def use_cache_result = cache_eligible & pipeline_memory.response.valid
  def cache_result = pipeline_memory.response |> filter_valid(_response => cache_eligible & load_request.egress.valid)
    |> map_valid(_response => pipeline_result)
  def translation_result = local_result |> filter_valid(_request => !use_cache_result)
    |> map_valid(_request => pipeline_result)
  Array(cache_result, translation_result) |> valid_arbiter() |> pipeline.response


  /* Page-walk admission
     Page probes precede instruction misses, then authorized data misses. */

  def can_start_walk = !walk_active & !fault_valid
  def instruction_fault_cache_hit = instruction_fault_cached & instruction_failure.request.same_request(itlb.lookup)
  // A replaying older instruction may need its own fetch (including a
  // straddling word), but speculative successors must not repeatedly occupy
  // the shared walker before that instruction resolves.
  def replay_first_word = instruction_replay_owner.bits.align_down(4)
  def replay_last_word = (instruction_replay_owner.bits + Bits(width)(3)).align_down(4)
  def replay_owner_fetch = (instruction_address === replay_first_word) ||| (instruction_address === replay_last_word)
  def instruction_walk_allowed = !instruction_replay_owner.valid ||| replay_owner_fetch
  def instruction_miss = instruction_s1_valid & instruction_translation_enabled & !itlb.hit & !instruction_fault_cache_hit
  def data_miss = data_demand & !data_pinned & data_translation_enabled & !dtlb.hit
  def start_probe_walk = can_start_walk & !invalidate_all & probe_selected & !dtlb.hit
  def start_instruction_walk = can_start_walk & !start_probe_walk & !split_busy & instruction_miss & instruction_walk_allowed
  def start_data_walk = can_start_walk & !start_probe_walk & !start_instruction_walk & data_miss
  walker.request.valid <== start_instruction_walk ||| start_data_walk ||| start_probe_walk
  walker.request.bits <== mux(start_data_walk ||| start_probe_walk, dtlb.lookup, itlb.lookup)
  reg walk_lookup(RiscvTlbLookup())
  when (walker.request.fire()):
    walk_lookup <== walker.request.bits

  def walker_request_fire = walker.request.fire()
  page_probe.request.ready <== probe_selected & !invalidate_all & (dtlb.hit ||| (start_probe_walk & walker.request.ready))
  def probe_hit_result = inject_interface(Valid(RiscvTranslationResult()), ~valid: page_probe.request.fire() & dtlb.hit, ~bits: dtlb_result)
  // Fetch recovery discards the consumer, not an accepted translation. Let
  // the walk warm the ITLB and retain ownership of every accepted PTE reply.
  def discard_instruction_walk = instruction.flush & walk_active & !walk_is_data & !walk_is_probe
  // Invalidate TLB/fault ownership at this edge, then notify the walker.
  // A PTE accepted on the invalidation edge remains owned and must drain.
  // This keeps WB's flush decision out of the physical arbiter's ready path.
  reg walker_cancel(~init: Bool(#false))
  walker_cancel <== invalidate_all
  walker.cancel <== walker_cancel


  /* Walker completion and TLB fills
     A discarded fetch consumer does not discard an accepted PTE reply. */

  def walker_completed = walker.completion |> gate_flow(!fault_valid) |> to_valid()
  def walker_completion_fire = walker_completed.valid
  def probe_walk_result = walker_completed |> filter_valid(_result => walk_is_probe) |> map_valid(result => riscv_host_result(result))
  Array(probe_hit_result, probe_walk_result) |> valid_arbiter() |> page_probe.response
  def walker_fault_completion = walker_completion_fire & (walker.completion.bits.fault =/= RiscvTranslationFault.None)
  def fills = walker_completed |> map_valid(result => RiscvTlbFill()):
    request: walk_lookup
    result: result

  def Array(instruction_fill, data_fill) = fills |> fork_valid(2)
  instruction_fill |> filter_valid(_completion => !walk_is_data & !walk_is_probe) |> itlb.fill
  data_fill |> filter_valid(_completion => walk_is_data ||| walk_is_probe) |> dtlb.fill
  def cache_instruction_page_fault = walker_fault_completion & !walk_is_data & !walk_is_probe & !invalidate_all & walker.completion.bits.fault.is_page_fault()
  when invalidate_all:
    instruction_fault_cached <== Bool(#false)
  elsewhen cache_instruction_page_fault:
    instruction_fault_cached <== Bool(#true)
    instruction_failure <== fills.bits.into(RiscvTlbFill()).failure()


  /* Fault selection and instruction PMA checks */

  def latched_instruction_fault = fault_valid & !fault_is_data & (fault_address === instruction_virtual_address)
  def latched_data_fault = fault_valid & fault_is_data & (fault_address === data_virtual_address)
  def instruction_page_fault = instruction_translation_enabled & ((itlb.hit & itlb_result.fault) ||| instruction_fault_cache_hit ||| (latched_instruction_fault & !fault_is_access))
  def data_page_fault = !data_pinned & data_translation_enabled & ((dtlb.hit & dtlb_result.fault) ||| (latched_data_fault & !fault_is_access))
  def instruction_walk_access_fault = (latched_instruction_fault & fault_is_access) ||| (itlb.hit & itlb_result.access_fault)
  def data_walk_access_fault = !data_pinned & ((latched_data_fault & fault_is_access) ||| (dtlb.hit & dtlb_result.access_fault))
  def request_fault_mapping = mux(latched_data_fault, fault_mapping, dtlb.translation)

  def instruction_exception_mapping = priority_mux(~default: itlb.translation):
    instruction_fault_cache_hit: instruction_failure.mapping()
    latched_instruction_fault: fault_mapping

  def instruction_guest_exception = riscv_guest_exception(instruction_exception_mapping, instruction_guest)
  if hypervisor
  | block:
      output request_guest_fault: RiscvGuestException()
      output pipeline_guest_fault: RiscvGuestException()
      request_guest_fault <== riscv_guest_exception(request_fault_mapping, normal.virtualized ||| (request_mode =/= RiscvGuestMemoryAccess.Normal))
      pipeline_guest_fault <== riscv_guest_exception(dtlb.translation, normal.virtualized ||| (load_mode.bits =/= RiscvGuestMemoryAccess.Normal))
  | #void

  def instruction_lookup_ready = !instruction_translation_enabled ||| itlb.hit ||| instruction_fault_cache_hit ||| latched_instruction_fault
  def instruction_physical_address = if xlen == XLen.X32 | instruction_address | mux(instruction_translation_enabled, itlb.translation.physical_address.zext(64), instruction_address)
  def (instruction_permitted, physical_fetch) = qualify_physical_fetch(
    xlen, physical_map, instruction_address, instruction_physical_address, 4, itlb_result.pbmt
  )
  def instruction_has_physical_address = !instruction_translation_enabled ||| itlb.hit
  def instruction_access_fault = instruction_walk_access_fault ||| (instruction_has_physical_address & !instruction_page_fault & !instruction_permitted)
  def instruction_local_fault = instruction_page_fault ||| instruction_access_fault


  /* Local S1 translation/PMA decisions are registered beside physical lookup.
     An ITLB miss starts at most one walk; the frontend regenerates the attempt. */

  def Array(instruction_physical_path, instruction_result_path) = instruction_head
    |> filter_valid(_request => !instruction.flush & !instruction.s1_kill) |> fork_valid(2)
  (instruction_physical_path |> filter_valid(_request => instruction_lookup_ready & !instruction_local_fault)
    |> map_valid(_request => physical_fetch)) |> instruction_memory.request

  instruction_memory.flush <== instruction.flush
  instruction_memory.invalidate_all <== instruction.invalidate_all
  instruction_memory.s1_kill <== instruction.s1_kill
  wire local_response: RV5StageInstructionResp(hypervisor)
  local_response.word <== Bits(32)(0)
  local_response.page_fault <== instruction_page_fault
  local_response.access_fault <== instruction_access_fault
  if hypervisor
  | local_response.guest <== instruction_guest_exception
  | #void

  (instruction_result_path |> map_valid(_request => RV5StageFetchResult(hypervisor)):
    response: local_response
    replay: !instruction_lookup_ready
  ) |> instruction_s2.ingress

  def s2_local = instruction_s2.egress.bits
  def s2_local_result = s2_local.replay ||| s2_local.response.page_fault ||| s2_local.response.access_fault
  def resolved = instruction_s2.egress |> filter_valid(_result => !instruction.flush) |> map_valid(result):
    wire selected: RV5StageFetchResult(hypervisor)
    selected.replay <== mux(s2_local_result, result.replay, !instruction_memory.response.valid ||| instruction_memory.response.bits.replay)
    selected.response.word <== instruction_memory.response.bits.data
    selected.response.page_fault <== result.response.page_fault
    selected.response.access_fault <== result.response.access_fault ||| (!s2_local_result & instruction_memory.response.valid & instruction_memory.response.bits.access_fault)
    if hypervisor
    | selected.response.guest <== result.response.guest
    | #void

    selected

  resolved |> instruction.response


  /* Core and PTE traffic independently offer physical requests. The outer
     arbiter tags each accepted transaction and returns it to its origin. */

  def word_bytes = memory_word_bytes(xlen)
  def translated_fragment_address :: Bits(width):
    if xlen == XLen.X32
    | data_request.address
    | block:
        priority_mux(~default: data_request.address):
          data_physical: data_request.address
          data_window: vector_window.physical_addresses[0]
          data_translation_enabled: dtlb.translation.physical_address.zext(64)

  def data_physical_address = mux(split_busy, translated_fragment_address.align_down(word_bytes), translated_fragment_address)
  def data_translated_address = mux(data_translation_enabled, dtlb.translation.physical_address.zext(64), data_virtual_address)
  def data_physical_region = cache_access_region(XLen.X64, physical_map, data_translated_address, data_request.width)
  def execute_read_denied = execute_read & dtlb.hit & !hlvx_physical_permitted(data_physical_region)
  // A retained split owner uses the same demand TLB and physical checks as
  // ordinary requests. No second-page probe or simultaneous mapping is needed.
  def fragment_permitted = cache_fragment_permitted(
    physical_map, data_physical_address, word_bytes, mux(data_physical, PageMemoryType.PMA, dtlb_result.pbmt),
    ~write: data_memory_operation.is_store(), ~execute_read: execute_read
  )
  def translation_ready = data_pinned ||| !data_translation_enabled ||| dtlb.hit
  def fragment_region_fault = split_busy & translation_ready & !data_page_fault & !data_walk_access_fault & !fragment_permitted
  request_fault_address <== data_request.address
  def Array(ordinary_data, split_data) = data_requests |> demux_flow(2, _request => split_candidate.as_bits())
  split_data |> gate_flow(core_memory.drained & !walk_active & !fault_valid) |> misaligned.start
  def split_capture = misaligned.start.fire()
  when split_capture:
    split_mode <== incoming_mode
    split_physical <== data_vector & vector_fast.request_physical

  when split_busy:
    assert(!invalidate_all, "retained_split_owns_translation_context")

  data.request_fault <== data.request.valid & !split_busy & !split_candidate & data_page_fault
  def requests = Array(ordinary_data |> gate_flow(!split_busy), misaligned.request) |> arbiter()
  def local_access_fault = data_walk_access_fault ||| execute_read_denied ||| fragment_region_fault
  def core_data_request = requests
    |> filter_flow(_request => !(data_page_fault ||| local_access_fault))
    |> gate_flow(translation_ready)
    |> map_flow(request => request.updated(~address: data_physical_address, ~access: data_memory_operation))

  data.request_access_fault <== data.request.valid & !split_busy & !split_candidate & !data_page_fault & (local_access_fault ||| (core_data_request.valid & core_memory.request_access_fault))
  misaligned.request_fault <== data_page_fault
  misaligned.request_access_fault <== !data_page_fault & (local_access_fault ||| (core_data_request.valid & core_memory.request_access_fault))
  misaligned.request_guest <== riscv_guest_exception(request_fault_mapping, normal.virtualized ||| (request_mode =/= RiscvGuestMemoryAccess.Normal))


  /* PTE physical requests and response routing */

  def pte_offer = walker.memory.request |> gate_flow(walk_active & !walker_memory_pending)
  def pte_permitted = pte_read_permitted(physical_map, pte_offer.bits.address, pte_offer.bits.pbmt)
  def walker_memory_request = pte_offer |> filter_flow(_pte => pte_permitted) |> trace_event("mmu/pte.request")
  walker_lookup.valid <== walker_memory_request.valid
  walker_lookup.bits <== if xlen == XLen.X32 | walker_memory_request.bits.address[0..32] | walker_memory_request.bits.address
  def walker_context = RV5StageMemoryContext(vector_completion_slots):
    writeback: RV5StageMemoryWriteback(vector_completion_slots).Ack
    origin: RV5StageDataOrigin.Walker
  walker_memory_request |> map_flow(pte => pte_read_request(xlen, pte.address[0..width], pte.pbmt, walker_context)) |> walker_memory.request

  core_lookup.valid <== data_demand
  core_lookup.bits <== data_request.address
  (core_data_request |> map_flow(request => RV5StagePhysicalDataReq(xlen, vector_completion_slots)):
    memory: request
    pbmt: mux(data_pinned, PageMemoryType.PMA, dtlb_result.pbmt)
  ) |> core_memory.request

  walker.memory.request_access_fault <== (pte_offer.valid & !pte_permitted) ||| (walker_memory.request.valid & walker_memory.request_access_fault)
  def walker_memory_request_fire = walker_memory.request.fire()
  // The shared walker retains canceled PTE ownership until the reply drains.
  walker_memory.response |> to_valid()
    |> map_valid(response => response.data.zext(64))
    |> walker.memory.response

  def Array(ordinary_responses, split_responses) = core_memory.response |> demux_flow(2, _response => split_busy.as_bits())
  split_responses |> misaligned.physical_response
  ordinary_responses |> data.response
  misaligned.completion |> split_completion
  // A saved fault is replay metadata, not outstanding memory work. Waiting
  // for its replay here would deadlock a WB trap/interrupt draining the LSU.
  data.drained <== !walk_active & !split_busy & !split_capture & core_memory.drained
  data.reservation_valid <== core_memory.reservation_valid


  /* Walker, fault, and accepted-PTE ownership updates */

  def fault_latch_reset = invalidate_all ||| (instruction.flush & fault_valid & !fault_is_data)
  def latched_instruction_fault_accepted = instruction_s1_valid & instruction_translation_enabled & latched_instruction_fault
  def latched_data_fault_accepted = data_demand & data_translation_enabled & latched_data_fault
  def latched_fault_accepted = latched_instruction_fault_accepted ||| latched_data_fault_accepted
  def capture_walker_fault = walker_fault_completion & !walk_is_probe & !invalidate_all & (walk_is_data ||| !(walk_instruction_discarded ||| instruction.flush))
  when invalidate_all:
    walk_active <== Bool(#false)
  elsewhen walker_request_fire:
    walk_active <== Bool(#true)
    walk_is_data <== start_data_walk
    walk_is_probe <== start_probe_walk
  elsewhen walker_completion_fire:
    walk_active <== Bool(#false)

  when fault_latch_reset:
    fault_valid <== Bool(#false)
  elsewhen capture_walker_fault:
    fault_valid <== Bool(#true)
  elsewhen latched_fault_accepted:
    fault_valid <== Bool(#false)

  when capture_walker_fault:
    fault_is_data <== walk_is_data
    fault_is_access <== walker.completion.bits.fault === RiscvTranslationFault.AccessFault
    fault_mapping <== walker.completion.bits
    fault_address <== walker.completion.bits.virtual_address

  when walker_request_fire:
    walk_instruction_discarded <== Bool(#false)
  elsewhen walk_active:
    when discard_instruction_walk:
      walk_instruction_discarded <== Bool(#true)

  when (walker_memory_request_fire & !walker.memory.request_access_fault):
    walker_memory_pending <== Bool(#true)
  elsewhen (walker_memory.response.fire()):
    walker_memory_pending <== Bool(#false)

  when (walker_memory.response.valid):
    assert(walker_memory_pending, "rv5stage_mmu_pte_response_has_accepted_request")

  assert(!(invalidate_all & vector_window.owned), "vector_page_window_survives_until_macro_drain")
  when (data.request.valid & data_window):
    assert(vector_window.hits[0], "vector_transaction_inside_certified_range")

  when (load_request.egress.valid & load_window):
    assert(vector_window.hits[1], "vector_lookup_inside_certified_range")


  /* Passive physical-address taps follow the same MEM and accepted-WB owners. */

  describe_cosim_signals({
    "pipeline_valid": pipeline.response.valid & pipeline_result.outcome.is_one_of(CachePipelineOutcome.LoadHit, CachePipelineOutcome.StoreHit),
    "pipeline_address": load_address,
    "request_valid": data.request.fire() & !split_capture & !data.request_fault & !data.request_access_fault,
    "request_address": data_physical_address,
    "request": data_request,
    "fragment_valid": split_busy & core_memory.request.fire() & !core_memory.request_fault & !core_memory.request_access_fault,
    "fragment_address": data_physical_address,
    "fragment_virtual": misaligned.fault_address,
    "fragment_request": misaligned.request.bits,
    "fragment_completed": split_responses.fire(),
    "fragment_response": split_responses.bits
  })

export:
  RV5StageMmu
