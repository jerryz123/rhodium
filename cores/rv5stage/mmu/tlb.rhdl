#lang rhodium
/* Shares one associative entry bank between host and composed guest mappings, with a
   combinational hit path. */
// SPDX-License-Identifier: Apache-2.0

import:
  "translation.rhdl" open
  "protocol.rhdl" open
  lib("riscv/rtl/hypervisor.rhdl") open
  lib("riscv/rtl/privilege.rhdl") open
  lib("riscv/rtl/sv39.rhdl") open
  lib("riscv/rtl/svpbmt.rhdl").compose_page_memory_type
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

/* Stores a mapping's address identity, translation roots, and independently checked stage
   leaves. */
bundle RV5StageTlbEntry():
  valid: Bool
  virtualized: Bool
  page_size: Sv39PageSize
  vpn: Bits(52)
  ppn: Bits(44)
  guest_ppn: Bits(52)
  context: RiscvGuestTranslationContext()
  vs_leaf: Sv39Pte()
  g_leaf: Sv39Pte()

/* Matches page and captured translation identity; current privilege, SUM, and VS MXR are
   rechecked. */
fun rv5stage_tlb_matches(entry :: RV5StageTlbEntry(), request :: RV5StageTlbLookup()) :~ Bool:
  def left = entry.context
  def right = request.context
  // SUM, VS MXR, and privilege are rechecked at lookup. HS MXR additionally
  // authorizes implicit G-stage PTE reads, whose leaves are not kept here;
  // changing it conservatively rewalks instead of reusing that lost proof.
  def host_page = request.virtual_address.sv39_canonical() & sv39_same_page(entry.vpn[0..27] ++ bits(0, 12), request.virtual_address[0..39], entry.page_size)
  def same_page = mux(entry.virtualized, entry.vpn === request.virtual_address[12..64], host_page)
  entry.valid & (entry.virtualized === request.virtualized) & same_page & (
    left.vs_mode === right.vs_mode
  ) & (left.g_mode === right.g_mode) & (left.vs_root_ppn === right.vs_root_ppn) & (
    left.g_root_ppn === right.g_root_ppn
  ) & (left.vs_pbmte === right.vs_pbmte) & (left.g_pbmte === right.g_pbmte) & (left.hs_mxr === right.hs_mxr)

/* Provides combinational demand and nonfaulting probe lookups over one associative bank.
   Successful fills replace round-robin; invalidation wins over a simultaneous fill. */
sync_circuit RV5StageTranslationTlb(entry_count :: Pow2Int = 8):
  input lookup: RV5StageTlbLookup()
  input probe: RV5StageTlbLookup()
  input invalidate_all: Bool
  interface fill(Valid(RV5StageTlbFill()), ~role: consumer)
  output hit: Bool
  output translation: RV5StageTlbMapping()
  output probe_raw_hit: Bool
  output probe_hit: Bool
  output probe_fault: Bool
  output probe_demand_fault: Bool
  output probe_translation: RV5StageTlbMapping()
  output probe_physical_address: Bits(56)
  output probe_pbmt: PageMemoryType

  def index_bits = index_width(entry_count)
  reg entries(Vec(entry_count, RV5StageTlbEntry()), ~init: literal(Vec(entry_count, RV5StageTlbEntry()), 0))
  reg replacement(~init: bits(0, index_bits))
  def matches = vec(for List (index in 0..entry_count): rv5stage_tlb_matches(entries[index], lookup))
  def selected = entries[priority_encoder(matches)]
  def vs_enabled = lookup.context.vs_mode === RiscvVSMode.Sv39
  def g_enabled = lookup.virtualized & (lookup.context.g_mode === RiscvGMode.Sv39x4)
  def vs_fault = vs_enabled & !sv39_permission_valid(selected.vs_leaf, lookup.access, lookup.context.privilege === PrivilegeMode.User, lookup.context.privilege === PrivilegeMode.Supervisor, lookup.context.vs_sum, lookup.context.vs_mxr ||| lookup.context.hs_mxr, lookup.execute_read)
  def g_fault = g_enabled & !sv39_permission_valid(selected.g_leaf, lookup.access, Bool(#true), Bool(#false), Bool(#false), lookup.context.hs_mxr, lookup.execute_read)
  def bare = !vs_enabled & !g_enabled
  def translated = sv39_physical_address(lookup.virtual_address, selected.ppn, selected.page_size)
  def guest_address = mux(lookup.virtualized, selected.guest_ppn ++ lookup.virtual_address[0..12], translated.zext(64))
  def details = RiscvGuestFault():
    guest_virtual_address: lookup.virtualized
    guest_physical_address: mux(vs_fault, bits(0, 64), guest_address)
    access: RiscvGuestFaultAccess.Explicit
  // Invalidation wins at the state-update edge. Do not feed a WB-owned fence
  // back through hit/readiness into the retirement decision that creates it.
  hit <== bare ||| matches.or_reduce()
  translation <== RV5StageTlbMapping():
    virtual_address: lookup.virtual_address
    access: lookup.access
    physical_address: mux(bare, lookup.virtual_address[0..56], translated)
    page_size: mux(bare, Sv39PageSize.Page4KiB, selected.page_size)
    guest_physical_address: mux(bare, lookup.virtual_address, guest_address)
    vs_leaf: mux(vs_enabled, selected.vs_leaf, literal(Sv39Pte(), 0))
    g_leaf: mux(g_enabled, selected.g_leaf, literal(Sv39Pte(), 0))
    fault: mux(bare & lookup.virtual_address[56..64].or_reduce(), RV5StageTranslationFault.AccessFault, mux(vs_fault, RV5StageTranslationFault.PageFault, mux(g_fault, RV5StageTranslationFault.GuestPageFault, RV5StageTranslationFault.None)))
    fault_details: details

  // Prefetch shares the bank but deliberately does not require A/D bits.
  def probe_matches = vec(for List (index in 0..entry_count): rv5stage_tlb_matches(entries[index], probe))
  def probe_entry = entries[priority_encoder(probe_matches)]
  def probe_vs = probe.context.vs_mode === RiscvVSMode.Sv39
  def probe_g = probe.virtualized & (probe.context.g_mode === RiscvGMode.Sv39x4)
  def probe_bare = !probe_vs & !probe_g
  def probe_vs_pte :: Sv39Pte() = probe_entry.vs_leaf.updated(~accessed: Bool(#true), ~dirty: Bool(#true))
  def probe_g_pte :: Sv39Pte() = probe_entry.g_leaf.updated(~accessed: Bool(#true), ~dirty: Bool(#true))
  /* Checks the same access class against both stages while ignoring A/D bits for prefetch. */
  fun probe_allowed(kind :: Sv39Access) :~ Bool:
    def stage_one = probe_vs_pte.sv39_permission_valid(kind, probe.context.privilege === PrivilegeMode.User, probe.context.privilege === PrivilegeMode.Supervisor, probe.context.vs_sum, probe.context.vs_mxr ||| probe.context.hs_mxr)
    def stage_two = probe_g_pte.sv39_permission_valid(kind, Bool(#true), Bool(#false), Bool(#false), probe.context.hs_mxr)
    (!probe_vs ||| stage_one) & (!probe_g ||| stage_two)
  // The SAME access class must be allowed by both stages, not merely some
  // access in each stage independently (e.g. VS execute-only + G read-only).
  def probe_permissions = vec(for List (kind in [Sv39Access.Fetch, Sv39Access.Load, Sv39Access.Store]): probe_allowed(kind))
  probe_raw_hit <== probe_bare ||| probe_matches.or_reduce()
  probe_hit <== probe_raw_hit & !invalidate_all
  probe_fault <== probe_hit & !probe_permissions.or_reduce()
  def probe_vs_demand_fault = probe_vs & !sv39_permission_valid(probe_entry.vs_leaf, probe.access, probe.context.privilege === PrivilegeMode.User, probe.context.privilege === PrivilegeMode.Supervisor, probe.context.vs_sum, probe.context.vs_mxr ||| probe.context.hs_mxr, probe.execute_read)
  def probe_g_demand_fault = probe_g & !sv39_permission_valid(probe_entry.g_leaf, probe.access, Bool(#true), Bool(#false), Bool(#false), probe.context.hs_mxr, probe.execute_read)
  probe_demand_fault <== probe_hit & (probe_vs_demand_fault ||| probe_g_demand_fault)
  def probe_physical = mux(probe_bare, probe.virtual_address[0..56], sv39_physical_address(probe.virtual_address, probe_entry.ppn, probe_entry.page_size))
  def probe_guest_address = mux(probe.virtualized, probe_entry.guest_ppn ++ probe.virtual_address[0..12], probe_physical.zext(64))
  def probe_fault_details = RiscvGuestFault():
    guest_virtual_address: probe.virtualized
    guest_physical_address: mux(probe_vs_demand_fault, bits(0, 64), probe_guest_address)
    access: RiscvGuestFaultAccess.Explicit
  probe_translation <== RV5StageTlbMapping():
    virtual_address: probe.virtual_address
    access: probe.access
    physical_address: probe_physical
    page_size: mux(probe_bare, Sv39PageSize.Page4KiB, probe_entry.page_size)
    guest_physical_address: mux(probe_bare, probe.virtual_address, probe_guest_address)
    vs_leaf: mux(probe_vs, probe_entry.vs_leaf, literal(Sv39Pte(), 0))
    g_leaf: mux(probe_g, probe_entry.g_leaf, literal(Sv39Pte(), 0))
    fault: mux(probe_bare & probe.virtual_address[56..64].or_reduce(), RV5StageTranslationFault.AccessFault, mux(probe_vs_demand_fault, RV5StageTranslationFault.PageFault, mux(probe_g_demand_fault, RV5StageTranslationFault.GuestPageFault, RV5StageTranslationFault.None)))
    fault_details: probe_fault_details
  probe_physical_address <== probe_physical
  // Svpbmt applies the G override first, then a non-PMA stage-one override.
  def probe_intermediate_pbmt = mux(probe_g, probe_entry.g_leaf.pbmt, PageMemoryType.PMA)
  probe_pbmt <== compose_page_memory_type(mux(probe_vs, probe_entry.vs_leaf.pbmt, PageMemoryType.PMA), probe_intermediate_pbmt)

  def fill_matches = vec(for List (index in 0..entry_count): rv5stage_tlb_matches(entries[index], fill.bits.request))
  def fill_index = mux(fill_matches.or_reduce(), priority_encoder(fill_matches), replacement)
  def next_entry = RV5StageTlbEntry():
    valid: Bool(#true)
    virtualized: fill.bits.request.virtualized
    page_size: fill.bits.result.page_size
    vpn: fill.bits.request.virtual_address[12..64]
    ppn: sv39_base_ppn(fill.bits.result.physical_address[12..56], fill.bits.result.page_size)
    guest_ppn: fill.bits.result.guest_physical_address[12..64]
    context: fill.bits.request.context
    vs_leaf: fill.bits.result.vs_leaf
    g_leaf: fill.bits.result.g_leaf
  when invalidate_all:
    entries <== literal(Vec(entry_count, RV5StageTlbEntry()), 0)
    replacement <== bits(0, index_bits)
  elsewhen (fill.valid & (fill.bits.result.fault === RV5StageTranslationFault.None)):
    entries <== entries.updated(fill_index, next_entry)
    replacement <== mux(fill_matches.or_reduce(), replacement, (replacement + bits(1, index_bits)) & bits(entry_count - 1, index_bits))

/* Projects the shared bank onto host-only ports without introducing a second entry store. */
sync_circuit RV5StageTlb(entry_count :: Pow2Int = 8):
  input virtual_address: Bits(64)
  input access: Sv39Access
  input privilege: PrivilegeMode
  input sum: Bool
  input mxr: Bool
  input enabled: Bool
  input invalidate_all: Bool
  input probe_virtual_address: Bits(64)
  input probe_privilege: PrivilegeMode
  input probe_sum: Bool
  input probe_mxr: Bool
  input probe_enabled: Bool
  input probe_access: Sv39Access
  interface fill(Valid(RV5StageTranslationResult()), ~role: consumer)
  output hit: Bool
  output fault: Bool
  output physical_address: Bits(56)
  output translation: RV5StageTranslationResult()
  output probe_hit: Bool
  output probe_fault: Bool
  output probe_demand_fault: Bool
  output probe_physical_address: Bits(56)
  output probe_pbmt: PageMemoryType

  inst bank(RV5StageTranslationTlb(entry_count))
  /* Builds the host adapter's lookup context with zero root identity and PBMT disabled. */
  fun host_lookup(address :: Bits(64), kind :: Sv39Access, mode :: PrivilegeMode, allow_user :: Bool, allow_execute :: Bool, paged :: Bool) :~ RV5StageTlbLookup():
    def request = RV5StageTranslationRequest():
      virtual_address: address
      root_ppn: bits(0, 44)
      access: kind
      privilege: mode
      sum: allow_user
      mxr: allow_execute
      pbmte: Bool(#false)
    rv5stage_host_lookup(request, ~enabled: paged)
  bank.lookup <== host_lookup(virtual_address, access, privilege, sum, mxr, enabled)
  bank.probe <== host_lookup(probe_virtual_address, probe_access, probe_privilege, probe_sum, probe_mxr, probe_enabled)
  bank.invalidate_all <== invalidate_all
  (
    fill |> map_valid(result => RV5StageTlbFill()):
      request: host_lookup(result.virtual_address, Sv39Access.Load, PrivilegeMode.Supervisor, Bool(#false), Bool(#false), Bool(#true))
      result: rv5stage_host_mapping(result)
  ) |> bank.fill
  hit <== bank.hit
  fault <== bank.hit & (bank.translation.fault === RV5StageTranslationFault.PageFault)
  physical_address <== bank.translation.physical_address
  translation <== rv5stage_host_result(bank.translation).updated(~fault: fault, ~pbmt: mux(enabled, bank.translation.vs_leaf.pbmt, PageMemoryType.PMA))
  probe_hit <== bank.probe_hit
  probe_fault <== bank.probe_fault
  probe_demand_fault <== bank.probe_demand_fault
  probe_physical_address <== bank.probe_physical_address
  probe_pbmt <== bank.probe_pbmt

export:
  RV5StageTlb
  RV5StageTranslationTlb
  RV5StageTlbEntry
