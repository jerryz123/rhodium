#lang rhodium
// Implements RV5Stage's fully associative Sv39 translation lookaside buffer.
// SPDX-License-Identifier: Apache-2.0

import:
  "protocol.rhdl" open
  "../csr.rhdl" open
  "../../../riscv/rtl/sv39.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/ready-valid.rhdl") open

bundle RV5StageTlbEntry():
  valid: Bool
  vpn: Bits(27)
  base_ppn: Bits(44)
  page_size: Sv39PageSize
  user: Bool
  read: Bool
  write: Bool
  execute: Bool
  global_mapping: Bool
  accessed: Bool
  dirty: Bool
  pbmt: PageMemoryType

fun rv5stage_tlb_entry_matches(entry :: RV5StageTlbEntry(), virtual_address :: Bits(64)) :~ Bool:
  entry.valid & sv39_same_page(entry.vpn ++ bits(0, 12), virtual_address[0..39], entry.page_size)

fun rv5stage_tlb_entry_pte(entry :: RV5StageTlbEntry()) :~ Sv39Pte():
  Sv39Pte():
    ppn: entry.base_ppn
    napot: Bool(#false)
    pbmt: entry.pbmt
    reserved: bits(0, 7)
    rsw: bits(0, 2)
    dirty: entry.dirty
    accessed: entry.accessed
    global_mapping: entry.global_mapping
    user: entry.user
    execute: entry.execute
    write: entry.write
    read: entry.read
    valid: Bool(#true)

sync_circuit RV5StageTlb(entry_count :: Pow2Int = 8):
  input virtual_address: Bits(64)
  input access: Sv39Access
  input privilege: PrivilegeMode
  input sum: Bool
  input mxr: Bool
  input enabled: Bool
  input invalidate_all: Bool
  input probe_virtual_address: Bits(64)
  input probe_privilege: PrivilegeMode
  input probe_sum: Bool
  input probe_mxr: Bool
  input probe_enabled: Bool
  interface fill(Valid(RV5StageTranslationResult()), ~role: consumer)
  output hit: Bool
  output fault: Bool
  output physical_address: Bits(56)
  output translation: RV5StageTranslationResult()
  output probe_hit: Bool
  output probe_fault: Bool
  output probe_physical_address: Bits(56)
  output probe_pbmt: PageMemoryType

  def index_bits = index_width(entry_count)
  reg entries(Vec(entry_count, RV5StageTlbEntry()), ~init: vec(
    for List (_index in 0..entry_count): literal(RV5StageTlbEntry(), 0)
  ))
  reg replacement(~init: bits(0, index_bits))

  def matches = vec(
    for List (index in 0..entry_count):
      entries[index].rv5stage_tlb_entry_matches(virtual_address)
  )
  def selected_index = priority_encoder(matches)
  def selected = entries[selected_index]
  def selected_pte = rv5stage_tlb_entry_pte(selected)
  def selected_hit = enabled & virtual_address.sv39_canonical() & matches.or_reduce()
  hit <== !enabled ||| selected_hit
  fault <== enabled & selected_hit & !selected_pte.sv39_permission_valid(access, privilege === PrivilegeMode.User, privilege === PrivilegeMode.Supervisor, sum, mxr)
  physical_address <== mux(enabled, sv39_physical_address(virtual_address, selected.base_ppn, selected.page_size), virtual_address[0..56])
  translation <== RV5StageTranslationResult():
    pbmt: mux(enabled, selected.pbmt, PageMemoryType.PMA)
    virtual_address: virtual_address
    physical_address: physical_address
    base_ppn: mux(enabled, selected.base_ppn, virtual_address[12..56])
    page_size: mux(enabled, selected.page_size, Sv39PageSize.Page4KiB)
    user: selected.user
    read: selected.read
    write: selected.write
    execute: selected.execute
    global_mapping: selected.global_mapping
    accessed: selected.accessed
    dirty: selected.dirty
    fault: fault
    access_fault: !enabled & virtual_address[56..64].or_reduce()

  def probe_matches = vec(
    for List (index in 0..entry_count):
      entries[index].rv5stage_tlb_entry_matches(probe_virtual_address)
  )
  def probe_selected = entries[priority_encoder(probe_matches)]
  def probe_pte = rv5stage_tlb_entry_pte(probe_selected)
  def selected_probe_hit = probe_enabled & probe_virtual_address.sv39_canonical() & probe_matches.or_reduce()
  probe_hit <== !probe_enabled ||| selected_probe_hit
  probe_pbmt <== mux(probe_enabled, probe_selected.pbmt, PageMemoryType.PMA)
  probe_fault <== probe_enabled & selected_probe_hit & !probe_pte.sv39_prefetch_permission_valid(probe_privilege === PrivilegeMode.User, probe_privilege === PrivilegeMode.Supervisor, probe_sum, probe_mxr)
  probe_physical_address <== mux(
    probe_enabled,
    sv39_physical_address(probe_virtual_address, probe_selected.base_ppn, probe_selected.page_size),
    probe_virtual_address[0..56]
  )

  when invalidate_all:
    entries <== vec(for List (_index in 0..entry_count): literal(RV5StageTlbEntry(), 0))
    replacement <== bits(0, index_bits)
  elsewhen (fill.valid & !fill.bits.fault & !fill.bits.access_fault):
    entries <== entries.updated(
      replacement,
      RV5StageTlbEntry():
        valid: Bool(#true)
        vpn: fill.bits.virtual_address[12..39]
        base_ppn: fill.bits.base_ppn
        page_size: fill.bits.page_size
        user: fill.bits.user
        read: fill.bits.read
        write: fill.bits.write
        execute: fill.bits.execute
        global_mapping: fill.bits.global_mapping
        accessed: fill.bits.accessed
        dirty: fill.bits.dirty
        pbmt: fill.bits.pbmt
    )
    replacement <== replacement + bits(1, index_bits)

export:
  RV5StageTlbEntry
  RV5StageTlb
