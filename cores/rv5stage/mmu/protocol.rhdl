#lang rhodium
// Defines RV5Stage's internal Sv39 lookup and page-table-memory protocols.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/rtl/sv39.rhdl" open
  "../../../riscv/rtl/hypervisor.rhdl" open
  "../csr.rhdl" open
  "../dcache/protocol.rhdl" open
  lib("rhodium/std/bits.rhdl").Pow2Int
  lib("rhodium/std/ready-valid.rhdl") open

// Only the virtual boundary carries guest access intent. Cache requests retain
// their physical ABI after the MMU consumes this captured instruction metadata.
bundle RV5StageGuestMemoryReq(T):
  memory: T
  translation: RiscvGuestMemoryAccess

interface RV5StageGuestDataAccess(xlen :: XLen, slots :: Pow2Int):
  role requester
  role responder
  provider requester
  requester -> responder:
    request: Decoupled(RV5StageGuestMemoryReq(RV5StageDataReq(xlen, slots)))
  responder -> requester:
    request_fault: Bool
    request_access_fault: Bool
    response: Decoupled(RV5StageDataResp(xlen, slots))
    drained: Bool
    reservation_valid: Bool

interface RV5StageGuestPipelineAccess(xlen :: XLen):
  role requester
  role responder
  provider requester
  requester -> responder:
    request: Valid(RV5StageGuestMemoryReq(RV5StagePipelineReq(xlen)))
    commit: Bool
  responder -> requester:
    response: Valid(RV5StagePipelineResult(xlen))
    commit_ready: Bool

bundle RV5StageTranslationRequest():
  virtual_address: Bits(64)
  root_ppn: Bits(44)
  access: Sv39Access
  privilege: PrivilegeMode
  sum: Bool
  mxr: Bool
  pbmte: Bool

bundle RV5StageTranslationResult():
  virtual_address: Bits(64)
  physical_address: Bits(56)
  base_ppn: Bits(44)
  page_size: Sv39PageSize
  user: Bool
  read: Bool
  write: Bool
  execute: Bool
  global_mapping: Bool
  accessed: Bool
  dirty: Bool
  fault: Bool
  access_fault: Bool
  pbmt: PageMemoryType

// One nonspeculative macro owns the checked range until release. A false
// response selects exact element execution; it is never an architectural fault.
bundle RV5StageVectorRange():
  first: Bits(64)
  last: Bits(64)
  store: Bool

// A speculative single-page proof travels with its instruction from MEM;
// each vector request uses its captured mapping independently of the fallback window.
bundle RV5StageVectorFastCertificate(xlen :: XLen):
  range: RV5StageVectorRange()
  ppn: Bits(44)
  virtualized: Bool
  context: RiscvGuestTranslationContext()
  invalidation_epoch: Bits(2)

interface RV5StageVectorFastCheck(xlen :: XLen):
  role requester
  role responder
  provider requester
  requester -> responder:
    request: Valid(RV5StageVectorRange())
    candidate: RV5StageVectorFastCertificate(xlen)
    pipeline_physical: Bool
    request_physical: Bool
  responder -> requester:
    response: Valid(RV5StageVectorFastCertificate(xlen))
    candidate_current: Bool

bundle RV5StagePageProbeRequest():
  address: Bits(64)
  store: Bool

interface RV5StagePageProbe():
  role requester
  role responder
  provider requester
  requester -> responder:
    request: Decoupled(RV5StagePageProbeRequest())
  responder -> requester:
    response: Valid(RV5StageTranslationResult())

interface RV5StageVectorPrecheck():
  role requester
  role responder
  provider requester
  requester -> responder:
    request: Decoupled(RV5StageVectorRange())
    release: Pulse()
  responder -> requester:
    response: Irrevocable(Bool)

interface RV5StagePageTableMemory():
  role requester
  role responder
  provider requester

  requester -> responder:
    request: Decoupled(Bits(64))

  responder -> requester:
    request_access_fault: Bool
    response: Valid(Bits(64))

export:
  RV5StageGuestMemoryReq
  RV5StageGuestDataAccess
  RV5StageGuestPipelineAccess
  RV5StageTranslationRequest
  RV5StageTranslationResult
  RV5StagePageTableMemory
  RV5StageVectorRange
  RV5StageVectorFastCertificate
  RV5StageVectorFastCheck
  RV5StageVectorPrecheck
  RV5StagePageProbeRequest
  RV5StagePageProbe
