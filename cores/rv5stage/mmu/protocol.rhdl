#lang rhodium
// Defines RV5Stage's internal Sv39 lookup and page-table-memory protocols.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../riscv/rtl/sv39.rhdl" open
  "../csr.rhdl" open
  lib("rhodium/std/ready-valid.rhdl") open

bundle RV5StageTranslationRequest():
  virtual_address: Bits(64)
  root_ppn: Bits(44)
  access: Sv39Access
  privilege: PrivilegeMode
  sum: Bool
  mxr: Bool

bundle RV5StageTranslationResult():
  virtual_address: Bits(64)
  physical_address: Bits(56)
  ppn: Bits(44)
  level: Bits(2)
  user: Bool
  read: Bool
  write: Bool
  execute: Bool
  global_mapping: Bool
  accessed: Bool
  dirty: Bool
  fault: Bool
  access_fault: Bool

// One nonspeculative macro owns the checked range until release. A false
// response selects exact element execution; it is never an architectural fault.
bundle RV5StageVectorRange():
  first: Bits(64)
  last: Bits(64)
  store: Bool

bundle RV5StagePageProbeRequest():
  address: Bits(64)
  store: Bool

interface RV5StagePageProbe():
  role requester
  role responder
  provider requester
  requester -> responder:
    request: Decoupled(RV5StagePageProbeRequest())
  responder -> requester:
    response: Valid(RV5StageTranslationResult())

interface RV5StageVectorPrecheck():
  role requester
  role responder
  provider requester
  requester -> responder:
    request: Decoupled(RV5StageVectorRange())
    release: Pulse()
  responder -> requester:
    response: Irrevocable(Bool)

interface RV5StagePageTableMemory():
  role requester
  role responder
  provider requester

  requester -> responder:
    request: Decoupled(Bits(64))

  responder -> requester:
    request_access_fault: Bool
    response: Valid(Bits(64))

export:
  RV5StageTranslationRequest
  RV5StageTranslationResult
  RV5StagePageTableMemory
  RV5StageVectorRange
  RV5StageVectorPrecheck
  RV5StagePageProbeRequest
  RV5StagePageProbe
