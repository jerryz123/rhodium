#lang rhodium
/* Defines RV5Stage's guest-aware pipeline requests, split completions, and vector translation interfaces. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../../cache/protocol.rhdl" open
  "../../misaligned-access.rhdl".RiscvSplitResult
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/rtl/hypervisor.rhdl" open
  lib("cores/mmu/protocol.rhdl").RiscvTranslationResult
  "../memory-context.rhdl" open
  lib("rhodium/std/bits.rhdl").Pow2Int
  lib("rhodium/std/ready-valid.rhdl") open

/* Wraps a virtual memory request with captured guest-access intent, consumed before cache
   dispatch. */
bundle RV5StageGuestMemoryReq(T):
  memory: T
  translation: RiscvGuestMemoryAccess

/* Carries authorized guest-aware virtual requests, fault indications, and tagged completions. */
interface RV5StageGuestDataAccess(xlen :: XLen, slots :: Pow2Int):
  role requester
  role responder
  provider requester
  requester -> responder:
    request: Decoupled(RV5StageGuestMemoryReq(PhysicalMemoryReq(xlen, RV5StageMemoryContext(slots))))
  responder -> requester:
    request_fault: Bool
    request_access_fault: Bool
    response: Decoupled(PhysicalMemoryResp(xlen, RV5StageMemoryContext(slots)))
    drained: Bool
    reservation_valid: Bool

/* Carries speculative guest-aware lookups with separate WB store authorization. */
interface RV5StageGuestPipelineAccess(xlen :: XLen):
  role requester
  role responder
  provider requester
  requester -> responder:
    request: Valid(RV5StageGuestMemoryReq(CachePipelineReq(xlen)))
    commit: Bool
  responder -> requester:
    response: Valid(CachePipelineResult(xlen))
    commit_ready: Bool

/* Bounds one nonspeculative vector macro's virtual byte range and required permission.
   A false check selects exact element execution, never an architectural fault. */
bundle RV5StageVectorRange():
  first: Bits(64)
  last: Bits(64)
  store: Bool

/* Carries a speculative single-page mapping and exact context/epoch identity from MEM
   for WB validation, independently of the retained fallback page window. */
bundle RV5StageVectorFastCertificate(xlen :: XLen):
  range: RV5StageVectorRange()
  ppn: Bits(44)
  virtualized: Bool
  context: RiscvGuestTranslationContext()
  invalidation_epoch: Bits(2)

/* Checks and revalidates single-page vector certificates separately from the retained page
   window. */
interface RV5StageVectorFastCheck(xlen :: XLen):
  role requester
  role responder
  provider requester
  requester -> responder:
    request: Valid(RV5StageVectorRange())
    candidate: RV5StageVectorFastCertificate(xlen)
    pipeline_physical: Bool
    request_physical: Bool
  responder -> requester:
    response: Valid(RV5StageVectorFastCertificate(xlen))
    candidate_current: Bool

/* Requests a page mapping with the vector macro's access direction. */
bundle RV5StagePageProbeRequest():
  address: Bits(64)
  store: Bool

/* Transfers a page lookup or walk and returns an unbackpressured host-shaped result. */
interface RV5StagePageProbe():
  role requester
  role responder
  provider requester
  requester -> responder:
    request: Decoupled(RV5StagePageProbeRequest())
  responder -> requester:
    response: Valid(RiscvTranslationResult())

/* Retains a macro's range check until its decision transfers, then owns the window until
   release. */
interface RV5StageVectorPrecheck():
  role requester
  role responder
  provider requester
  requester -> responder:
    request: Decoupled(RV5StageVectorRange())
    release: Pulse()
  responder -> requester:
    response: Irrevocable(Bool)

export:
  RiscvSplitResult
  RV5StageGuestMemoryReq
  RV5StageGuestDataAccess
  RV5StageGuestPipelineAccess
  RV5StageVectorRange
  RV5StageVectorFastCertificate
  RV5StageVectorFastCheck
  RV5StageVectorPrecheck
  RV5StagePageProbeRequest
  RV5StagePageProbe
