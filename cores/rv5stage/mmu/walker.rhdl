#lang rhodium
// Implements RV5Stage's serialized non-speculative Sv39 page-table walker.

import:
  "protocol.rhdl" open
  "../csr.rhdl" open
  "../../../riscv/rtl/sv39.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/ready-valid.rhdl") open

hardware_enum RV5StagePageWalkState:
  Idle
  Request
  Response
  Complete

sync_circuit RV5StagePageTableWalker():
  interface request(Decoupled(RV5StageTranslationRequest()), ~role: consumer)
  interface completion(Irrevocable(RV5StageTranslationResult()), ~role: producer)
  interface memory(RV5StagePageTableMemory(), ~role: requester)
  input cancel: Bool

  reg state(~init: RV5StagePageWalkState.Idle)
  reg operation(RV5StageTranslationRequest())
  reg level(~init: bits(2, 2))
  reg table_ppn(Bits(44))
  reg global_mapping(~init: Bool(#false))
  reg result(RV5StageTranslationResult())

  request.ready <== state === RV5StagePageWalkState.Idle
  def request_fire = request.fire()
  def vpn_index = sv39_vpn(operation.virtual_address, level)
  memory.request.valid <== state === RV5StagePageWalkState.Request
  memory.request.bits <== (table_ppn ++ bits(0, 12)).zext(64) + (vpn_index ++ bits(0, 3)).zext(64)
  def memory_request_fire = memory.request.fire()
  memory.response.ready <== state === RV5StagePageWalkState.Response
  def memory_response_fire = memory.response.fire()
  def pte = memory.response.bits.into(Sv39Pte())
  def leaf = sv39_leaf(pte)
  def structural_fault = !sv39_pte_structurally_valid(pte) ||| (
    leaf & !sv39_superpage_aligned(pte, level)
  ) ||| (!leaf & ((level === bits(0, 2)) ||| pte.dirty ||| pte.accessed ||| pte.user))
  def permission_fault = leaf & !sv39_permission_valid(
    pte,
    operation.access,
    operation.privilege === PrivilegeMode.User,
    operation.privilege === PrivilegeMode.Supervisor,
    operation.sum,
    operation.mxr
  )
  def completes_walk = structural_fault ||| leaf
  def walk_fault = structural_fault ||| permission_fault

  completion.valid <== state === RV5StagePageWalkState.Complete
  completion.bits <== result
  def completion_fire = completion.fire()

  when cancel:
    state <== RV5StagePageWalkState.Idle
  elsewhen request_fire:
    operation <== request.bits
    level <== bits(2, 2)
    table_ppn <== request.bits.root_ppn
    global_mapping <== Bool(#false)
    when (sv39_canonical(request.bits.virtual_address)):
      state <== RV5StagePageWalkState.Request
    elsewhen (!sv39_canonical(request.bits.virtual_address)):
      state <== RV5StagePageWalkState.Complete
      result <== RV5StageTranslationResult():
        virtual_address: request.bits.virtual_address
        physical_address: bits(0, 56)
        ppn: bits(0, 44)
        level: bits(0, 2)
        user: Bool(#false)
        read: Bool(#false)
        write: Bool(#false)
        execute: Bool(#false)
        global_mapping: Bool(#false)
        accessed: Bool(#false)
        dirty: Bool(#false)
        fault: Bool(#true)
        access_fault: Bool(#false)
  elsewhen (memory_request_fire & memory.request_access_fault):
    state <== RV5StagePageWalkState.Complete
    result <== RV5StageTranslationResult():
      virtual_address: operation.virtual_address
      physical_address: bits(0, 56)
      ppn: bits(0, 44)
      level: level
      user: Bool(#false)
      read: Bool(#false)
      write: Bool(#false)
      execute: Bool(#false)
      global_mapping: Bool(#false)
      accessed: Bool(#false)
      dirty: Bool(#false)
      fault: Bool(#false)
      access_fault: Bool(#true)
  elsewhen (memory_request_fire & !memory.request_access_fault):
    state <== RV5StagePageWalkState.Response
  elsewhen memory_response_fire:
    when completes_walk:
      state <== RV5StagePageWalkState.Complete
      result <== RV5StageTranslationResult():
        virtual_address: operation.virtual_address
        physical_address: sv39_physical_address(operation.virtual_address, pte, level)
        ppn: pte.ppn
        level: level
        user: pte.user
        read: pte.read
        write: pte.write
        execute: pte.execute
        global_mapping: global_mapping ||| pte.global_mapping
        accessed: pte.accessed
        dirty: pte.dirty
        fault: walk_fault
        access_fault: Bool(#false)
    elsewhen (!completes_walk):
      state <== RV5StagePageWalkState.Request
      level <== level - bits(1, 2)
      table_ppn <== pte.ppn
      global_mapping <== global_mapping ||| pte.global_mapping
  elsewhen completion_fire:
    state <== RV5StagePageWalkState.Idle

export:
  RV5StagePageWalkState
  RV5StagePageTableWalker
