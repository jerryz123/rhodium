#lang rhodium
// Implements RV5Stage's serialized non-speculative Sv39 page-table walker.
// SPDX-License-Identifier: Apache-2.0

import:
  "protocol.rhdl" open
  "../csr.rhdl" open
  "../../../riscv/rtl/sv39.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

hardware_enum RV5StagePageWalkState:
  Idle
  Request
  Response
  Complete

sync_circuit RV5StagePageTableWalker(~svnapot: svnapot :: Boolean = #false):
  interface request(Decoupled(RV5StageTranslationRequest()), ~role: consumer)
  interface completion(Irrevocable(RV5StageTranslationResult()), ~role: producer)
  interface memory(RV5StagePageTableMemory(), ~role: requester)
  input cancel: Bool

  reg state(~init: RV5StagePageWalkState.Idle)
  reg operation(RV5StageTranslationRequest())
  reg level(~init: bits(2, 2))
  reg table_ppn(Bits(44))
  reg global_mapping(~init: Bool(#false))
  reg result(RV5StageTranslationResult())

  // Cancellation wins over an offered admission in the functional state machine.
  def walking = request |> trace_event("mmu/walk", ~when: !cancel, ~residency: "walk", ~fields: translation):
    virtual_address: translation.virtual_address
    access(~format: "enum"): translation.access
    privilege(~format: "enum"): translation.privilege
  walking.ready <== state === RV5StagePageWalkState.Idle
  def request_fire = request.fire()
  def vpn_index = operation.virtual_address.sv39_vpn(level)
  memory.request.valid <== state === RV5StagePageWalkState.Request
  memory.request.bits <== (table_ppn ++ bits(0, 12)).zext(64) + (vpn_index ++ bits(0, 3)).zext(64)
  def memory_request_fire = memory.request.fire()
  def waiting_for_memory = state === RV5StagePageWalkState.Response
  assert(!memory.response.valid ||| waiting_for_memory, "rv5stage_ptw_response_expected")
  def memory_response_received = memory.response.valid & waiting_for_memory
  def pte = memory.response.bits.into(Sv39Pte())
  def leaf = pte.sv39_leaf()
  def structural_fault = !sv39_pte_structurally_valid(pte, ~level: level, ~svnapot: svnapot, ~pbmte: operation.pbmte) ||| (
    leaf & !pte.sv39_superpage_aligned(level)
  ) ||| (!leaf & ((level === bits(0, 2)) ||| pte.dirty ||| pte.accessed ||| pte.user))
  def permission_fault = leaf & !pte.sv39_permission_valid(operation.access, operation.privilege === PrivilegeMode.User, operation.privilege === PrivilegeMode.Supervisor, operation.sum, operation.mxr)
  def completes_walk = structural_fault ||| leaf
  def walk_fault = structural_fault ||| permission_fault
  def page_size = sv39_page_size(pte, level)
  def base_ppn = sv39_base_ppn(pte.ppn, page_size)

  completion.valid <== state === RV5StagePageWalkState.Complete
  completion.bits <== result
  def completion_fire = completion.fire()
  def occupied = state =/= RV5StagePageWalkState.Idle
  describe_interface_retained_storage(request_fire & !cancel, occupied & (completion_fire ||| cancel), occupied, ~name: "walk")
  describe_interface_contract(walking, Array(memory.request, completion), "walk-outputs", ~trace_model: interface_trace_retained(~name: "walk", ~outputs: 2))

  when cancel:
    state <== RV5StagePageWalkState.Idle
  elsewhen request_fire:
    operation <== request.bits
    level <== bits(2, 2)
    table_ppn <== request.bits.root_ppn
    global_mapping <== Bool(#false)
    when (request.bits.virtual_address.sv39_canonical()):
      state <== RV5StagePageWalkState.Request
    elsewhen (!request.bits.virtual_address.sv39_canonical()):
      state <== RV5StagePageWalkState.Complete
      result <== RV5StageTranslationResult():
        virtual_address: request.bits.virtual_address
        physical_address: bits(0, 56)
        base_ppn: bits(0, 44)
        page_size: Sv39PageSize.Page4KiB
        user: Bool(#false)
        read: Bool(#false)
        write: Bool(#false)
        execute: Bool(#false)
        global_mapping: Bool(#false)
        accessed: Bool(#false)
        dirty: Bool(#false)
        fault: Bool(#true)
        access_fault: Bool(#false)
        pbmt: PageMemoryType.PMA
  elsewhen (memory_request_fire & memory.request_access_fault):
    state <== RV5StagePageWalkState.Complete
    result <== RV5StageTranslationResult():
      virtual_address: operation.virtual_address
      physical_address: bits(0, 56)
      base_ppn: bits(0, 44)
      page_size: Sv39PageSize.Page4KiB
      user: Bool(#false)
      read: Bool(#false)
      write: Bool(#false)
      execute: Bool(#false)
      global_mapping: Bool(#false)
      accessed: Bool(#false)
      dirty: Bool(#false)
      fault: Bool(#false)
      access_fault: Bool(#true)
      pbmt: PageMemoryType.PMA
  elsewhen (memory_request_fire & !memory.request_access_fault):
    state <== RV5StagePageWalkState.Response
  elsewhen memory_response_received:
    when completes_walk:
      state <== RV5StagePageWalkState.Complete
      result <== RV5StageTranslationResult():
        virtual_address: operation.virtual_address
        pbmt: mux(walk_fault, PageMemoryType.PMA, pte.pbmt)
        physical_address: sv39_physical_address(operation.virtual_address, base_ppn, page_size)
        base_ppn: base_ppn
        page_size: page_size
        user: pte.user
        read: pte.read
        write: pte.write
        execute: pte.execute
        global_mapping: global_mapping ||| pte.global_mapping
        accessed: pte.accessed
        dirty: pte.dirty
        fault: walk_fault
        access_fault: Bool(#false)
    elsewhen (!completes_walk):
      state <== RV5StagePageWalkState.Request
      level <== level - bits(1, 2)
      table_ppn <== pte.ppn
      global_mapping <== global_mapping ||| pte.global_mapping
  elsewhen completion_fire:
    state <== RV5StagePageWalkState.Idle

export:
  RV5StagePageWalkState
  RV5StagePageTableWalker
