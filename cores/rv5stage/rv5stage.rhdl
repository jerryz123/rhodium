#lang rhodium
// Composes RV5Stage's core and L1 caches with annotated outer CHI transfers.

import:
  "../cache-prefetch.rhdl" open
  "core.rhdl" open
  "interrupt.rhdl" open
  "chi/foundation.rhdl" open
  "profile.rhm" open
  "cache.rhdl" open
  "icache/cache.rhdl" open
  "dcache/cache.rhdl" open
  "memory-router.rhdl" open
  "instruction-memory-router.rhdl" open
  "chi/uncached.rhdl" open
  "mmu/mmu.rhdl" open
  lib("flow/main.rhdl") open
  lib("rhodium/std/ready-valid.rhdl") open
  lib("chi/protocol/channels.rhdl") open

// Observe accepted flits at the private-cache boundary. CHI transaction state
// and the outer fabric are opaque to lineage inference, so each channel starts
// and ends its own observation; transaction IDs are captures, not parent IDs.
fun connect_traced_cache_chi(cache :: Endpoint, outer :: Endpoint, label :: String):
  def requests = cache.field("requests") |> trace_event(label ++ ".txreq", ~root: #true, ~terminal: #true, ~fields: flit):
    address: flit.address
    opcode(~format: "enum", ~label: #true): flit.opcode
    txn_id(~format: "unsigned"): flit.txn_id
    src_id(~format: "unsigned"): flit.src_id
    tgt_id(~format: "unsigned"): flit.tgt_id
    size_or_num_req(~format: "unsigned"): flit.size_or_num_req
    allow_retry: flit.allow_retry
    exp_comp_ack: flit.exp_comp_ack
  requests |> outer.field("requests")

  for (channel in ["requester_responses", "responses"], suffix in ["txrsp", "rxrsp"], outgoing in [#true, #false]):
    def source = if outgoing | cache.field(channel) | outer.field(channel)
    def sink = if outgoing | outer.field(channel) | cache.field(channel)
    def responses = source |> trace_event(label ++ "." ++ suffix, ~root: #true, ~terminal: #true, ~fields: flit):
      opcode(~format: "enum", ~label: #true): flit.opcode
      txn_id(~format: "unsigned"): flit.txn_id
      src_id(~format: "unsigned"): flit.src_id
      tgt_id(~format: "unsigned"): flit.tgt_id
      dbid_or_group_id(~format: "unsigned"): flit.dbid_or_group_id
      resp(~format: "unsigned"): flit.resp
      resp_err(~format: "unsigned"): flit.resp_err
      pcrd_type(~format: "unsigned"): flit.pcrd_type
    responses |> sink

  for (channel in ["request_data", "response_data"], suffix in ["txdat", "rxdat"], outgoing in [#true, #false]):
    def source = if outgoing | cache.field(channel) | outer.field(channel)
    def sink = if outgoing | outer.field(channel) | cache.field(channel)
    def data = source |> trace_event(label ++ "." ++ suffix, ~root: #true, ~terminal: #true, ~fields: flit):
      opcode(~format: "enum", ~label: #true): flit.opcode
      txn_id(~format: "unsigned"): flit.txn_id
      src_id(~format: "unsigned"): flit.src_id
      tgt_id(~format: "unsigned"): flit.tgt_id
      dbid_or_mecid(~format: "unsigned"): flit.dbid_or_mecid
      data_id(~format: "unsigned"): flit.data_id
      resp(~format: "unsigned"): flit.resp
      resp_err(~format: "unsigned"): flit.resp_err
      byte_enable: flit.byte_enable
    data |> sink

  def snoops = outer.field("snoops") |> trace_event(label ++ ".rxsnp", ~root: #true, ~terminal: #true, ~fields: flit):
    address: flit.address ++ bits(0, 3)
    opcode(~format: "enum", ~label: #true): flit.opcode
    txn_id(~format: "unsigned"): flit.txn_id
    src_id(~format: "unsigned"): flit.src_id
    ret_to_src: flit.ret_to_src
  snoops |> cache.field("snoops")

sync_circuit RV5Stage(profile :: RVCoreProfile,
                      ~reset_address: reset_address :: Nat,
                      ~chi: config :: RV5StageCHIConfig,
                      ~btb_entries: btb_entries :: Nat = 16):
  def xlen = profile.xlen
  def extensions = profile.extensions
  def width = xlen.width
  def p = config.flit

  // These advertisements constrain the integration, not instruction decode.
  for (region in config.regions):
    def attributes = region.physical.attributes
    unless (!attributes.cacheable) || (!extensions.ziccif) || attributes.executable
    | error(~who: #'RV5Stage, "Ziccif requires executable cacheable coherent memory")
    unless (!attributes.cacheable) || (!extensions.ziccamoa) || attributes.atomic
    | error(~who: #'RV5Stage, "Ziccamoa requires AMOArithmetic in cacheable coherent memory")

  input chi_identity: RV5StageCHIIdentity(p)
  input interrupts: RV5StageInterrupts()
  input hart_id: Bits(width)
  input time_counter: Bits(64)
  interface imem(CHIRNChannels(p), ~role: node)
  interface dmem(CHIRNChannels(p), ~role: node)
  interface umem(CHIRNIChannels(p), ~role: node)

  inst core(RV5StageCore(profile, ~reset_address: reset_address, ~btb_entries: btb_entries))
  inst mmu(RV5StageMmu(xlen, profile.mmu_mode, config.physical_map))
  inst l1i(RV5StageL1ICache(xlen, profile.cache_geometry.instruction, ~chi: config))
  inst l1d(RV5StageL1DCache(xlen, profile.cache_geometry.data, ~chi: config))
  inst instruction_memory_router(RV5StageInstructionMemoryRouter(xlen))
  inst memory_router(RV5StageMemoryRouter(xlen, config.physical_map))
  inst uncached(RV5StageUncached(xlen, config))
  l1i.node_id <== chi_identity.instruction_node_id
  l1d.node_id <== chi_identity.data_node_id
  uncached.node_id <== chi_identity.uncached_node_id
  core.interrupts <== interrupts
  core.hart_id <== hart_id
  core.time_counter <== time_counter
  core.instruction_access |> mmu.instruction
  core.data_access |> mmu.data
  mmu.instruction_lookup |> l1i.virtual_lookup
  mmu.data_lookup |> l1d.virtual_lookup
  core.prefetch |> mmu.prefetch
  def physical_prefetch_request = mmu.physical_prefetch.bits.into(CachePrefetchReq(width))
  def instruction_prefetch_selected = physical_prefetch_request.operation === CachePrefetchOperation.Instruction
  def data_prefetch_selected = physical_prefetch_request.operation.is_one_of(CachePrefetchOperation.Read, CachePrefetchOperation.Write)
  def Array(instruction_prefetch, data_prefetch) = mmu.physical_prefetch |> fork_valid(2)
  instruction_prefetch |> filter_valid(_request => instruction_prefetch_selected) |> l1i.prefetch
  data_prefetch |> filter_valid(_request => data_prefetch_selected) |> l1d.prefetch
  mmu.instruction_memory |> instruction_memory_router.core
  instruction_memory_router.cache |> l1i.core
  instruction_memory_router.uncached |> uncached.instruction
  mmu.data_memory |> memory_router.core
  memory_router.cache |> l1d.core
  memory_router.uncached |> uncached.core
  mmu.privilege <== core.privilege
  mmu.mstatus <== core.mstatus
  mmu.satp <== core.satp
  mmu.invalidate_all <== core.translation_flush
  connect_traced_cache_chi(l1i.chi, imem, "icache")
  connect_traced_cache_chi(l1d.chi, dmem, "dcache")
  uncached.chi <=> umem

export:
  RV5Stage
