#lang rhodium
/* Carries opaque ownership through the selected shared integer execution services. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../common/integer-execution.rhdl" open
  "../common/multiplier.rhdl" open
  "../common/divider.rhdl" open
  "../common/integer-service.rhdl" open
  "profile.rhm".RV5StageMultiplierKind
  lib("flow/main.rhdl") open

/* Selects the profile's iterative or pipelined multiplier behind one tagged interface. */
sync_circuit RV5StageMultiplyService(kind :: RV5StageMultiplierKind, width :: PosInt, Tag :: DataType, ~scheduled_writeback: scheduled_writeback :: Boolean = #false):
  interface request(Decoupled(IntegerExecutionRequest(MultiplierRequest(width), Tag)), ~role: consumer)
  interface result(Irrevocable(IntegerExecutionResult(Bits(width * 2), Tag)), ~role: producer)
  def Service = if kind == RV5StageMultiplierKind.Iterative | IterativeMultiplyService(width, Tag) | PipelinedMultiplyService(width, Tag, ~scheduled_writeback: scheduled_writeback)
  inst selected(Service)
  request |> selected.request
  selected.result |> result


/* Select the shared port from resident scalar ownership, independently of final
   Decode admission. A queued vector wins a fresh contest; after it transfers,
   a waiting scalar gets one idle edge to claim the service, not an indefinite
   lock if another Decode hazard prevents issue. */
sync_circuit RV5StageDivideOwnership(Request :: DataType):
  input busy: Bool
  input reserved: Bool
  input scalar_waiting: Bool
  output scalar_available: Bool
  interface scalar(Decoupled(Request), ~role: consumer)
  interface vector(Decoupled(Request), ~role: consumer)
  interface request(Decoupled(Request), ~role: producer)

  reg scalar_turn(~init: Bool(#false))
  scalar_available <== !busy & !reserved & (scalar_turn ||| !vector.valid)

  inst selection(GrantMerge(Request, 2))
  selection.grants <== vec([reserved, !reserved]).into(MaybeOneHot(2))
  scalar |> selection.ingress[0]
  vector |> gate_flow(!scalar_turn) |> selection.ingress[1]
  selection.egress |> request

  when (vector.fire()):
    scalar_turn <== scalar_waiting
  elsewhen (!scalar_waiting ||| reserved ||| !busy):
    scalar_turn <== Bool(#false)

  when (scalar.valid):
    assert(reserved, "scalar_divider_launch_has_pipeline_owner")


/* Capture the arbitrated operands before the divider's magnitude and early-out
   logic. The handoff is the first cycle of a single reservation, not a queue
   for another division. A consumed result may be replaced on the same edge. */
sync_circuit RV5StageDivideService(width :: PosInt, Tag :: DataType):
  interface request(Decoupled(IntegerExecutionRequest(DividerRequest(width), Tag)), ~role: consumer)
  interface result(Irrevocable(IntegerExecutionResult(DividerResponse(width), Tag)), ~role: producer)
  output busy: Bool

  inst execution(DivideService(width, Tag))
  execution.result |> result
  reg occupied(~init: Bool(#false))
  busy <== occupied
  request |> gate_flow(!occupied ||| result.fire()) |> pipe(1) |> execution.request
  when (request.fire()):
    occupied <== Bool(#true)
  elsewhen (result.fire()):
    occupied <== Bool(#false)

export:
  RV5StageMultiplyService
  RV5StageDivideOwnership
  RV5StageDivideService
