#lang rhodium
/* Carries opaque ownership through the selected shared integer execution services. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../integer-execution.rhdl" open
  "../multiplier.rhdl" open
  "../integer-service.rhdl" open
  "profile.rhm".RV5StageMultiplierKind
  lib("flow/main.rhdl") open

/* Selects the profile's iterative or pipelined multiplier behind one tagged interface. */
sync_circuit RV5StageMultiplyService(kind :: RV5StageMultiplierKind, width :: PosInt, Tag :: DataType, ~scheduled_writeback: scheduled_writeback :: Boolean = #false):
  interface request(Decoupled(IntegerExecutionRequest(MultiplierRequest(width), Tag)), ~role: consumer)
  interface result(Irrevocable(IntegerExecutionResult(Bits(width * 2), Tag)), ~role: producer)
  def Service = if kind == RV5StageMultiplierKind.Iterative | IterativeMultiplyService(width, Tag) | PipelinedMultiplyService(width, Tag, ~scheduled_writeback: scheduled_writeback)
  inst selected(Service)
  request |> selected.request
  selected.result |> result


export:
  RV5StageMultiplyService
