#lang rhodium
// Carries opaque ownership through the selected shared integer execution services.
// SPDX-License-Identifier: Apache-2.0

import:
  "../multiplier.rhdl" open
  "../divider.rhdl" open
  "profile.rhm".RV5StageMultiplierKind
  lib("flow/main.rhdl") open

bundle RV5StageExecutionRequest(Operands :: DataType, Tag :: DataType):
  tag: Tag
  operands: Operands

bundle RV5StageExecutionResult(Value :: DataType, Tag :: DataType):
  tag: Tag
  value: Value

fun integer_request_with_tag(Operands :: DataType, From :: DataType, To :: DataType, request :: RV5StageExecutionRequest(Operands, From), tag :: Hardware.of(To)) :~ RV5StageExecutionRequest(Operands, To):
  RV5StageExecutionRequest(Operands, To):
    tag: tag
    operands: request.operands

fun integer_result_with_tag(Value :: DataType, From :: DataType, To :: DataType, result :: RV5StageExecutionResult(Value, From), tag :: Hardware.of(To)) :~ RV5StageExecutionResult(Value, To):
  RV5StageExecutionResult(Value, To):
    tag: tag
    value: result.value

sync_circuit RV5StageIterativeMultiplyService(width :: PosInt, Tag :: DataType):
  interface request(Decoupled(RV5StageExecutionRequest(MultiplierRequest(width), Tag)), ~role: consumer)
  interface result(Irrevocable(RV5StageExecutionResult(Bits(width * 2), Tag)), ~role: producer)
  inst execution(IterativeMultiplier(width))
  reg owner(Tag)
  request |> map_flow(operation => operation.operands) |> execution.request
  when (request.fire()):
    owner <== request.bits.tag
  (
    execution.response |> map_flow(~stable: #true, value => RV5StageExecutionResult(Bits(width * 2), Tag)):
      tag: owner
      value: value
  ) |> result

sync_circuit RV5StagePipelinedMultiplyService(width :: PosInt, Tag :: DataType, ~scheduled_writeback: scheduled_writeback :: Boolean = #false):
  def capacity = PipelinedMultiplierStages + 1
  def count_width = index_width(capacity + 1)
  def Result = RV5StageExecutionResult(Bits(width * 2), Tag)
  interface request(Decoupled(RV5StageExecutionRequest(MultiplierRequest(width), Tag)), ~role: consumer)
  interface result(Irrevocable(Result), ~role: producer)
  inst execution(PipelinedMultiplier(width))
  wire capacity_available: Bool
  def launched = request |> gate_flow(capacity_available) |> to_valid()
  def Array(operand_path, owner_path) = launched |> fork_valid(2)
  operand_path |> map_valid(operation => operation.operands) |> execution.request
  def owner = owner_path |> map_valid(operation => operation.tag) |> valid_pipe(PipelinedMultiplierStages)
  def completion = execution.response |> map_valid(value):
    RV5StageExecutionResult(Bits(width * 2), Tag):
      tag: owner.bits
      value: value
  assert(execution.response.valid === owner.valid)
  if scheduled_writeback
  | block:
      // The caller reserves the physical destination before accepting launch.
      // The Irrevocable response never stalls in this stronger timing contract.
      capacity_available <== Bool(#true)
      result.valid <== completion.valid
      result.bits <== completion.bits
      assert(!result.valid ||| result.ready, "scheduled_multiply_writes_on_return")
      describe_interface_contract(completion, result, "data", ~kind: "scheduled-writeback", ~trace_model: interface_trace_combinational())
  | block:
      // Standalone clients with arbitrary sink backpressure use the elastic
      // adapter. The integrated core selects scheduled writeback instead.
      inst completed(Queue(Result, capacity))
      reg outstanding(~init: bits(0, count_width))
      completed.egress |> result
      completion |> to_decoupled() |> completed.ingress
      capacity_available <== (outstanding =/= bits(capacity, count_width)) ||| result.fire()
      when (launched.valid & !result.fire()):
        outstanding <== outstanding + bits(1, count_width)
      elsewhen (result.fire() & !launched.valid):
        outstanding <== outstanding - bits(1, count_width)

sync_circuit RV5StageMultiplyService(kind :: RV5StageMultiplierKind, width :: PosInt, Tag :: DataType, ~scheduled_writeback: scheduled_writeback :: Boolean = #false):
  interface request(Decoupled(RV5StageExecutionRequest(MultiplierRequest(width), Tag)), ~role: consumer)
  interface result(Irrevocable(RV5StageExecutionResult(Bits(width * 2), Tag)), ~role: producer)
  def Service = if kind == RV5StageMultiplierKind.Iterative | RV5StageIterativeMultiplyService(width, Tag) | RV5StagePipelinedMultiplyService(width, Tag, ~scheduled_writeback: scheduled_writeback)
  inst selected(Service)
  request |> selected.request
  selected.result |> result

sync_circuit RV5StageDivideService(width :: PosInt, Tag :: DataType):
  interface request(Decoupled(RV5StageExecutionRequest(DividerRequest(width), Tag)), ~role: consumer)
  interface result(Irrevocable(RV5StageExecutionResult(DividerResponse(width), Tag)), ~role: producer)
  inst execution(IterativeDivider(width))
  reg owner(Tag)
  request |> map_flow(operation => operation.operands) |> execution.request
  when (request.fire()):
    owner <== request.bits.tag
  (
    execution.response |> map_flow(~stable: #true, value => RV5StageExecutionResult(DividerResponse(width), Tag)):
      tag: owner
      value: value
  ) |> result

export:
  RV5StageExecutionRequest
  RV5StageExecutionResult
  integer_request_with_tag
  integer_result_with_tag
  RV5StageMultiplyService
  RV5StageDivideService
