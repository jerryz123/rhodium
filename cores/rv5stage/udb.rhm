#lang rhombus
// Projects an RV5Stage architectural profile and physical-address contract into a UDB configuration.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../support/annotations.rhm".NonemptyString
  "../../riscv/udb.rhm" open
  "../../riscv/isa/c.rhm" open
  "../../riscv/isa/fp-profile.rhm" open
  "../../riscv/isa/vector-profile.rhm" open
  "../../riscv/isa/xlen.rhm".XLen
  "../../riscv/isa/zkt.rhm".ZktVersion
  "../../riscv/isa/zvkt.rhm".ZvktVersion
  "profile.rhm" open

fun extension(name :: NonemptyString, version :: NonemptyString):
  UdbExtension(name, version)

fun boolean_parameter(name :: NonemptyString, value :: Boolean):
  UdbParameter(name, UdbBooleanValue(value))

fun natural_parameter(name :: NonemptyString, value :: Nat):
  UdbParameter(name, UdbNaturalValue(value))

fun string_parameter(name :: NonemptyString, value :: String):
  UdbParameter(name, UdbStringValue(value))

fun natural_list_parameter(name :: NonemptyString, elements :: NonemptyList.of(Nat)):
  UdbParameter(name, UdbNaturalListValue(elements))

fun boolean_list_parameter(name :: NonemptyString, elements :: NonemptyList.of(Boolean)):
  UdbParameter(name, UdbBooleanListValue(elements))

def NoHpmCounters = for List (_index in 0..32): #false
def BaseCountersDelegatable = [#true, #true, #true] ++ for List (_index in 0..29): #false

fun rv5stage_udb_extensions(profile :: RV5StageConfig) :: NonemptyList.of(UdbExtension):
  def xlen = profile.xlen
  def advertised = profile.isa_profile.isa_extensions
  fun advertises(name :: String) :: Boolean: advertised.contains(name)
  def mutable result = [
    extension("I", "2.1"),
    extension("M", "2.0"),
    extension("Zmmul", "1.0.0"),
    extension("A", "2.1.0"),
    extension("Zaamo", "1.0.0"),
    extension("Zalrsc", "1.0.0"),
    extension("Za64rs", "1.0.0"),
    extension("Za128rs", "1.0.0"),
    extension("Zic64b", "1.0.0"),
    extension("B", "1.0.0"),
    extension("Zba", "1.0.0"),
    extension("Zbb", "1.0.0"),
    extension("Zbs", "1.0.0")
  ]
  when advertises("f")
  | result := result ++ [extension("F", "2.2.0")]
  when advertises("d")
  | result := result ++ [extension("D", "2.2.0")]
  when advertises("zfhmin") && !advertises("zfh")
  | result := result ++ [extension("Zfhmin", "1.0.0")]
  when advertises("zfh")
  | result := result ++ [extension("Zfhmin", "1.0.0"), extension("Zfh", "1.0.0")]
  when advertises("zfa")
  | result := result ++ [extension("Zfa", "1.0.0")]
  when advertises("zicbop")
  | result := result ++ [extension("Zicbop", "1.0.0")]
  when advertises("zicboz")
  | result := result ++ [extension("Zicboz", "1.0.0")]
  when advertises("zicbom")
  | result := result ++ [extension("Zicbom", "1.0.0")]
  when advertises("ziccif")
  | result := result ++ [extension("Ziccif", "1.0.0")]
  when advertises("ziccamoa")
  | result := result ++ [extension("Ziccamoa", "1.0.0")]
  when advertises("ziccrse")
  | result := result ++ [extension("Ziccrse", "1.0.0")]
  when advertises("ssnpm")
  | result := result ++ [extension("Ssnpm", "1.0.0")]
  when advertises("supm")
  | result := result ++ [extension("Supm", "1.0.0")]
  when advertises("zihintpause")
  | result := result ++ [extension("Zihintpause", "2.0.0")]
  when advertises("zihintntl")
  | result := result ++ [extension("Zihintntl", "1.0.0")]
  when advertises("zawrs")
  | result := result ++ [extension("Zawrs", "1.0.0")]
  when advertises("c")
  | result := result ++ [extension("C", "2.0")]
  when advertises("zca") || advertises("c")
  | result := result ++ [extension("Zca", "1.0.0")]
  when advertises("zcb")
  | result := result ++ [extension("Zcb", "1.0.0")]
  when advertises("zcmop")
  | result := result ++ [extension("Zcmop", "1.0.0")]
  when advertises("zcf") || (advertises("c") && xlen == XLen.X32 && advertises("f"))
  | result := result ++ [extension("Zcf", "1.0.0")]
  when advertises("zcd") || (advertises("c") && advertises("d"))
  | result := result ++ [extension("Zcd", "1.0.0")]
  when advertises("zve32x")
  | block:
      when advertises("v")
      | result := result ++ [extension("V", "1.0.0")]
      result := result ++ [extension("Zve32x", "1.0.0")]
      when advertises("zve32f")
      | result := result ++ [extension("Zve32f", "1.0.0")]
      when advertises("zve64x")
      | result := result ++ [extension("Zve64x", "1.0.0")]
      when advertises("zve64f")
      | result := result ++ [extension("Zve64f", "1.0.0")]
      when advertises("zve64d")
      | result := result ++ [extension("Zve64d", "1.0.0")]
      when advertises("zvfhmin")
      | result := result ++ [extension("Zvfhmin", "1.0.0")]
      when advertises("zvfh")
      | result := result ++ [extension("Zvfh", "1.0.0")]
      when advertises("zvbb")
      | result := result ++ [extension("Zvkb", "1.0.0"), extension("Zvbb", "1.0.0")]
      when advertises("zvkt")
      | result := result ++ [extension("Zvkt", ZvktVersion)]
      for (length in vector_length_extension_lengths(profile.vector_length)):
        result := result ++ [extension("Zvl" ++ String.from_int(length) ++ "b", "1.0.0")]
  result := result ++ [
    extension("Zicntr", "2.0"),
    extension("Zicond", "1.0.0"),
    extension("Zicsr", "2.0"),
    extension("Zifencei", "2.0.0"),
    extension("Zihpm", "2.0"),
    extension("Zimop", "1.0.0"),
    extension("Zkt", ZktVersion),
    extension("U", "1.0.0"),
    extension("S", "1.12.0"),
    extension("Sm", "1.12.0"),
    extension("Svbare", "1.0.0")
  ]
  when profile.mmu_mode == RV5StageMmuMode.Sv39
  | result := result ++ [extension("Sv39", "1.0.0"), extension("Svade", "1.0.0")]
  result

fun rv5stage_udb_parameters(profile :: RV5StageConfig,
                            physical_address_width :: PosInt,
                            pma_granularity_log2 :: PosInt,
                            ~pmlen: pmlen :: Nat = 0) :: NonemptyList.of(UdbParameter):
  when physical_address_width > 64
  | error(~who: #'rv5stage_udb_parameters, "physical address width must not exceed 64")
  when profile.xlen == XLen.X32 && physical_address_width > 32
  | error(~who: #'rv5stage_udb_parameters, "RV32 RV5Stage physical address width must not exceed 32")
  unless pma_granularity_log2 >= 2 && pma_granularity_log2 <= 66
  | error(~who: #'rv5stage_udb_parameters, "PMA granularity log2 must be between 2 and 66")
  def selected = profile.extensions
  when selected.ssnpm && ![0, 7, 16].contains(pmlen)
  | error(~who: #'rv5stage_udb_parameters, "Ssnpm PMLEN must be 0, 7, or 16")
  when !selected.ssnpm && pmlen != 0
  | error(~who: #'rv5stage_udb_parameters, "nonzero PMLEN requires Ssnpm")
  def xlen = profile.xlen.width
  def mutable result = [
    natural_parameter("MXLEN", xlen),
    natural_parameter("PHYS_ADDR_WIDTH", physical_address_width),
    natural_parameter("PMA_GRANULARITY", pma_granularity_log2),
    natural_parameter("CACHE_BLOCK_SIZE", RV5StageCacheLineBytes),
    boolean_parameter("PRECISE_SYNCHRONOUS_EXCEPTIONS", #true),
    boolean_parameter("TRAP_ON_ECALL_FROM_M", #true),
    boolean_parameter("TRAP_ON_EBREAK", #true),
    boolean_parameter("TRAP_ON_ILLEGAL_WLRL", #false),
    boolean_parameter("TRAP_ON_UNIMPLEMENTED_INSTRUCTION", #true),
    boolean_parameter("TRAP_ON_RESERVED_INSTRUCTION", #true),
    boolean_parameter("TRAP_ON_UNIMPLEMENTED_CSR", #true),
    boolean_parameter("REPORT_VA_IN_MTVAL_ON_BREAKPOINT", #false),
    boolean_parameter("REPORT_VA_IN_MTVAL_ON_LOAD_MISALIGNED", #true),
    boolean_parameter("REPORT_VA_IN_MTVAL_ON_STORE_AMO_MISALIGNED", #true),
    boolean_parameter("REPORT_VA_IN_MTVAL_ON_INSTRUCTION_MISALIGNED", #true),
    boolean_parameter("REPORT_VA_IN_MTVAL_ON_LOAD_ACCESS_FAULT", #true),
    boolean_parameter("REPORT_VA_IN_MTVAL_ON_STORE_AMO_ACCESS_FAULT", #true),
    boolean_parameter("REPORT_VA_IN_MTVAL_ON_INSTRUCTION_ACCESS_FAULT", #true),
    boolean_parameter("REPORT_ENCODING_IN_MTVAL_ON_ILLEGAL_INSTRUCTION", #true),
    natural_parameter("MTVAL_WIDTH", xlen),
    boolean_parameter("MARCHID_IMPLEMENTED", #false),
    boolean_parameter("MIMPID_IMPLEMENTED", #false),
    natural_parameter("CONFIG_PTR_ADDRESS", 0),
    natural_parameter("VENDOR_ID_BANK", 0),
    natural_parameter("VENDOR_ID_OFFSET", 0),
    boolean_parameter("MISALIGNED_LDST", #false),
    string_parameter("MISALIGNED_LDST_EXCEPTION_PRIORITY", "high"),
    string_parameter("M_MODE_ENDIANNESS", "little"),
    boolean_parameter("MISA_CSR_IMPLEMENTED", #true),
    string_parameter("MTVEC_ACCESS", "rw"),
    natural_list_parameter("MTVEC_MODES", [0]),
    natural_parameter("MTVEC_BASE_ALIGNMENT_DIRECT", 4),
    string_parameter("MTVEC_ILLEGAL_WRITE_BEHAVIOR", "custom"),
    boolean_parameter("MCOUNTINHIBIT_IMPLEMENTED", #false),
    boolean_list_parameter("HPM_COUNTER_EN", NoHpmCounters),
    boolean_list_parameter("MCOUNTENABLE_EN", BaseCountersDelegatable),
    natural_parameter("NUM_PMP_ENTRIES", 0),
    boolean_parameter("MUTABLE_MISA_M", #false),
    boolean_parameter("MUTABLE_MISA_A", #false),
    boolean_parameter("MUTABLE_MISA_B", #false),
    boolean_parameter("MISALIGNED_AMO", #false),
    string_parameter("LRSC_RESERVATION_STRATEGY", "reserve exactly enough to cover the access"),
    boolean_parameter("LRSC_FAIL_ON_VA_SYNONYM", #false),
    string_parameter("LRSC_MISALIGNED_BEHAVIOR", "always raise misaligned exception"),
    boolean_parameter("LRSC_FAIL_ON_NON_EXACT_LRSC", #true),
    boolean_parameter("TIME_CSR_IMPLEMENTED", #true),
    boolean_parameter("MUTABLE_MISA_U", #false),
    string_parameter("U_MODE_ENDIANNESS", "little"),
    natural_list_parameter("UXLEN", [xlen]),
    boolean_parameter("TRAP_ON_ECALL_FROM_U", #true),
    boolean_parameter("MUTABLE_MISA_S", #false),
    natural_parameter("ASID_WIDTH", 0),
    string_parameter("S_MODE_ENDIANNESS", "little"),
    natural_list_parameter("SXLEN", [xlen]),
    boolean_parameter("REPORT_VA_IN_MTVAL_ON_LOAD_PAGE_FAULT", #true),
    boolean_parameter("REPORT_VA_IN_MTVAL_ON_STORE_AMO_PAGE_FAULT", #true),
    boolean_parameter("REPORT_VA_IN_MTVAL_ON_INSTRUCTION_PAGE_FAULT", #true),
    boolean_parameter("REPORT_VA_IN_STVAL_ON_BREAKPOINT", #false),
    boolean_parameter("REPORT_VA_IN_STVAL_ON_LOAD_MISALIGNED", #true),
    boolean_parameter("REPORT_VA_IN_STVAL_ON_STORE_AMO_MISALIGNED", #true),
    boolean_parameter("REPORT_VA_IN_STVAL_ON_INSTRUCTION_MISALIGNED", #true),
    boolean_parameter("REPORT_VA_IN_STVAL_ON_LOAD_ACCESS_FAULT", #true),
    boolean_parameter("REPORT_VA_IN_STVAL_ON_STORE_AMO_ACCESS_FAULT", #true),
    boolean_parameter("REPORT_VA_IN_STVAL_ON_INSTRUCTION_ACCESS_FAULT", #true),
    boolean_parameter("REPORT_VA_IN_STVAL_ON_LOAD_PAGE_FAULT", #true),
    boolean_parameter("REPORT_VA_IN_STVAL_ON_STORE_AMO_PAGE_FAULT", #true),
    boolean_parameter("REPORT_VA_IN_STVAL_ON_INSTRUCTION_PAGE_FAULT", #true),
    boolean_parameter("REPORT_ENCODING_IN_STVAL_ON_ILLEGAL_INSTRUCTION", #true),
    natural_parameter("STVAL_WIDTH", xlen),
    boolean_list_parameter("SCOUNTENABLE_EN", BaseCountersDelegatable),
    natural_list_parameter("STVEC_MODES", [0]),
    boolean_parameter("SATP_MODE_BARE", #true),
    boolean_parameter("TRAP_ON_ECALL_FROM_S", #true),
    natural_list_parameter("MSTATUS_VS_LEGAL_VALUES", if vector_profile_enabled(profile.vector) | [0, 1, 2, 3] | [0]),
    natural_list_parameter("MSTATUS_FS_LEGAL_VALUES", if floating_point_supports_f(selected.floating_point) | [0, 1, 2, 3] | [0])
  ]
  when profile.mmu_mode == RV5StageMmuMode.Bare
  | result := result ++ [boolean_parameter("TRAP_ON_SFENCE_VMA_WHEN_SATP_MODE_IS_READ_ONLY", #false)]
  when selected.zicbom
  | result := result ++ [boolean_parameter("FORCE_UPGRADE_CBO_INVAL_TO_FLUSH", #false)]
  when selected.ssnpm
  | result := result ++ [natural_parameter("PMLEN", pmlen)]
  when selected.zawrs
  | result := result ++ [boolean_parameter("ZAWRS_NTO_IS_NOP", #false)]
  when floating_point_supports_f(selected.floating_point)
  | result := result ++ [
      boolean_parameter("MUTABLE_MISA_F", #false),
      string_parameter("HW_MSTATUS_FS_DIRTY_UPDATE", "precise")
    ]
  when floating_point_supports_d(selected.floating_point)
  | result := result ++ [boolean_parameter("MUTABLE_MISA_D", #false)]
  when selected.compressed_misa_c(profile.xlen)
  | result := result ++ [boolean_parameter("MUTABLE_MISA_C", #false)]
  when vector_profile_enabled(profile.vector)
  | result := result ++ [
      natural_parameter("VLEN", profile.vector_length),
      natural_parameter("ELEN", vector_profile_elen_bits(profile.vector)),
      natural_parameter("SEW_MIN", 8),
      boolean_parameter("FOLLOW_VTYPE_RESET_RECOMMENDATION", #true),
      boolean_parameter("IMPRECISE_VECTOR_TRAP_SETTABLE", #false),
      string_parameter("LEGAL_VSTART", "1_stride"),
      string_parameter("RESERVED_VSET_X0X0_VILL_SET", "never"),
      string_parameter("RESERVED_VSET_X0X0_VLMAX_CHANGE", "never"),
      string_parameter("RVV_VL_WHEN_AVL_LT_DOUBLE_VLMAX", "VLMAX"),
      string_parameter("SUPPORT_FRACTIONAL_LMUL_BEYOND_REQUIRED", "no_unrequired_supported"),
      boolean_parameter("VILL_SET_ON_RESERVED_VTYPE", #true),
      string_parameter("HW_MSTATUS_VS_DIRTY_UPDATE", "precise"),
      boolean_parameter("VECTOR_FF_NO_EXCEPTION_TRIM", #false),
      string_parameter("VECTOR_FF_SEG_EXCEPTION_PARTIAL_LOAD", "custom"),
      string_parameter("VECTOR_FF_UPDATE_PAST_TRIM", "update_none"),
      boolean_parameter("VECTOR_LOAD_PAST_TRAP", #false),
      string_parameter("VECTOR_LOAD_SEG_FF_OVERWRITE_ELEMENTS_AFTER_FAULT", "no_overwrite"),
      string_parameter("VECTOR_LS_INDEX_MAX_EEW", "64"),
      boolean_parameter("VECTOR_LS_MISALIGNED_LEGAL", #false),
      boolean_parameter("VECTOR_LS_SEG_PARTIAL_ACCESS", #true),
      boolean_parameter("VECTOR_LS_WHOLEREG_MISALIGNED_LEGAL", #false),
      string_parameter("VFREDUSUM_FINAL_NODE_ELEMENT_BEHAVIOR", "copy"),
      string_parameter("VFREDUSUM_INACTIVE_NODE_ELEMENT_BEHAVIOR", "copy"),
      string_parameter("VFREDUSUM_NAN", "no_change"),
      string_parameter("VFREDUSUM_NODE_ROUNDING_BEHAVIOR", "SEW_precision"),
      boolean_parameter("VSSTATUS_VS_EXISTS", #false)
    ]
  when vector_profile_is_v(profile.vector)
  | result := result ++ [boolean_parameter("MUTABLE_MISA_V", #false)]
  result

fun rv5stage_udb_configuration(profile :: RV5StageConfig,
                               name :: NonemptyString,
                               description :: NonemptyString,
                               physical_address_width :: PosInt,
                               pma_granularity_log2 :: PosInt = 3,
                               ~pmlen: pmlen :: Nat = 0):
  UdbConfiguration(
    name,
    description,
    rv5stage_udb_extensions(profile),
    rv5stage_udb_parameters(profile, physical_address_width, pma_granularity_log2, ~pmlen)
  )

export:
  rv5stage_udb_extensions
  rv5stage_udb_parameters
  rv5stage_udb_configuration
