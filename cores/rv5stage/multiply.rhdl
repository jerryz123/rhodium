#lang rhodium
// Adapts the reusable iterative multiplier to RV5Stage's deferred-writeback protocol.

import:
  "../multiplier.rhdl" open
  "decode/multiply-ctrl.rhdl" open
  "../../riscv/isa/xlen.rhm" open
  lib("flow/main.rhdl") open

bundle RV5StageMultiplyIssue(xlen :: XLen):
  left: Bits(xlen.width)
  right: Bits(xlen.width)
  control: RV5StageMultiplyControl()
  rd: Bits(5)

bundle RV5StageMultiplyCompletion(xlen :: XLen):
  rd: Bits(5)
  value: Bits(xlen.width)

sync_circuit RV5StageMultiplier(xlen :: XLen):
  def width = xlen.width
  def product_width = width * 2

  interface issue(Valid(RV5StageMultiplyIssue(xlen)), ~role: consumer)
  interface completion(Irrevocable(RV5StageMultiplyCompletion(xlen)), ~role: producer)
  output available: Bool

  inst multiplier(IterativeMultiplier(width))
  reg destination(Bits(5))
  reg high_result(Bool)
  reg word_result(Bool)

  available <== multiplier.request.ready
  (
    issue |> to_decoupled() |> map_flow(issued):
      MultiplierRequest(width):
        left: issued.left
        right: issued.right
        mode: issued.control.mode
  ) |> multiplier.request

  def issue_fire = issue.valid
  when issue_fire:
    destination <== issue.bits.rd
    high_result <== issue.bits.control.high_result
    word_result <== issue.bits.control.word_result

  def product = multiplier.response.bits
  def full_result = mux(high_result, product[width..product_width], product[0..width])
  def word_result_value = product[0..32].into(SInt(32)).sext(64).as_bits()
  def selected_result = if xlen == XLen.X64 | mux(word_result, word_result_value, full_result) | full_result

  (
    multiplier.response |> map_flow(~stable: #true, _product):
      RV5StageMultiplyCompletion(xlen):
        rd: destination
        value: selected_result
  ) |> completion

export:
  RV5StageMultiplyIssue
  RV5StageMultiplyCompletion
  RV5StageMultiplier
