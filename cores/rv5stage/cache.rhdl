#lang rhodium
// Defines shared geometry and replacement helpers for RV5Stage's private L1 caches.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/bits.rhdl") open
  "profile.rhm" open

fun rv5stage_cache_way_mask(config :: RV5StageCacheConfig,
                            way :: Bits(config.way_width)) :: Mask(config.ways):
  vec(
    for List (index in 0..config.ways):
      way === bits(index, config.way_width)
  ).into(Mask(config.ways))

fun rv5stage_cache_lane_mask(config :: RV5StageCacheConfig,
                             way :: Bits(config.way_width),
                             lanes :: PosInt,
                             lane_mask :: Mask(lanes)) :: Mask(config.ways * lanes):
  def lane_bits = lane_mask.as_bits().as_vec(Bool)
  def mutable expanded = []
  for (way_index in 0..config.ways):
    def selected_way = way === bits(way_index, config.way_width)
    for (lane in 0..lanes):
      expanded := expanded ++ [selected_way & lane_bits[lane]]
  vec(expanded).into(Mask(config.ways * lanes))

// Prefer an invalid way before falling back to the set's round-robin pointer.
fun rv5stage_cache_replacement_way(config :: RV5StageCacheConfig,
                                   valid :: Vec(config.ways, Bool),
                                   replacement :: Bits(config.way_width)) :: Bits(config.way_width):
  def invalid = vec(for List (index in 0..config.ways): !valid[index])
  def first_invalid = priority_encoder_oh(invalid)
  mux(first_invalid.valid, first_invalid.index, replacement)

fun rv5stage_cache_next_way(config :: RV5StageCacheConfig,
                            way :: Bits(config.way_width)) :: Bits(config.way_width):
  mux(way === bits(config.ways - 1, config.way_width),
      bits(0, config.way_width),
      way + bits(1, config.way_width))

export:
  RV5StageCacheLineBytes
  RV5StageCacheConfig
  rv5stage_cache_way_mask
  rv5stage_cache_lane_mask
  rv5stage_cache_replacement_way
  rv5stage_cache_next_way
