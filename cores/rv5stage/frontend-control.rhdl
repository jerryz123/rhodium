#lang rhodium
// Defines independent core-to-frontend control streams and their stage-owned payloads.

import:
  "btb.rhdl" open
  "../../riscv/isa/xlen.rhm" open
  lib("rhodium/std/ready-valid.rhdl") open

interface RV5StageFrontendControl(xlen :: XLen):
  role core
  role frontend
  provider core

  core -> frontend:
    // IF owns the persistent fetch-admission level.
    active: Bool
    // MEM reports a squash after its exception and replay filtering.
    flush: ValidCtrl()
    // The core orders MEM branch recovery with WB redirects and restarts.
    restart: Valid(Bits(xlen.width))
    // WB commits instruction-cache invalidation.
    invalidate_all: ValidCtrl()
    // WB invalidates predictor state for serialized architectural changes.
    predictor_flush: ValidCtrl()
    // MEM publishes the uncanceled branch outcome resolved in EX.
    branch_update: Valid(RV5StageBranchUpdate(xlen))

export:
  RV5StageFrontendControl
