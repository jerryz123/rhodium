#lang rhodium
// Normalizes singleton SEW operands and selects tagged shared integer results.
// SPDX-License-Identifier: Apache-2.0

import:
  "bundles.rhdl" open
  "../integer-execution.rhdl" open
  "../../multiplier.rhdl" open
  "../../divider.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/isa/vector.rhm" open
  lib("rhodium/std/bits.rhdl").Pow2Int

bundle RV5StageVectorArithmeticTag(slots :: Pow2Int):
  slot: Bits(index_width(slots))
  sew: Bits(2)
  upper: Bool

fun vector_integer_operand(xlen :: XLen, value :: Bits(64), sew :: Bits(2), signed_mode :: Bool) :~ Bits(xlen.width):
  def cases = for List (width in [8, 16, 32], code in 0..3):
    [code, if width == xlen.width | value[0..width] | mux(signed_mode, value[0..width].into(SInt(width)).sext(xlen.width).as_bits(), value[0..width].zext(xlen.width))]
  mux_lookup(sew, ~default: value[0..xlen.width], cases)

fun vector_multiply_request(xlen :: XLen, vlen :: VectorLength, slots :: Pow2Int, beat :: RV5StageVectorBeat(vlen), slot :: Bits(index_width(slots))) :~ RV5StageExecutionRequest(MultiplierRequest(xlen.width), RV5StageVectorArithmeticTag(slots)):
  def sew = beat.element_width.into(Bits(2))
  RV5StageExecutionRequest(MultiplierRequest(xlen.width), RV5StageVectorArithmeticTag(slots)):
    tag:
      RV5StageVectorArithmeticTag(slots):
        slot: slot
        sew: sew
        upper: beat.control.upper_result
    operands:
      MultiplierRequest(xlen.width):
        left: vector_integer_operand(xlen, beat.left, sew, beat.control.left_signed)
        right: vector_integer_operand(xlen, beat.right, sew, beat.control.right_signed)
        mode:
          MultiplierMode():
            left_signed: beat.control.left_signed
            right_signed: beat.control.right_signed

fun vector_divide_request(xlen :: XLen, vlen :: VectorLength, slots :: Pow2Int, beat :: RV5StageVectorBeat(vlen), slot :: Bits(index_width(slots))) :~ RV5StageExecutionRequest(DividerRequest(xlen.width), RV5StageVectorArithmeticTag(slots)):
  def sew = beat.element_width.into(Bits(2))
  RV5StageExecutionRequest(DividerRequest(xlen.width), RV5StageVectorArithmeticTag(slots)):
    tag:
      RV5StageVectorArithmeticTag(slots):
        slot: slot
        sew: sew
        upper: beat.control.upper_result
    operands:
      DividerRequest(xlen.width):
        dividend: vector_integer_operand(xlen, beat.left, sew, beat.control.left_signed)
        divisor: vector_integer_operand(xlen, beat.right, sew, beat.control.left_signed)
        signed_mode: beat.control.left_signed

fun vector_multiply_value(xlen :: XLen, slots :: Pow2Int, result :: RV5StageExecutionResult(Bits(xlen.width * 2), RV5StageVectorArithmeticTag(slots))) :~ Bits(64):
  // High multiplication is relative to SEW, not to the physical multiplier width.
  def cases = for List (width in [8, 16, 32], code in 0..3):
    [code, result.value[width..width * 2].zext(64)]
  def full_high = result.value[xlen.width..xlen.width * 2]
  def low = result.value[0..xlen.width]
  def high = mux_lookup(result.tag.sew, ~default: (if xlen == XLen.X64 | full_high | full_high.zext(64)), cases)
  mux(result.tag.upper, high, if xlen == XLen.X64 | low | low.zext(64))

fun vector_divide_value(xlen :: XLen, slots :: Pow2Int, result :: RV5StageExecutionResult(DividerResponse(xlen.width), RV5StageVectorArithmeticTag(slots))) :~ Bits(64):
  def value = mux(result.tag.upper, result.value.remainder, result.value.quotient)
  if xlen == XLen.X64 | value | value.zext(64)

export:
  RV5StageVectorArithmeticTag
  vector_integer_operand
  vector_multiply_request
  vector_divide_request
  vector_multiply_value
  vector_divide_value
