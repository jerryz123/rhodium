#lang rhodium
// Defines packed transport layouts and replay checkpoints shared by preparation and load assembly.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/riscv/vector-layout.rhm") open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/isa/vector.rhm" open
  lib("rhodium/std/bits.rhdl").Pow2Int

fun vector_transport_bytes(xlen :: XLen) :: PosInt:
  xlen.width / 8

fun vector_sequence_width(vlen :: VectorLength) :: PosInt:
  index_width(vlen + 1) + 3

bundle RV5StageVectorPackedCursor(xlen :: XLen, vlen :: VectorLength):
  address: Bits(xlen.width)
  element: Bits(index_width(vlen + 1))
  field: Bits(3)
  byte: Bits(vector_byte_offset_width(xlen))
  leading: Bits(vector_byte_offset_width(xlen))

bundle RV5StageVectorPackedLayout(xlen :: XLen, vlen :: VectorLength):
  before: RV5StageVectorPackedCursor(xlen, vlen)
  after: RV5StageVectorPackedCursor(xlen, vlen)
  rows: Vec(vector_transport_bytes(xlen), Bits(index_width(VectorRegisterLayout(vlen, xlen.width).depth)))
  offsets: Vec(vector_transport_bytes(xlen), Bits(vector_byte_offset_width(xlen)))
  elements: Vec(vector_transport_bytes(xlen), Bits(index_width(vlen + 1)))
  live: Bits(vector_transport_bytes(xlen))
  last: Bool

bundle RV5StageVectorPackedEntry(xlen :: XLen, vlen :: VectorLength, owners :: Pow2Int):
  sequence: Bits(vector_sequence_width(vlen))
  layout: RV5StageVectorPackedLayout(xlen, vlen)
  mask: Bits(vector_transport_bytes(xlen))
  store: Bool
  segmented: Bool
  owner: Bits(index_width(owners))

bundle RV5StageVectorPackedReservation(xlen :: XLen, vlen :: VectorLength, slots :: Pow2Int, owners :: Pow2Int):
  tag: Bits(index_width(slots))
  entry: RV5StageVectorPackedEntry(xlen, vlen, owners)

export:
  vector_sequence_width
  RV5StageVectorPackedCursor
  RV5StageVectorPackedLayout
  RV5StageVectorPackedEntry
  RV5StageVectorPackedReservation
