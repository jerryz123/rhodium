#lang rhodium
// Adapts vector chunks and performs destination packing plus lane-local fixed-point clipping.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../riscv/isa/vector.rhm" open
  "../../simd-alu.rhdl" open
  "register-file.rhdl" open
  lib("rhodium/std/bits.rhdl") open

hardware_enum VectorOperandSelect:
  Vector
  Scalar
  Immediate

bundle VectorPackingControl(vlen :: VectorLength):
  element_width: SimdElementWidth
  first_element: Bits(index_width(vlen + 1))
  vl: Bits(index_width(vlen + 1))
  vstart: Bits(index_width(vlen + 1))
  vlmax: Bits(index_width(vlen + 1))
  masked: Bool
  operand_select: VectorOperandSelect
  immediate_unsigned: Bool
  widening: Bool
  narrowing: Bool
  upper_half: Bool
  left_wide: Bool
  left_signed: Bool
  right_signed: Bool

bundle VectorPackedOperands(vlen :: VectorLength):
  left: Bits(64)
  right: Bits(64)
  element_width: SimdElementWidth
  enabled: Mask(8)
  first_element: Bits(index_width(vlen + 1))

// Internal narrowing result retains the per-beat saturation indication beside
// the packed write data until WB authorizes the architectural sticky update.
bundle VectorNarrowedResult():
  result: SimdAluResult()
  saturated: Bool

circuit RV5StageVectorOperands(vlen :: VectorLength):
  input control: VectorPackingControl(vlen)
  input(left, right, mask_word, scalar): Bits(64)
  input immediate: Bits(5)
  output operands: VectorPackedOperands(vlen)
  output legal: Bool

  def count_width = index_width(vlen + 1)
  def widths = [SimdElementWidth.E8, SimdElementWidth.E16, SimdElementWidth.E32, SimdElementWidth.E64]
  def immediate_value = mux(control.immediate_unsigned, immediate.zext(64), immediate.into(SInt(5)).sext(64).into(Bits(64)))
  def broadcast_source = mux(control.operand_select === VectorOperandSelect.Immediate, immediate_value, scalar)
  def source_mask = (mask_word >> control.first_element[0..6])[0..8]
  def alternatives:
    for List (format in 0..4):
      def width = 8 << format
      def lanes = 64 / width
      def enabled = vec(for List (lane in 0..8):
                          def element = control.first_element.zext(count_width + 1) + bits(lane, count_width + 1)
                          Bool(lane < lanes) & (element >= control.vstart.zext(count_width + 1)) & (element < control.vl.zext(count_width + 1)) & (element < control.vlmax.zext(count_width + 1)) & (!control.masked ||| source_mask[lane].into(Bool)))
      VectorPackedOperands(vlen):
        left: left
        right: mux(control.operand_select === VectorOperandSelect.Vector, right, vec(for List (_ in 0..lanes): broadcast_source[0..width]).as_bits())
        element_width: widths[format]
        enabled: enabled.as_bits().into(Mask(8))
        first_element: control.first_element
  def packed :: VectorPackedOperands(vlen) = mux_lookup(control.element_width, ~default: alternatives[0], for List (format in 1..4): [widths[format], alternatives[format]])
  inst widen(SimdWidenOperands())
  widen.left <== packed.left
  widen.right <== packed.right
  widen.enabled <== packed.enabled
  widen.upper_half <== control.upper_half
  widen.left_wide <== control.left_wide
  widen.left_signed <== control.left_signed
  widen.right_signed <== control.right_signed
  widen.element_width <== control.element_width.as_bits().into(SimdWidenElementWidth)
  def half_elements = mux_lookup(control.element_width, ~default: bits(4, count_width), [[SimdElementWidth.E16, bits(2, count_width)], [SimdElementWidth.E32, bits(1, count_width)]])
  def widened = VectorPackedOperands(vlen):
    left: widen.operands.left
    right: widen.operands.right
    element_width: widen.operands.element_width
    enabled: widen.operands.enabled
    first_element: control.first_element + mux(control.upper_half, half_elements, bits(0, count_width))
  operands <== mux(control.widening ||| control.narrowing, widened, packed)
  def aligned = mux_lookup(control.element_width, ~default: control.first_element.is_aligned(8), [[SimdElementWidth.E16, control.first_element.is_aligned(4)], [SimdElementWidth.E32, control.first_element.is_aligned(2)], [SimdElementWidth.E64, Bool(#true)]])
  legal <== aligned & (control.vl <= control.vlmax) & (control.vlmax <= bits(vlen, count_width)) & control.vlmax.or_reduce() & (control.first_element < control.vlmax) & !((control.widening ||| control.narrowing) & (control.element_width === SimdElementWidth.E64))

circuit RV5StageVectorResult(vlen :: VectorLength):
  input destination: Bits(5)
  input first_element: Bits(index_width(vlen + 1))
  input element_width: SimdElementWidth
  input mask_destination: Bool
  input narrowing: Bool
  input clip: Bool
  input clip_unsigned: Bool
  input enabled: Mask(8)
  input result: SimdAluResult()
  output write: VectorRegisterWrite(vlen)
  output legal: Bool
  output saturated: Bool

  // Keep the carry above the physical address until checking the bank bound.
  def address_width = index_width(vector_depth(vlen))
  def calculation_width = index_width(vlen + 1) + 1
  def base = destination.zext(calculation_width) << index_width(vector_chunks(vlen))
  def element = first_element.zext(calculation_width)
  def data_chunk = mux_lookup(element_width, ~default: element >> 3, [[SimdElementWidth.E16, element >> 2], [SimdElementWidth.E32, element >> 1], [SimdElementWidth.E64, element]])
  def address = base + mux(mask_destination, element >> 6, data_chunk)
  def mask_write_mask = enabled.as_bits().zext(64) << first_element[0..6]
  def upper_half = mux_lookup(element_width, ~default: first_element[2].into(Bool), [[SimdElementWidth.E16, first_element[1].into(Bool)], [SimdElementWidth.E32, first_element[0].into(Bool)]])
  def narrowed_results = for List (format in 0..3):
    def element_bits = 8 * (2 ** format)
    def source_bits = 2 * element_bits
    def lanes = 32 div element_bits
    def elements = for List (lane in 0..lanes):
      def source = result.data[lane * source_bits..(lane + 1) * source_bits]
      def low = source[0..element_bits]
      def upper = source[element_bits..source_bits]
      def result_negative = source[source_bits - 1].into(Bool)
      def low_negative = low[element_bits - 1].into(Bool)
      def sign_fill = mux(low_negative, !bits(0, element_bits), bits(0, element_bits))
      def unsigned_overflow = upper.or_reduce()
      def signed_overflow = upper =/= sign_fill
      def overflow = mux(clip_unsigned, unsigned_overflow, signed_overflow)
      def unsigned_limit = !bits(0, element_bits)
      def signed_limit = mux(result_negative, bits(1 << (element_bits - 1), element_bits), bits((1 << (element_bits - 1)) - 1, element_bits))
      [mux(clip & overflow, mux(clip_unsigned, unsigned_limit, signed_limit), low), (enabled[lane] & clip & overflow).as_bits()]
    def low_data :: Bits(32) = if lanes == 1 | elements[0][0] | concat(elements.map(fun (element :: List): element[0]).reverse())
    def saturation_bits :: Bits(lanes) = if lanes == 1 | elements[0][1] | concat(elements.map(fun (element :: List): element[1]).reverse())
    def mask_bits = for List (byte in 0..4): enabled[byte div (2 ** format)].as_bits()
    def low_mask = concat(mask_bits.reverse()).into(Mask(4))
    VectorNarrowedResult():
      result:
        SimdAluResult():
          data: mux(upper_half, low_data ++ bits(0, 32), bits(0, 32) ++ low_data)
          mask_result: result.mask_result
          write_mask: mux(upper_half, low_mask.as_bits() ++ bits(0, 4), bits(0, 4) ++ low_mask.as_bits()).into(Mask(8))
          saturated: result.saturated
      saturated: saturation_bits.or_reduce()
  def narrowed :: VectorNarrowedResult() = mux_lookup(element_width, ~default: narrowed_results[0], [[SimdElementWidth.E16, narrowed_results[1]], [SimdElementWidth.E32, narrowed_results[2]]])
  def effective_result :: SimdAluResult() = mux(narrowing, narrowed.result, result)
  saturated <== result.saturated ||| (narrowing & narrowed.saturated)
  write <== VectorRegisterWrite(vlen):
    address: address[0..address_width]
    data: mux(mask_destination, effective_result.mask_result.as_bits().zext(64) << first_element[0..6], effective_result.data)
    mask: mux(mask_destination, mask_write_mask, expand_mask(effective_result.write_mask.as_bits(), 8))
  def aligned = mux_lookup(element_width, ~default: first_element.is_aligned(8), [[SimdElementWidth.E16, first_element.is_aligned(4)], [SimdElementWidth.E32, first_element.is_aligned(2)], [SimdElementWidth.E64, Bool(#true)]])
  def half_aligned = mux_lookup(element_width, ~default: first_element.is_aligned(4), [[SimdElementWidth.E16, first_element.is_aligned(2)], [SimdElementWidth.E32, Bool(#true)], [SimdElementWidth.E64, Bool(#false)]])
  legal <== mux(narrowing, half_aligned, aligned) & (address < bits(vector_depth(vlen), calculation_width)) & (!mask_destination ||| (first_element < bits(vlen, index_width(vlen + 1))))

export:
  VectorOperandSelect
  VectorPackingControl
  VectorPackedOperands
  RV5StageVectorOperands
  RV5StageVectorResult
