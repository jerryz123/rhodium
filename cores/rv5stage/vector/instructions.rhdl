#lang rhodium
// Retains instruction lifetimes and register-row hazards until their accepted work has drained.
// SPDX-License-Identifier: Apache-2.0

import:
  "bundles.rhdl" open
  "dependencies.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/isa/vector.rhm" open
  lib("rhodium/std/bits.rhdl").Pow2Int
  lib("flow/main.rhdl") open

bundle RV5StageVectorIssueFinished(slots :: Pow2Int):
  owner: Bits(index_width(slots))
  fault: Bool

sync_circuit RV5StageVectorInstructions(xlen :: XLen, vlen :: VectorLength, vector_completion_slots :: Pow2Int):
  def tag_width = index_width(vector_completion_slots)
  def row_frontier_width = index_width(vector_depth(vlen) + 1)
  def Result = RV5StageVectorOwnedResult(xlen, vlen, vector_completion_slots)
  interface request(Valid(RV5StageVectorDescriptor(xlen)), ~role: consumer)
  interface finished(Valid(RV5StageVectorIssueFinished(vector_completion_slots)), ~role: consumer)
  interface resolved(Valid(Result), ~role: consumer)
  interface compute_maturity(Valid(Result), ~role: consumer)
  interface cancel(Pulse(), ~role: consumer)
  interface retire(Pulse(), ~role: producer)
  input slots: Vec(vector_completion_slots, RV5StageVectorSlotState(vlen, vector_completion_slots))
  input packed_rows: Vec(vector_depth(vlen), Bool)
  input(packed_memory, packed_drain_blocked, memory_drained): Bool
  output blocked_rows: Vec(vector_depth(vlen), Bool)
  output(allocate_id, sequencing_id): Bits(tag_width)
  output(closed, serial, memory): Vec(vector_completion_slots, Bool)
  output(available, active, loads_pending, stores_pending, fp_pending): Bool
  def compute_beat = compute_maturity.bits.beat
  def compute_owner = compute_maturity.bits.owner
  def element_resolved = resolved.valid
  def resolution_beat = resolved.bits.beat
  def resolution_owner = resolved.bits.owner
  // Sequencing ownership ends at the final accepted read request. These lightweight
  // contexts retain only completion and ordering state after that handoff.
  reg macro_valid(~init: bits(0, vector_completion_slots).as_vec(Bool))
  reg macro_load(Vec(vector_completion_slots, Bool))
  reg macro_store(Vec(vector_completion_slots, Bool))
  reg macro_fp(Vec(vector_completion_slots, Bool))
  reg macro_serial(Vec(vector_completion_slots, Bool))
  reg macro_destinations(Vec(vector_completion_slots, Bits(32)))
  reg macro_classified(Vec(vector_completion_slots, Bool))
  reg macro_progressive(Vec(vector_completion_slots, Bool))
  reg macro_row_frontier(Vec(vector_completion_slots, Bits(row_frontier_width)))
  reg macro_issued(~init: bits(0, vector_completion_slots).as_vec(Bool))
  reg macro_fault(~init: bits(0, vector_completion_slots).as_vec(Bool))
  reg next_owner(~init: bits(0, tag_width))
  reg current_owner(~init: bits(0, tag_width))
  reg drain_owner(~init: bits(0, tag_width))
  reg store_barrier(~init: Bool(#false))
  def destination_registers = vector_destination_registers(xlen, vlen, request.bits)
  // These schedules visit destination rows in order. Other schedules retain
  // their whole-group intent until the final beat resolves.
  def requested_control = request.bits.control
  def special_schedule = requested_control.reduction ||| requested_control.scan ||| requested_control.compress ||| requested_control.element_move ||| requested_control.whole_register_move ||| requested_control.gather
  def special_geometry = requested_control.mask_destination ||| requested_control.mask_logic ||| requested_control.widening ||| requested_control.narrowing ||| requested_control.extension ||| requested_control.wide_vs2
  def progressive_write = (requested_control.integer ||| requested_control.fp_service ||| requested_control.multiply_divide) & !requested_control.memory & !requested_control.scalar_destination & !requested_control.floating_scalar_destination & !special_schedule & !special_geometry
  def owner_has_slots = vec(for List (slot in 0..vector_completion_slots): slots[slot].allocated & (slots[slot].owner === drain_owner)).as_bits().or_reduce()
  def macro_complete = macro_valid[drain_owner] & macro_issued[drain_owner] & !owner_has_slots & !packed_drain_blocked
  for (owner in 0..vector_completion_slots):
    def owner_tag = bits(owner, tag_width)
    def unauthorized = vec(for List (slot in 0..vector_completion_slots): slots[slot].allocated & !slots[slot].accepted & (slots[slot].owner === owner_tag)).as_bits().or_reduce()
    when (request.valid & (next_owner === owner_tag)):
      macro_valid[owner] <== Bool(#true)
      macro_issued[owner] <== Bool(#false)
      macro_fault[owner] <== Bool(#false)
      macro_destinations[owner] <== destination_registers
      macro_progressive[owner] <== progressive_write
      macro_load[owner] <== request.bits.control.memory & !request.bits.control.store
      macro_store[owner] <== request.bits.control.memory & request.bits.control.store
      macro_fp[owner] <== request.bits.control.floating_point
      macro_serial[owner] <== (request.bits.control.scan & !request.bits.control.scan_control.index) ||| request.bits.control.compress
    elsewhen (macro_complete & (drain_owner === owner_tag)):
      macro_valid[owner] <== Bool(#false)
    elsewhen (cancel.valid & macro_valid[owner] & (!macro_issued[owner] ||| unauthorized)):
      macro_issued[owner] <== Bool(#true)
      macro_fault[owner] <== Bool(#true)
    elsewhen (finished.valid & (finished.bits.owner === owner_tag)):
      macro_issued[owner] <== Bool(#true)
      macro_fault[owner] <== finished.bits.fault ||| cancel.valid
  when macro_complete:
    drain_owner <== if vector_completion_slots == 1 | bits(0, tag_width) | drain_owner + bits(1, tag_width)
  def mutable foreign :: Bits(vector_depth(vlen)) = packed_rows.as_bits()
  for (owner in 0..vector_completion_slots):
    for (row in 0..vector_depth(vlen)):
      def future_row = !macro_progressive[owner] ||| (bits(row, row_frontier_width) >= macro_row_frontier[owner])
      def pending_row = macro_valid[owner] & !macro_classified[owner] & macro_destinations[owner][row div vector_chunks(vlen)].into(Bool) & future_row
      foreign := foreign ||| mux(pending_row & (bits(owner, tag_width) =/= current_owner), bits(1, vector_depth(vlen)) << row, bits(0, vector_depth(vlen)))
  for (slot in 0..vector_completion_slots):
    def rows = mux(slots[slot].allocated & !slots[slot].packed & slots[slot].writes, bits(1, vector_depth(vlen)) << slots[slot].write_address, bits(0, vector_depth(vlen)))
    foreign := foreign ||| mux(slots[slot].owner =/= current_owner, rows, bits(0, vector_depth(vlen)))
  blocked_rows <== foreign.as_vec(Bool)
  when (request.valid):
    current_owner <== next_owner
    next_owner <== if vector_completion_slots == 1 | bits(0, tag_width) | next_owner + bits(1, tag_width)
  active <== macro_valid.as_bits().or_reduce()
  def store_macro_pending = vec(for List (owner in 0..vector_completion_slots): macro_valid[owner] & macro_store[owner]).as_bits().or_reduce()
  stores_pending <== store_barrier ||| store_macro_pending
  loads_pending <== vec(for List (owner in 0..vector_completion_slots): macro_valid[owner] & macro_load[owner]).as_bits().or_reduce()
  fp_pending <== vec(for List (owner in 0..vector_completion_slots): macro_valid[owner] & macro_fp[owner]).as_bits().or_reduce()
  when (request.valid & request.bits.control.memory & request.bits.control.store):
    store_barrier <== Bool(#true)
  elsewhen (store_barrier & !store_macro_pending & memory_drained):
    store_barrier <== Bool(#false)
  def row_element_mask = bits(7, index_width(vlen + 1)) >> compute_beat.element_width.as_bits()
  def row_finished = compute_beat.last ||| ((compute_beat.end & row_element_mask) === bits(0, index_width(vlen + 1)))
  for (owner in 0..vector_completion_slots):
    def owner_tag = bits(owner, tag_width)
    when (request.valid & (next_owner === owner_tag)):
      macro_classified[owner] <== packed_memory
    elsewhen (element_resolved & resolution_beat.last & (resolution_owner === owner_tag)):
      macro_classified[owner] <== Bool(#true)
    when (request.valid & (next_owner === owner_tag)):
      macro_row_frontier[owner] <== bits(0, row_frontier_width)
    elsewhen (compute_maturity.valid & (compute_owner === owner_tag) & macro_progressive[owner] & row_finished):
      assert(compute_beat.write.address.zext(row_frontier_width) >= macro_row_frontier[owner], "vector_progressive_write_rows_are_ordered")
      macro_row_frontier[owner] <== compute_beat.write.address.zext(row_frontier_width) + bits(1, row_frontier_width)
  retire.valid <== macro_complete & !macro_fault[drain_owner]
  allocate_id <== next_owner
  sequencing_id <== current_owner
  available <== !macro_valid[next_owner]
  closed <== macro_issued
  serial <== macro_serial
  memory <== vec(for List (i in 0..vector_completion_slots): macro_load[i] ||| macro_store[i])

export:
  RV5StageVectorInstructions
  RV5StageVectorIssueFinished
