#lang rhodium
// Drives feed-forward vector memory attempts and returns ordered acceptance, replay, or fault feedback.
// SPDX-License-Identifier: Apache-2.0

import:
  "bundles.rhdl" open
  "../dcache/protocol.rhdl" open
  "../memory.rhdl" open
  "../../load-store.rhdl".MemoryWidth
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/isa/trap.rhm" open
  "../../../riscv/rtl/trap.rhdl" open
  "../../../riscv/rtl/pointer-masking.rhdl" open
  "../../../riscv/rtl/atomic.rhdl" open
  "../../../riscv/rtl/zihintntl.rhdl" open
  lib("rhodium/std/bits.rhdl").Pow2Int
  lib("flow/main.rhdl") open

sync_circuit RV5StageVectorMemory(xlen :: XLen, slots :: Pow2Int):
  def Token = RV5StageVectorToken(Bits(xlen.width), slots)
  bundle Lookup():
    token: Token
    request: RV5StageDataReq(xlen, slots)
    misaligned: Bool
  bundle Decision():
    lookup: Lookup()
    outcome: RV5StagePipelineOutcome
    data: Bits(xlen.width)
  interface issue(Decoupled(Token), ~role: consumer)
  interface pipeline(RV5StagePipelineAccess(xlen), ~role: requester)
  interface memory(RV5StageDataAccess(xlen, slots), ~role: requester)
  interface feedback(Valid(RV5StageVectorCommit(xlen)), ~role: producer)
  interface outcome(Valid(RV5StageVectorCommit(xlen)), ~role: producer)
  interface completion(Valid(RV5StageVectorCompletion(xlen, slots)), ~role: producer)
  input store: Bool
  input pointer_masking: PointerMaskControl()
  wire recover: Bool
  def ex = issue |> to_valid() |> valid_pipe(1, ~flush: recover)
  def Array(lookup_path, context_path) = ex |> fork_valid(2)
  def access = ex.bits.memory & ex.bits.enabled
  def address = apply_pointer_mask(xlen, ex.bits.address[0..xlen.width], pointer_masking)
  def width = ex.bits.memory_width.into(MemoryWidth)
  def misaligned = access & !width.is_aligned(address)
  def request = RV5StageDataReq(xlen, slots):
    address: address
    access: mux(store, RV5StageMemoryOperation.Store, RV5StageMemoryOperation.Load)
    atomic: RiscvAtomicOperation.Swap
    width: width
    unsigned: Bool(#true)
    data: ex.bits.store_data[0..xlen.width]
    writeback: RV5StageMemoryWriteback(slots).Vector(ex.bits.completion_tag)
    locality: RiscvMemoryLocality.Default
  (
    lookup_path |> filter_valid(_token => access & !misaligned & !recover)
      |> map_valid(_token => RV5StagePipelineReq(xlen)):
           address: request.address
           access: request.access
           width: request.width
           unsigned: request.unsigned
           data: request.data
  ) |> pipeline.request
  def mem = context_path |> map_valid(token => Lookup()):
    token: token
    request: request
    misaligned: misaligned
  def mem_context = mem |> valid_pipe(1, ~flush: recover)
  def wb = mem_context |> map_valid(lookup => Decision()):
    lookup: lookup
    outcome: mux(pipeline.response.valid, pipeline.response.bits.outcome, RV5StagePipelineOutcome.Slow)
    data: pipeline.response.bits.data
  def wb_context = wb |> valid_pipe(1, ~flush: recover)
  def Array(request_path, decision_path) = wb_context |> fork_valid(2)
  def operation = wb_context.bits
  def token = operation.lookup.token
  def memory_operation = wb_context.valid & token.memory & token.enabled & !operation.lookup.misaligned
  def slow = memory_operation & (operation.outcome === RV5StagePipelineOutcome.Slow)
  def store_hit = memory_operation & (operation.outcome === RV5StagePipelineOutcome.StoreHit)
  pipeline.commit <== store_hit
  request_path |> filter_valid(_operation => slow) |> map_valid(operation => operation.lookup.request) |> offer_decoupled() |> memory.request
  def page_fault = memory_operation & ((operation.outcome === RV5StagePipelineOutcome.PageFault) ||| (slow & memory.request_fault))
  def access_fault = memory_operation & !page_fault & ((operation.outcome === RV5StagePipelineOutcome.AccessFault) ||| (slow & memory.request_access_fault))
  def fault = wb_context.valid & (operation.lookup.misaligned ||| page_fault ||| access_fault)
  def retry = memory_operation & !fault & ((operation.outcome === RV5StagePipelineOutcome.Replay) ||| (slow & !memory.request.ready) ||| (store_hit & !pipeline.commit_ready))
  def accepted = memory.request.fire() & !fault
  def truncate = fault & token.truncate_on_fault
  recover <== retry ||| fault
  def disposition = mux(retry, RV5StageVectorDisposition.Retry, mux(truncate, RV5StageVectorDisposition.Truncate, mux(fault, RV5StageVectorDisposition.Fault, RV5StageVectorDisposition.Authorized)))
  def page_cause = mux(store, exception_cause_bits(ExceptionCause.StorePageFault, xlen.width), exception_cause_bits(ExceptionCause.LoadPageFault, xlen.width))
  def access_cause = mux(store, exception_cause_bits(ExceptionCause.StoreAccessFault, xlen.width), exception_cause_bits(ExceptionCause.LoadAccessFault, xlen.width))
  def alignment_cause = mux(store, exception_cause_bits(ExceptionCause.StoreAddressMisaligned, xlen.width), exception_cause_bits(ExceptionCause.LoadAddressMisaligned, xlen.width))
  def decision = decision_path |> map_valid(operation => RV5StageVectorCommit(xlen)):
    pc: operation.lookup.token.context
    disposition: disposition
    slow: accepted
    data: operation.data
    cause: mux(page_fault, page_cause, mux(access_fault, access_cause, alignment_cause))
    fault_address: operation.lookup.request.address
  def Array(feedback_path, outcome_path) = decision |> fork_valid(2)
  feedback_path |> feedback
  outcome_path |> filter_valid(event => (event.disposition =/= RV5StageVectorDisposition.Retry) & (token.last ||| fault)) |> outcome
  (
    memory.response |> map_valid(response => RV5StageVectorCompletion(xlen, slots)):
      tag: response.writeback.view(RV5StageMemoryWriteback(slots).Vector).payload
      data: response.data
  ) |> completion
  when (memory.response.valid):
    assert(!memory.response.bits.access_fault, "vector_memory_faults_are_reported_before_acceptance")
    assert(memory.response.bits.writeback.is(RV5StageMemoryWriteback(slots).Vector).into(Bool), "vector_response_has_vector_owner")
  assert(!(accepted & recover), "vector_accepted_request_never_replays")

export:
  RV5StageVectorMemory
