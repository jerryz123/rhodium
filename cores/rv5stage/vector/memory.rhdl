#lang rhodium
/* Translates RV5Stage pipeline lookups, slow admissions, and split replies for the vector LSU controller. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/common/vector/memory-controller.rhdl") open
  "../../common/cache/protocol.rhdl" open
  "../../common/cosim-source.rhm".describe_cosim_signals
  "../../common/vector/bundles.rhdl" open
  "../mmu/protocol.rhdl" open
  "../memory-context.rhdl" open
  "../../common/cache/operation.rhdl" open
  "../../common/load-store.rhdl".MemoryWidth
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/rtl/trap.rhdl" open
  "../../../riscv/rtl/hypervisor.rhdl" open
  "../../../riscv/rtl/pointer-masking.rhdl" open
  "../../../riscv/rtl/atomic.rhdl" open
  "../../../riscv/rtl/zihintntl.rhdl" open
  lib("rhodium/std/bits.rhdl").Pow2Int
  lib("flow/main.rhdl") open

/* Resolves speculative cache attempts and authorized slow accesses for vector beats.
   Precertified requests become durable at capture and retry in a bounded physical
   request ring; faultable attempts instead return precise sequencer feedback. */
sync_circuit RV5StageVectorMemory(xlen :: XLen, slots :: Pow2Int, ~hypervisor: hypervisor :: Boolean = #false):
  def Token = VectorToken(xlen, Bits(xlen.width), slots)
  /* Captures one memory token with its physical/virtual request and alignment decision. */
  bundle Lookup():
    token: Token
    request: PhysicalMemoryReq(xlen, RV5StageMemoryContext(slots))
    misaligned: Bool

  /* Pairs the retained lookup with its cache outcome and optional guest-fault provenance. */
  bundle Decision():
    request_context: Lookup()
    outcome: CachePipelineOutcome
    data: Bits(xlen.width)
    if hypervisor:
      guest: RiscvGuestException()

  interface issue(Decoupled(Token), ~role: consumer)
  interface pipeline(CachePipelineAccess(xlen), ~role: requester)
  interface memory(CacheAccess(xlen, RV5StageMemoryContext(slots)), ~role: requester)
  input request_fault_address: Bits(xlen.width)
  interface split_completion(Valid(RiscvSplitResult(xlen, RV5StageMemoryContext(slots))), ~role: consumer)
  interface feedback(Valid(VectorCommit(xlen, slots)), ~role: producer)
  interface outcome(Valid(VectorCommit(xlen, slots)), ~role: producer)
  interface completion(Decoupled(VectorCompletion(xlen, slots)), ~role: producer)
  interface store_completed(Valid(Bits(index_width(slots))), ~role: producer)
  input store: Bool
  input pointer_masking: PointerMaskControl()
  output(pipeline_physical, request_physical, requests_idle, memory_start_ready): Bool
  def pipeline_guest :: RiscvGuestException():
    if hypervisor
    | block:
        input pipeline_guest_fault: RiscvGuestException()
        pipeline_guest_fault
    | literal(RiscvGuestException(), 0)

  def request_guest :: RiscvGuestException():
    if hypervisor
    | block:
        input request_guest_fault: RiscvGuestException()
        request_guest_fault
    | literal(RiscvGuestException(), 0)


  /* Shared lookup issue and local split ownership.
     Certified capture is durable; a split takeover skips its retained request. */

  inst controller(VectorMemoryController(xlen, slots))
  issue |> controller.issue
  controller.feedback |> feedback
  controller.outcome |> outcome
  controller.completion |> completion
  controller.store_completed |> store_completed
  memory_start_ready <== controller.memory_start_ready
  wire split_capture: Bool
  controller.skip <== split_capture
  requests_idle <== controller.issue_idle


  /* Lookup formation.
     The shared issue path supplies the timed beat; RV5Stage supplies cache shape. */

  def Array(lookup_path, context_path) = controller.lookup |> fork_valid(2)
  def access = controller.lookup.bits.memory & controller.lookup.bits.enabled
  def address = mux(controller.lookup.bits.precertified, controller.lookup.bits.physical_address, apply_pointer_mask(xlen, controller.lookup.bits.address[0..xlen.width], pointer_masking))
  def lookup_store = mux(controller.lookup.bits.precertified, controller.lookup.bits.store, store)
  pipeline_physical <== controller.lookup.bits.precertified
  def width = controller.lookup.bits.memory_width.into(MemoryWidth)
  def request = PhysicalMemoryReq(xlen, RV5StageMemoryContext(slots)):
    byte_mask: controller.lookup.bits.byte_mask[0..xlen.width / 8]
    address: address
    access: mux(lookup_store, CacheOperation.Store, CacheOperation.Load)
    atomic: RiscvAtomicOperation.Swap
    width: width
    unsigned: Bool(#true)
    data: controller.lookup.bits.store_data[0..xlen.width]
    context:
      RV5StageMemoryContext(slots):
        writeback: RV5StageMemoryWriteback(slots).Vector(controller.lookup.bits.completion_tag)
        origin: RV5StageDataOrigin.Core

    locality: RiscvMemoryLocality.Default

  def misaligned = access & request.access.requires_split(width, address)
  lookup_path |> filter_valid(_token => access & !misaligned & !controller.recover)
    |> map_valid(_token => request.native_lookup()) |> pipeline.request


  /* MEM context and cache-result pairing.
     An absent response means Slow; the same-cycle join adds no storage or wait. */

  def mem = context_path |> map_valid(token => Lookup()):
    token: token
    request: request
    misaligned: misaligned

  def mem_context = mem |> valid_pipe(1, ~flush: controller.recover)
  def Array(context_capture, missing_response) = mem_context |> fork_valid(2)
  def returned = pipeline.response |> filter_valid(_result => mem_context.valid)
  def absent = missing_response |> filter_valid(_lookup => !pipeline.response.valid)
    |> map_valid(_lookup => pipeline.response.bits.updated(~outcome: CachePipelineOutcome.Slow))

  def result = Array(returned, absent) |> valid_arbiter()
  // Both operands are available in this cycle; the join adds no storage or wait.
  def wb = Array(context_capture |> to_decoupled(), result |> to_decoupled()) |> zip_flow(lookup, response):
    wire decision: Decision()
    decision.request_context <== lookup
    decision.outcome <== response.outcome
    decision.data <== response.data
    if hypervisor
    | decision.guest <== pipeline_guest
    | #void

    decision

  def arrival = wb |> to_valid() |> valid_pipe(1, ~flush: controller.recover)


  /* Translates a completed MMU split using the accepted lookup's original owner. */
  fun finish_split(saved :: Lookup(), reply :: RiscvSplitResult(xlen, RV5StageMemoryContext(slots))) :~ Decision():
    wire result: Decision()
    result.request_context <== saved
    def split_outcome :: CachePipelineOutcome = priority_mux(~default: CachePipelineOutcome.LoadHit):
      reply.page_fault: CachePipelineOutcome.PageFault
      reply.response.access_fault: CachePipelineOutcome.AccessFault

    result.outcome <== split_outcome
    result.data <== reply.response.data
    if hypervisor
    | result.guest <== reply.guest
    | #void

    result

  def (wb_context :: Endpoint.of(Valid(Decision())), split_owner :: Endpoint.of(Decoupled(Lookup()))) = vector_split_writeback(
    arrival, split_completion, split_capture,
    ~save: fun (decision :: Decision()): decision.request_context,
    ~finish: finish_split)
  def split_pending = split_owner.valid
  when (split_completion.valid):
    def tag = split_completion.bits.response.context.writeback.view(RV5StageMemoryWriteback(slots).Vector).payload
    assert(tag === split_owner.bits.token.completion_tag, "vector_split_return_matches_owner")
  controller.split_pending <== split_pending
  def operation :: Decision() = wb_context.bits
  def token = operation.request_context.token
  request_physical <== token.precertified
  def memory_operation = wb_context.valid & token.memory & token.enabled
  def slow = memory_operation & (operation.outcome === CachePipelineOutcome.Slow)
  def store_hit = !split_pending & memory_operation & (operation.outcome === CachePipelineOutcome.StoreHit)
  pipeline.commit <== store_hit
  def page_fault = memory_operation & ((operation.outcome === CachePipelineOutcome.PageFault) ||| (slow & memory.request_fault))
  def access_fault = memory_operation & !page_fault & ((operation.outcome === CachePipelineOutcome.AccessFault) ||| (slow & memory.request_access_fault))
  def fault = wb_context.valid & (page_fault ||| access_fault)
  def cache_replay = operation.outcome === CachePipelineOutcome.Replay
  def hit = wb_context.valid & !slow & !fault & !cache_replay
  def slow_blocked = slow & !memory.request.ready
  def store_commit_blocked = store_hit & !pipeline.commit_ready
  def precise_retry = memory_operation & !fault & (cache_replay ||| slow_blocked ||| store_commit_blocked)
  // The outgoing offer below is exactly the live Slow decision. Compute its
  // admission before annotating/forking that decision, without reading an undriven output.
  def accepted = slow & memory.request.ready & !fault
  split_capture <== accepted & operation.request_context.misaligned & !split_pending
  controller.mem_valid <== mem_context.valid
  controller.wb_valid <== arrival.valid

  def guest :: RiscvGuestException():
    if hypervisor | mux(slow, request_guest, operation.guest) | literal(RiscvGuestException(), 0)

  if hypervisor
  | block:
      output outcome_guest: RiscvGuestException()
      outcome_guest <== guest
  | #void

  def fault_cause = data_fault_cause(store, ~page_fault: page_fault, ~guest_page_fault: page_fault & guest.page_fault)
  def response_capture = wb_context |> trace_valid_event("vector/memory.result", ~when: token.memory & token.enabled, ~fields: decision):
    pc: decision.request_context.token.context
    address: decision.request_context.request.address
    slot(~format: "unsigned"): decision.request_context.token.completion_tag
    outcome(~format: "enum"): decision.outcome
    fault: fault
    replay: controller.retry
    admitted: accepted

  def Array(request_path, decision_path) = response_capture |> fork_valid(2)
  request_path |> filter_valid(_operation => slow) |> map_valid(operation => operation.request_context.request) |> offer_decoupled() |> memory.request
  def slow_admission_fault = slow & (memory.request_fault ||| memory.request_access_fault)
  def fault_address :: Bits(xlen.width) = priority_mux(~default: operation.request_context.request.address):
    split_pending: split_completion.bits.fault_address
    slow_admission_fault: request_fault_address

  (decision_path |> map_valid(_operation => VectorMemoryDecision(xlen, slots)):
    token: token
    action: vector_memory_action(
      ~fault: fault, ~retry: precise_retry, ~accepted: accepted,
      ~split_start: split_capture, ~split_return: split_pending
    )
    data: operation.data
    cause: fault_cause
    fault_address: fault_address
  ) |> controller.decision

  (
    memory.response |> map_flow(response => VectorCompletion(xlen, slots)):
      tag: response.context.writeback.view(RV5StageMemoryWriteback(slots).Vector).payload
      data: response.data
  ) |> controller.returned
  when (memory.response.valid):
    assert(!memory.response.bits.access_fault, "vector_memory_faults_are_reported_before_acceptance")
    assert(memory.response.bits.context.writeback.is(RV5StageMemoryWriteback(slots).Vector), "vector_response_has_vector_owner")

  assert(!(accepted & (controller.retry ||| fault)), "vector_accepted_request_never_replays")


  /* Passive completion accounting.
     A direct precise hit has no asynchronous completion. Other successful accesses
     retain their slot through completion, including certified hit acknowledgements. */

  describe_cosim_signals({
    "direct": memory_operation & hit & !controller.retry & !token.precertified & !split_pending,
    "direct_tag": token.completion_tag,
    "direct_data": operation.data,
    "completed": completion.fire(),
    "completion": completion.bits,
    "store_completed": store_completed.valid,
    "store_completed_tag": store_completed.bits,
    "fault": fault,
    "fault_tag": token.completion_tag,
    "fault_address": fault_address,
    "split": split_capture
  })

export:
  RV5StageVectorMemory
