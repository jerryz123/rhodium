#lang rhodium
/* Retains certified physical requests across local cache retries and precisely resolves
   faulting attempts. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../../cache/protocol.rhdl" open
  "../../riscv/cosim-source.rhm".describe_cosim_signals
  "bundles.rhdl" open
  "../mmu/protocol.rhdl" open
  "../memory-context.rhdl" open
  "../../cache/operation.rhdl" open
  "../../load-store.rhdl".MemoryWidth
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/isa/trap.rhm" open
  "../../../riscv/rtl/trap.rhdl" open
  "../../../riscv/rtl/hypervisor.rhdl" open
  "../../../riscv/rtl/pointer-masking.rhdl" open
  "../../../riscv/rtl/atomic.rhdl" open
  "../../../riscv/rtl/zihintntl.rhdl" open
  lib("rhodium/std/bits.rhdl").Pow2Int
  lib("flow/main.rhdl") open

/* Resolves speculative cache attempts and authorized slow accesses for vector beats.
   Precertified requests become durable at capture and retry in a bounded physical
   request ring; faultable attempts instead return precise sequencer feedback. */
sync_circuit RV5StageVectorMemory(xlen :: XLen, slots :: Pow2Int, ~hypervisor: hypervisor :: Boolean = #false):
  def Token = RV5StageVectorToken(xlen, Bits(xlen.width), slots)
  /* Captures one memory token with its physical/virtual request and alignment decision. */
  bundle Lookup():
    token: Token
    request: PhysicalMemoryReq(xlen, RV5StageMemoryContext(slots))
    misaligned: Bool
  /* Pairs the retained lookup with its cache outcome and optional guest-fault provenance. */
  bundle Decision():
    request_context: Lookup()
    outcome: CachePipelineOutcome
    data: Bits(xlen.width)
    if hypervisor:
      guest: RiscvGuestException()
  interface issue(Decoupled(Token), ~role: consumer)
  interface pipeline(CachePipelineAccess(xlen), ~role: requester)
  interface memory(CacheAccess(xlen, RV5StageMemoryContext(slots)), ~role: requester)
  input request_fault_address: Bits(xlen.width)
  interface split_completion(Valid(RiscvSplitResult(xlen, RV5StageMemoryContext(slots))), ~role: consumer)
  interface feedback(Valid(RV5StageVectorCommit(xlen, slots)), ~role: producer)
  interface outcome(Valid(RV5StageVectorCommit(xlen, slots)), ~role: producer)
  interface completion(Decoupled(RV5StageVectorCompletion(xlen, slots)), ~role: producer)
  input store: Bool
  input pointer_masking: PointerMaskControl()
  output(pipeline_physical, request_physical, requests_idle): Bool
  def pipeline_guest :: RiscvGuestException():
    if hypervisor
    | block:
        input pipeline_guest_fault: RiscvGuestException()
        pipeline_guest_fault
    | literal(RiscvGuestException(), 0)
  def request_guest :: RiscvGuestException():
    if hypervisor
    | block:
        input request_guest_fault: RiscvGuestException()
        request_guest_fault
    | literal(RiscvGuestException(), 0)
  inst split_owner(OfferRegister(Decision()))
  def split_pending = split_owner.egress.valid
  wire split_capture: Bool
  wire recover: Bool
  wire retry: Bool
  wire resolved: Bool
  // These are requests, not result buffers. Completion-slot capacity bounds
  // them even when the sequencer has moved on to independent instructions.
  def Cursor = Bits(bits.length(slots))
  /* Projects an extended ring cursor to its slot, explicitly producing zero for depth one. */
  fun request_index(cursor :: Bits(bits.length(slots))) :~ Bits(index_width(slots)):
    if slots == 1 | bits(0, 1) | cursor[0..index_width(slots)]
  reg requests(Vec(slots, Token))
  reg head(~init: bits(0, Cursor.width))
  reg tail(~init: bits(0, Cursor.width))
  reg next_request(~init: bits(0, Cursor.width))
  def count = tail - head
  requests_idle <== (count === bits(0, Cursor.width)) & !split_pending
  def Array(certified_input, faultable_input) = issue |> demux_flow(2, operation => !operation.precertified)
  def captured = certified_input |> gate_flow(count < bits(slots, Cursor.width)) |> to_valid()
  def Array(retention, live_attempt, capture_feedback) = captured |> fork_valid(3)
  def queued = count.or_reduce()
  def bypass = next_request === tail
  def pending = next_request =/= tail
  def captures = retention |> fork_valid(slots)
  def retained_attempts = for Array (slot in 0..slots):
    def index = bits(slot, index_width(slots))
    def capture = captures[slot] |> filter_valid(_token => request_index(tail) === index)
    def offered = inject_interface(Valid(Token), ~valid: pending & !recover & !split_pending & (request_index(next_request) === index), ~bits: requests[slot])
    def occupied = if slots == 1 | queued | (index - request_index(head)).zext(Cursor.width) < count
    def name = "request-" ++ to_string(slot)
    describe_interface_retained_storage(capture.valid, resolved & (request_index(head) === index), occupied, ~name: name)
    describe_interface_contract(capture, offered, name, ~trace_model: interface_trace_retained(~name: name))
    offered
  def bypassed = live_attempt |> filter_valid(_token => bypass & !recover & !split_pending)
  def attempt = Array(retained_attempts |> valid_arbiter(), bypassed) |> valid_arbiter()
  def direct = faultable_input |> gate_flow(!queued & !split_pending) |> to_valid()
  def ex = Array(attempt, direct) |> valid_arbiter() |> valid_pipe(1, ~flush: recover)
  when (captured.valid):
    requests[request_index(tail)] <== captured.bits
    tail <== tail + bits(1, Cursor.width)
  when (split_capture & queued):
    next_request <== head + bits(1, Cursor.width)
  elsewhen (retry & queued):
    next_request <== head
  elsewhen (attempt.valid):
    next_request <== next_request + bits(1, Cursor.width)
  when resolved:
    head <== head + bits(1, Cursor.width)
  // Capture resolves ownership at execute, independent of later cache retries.
  def durable = capture_feedback |> valid_pipe(1) |> map_valid(operation => RV5StageVectorCommit(xlen, slots)):
    tag: operation.completion_tag
    pc: operation.context
    disposition: RV5StageVectorDisposition.Authorized
    slow: Bool(#true)
    data: bits(0, xlen.width)
    cause: bits(0, xlen.width)
    fault_address: operation.address
  def Array(lookup_path, context_path) = ex |> fork_valid(2)
  def access = ex.bits.memory & ex.bits.enabled
  def address = mux(ex.bits.precertified, ex.bits.physical_address, apply_pointer_mask(xlen, ex.bits.address[0..xlen.width], pointer_masking))
  def ex_store = mux(ex.bits.precertified, ex.bits.store, store)
  pipeline_physical <== ex.bits.precertified
  def width = ex.bits.memory_width.into(MemoryWidth)
  def misaligned = access & !width.is_aligned(address)
  def request = PhysicalMemoryReq(xlen, RV5StageMemoryContext(slots)):
    byte_mask: ex.bits.byte_mask[0..xlen.width / 8]
    address: address
    access: mux(ex_store, CacheOperation.Store, CacheOperation.Load)
    atomic: RiscvAtomicOperation.Swap
    width: width
    unsigned: Bool(#true)
    data: ex.bits.store_data[0..xlen.width]
    context:
      RV5StageMemoryContext(slots):
        writeback: RV5StageMemoryWriteback(slots).Vector(ex.bits.completion_tag)
        origin: RV5StageDataOrigin.Core
    locality: RiscvMemoryLocality.Default
  (
    lookup_path |> filter_valid(_token => access & !misaligned & !recover)
      |> map_valid(_token => CachePipelineReq(xlen)):
           byte_mask: request.byte_mask
           address: request.address
           access: request.access
           width: request.width
           unsigned: request.unsigned
           data: request.data
  ) |> pipeline.request
  def mem = context_path |> map_valid(token => Lookup()):
    token: token
    request: request
    misaligned: misaligned
  def mem_context = mem |> valid_pipe(1, ~flush: recover)
  def Array(context_capture, missing_response) = mem_context |> fork_valid(2)
  def returned = pipeline.response |> filter_valid(_result => mem_context.valid)
  def absent = missing_response |> filter_valid(_lookup => !pipeline.response.valid)
    |> map_valid(_lookup => pipeline.response.bits.updated(~outcome: CachePipelineOutcome.Slow))
  def result = Array(returned, absent) |> valid_arbiter()
  // Both operands are available in this cycle; the join adds no storage or wait.
  def wb = Array(context_capture |> to_decoupled(), result |> to_decoupled()) |> zip_flow(lookup, response):
    wire decision: Decision()
    decision.request_context <== lookup
    decision.outcome <== response.outcome
    decision.data <== response.data
    if hypervisor
    | decision.guest <== pipeline_guest
    | #void
    decision
  def arrival = wb |> to_valid() |> valid_pipe(1, ~flush: recover)
  def returned_split = split_owner.egress |> gate_flow(split_completion.valid) |> map_flow(operation):
    wire result: Decision()
    result.request_context <== operation.request_context
    result.outcome <== mux(split_completion.bits.page_fault, CachePipelineOutcome.PageFault, mux(split_completion.bits.response.access_fault, CachePipelineOutcome.AccessFault, CachePipelineOutcome.LoadHit))
    result.data <== split_completion.bits.response.data
    if hypervisor
    | result.guest <== split_completion.bits.guest
    | #void
    result
  def wb_context = Array(arrival |> filter_valid(_operation => !split_pending), returned_split |> to_valid()) |> valid_arbiter()
  def Array(split_retention, response_context) = wb_context |> fork_valid(2)
  split_retention |> filter_valid(_operation => split_capture) |> split_owner.update
  def operation = wb_context.bits
  def token = operation.request_context.token
  request_physical <== token.precertified
  def memory_operation = wb_context.valid & token.memory & token.enabled
  def slow = memory_operation & (operation.outcome === CachePipelineOutcome.Slow)
  def store_hit = !split_pending & memory_operation & (operation.outcome === CachePipelineOutcome.StoreHit)
  wire hit_ready: Bool
  pipeline.commit <== store_hit
  def page_fault = memory_operation & ((operation.outcome === CachePipelineOutcome.PageFault) ||| (slow & memory.request_fault))
  def access_fault = memory_operation & !page_fault & ((operation.outcome === CachePipelineOutcome.AccessFault) ||| (slow & memory.request_access_fault))
  def fault = wb_context.valid & (page_fault ||| access_fault)
  def hit = wb_context.valid & !slow & !fault & (operation.outcome =/= CachePipelineOutcome.Replay)
  def precise_retry = memory_operation & !fault & ((operation.outcome === CachePipelineOutcome.Replay) ||| (slow & !memory.request.ready) ||| (store_hit & !pipeline.commit_ready))
  retry <== precise_retry ||| (hit & token.precertified & !token.store & !hit_ready)
  // The outgoing offer below is exactly the live Slow decision. Compute its
  // admission before annotating/forking that decision, without reading an undriven output.
  def accepted = slow & memory.request.ready & !fault
  split_capture <== accepted & operation.request_context.misaligned & !split_pending
  def truncate = fault & token.truncate_on_fault
  recover <== retry ||| fault ||| split_capture
  resolved <== wb_context.valid & token.precertified & !recover
  when (wb_context.valid & token.precertified):
    assert(!fault, "certified_vector_request_cannot_fault")
    assert(queued & (token.completion_tag === requests[request_index(head)].completion_tag), "vector_retry_resolves_oldest_request")
  def disposition = priority_mux(~default: RV5StageVectorDisposition.Authorized):
    precise_retry: RV5StageVectorDisposition.Retry
    truncate: RV5StageVectorDisposition.Truncate
    fault: RV5StageVectorDisposition.Fault
  def guest :: RiscvGuestException():
    if hypervisor | mux(slow, request_guest, operation.guest) | literal(RiscvGuestException(), 0)
  if hypervisor
  | block:
      output outcome_guest: RiscvGuestException()
      outcome_guest <== guest
  | #void
  def page_cause = mux(guest.page_fault,
                       mux(store, exception_cause_bits(ExceptionCause.StoreGuestPageFault, xlen.width), exception_cause_bits(ExceptionCause.LoadGuestPageFault, xlen.width)),
                       mux(store, exception_cause_bits(ExceptionCause.StorePageFault, xlen.width), exception_cause_bits(ExceptionCause.LoadPageFault, xlen.width)))
  def access_cause = mux(store, exception_cause_bits(ExceptionCause.StoreAccessFault, xlen.width), exception_cause_bits(ExceptionCause.LoadAccessFault, xlen.width))
  def response_capture = response_context |> trace_valid_event("vector/memory.result", ~when: token.memory & token.enabled, ~fields: decision):
    pc: decision.request_context.token.context
    address: decision.request_context.request.address
    slot(~format: "unsigned"): decision.request_context.token.completion_tag
    outcome(~format: "enum"): decision.outcome
    fault: fault
    replay: retry
    admitted: accepted
  def Array(request_path, decision_path, hit_path) = response_capture |> fork_valid(3)
  request_path |> filter_valid(_operation => slow) |> map_valid(operation => operation.request_context.request) |> offer_decoupled() |> memory.request
  def decision = decision_path |> filter_valid(_operation => !split_capture) |> map_valid(operation => RV5StageVectorCommit(xlen, slots)):
    tag: operation.request_context.token.completion_tag
    pc: operation.request_context.token.context
    disposition: disposition
    slow: accepted ||| (split_pending & !fault)
    data: operation.data
    cause: mux(page_fault, page_cause, access_cause)
    fault_address: mux(split_pending, split_completion.bits.fault_address, mux(slow & (memory.request_fault ||| memory.request_access_fault), request_fault_address, operation.request_context.request.address))
  def Array(feedback_path, outcome_path) = decision |> fork_valid(2)
  def precise_feedback = feedback_path |> filter_valid(_event => !token.precertified)
  Array(durable, precise_feedback) |> valid_arbiter() |> feedback
  assert(!(durable.valid & precise_feedback.valid), "vector_capture_and_precise_feedback_are_exclusive")
  outcome_path |> filter_valid(event => !token.precertified & (event.disposition =/= RV5StageVectorDisposition.Retry) & (token.last ||| fault)) |> outcome
  def Array(load_hit_path, store_hit_path) = hit_path |> fork_valid(2)
  def hit_completion = load_hit_path |> filter_valid(_operation => hit & token.precertified & !token.store) |> map_valid(result => RV5StageVectorCompletion(xlen, slots)):
    tag: result.request_context.token.completion_tag
    data: result.data
  def offered_hit = hit_completion |> offer_decoupled()
  hit_ready <== offered_hit.ready
  // Store commit must not depend on result readiness (cache drain itself
  // depends on commit). Retain only acknowledgement tags, never result data.
  reg acknowledgements(~init: bits(0, slots).as_vec(Bool))
  wire acknowledgement_ready: Vec(slots, Bool)
  def ack_captures = store_hit_path |> filter_valid(_operation => resolved & token.store & !accepted) |> fork_valid(slots)
  def ack_entries = for Array (slot in 0..slots):
    def index = bits(slot, index_width(slots))
    def capture = ack_captures[slot] |> filter_valid(result => result.request_context.token.completion_tag === index)
    def ack_bits = RV5StageVectorCompletion(xlen, slots):
      tag: index
      data: bits(0, xlen.width)
    def offered = inject_interface(Decoupled(RV5StageVectorCompletion(xlen, slots)), ~valid: acknowledgements[slot], ~bits: ack_bits, ~ready: acknowledgement_ready[slot])
    def name = "ack-" ++ to_string(slot)
    describe_interface_retained_storage(capture.valid, offered.fire(), acknowledgements[slot], ~name: name)
    describe_interface_contract(capture, offered, name, ~trace_model: interface_trace_retained(~name: name))
    when (offered.fire()):
      acknowledgements[slot] <== Bool(#false)
    elsewhen (capture.valid):
      acknowledgements[slot] <== Bool(#true)
    when (capture.valid):
      assert(!acknowledgements[slot], "vector_store_ack_has_unique_owner")
    offered
  def ack = ack_entries |> arbiter()
  def slow_completion = (
    memory.response |> map_flow(response => RV5StageVectorCompletion(xlen, slots)):
      tag: response.context.writeback.view(RV5StageMemoryWriteback(slots).Vector).payload
      data: response.data
  )
  // Split results arrive outside the fixed write calendar. Authorize their
  // slot first, then use the ordinary arbitrated completion/writeback path.
  def split_result = split_completion |> filter_valid(result => !result.page_fault & !result.response.access_fault)
    |> map_valid(result => RV5StageVectorCompletion(xlen, slots)):
         tag: result.response.context.writeback.view(RV5StageMemoryWriteback(slots).Vector).payload
         data: result.response.data
  def deferred_split = split_result |> to_decoupled() |> queue(1)
  Array(offered_hit, ack, slow_completion, deferred_split) |> arbiter() |> completion
  when (memory.response.valid):
    assert(!memory.response.bits.access_fault, "vector_memory_faults_are_reported_before_acceptance")
    assert(memory.response.bits.context.writeback.is(RV5StageMemoryWriteback(slots).Vector).into(Bool), "vector_response_has_vector_owner")
  assert(!(accepted & (retry ||| fault)), "vector_accepted_request_never_replays")
  // A direct precise hit has no asynchronous completion. All other successful
  // accesses retain their slot through completion, including certified hit ACKs.
  describe_cosim_signals({
    "direct": memory_operation & hit & !retry & !token.precertified & !split_pending,
    "direct_tag": token.completion_tag,
    "direct_data": operation.data,
    "completed": completion.fire(),
    "completion": completion.bits,
    "fault": fault,
    "fault_tag": token.completion_tag,
    "fault_address": decision.bits.fault_address,
    "split": split_capture
  })

export:
  RV5StageVectorMemory
