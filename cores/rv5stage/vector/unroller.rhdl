#lang rhodium
// Streams packed integer or singleton memory/FP operands with ordered WB progress.
// SPDX-License-Identifier: Apache-2.0

import:
  "bundles.rhdl" open
  "packing.rhdl" open
  "../decode/vector-ctrl.rhdl" open
  "../../simd-alu.rhdl" open
  "../../../riscv/isa/vector.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/rtl/vector.rhdl" open
  lib("flow/main.rhdl") open
  lib("rhodium/std/bits.rhdl") open

sync_circuit RV5StageVectorUnroller(xlen :: XLen, vlen :: VectorLength, Context :: DataType):
  def Address = Bits(index_width(vector_depth(vlen)))
  def Count = Bits(index_width(vlen + 1))
  def MicroOp = RV5StageVectorMicroOp(vlen, Context)
  bundle ReadContext():
    beat: RV5StageVectorBeat(vlen)
    slide_valid: Bits(16)
  bundle GatherRead():
    beat: RV5StageVectorBeat(vlen)
    in_range: Bool
  interface request(Decoupled(RV5StageVectorInstruction(xlen, Context)), ~role: consumer)
  interface cancel(Pulse(), ~role: consumer)
  interface feedback(Valid(RV5StageVectorFeedback(xlen, vlen, Bits(xlen.width))), ~role: consumer)
  interface reads[3](Valid(Address), ~role: producer)
  interface results[3](Valid(Bits(64)), ~role: consumer)
  interface issue(Decoupled(MicroOp), ~role: producer)
  output active: Bool

  reg occupied(~init: Bool(#false))
  reg instruction(RV5StageVectorInstruction(xlen, Context))
  reg cursor(Count)
  reg minimum(Count)
  reg authorized(Count)
  reg all_issued(~init: Bool(#false))
  reg compress_data(~init: bits(0, 64))
  reg compress_count(~init: bits(0, 4))
  reg compress_destination(~init: bits(0, index_width(vlen + 1)))
  reg authorized_compress_data(~init: bits(0, 64))
  reg authorized_compress_count(~init: bits(0, 4))
  reg authorized_compress_destination(~init: bits(0, index_width(vlen + 1)))
  reg compress_flush(~init: Bool(#false))
  // Credits cover both the unbackpressurable read response and the output FIFO.
  reg reserved(~init: bits(0, 2))
  inst context_pipe(ValidPipe(ReadContext(), 1, ~flushable: #true))
  inst gather_pipe(ValidPipe(GatherRead(), 1, ~flushable: #true))
  inst pending(ShiftQueue(MicroOp, 2, ~pipe: #true, ~flushable: #true))
  inst packing(RV5StageVectorOperands(vlen))
  def descriptor = instruction.descriptor
  def geometry = vector_type(xlen, vlen, descriptor.state.vtype)
  def sew = mux(descriptor.control.memory, descriptor.control.eew, geometry.sew)
  def element_move = descriptor.control.integer & descriptor.control.element_move
  def reduction = descriptor.control.integer & descriptor.control.reduction
  def scan = descriptor.control.integer & descriptor.control.scan
  def scan_word = scan & (descriptor.control.scan_control.result =/= VectorScanResult.Elements)
  def slide = descriptor.control.integer & descriptor.control.slide
  def gather = descriptor.control.integer & descriptor.control.gather
  def gather_vector = gather & (descriptor.control.operand === VectorOperandMode.Vector)
  def compress = descriptor.control.integer & descriptor.control.compress
  def widening = descriptor.control.integer & descriptor.control.widening
  def narrowing = descriptor.control.integer & descriptor.control.narrowing
  def width_change = widening ||| narrowing
  def singleton = descriptor.control.memory ||| descriptor.control.floating_point ||| descriptor.control.multiply_divide ||| element_move ||| reduction ||| gather_vector
  def mask_logic = descriptor.control.integer & descriptor.control.mask_logic
  def mask_word = mask_logic ||| scan_word
  def mask_select = descriptor.control.integer & descriptor.control.mask_select
  def format = mux(mask_word, SimdElementWidth.E64, sew.into(SimdElementWidth))
  // Element moves have one bookkeeping beat, not a VL-sized iteration space.
  def limit = mux(element_move, bits(1, index_width(vlen + 1)), descriptor.state.vl[0..index_width(vlen + 1)])
  def lanes = mux(mask_word, bits(64, index_width(vlen + 1)), mux(singleton, bits(1, index_width(vlen + 1)), mux_lookup(format, ~default: mux(width_change, bits(4, index_width(vlen + 1)), bits(8, index_width(vlen + 1))), [[SimdElementWidth.E16, mux(width_change, bits(2, index_width(vlen + 1)), bits(4, index_width(vlen + 1)))], [SimdElementWidth.E32, mux(width_change, bits(1, index_width(vlen + 1)), bits(2, index_width(vlen + 1)))], [SimdElementWidth.E64, bits(1, index_width(vlen + 1))]])))
  fun aligned_first(first :: Bits(index_width(vlen + 1)), sew :: Bits(2)):
    mux_lookup(sew, ~default: first.align_down(8), [[1, first.align_down(4)], [2, first.align_down(2)], [3, first]])
  def retry = feedback.valid & (feedback.bits.disposition === RV5StageVectorDisposition.Retry)
  def fault = feedback.valid & (feedback.bits.disposition === RV5StageVectorDisposition.Fault)
  def clear = cancel.valid ||| retry ||| fault
  pending.egress |> gate_flow(!clear) |> issue
  def empty = mux(element_move, !descriptor.control.scalar_destination & (descriptor.state.vstart >= descriptor.state.vl), minimum >= limit)
  def next_cursor = cursor.zext(index_width(vlen + 1) + 1) + lanes.zext(index_width(vlen + 1) + 1)
  def end = mux(empty ||| (next_cursor >= limit.zext(index_width(vlen + 1) + 1)), limit, next_cursor[0..index_width(vlen + 1)])
  // A vector gather's second read owns port zero in the index-response cycle.
  // The next index read can overlap the preceding data response, not its read.
  def launch = occupied & !all_issued & !clear & !(gather_vector & context_pipe.egress.valid) & ((reserved < bits(2, 2)) ||| issue.fire())
  def source_chunk = mux(mask_logic ||| scan, cursor >> 6, cursor >> (bits(3, 2) - sew))
  def wide_source_chunk = cursor >> (bits(2, 2) - sew)
  def row_base_width = index_width(vector_depth(vlen))
  // Whole-element displacement stays at XLEN until bounds are checked. Extra
  // bits retain both unsigned overflow and the negative slide-up prefix.
  def slide_distance = mux(descriptor.control.slide_one, bits(1, xlen.width), mux(descriptor.control.operand === VectorOperandMode.Immediate, descriptor.vs1.zext(xlen.width), descriptor.scalar))
  def slide_delta = mux(descriptor.control.slide_up, -slide_distance.zext(xlen.width + 2), slide_distance.zext(xlen.width + 2))
  def slide_origin = cursor.zext(xlen.width + 2) + slide_delta
  def slide_chunk = slide_origin >> (bits(3, 2) - sew)
  def slide_first = slide_origin & !(bits(7, xlen.width + 2) >> sew)
  // Every destination cursor is chunk-aligned, including a restarted chunk,
  // so this byte offset is constant throughout the retained macro.
  def slide_offset = (slide_delta[0..3] << sew)
  def slide_valid = vec(for List (byte in 0..16):
                          def element = slide_first + (bits(byte, xlen.width + 2) >> sew)
                          element < geometry.vlmax.zext(xlen.width + 2)).as_bits()
  def slide_base = descriptor.vs2.zext(row_base_width) << index_width(vector_chunks(vlen))
  def slide_address = slide_base + slide_chunk[0..row_base_width]
  def index_sew = mux(descriptor.control.gather_index16, bits(1, 2), sew)
  def index_chunk = cursor >> (bits(3, 2) - index_sew)
  def scalar_index = mux(descriptor.control.operand === VectorOperandMode.Immediate, descriptor.vs1.zext(64), if xlen == XLen.X64 | descriptor.scalar | descriptor.scalar.zext(64))
  def scalar_in_range = scalar_index < geometry.vlmax.zext(64)
  def scalar_address = slide_base + (scalar_index >> (bits(3, 2) - sew))[0..row_base_width]
  def first_source_chunk = mux(width_change & descriptor.control.wide_vs2, wide_source_chunk, source_chunk)
  def first_address = mux(gather, mux(!gather_vector & scalar_in_range, scalar_address, slide_base), mux(slide, mux(slide_valid[0..8].or_reduce(), slide_address, slide_base), (mux(descriptor.control.memory, descriptor.vd, descriptor.vs2).zext(row_base_width) << index_width(vector_chunks(vlen))) + first_source_chunk[0..row_base_width]))
  def second_address = mux(compress, (descriptor.vs1.zext(row_base_width) << index_width(vector_chunks(vlen))) + (cursor >> 6)[0..row_base_width], mux(slide, mux(slide_valid[8..16].or_reduce(), slide_address + bits(1, row_base_width), slide_base), (descriptor.vs1.zext(row_base_width) << index_width(vector_chunks(vlen))) + mux(reduction, bits(0, row_base_width), mux(gather_vector, index_chunk, source_chunk)[0..row_base_width])))
  def addresses = Array(first_address, second_address, (cursor >> 6)[0..row_base_width])
  context_pipe.flush <== clear
  context_pipe.ingress.valid <== launch
  context_pipe.ingress.bits.slide_valid <== slide_valid
  context_pipe.ingress.bits.beat <== RV5StageVectorBeat(vlen):
    first: cursor
    end: end
    destination_first: cursor
    last: end === limit
    empty: empty
    left: bits(0, 64)
    right: bits(0, 64)
    enabled: bits(0, 8).into(Mask(8))
    select_right: bits(0, 8).into(Mask(8))
    mask_enabled: vec(for List (bit_index in 0..64):
                        def element = cursor.zext(index_width(vlen + 1) + 1) + bits(bit_index, index_width(vlen + 1) + 1)
                        !empty & (element >= minimum.zext(index_width(vlen + 1) + 1)) & (element < end.zext(index_width(vlen + 1) + 1))).as_bits()
    element_width: format
    rounding_mode: descriptor.state.vxrm.into(SimdRoundingMode)
    control: descriptor.control
    destination: descriptor.vd
    compress_state:
      RV5StageVectorCompressState(vlen):
        data: bits(0, 64)
        count: bits(0, 4)
        destination: cursor
  def response = context_pipe.egress
  def read_beat = response.bits.beat
  def index_shift = (read_beat.first[0..3] << index_sew) ++ bits(0, 3)
  def index_word = results[1].bits >> index_shift
  def vector_index = mux_lookup(index_sew, ~default: index_word[0..8].zext(64), [[1, index_word[0..16].zext(64)], [2, index_word[0..32].zext(64)], [3, index_word]])
  def gather_index = mux(gather_vector, vector_index, scalar_index)
  def gather_in_range = gather_index < geometry.vlmax.zext(64)
  def gather_address = slide_base + mux(gather_in_range, (gather_index >> (bits(3, 2) - sew))[0..row_base_width], bits(0, row_base_width))
  // Rotate the selected source element directly into its destination slot;
  // scalar gathers rotate to slot zero, then use width-selected replication.
  def gather_offset = (gather_index[0..3] << sew) - mux(gather_vector, read_beat.first[0..3] << sew, bits(0, 3))
  def gather_data_read = response.valid & gather_vector & !clear
  reads[0].valid <== (launch & !empty) ||| (gather_data_read & !read_beat.empty)
  reads[0].bits <== mux(gather_data_read, gather_address, addresses[0])
  for (index in 1..3):
    reads[index].valid <== launch & !empty
    reads[index].bits <== addresses[index]
  packing.control <== VectorPackingControl(vlen):
    element_width: read_beat.element_width
    first_element: mux(width_change, aligned_first(read_beat.first, sew), read_beat.first)
    vl: limit
    vstart: minimum
    vlmax: geometry.vlmax
    masked: descriptor.masked & !mask_select
    operand_select: mux_lookup(descriptor.control.operand, ~default: VectorOperandSelect.Vector, [[VectorOperandMode.Scalar, VectorOperandSelect.Scalar], [VectorOperandMode.Immediate, VectorOperandSelect.Immediate]])
    immediate_unsigned: descriptor.control.immediate_unsigned
    widening: widening
    narrowing: narrowing
    upper_half: width_change & (read_beat.first =/= aligned_first(read_beat.first, sew))
    left_wide: descriptor.control.wide_vs2
    left_signed: descriptor.control.left_signed
    right_signed: descriptor.control.right_signed
  packing.left <== results[0].bits
  packing.right <== results[1].bits
  packing.mask_word <== results[2].bits
  packing.scalar <== if xlen == XLen.X64 | descriptor.scalar | descriptor.scalar.into(SInt(32)).sext(64).into(Bits(64))
  packing.immediate <== descriptor.vs1
  // Premerge bytes before the ALU's existing E64 rotate-right. Scalar insert
  // bytes keep their element-local position because the offset is SEW-aligned.
  def slide_source = vec(for List (byte in 0..8):
                           def high = bits(byte, 3) < slide_offset
                           def valid = mux(high, response.bits.slide_valid[byte + 8], response.bits.slide_valid[byte]).into(Bool)
                           def source = mux(valid, mux(high, results[1].bits[byte * 8..byte * 8 + 8], results[0].bits[byte * 8..byte * 8 + 8]), bits(0, 8))
                           def destination_byte = bits(byte, 3) - slide_offset
                           def destination_element = read_beat.first + (destination_byte >> sew).zext(index_width(vlen + 1))
                           def insert = descriptor.control.slide_one & (destination_element === mux(descriptor.control.slide_up, bits(0, index_width(vlen + 1)), limit - bits(1, index_width(vlen + 1))))
                           def scalar_byte = mux_lookup(sew, ~default: packing.scalar[0..8], for List (format in 1..4): [format, packing.scalar[(byte mod (2 ** format)) * 8..(byte mod (2 ** format)) * 8 + 8]])
                           mux(insert, scalar_byte, source)).as_bits()
  def slide_enabled = vec(for List (lane in 0..8):
                            !descriptor.control.slide_up ||| descriptor.control.slide_one ||| ((read_beat.first.zext(xlen.width + 2) + bits(lane, xlen.width + 2)) >= slide_distance.zext(xlen.width + 2))).as_bits()
  def memory_shift = ((read_beat.first[0..3] << sew) ++ bits(0, 3))
  def memory_enabled = !read_beat.empty & (!descriptor.masked ||| (results[2].bits >> read_beat.first[0..6])[0].into(Bool))
  def operands = read_beat.updated(
    ~left: mux(gather, mux(gather_in_range, results[0].bits, bits(0, 64)), mux(slide, slide_source, mux(scan, results[0].bits >> read_beat.first[0..6], mux(singleton, results[0].bits >> memory_shift, packing.operands.left)))),
    ~right: mux(gather, (gather_offset ++ bits(0, 3)).zext(64), mux(slide, (slide_offset ++ bits(0, 3)).zext(64), mux(mask_logic ||| reduction, results[1].bits, mux(singleton & (descriptor.control.operand === VectorOperandMode.Vector), results[1].bits >> memory_shift, packing.operands.right)))),
    ~select_right: mux(mask_select, (results[2].bits >> read_beat.first[0..6])[0..8], !bits(0, 8)).into(Mask(8)),
    ~mask_enabled: read_beat.mask_enabled & mux(scan & descriptor.masked, results[2].bits >> read_beat.first[0..6], !bits(0, 64)),
    ~destination_first: packing.operands.first_element,
    ~element_width: packing.operands.element_width,
    // One physical 64-bit logic lane computes the word; mask_enabled controls
    // its 64 independently writable architectural elements at the result port.
    ~enabled: mux(mask_logic, read_beat.mask_enabled.or_reduce().as_bits().zext(8).into(Mask(8)), mux(singleton, memory_enabled.as_bits().zext(8).into(Mask(8)), (mux(read_beat.empty, bits(0, 8), packing.operands.enabled.as_bits()) & mux(slide, slide_enabled, !bits(0, 8))).into(Mask(8))))
  )
  inst compactor(SimdCompress())
  def compress_mask = results[1].bits >> read_beat.first[0..6]
  def compress_selected = vec(for List (lane in 0..8):
                                def position = read_beat.first.zext(index_width(vlen + 1) + 1) + bits(lane, index_width(vlen + 1) + 1)
                                (!read_beat.empty & (bits(lane, index_width(vlen + 1)) < lanes) & (position < read_beat.end.zext(index_width(vlen + 1) + 1)) & compress_mask[lane].into(Bool)).as_bits()).into(Mask(8))
  compactor.data <== results[0].bits
  compactor.element_width <== read_beat.element_width
  compactor.selected <== compress_selected
  def append_shift = mux_lookup(read_beat.element_width, ~default: compress_count.zext(7) << 3, [[SimdElementWidth.E16, compress_count.zext(7) << 4], [SimdElementWidth.E32, compress_count.zext(7) << 5], [SimdElementWidth.E64, compress_count.zext(7) << 6]])
  def combined = compress_data.zext(128) ||| (compactor.compressed.data.zext(128) << append_shift)
  def total_count = compress_count.zext(5) + compactor.compressed.count.zext(5)
  def lane_count = lanes[0..5]
  def compress_full = total_count >= lane_count
  def remainder_count = mux(compress_full, total_count - lane_count, total_count)[0..4]
  def source_final = read_beat.end === limit
  def needs_flush = source_final & compress_full & remainder_count.or_reduce()
  def emitted_count = mux(compress_full, lane_count, mux(source_final, total_count, bits(0, 5)))[0..4]
  def emits_write = compress_full ||| (source_final & total_count.or_reduce())
  def post_compress_state = RV5StageVectorCompressState(vlen):
    data: mux(source_final & !needs_flush, bits(0, 64), mux(compress_full, combined[64..128], combined[0..64]))
    count: mux(source_final & !needs_flush, bits(0, 4), remainder_count)
    destination: compress_destination + emitted_count.zext(index_width(vlen + 1))
  def compress_beat = read_beat.updated(
    ~destination_first: compress_destination,
    ~last: source_final & !needs_flush,
    ~empty: !emits_write,
    ~left: combined[0..64],
    ~right: bits(0, 64),
    ~enabled: vec(for List (lane in 0..8): (bits(lane, 4) < emitted_count).as_bits()).into(Mask(8)),
    ~select_right: bits(0, 8).into(Mask(8)),
    ~compress_state: post_compress_state
  )
  fun compression_flush_beat(state :: RV5StageVectorCompressState(vlen)) :~ RV5StageVectorBeat(vlen):
    RV5StageVectorBeat(vlen):
      first: limit
      end: limit
      destination_first: state.destination
      last: Bool(#true)
      empty: Bool(#false)
      left: state.data
      right: bits(0, 64)
      enabled: vec(for List (lane in 0..8): (bits(lane, 4) < state.count).as_bits()).into(Mask(8))
      select_right: bits(0, 8).into(Mask(8))
      mask_enabled: bits(0, 64)
      element_width: format
      rounding_mode: descriptor.state.vxrm.into(SimdRoundingMode)
      control: descriptor.control
      destination: descriptor.vd
      compress_state:
        RV5StageVectorCompressState(vlen):
          data: bits(0, 64)
          count: bits(0, 4)
          destination: state.destination + state.count.zext(index_width(vlen + 1))
  gather_pipe.flush <== clear
  gather_pipe.ingress.valid <== gather_data_read
  gather_pipe.ingress.bits <== GatherRead():
    beat: operands
    in_range: gather_in_range
  pending.flush <== clear
  def flush_offer = compress_flush & !clear
  def read_offer = mux(gather_vector, gather_pipe.egress.valid, response.valid)
  def flush_state = RV5StageVectorCompressState(vlen):
    data: compress_data
    count: compress_count
    destination: compress_destination
  pending.ingress.valid <== (flush_offer ||| read_offer) & !clear
  pending.ingress.bits <== RV5StageVectorMicroOp(vlen, Context):
    context: instruction.context
    beat: mux(flush_offer, compression_flush_beat(flush_state), mux(gather_vector, gather_pipe.egress.bits.beat.updated(~left: mux(gather_pipe.egress.bits.in_range, results[0].bits, bits(0, 64))), mux(compress, compress_beat, operands)))
  def flush_enqueue = flush_offer & pending.ingress.ready
  def reserve_event = launch ||| flush_enqueue
  active <== occupied
  request.ready <== !occupied & !clear
  def accepted = request.fire()
  def authorized_event = feedback.valid & (feedback.bits.disposition === RV5StageVectorDisposition.Authorized)
  when (read_offer & !clear):
    assert(pending.ingress.ready, "vector_read_has_reserved_output_slot")
  when (gather_pipe.egress.valid & !clear):
    assert(gather_pipe.egress.bits.beat.empty ||| results[0].valid, "vector_gather_data_matches_context")
  when (response.valid & !clear):
    assert(read_beat.empty ||| (results[0].valid & results[1].valid & results[2].valid), "vector_read_context_matches_all_ports")
    assert(singleton ||| mask_word ||| read_beat.empty ||| packing.legal, "vector_packed_read_is_legal")
  when (feedback.valid & !cancel.valid):
    assert(occupied, "vector_feedback_has_active_macro")
    assert(feedback.bits.context === descriptor.pc, "vector_feedback_matches_active_macro")
    assert(empty ||| ((feedback.bits.first <= authorized) & (feedback.bits.end > authorized)) ||| (compress & feedback.bits.last & (feedback.bits.first === feedback.bits.end) & (feedback.bits.end === authorized)), "vector_feedback_is_oldest_unauthorized_beat")
  when (retry & !cancel.valid):
    assert(feedback.bits.end <= limit, "vector_retry_stays_within_active_body")
  when (cancel.valid ||| fault):
    occupied <== Bool(#false)
    all_issued <== Bool(#false)
    reserved <== bits(0, 2)
    compress_data <== bits(0, 64)
    compress_count <== bits(0, 4)
    compress_destination <== bits(0, index_width(vlen + 1))
    authorized_compress_data <== bits(0, 64)
    authorized_compress_count <== bits(0, 4)
    authorized_compress_destination <== bits(0, index_width(vlen + 1))
    compress_flush <== Bool(#false)
  elsewhen accepted:
    occupied <== Bool(#true)
    instruction <== request.bits
    def start = mux(request.bits.descriptor.control.integer & request.bits.descriptor.control.element_move, bits(0, index_width(vlen + 1)), request.bits.descriptor.state.vstart[0..index_width(vlen + 1)])
    def word_schedule = request.bits.descriptor.control.integer & (request.bits.descriptor.control.mask_logic ||| (request.bits.descriptor.control.scan & (request.bits.descriptor.control.scan_control.result =/= VectorScanResult.Elements)))
    def single_schedule = request.bits.descriptor.control.memory ||| request.bits.descriptor.control.floating_point ||| request.bits.descriptor.control.multiply_divide ||| (request.bits.descriptor.control.integer & (request.bits.descriptor.control.reduction ||| (request.bits.descriptor.control.gather & (request.bits.descriptor.control.operand === VectorOperandMode.Vector))))
    def packed_start = aligned_first(start, request.bits.descriptor.state.vtype[3..5])
    def width_change_start = mux_lookup(request.bits.descriptor.state.vtype[3..5], ~default: start.align_down(4), [[1, start.align_down(2)], [2, start]])
    cursor <== mux(word_schedule, start.align_down(64), mux(single_schedule, start, mux(request.bits.descriptor.control.widening ||| request.bits.descriptor.control.narrowing, width_change_start, packed_start)))
    minimum <== start
    authorized <== start
    all_issued <== Bool(#false)
    reserved <== bits(0, 2)
    compress_data <== bits(0, 64)
    compress_count <== bits(0, 4)
    compress_destination <== bits(0, index_width(vlen + 1))
    authorized_compress_data <== bits(0, 64)
    authorized_compress_count <== bits(0, 4)
    authorized_compress_destination <== bits(0, index_width(vlen + 1))
    compress_flush <== Bool(#false)
  elsewhen retry:
    def width_change_restart = mux_lookup(geometry.sew, ~default: authorized.align_down(4), [[1, authorized.align_down(2)], [2, authorized]])
    cursor <== mux(compress, authorized, mux(mask_word, authorized.align_down(64), mux(singleton, authorized, mux(width_change, width_change_restart, aligned_first(authorized, geometry.sew)))))
    minimum <== authorized
    all_issued <== compress & (authorized === limit)
    reserved <== bits(0, 2)
    compress_data <== authorized_compress_data
    compress_count <== authorized_compress_count
    compress_destination <== authorized_compress_destination
    compress_flush <== compress & (authorized === limit) & authorized_compress_count.or_reduce()
  elsewhen occupied:
    when launch:
      cursor <== end
      all_issued <== end === limit
    when (reserve_event =/= issue.fire()):
      reserved <== mux(reserve_event, reserved + bits(1, 2), reserved - bits(1, 2))
    when (response.valid & compress & !clear):
      compress_data <== post_compress_state.data
      compress_count <== post_compress_state.count
      compress_destination <== post_compress_state.destination
      compress_flush <== needs_flush
    elsewhen flush_enqueue:
      compress_data <== bits(0, 64)
      compress_count <== bits(0, 4)
      compress_destination <== compress_destination + compress_count.zext(index_width(vlen + 1))
      compress_flush <== Bool(#false)
    when authorized_event:
      authorized <== feedback.bits.end
      authorized_compress_data <== feedback.bits.compress_state.data
      authorized_compress_count <== feedback.bits.compress_state.count
      authorized_compress_destination <== feedback.bits.compress_state.destination
      when (feedback.bits.last):
        occupied <== Bool(#false)

export:
  RV5StageVectorUnroller
