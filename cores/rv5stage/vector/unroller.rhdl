#lang rhodium
// Plans VRF reads solely from one registered descriptor and cursor, retaining serialized replay progress.
// SPDX-License-Identifier: Apache-2.0

import:
  "bundles.rhdl" open
  "../decode/vector-ctrl.rhdl" open
  "../fp/types.rhdl".RV5StageFloatUnit
  "../../simd-alu.rhdl" open
  "../../../riscv/isa/vector.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/model/formats.rhm" as riscv_fields
  "../../../riscv/rtl/instruction-fields.rhdl".instruction_field
  "../../../riscv/rtl/vector.rhdl" open
  lib("flow/main.rhdl") open
  lib("rhodium/std/bits.rhdl") open

sync_circuit RV5StageVectorUnroller(xlen :: XLen, vlen :: VectorLength, Context :: DataType, ~trace_isa: trace_isa :: maybe(String) = #false):
  def Address = Bits(index_width(vector_depth(vlen)))
  def Count = Bits(index_width(vlen + 1))
  def Sequence = Bits(vector_sequence_width(vlen))
  def ReadRequest = RV5StageVectorReadRequest(xlen, vlen, Context)
  interface request(Decoupled(RV5StageVectorInstruction(xlen, Context)), ~role: consumer)
  input packed_memory: Bool
  interface packed_done(Pulse(), ~role: consumer)
  output retained: RV5StageVectorInstruction(xlen, Context)
  interface cancel(Pulse(), ~role: consumer)
  interface feedback(Valid(RV5StageVectorFeedback(xlen, vlen, Bits(xlen.width))), ~role: consumer)
  interface read_request(Decoupled(ReadRequest), ~role: producer)
  interface sequencing_done(Pulse(), ~role: producer)
  input blocked_rows: Vec(vector_depth(vlen), Bool)
  output(active, read_flush): Bool

  reg occupied(~init: Bool(#false))
  reg instruction(RV5StageVectorInstruction(xlen, Context))
  reg cursor(Count)
  reg field(Bits(3))
  reg sequence(Sequence)
  reg minimum(Count)
  reg authorized(Count)
  reg authorized_field(Bits(3))
  reg authorized_sequence(Sequence)
  reg memory_element_address(~init: bits(0, 64))
  reg authorized_memory_element_address(~init: bits(0, 64))
  reg memory_element_step(~init: bits(0, 64))
  reg memory_setup_remaining(~init: bits(0, index_width(vlen + 1)))
  reg all_issued(~init: Bool(#false))
  def descriptor = instruction.descriptor
  def vd = instruction_field(riscv_fields.rd, descriptor.instruction)
  def vs1 = instruction_field(riscv_fields.rs1, descriptor.instruction)
  def vs2 = instruction_field(riscv_fields.rs2, descriptor.instruction)
  retained <== instruction
  def geometry = vector_type(xlen, vlen, descriptor.state.vtype)
  def whole_register_memory = descriptor.control.memory & (descriptor.control.memory_mode === VectorMemoryMode.WholeRegister)
  def mask_memory = descriptor.control.memory & (descriptor.control.memory_mode === VectorMemoryMode.Mask)
  def indexed_memory = descriptor.control.memory & descriptor.control.memory_addressing.is_one_of(VectorMemoryAddressing.IndexedUnordered, VectorMemoryAddressing.IndexedOrdered)
  def segmented_memory = descriptor.control.memory & !whole_register_memory & descriptor.control.memory_nf.or_reduce()
  def memory_data_eew = mux(indexed_memory, geometry.sew, descriptor.control.memory_data_eew)
  def sew = mux(descriptor.control.memory, memory_data_eew, geometry.sew)
  def element_move = descriptor.control.element_move
  def whole_register_move = descriptor.control.integer & descriptor.control.whole_register_move
  def reduction = (descriptor.control.integer ||| descriptor.control.fp_service) & descriptor.control.reduction
  def scan = descriptor.control.integer & descriptor.control.scan
  def scan_word = scan & (descriptor.control.scan_control.result =/= VectorScanResult.Elements)
  def slide = descriptor.control.slide
  def gather = descriptor.control.integer & descriptor.control.gather
  def gather_vector = gather & (descriptor.control.operand === VectorOperandMode.Vector)
  def compress = descriptor.control.integer & descriptor.control.compress
  def serialized = descriptor.control.memory ||| (scan & !descriptor.control.scan_control.index) ||| compress
  def widening = descriptor.control.integer & descriptor.control.widening
  def narrowing = descriptor.control.integer & descriptor.control.narrowing
  def fp_widening = descriptor.control.fp_service & descriptor.control.widening
  def fp_narrowing = descriptor.control.fp_service & descriptor.control.narrowing
  def wide_vs2 = (descriptor.control.integer ||| descriptor.control.fp_service) & descriptor.control.wide_vs2
  def extension = descriptor.control.integer & descriptor.control.extension
  def extension_power = descriptor.control.extension_ratio.as_bits() + bits(1, 2)
  def source_sew = sew - extension_power
  def width_change = widening ||| narrowing
  def singleton = descriptor.control.memory ||| descriptor.control.fp_service ||| descriptor.control.multiply_divide ||| element_move ||| reduction ||| gather_vector
  def mask_logic = descriptor.control.integer & descriptor.control.mask_logic
  def mask_word = mask_logic ||| scan_word
  def format = mux(mask_word, SimdElementWidth.E64, sew.into(SimdElementWidth))
  // Whole-register transfers count encoded-EEW elements across NREG registers;
  // they deliberately ignore the active vl and vtype geometry.
  def whole_register_group_shift = mux_lookup(descriptor.control.memory_nf, ~default: bits(0, 2), [[1, bits(1, 2)], [3, bits(2, 2)], [7, bits(3, 2)]])
  def whole_register_elements = bits(vlen / 8, index_width(vlen + 1)) >> descriptor.control.memory_data_eew
  def whole_register_limit = whole_register_elements << whole_register_group_shift
  def whole_register_move_shift = mux_lookup(descriptor.control.whole_register_count, ~default: bits(0, 2), [[2, bits(1, 2)], [4, bits(2, 2)], [8, bits(3, 2)]])
  def whole_register_move_limit = (bits(vlen / 8, index_width(vlen + 1)) >> geometry.sew) << whole_register_move_shift
  def mask_memory_limit = (descriptor.state.vl[0..index_width(vlen + 1)] + bits(7, index_width(vlen + 1))) >> 3
  // Element moves have one bookkeeping beat, not a VL-sized iteration space.
  def limit = mux(element_move, bits(1, index_width(vlen + 1)), mux(whole_register_move, whole_register_move_limit, mux(whole_register_memory, whole_register_limit, mux(mask_memory, mask_memory_limit, descriptor.state.vl[0..index_width(vlen + 1)]))))
  def lanes = mux(mask_word, bits(64, index_width(vlen + 1)), mux(singleton, bits(1, index_width(vlen + 1)), mux_lookup(format, ~default: mux(width_change, bits(4, index_width(vlen + 1)), bits(8, index_width(vlen + 1))), [[SimdElementWidth.E16, mux(width_change, bits(2, index_width(vlen + 1)), bits(4, index_width(vlen + 1)))], [SimdElementWidth.E32, mux(width_change, bits(1, index_width(vlen + 1)), bits(2, index_width(vlen + 1)))], [SimdElementWidth.E64, bits(1, index_width(vlen + 1))]])))
  fun aligned_first(first :: Bits(index_width(vlen + 1)), sew :: Bits(2)):
    mux_lookup(sew, ~default: first.align_down(8), [[1, first.align_down(4)], [2, first.align_down(2)], [3, first]])
  def retry = feedback.valid & (feedback.bits.disposition === RV5StageVectorDisposition.Retry)
  def fault = feedback.valid & (feedback.bits.disposition === RV5StageVectorDisposition.Fault)
  def truncate = feedback.valid & (feedback.bits.disposition === RV5StageVectorDisposition.Truncate)
  def clear = cancel.valid ||| retry ||| fault ||| truncate
  read_flush <== clear
  def scalar_destination = descriptor.control.scalar_destination ||| descriptor.control.floating_scalar_destination
  def empty = mux(element_move, !scalar_destination & (descriptor.state.vstart >= descriptor.state.vl), minimum >= limit)
  def next_cursor = cursor.zext(index_width(vlen + 1) + 1) + lanes.zext(index_width(vlen + 1) + 1)
  def end = mux(empty ||| (next_cursor >= limit.zext(index_width(vlen + 1) + 1)), limit, next_cursor[0..index_width(vlen + 1)])
  def last_field = !segmented_memory ||| (field === descriptor.control.memory_nf)
  def authorized_last_field = !segmented_memory ||| (authorized_field === descriptor.control.memory_nf)
  def beat_last = empty ||| ((end === limit) & last_field)
  // A vector gather's second read owns port zero in the index-response cycle.
  // The next index read can overlap the preceding data response, not its read.
  def source_chunk = mux(mask_logic ||| scan, cursor >> 6, cursor >> (bits(3, 2) - sew))
  def extension_source_chunk = cursor >> (bits(3, 2) - source_sew)
  def wide_source_chunk = cursor >> (bits(2, 2) - sew)
  def multiply_accumulate = descriptor.control.multiply_divide & descriptor.control.multiply_accumulate
  def fp_fused = descriptor.control.fp_service & (descriptor.control.fp_execution.unit === RV5StageFloatUnit.FusedMultiplyAdd)
  def destination_source = multiply_accumulate ||| fp_fused
  def second_source = slide ||| !descriptor.control.floating_point ||| descriptor.control.fp_uses_vs1
  def destination_width = sew + ((descriptor.control.widening & multiply_accumulate) ||| fp_widening).as_bits().zext(2)
  def destination_chunk = cursor >> (bits(3, 2) - destination_width)
  def row_base_width = index_width(vector_depth(vlen))
  def memory_emul = geometry.lmul.into(SInt(3)).sext(5) + memory_data_eew.zext(5).into(SInt(5)) - geometry.sew.zext(5).into(SInt(5))
  def memory_group_shift = mux(memory_emul < SInt(5)(0), bits(0, 3), memory_emul.into(Bits(5))[0..3])
  def memory_register = vd + (field.zext(5) << memory_group_shift)
  def memory_field_offset = field.zext(64) << memory_data_eew
  def memory_effective_address = memory_element_address + memory_field_offset
  // Whole-element displacement stays at XLEN until bounds are checked. Extra
  // bits retain both unsigned overflow and the negative slide-up prefix.
  def slide_distance = mux(descriptor.control.slide_one, bits(1, xlen.width), mux(descriptor.control.operand === VectorOperandMode.Immediate, vs1.zext(xlen.width), descriptor.scalar))
  def slide_delta = mux(descriptor.control.slide_up, -slide_distance.zext(xlen.width + 2), slide_distance.zext(xlen.width + 2))
  def slide_origin = cursor.zext(xlen.width + 2) + slide_delta
  def slide_chunk = slide_origin >> (bits(3, 2) - sew)
  def slide_first = slide_origin & !(bits(7, xlen.width + 2) >> sew)
  // Every destination cursor is chunk-aligned, including a restarted chunk,
  // so this byte offset is constant throughout the retained macro.
  def slide_valid = vec(for List (byte in 0..16):
                          def element = slide_first + (bits(byte, xlen.width + 2) >> sew)
                          element < geometry.vlmax.zext(xlen.width + 2)).as_bits()
  def slide_base = vs2.zext(row_base_width) << index_width(vector_chunks(vlen))
  def slide_address = slide_base + slide_chunk[0..row_base_width]
  def index_sew = mux(indexed_memory, descriptor.control.memory_index_eew, mux(descriptor.control.gather_index16, bits(1, 2), sew))
  def index_chunk = cursor >> (bits(3, 2) - index_sew)
  def scalar_index = mux(descriptor.control.operand === VectorOperandMode.Immediate, vs1.zext(64), if xlen == XLen.X64 | descriptor.scalar | descriptor.scalar.zext(64))
  def scalar_in_range = scalar_index < geometry.vlmax.zext(64)
  def scalar_address = slide_base + (scalar_index >> (bits(3, 2) - sew))[0..row_base_width]
  def first_source_chunk = mux(extension, extension_source_chunk, mux(wide_vs2 ||| fp_narrowing, wide_source_chunk, source_chunk))
  def first_address = mux(gather, mux(!gather_vector & scalar_in_range, scalar_address, slide_base), mux(slide, mux(slide_valid[0..8].or_reduce(), slide_address, slide_base), (mux(descriptor.control.memory, memory_register, vs2).zext(row_base_width) << index_width(vector_chunks(vlen))) + first_source_chunk[0..row_base_width]))
  def second_address = mux(compress, (vs1.zext(row_base_width) << index_width(vector_chunks(vlen))) + (cursor >> 6)[0..row_base_width], mux(slide, mux(slide_valid[8..16].or_reduce(), slide_address + bits(1, row_base_width), slide_base), (mux(indexed_memory, vs2, vs1).zext(row_base_width) << index_width(vector_chunks(vlen))) + mux(reduction, bits(0, row_base_width), mux(gather_vector ||| indexed_memory, index_chunk, source_chunk)[0..row_base_width])))
  def destination_address = (vd.zext(row_base_width) << index_width(vector_chunks(vlen))) + destination_chunk[0..row_base_width]
  // Older macros have captured every operand before this descriptor starts.
  // Only their pending writes can block us; this macro's own writes cannot.
  // Indexed gathers conservatively wait for older writes before their index
  // read, since the dependent data read is a nonstallable second read stage.
  def mask_address = (cursor >> 6)[0..index_width(vector_chunks(vlen))].zext(row_base_width)
  def uses_mask = descriptor.masked ||| descriptor.control.carry_input ||| descriptor.control.mask_select
  def read_source_blocked = vec([
    !empty & blocked_rows[first_address],
    !empty & second_source & blocked_rows[second_address],
    !empty & destination_source & blocked_rows[destination_address],
    !empty & uses_mask & blocked_rows[mask_address],
    !empty & gather_vector & blocked_rows.as_bits().or_reduce()
  ]).as_bits()
  def read_sources_ready = !read_source_blocked.or_reduce()
  def read_setup_ready = !memory_setup_remaining.or_reduce()
  // Only registered descriptor/cursor state drives this offer. Independent
  // setup, source, and operand-fetch acceptances hold it until launch.
  def read_offer :: Handle = interface_link(Decoupled(ReadRequest), "read_offer")
  read_offer.left.valid <== occupied & !packed_memory & !all_issued & !clear
  read_offer.left.bits.context.instruction <== instruction
  read_offer.left.bits.context.minimum <== minimum
  read_offer.left.bits.context.slide_valid <== slide_valid
  read_offer.left.bits.context.beat <== RV5StageVectorBeat(vlen):
    sequence: sequence
    first: cursor
    end: end
    destination_first: cursor
    last: beat_last
    empty: empty
    address: memory_effective_address
    left: bits(0, 64)
    right: bits(0, 64)
    destination_data: bits(0, 64)
    enabled: bits(0, 8).into(Mask(8))
    carry_in: bits(0, 8).into(Mask(8))
    select_right: bits(0, 8).into(Mask(8))
    mask_enabled: vec(for List (bit_index in 0..64):
                        def element = cursor.zext(index_width(vlen + 1) + 1) + bits(bit_index, index_width(vlen + 1) + 1)
                        !empty & (element >= minimum.zext(index_width(vlen + 1) + 1)) & (element < end.zext(index_width(vlen + 1) + 1))).as_bits()
    element_width: format
    fp_source_width: (sew + fp_narrowing.as_bits().zext(2)).into(SimdElementWidth)
    fp_result_width: (sew + fp_widening.as_bits().zext(2)).into(SimdElementWidth)
    rounding_mode: descriptor.state.vxrm.into(SimdRoundingMode)
    fp_rounding_mode: descriptor.rounding_mode
    control: descriptor.control
    destination: mux(segmented_memory, memory_register, vd)
    compress_state:
      RV5StageVectorCompressState(vlen):
        data: bits(0, 64)
        count: bits(0, 4)
        destination: cursor
  read_offer.left.bits.enables <== vec([!empty, !empty & second_source, !empty & destination_source]).as_bits()
  read_offer.left.bits.addresses <== vec([first_address, second_address, destination_address])
  read_offer.left.bits.mask_enable <== !empty
  read_offer.left.bits.mask_address <== (cursor >> 6)[0..index_width(vector_chunks(vlen))]
  def offered_read = read_offer.right |> trace_event("vector/s1.sequence", ~stalls: #true, ~fields: plan):
    pc: plan.context.instruction.descriptor.pc
    instruction(~format: "riscv", ~isa: trace_isa || (if xlen == XLen.X32 | "rv32imafdcv" | "rv64imafdcv"), ~pc: "pc"): plan.context.instruction.descriptor.instruction
    packed: Bool(#false)
    op_index(~format: "unsigned"): plan.context.beat.sequence
    first(~format: "unsigned"): plan.context.beat.first
    end(~format: "unsigned"): plan.context.beat.end
    last: plan.context.beat.last
    empty: plan.context.beat.empty
    setup_wait: !read_setup_ready
    vs2_wait: read_source_blocked[0].into(Bool)
    vs1_wait: read_source_blocked[1].into(Bool)
    destination_wait: read_source_blocked[2].into(Bool)
    mask_wait: read_source_blocked[3].into(Bool)
    gather_source_wait: read_source_blocked[4].into(Bool)
    fetch_wait: !read_request.ready
  def Array(read_plan, source_permission, setup_permission) = offered_read |> atomic_fork(3)
  source_permission.ready <== read_sources_ready
  setup_permission.ready <== read_setup_ready
  read_plan |> read_request
  def launch = read_request.fire()
  def compute_tail_request = launch & beat_last & !serialized
  active <== occupied
  request.ready <== (!occupied ||| compute_tail_request) & !clear
  def accepted = request.fire()
  def authorized_event = feedback.valid & (feedback.bits.disposition === RV5StageVectorDisposition.Authorized)
  // Compute micro-ops become operand-fetch-owned when read. Replayable memory
  // retains the sequencer through final authorization.
  sequencing_done.valid <== occupied & (compute_tail_request ||| cancel.valid ||| fault ||| truncate ||| packed_done.valid ||| (authorized_event & feedback.bits.last))
  def release_macro = sequencing_done.valid
  describe_interface_retained_storage(accepted, release_macro, occupied, ~name: "macro")
  describe_interface_contract(request, read_offer.left, "macro-beats", ~trace_model: interface_trace_retained(~name: "macro"))
  when (feedback.valid & !cancel.valid):
    assert(serialized, "vector_feedback_only_replays_serialized_sequence")
    assert(occupied, "vector_feedback_has_active_macro")
    assert(feedback.bits.context === descriptor.pc, "vector_feedback_matches_active_macro")
    assert(feedback.bits.sequence === authorized_sequence, "vector_feedback_is_oldest_unauthorized_operation")
    assert(empty ||| ((feedback.bits.first <= authorized) & (feedback.bits.end > authorized)) ||| (compress & feedback.bits.last & (feedback.bits.first === feedback.bits.end) & (feedback.bits.end === authorized)), "vector_feedback_is_oldest_unauthorized_beat")
  when (retry & !cancel.valid):
    assert(feedback.bits.end <= limit, "vector_retry_stays_within_active_body")
  when (cancel.valid ||| fault ||| truncate ||| packed_done.valid):
    occupied <== Bool(#false)
    all_issued <== Bool(#false)
    memory_setup_remaining <== bits(0, index_width(vlen + 1))
    field <== bits(0, 3)
    sequence <== bits(0, vector_sequence_width(vlen))
    authorized_field <== bits(0, 3)
    authorized_sequence <== bits(0, vector_sequence_width(vlen))
  elsewhen accepted:
    occupied <== Bool(#true)
    instruction <== request.bits
    def start = mux(request.bits.descriptor.control.element_move, bits(0, index_width(vlen + 1)), request.bits.descriptor.state.vstart[0..index_width(vlen + 1)])
    def base = if xlen == XLen.X64 | request.bits.descriptor.scalar | request.bits.descriptor.scalar.zext(64)
    def stride = if xlen == XLen.X64 | request.bits.descriptor.stride | request.bits.descriptor.stride.into(SInt(32)).sext(64).into(Bits(64))
    def field_bytes = bits(1, 64) << request.bits.descriptor.control.memory_data_eew
    def fields = request.bits.descriptor.control.memory_nf.zext(64) + bits(1, 64)
    def request_whole_register_memory = request.bits.descriptor.control.memory & (request.bits.descriptor.control.memory_mode === VectorMemoryMode.WholeRegister)
    def request_mask_memory = request.bits.descriptor.control.memory & (request.bits.descriptor.control.memory_mode === VectorMemoryMode.Mask)
    def unit_stride_step = mux(request_whole_register_memory, field_bytes, mux(request.bits.descriptor.control.memory_nf.or_reduce(), fields << request.bits.descriptor.control.memory_data_eew, field_bytes))
    def element_step = mux(request.bits.descriptor.control.memory_addressing === VectorMemoryAddressing.Strided, stride, unit_stride_step)
    def word_schedule = request.bits.descriptor.control.integer & (request.bits.descriptor.control.mask_logic ||| (request.bits.descriptor.control.scan & (request.bits.descriptor.control.scan_control.result =/= VectorScanResult.Elements)))
    def single_schedule = request.bits.descriptor.control.memory ||| request.bits.descriptor.control.fp_service ||| request.bits.descriptor.control.multiply_divide ||| (request.bits.descriptor.control.integer & (request.bits.descriptor.control.reduction ||| (request.bits.descriptor.control.gather & (request.bits.descriptor.control.operand === VectorOperandMode.Vector))))
    def packed_start = aligned_first(start, request.bits.descriptor.state.vtype[3..5])
    def width_change_start = mux_lookup(request.bits.descriptor.state.vtype[3..5], ~default: start.align_down(4), [[1, start.align_down(2)], [2, start]])
    def request_width_change = (request.bits.descriptor.control.integer ||| request.bits.descriptor.control.fp_service) & (request.bits.descriptor.control.widening ||| request.bits.descriptor.control.narrowing)
    cursor <== mux(word_schedule, start.align_down(64), mux(single_schedule, start, mux(request_width_change, width_change_start, packed_start)))
    field <== bits(0, 3)
    sequence <== bits(0, vector_sequence_width(vlen))
    minimum <== start
    authorized <== start
    authorized_field <== bits(0, 3)
    authorized_sequence <== bits(0, vector_sequence_width(vlen))
    memory_element_address <== base
    authorized_memory_element_address <== base
    memory_element_step <== element_step
    def indexed = request.bits.descriptor.control.memory_addressing.is_one_of(VectorMemoryAddressing.IndexedUnordered, VectorMemoryAddressing.IndexedOrdered)
    def request_whole_register_group_shift = mux_lookup(request.bits.descriptor.control.memory_nf, ~default: bits(0, 2), [[1, bits(1, 2)], [3, bits(2, 2)], [7, bits(3, 2)]])
    def request_whole_register_elements = bits(vlen / 8, index_width(vlen + 1)) >> request.bits.descriptor.control.memory_data_eew
    def request_whole_register_limit = request_whole_register_elements << request_whole_register_group_shift
    def request_mask_memory_limit = (request.bits.descriptor.state.vl[0..index_width(vlen + 1)] + bits(7, index_width(vlen + 1))) >> 3
    def request_limit = mux(request_whole_register_memory, request_whole_register_limit, mux(request_mask_memory, request_mask_memory_limit, request.bits.descriptor.state.vl[0..index_width(vlen + 1)]))
    memory_setup_remaining <== mux(request.bits.descriptor.control.memory & !indexed & (start < request_limit), start, bits(0, index_width(vlen + 1)))
    all_issued <== Bool(#false)
  elsewhen retry:
    def width_change_restart = mux_lookup(geometry.sew, ~default: authorized.align_down(4), [[1, authorized.align_down(2)], [2, authorized]])
    cursor <== mux(compress, authorized, mux(mask_word, authorized.align_down(64), mux(singleton, authorized, mux(width_change, width_change_restart, aligned_first(authorized, geometry.sew)))))
    field <== authorized_field
    sequence <== authorized_sequence
    minimum <== authorized
    memory_element_address <== authorized_memory_element_address
    memory_setup_remaining <== bits(0, index_width(vlen + 1))
    all_issued <== compress & (authorized === limit)
  elsewhen occupied:
    when (memory_setup_remaining.or_reduce()):
      memory_element_address <== memory_element_address + memory_element_step
      memory_setup_remaining <== memory_setup_remaining - bits(1, index_width(vlen + 1))
    elsewhen (launch & descriptor.control.memory & !indexed_memory & last_field):
      memory_element_address <== memory_element_address + memory_element_step
    when (memory_setup_remaining.or_reduce()):
      authorized_memory_element_address <== authorized_memory_element_address + memory_element_step
    elsewhen (authorized_event & descriptor.control.memory & !indexed_memory & authorized_last_field):
      authorized_memory_element_address <== authorized_memory_element_address + memory_element_step
    when launch:
      sequence <== sequence + bits(1, vector_sequence_width(vlen))
      when (!empty & segmented_memory & !last_field):
        field <== field + bits(1, 3)
      elsewhen (empty ||| !segmented_memory ||| last_field):
        cursor <== end
        field <== bits(0, 3)
      all_issued <== beat_last
    when authorized_event:
      authorized_sequence <== authorized_sequence + bits(1, vector_sequence_width(vlen))
      when (!feedback.bits.last & segmented_memory & (authorized_field =/= descriptor.control.memory_nf)):
        authorized_field <== authorized_field + bits(1, 3)
      elsewhen (feedback.bits.last ||| !segmented_memory ||| (authorized_field === descriptor.control.memory_nf)):
        authorized <== feedback.bits.end
        authorized_field <== bits(0, 3)
    when (compute_tail_request ||| (authorized_event & feedback.bits.last)):
      occupied <== Bool(#false)

export:
  RV5StageVectorUnroller
