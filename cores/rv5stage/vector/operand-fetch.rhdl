#lang rhodium
// Fetches and packs operands from credited registered beat plans, independent of the current sequencer.
// SPDX-License-Identifier: Apache-2.0

import:
  "bundles.rhdl" open
  "packing.rhdl" open
  "../decode/vector-ctrl.rhdl" open
  "../fp/types.rhdl".RV5StageFloatUnit
  "../../simd-alu.rhdl" open
  "../../../riscv/isa/vector.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/model/formats.rhm" as riscv_fields
  "../../../riscv/rtl/instruction-fields.rhdl".instruction_field
  "../../../riscv/rtl/floating-point.rhdl".riscv_unbox
  lib("hardfloat/main.rhdl").FloatFormat
  "../../../riscv/rtl/vector.rhdl" open
  lib("flow/main.rhdl") open
  lib("rhodium/std/bits.rhdl") open

sync_circuit RV5StageVectorOperandFetch(xlen :: XLen, vlen :: VectorLength, Context :: DataType):
  def Address = Bits(index_width(vector_depth(vlen)))
  def ReadContext = RV5StageVectorReadContext(xlen, vlen, Context)
  def MicroOp = RV5StageVectorMicroOp(vlen, Context)
  bundle GatherRead():
    context: Context
    beat: RV5StageVectorBeat(vlen)
    in_range: Bool
  interface request(Decoupled(RV5StageVectorReadRequest(xlen, vlen, Context)), ~role: consumer)
  interface reads[3](Valid(Address), ~role: producer)
  interface results[3](Valid(Bits(64)), ~role: consumer)
  interface mask_read(Valid(Bits(index_width(vector_chunks(vlen)))), ~role: producer)
  interface mask_result(Valid(Bits(64)), ~role: consumer)
  interface issue(Decoupled(MicroOp), ~role: producer)
  interface feedback(Valid(RV5StageVectorFeedback(xlen, vlen, Bits(xlen.width))), ~role: consumer)
  input(flush, begin_macro): Bool
  output active: Bool
  // Reservations include in-flight reads and queued results, and survive
  // descriptor replacement. Only issue or explicit cancellation releases them.
  reg reserved(~init: bits(0, 2))
  inst context_pipe(ValidPipe(ReadContext, 1, ~flushable: #true))
  inst gather_pipe(ValidPipe(GatherRead(), 1, ~flushable: #true))
  inst pending(ShiftQueue(MicroOp, 2, ~pipe: #true, ~flow: #true, ~flushable: #true))
  inst packing(RV5StageVectorOperands(vlen))
  reg compress_data(~init: bits(0, 64))
  reg compress_count(~init: bits(0, 4))
  reg compress_destination(~init: bits(0, index_width(vlen + 1)))
  reg authorized_compress_data(~init: bits(0, 64))
  reg authorized_compress_count(~init: bits(0, 4))
  reg authorized_compress_destination(~init: bits(0, index_width(vlen + 1)))
  reg compress_flush(~init: Bool(#false))
  reg compress_context(ReadContext)
  reg compress_context_valid(~init: Bool(#false))
  reg flush_sequence(Bits(vector_sequence_width(vlen)))
  reg authorized_sequence(~init: bits(0, vector_sequence_width(vlen)))
  reg authorized_end(~init: bits(0, index_width(vlen + 1)))
  def clear = flush
  def retry = feedback.valid & (feedback.bits.disposition === RV5StageVectorDisposition.Retry)
  pending.egress |> gate_flow(!clear) |> issue
  def response = context_pipe.egress
  def read_context = mux(compress_flush, compress_context, response.bits)
  def instruction = read_context.instruction
  def minimum = read_context.minimum
  def read_beat = read_context.beat
  def descriptor = instruction.descriptor
  def vd = instruction_field(riscv_fields.rd, descriptor.instruction)
  def vs1 = instruction_field(riscv_fields.rs1, descriptor.instruction)
  def vs2 = instruction_field(riscv_fields.rs2, descriptor.instruction)
  def geometry = vector_type(xlen, vlen, descriptor.state.vtype)
  def whole_register_memory = descriptor.control.memory & (descriptor.control.memory_mode === VectorMemoryMode.WholeRegister)
  def mask_memory = descriptor.control.memory & (descriptor.control.memory_mode === VectorMemoryMode.Mask)
  def indexed_memory = descriptor.control.memory & descriptor.control.memory_addressing.is_one_of(VectorMemoryAddressing.IndexedUnordered, VectorMemoryAddressing.IndexedOrdered)
  def memory_data_eew = mux(indexed_memory, geometry.sew, descriptor.control.memory_data_eew)
  def sew = mux(descriptor.control.memory, memory_data_eew, geometry.sew)
  def element_move = descriptor.control.element_move
  def whole_register_move = descriptor.control.integer & descriptor.control.whole_register_move
  def reduction = (descriptor.control.integer ||| descriptor.control.fp_service) & descriptor.control.reduction
  def scan = descriptor.control.integer & descriptor.control.scan
  def scan_word = scan & (descriptor.control.scan_control.result =/= VectorScanResult.Elements)
  def slide = descriptor.control.slide
  def gather = descriptor.control.integer & descriptor.control.gather
  def gather_vector = gather & (descriptor.control.operand === VectorOperandMode.Vector)
  def compress = descriptor.control.integer & descriptor.control.compress
  def widening = descriptor.control.integer & descriptor.control.widening
  def narrowing = descriptor.control.integer & descriptor.control.narrowing
  def fp_widening = descriptor.control.fp_service & descriptor.control.widening
  def wide_vs2 = (descriptor.control.integer ||| descriptor.control.fp_service) & descriptor.control.wide_vs2
  def extension = descriptor.control.integer & descriptor.control.extension
  def width_change = widening ||| narrowing
  def singleton = descriptor.control.memory ||| descriptor.control.fp_service ||| descriptor.control.multiply_divide ||| element_move ||| reduction ||| gather_vector
  def mask_logic = descriptor.control.integer & descriptor.control.mask_logic
  def mask_word = mask_logic ||| scan_word
  def mask_select = descriptor.control.mask_select
  def carry_input = descriptor.control.integer & descriptor.control.carry_input
  def format = mux(mask_word, SimdElementWidth.E64, sew.into(SimdElementWidth))
  // Whole-register transfers count encoded-EEW elements across NREG registers;
  // they deliberately ignore the active vl and vtype geometry.
  def whole_register_group_shift = mux_lookup(descriptor.control.memory_nf, ~default: bits(0, 2), [[1, bits(1, 2)], [3, bits(2, 2)], [7, bits(3, 2)]])
  def whole_register_elements = bits(vlen / 8, index_width(vlen + 1)) >> descriptor.control.memory_data_eew
  def whole_register_limit = whole_register_elements << whole_register_group_shift
  def whole_register_move_shift = mux_lookup(descriptor.control.whole_register_count, ~default: bits(0, 2), [[2, bits(1, 2)], [4, bits(2, 2)], [8, bits(3, 2)]])
  def whole_register_move_limit = (bits(vlen / 8, index_width(vlen + 1)) >> geometry.sew) << whole_register_move_shift
  def mask_memory_limit = (descriptor.state.vl[0..index_width(vlen + 1)] + bits(7, index_width(vlen + 1))) >> 3
  // Element moves have one bookkeeping beat, not a VL-sized iteration space.
  def limit = mux(element_move, bits(1, index_width(vlen + 1)), mux(whole_register_move, whole_register_move_limit, mux(whole_register_memory, whole_register_limit, mux(mask_memory, mask_memory_limit, descriptor.state.vl[0..index_width(vlen + 1)]))))
  def lanes = mux(mask_word, bits(64, index_width(vlen + 1)), mux(singleton, bits(1, index_width(vlen + 1)), mux_lookup(format, ~default: mux(width_change, bits(4, index_width(vlen + 1)), bits(8, index_width(vlen + 1))), [[SimdElementWidth.E16, mux(width_change, bits(2, index_width(vlen + 1)), bits(4, index_width(vlen + 1)))], [SimdElementWidth.E32, mux(width_change, bits(1, index_width(vlen + 1)), bits(2, index_width(vlen + 1)))], [SimdElementWidth.E64, bits(1, index_width(vlen + 1))]])))
  fun aligned_first(first :: Bits(index_width(vlen + 1)), sew :: Bits(2)):
    mux_lookup(sew, ~default: first.align_down(8), [[1, first.align_down(4)], [2, first.align_down(2)], [3, first]])
  // A vector gather's second read owns port zero in the index-response cycle.
  // The next index read can overlap the preceding data response, not its read.
  def multiply_accumulate = descriptor.control.multiply_divide & descriptor.control.multiply_accumulate
  def fp_fused = descriptor.control.fp_service & (descriptor.control.fp_execution.unit === RV5StageFloatUnit.FusedMultiplyAdd)
  def destination_source = multiply_accumulate ||| fp_fused
  def second_source = slide ||| !descriptor.control.floating_point ||| descriptor.control.fp_uses_vs1
  def floating_scalar_operand = descriptor.control.floating_point & (descriptor.control.operand === VectorOperandMode.FloatingScalar)
  def fp_service_scalar_operand = descriptor.control.fp_service & floating_scalar_operand
  def checked_floating_scalar = mux_lookup(sew, ~default: descriptor.floating_scalar, [[1, riscv_unbox(FloatFormat.F16, 64, descriptor.floating_scalar).as_bits().zext(64)], [2, riscv_unbox(FloatFormat.F32, 64, descriptor.floating_scalar).as_bits().zext(64)]])
  def floating_scalar = mux(descriptor.control.fp_service, descriptor.floating_scalar, checked_floating_scalar)
  def destination_width = sew + ((descriptor.control.widening & multiply_accumulate) ||| fp_widening).as_bits().zext(2)
  def row_base_width = index_width(vector_depth(vlen))
  // Whole-element displacement stays at XLEN until bounds are checked. Extra
  // bits retain both unsigned overflow and the negative slide-up prefix.
  def slide_distance = mux(descriptor.control.slide_one, bits(1, xlen.width), mux(descriptor.control.operand === VectorOperandMode.Immediate, vs1.zext(xlen.width), descriptor.scalar))
  def slide_delta = mux(descriptor.control.slide_up, -slide_distance.zext(xlen.width + 2), slide_distance.zext(xlen.width + 2))
  // Every destination cursor is chunk-aligned, including a restarted chunk,
  // so this byte offset is constant throughout the retained macro.
  def slide_offset = (slide_delta[0..3] << sew)
  def slide_base = vs2.zext(row_base_width) << index_width(vector_chunks(vlen))
  def index_sew = mux(indexed_memory, descriptor.control.memory_index_eew, mux(descriptor.control.gather_index16, bits(1, 2), sew))
  def scalar_index = mux(descriptor.control.operand === VectorOperandMode.Immediate, vs1.zext(64), if xlen == XLen.X64 | descriptor.scalar | descriptor.scalar.zext(64))
  def read_destination_chunk = read_beat.first >> (bits(3, 2) - destination_width)
  def extension_part = mux_lookup(descriptor.control.extension_ratio, ~default: read_destination_chunk[0].as_bits().zext(3), [[SimdExtensionRatio.By4, read_destination_chunk[0..2].zext(3)], [SimdExtensionRatio.By8, read_destination_chunk[0..3]]])
  def index_shift = (read_beat.first[0..3] << index_sew) ++ bits(0, 3)
  def index_word = results[1].bits >> index_shift
  def vector_index = mux_lookup(index_sew, ~default: index_word[0..8].zext(64), [[1, index_word[0..16].zext(64)], [2, index_word[0..32].zext(64)], [3, index_word]])
  def gather_index = mux(gather_vector, vector_index, scalar_index)
  def gather_in_range = gather_index < geometry.vlmax.zext(64)
  def gather_address = slide_base + mux(gather_in_range, (gather_index >> (bits(3, 2) - sew))[0..row_base_width], bits(0, row_base_width))
  // Rotate the selected source element directly into its destination slot;
  // scalar gathers rotate to slot zero, then use width-selected replication.
  def gather_offset = (gather_index[0..3] << sew) - mux(gather_vector, read_beat.first[0..3] << sew, bits(0, 3))
  def gather_data_read = response.valid & gather_vector & !clear
  // A dependent gather read occupies port zero for one cycle. Its data
  // response can overlap the next index request without losing either context.
  def can_read = !clear & !gather_data_read & !compress_flush & ((reserved < bits(2, 2)) ||| issue.fire())
  request |> gate_flow(can_read) |> to_valid() |> map_valid(plan => plan.context) |> context_pipe.ingress
  context_pipe.flush <== clear
  def launch = request.fire()
  reads[0].valid <== (launch & request.bits.enables[0].into(Bool)) ||| (gather_data_read & !read_beat.empty)
  reads[0].bits <== mux(gather_data_read, gather_address, request.bits.addresses[0])
  for (port in 1..3):
    reads[port].valid <== launch & request.bits.enables[port].into(Bool)
    reads[port].bits <== request.bits.addresses[port]
  mask_read.valid <== launch & request.bits.mask_enable
  mask_read.bits <== request.bits.mask_address
  packing.control <== VectorPackingControl(vlen):
    element_width: read_beat.element_width
    first_element: mux(width_change, aligned_first(read_beat.first, sew), read_beat.first)
    vl: limit
    vstart: minimum
    vlmax: mux(whole_register_move, limit, geometry.vlmax)
    masked: descriptor.masked & !mask_select & !carry_input
    operand_select: mux_lookup(descriptor.control.operand, ~default: VectorOperandSelect.Vector, [[VectorOperandMode.Scalar, VectorOperandSelect.Scalar], [VectorOperandMode.FloatingScalar, VectorOperandSelect.Scalar], [VectorOperandMode.Immediate, VectorOperandSelect.Immediate]])
    immediate_kind: descriptor.control.immediate_kind
    widening: widening & !reduction
    narrowing: narrowing
    extension: extension
    extension_ratio: descriptor.control.extension_ratio
    extension_signed: descriptor.control.extension_signed
    extension_part: extension_part
    upper_half: width_change & (read_beat.first =/= aligned_first(read_beat.first, sew))
    left_wide: wide_vs2
    left_signed: descriptor.control.left_signed
    right_signed: descriptor.control.right_signed
  packing.left <== results[0].bits
  packing.right <== mux(second_source, results[1].bits, bits(0, 64))
  packing.mask_word <== mask_result.bits
  packing.scalar <== mux(floating_scalar_operand, floating_scalar, if xlen == XLen.X64 | descriptor.scalar | descriptor.scalar.into(SInt(32)).sext(64).into(Bits(64)))
  packing.immediate <== concat(descriptor.instruction[26], vs1)
  // Premerge bytes before the ALU's existing E64 rotate-right. Scalar insert
  // bytes keep their element-local position because the offset is SEW-aligned.
  def slide_source = vec(for List (byte in 0..8):
                           def high = bits(byte, 3) < slide_offset
                           def valid = mux(high, response.bits.slide_valid[byte + 8], response.bits.slide_valid[byte]).into(Bool)
                           def source = mux(valid, mux(high, results[1].bits[byte * 8..byte * 8 + 8], results[0].bits[byte * 8..byte * 8 + 8]), bits(0, 8))
                           def destination_byte = bits(byte, 3) - slide_offset
                           def destination_element = read_beat.first + (destination_byte >> sew).zext(index_width(vlen + 1))
                           def insert = descriptor.control.slide_one & (destination_element === mux(descriptor.control.slide_up, bits(0, index_width(vlen + 1)), limit - bits(1, index_width(vlen + 1))))
                           def scalar_byte = mux_lookup(sew, ~default: packing.scalar[0..8], for List (format in 1..4): [format, packing.scalar[(byte mod (2 ** format)) * 8..(byte mod (2 ** format)) * 8 + 8]])
                           mux(insert, scalar_byte, source)).as_bits()
  def slide_enabled = vec(for List (lane in 0..8):
                            !descriptor.control.slide_up ||| descriptor.control.slide_one ||| ((read_beat.first.zext(xlen.width + 2) + bits(lane, xlen.width + 2)) >= slide_distance.zext(xlen.width + 2))).as_bits()
  def memory_shift_width = mux(descriptor.control.fp_service, read_beat.fp_source_width.into(Bits(2)), sew)
  def memory_shift = ((read_beat.first[0..3] << memory_shift_width) ++ bits(0, 3))
  def first_shift_width = mux(descriptor.control.fp_service & descriptor.control.wide_vs2, read_beat.fp_result_width.into(Bits(2)), memory_shift_width)
  def first_shift = ((read_beat.first[0..3] << first_shift_width) ++ bits(0, 3))
  def indexed_address = read_beat.address + vector_index
  def destination_shift = ((read_beat.first[0..3] << destination_width) ++ bits(0, 3))
  def memory_enabled = !read_beat.empty & (!descriptor.masked ||| (mask_result.bits >> read_beat.first[0..6])[0].into(Bool))
  def operands = read_beat.updated(
    ~address: mux(indexed_memory, indexed_address, read_beat.address),
    ~left: mux(gather, mux(gather_in_range, results[0].bits, bits(0, 64)), mux(slide, slide_source, mux(scan, results[0].bits >> read_beat.first[0..6], mux(singleton, results[0].bits >> first_shift, packing.operands.left)))),
    ~right: mux(gather, (gather_offset ++ bits(0, 3)).zext(64), mux(slide, (slide_offset ++ bits(0, 3)).zext(64), mux(mask_logic ||| reduction, results[1].bits, mux(fp_service_scalar_operand, floating_scalar, mux(singleton & (descriptor.control.operand === VectorOperandMode.Vector), results[1].bits >> memory_shift, packing.operands.right))))),
    ~destination_data: results[2].bits >> destination_shift,
    ~carry_in: mux(carry_input, (mask_result.bits >> read_beat.first[0..6])[0..8], bits(0, 8)).into(Mask(8)),
    ~select_right: mux(mask_select, (mask_result.bits >> read_beat.first[0..6])[0..8], mux(extension ||| whole_register_move, bits(0, 8), !bits(0, 8))).into(Mask(8)),
    ~mask_enabled: read_beat.mask_enabled & mux(scan & descriptor.masked, mask_result.bits >> read_beat.first[0..6], !bits(0, 64)),
    ~destination_first: packing.operands.first_element,
    ~element_width: packing.operands.element_width,
    // One physical 64-bit logic lane computes the word; mask_enabled controls
    // its 64 independently writable architectural elements at the result port.
    ~enabled: mux(mask_logic, read_beat.mask_enabled.or_reduce().as_bits().zext(8).into(Mask(8)), mux(singleton, memory_enabled.as_bits().zext(8).into(Mask(8)), (mux(read_beat.empty, bits(0, 8), packing.operands.enabled.as_bits()) & mux(slide, slide_enabled, !bits(0, 8))).into(Mask(8))))
  )
  inst compactor(SimdCompress())
  def compress_mask = results[1].bits >> read_beat.first[0..6]
  def compress_selected = vec(for List (lane in 0..8):
                                def position = read_beat.first.zext(index_width(vlen + 1) + 1) + bits(lane, index_width(vlen + 1) + 1)
                                (!read_beat.empty & (bits(lane, index_width(vlen + 1)) < lanes) & (position < read_beat.end.zext(index_width(vlen + 1) + 1)) & compress_mask[lane].into(Bool)).as_bits()).into(Mask(8))
  compactor.data <== results[0].bits
  compactor.element_width <== read_beat.element_width
  compactor.selected <== compress_selected
  def append_shift = mux_lookup(read_beat.element_width, ~default: compress_count.zext(7) << 3, [[SimdElementWidth.E16, compress_count.zext(7) << 4], [SimdElementWidth.E32, compress_count.zext(7) << 5], [SimdElementWidth.E64, compress_count.zext(7) << 6]])
  def combined = compress_data.zext(128) ||| (compactor.compressed.data.zext(128) << append_shift)
  def total_count = compress_count.zext(5) + compactor.compressed.count.zext(5)
  def lane_count = lanes[0..5]
  def compress_full = total_count >= lane_count
  def remainder_count = mux(compress_full, total_count - lane_count, total_count)[0..4]
  def source_final = read_beat.end === limit
  def needs_flush = source_final & compress_full & remainder_count.or_reduce()
  def emitted_count = mux(compress_full, lane_count, mux(source_final, total_count, bits(0, 5)))[0..4]
  def emits_write = compress_full ||| (source_final & total_count.or_reduce())
  def post_compress_state = RV5StageVectorCompressState(vlen):
    data: mux(source_final & !needs_flush, bits(0, 64), mux(compress_full, combined[64..128], combined[0..64]))
    count: mux(source_final & !needs_flush, bits(0, 4), remainder_count)
    destination: compress_destination + emitted_count.zext(index_width(vlen + 1))
  def compress_beat = read_beat.updated(
    ~destination_first: compress_destination,
    ~last: source_final & !needs_flush,
    ~empty: !emits_write,
    ~left: combined[0..64],
    ~right: bits(0, 64),
    ~enabled: vec(for List (lane in 0..8): (bits(lane, 4) < emitted_count).as_bits()).into(Mask(8)),
    ~select_right: bits(0, 8).into(Mask(8)),
    ~compress_state: post_compress_state
  )
  fun compression_flush_beat(state :: RV5StageVectorCompressState(vlen)) :~ RV5StageVectorBeat(vlen):
    RV5StageVectorBeat(vlen):
      sequence: flush_sequence
      first: limit
      end: limit
      destination_first: state.destination
      last: Bool(#true)
      empty: Bool(#false)
      address: bits(0, 64)
      left: state.data
      right: bits(0, 64)
      destination_data: bits(0, 64)
      enabled: vec(for List (lane in 0..8): (bits(lane, 4) < state.count).as_bits()).into(Mask(8))
      carry_in: bits(0, 8).into(Mask(8))
      select_right: bits(0, 8).into(Mask(8))
      mask_enabled: bits(0, 64)
      element_width: format
      fp_source_width: format
      fp_result_width: format
      rounding_mode: descriptor.state.vxrm.into(SimdRoundingMode)
      fp_rounding_mode: descriptor.rounding_mode
      control: descriptor.control
      destination: vd
      compress_state:
        RV5StageVectorCompressState(vlen):
          data: bits(0, 64)
          count: bits(0, 4)
          destination: state.destination + state.count.zext(index_width(vlen + 1))
  gather_pipe.flush <== clear
  def Array(direct_response, indexed_response, compression_response) = response |> fork_valid(3)
  (
    indexed_response |> filter_valid(_context => gather_vector & !clear)
      |> map_valid(context => GatherRead()):
           context: context.instruction.context
           beat: operands
           in_range: gather_in_range
  ) |> gather_pipe.ingress
  def direct = direct_response |> filter_valid(_context => !gather_vector & !clear) |> map_valid(context => RV5StageVectorMicroOp(vlen, Context)):
    context: context.instruction.context
    beat: mux(compress, compress_beat, operands)
  def gathered_read :: GatherRead() = gather_pipe.egress.bits
  def gathered = gather_pipe.egress |> map_valid(_value => RV5StageVectorMicroOp(vlen, Context)):
    context: gathered_read.context
    beat: gathered_read.beat.updated(~left: mux(gathered_read.in_range, results[0].bits, bits(0, 64)))
  def flush_state = RV5StageVectorCompressState(vlen):
    data: compress_data
    count: compress_count
    destination: compress_destination
  def flush_offer = compress_flush & !clear
  def flush_operation = RV5StageVectorMicroOp(vlen, Context):
    context: compress_context.instruction.context
    beat: compression_flush_beat(flush_state)
  wire flush_ready: Bool
  def flushed = inject_flow(Decoupled(MicroOp), ~valid: flush_offer, ~bits: flush_operation, ~ready: flush_ready)
  def capture_compression = response.valid & compress & !clear
  def discard_compression = begin_macro ||| (clear & !retry)
  describe_interface_retained_storage(capture_compression, compress_context_valid & (capture_compression ||| discard_compression), compress_context_valid, ~name: "compression")
  describe_interface_contract(compression_response, flushed, "compression-suffix", ~trace_model: interface_trace_retained(~name: "compression"))
  pending.flush <== clear
  def returned = Array(direct, gathered) |> valid_arbiter() |> to_decoupled()
  Array(returned, flushed) |> arbiter() |> pending.ingress
  def flush_enqueue = flushed.fire()
  def reserve_event = launch ||| flush_enqueue
  active <== reserved.or_reduce() ||| compress_flush
  when clear:
    reserved <== bits(0, 2)
  elsewhen (reserve_event =/= issue.fire()):
    reserved <== mux(reserve_event, reserved + bits(1, 2), reserved - bits(1, 2))
  when (response.valid & !clear ||| gather_pipe.egress.valid & !clear):
    assert(pending.ingress.ready, "vector_read_has_reserved_output_slot")
  when (gather_pipe.egress.valid & !clear):
    assert(gathered_read.beat.empty ||| results[0].valid, "vector_gather_data_matches_context")
  when (response.valid & !clear):
    assert(read_beat.empty ||| (results[0].valid & (!second_source ||| results[1].valid) & mask_result.valid & (!destination_source ||| results[2].valid)), "vector_read_context_matches_data_and_mask_ports")
    assert(singleton ||| mask_word ||| read_beat.empty ||| packing.legal, "vector_packed_read_is_legal")
  when discard_compression:
    compress_context_valid <== Bool(#false)
  elsewhen capture_compression:
    compress_context_valid <== Bool(#true)
  when (begin_macro):
    authorized_compress_data <== bits(0, 64)
    authorized_compress_count <== bits(0, 4)
    authorized_compress_destination <== bits(0, index_width(vlen + 1))
    authorized_sequence <== bits(0, vector_sequence_width(vlen))
    authorized_end <== bits(0, index_width(vlen + 1))
  elsewhen (feedback.valid & (feedback.bits.disposition === RV5StageVectorDisposition.Authorized)):
    authorized_compress_data <== feedback.bits.compress_state.data
    authorized_compress_count <== feedback.bits.compress_state.count
    authorized_compress_destination <== feedback.bits.compress_state.destination
    authorized_sequence <== authorized_sequence + bits(1, vector_sequence_width(vlen))
    authorized_end <== feedback.bits.end
  when retry:
    compress_data <== authorized_compress_data
    compress_count <== authorized_compress_count
    compress_destination <== authorized_compress_destination
    compress_flush <== compress_context_valid & compress_context.beat.last & (authorized_end === compress_context.beat.end) & authorized_compress_count.or_reduce()
    flush_sequence <== authorized_sequence
  elsewhen (clear ||| begin_macro):
    compress_data <== bits(0, 64)
    compress_count <== bits(0, 4)
    compress_destination <== bits(0, index_width(vlen + 1))
    compress_flush <== Bool(#false)
  elsewhen (response.valid & compress):
    compress_context <== response.bits
    flush_sequence <== read_beat.sequence + bits(1, vector_sequence_width(vlen))
    compress_data <== post_compress_state.data
    compress_count <== post_compress_state.count
    compress_destination <== post_compress_state.destination
    compress_flush <== needs_flush
  elsewhen flush_enqueue:
    compress_data <== bits(0, 64)
    compress_count <== bits(0, 4)
    compress_destination <== compress_destination + compress_count.zext(index_width(vlen + 1))
    compress_flush <== Bool(#false)

export RV5StageVectorOperandFetch
