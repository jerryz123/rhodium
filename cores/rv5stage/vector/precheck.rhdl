#lang rhodium
// Computes conservative vector memory byte footprints without an element-address multiplier.
// SPDX-License-Identifier: Apache-2.0

import:
  "bundles.rhdl" open
  "geometry.rhdl".vector_zero_stride_load_parts
  "../mmu/protocol.rhdl" open
  "../decode/vector-ctrl.rhdl" open
  "../../../riscv/isa/vector.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/rtl/pointer-masking.rhdl" open
  "../../../riscv/rtl/vector.rhdl".RiscvVectorState
  lib("rhodium/std/bits.rhdl").count_leading_zeros

bundle RV5StageVectorFootprintGeometry():
  eligible: Bool
  empty: Bool
  start_offset: Bits(68)
  span_bytes: Bits(68)
  eew: Bits(2)
  reverse: Bool
  strided: Bool

bundle RV5StageVectorFootprint():
  eligible: Bool
  empty: Bool
  range: RV5StageVectorRange()

fun vector_field_extent(value :: Bits(68), nf :: Bits(3)) :~ Bits(68):
  mux_lookup(nf, ~default: value, [
    [1, value << 1], [2, (value << 1) + value], [3, value << 2],
    [4, (value << 2) + value], [5, (value << 2) + (value << 1)],
    [6, (value << 3) - value], [7, value << 3]
  ])

fun vector_footprint_geometry(xlen :: XLen, vlen :: VectorLength, control :: RV5StageVectorControl(), instruction :: Bits(32), state :: RiscvVectorState(xlen)) :~ RV5StageVectorFootprintGeometry():
  def whole = control.memory_mode === VectorMemoryMode.WholeRegister
  def mask = control.memory_mode === VectorMemoryMode.Mask
  def zero_stride = vector_zero_stride_load_parts(control, instruction)
  def eew = mux(mask, bits(0, 2), control.memory_data_eew)
  def start = state.vstart.zext(68)
  def whole_limit = vector_field_extent(bits(vlen / 8, 68), control.memory_nf) >> eew
  def limit = mux(whole, whole_limit, mux(mask, (state.vl.zext(68) + bits(7, 68)) >> 3, state.vl.zext(68)))
  def nf = mux(whole ||| mask, bits(0, 3), control.memory_nf)
  RV5StageVectorFootprintGeometry():
    eligible: control.memory & ((control.memory_addressing === VectorMemoryAddressing.UnitStride) ||| zero_stride) & (control.memory_mode =/= VectorMemoryMode.FaultOnlyFirst)
    empty: start >= limit
    start_offset: mux(zero_stride, bits(0, 68), vector_field_extent(start << eew, nf))
    span_bytes: mux(zero_stride, bits(1, 68) << eew, vector_field_extent((limit - start) << eew, nf))
    eew: eew
    reverse: Bool(#false)
    strided: Bool(#false)

// Round a small runtime stride upward so the single-page MEM probe needs a
// shift, not an element-count multiplier. An overlarge envelope only misses
// this optional fast path; it never changes the elementwise addresses.
fun vector_strided_fast_geometry(xlen :: XLen, vlen :: VectorLength, control :: RV5StageVectorControl(), state :: RiscvVectorState(xlen), stride :: Bits(xlen.width)) :~ RV5StageVectorFootprintGeometry():
  def magnitude = mux(stride[xlen.width - 1].into(Bool), -stride, stride)
  def small = magnitude[0..12]
  def exponent = bits(12, 4) - count_leading_zeros(small - bits(1, 12))
  def length = state.vl[0..index_width(vlen + 1)]
  def steps = mux(length.or_reduce(), length - bits(1, index_width(vlen + 1)), bits(0, index_width(vlen + 1)))
  def distance = mux(small.or_reduce(), steps.zext(68) << exponent, bits(0, 68))
  def eew = control.memory_data_eew
  def alignment_mask = (bits(1, xlen.width) << eew) - bits(1, xlen.width)
  RV5StageVectorFootprintGeometry():
    eligible: control.memory & (control.memory_addressing === VectorMemoryAddressing.Strided) & !control.memory_nf.or_reduce() & (control.memory_mode =/= VectorMemoryMode.FaultOnlyFirst) & !state.vstart.or_reduce() & (!magnitude[12..xlen.width].or_reduce() ||| !steps.or_reduce()) & !(stride & alignment_mask).or_reduce()
    empty: !length.or_reduce()
    start_offset: mux(stride[xlen.width - 1].into(Bool), distance, bits(0, 68))
    span_bytes: distance + (bits(1, 68) << eew)
    eew: eew
    reverse: stride[xlen.width - 1].into(Bool)
    strided: Bool(#true)

fun vector_fast_footprint_geometry(xlen :: XLen, vlen :: VectorLength, control :: RV5StageVectorControl(), instruction :: Bits(32), state :: RiscvVectorState(xlen), stride :: Bits(xlen.width)) :~ RV5StageVectorFootprintGeometry():
  def ordinary = vector_footprint_geometry(xlen, vlen, control, instruction, state)
  def dynamic_stride = vector_strided_fast_geometry(xlen, vlen, control, state, stride)
  mux((control.memory_addressing === VectorMemoryAddressing.Strided) & !vector_zero_stride_load_parts(control, instruction), dynamic_stride, ordinary)

fun vector_footprint(xlen :: XLen, vlen :: VectorLength, descriptor :: RV5StageVectorDescriptor(xlen), masking :: PointerMaskControl()) :~ RV5StageVectorFootprint():
  def geometry = vector_footprint_geometry(xlen, vlen, descriptor.control, descriptor.instruction, descriptor.state)
  def first_raw = descriptor.scalar.zext(68) + geometry.start_offset
  def last_raw = first_raw + geometry.span_bytes - bits(1, 68)
  def first_address = apply_pointer_mask(xlen, first_raw[0..xlen.width], masking)
  def last_address = apply_pointer_mask(xlen, last_raw[0..xlen.width], masking)
  def first = if xlen == XLen.X32 | first_address.zext(64) | first_address
  def last = if xlen == XLen.X32 | last_address.zext(64) | last_address
  def no_wrap = !first_raw[xlen.width..68].or_reduce() & !last_raw[xlen.width..68].or_reduce() & (first <= last) & ((last - first).zext(68) === (last_raw - first_raw))
  def aligned = (first & ((bits(1, 64) << geometry.eew) - bits(1, 64))) === bits(0, 64)
  def two_pages = (last[12..64] === first[12..64]) ||| (last[12..64] === (first[12..64] + bits(1, 52)))
  RV5StageVectorFootprint():
    eligible: geometry.eligible & no_wrap & aligned & two_pages
    empty: geometry.empty
    range:
      RV5StageVectorRange():
        first: first
        last: last
        store: descriptor.control.store

export:
  RV5StageVectorFootprintGeometry
  vector_footprint_geometry
  vector_fast_footprint_geometry
  RV5StageVectorFootprint
  vector_field_extent
  vector_footprint
