#lang rhodium
// Scans packed mask chunks and packs prefix counts or indices without owning retirement state.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/riscv/vector-layout.rhm") open
  lib("riscv/isa/xlen.rhm").XLen
  "../../simd-alu.rhdl" open
  lib("rhodium/std/bits.rhdl") open

hardware_enum VectorScanResult:
  Count
  First
  Mask
  Elements

bundle VectorMaskScanControl():
  result: VectorScanResult
  index: Bool
  include_first: Bool
  only_first: Bool

circuit RV5StageVectorMaskScan(xlen :: XLen):
  input(source, enabled, first, carry): Bits(xlen.width)
  input element_width: SimdElementWidth
  input control: VectorMaskScanControl()
  output(data, next_carry): Bits(xlen.width)
  def selected = source & enabled
  // A shared parallel prefix network supplies the total and every lane prefix.
  // One extra count bit represents a fully selected physical word.
  def mutable sums = for List (index in 0..xlen.width): selected[index].zext(vector_bit_offset_width(xlen) + 1)
  for (level in 0..vector_bit_offset_width(xlen)):
    def previous = sums
    def distance = 2 ** level
    sums := for List (index in 0..xlen.width):
      def current :: Bits(vector_bit_offset_width(xlen) + 1) = previous[index]
      if index < distance
      | current
      | def lower :: Bits(vector_bit_offset_width(xlen) + 1) = previous[index - distance]
        current + lower
  def prefixes = [bits(0, vector_bit_offset_width(xlen) + 1)] ++ sums
  def total :: Bits(vector_bit_offset_width(xlen) + 1) = sums[xlen.width - 1]
  def count = carry + total.zext(xlen.width)
  def first_set = count_leading_zeros(reverse_bits(selected)).zext(xlen.width)
  def first_result = mux((carry === !bits(0, xlen.width)) & selected.or_reduce(), first + first_set, carry)
  def mask = vec(for List (index in 0..xlen.width):
                   def preceding :: Bits(vector_bit_offset_width(xlen) + 1) = prefixes[index]
                   !carry.or_reduce() & !preceding.or_reduce() & mux(control.only_first, selected[index].into(Bool), control.include_first ||| !selected[index].into(Bool))).as_bits()
  def elements = for List (format in 0..vector_format_count(xlen)):
    def width = 8 * (2 ** format)
    vec(for List (lane in 0..(xlen.width / width)):
          def preceding :: Bits(vector_bit_offset_width(xlen) + 1) = prefixes[lane]
          mux(control.index, first + bits(lane, xlen.width), carry + preceding.zext(xlen.width))[0..width]).as_bits()
  def packed = mux_lookup(element_width, ~default: elements[0], for List (format in 1..vector_format_count(xlen)): [SimdElementWidth.values()[format], elements[format]])
  next_carry <== mux(control.result === VectorScanResult.First, first_result, count)
  data <== mux_lookup(control.result, ~default: count, [[VectorScanResult.First, first_result], [VectorScanResult.Mask, mask], [VectorScanResult.Elements, packed]])

export:
  VectorScanResult
  VectorMaskScanControl
  RV5StageVectorMaskScan
