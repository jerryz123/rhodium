#lang rhodium
// Prepares replayable packed requests and shares alignment with independently retained load assembly.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/riscv/vector-layout.rhm").VectorRegisterLayout
  "bundles.rhdl" open
  "packed-bundles.rhdl" open
  "packed-load.rhdl" open
  "register-file.rhdl" open
  "precheck.rhdl".vector_field_extent
  "../decode/vector-ctrl.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/isa/vector.rhm" open
  "../../../riscv/model/formats.rhm" as riscv_fields
  "../../../riscv/rtl/instruction-fields.rhdl".instruction_field
  "../../../riscv/rtl/vector.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

hardware_enum RV5StagePackedPrepare:
  Map
  MaskLow
  MaskHigh
  MaskDone
  Read
  ReadDone
  Align
  Issue

sync_circuit RV5StageVectorPackedMemory(xlen :: XLen, vlen :: VectorLength, Context :: DataType, slots :: Pow2Int, ~owner_count: owner_count :: Pow2Int = 2):
  def bytes = xlen.width / 8
  def Count = Bits(index_width(vlen + 1))
  def Address = Bits(index_width(VectorRegisterLayout(vlen, 64).depth))
  def Tag = Bits(index_width(slots))
  def Owner = Bits(index_width(owner_count))
  def Cursor = RV5StageVectorPackedCursor(vlen)
  def Layout = RV5StageVectorPackedLayout(xlen, vlen)
  interface launch(Valid(RV5StageVectorInstruction(xlen, Context)), ~role: consumer)
  input instruction: RV5StageVectorInstruction(xlen, Context)
  input(occupied, schedule_enable): Bool
  interface issue(Decoupled(RV5StageVectorToken(Context, slots)), ~role: producer)
  interface commit(Valid(RV5StageVectorCommit(xlen, slots)), ~role: consumer)
  interface cancel(Pulse(), ~role: consumer)
  interface completion(Valid(RV5StageVectorCompletion(xlen, slots)), ~role: consumer)
  interface reads[3](Valid(Address), ~role: producer)
  interface results[3](Valid(Bits(64)), ~role: consumer)
  interface mask_read(Valid(Bits(index_width(VectorRegisterLayout(vlen, 64).rows_per_register))), ~role: producer)
  interface mask_result(Valid(Bits(64)), ~role: consumer)
  interface alignment(Valid(RV5StageVectorAlignment()), ~role: producer)
  input aligned: Bits(64)
  interface write(Valid(VectorRegisterWrite(vlen)), ~role: producer)
  interface issue_done(Pulse(), ~role: producer)
  interface released(Valid(Tag), ~role: producer)
  input slot: Tag
  input head: Tag
  input(slot_available, schedule_slot_available, drain_enable, alignment_available): Bool
  input write_available: Bool
  input owner: Owner
  input accepted_slots: Vec(slots, Bool)
  input closed_owners: Vec(owner_count, Bool)
  input blocked_rows: Vec(VectorRegisterLayout(vlen, 64).depth, Bool)
  output(busy_rows, foreign_rows): Vec(VectorRegisterLayout(vlen, 64).depth, Bool)
  output drain_blocked: Bool
  output active: Bool

  inst assembly(RV5StageVectorPackedLoad(xlen, vlen, slots, owner_count))
  reg cursor(Cursor)
  reg all_issued(~init: Bool(#false))
  reg prepare(~init: RV5StagePackedPrepare.Map)
  reg layout(Layout)
  reg byte_mask(Bits(bytes))
  reg low_mask(Bits(64))
  reg high_mask(Bits(64))
  reg store_data(Bits(64))
  reg store_remaining(Bits(bytes))
  reg read_row(Address)
  reg read_lane(Bits(index_width(bytes)))
  reg read_data(Bits(64))
  def descriptor = instruction.descriptor
  def vd = instruction_field(riscv_fields.rd, descriptor.instruction)
  def whole = descriptor.control.memory_mode === VectorMemoryMode.WholeRegister
  def mask_transfer = descriptor.control.memory_mode === VectorMemoryMode.Mask
  def eew = mux(mask_transfer, bits(0, 2), descriptor.control.memory_data_eew)
  def nf = mux(whole ||| mask_transfer, bits(0, 3), descriptor.control.memory_nf)
  def segmented = nf.or_reduce()
  def geometry = vector_type(xlen, vlen, descriptor.state.vtype)
  def emul = geometry.lmul.into(SInt(3)).sext(5) + eew.zext(5).into(SInt(5)) - geometry.sew.zext(5).into(SInt(5))
  def group_shift = mux(emul < SInt(5)(0), bits(0, 3), emul.as_bits()[0..3])
  def limit = mux(whole, (vector_field_extent(bits(vlen / 8, 68), descriptor.control.memory_nf) >> eew)[0..index_width(vlen + 1)], mux(mask_transfer, ((descriptor.state.vl + bits(7, xlen.width)) >> 3)[0..index_width(vlen + 1)], descriptor.state.vl[0..index_width(vlen + 1)]))
  def store = descriptor.control.store
  def masked = descriptor.masked & !whole & !mask_transfer
  def retry = commit.valid & (commit.bits.disposition === RV5StageVectorDisposition.Retry)
  def clear = retry ||| cancel.valid
  def successful = commit.valid & (commit.bits.disposition === RV5StageVectorDisposition.Authorized)
  def scheduling = occupied & schedule_enable
  def offers :: Handle = interface_link(Decoupled(RV5StageVectorToken(Context, slots)))
  def offered = offers.left
  def issued = offers.right |> trace_event("vector/s2.issue", ~stalls: #true, ~fields: token):
    packed: Bool(#true)
    memory_bytes(~format: "unsigned"): bits(bytes, 4)
    store: store
    address: token.address
    byte_mask: token.byte_mask
    slot(~format: "unsigned"): token.completion_tag
    last: token.last
  issued |> issue
  // Increment the logical byte/field cursor; no element-address multiplier or divider.
  def mutable element :: Bits(index_width(vlen + 1)) = cursor.element
  def mutable field :: Bits(3) = cursor.field
  def mutable byte :: Bits(3) = cursor.byte
  def mutable row_values = []
  def mutable offset_values = []
  def mutable element_values = []
  def mutable live_values = []
  for (lane in 0..bytes):
    def live = (bits(lane, 3) >= cursor.leading) & (element < limit)
    def register = vd + (field.zext(5) << group_shift)
    def position = (element.zext(index_width(vlen + 1) + 3) << eew) + byte.zext(index_width(vlen + 1) + 3)
    row_values := row_values ++ [((register.zext(index_width(VectorRegisterLayout(vlen, 64).depth)) << index_width(VectorRegisterLayout(vlen, 64).rows_per_register)) + (position >> 3)[0..index_width(VectorRegisterLayout(vlen, 64).depth)])]
    offset_values := offset_values ++ [position[0..3]]
    element_values := element_values ++ [element]
    live_values := live_values ++ [live]
    def end_byte = byte === ((bits(1, 4) << eew) - bits(1, 4))[0..3]
    def end_field = field === nf
    element := element + (live & end_byte & end_field).as_bits().zext(index_width(vlen + 1))
    field := mux(live & end_byte, mux(end_field, bits(0, 3), field + bits(1, 3)), field)
    byte := mux(live, mux(end_byte, bits(0, 3), byte + bits(1, 3)), byte)
  def mapped = RV5StageVectorPackedLayout(xlen, vlen):
    before: cursor
    after:
      RV5StageVectorPackedCursor(vlen):
        address: cursor.address + bits(bytes, 64)
        element: element
        field: field
        byte: byte
        leading: bits(0, 3)
    rows: vec(row_values)
    offsets: vec(offset_values)
    elements: vec(element_values)
    live: vec(live_values).as_bits()
    last: element >= limit
  def fast_load = !store & !masked
  def fast_store = store & !masked & !segmented
  inst store_reads(ValidPipe(Layout, 1, ~flushable: #true))
  store_reads.flush <== clear
  def mapped_sources_ready = !vec(for List (lane in 0..bytes): mapped.live[lane].into(Bool) & blocked_rows[mapped.rows[lane]]).as_bits().or_reduce()
  def prefetch_store = scheduling & fast_store & !all_issued & !clear & mapped_sources_ready & schedule_slot_available & alignment_available
  store_reads.ingress.valid <== prefetch_store
  store_reads.ingress.bits <== mapped
  def offered_layout = mux(fast_load, mapped, mux(fast_store, store_reads.egress.bits, layout))
  def offered_mask = mux(fast_load ||| fast_store, offered_layout.live, byte_mask)
  def destinations_ready = !vec(for List (lane in 0..bytes): offered_layout.live[lane].into(Bool) & blocked_rows[offered_layout.rows[lane]]).as_bits().or_reduce()
  def can_issue = scheduling & (!all_issued ||| fast_store) & !clear & slot_available & (store ||| destinations_ready)
  offered.valid <== can_issue & mux(fast_store, store_reads.egress.valid & alignment_available, fast_load ||| (prepare === RV5StagePackedPrepare.Issue))
  offered.bits <== RV5StageVectorToken(Context, slots):
    byte_mask: if bytes == 8 | offered_mask | offered_mask.zext(8)
    context: instruction.context
    last: offered_layout.last
    truncate_on_fault: Bool(#false)
    memory: Bool(#true)
    memory_width: bits(if xlen == XLen.X64 | 3 | 2, 2)
    enabled: offered_mask.or_reduce()
    address: offered_layout.before.address
    store_data: mux(fast_store, aligned, store_data)
    completion_tag: slot
  // The mask shadow remains independent of the three general VRF read ports.
  def start_mask = layout.elements[0] >> 6
  def end_mask = layout.elements[bytes - 1] >> 6
  def masks_ready = !blocked_rows[start_mask[0..index_width(VectorRegisterLayout(vlen, 64).rows_per_register)].zext(index_width(VectorRegisterLayout(vlen, 64).depth))] & !blocked_rows[end_mask[0..index_width(VectorRegisterLayout(vlen, 64).rows_per_register)].zext(index_width(VectorRegisterLayout(vlen, 64).depth))]
  mask_read.valid <== scheduling & !clear & masks_ready & ((prepare === RV5StagePackedPrepare.MaskLow) ||| (prepare === RV5StagePackedPrepare.MaskHigh))
  mask_read.bits <== mux(prepare === RV5StagePackedPrepare.MaskHigh, end_mask, start_mask)[0..index_width(VectorRegisterLayout(vlen, 64).rows_per_register)]
  def enabled_bytes = vec(for List (lane in 0..bytes):
                            def word = mux((layout.elements[lane] >> 6) === start_mask, low_mask, high_mask)
                            layout.live[lane].into(Bool) & (!masked ||| word.as_vec(Bool)[layout.elements[lane][0..6]])).as_bits()
  def source_lane = priority_encoder(store_remaining)
  def source_row = layout.rows[source_lane]
  def first_store_lane = priority_encoder(mapped.live)
  def mutable last_store_row :: Bits(index_width(VectorRegisterLayout(vlen, 64).depth)) = mapped.rows[first_store_lane]
  for (lane in 0..bytes):
    last_store_row := mux(mapped.live[lane].into(Bool), mapped.rows[lane], last_store_row)
  for (port in 0..3):
    reads[port].valid <== (Bool(port < 2) & prefetch_store) ||| (Bool(port == 0) & !fast_store & store & scheduling & !clear & (prepare === RV5StagePackedPrepare.Read) & store_remaining.or_reduce() & !blocked_rows[source_row])
    reads[port].bits <== mux(fast_store, if port == 0 | mapped.rows[first_store_lane] | last_store_row, source_row)
  def store_group = vec(for List (lane in 0..bytes): store_remaining[lane].into(Bool) & (layout.rows[lane] === read_row)).as_bits()
  def store_rotation = layout.offsets[read_lane] - (if bytes == 8 | read_lane | read_lane.zext(3))

  def prefetched = store_reads.egress.bits
  def prefetched_lane = priority_encoder(prefetched.live)
  def prefetched_rotation = prefetched.offsets[prefetched_lane] - (if bytes == 8 | prefetched_lane | prefetched_lane.zext(3))
  def prefetched_row = prefetched.rows[prefetched_lane]
  def prefetched_data = vec(for List (offset in 0..8):
                             def lane = bits(offset, 3) - prefetched_rotation
                             def use_first = prefetched.rows[lane[0..index_width(bytes)]] === prefetched_row
                             mux(use_first, results[0].bits[offset * 8..offset * 8 + 8], results[1].bits[offset * 8..offset * 8 + 8])).as_bits()
  def fast_store_alignment = can_issue & fast_store & store_reads.egress.valid & alignment_available
  def slow_store_alignment = scheduling & !clear & store & !fast_store & (prepare === RV5StagePackedPrepare.Align) & alignment_available
  def store_alignment = fast_store_alignment ||| slow_store_alignment
  assembly.alignment_available <== alignment_available & !store_alignment
  assembly.aligned <== aligned
  alignment.valid <== store_alignment ||| assembly.alignment.valid
  def store_alignment_request = RV5StageVectorAlignment():
    data: mux(fast_store, prefetched_data, read_data)
    bytes: mux(fast_store, prefetched_rotation, store_rotation)
  alignment.bits <== mux(store_alignment, store_alignment_request, assembly.alignment.bits)
  when (store_reads.egress.valid & !clear):
    assert(issue.fire(), "packed_scheduled_store_read_issues_without_stall")
  def gathered_word = vec(
    for List (lane in 0..bytes):
      def index = layout.offsets[lane] - store_rotation
      mux(segmented, aligned.as_vec(Bits(8))[index], aligned[lane * 8..lane * 8 + 8])
  ).as_bits()
  def gathered = if bytes == 8 | gathered_word | gathered_word.zext(64)
  when (launch.valid):
    all_issued <== Bool(#false)
    prepare <== RV5StagePackedPrepare.Map
    def incoming = launch.bits.descriptor
    def incoming_whole = incoming.control.memory_mode === VectorMemoryMode.WholeRegister
    def incoming_mask = incoming.control.memory_mode === VectorMemoryMode.Mask
    def incoming_eew = mux(incoming_mask, bits(0, 2), incoming.control.memory_data_eew)
    def origin = incoming.scalar.zext(68) + vector_field_extent(incoming.state.vstart.zext(68) << incoming_eew, mux(incoming_whole ||| incoming_mask, bits(0, 3), incoming.control.memory_nf))
    cursor <== RV5StageVectorPackedCursor(vlen):
      address: origin[0..64].align_down(bytes)
      // Every legal transfer has at most VLEN elements; preserve empty high-vstart bodies when narrowing.
      element: mux(incoming.state.vstart >= bits(vlen, xlen.width), bits(vlen, index_width(vlen + 1)), incoming.state.vstart[0..index_width(vlen + 1)])
      field: bits(0, 3)
      byte: bits(0, 3)
      leading: if bytes == 8 | origin[0..3] | origin[0..2].zext(3)
  elsewhen retry:
    cursor <== assembly.replay_cursor
    all_issued <== Bool(#false)
    prepare <== RV5StagePackedPrepare.Map
  elsewhen (prefetch_store):
    cursor <== mapped.after
    all_issued <== mapped.last
  elsewhen (issue.fire() & !fast_store):
    cursor <== offered_layout.after
    all_issued <== offered_layout.last
    prepare <== RV5StagePackedPrepare.Map
  elsewhen (scheduling & !all_issued & !fast_load & !fast_store):
    when (prepare === RV5StagePackedPrepare.Map):
      layout <== mapped
      byte_mask <== mapped.live
      store_remaining <== mapped.live
      store_data <== bits(0, 64)
      prepare <== mux(masked, RV5StagePackedPrepare.MaskLow, mux(store, RV5StagePackedPrepare.Read, RV5StagePackedPrepare.Issue))
    elsewhen ((prepare === RV5StagePackedPrepare.MaskLow) & masks_ready):
      prepare <== RV5StagePackedPrepare.MaskHigh
    elsewhen ((prepare === RV5StagePackedPrepare.MaskHigh) & masks_ready):
      low_mask <== mask_result.bits
      prepare <== RV5StagePackedPrepare.MaskDone
    elsewhen (prepare === RV5StagePackedPrepare.MaskDone):
      high_mask <== mask_result.bits
      prepare <== RV5StagePackedPrepare.Read
    elsewhen ((prepare === RV5StagePackedPrepare.Read) & (!store ||| !store_remaining.or_reduce() ||| !blocked_rows[source_row])):
      // MaskDone's second word is now registered; retain the exact per-byte predicate.
      byte_mask <== enabled_bytes
      when (store & store_remaining.or_reduce()):
        read_row <== source_row
        read_lane <== source_lane
      prepare <== mux(store & store_remaining.or_reduce(), RV5StagePackedPrepare.ReadDone, RV5StagePackedPrepare.Issue)
    elsewhen (prepare === RV5StagePackedPrepare.ReadDone):
      when (results[0].valid):
        read_data <== results[0].bits
        prepare <== RV5StagePackedPrepare.Align
    elsewhen (slow_store_alignment):
      def mask = vec(for List (lane in 0..8): mux(if lane < bytes | store_group[lane].into(Bool) | Bool(#false), !bits(0, 8), bits(0, 8))).as_bits()
      store_data <== masked_merge(store_data, gathered, mask)
      store_remaining <== store_remaining & !store_group
      prepare <== mux((store_remaining & !store_group).or_reduce(), RV5StagePackedPrepare.Read, RV5StagePackedPrepare.Issue)

  assembly.reserve.valid <== issue.fire()
  assembly.reserve.bits <== RV5StageVectorPackedReservation(xlen, vlen, slots, owner_count):
    tag: issue.bits.completion_tag
    entry:
      RV5StageVectorPackedEntry(xlen, vlen, owner_count):
        layout: offered_layout
        mask: offered_mask
        store: store
        segmented: segmented
        owner: owner
  commit |> assembly.commit
  completion |> assembly.completion
  assembly.head <== head
  assembly.owner <== owner
  assembly.accepted_slots <== accepted_slots
  assembly.closed_owners <== closed_owners
  assembly.drain_enable <== drain_enable
  assembly.write_available <== write_available
  assembly.write |> write
  assembly.released |> released
  busy_rows <== assembly.busy_rows
  foreign_rows <== assembly.foreign_rows
  drain_blocked <== assembly.drain_blocked
  active <== occupied ||| assembly.active
  issue_done.valid <== successful & assembly.resolved_last
  describe_interface_retained_storage(launch.valid, issue_done.valid ||| cancel.valid, occupied, ~name: "macro")
  describe_interface_contract(launch, offered, "packed-beats", ~trace_model: interface_trace_retained(~name: "macro"))

export:
  RV5StageVectorPackedMemory
