#lang rhodium
// Owns local vector acceptance, shared-service operands, completion slots, and ordered VRF writes.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/bits.rhdl").Pow2Int
  "bundles.rhdl" open
  "dependencies.rhdl" open
  "scoreboard.rhdl" open
  "load-response.rhdl" open
  "packed-memory.rhdl" open
  "fp.rhdl" open
  "muldiv.rhdl" open
  "../integer-execution.rhdl" open
  "../../simd-alu.rhdl".SimdElementWidth
  "../../load-store.rhdl" open
  "../../multiplier.rhdl" open
  "../../divider.rhdl" open
  "../fp/bundles.rhdl" open
  "../../../riscv/isa/fp-profile.rhm" open
  lib("hardfloat/main.rhdl").RoundingMode
  "unroller.rhdl" open
  "execute.rhdl" open
  "mask.rhdl".VectorScanResult
  "register-file.rhdl" open
  "../decode/vector-ctrl.rhdl".VectorMemoryMode
  "../decode/vector-ctrl.rhdl".VectorFloatResult
  "../register-file.rhdl".RegisterFileWrite
  "../fp/register-file.rhdl".FloatingPointRegisterWrite
  "../../../riscv/isa/vector.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  lib("flow/main.rhdl") open

sync_circuit RV5StageVectorExecution(xlen :: XLen, vlen :: VectorLength, Context :: DataType, ~vector_completion_slots: vector_completion_slots :: Pow2Int = 8, ~trace_isa: trace_isa :: maybe(String) = #false):
  def fp_profile = if xlen == XLen.X32 | FloatingPointProfile.F | FloatingPointProfile.D
  def FpRequest = RV5StageFpExecutionRequest(xlen, fp_profile, Bits(index_width(vector_completion_slots)))
  def FpResult = RV5StageFpExecutionResult(xlen, fp_profile, Bits(index_width(vector_completion_slots)))
  interface fp_request(Decoupled(FpRequest), ~role: producer)
  interface fp_result(Irrevocable(FpResult), ~role: consumer)
  interface fp_update(Valid(Bits(5)), ~role: producer)
  def MultiplyTag = RV5StageVectorMultiplyTag(vector_completion_slots)
  def DivideTag = RV5StageVectorDivideTag(vector_completion_slots)
  def MultiplyRequest = RV5StageExecutionRequest(MultiplierRequest(xlen.width), MultiplyTag)
  def DivideRequest = RV5StageExecutionRequest(DividerRequest(xlen.width), DivideTag)
  interface multiply_request(Decoupled(MultiplyRequest), ~role: producer)
  interface multiply_result(Irrevocable(RV5StageExecutionResult(Bits(xlen.width * 2), MultiplyTag)), ~role: consumer)
  interface divide_request(Decoupled(DivideRequest), ~role: producer)
  interface divide_result(Irrevocable(RV5StageExecutionResult(DividerResponse(xlen.width), DivideTag)), ~role: consumer)
  input rounding_mode: RoundingMode
  reg captured_rounding(RoundingMode)
  interface request(Decoupled(RV5StageVectorInstruction(xlen, Context)), ~role: consumer)
  interface issue(Decoupled(RV5StageVectorToken(Context, vector_completion_slots)), ~role: producer)
  interface cancel(Pulse(), ~role: consumer)
  // Local feedback names the macro PC and accepts the beat issued three cycles ago.
  interface commit(Valid(RV5StageVectorCommit(xlen)), ~role: consumer)
  interface completion(Valid(RV5StageVectorCompletion(xlen, vector_completion_slots)), ~role: consumer)
  interface fault_start(Valid(Bits(xlen.width)), ~role: producer)
  interface truncate(Valid(Bits(xlen.width)), ~role: producer)
  interface retire(Pulse(), ~role: producer)
  interface issue_done(Pulse(), ~role: producer)
  interface saturate(Pulse(), ~role: producer)
  interface scalar_result(Valid(RegisterFileWrite(xlen)), ~role: producer)
  interface floating_result(Valid(FloatingPointRegisterWrite(fp_profile)), ~role: producer)
  input packed_memory: Bool
  input memory_drained: Bool
  output active: Bool
  output unrolling: Bool
  output pending: Bool
  output stores_pending: Bool
  output(loads_pending, fp_pending, available): Bool

  // One issue owner, two bounded macro lifetimes. Accepted slots keep their
  // owner after the descriptor is replaced; the ordered drain frees contexts.
  reg macro_valid(~init: bits(0, 2).as_vec(Bool))
  reg macro_load(Vec(2, Bool))
  reg macro_store(Vec(2, Bool))
  reg macro_fp(Vec(2, Bool))
  reg macro_issued(~init: bits(0, 2).as_vec(Bool))
  reg macro_fault(~init: bits(0, 2).as_vec(Bool))
  reg next_owner(~init: Bool(#false))
  reg current_owner(~init: Bool(#false))
  reg drain_owner(~init: Bool(#false))
  reg packed_owner(~init: Bool(#false))
  reg entry_packed(Vec(vector_completion_slots, Bool))
  inst packed(RV5StageVectorPackedMemory(xlen, vlen, Context, vector_completion_slots))
  def Array(local_commit_input, packed_commit_input, acceptance_input) = commit |> fork_valid(3)
  def local_commit = local_commit_input |> filter_valid(_event => !packed_owner)
  packed_commit_input |> filter_valid(_event => packed_owner) |> packed.commit
  def Array(local_completion_input, packed_completion_input) = completion |> fork_valid(2)
  def local_completion = local_completion_input |> filter_valid(event => !entry_packed[event.tag])
  packed_completion_input |> filter_valid(event => entry_packed[event.tag]) |> packed.completion
  inst unroller(RV5StageVectorUnroller(xlen, vlen, Context))
  inst registers(RV5StageVectorRegisterFile(vlen))
  inst ex_pipe(ValidPipe(RV5StageVectorBeat(vlen), 1, ~flushable: #true))
  inst execute(RV5StageVectorExecute(vlen))
  inst wb_pipe(ValidPipe(RV5StageVectorResultBeat(vlen), 2, ~flushable: #true))
  // Configured slots reserve storage before issue for non-backpressurable responses.
  // Tags identify these slots; scalar rd never encodes vector element position.
  inst scoreboard(RV5StageVectorScoreboard(vector_completion_slots))
  inst loads(RV5StageVectorLoadResponse(xlen, vector_completion_slots))
  def allocated = scoreboard.allocated
  def authorized_slots = scoreboard.accepted
  reg completed(~init: bits(0, vector_completion_slots).as_vec(Bool))
  reg entries(Vec(vector_completion_slots, RV5StageVectorResultBeat(vlen)))
  reg completion_flags(Vec(vector_completion_slots, Bits(5)))
  reg completion_data(Vec(vector_completion_slots, Bits(64)))
  reg completion_saturated(~init: bits(0, vector_completion_slots).as_vec(Bool))
  reg entry_owner(Vec(vector_completion_slots, Bool))
  reg head(~init: bits(0, index_width(vector_completion_slots)))
  reg tail(~init: bits(0, index_width(vector_completion_slots)))
  reg accepted_tail(~init: bits(0, index_width(vector_completion_slots)))
  reg store_barrier(~init: Bool(#false))
  reg fold_inflight(~init: Bool(#false))
  reg accumulator(Bits(64))
  reg scan_carry(Bits(64))
  def retry = local_commit.valid & (local_commit.bits.disposition === RV5StageVectorDisposition.Retry)
  def fault = local_commit.valid & (local_commit.bits.disposition === RV5StageVectorDisposition.Fault)
  def truncating = local_commit.valid & (local_commit.bits.disposition === RV5StageVectorDisposition.Truncate)
  def successful = local_commit.valid & (local_commit.bits.disposition === RV5StageVectorDisposition.Authorized)
  issue_done.valid <== packed.issue_done.valid ||| cancel.valid ||| fault ||| truncating ||| (successful & wb_pipe.egress.bits.last)
  def clear = cancel.valid ||| retry ||| fault ||| truncating
  def packed_retry = commit.valid & packed_owner & (commit.bits.disposition === RV5StageVectorDisposition.Retry)
  def replay = clear ||| packed_retry
  scoreboard.replay.valid <== replay
  local_completion |> loads.response
  wire busy_rows: Vec(vector_depth(vlen), Bool)
  def destination_registers = vector_destination_registers(xlen, vlen, request.bits.descriptor)
  def waw = vec(for List (row in 0..vector_depth(vlen)): busy_rows[row] & destination_registers[row div vector_chunks(vlen)].into(Bool)).as_bits().or_reduce()
  available <== !unroller.active & !macro_valid[next_owner.as_bits()]
  def admitted = request |> gate_flow(available & !waw)
  def sequencing = admitted |> trace_event("vector/sequencer", ~residency: "sequencer", ~fields: operation):
    pc: operation.descriptor.pc
    instruction(~format: "riscv", ~isa: trace_isa || (if xlen == XLen.X32 | "rv32imafdcv" | "rv64imafdcv"), ~pc: "pc"): operation.descriptor.instruction
    vl(~format: "unsigned"): operation.descriptor.state.vl
    vstart(~format: "unsigned"): operation.descriptor.state.vstart
    sew(~format: "unsigned"): operation.descriptor.state.vtype[3..6]
    lmul: operation.descriptor.state.vtype[0..3]
    packed(~format: "bool"): packed_memory
  describe_interface_retained_storage(admitted.fire(), unroller.active & issue_done.valid, unroller.active, ~name: "sequencer")
  // The shared descriptor owner supplies both schedules and their lineage.
  def Array(element_request, packed_request) = sequencing |> atomic_fork(2)
  element_request |> unroller.request
  packed_request |> filter_flow(_operation => packed_memory) |> to_valid() |> packed.launch
  unroller.packed_memory <== packed_owner
  packed.issue_done |> unroller.packed_done
  packed.instruction <== unroller.retained
  packed.occupied <== unroller.active & packed_owner
  when (request.fire()):
    packed_owner <== packed_memory
    current_owner <== next_owner
    next_owner <== !next_owner
  def owner_has_slots = vec(for List (slot in 0..vector_completion_slots): allocated[slot] & (entry_owner[slot] === drain_owner)).as_bits().or_reduce()
  def macro_complete = macro_valid[drain_owner.as_bits()] & macro_issued[drain_owner.as_bits()] & !owner_has_slots & !packed.drain_blocked
  for (owner in 0..2):
    when (request.fire() & (next_owner === Bool(owner == 1))):
      macro_valid[owner] <== Bool(#true)
      macro_issued[owner] <== Bool(#false)
      macro_fault[owner] <== Bool(#false)
      macro_load[owner] <== request.bits.descriptor.control.memory & !request.bits.descriptor.control.store
      macro_store[owner] <== request.bits.descriptor.control.memory & request.bits.descriptor.control.store
      macro_fp[owner] <== request.bits.descriptor.control.floating_point
    elsewhen (macro_complete & (drain_owner === Bool(owner == 1))):
      macro_valid[owner] <== Bool(#false)
    elsewhen (issue_done.valid & (current_owner === Bool(owner == 1))):
      macro_issued[owner] <== Bool(#true)
      macro_fault[owner] <== fault ||| cancel.valid
  when macro_complete:
    drain_owner <== !drain_owner
  def mutable busy :: Bits(vector_depth(vlen)) = packed.busy_rows.as_bits()
  def mutable foreign :: Bits(vector_depth(vlen)) = packed.foreign_rows.as_bits()
  for (slot in 0..vector_completion_slots):
    def rows = mux(authorized_slots[slot] & !entry_packed[slot] & entries[slot].write.mask.or_reduce(), bits(1, vector_depth(vlen)) << entries[slot].write.address, bits(0, vector_depth(vlen)))
    busy := busy ||| rows
    foreign := foreign ||| mux(entry_owner[slot] =/= current_owner, rows, bits(0, vector_depth(vlen)))
  busy_rows <== busy.as_vec(Bool)
  def foreign_rows :: Vec(vector_depth(vlen), Bool) = foreign.as_vec(Bool)
  unroller.blocked_rows <== foreign_rows
  packed.blocked_rows <== foreign_rows
  packed.owner <== current_owner
  packed.closed_owners <== macro_issued
  packed.cancel.valid <== cancel.valid & packed_owner
  packed.slot <== tail
  packed.slot_available <== !allocated[tail]
  packed.accepted_slots <== vec(for List (slot in 0..vector_completion_slots): authorized_slots[slot] & entry_packed[slot])
  packed.head <== head
  packed.drain_enable <== authorized_slots[head] & entry_packed[head]
  packed.alignment_available <== !ex_pipe.egress.valid
  cancel |> unroller.cancel
  for (port in 0..3):
    assert(!(unroller.reads[port].valid & packed.reads[port].valid), "vector_read_owners_exclusive")
    Array(unroller.reads[port], packed.reads[port]) |> valid_arbiter() |> registers.reads[port]
    def Array(element_result, packed_result) = registers.results[port] |> fork_valid(2)
    element_result |> filter_valid(_value => !packed_owner) |> unroller.results[port]
    packed_result |> filter_valid(_value => packed_owner) |> packed.results[port]
  Array(unroller.mask_read, packed.mask_read) |> valid_arbiter() |> registers.mask_read
  def Array(element_mask, packed_mask) = registers.mask_result |> fork_valid(2)
  element_mask |> filter_valid(_value => !packed_owner) |> unroller.mask_result
  packed_mask |> filter_valid(_value => packed_owner) |> packed.mask_result
  packed.alignment |> execute.alignment
  packed.aligned <== execute.aligned
  assert(!(packed.alignment.valid & ex_pipe.egress.valid), "vector_simd_owners_exclusive")
  active <== macro_valid.as_bits().or_reduce()
  unrolling <== unroller.active
  pending <== authorized_slots.as_bits().or_reduce()
  def store_macro_pending = vec(for List (owner in 0..2): macro_valid[owner] & macro_store[owner]).as_bits().or_reduce()
  stores_pending <== store_barrier ||| store_macro_pending
  loads_pending <== vec(for List (owner in 0..2): macro_valid[owner] & macro_load[owner]).as_bits().or_reduce()
  fp_pending <== vec(for List (owner in 0..2): macro_valid[owner] & macro_fp[owner]).as_bits().or_reduce()
  ex_pipe.flush <== clear
  wb_pipe.flush <== clear

  def tag_width = index_width(vector_completion_slots)
  // Local attempt admission and private operand capture are one atomic transfer.
  def fault_only_first = unroller.issue.bits.beat.control.memory & (unroller.issue.bits.beat.control.memory_mode === VectorMemoryMode.FaultOnlyFirst)
  def slot_available = !allocated[tail] & (!fault_only_first ||| !allocated.as_bits().or_reduce())
  def issued = unroller.issue |> trace_event("vector/issue", ~stalls: #true, ~fields: operation):
    packed: Bool(#false)
    op_index(~format: "unsigned"): operation.beat.sequence
    first(~format: "unsigned"): operation.beat.first
    end(~format: "unsigned"): operation.beat.end
    last: operation.beat.last
    empty: operation.beat.empty
  def Array(token, operands) = issued |> gate_flow(slot_available & !clear & !fold_inflight) |> atomic_fork(2)
  def element_issue = (
    token |> map_flow(operation => RV5StageVectorToken(Context, vector_completion_slots)):
      byte_mask: if xlen == XLen.X64 | memory_byte_mask(xlen, operation.beat.address, operation.beat.element_width.as_bits().into(MemoryWidth)) | memory_byte_mask(xlen, operation.beat.address[0..32], operation.beat.element_width.as_bits().into(MemoryWidth)).zext(8)
      context: operation.context
      last: operation.beat.last
      truncate_on_fault: (operation.beat.control.memory_mode === VectorMemoryMode.FaultOnlyFirst) & operation.beat.first.or_reduce()
      memory: operation.beat.control.memory
      memory_width: operation.beat.element_width.into(Bits(2))
      enabled: operation.beat.enabled.as_bits()[0].into(Bool)
      address: operation.beat.address
      store_data: operation.beat.left
      completion_tag: tail
  )
  Array(element_issue, packed.issue) |> rr_arbiter() |> issue
  // All routes use one persistent allocation order, including immediate ALU
  // results. No unbackpressurable write can collide with an older completion.
  inst attempt_tags(ValidPipe(Bits(tag_width), 3, ~flushable: #true))
  attempt_tags.flush <== replay
  attempt_tags.ingress.valid <== issue.fire()
  attempt_tags.ingress.bits <== tail
  inst execute_tags(ValidPipe(Bits(tag_width), 1))
  execute_tags.ingress.valid <== element_issue.fire()
  execute_tags.ingress.bits <== tail
  operands |> map_flow(operation => operation.beat) |> to_valid() |> ex_pipe.ingress
  def ex_beat = ex_pipe.egress.bits
  def ex_reduction = (ex_beat.control.integer ||| ex_beat.control.fp_service) & ex_beat.control.reduction
  def ex_effective_beat = ex_beat.updated(~right: mux(ex_reduction & ex_beat.first.or_reduce(), accumulator, ex_beat.right))
  execute.beat <== ex_effective_beat
  execute.scan_carry <== scan_carry
  ex_pipe.egress |> map_valid(_beat => execute.result) |> wb_pipe.ingress

  inst fp_operands(ValidPipe(FpRequest, 2, ~flushable: #true))
  fp_operands.flush <== clear
  ex_pipe.egress |> map_valid(operation => vector_fp_request(xlen, vlen, vector_completion_slots, ex_effective_beat, execute_tags.egress.bits, captured_rounding)) |> fp_operands.ingress
  // Empty authorization storage bypasses directly into the shared service;
  // occupied entries still retain every accepted, nonstallable request.
  inst fp_authorized(Queue(FpRequest, vector_completion_slots, ~flow: #true))
  fp_authorized.egress |> fp_request
  fp_result.ready <== Bool(#true)
  when (request.fire()):
    captured_rounding <== rounding_mode

  inst multiply_operands(ValidPipe(MultiplyRequest, 2, ~flushable: #true))
  inst divide_operands(ValidPipe(DivideRequest, 2, ~flushable: #true))
  multiply_operands.flush <== clear
  divide_operands.flush <== clear
  ex_pipe.egress |> map_valid(operation => vector_multiply_request(xlen, vlen, vector_completion_slots, operation, execute_tags.egress.bits)) |> multiply_operands.ingress
  ex_pipe.egress |> map_valid(operation => vector_divide_request(xlen, vlen, vector_completion_slots, operation, execute_tags.egress.bits)) |> divide_operands.ingress
  // Accepted work survives cancellation; speculative operand pipes do not.
  inst multiply_authorized(Queue(MultiplyRequest, vector_completion_slots))
  inst divide_authorized(Queue(DivideRequest, vector_completion_slots))
  multiply_authorized.egress |> multiply_request
  divide_authorized.egress |> divide_request
  multiply_result.ready <== Bool(#true)
  divide_result.ready <== Bool(#true)
  def result = entries[head]
  def delayed_load_at_head = loads.completed[1].valid & (loads.completed[1].bits.tag === head)
  def immediate_load_at_head = loads.completed[0].valid & (loads.completed[0].bits.tag === head)
  def fp_at_head = fp_result.fire() & (fp_result.bits.tag === head)
  def multiply_entry = entries[multiply_result.bits.tag.slot]
  def multiply_completion = vector_multiply_value(xlen, vector_completion_slots, multiply_result.bits, multiply_entry.write.data, multiply_entry.multiply_accumulate, multiply_entry.multiply_subtract)
  def multiply_at_head = multiply_result.fire() & (multiply_result.bits.tag.slot === head)
  def divide_at_head = divide_result.fire() & (divide_result.bits.tag.slot === head)
  def arriving_at_head = delayed_load_at_head ||| immediate_load_at_head ||| fp_at_head ||| multiply_at_head ||| divide_at_head
  def direct_head_completion = !completed[head] & arriving_at_head
  def fp_arrival_data = mux(result.mask_destination, fp_result.bits.integer_value[0].as_bits().zext(64), mux(result.fp_result === VectorFloatResult.Integer, if xlen == XLen.X64 | fp_result.bits.integer_value | fp_result.bits.integer_value.zext(64), if xlen == XLen.X64 | fp_result.bits.fp_value | fp_result.bits.fp_value.zext(64)))
  def arriving_head_data = mux(delayed_load_at_head, if xlen == XLen.X64 | loads.completed[1].bits.data | loads.completed[1].bits.data.zext(64), mux(immediate_load_at_head, if xlen == XLen.X64 | loads.completed[0].bits.data | loads.completed[0].bits.data.zext(64), mux(fp_at_head, fp_arrival_data, mux(multiply_at_head, multiply_completion.data, vector_divide_value(xlen, vector_completion_slots, divide_result.bits)))))
  def drain = authorized_slots[head] & !entry_packed[head] & (completed[head] ||| direct_head_completion) & !packed.drain_blocked
  def drained_data = mux(direct_head_completion, arriving_head_data, completion_data[head])
  def drained_flags = mux(fp_at_head & direct_head_completion, mux(fp_result.bits.exception_flags_valid, fp_result.bits.exception_flags, bits(0, 5)), completion_flags[head])
  def drained_saturated = mux(multiply_at_head & direct_head_completion, multiply_completion.saturated, completion_saturated[head])

  // Cancellation drops future private results; a live older local acceptance
  // still takes effect on this edge. Results alone never authorize a write.
  when (local_commit.valid):
    assert(wb_pipe.egress.valid, "vector_commit_has_aligned_result")
  def beat = wb_pipe.egress.bits
  def wb_tag = attempt_tags.egress.bits
  // Keep the accumulator at the authorized frontier. A retry never folds an
  // element twice, and an overlapping destination is written only at the end.
  when (successful & beat.reduction & !beat.floating_point):
    accumulator <== beat.write.data
  elsewhen (drain & (entry_owner[head] === current_owner) & result.reduction & result.floating_point):
    accumulator <== drained_data
  when (request.fire()):
    scan_carry <== mux(request.bits.descriptor.control.scan_control.result === VectorScanResult.First, !bits(0, 64), bits(0, 64))
  elsewhen (successful & beat.scan):
    scan_carry <== beat.scan_carry
  when (request.fire() ||| clear ||| (local_commit.valid & (!beat.floating_point & beat.reduction ||| beat.scan)) ||| (drain & (entry_owner[head] === current_owner) & result.floating_point & result.reduction)):
    fold_inflight <== Bool(#false)
  elsewhen (element_issue.fire() & (((unroller.issue.bits.beat.control.integer ||| unroller.issue.bits.beat.control.fp_service) & unroller.issue.bits.beat.control.reduction) ||| (unroller.issue.bits.beat.control.integer & unroller.issue.bits.beat.control.scan & !unroller.issue.bits.beat.control.scan_control.index))):
    fold_inflight <== Bool(#true)
  (
    local_commit |> filter_valid(event => (event.disposition === RV5StageVectorDisposition.Authorized) & beat.scalar_destination)
      |> map_valid(_event => RegisterFileWrite(xlen)):
           address: beat.destination
           data: beat.write.data[0..xlen.width]
  ) |> scalar_result
  (
    local_commit |> filter_valid(event => (event.disposition === RV5StageVectorDisposition.Authorized) & beat.floating_scalar_destination)
      |> map_valid(_event => FloatingPointRegisterWrite(fp_profile)):
           address: beat.destination
           data: if xlen == XLen.X32 | mux(beat.element_width === SimdElementWidth.E16, (!bits(0, 16)) ++ beat.write.data[0..16], beat.write.data[0..32]) | mux_lookup(beat.element_width, ~default: beat.write.data, [[SimdElementWidth.E16, (!bits(0, 48)) ++ beat.write.data[0..16]], [SimdElementWidth.E32, (!bits(0, 32)) ++ beat.write.data[0..32]]])
  ) |> floating_result
  def deferred_commit = successful
  local_commit |> filter_valid(_event => successful & beat.fp_execute) |> map_valid(_event => fp_operands.egress.bits) |> to_decoupled() |> fp_authorized.ingress
  when (fp_authorized.ingress.valid):
    assert(fp_operands.egress.valid & fp_authorized.ingress.ready, "vector_fp_wb_has_reserved_request_space")
  local_commit |> filter_valid(_event => successful & beat.multiply_divide & !beat.divide & beat.write.mask.or_reduce()) |> map_valid(_event => multiply_operands.egress.bits) |> to_decoupled() |> multiply_authorized.ingress
  local_commit |> filter_valid(_event => successful & beat.multiply_divide & beat.divide & beat.write.mask.or_reduce()) |> map_valid(_event => divide_operands.egress.bits) |> to_decoupled() |> divide_authorized.ingress
  when (multiply_authorized.ingress.valid):
    assert(multiply_operands.egress.valid & multiply_authorized.ingress.ready, "vector_multiply_wb_has_reserved_request_space")
  when (divide_authorized.ingress.valid):
    assert(divide_operands.egress.valid & divide_authorized.ingress.ready, "vector_divide_wb_has_reserved_request_space")
  def drain_write = result.write.updated(~data: mux(result.memory ||| result.floating_point ||| result.multiply_divide, drained_data << result.shift, result.write.data))
  // Acceptance and drain are ordered even when service results arrive out of
  // order. Trace the real entry writes/head reads, not response tag equality.
  def accepted_results = wb_pipe.egress |> filter_valid(_beat => successful)
  def drained = inject_flow(Valid(RV5StageVectorResultBeat(vlen)), ~valid: drain, ~bits: result.updated(~write: drain_write))
  describe_interface_queue_storage(vector_completion_slots, deferred_commit, drain, head, wb_tag, authorized_slots[head], Bool(#false), ~name: "accepted-results")
  describe_interface_contract(accepted_results, drained, "accepted-results", ~trace_model: interface_trace_queue(~name: "accepted-results"))
  def finished = drained |> trace_valid_event("vector/complete", ~fields: operation):
    packed: Bool(#false)
    destination(~format: "unsigned"): operation.destination
    write_enabled: operation.write.mask.or_reduce()
  def element_write = finished |> filter_valid(operation => operation.write.mask.or_reduce()) |> map_valid(operation => operation.write)
  Array(element_write, packed.write) |> valid_arbiter() |> registers.write
  assert(!(element_write.valid & packed.write.valid), "vector_write_owners_exclusive")
  fp_update.valid <== drain & result.fp_execute
  fp_update.bits <== drained_flags
  fault_start.valid <== fault
  fault_start.bits <== beat.first.zext(xlen.width)
  truncate.valid <== truncating
  truncate.bits <== beat.first.zext(xlen.width)
  saturate.valid <== (successful & beat.saturated) ||| (drain & drained_saturated)
  retire.valid <== macro_complete & !macro_fault[drain_owner.as_bits()]
  when truncating:
    assert(!authorized_slots.as_bits().or_reduce(), "vector_truncate_has_no_older_completion")
  (
    local_commit |> map_valid(event => RV5StageVectorFeedback(xlen, vlen, Bits(xlen.width))):
      context: event.pc
      sequence: beat.sequence
      first: beat.first
      end: beat.end
      disposition: event.disposition
      cause: event.cause
      fault_address: event.fault_address
      last: beat.last
      compress_state: beat.compress_state
  ) |> unroller.feedback

  def deferred_issue = element_issue.fire()
  scoreboard.reserve.valid <== issue.fire()
  scoreboard.reserve.bits <== tail
  def authorized = commit.valid & (commit.bits.disposition === RV5StageVectorDisposition.Authorized)
  acceptance_input |> filter_valid(_event => authorized) |> map_valid(_event => wb_tag) |> scoreboard.accept
  scoreboard.release.valid <== drain ||| packed.released.valid
  scoreboard.release.bits <== head
  (
    local_commit |> filter_valid(_event => successful & beat.memory)
      |> map_valid(event => RV5StageVectorMemoryAcceptance(xlen, vector_completion_slots)):
           tag: wb_tag
           pending: event.slow
           data: event.data
  ) |> loads.accepted
  when (scoreboard.release.valid):
    head <== if vector_completion_slots == 1 | bits(0, tag_width) | head + bits(1, tag_width)
  when authorized:
    accepted_tail <== if vector_completion_slots == 1 | bits(0, tag_width) | wb_tag + bits(1, tag_width)
  when replay:
    tail <== mux(authorized, if vector_completion_slots == 1 | bits(0, tag_width) | wb_tag + bits(1, tag_width), accepted_tail)
  elsewhen (issue.fire()):
    tail <== if vector_completion_slots == 1 | bits(0, tag_width) | tail + bits(1, tag_width)
  when (request.fire() & request.bits.descriptor.control.memory & request.bits.descriptor.control.store):
    store_barrier <== Bool(#true)
  elsewhen (store_barrier & !store_macro_pending & memory_drained):
    store_barrier <== Bool(#false)
  when (local_completion.valid):
    assert(authorized_slots[local_completion.bits.tag], "vector_response_has_authorized_owner")
    assert(!completed[local_completion.bits.tag], "vector_response_completes_once")
  when (commit.valid):
    assert(attempt_tags.egress.valid, "vector_feedback_has_attempt_owner")
    assert(wb_tag === accepted_tail, "vector_feedback_follows_acceptance_frontier")
  when (issue_done.valid & !cancel.valid):
    assert(active, "vector_issue_release_has_macro_owner")
  when (fp_result.fire()):
    assert(authorized_slots[fp_result.bits.tag] & entries[fp_result.bits.tag].floating_point, "vector_fp_result_has_authorized_owner")
    assert(!completed[fp_result.bits.tag], "vector_fp_result_completes_once")
  when (multiply_result.fire()):
    assert(authorized_slots[multiply_result.bits.tag.slot] & entries[multiply_result.bits.tag.slot].multiply_divide & !entries[multiply_result.bits.tag.slot].divide, "vector_multiply_result_has_authorized_owner")
    assert(!completed[multiply_result.bits.tag.slot], "vector_multiply_result_completes_once")
  when (divide_result.fire()):
    assert(authorized_slots[divide_result.bits.tag.slot] & entries[divide_result.bits.tag.slot].multiply_divide & entries[divide_result.bits.tag.slot].divide, "vector_divide_result_has_authorized_owner")
    assert(!completed[divide_result.bits.tag.slot], "vector_divide_result_completes_once")
  // Independent slots absorb a hit and a delayed response on the same edge;
  // the single VRF write port drains them strictly in architectural order.
  for (slot in 0..vector_completion_slots):
    def tag = bits(slot, tag_width)
    def authorizing = deferred_commit & (wb_tag === tag)
    def releasing = scoreboard.release.valid & (head === tag)
    when (issue.fire() & (tail === tag)):
      entry_owner[slot] <== current_owner
      entry_packed[slot] <== packed_owner
    when authorizing:
      entries[slot] <== beat
    when (fp_result.fire() & (fp_result.bits.tag === tag)):
      completion_flags[slot] <== mux(fp_result.bits.exception_flags_valid, fp_result.bits.exception_flags, bits(0, 5))
    elsewhen authorizing:
      completion_flags[slot] <== bits(0, 5)
    when (multiply_result.fire() & (multiply_result.bits.tag.slot === tag)):
      completion_saturated[slot] <== multiply_completion.saturated
    elsewhen (releasing ||| authorizing ||| (deferred_issue & (element_issue.bits.completion_tag === tag))):
      completion_saturated[slot] <== Bool(#false)
    // A result for the ordered head can drain immediately; do not leave a
    // completed bit behind after releasing its owner on the same edge.
    when releasing:
      completed[slot] <== Bool(#false)
    elsewhen (loads.completed[1].valid & (loads.completed[1].bits.tag === tag)):
      completed[slot] <== Bool(#true)
      completion_data[slot] <== if xlen == XLen.X64 | loads.completed[1].bits.data | loads.completed[1].bits.data.zext(64)
    elsewhen (loads.completed[0].valid & (loads.completed[0].bits.tag === tag)):
      completed[slot] <== Bool(#true)
      completion_data[slot] <== if xlen == XLen.X64 | loads.completed[0].bits.data | loads.completed[0].bits.data.zext(64)
    elsewhen (fp_result.fire() & (fp_result.bits.tag === tag)):
      completed[slot] <== Bool(#true)
      completion_data[slot] <== mux(entries[slot].mask_destination, fp_result.bits.integer_value[0].as_bits().zext(64), mux(entries[slot].fp_result === VectorFloatResult.Integer, if xlen == XLen.X64 | fp_result.bits.integer_value | fp_result.bits.integer_value.zext(64), if xlen == XLen.X64 | fp_result.bits.fp_value | fp_result.bits.fp_value.zext(64)))
    elsewhen (multiply_result.fire() & (multiply_result.bits.tag.slot === tag)):
      completed[slot] <== Bool(#true)
      completion_data[slot] <== multiply_completion.data
    elsewhen (divide_result.fire() & (divide_result.bits.tag.slot === tag)):
      completed[slot] <== Bool(#true)
      completion_data[slot] <== vector_divide_value(xlen, vector_completion_slots, divide_result.bits)
    elsewhen (deferred_issue & (element_issue.bits.completion_tag === tag)):
      completed[slot] <== Bool(#false)
    elsewhen authorizing:
      completed[slot] <== mux(beat.floating_point, !beat.fp_execute, mux(beat.multiply_divide, !beat.write.mask.or_reduce(), !beat.memory ||| !local_commit.bits.slow))
      completion_data[slot] <== mux(beat.reduction, beat.write.data, if xlen == XLen.X64 | local_commit.bits.data | local_commit.bits.data.zext(64))

export:
  RV5StageVectorExecution
