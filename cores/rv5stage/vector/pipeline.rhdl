#lang rhodium
// Composes vector admission, sequencing, operand capture, execution services, and persistent completion.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/bits.rhdl").Pow2Int
  "bundles.rhdl" open
  "instructions.rhdl" open
  "completion.rhdl" open
  "operand-fetch.rhdl" open
  "packed-memory.rhdl" open
  "fp.rhdl" open
  "muldiv.rhdl" open
  "../integer-execution.rhdl" open
  "../writeback-calendar.rhdl" open
  "../decode/fp-ctrl.rhdl".RV5StageFloatUnit
  "../../load-store.rhdl" open
  "../../multiplier.rhdl" open
  "../../divider.rhdl" open
  "../fp/bundles.rhdl" open
  "../../../riscv/isa/fp-profile.rhm" open
  "sequencer.rhdl" open
  "execute.rhdl" open
  "mask.rhdl".VectorScanResult
  "register-file.rhdl" open
  "../decode/vector-ctrl.rhdl".VectorMemoryMode
  "../register-file.rhdl".RegisterFileWrite
  "../fp/register-file.rhdl".FloatingPointRegisterWrite
  "../../../riscv/isa/vector.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  lib("flow/main.rhdl") open

sync_circuit RV5StageVectorExecution(xlen :: XLen, vlen :: VectorLength, Context :: DataType, ~vector_completion_slots: vector_completion_slots :: Pow2Int = 8, ~trace_isa: trace_isa :: maybe(String) = #false, ~multiply_latency: multiply_latency :: maybe(PosInt) = #false, ~fixed_fp: fixed_fp :: Boolean = #false):
  def tag_width = index_width(vector_completion_slots)
  def InstructionId = Bits(tag_width)
  def SlotId = Bits(tag_width)
  bundle OwnedContext():
    value: Context
    owner: InstructionId
    pc: Bits(xlen.width)
  bundle OwnedBeat():
    beat: RV5StageVectorBeat(vlen)
    tag: SlotId
    owner: InstructionId
    pc: Bits(xlen.width)
  def OwnedResult = RV5StageVectorOwnedResult(xlen, vlen, vector_completion_slots)
  def fp_profile = if xlen == XLen.X32 | FloatingPointProfile.F | FloatingPointProfile.D
  def FpRequest = RV5StageFpExecutionRequest(xlen, fp_profile, Bits(index_width(vector_completion_slots)))
  def FpResult = RV5StageFpExecutionResult(xlen, fp_profile, Bits(index_width(vector_completion_slots)))
  interface fp_request(Decoupled(FpRequest), ~role: producer)
  interface fp_result(Decoupled(FpResult), ~role: consumer)
  interface fp_update(Valid(Bits(5)), ~role: producer)
  def MultiplyTag = RV5StageVectorMultiplyTag(vector_completion_slots)
  def DivideTag = RV5StageVectorDivideTag(vector_completion_slots)
  def MultiplyRequest = RV5StageExecutionRequest(MultiplierRequest(xlen.width), MultiplyTag)
  def DivideRequest = RV5StageExecutionRequest(DividerRequest(xlen.width), DivideTag)
  interface multiply_request(Decoupled(MultiplyRequest), ~role: producer)
  interface multiply_result(Irrevocable(RV5StageExecutionResult(Bits(xlen.width * 2), MultiplyTag)), ~role: consumer)
  interface divide_request(Decoupled(DivideRequest), ~role: producer)
  interface divide_result(Irrevocable(RV5StageExecutionResult(DividerResponse(xlen.width), DivideTag)), ~role: consumer)
  interface request(Decoupled(RV5StageVectorInstruction(xlen, Context)), ~role: consumer)
  interface issue(Decoupled(RV5StageVectorToken(Context, vector_completion_slots)), ~role: producer)
  interface cancel(Pulse(), ~role: consumer)
  // Only memory attempts require an external retry, fault, or authorization decision.
  interface decision(Valid(RV5StageVectorCommit(xlen, vector_completion_slots)), ~role: consumer)
  interface completion(Decoupled(RV5StageVectorCompletion(xlen, vector_completion_slots)), ~role: consumer)
  interface fault_start(Valid(Bits(xlen.width)), ~role: producer)
  interface truncate(Valid(Bits(xlen.width)), ~role: producer)
  interface retire(Pulse(), ~role: producer)
  interface issue_done(Pulse(), ~role: producer)
  interface sequencing_done(Pulse(), ~role: producer)
  interface saturate(Pulse(), ~role: producer)
  interface scalar_result(Valid(RegisterFileWrite(xlen)), ~role: producer)
  interface scalar_writeback(Decoupled(Bits(4)), ~role: producer)
  interface floating_result(Valid(FloatingPointRegisterWrite(fp_profile)), ~role: producer)
  input packed_memory: Bool
  input memory_drained: Bool
  output active: Bool
  output sequencing: Bool
  output pending: Bool
  output stores_pending: Bool
  output(loads_pending, fp_pending, available): Bool

  // State owners are independent of the currently retained descriptor.
  inst instructions(RV5StageVectorInstructions(xlen, vlen, vector_completion_slots))
  active <== instructions.active
  stores_pending <== instructions.stores_pending
  loads_pending <== instructions.loads_pending
  fp_pending <== instructions.fp_pending
  def next_owner = instructions.allocate_id
  def current_owner = instructions.sequencing_id
  def foreign_rows = instructions.blocked_rows
  reg current_packed(~init: Bool(#false))
  inst completions(RV5StageVectorCompletionUnit(xlen, vlen, vector_completion_slots, ~fixed_multiply: multiply_latency != #false))
  inst writeback_calendar(RV5StageWritebackCalendar(3, 8))
  def allocated = vec(for List (s in 0..vector_completion_slots): completions.state[s].allocated)
  def authorized_slots = vec(for List (s in 0..vector_completion_slots): completions.state[s].accepted)
  def entry_owner = vec(for List (s in 0..vector_completion_slots): completions.state[s].owner)
  def entry_packed = vec(for List (s in 0..vector_completion_slots): completions.state[s].packed)
  def drain_slot = completions.drain_slot
  def allocate_slot = completions.allocate_slot
  def drain = completions.drained.valid
  def head_result = completions.drained.bits.beat
  def drained_data = completions.drained.bits.data
  inst ex_pipe(ValidPipe(OwnedBeat(), 1, ~flushable: #true))
  inst execute(RV5StageVectorExecute(vlen))
  inst memory_pipe(ValidPipe(OwnedResult, 2, ~flushable: #true))
  def decision_tag = decision.bits.tag
  def feedback_packed = entry_packed[decision_tag]
  def feedback_owner = entry_owner[decision_tag]
  inst packed(RV5StageVectorPackedMemory(xlen, vlen, Context, vector_completion_slots, ~owner_count: vector_completion_slots))
  def Array(element_decision_input, packed_decision_input) = decision |> fork_valid(2)
  def element_memory_decision = element_decision_input |> filter_valid(_event => !feedback_packed)
  packed_decision_input |> filter_valid(_event => feedback_packed) |> packed.commit
  def Array(local_completion, packed_completion_input) = completion |> demux_flow(2, event => entry_packed[event.tag])
  packed_completion_input |> to_valid() |> packed.completion
  inst sequencer(RV5StageVectorSequencer(xlen, vlen, OwnedContext(), ~trace_isa: trace_isa))
  inst operand_fetch(RV5StageVectorOperandFetch(xlen, vlen, OwnedContext()))
  inst registers(RV5StageVectorRegisterFile(vlen))
  reg fold_inflight(~init: bits(0, vector_completion_slots).as_vec(Bool))
  reg accumulators(Vec(vector_completion_slots, Bits(64)))
  reg scan_carries(Vec(vector_completion_slots, Bits(64)))
  def retry = element_memory_decision.valid & (element_memory_decision.bits.disposition === RV5StageVectorDisposition.Retry)
  def fault = element_memory_decision.valid & (element_memory_decision.bits.disposition === RV5StageVectorDisposition.Fault)
  def truncating = element_memory_decision.valid & (element_memory_decision.bits.disposition === RV5StageVectorDisposition.Truncate)
  def memory_accepted = element_memory_decision.valid & (element_memory_decision.bits.disposition === RV5StageVectorDisposition.Authorized)
  sequencer.sequencing_done |> sequencing_done
  wire compute_tail_issue: Bool
  def serialized_done = sequencer.sequencing_done.valid & (current_packed ||| instructions.memory[current_owner] ||| instructions.serial[current_owner] ||| cancel.valid)
  issue_done.valid <== compute_tail_issue ||| serialized_done
  def finished_owner = mux(compute_tail_issue, operand_fetch.issue.bits.context.owner, current_owner)
  def replay = cancel.valid ||| (decision.valid & (decision.bits.disposition =/= RV5StageVectorDisposition.Authorized))

  // Admission and the single registered sequencer.
  // Packed and checkpointed compute schedules wait for older operand preparation.
  // Elementwise memory uses the ordered operand-fetch queue: older compute
  // beats issue before a younger memory beat can reach a replay decision.
  def stateful_request = packed_memory ||| request.bits.descriptor.control.reduction ||| (request.bits.descriptor.control.scan & !request.bits.descriptor.control.scan_control.index) ||| request.bits.descriptor.control.compress
  available <== sequencer.request.ready & instructions.available & (!stateful_request ||| !operand_fetch.active)
  def admitted = request |> gate_flow(available)
  describe_interface_retained_storage(admitted.fire(), sequencer.sequencing_done.valid, sequencer.active, ~name: "sequencer")
  // The shared descriptor owner supplies both schedules and their lineage.
  def Array(element_request, packed_request, tracked_request) = admitted |> atomic_fork(3)
  (
    element_request |> map_flow(operation => RV5StageVectorInstruction(xlen, OwnedContext())):
      descriptor: operation.descriptor
      context:
        OwnedContext():
          value: operation.context
          owner: next_owner
          pc: operation.descriptor.pc
  ) |> sequencer.request
  tracked_request |> to_valid() |> map_valid(operation => operation.descriptor) |> instructions.request
  instructions.packed_memory <== packed_memory
  instructions.memory_drained <== memory_drained
  instructions.slots <== completions.state
  instructions.packed_rows <== packed.foreign_rows
  instructions.packed_drain_blocked <== packed.drain_blocked
  instructions.finished.valid <== issue_done.valid
  instructions.finished.bits <== RV5StageVectorIssueFinished(vector_completion_slots):
    owner: finished_owner
    fault: fault ||| cancel.valid
  packed_request |> filter_flow(_operation => packed_memory) |> to_valid() |> packed.launch
  sequencer.packed_memory <== current_packed
  packed.issue_done |> sequencer.packed_done
  packed.instruction <== RV5StageVectorInstruction(xlen, Context):
    context: sequencer.retained.context.value
    descriptor: sequencer.retained.descriptor
  packed.occupied <== sequencer.active & current_packed
  // Admission can coincide with the older macro's final read. Retain packed
  // ownership, but defer shared VRF activity and issue until that read issues.
  packed.schedule_enable <== !operand_fetch.active
  when (request.fire()):
    current_packed <== packed_memory
  sequencer.blocked_rows <== foreign_rows
  packed.blocked_rows <== foreign_rows
  packed.owner <== current_owner
  packed.closed_owners <== instructions.closed
  packed.cancel.valid <== cancel.valid & current_packed
  packed.slot <== allocate_slot
  packed.slot_available <== !allocated[allocate_slot]
  packed.accepted_slots <== vec(for List (slot in 0..vector_completion_slots): authorized_slots[slot] & entry_packed[slot])
  packed.head <== drain_slot
  packed.drain_enable <== authorized_slots[drain_slot] & entry_packed[drain_slot]
  packed.alignment_available <== !ex_pipe.egress.valid
  packed.write_available <== !completions.compute_writeback

  // Operand capture: fixed-latency VRF returns retain their sampled source.
  cancel |> sequencer.cancel
  sequencer.read_request |> operand_fetch.request
  operand_fetch.flush <== sequencer.read_flush
  operand_fetch.begin_macro <== request.fire()
  reg read_element(~init: bits(0, 3))
  reg mask_element(~init: Bool(#false))
  read_element <== vec(for List (port in 0..3): operand_fetch.reads[port].valid).as_bits()
  mask_element <== operand_fetch.mask_read.valid
  for (port in 0..3):
    assert(!(operand_fetch.reads[port].valid & packed.reads[port].valid), "vector_read_owners_exclusive")
    Array(operand_fetch.reads[port], packed.reads[port]) |> valid_arbiter() |> registers.reads[port]
    def Array(element_result, packed_result) = registers.results[port] |> fork_valid(2)
    element_result |> filter_valid(_value => read_element[port].into(Bool)) |> operand_fetch.results[port]
    packed_result |> filter_valid(_value => !read_element[port].into(Bool)) |> packed.results[port]
  Array(operand_fetch.mask_read, packed.mask_read) |> valid_arbiter() |> registers.mask_read
  def Array(element_mask, packed_mask) = registers.mask_result |> fork_valid(2)
  element_mask |> filter_valid(_value => mask_element) |> operand_fetch.mask_result
  packed_mask |> filter_valid(_value => !mask_element) |> packed.mask_result
  packed.alignment |> execute.alignment
  packed.aligned <== execute.aligned
  assert(!(packed.alignment.valid & ex_pipe.egress.valid), "vector_simd_owners_exclusive")
  sequencing <== sequencer.active
  pending <== authorized_slots.as_bits().or_reduce()
  ex_pipe.flush <== replay
  memory_pipe.flush <== replay


  // Issue and one-stage private execution, with the memory-only decision delay.
  // Local attempt admission and private operand capture are one atomic transfer.
  def fault_only_first = operand_fetch.issue.bits.beat.control.memory & (operand_fetch.issue.bits.beat.control.memory_mode === VectorMemoryMode.FaultOnlyFirst)
  def slot_available = !allocated[allocate_slot] & (!fault_only_first ||| !allocated.as_bits().or_reduce())
  // Fixed returns reserve the common completion/write cycle before launch.
  // Variable services retain their output until a free cycle, not in slots.
  def offered_beat = operand_fetch.issue.bits.beat
  def service_beat = (offered_beat.control.fp_service ||| offered_beat.control.multiply_divide) & offered_beat.enabled.as_bits()[0].into(Bool)
  def immediate_beat = !offered_beat.control.memory & !service_beat
  def local_reservation_needed = immediate_beat ||| offered_beat.control.memory
  def local_reservation_delay = mux(offered_beat.control.memory, bits(3, 4), bits(1, 4))
  writeback_calendar.probe_client <== bits(2, index_width(3))
  writeback_calendar.probe_delay <== local_reservation_delay
  def issued = operand_fetch.issue |> trace_event("vector/s2.issue", ~stalls: #true, ~fields: operation):
    packed: Bool(#false)
    op_index(~format: "unsigned"): operation.beat.sequence
    first(~format: "unsigned"): operation.beat.first
    end(~format: "unsigned"): operation.beat.end
    last: operation.beat.last
    empty: operation.beat.empty
  def issue_owner = operand_fetch.issue.bits.context.owner
  def Array(token, operands, scalar_reservation) = issued |> gate_flow(slot_available & !replay & !fold_inflight[issue_owner] & (!local_reservation_needed ||| writeback_calendar.probe_available)) |> atomic_fork(3)
  scalar_reservation |> filter_flow(operation => operation.beat.control.scalar_destination) |> map_flow(_operation => bits(1, 4)) |> scalar_writeback
  def element_issue = (
    token |> map_flow(operation => RV5StageVectorToken(Context, vector_completion_slots)):
      byte_mask: if xlen == XLen.X64 | memory_byte_mask(xlen, operation.beat.address, operation.beat.element_width.as_bits().into(MemoryWidth)) | memory_byte_mask(xlen, operation.beat.address[0..32], operation.beat.element_width.as_bits().into(MemoryWidth)).zext(8)
      context: operation.context.value
      last: operation.beat.last
      truncate_on_fault: (operation.beat.control.memory_mode === VectorMemoryMode.FaultOnlyFirst) & operation.beat.first.or_reduce()
      memory: operation.beat.control.memory
      memory_width: operation.beat.element_width.into(Bits(2))
      enabled: operation.beat.enabled.as_bits()[0].into(Bool)
      address: operation.beat.address
      store_data: operation.beat.left
      completion_tag: allocate_slot
  )
  Array(element_issue, packed.issue) |> rr_arbiter() |> issue
  // The calendar claims only the accepted element beat; its availability
  // gates admission without participating in the atomic fork's ready loop.
  writeback_calendar.reserve[2].valid <== element_issue.fire() & local_reservation_needed
  writeback_calendar.reserve[2].bits <== local_reservation_delay
  compute_tail_issue <== element_issue.fire() & operand_fetch.issue.bits.beat.last & !(operand_fetch.issue.bits.beat.control.memory ||| (operand_fetch.issue.bits.beat.control.scan & !operand_fetch.issue.bits.beat.control.scan_control.index) ||| operand_fetch.issue.bits.beat.control.compress)
  // All routes use one persistent allocation order, including immediate ALU
  // results. No unbackpressurable write can collide with an older completion.
  (
    operands |> map_flow(operation => OwnedBeat()):
      beat: operation.beat
      tag: allocate_slot
      owner: operation.context.owner
      pc: operation.context.pc
  ) |> to_valid() |> ex_pipe.ingress
  def ex_beat = ex_pipe.egress.bits.beat
  def ex_owner = ex_pipe.egress.bits.owner
  def ex_reduction = (ex_beat.control.integer ||| ex_beat.control.fp_service) & ex_beat.control.reduction
  def ex_effective_beat = ex_beat.updated(~right: mux(ex_reduction & ex_beat.first.or_reduce(), accumulators[ex_owner], ex_beat.right))
  execute.beat <== ex_effective_beat
  execute.scan_carry <== scan_carries[ex_owner]
  def executed = ex_pipe.egress |> map_valid(operation => RV5StageVectorOwnedResult(xlen, vlen, vector_completion_slots)):
    beat: execute.result
    tag: operation.tag
    owner: operation.owner
    pc: operation.pc
  def compute_maturity = executed |> filter_valid(result => !result.beat.memory)
  def compute_result = compute_maturity.bits
  def compute_beat = compute_result.beat
  def compute_owner = compute_result.owner
  executed |> filter_valid(result => result.beat.memory) |> memory_pipe.ingress
  def memory_result = memory_pipe.egress.bits
  def memory_beat = memory_result.beat

  // Empty FP and multiply request queues bypass directly into their shared
  // services; occupied entries retain every accepted, nonstallable request.
  inst fp_authorized(Queue(FpRequest, vector_completion_slots, ~flow: #true))
  def Array(fp_launch, fp_reservation) = fp_authorized.egress |> atomic_fork(2)
  fp_launch |> fp_request
  fp_reservation |> filter_flow(operation => Bool(fixed_fp) & (operation.control.execution.unit =/= RV5StageFloatUnit.DivideSquareRoot)) |> map_flow(_operation => bits(2, 4)) |> writeback_calendar.reserve[1]
  reg fp_returns(~init: bits(0, 2))
  fp_returns <== writeback_calendar.reserve[1].fire().as_bits() ++ fp_returns[1..2]
  completions.fixed_fp_return <== fp_returns[0].into(Bool)
  completions.reserved_write <== writeback_calendar.occupied[0].into(Bool)
  fp_result |> completions.fp_result
  // Accepted service work survives cancellation and returns through its tag.
  inst multiply_authorized(Queue(MultiplyRequest, vector_completion_slots, ~flow: #true))
  inst divide_authorized(Queue(DivideRequest, vector_completion_slots))
  def Array(multiply_launch, multiply_reservation) = multiply_authorized.egress |> atomic_fork(2)
  multiply_launch |> multiply_request
  multiply_reservation |> filter_flow(_operation => Bool(multiply_latency != #false)) |> map_flow(_operation => bits(if multiply_latency | multiply_latency | 1, 4)) |> writeback_calendar.reserve[0]
  divide_authorized.egress |> divide_request
  multiply_result |> completions.multiply_result
  divide_result |> completions.divide_result
  compute_maturity |> filter_valid(result => result.beat.fp_execute) |> map_valid(result => vector_fp_request(xlen, vlen, vector_completion_slots, ex_effective_beat, result.tag)) |> to_decoupled() |> fp_authorized.ingress
  when (fp_authorized.ingress.valid):
    assert(fp_authorized.ingress.ready, "vector_fp_execute_has_reserved_request_space")
  compute_maturity |> filter_valid(result => result.beat.multiply_execute & !result.beat.divide) |> map_valid(result => vector_multiply_request(xlen, vlen, vector_completion_slots, ex_effective_beat, result.tag)) |> to_decoupled() |> multiply_authorized.ingress
  compute_maturity |> filter_valid(result => result.beat.multiply_execute & result.beat.divide) |> map_valid(result => vector_divide_request(xlen, vlen, vector_completion_slots, ex_effective_beat, result.tag)) |> to_decoupled() |> divide_authorized.ingress
  when (multiply_authorized.ingress.valid):
    assert(multiply_authorized.ingress.ready, "vector_multiply_execute_has_reserved_request_space")
  when (divide_authorized.ingress.valid):
    assert(divide_authorized.ingress.ready, "vector_divide_execute_has_reserved_request_space")

  // External decisions align only with memory attempts. Every compute route
  // becomes durable directly from the private execute stage.
  when (element_memory_decision.valid):
    assert(memory_pipe.egress.valid & memory_beat.memory, "vector_memory_decision_has_aligned_attempt")
    assert(memory_result.tag === decision_tag, "vector_memory_decision_matches_attempt")
  assert(!(decision.valid & compute_maturity.valid), "vector_attempt_has_one_resolution")
  // Keep each accumulator at its owner's resolved frontier. An overlapping
  // destination is written only when that owner's final result drains.
  for (owner in 0..vector_completion_slots):
    def owner_tag = bits(owner, tag_width)
    when (compute_maturity.valid & (compute_owner === owner_tag) & compute_beat.reduction & !compute_beat.floating_point):
      accumulators[owner] <== compute_beat.write.data
    elsewhen (drain & (completions.drained.bits.owner === owner_tag) & head_result.reduction & head_result.floating_point):
      accumulators[owner] <== drained_data
    when (request.fire() & (next_owner === owner_tag)):
      scan_carries[owner] <== mux(request.bits.descriptor.control.scan_control.result === VectorScanResult.First, !bits(0, 64), bits(0, 64))
    elsewhen (compute_maturity.valid & (compute_owner === owner_tag) & compute_beat.scan):
      scan_carries[owner] <== compute_beat.scan_carry
    when ((request.fire() & (next_owner === owner_tag)) ||| (cancel.valid & (current_owner === owner_tag)) ||| ((retry ||| fault ||| truncating) & (feedback_owner === owner_tag)) ||| (compute_maturity.valid & (compute_owner === owner_tag) & (!compute_beat.floating_point & compute_beat.reduction ||| compute_beat.scan)) ||| (drain & (completions.drained.bits.owner === owner_tag) & head_result.floating_point & head_result.reduction)):
      fold_inflight[owner] <== Bool(#false)
    elsewhen (element_issue.fire() & (issue_owner === owner_tag) & (((operand_fetch.issue.bits.beat.control.integer ||| operand_fetch.issue.bits.beat.control.fp_service) & operand_fetch.issue.bits.beat.control.reduction) ||| (operand_fetch.issue.bits.beat.control.integer & operand_fetch.issue.bits.beat.control.scan & !operand_fetch.issue.bits.beat.control.scan_control.index))):
      fold_inflight[owner] <== Bool(#true)

  // Replay feedback restores only the unauthorized suffix.
  fault_start.valid <== fault
  fault_start.bits <== memory_beat.first.zext(xlen.width)
  truncate.valid <== truncating
  truncate.bits <== memory_beat.first.zext(xlen.width)
  when truncating:
    assert(!authorized_slots.as_bits().or_reduce(), "vector_truncate_has_no_older_completion")
  def memory_feedback = element_memory_decision |> map_valid(event => RV5StageVectorFeedback(xlen, vlen, Bits(xlen.width))):
      context: event.pc
      sequence: memory_beat.sequence
      first: memory_beat.first
      end: memory_beat.end
      disposition: event.disposition
      cause: event.cause
      fault_address: event.fault_address
      last: memory_beat.last
      compress_state: memory_beat.compress_state
  def compute_feedback = compute_maturity |> map_valid(result => RV5StageVectorFeedback(xlen, vlen, Bits(xlen.width))):
    context: result.pc
    sequence: result.beat.sequence
    first: result.beat.first
    end: result.beat.end
    disposition: RV5StageVectorDisposition.Authorized
    cause: bits(0, xlen.width)
    fault_address: bits(0, xlen.width)
    last: result.beat.last
    compress_state: result.beat.compress_state
  def relevant_memory_feedback = memory_feedback |> filter_valid(_event => instructions.memory[feedback_owner] ||| instructions.serial[feedback_owner])
  def relevant_compute_feedback = compute_feedback |> filter_valid(_event => instructions.serial[compute_owner])
  def Array(sequencer_feedback, operand_feedback) = Array(relevant_memory_feedback, relevant_compute_feedback) |> valid_arbiter() |> fork_valid(2)
  sequencer_feedback |> sequencer.feedback
  operand_feedback |> filter_valid(_event => !cancel.valid) |> operand_fetch.feedback

  when (decision.valid):
    assert(decision_tag === completions.accept_slot, "vector_feedback_follows_acceptance_frontier")
  when (issue_done.valid & !cancel.valid):
    assert(active, "vector_issue_release_has_macro_owner")

  // Completion storage persists across sequencer replacement and memory replay.
  compute_maturity |> completions.compute_maturity
  memory_pipe.egress |> completions.memory_attempt
  element_memory_decision |> completions.decision
  local_completion |> completions.response
  def variable_waiting = (completion.valid & !completion.ready) ||| (divide_result.valid & !divide_result.ready) ||| (Bool(multiply_latency == #false) & multiply_result.valid & !multiply_result.ready) ||| (!fp_returns[0].into(Bool) & fp_result.valid & !fp_result.ready)
  reg variable_age(~init: bits(0, 3))
  when (!variable_waiting):
    variable_age <== bits(0, 3)
  elsewhen (!variable_age.and_reduce()):
    variable_age <== variable_age + bits(1, 3)
  writeback_calendar.pause <== variable_age.and_reduce()
  completions.replay.valid <== replay
  completions.packed_release.valid <== packed.released.valid
  completions.reserve.valid <== issue.fire()
  completions.reserve.bits <== RV5StageVectorSlotAllocation(vector_completion_slots):
    owner: mux(packed.issue.fire(), current_owner, operand_fetch.issue.bits.context.owner)
    packed: packed.issue.fire()
  decision |> filter_valid(event => feedback_packed & (event.disposition === RV5StageVectorDisposition.Authorized)) |> map_valid(event => event.tag) |> completions.packed_accept
  Array(completions.write, packed.write) |> valid_arbiter() |> registers.write
  assert(!(completions.write.valid & packed.write.valid), "vector_write_owners_exclusive")
  completions.fp_update |> fp_update
  completions.saturate |> saturate
  completions.scalar_result |> scalar_result
  completions.floating_result |> floating_result

  compute_maturity |> instructions.compute_maturity
  def resolved_memory = memory_pipe.egress |> filter_valid(_result => memory_accepted)
  Array(compute_maturity, resolved_memory) |> valid_arbiter() |> instructions.resolved
  cancel |> instructions.cancel
  instructions.retire |> retire

export:
  RV5StageVectorExecution
