#lang rhodium
// Adapts one packed vector element to the shared scalar-format FP execution contract.
// SPDX-License-Identifier: Apache-2.0

import:
  "bundles.rhdl" open
  "../decode/vector-ctrl.rhdl" open
  "../../simd-alu.rhdl".SimdElementWidth
  "../fp/bundles.rhdl" open
  "../decode/fp-ctrl.rhdl" open
  "../../../riscv/isa/vector.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/isa/fp-profile.rhm" open
  "../../../riscv/rtl/floating-point.rhdl" open
  lib("hardfloat/main.rhdl") open
  lib("rhodium/std/bits.rhdl").Pow2Int

fun vector_fp_request(xlen :: XLen, vlen :: VectorLength, slots :: Pow2Int, beat :: RV5StageVectorBeat(xlen, vlen), tag :: Bits(index_width(slots))) :~ RV5StageFpExecutionRequest(xlen, (if xlen == XLen.X32 | FloatingPointProfile.F | FloatingPointProfile.D), Bits(index_width(slots))):
  def profile = if xlen == XLen.X32 | FloatingPointProfile.F | FloatingPointProfile.D
  def flen = floating_point_register_width(profile)
  fun precision(width :: SimdElementWidth) :~ RV5StageFloatPrecision:
    mux_lookup(width, ~default: RV5StageFloatPrecision.Double, [[SimdElementWidth.E16, RV5StageFloatPrecision.Half], [SimdElementWidth.E32, RV5StageFloatPrecision.Single]])
  fun integer_width(width :: SimdElementWidth) :~ RV5StageFloatIntegerWidth:
    mux_lookup(width, ~default: RV5StageFloatIntegerWidth.Long, [[SimdElementWidth.E8, RV5StageFloatIntegerWidth.Byte], [SimdElementWidth.E16, RV5StageFloatIntegerWidth.Half], [SimdElementWidth.E32, RV5StageFloatIntegerWidth.Word]])
  def source_precision = precision(beat.fp_source_width)
  def result_precision = precision(beat.fp_result_width)
  def left_precision = mux(beat.control.wide_vs2, result_precision, source_precision)
  def right_precision = mux(beat.control.reduction & beat.control.widening, result_precision, source_precision)
  // The decoder selects a physical FP operation; SEW supplies its dynamic format.
  wire unused: RV5StageFloatingPointControl()
  unused <== dont_care(RV5StageFloatingPointControl())
  def fp_source = beat.control.fp_source === VectorFloatSource.Floating
  def fp_destination = beat.control.fp_result === VectorFloatResult.Floating
  def control = unused.updated(
    ~registers: unused.registers.updated(~destination: mux(fp_destination, RV5StageFloatDestination.FloatingPoint, RV5StageFloatDestination.Integer), ~uses_frs1: fp_source),
    ~execution: beat.control.fp_execution.updated(~source_precision: source_precision, ~destination_precision: result_precision, ~integer_width: mux(fp_source, integer_width(beat.fp_result_width), integer_width(beat.fp_source_width)))
  )
  fun operand(value :: Bits(xlen.width), precision :: RV5StageFloatPrecision) :~ Bits(flen):
    def half = riscv_nan_box(FloatFormat.F16, value[0..16].into(IEEEFloat(FloatFormat.F16)), flen)
    def single = riscv_nan_box(FloatFormat.F32, value[0..32].into(IEEEFloat(FloatFormat.F32)), flen)
    if xlen == XLen.X32
    | mux(precision === RV5StageFloatPrecision.Half, half, single)
    | mux_lookup(precision, ~default: value, [[RV5StageFloatPrecision.Half, half], [RV5StageFloatPrecision.Single, single]])
  def floating_scalar = beat.control.operand === VectorOperandMode.FloatingScalar
  def scalar_operand = if xlen == XLen.X32 | beat.right[0..32] | beat.right
  def vector_left = operand(beat.left, left_precision)
  def source_right = mux(floating_scalar, scalar_operand, operand(beat.right, right_precision))
  def destination_operand = operand(beat.destination_data, result_precision)
  def ordered_left = mux(beat.control.swap_operands, source_right, vector_left)
  def ordered_right = mux(beat.control.swap_operands, vector_left, source_right)
  RV5StageFpExecutionRequest(xlen, profile, Bits(index_width(slots))):
    tag: tag
    control: control
    left: mux(beat.control.multiply_destination, destination_operand, ordered_left)
    left_precision: mux(beat.control.multiply_destination, result_precision, mux(beat.control.swap_operands, right_precision, left_precision))
    right: ordered_right
    right_precision: mux(beat.control.swap_operands, left_precision, right_precision)
    third: mux(beat.control.multiply_destination, vector_left, destination_operand)
    third_precision: mux(beat.control.multiply_destination, left_precision, result_precision)
    integer_operand: beat.left[0..xlen.width]
    immediate_index: dont_care(Bits(5))
    rounding_mode: mux_lookup(beat.control.fp_rounding, ~default: beat.fp_rounding_mode, [[VectorFloatRounding.TowardZero, RoundingMode.MinMagnitude], [VectorFloatRounding.RoundToOdd, RoundingMode.Odd]])

export:
  vector_fp_request
