#lang rhodium
// Composes fetch-attempt production, fixed-latency replay, and buffered instruction assembly.

import:
  "btb.rhdl" open
  "fetch-source.rhdl" open
  "fetch-word-buffer.rhdl" open
  "instruction-buffer.rhdl" open
  "frontend-control.rhdl" open
  "profile.rhm".RVCoreProfile
  "bundles.rhdl" open
  "icache/protocol.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

sync_circuit RV5StageFrontend(core_profile :: RVCoreProfile, ~btb_entries: btb_entries :: Nat = 16):
  def xlen = core_profile.xlen
  def word_buffer_capacity :: PosInt = 5
  interface control(RV5StageFrontendControl(xlen), ~role: frontend)
  interface memory(RV5StageFetchAccess(xlen), ~role: requester)
  interface fetched(Decoupled(FetchDecode(xlen)), ~role: producer)

  def recovery = control.flush.valid ||| control.restart.valid ||| control.invalidate_all.valid
  inst repair(ValidPipe(RV5StageFetchRepair(xlen), 1), ~reset_when: recovery)
  def command = recovery ||| repair.egress.valid
  inst source(RV5StageFetchSource(xlen, btb_entries))
  inst instructions(RV5StageInstructionBuffer(core_profile, word_buffer_capacity))
  inst s1(ValidPipeAlwaysCapture(RV5StageFetchAttempt(xlen), 1), ~reset_when: command)
  inst s2(ValidPipeAlwaysCapture(RV5StageFetchAttempt(xlen), 1), ~reset_when: command)

  instructions.repair |> repair.ingress
  def Array(repair_restart, repair_invalidate) = repair.egress |> fork_valid(2)
  def restarts = Array(
    control.restart,
    repair_restart |> filter_valid(_repair => !recovery) |> map_valid(repair => repair.pc)
  ) |> valid_arbiter() |> fork_valid(2)
  restarts <=> Array(source.restart, instructions.restart)
  repair_invalidate |> map_valid(repair => repair.entry) |> source.predictor_invalidate
  control.predictor_flush |> source.predictor_flush
  control.branch_update |> source.branch_update
  // Independent recovery events coalesce into one synchronous clear. They do
  // not clear accepted page walks or refills in the memory implementation.
  source.clear.valid <== command
  instructions.clear.valid <== command
  instructions.active <== control.active
  source.active <== control.active
  source.cursor <== instructions.cursor
  instructions.fetched |> fetched

  // Reserve from registered occupancy only; never borrow Decode's current
  // dequeue credit or a younger S1 translation/tag decision.
  def occupied = instructions.count.zext(4) + s1.egress.valid.as_bits().zext(4) + s2.egress.valid.as_bits().zext(4)
  assert(occupied <= bits(word_buffer_capacity, 4), "fetch_word_reservations_in_range")
  source.space <== occupied < bits(word_buffer_capacity, 4)
  def Array(memory_attempts, accepted_attempts) = source.attempts |> atomic_fork(2)
  (memory_attempts |> map_flow(attempt => RV5StageInstructionReq(xlen)):
    address: attempt.pc.align_down(4)
  ) |> memory.request
  accepted_attempts |> to_valid() |> s1.ingress

  // A result is paired with its fixed S2 occurrence, not joined to an
  // independently buffered response. Replay kills only the younger S1.
  def replays = s2.egress |> filter_valid(_attempt => memory.response.valid & memory.response.bits.replay)
  replays |> source.replay
  s1.egress |> filter_valid(_attempt => !command & !replays.valid) |> s2.ingress
  (s2.egress |> filter_valid(_attempt => !command & memory.response.valid & !memory.response.bits.replay)
    |> map_valid(attempt => RV5StageFetchWord(xlen)):
         base: attempt.pc.align_down(4)
         word: memory.response.bits.response.word
         page_fault: memory.response.bits.response.page_fault
         access_fault: memory.response.bits.response.access_fault
         prediction: attempt.prediction
  ) |> instructions.fill
  memory.flush <== command
  memory.invalidate_all <== control.invalidate_all.valid
  memory.s1_kill <== command ||| replays.valid
  when (s2.egress.valid & !command):
    assert(memory.response.valid, "fetch_s2_has_outcome")

export:
  RV5StageFetchAttempt
  RV5StageFetchWord
  RV5StageFrontend
