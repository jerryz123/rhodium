#lang rhodium
// Fetches speculative raw packets through S1/S2 into a reserved flow-through queue.
// SPDX-License-Identifier: Apache-2.0

import:
  "btb.rhdl" open
  "fetch-source.rhdl" open
  "fetch-packet.rhdl" open
  "fetch-scan.rhdl" open
  "frontend-control.rhdl" open
  "profile.rhm".RVCoreProfile
  "icache/protocol.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

sync_circuit RV5StageFrontend(core_profile :: RVCoreProfile, ~btb_entries: btb_entries :: Nat = 16):
  def xlen = core_profile.xlen
  def packet_capacity :: PosInt = 5
  interface control(RV5StageFrontendControl(xlen), ~role: frontend)
  interface memory(RV5StageFetchAccess(xlen), ~role: requester)
  interface packets(Decoupled(RV5StageFetchPacket(xlen)), ~role: producer)

  def recovery = control.flush.valid ||| control.restart.valid ||| control.invalidate_all.valid
  inst repair(ValidPipe(RV5StageFetchRepair(xlen), 1, ~flushable: #true))
  repair.flush <== recovery
  def command = recovery ||| repair.egress.valid
  inst source(RV5StageFetchSource(xlen, btb_entries))
  inst scan(RV5StageFetchScan(core_profile))
  inst queue(ShiftQueue(RV5StageFetchPacket(xlen), packet_capacity, ~flow: #true, ~flushable: #true))
  inst s2(ValidPipeAlwaysCapture(RV5StageFetchAttempt(xlen), 1, ~flushable: #true))
  queue.flush <== recovery
  s2.flush <== command

  scan.repair |> repair.ingress
  def Array(repair_restart, repair_invalidate) = repair.egress |> fork_valid(2)
  Array(control.restart, repair_restart |> filter_valid(_repair => !recovery) |> map_valid(repair => repair.pc)) |> valid_arbiter() |> source.restart
  repair_invalidate |> map_valid(repair => repair.entry) |> source.predictor_invalidate
  control.predictor_flush |> source.predictor_flush
  control.branch_update |> source.branch_update
  source.clear.valid <== command
  source.active <== control.active
  // Prediction repair discards only younger attempts. The corrected S2 packet
  // and all older queue/residual contents remain part of the instruction stream.
  scan.clear.valid <== recovery
  queue.egress |> filter_flow(_packet => !recovery) |> packets

  def occupied = queue.count.zext(4) + source.stage1.valid.as_bits().zext(4) + s2.egress.valid.as_bits().zext(4)
  assert(occupied <= bits(packet_capacity, 4), "fetch_packet_reservations_in_range")
  source.space <== occupied < bits(packet_capacity, 4)
  (source.attempts |> map_flow(attempt => RV5StageInstructionReq(xlen)):
    address: attempt.pc.align_down(4)
  ) |> memory.request

  def admitted = !command & memory.response.valid & !memory.response.bits.replay
  def outcome = s2.egress |> trace_valid_event("frontend/s2.outcome", ~fields: attempt):
    pc: attempt.pc
    replay: memory.response.bits.replay
    admitted: admitted
    page_fault: admitted & memory.response.bits.response.page_fault
    access_fault: admitted & memory.response.bits.response.access_fault
  def replays = outcome |> filter_valid(_attempt => memory.response.valid & memory.response.bits.replay)
  replays |> source.replay
  def lookup = source.stage1 |> trace_valid_event("frontend/s1.lookup", ~fields: attempt):
    pc: attempt.pc
  lookup |> filter_valid(_attempt => !command & !replays.valid) |> s2.ingress
  (outcome |> filter_valid(_attempt => admitted)
    |> map_valid(attempt => RV5StageFetchPacket(xlen)):
         pc: attempt.pc
         word: memory.response.bits.response.word
         mask: mux(attempt.continuation, bits(1, 2), mux(attempt.pc[1].into(Bool), bits(2, 2), bits(3, 2)))
         page_fault: memory.response.bits.response.page_fault
         access_fault: memory.response.bits.response.access_fault
         prediction: attempt.prediction
  ) |> scan.ingress
  scan.egress |> to_decoupled() |> queue.ingress
  memory.flush <== command
  memory.invalidate_all <== control.invalidate_all.valid
  memory.s1_kill <== command ||| replays.valid
  when (s2.egress.valid & !command):
    assert(memory.response.valid, "fetch_s2_has_outcome")

export:
  RV5StageFetchAttempt
  RV5StageFetchPacket
  RV5StageFrontend
