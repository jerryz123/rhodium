bundle RV5StageControl():
  alu: AluControl()
  operand: OperandControl()
  branch: BranchControl()
  memory: MemoryControl()
  prefetch: CachePrefetchOperation
  multiply: RV5StageMultiplyControl()
  divide: RV5StageDivideControl()
  writeback: WritebackControl()
  system: SystemControl()
  fence: FenceControl()
  hint: HintOperation
  floating_point_valid: Bool
  floating_point: RV5StageFloatingPointControl()

// Ordinary host code adds independently authored control columns to one row
// per instruction. The selected ISA still elaborates to one decode table.
fun compose_control_cases(instructions :: List.of(InstructionSpec),
                          alu_cases :: List.of(DecodeCase),
                          operand_cases :: List.of(DecodeCase),
                          branch_cases :: List.of(DecodeCase),
                          memory_cases :: List.of(DecodeCase),
                          multiply_cases :: List.of(DecodeCase),
                          divide_cases :: List.of(DecodeCase),
                          writeback_cases :: List.of(DecodeCase),
                          system_cases :: List.of(DecodeCase),
                          fence_cases :: List.of(DecodeCase)):
  for List (instruction in instructions):
    block:
      def input = instruction_pattern(instruction)
      DecodeCase(
        input,
        pattern(RV5StageControl()):
          alu: component_output(alu_cases, input)
          operand: component_output(operand_cases, input)
          branch: component_output(branch_cases, input)
          memory: component_output(memory_cases, input)
          prefetch: CachePrefetchOperation.None
          multiply: component_output(multiply_cases, input)
          divide: component_output(divide_cases, input)
          writeback: component_output(writeback_cases, input)
          system: component_output(system_cases, input)
          fence: component_output(fence_cases, input)
          hint: HintOperation.None
          floating_point_valid: Bool(#false)
          floating_point: pattern(RV5StageFloatingPointControl(), _)
      )

fun floating_point_core_control_cases(instructions :: List.of(InstructionSpec),
                                      floating_point_cases :: List.of(DecodeCase)):
  for List (instruction in instructions):
    block:
      def input = instruction_pattern(instruction)
      def half_load = [zfhmin.FLH].contains(instruction)
      def load = [f.FLW, d.FLD, zfhmin.FLH].contains(instruction)
      def store = [f.FSW, d.FSD, zfhmin.FSH].contains(instruction)
      def memory = load || store
      def double = [d.FLD, d.FSD].contains(instruction)
      def integer_sources = instruction.operands.filter(
        ~keep: fun (operand): operand.role == "source" && operand.bank == RegisterBank.Integer
      )
      def immediate = cond
      | load: ImmediateSelect.I
      | store: ImmediateSelect.S
      | ~else: ImmediateSelect.None
      def memory_access = cond
      | load: MemoryOperation.Load
      | store: MemoryOperation.Store
      | ~else: MemoryOperation.None
      def memory_width = cond
      | double: MemoryWidth.Double
      | half_load || [zfhmin.FSH].contains(instruction): MemoryWidth.Half
      | ~else: MemoryWidth.Word
      def alu_control = partial_pattern(AluControl()):
        result_select: AluResultSelect.Adder
        subtract: Bool(#false)
        unsigned_word: Bool(#false)
        shift_add_amount: bits(0, 2)
        word: Bool(#false)
      def operand_control = pattern(OperandControl()):
        uses_rs1: Bool(!integer_sources.is_empty())
        uses_rs2: Bool(#false)
        left: OperandASelect.Register
        right: OperandBSelect.Immediate
        immediate: immediate
      def branch_control = partial_pattern(BranchControl()):
        resolver:
          partial_pattern(BranchResolverControl()):
            enable: Bool(#false)
      def memory_control = partial_pattern(MemoryControl()):
        access: memory_access
        width: memory_width
        unsigned: Bool(#true)
      def writeback_control = partial_pattern(WritebackControl()):
        enable: Bool(#false)
      def system_control = partial_pattern(SystemControl()):
        csr: CsrOperation.None
        action: SystemOperation.None
      def fence_control = pattern(FenceControl()):
        action: FenceOperation.None
      DecodeCase(
        input,
        pattern(RV5StageControl()):
          alu: alu_control
          operand: operand_control
          branch: branch_control
          memory: memory_control
          prefetch: CachePrefetchOperation.None
          multiply: pattern(RV5StageMultiplyControl(), _)
          divide: pattern(RV5StageDivideControl(), _)
          writeback: writeback_control
          system: system_control
          fence: fence_control
          hint: HintOperation.None
          floating_point_valid: Bool(#true)
          floating_point: component_output(floating_point_cases, input)
      )

// Zicbop refines three ORI-to-x0 regions. Complete override rows are formed
// after the ordinary scalar control columns have been composed.
def zicbop_alu_control = partial_pattern(AluControl()):
  result_select: AluResultSelect.Adder
  subtract: Bool(#false)
  unsigned_word: Bool(#false)
  shift_add_amount: bits(0, 2)
  word: Bool(#false)
def zicbop_operand_control = pattern(OperandControl()):
  uses_rs1: Bool(#true)
  uses_rs2: Bool(#false)
  left: OperandASelect.Register
  right: OperandBSelect.Immediate
  immediate: ImmediateSelect.Prefetch
def inactive_branch_control = partial_pattern(BranchControl()):
  resolver:
    partial_pattern(BranchResolverControl()):
      enable: Bool(#false)
def inactive_memory_control = partial_pattern(MemoryControl()):
  access: MemoryOperation.None
def inactive_writeback_control = partial_pattern(WritebackControl()):
  enable: Bool(#false)
def inactive_system_control = partial_pattern(SystemControl()):
  csr: CsrOperation.None
  action: SystemOperation.None
def inactive_fence_control = pattern(FenceControl()):
  action: FenceOperation.None

fun zicbop_operation(instruction :: InstructionSpec):
  cond
  | instruction.name == zicbop.PREFETCH_I.name: CachePrefetchOperation.Instruction
  | instruction.name == zicbop.PREFETCH_R.name: CachePrefetchOperation.Read
  | ~else: CachePrefetchOperation.Write

def ZicbopCoreControlCases = for List (instruction in zicbop.ZicbopInstructions):
  DecodeCase(
    instruction_pattern(instruction),
    pattern(RV5StageControl()):
      alu: zicbop_alu_control
      operand: zicbop_operand_control
      branch: inactive_branch_control
      memory: inactive_memory_control
      prefetch: zicbop_operation(instruction)
      multiply: pattern(RV5StageMultiplyControl(), _)
      divide: pattern(RV5StageDivideControl(), _)
      writeback: inactive_writeback_control
      system: inactive_system_control
      fence: inactive_fence_control
      hint: HintOperation.None
      floating_point_valid: Bool(#false)
      floating_point: pattern(RV5StageFloatingPointControl(), _)
  )

// Hint overlays preserve intent without introducing register use or architectural effects.
fun hint_control_case(instruction :: InstructionSpec, hint :: HintOperation):
  DecodeCase(
    instruction_pattern(instruction),
    partial_pattern(RV5StageControl()):
      operand:
        partial_pattern(OperandControl()):
          uses_rs1: Bool(#false)
          uses_rs2: Bool(#false)
      branch: inactive_branch_control
      memory: inactive_memory_control
      prefetch: CachePrefetchOperation.None
      writeback: inactive_writeback_control
      system: inactive_system_control
      fence: inactive_fence_control
      hint: hint
      floating_point_valid: Bool(#false)
  )
def ZihintpauseCoreControlCases = [hint_control_case(PAUSE, HintOperation.Pause)]
def ZihintntlCoreControlCases = [
  hint_control_case(NTL_P1, HintOperation.NtlP1),
  hint_control_case(NTL_PALL, HintOperation.NtlPall),
  hint_control_case(NTL_S1, HintOperation.NtlS1),
  hint_control_case(NTL_ALL, HintOperation.NtlAll)
]

// Reservation waits retain retirement context in the core.
def ZawrsCoreControlCases = compose_control_cases(
  ZawrsInstructions,
  ZawrsAluCases,
  ZawrsOperandCases,
  ZawrsBranchCases,
  ZawrsMemoryCases,
  ZawrsMultiplyCases,
  ZawrsDivideCases,
  ZawrsWritebackCases,
  ZawrsSystemCases,
  ZawrsFenceCases
)

def ZicbozCoreControlCases = compose_control_cases(
  ZicbozInstructions,
  ZicbozAluCases,
  ZicbozOperandCases,
  ZicbozBranchCases,
  ZicbozMemoryCases,
  ZicbozMultiplyCases,
  ZicbozDivideCases,
  ZicbozWritebackCases,
  ZicbozSystemCases,
  ZicbozFenceCases
)
def ZicbomCoreControlCases = compose_control_cases(
  ZicbomInstructions,
  ZicbomAluCases,
  ZicbomOperandCases,
  ZicbomBranchCases,
  ZicbomMemoryCases,
  ZicbomMultiplyCases,
  ZicbomDivideCases,
  ZicbomWritebackCases,
  ZicbomSystemCases,
  ZicbomFenceCases
)

def RV32IControlCases = compose_control_cases(
  rv32.RV32IInstructions,
  RV32ICompleteAluCases,
  RV32IOperandCases,
  RV32IBranchCases,
  RV32IMemoryCases,
  RV32RV5StageMultiplyCases,
  RV32RV5StageDivideCases,
  RV32IWritebackCases,
  RV32ISystemCases,
  RV32IFenceCases
)
def RV64IControlCases = compose_control_cases(
  RV64IInstructions,
  RV64ICompleteAluCases,
  RV64IOperandCases,
  RV64IBranchCases,
  RV64IMemoryCases,
  RV64RV5StageMultiplyCases,
  RV64RV5StageDivideCases,
  RV64IWritebackCases,
  RV64ISystemCases,
  RV64IFenceCases
)
def RV32RV5StageInstructions = rv32.RV32IInstructions ++ RV32MInstructions ++ RV32AInstructions ++ RV32BInstructions ++ ZicondInstructions ++ (
  ZicsrInstructions ++ ZifenceiInstructions ++ ZimopInstructions ++ PrivilegedInstructions
)
def RV64RV5StageInstructions = RV64IInstructions ++ RV64MInstructions ++ RV64AInstructions ++ RV64BInstructions ++ ZicondInstructions ++ (
  ZicsrInstructions ++ ZifenceiInstructions ++ ZimopInstructions ++ PrivilegedInstructions
)
fun rv5stage_instructions(xlen :: XLen,
                          profile :: FloatingPointProfile,
                          half_precision :: HalfPrecisionProfile,
                          ~zfa: zfa_enabled :: Boolean = #false,
                          ~zicbop: zicbop_enabled :: Boolean = #false,
                          ~zawrs: zawrs_enabled :: Boolean = #false,
                          ~zihintpause: zihintpause_enabled :: Boolean = #false,
                          ~zihintntl: zihintntl_enabled :: Boolean = #false,
                          ~zicbom: zicbom_enabled :: Boolean = #false,
                          ~zicboz: zicboz_enabled :: Boolean = #false) :: List.of(InstructionSpec):
  check_rv5stage_floating_point_profile(xlen, profile, half_precision, ~zfa: zfa_enabled)
  def base_integer_instructions = if xlen == XLen.X32 | RV32RV5StageInstructions | RV64RV5StageInstructions
  def integer_instructions = base_integer_instructions ++ (if zicbop_enabled | zicbop.ZicbopInstructions | []) ++ (if zicboz_enabled | ZicbozInstructions | []) ++ (if zicbom_enabled | ZicbomInstructions | []) ++ (if zawrs_enabled | ZawrsInstructions | []) ++ (if zihintpause_enabled | ZihintpauseInstructions | []) ++ (if zihintntl_enabled | ZihintntlInstructions | [])
  if profile == FloatingPointProfile.None
  | integer_instructions
  | integer_instructions ++ rv5stage_floating_point_instructions(xlen, profile, half_precision, ~zfa: zfa_enabled)
def RV32RV5StageControlCases = compose_control_cases(
  RV32RV5StageInstructions,
  RV32RV5StageAluCases,
  RV32RV5StageOperandCases,
  RV32RV5StageBranchCases,
  RV32RV5StageMemoryCases,
  RV32RV5StageMultiplyCases,
  RV32RV5StageDivideCases,
  RV32RV5StageWritebackCases,
  RV32RV5StageSystemCases,
  RV32RV5StageFenceCases
)
def RV64RV5StageControlCases = compose_control_cases(
  RV64RV5StageInstructions,
  RV64RV5StageAluCases,
  RV64RV5StageOperandCases,
  RV64RV5StageBranchCases,
  RV64RV5StageMemoryCases,
  RV64RV5StageMultiplyCases,
  RV64RV5StageDivideCases,
  RV64RV5StageWritebackCases,
  RV64RV5StageSystemCases,
  RV64RV5StageFenceCases
)
def RV32RV5StageZicbopControlCases = overlay_decode_cases(RV32RV5StageControlCases, ZicbopCoreControlCases)
def RV64RV5StageZicbopControlCases = overlay_decode_cases(RV64RV5StageControlCases, ZicbopCoreControlCases)
def RV32FCoreControlCases = RV32RV5StageControlCases ++ floating_point_core_control_cases(
  RV32FFloatingPointInstructions,
  RV32FFloatingPointControlCases
)
def RV64DCoreControlCases = RV64RV5StageControlCases ++ floating_point_core_control_cases(
  RV64FDFloatingPointInstructions,
  RV64FDFloatingPointControlCases
)
def RV32IControlDecode = ValidDecodeGen(RV32IControlCases)
def RV64IControlDecode = ValidDecodeGen(RV64IControlCases)
def RV32RV5StageControlDecode = ValidDecodeGen(RV32RV5StageControlCases)
def RV64RV5StageControlDecode = ValidDecodeGen(RV64RV5StageControlCases)
def RV32FCoreControlDecode = ValidDecodeGen(RV32FCoreControlCases)
def RV64DCoreControlDecode = ValidDecodeGen(RV64DCoreControlCases)

circuit RV5StageInstructionDecoder(
  xlen :: XLen,
  profile :: FloatingPointProfile = DefaultFloatingPointProfile,
  half_precision :: HalfPrecisionProfile = DefaultHalfPrecisionProfile,
  ~zfa: zfa_enabled :: Boolean = #false,
  ~zicbop: zicbop_enabled :: Boolean = #false,
  ~zawrs: zawrs_enabled :: Boolean = #false,
  ~zihintpause: zihintpause_enabled :: Boolean = #false,
  ~zihintntl: zihintntl_enabled :: Boolean = #false,
  ~zicbom: zicbom_enabled :: Boolean = #false,
  ~zicboz: zicboz_enabled :: Boolean = #false
):
  check_rv5stage_floating_point_profile(xlen, profile, half_precision, ~zfa: zfa_enabled)
  input instruction: Bits(32)
  output valid: Bool
  output control: RV5StageControl()

  def base_integer_cases = if xlen == XLen.X32 | RV32RV5StageControlCases | RV64RV5StageControlCases
  def integer_cases = (if zicbop_enabled | overlay_decode_cases(base_integer_cases, ZicbopCoreControlCases) | base_integer_cases) ++ (if zicboz_enabled | ZicbozCoreControlCases | []) ++ (if zicbom_enabled | ZicbomCoreControlCases | []) ++ (if zawrs_enabled | ZawrsCoreControlCases | [])
  def hint_overrides = (if zihintpause_enabled | ZihintpauseCoreControlCases | []) ++ (if zihintntl_enabled | ZihintntlCoreControlCases | [])
  def hinted_cases = if hint_overrides.is_empty() | integer_cases | overlay_decode_cases(integer_cases, hint_overrides)
  def selected_cases:
    if profile == FloatingPointProfile.None
    | hinted_cases
    | hinted_cases ++ floating_point_core_control_cases(
        rv5stage_floating_point_instructions(xlen, profile, half_precision, ~zfa: zfa_enabled),
        rv5stage_floating_point_control_cases(xlen, profile, half_precision, ~zfa: zfa_enabled)
      )
  def decoded :: DecodeResult(RV5StageControl()) = ValidDecodeGen(selected_cases)(instruction)
  valid <== decoded.valid
  control <== decoded.value

export:
  ZihintntlCoreControlCases
  ZihintpauseCoreControlCases
  ZawrsCoreControlCases
  ZicbomCoreControlCases
  ZicbozCoreControlCases
  RV5StageControl
  compose_control_cases
  RV32IControlCases
  RV64IControlCases
  RV32IControlDecode
  RV64IControlDecode
  RV32RV5StageInstructions
  RV64RV5StageInstructions
  rv5stage_instructions
  RV32RV5StageControlCases
  RV64RV5StageControlCases
  ZicbopCoreControlCases
  RV32RV5StageZicbopControlCases
  RV64RV5StageZicbopControlCases
  RV32RV5StageControlDecode
  RV64RV5StageControlDecode
  RV32FCoreControlCases
  RV64DCoreControlCases
  RV32FCoreControlDecode
  RV64DCoreControlDecode
  RV5StageInstructionDecoder
