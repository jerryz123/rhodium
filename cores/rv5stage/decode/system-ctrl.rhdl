#lang rhodium
// Defines RV5Stage's CSR, trap, return, and wait instruction controls.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../riscv/isa/zawrs.rhm" open
  "../../../riscv/isa/zicboz.rhm" open
  "../../../riscv/isa/zicbom.rhm" open
  "../../../riscv/rtl/decode.rhdl" open
  "../../../riscv/isa/rv32i.rhm" as rv32
  "../../../riscv/isa/rv64i.rhm" open
  "../../../riscv/isa/m.rhm" open
  "../../../riscv/isa/a.rhm" open
  "../../../riscv/isa/b.rhm" open
  "../../../riscv/isa/zicond.rhm" open
  "../../../riscv/isa/zicsr.rhm" open
  "../../../riscv/isa/zifencei.rhm" open
  "../../../riscv/isa/zimop.rhm" open
  "../../../riscv/isa/privileged.rhm" open
  "../../../riscv/rtl/csr.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/decode.rhdl") open

hardware_enum RV5StageSystemOperation:
  None
  Ecall
  Ebreak
  Mret
  Sret
  Wfi
  WrsNto
  WrsSto
  VectorConfig

bundle RV5StageSystemControl():
  csr: RiscvCsrOperation
  immediate: Bool
  action: RV5StageSystemOperation

  method is_system_operation(control) :: Bool:
    (control.csr =/= RiscvCsrOperation.None) ||| (
      control.action =/= RV5StageSystemOperation.None
    )

def no_system = partial_pattern(RV5StageSystemControl()):
  csr: RiscvCsrOperation.None
  action: RV5StageSystemOperation.None

fun csr_control(operation :: RiscvCsrOperation, immediate :: Boolean):
  pattern(RV5StageSystemControl()):
    csr: operation
    immediate: Bool(immediate)
    action: RV5StageSystemOperation.None

fun system_control(operation :: RV5StageSystemOperation):
  partial_pattern(RV5StageSystemControl()):
    csr: RiscvCsrOperation.None
    action: operation

def ZicsrSystemCases = combine_case_groups([
  instruction_cases([CSRRW], csr_control(RiscvCsrOperation.Write, #false)),
  instruction_cases([CSRRS], csr_control(RiscvCsrOperation.Set, #false)),
  instruction_cases([CSRRC], csr_control(RiscvCsrOperation.Clear, #false)),
  instruction_cases([CSRRWI], csr_control(RiscvCsrOperation.Write, #true)),
  instruction_cases([CSRRSI], csr_control(RiscvCsrOperation.Set, #true)),
  instruction_cases([CSRRCI], csr_control(RiscvCsrOperation.Clear, #true))
])

def PrivilegedSystemCases = combine_case_groups([
  instruction_cases([MRET], system_control(RV5StageSystemOperation.Mret)),
  instruction_cases([SRET], system_control(RV5StageSystemOperation.Sret)),
  instruction_cases([WFI], system_control(RV5StageSystemOperation.Wfi)),
  instruction_cases([SFENCE_VMA], no_system)
])

fun base_system_cases(instructions :: List.of(InstructionSpec)):
  combine_case_groups([
    instruction_cases([ECALL], system_control(RV5StageSystemOperation.Ecall)),
    instruction_cases([EBREAK], system_control(RV5StageSystemOperation.Ebreak)),
    instruction_cases(excluding_instructions(instructions, [ECALL, EBREAK]), no_system)
  ])

def RV32ISystemCases = base_system_cases(rv32.RV32IInstructions)
def RV64ISystemCases = base_system_cases(RV64IInstructions)
def RV32RV5StageSystemCases = RV32ISystemCases ++ instruction_cases(
  RV32MInstructions ++ RV32AInstructions ++ RV32BInstructions ++ ZicondInstructions ++ ZimopInstructions,
  no_system
) ++ ZicsrSystemCases ++ PrivilegedSystemCases ++ instruction_cases(ZifenceiInstructions, no_system)
def RV64RV5StageSystemCases = RV64ISystemCases ++ instruction_cases(
  RV64MInstructions ++ RV64AInstructions ++ RV64BInstructions ++ ZicondInstructions ++ ZimopInstructions,
  no_system
) ++ ZicsrSystemCases ++ PrivilegedSystemCases ++ instruction_cases(ZifenceiInstructions, no_system)

def ZicbozSystemCases = instruction_cases(ZicbozInstructions, no_system)
def ZicbomSystemCases = instruction_cases(ZicbomInstructions, no_system)

def ZawrsSystemCases = combine_case_groups([
  instruction_cases([WRS_NTO], system_control(RV5StageSystemOperation.WrsNto)),
  instruction_cases([WRS_STO], system_control(RV5StageSystemOperation.WrsSto))
])

export:
  ZawrsSystemCases
  ZicbomSystemCases
  ZicbozSystemCases
  RV5StageSystemOperation
  RV5StageSystemControl
  RV32ISystemCases
  RV64ISystemCases
  RV32RV5StageSystemCases
  RV64RV5StageSystemCases
