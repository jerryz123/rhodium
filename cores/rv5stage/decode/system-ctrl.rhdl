#lang rhodium
/* Defines RV5Stage's CSR, trap, return, and wait instruction controls. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../../csr/decode.rhdl" open
  "../../csr/protocol.rhdl".RiscvCsrAction
  "../../../riscv/isa/zawrs.rhm" open
  "../../../riscv/isa/zicboz.rhm" open
  "../../../riscv/isa/zicbom.rhm" open
  "../../../riscv/rtl/decode.rhdl" open
  "../../../riscv/isa/rv32i.rhm" as rv32
  "../../../riscv/isa/rv64i.rhm" open
  "../../../riscv/isa/m.rhm" open
  "../../../riscv/isa/a.rhm" open
  "../../../riscv/isa/b.rhm" open
  "../../../riscv/isa/zicond.rhm" open
  "../../../riscv/isa/zicsr.rhm" open
  "../../../riscv/isa/zifencei.rhm" open
  "../../../riscv/isa/zimop.rhm" open
  "../../../riscv/isa/privileged.rhm" open
  "../../../riscv/rtl/csr.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/decode.rhdl") open

/* Selects reservation waiting independently of the architectural CSR action. */
hardware_enum RV5StageWait:
  None
  NoTimeout
  ShortTimeout

/* Carries CSR operation/source mode and the separate system action. */
bundle RV5StageSystemControl():
  csr: RiscvCsrOperation
  immediate: Bool
  action: RiscvCsrAction
  wait: RV5StageWait

  /* Identifies either CSR access or a system action requiring core serialization policy. */
  method is_system_operation(control) :: Bool:
    (control.csr =/= RiscvCsrOperation.None) ||| (
      control.action =/= RiscvCsrAction.None
    ) ||| (control.wait =/= RV5StageWait.None)

def no_system = partial_pattern(RV5StageSystemControl()):
  csr: RiscvCsrOperation.None
  action: RiscvCsrAction.None
  wait: RV5StageWait.None

def no_wait = partial_pattern(RV5StageSystemControl()): wait: RV5StageWait.None
def csr_inactive = partial_pattern(RV5StageSystemControl()):
  action: RiscvCsrAction.None
  wait: RV5StageWait.None
def ZicsrSystemCases = csr_access_cases(RV5StageSystemControl(), csr_inactive)
def PrivilegedSystemCases = csr_system_cases(RV5StageSystemControl(), no_wait, [MRET, SRET, WFI, SFENCE_VMA])

def RV32ISystemCases = csr_system_cases(RV5StageSystemControl(), no_wait, rv32.RV32IInstructions)
def RV64ISystemCases = csr_system_cases(RV5StageSystemControl(), no_wait, RV64IInstructions)
def RV32RV5StageSystemCases = RV32ISystemCases ++ instruction_cases(
  RV32MInstructions ++ RV32AInstructions ++ RV32BInstructions ++ ZicondInstructions ++ ZimopInstructions,
  no_system
) ++ ZicsrSystemCases ++ PrivilegedSystemCases ++ instruction_cases(ZifenceiInstructions, no_system)
def RV64RV5StageSystemCases = RV64ISystemCases ++ instruction_cases(
  RV64MInstructions ++ RV64AInstructions ++ RV64BInstructions ++ ZicondInstructions ++ ZimopInstructions,
  no_system
) ++ ZicsrSystemCases ++ PrivilegedSystemCases ++ instruction_cases(ZifenceiInstructions, no_system)

def ZicbozSystemCases = instruction_cases(ZicbozInstructions, no_system)
def ZicbomSystemCases = instruction_cases(ZicbomInstructions, no_system)

def ZawrsSystemCases = decode_groups(RV5StageSystemControl(), ~input: instruction_pattern):
  [WRS_NTO]:
    csr: RiscvCsrOperation.None
    action: RiscvCsrAction.None
    wait: RV5StageWait.NoTimeout
  [WRS_STO]:
    csr: RiscvCsrOperation.None
    action: RiscvCsrAction.None
    wait: RV5StageWait.ShortTimeout

export:
  ZawrsSystemCases
  ZicbomSystemCases
  ZicbozSystemCases
  RV5StageWait
  RV5StageSystemControl
  RV32ISystemCases
  RV64ISystemCases
  RV32RV5StageSystemCases
  RV64RV5StageSystemCases
