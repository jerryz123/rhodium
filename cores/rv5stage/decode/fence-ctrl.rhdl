#lang rhodium
// Defines RV5Stage's explicit memory- and instruction-fence controls.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../riscv/isa/zawrs.rhm" open
  "../../../riscv/isa/zicboz.rhm" open
  "../../../riscv/isa/zicbom.rhm" open
  "decode-support.rhdl" open
  "../../../riscv/isa/rv32i.rhm" as rv32
  "../../../riscv/isa/rv64i.rhm" open
  "../../../riscv/isa/m.rhm" open
  "../../../riscv/isa/a.rhm" open
  "../../../riscv/isa/b.rhm" open
  "../../../riscv/isa/zicond.rhm" open
  "../../../riscv/isa/zicsr.rhm" open
  "../../../riscv/isa/zifencei.rhm" open
  "../../../riscv/isa/zimop.rhm" open
  "../../../riscv/isa/privileged.rhm" open
  lib("rhodium/std/decode.rhdl") open

hardware_enum FenceOperation:
  None
  Memory
  Instruction
  AddressTranslation

bundle FenceControl():
  action: FenceOperation

  method is_fence_operation(control) :: Bool:
    control.action =/= FenceOperation.None

  method is_instruction_fence(control) :: Bool:
    control.action === FenceOperation.Instruction

  method is_address_translation_fence(control) :: Bool:
    control.action === FenceOperation.AddressTranslation

def no_fence = pattern(FenceControl()):
  action: FenceOperation.None
def memory_fence = pattern(FenceControl()):
  action: FenceOperation.Memory
def instruction_fence = pattern(FenceControl()):
  action: FenceOperation.Instruction
def address_translation_fence = pattern(FenceControl()):
  action: FenceOperation.AddressTranslation

fun base_fence_cases(instructions :: List.of(InstructionSpec)):
  instruction_cases([FENCE], memory_fence) ++ instruction_cases(
    excluding_instructions(instructions, [FENCE]),
    no_fence
  )

def RV32IFenceCases = base_fence_cases(rv32.RV32IInstructions)
def RV64IFenceCases = base_fence_cases(RV64IInstructions)
def RV32RV5StageFenceCases = RV32IFenceCases ++ instruction_cases(
  RV32MInstructions ++ RV32AInstructions ++ RV32BInstructions ++ ZicondInstructions ++ ZicsrInstructions ++ ZimopInstructions ++ excluding_instructions(PrivilegedInstructions, [SFENCE_VMA]),
  no_fence
) ++ instruction_cases(ZifenceiInstructions, instruction_fence) ++ instruction_cases(
  [SFENCE_VMA],
  address_translation_fence
)
def RV64RV5StageFenceCases = RV64IFenceCases ++ instruction_cases(
  RV64MInstructions ++ RV64AInstructions ++ RV64BInstructions ++ ZicondInstructions ++ ZicsrInstructions ++ ZimopInstructions ++ excluding_instructions(PrivilegedInstructions, [SFENCE_VMA]),
  no_fence
) ++ instruction_cases(ZifenceiInstructions, instruction_fence) ++ instruction_cases(
  [SFENCE_VMA],
  address_translation_fence
)

def ZicbozFenceCases = instruction_cases(ZicbozInstructions, no_fence)
def ZicbomFenceCases = instruction_cases(ZicbomInstructions, no_fence)

def ZawrsFenceCases = instruction_cases(ZawrsInstructions, no_fence)

export:
  ZawrsFenceCases
  ZicbomFenceCases
  ZicbozFenceCases
  FenceOperation
  FenceControl
  RV32IFenceCases
  RV64IFenceCases
  RV32RV5StageFenceCases
  RV64RV5StageFenceCases
