    unit: RV5StageFloatUnit.RoundToIntegral
    source_precision: RV5StageFloatPrecision.Half
    destination_precision: RV5StageFloatPrecision.Half
    uses_rounding_mode: Bool(#true)
    round_raise_inexact: Bool(#false)
  [zfa.FROUNDNX_H]:
    unit: RV5StageFloatUnit.RoundToIntegral
    source_precision: RV5StageFloatPrecision.Half
    destination_precision: RV5StageFloatPrecision.Half
    uses_rounding_mode: Bool(#true)
    round_raise_inexact: Bool(#true)
  [zfa.FLEQ_H]:
    unit: RV5StageFloatUnit.Compare
    source_precision: RV5StageFloatPrecision.Half
    comparison: RV5StageFloatComparison.LessEqual
    comparison_signaling: Bool(#false)
  [zfa.FLTQ_H]:
