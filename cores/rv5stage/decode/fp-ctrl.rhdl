    integer_unsigned: Bool(#false)

  [f.FCVT_LU_S]:
    unit: RV5StageFloatUnit.Convert
    source_precision: RV5StageFloatPrecision.Single
    uses_rounding_mode: Bool(#true)
    integer_width: RV5StageFloatIntegerWidth.Long
    integer_unsigned: Bool(#true)

