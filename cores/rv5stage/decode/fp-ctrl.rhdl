    unit: RV5StageFloatUnit.MinMax
    source_precision: RV5StageFloatPrecision.Double
    destination_precision: RV5StageFloatPrecision.Double
    minmax_operation: MinMaxOperation.Maximum
  [zfa.FROUND_D]:
    unit: RV5StageFloatUnit.RoundToIntegral
    source_precision: RV5StageFloatPrecision.Double
    destination_precision: RV5StageFloatPrecision.Double
    uses_rounding_mode: Bool(#true)
    round_raise_inexact: Bool(#false)
  [zfa.FROUNDNX_D]:
    unit: RV5StageFloatUnit.RoundToIntegral
    source_precision: RV5StageFloatPrecision.Double
    destination_precision: RV5StageFloatPrecision.Double
    uses_rounding_mode: Bool(#true)
    round_raise_inexact: Bool(#true)
  [zfa.FCVTMOD_W_D]:
    unit: RV5StageFloatUnit.IntegerModulo
    source_precision: RV5StageFloatPrecision.Double
    integer_width: RV5StageFloatIntegerWidth.Word
    integer_unsigned: Bool(#false)
  [zfa.FLEQ_D]:
    unit: RV5StageFloatUnit.Compare
    source_precision: RV5StageFloatPrecision.Double
    comparison: RV5StageFloatComparison.LessEqual
    comparison_signaling: Bool(#false)
  [zfa.FLTQ_D]:
    unit: RV5StageFloatUnit.Compare
    source_precision: RV5StageFloatPrecision.Double
    comparison: RV5StageFloatComparison.Less
    comparison_signaling: Bool(#false)

def HalfZfaExecutionCases = decode_groups(
  RV5StageFloatExecutionControl(),
  ~input: instruction_pattern
):
  [zfa.FLI_H]:
    unit: RV5StageFloatUnit.Immediate
    destination_precision: RV5StageFloatPrecision.Half
  [zfa.FMINM_H]:
    unit: RV5StageFloatUnit.MinMax
    source_precision: RV5StageFloatPrecision.Half
    destination_precision: RV5StageFloatPrecision.Half
    minmax_operation: MinMaxOperation.Minimum
