#lang rhodium
// Defines RV5Stage's profile-selected F and D register and execution controls.
// SPDX-License-Identifier: Apache-2.0

import:
  "../profile.rhm" open
  "decode-support.rhdl" open
  "../fp/types.rhdl" open
  "../../../riscv/isa/fp-profile.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/isa/f.rhm" as f
  "../../../riscv/isa/d.rhm" as d
  "../../../riscv/isa/zfhmin.rhm" as zfhmin
  "../../../riscv/isa/zfh.rhm" as zfh
  "../../../riscv/isa/zfa.rhm" as zfa
  "../../../riscv/model/main.rhm" open
  "../../../riscv/rtl/floating-point.rhdl".FloatSignOperation
  lib("hardfloat/main.rhdl").MulAddOperation
  lib("hardfloat/main.rhdl").MinMaxOperation
  lib("rhodium/std/decode.rhdl") open

hardware_enum RV5StageFloatUnit:
  Memory
  FusedMultiplyAdd
  Add
  Multiply
  DivideSquareRoot
  SignInject
  MinMax
  Compare
  Convert
  Move
  Classify
  Immediate
  RoundToIntegral
  IntegerModulo

hardware_enum RV5StageFloatDestination:
  None
  Integer
  FloatingPoint

hardware_enum RV5StageFloatAddOperation:
  Add
  Subtract

hardware_enum RV5StageFloatDivideOperation:
  Divide
  SquareRoot

hardware_enum RV5StageFloatComparison:
  Equal
  Less
  LessEqual

hardware_enum RV5StageFloatIntegerWidth:
  Word
  Long

bundle RV5StageFloatRegisterControl():
  uses_integer_rs1: Bool
  uses_frs1: Bool
  uses_frs2: Bool
  uses_frs3: Bool
  destination: RV5StageFloatDestination

bundle RV5StageFloatExecutionControl():
  unit: RV5StageFloatUnit
  source_precision: RV5StageFloatPrecision
  destination_precision: RV5StageFloatPrecision
  uses_rounding_mode: Bool
  memory_write: Bool
  fused_operation: MulAddOperation
  add_operation: RV5StageFloatAddOperation
  divide_operation: RV5StageFloatDivideOperation
  sign_operation: FloatSignOperation
  minmax_operation: MinMaxOperation
  comparison: RV5StageFloatComparison
  comparison_signaling: Bool
  round_raise_inexact: Bool
  integer_width: RV5StageFloatIntegerWidth
  integer_unsigned: Bool

bundle RV5StageFloatingPointControl():
  registers: RV5StageFloatRegisterControl()
  execution: RV5StageFloatExecutionControl()

fun register_control(instruction :: InstructionSpec):
  def source_names = instruction.operands.filter(~keep: fun (operand): operand.role == "source").map(fun (operand): operand.name)
  def destination = instruction.operands.find(fun (operand): operand.role == "destination")
  def destination_control:
    cond
    | destination == #false: RV5StageFloatDestination.None
    | destination.bank == RegisterBank.Integer: RV5StageFloatDestination.Integer
    | ~else: RV5StageFloatDestination.FloatingPoint
  pattern(RV5StageFloatRegisterControl()):
    uses_integer_rs1: Bool(source_names.contains("rs1"))
    uses_frs1: Bool(source_names.contains("frs1"))
    uses_frs2: Bool(source_names.contains("frs2"))
    uses_frs3: Bool(source_names.contains("frs3"))
    destination: destination_control

def SingleExecutionCases = decode_groups(
  RV5StageFloatExecutionControl(),
  ~input: instruction_pattern
):
  [f.FLW]:
    unit: RV5StageFloatUnit.Memory
    destination_precision: RV5StageFloatPrecision.Single
    memory_write: Bool(#false)

  [f.FSW]:
    unit: RV5StageFloatUnit.Memory
    source_precision: RV5StageFloatPrecision.Single
    memory_write: Bool(#true)

  [f.FMADD_S]:
    unit: RV5StageFloatUnit.FusedMultiplyAdd
    source_precision: RV5StageFloatPrecision.Single
    destination_precision: RV5StageFloatPrecision.Single
    uses_rounding_mode: Bool(#true)
    fused_operation: MulAddOperation.MultiplyAdd

  [f.FMSUB_S]:
    unit: RV5StageFloatUnit.FusedMultiplyAdd
    source_precision: RV5StageFloatPrecision.Single
    destination_precision: RV5StageFloatPrecision.Single
    uses_rounding_mode: Bool(#true)
    fused_operation: MulAddOperation.MultiplySubtract

  [f.FNMSUB_S]:
    unit: RV5StageFloatUnit.FusedMultiplyAdd
    source_precision: RV5StageFloatPrecision.Single
    destination_precision: RV5StageFloatPrecision.Single
    uses_rounding_mode: Bool(#true)
    fused_operation: MulAddOperation.NegatedMultiplyAdd

  [f.FNMADD_S]:
    unit: RV5StageFloatUnit.FusedMultiplyAdd
    source_precision: RV5StageFloatPrecision.Single
    destination_precision: RV5StageFloatPrecision.Single
    uses_rounding_mode: Bool(#true)
    fused_operation: MulAddOperation.NegatedMultiplySubtract

  [f.FADD_S]:
    unit: RV5StageFloatUnit.Add
    source_precision: RV5StageFloatPrecision.Single
    destination_precision: RV5StageFloatPrecision.Single
    uses_rounding_mode: Bool(#true)
    add_operation: RV5StageFloatAddOperation.Add

  [f.FSUB_S]:
    unit: RV5StageFloatUnit.Add
    source_precision: RV5StageFloatPrecision.Single
    destination_precision: RV5StageFloatPrecision.Single
    uses_rounding_mode: Bool(#true)
    add_operation: RV5StageFloatAddOperation.Subtract

  [f.FMUL_S]:
    unit: RV5StageFloatUnit.Multiply
    source_precision: RV5StageFloatPrecision.Single
    destination_precision: RV5StageFloatPrecision.Single
    uses_rounding_mode: Bool(#true)

  [f.FDIV_S]:
    unit: RV5StageFloatUnit.DivideSquareRoot
    source_precision: RV5StageFloatPrecision.Single
    destination_precision: RV5StageFloatPrecision.Single
    uses_rounding_mode: Bool(#true)
    divide_operation: RV5StageFloatDivideOperation.Divide

  [f.FSQRT_S]:
    unit: RV5StageFloatUnit.DivideSquareRoot
    source_precision: RV5StageFloatPrecision.Single
    destination_precision: RV5StageFloatPrecision.Single
    uses_rounding_mode: Bool(#true)
    divide_operation: RV5StageFloatDivideOperation.SquareRoot

  [f.FSGNJ_S]:
    unit: RV5StageFloatUnit.SignInject
    source_precision: RV5StageFloatPrecision.Single
    destination_precision: RV5StageFloatPrecision.Single
    sign_operation: FloatSignOperation.Copy

  [f.FSGNJN_S]:
    unit: RV5StageFloatUnit.SignInject
    source_precision: RV5StageFloatPrecision.Single
    destination_precision: RV5StageFloatPrecision.Single
    sign_operation: FloatSignOperation.Negate

  [f.FSGNJX_S]:
    unit: RV5StageFloatUnit.SignInject
    source_precision: RV5StageFloatPrecision.Single
    destination_precision: RV5StageFloatPrecision.Single
    sign_operation: FloatSignOperation.Xor

  [f.FMIN_S]:
    unit: RV5StageFloatUnit.MinMax
    source_precision: RV5StageFloatPrecision.Single
    destination_precision: RV5StageFloatPrecision.Single
    minmax_operation: MinMaxOperation.MinimumNumber

  [f.FMAX_S]:
    unit: RV5StageFloatUnit.MinMax
    source_precision: RV5StageFloatPrecision.Single
    destination_precision: RV5StageFloatPrecision.Single
    minmax_operation: MinMaxOperation.MaximumNumber

  [f.FEQ_S]:
    unit: RV5StageFloatUnit.Compare
    source_precision: RV5StageFloatPrecision.Single
    comparison: RV5StageFloatComparison.Equal
    comparison_signaling: Bool(#false)

  [f.FLT_S]:
    unit: RV5StageFloatUnit.Compare
    source_precision: RV5StageFloatPrecision.Single
    comparison: RV5StageFloatComparison.Less
    comparison_signaling: Bool(#true)

  [f.FLE_S]:
    unit: RV5StageFloatUnit.Compare
    source_precision: RV5StageFloatPrecision.Single
    comparison: RV5StageFloatComparison.LessEqual
    comparison_signaling: Bool(#true)

  [f.FCLASS_S]:
    unit: RV5StageFloatUnit.Classify
    source_precision: RV5StageFloatPrecision.Single

  [f.FMV_X_W]:
    unit: RV5StageFloatUnit.Move
    source_precision: RV5StageFloatPrecision.Single

  [f.FMV_W_X]:
    unit: RV5StageFloatUnit.Move
    destination_precision: RV5StageFloatPrecision.Single

  [f.FCVT_W_S]:
    unit: RV5StageFloatUnit.Convert
    source_precision: RV5StageFloatPrecision.Single
    uses_rounding_mode: Bool(#true)
    integer_width: RV5StageFloatIntegerWidth.Word
    integer_unsigned: Bool(#false)

  [f.FCVT_WU_S]:
    unit: RV5StageFloatUnit.Convert
    source_precision: RV5StageFloatPrecision.Single
    uses_rounding_mode: Bool(#true)
    integer_width: RV5StageFloatIntegerWidth.Word
    integer_unsigned: Bool(#true)

  [f.FCVT_S_W]:
    unit: RV5StageFloatUnit.Convert
    destination_precision: RV5StageFloatPrecision.Single
    uses_rounding_mode: Bool(#true)
    integer_width: RV5StageFloatIntegerWidth.Word
    integer_unsigned: Bool(#false)

  [f.FCVT_S_WU]:
    unit: RV5StageFloatUnit.Convert
    destination_precision: RV5StageFloatPrecision.Single
    uses_rounding_mode: Bool(#true)
    integer_width: RV5StageFloatIntegerWidth.Word
    integer_unsigned: Bool(#true)

