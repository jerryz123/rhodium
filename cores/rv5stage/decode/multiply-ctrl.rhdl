#lang rhodium
// Defines RV5Stage's RV32 and RV64 Zmmul multiplier-control relation.

import:
  "../../../riscv/isa/zawrs.rhm" open
  "../../../riscv/isa/zicboz.rhm" open
  "../../../riscv/isa/zicbom.rhm" open
  "../../multiplier.rhdl" open
  "decode-support.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/isa/rv32i.rhm" as rv32
  "../../../riscv/isa/rv64i.rhm" open
  "../../../riscv/isa/m.rhm" open
  "../../../riscv/isa/a.rhm" open
  "../../../riscv/isa/b.rhm" open
  "../../../riscv/isa/zicond.rhm" open
  "../../../riscv/isa/zmmul.rhm" open
  "../../../riscv/isa/zicsr.rhm" open
  "../../../riscv/isa/zifencei.rhm" open
  "../../../riscv/isa/zimop.rhm" open
  "../../../riscv/isa/privileged.rhm" open
  "../../../riscv/rtl/instruction-pattern.rhdl" open
  lib("rhodium/std/decode.rhdl") open

bundle RV5StageMultiplyControl():
  mode: MultiplierMode()
  high_result: Bool
  word_result: Bool

def signed_signed = pattern(MultiplierMode()):
  left_signed: Bool(#true)
  right_signed: Bool(#true)

def signed_unsigned = pattern(MultiplierMode()):
  left_signed: Bool(#true)
  right_signed: Bool(#false)

def unsigned_unsigned = pattern(MultiplierMode()):
  left_signed: Bool(#false)
  right_signed: Bool(#false)

def RV32ZmmulControlCases = decode_groups(
  RV5StageMultiplyControl(),
  ~input: instruction_pattern
):
  [MUL]:
    high_result: Bool(#false)
    word_result: Bool(#false)

  [MULH]:
    mode: signed_signed
    high_result: Bool(#true)
    word_result: Bool(#false)

  [MULHSU]:
    mode: signed_unsigned
    high_result: Bool(#true)
    word_result: Bool(#false)

  [MULHU]:
    mode: unsigned_unsigned
    high_result: Bool(#true)
    word_result: Bool(#false)

def RV64ZmmulControlCases = RV32ZmmulControlCases ++ decode_groups(
  RV5StageMultiplyControl(),
  ~input: instruction_pattern
):
  [MULW]:
    high_result: Bool(#false)
    word_result: Bool(#true)

def unused_multiply = pattern(RV5StageMultiplyControl(), _)
def RV32RV5StageMultiplyCases = instruction_cases(
  rv32.RV32IInstructions ++ RV32MDivideInstructions ++ RV32AInstructions ++ RV32BInstructions ++ ZicondInstructions ++ ZicsrInstructions ++ ZifenceiInstructions ++ ZimopInstructions ++ PrivilegedInstructions,
  unused_multiply
) ++ RV32ZmmulControlCases
def RV64RV5StageMultiplyCases = instruction_cases(
  RV64IInstructions ++ RV64MDivideInstructions ++ RV64AInstructions ++ RV64BInstructions ++ ZicondInstructions ++ ZicsrInstructions ++ ZifenceiInstructions ++ ZimopInstructions ++ PrivilegedInstructions,
  unused_multiply
) ++ RV64ZmmulControlCases

def RV32ZmmulControlDecode = ValidDecodeGen(RV32ZmmulControlCases)
def RV64ZmmulControlDecode = ValidDecodeGen(RV64ZmmulControlCases)

circuit RV5StageMultiplyInstructionDecoder(xlen :: XLen):
  input instruction: Bits(32)
  output valid: Bool
  output control: RV5StageMultiplyControl()

  def decoded :: DecodeResult(RV5StageMultiplyControl()) = if xlen == XLen.X32 | RV32ZmmulControlDecode(instruction) | RV64ZmmulControlDecode(instruction)
  valid <== decoded.valid
  control <== decoded.value

def ZicbozMultiplyCases = instruction_cases(ZicbozInstructions, unused_multiply)
def ZicbomMultiplyCases = instruction_cases(ZicbomInstructions, unused_multiply)

def ZawrsMultiplyCases = instruction_cases(ZawrsInstructions, unused_multiply)

export:
  ZawrsMultiplyCases
  ZicbomMultiplyCases
  ZicbozMultiplyCases
  RV5StageMultiplyControl
  RV32ZmmulControlCases
  RV64ZmmulControlCases
  RV32RV5StageMultiplyCases
  RV64RV5StageMultiplyCases
  RV32ZmmulControlDecode
  RV64ZmmulControlDecode
  RV5StageMultiplyInstructionDecoder
