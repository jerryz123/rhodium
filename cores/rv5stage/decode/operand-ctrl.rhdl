#lang rhodium
/* Composes RV5Stage source-use and routing columns for scalar execution units. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/operand.rhdl") open
  lib("cores/operand-decode.rhdl") open
  lib("riscv/isa/zawrs.rhm") open
  lib("riscv/isa/zicboz.rhm") open
  lib("riscv/isa/zicbom.rhm") open
  lib("riscv/isa/zicsr.rhm") open
  lib("riscv/isa/zifencei.rhm") open
  lib("riscv/isa/zimop.rhm") open
  lib("riscv/isa/privileged.rhm") open
  lib("riscv/rtl/decode.rhdl") open
  lib("rhodium/std/decode.rhdl") open

def RV5StageSystemOperandCases = combine_case_groups([
  instruction_cases([CSRRW, CSRRS, CSRRC], csr_register_operands),
  instruction_cases([CSRRWI, CSRRSI, CSRRCI], no_operands),
  instruction_cases(PrivilegedInstructions ++ ZifenceiInstructions ++ ZimopInstructions, no_operands)
])

def RV32RV5StageOperandCases = RV32IOperandCases ++ RV32MOperandCases ++ RV32AOperandCases ++ RV5StageSystemOperandCases ++ RV32BOperandCases ++ ZicondOperandCases
def RV64RV5StageOperandCases = RV64IOperandCases ++ RV64MOperandCases ++ RV64AOperandCases ++ RV5StageSystemOperandCases ++ RV64BOperandCases ++ ZicondOperandCases

def ZicbozOperandCases = instruction_cases(ZicbozInstructions, load_reserved_operands)
def ZicbomOperandCases = instruction_cases(ZicbomInstructions, load_reserved_operands)

def ZawrsOperandCases = instruction_cases(ZawrsInstructions, no_operands)

export:
  ZawrsOperandCases
  ZicbomOperandCases
  ZicbozOperandCases
  RV32RV5StageOperandCases
  RV64RV5StageOperandCases
