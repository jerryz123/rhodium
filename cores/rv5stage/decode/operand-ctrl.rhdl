#lang rhodium
/* Composes RV5Stage source-use and routing columns for scalar execution units. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/operand.rhdl") open
  lib("cores/operand-decode.rhdl") open
  lib("riscv/isa/zawrs.rhm") open
  lib("riscv/isa/zicboz.rhm") open
  lib("riscv/isa/zicbom.rhm") open
  lib("riscv/isa/m.rhm") open
  lib("riscv/isa/a.rhm") open
  lib("riscv/isa/zicond.rhm") open
  lib("riscv/isa/zicsr.rhm") open
  lib("riscv/isa/zifencei.rhm") open
  lib("riscv/isa/zimop.rhm") open
  lib("riscv/isa/privileged.rhm") open
  lib("riscv/rtl/decode.rhdl") open
  lib("rhodium/std/decode.rhdl") open

def RV5StageSystemOperandCases = combine_case_groups([
  instruction_cases([CSRRW, CSRRS, CSRRC], csr_register_operands),
  instruction_cases([CSRRWI, CSRRSI, CSRRCI], no_operands),
  instruction_cases(PrivilegedInstructions ++ ZifenceiInstructions ++ ZimopInstructions, no_operands)
])
/* Dedicated M services read forwarded registers without using the ALU input muxes. */
def multiply_operands = partial_pattern(OperandControl()):
  uses_rs1: Bool(#true)
  uses_rs2: Bool(#true)

def RV32RV5StageOperandCases = RV32IOperandCases ++ instruction_cases(
  RV32MInstructions,
  multiply_operands
) ++ instruction_cases(
  excluding_instructions(RV32AInstructions, [LR_W]),
  atomic_operands
) ++ instruction_cases(
  [LR_W],
  load_reserved_operands
) ++ RV5StageSystemOperandCases ++ RV32BOperandCases ++ instruction_cases(ZicondInstructions, register_operands)
def RV64RV5StageOperandCases = RV64IOperandCases ++ instruction_cases(
  RV64MInstructions,
  multiply_operands
) ++ instruction_cases(
  excluding_instructions(RV64AInstructions, [LR_W, LR_D]),
  atomic_operands
) ++ instruction_cases(
  [LR_W, LR_D],
  load_reserved_operands
) ++ RV5StageSystemOperandCases ++ RV64BOperandCases ++ instruction_cases(ZicondInstructions, register_operands)

def ZicbozOperandCases = instruction_cases(ZicbozInstructions, load_reserved_operands)
def ZicbomOperandCases = instruction_cases(ZicbomInstructions, load_reserved_operands)

def ZawrsOperandCases = instruction_cases(ZawrsInstructions, no_operands)

export:
  ZawrsOperandCases
  ZicbomOperandCases
  ZicbozOperandCases
  RV32RV5StageOperandCases
  RV64RV5StageOperandCases
