#lang rhodium
// Decodes RVV integer, extension, fixed-point, and memory controls with register-group legality.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../riscv/isa/v.rhm" open
  "../../../riscv/isa/vector.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/rtl/vector.rhdl" open
  "../../../riscv/rtl/instruction-fields.rhdl" open
  "../../../riscv/rtl/instruction-pattern.rhdl" open
  "../../../riscv/model/instruction.rhm".InstructionSpec
  "../../simd-alu.rhdl" open
  "../vector/mask.rhdl" open
  lib("rhodium/std/decode.rhdl") open

hardware_enum VectorConfigMode:
  None
  VtypeImmediate
  AllImmediate
  VtypeRegister

hardware_enum VectorOperandMode:
  Vector
  Scalar
  Immediate

hardware_enum VectorMultiplyResult:
  Low
  High
  Fractional
  Widened

hardware_enum VectorMemoryAddressing:
  UnitStride
  Strided
  IndexedUnordered
  IndexedOrdered

bundle RV5StageVectorControl():
  configure: VectorConfigMode
  integer: Bool
  floating_point: Bool
  multiply_divide: Bool
  divide: Bool
  left_signed: Bool
  right_signed: Bool
  multiply_result: VectorMultiplyResult
  multiply_accumulate: Bool
  multiply_destination: Bool
  multiply_subtract: Bool
  remainder: Bool
  fp_subtract: Bool
  fp_multiply: Bool
  memory: Bool
  store: Bool
  memory_data_eew: Bits(2)
  memory_index_eew: Bits(2)
  memory_nf: Bits(3)
  memory_addressing: VectorMemoryAddressing
  operand: VectorOperandMode
  immediate_unsigned: Bool
  carry_input: Bool
  extension: Bool
  extension_ratio: SimdExtensionRatio
  extension_signed: Bool
  mask_destination: Bool
  mask_logic: Bool
  mask_select: Bool
  element_move: Bool
  scalar_destination: Bool
  reduction: Bool
  scan: Bool
  scan_control: VectorMaskScanControl()
  slide: Bool
  slide_up: Bool
  slide_one: Bool
  gather: Bool
  gather_index16: Bool
  compress: Bool
  widening: Bool
  narrowing: Bool
  rounding: Bool
  clip: Bool
  clip_unsigned: Bool
  wide_vs2: Bool
  uses_vs2: Bool
  invert_logic_result: Bool
  invert_comparison: Bool
  swap_operands: Bool
  alu: SimdAluControl()

def NoVectorControl = partial_pattern(RV5StageVectorControl()):
  configure: VectorConfigMode.None
  integer: Bool(#false)
  floating_point: Bool(#false)
  multiply_divide: Bool(#false)
  memory: Bool(#false)

fun config_case(instruction :: InstructionSpec, mode :: VectorConfigMode):
  DecodeCase(
    instruction_pattern(instruction),
    partial_pattern(RV5StageVectorControl()):
      configure: mode
      integer: Bool(#false)
      floating_point: Bool(#false)
      multiply_divide: Bool(#false)
      memory: Bool(#false)
  )
def VectorConfigurationCases = [
  config_case(VSETVLI, VectorConfigMode.VtypeImmediate),
  config_case(VSETIVLI, VectorConfigMode.AllImmediate),
  config_case(VSETVL, VectorConfigMode.VtypeRegister)
]

fun integer_case(instruction :: InstructionSpec, alu :: Pattern,
                 ~mask: mask :: Boolean = #false,
                 ~mask_logic: mask_logic :: Boolean = #false,
                 ~mask_select: mask_select :: Boolean = #false,
                 ~element_move: element_move :: Boolean = #false,
                 ~scalar_destination: scalar_destination :: Boolean = #false,
                 ~reduction: reduction :: Boolean = #false,
                 ~scan: scan :: Boolean = #false,
                 ~scan_result: scan_result :: VectorScanResult = VectorScanResult.Count,
                 ~scan_index: scan_index :: Boolean = #false,
                 ~include_first: include_first :: Boolean = #false,
                 ~only_first: only_first :: Boolean = #false,
                 ~slide: slide :: Boolean = #false,
                 ~slide_up: slide_up :: Boolean = #false,
                 ~slide_one: slide_one :: Boolean = #false,
                 ~gather: gather :: Boolean = #false,
                 ~gather_index16: gather_index16 :: Boolean = #false,
                 ~compress: compress :: Boolean = #false,
                 ~widening: widening :: Boolean = #false,
                 ~narrowing: narrowing :: Boolean = #false,
                 ~rounding: rounding :: Boolean = #false,
                 ~clip: clip :: Boolean = #false,
                 ~clip_unsigned: clip_unsigned :: Boolean = #false,
                 ~wide_vs2: wide_vs2 :: Boolean = #false,
                 ~left_signed: left_signed :: Boolean = #false,
                 ~right_signed: right_signed :: Boolean = #false,
                 ~carry_input: carry_input :: Boolean = #false,
                 ~extension: extension :: Boolean = #false,
                 ~extension_ratio: extension_ratio :: SimdExtensionRatio = SimdExtensionRatio.By2,
                 ~extension_signed: extension_signed :: Boolean = #false,
                 ~uses_vs2: uses_vs2 :: Boolean = #true,
                 ~invert_logic: invert_logic :: Boolean = #false,
                 ~invert: invert :: Boolean = #false,
                 ~swap: swap :: Boolean = #false):
  def form = instruction.format
  DecodeCase(
    instruction_pattern(instruction),
    partial_pattern(RV5StageVectorControl()):
      configure: VectorConfigMode.None
      integer: Bool(#true)
      floating_point: Bool(#false)
      multiply_divide: Bool(#false)
      memory: Bool(#false)
      operand: if [VectorVVFormat, VectorFixedVVFormat, VectorMoveVFormat, VectorReadScalarFormat, VectorMaskScalarFormat, VectorMaskUnaryFormat, VectorIndexFormat].contains(form) | VectorOperandMode.Vector | (if [VectorVXFormat, VectorFixedVXFormat, VectorMoveXFormat].contains(form) | VectorOperandMode.Scalar | VectorOperandMode.Immediate)
      immediate_unsigned: Bool(form == VectorShiftVIFormat)
      carry_input: Bool(carry_input)
      extension: Bool(extension)
      extension_ratio: if extension | extension_ratio | pattern(SimdExtensionRatio, _)
      extension_signed: if extension | Bool(extension_signed) | pattern(Bool, _)
      mask_destination: Bool(mask)
      mask_logic: Bool(mask_logic)
      mask_select: Bool(mask_select)
      element_move: Bool(element_move)
      scalar_destination: Bool(scalar_destination)
      reduction: Bool(reduction)
      scan: Bool(scan)
      slide: Bool(slide)
      slide_up: Bool(slide_up)
      slide_one: Bool(slide_one)
      gather: Bool(gather)
      gather_index16: Bool(gather_index16)
      compress: Bool(compress)
      widening: Bool(widening)
      narrowing: Bool(narrowing)
      rounding: Bool(rounding)
      clip: Bool(clip)
      clip_unsigned: Bool(clip_unsigned)
      wide_vs2: Bool(wide_vs2)
      left_signed: Bool(left_signed)
      right_signed: Bool(right_signed)
      scan_control:
        VectorMaskScanControl():
          result: scan_result
          index: Bool(scan_index)
          include_first: Bool(include_first)
          only_first: Bool(only_first)
      uses_vs2: Bool(uses_vs2)
      invert_logic_result: Bool(invert_logic)
      invert_comparison: Bool(invert)
      swap_operands: Bool(swap)
      alu: alu
  )

def vadd_control = partial_pattern(SimdAluControl()):
  result_select: SimdResultSelect.Adder
  arithmetic_mode: SimdArithmeticMode.Wrap
  subtract: Bool(#false)
def vsub_control = partial_pattern(SimdAluControl()):
  result_select: SimdResultSelect.Adder
  arithmetic_mode: SimdArithmeticMode.Wrap
  subtract: Bool(#true)
def vcarry_control = partial_pattern(SimdAluControl()):
  result_select: SimdResultSelect.Adder
  arithmetic_mode: SimdArithmeticMode.Wrap
  mask_result_select: SimdMaskResultSelect.CarryBorrow
  subtract: Bool(#false)
def vborrow_control = partial_pattern(SimdAluControl()):
  result_select: SimdResultSelect.Adder
  arithmetic_mode: SimdArithmeticMode.Wrap
  mask_result_select: SimdMaskResultSelect.CarryBorrow
  subtract: Bool(#true)
def vextension_control = partial_pattern(SimdAluControl()):
  result_select: SimdResultSelect.Select
