  integer_case(VIOTA_M, vselect_control, ~scan: #true, ~scan_result: VectorScanResult.Elements),
  integer_case(VID_V, vselect_control, ~scan: #true, ~scan_result: VectorScanResult.Elements, ~scan_index: #true, ~uses_vs2: #false)
]
fun memory_cases(instructions :: List.of(InstructionSpec), addressing :: VectorMemoryAddressing):
  for List (instruction in instructions, index in 0..8):
    DecodeCase(
      instruction_pattern(instruction),
      partial_pattern(RV5StageVectorControl()):
        configure: VectorConfigMode.None
        integer: Bool(#false)
        floating_point: Bool(#false)
        multiply_divide: Bool(#false)
        memory: Bool(#true)
        store: Bool(index >= 4)
        memory_mode: VectorMemoryMode.Ordinary
        memory_data_eew: bits(index mod 4, 2)
        memory_nf: bits(0, 3)
        memory_addressing: addressing
        operand: VectorOperandMode.Scalar
    )
fun indexed_memory_cases(instructions :: List.of(InstructionSpec), addressing :: VectorMemoryAddressing):
  for List (instruction in instructions, index in 0..8):
    DecodeCase(
      instruction_pattern(instruction),
      partial_pattern(RV5StageVectorControl()):
        configure: VectorConfigMode.None
        integer: Bool(#false)
        floating_point: Bool(#false)
        multiply_divide: Bool(#false)
        memory: Bool(#true)
        store: Bool(index >= 4)
        memory_mode: VectorMemoryMode.Ordinary
        memory_index_eew: bits(index mod 4, 2)
        memory_nf: bits(0, 3)
        memory_addressing: addressing
        operand: VectorOperandMode.Vector
    )
fun segment_memory_cases(instructions :: List.of(InstructionSpec), addressing :: VectorMemoryAddressing):
  for List (instruction in instructions, index in 0..56):
    DecodeCase(
      instruction_pattern(instruction),
      partial_pattern(RV5StageVectorControl()):
        configure: VectorConfigMode.None
        integer: Bool(#false)
        floating_point: Bool(#false)
        multiply_divide: Bool(#false)
        memory: Bool(#true)
        store: Bool(index >= 28)
        memory_mode: VectorMemoryMode.Ordinary
        memory_data_eew: bits(index mod 4, 2)
        memory_nf: bits(((index mod 28) div 4) + 1, 3)
        memory_addressing: addressing
        operand: VectorOperandMode.Scalar
    )
fun indexed_segment_memory_cases(instructions :: List.of(InstructionSpec), addressing :: VectorMemoryAddressing):
  for List (instruction in instructions, index in 0..56):
    DecodeCase(
      instruction_pattern(instruction),
      partial_pattern(RV5StageVectorControl()):
        configure: VectorConfigMode.None
        integer: Bool(#false)
        floating_point: Bool(#false)
        multiply_divide: Bool(#false)
        memory: Bool(#true)
        store: Bool(index >= 28)
        memory_mode: VectorMemoryMode.Ordinary
        memory_index_eew: bits(index mod 4, 2)
        memory_nf: bits(((index mod 28) div 4) + 1, 3)
        memory_addressing: addressing
        operand: VectorOperandMode.Vector
    )
fun fault_only_first_memory_cases(instructions :: List.of(InstructionSpec)):
  for List (instruction in instructions, index in 0..32):
    DecodeCase(
      instruction_pattern(instruction),
      partial_pattern(RV5StageVectorControl()):
        configure: VectorConfigMode.None
        integer: Bool(#false)
        floating_point: Bool(#false)
        multiply_divide: Bool(#false)
        memory: Bool(#true)
        store: Bool(#false)
        memory_mode: VectorMemoryMode.FaultOnlyFirst
        memory_data_eew: bits(index mod 4, 2)
        memory_nf: bits(if index < 4 | 0 | ((index - 4) div 4) + 1, 3)
        memory_addressing: VectorMemoryAddressing.UnitStride
        operand: VectorOperandMode.Scalar
    )
fun mask_memory_cases(instructions :: List.of(InstructionSpec)):
  for List (instruction in instructions, index in 0..2):
    DecodeCase(
      instruction_pattern(instruction),
      partial_pattern(RV5StageVectorControl()):
        configure: VectorConfigMode.None
        integer: Bool(#false)
        floating_point: Bool(#false)
        multiply_divide: Bool(#false)
        memory: Bool(#true)
        store: Bool(index == 1)
        memory_mode: VectorMemoryMode.Mask
        memory_data_eew: bits(0, 2)
        memory_nf: bits(0, 3)
        memory_addressing: VectorMemoryAddressing.UnitStride
        operand: VectorOperandMode.Scalar
    )
fun whole_register_memory_cases(instructions :: List.of(InstructionSpec)):
  for List (instruction in instructions, index in 0..20):
    def register_index = if index < 16 | index div 4 | index - 16
    DecodeCase(
      instruction_pattern(instruction),
      partial_pattern(RV5StageVectorControl()):
        configure: VectorConfigMode.None
        integer: Bool(#false)
        floating_point: Bool(#false)
        multiply_divide: Bool(#false)
        memory: Bool(#true)
        store: Bool(index >= 16)
        memory_mode: VectorMemoryMode.WholeRegister
        memory_data_eew: bits(if index < 16 | index mod 4 | 0, 2)
        memory_nf: bits([0, 1, 3, 7][register_index], 3)
        memory_addressing: VectorMemoryAddressing.UnitStride
        operand: VectorOperandMode.Scalar
    )
def VectorUnitStrideMemoryCases = memory_cases(VectorUnitStrideMemoryInstructions, VectorMemoryAddressing.UnitStride)
def VectorStridedMemoryCases = memory_cases(VectorStridedMemoryInstructions, VectorMemoryAddressing.Strided)
def VectorIndexedUnorderedMemoryCases = indexed_memory_cases(VectorIndexedUnorderedMemoryInstructions, VectorMemoryAddressing.IndexedUnordered)
def VectorIndexedOrderedMemoryCases = indexed_memory_cases(VectorIndexedOrderedMemoryInstructions, VectorMemoryAddressing.IndexedOrdered)
def VectorIndexedMemoryCases = VectorIndexedUnorderedMemoryCases ++ VectorIndexedOrderedMemoryCases
def VectorUnitStrideSegmentMemoryCases = segment_memory_cases(VectorUnitStrideSegmentMemoryInstructions, VectorMemoryAddressing.UnitStride)
def VectorStridedSegmentMemoryCases = segment_memory_cases(VectorStridedSegmentMemoryInstructions, VectorMemoryAddressing.Strided)
def VectorIndexedUnorderedSegmentMemoryCases = indexed_segment_memory_cases(VectorIndexedUnorderedSegmentMemoryInstructions, VectorMemoryAddressing.IndexedUnordered)
def VectorIndexedOrderedSegmentMemoryCases = indexed_segment_memory_cases(VectorIndexedOrderedSegmentMemoryInstructions, VectorMemoryAddressing.IndexedOrdered)
def VectorIndexedSegmentMemoryCases = VectorIndexedUnorderedSegmentMemoryCases ++ VectorIndexedOrderedSegmentMemoryCases
def VectorFaultOnlyFirstMemoryCases = fault_only_first_memory_cases(VectorFaultOnlyFirstLoadInstructions)
def VectorMaskMemoryCases = mask_memory_cases(VectorMaskMemoryInstructions)
def VectorWholeRegisterMemoryCases = whole_register_memory_cases(VectorWholeRegisterMemoryInstructions)
def VectorMemoryCases = VectorUnitStrideMemoryCases ++ VectorStridedMemoryCases ++ VectorIndexedMemoryCases ++ VectorUnitStrideSegmentMemoryCases ++ VectorStridedSegmentMemoryCases ++ VectorIndexedSegmentMemoryCases ++ VectorFaultOnlyFirstMemoryCases ++ VectorMaskMemoryCases ++ VectorWholeRegisterMemoryCases
fun floating_point_case(instruction :: InstructionSpec, execution :: Pattern,
                        ~uses_vs1: uses_vs1 :: Boolean = #true,
                        ~mask_destination: mask_destination :: Boolean = #false,
                        ~multiply_destination: multiply_destination :: Boolean = #false,
                        ~operand: operand :: VectorOperandMode = VectorOperandMode.Vector,
                        ~swap: swap :: Boolean = #false,
                        ~source: source :: VectorFloatSource = VectorFloatSource.Floating,
                        ~result: result :: VectorFloatResult = VectorFloatResult.Floating,
                        ~rounding: rounding :: VectorFloatRounding = VectorFloatRounding.Dynamic,
                        ~reduction: reduction :: Boolean = #false,
                        ~widening: widening :: Boolean = #false,
                        ~narrowing: narrowing :: Boolean = #false,
                        ~zvfhmin_e16: zvfhmin_e16 :: Boolean = #false,
                        ~zvfh_e8: zvfh_e8 :: Boolean = #false,
                        ~wide_vs2: wide_vs2 :: Boolean = #false):
  DecodeCase(
    instruction_pattern(instruction),
    partial_pattern(RV5StageVectorControl()):
      configure: VectorConfigMode.None
      integer: Bool(#false)
      floating_point: Bool(#true)
      fp_service: Bool(#true)
      fp_zvfhmin_e16: Bool(zvfhmin_e16)
      fp_zvfh_e8: Bool(zvfh_e8)
      multiply_divide: Bool(#false)
      memory: Bool(#false)
      operand: operand
      fp_execution: execution
      fp_uses_vs1: Bool(uses_vs1)
      fp_source: source
      fp_result: if mask_destination | VectorFloatResult.Mask | result
      fp_rounding: rounding
      reduction: Bool(reduction)
      widening: Bool(widening)
      narrowing: Bool(narrowing)
      wide_vs2: Bool(wide_vs2)
      mask_destination: Bool(mask_destination)
      floating_scalar_destination: Bool(#false)
      multiply_destination: Bool(multiply_destination)
      swap_operands: Bool(swap)
  )
fun fp_unit(unit :: RV5StageFloatUnit,
            ~rounding: rounding :: Boolean = #false,
            ~fused: fused :: MulAddOperation = MulAddOperation.MultiplyAdd,
            ~add: add :: RV5StageFloatAddOperation = RV5StageFloatAddOperation.Add,
            ~divide: divide :: RV5StageFloatDivideOperation = RV5StageFloatDivideOperation.Divide,
            ~sign: sign :: FloatSignOperation = FloatSignOperation.Copy,
            ~minmax: minmax :: MinMaxOperation = MinMaxOperation.MinimumNumber,
            ~estimate: estimate :: Estimate7Operation = Estimate7Operation.Reciprocal,
            ~comparison: comparison :: RV5StageFloatComparison = RV5StageFloatComparison.Equal,
            ~signaling: signaling :: Boolean = #false,
            ~unsigned: unsigned :: Boolean = #false):
  partial_pattern(RV5StageFloatExecutionControl()):
    unit: unit
    uses_rounding_mode: Bool(rounding)
    fused_operation: if unit == RV5StageFloatUnit.FusedMultiplyAdd | fused | pattern(MulAddOperation, _)
    add_operation: if unit == RV5StageFloatUnit.Add | add | pattern(RV5StageFloatAddOperation, _)
    divide_operation: if unit == RV5StageFloatUnit.DivideSquareRoot | divide | pattern(RV5StageFloatDivideOperation, _)
    sign_operation: if unit == RV5StageFloatUnit.SignInject | sign | pattern(FloatSignOperation, _)
    minmax_operation: if unit == RV5StageFloatUnit.MinMax | minmax | pattern(MinMaxOperation, _)
    estimate_operation: if unit == RV5StageFloatUnit.Estimate | estimate | pattern(Estimate7Operation, _)
    comparison: if unit == RV5StageFloatUnit.Compare | comparison | pattern(RV5StageFloatComparison, _)
    comparison_signaling: if unit == RV5StageFloatUnit.Compare | Bool(signaling) | pattern(Bool, _)
    integer_unsigned: if unit == RV5StageFloatUnit.Convert | Bool(unsigned) | pattern(Bool, _)
def VectorFloatingPointCases = [
  floating_point_case(VFADD_VV, fp_unit(RV5StageFloatUnit.Add, ~rounding: #true)),
  floating_point_case(VFSUB_VV, fp_unit(RV5StageFloatUnit.Add, ~rounding: #true, ~add: RV5StageFloatAddOperation.Subtract)),
  floating_point_case(VFMUL_VV, fp_unit(RV5StageFloatUnit.Multiply, ~rounding: #true)),
  floating_point_case(VFDIV_VV, fp_unit(RV5StageFloatUnit.DivideSquareRoot, ~rounding: #true)),
  floating_point_case(VFSQRT_V, fp_unit(RV5StageFloatUnit.DivideSquareRoot, ~rounding: #true, ~divide: RV5StageFloatDivideOperation.SquareRoot), ~uses_vs1: #false),
  floating_point_case(VFRSQRT7_V, fp_unit(RV5StageFloatUnit.Estimate, ~estimate: Estimate7Operation.ReciprocalSquareRoot), ~uses_vs1: #false),
  floating_point_case(VFREC7_V, fp_unit(RV5StageFloatUnit.Estimate, ~rounding: #true), ~uses_vs1: #false),
  floating_point_case(VFCLASS_V, fp_unit(RV5StageFloatUnit.Classify), ~uses_vs1: #false, ~result: VectorFloatResult.Integer),
  floating_point_case(VFSGNJ_VV, fp_unit(RV5StageFloatUnit.SignInject)),
  floating_point_case(VFSGNJN_VV, fp_unit(RV5StageFloatUnit.SignInject, ~sign: FloatSignOperation.Negate)),
  floating_point_case(VFSGNJX_VV, fp_unit(RV5StageFloatUnit.SignInject, ~sign: FloatSignOperation.Xor)),
  floating_point_case(VFMIN_VV, fp_unit(RV5StageFloatUnit.MinMax)),
  floating_point_case(VFMAX_VV, fp_unit(RV5StageFloatUnit.MinMax, ~minmax: MinMaxOperation.MaximumNumber)),
  floating_point_case(VMFEQ_VV, fp_unit(RV5StageFloatUnit.Compare), ~mask_destination: #true),
  floating_point_case(VMFNE_VV, fp_unit(RV5StageFloatUnit.Compare, ~comparison: RV5StageFloatComparison.NotEqual), ~mask_destination: #true),
  floating_point_case(VMFLT_VV, fp_unit(RV5StageFloatUnit.Compare, ~comparison: RV5StageFloatComparison.Less, ~signaling: #true), ~mask_destination: #true),
  floating_point_case(VMFLE_VV, fp_unit(RV5StageFloatUnit.Compare, ~comparison: RV5StageFloatComparison.LessEqual, ~signaling: #true), ~mask_destination: #true),
  floating_point_case(VFMACC_VV, fp_unit(RV5StageFloatUnit.FusedMultiplyAdd, ~rounding: #true)),
  floating_point_case(VFMADD_VV, fp_unit(RV5StageFloatUnit.FusedMultiplyAdd, ~rounding: #true), ~multiply_destination: #true),
  floating_point_case(VFMSAC_VV, fp_unit(RV5StageFloatUnit.FusedMultiplyAdd, ~rounding: #true, ~fused: MulAddOperation.MultiplySubtract)),
  floating_point_case(VFMSUB_VV, fp_unit(RV5StageFloatUnit.FusedMultiplyAdd, ~rounding: #true, ~fused: MulAddOperation.MultiplySubtract), ~multiply_destination: #true),
  floating_point_case(VFNMACC_VV, fp_unit(RV5StageFloatUnit.FusedMultiplyAdd, ~rounding: #true, ~fused: MulAddOperation.NegatedMultiplySubtract)),
  floating_point_case(VFNMADD_VV, fp_unit(RV5StageFloatUnit.FusedMultiplyAdd, ~rounding: #true, ~fused: MulAddOperation.NegatedMultiplySubtract), ~multiply_destination: #true),
  floating_point_case(VFNMSAC_VV, fp_unit(RV5StageFloatUnit.FusedMultiplyAdd, ~rounding: #true, ~fused: MulAddOperation.NegatedMultiplyAdd)),
  floating_point_case(VFNMSUB_VV, fp_unit(RV5StageFloatUnit.FusedMultiplyAdd, ~rounding: #true, ~fused: MulAddOperation.NegatedMultiplyAdd), ~multiply_destination: #true),
  floating_point_case(VFADD_VF, fp_unit(RV5StageFloatUnit.Add, ~rounding: #true), ~uses_vs1: #false, ~operand: VectorOperandMode.FloatingScalar),
  floating_point_case(VFSUB_VF, fp_unit(RV5StageFloatUnit.Add, ~rounding: #true, ~add: RV5StageFloatAddOperation.Subtract), ~uses_vs1: #false, ~operand: VectorOperandMode.FloatingScalar),
  floating_point_case(VFRSUB_VF, fp_unit(RV5StageFloatUnit.Add, ~rounding: #true, ~add: RV5StageFloatAddOperation.Subtract), ~uses_vs1: #false, ~operand: VectorOperandMode.FloatingScalar, ~swap: #true),
  floating_point_case(VFMUL_VF, fp_unit(RV5StageFloatUnit.Multiply, ~rounding: #true), ~uses_vs1: #false, ~operand: VectorOperandMode.FloatingScalar),
  floating_point_case(VFDIV_VF, fp_unit(RV5StageFloatUnit.DivideSquareRoot, ~rounding: #true), ~uses_vs1: #false, ~operand: VectorOperandMode.FloatingScalar),
  floating_point_case(VFRDIV_VF, fp_unit(RV5StageFloatUnit.DivideSquareRoot, ~rounding: #true), ~uses_vs1: #false, ~operand: VectorOperandMode.FloatingScalar, ~swap: #true),
  floating_point_case(VFSGNJ_VF, fp_unit(RV5StageFloatUnit.SignInject), ~uses_vs1: #false, ~operand: VectorOperandMode.FloatingScalar),
  floating_point_case(VFSGNJN_VF, fp_unit(RV5StageFloatUnit.SignInject, ~sign: FloatSignOperation.Negate), ~uses_vs1: #false, ~operand: VectorOperandMode.FloatingScalar),
  floating_point_case(VFSGNJX_VF, fp_unit(RV5StageFloatUnit.SignInject, ~sign: FloatSignOperation.Xor), ~uses_vs1: #false, ~operand: VectorOperandMode.FloatingScalar),
  floating_point_case(VFMIN_VF, fp_unit(RV5StageFloatUnit.MinMax), ~uses_vs1: #false, ~operand: VectorOperandMode.FloatingScalar),
  floating_point_case(VFMAX_VF, fp_unit(RV5StageFloatUnit.MinMax, ~minmax: MinMaxOperation.MaximumNumber), ~uses_vs1: #false, ~operand: VectorOperandMode.FloatingScalar),
  floating_point_case(VMFEQ_VF, fp_unit(RV5StageFloatUnit.Compare), ~uses_vs1: #false, ~mask_destination: #true, ~operand: VectorOperandMode.FloatingScalar),
  floating_point_case(VMFNE_VF, fp_unit(RV5StageFloatUnit.Compare, ~comparison: RV5StageFloatComparison.NotEqual), ~uses_vs1: #false, ~mask_destination: #true, ~operand: VectorOperandMode.FloatingScalar),
  floating_point_case(VMFLT_VF, fp_unit(RV5StageFloatUnit.Compare, ~comparison: RV5StageFloatComparison.Less, ~signaling: #true), ~uses_vs1: #false, ~mask_destination: #true, ~operand: VectorOperandMode.FloatingScalar),
  floating_point_case(VMFLE_VF, fp_unit(RV5StageFloatUnit.Compare, ~comparison: RV5StageFloatComparison.LessEqual, ~signaling: #true), ~uses_vs1: #false, ~mask_destination: #true, ~operand: VectorOperandMode.FloatingScalar),
  floating_point_case(VMFGT_VF, fp_unit(RV5StageFloatUnit.Compare, ~comparison: RV5StageFloatComparison.Less, ~signaling: #true), ~uses_vs1: #false, ~mask_destination: #true, ~operand: VectorOperandMode.FloatingScalar, ~swap: #true),
  floating_point_case(VMFGE_VF, fp_unit(RV5StageFloatUnit.Compare, ~comparison: RV5StageFloatComparison.LessEqual, ~signaling: #true), ~uses_vs1: #false, ~mask_destination: #true, ~operand: VectorOperandMode.FloatingScalar, ~swap: #true),
  floating_point_case(VFMACC_VF, fp_unit(RV5StageFloatUnit.FusedMultiplyAdd, ~rounding: #true), ~uses_vs1: #false, ~operand: VectorOperandMode.FloatingScalar),
  floating_point_case(VFMADD_VF, fp_unit(RV5StageFloatUnit.FusedMultiplyAdd, ~rounding: #true), ~uses_vs1: #false, ~multiply_destination: #true, ~operand: VectorOperandMode.FloatingScalar),
  floating_point_case(VFMSAC_VF, fp_unit(RV5StageFloatUnit.FusedMultiplyAdd, ~rounding: #true, ~fused: MulAddOperation.MultiplySubtract), ~uses_vs1: #false, ~operand: VectorOperandMode.FloatingScalar),
  floating_point_case(VFMSUB_VF, fp_unit(RV5StageFloatUnit.FusedMultiplyAdd, ~rounding: #true, ~fused: MulAddOperation.MultiplySubtract), ~uses_vs1: #false, ~multiply_destination: #true, ~operand: VectorOperandMode.FloatingScalar),
  floating_point_case(VFNMACC_VF, fp_unit(RV5StageFloatUnit.FusedMultiplyAdd, ~rounding: #true, ~fused: MulAddOperation.NegatedMultiplySubtract), ~uses_vs1: #false, ~operand: VectorOperandMode.FloatingScalar),
  floating_point_case(VFNMADD_VF, fp_unit(RV5StageFloatUnit.FusedMultiplyAdd, ~rounding: #true, ~fused: MulAddOperation.NegatedMultiplySubtract), ~uses_vs1: #false, ~multiply_destination: #true, ~operand: VectorOperandMode.FloatingScalar),
  floating_point_case(VFNMSAC_VF, fp_unit(RV5StageFloatUnit.FusedMultiplyAdd, ~rounding: #true, ~fused: MulAddOperation.NegatedMultiplyAdd), ~uses_vs1: #false, ~operand: VectorOperandMode.FloatingScalar),
  floating_point_case(VFNMSUB_VF, fp_unit(RV5StageFloatUnit.FusedMultiplyAdd, ~rounding: #true, ~fused: MulAddOperation.NegatedMultiplyAdd), ~uses_vs1: #false, ~multiply_destination: #true, ~operand: VectorOperandMode.FloatingScalar),
  floating_point_case(VFREDUSUM_VS, fp_unit(RV5StageFloatUnit.Add, ~rounding: #true), ~reduction: #true),
  floating_point_case(VFREDOSUM_VS, fp_unit(RV5StageFloatUnit.Add, ~rounding: #true), ~reduction: #true),
  floating_point_case(VFREDMIN_VS, fp_unit(RV5StageFloatUnit.MinMax), ~reduction: #true),
  floating_point_case(VFREDMAX_VS, fp_unit(RV5StageFloatUnit.MinMax, ~minmax: MinMaxOperation.MaximumNumber), ~reduction: #true),
  floating_point_case(VFWADD_VV, fp_unit(RV5StageFloatUnit.Add, ~rounding: #true), ~widening: #true),
  floating_point_case(VFWADD_VF, fp_unit(RV5StageFloatUnit.Add, ~rounding: #true), ~uses_vs1: #false, ~operand: VectorOperandMode.FloatingScalar, ~widening: #true),
  floating_point_case(VFWADD_WV, fp_unit(RV5StageFloatUnit.Add, ~rounding: #true), ~widening: #true, ~wide_vs2: #true),
  floating_point_case(VFWADD_WF, fp_unit(RV5StageFloatUnit.Add, ~rounding: #true), ~uses_vs1: #false, ~operand: VectorOperandMode.FloatingScalar, ~widening: #true, ~wide_vs2: #true),
  floating_point_case(VFWSUB_VV, fp_unit(RV5StageFloatUnit.Add, ~rounding: #true, ~add: RV5StageFloatAddOperation.Subtract), ~widening: #true),
  floating_point_case(VFWSUB_VF, fp_unit(RV5StageFloatUnit.Add, ~rounding: #true, ~add: RV5StageFloatAddOperation.Subtract), ~uses_vs1: #false, ~operand: VectorOperandMode.FloatingScalar, ~widening: #true),
  floating_point_case(VFWSUB_WV, fp_unit(RV5StageFloatUnit.Add, ~rounding: #true, ~add: RV5StageFloatAddOperation.Subtract), ~widening: #true, ~wide_vs2: #true),
  floating_point_case(VFWSUB_WF, fp_unit(RV5StageFloatUnit.Add, ~rounding: #true, ~add: RV5StageFloatAddOperation.Subtract), ~uses_vs1: #false, ~operand: VectorOperandMode.FloatingScalar, ~widening: #true, ~wide_vs2: #true),
  floating_point_case(VFWMUL_VV, fp_unit(RV5StageFloatUnit.Multiply, ~rounding: #true), ~widening: #true),
  floating_point_case(VFWMUL_VF, fp_unit(RV5StageFloatUnit.Multiply, ~rounding: #true), ~uses_vs1: #false, ~operand: VectorOperandMode.FloatingScalar, ~widening: #true),
  floating_point_case(VFWMACC_VV, fp_unit(RV5StageFloatUnit.FusedMultiplyAdd, ~rounding: #true), ~widening: #true),
  floating_point_case(VFWMACC_VF, fp_unit(RV5StageFloatUnit.FusedMultiplyAdd, ~rounding: #true), ~uses_vs1: #false, ~operand: VectorOperandMode.FloatingScalar, ~widening: #true),
  floating_point_case(VFWNMACC_VV, fp_unit(RV5StageFloatUnit.FusedMultiplyAdd, ~rounding: #true, ~fused: MulAddOperation.NegatedMultiplySubtract), ~widening: #true),
  floating_point_case(VFWNMACC_VF, fp_unit(RV5StageFloatUnit.FusedMultiplyAdd, ~rounding: #true, ~fused: MulAddOperation.NegatedMultiplySubtract), ~uses_vs1: #false, ~operand: VectorOperandMode.FloatingScalar, ~widening: #true),
  floating_point_case(VFWMSAC_VV, fp_unit(RV5StageFloatUnit.FusedMultiplyAdd, ~rounding: #true, ~fused: MulAddOperation.MultiplySubtract), ~widening: #true),
  floating_point_case(VFWMSAC_VF, fp_unit(RV5StageFloatUnit.FusedMultiplyAdd, ~rounding: #true, ~fused: MulAddOperation.MultiplySubtract), ~uses_vs1: #false, ~operand: VectorOperandMode.FloatingScalar, ~widening: #true),
  floating_point_case(VFWNMSAC_VV, fp_unit(RV5StageFloatUnit.FusedMultiplyAdd, ~rounding: #true, ~fused: MulAddOperation.NegatedMultiplyAdd), ~widening: #true),
  floating_point_case(VFWNMSAC_VF, fp_unit(RV5StageFloatUnit.FusedMultiplyAdd, ~rounding: #true, ~fused: MulAddOperation.NegatedMultiplyAdd), ~uses_vs1: #false, ~operand: VectorOperandMode.FloatingScalar, ~widening: #true),
  floating_point_case(VFWREDUSUM_VS, fp_unit(RV5StageFloatUnit.Add, ~rounding: #true), ~reduction: #true, ~widening: #true),
  floating_point_case(VFWREDOSUM_VS, fp_unit(RV5StageFloatUnit.Add, ~rounding: #true), ~reduction: #true, ~widening: #true),
  floating_point_case(VFCVT_XU_F_V, fp_unit(RV5StageFloatUnit.Convert, ~rounding: #true, ~unsigned: #true), ~uses_vs1: #false, ~result: VectorFloatResult.Integer),
  floating_point_case(VFCVT_X_F_V, fp_unit(RV5StageFloatUnit.Convert, ~rounding: #true), ~uses_vs1: #false, ~result: VectorFloatResult.Integer),
  floating_point_case(VFCVT_F_XU_V, fp_unit(RV5StageFloatUnit.Convert, ~rounding: #true, ~unsigned: #true), ~uses_vs1: #false, ~source: VectorFloatSource.Integer),
  floating_point_case(VFCVT_F_X_V, fp_unit(RV5StageFloatUnit.Convert, ~rounding: #true), ~uses_vs1: #false, ~source: VectorFloatSource.Integer),
  floating_point_case(VFCVT_RTZ_XU_F_V, fp_unit(RV5StageFloatUnit.Convert, ~unsigned: #true), ~uses_vs1: #false, ~result: VectorFloatResult.Integer, ~rounding: VectorFloatRounding.TowardZero),
  floating_point_case(VFCVT_RTZ_X_F_V, fp_unit(RV5StageFloatUnit.Convert), ~uses_vs1: #false, ~result: VectorFloatResult.Integer, ~rounding: VectorFloatRounding.TowardZero),
  floating_point_case(VFWCVT_XU_F_V, fp_unit(RV5StageFloatUnit.Convert, ~rounding: #true, ~unsigned: #true), ~uses_vs1: #false, ~result: VectorFloatResult.Integer, ~widening: #true),
  floating_point_case(VFWCVT_X_F_V, fp_unit(RV5StageFloatUnit.Convert, ~rounding: #true), ~uses_vs1: #false, ~result: VectorFloatResult.Integer, ~widening: #true),
  floating_point_case(VFWCVT_F_XU_V, fp_unit(RV5StageFloatUnit.Convert, ~rounding: #true, ~unsigned: #true), ~uses_vs1: #false, ~source: VectorFloatSource.Integer, ~widening: #true, ~zvfh_e8: #true),
  floating_point_case(VFWCVT_F_X_V, fp_unit(RV5StageFloatUnit.Convert, ~rounding: #true), ~uses_vs1: #false, ~source: VectorFloatSource.Integer, ~widening: #true, ~zvfh_e8: #true),
  floating_point_case(VFWCVT_F_F_V, fp_unit(RV5StageFloatUnit.Convert, ~rounding: #true), ~uses_vs1: #false, ~widening: #true, ~zvfhmin_e16: #true),
  floating_point_case(VFWCVT_RTZ_XU_F_V, fp_unit(RV5StageFloatUnit.Convert, ~unsigned: #true), ~uses_vs1: #false, ~result: VectorFloatResult.Integer, ~rounding: VectorFloatRounding.TowardZero, ~widening: #true),
  floating_point_case(VFWCVT_RTZ_X_F_V, fp_unit(RV5StageFloatUnit.Convert), ~uses_vs1: #false, ~result: VectorFloatResult.Integer, ~rounding: VectorFloatRounding.TowardZero, ~widening: #true),
  floating_point_case(VFNCVT_XU_F_W, fp_unit(RV5StageFloatUnit.Convert, ~rounding: #true, ~unsigned: #true), ~uses_vs1: #false, ~result: VectorFloatResult.Integer, ~narrowing: #true, ~zvfh_e8: #true),
  floating_point_case(VFNCVT_X_F_W, fp_unit(RV5StageFloatUnit.Convert, ~rounding: #true), ~uses_vs1: #false, ~result: VectorFloatResult.Integer, ~narrowing: #true, ~zvfh_e8: #true),
  floating_point_case(VFNCVT_F_XU_W, fp_unit(RV5StageFloatUnit.Convert, ~rounding: #true, ~unsigned: #true), ~uses_vs1: #false, ~source: VectorFloatSource.Integer, ~narrowing: #true),
  floating_point_case(VFNCVT_F_X_W, fp_unit(RV5StageFloatUnit.Convert, ~rounding: #true), ~uses_vs1: #false, ~source: VectorFloatSource.Integer, ~narrowing: #true),
  floating_point_case(VFNCVT_F_F_W, fp_unit(RV5StageFloatUnit.Convert, ~rounding: #true), ~uses_vs1: #false, ~narrowing: #true, ~zvfhmin_e16: #true),
  floating_point_case(VFNCVT_ROD_F_F_W, fp_unit(RV5StageFloatUnit.Convert), ~uses_vs1: #false, ~rounding: VectorFloatRounding.RoundToOdd, ~narrowing: #true),
  floating_point_case(VFNCVT_RTZ_XU_F_W, fp_unit(RV5StageFloatUnit.Convert, ~unsigned: #true), ~uses_vs1: #false, ~result: VectorFloatResult.Integer, ~rounding: VectorFloatRounding.TowardZero, ~narrowing: #true, ~zvfh_e8: #true),
  floating_point_case(VFNCVT_RTZ_X_F_W, fp_unit(RV5StageFloatUnit.Convert), ~uses_vs1: #false, ~result: VectorFloatResult.Integer, ~rounding: VectorFloatRounding.TowardZero, ~narrowing: #true, ~zvfh_e8: #true)
]
fun floating_move_case(instruction :: InstructionSpec,
                       ~mask_select: mask_select :: Boolean = #false,
                       ~element_move: element_move :: Boolean = #false,
                       ~floating_scalar_destination: floating_scalar_destination :: Boolean = #false,
                       ~slide: slide :: Boolean = #false,
                       ~slide_up: slide_up :: Boolean = #false,
                       ~uses_vs2: uses_vs2 :: Boolean = #true):
  DecodeCase(
    instruction_pattern(instruction),
    partial_pattern(RV5StageVectorControl()):
      configure: VectorConfigMode.None
      integer: Bool(#false)
      floating_point: Bool(#true)
      fp_service: Bool(#false)
      fp_zvfhmin_e16: Bool(#false)
      fp_zvfh_e8: Bool(#false)
      multiply_divide: Bool(#false)
      memory: Bool(#false)
      operand: if floating_scalar_destination | VectorOperandMode.Vector | VectorOperandMode.FloatingScalar
      fp_uses_vs1: Bool(#false)
      mask_select: Bool(mask_select)
      element_move: Bool(element_move)
      floating_scalar_destination: Bool(floating_scalar_destination)
      slide: Bool(slide)
      slide_up: Bool(slide_up)
      slide_one: Bool(slide)
      uses_vs2: Bool(uses_vs2)
      alu: if slide | vslide_control | vselect_control
  )
def VectorFloatingPointMoveCases = [
  floating_move_case(VFMERGE_VFM, ~mask_select: #true),
  floating_move_case(VFMV_V_F, ~uses_vs2: #false),
  floating_move_case(VFMV_F_S, ~element_move: #true, ~floating_scalar_destination: #true),
  floating_move_case(VFMV_S_F, ~element_move: #true, ~uses_vs2: #false),
  floating_move_case(VFSLIDE1UP_VF, ~slide: #true, ~slide_up: #true),
  floating_move_case(VFSLIDE1DOWN_VF, ~slide: #true)
]
def VectorDivideCases = for List (instruction in VectorDivideInstructions):
  def signed_left = [VMULH_VV, VMULH_VX, VMULHSU_VV, VMULHSU_VX, VDIV_VV, VDIV_VX, VREM_VV, VREM_VX].contains(instruction)
  def signed_right = [VMULH_VV, VMULH_VX, VDIV_VV, VDIV_VX, VREM_VV, VREM_VX].contains(instruction)
  DecodeCase(
    instruction_pattern(instruction),
    partial_pattern(RV5StageVectorControl()):
      configure: VectorConfigMode.None
      integer: Bool(#false)
      floating_point: Bool(#false)
      multiply_divide: Bool(#true)
      memory: Bool(#false)
      operand: if instruction.format == VectorVXFormat | VectorOperandMode.Scalar | VectorOperandMode.Vector
      divide: Bool(#true)
      multiply_accumulate: Bool(#false)
      left_signed: Bool(signed_left)
      right_signed: Bool(signed_right)
      remainder: Bool([VREM_VV, VREM_VX, VREMU_VV, VREMU_VX].contains(instruction))
  )
def VectorMultiplyCases = for List (instruction in VectorMultiplyInstructions ++ VectorFractionalMultiplyInstructions ++ VectorWideningMultiplyInstructions ++ VectorMultiplyAccumulateInstructions ++ VectorWideningMultiplyAccumulateInstructions):
  def fractional = VectorFractionalMultiplyInstructions.contains(instruction)
  def widened = (VectorWideningMultiplyInstructions ++ VectorWideningMultiplyAccumulateInstructions).contains(instruction)
  def accumulate = (VectorMultiplyAccumulateInstructions ++ VectorWideningMultiplyAccumulateInstructions).contains(instruction)
  def signed_left = fractional || [VMULH_VV, VMULH_VX, VMULHSU_VV, VMULHSU_VX, VWMULSU_VV, VWMULSU_VX, VWMUL_VV, VWMUL_VX, VWMACC_VV, VWMACC_VX, VWMACCSU_VV, VWMACCSU_VX].contains(instruction)
  def signed_right = fractional || [VMULH_VV, VMULH_VX, VWMUL_VV, VWMUL_VX, VWMACC_VV, VWMACC_VX, VWMACCUS_VX].contains(instruction)
  DecodeCase(
    instruction_pattern(instruction),
    partial_pattern(RV5StageVectorControl()):
      configure: VectorConfigMode.None
      integer: Bool(#false)
      floating_point: Bool(#false)
      multiply_divide: Bool(#true)
      memory: Bool(#false)
      operand: if instruction.format == VectorVXFormat | VectorOperandMode.Scalar | VectorOperandMode.Vector
      divide: Bool(#false)
      left_signed: if accumulate && !widened | pattern(Bool, _) | Bool(signed_left)
      right_signed: if accumulate && !widened | pattern(Bool, _) | Bool(signed_right)
      widening: Bool(widened)
      multiply_accumulate: Bool(accumulate)
      multiply_destination: if accumulate | Bool([VMADD_VV, VMADD_VX, VNMSUB_VV, VNMSUB_VX].contains(instruction)) | pattern(Bool, _)
      multiply_subtract: if accumulate | Bool([VNMSAC_VV, VNMSAC_VX, VNMSUB_VV, VNMSUB_VX].contains(instruction)) | pattern(Bool, _)
      multiply_result: if accumulate | pattern(VectorMultiplyResult, _) | (if fractional | VectorMultiplyResult.Fractional | (if widened | VectorMultiplyResult.Widened | (if [VMUL_VV, VMUL_VX].contains(instruction) | VectorMultiplyResult.Low | VectorMultiplyResult.High)))
  )
def VectorMultiplyDivideCases = VectorDivideCases ++ VectorMultiplyCases
def VectorControlCases = VectorConfigurationCases ++ VectorIntegerCases ++ VectorSlideCases ++ VectorGatherCases ++ VectorCompressCases ++ VectorMoveMergeCases ++ VectorWholeRegisterMoveCases ++ VectorMaskLogicCases ++ VectorElementMoveCases ++ VectorMaskScanCases ++ VectorIntegerReductionCases ++ VectorMemoryCases ++ VectorFloatingPointCases ++ VectorFloatingPointMoveCases ++ VectorMultiplyDivideCases

fun vector_configuration_request(xlen :: XLen, mode :: VectorConfigMode, instruction :: Bits(32), scalar1 :: Bits(xlen.width), scalar2 :: Bits(xlen.width)) :~ RiscvVectorConfigRequest(xlen):
  def immediate_avl = mode === VectorConfigMode.AllImmediate
  def source_zero = !instruction_field(vs1, instruction).or_reduce()
  def destination_zero = !instruction_field(vd, instruction).or_reduce()
  RiscvVectorConfigRequest(xlen):
    vtype: mux(mode === VectorConfigMode.VtypeRegister, scalar2, mux(immediate_avl, instruction_field(vtype10, instruction).zext(xlen.width), instruction_field(vtype11, instruction).zext(xlen.width)))
    avl: mux(immediate_avl, instruction_field(avl5, instruction).zext(xlen.width), scalar1)
    maximum: !immediate_avl & source_zero & !destination_zero
    keep_vl: !immediate_avl & source_zero & destination_zero

// Runtime legality covers equal-width groups, widening overlap, and memory EMUL.
circuit RV5StageVectorLegality(xlen :: XLen, vlen :: VectorLength, profile :: VectorProfile = VectorProfile.V, extensions :: List.of(VectorExtension) = DefaultVectorExtensions):
  input instruction: Bits(32)
  input control: RV5StageVectorControl()
  input vtype: Bits(xlen.width)
  input vstart: Bits(xlen.width)
  output legal: Bool
  validate_vector_extensions(profile, extensions)
  def config = vector_type(xlen, vlen, vtype, ~elen: vector_profile_elen(profile))
  def elen = bits(if vector_profile_supports_integer64(profile) | 3 | 2, 2)
  def whole_register_memory = control.memory & (control.memory_mode === VectorMemoryMode.WholeRegister)
  def mask_memory = control.memory & (control.memory_mode === VectorMemoryMode.Mask)
  def indexed_memory = control.memory_addressing.is_one_of(VectorMemoryAddressing.IndexedUnordered, VectorMemoryAddressing.IndexedOrdered)
  def segmented_memory = control.memory & control.memory_nf.or_reduce()
  // LMUL is a signed power-of-two exponent; EMUL = LMUL * EEW / SEW.
  // Indexed memory uses SEW/LMUL for data and the encoded EEW for offsets.
  def data_eew = mux(indexed_memory, config.sew, control.memory_data_eew)
  def emul = config.lmul.into(SInt(3)).sext(5) + data_eew.zext(5).into(SInt(5)) - config.sew.zext(5).into(SInt(5))
  def memory_index_emul = config.lmul.into(SInt(3)).sext(5) + control.memory_index_eew.zext(5).into(SInt(5)) - config.sew.zext(5).into(SInt(5))
  def widening_emul = config.lmul.into(SInt(3)).sext(5) + SInt(5)(1)
  def widening = (control.integer ||| control.fp_service ||| control.multiply_divide) & control.widening
  def narrowing = control.integer & control.narrowing
  def fp_widening = control.fp_service & control.widening
  def fp_narrowing = control.fp_service & control.narrowing
  def extension = control.integer & control.extension
  def whole_register_move = control.integer & control.whole_register_move
  def extension_power = control.extension_ratio.as_bits().zext(5) + bits(1, 5)
  def extension_emul = config.lmul.into(SInt(3)).sext(5) - extension_power.into(SInt(5))
  def extension_group = extension_emul.into(Bits(5))[0..3]
  def extension_group_mask = mux_lookup(extension_group, ~default: bits(0, 5), [[1, bits(1, 5)], [2, bits(3, 5)], [3, bits(7, 5)]])
  def group = mux(control.memory, emul.into(Bits(5))[0..3], config.lmul)
  def group_mask = mux_lookup(group, ~default: bits(0, 5), [[1, bits(1, 5)], [2, bits(3, 5)], [3, bits(7, 5)]])
  def memory_group_shift = mux(emul < SInt(5)(0), bits(0, 3), emul.into(Bits(5))[0..3])
  def memory_fields = control.memory_nf.zext(4) + bits(1, 4)
  def memory_register_count = memory_fields.zext(7) << memory_group_shift
  def memory_index_group = memory_index_emul.into(Bits(5))[0..3]
  def memory_index_group_mask = mux_lookup(memory_index_group, ~default: bits(0, 5), [[1, bits(1, 5)], [2, bits(3, 5)], [3, bits(7, 5)]])
  def wide_group_mask = mux_lookup(widening_emul.into(Bits(5))[0..3], ~default: bits(0, 5), [[1, bits(1, 5)], [2, bits(3, 5)], [3, bits(7, 5)]])
  def destination_group = mux(widening, widening_emul.into(Bits(5))[0..3], group)
  def destination_group_mask = mux_lookup(destination_group, ~default: bits(0, 5), [[1, bits(1, 5)], [2, bits(3, 5)], [3, bits(7, 5)]])
  def destination = instruction_field(vd, instruction)
  def source1 = instruction_field(vs1, instruction)
  def source2 = instruction_field(vs2, instruction)
  def vector_operand = control.operand === VectorOperandMode.Vector
  def destination_aligned = !(destination & destination_group_mask).or_reduce()
  def source1_aligned = !(source1 & group_mask).or_reduce()
  def source2_aligned = !(source2 & group_mask).or_reduce()
  def whole_register_mask = (control.whole_register_count - bits(1, 4)).zext(5)
  def whole_register_destination_end = destination.zext(7) + control.whole_register_count.zext(7)
  def whole_register_source_end = source2.zext(7) + control.whole_register_count.zext(7)
  def whole_register_shift = mux_lookup(control.whole_register_count, ~default: bits(0, 2), [[2, bits(1, 2)], [4, bits(2, 2)], [8, bits(3, 2)]])
  def whole_register_limit = (bits(vlen / 8, index_width(vlen + 1)) >> config.sew) << whole_register_shift
  def whole_register_move_legal = control.whole_register_count.is_one_of(bits(1, 4), bits(2, 4), bits(4, 4), bits(8, 4)) & !(destination & whole_register_mask).or_reduce() & !(source2 & whole_register_mask).or_reduce() & (whole_register_destination_end <= bits(32, 7)) & (whole_register_source_end <= bits(32, 7)) & (vstart < whole_register_limit.zext(xlen.width))
  def memory_index_aligned = !(source2 & memory_index_group_mask).or_reduce()
  def wide_source2_aligned = !(source2 & wide_group_mask).or_reduce()
  fun mask_overlap_legal(source :: Bits(5)) :: Bool:
    ((destination & !group_mask) =/= source) ||| (destination === source)
  fun widening_overlap_legal(source :: Bits(5)) :: Bool:
    def source_end = source.zext(6) + group_mask.zext(6) + bits(1, 6)
    def widened_end = destination.zext(6) + destination_group_mask.zext(6) + bits(1, 6)
    def disjoint = (destination.zext(6) >= source_end) ||| (source.zext(6) >= widened_end)
    disjoint ||| ((config.lmul.into(SInt(3)) >= SInt(3)(0)) & (source_end === widened_end))
  fun narrowing_overlap_legal() :: Bool:
    def source_end = source2.zext(6) + wide_group_mask.zext(6) + bits(1, 6)
    def destination_end = destination.zext(6) + group_mask.zext(6) + bits(1, 6)
    def disjoint = (destination.zext(6) >= source_end) ||| (source2.zext(6) >= destination_end)
    disjoint ||| (destination === source2)
  def masked = !instruction_field(vm, instruction).or_reduce()
  // Merge reads v0 at EEW=1; the same register cannot also supply SEW data.
  def merge_sources_legal = !control.mask_select ||| (source2.or_reduce() & (!vector_operand ||| source1.or_reduce()))
  // Carry-in uses v0 as EEW=1 data, so the same register cannot also supply a
  // SEW-wide source operand in that instruction.
  def carry_sources_legal = !control.carry_input ||| (source2.or_reduce() & (!vector_operand ||| source1.or_reduce()))
  def reduction_source2_end = source2.zext(6) + group_mask.zext(6) + bits(1, 6)
  def reduction_sources_disjoint = (source1.zext(6) < source2.zext(6)) ||| (source1.zext(6) >= reduction_source2_end)
  def widening_reduction_legal = !widening ||| ((config.sew < elen) & reduction_sources_disjoint)
  def reduction_sources_legal = source2_aligned & widening_reduction_legal & (!masked ||| (source1.or_reduce() & source2.or_reduce()))
  def scan_mask = control.scan_control.result === VectorScanResult.Mask
  def scan_overlap = mux(scan_mask, destination === source2, (source2 & !group_mask) === destination)
  def scan_legal = control.scalar_destination ||| ((!masked ||| destination.or_reduce()) & mux(scan_mask, destination =/= source2, destination_aligned & (control.scan_control.index ||| !scan_overlap)))
  // Aligned equal-size groups overlap exactly when their base registers match.
  def slide_overlap_legal = !control.slide ||| ((!control.slide_up ||| (destination =/= source2)) & (!masked ||| source2.or_reduce()))
  // Gather's index group may have a different EEW/EMUL. Compare physical
  // register intervals before issuing any read, even for an empty body.
  def index_emul = config.lmul.into(SInt(3)).sext(5) + SInt(5)(1) - config.sew.zext(5).into(SInt(5))
  def index_group = mux(control.gather_index16, index_emul.into(Bits(5))[0..3], config.lmul)
  def index_mask = mux_lookup(index_group, ~default: bits(0, 5), [[1, bits(1, 5)], [2, bits(3, 5)], [3, bits(7, 5)]])
  def index_end = source1.zext(6) + index_mask.zext(6) + bits(1, 6)
  def data_end = source2.zext(6) + group_mask.zext(6) + bits(1, 6)
  def destination_end = destination.zext(6) + destination_group_mask.zext(6) + bits(1, 6)
  def index_disjoint = (destination.zext(6) >= index_end) ||| (source1.zext(6) >= destination_end)
  def sources_disjoint = (source2.zext(6) >= index_end) ||| (source1.zext(6) >= data_end)
  def gather_legal = destination_aligned & source2_aligned & (destination =/= source2) & (!masked ||| (destination.or_reduce() & source2.or_reduce())) & (!vector_operand ||| (
    !(source1 & index_mask).or_reduce() & index_disjoint & (!masked ||| source1.or_reduce()) & (!control.gather_index16 ||| ((index_emul >= SInt(5)(-3)) & (index_emul <= SInt(5)(3)) & ((config.sew === bits(1, 2)) ||| sources_disjoint)))
  ))
  def compress_mask_disjoint = ((source1.zext(6) < destination.zext(6)) ||| (source1.zext(6) >= destination_end)) & ((source1.zext(6) < source2.zext(6)) ||| (source1.zext(6) >= data_end))
  def compress_legal = destination_aligned & source2_aligned & (destination =/= source2) & compress_mask_disjoint
  def narrow_source2_legal = source2_aligned & widening_overlap_legal(source2)
  def wide_source2_legal = wide_source2_aligned
  def widening_legal = !widening ||| ((config.sew < elen) & (widening_emul <= SInt(5)(3)) & mux(control.wide_vs2, wide_source2_legal, narrow_source2_legal) & (!vector_operand ||| widening_overlap_legal(source1)))
  def source1_end = source1.zext(6) + group_mask.zext(6) + bits(1, 6)
  def wide_source2_end = source2.zext(6) + wide_group_mask.zext(6) + bits(1, 6)
  def narrowing_sources_disjoint = !vector_operand ||| (source1.zext(6) >= wide_source2_end) ||| (source2.zext(6) >= source1_end)
  def narrowing_legal = !narrowing ||| ((config.sew < elen) & (widening_emul <= SInt(5)(3)) & wide_source2_aligned & (!vector_operand ||| source1_aligned) & narrowing_overlap_legal() & narrowing_sources_disjoint & (!masked ||| (source2.or_reduce() & (!vector_operand ||| source1.or_reduce()))))
  def extension_source_aligned = !(source2 & extension_group_mask).or_reduce()
  def extension_source_end = source2.zext(6) + extension_group_mask.zext(6) + bits(1, 6)
  def extension_destination_end = destination.zext(6) + destination_group_mask.zext(6) + bits(1, 6)
  def extension_disjoint = (destination.zext(6) >= extension_source_end) ||| (source2.zext(6) >= extension_destination_end)
  def extension_overlap_legal = extension_disjoint ||| ((extension_emul >= SInt(5)(0)) & (extension_source_end === extension_destination_end))
  def extension_width_legal = config.sew.zext(5) >= extension_power
  def extension_legal = extension_width_legal & (extension_emul >= SInt(5)(-3)) & extension_source_aligned & destination_aligned & extension_overlap_legal & (!masked ||| (source2.or_reduce() & destination.or_reduce()))
  // Mask logic always names single registers, regardless of the data LMUL.
  def integer_legal = control.integer & mux(whole_register_move, whole_register_move_legal, mux(extension, extension_legal, mux(control.compress, compress_legal, mux(control.gather, gather_legal, mux(control.scan, scan_legal, control.element_move ||| mux(control.reduction, reduction_sources_legal, control.mask_logic ||| (
    slide_overlap_legal & merge_sources_legal & carry_sources_legal & widening_legal & narrowing_legal & (!control.uses_vs2 ||| mux((widening ||| narrowing) & control.wide_vs2, wide_source2_aligned, source2_aligned)) & (!vector_operand ||| source1_aligned) & mux(control.mask_destination, mask_overlap_legal(source2) & (!vector_operand ||| mask_overlap_legal(source1)), destination_aligned & !(masked & !destination.or_reduce()))
  )))))))
  def memory_data_register_count = mux(segmented_memory, memory_register_count, group_mask.zext(7) + bits(1, 7))
  def memory_data_end = destination.zext(7) + memory_data_register_count
  def memory_index_end = source2.zext(7) + memory_index_group_mask.zext(7) + bits(1, 7)
  def memory_groups_disjoint = (destination.zext(7) >= memory_index_end) ||| (source2.zext(7) >= memory_data_end)
  // Indexed loads require disjoint index/destination groups in this initial
