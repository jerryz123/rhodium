  integer_case(VWADD_WV, vadd_control, ~widening: #true, ~wide_vs2: #true, ~left_signed: #true, ~right_signed: #true),
  integer_case(VWADD_WX, vadd_control, ~widening: #true, ~wide_vs2: #true, ~left_signed: #true, ~right_signed: #true),
  integer_case(VWSUBU_WV, vsub_control, ~widening: #true, ~wide_vs2: #true),
