  arithmetic_shift: Bool(#false)
  rotate: Bool(#true)
def VectorSlideCases = [
  integer_case(VSLIDEUP_VX, vslide_control, ~slide: #true, ~slide_up: #true),
  integer_case(VSLIDEUP_VI, vslide_control, ~slide: #true, ~slide_up: #true),
  integer_case(VSLIDEDOWN_VX, vslide_control, ~slide: #true),
  integer_case(VSLIDEDOWN_VI, vslide_control, ~slide: #true),
  integer_case(VSLIDE1UP_VX, vslide_control, ~slide: #true, ~slide_up: #true, ~slide_one: #true),
  integer_case(VSLIDE1DOWN_VX, vslide_control, ~slide: #true, ~slide_one: #true)
]
