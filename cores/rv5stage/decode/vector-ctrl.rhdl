  // may alias only when both operands use the same EEW.
  def indexed_overlap_legal = mux(control.store, (control.memory_index_eew === config.sew) ||| memory_groups_disjoint, memory_groups_disjoint)
  def indexed_memory_legal = !indexed_memory ||| ((memory_index_emul >= SInt(5)(-3)) & (memory_index_emul <= SInt(5)(3)) & memory_index_aligned & indexed_overlap_legal & (!masked ||| source2.or_reduce()))
  def segment_memory_legal = !segmented_memory ||| ((memory_register_count <= bits(8, 7)) & (memory_data_end <= bits(32, 7)))
  def memory_eew_legal = (indexed_memory ||| (control.memory_data_eew <= elen)) & (!indexed_memory ||| (control.memory_index_eew <= elen))
  def ordinary_memory_legal = control.memory & !whole_register_memory & !mask_memory & Bool(xlen == XLen.X64) & memory_eew_legal & (emul >= SInt(5)(-3)) & (emul <= SInt(5)(3)) & destination_aligned & indexed_memory_legal & segment_memory_legal & (control.store ||| !(masked & !destination.or_reduce())) & (!control.store ||| !masked ||| destination.or_reduce())
  def mask_memory_legal = mask_memory & Bool(xlen == XLen.X64)
  def whole_register_count = control.memory_nf.zext(7) + bits(1, 7)
  def whole_register_end = destination.zext(7) + whole_register_count
  def whole_register_legal = whole_register_memory & Bool(xlen == XLen.X64) & (control.memory_data_eew <= elen) & control.memory_nf.is_one_of(bits(0, 3), bits(1, 3), bits(3, 3), bits(7, 3)) & !(destination & control.memory_nf.zext(5)).or_reduce() & (whole_register_end <= bits(32, 7))
  def fp_width_change = fp_widening ||| fp_narrowing
  def fp_reduction = control.floating_point & control.reduction
  def fp_sources_legal = mux(fp_reduction, reduction_sources_legal, mux(fp_narrowing ||| (fp_widening & control.wide_vs2), wide_source2_aligned, source2_aligned) & (!control.fp_uses_vs1 ||| source1_aligned))
  def fp_destination_legal = fp_reduction ||| mux(control.mask_destination, mask_overlap_legal(source2) & (!control.fp_uses_vs1 ||| mask_overlap_legal(source1)), destination_aligned & !(masked & !destination.or_reduce()))
  def fp_widening_overlap_legal = mux(control.wide_vs2, Bool(#true), widening_overlap_legal(source2)) & (!control.fp_uses_vs1 ||| widening_overlap_legal(source1))
  def fp_zvfhmin = Bool(vector_extensions_support_zvfhmin(extensions))
  def fp_zvfh = Bool(vector_extensions_support_zvfh(extensions))
  def fp_e8_legal = (config.sew === bits(0, 2)) & control.fp_zvfh_e8 & fp_zvfh
  def fp_e16_legal = (config.sew === bits(1, 2)) & (fp_zvfh ||| (control.fp_zvfhmin_e16 & fp_zvfhmin))
  def fp_width_change_profile_legal = mux_lookup(config.sew, ~default: Bool(vector_profile_supports_fp64(profile)), [[0, fp_e8_legal], [1, fp_e16_legal]])
  def fp_width_change_legal = fp_reduction ||| !fp_width_change ||| ((config.sew <= bits(2, 2)) & (widening_emul <= SInt(5)(3)) & mux(fp_widening, fp_widening_overlap_legal, narrowing_overlap_legal()))
  def fp_move_sources_legal = (!control.uses_vs2 ||| source2_aligned) & (!control.slide ||| slide_overlap_legal)
  def fp_move_destination_legal = control.floating_scalar_destination ||| control.element_move ||| (destination_aligned & !(masked & !destination.or_reduce()))
  def fp_service_legal = !(fp_widening & fp_narrowing) & (!fp_width_change ||| fp_width_change_profile_legal) & fp_sources_legal & fp_destination_legal & fp_width_change_legal
  def fp_move_legal = fp_move_sources_legal & fp_move_destination_legal & (!control.mask_select ||| merge_sources_legal)
  def fp_width_legal = Bool(vector_profile_supports_fp32(profile)) & (fp_e8_legal ||| fp_e16_legal ||| mux(Bool(vector_profile_supports_fp64(profile)), config.sew >= bits(2, 2), config.sew === bits(2, 2)))
  def fp_legal = control.floating_point & Bool(xlen == XLen.X64) & fp_width_legal & mux(control.fp_service, fp_service_legal, fp_move_legal)
