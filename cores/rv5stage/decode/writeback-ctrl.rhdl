#lang rhodium
// Defines base and extension architectural writeback and result-source controls.

import:
  "../../../riscv/isa/zawrs.rhm" open
  "../../../riscv/isa/zicboz.rhm" open
  "../../../riscv/isa/zicbom.rhm" open
  "decode-support.rhdl" open
  "../../../riscv/isa/rv32i.rhm" as rv32
  "../../../riscv/isa/rv64i.rhm" open
  "../../../riscv/isa/m.rhm" open
  "../../../riscv/isa/a.rhm" open
  "../../../riscv/isa/b.rhm" open
  "../../../riscv/isa/zicond.rhm" open
  "../../../riscv/isa/zmmul.rhm" open
  "../../../riscv/isa/zicsr.rhm" open
  "../../../riscv/isa/zifencei.rhm" open
  "../../../riscv/isa/zimop.rhm" open
  "../../../riscv/isa/privileged.rhm" open
  lib("rhodium/std/decode.rhdl") open

hardware_enum WritebackSelect:
  Alu
  Memory
  SequentialPc
  Multiply
  Divide
  Csr
  Zero

bundle WritebackControl():
  enable: Bool
  source: WritebackSelect

def alu_writeback = pattern(WritebackControl()):
  enable: Bool(#true)
  source: WritebackSelect.Alu
def memory_writeback = pattern(WritebackControl()):
  enable: Bool(#true)
  source: WritebackSelect.Memory
def link_writeback = pattern(WritebackControl()):
  enable: Bool(#true)
  source: WritebackSelect.SequentialPc
def multiply_writeback = pattern(WritebackControl()):
  enable: Bool(#true)
  source: WritebackSelect.Multiply
def divide_writeback = pattern(WritebackControl()):
  enable: Bool(#true)
  source: WritebackSelect.Divide
def csr_writeback = pattern(WritebackControl()):
  enable: Bool(#true)
  source: WritebackSelect.Csr
def zero_writeback = pattern(WritebackControl()):
  enable: Bool(#true)
  source: WritebackSelect.Zero
def no_writeback = partial_pattern(WritebackControl()):
  enable: Bool(#false)

def shared_immediate_alu = [ADDI, SLTI, SLTIU, XORI, ORI, ANDI]
def shared_register_alu = [ADD, SUB, SLL, SLT, SLTU, XOR, SRL, SRA, OR, AND]
def shared_loads = [LB, LH, LW, LBU, LHU]
def link_instructions = [JAL, JALR]
fun writeback_cases(instructions :: List.of(InstructionSpec),
                    alu_instructions :: List.of(InstructionSpec),
                    load_instructions :: List.of(InstructionSpec)):
  def writing_instructions = alu_instructions ++ load_instructions ++ link_instructions
  combine_case_groups([
    instruction_cases(alu_instructions, alu_writeback),
    instruction_cases(load_instructions, memory_writeback),
    instruction_cases(link_instructions, link_writeback),
    instruction_cases(excluding_instructions(instructions, writing_instructions), no_writeback)
  ])

def RV32IWritebackCases = writeback_cases(
  rv32.RV32IInstructions,
  [LUI, AUIPC] ++ shared_immediate_alu ++ [rv32.SLLI, rv32.SRLI, rv32.SRAI] ++ shared_register_alu,
  shared_loads
)
def RV64IWritebackCases = writeback_cases(
  RV64IInstructions,
  [LUI, AUIPC] ++ shared_immediate_alu ++ [SLLI, SRLI, SRAI, ADDIW, SLLIW, SRLIW, SRAIW] ++ shared_register_alu ++ [ADDW, SUBW, SLLW, SRLW, SRAW],
  shared_loads ++ [LWU, LD]
)
def RV5StageSystemWritebackCases = instruction_cases(
  ZicsrInstructions,
  csr_writeback
) ++ instruction_cases(PrivilegedInstructions ++ ZifenceiInstructions, no_writeback)
def RV32RV5StageWritebackCases = RV32IWritebackCases ++ instruction_cases(
  RV32AInstructions,
  memory_writeback
) ++ instruction_cases(
  RV32ZmmulInstructions,
  multiply_writeback
) ++ instruction_cases(
  RV32MDivideInstructions,
  divide_writeback
) ++ instruction_cases(RV32BInstructions ++ ZicondInstructions, alu_writeback) ++ instruction_cases(
  ZimopInstructions,
  zero_writeback
) ++ RV5StageSystemWritebackCases
def RV64RV5StageWritebackCases = RV64IWritebackCases ++ instruction_cases(
  RV64AInstructions,
  memory_writeback
) ++ instruction_cases(
  RV64ZmmulInstructions,
  multiply_writeback
) ++ instruction_cases(
  RV64MDivideInstructions,
  divide_writeback
) ++ instruction_cases(RV64BInstructions ++ ZicondInstructions, alu_writeback) ++ instruction_cases(
  ZimopInstructions,
  zero_writeback
) ++ RV5StageSystemWritebackCases
def RV32IWritebackDecode = ValidDecodeGen(RV32IWritebackCases)
def RV64IWritebackDecode = ValidDecodeGen(RV64IWritebackCases)

def ZicbozWritebackCases = instruction_cases(ZicbozInstructions, no_writeback)
def ZicbomWritebackCases = instruction_cases(ZicbomInstructions, no_writeback)

def ZawrsWritebackCases = instruction_cases(ZawrsInstructions, no_writeback)

export:
  ZawrsWritebackCases
  ZicbomWritebackCases
  ZicbozWritebackCases
  WritebackSelect
  WritebackControl
  RV32IWritebackCases
  RV64IWritebackCases
  RV32RV5StageWritebackCases
  RV64RV5StageWritebackCases
  RV32IWritebackDecode
  RV64IWritebackDecode
