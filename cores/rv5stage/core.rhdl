#lang rhodium
// Implements RV5Stage's five-stage core with EX-issued load hits and ordered side effects.
// SPDX-License-Identifier: Apache-2.0

import:
  "fetch/bpd/protocol.rhdl" open
  "fetch/bpd/ras.rhdl" open
  "../alu.rhdl" open
  "../branch-resolver.rhdl" open
  "../load-store.rhdl" open
  "../cache-prefetch.rhdl" open
  "memory.rhdl" open
  "memory-arbiter.rhdl" open
  "mmu/protocol.rhdl" open
  "decode/core-ctrl.rhdl" open
  "decode/vector-ctrl.rhdl" open
  "vector/bundles.rhdl" open
  "vector/precheck.rhdl" open
  "vector.rhdl" open
  "../../riscv/isa/vector.rhm" open
  "../../riscv/isa/vector-profile.rhm" open
  "../../riscv/isa/csr.rhm".MstatusTW
  "../../riscv/rtl/csr.rhdl".csr_flag
  "../../riscv/rtl/vector.rhdl" open
  "../../riscv/rtl/zihintntl.rhdl" open
  "decode/operand-ctrl.rhdl" open
  "decode/branch-ctrl.rhdl" open
  "../riscv/branch-decode.rhdl" open
  "decode/mem-ctrl.rhdl" open
  "decode/fence-ctrl.rhdl" open
  "decode/hint-ctrl.rhdl" open
  "decode/system-ctrl.rhdl" open
  "decode/writeback-ctrl.rhdl" open
  "bundles.rhdl" open
  "csr.rhdl" open
  "profile.rhm".RV5StageConfig
  "profile.rhm".RV5StageMultiplierKind
  "profile.rhm".rv5stage_execution_half_precision
  "../../riscv/rtl/interrupt.rhdl" open
  "multiply.rhdl" open
  "integer-execution.rhdl" open
  "writeback-calendar.rhdl" open
  "vector/muldiv.rhdl" open
  "../multiplier.rhdl" open
  "../divider.rhdl" open
  "divide.rhdl" open
  "fp/pipeline.rhdl" open
  "fp/register-file.rhdl".FloatingPointRegisterWrite
  "fp/execute.rhdl" open
  lib("hardfloat/main.rhdl").RoundingMode
  "fp/bundles.rhdl" open
  "fetch/protocol.rhdl" open
  "fetch/packet.rhdl" open
  "fetch/instruction-buffer.rhdl" open
  "decode/fp-ctrl.rhdl" open
  "register-file.rhdl" open
  "dcache/protocol.rhdl" open
  "../../riscv/isa/c.rhm" open
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/isa/fp-profile.rhm" open
  "../../riscv/isa/trap.rhm" open
  "../../riscv/rtl/trap.rhdl" open
  "../../riscv/rtl/cmo.rhdl" open
  "../../riscv/rtl/pointer-masking.rhdl" open
  "../../riscv/model/formats.rhm" as riscv_fields
  "../../riscv/rtl/instruction-fields.rhdl" open
  "../../riscv/rtl/floating-point.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open
  lib("rhodium/std/scoreboard.rhdl") open

sync_circuit RV5StageCore(core_profile :: RV5StageConfig, ~reset_address: reset_address :: Nat):
  def xlen = core_profile.xlen
  def extensions = core_profile.extensions
  def profile = extensions.floating_point
  def half_precision = extensions.half_precision
  def vector_extensions = core_profile.vector_extensions
  def execution_half_precision = rv5stage_execution_half_precision(half_precision, vector_extensions)
  def zfa_enabled = extensions.zfa
  def zicbop_enabled = extensions.zicbop
  def zicboz_enabled = extensions.zicboz
  def zicbom_enabled = extensions.zicbom
  def zawrs_enabled = extensions.zawrs
  def zihintpause_enabled = extensions.zihintpause
  def zihintntl_enabled = extensions.zihintntl
  def compressed_extensions = extensions.compressed
  def width = xlen.width
  def vector_completion_slots = core_profile.vector_completion_slots
  def vector_enabled = vector_profile_enabled(core_profile.vector)
  def vector_length = core_profile.vector_length
  def vector_elen = if vector_enabled | vector_profile_elen(core_profile.vector) | VectorSEW.E64
  def trace_isa = "rv" ++ to_string(width) ++ String.join(core_profile.isa_profile.isa_extensions.filter(~keep: fun (name): name.length() == 1), "") ++ "_" ++ String.join(core_profile.isa_profile.isa_extensions.filter(~keep: fun (name): name.length() > 1), "_")
  def compressed_enabled = compressed_extensions_enabled(compressed_extensions)
  def register_count = 32
  def effective_fp_profile = if xlen == XLen.X32 | FloatingPointProfile.F | FloatingPointProfile.D

  def instruction_alignment = if compressed_enabled | 2 | 4
  unless reset_address < (1 << width)
  | error(~who: #'RV5StageCore, "reset address must fit XLEN")
  unless reset_address mod instruction_alignment == 0
  | error(~who: #'RV5StageCore, "reset address must be instruction aligned")
  def reset_pc = bits(reset_address, width)

  input interrupts: RiscvInterrupts()
  input hart_id: Bits(width)
  input time_counter: Bits(64)
  interface frontend_control(RV5StageFrontendControl(xlen), ~role: core)
  interface packets(Decoupled(RV5StageFetchPacket(xlen)), ~role: consumer)
  interface data_access(RV5StageDataAccess(xlen, vector_completion_slots), ~role: requester)
  interface pipeline_access(RV5StagePipelineAccess(xlen), ~role: requester)
  output pipeline_vector: Bool
  interface vector_precheck(RV5StageVectorPrecheck(), ~role: requester)
  interface vector_fast(RV5StageVectorFastCheck(xlen), ~role: requester)
  interface prefetch(Valid(CachePrefetchReq(width)), ~role: producer)
  output privilege: PrivilegeMode
  output mstatus: Bits(width)
  output satp: Bits(width)
  output translation_flush: Bool

  inst memory_ports(RV5StageMemoryArbiter(xlen, vector_completion_slots))
  pipeline_vector <== memory_ports.pipeline_vector
  memory_ports.memory <=> data_access
  memory_ports.pipeline <=> pipeline_access
  def scalar_data = memory_ports.scalar
  def scalar_pipeline = memory_ports.scalar_pipeline

  def zero = bits(0, width)
  fun core_instruction_value(instruction :: Bits(32)):
    if width == 32 | instruction | instruction.zext(width)
  fun core_deferred_writeback(source :: RV5StageWritebackSelect):
    source.is_one_of(RV5StageWritebackSelect.Memory, RV5StageWritebackSelect.Multiply, RV5StageWritebackSelect.Divide)
  fun core_serializing_operation(system :: RV5StageSystemControl(), fence :: RV5StageFenceControl()) :~ Bool:
    (system.is_system_operation() & (system.action =/= RV5StageSystemOperation.VectorConfig)) ||| fence.is_fence_operation()
  fun core_data_exception(operation :: RV5StageMemoryOperation,
                          address :: Bits(width),
                          store_cause :: ExceptionCause,
                          load_cause :: ExceptionCause):
    RV5StageException(xlen):
      valid: Bool(#true)
      cause: mux(operation.store_fault_class(),
                 exception_cause_bits(store_cause, width),
                 exception_cause_bits(load_cause, width))
      value: address

  fun core_hazard_any(reasons :: RV5StageHazardReasons()) :~ Bool:
    reasons.deferred_dependency ||| reasons.scoreboard_raw ||| reasons.scoreboard_waw ||| reasons.fp_source ||| reasons.fp_destination ||| reasons.resource ||| reasons.pause ||| reasons.serialization ||| reasons.wfi ||| reasons.interrupt_pending ||| reasons.exception

  // Control-plane state is declared before the stage bodies because redirects,
  // hazards, and retirement decisions travel backward through the pipeline.
  // The stage sections below remain the readable forward datapath order.
  reg wb_pending_exception_valid(~init: Bool(#false))
  reg wb_pending_exception(MemoryWriteback(xlen, vector_completion_slots))

  // Pipeline storage and reusable execution units.
  // The fall-through IBuf holds leftover parcels, not a separate IF/ID stage.
  // Every boundary after Decode
  // advances feed-forward; rejected WB dispatch refetches the instruction
  // without authorizing effects or introducing downstream backpressure.
  inst id_instructions(RV5StageInstructionBuffer(core_profile))
  inst id_ex_pipe(ValidPipeAlwaysCapture(DecodeExecute(xlen, vector_completion_slots), 1))
  inst ex_mem_pipe(ValidPipeAlwaysCapture(ExecuteMemory(xlen, vector_completion_slots), 1))
  inst mem_wb_pipe(ValidPipeAlwaysCapture(MemoryWriteback(xlen, vector_completion_slots), 1))

  inst id_decoder(RV5StageInstructionDecoder(xlen, profile, half_precision, ~zfa: zfa_enabled, ~zicbop: zicbop_enabled, ~zicboz: zicboz_enabled, ~zicbom: zicbom_enabled, ~zawrs: zawrs_enabled, ~zihintpause: zihintpause_enabled, ~zihintntl: zihintntl_enabled, ~vector: core_profile.vector, ~vector_extensions: vector_extensions))
  inst id_registers(RV5StageRegisterFile(xlen))
  inst ex_alu(ALU(xlen))
  inst ex_branch_resolver(BranchResolver(width))
  def wb_pipelined_multiplier = core_profile.multiplier == RV5StageMultiplierKind.Pipelined
  inst wb_multiplier(RV5StageMultiplyScalar(xlen, ~speculative: wb_pipelined_multiplier))
  inst wb_divider(RV5StageDivideScalar(xlen))
  inst wb_scoreboard(Scoreboard(register_count))
  inst wb_fp_integer_scoreboard(Scoreboard(register_count))
  def wb_fp_module = if floating_point_supports_f(profile) | RV5StageFpScalar(xlen, effective_fp_profile, Bits(width), ~half_precision: execution_half_precision, ~zfa: zfa_enabled) | RV5StageDisabledFpPipeline(xlen, effective_fp_profile, Bits(width))
  inst wb_fp(wb_fp_module)
  inst wb_csrs(RV5StageCsrFile(core_profile))
  def wb_vector_retirement_link :: Handle = interface_link(Valid(MemoryWriteback(xlen, vector_completion_slots)))
  wire wb_vector_active: Bool
  wire wb_vector_replay: Bool
  wire ex_vector_operation_legal: Bool
  wire ex_vector_snapshot: RiscvVectorState(xlen)
  wire ex_vector_geometry: RV5StageVectorFootprintGeometry()
  wire wb_vector_certification_pending: Bool
  wire wb_vector_loads_pending: Bool
  wire wb_vector_fp_pending: Bool
  wire wb_vector_integer_write_pending: Bool
  def wb_vector_reserve_link :: Handle = interface_link(Valid(Bits(5)))
  wire wb_vector_stores_pending: Bool
  wire wb_vector_fp_write_pending: Bool
  wire ex_vector_resolved_rs1: Bits(width)
  wire ex_vector_resolved_rs2: Bits(width)
  def wb_vector_scalar_result_link :: Handle = interface_link(Valid(RegisterFileWrite(xlen)))
  wire wb_memory_accepted: Bool
  wb_csrs.interrupts <== interrupts
  wb_csrs.hart_id <== hart_id
  wb_csrs.time_counter <== time_counter
  def wb_scalar_fp_tag = RV5StageFpScalarTag(Bits(width))
  inst wb_gpr_calendar(RV5StageWritebackCalendar(3, 8))
  // WB services reserve before younger ID admissions; WB readiness must not
  // depend on an instruction whose admission depends on WB cancellation.
  wb_gpr_calendar.probe_client <== bits(2, index_width(3))
  wb_gpr_calendar.probe_delay <== bits(PipelinedMultiplierStages + 1, 4)
  wire wb_fp_fixed_integer_return: Bool
  def wb_vector_fp_tag = Bits(index_width(vector_completion_slots))
  def wb_vector_fp_request_link :: Handle = interface_link(Decoupled(RV5StageFpExecutionRequest(xlen, effective_fp_profile, wb_vector_fp_tag)))
  def wb_vector_fp_result_link :: Handle = interface_link(Decoupled(RV5StageFpExecutionResult(xlen, effective_fp_profile, wb_vector_fp_tag)))
  def wb_vector_fp_update_link :: Handle = interface_link(Valid(Bits(5)))
  // Scalar and vector completions may both update flags on the same edge.
  wb_csrs.fp_update.valid <== wb_fp.state_update.valid ||| wb_vector_fp_update_link.right.valid
  wb_csrs.fp_update.bits <== mux(wb_fp.state_update.valid, wb_fp.state_update.bits, bits(0, 5)) ||| mux(wb_vector_fp_update_link.right.valid, wb_vector_fp_update_link.right.bits, bits(0, 5))
  if floating_point_supports_f(profile)
  | block:
      tagged_union FpOwner():
        Scalar(wb_scalar_fp_tag)
        Vector(wb_vector_fp_tag)
      inst wb_fp_execution(RV5StageFpExecutionService(xlen, effective_fp_profile, FpOwner(), ~half_precision: execution_half_precision, ~zfa: zfa_enabled, ~scheduled_writeback: #true))
      def Array(fp_launch, fp_reservation) = Array(
        wb_fp.execution_request |> map_flow(request => fp_request_with_tag(xlen, effective_fp_profile, wb_scalar_fp_tag, FpOwner(), request, FpOwner().Scalar(request.tag))),
        wb_vector_fp_request_link.right |> map_flow(request => fp_request_with_tag(xlen, effective_fp_profile, wb_vector_fp_tag, FpOwner(), request, FpOwner().Vector(request.tag)))
      ) |> rr_arbiter() |> atomic_fork(2)
      fp_launch |> wb_fp_execution.request
      fp_reservation |> filter_flow(operation => operation.tag.is(FpOwner().Scalar).into(Bool) & (operation.control.registers.destination === RV5StageFloatDestination.Integer) & (operation.control.execution.unit =/= RV5StageFloatUnit.DivideSquareRoot)) |> map_flow(_operation => bits(2, 4)) |> wb_gpr_calendar.reserve[0]
      reg integer_returns(~init: bits(0, 2))
      integer_returns <== wb_gpr_calendar.reserve[0].fire().as_bits() ++ integer_returns[1..2]
      wb_fp_fixed_integer_return <== integer_returns[0].into(Bool)
      (
        wb_fp_execution.result |> demux_flow(2, ~stable: #true, result => result.tag.is(FpOwner().Vector).into(Bool))
          |> parallel(
               map_flow(~stable: #true, result => fp_result_with_tag(xlen, effective_fp_profile, FpOwner(), wb_scalar_fp_tag, result, result.tag.view(FpOwner().Scalar).payload)),
               map_flow(~stable: #true, result => fp_result_with_tag(xlen, effective_fp_profile, FpOwner(), wb_vector_fp_tag, result, result.tag.view(FpOwner().Vector).payload))
             )
      ) <=> Array(wb_fp.execution_result, wb_vector_fp_result_link.left)
  | block:
      wb_gpr_calendar.reserve[0].valid <== Bool(#false)
      wb_gpr_calendar.reserve[0].bits <== bits(2, 4)
      wb_fp_fixed_integer_return <== Bool(#false)
      wb_vector_fp_request_link.right.ready <== Bool(#false)
      wb_vector_fp_result_link.left.valid <== Bool(#false)
      wb_vector_fp_result_link.left.bits <== dont_care(RV5StageFpExecutionResult(xlen, effective_fp_profile, wb_vector_fp_tag))

  def wb_vector_multiply_tag = RV5StageVectorMultiplyTag(vector_completion_slots)
  def wb_vector_divide_tag = RV5StageVectorDivideTag(vector_completion_slots)
  def wb_vector_multiply_request_link :: Handle = interface_link(Decoupled(RV5StageExecutionRequest(MultiplierRequest(width), wb_vector_multiply_tag)))
  def wb_vector_multiply_result_link :: Handle = interface_link(Irrevocable(RV5StageExecutionResult(Bits(width * 2), wb_vector_multiply_tag)))
  tagged_union MultiplyOwner():
    Scalar(RV5StageMultiplyTag())
    Vector(wb_vector_multiply_tag)
  inst wb_multiply_execution(RV5StageMultiplyService(core_profile.multiplier, width, MultiplyOwner(), ~scheduled_writeback: #true))
  def wb_scalar_multiply_request = wb_multiplier.execution_request |> map_flow(request => integer_request_with_tag(MultiplierRequest(width), RV5StageMultiplyTag(), MultiplyOwner(), request, MultiplyOwner().Scalar(request.tag)))
  def wb_vector_multiply_request = wb_vector_multiply_request_link.right |> map_flow(request => integer_request_with_tag(MultiplierRequest(width), wb_vector_multiply_tag, MultiplyOwner(), request, MultiplyOwner().Vector(request.tag)))
  wire id_multiply_admitted: Bool
  wire id_multiply_available: Bool
  if wb_pipelined_multiplier
  | block:
      // ID books the next launch and its return together. Only control is
      // retained here; EX operands enter the arithmetic pipeline directly.
      reg ex_multiply_reserved(~init: Bool(#false))
      reg id_multiply_vector_turn(~init: Bool(#false))
      ex_multiply_reserved <== id_multiply_admitted
      def id_vector_multiply_waiting = wb_vector_multiply_request.valid & !fire(wb_vector_multiply_request)
      id_multiply_available <== wb_gpr_calendar.probe_available & !(id_multiply_vector_turn & id_vector_multiply_waiting)
      when (!wb_vector_multiply_request.valid ||| fire(wb_vector_multiply_request)):
        id_multiply_vector_turn <== Bool(#false)
      elsewhen id_multiply_admitted:
        id_multiply_vector_turn <== Bool(#true)
      inst ex_multiply_selection(GrantMerge(RV5StageExecutionRequest(MultiplierRequest(width), MultiplyOwner()), 2))
      ex_multiply_selection.grants <== vec([ex_multiply_reserved, !ex_multiply_reserved]).into(MaybeOneHot(2))
      Array(wb_scalar_multiply_request, wb_vector_multiply_request) <=> ex_multiply_selection.ingress
      ex_multiply_selection.egress |> wb_multiply_execution.request
      when (wb_scalar_multiply_request.valid):
        assert(ex_multiply_reserved, "scalar_multiply_has_ex_reservation")
  | block:
      id_multiply_available <== Bool(#true)
      Array(wb_vector_multiply_request, wb_scalar_multiply_request |> queue(2)) |> arbiter() |> wb_multiply_execution.request
  (
    wb_multiply_execution.result |> demux_flow(2, ~stable: #true, result => result.tag.is(MultiplyOwner().Vector).into(Bool))
      |> parallel(
           map_flow(~stable: #true, result => integer_result_with_tag(Bits(width * 2), MultiplyOwner(), RV5StageMultiplyTag(), result, result.tag.view(MultiplyOwner().Scalar).payload)),
           map_flow(~stable: #true, result => integer_result_with_tag(Bits(width * 2), MultiplyOwner(), wb_vector_multiply_tag, result, result.tag.view(MultiplyOwner().Vector).payload))
         )
  ) <=> Array(wb_multiplier.execution_result, wb_vector_multiply_result_link.left)
  def wb_vector_divide_request_link :: Handle = interface_link(Decoupled(RV5StageExecutionRequest(DividerRequest(width), wb_vector_divide_tag)))
  def wb_vector_divide_result_link :: Handle = interface_link(Irrevocable(RV5StageExecutionResult(DividerResponse(width), wb_vector_divide_tag)))
  tagged_union DivideOwner():
    Scalar(RV5StageDivideTag())
    Vector(wb_vector_divide_tag)
  inst wb_divide_execution(RV5StageDivideService(width, DivideOwner()))
  Array(
    wb_divider.execution_request |> map_flow(request => integer_request_with_tag(DividerRequest(width), RV5StageDivideTag(), DivideOwner(), request, DivideOwner().Scalar(request.tag))),
    wb_vector_divide_request_link.right |> map_flow(request => integer_request_with_tag(DividerRequest(width), wb_vector_divide_tag, DivideOwner(), request, DivideOwner().Vector(request.tag)))
  ) |> rr_arbiter() |> queue(2) |> wb_divide_execution.request
  (
    wb_divide_execution.result |> demux_flow(2, ~stable: #true, result => result.tag.is(DivideOwner().Vector).into(Bool))
      |> parallel(
           map_flow(~stable: #true, result => integer_result_with_tag(DividerResponse(width), DivideOwner(), RV5StageDivideTag(), result, result.tag.view(DivideOwner().Scalar).payload)),
           map_flow(~stable: #true, result => integer_result_with_tag(DividerResponse(width), DivideOwner(), wb_vector_divide_tag, result, result.tag.view(DivideOwner().Vector).payload))
         )
  ) <=> Array(wb_divider.execution_result, wb_vector_divide_result_link.left)

  // Stage boundary aliases and retained retirement contexts. These aliases
  // keep the stage bodies below independent of Flow implementation details.
  def ex_input = id_ex_pipe.egress
  def mem_input = ex_mem_pipe.egress
  def mem_cache_outcome = mux(scalar_pipeline.response.valid & mem_input.bits.data_request_valid, scalar_pipeline.response.bits.outcome, RV5StagePipelineOutcome.Slow)
  def mem_load_hit = mem_cache_outcome === RV5StagePipelineOutcome.LoadHit
  def mem_cache_replay = mem_cache_outcome === RV5StagePipelineOutcome.Replay
  // Accepted maintenance retains retirement context outside the feed-forward
  // pipeline. Only its completion can retire it; it is never reissued.
  inst wb_maintenance(OfferRegister(MemoryWriteback(xlen, vector_completion_slots)))
  inst wb_reservation_wait(OfferRegister(MemoryWriteback(xlen, vector_completion_slots)))
  inst wb_selection(GrantMerge(MemoryWriteback(xlen, vector_completion_slots), 4))
  def wb_maintenance_pending = wb_maintenance.egress.valid
  wire wb_maintenance_accepted: Bool
  def wb_input = mem_wb_pipe.egress
  def Array(wb_retirement_path, wb_fp_path, wb_memory_path) = wb_input |> fork_valid(3)
  def Array(wb_live_path, wb_maintenance_path, wb_wait_path, wb_vector_retention_path) = wb_retirement_path |> fork_valid(4)
  // WRS owns its retirement context outside the feed-forward pipeline. Wake
  // levels win over timeout, including a reservation lost on entry to waiting.
  def wb_reservation_wait_pending = wb_reservation_wait.egress.valid
  def wb_reservation_wait_instruction = wb_reservation_wait.egress.bits
  reg wb_reservation_wait_count(~init: bits(0, 12))
  def wb_reservation_wait_wake = !scalar_data.reservation_valid ||| wb_csrs.wfi_wake
  def wb_reservation_wait_expired = and_reduce(wb_reservation_wait_count)
  def wb_reservation_wait_short = wb_reservation_wait_instruction.system.action === RV5StageSystemOperation.WrsSto
  def wb_reservation_wait_tw = (wb_csrs.privilege =/= PrivilegeMode.Machine) & csr_flag(wb_csrs.mstatus, MstatusTW)
  def wb_reservation_wait_timeout = wb_reservation_wait_expired & (wb_reservation_wait_short ||| wb_reservation_wait_tw)
  def wb_reservation_wait_done = wb_reservation_wait_pending & (wb_reservation_wait_wake ||| wb_reservation_wait_timeout)
  def wb_reservation_wait_illegal = wb_reservation_wait_done & !wb_reservation_wait_wake & !wb_reservation_wait_short & wb_reservation_wait_tw
  def wb_reservation_wait_accept = Bool(zawrs_enabled) & wb_input.valid & !wb_maintenance_pending & !wb_reservation_wait_pending & !wb_pending_exception_valid & !wb_input.bits.replay & !wb_input.bits.exception_valid & wb_input.bits.system.action.is_one_of(RV5StageSystemOperation.WrsNto, RV5StageSystemOperation.WrsSto)
  when wb_reservation_wait_accept:
    wb_reservation_wait_count <== bits(0, 12)
  elsewhen (wb_reservation_wait_pending & !wb_reservation_wait_done & !wb_reservation_wait_expired):
    wb_reservation_wait_count <== wb_reservation_wait_count + bits(1, 12)
  def Array(wb_integer_responses, wb_fp_responses, wb_other_responses) = scalar_data.response |> demux_flow(3, response => mux(response.writeback.is(RV5StageMemoryWriteback(vector_completion_slots).Integer).into(Bool), bits(0, 2), mux(response.writeback.is(RV5StageMemoryWriteback(vector_completion_slots).FloatingPoint).into(Bool), bits(1, 2), bits(2, 2))))
  def wb_fp_response = wb_fp_responses |> to_valid()
  def wb_other_response = wb_other_responses |> to_valid()
  def wb_maintenance_done = wb_maintenance_pending & wb_other_response.valid
  when (wb_other_response.valid & wb_other_response.bits.access_fault):
    assert(wb_maintenance_pending, "rv5stage_completion_fault_has_retirement_context")
  assert(!wb_maintenance_accepted ||| wb_input.valid, "maintenance_capture_has_wb")
  assert(!wb_reservation_wait_accept ||| wb_input.valid, "wait_capture_has_wb")
  wb_maintenance_path |> filter_valid(_instruction => wb_maintenance_accepted) |> wb_maintenance.update
  wb_wait_path |> filter_valid(_instruction => wb_reservation_wait_accept) |> wb_reservation_wait.update
  // Select the pending owner before gating completion, preserving its payload
  // while unfinished. Acceptance releases that OfferRegister at the edge.
  wb_selection.grants <== vec([!wb_maintenance_pending & !wb_reservation_wait_pending & !wb_vector_retirement_link.right.valid, wb_maintenance_pending & !wb_reservation_wait_pending, wb_reservation_wait_pending, wb_vector_retirement_link.right.valid & !wb_maintenance_pending & !wb_reservation_wait_pending]).into(MaybeOneHot(4))
  wb_live_path |> filter_valid(_instruction => !wb_reservation_wait_accept) |> offer_decoupled() |> wb_selection.ingress[0]
  wb_maintenance.egress |> wb_selection.ingress[1]
  wb_reservation_wait.egress |> wb_selection.ingress[2]
  wb_vector_retirement_link.right |> offer_decoupled() |> wb_selection.ingress[3]
  when (wb_vector_retirement_link.right.valid):
    assert(!wb_input.valid & !wb_maintenance_pending & !wb_reservation_wait_pending, "vector_outcome_has_retirement_port")
  def wb = wb_selection.egress |> gate_flow(mux(wb_reservation_wait_pending, wb_reservation_wait_done, mux(wb_maintenance_pending, wb_maintenance_done, Bool(#true)))) |> to_valid()
  def Array(wb_commit_path, wb_vector_launch_path, wb_vector_replay_path, wb_vector_slow_path, wb_fp_reservation_path, wb_fp_hit_path) = wb |> fork_valid(6)
  def wb_offer_bits :: MemoryWriteback(xlen, vector_completion_slots) = wb.bits
  wire wb_commit_result: MemoryWriteback(xlen, vector_completion_slots)
  wire wb_vector_fast: Bool
  wire wb_vector_slow_admission: Bool
  wire wb_vector_slow_restart: Bool
  def wb_commit = wb_commit_path |> filter_valid(operation => (!operation.vector_launch ||| !operation.vector_context.control.memory ||| wb_vector_fast) & !wb_maintenance_accepted & !wb_pending_exception_valid) |> map_valid(_operation => wb_commit_result)
  def Array(wb_serializing_path, wb_replay_path, wb_prefetch_path, wb_vector_redirect_path, wb_scoreboard_path, wb_register_path, wb_multiply_path, wb_divide_path, wb_trace_path) = wb_commit |> fork_valid(9)
  // Retirement is a final observation; replay and memory consumers retain their
  // own lineage even when this instruction does not retire.
  def wb_retired_event = wb_trace_path |> trace_valid_event("core/s5.wb", ~when: wb_csrs.retired, ~fields: operation):
    pc: operation.pc
    instruction(~format: "riscv", ~isa: trace_isa, ~pc: "pc"): operation.raw_instruction
    branch_prediction(~format: "enum"): operation.branch_prediction
    ras_mismatch: operation.ras_mismatch
  def wb_commit_bits :: MemoryWriteback(xlen, vector_completion_slots) = wb_commit.bits
  def wb_commit_replay = wb_commit.valid & wb_commit_bits.replay
  def wb_commit_valid = wb_commit.valid & !wb_commit_bits.replay
  wire wb_vector_truncate: Bool
  def wb_macro_retire = wb_commit_valid
  def Array(wb_commit_write :: Endpoint, wb_deferred_completion_write :: Endpoint) = id_registers.writes

  privilege <== wb_csrs.privilege
  mstatus <== wb_csrs.mstatus
  satp <== wb_csrs.satp

  // Backward-traveling observations use local Valid interface links. Their
  // producers remain in the forward stage sections below, despite earlier
  // stages consuming their values.
  def if_redirect_link :: Handle = interface_link(Valid(Bits(width)))
  def mem_to_if_exception_link :: Handle = interface_link(Valid(Bits(width)))
  def mem_to_if_replay_link :: Handle = interface_link(Valid(Bits(width)))
  def mem_to_if_redirect_link :: Handle = interface_link(Valid(Bits(width)))
  def wb_to_id_scoreboard_set_link :: Handle = interface_link(Valid(Bits(5)))
  def wb_to_id_scoreboard_clear_link :: Handle = interface_link(Valid(Bits(5)))
  Array(wb_to_id_scoreboard_set_link.right, wb_vector_reserve_link.right) |> valid_arbiter() |> wb_scoreboard.set
  wb_to_id_scoreboard_clear_link.right |> wb_scoreboard.clear
  def fence_i_commit = wb_commit_valid & !wb_commit_bits.exception_valid & wb_offer_bits.fence.into(RV5StageFenceControl()).is_instruction_fence()
  translation_flush <== wb_csrs.translation_flush
  // Restart after a PMM change to discard younger context and queued prefetches,
  // without conflating pointer policy with translation invalidation.
  def wb_serializing_resume = fence_i_commit ||| wb_csrs.translation_flush ||| wb_csrs.pointer_masking_changed
  def wb_commit_redirect = wb_csrs.redirect.valid ||| wb_serializing_resume ||| wb_commit_replay ||| wb_vector_replay ||| wb_vector_truncate ||| wb_vector_slow_restart
  def mem_stage_valid = mem_input.valid & !wb_commit_redirect & !wb_pending_exception_valid & !(wb_commit_valid & wb_commit_bits.exception_valid)
  def mem_exception_event = mem_to_if_exception_link.right.valid
  def mem_replay_event = mem_to_if_replay_link.right.valid
  def mem_redirect = mem_to_if_redirect_link.right.valid
  def ex_older_squash = mem_exception_event ||| mem_replay_event ||| mem_redirect ||| wb_commit_redirect
  def ex_transfer = ex_input.valid & !ex_older_squash
  def Array(wb_trap_restart, wb_trap_predictor_flush) = wb_csrs.redirect |> fork_valid(2)
  def wb_serializing_redirect = wb_serializing_path |> filter_valid(_operation => wb_serializing_resume) |> map_valid(operation => operation.resume_pc)
  def wb_vector_truncate_redirect = wb_vector_redirect_path |> filter_valid(_operation => wb_vector_truncate) |> map_valid(operation => operation.resume_pc)
  def Array(wb_serializing_restart, wb_serializing_invalidate) = wb_serializing_redirect |> fork_valid(2)
  def wb_commit_replay_redirect = wb_replay_path |> filter_valid(operation => operation.replay & !operation.vector_launch) |> map_valid(operation => operation.pc)
  def wb_vector_replay_redirect = wb_vector_replay_path |> filter_valid(_operation => wb_vector_replay) |> map_valid(operation => operation.pc)
  def wb_vector_slow_redirect = wb_vector_slow_path |> filter_valid(_operation => wb_vector_slow_restart) |> map_valid(operation => operation.resume_pc)
  def if_redirect_sources = Array(
    wb_trap_restart,
    wb_serializing_restart,
    wb_vector_truncate_redirect,
    wb_commit_replay_redirect,
    wb_vector_replay_redirect,
    wb_vector_slow_redirect,
    mem_to_if_redirect_link.right
  )
  if_redirect_sources |> valid_arbiter() |> if_redirect_link.left

  // Stage 1: Fetch (IF) assembles variable-length instructions from aligned
  // cache words. Redirects and faults discard partial and outstanding data.
  def if_exception_in_flight = wb_pending_exception_valid ||| mem_exception_event ||| (
    wb_commit_valid & wb_commit_bits.exception_valid
  )
  def if_squash = if_exception_in_flight ||| mem_replay_event ||| if_redirect_link.right.valid
  reg if_started(~init: Bool(#false))
  reg if_waiting_for_interrupt(~init: Bool(#false))
  // PAUSE retires before its bounded cooldown. Unlike WFI/WRS, no instruction
  // context or older-memory drain is required, and interrupts remain live.
  def if_pause_cycle_limit = 16
  reg if_pause_cycles(~init: bits(0, index_width(if_pause_cycle_limit + 1)))
  def if_pause_active = or_reduce(if_pause_cycles)
  def if_pause_commit = wb_commit_valid & !wb_commit_bits.exception_valid & (wb_commit_bits.hint === RV5StageHintOperation.Pause)
  when (wb_csrs.redirect.valid ||| wb_csrs.interrupt_request):
    if_pause_cycles <== bits(0, index_width(if_pause_cycle_limit + 1))
  elsewhen if_pause_commit:
    if_pause_cycles <== bits(if_pause_cycle_limit, index_width(if_pause_cycle_limit + 1))
  elsewhen if_pause_active:
    if_pause_cycles <== if_pause_cycles - bits(1, index_width(if_pause_cycle_limit + 1))
  reg if_architectural_pc(~init: reset_pc)
  // Seed fetch once after reset; software in the reset image owns boot waiting.
  def if_start_link :: Handle = interface_link(Valid(Bits(width)))
  if_start_link.left.valid <== !if_started
  if_start_link.left.bits <== reset_pc
  def if_fetch_valid = if_started & !if_pause_active & !if_pause_commit & !if_squash & !wb_csrs.interrupt_request & !if_waiting_for_interrupt & !wb_reservation_wait_pending & !wb_reservation_wait_accept
  frontend_control.active <== if_fetch_valid
  Array(mem_to_if_exception_link.right, mem_to_if_replay_link.right) |> valid_arbiter() |> frontend_control.flush
  Array(if_redirect_link.right, if_start_link.right) |> valid_arbiter() |> frontend_control.restart
  def Array(wb_instruction_invalidate, wb_predictor_invalidate) = wb_serializing_invalidate |> fork_valid(2)
  wb_instruction_invalidate |> filter_valid(_pc => fence_i_commit) |> frontend_control.invalidate_all
  def wb_predictor_flush = wb_predictor_invalidate |> filter_valid(_pc => fence_i_commit ||| wb_csrs.translation_flush)
  Array(wb_trap_predictor_flush, wb_predictor_flush) |> valid_arbiter() |> frontend_control.predictor_flush
  packets |> id_instructions.packets
  id_instructions.clear.valid <== frontend_control.flush.valid ||| frontend_control.restart.valid ||| frontend_control.invalidate_all.valid
  if_started <== Bool(#true)
  when (wb_csrs.redirect.valid):
    if_architectural_pc <== wb_csrs.redirect.bits
  elsewhen (wb_macro_retire & !wb_commit_bits.exception_valid):
    if_architectural_pc <== wb_commit_bits.resume_pc

  when (wb_csrs.wfi_wake ||| wb_csrs.redirect.valid):
    if_waiting_for_interrupt <== Bool(#false)
  elsewhen (wb_csrs.wfi_retired):
    if_waiting_for_interrupt <== Bool(#true)

  def id_decode_valid = id_instructions.fetched.valid & !if_squash
  def id_decode_bits = id_instructions.fetched.bits

  // Stage 2: Decode (ID) consumes the fall-through IBuf directly into ID/EX.
  // Filtering consumes squashed tokens; gating holds a token that depends on
  // deferred work which has not yet reached the WB commit point.
  def id_instruction = id_decode_bits.instruction
  id_decoder.instruction <== id_instruction
  def id_control :: RV5StageControl() = id_decoder.control

  def id_rs1 = instruction_field(riscv_fields.rs1, id_instruction)
  def id_rs2 = instruction_field(riscv_fields.rs2, id_instruction)
  def id_rd = instruction_field(riscv_fields.rd, id_instruction)
  def id_frs3 = instruction_field(riscv_fields.rs3, id_instruction)
  def id_fp_rounding = riscv_rounding_mode(instruction_field(riscv_fields.rm, id_instruction), wb_csrs.frm)
  def id_immediate = id_control.operand.immediate.decode(id_instruction, width)
  wb_csrs.cbo_operation <== mux_lookup(
    id_control.memory.access, ~default: CboManagementOperation.Invalidate,
    [[RV5StageMemoryOperation.CacheBlockClean, CboManagementOperation.Clean],
     [RV5StageMemoryOperation.CacheBlockFlush, CboManagementOperation.Flush]]
  )
  def id_management = id_control.memory.access.is_cache_management()
  def id_cbo_permission :: CboManagementPermission() = wb_csrs.cbo_permission
  def id_memory_operation = mux(id_management & (id_cbo_permission.operation === CboManagementOperation.Flush), RV5StageMemoryOperation.CacheBlockFlush, id_control.memory.access)
  def id_vector_instruction = id_control.vector.integer ||| id_control.vector.memory ||| id_control.vector.floating_point ||| id_control.vector.multiply_divide
  def id_illegal = id_control.vector.floating_point & (Bool(!floating_point_supports_f(profile)) ||| !wb_csrs.fp_enabled ||| (id_control.vector.fp_service & id_control.vector.fp_execution.uses_rounding_mode & (wb_csrs.frm > bits(4, 3)))) ||| id_decode_bits.compressed_illegal ||| !id_decoder.valid ||| (id_vector_instruction & !wb_csrs.vector_enabled) ||| (
    (id_control.system.action === RV5StageSystemOperation.VectorConfig) & !wb_csrs.vector_enabled
  ) ||| (
    id_control.memory.access.is_cache_block_zero() & !wb_csrs.cbo_zero_enabled
  ) ||| (id_management & !id_cbo_permission.permitted) ||| (
    id_control.floating_point_valid & (
      !wb_csrs.fp_enabled ||| (
        id_control.floating_point.execution.uses_rounding_mode & !id_fp_rounding.valid
      )
    )
  )
  def id_fault = id_decode_bits.instruction_page_fault ||| id_decode_bits.instruction_access_fault ||| id_illegal

  id_registers.read_address_1 <== id_rs1
  id_registers.read_address_2 <== id_rs2
  // Decode selects the registered data source that will be present in EX's
  // next cycle. Live MEM faults, replay, and redirects never select operands.
  def id_ex_bypass_available = ex_input.valid & ex_input.bits.writeback_enable & !core_deferred_writeback(ex_input.bits.writeback_source) & (ex_input.bits.writeback_source =/= RV5StageWritebackSelect.Vector) & ((ex_input.bits.writeback_source =/= RV5StageWritebackSelect.Csr) ||| (ex_input.bits.system.action === RV5StageSystemOperation.VectorConfig))
  def id_mem_bypass_available = mem_input.valid & mem_input.bits.writeback_enable & (!core_deferred_writeback(mem_input.bits.writeback_source) ||| mem_load_hit) & (mem_input.bits.writeback_source =/= RV5StageWritebackSelect.Vector) & ((mem_input.bits.writeback_source =/= RV5StageWritebackSelect.Csr) ||| (mem_input.bits.system.action === RV5StageSystemOperation.VectorConfig))
  fun id_operand(index :: Bits(5), register_value :: Bits(width)):
    def id_from_memory = index.or_reduce() & id_ex_bypass_available & (ex_input.bits.rd === index)
    def id_from_writeback = index.or_reduce() & id_mem_bypass_available & (mem_input.bits.rd === index)
    def id_bypass_winner = priority_encoder_oh(id_from_writeback ++ id_from_memory)
    RV5StageOperand(xlen):
      stage_sel: id_bypass_winner.mux([RV5StageBypassStage.Memory, RV5StageBypassStage.Writeback], ~default: RV5StageBypassStage.RegisterFile)
      value: register_value
  // A launch has not reserved its deferred destination until WB admission.
  // Track those older tokens explicitly without treating capacity as an ID hazard.
  fun id_vector_launch_matches(predicate :: Function.of_arity(2)):
    (ex_input.valid & ex_input.bits.vector_launch & predicate(ex_input.bits.vector_control, ex_input.bits.rd)) ||| (mem_input.valid & mem_input.bits.vector_launch & predicate(mem_input.bits.vector_context.control, mem_input.bits.rd)) ||| (wb.valid & wb_offer_bits.vector_launch & predicate(wb_offer_bits.vector_context.control, wb_offer_bits.rd))
  fun id_integer_register_busy(index :: Bits(5)):
    (
      id_vector_launch_matches(fun (control :: RV5StageVectorControl(), rd :: Bits(5)): control.integer & control.scalar_destination & (rd === index)) ||| scoreboard_busy(register_count, wb_scoreboard.busy, index) ||| scoreboard_busy(
        register_count,
        wb_fp_integer_scoreboard.busy,
        index
      ) ||| (
        wb_to_id_scoreboard_set_link.right.valid & (wb_to_id_scoreboard_set_link.right.bits === index)
      ) ||| (
        ex_input.valid & ex_input.bits.floating_point_valid & (
          ex_input.bits.floating_point_control.registers.destination === RV5StageFloatDestination.Integer
        ) & (ex_input.bits.rd === index)
      ) ||| (
        mem_input.valid & mem_input.bits.fp_compute & (mem_input.bits.fp_issue.control.registers.destination === RV5StageFloatDestination.Integer) & (mem_input.bits.rd === index)
      ) ||| (
        wb.valid & wb_offer_bits.fp_compute & (wb_offer_bits.fp_issue.control.registers.destination === RV5StageFloatDestination.Integer) & (wb_offer_bits.rd === index)
      )
    ) & !(
      wb_to_id_scoreboard_clear_link.right.valid & (wb_to_id_scoreboard_clear_link.right.bits === index)
    )

  def id_ex_deferred = ex_input.valid & ex_input.bits.writeback_enable & core_deferred_writeback(ex_input.bits.writeback_source)
  def id_mem_deferred = mem_input.valid & mem_input.bits.writeback_enable & core_deferred_writeback(mem_input.bits.writeback_source) & !mem_load_hit
  fun id_conflicts_with_deferred(deferred_valid :: Bool,
                                 deferred_destination :: Bits(5)):
    deferred_valid & deferred_destination.or_reduce() & (
      (id_control.operand.uses_rs1 & (deferred_destination === id_rs1)) ||| (
        id_control.operand.uses_rs2 & (deferred_destination === id_rs2)
      ) ||| (
        (id_control.writeback.enable ||| (
          id_control.floating_point_valid & (
            id_control.floating_point.registers.destination === RV5StageFloatDestination.Integer
          )
        )) & (deferred_destination === id_rd)
      )
    )
  def id_deferred_dependency_hazard = id_decode_valid & (
    id_conflicts_with_deferred(id_ex_deferred, ex_input.bits.rd) ||| (
      id_conflicts_with_deferred(id_mem_deferred, mem_input.bits.rd)
    )
  )
  def id_scoreboard_raw_hazard = (
    id_control.operand.uses_rs1 & id_rs1.or_reduce() & id_integer_register_busy(id_rs1)
  ) ||| (
    id_control.operand.uses_rs2 & id_rs2.or_reduce() & id_integer_register_busy(id_rs2)
  )
  def id_integer_write = id_control.writeback.enable ||| (id_vector_instruction & id_control.vector.integer & id_control.vector.scalar_destination) ||| (
    id_control.floating_point_valid & (
      id_control.floating_point.registers.destination === RV5StageFloatDestination.Integer
    )
  )
  def id_scoreboard_waw_hazard = id_integer_write & id_rd.or_reduce() & id_integer_register_busy(id_rd)
  fun id_fp_register_busy(index :: Bits(5)):
    id_vector_launch_matches(fun (control :: RV5StageVectorControl(), rd :: Bits(5)): control.floating_scalar_destination & (rd === index)) ||| scoreboard_busy(register_count, wb_fp.busy, index) ||| (
      ex_input.valid & ex_input.bits.floating_point_valid & (
        ex_input.bits.floating_point_control.registers.destination === RV5StageFloatDestination.FloatingPoint
      ) & (ex_input.bits.rd === index)
    ) ||| (
      mem_input.valid & mem_input.bits.data_request_valid & (
        mem_input.bits.data_request.writeback.is(RV5StageMemoryWriteback(vector_completion_slots).FloatingPoint).into(Bool)
      ) & (mem_input.bits.data_request.writeback.view(RV5StageMemoryWriteback(vector_completion_slots).FloatingPoint).payload.rd === index)
    ) ||| (
      mem_input.valid & mem_input.bits.fp_compute & (mem_input.bits.fp_issue.control.registers.destination === RV5StageFloatDestination.FloatingPoint) & (mem_input.bits.rd === index)
    ) ||| (
      wb.valid & ((wb_offer_bits.fp_compute & (wb_offer_bits.fp_issue.control.registers.destination === RV5StageFloatDestination.FloatingPoint)) ||| (wb_offer_bits.data_request_valid & wb_offer_bits.data_request.writeback.is(RV5StageMemoryWriteback(vector_completion_slots).FloatingPoint).into(Bool))) & (wb_offer_bits.rd === index)
    )
  def id_fp_source_hazard = id_control.floating_point_valid & (
    (id_control.floating_point.registers.uses_frs1 & id_fp_register_busy(id_rs1)) ||| (
      id_control.floating_point.registers.uses_frs2 & id_fp_register_busy(id_rs2)
    ) ||| (
      id_control.floating_point.registers.uses_frs3 & id_fp_register_busy(id_frs3)
    )
  )
  def id_vector_fp_source_hazard = id_control.vector.floating_point & (id_control.vector.operand === VectorOperandMode.FloatingScalar) & id_fp_register_busy(id_rs1)
  def id_fp_destination_hazard = id_control.floating_point_valid & (
    id_control.floating_point.registers.destination === RV5StageFloatDestination.FloatingPoint
  ) & id_fp_register_busy(id_rd)
  def id_ex_fp_reservation_pending = ex_input.valid & ex_input.bits.floating_point_valid & ((ex_input.bits.floating_point_control.execution.unit =/= RV5StageFloatUnit.Memory) ||| !ex_input.bits.floating_point_control.execution.memory_write)
  def id_mem_fp_reservation_pending = mem_input.valid & (mem_input.bits.fp_compute ||| (mem_input.bits.data_request_valid & mem_input.bits.data_request.writeback.is(RV5StageMemoryWriteback(vector_completion_slots).FloatingPoint).into(Bool)))
  def id_wb_fp_reservation_pending = wb.valid & (wb_offer_bits.fp_compute ||| (wb_offer_bits.data_request_valid & wb_offer_bits.data_request.writeback.is(RV5StageMemoryWriteback(vector_completion_slots).FloatingPoint).into(Bool)))
  def id_older_fp_reservation_pending = id_ex_fp_reservation_pending ||| id_mem_fp_reservation_pending ||| id_wb_fp_reservation_pending
  def id_vector_fp_destination_hazard = id_control.vector.floating_point & id_control.vector.floating_scalar_destination & (id_fp_register_busy(id_rd) ||| !wb_fp.drained ||| id_older_fp_reservation_pending)
  def id_ex_serializing = ex_input.valid & (core_serializing_operation(ex_input.bits.system, ex_input.bits.fence) ||| ex_input.bits.memory_operation.into(RV5StageMemoryOperation).is_cache_management())
  def id_mem_serializing = mem_input.valid & (core_serializing_operation(mem_input.bits.system, mem_input.bits.fence) ||| mem_input.bits.data_request.access.into(RV5StageMemoryOperation).is_cache_management())
  def id_wb_serializing = wb_commit_valid & core_serializing_operation(wb_offer_bits.system, wb_offer_bits.fence)
  def id_pause_in_flight = (ex_input.valid & (ex_input.bits.hint === RV5StageHintOperation.Pause)) ||| (mem_input.valid & (mem_input.bits.hint === RV5StageHintOperation.Pause)) ||| (wb.valid & (wb_offer_bits.hint === RV5StageHintOperation.Pause))
  def id_serializing_in_flight = id_ex_serializing ||| id_mem_serializing ||| id_wb_serializing ||| wb_maintenance_pending ||| wb_reservation_wait_pending ||| wb_reservation_wait_accept ||| (wb_input.valid & wb_input.bits.data_request.access.into(RV5StageMemoryOperation).is_cache_management())
  def id_wb_commit_deferred = wb_commit_valid & core_deferred_writeback(
    wb_commit_bits.writeback_source
  ) & wb_commit_bits.write_enable
  def wb_deferred_results_pending = wb_scoreboard.busy.or_reduce() ||| wb_fp_integer_scoreboard.busy.or_reduce() ||| !wb_fp.drained
  def id_deferred_state_pending = id_ex_deferred ||| id_mem_deferred ||| (
    id_wb_commit_deferred
  ) ||| wb_deferred_results_pending ||| wb_to_id_scoreboard_set_link.right.valid ||| (ex_input.valid & ex_input.bits.floating_point_valid) ||| (mem_input.valid & mem_input.bits.fp_compute) ||| (wb.valid & wb_offer_bits.fp_compute)
  // Include older accesses not yet accepted by the LSU: drained alone can
  // still be true while a block zero (or scalar store) is in Execute/Memory.
  def id_older_memory_in_flight = (ex_input.valid & ex_input.bits.memory_operation.into(RV5StageMemoryOperation).is_memory()) ||| (mem_input.valid & mem_input.bits.data_request_valid) ||| (wb.valid & wb_offer_bits.data_request_valid)
  def id_serializing_waits_for_older = (core_serializing_operation(id_control.system, id_control.fence) ||| id_management) & (id_deferred_state_pending ||| id_older_memory_in_flight ||| !scalar_data.drained)
  def id_needs_multiplier = (id_control.writeback.source === RV5StageWritebackSelect.Multiply) & id_control.writeback.enable & id_rd.or_reduce()
  def id_ex_has_multiply = ex_input.valid & (ex_input.bits.writeback_source === RV5StageWritebackSelect.Multiply) & ex_input.bits.writeback_enable & ex_input.bits.rd.or_reduce()
  def id_mem_has_multiply = mem_input.valid & (mem_input.bits.writeback_source === RV5StageWritebackSelect.Multiply) & mem_input.bits.writeback_enable & mem_input.bits.rd.or_reduce()
  def wb_commit_has_multiply = wb_commit_valid & (wb_commit_bits.writeback_source === RV5StageWritebackSelect.Multiply) & wb_commit_bits.write_enable & wb_commit_bits.rd.or_reduce()
  def id_multiply_resource_hazard = id_needs_multiplier & !id_fault & (
    if wb_pipelined_multiplier | !id_multiply_available | !wb_multiplier.available ||| id_ex_has_multiply ||| id_mem_has_multiply ||| wb_commit_has_multiply
  )
  def id_needs_divider = (id_control.writeback.source === RV5StageWritebackSelect.Divide) & id_control.writeback.enable & id_rd.or_reduce()
  def id_ex_has_divide = ex_input.valid & (ex_input.bits.writeback_source === RV5StageWritebackSelect.Divide) & ex_input.bits.writeback_enable & ex_input.bits.rd.or_reduce()
  def id_mem_has_divide = mem_input.valid & (mem_input.bits.writeback_source === RV5StageWritebackSelect.Divide) & mem_input.bits.writeback_enable & mem_input.bits.rd.or_reduce()
  def wb_commit_has_divide = wb_commit_valid & (wb_commit_bits.writeback_source === RV5StageWritebackSelect.Divide) & wb_commit_bits.write_enable & wb_commit_bits.rd.or_reduce()
  def id_divide_resource_hazard = id_needs_divider & !id_fault & (
    !wb_divider.available ||| id_ex_has_divide ||| id_mem_has_divide ||| wb_commit_has_divide
  )
  def id_fp_execution_control = id_control.floating_point.execution
  def id_fp_memory = id_control.floating_point_valid & (
    id_fp_execution_control.unit === RV5StageFloatUnit.Memory
  )
  def id_fp_store = id_fp_memory & id_fp_execution_control.memory_write
  def id_fp_store_resource_hazard = id_fp_store & !id_fault & wb.valid & wb_offer_bits.fp_compute
  def id_local_resource_hazard = id_multiply_resource_hazard ||| id_divide_resource_hazard ||| id_fp_store_resource_hazard
  // Certification releases independent scalar work before vector sequencing
  // finishes. Memory ordering and vector/state observers retain explicit barriers.
  // Descriptor capacity is intentionally absent: vector launches speculate
  // through ID and replay precisely if the WB sink cannot admit them.
  // State observers must also wait for older launches that have not reached
  // the vector sink yet; its registered active flag cannot cover those tokens.
  def id_vector_launch_pending = id_vector_launch_matches(fun (_control, _rd): Bool(#true))
  // Preserve pre-admission memory ordering while independent scalar work
  // speculates on a one-page certificate that MEM and WB may establish.
  def id_vector_load_launch_pending = id_vector_launch_matches(fun (control :: RV5StageVectorControl(), _rd): control.memory & !control.store)
  def id_vector_store_launch_pending = id_vector_launch_matches(fun (control :: RV5StageVectorControl(), _rd): control.memory & control.store)
  def id_vector_memory_order_pending = (id_vector_load_launch_pending & id_memory_operation.needs_unique()) ||| (id_vector_store_launch_pending & id_memory_operation.is_memory())
  // A nonzero vstart still waits for the older WB reset.
  def id_vector_start_pending = id_vector_instruction & wb_csrs.vector_state.vstart.or_reduce() & id_vector_launch_pending
  def id_vector_fp_pending = wb_vector_fp_pending ||| id_vector_launch_matches(fun (control :: RV5StageVectorControl(), _rd): control.floating_point)
  def id_vector_wait = wb_vector_certification_pending ||| wb_vector_slow_admission ||| id_vector_memory_order_pending ||| id_vector_start_pending ||| (id_vector_instruction & wb_vector_integer_write_pending) ||| ((wb_vector_active ||| id_vector_launch_pending) & (core_serializing_operation(id_control.system, id_control.fence) ||| id_management)) ||| (wb_vector_loads_pending & id_memory_operation.needs_unique()) ||| (wb_vector_stores_pending & id_memory_operation.is_memory()) ||| ((wb_vector_fp_write_pending ||| id_vector_fp_pending) & id_control.floating_point_valid)
  def id_hazard_reasons = RV5StageHazardReasons():
    deferred_dependency: id_deferred_dependency_hazard
    scoreboard_raw: id_scoreboard_raw_hazard
    scoreboard_waw: id_scoreboard_waw_hazard
    fp_source: id_fp_source_hazard ||| id_vector_fp_source_hazard
    fp_destination: id_fp_destination_hazard ||| id_vector_fp_destination_hazard
    resource: id_local_resource_hazard ||| id_vector_wait
    pause: id_pause_in_flight ||| if_pause_active
    serialization: id_serializing_in_flight ||| id_serializing_waits_for_older
    wfi: if_waiting_for_interrupt
    interrupt_pending: wb_csrs.interrupt_request
    exception: if_exception_in_flight
  def id_pipeline_hazard = core_hazard_any(id_hazard_reasons)
  // Operand probes are read-only and may repeat while ID waits. Keeping them
  // independent of transfer/replay avoids feeding WB readiness into FP reads.
  wb_fp.store_request.valid <== id_instructions.fetched.valid & id_fp_store
  wb_fp.store_request.bits <== RV5StageFpStoreRequest(Bits(width)):
    context: id_decode_bits.pc
    precision: id_fp_execution_control.source_precision
    rs: id_rs2
  def id_traced_decode:
    id_instructions.fetched
      |> filter_flow(_fetched => !if_squash)
      |> trace_event("core/s2.decode", ~stalls: #true, ~fields: operation):
           pc: operation.pc
           instruction(~format: "riscv", ~isa: trace_isa, ~pc: "pc"): operation.raw_instruction
           deferred_dependency: id_hazard_reasons.deferred_dependency
           raw_hazard: id_hazard_reasons.scoreboard_raw
           waw_hazard: id_hazard_reasons.scoreboard_waw
           fp_source_hazard: id_hazard_reasons.fp_source
           fp_destination_hazard: id_hazard_reasons.fp_destination
           resource_hazard: id_hazard_reasons.resource
           pause: id_hazard_reasons.pause
           serialization: id_hazard_reasons.serialization
           wfi: id_hazard_reasons.wfi
           interrupt: id_hazard_reasons.interrupt_pending
           exception: id_hazard_reasons.exception
  def id_operation:
    // Observe the live offer before the gate hides valid; only admission advances ID/EX.
    id_traced_decode |> gate_flow(!id_pipeline_hazard) |> map_flow(fetched => DecodeExecute(xlen, vector_completion_slots)):
          vector_launch: id_vector_instruction & !id_fault
          pc: fetched.pc
          instruction: fetched.instruction
          raw_instruction: fetched.raw_instruction
          sequential_pc: fetched.sequential_pc
          predicted_next_pc: fetched.predicted_next_pc
          predicted_ras_action: fetched.predicted_ras_action
          alu_control: id_control.alu
          vector_control: id_control.vector
          operand_left: id_control.operand.left
          operand_right: id_control.operand.right
          pointer_masking: wb_csrs.pointer_masking
          branch_control: id_control.branch.resolver
          target_from_rs1: id_control.branch.target_from_rs1
          memory_operation: id_memory_operation
          prefetch_operation: id_control.prefetch
          memory_atomic: id_control.memory.atomic
          memory_width: id_control.memory.width
          memory_unsigned: id_control.memory.unsigned
          multiply_control: id_control.multiply
          divide_control: id_control.divide
          floating_point_valid: id_control.floating_point_valid
          floating_point_control: id_control.floating_point
          floating_point_rounding_mode_valid: id_fp_rounding.valid
          floating_point_rounding_mode: id_fp_rounding.mode
          writeback_enable: id_control.writeback.enable
          writeback_source: id_control.writeback.source
          system: id_control.system
          fence: id_control.fence
          hint: id_control.hint
          illegal: id_illegal
          instruction_page_fault: fetched.instruction_page_fault
          instruction_access_fault: fetched.instruction_access_fault
          instruction_fault_address: fetched.instruction_fault_address
          immediate: id_immediate
          rs1: id_rs1
          rs2: id_rs2
          operand_rs1: id_operand(id_rs1, id_registers.read_data_1)
          operand_rs2: id_operand(id_rs2, id_registers.read_data_2)
          rd: id_rd
          frs3: id_frs3
  def Array(id_execute, id_multiply_admission) = id_operation |> to_valid() |> fork_valid(2)
  id_execute |> id_ex_pipe.ingress
  def id_multiply_reservation = id_multiply_admission |> filter_valid(_operation => Bool(wb_pipelined_multiplier) & id_needs_multiplier & !id_fault)
  id_multiply_admitted <== id_multiply_reservation.valid
  id_multiply_reservation |> map_valid(_operation => bits(PipelinedMultiplierStages + 1, 4)) |> to_decoupled() |> wb_gpr_calendar.reserve[2]
  if vector_enabled
  | block:
      inst wb_vector(RV5StageVectorPipeline(xlen, vector_length, ~vector_completion_slots: vector_completion_slots, ~trace_isa: trace_isa, ~multiply_latency: if wb_pipelined_multiplier | PipelinedMultiplierStages | #false, ~fixed_fp: #true))
      wb_vector.scalar_writeback |> wb_gpr_calendar.reserve[1]
      inst wb_vector_retirement(OfferRegister(MemoryWriteback(xlen, vector_completion_slots)))
      def wb_vector_context = wb_offer_bits.vector_context
      def wb_vector_vd = instruction_field(riscv_fields.rd, wb_vector_context.instruction)
      wb_fp.snapshot_read_address <== instruction_field(riscv_fields.rs1, wb_vector_context.instruction)
      inst ex_vector_operation_legality(RV5StageVectorOperationLegality(xlen, vector_length, core_profile.vector, vector_extensions))
      ex_vector_operation_legality.instruction <== ex_input.bits.instruction
      ex_vector_operation_legality.control <== ex_input.bits.vector_control
      ex_vector_operation_legality.vtype <== ex_vector_snapshot.vtype
      ex_vector_operation_legality.vstart <== ex_vector_snapshot.vstart
      ex_vector_operation_legal <== ex_vector_operation_legality.legal
      wb_vector_active <== wb_vector.active ||| wb_vector_integer_write_pending
      wb_vector_certification_pending <== wb_vector.certification_pending
      wb_vector_loads_pending <== wb_vector.loads_pending
      wb_vector_fp_pending <== wb_vector.fp_pending
      wb_vector.precheck |> vector_precheck
      wb_vector_stores_pending <== wb_vector.stores_pending
      wb_vector_fp_write_pending <== wb_vector.fp_pending
      wb_vector.multiply_request |> wb_vector_multiply_request_link.left
      wb_vector_multiply_result_link.right |> wb_vector.multiply_result
      wb_vector.divide_request |> wb_vector_divide_request_link.left
      wb_vector_divide_result_link.right |> wb_vector.divide_result
      wb_vector.fp_request |> wb_vector_fp_request_link.left
      wb_vector_fp_result_link.right |> wb_vector.fp_result
      wb_vector.fp_update |> wb_vector_fp_update_link.left
      wb_vector.memory <=> memory_ports.vector
      wb_vector.pipeline <=> memory_ports.vector_pipeline
      def wb_vector_masking_unchanged = (wb_vector_context.pointer_masking.mode === wb_csrs.pointer_masking.mode) & (wb_vector_context.pointer_masking.virtual_address === wb_csrs.pointer_masking.virtual_address)
      def wb_vector_fast_candidate = wb_offer_bits.vector_fast_valid & vector_fast.install_ready & wb_vector.fast_admission_ready & wb_vector_masking_unchanged
      def wb_vector_launch = wb_vector_launch_path |> filter_valid(operation => operation.vector_launch & !operation.replay & !operation.exception_valid)
        |> map_valid(operation => RV5StageVectorDescriptor(xlen)):
             pc: operation.pc
             precertified: wb_vector_fast_candidate
             instruction: wb_vector_context.instruction
             state: wb_vector_context.state
             control: wb_vector_context.control
             scalar: wb_vector_context.scalar
             floating_scalar: wb_fp.snapshot_read_data[0..width]
             stride: wb_vector_context.stride
             masked: !wb_vector_context.instruction[25].into(Bool)
             rounding_mode: wb_csrs.frm.into(RoundingMode)
             pointer_masking: wb_vector_context.pointer_masking
      def wb_vector_needs_fp_reservation = wb_vector_launch.bits.control.floating_scalar_destination
      def wb_vector_sink_ready = wb_vector.request.ready & (!wb_vector_needs_fp_reservation ||| wb_fp.vector_reserve.ready)
      def wb_vector_accepted = wb_vector_launch.valid & wb_vector_sink_ready
      wb_vector_fast <== wb_vector_accepted & wb_vector_fast_candidate & wb_vector_launch.bits.control.memory
      wb_vector_slow_admission <== wb_vector_accepted & wb_vector_launch.bits.control.memory & !wb_vector_fast
      wb_vector_slow_restart <== wb_vector_slow_admission & (mem_input.valid ||| ex_input.valid)
      vector_fast.install.valid <== wb_vector_fast
      vector_fast.install.bits <== wb_offer_bits.vector_fast
      wb_vector_launch |> filter_valid(_descriptor => !wb_vector_needs_fp_reservation ||| wb_fp.vector_reserve.ready) |> offer_decoupled() |> wb_vector.request
      wb_vector_launch |> filter_valid(descriptor => descriptor.control.floating_scalar_destination & wb_vector.request.ready) |> map_valid(_descriptor => wb_vector_vd) |> offer_decoupled() |> wb_fp.vector_reserve
      wb_vector_replay <== wb_vector_launch.valid & !wb_vector_sink_ready
      wb_vector_launch |> filter_valid(descriptor => wb_vector_accepted & descriptor.control.integer & descriptor.control.scalar_destination & wb_vector_vd.or_reduce()) |> map_valid(_descriptor => wb_vector_vd) |> wb_vector_reserve_link.left
      wb_vector.floating_result |> wb_fp.vector_write
      assert(!wb_vector_accepted ||| wb_input.valid, "vector_admission_has_live_wb_instruction")
      wb_vector_retention_path |> filter_valid(operation => wb_vector_accepted & operation.vector_context.control.memory & !wb_vector_fast) |> wb_vector_retirement.update
      assert(!wb_vector.outcome.valid ||| wb_vector_retirement.egress.valid, "vector_outcome_has_retained_instruction")
      (
        wb_vector_retirement.egress |> gate_flow(wb_vector.outcome.valid) |> to_valid() |> map_valid(operation => operation.updated(
          ~vector_launch: Bool(#false),
          ~write_enable: Bool(#false),
          ~exception_valid: wb_vector.outcome.bits.disposition === RV5StageVectorDisposition.Fault,
          ~exception_cause: wb_vector.outcome.bits.cause,
          ~exception_value: wb_vector.outcome.bits.fault_address
        ))
      ) |> wb_vector_retirement_link.left
      wb_vector_truncate <== wb_vector.outcome.valid & (wb_vector.outcome.bits.disposition === RV5StageVectorDisposition.Truncate)
      wb_vector.fault_start |> wb_csrs.vector_fault_start
      wb_vector.truncate |> wb_csrs.vector_truncate
      wb_csrs.vector_retire.valid <== wb_vector.retire.valid ||| (wb_commit_valid & wb_commit_bits.vector_launch & !wb_commit_bits.exception_valid)
      wb_vector.saturate |> wb_csrs.vector_saturate
      wb_vector.scalar_result |> wb_vector_scalar_result_link.left
      assert(!(wb_vector_accepted & wb_vector_replay), "rv5stage_wb_vector_accept_does_not_replay")
      assert(!wb_vector_replay ||| !wb_vector.request.fire(), "rv5stage_wb_vector_replay_has_no_admission")
  | block:
      wb_vector_retirement_link.left.valid <== Bool(#false)
      wb_gpr_calendar.reserve[1].valid <== Bool(#false)
      wb_gpr_calendar.reserve[1].bits <== bits(1, 4)
      wb_vector_retirement_link.left.bits <== dont_care(MemoryWriteback(xlen, vector_completion_slots))
      wb_vector_truncate <== Bool(#false)
      wb_vector_fast <== Bool(#false)
      wb_vector_slow_admission <== Bool(#false)
      wb_vector_slow_restart <== Bool(#false)
      vector_fast.install.valid <== Bool(#false)
      vector_fast.install.bits <== dont_care(RV5StageVectorFastCertificate(xlen))
      memory_ports.vector.request.valid <== Bool(#false)
      memory_ports.vector.request.bits <== dont_care(RV5StageDataReq(xlen, vector_completion_slots))
      memory_ports.vector.response.ready <== Bool(#true)
      memory_ports.vector_pipeline.request.valid <== Bool(#false)
      memory_ports.vector_pipeline.request.bits <== dont_care(RV5StagePipelineReq(xlen))
      memory_ports.vector_pipeline.commit <== Bool(#false)
      wb_fp.snapshot_read_address <== bits(0, 5)
      wb_vector_multiply_request_link.left.valid <== Bool(#false)
      wb_vector_multiply_request_link.left.bits <== dont_care(RV5StageExecutionRequest(MultiplierRequest(width), wb_vector_multiply_tag))
      wb_vector_multiply_result_link.right.ready <== Bool(#true)
      wb_vector_divide_request_link.left.valid <== Bool(#false)
      wb_vector_divide_request_link.left.bits <== dont_care(RV5StageExecutionRequest(DividerRequest(width), wb_vector_divide_tag))
      wb_vector_divide_result_link.right.ready <== Bool(#true)
      wb_vector_fp_request_link.left.valid <== Bool(#false)
      wb_vector_fp_request_link.left.bits <== dont_care(RV5StageFpExecutionRequest(xlen, effective_fp_profile, wb_vector_fp_tag))
      wb_vector_fp_result_link.right.ready <== Bool(#true)
      wb_vector_fp_update_link.left.valid <== Bool(#false)
      wb_vector_fp_update_link.left.bits <== bits(0, 5)
      wb_vector_active <== Bool(#false)
      wb_vector_replay <== Bool(#false)
      ex_vector_operation_legal <== Bool(#false)
      wb_vector_certification_pending <== Bool(#false)
      wb_vector_loads_pending <== Bool(#false)
      wb_vector_fp_pending <== Bool(#false)
      wb_vector_reserve_link.left.valid <== Bool(#false)
      wb_vector_reserve_link.left.bits <== bits(0, 5)
      vector_precheck.request.valid <== Bool(#false)
      vector_precheck.request.bits <== dont_care(RV5StageVectorRange())
      vector_precheck.response.ready <== Bool(#true)
      vector_precheck.release.valid <== Bool(#false)
      wb_vector_stores_pending <== Bool(#false)
      wb_vector_fp_write_pending <== Bool(#false)
      wb_fp.vector_reserve.valid <== Bool(#false)
      wb_fp.vector_reserve.bits <== bits(0, 5)
      wb_fp.vector_write.valid <== Bool(#false)
      wb_fp.vector_write.bits <== dont_care(FloatingPointRegisterWrite(effective_fp_profile))
      wb_vector_scalar_result_link.left.valid <== Bool(#false)
      wb_vector_scalar_result_link.left.bits <== dont_care(RegisterFileWrite(xlen))
      wb_csrs.vector_fault_start.valid <== Bool(#false)
      wb_csrs.vector_fault_start.bits <== zero
      wb_csrs.vector_truncate.valid <== Bool(#false)
      wb_csrs.vector_truncate.bits <== zero
      wb_csrs.vector_retire.valid <== Bool(#false)
      wb_csrs.vector_saturate.valid <== Bool(#false)

  // Stage 3: EX uses only registered selectors and data. A killed producer's younger
  // consumer is canceled independently; it does not select an older operand.
  // The WB selector names the normal pipeline token, not retained retirement context.
  fun ex_forwarded_register_value(operand :: RV5StageOperand(xlen)):
    operand.stage_sel.mux({
      RV5StageBypassStage.RegisterFile: operand.value,
      RV5StageBypassStage.Memory: mem_input.bits.result,
      RV5StageBypassStage.Writeback: wb_input.bits.value
    })
  assert(enum_valid(ex_input.bits.operand_rs1.stage_sel), "rv5stage_rs1_bypass_stage_is_one_hot")
  assert(enum_valid(ex_input.bits.operand_rs2.stage_sel), "rv5stage_rs2_bypass_stage_is_one_hot")
  def ex_forwarded_rs1 = ex_forwarded_register_value(ex_input.bits.operand_rs1)
  def ex_forwarded_rs2 = ex_forwarded_register_value(ex_input.bits.operand_rs2)
  ex_vector_resolved_rs1 <== ex_forwarded_rs1
  ex_vector_resolved_rs2 <== ex_forwarded_rs2

  ex_alu.left <== mux_lookup(
    ex_input.bits.operand_left,
    ~default: ex_forwarded_rs1,
    [
      [OperandASelect.Pc, ex_input.bits.pc],
      [OperandASelect.Zero, bits(0, width)]
    ]
  )
  ex_alu.right <== mux(ex_input.bits.vector_launch & ex_input.bits.vector_control.memory, ex_vector_geometry.start_offset[0..width], mux(ex_input.bits.operand_right === OperandBSelect.Immediate, ex_input.bits.immediate, ex_forwarded_rs2))
  ex_alu.control <== ex_input.bits.alu_control

  def ex_redirect_requested = ex_branch_resolver.result.bits.taken
  def ex_redirect_target :: Bits(width) = mux(
    ex_input.bits.target_from_rs1,
    (ex_forwarded_rs1 + ex_input.bits.immediate) & !bits(1, width),
    ex_input.bits.pc + ex_input.bits.immediate
  )
  def ex_redirect_aligned = ex_redirect_target.is_aligned(instruction_alignment)
  def ex_memory_operation = mux(ex_input.bits.vector_launch, RV5StageMemoryOperation.None, ex_input.bits.memory_operation)
  def ex_memory_address = if extensions.ssnpm | apply_pointer_mask(xlen, ex_alu.result, ex_input.bits.pointer_masking) | ex_alu.result
  def ex_memory_aligned = ex_memory_operation.is_cache_block() ||| ex_input.bits.memory_width.is_aligned(ex_memory_address)
  def ex_is_memory = ex_memory_operation.is_memory()
  def ex_fp_execution_control = ex_input.bits.floating_point_control.execution
  def ex_is_fp = ex_input.bits.floating_point_valid & !ex_input.bits.vector_launch
  def ex_fp_memory = ex_is_fp & (ex_fp_execution_control.unit === RV5StageFloatUnit.Memory)
  def ex_fp_store = ex_fp_memory & ex_fp_execution_control.memory_write
  def ex_fp_load = ex_fp_memory & !ex_fp_execution_control.memory_write
  def ex_fp_compute = ex_is_fp & !ex_fp_memory
  // vset executes in EX. Older in-flight results take priority over committed
  // state so configurations and vector launches can consume its state directly.
  def ex_is_vector_config = ex_input.bits.system.action === RV5StageSystemOperation.VectorConfig
  def ex_mem_vector_config = mem_input.valid & (mem_input.bits.system.action === RV5StageSystemOperation.VectorConfig) & !mem_input.bits.replay & !mem_input.bits.exception_valid
  def ex_wb_vector_config = wb.valid & (wb_offer_bits.system.action === RV5StageSystemOperation.VectorConfig) & !wb_offer_bits.replay & !wb_offer_bits.exception_valid
  def ex_vector_base_state = mux(ex_mem_vector_config, mem_input.bits.vector_context.state, mux(ex_wb_vector_config, wb_offer_bits.vector_context.state, wb_csrs.vector_state))
  def ex_vector_config = vector_configuration_request(xlen, ex_input.bits.vector_control.configure, ex_input.bits.instruction, ex_forwarded_rs1, ex_forwarded_rs2)
  def ex_vector_configuration = vector_configure(xlen, vector_length, ex_vector_config, ex_vector_base_state.vtype, ex_vector_base_state.vl[0..index_width(vector_length + 1)], ~elen: vector_elen)
  def ex_configured_vector_state = RiscvVectorState(xlen):
    vl: ex_vector_configuration.vl.zext(width)
    vtype: ex_vector_configuration.vtype
    vstart: zero
    vxrm: ex_vector_base_state.vxrm
    vxsat: ex_vector_base_state.vxsat
  ex_vector_snapshot <== mux(ex_is_vector_config, ex_configured_vector_state, ex_vector_base_state)
  ex_vector_geometry <== vector_footprint_geometry(xlen, vector_length, ex_input.bits.vector_control, ex_input.bits.instruction, ex_vector_snapshot)
  def ex_vector_illegal = (ex_input.bits.vector_launch & !ex_vector_operation_legal) ||| (ex_is_vector_config & ex_vector_configuration.illegal)
  def ex_request_fault = ex_input.bits.instruction_page_fault ||| ex_input.bits.instruction_access_fault ||| ex_input.bits.illegal ||| ex_vector_illegal ||| (
    ex_is_memory & !ex_memory_aligned
  )
  def ex_redirect_fault = !ex_input.bits.vector_launch & ex_redirect_requested & !ex_redirect_aligned
  fun ex_make_exception(cause :: ExceptionCause, value :: Bits(width)):
    RV5StageException(xlen):
      valid: Bool(#true)
      cause: exception_cause_bits(cause, width)
      value: value
  wire ex_exception: RV5StageException(xlen)
  when (ex_input.bits.instruction_access_fault):
    ex_exception <== ex_make_exception(ExceptionCause.InstructionAccessFault, ex_input.bits.instruction_fault_address)
  elsewhen (ex_input.bits.instruction_page_fault):
    ex_exception <== ex_make_exception(ExceptionCause.InstructionPageFault, ex_input.bits.instruction_fault_address)
  elsewhen (ex_input.bits.illegal ||| ex_vector_illegal):
    ex_exception <== ex_make_exception(ExceptionCause.IllegalInstruction,
                                       core_instruction_value(ex_input.bits.raw_instruction))
  elsewhen ex_redirect_fault:
    ex_exception <== ex_make_exception(ExceptionCause.InstructionAddressMisaligned,
                                       ex_redirect_target)
  elsewhen (ex_is_memory & !ex_memory_aligned):
    ex_exception <== core_data_exception(ex_memory_operation,
                                         ex_memory_address,
                                         ExceptionCause.StoreAddressMisaligned,
                                         ExceptionCause.LoadAddressMisaligned)
  otherwise:
    ex_exception <== RV5StageException(xlen):
      valid: Bool(#false)
      cause: dont_care(Bits(width))
      value: dont_care(Bits(width))
  def ex_csr_source = mux(
    ex_input.bits.system.immediate,
    ex_input.bits.instruction[15..20].zext(width),
    ex_forwarded_rs1
  )
  def ex_result = mux_lookup(
    ex_input.bits.writeback_source,
    ~default: ex_alu.result,
    [[RV5StageWritebackSelect.Zero, zero],
     [RV5StageWritebackSelect.SequentialPc, ex_input.bits.sequential_pc]]
  )
  def ex_multiply_issue = RV5StageMultiplyIssue(xlen):
    left: ex_forwarded_rs1
    right: ex_forwarded_rs2
    control: ex_input.bits.multiply_control
    rd: ex_input.bits.rd
  def ex_divide_issue = RV5StageDivideIssue(xlen):
    dividend: ex_forwarded_rs1
    divisor: ex_forwarded_rs2
    control: ex_input.bits.divide_control
    rd: ex_input.bits.rd
  def ex_fp_issue = RV5StageFpIssue(xlen, effective_fp_profile, Bits(width)):
    context: ex_input.bits.pc
    control: ex_input.bits.floating_point_control
    frs1: ex_input.bits.rs1
    frs2: ex_input.bits.rs2
    frs3: ex_input.bits.frs3
    frd: ex_input.bits.rd
    integer_operand: ex_forwarded_rs1
    rounding_mode: ex_input.bits.floating_point_rounding_mode
  // EX prepares memory/FP operands; only the pipelined multiplier may launch
  // pure arithmetic here. A missing store-read result becomes a replay, while
  // architectural effects still require WB authorization.
  def ex_prefetch_request = CachePrefetchReq(width):
    address: ex_memory_address
    operation: ex_input.bits.prefetch_operation
  def ex_fp_store_response_match = wb_fp.store_response.valid & (
    wb_fp.store_response.bits.context === ex_input.bits.pc
  )
  def ex_fp_store_replay = ex_transfer & ex_fp_store & !ex_exception.valid & !ex_fp_store_response_match
  def ex_replay = ex_fp_store_replay
  assert(!(ex_replay & ex_exception.valid),
         "rv5stage_execute_fault_does_not_replay")
  ex_branch_resolver.request.valid <== ex_transfer & !ex_input.bits.vector_launch
  ex_branch_resolver.request.bits <== BranchResolverRequest(width):
    left: ex_forwarded_rs1
    right: ex_forwarded_rs2
    control: ex_input.bits.branch_control

  def ex_fp_memory_writeback = RV5StageFpMemoryWriteback():
    rd: ex_input.bits.rd
    precision: ex_fp_execution_control.destination_precision
  def ex_data_request = RV5StageDataReq(xlen, vector_completion_slots):
    byte_mask: memory_byte_mask(xlen, ex_memory_address, ex_input.bits.memory_width)
    address: ex_memory_address
    access: ex_memory_operation
    atomic: ex_input.bits.memory_atomic
    width: ex_input.bits.memory_width
    unsigned: ex_input.bits.memory_unsigned
    data: mux(ex_fp_store,
              if xlen == XLen.X32 | wb_fp.store_response.bits.data[0..32] | wb_fp.store_response.bits.data,
              ex_forwarded_rs2)
    writeback: mux(
      ex_fp_load,
      RV5StageMemoryWriteback(vector_completion_slots).FloatingPoint(ex_fp_memory_writeback),
      mux(ex_memory_operation.returns_result(),
          RV5StageMemoryWriteback(vector_completion_slots).Integer(ex_input.bits.rd),
          RV5StageMemoryWriteback(vector_completion_slots).Ack)
    )
    origin: RV5StageDataOrigin.Core
    locality: RiscvMemoryLocality.Default

  // Both ordinary operations use EX/MEM lookup. Only WB authorizes a store;
  // lookup itself cannot change the cache or initiate an external transaction.
  def ex_lookup_payload = RV5StagePipelineReq(xlen):
    byte_mask: ex_data_request.byte_mask
    address: ex_memory_address
    access: ex_memory_operation
    width: ex_input.bits.memory_width
    unsigned: ex_input.bits.memory_unsigned
    data: ex_data_request.data

  def ex_resume_pc = mux(ex_input.bits.vector_launch, ex_input.bits.sequential_pc, mux(ex_redirect_requested, ex_redirect_target, ex_input.bits.sequential_pc))
  def ex_vector_context = RV5StageVectorLaunchContext(xlen):
    pointer_masking: ex_input.bits.pointer_masking
    instruction: ex_input.bits.instruction
    control: ex_input.bits.vector_control
    state: ex_vector_snapshot
    scalar: ex_vector_resolved_rs1
    stride: ex_vector_resolved_rs2
  def ex_ras_action = rv5stage_ras_action(ex_input.bits.instruction)
  def ex_ras_mispredicted = ex_ras_action =/= ex_input.bits.predicted_ras_action
  def ex_next_pc_mispredicted = ex_resume_pc =/= ex_input.bits.predicted_next_pc
  def ex_redirect_valid = (ex_next_pc_mispredicted ||| ex_ras_mispredicted) & !ex_exception.valid
  def ex_payload = ExecuteMemory(xlen, vector_completion_slots):
    vector_launch: ex_input.bits.vector_launch
    vector_context: ex_vector_context
    vector_fast_first: ex_memory_address
    vector_fast_no_wrap: !ex_vector_geometry.start_offset[width..68].or_reduce() & (ex_alu.result >= ex_forwarded_rs1)
    vector_fast_geometry: ex_vector_geometry
    pc: ex_input.bits.pc
    resume_pc: ex_resume_pc
    redirect_valid: ex_redirect_valid
    branch_prediction: mux(!ex_input.bits.vector_launch & ex_input.bits.branch_control.enable, mux(ex_next_pc_mispredicted, RV5StageBranchPrediction.Mispredicted, RV5StageBranchPrediction.Correct), RV5StageBranchPrediction.NotBranch)
    branch_update:
      RV5StageBranchUpdate(xlen):
        pc: ex_input.bits.pc
        target: ex_redirect_target
        branch: ex_input.bits.branch_control.enable
        conditional: !ex_input.bits.branch_control.unconditional
        taken: ex_redirect_requested
        compressed: ex_input.bits.sequential_pc === (ex_input.bits.pc + bits(2, width))
        ras_action: ex_ras_action
        predicted_ras_action: ex_input.bits.predicted_ras_action
        return_address: ex_input.bits.sequential_pc
    raw_instruction: ex_input.bits.raw_instruction
    replay: ex_replay
    data_request_valid: ex_is_memory & !ex_request_fault & !ex_replay
    data_request: ex_data_request
    fp_compute: ex_fp_compute
    fp_issue: ex_fp_issue
    prefetch: ex_prefetch_request
    writeback_source: ex_input.bits.writeback_source
    writeback_enable: ex_input.bits.writeback_enable & !ex_input.bits.vector_launch & !ex_exception.valid
    rd: ex_input.bits.rd
    result: mux(ex_is_vector_config, ex_vector_configuration.vl.zext(width), ex_result)
    multiply_issue: ex_multiply_issue
    divide_issue: ex_divide_issue
    system: ex_input.bits.system
    fence: ex_input.bits.fence
    hint: ex_input.bits.hint
    csr_address: ex_input.bits.instruction[20..32]
    csr_source: ex_csr_source
    vector_config: ex_vector_config
    exception_valid: ex_exception.valid
    exception_cause: ex_exception.cause
    exception_value: ex_exception.value

  def ex_traced = ex_input |> filter_valid(_operation => ex_transfer)
    |> trace_valid_event("core/s3.execute", ~fields: operation):
         pc: operation.pc
         instruction(~format: "riscv", ~isa: trace_isa, ~pc: "pc"): operation.raw_instruction
  def Array(ex_context_path, ex_lookup_path, ex_multiply_path) = ex_traced |> fork_valid(3)
  if wb_pipelined_multiplier
  | block:
      ex_multiply_path |> filter_valid(operation => !ex_exception.valid & !ex_replay & (operation.writeback_source === RV5StageWritebackSelect.Multiply) & operation.writeback_enable & operation.rd.or_reduce()) |> map_valid(_operation => ex_multiply_issue) |> wb_multiplier.issue
  | #void
  ex_context_path |> map_valid(_operation => ex_payload) |> ex_mem_pipe.ingress
  ex_lookup_path |> filter_valid(_operation => !ex_exception.valid & ex_memory_operation.is_one_of(RV5StageMemoryOperation.Load, RV5StageMemoryOperation.Store))
    |> map_valid(_operation => ex_lookup_payload) |> scalar_pipeline.request

  // Stage 4: MEM resolves the parallel DTLB/tag/data lookup. Capture successful load
  // data at the ordinary MEM/WB boundary, alongside pure integer results.
  def mem_live = mem_input |> filter_valid(_operation => mem_stage_valid) |> trace_valid_event("core/s4.memory", ~fields: operation):
    pc: operation.pc
    instruction(~format: "riscv", ~isa: trace_isa, ~pc: "pc"): operation.raw_instruction
    cache_outcome(~format: "enum"): mem_cache_outcome
    cache_reason(~format: "enum"): mux(scalar_pipeline.response.valid, scalar_pipeline.response.bits.reason, RV5StagePipelineReason.None)
  def mem_vector_geometry = mem_input.bits.vector_fast_geometry
  def mem_vector_first = if xlen == XLen.X32 | mem_input.bits.vector_fast_first.zext(64) | mem_input.bits.vector_fast_first
  def mem_vector_span_fits = mem_vector_geometry.span_bytes <= bits(4096, 68)
  def mem_vector_last_offset = mem_vector_first[0..12].zext(14) + mem_vector_geometry.span_bytes[0..13].zext(14) - bits(1, 14)
  def mem_vector_one_page = mem_vector_span_fits & (mem_vector_last_offset < bits(4096, 14))
  def mem_vector_aligned = (mem_vector_first & ((bits(1, 64) << mem_vector_geometry.eew) - bits(1, 64))) === bits(0, 64)
  vector_fast.request.valid <== mem_stage_valid & mem_input.bits.vector_launch & mem_vector_geometry.eligible & !mem_vector_geometry.empty & mem_input.bits.vector_fast_no_wrap & mem_vector_one_page & mem_vector_aligned & !mem_input.bits.replay & !mem_input.bits.exception_valid
  vector_fast.request.bits <== RV5StageVectorRange():
    first: mem_vector_first.align_down(width / 8)
    last: (mem_vector_first[12..64] ++ mem_vector_last_offset[0..12]) ||| bits(width / 8 - 1, 64)
    store: mem_input.bits.vector_context.control.store
  def Array(mem_context_path, mem_to_if_exception_path, mem_to_if_replay_path, mem_prediction_path) = mem_live |> fork_valid(4)
  def Array(mem_capture, missing_response) = mem_context_path |> fork_valid(2)
  def returned = scalar_pipeline.response |> filter_valid(_result => mem_stage_valid)
  def absent = missing_response |> filter_valid(_operation => !scalar_pipeline.response.valid)
    |> map_valid(_operation => scalar_pipeline.response.bits)
  def memory_result = Array(returned, absent) |> valid_arbiter()
  // Pair the current instruction and its optional same-cycle LSU result before
  // the existing MEM/WB register. Non-memory instructions use the local fallback.
  def mem_with_result = Array(mem_capture |> to_decoupled(), memory_result |> to_decoupled()) |> zip_flow(operation, response):
    operation.updated(~result: mux(mem_load_hit, response.data, operation.result))
  mem_to_if_exception_path |> filter_valid(operation => operation.exception_valid)
    |> map_valid(operation => operation.pc) |> mem_to_if_exception_link.left
  mem_to_if_replay_path |> filter_valid(operation => operation.replay ||| mem_cache_replay)
    |> map_valid(operation => operation.pc) |> mem_to_if_replay_link.left
  def Array(mem_redirect_path, mem_training_path) = mem_prediction_path
    |> filter_valid(_operation => !mem_exception_event & !mem_replay_event) |> fork_valid(2)
  mem_redirect_path |> filter_valid(operation => operation.redirect_valid)
    |> map_valid(operation => operation.resume_pc) |> mem_to_if_redirect_link.left
  // Nonbranches also train: they remove a stale prediction at this PC.
  mem_training_path |> filter_valid(operation => !operation.vector_launch) |> map_valid(operation => operation.branch_update) |> frontend_control.branch_update
  def mem_to_wb = mem_with_result |> to_valid() |> map_valid(operation => MemoryWriteback(xlen, vector_completion_slots)):
    vector_launch: operation.vector_launch
    vector_context: operation.vector_context
    vector_fast_valid: vector_fast.response.valid
    vector_fast: vector_fast.response.bits
    pc: operation.pc
    resume_pc: operation.resume_pc
    branch_prediction: operation.branch_prediction
    ras_mismatch: operation.branch_update.ras_action =/= operation.branch_update.predicted_ras_action
    raw_instruction: operation.raw_instruction
    replay: operation.replay ||| mem_cache_replay
    load_hit: mem_load_hit
    cache_outcome: mem_cache_outcome
    data_request_valid: operation.data_request_valid & (mem_cache_outcome === RV5StagePipelineOutcome.Slow)
    data_request: operation.data_request
    fp_compute: operation.fp_compute
    fp_issue: operation.fp_issue
    prefetch: operation.prefetch
    writeback_source: mux(mem_load_hit, RV5StageWritebackSelect.Alu, operation.writeback_source)
    write_enable: operation.writeback_enable & !operation.exception_valid & !operation.replay
    rd: operation.rd
    value: operation.result
    multiply_issue: operation.multiply_issue
    divide_issue: operation.divide_issue
    system: operation.system
    fence: operation.fence
    hint: operation.hint
    csr_address: operation.csr_address
    csr_source: operation.csr_source
    vector_config: operation.vector_config
    exception_valid: operation.exception_valid
    exception_cause: operation.exception_cause
    exception_value: operation.exception_value
  mem_to_wb |> mem_wb_pipe.ingress

  // Stage 5: WB authorizes transactions that did not complete as speculative hits.
  // An attempted request
  // either faults, transfers irrevocably, or replays without any side effect.
  // Device reads, misses, and mutations cannot acquire effects speculatively.
  // In-order WB associates NTL with exactly one successor, not one memory
  // access. Rejected dispatch and pipeline replay leave this state untouched.
  reg wb_pending_locality(~init: RiscvMemoryLocality.Default)
  def wb_retiring_locality = mux_lookup(
    wb_commit_bits.hint,
    ~default: RiscvMemoryLocality.Default,
    [[RV5StageHintOperation.NtlP1, RiscvMemoryLocality.P1],
     [RV5StageHintOperation.NtlPall, RiscvMemoryLocality.Pall],
     [RV5StageHintOperation.NtlS1, RiscvMemoryLocality.S1],
     [RV5StageHintOperation.NtlAll, RiscvMemoryLocality.All]]
  )
  when (wb_csrs.redirect.valid):
    wb_pending_locality <== RiscvMemoryLocality.Default
  elsewhen (wb_macro_retire & !wb_commit_bits.exception_valid):
    wb_pending_locality <== wb_retiring_locality
  def wb_attempt = wb_input.valid & !wb_maintenance_pending & !wb_reservation_wait_pending & !wb_reservation_wait_accept & !wb_pending_exception_valid & !wb_offer_bits.replay & !wb_offer_bits.exception_valid
  def wb_memory_attempt = wb_attempt & wb_offer_bits.data_request_valid
  def wb_store_attempt = wb_attempt & (wb_offer_bits.cache_outcome === RV5StagePipelineOutcome.StoreHit)
  scalar_pipeline.commit <== wb_store_attempt
  def wb_fp_memory_writeback = wb_offer_bits.data_request.writeback.view(RV5StageMemoryWriteback(vector_completion_slots).FloatingPoint)
  def wb_fp_load = wb_fp_memory_writeback.valid.into(Bool)
  // Use registered destination availability for request admission. The FP
  // reservation's same-cycle completion bypass must not feed LSU request valid.
  def wb_fp_load_ready = !wb_fp_load ||| !scoreboard_busy(register_count, wb_fp.busy, wb_fp_memory_writeback.payload.rd)
  wire wb_data_fault: Bool
  wire wb_memory_replay: Bool
  wire wb_memory_response_replay: Bool
  // Observe the scalar cache response at its existing MEM/WB capture.
  // Admission qualifies continuation, not whether the S2 response is recorded.
  def wb_memory_response = wb_memory_path
    |> trace_valid_event("dcache/s2.resp", ~when: wb_memory_path.bits.data_request.access.into(RV5StageMemoryOperation).is_memory(), ~fields: operation):
         pc: operation.pc
         instruction(~format: "riscv", ~isa: trace_isa, ~pc: "pc"): operation.raw_instruction
         address: operation.data_request.address
         outcome(~format: "enum"): operation.cache_outcome
         fault: operation.exception_valid ||| operation.cache_outcome.is_one_of(RV5StagePipelineOutcome.PageFault, RV5StagePipelineOutcome.AccessFault) ||| (wb_memory_attempt & wb_data_fault)
         replay: operation.replay ||| wb_memory_response_replay
         admitted: wb_memory_accepted
  def wb_memory_offer = wb_memory_response |> filter_valid(_operation => wb_memory_attempt & wb_fp_load_ready)
    |> map_valid(operation => operation.data_request.updated(
         ~locality: mux(operation.data_request.access.into(RV5StageMemoryOperation).is_one_of(RV5StageMemoryOperation.Load, RV5StageMemoryOperation.Store), wb_pending_locality, RiscvMemoryLocality.Default)
       ))
  // Request validity must not depend on admission or fault-status feedback.
  wb_memory_offer |> offer_decoupled() |> scalar_data.request
  wb_fp_path |> filter_valid(_operation => wb_attempt & wb_offer_bits.fp_compute)
    |> map_valid(operation => operation.fp_issue)
    |> eject_flow(~valid: wb_fp.issue.valid, ~bits: wb_fp.issue.bits)
  def wb_page_fault = (wb_attempt & (wb_offer_bits.cache_outcome === RV5StagePipelineOutcome.PageFault)) ||| (scalar_data.request.valid & scalar_data.request_fault)
  def wb_access_fault = (wb_attempt & (wb_offer_bits.cache_outcome === RV5StagePipelineOutcome.AccessFault)) ||| (scalar_data.request.valid & !wb_page_fault & scalar_data.request_access_fault) ||| (wb_maintenance_done & wb_other_response.bits.access_fault)
  wb_data_fault <== wb_page_fault ||| wb_access_fault
  wb_memory_accepted <== scalar_data.request.fire() & !wb_data_fault
  wb_maintenance_accepted <== wb_memory_accepted & wb_offer_bits.data_request.access.into(RV5StageMemoryOperation).is_cache_management()
  wb_memory_replay <== wb_memory_attempt & (!wb_fp_load_ready ||| (!wb_data_fault & !scalar_data.request.ready))
  def wb_fp_replay = wb_fp.issue.valid & !wb_fp.issue.ready
  def wb_deferred_fp_load_completion = wb_fp_response.valid
  def wb_hit_fp_replay = wb_attempt & wb_offer_bits.load_hit & wb_fp_load & (!wb_fp_load_ready ||| wb_deferred_fp_load_completion)
  def wb_store_replay = wb_store_attempt & !scalar_pipeline.commit_ready
  wb_memory_response_replay <== wb_memory_replay ||| wb_hit_fp_replay ||| wb_store_replay
  def wb_replay = wb_offer_bits.replay ||| wb_memory_replay ||| wb_fp_replay ||| wb_hit_fp_replay ||| wb_store_replay ||| wb_vector_replay
  wire wb_exception: RV5StageException(xlen)
  when (wb_offer_bits.exception_valid):
    wb_exception <== RV5StageException(xlen):
      valid: Bool(#true)
      cause: wb_offer_bits.exception_cause
      value: wb_offer_bits.exception_value
  elsewhen wb_page_fault:
    wb_exception <== core_data_exception(wb_offer_bits.data_request.access, wb_offer_bits.data_request.address, ExceptionCause.StorePageFault, ExceptionCause.LoadPageFault)
  elsewhen wb_access_fault:
    wb_exception <== core_data_exception(wb_offer_bits.data_request.access, wb_offer_bits.data_request.address, ExceptionCause.StoreAccessFault, ExceptionCause.LoadAccessFault)
  elsewhen wb_reservation_wait_illegal:
    wb_exception <== RV5StageException(xlen):
      valid: Bool(#true)
      cause: exception_cause_bits(ExceptionCause.IllegalInstruction, width)
      value: core_instruction_value(wb_offer_bits.raw_instruction)
  otherwise:
    wb_exception <== RV5StageException(xlen):
      valid: Bool(#false)
      cause: dont_care(Bits(width))
      value: dont_care(Bits(width))
  wb_commit_result <== wb_offer_bits.updated(
    ~replay: wb_replay,
    ~write_enable: wb_offer_bits.write_enable & !wb_exception.valid & !wb_replay,
    ~exception_valid: wb_exception.valid & !wb_vector_truncate,
    ~exception_cause: wb_exception.cause,
    ~exception_value: wb_exception.value
  )
  def wb_fp_load_reservation:
    wb_fp_reservation_path |> filter_valid(_operation => wb_memory_accepted & wb_fp_load)
      |> map_valid(operation => RV5StageFpLoadReservation(Bits(width))):
           context: operation.pc
           precision: operation.data_request.writeback.view(RV5StageMemoryWriteback(vector_completion_slots).FloatingPoint).payload.precision
           rd: operation.data_request.writeback.view(RV5StageMemoryWriteback(vector_completion_slots).FloatingPoint).payload.rd
  wb_fp_load_reservation |> to_decoupled() |> wb_fp.load_reserve
  (
    wb_fp_hit_path |> filter_valid(operation => wb_attempt & operation.load_hit & wb_fp_load & !wb_hit_fp_replay)
      |> map_valid(operation => RV5StageFpLoadCompletion(Bits(width))):
           context: operation.pc
           precision: operation.data_request.writeback.view(RV5StageMemoryWriteback(vector_completion_slots).FloatingPoint).payload.precision
           rd: operation.data_request.writeback.view(RV5StageMemoryWriteback(vector_completion_slots).FloatingPoint).payload.rd
           data: if xlen == XLen.X32 | operation.value.zext(64) | operation.value
  ) |> wb_fp.load_hit
  wb_prefetch_path |> filter_valid(operation => !operation.replay & !operation.exception_valid & wb_offer_bits.prefetch.into(CachePrefetchReq(width)).operation.into(CachePrefetchOperation).is_prefetch())
    |> map_valid(operation => operation.prefetch) |> prefetch
  assert(!(wb_data_fault & wb_memory_replay), "rv5stage_wb_fault_does_not_replay")
  assert(!(wb_memory_accepted & wb_replay), "rv5stage_wb_memory_accept_does_not_replay")
  assert(!(wb_fp.issue.fire() & wb_replay), "rv5stage_wb_fp_accept_does_not_replay")

  // Retirement and architectural side effects. Older authorized work must
  // finish before entering a precise trap. Younger
  // speculative pipeline occupancy is not outstanding architectural work.
  def wb_current_exception_wait = wb_commit_valid & wb_commit_bits.exception_valid & (wb_deferred_results_pending ||| wb_vector_active ||| !scalar_data.drained)
  def wb_architectural_commit = mux(wb_pending_exception_valid, wb_pending_exception, wb_commit_bits)
  def wb_pending_exception_ready = wb_pending_exception_valid & !wb_deferred_results_pending & !wb_vector_active & scalar_data.drained
  wb_csrs.interrupt_boundary <== !wb_vector_active & !wb_maintenance_pending & !wb_reservation_wait_pending & !wb_reservation_wait_accept & !wb_pending_exception_valid & !ex_input.valid & !mem_input.valid & !wb.valid & !wb_deferred_results_pending & scalar_data.drained
  wb_csrs.interrupt_pc <== mux(wb_commit_replay,
                               wb_commit_bits.pc,
                               mux(wb_commit_valid, wb_commit_bits.resume_pc, if_architectural_pc))
  wb_csrs.commit.valid <== wb_pending_exception_ready ||| (wb_macro_retire & !wb_current_exception_wait)
  wb_csrs.commit.bits <== RV5StageCsrCommit(xlen):
    pc: wb_architectural_commit.pc
    instruction: wb_architectural_commit.raw_instruction
    rd: wb_architectural_commit.rd
    system: wb_architectural_commit.system
    fence: wb_architectural_commit.fence
    csr_address: wb_architectural_commit.csr_address
    csr_source: wb_architectural_commit.csr_source
    vector_config: wb_architectural_commit.vector_config
    exception_valid: wb_architectural_commit.exception_valid
    exception_cause: wb_architectural_commit.exception_cause
    exception_value: wb_architectural_commit.exception_value

  when wb_current_exception_wait:
    wb_pending_exception_valid <== Bool(#true)
    wb_pending_exception <== wb_commit_bits
  elsewhen (wb_pending_exception_valid & wb_csrs.redirect.valid):
    wb_pending_exception_valid <== Bool(#false)

  (
    wb_scoreboard_path
      |> filter_valid(committed => !committed.replay & core_deferred_writeback(committed.writeback_source) & (
          committed.write_enable
        ) & committed.rd.or_reduce())
      |> map_valid(committed => committed.rd)
  ) |> wb_to_id_scoreboard_set_link.left

  def wb_normal_write = (
    wb_register_path
      |> filter_valid(committed => !committed.replay & (committed.writeback_source =/= RV5StageWritebackSelect.Vector) & !core_deferred_writeback(committed.writeback_source) & (
          committed.write_enable
        ) & ((committed.writeback_source =/= RV5StageWritebackSelect.Csr) ||| wb_csrs.writeback_valid))
      |> map_valid(committed => RegisterFileWrite(xlen)):
          address: committed.rd
          data: mux(
            committed.writeback_source === RV5StageWritebackSelect.Csr,
            wb_csrs.writeback_value,
            committed.value
          )
  )
  wb_normal_write |> wb_commit_write

  // Pipelined multiplication is pure EX work; WB authorizes its aligned result.
  // The iterative implementation still starts only after WB retirement.
  if wb_pipelined_multiplier
  | block:
      wb_multiplier.authorize.valid <== wb_commit_has_multiply
      wb_multiplier.authorize.bits <== wb_commit_bits.rd
  | block:
      (
        wb_multiply_path
          |> filter_valid(committed => !committed.replay & (committed.writeback_source === RV5StageWritebackSelect.Multiply) & committed.write_enable & committed.rd.or_reduce())
          |> map_valid(_committed => wb_input.bits.multiply_issue)
      ) |> wb_multiplier.issue
      wb_multiplier.authorize.valid <== Bool(#false)
      wb_multiplier.authorize.bits <== bits(0, 5)
      when wb_commit_has_multiply:
        assert(wb_multiplier.available, "rv5stage_multiplier_commit_reserved")
  (
    wb_divide_path
      |> filter_valid(committed => !committed.replay & (
          committed.writeback_source === RV5StageWritebackSelect.Divide
        ) & committed.write_enable & committed.rd.or_reduce())
      |> map_valid(_committed => wb_input.bits.divide_issue)
  ) |> wb_divider.issue
  when wb_commit_has_divide:
    assert(wb_divider.available, "rv5stage_divider_commit_reserved")

  wb_fp_integer_scoreboard.set.valid <== wb_fp.issue.fire() & (
    wb_fp.issue.bits.control.registers.destination === RV5StageFloatDestination.Integer
  ) & wb_fp.issue.bits.frd.or_reduce()
  wb_fp_integer_scoreboard.set.bits <== wb_fp.issue.bits.frd

  // Deferred completion. Loads and arithmetic complete outside the ordered
  // pipeline. Each candidate carries its semantic source, so routing does not
  // depend on the arbiter's structural input index.
  inst wb_completion_arbiter(RRArbiter(RV5StageDeferredCompletion(xlen), 5))
  fun wb_tag_completion(source :: RV5StageCompletionSource):
    map_flow(~stable: #true, completion):
      RV5StageDeferredCompletion(xlen):
        write: completion
        source: source
  def wb_integer_load_completion = (
    wb_integer_responses
      |> filter_flow(response => response.writeback.view(RV5StageMemoryWriteback(vector_completion_slots).Integer).payload.or_reduce())
      |> map_flow(response => RegisterFileWrite(xlen)):
          address: response.writeback.view(RV5StageMemoryWriteback(vector_completion_slots).Integer).payload
          data: response.data
  )
  // A returned slow load can wait at its producer. Give the fixed multiply
  // result the first deferred RF write slot, then arbitrate variable returns.
  wb_integer_load_completion |> gate_flow(!wb_gpr_calendar.occupied[0].into(Bool)) |> wb_tag_completion(RV5StageCompletionSource.IntegerLoad) |> wb_completion_arbiter.ingress[4]
  (
    wb_multiplier.completion
      |> map_flow(~stable: #true, completion => RegisterFileWrite(xlen)):
          address: completion.rd
          data: completion.value
  ) |> gate_flow(Bool(wb_pipelined_multiplier) ||| !wb_gpr_calendar.occupied[0].into(Bool)) |> wb_tag_completion(RV5StageCompletionSource.Multiply) |> wb_completion_arbiter.ingress[0]
  (
    wb_divider.completion
      |> map_flow(~stable: #true, completion => RegisterFileWrite(xlen)):
          address: completion.rd
          data: completion.value
  ) |> gate_flow(!wb_gpr_calendar.occupied[0].into(Bool)) |> wb_tag_completion(RV5StageCompletionSource.Divide) |> wb_completion_arbiter.ingress[1]
  (
    wb_fp.completion
      |> filter_flow(completion => (
          completion.destination === RV5StageFloatDestination.Integer
        ) & completion.rd.or_reduce())
      |> map_flow(completion => RegisterFileWrite(xlen)):
          address: completion.rd
          data: completion.integer_value
  ) |> gate_flow(wb_fp_fixed_integer_return ||| !wb_gpr_calendar.occupied[0].into(Bool)) |> wb_tag_completion(RV5StageCompletionSource.FpInteger) |> wb_completion_arbiter.ingress[2]
  // Vector scalar results reserve their one-cycle write before private issue.
  def wb_vector_integer_completion = wb_vector_scalar_result_link.right |> filter_valid(write => write.address.or_reduce()) |> to_decoupled()
  wb_vector_integer_write_pending <== wb_vector_integer_completion.valid
  wb_vector_integer_completion |> wb_tag_completion(RV5StageCompletionSource.VectorInteger) |> wb_completion_arbiter.ingress[3]
  def Array(
    wb_completed_register_write,
    wb_completed_integer_scoreboard_clear,
    wb_completed_fp_integer_scoreboard_clear
  ) = wb_completion_arbiter.egress |> to_valid() |> fork_valid(3)
  wb_completed_register_write |> map_valid(completion => completion.write) |> wb_deferred_completion_write
  // Drain a persistently blocked variable response by withholding new fixed
  // reservations. Already-launched operations keep every promised write cycle.
  def wb_variable_waiting = (wb_integer_load_completion.valid & !wb_integer_load_completion.ready) ||| (wb_divider.completion.valid & !wb_divider.completion.ready) ||| (Bool(!wb_pipelined_multiplier) & wb_multiplier.completion.valid & !wb_multiplier.completion.ready) ||| (!wb_fp_fixed_integer_return & wb_fp.completion.valid & !wb_fp.completion.ready)
  reg wb_variable_age(~init: bits(0, 3))
  when (!wb_variable_waiting):
    wb_variable_age <== bits(0, 3)
  elsewhen (!wb_variable_age.and_reduce()):
    wb_variable_age <== wb_variable_age + bits(1, 3)
  wb_gpr_calendar.pause <== wb_variable_age.and_reduce()
  (
    wb_completed_integer_scoreboard_clear
      |> filter_valid(completion => completion.source =/= RV5StageCompletionSource.FpInteger)
      |> map_valid(completion => completion.write.address)
  ) |> wb_to_id_scoreboard_clear_link.left
  (
    wb_completed_fp_integer_scoreboard_clear
      |> filter_valid(completion => completion.source === RV5StageCompletionSource.FpInteger)
      |> map_valid(completion => completion.write.address)
  ) |> wb_fp_integer_scoreboard.clear

  (
    wb_fp_response
      |> map_valid(response => RV5StageFpLoadCompletion(Bits(width))):
          context: bits(0, width)
          precision: response.writeback.view(RV5StageMemoryWriteback(vector_completion_slots).FloatingPoint).payload.precision
          rd: response.writeback.view(RV5StageMemoryWriteback(vector_completion_slots).FloatingPoint).payload.rd
          data: if xlen == XLen.X32 | response.data.zext(64) | response.data
  ) |> wb_fp.load_completion

export:
  RV5StageCore
