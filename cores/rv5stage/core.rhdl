#lang rhodium
// Implements RV5Stage's five-stage core with composable flows and explicit state logic.

import:
  "../alu.rhdl" open
  "../branch-resolver.rhdl" open
  "../load-store.rhdl" open
  "../cache-prefetch.rhdl" open
  "memory.rhdl" open
  "decode/core-ctrl.rhdl" open
  "decode/operand-ctrl.rhdl" open
  "decode/branch-ctrl.rhdl" open
  "decode/mem-ctrl.rhdl" open
  "decode/fence-ctrl.rhdl" open
  "decode/hint-ctrl.rhdl" open
  "decode/system-ctrl.rhdl" open
  "decode/writeback-ctrl.rhdl" open
  "bundles.rhdl" open
  "csr.rhdl" open
  "profile.rhm".RVCoreProfile
  "interrupt.rhdl" open
  "multiply.rhdl" open
  "divide.rhdl" open
  "fp/pipeline.rhdl" open
  "fp/bundles.rhdl" open
  "fetch.rhdl" open
  "decode/fp-ctrl.rhdl" open
  "register-file.rhdl" open
  "icache/protocol.rhdl" open
  "dcache/protocol.rhdl" open
  "../../riscv/isa/c.rhm" open
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/isa/fp-profile.rhm" open
  "../../riscv/isa/trap.rhm" open
  "../../riscv/rtl/trap.rhdl" open
  "../../riscv/rtl/cmo.rhdl" open
  "../../riscv/model/formats.rhm" as riscv_fields
  "../../riscv/rtl/instruction-fields.rhdl" open
  "../../riscv/rtl/floating-point.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open
  lib("rhodium/std/scoreboard.rhdl") open

sync_circuit RV5StageCore(core_profile :: RVCoreProfile, ~reset_address: reset_address :: Nat):
  def xlen = core_profile.xlen
  def extensions = core_profile.extensions
  def profile = extensions.floating_point
  def half_precision = extensions.half_precision
  def zfa_enabled = extensions.zfa
  def zicbop_enabled = extensions.zicbop
  def zicboz_enabled = extensions.zicboz
  def zicbom_enabled = extensions.zicbom
  def zawrs_enabled = extensions.zawrs
  def zihintpause_enabled = extensions.zihintpause
  def zihintntl_enabled = extensions.zihintntl
  def compressed_extensions = extensions.compressed
  def width = xlen.width
  def compressed_enabled = compressed_extensions_enabled(compressed_extensions)
  def register_count = 32
  def effective_fp_profile = if xlen == XLen.X32 | FloatingPointProfile.F | FloatingPointProfile.D
  def supported_instruction_names = rv5stage_instructions(xlen, profile, half_precision, ~zfa: zfa_enabled, ~zicbop: zicbop_enabled, ~zicboz: zicboz_enabled, ~zicbom: zicbom_enabled, ~zawrs: zawrs_enabled, ~zihintpause: zihintpause_enabled, ~zihintntl: zihintntl_enabled).map(fun (instruction): instruction.name)

  def instruction_alignment = if compressed_enabled | 2 | 4
  unless reset_address < (1 << width)
  | error(~who: #'RV5StageCore, "reset address must fit XLEN")
  unless reset_address mod instruction_alignment == 0
  | error(~who: #'RV5StageCore, "reset address must be instruction aligned")
  def reset_pc = bits(reset_address, width)

  input interrupts: RV5StageInterrupts()
  input hart_id: Bits(width)
  input time_counter: Bits(64)
  interface instruction_access(RV5StageInstructionAccess(xlen), ~role: requester)
  interface data_access(RV5StageDataAccess(xlen), ~role: requester)
  interface prefetch(Valid(CachePrefetchReq(width)), ~role: producer)
  output privilege: PrivilegeMode
  output mstatus: Bits(width)
  output satp: Bits(width)
  output translation_flush: Bool

  def zero = bits(0, width)
  fun instruction_value(instruction :: Bits(32)):
    if width == 32 | instruction | instruction.zext(width)
  fun deferred_writeback(source :: WritebackSelect):
    source.is_one_of(WritebackSelect.Memory, WritebackSelect.Multiply, WritebackSelect.Divide)
  fun serializing_operation(system :: SystemControl(), fence :: FenceControl()) :~ Bool:
    system.is_system_operation() ||| fence.is_fence_operation()
  fun data_exception(operation :: MemoryOperation,
                     address :: Bits(width),
                     store_cause :: ExceptionCause,
                     load_cause :: ExceptionCause):
    RV5StageException(xlen):
      valid: Bool(#true)
      cause: mux(operation.store_fault_class(),
                 exception_cause_bits(store_cause, width),
                 exception_cause_bits(load_cause, width))
      value: address
  reg pending_exception_valid(~init: Bool(#false))
  reg pending_exception(MemoryWriteback(xlen))

  // IF/ID is elastic so Decode can hold hazards. Every boundary after Decode
  // advances feed-forward; rejected WB dispatch refetches the instruction
  // without authorizing effects or introducing downstream backpressure.
  inst if_id_pipe(Pipe(FetchDecode(xlen), 1))
  inst id_ex_pipe(ValidPipeAlwaysCapture(DecodeExecute(xlen), 1))
  inst ex_mem_pipe(ValidPipeAlwaysCapture(ExecuteMemory(xlen), 1))
  inst mem_wb_pipe(ValidPipeAlwaysCapture(MemoryWriteback(xlen), 1))

  // Describe the existing stage storage without replacing its functional RTL.
  describe_interface_transform(InterfaceHandle(if_id_pipe.ingress, if_id_pipe.egress), "if-id", {}, if_id_pipe, ~trace_model: interface_trace_elastic(if_id_pipe))
  describe_interface_transform(InterfaceHandle(id_ex_pipe.ingress, id_ex_pipe.egress), "id-ex", {}, id_ex_pipe, ~trace_model: interface_trace_fixed_latency(1))
  describe_interface_transform(InterfaceHandle(ex_mem_pipe.ingress, ex_mem_pipe.egress), "ex-mem", {}, ex_mem_pipe, ~trace_model: interface_trace_fixed_latency(1))
  describe_interface_transform(InterfaceHandle(mem_wb_pipe.ingress, mem_wb_pipe.egress), "mem-wb", {}, mem_wb_pipe, ~trace_model: interface_trace_fixed_latency(1))

  inst decoder(RV5StageInstructionDecoder(xlen, profile, half_precision, ~zfa: zfa_enabled, ~zicbop: zicbop_enabled, ~zicboz: zicboz_enabled, ~zicbom: zicbom_enabled, ~zawrs: zawrs_enabled, ~zihintpause: zihintpause_enabled, ~zihintntl: zihintntl_enabled))
  inst registers(RV5StageRegisterFile(xlen))
  inst alu(ALU(xlen))
  inst branch_resolver(BranchResolver(width))
  inst multiplier(RV5StageMultiplier(xlen))
  inst divider(RV5StageDivider(xlen))
  inst scoreboard(Scoreboard(register_count))
  inst fp_integer_scoreboard(Scoreboard(register_count))
  def FpModule = if floating_point_supports_f(profile) | RV5StageFpPipeline(xlen, effective_fp_profile, Bits(width), ~half_precision: half_precision, ~zfa: zfa_enabled) | RV5StageDisabledFpPipeline(xlen, effective_fp_profile, Bits(width))
  inst fp(FpModule)
  inst csrs(RV5StageCsrFile(core_profile))
  inst fetch(RV5StageInstructionFetch(xlen, profile, ~compressed: compressed_extensions, ~supported_instructions: supported_instruction_names))
  csrs.interrupts <== interrupts
  csrs.hart_id <== hart_id
  csrs.time_counter <== time_counter
  fp.state_update |> csrs.fp_update

  // Name the pipeline boundaries once so later sections can be presented in
  // stage order while still observing downstream occupancy and results.
  def id_ex = id_ex_pipe.egress
  def memory = ex_mem_pipe.egress
  // Accepted maintenance retains retirement context outside the feed-forward
  // pipeline. Only its completion can retire it; it is never reissued.
  reg maintenance_pending(~init: Bool(#false))
  reg maintenance_instruction(MemoryWriteback(xlen))
  wire maintenance_accepted: Bool
  def pipeline_wb = mem_wb_pipe.egress |> trace_valid_event("core.wb", ~terminal: #true, ~fields: operation):
    pc: operation.pc
    instruction: operation.instruction
  // WRS owns its retirement context outside the feed-forward pipeline. Wake
  // levels win over timeout, including a reservation lost on entry to waiting.
  reg reservation_wait_pending(~init: Bool(#false))
  reg reservation_wait_instruction(MemoryWriteback(xlen))
  reg reservation_wait_count(~init: bits(0, 12))
  def reservation_wait_wake = !data_access.reservation_valid ||| csrs.wfi_wake
  def reservation_wait_expired = and_reduce(reservation_wait_count)
  def reservation_wait_short = reservation_wait_instruction.system.action === SystemOperation.WrsSto
  def reservation_wait_tw = (csrs.privilege =/= PrivilegeMode.Machine) & csrs.mstatus[21].into(Bool)
  def reservation_wait_timeout = reservation_wait_expired & (reservation_wait_short ||| reservation_wait_tw)
  def reservation_wait_done = reservation_wait_pending & (reservation_wait_wake ||| reservation_wait_timeout)
  def reservation_wait_illegal = reservation_wait_done & !reservation_wait_wake & !reservation_wait_short & reservation_wait_tw
  def reservation_wait_accept = Bool(zawrs_enabled) & pipeline_wb.valid & !maintenance_pending & !reservation_wait_pending & !pending_exception_valid & !pipeline_wb.bits.replay & !pipeline_wb.bits.exception_valid & pipeline_wb.bits.system.action.is_one_of(SystemOperation.WrsNto, SystemOperation.WrsSto)
  when reservation_wait_accept:
    reservation_wait_pending <== Bool(#true)
    reservation_wait_instruction <== pipeline_wb.bits
    reservation_wait_count <== bits(0, 12)
  elsewhen reservation_wait_done:
    reservation_wait_pending <== Bool(#false)
  elsewhen (reservation_wait_pending & !reservation_wait_expired):
    reservation_wait_count <== reservation_wait_count + bits(1, 12)
  def maintenance_done = maintenance_pending & data_access.response.valid
  when (data_access.response.valid & data_access.response.bits.access_fault):
    assert(maintenance_pending, "rv5stage_completion_fault_has_retirement_context")
  def wb = inject_flow(Valid(MemoryWriteback(xlen)), ~valid: mux(reservation_wait_pending, reservation_wait_done, mux(maintenance_pending, maintenance_done, pipeline_wb.valid & !reservation_wait_accept)), ~bits: mux(reservation_wait_pending, reservation_wait_instruction, mux(maintenance_pending, maintenance_instruction, pipeline_wb.bits)))
  def wb_bits :: MemoryWriteback(xlen) = wb.bits
  wire commit_result: MemoryWriteback(xlen)
  def commit = inject_flow(Valid(MemoryWriteback(xlen)), ~valid: wb.valid & !maintenance_accepted & !pending_exception_valid, ~bits: commit_result)
  def commit_bits :: MemoryWriteback(xlen) = commit.bits
  def commit_replay = commit.valid & commit_bits.replay
  def commit_valid = commit.valid & !commit_bits.replay
  def Array(commit_write :: Endpoint, deferred_completion_write :: Endpoint) = registers.writes

  privilege <== csrs.privilege
  mstatus <== csrs.mstatus
  satp <== csrs.satp

  // Backward-traveling observations use local Valid interface links. Their
  // producers remain in their pipeline stages below, despite earlier stages
  // consuming their values.
  def redirect_link :: Handle = interface_link(Valid(Bits(width)))
  def memory_exception_link :: Handle = interface_link(Valid(Bits(width)))
  def memory_replay_link :: Handle = interface_link(Valid(Bits(width)))
  def scoreboard_set_link :: Handle = interface_link(Valid(Bits(5)))
  def scoreboard_clear_link :: Handle = interface_link(Valid(Bits(5)))
  scoreboard_set_link.right |> scoreboard.set
  scoreboard_clear_link.right |> scoreboard.clear
  def fence_i_commit = commit_valid & !commit_bits.exception_valid & wb_bits.fence.into(FenceControl()).is_instruction_fence()
  translation_flush <== csrs.translation_flush
  def fence_resume_pc = commit_bits.resume_pc
  def fence_commit = fence_i_commit ||| csrs.translation_flush
  def commit_redirect = csrs.redirect.valid ||| fence_commit ||| commit_replay
  def memory_stage_valid = memory.valid & !commit_redirect & !pending_exception_valid & !(commit_valid & commit_bits.exception_valid)
  def memory_exception_event = memory_exception_link.right.valid
  def memory_replay_event = memory_replay_link.right.valid
  def memory_redirect = memory_stage_valid & memory.bits.redirect_valid & !memory_exception_event & !memory_replay_event
  def fence_redirect = inject_flow(
    Valid(Bits(width)),
    ~valid: fence_commit,
    ~bits: fence_resume_pc
  )
  def commit_replay_redirect = inject_flow(
    Valid(Bits(width)),
    ~valid: commit_replay,
    ~bits: commit_bits.pc
  )
  def memory_redirect_flow = inject_flow(
    Valid(Bits(width)),
    ~valid: memory_redirect,
    ~bits: memory.bits.resume_pc
  )
  def redirect_sources = Array(
    csrs.redirect,
    fence_redirect,
    commit_replay_redirect,
    memory_redirect_flow
  )
  redirect_sources |> valid_arbiter() |> redirect_link.left

  // Fetch (IF) assembles variable-length instructions from aligned cache words.
  // Redirects and faults discard both partially assembled and outstanding data.
  def exception_in_flight = pending_exception_valid ||| memory_exception_event ||| (
    commit_valid & commit_bits.exception_valid
  )
  def squash = exception_in_flight ||| memory_replay_event ||| redirect_link.right.valid
  reg started(~init: Bool(#false))
  reg waiting_for_interrupt(~init: Bool(#false))
  // PAUSE retires before its bounded cooldown. Unlike WFI/WRS, no instruction
  // context or older-memory drain is required, and interrupts remain live.
  def PauseCycles = 16
  reg pause_cycles(~init: bits(0, index_width(PauseCycles + 1)))
  def pause_active = or_reduce(pause_cycles)
  def pause_commit = commit_valid & !commit_bits.exception_valid & (commit_bits.hint === HintOperation.Pause)
  when (csrs.redirect.valid ||| csrs.interrupt_request):
    pause_cycles <== bits(0, index_width(PauseCycles + 1))
  elsewhen pause_commit:
    pause_cycles <== bits(PauseCycles, index_width(PauseCycles + 1))
  elsewhen pause_active:
    pause_cycles <== pause_cycles - bits(1, index_width(PauseCycles + 1))
  reg architectural_pc(~init: reset_pc)
  // Seed fetch once after reset; software in the reset image owns boot waiting.
  def reset_start = !started
  def fetch_valid = started & !pause_active & !pause_commit & !squash & !csrs.interrupt_request & !waiting_for_interrupt & !reservation_wait_pending & !reservation_wait_accept
  fetch.active <== fetch_valid
  fetch.flush <== memory_exception_event ||| memory_replay_event
  fetch.restart_valid <== redirect_link.right.valid ||| reset_start
  fetch.restart_pc <== mux(redirect_link.right.valid, redirect_link.right.bits, reset_pc)
  fetch.invalidate_all <== fence_i_commit
  fetch.memory <=> instruction_access
  def fetched = fetch.fetched |> trace_event("core.fetch", ~root: #true, ~fields: operation):
    pc: operation.pc
    instruction: operation.instruction
  fetched |> if_id_pipe.ingress
  started <== Bool(#true)
  when (csrs.redirect.valid):
    architectural_pc <== csrs.redirect.bits
  elsewhen (commit_valid & !commit_bits.exception_valid):
    architectural_pc <== commit_bits.resume_pc

  when (csrs.wfi_wake ||| csrs.redirect.valid):
    waiting_for_interrupt <== Bool(#false)
  elsewhen (csrs.wfi_retired):
    waiting_for_interrupt <== Bool(#true)

  def decode_valid = if_id_pipe.egress.valid & !squash
  def decode_bits = if_id_pipe.egress.bits

  // Decode (ID) is ordinary combinational logic between IF/ID and ID/EX.
  // Filtering consumes squashed tokens; gating holds a token that depends on
  // deferred work which has not yet reached the WB commit point.
  def instruction = decode_bits.instruction
  decoder.instruction <== instruction
  def control :: RV5StageControl() = decoder.control

  def rs1 = instruction_field(riscv_fields.rs1, instruction)
  def rs2 = instruction_field(riscv_fields.rs2, instruction)
  def rd = instruction_field(riscv_fields.rd, instruction)
  def frs3 = instruction_field(riscv_fields.rs3, instruction)
  def fp_rounding = riscv_rounding_mode(instruction_field(riscv_fields.rm, instruction), csrs.frm)
  def decoded_immediate = control.operand.immediate.decode(instruction, width)
  csrs.cbo_operation <== mux_lookup(
    control.memory.access, ~default: CboManagementOperation.Invalidate,
    [[MemoryOperation.CacheBlockClean, CboManagementOperation.Clean],
     [MemoryOperation.CacheBlockFlush, CboManagementOperation.Flush]]
  )
  def decoded_management = control.memory.access.is_cache_management()
  def decoded_cbo_permission :: CboManagementPermission() = csrs.cbo_permission
  def decoded_memory_operation = mux(decoded_management & (decoded_cbo_permission.operation === CboManagementOperation.Flush), MemoryOperation.CacheBlockFlush, control.memory.access)
  def decoded_illegal = decode_bits.compressed_illegal ||| !decoder.valid ||| (
    control.memory.access.is_cache_block_zero() & !csrs.cbo_zero_enabled
  ) ||| (decoded_management & !decoded_cbo_permission.permitted) ||| (
    control.floating_point_valid & (
      !csrs.fp_enabled ||| (
        control.floating_point.execution.uses_rounding_mode & !fp_rounding.valid
      )
    )
  )
  def decoded_fault = decode_bits.instruction_page_fault ||| decode_bits.instruction_access_fault ||| decoded_illegal

  registers.read_address_1 <== rs1
  registers.read_address_2 <== rs2
  // Decode selects the registered data source that will be present in EX's
  // next cycle. Live MEM faults, replay, and redirects never select operands.
  def execute_bypass_available = id_ex.valid & id_ex.bits.writeback_enable & !deferred_writeback(id_ex.bits.writeback_source) & (id_ex.bits.writeback_source =/= WritebackSelect.Csr)
  def memory_bypass_available = memory.valid & memory.bits.writeback_enable & !deferred_writeback(memory.bits.writeback_source) & (memory.bits.writeback_source =/= WritebackSelect.Csr)
  fun decoded_operand(index :: Bits(5), register_value :: Bits(width)):
    def from_memory = index.or_reduce() & execute_bypass_available & (id_ex.bits.rd === index)
    RV5StageOperand(xlen):
      from_memory: from_memory
      from_writeback: !from_memory & index.or_reduce() & memory_bypass_available & (memory.bits.rd === index)
      value: register_value
  fun rv5stage_register_busy(index :: Bits(5)):
    (
      scoreboard_busy(register_count, scoreboard.busy, index) ||| scoreboard_busy(
        register_count,
        fp_integer_scoreboard.busy,
        index
      ) ||| (
        scoreboard_set_link.right.valid & (scoreboard_set_link.right.bits === index)
      ) ||| (
        id_ex.valid & id_ex.bits.floating_point_valid & (
          id_ex.bits.floating_point_control.registers.destination === RV5StageFloatDestination.Integer
        ) & (id_ex.bits.rd === index)
      ) ||| (
        memory.valid & memory.bits.fp_compute & (memory.bits.fp_issue.control.registers.destination === RV5StageFloatDestination.Integer) & (memory.bits.rd === index)
      ) ||| (
        wb.valid & wb_bits.fp_compute & (wb_bits.fp_issue.control.registers.destination === RV5StageFloatDestination.Integer) & (wb_bits.rd === index)
      )
    ) & !(
      scoreboard_clear_link.right.valid & (scoreboard_clear_link.right.bits === index)
    )

  def id_ex_is_deferred = id_ex.valid & deferred_writeback(id_ex.bits.writeback_source)
  def memory_is_deferred = memory.valid & deferred_writeback(memory.bits.writeback_source)
  fun conflicts_with_deferred(deferred_valid :: Bool,
                              deferred_destination :: Bits(5)):
    deferred_valid & deferred_destination.or_reduce() & (
      (control.operand.uses_rs1 & (deferred_destination === rs1)) ||| (
        control.operand.uses_rs2 & (deferred_destination === rs2)
      ) ||| (
        (control.writeback.enable ||| (
          control.floating_point_valid & (
            control.floating_point.registers.destination === RV5StageFloatDestination.Integer
          )
        )) & (deferred_destination === rd)
      )
    )
  def deferred_dependency_hazard = decode_valid & (
    conflicts_with_deferred(id_ex_is_deferred, id_ex.bits.rd) ||| (
      conflicts_with_deferred(memory_is_deferred, memory.bits.rd)
    )
  )
  def scoreboard_raw_hazard = (
    control.operand.uses_rs1 & rs1.or_reduce() & rv5stage_register_busy(rs1)
  ) ||| (
    control.operand.uses_rs2 & rs2.or_reduce() & rv5stage_register_busy(rs2)
  )
  def decoded_integer_write = control.writeback.enable ||| (
    control.floating_point_valid & (
      control.floating_point.registers.destination === RV5StageFloatDestination.Integer
    )
  )
  def scoreboard_waw_hazard = decoded_integer_write & rd.or_reduce() & rv5stage_register_busy(rd)
  fun rv5stage_fp_register_busy(index :: Bits(5)):
    scoreboard_busy(register_count, fp.busy, index) ||| (
      id_ex.valid & id_ex.bits.floating_point_valid & (
        id_ex.bits.floating_point_control.registers.destination === RV5StageFloatDestination.FloatingPoint
      ) & (id_ex.bits.rd === index)
    ) ||| (
      memory.valid & memory.bits.data_request_valid & (
        memory.bits.data_request.destination === RV5StageDataDestination.FloatingPoint
      ) & (memory.bits.data_request.rd === index)
    ) ||| (
      memory.valid & memory.bits.fp_compute & (memory.bits.fp_issue.control.registers.destination === RV5StageFloatDestination.FloatingPoint) & (memory.bits.rd === index)
    ) ||| (
      wb.valid & ((wb_bits.fp_compute & (wb_bits.fp_issue.control.registers.destination === RV5StageFloatDestination.FloatingPoint)) ||| (wb_bits.data_request_valid & (wb_bits.data_request.destination === RV5StageDataDestination.FloatingPoint))) & (wb_bits.rd === index)
    )
  def fp_source_hazard = control.floating_point_valid & (
    (control.floating_point.registers.uses_frs1 & rv5stage_fp_register_busy(rs1)) ||| (
      control.floating_point.registers.uses_frs2 & rv5stage_fp_register_busy(rs2)
    ) ||| (
      control.floating_point.registers.uses_frs3 & rv5stage_fp_register_busy(frs3)
    )
  )
  def fp_destination_hazard = control.floating_point_valid & (
    control.floating_point.registers.destination === RV5StageFloatDestination.FloatingPoint
  ) & rv5stage_fp_register_busy(rd)
  def serializing_in_id_ex = id_ex.valid & (serializing_operation(id_ex.bits.system, id_ex.bits.fence) ||| id_ex.bits.memory_operation.into(MemoryOperation).is_cache_management())
  def serializing_in_memory = memory.valid & (serializing_operation(memory.bits.system, memory.bits.fence) ||| memory.bits.data_request.access.into(MemoryOperation).is_cache_management())
  def serializing_in_commit = commit_valid & serializing_operation(wb_bits.system, wb_bits.fence)
  def pause_in_flight = (id_ex.valid & (id_ex.bits.hint === HintOperation.Pause)) ||| (memory.valid & (memory.bits.hint === HintOperation.Pause)) ||| (wb.valid & (wb_bits.hint === HintOperation.Pause))
  def serializing_in_flight = serializing_in_id_ex ||| serializing_in_memory ||| serializing_in_commit ||| maintenance_pending ||| reservation_wait_pending ||| reservation_wait_accept ||| (pipeline_wb.valid & pipeline_wb.bits.data_request.access.into(MemoryOperation).is_cache_management())
  def commit_is_deferred = commit_valid & deferred_writeback(
    commit_bits.writeback_source
  ) & commit_bits.write_enable
  def deferred_results_pending = scoreboard.busy.or_reduce() ||| fp_integer_scoreboard.busy.or_reduce() ||| !fp.drained
  def deferred_state_pending = id_ex_is_deferred ||| memory_is_deferred ||| (
    commit_is_deferred
  ) ||| deferred_results_pending ||| scoreboard_set_link.right.valid ||| (id_ex.valid & id_ex.bits.floating_point_valid) ||| (memory.valid & memory.bits.fp_compute) ||| (wb.valid & wb_bits.fp_compute)
  // Include older accesses not yet accepted by the LSU: drained alone can
  // still be true while a block zero (or scalar store) is in Execute/Memory.
  def older_memory_in_flight = (id_ex.valid & id_ex.bits.memory_operation.into(MemoryOperation).is_memory()) ||| (memory.valid & memory.bits.data_request_valid) ||| (wb.valid & wb_bits.data_request_valid)
  def serializing_waits_for_older = (serializing_operation(control.system, control.fence) ||| decoded_management) & (deferred_state_pending ||| older_memory_in_flight ||| !data_access.drained)
  def decoded_needs_multiplier = (control.writeback.source === WritebackSelect.Multiply) & control.writeback.enable & rd.or_reduce()
  def id_ex_has_multiply = id_ex.valid & (id_ex.bits.writeback_source === WritebackSelect.Multiply) & id_ex.bits.writeback_enable & id_ex.bits.rd.or_reduce()
  def memory_has_multiply = memory.valid & (memory.bits.writeback_source === WritebackSelect.Multiply) & memory.bits.writeback_enable & memory.bits.rd.or_reduce()
  def commit_has_multiply = commit_valid & (commit_bits.writeback_source === WritebackSelect.Multiply) & commit_bits.write_enable & commit_bits.rd.or_reduce()
  def multiply_resource_hazard = decoded_needs_multiplier & !decoded_fault & (
    !multiplier.available ||| id_ex_has_multiply ||| memory_has_multiply ||| commit_has_multiply
  )
  def decoded_needs_divider = (control.writeback.source === WritebackSelect.Divide) & control.writeback.enable & rd.or_reduce()
  def id_ex_has_divide = id_ex.valid & (id_ex.bits.writeback_source === WritebackSelect.Divide) & id_ex.bits.writeback_enable & id_ex.bits.rd.or_reduce()
  def memory_has_divide = memory.valid & (memory.bits.writeback_source === WritebackSelect.Divide) & memory.bits.writeback_enable & memory.bits.rd.or_reduce()
  def commit_has_divide = commit_valid & (commit_bits.writeback_source === WritebackSelect.Divide) & commit_bits.write_enable & commit_bits.rd.or_reduce()
  def divide_resource_hazard = decoded_needs_divider & !decoded_fault & (
    !divider.available ||| id_ex_has_divide ||| memory_has_divide ||| commit_has_divide
  )
  def decoded_fp_execution_control :: RV5StageFloatExecutionControl() = control.floating_point.execution
  def decoded_fp_memory = control.floating_point_valid & (
    decoded_fp_execution_control.unit === RV5StageFloatUnit.Memory
  )
  def decoded_fp_store = decoded_fp_memory & decoded_fp_execution_control.memory_write
  def fp_store_resource_hazard = decoded_fp_store & !decoded_fault & wb.valid & wb_bits.fp_compute
  def local_resource_hazard = multiply_resource_hazard ||| divide_resource_hazard ||| fp_store_resource_hazard
  def pipeline_hazard = deferred_dependency_hazard ||| scoreboard_raw_hazard ||| (
    scoreboard_waw_hazard ||| fp_source_hazard ||| fp_destination_hazard
  ) ||| local_resource_hazard ||| pause_in_flight ||| pause_active ||| serializing_in_flight ||| serializing_waits_for_older ||| waiting_for_interrupt ||| csrs.interrupt_request ||| exception_in_flight
  // Operand probes are read-only and may repeat while ID waits. Keeping them
  // independent of transfer/replay avoids feeding WB readiness into FP reads.
  fp.store_request.valid <== if_id_pipe.egress.valid & decoded_fp_store
  fp.store_request.bits <== RV5StageFpStoreRequest(Bits(width)):
    context: decode_bits.pc
    precision: decoded_fp_execution_control.source_precision
    rs: rs2
  def traced_decode:
    if_id_pipe.egress
      |> filter_flow(_fetched => !squash)
      |> gate_flow(!pipeline_hazard)
      |> trace_event("core.decode", ~fields: operation):
           pc: operation.pc
           instruction: operation.instruction
  def decoded_operation:
    traced_decode |> map_flow(fetched => DecodeExecute(xlen)):
          pc: fetched.pc
          instruction: fetched.instruction
          raw_instruction: fetched.raw_instruction
          sequential_pc: fetched.sequential_pc
          alu_control: control.alu
          operand_left: control.operand.left
          operand_right: control.operand.right
          branch_control: control.branch.resolver
          target_from_rs1: control.branch.target_from_rs1
          memory_operation: decoded_memory_operation
          prefetch_operation: control.prefetch
          memory_atomic: control.memory.atomic
          memory_width: control.memory.width
          memory_unsigned: control.memory.unsigned
          multiply_control: control.multiply
          divide_control: control.divide
          floating_point_valid: control.floating_point_valid
          floating_point_control: control.floating_point
          floating_point_rounding_mode_valid: fp_rounding.valid
          floating_point_rounding_mode: fp_rounding.mode
          writeback_enable: control.writeback.enable
          writeback_source: control.writeback.source
          system: control.system
          fence: control.fence
          hint: control.hint
          illegal: decoded_illegal
          instruction_page_fault: fetched.instruction_page_fault
          instruction_access_fault: fetched.instruction_access_fault
          instruction_fault_address: fetched.instruction_fault_address
          immediate: decoded_immediate
          rs1: rs1
          rs2: rs2
          operand_rs1: decoded_operand(rs1, registers.read_data_1)
          operand_rs2: decoded_operand(rs2, registers.read_data_2)
          rd: rd
          frs3: frs3
  decoded_operation |> to_valid() |> id_ex_pipe.ingress

  // EX uses only registered selectors and data. A killed producer's younger
  // consumer is canceled independently; it does not select an older operand.
  fun forwarded_register_value(operand :: RV5StageOperand(xlen)):
    mux(
      operand.from_memory,
      memory.bits.result,
      mux(
        operand.from_writeback,
        wb_bits.value,
        operand.value
      )
    )
  def forwarded_rs1 = forwarded_register_value(id_ex.bits.operand_rs1)
  def forwarded_rs2 = forwarded_register_value(id_ex.bits.operand_rs2)

  alu.left <== mux_lookup(
    id_ex.bits.operand_left,
    ~default: forwarded_rs1,
    [
      [OperandASelect.Pc, id_ex.bits.pc],
      [OperandASelect.Zero, bits(0, width)]
    ]
  )
  alu.right <== mux(
    id_ex.bits.operand_right === OperandBSelect.Immediate,
    id_ex.bits.immediate,
    forwarded_rs2
  )
  alu.control <== id_ex.bits.alu_control

  def redirect_requested = branch_resolver.result.bits.taken
  def computed_redirect_target :: Bits(width) = mux(
    id_ex.bits.target_from_rs1,
    (forwarded_rs1 + id_ex.bits.immediate) & !bits(1, width),
    id_ex.bits.pc + id_ex.bits.immediate
  )
  def redirect_aligned = computed_redirect_target.is_aligned(instruction_alignment)
  def execute_memory_operation :: MemoryOperation = id_ex.bits.memory_operation
  def memory_aligned = execute_memory_operation.is_cache_block() ||| id_ex.bits.memory_width.is_aligned(alu.result)
  def execute_prefetch_operation :: CachePrefetchOperation = id_ex.bits.prefetch_operation
  def execute_is_memory = execute_memory_operation.is_memory()
  def fp_execution_control :: RV5StageFloatExecutionControl() = id_ex.bits.floating_point_control.execution
  def execute_is_fp = id_ex.bits.floating_point_valid
  def execute_fp_memory = execute_is_fp & (fp_execution_control.unit === RV5StageFloatUnit.Memory)
  def execute_fp_store = execute_fp_memory & fp_execution_control.memory_write
  def execute_fp_load = execute_fp_memory & !fp_execution_control.memory_write
  def execute_fp_compute = execute_is_fp & !execute_fp_memory
  def execute_request_fault = id_ex.bits.instruction_page_fault ||| id_ex.bits.instruction_access_fault ||| id_ex.bits.illegal ||| (
    execute_is_memory & !memory_aligned
  )
  def redirect_fault = redirect_requested & !redirect_aligned
  fun exception(cause :: ExceptionCause, value :: Bits(width)):
    RV5StageException(xlen):
      valid: Bool(#true)
      cause: exception_cause_bits(cause, width)
      value: value
  wire execute_exception: RV5StageException(xlen)
  when (id_ex.bits.instruction_access_fault):
    execute_exception <== exception(ExceptionCause.InstructionAccessFault, id_ex.bits.instruction_fault_address)
  elsewhen (id_ex.bits.instruction_page_fault):
    execute_exception <== exception(ExceptionCause.InstructionPageFault, id_ex.bits.instruction_fault_address)
  elsewhen (id_ex.bits.illegal):
    execute_exception <== exception(ExceptionCause.IllegalInstruction,
                                    instruction_value(id_ex.bits.raw_instruction))
  elsewhen redirect_fault:
    execute_exception <== exception(ExceptionCause.InstructionAddressMisaligned,
                                    computed_redirect_target)
  elsewhen (execute_is_memory & !memory_aligned):
    execute_exception <== data_exception(execute_memory_operation,
                                         alu.result,
                                         ExceptionCause.StoreAddressMisaligned,
                                         ExceptionCause.LoadAddressMisaligned)
  otherwise:
    execute_exception <== RV5StageException(xlen):
      valid: Bool(#false)
      cause: dont_care(Bits(width))
      value: dont_care(Bits(width))
  def csr_source = mux(
    id_ex.bits.system.immediate,
    id_ex.bits.instruction[15..20].zext(width),
    forwarded_rs1
  )
  def execute_result = mux_lookup(
    id_ex.bits.writeback_source,
    ~default: alu.result,
    [[WritebackSelect.Zero, zero],
     [WritebackSelect.SequentialPc, id_ex.bits.sequential_pc]]
  )
  def execute_multiply_issue = RV5StageMultiplyIssue(xlen):
    left: forwarded_rs1
    right: forwarded_rs2
    control: id_ex.bits.multiply_control
    rd: id_ex.bits.rd
  def execute_divide_issue = RV5StageDivideIssue(xlen):
    dividend: forwarded_rs1
    divisor: forwarded_rs2
    control: id_ex.bits.divide_control
    rd: id_ex.bits.rd
  def older_pipeline_squash = memory_exception_event ||| memory_replay_event ||| memory_redirect ||| commit_redirect

  def execute_fp_issue = RV5StageFpIssue(xlen, effective_fp_profile, Bits(width)):
    context: id_ex.bits.pc
    control: id_ex.bits.floating_point_control
    frs1: id_ex.bits.rs1
    frs2: id_ex.bits.rs2
    frs3: id_ex.bits.frs3
    frd: id_ex.bits.rd
    integer_operand: forwarded_rs1
    rounding_mode: id_ex.bits.floating_point_rounding_mode
  // EX only prepares operands. A missing store-read result becomes a replay;
  // execution and all architectural effects require WB authorization.
  def execute_transfer = id_ex.valid & !older_pipeline_squash
  def execute_prefetch_request = CachePrefetchReq(width):
    address: alu.result
    operation: execute_prefetch_operation
  def fp_store_response_match = fp.store_response.valid & (
    fp.store_response.bits.context === id_ex.bits.pc
  )
  def execute_fp_store_replay = execute_transfer & execute_fp_store & !execute_exception.valid & !fp_store_response_match
  def execute_replay = execute_fp_store_replay
  assert(!(execute_replay & execute_exception.valid),
         "rv5stage_execute_fault_does_not_replay")
  branch_resolver.request.valid <== execute_transfer
  branch_resolver.request.bits <== BranchResolverRequest(width):
    left: forwarded_rs1
    right: forwarded_rs2
    control: id_ex.bits.branch_control

  def execute_data_request = RV5StageDataReq(xlen):
    address: alu.result
    access: execute_memory_operation
    atomic: id_ex.bits.memory_atomic
    width: id_ex.bits.memory_width
    unsigned: id_ex.bits.memory_unsigned
    data: mux(execute_fp_store,
              if xlen == XLen.X32 | fp.store_response.bits.data[0..32] | fp.store_response.bits.data,
              forwarded_rs2)
    destination: mux(
      execute_fp_load,
      RV5StageDataDestination.FloatingPoint,
      mux(execute_memory_operation.returns_result(),
          RV5StageDataDestination.Integer,
          RV5StageDataDestination.None)
    )
    rd: id_ex.bits.rd
    floating_point_precision: fp_execution_control.destination_precision
    locality: RV5StageMemoryLocality.Default

  def execute_payload = ExecuteMemory(xlen):
    pc: id_ex.bits.pc
    resume_pc: mux(redirect_requested, computed_redirect_target, id_ex.bits.sequential_pc)
    redirect_valid: redirect_requested & !execute_exception.valid
    instruction: id_ex.bits.instruction
    replay: execute_replay
    data_request_valid: execute_is_memory & !execute_request_fault & !execute_replay
    data_request: execute_data_request
    fp_compute: execute_fp_compute
    fp_issue: execute_fp_issue
    prefetch: execute_prefetch_request
    writeback_source: id_ex.bits.writeback_source
    writeback_enable: id_ex.bits.writeback_enable & !execute_exception.valid
    rd: id_ex.bits.rd
    result: execute_result
    multiply_issue: execute_multiply_issue
    divide_issue: execute_divide_issue
    system: id_ex.bits.system
    fence: id_ex.bits.fence
    hint: id_ex.bits.hint
    csr_address: id_ex.bits.instruction[20..32]
    csr_source: csr_source
    exception_valid: execute_exception.valid
    exception_cause: execute_exception.cause
    exception_value: execute_exception.value

  def traced_execute = id_ex |> filter_valid(_operation => execute_transfer)
    |> trace_valid_event("core.execute", ~fields: operation):
         pc: operation.pc
         instruction: operation.instruction
  traced_execute |> map_valid(_operation => execute_payload) |> ex_mem_pipe.ingress

  // MEM remains speculative: forward prepared operands without dispatch,
  // recover branches, and bypass pure integer results.
  def live_memory = memory |> filter_valid(_operation => memory_stage_valid) |> trace_valid_event("core.memory", ~fields: operation):
    pc: operation.pc
    instruction: operation.instruction
  def Array(memory_writeback_path, memory_exception_path, memory_replay_path) = live_memory |> fork_valid(3)
  memory_exception_path |> filter_valid(operation => operation.exception_valid)
    |> map_valid(operation => operation.pc) |> memory_exception_link.left
  memory_replay_path |> filter_valid(operation => operation.replay)
    |> map_valid(operation => operation.pc) |> memory_replay_link.left
  def memory_writeback = memory_writeback_path |> map_valid(operation => MemoryWriteback(xlen)):
    pc: operation.pc
    resume_pc: operation.resume_pc
    instruction: operation.instruction
    replay: operation.replay
    data_request_valid: operation.data_request_valid
    data_request: operation.data_request
    fp_compute: operation.fp_compute
    fp_issue: operation.fp_issue
    prefetch: operation.prefetch
    writeback_source: operation.writeback_source
    write_enable: operation.writeback_enable & !operation.exception_valid & !operation.replay
    rd: operation.rd
    value: operation.result
    multiply_issue: operation.multiply_issue
    divide_issue: operation.divide_issue
    system: operation.system
    fence: operation.fence
    hint: operation.hint
    csr_address: operation.csr_address
    csr_source: operation.csr_source
    exception_valid: operation.exception_valid
    exception_cause: operation.exception_cause
    exception_value: operation.exception_value
  memory_writeback |> mem_wb_pipe.ingress

  // WB is the sole instruction-side dispatch boundary. An attempted request
  // either faults, transfers irrevocably, or replays without any side effect.
  // Loads also issue here: their address may select a side-effecting device.
  // In-order WB associates NTL with exactly one successor, not one memory
  // access. Rejected dispatch and pipeline replay leave this state untouched.
  reg pending_locality(~init: RV5StageMemoryLocality.Default)
  def retiring_locality = mux_lookup(
    commit_bits.hint,
    ~default: RV5StageMemoryLocality.Default,
    [[HintOperation.NtlP1, RV5StageMemoryLocality.P1],
     [HintOperation.NtlPall, RV5StageMemoryLocality.Pall],
     [HintOperation.NtlS1, RV5StageMemoryLocality.S1],
     [HintOperation.NtlAll, RV5StageMemoryLocality.All]]
  )
  when (csrs.redirect.valid):
    pending_locality <== RV5StageMemoryLocality.Default
  elsewhen (commit_valid & !commit_bits.exception_valid):
    pending_locality <== retiring_locality
  def wb_attempt = pipeline_wb.valid & !maintenance_pending & !reservation_wait_pending & !reservation_wait_accept & !pending_exception_valid & !wb_bits.replay & !wb_bits.exception_valid
  def wb_memory_attempt = wb_attempt & wb_bits.data_request_valid
  def wb_fp_load = wb_bits.data_request.destination === RV5StageDataDestination.FloatingPoint
  // Use registered destination availability for request admission. The FP
  // reservation's same-cycle completion bypass must not feed LSU request valid.
  def wb_fp_load_ready = !wb_fp_load ||| !scoreboard_busy(register_count, fp.busy, wb_bits.data_request.rd)
  pipeline_wb |> filter_valid(_operation => wb_memory_attempt & wb_fp_load_ready)
    |> map_valid(operation => operation.data_request.updated(
         ~locality: mux(operation.data_request.access.into(MemoryOperation).is_one_of(MemoryOperation.Load, MemoryOperation.Store), pending_locality, RV5StageMemoryLocality.Default)
       ))
    |> eject_flow(~valid: data_access.request.valid, ~bits: data_access.request.bits)
  pipeline_wb |> filter_valid(_operation => wb_attempt & wb_bits.fp_compute)
    |> map_valid(operation => operation.fp_issue)
    |> eject_flow(~valid: fp.issue.valid, ~bits: fp.issue.bits)
  def wb_page_fault = data_access.request.valid & data_access.request_fault
  def wb_access_fault = (data_access.request.valid & !wb_page_fault & data_access.request_access_fault) ||| (maintenance_done & data_access.response.bits.access_fault)
  def wb_data_fault = wb_page_fault ||| wb_access_fault
  def wb_memory_accepted = data_access.request.fire() & !wb_data_fault
  maintenance_accepted <== wb_memory_accepted & wb_bits.data_request.access.into(MemoryOperation).is_cache_management()
  when maintenance_accepted:
    maintenance_pending <== Bool(#true)
    maintenance_instruction <== wb_bits
  elsewhen maintenance_done:
    maintenance_pending <== Bool(#false)
  def wb_memory_replay = wb_memory_attempt & (!wb_fp_load_ready ||| (!wb_data_fault & !data_access.request.ready))
  def wb_fp_replay = fp.issue.valid & !fp.issue.ready
  def wb_replay = wb_bits.replay ||| wb_memory_replay ||| wb_fp_replay
  wire wb_exception: RV5StageException(xlen)
  when (wb_bits.exception_valid):
    wb_exception <== RV5StageException(xlen):
      valid: Bool(#true)
      cause: wb_bits.exception_cause
      value: wb_bits.exception_value
  elsewhen wb_page_fault:
    wb_exception <== data_exception(wb_bits.data_request.access, wb_bits.data_request.address, ExceptionCause.StorePageFault, ExceptionCause.LoadPageFault)
  elsewhen wb_access_fault:
    wb_exception <== data_exception(wb_bits.data_request.access, wb_bits.data_request.address, ExceptionCause.StoreAccessFault, ExceptionCause.LoadAccessFault)
  elsewhen reservation_wait_illegal:
    wb_exception <== RV5StageException(xlen):
      valid: Bool(#true)
      cause: exception_cause_bits(ExceptionCause.IllegalInstruction, width)
      value: instruction_value(wb_bits.instruction)
  otherwise:
    wb_exception <== RV5StageException(xlen):
      valid: Bool(#false)
      cause: dont_care(Bits(width))
      value: dont_care(Bits(width))
  commit_result <== wb_bits.updated(
    ~replay: wb_replay,
    ~write_enable: wb_bits.write_enable & !wb_exception.valid & !wb_replay,
    ~exception_valid: wb_exception.valid,
    ~exception_cause: wb_exception.cause,
    ~exception_value: wb_exception.value
  )
  def fp_load_reservation:
    wb |> filter_valid(_operation => wb_memory_accepted & wb_fp_load)
      |> map_valid(operation => RV5StageFpLoadReservation(Bits(width))):
           context: operation.pc
           precision: operation.data_request.floating_point_precision
           rd: operation.data_request.rd
  fp_load_reservation |> to_decoupled() |> fp.load_reserve
  commit |> filter_valid(operation => !operation.replay & !operation.exception_valid & wb_bits.prefetch.into(CachePrefetchReq(width)).operation.into(CachePrefetchOperation).is_prefetch())
    |> map_valid(operation => operation.prefetch) |> prefetch
  assert(!(wb_data_fault & wb_memory_replay), "rv5stage_wb_fault_does_not_replay")
  assert(!(wb_memory_accepted & wb_replay), "rv5stage_wb_memory_accept_does_not_replay")
  assert(!(fp.issue.fire() & wb_replay), "rv5stage_wb_fp_accept_does_not_replay")

  // Older authorized work must finish before entering a precise trap. Younger
  // speculative pipeline occupancy is not outstanding architectural work.
  def current_exception_wait = commit_valid & commit_bits.exception_valid & (deferred_results_pending ||| !data_access.drained)
  def architectural_commit = mux(pending_exception_valid, pending_exception, commit_bits)
  def pending_exception_ready = pending_exception_valid & !deferred_results_pending & data_access.drained
  csrs.interrupt_boundary <== !maintenance_pending & !reservation_wait_pending & !reservation_wait_accept & !pending_exception_valid & !id_ex.valid & !memory.valid & !wb.valid & !deferred_results_pending & data_access.drained
  csrs.interrupt_pc <== mux(commit_replay,
                            commit_bits.pc,
                            mux(commit_valid, commit_bits.resume_pc, architectural_pc))
  csrs.commit.valid <== pending_exception_ready ||| (commit_valid & !current_exception_wait)
  csrs.commit.bits <== RV5StageCsrCommit(xlen):
    pc: architectural_commit.pc
    instruction: architectural_commit.instruction
    rd: architectural_commit.rd
    system: architectural_commit.system
    fence: architectural_commit.fence
    csr_address: architectural_commit.csr_address
    csr_source: architectural_commit.csr_source
    exception_valid: architectural_commit.exception_valid
    exception_cause: architectural_commit.exception_cause
    exception_value: architectural_commit.exception_value

  when current_exception_wait:
    pending_exception_valid <== Bool(#true)
    pending_exception <== commit_bits
  elsewhen (pending_exception_valid & csrs.redirect.valid):
    pending_exception_valid <== Bool(#false)

  (
    commit
      |> filter_valid(committed => !committed.replay & deferred_writeback(committed.writeback_source) & (
          committed.write_enable
        ) & committed.rd.or_reduce())
      |> map_valid(committed => committed.rd)
  ) |> scoreboard_set_link.left

  (
    commit
      |> filter_valid(committed => !committed.replay & !deferred_writeback(committed.writeback_source) & (
          committed.write_enable
        ) & ((committed.writeback_source =/= WritebackSelect.Csr) ||| csrs.writeback_valid))
      |> map_valid(committed => RegisterFileWrite(xlen)):
          address: committed.rd
          data: mux(
            committed.writeback_source === WritebackSelect.Csr,
            csrs.writeback_value,
            committed.value
          )
  ) |> commit_write

  // Retirement authorizes issue; retained maintenance/WRS context never selects arithmetic operands.
  (
    commit
      |> filter_valid(committed => !committed.replay & (
          committed.writeback_source === WritebackSelect.Multiply
        ) & committed.write_enable & committed.rd.or_reduce())
      |> map_valid(_committed => pipeline_wb.bits.multiply_issue)
  ) |> multiplier.issue
  when commit_has_multiply:
    assert(multiplier.available, "rv5stage_multiplier_commit_reserved")
  (
    commit
      |> filter_valid(committed => !committed.replay & (
          committed.writeback_source === WritebackSelect.Divide
        ) & committed.write_enable & committed.rd.or_reduce())
      |> map_valid(_committed => pipeline_wb.bits.divide_issue)
  ) |> divider.issue
  when commit_has_divide:
    assert(divider.available, "rv5stage_divider_commit_reserved")

  fp_integer_scoreboard.set.valid <== fp.issue.fire() & (
    fp.issue.bits.control.registers.destination === RV5StageFloatDestination.Integer
  ) & fp.issue.bits.frd.or_reduce()
  fp_integer_scoreboard.set.bits <== fp.issue.bits.frd

  // Deferred loads and arithmetic complete outside the ordered pipeline. The
  // fixed-priority arbiter lets nonbackpressured L1D responses win while the
  // arithmetic units hold their irrevocable results.
  inst deferred_completion_arbiter(Arbiter(RegisterFileWrite(xlen), 4))
  def integer_load_completion = (
    data_access.response
      |> filter_valid(response => (
          response.destination === RV5StageDataDestination.Integer
        ) & response.rd.or_reduce())
      |> map_valid(response => RegisterFileWrite(xlen)):
          address: response.rd
          data: response.data
  )
  integer_load_completion |> to_decoupled() |> deferred_completion_arbiter.ingress[0]
  (
    multiplier.completion
      |> map_flow(~stable: #true, completion => RegisterFileWrite(xlen)):
          address: completion.rd
          data: completion.value
  ) |> deferred_completion_arbiter.ingress[1]
  (
    divider.completion
      |> map_flow(~stable: #true, completion => RegisterFileWrite(xlen)):
          address: completion.rd
          data: completion.value
  ) |> deferred_completion_arbiter.ingress[2]
  (
    fp.completion
      |> filter_flow(completion => (
          completion.destination === RV5StageFloatDestination.Integer
        ) & completion.rd.or_reduce())
      |> map_flow(completion => RegisterFileWrite(xlen)):
          address: completion.rd
          data: completion.integer_value
  ) |> deferred_completion_arbiter.ingress[3]
  def Array(
    completed_register_write,
    completed_integer_scoreboard_clear,
    completed_fp_integer_scoreboard_clear
  ) = deferred_completion_arbiter.egress |> to_valid() |> fork_valid(3)
  completed_register_write |> deferred_completion_write
  (
    completed_integer_scoreboard_clear
      |> filter_valid(_write => deferred_completion_arbiter.chosen =/= bits(3, 2))
      |> map_valid(write => write.address)
  ) |> scoreboard_clear_link.left
  (
    completed_fp_integer_scoreboard_clear
      |> filter_valid(_write => deferred_completion_arbiter.chosen === bits(3, 2))
      |> map_valid(write => write.address)
  ) |> fp_integer_scoreboard.clear

  (
    data_access.response
      |> filter_valid(response => response.destination === RV5StageDataDestination.FloatingPoint)
      |> map_valid(response => RV5StageFpLoadCompletion(Bits(width))):
          context: bits(0, width)
          precision: response.floating_point_precision
          rd: response.rd
          data: if xlen == XLen.X32 | response.data.zext(64) | response.data
  ) |> fp.load_completion

export:
  RV5StageCore
