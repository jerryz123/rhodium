#lang rhodium
/* Adapts the reusable iterative divider to RV5Stage's deferred-writeback protocol. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/integer-format.rhdl") open
  lib("cores/integer-service.rhdl") open
  lib("cores/integer-execution.rhdl") open
  "../divider.rhdl" open
  "decode/divide-ctrl.rhdl" open
  "../divide-decode.rhdl" open
  "../../riscv/isa/xlen.rhm" open
  lib("flow/main.rhdl") open

/* Carries dividend, divisor, operation controls, and GPR destination. */
bundle RV5StageDivideIssue(xlen :: XLen):
  dividend: Bits(xlen.width)
  divisor: Bits(xlen.width)
  control: RiscvDivideControl()
  rd: Bits(5)

/* Returns a quotient or remainder with its architectural GPR destination. */
bundle RV5StageDivideCompletion(xlen :: XLen):
  rd: Bits(5)
  value: Bits(xlen.width)

/* Retains destination, quotient/remainder choice, and RV64 word-result normalization. */
bundle RV5StageDivideTag():
  rd: Bits(5)
  remainder: Bool
  word_result: Bool

/* Queues authorized division, normalizes RV64 word operands, and maps tagged results
   to GPR completions while preserving result backpressure. */
sync_circuit RV5StageDivideScalar(xlen :: XLen):
  def width = xlen.width

  interface issue(Valid(RV5StageDivideIssue(xlen)), ~role: consumer)
  interface completion(Irrevocable(RV5StageDivideCompletion(xlen)), ~role: producer)
  output available: Bool

  def Request = IntegerExecutionRequest(DividerRequest(width), RV5StageDivideTag())
  interface execution_request(Decoupled(Request), ~role: producer)
  interface execution_result(Irrevocable(IntegerExecutionResult(DividerResponse(width), RV5StageDivideTag())), ~role: consumer)
  inst authorized(Queue(Request, 1))

  def normalized_dividend = integer_word_operand(xlen, issue.bits.dividend, issue.bits.control.signed_mode, issue.bits.control.word_result)
  def normalized_divisor = integer_word_operand(xlen, issue.bits.divisor, issue.bits.control.signed_mode, issue.bits.control.word_result)

  available <== authorized.ingress.ready
  (
    issue |> to_decoupled() |> map_flow(issued):
      IntegerExecutionRequest(DividerRequest(width), RV5StageDivideTag()):
        tag:
          RV5StageDivideTag():
            rd: issued.rd
            remainder: issued.control.remainder
            word_result: issued.control.word_result

        operands:
          DividerRequest(width):
            dividend: normalized_dividend
            divisor: normalized_divisor
            signed_mode: issued.control.signed_mode
  ) |> authorized.ingress

  authorized.egress |> execution_request

  when (issue.valid):
    assert(available, "scalar_divide_issue_has_reserved_slot")

  def selected_result = integer_divide_result(xlen, execution_result.bits.value, execution_result.bits.tag.remainder, execution_result.bits.tag.word_result)

  (
    execution_result |> map_flow(~stable: #true, _result):
      RV5StageDivideCompletion(xlen):
        rd: execution_result.bits.tag.rd
        value: selected_result
  ) |> completion

/* Composes the scalar adapter and tagged iterative divider for standalone use. */
sync_circuit RV5StageDivider(xlen :: XLen):
  interface issue(Valid(RV5StageDivideIssue(xlen)), ~role: consumer)
  interface completion(Irrevocable(RV5StageDivideCompletion(xlen)), ~role: producer)
  output available: Bool
  inst scalar(RV5StageDivideScalar(xlen))
  inst execution(DivideService(xlen.width, RV5StageDivideTag()))
  issue |> scalar.issue
  scalar.execution_request |> execution.request
  execution.result |> scalar.execution_result
  scalar.completion |> completion
  available <== scalar.available

export:
  RV5StageDivideIssue
  RV5StageDivideCompletion
  RV5StageDivider
  RV5StageDivideScalar
  RV5StageDivideTag
