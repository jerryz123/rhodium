#lang rhombus
/* Defines RV5Stage capability validation and immutable microarchitectural configuration. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../profile.rhm" open
  "../vector/profile.rhm".check_vector_profile
  "../csr/config.rhm".RiscvCsrConfig
  "../fp/profile.rhm".check_fp_profile
  "../cache/config.rhm" open
  lib("rhodium/frontend/foundation.rhm").StableCircuitParam
  lib("rhodium/std/bits.rhdl").Pow2Int
  lib("riscv/isa/c.rhm") open
  lib("riscv/isa/fp-profile.rhm") open
  lib("riscv/isa/vector-profile.rhm") open
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/vector.rhm").VectorLength
  lib("riscv/isa/profile.rhm") open
  lib("riscv/isa/hart.rhm") open

/* Selects iterative or fixed-latency pipelined shared multiplication. */
enum RV5StageMultiplierKind
| Iterative
| Pipelined

/* Selects scalar and privileged features; cross-feature validation belongs to RV5StageConfig. */
class RV5StageExtensions(floating_point :: FloatingPointProfile,
                         half_precision :: HalfPrecisionProfile,
                         zfa :: Boolean,
                         zicbop :: Boolean,
                         zicboz :: Boolean,
                         zicbom :: Boolean,
                         ziccif :: Boolean,
                         ziccamoa :: Boolean,
                         ziccrse :: Boolean,
                         ssnpm :: Boolean,
                         supm :: Boolean,
                         svpbmt :: Boolean,
                         svnapot :: Boolean,
                         sstc :: Boolean,
                         sscofpmf :: Boolean,
                         smstateen :: Boolean,
                         svinval :: Boolean,
                         hypervisor :: Boolean,
                         zawrs :: Boolean,
                         zihintpause :: Boolean,
                         zihintntl :: Boolean,
                         compressed :: List.of(CompressedExtension)):
  implements StableCircuitParam

  /* Records explicit feature choices with optional extensions disabled by default. */
  constructor (~floating_point: floating_point :: FloatingPointProfile = DefaultFloatingPointProfile,
               ~half_precision: half_precision :: HalfPrecisionProfile = DefaultHalfPrecisionProfile,
               ~zfa: zfa :: Boolean = #false,
               ~zicbop: zicbop :: Boolean = #false,
               ~zicboz: zicboz :: Boolean = #false,
               ~zicbom: zicbom :: Boolean = #false,
               ~ziccif: ziccif :: Boolean = #false,
               ~ziccamoa: ziccamoa :: Boolean = #false,
               ~ziccrse: ziccrse :: Boolean = #false,
               ~ssnpm: ssnpm :: Boolean = #false,
               ~supm: supm :: Boolean = #false,
               ~svpbmt: svpbmt :: Boolean = #false,
               ~svnapot: svnapot :: Boolean = #false,
               ~sstc: sstc :: Boolean = #false,
               ~sscofpmf: sscofpmf :: Boolean = #false,
               ~smstateen: smstateen :: Boolean = #false,
               ~svinval: svinval :: Boolean = #false,
               ~hypervisor: hypervisor :: Boolean = #false,
               ~zawrs: zawrs :: Boolean = #false,
               ~zihintpause: zihintpause :: Boolean = #false,
               ~zihintntl: zihintntl :: Boolean = #false,
               ~compressed: compressed :: List.of(CompressedExtension) = DefaultCompressedExtensions):
    super(floating_point, half_precision, zfa, zicbop, zicboz, zicbom, ziccif, ziccamoa, ziccrse, ssnpm, supm, svpbmt, svnapot, sstc, sscofpmf, smstateen, svinval, hypervisor, zawrs, zihintpause, zihintntl, compressed)

  /* Rebuilds the feature selection while preserving unchanged choices. */
  reconstructor (floating_point, half_precision, zfa, zicbop, zicboz,
                 zicbom, ziccif, ziccamoa, ziccrse, ssnpm, supm, svpbmt, svnapot, sstc, sscofpmf, smstateen, svinval, hypervisor, zawrs,
                 zihintpause, zihintntl, compressed):
    RV5StageExtensions(
      ~floating_point: floating_point,
      ~half_precision: half_precision,
      ~zfa: zfa,
      ~zicbop: zicbop,
      ~zicboz: zicboz,
      ~zicbom: zicbom,
      ~ziccif: ziccif,
      ~ziccamoa: ziccamoa,
      ~ziccrse: ziccrse,
      ~ssnpm: ssnpm,
      ~supm: supm,
      ~svpbmt: svpbmt,
      ~svnapot: svnapot,
      ~sstc: sstc,
      ~sscofpmf: sscofpmf,
      ~smstateen: smstateen,
      ~svinval: svinval,
      ~hypervisor: hypervisor,
      ~zawrs: zawrs,
      ~zihintpause: zihintpause,
      ~zihintntl: zihintntl,
      ~compressed: compressed
    )

  /* Validates compressed-extension dependencies and computes their architectural misa.C claim. */
  method compressed_misa_c(xlen :: XLen) :: Boolean:
    compressed_extensions_report_misa_c(xlen, floating_point, compressed)

  /* Projects scalar feature choices into ISA names, including fixed implemented guarantees. */
  method names(xlen :: XLen) :: NonemptyList.of(String):
    def scalar = core_scalar_extensions(floating_point, compressed, hypervisor) ++ core_fp_extensions(half_precision, zfa)
    def memory = core_memory_extensions(~zicbop: zicbop, ~zicboz: zicboz, ~zicbom: zicbom, ~ziccamoa: ziccamoa, ~ziccif: ziccif, ~ziccrse: ziccrse)
    def pointer_masking = (if ssnpm | ["ssnpm"] | []) ++ (if supm | ["supm"] | [])
    def privileged = core_privileged_extensions(~sstc: sstc, ~svinval: svinval, ~svpbmt: svpbmt, ~svnapot: svnapot, ~smstateen: smstateen, ~hypervisor: hypervisor, ~sscofpmf: sscofpmf)
    scalar ++ memory ++ pointer_masking ++ core_hint_extensions(zawrs, zihintpause, zihintntl) ++ CoreSystemExtensions ++ privileged

/* Groups independently configurable instruction and data cache geometries. */
class RV5StageCacheGeometry(instruction :: CacheConfig,
                            data :: CacheConfig):
  implements StableCircuitParam

  /* Defaults each private cache to 64 sets and one way. */
  constructor (~instruction: instruction :: CacheConfig = CacheConfig(64, 1),
               ~data: data :: CacheConfig = CacheConfig(64, 1)):
    super(instruction, data)

  /* Replaces either cache geometry without coupling the two caches. */
  reconstructor (instruction, data):
    RV5StageCacheGeometry(~instruction: instruction, ~data: data)

/* Owns validated ISA selection, cache geometry, and scalar/vector execution capacities. */
class RV5StageConfig(xlen :: XLen,
                     extensions :: RV5StageExtensions,
                     mmu_mode :: RiscvMmuType,
                     cache_geometry :: RV5StageCacheGeometry,
                     data_cache_service_queue_depth :: PosInt,
                     multiplier :: RV5StageMultiplierKind,
                     vector :: VectorProfile,
                     vector_extensions :: List.of(VectorExtension),
                     vector_length :: VectorLength,
                     vector_completion_slots :: Pow2Int):
  implements StableCircuitParam

  /* Rejects unsupported translation, privilege, FP, and vector combinations before elaboration. */
  constructor (~xlen: xlen :: XLen,
               ~extensions: extensions :: RV5StageExtensions = RV5StageExtensions(),
               ~mmu_mode: mmu_mode :: RiscvMmuType = RiscvMmuType.Bare,
               ~cache_geometry: cache_geometry :: RV5StageCacheGeometry = RV5StageCacheGeometry(),
               ~data_cache_service_queue_depth: data_cache_service_queue_depth :: PosInt = 2,
               ~multiplier: multiplier :: RV5StageMultiplierKind = RV5StageMultiplierKind.Iterative,
               ~vector: vector :: VectorProfile = DefaultVectorProfile,
               ~vector_extensions: vector_extensions :: List.of(VectorExtension) = DefaultVectorExtensions,
               ~vector_length: vector_length :: VectorLength = 128,
               ~vector_completion_slots: vector_completion_slots :: Pow2Int = 8):
    check_fp_profile(
      xlen,
      extensions.floating_point,
      extensions.half_precision,
      ~zfa: extensions.zfa
    )

    extensions.compressed_misa_c(xlen)
    when xlen == XLen.X32 && extensions.ssnpm
    | error(~who: #'RV5StageConfig, "Ssnpm requires RV64")

    when extensions.supm && !extensions.ssnpm
    | error(~who: #'RV5StageConfig, "Supm requires Ssnpm hardware")

    when xlen == XLen.X32 && mmu_mode != RiscvMmuType.Bare
    | error(~who: #'RV5StageConfig, "RV32 profiles support only Bare translation")

    when extensions.svpbmt && (xlen != XLen.X64 || mmu_mode != RiscvMmuType.Sv39)
    | error(~who: #'RV5StageConfig, "Svpbmt requires RV64 Sv39")

    when extensions.svnapot && (xlen != XLen.X64 || mmu_mode != RiscvMmuType.Sv39)
    | error(~who: #'RV5StageConfig, "Svnapot requires RV64 Sv39")

    when extensions.hypervisor && (xlen != XLen.X64 || mmu_mode != RiscvMmuType.Sv39)
    | error(~who: #'RV5StageConfig, "H requires RV64 Sv39")

    check_vector_profile(xlen, extensions.floating_point, extensions.half_precision, vector, vector_extensions)
    when vector_profile_enabled(vector) && vector_length < 2 * xlen.width
    | error(~who: #'RV5StageConfig, "the integrated vector pipeline requires at least two XLEN-wide rows per register")

    super(xlen, extensions, mmu_mode, cache_geometry, data_cache_service_queue_depth, multiplier, vector, vector_extensions, vector_length, vector_completion_slots)

  /* Reapplies configuration checks after a specialization parameter changes. */
  reconstructor (xlen, extensions, mmu_mode, cache_geometry,
                 data_cache_service_queue_depth, multiplier, vector,
                 vector_extensions, vector_length,
                 vector_completion_slots):
    RV5StageConfig(
      ~xlen: xlen,
      ~extensions: extensions,
      ~mmu_mode: mmu_mode,
      ~cache_geometry: cache_geometry,
      ~data_cache_service_queue_depth: data_cache_service_queue_depth,
      ~multiplier: multiplier,
      ~vector: vector,
      ~vector_extensions: vector_extensions,
      ~vector_length: vector_length,
      ~vector_completion_slots: vector_completion_slots
    )

  /* Derives ISA names and MISA bits from the same choices used to build hardware. */
  property isa_profile :: RiscvIsaProfile:
    def selected_vector = vector_profile_isa_extensions(vector, vector_length, vector_extensions)
    // Fixed behavioral guarantees validated on the RV64 Sv39 implementation,
    // not optional datapaths or new implementation switches.
    def supervisor = if xlen == XLen.X64 && mmu_mode == RiscvMmuType.Sv39 | core_supervisor_extensions(~page_tables: #true) | []
    def names = extensions.names(xlen) ++ supervisor ++ selected_vector ++ (if vector_profile_enabled(vector) | ["zvkt"] | [])
    def misa = core_misa_extensions(extensions.floating_point, extensions.compressed_misa_c(xlen), vector, extensions.hypervisor)
    RiscvIsaProfile(xlen, names, misa)

  /* Selects architectural CSR banks without exporting pipeline, cache, or execution configuration. */
  property csr_config :: RiscvCsrConfig:
    RiscvCsrConfig(
      isa_profile,
      ~mmu_type: mmu_mode,
      ~floating_point: extensions.floating_point,
      ~compressed: extensions.compressed,
      ~vector: vector,
      ~vector_length: vector_length,
      ~hypervisor: extensions.hypervisor,
      ~sscofpmf: extensions.sscofpmf,
      ~sstc: extensions.sstc,
      ~smstateen: extensions.smstateen,
      ~zicboz: extensions.zicboz,
      ~zicbom: extensions.zicbom,
      ~ssnpm: extensions.ssnpm,
      ~svpbmt: extensions.svpbmt
    )

  /* Projects architectural translation, cache, CBO, and vector facts for platform descriptions. */
  property hart_description :: RiscvHartDescription:
    RiscvHartDescription(
      isa_profile,
      mmu_mode,
      RiscvCacheDescription(CacheLineBytes, cache_geometry.instruction.sets, cache_geometry.instruction.capacity_bytes),
      RiscvCacheDescription(CacheLineBytes, cache_geometry.data.sets, cache_geometry.data.capacity_bytes),
      ~cbo_block_bytes: CacheLineBytes,
      ~vector: if vector_profile_enabled(vector) | RiscvVectorDescription(vector_length, vector_profile_elen_bits(vector)) | #false
    )

export:
  CacheLineBytes
  CacheConfig
  RV5StageMultiplierKind
  RV5StageExtensions
  RV5StageCacheGeometry
  RV5StageConfig
