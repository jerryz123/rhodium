#lang rhombus
// Defines RV5Stage capability validation and immutable microarchitectural configuration.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/core/types.rhm").count_index_width
  lib("rhodium/frontend/foundation.rhm").StableCircuitParam
  lib("rhodium/std/bits.rhdl").Pow2Int
  lib("riscv/isa/c.rhm") open
  lib("riscv/isa/fp-profile.rhm") open
  lib("riscv/isa/vector-profile.rhm") open
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/vector.rhm").VectorLength
  lib("riscv/isa/profile.rhm") open

def RV5StageCacheLineBytes :: Pow2Int = 64

class RV5StageCacheConfig(sets :: Pow2Int, ways :: PosInt):
  implements StableCircuitParam

  constructor (sets :: Pow2Int, ways :: PosInt):
    unless sets >= 2
    | error(~who: #'RV5StageCacheConfig,
            "set count must be a power of two of at least two")
    unless sets * RV5StageCacheLineBytes <= 4096
    | error(~who: #'RV5StageCacheConfig,
            "VIPT requires sets * line bytes <= 4096 (at most 4 KiB per way)")
    super(sets, ways)

  property set_width :: PosInt: count_index_width(sets)
  property way_width :: PosInt: count_index_width(ways)
  property line_count :: PosInt: sets * ways
  property capacity_bytes :: PosInt: line_count * RV5StageCacheLineBytes

enum RV5StageMmuMode
| Bare
| Sv39

class RV5StageExtensions(floating_point :: FloatingPointProfile,
                         half_precision :: HalfPrecisionProfile,
                         zfa :: Boolean,
                         zicbop :: Boolean,
                         zicboz :: Boolean,
                         zicbom :: Boolean,
                         ziccif :: Boolean,
                         ziccamoa :: Boolean,
                         ziccrse :: Boolean,
                         ssnpm :: Boolean,
                         zawrs :: Boolean,
                         zihintpause :: Boolean,
                         zihintntl :: Boolean,
                         compressed :: List.of(CompressedExtension)):
  implements StableCircuitParam

  constructor (~floating_point: floating_point :: FloatingPointProfile = DefaultFloatingPointProfile,
               ~half_precision: half_precision :: HalfPrecisionProfile = DefaultHalfPrecisionProfile,
               ~zfa: zfa :: Boolean = #false,
               ~zicbop: zicbop :: Boolean = #false,
               ~zicboz: zicboz :: Boolean = #false,
               ~zicbom: zicbom :: Boolean = #false,
               ~ziccif: ziccif :: Boolean = #false,
               ~ziccamoa: ziccamoa :: Boolean = #false,
               ~ziccrse: ziccrse :: Boolean = #false,
               ~ssnpm: ssnpm :: Boolean = #false,
               ~zawrs: zawrs :: Boolean = #false,
               ~zihintpause: zihintpause :: Boolean = #false,
               ~zihintntl: zihintntl :: Boolean = #false,
               ~compressed: compressed :: List.of(CompressedExtension) = DefaultCompressedExtensions):
    super(floating_point, half_precision, zfa, zicbop, zicboz, zicbom, ziccif, ziccamoa, ziccrse, ssnpm, zawrs, zihintpause, zihintntl, compressed)

  method compressed_misa_c(xlen :: XLen) :: Boolean:
    compressed_extensions_report_misa_c(xlen, floating_point, compressed)

  method names(xlen :: XLen) :: NonemptyList.of(String):
    def mutable single_letter = ["i", "m", "a"]
    when floating_point_supports_f(floating_point)
    | single_letter := single_letter ++ ["f"]
    when floating_point_supports_d(floating_point)
    | single_letter := single_letter ++ ["d"]
    when compressed.contains(CompressedExtension.C)
    | single_letter := single_letter ++ ["c"]
    single_letter := single_letter ++ ["b"]

    def mutable multi_letter = []
    multi_letter := multi_letter ++ ["za64rs", "zba", "zbb", "zbs"]
    unless compressed.contains(CompressedExtension.C)
    | block:
        when compressed.contains(CompressedExtension.Zca)
        | multi_letter := multi_letter ++ ["zca"]
        when compressed.contains(CompressedExtension.Zcb)
        | multi_letter := multi_letter ++ ["zcb"]
        when compressed.contains(CompressedExtension.Zcd)
        | multi_letter := multi_letter ++ ["zcd"]
        when compressed.contains(CompressedExtension.Zcf)
        | multi_letter := multi_letter ++ ["zcf"]
    when compressed.contains(CompressedExtension.Zcmop)
    | multi_letter := multi_letter ++ ["zcmop"]
    when zfa
    | multi_letter := multi_letter ++ ["zfa"]
    cond
    | half_precision == HalfPrecisionProfile.Zfh:
        multi_letter := multi_letter ++ ["zfh"]
    | half_precision == HalfPrecisionProfile.Zfhmin:
        multi_letter := multi_letter ++ ["zfhmin"]
    | ~else: #void
    def cache_block = ["zic64b"] ++ (if zicbop | ["zicbop"] | []) ++ (if zicboz | ["zicboz"] | []) ++ (if zicbom | ["zicbom"] | [])
    def main_memory = (if ziccamoa | ["ziccamoa"] | []) ++ (if ziccif | ["ziccif"] | []) ++ (if ziccrse | ["ziccrse"] | [])
    single_letter ++ multi_letter ++ cache_block ++ main_memory ++ (if zawrs | ["zawrs"] | []) ++ (if zihintpause | ["zihintpause"] | []) ++ (if zihintntl | ["zihintntl"] | []) ++ ["zicntr", "zicond", "zicsr", "zifencei", "zihpm", "zimop", "zkt"]

class RV5StageCacheGeometry(instruction :: RV5StageCacheConfig,
                            data :: RV5StageCacheConfig):
  implements StableCircuitParam

  constructor (~instruction: instruction :: RV5StageCacheConfig = RV5StageCacheConfig(64, 1),
               ~data: data :: RV5StageCacheConfig = RV5StageCacheConfig(64, 1)):
    super(instruction, data)

fun rv5stage_floating_point_profile_supported(xlen :: XLen,
                                              profile :: FloatingPointProfile,
                                              half_precision :: HalfPrecisionProfile = DefaultHalfPrecisionProfile,
                                              ~zfa: zfa_enabled :: Boolean = #false):
  ((profile == FloatingPointProfile.None) || (
    (xlen == XLen.X32) && (profile == FloatingPointProfile.F)
  ) || (
    (xlen == XLen.X64) && (profile == FloatingPointProfile.D)
  )) && !(profile == FloatingPointProfile.None && (
    half_precision != HalfPrecisionProfile.None || zfa_enabled
  ))

fun check_rv5stage_floating_point_profile(xlen :: XLen,
                                          profile :: FloatingPointProfile,
                                          half_precision :: HalfPrecisionProfile = DefaultHalfPrecisionProfile,
                                          ~zfa: zfa_enabled :: Boolean = #false):
  unless rv5stage_floating_point_profile_supported(xlen,
                                                   profile,
                                                   half_precision,
                                                   ~zfa: zfa_enabled)
  | error(~who: #'check_rv5stage_floating_point_profile,
          "RV5Stage supports only disabled FP, RV32F, or RV64D, with optional Zfhmin, Zfh, or Zfa")

fun check_rv5stage_vector_profile(xlen :: XLen,
                                  floating_point :: FloatingPointProfile,
                                  half_precision :: HalfPrecisionProfile,
                                  vector :: VectorProfile,
                                  vector_extensions :: List.of(VectorExtension) = DefaultVectorExtensions):
  validate_vector_extensions(vector, vector_extensions)
  when vector_profile_enabled(vector) && xlen != XLen.X64
  | error(~who: #'check_rv5stage_vector_profile, "RV5Stage vector profiles require RV64")
  when vector_profile_supports_fp64(vector) && !floating_point_supports_d(floating_point)
  | error(~who: #'check_rv5stage_vector_profile, "Zve64d and V require scalar D")
  when vector_profile_supports_fp32(vector) && !floating_point_supports_f(floating_point)
  | error(~who: #'check_rv5stage_vector_profile, "floating-point vector profiles require scalar F or D")
  when vector_extensions_support_zvfh(vector_extensions) && !half_precision_supports_zfhmin(half_precision)
  | error(~who: #'check_rv5stage_vector_profile, "Zvfh requires scalar Zfhmin or Zfh")

fun rv5stage_execution_half_precision(half_precision :: HalfPrecisionProfile,
                                      vector_extensions :: List.of(VectorExtension)) :: HalfPrecisionProfile:
  cond
  | half_precision_supports_zfh(half_precision) || vector_extensions_support_zvfh(vector_extensions): HalfPrecisionProfile.Zfh
  | half_precision_supports_zfhmin(half_precision) || vector_extensions_support_zvfhmin(vector_extensions): HalfPrecisionProfile.Zfhmin
  | ~else: HalfPrecisionProfile.None

class RV5StageConfig(xlen :: XLen,
                     extensions :: RV5StageExtensions,
                     mmu_mode :: RV5StageMmuMode,
                     cache_geometry :: RV5StageCacheGeometry,
                     vector :: VectorProfile,
                     vector_extensions :: List.of(VectorExtension),
                     vector_length :: VectorLength,
                     vector_completion_slots :: Pow2Int):
  implements StableCircuitParam

  constructor (~xlen: xlen :: XLen,
               ~extensions: extensions :: RV5StageExtensions = RV5StageExtensions(),
               ~mmu_mode: mmu_mode :: RV5StageMmuMode = RV5StageMmuMode.Bare,
               ~cache_geometry: cache_geometry :: RV5StageCacheGeometry = RV5StageCacheGeometry(),
               ~vector: vector :: VectorProfile = DefaultVectorProfile,
               ~vector_extensions: vector_extensions :: List.of(VectorExtension) = DefaultVectorExtensions,
               ~vector_length: vector_length :: VectorLength = 128,
               ~vector_completion_slots: vector_completion_slots :: Pow2Int = 8):
    check_rv5stage_floating_point_profile(
      xlen,
      extensions.floating_point,
      extensions.half_precision,
      ~zfa: extensions.zfa
    )
    extensions.compressed_misa_c(xlen)
    when xlen == XLen.X32 && extensions.ssnpm
    | error(~who: #'RV5StageConfig, "Ssnpm requires RV64")
    when xlen == XLen.X32 && mmu_mode != RV5StageMmuMode.Bare
    | error(~who: #'RV5StageConfig, "RV32 profiles support only Bare translation")
    check_rv5stage_vector_profile(xlen, extensions.floating_point, extensions.half_precision, vector, vector_extensions)
    super(xlen, extensions, mmu_mode, cache_geometry, vector, vector_extensions, vector_length, vector_completion_slots)

  property isa_profile :: RiscvIsaProfile:
    def selected_vector = vector_profile_isa_extensions(vector, vector_length, vector_extensions)
    def names = extensions.names(xlen) ++ selected_vector ++ (if vector_profile_enabled(vector) | ["zvkt"] | [])
    def mutable misa = [MisaExtension.A, MisaExtension.B, MisaExtension.I, MisaExtension.M, MisaExtension.S, MisaExtension.U]
    when floating_point_supports_f(extensions.floating_point)
    | misa := misa ++ [MisaExtension.F]
    when floating_point_supports_d(extensions.floating_point)
    | misa := misa ++ [MisaExtension.D]
    when extensions.compressed_misa_c(xlen)
    | misa := misa ++ [MisaExtension.C]
    when vector_profile_is_v(vector)
    | misa := misa ++ [MisaExtension.V]
    RiscvIsaProfile(xlen, names, misa)

export:
  RV5StageCacheLineBytes
  RV5StageCacheConfig
  RV5StageMmuMode
  RV5StageExtensions
  RV5StageCacheGeometry
  RV5StageConfig
  rv5stage_floating_point_profile_supported
  check_rv5stage_floating_point_profile
  check_rv5stage_vector_profile
  rv5stage_execution_half_precision
