#lang rhombus
// Emits the shared CSR bank for the sscofpmf-rv32 behavioral fixture.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/backend/circt.rhm") open
  lib("rhodium/frontend/kernel.rhm") as embedded
  lib("riscv/isa/xlen.rhm") open
  lib("riscv/isa/hart.rhm").RiscvMmuType
  lib("riscv/isa/fp-profile.rhm") open
  lib("riscv/isa/c.rhm") open
  lib("riscv/isa/vector-profile.rhm") open
  "../../config.rhm".RiscvCsrConfig
  "../../file.rhdl".RiscvCsrFile
  "../csr-profile.rhm".csr_test_isa

def config = RiscvCsrConfig(csr_test_isa(XLen.X32), ~sscofpmf: #true)
def design = embedded.run_elaboration(fun (): RiscvCsrFile(config))
print(emit_circt(design))
