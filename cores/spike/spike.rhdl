#lang rhodium
/* Composes the Spike DPI hart with private-cache transaction adapters and three CHI ports. */
// SPDX-License-Identifier: Apache-2.0

import:
  "profile.rhm" open
  "protocol.rhdl" open
  "dpi/spike-dpi.rhdl" open
  "chi/instruction.rhdl" open
  "chi/data.rhdl" open
  "chi/uncached.rhdl" open
  "../chi-hart.rhdl" open
  lib("riscv/rtl/interrupt.rhdl").RiscvInterrupts
  lib("riscv/rtl/pma.rhdl").RiscvPhysicalMemoryMap
  lib("chi/protocol/channels.rhdl") open
  lib("chi/protocol/flits.rhdl").CHIDatFlit

/*
 * Classify the existing request and certify its containing contiguous region fragment for native
 * reuse. Noncontiguous AddressSets grant only the run selected by their trailing variable bits;
 * unmapped, overflowing, or fragment-crossing requests receive no reusable grant.
 */
fun spike_address_response(physical_map :: RiscvPhysicalMemoryMap, request :: SpikeAddressRequest()) :~ SpikeAddressResponse():
  def last_address = request.address +& ((bits(1, 64) << request.size) - bits(1, 64))
  def classified = physical_map.lookup(request.address, last_address)
  def mutable grant_valid = Bool(#false)
  def mutable grant_base = bits(0, 64)
  def mutable grant_limit = bits(0, 64)
  for (region in physical_map.regions):
    def mutable run_mask = 0
    while ((region.address_set.mask bits.and (run_mask + 1)) != 0):
      run_mask := run_mask * 2 + 1
    def base = request.address & !bits(run_mask, 64)
    def limit = base ||| bits(run_mask, 64)
    def matches = classified.mapped & region.address_set.matches(request.address) & (last_address <= limit.zext(65))
    grant_valid := grant_valid ||| matches
    grant_base := mux(matches, base, grant_base)
    grant_limit := mux(matches, limit, grant_limit)
  SpikeAddressResponse():
    grant_valid: grant_valid
    grant_base: grant_base
    grant_limit: grant_limit
    readable: classified.readable
    writable: classified.writable
    executable: classified.executable
    cacheable: classified.cacheable
    cache_block_zero: classified.cache_block_zero
    instruction_cacheable: classified.instruction_cacheable
    device: classified.device
    atomic: classified.atomic
    access_fault: !classified.mapped ||| mux(request.execute, !classified.executable, mux(request.write, !classified.writable, !classified.readable))

/*
 * Compose one DPI hart and three CHI paths; classify requested physical ranges in RTL and pass
 * placement, time, and interrupt inputs to Spike.
 */
sync_circuit SpikeCore(config :: SpikeConfig,
                       ~reset_address: reset_address :: Nat,
                       ~chi: chi_config :: RiscvHartCHIConfig):
  def p = chi_config.flit
  unless chi_config.cache_line_bytes == 64
  | error(~who: #'SpikeCore, "SpikeCore requires 64-byte CHI cache lines")

  input chi_identity: RiscvHartCHIIdentity(p)
  input interrupts: RiscvInterrupts()
  input hart_id: Bits(config.architecture.xlen.width)
  input time_counter: Bits(64)
  interface imem(CHIRNIChannels(p), ~role: node)
  interface dmem(CHIRNChannels(p), ~role: node)
  interface umem(CHIRNIChannels(p), ~role: node)

  inst spike(SpikeDPI(config))
  inst instruction(SpikeInstructionCHI(chi_config))
  inst data(SpikeDataCHI(chi_config))
  inst uncached(SpikeUncachedCHI(chi_config))

  spike.hart_id <== if config.architecture.xlen.width == 64 | hart_id | hart_id.zext(64)
  spike.reset_vector <== bits(reset_address, 64)
  spike.time <== time_counter
  spike.interrupts <== interrupts.machine_external.as_bits() ++ (
    interrupts.supervisor_external.as_bits()
  ) ++ interrupts.machine_timer.as_bits() ++ interrupts.supervisor_timer.as_bits() ++ (
    interrupts.machine_software.as_bits()
  ) ++ interrupts.supervisor_software.as_bits()

  spike.address.request.ready <== spike.address.response.ready
  spike.address.response.valid <== spike.address.request.valid
  spike.address.response.bits <== spike_address_response(chi_config.physical_map, spike.address.request.bits)

  spike.instruction <=> instruction.transaction
  spike.data <=> data.transaction
  spike.uncached <=> uncached.transaction
  instruction.node_id <== chi_identity.instruction_node_id
  data.node_id <== chi_identity.data_node_id
  uncached.node_id <== chi_identity.uncached_node_id
  instruction.requests <=> imem.req
  instruction.acknowledgements <=> imem.rsp.requester
  imem.rsp.response <=> instruction.responses
  imem.dat.response <=> instruction.response_data
  imem.dat.request.valid <== Bool(#false)
  imem.dat.request.bits <== literal(CHIDatFlit(p), 0)
  data.chi <=> dmem
  uncached.chi <=> umem

export:
  spike_address_response
  SpikeCore
