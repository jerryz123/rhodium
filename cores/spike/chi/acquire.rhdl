#lang rhodium
// Converts one Spike cache-line acquisition into a retryable coherent CHI transaction.
// SPDX-License-Identifier: Apache-2.0

import:
  "../protocol.rhdl" open
  "foundation.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open
  lib("chi/protocol/flits.rhdl") open
  lib("chi/protocol/protocol.rhdl") open
  lib("chi/protocol/coherence.rhdl") open
  lib("chi/transactions/retryable-transaction.rhdl").CHIRetryableTransactionControl

sync_circuit SpikeAcquire(config :: RiscvHartCHIConfig):
  def p = config.flit
  def packet_count = 64 / p.data_bytes
  def packet_index_width = index_width(packet_count)

  input node_id: Bits(p.node_id_width)
  interface command(Decoupled(SpikeAcquireRequest()), ~role: consumer)
  interface completion(Irrevocable(SpikeAcquireResponse()), ~role: producer)
  interface requests(Decoupled(CHIReqFlit(p)), ~role: producer)
  interface acknowledgements(Decoupled(CHIRspFlit(p)), ~role: producer)
  interface responses(Decoupled(CHIRspFlit(p)), ~role: consumer)
  interface response_data(Decoupled(CHIDatFlit(p)), ~role: consumer)

  inst control(CHIRetryableTransactionControl(p, SpikeAcquireResponses))
  reg received_packets(~init: bits(0, packet_count).as_vec(Bool))
  reg acknowledgement_sent(~init: Bool(#false))
  reg address(~init: bits(0, 64))
  reg unique(~init: Bool(#false))
  reg line(~init: bits(0, 512))
  reg home_id(~init: bits(0, p.node_id_width))
  reg dbid(~init: bits(0, 12))
  reg response_state(~init: CHIResponseState.Invalid)
  reg pass_dirty(~init: Bool(#false))
  reg access_fault(~init: Bool(#false))

  command.ready <== !control.active
  def command_fire = command.fire()
  def command_home = config.home_map.lookup(spike_chi_address(command.bits.address, p))
  when command_fire:
    assert(command.bits.address.is_aligned(64), "spike_acquire_address_aligned")
    assert(spike_chi_address_fits(command.bits.address, p), "spike_acquire_address_fits")
    assert(command_home.valid, "spike_acquire_address_has_home")

  control.attempt
    |> map_flow(attempt => spike_chi_request(
      p, node_id, home_id, address, CHITransferSize.Bytes64,
      mux(unique, CHIReqOpcode.ReadUnique, CHIReqOpcode.ReadClean),
      bits(0, 12), Bool(#true), Bool(#true), attempt.allow_retry, attempt.pcrd_type
    ))
    |> requests

  responses |> control.response
  def response_event = control.event
  when (response_event.valid):
    assert(response_event.bits.flit.src_id === home_id, "spike_acquire_response_home")
    assert(response_event.bits.flit.tgt_id === node_id, "spike_acquire_response_target")

  def incoming_data = response_data.bits
  def coherent_response = incoming_data.resp.into(CHICoherentResponse())
  def all_data_received = received_packets.and_reduce()
  def first_data_packet = !received_packets.or_reduce()
  def packet_index = chi_transfer_beat(incoming_data.data_id, p)[0..packet_index_width]
  def next_received_packets = received_packets.updated(packet_index, Bool(#true))
  def next_line = line.as_vec(Bits(p.data_width)).updated(packet_index, incoming_data.data)
  response_data.ready <== control.active & control.attempt_outstanding & !all_data_received
  def data_fire = response_data.fire()
  when data_fire:
    assert(incoming_data.opcode === CHIDatOpcode.CompData, "spike_acquire_comp_data")
    assert(incoming_data.txn_id === bits(0, 12), "spike_acquire_data_txn")
    assert(incoming_data.tgt_id === node_id, "spike_acquire_data_target")
    assert(incoming_data.home_nid_or_pbha_or_mismatched_mecid === home_id,
           "spike_acquire_data_home")
    assert(chi_data_id_valid(incoming_data.data_id, p), "spike_acquire_data_id")
    assert(!received_packets[packet_index], "spike_acquire_data_unique")

  acknowledgements.valid <== control.active & all_data_received & !acknowledgement_sent
  acknowledgements.bits <== spike_chi_response(
    p, node_id, home_id, dbid, CHIRspOpcode.CompAck
  )
  def acknowledgement_fire = acknowledgements.fire()

  completion.valid <== control.active & acknowledgement_sent
  completion.bits <== SpikeAcquireResponse():
    line: line
    state: response_state
    pass_dirty: pass_dirty
    access_fault: access_fault
  def completion_fire = completion.fire()
  control.start <== command_fire
  control.finish <== completion_fire
  control.external_progress <== data_fire

  when command_fire:
    received_packets <== bits(0, packet_count).as_vec(Bool)
    acknowledgement_sent <== Bool(#false)
    address <== command.bits.address
    unique <== command.bits.unique
    line <== bits(0, 512)
    home_id <== command_home.node_id
    dbid <== bits(0, 12)
    response_state <== CHIResponseState.Invalid
    pass_dirty <== Bool(#false)
    access_fault <== Bool(#false)
  elsewhen data_fire:
    received_packets <== next_received_packets
    line <== next_line.as_bits()
    dbid <== mux(first_data_packet, incoming_data.dbid_or_mecid[0..12], dbid)
    response_state <== mux(first_data_packet, coherent_response.state, response_state)
    pass_dirty <== mux(first_data_packet, coherent_response.pass_dirty, pass_dirty)
    access_fault <== access_fault ||| (incoming_data.resp_err =/= CHIRespErr.OK)
  elsewhen acknowledgement_fire:
    acknowledgement_sent <== Bool(#true)

export:
  SpikeAcquire
