#lang rhombus
// Projects the pinned Spike hart configuration into an ACT/UDB architecture description.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("support/annotations.rhm").NonemptyString
  lib("riscv/udb.rhm") open
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/hart.rhm").RiscvMmuType
  "profile.rhm".SpikeConfig

fun extension(name :: NonemptyString, version :: NonemptyString) :: UdbExtension:
  UdbExtension(name, version)

fun boolean_parameter(name :: NonemptyString, value :: Boolean) :: UdbParameter:
  UdbParameter(name, UdbBooleanValue(value))

fun natural_parameter(name :: NonemptyString, value :: Nat) :: UdbParameter:
  UdbParameter(name, UdbNaturalValue(value))

fun string_parameter(name :: NonemptyString, value :: String) :: UdbParameter:
  UdbParameter(name, UdbStringValue(value))

fun natural_list_parameter(name :: NonemptyString, elements :: NonemptyList.of(Nat)) :: UdbParameter:
  UdbParameter(name, UdbNaturalListValue(elements))

fun boolean_list_parameter(name :: NonemptyString, elements :: NonemptyList.of(Boolean)) :: UdbParameter:
  UdbParameter(name, UdbBooleanListValue(elements))

def BaseCounters = [#true, #true, #true] ++ for List (_index in 0..29): #false
def InhibitableCounters = [#true, #false, #true] ++ for List (_index in 0..29): #false
def NoHpmCounters = for List (_index in 0..32): #false

// ISA spellings and versions are explicit: an unmodeled claim must fail closed.
def SpikeUdbExtensions = [
  ["i", extension("I", "2.1")],
  ["m", extension("M", "2.0")],
  ["a", extension("A", "2.1.0")],
  ["f", extension("F", "2.2.0")],
  ["d", extension("D", "2.2.0")],
  ["c", extension("C", "2.0")],
  ["b", extension("B", "1.0.0")],
  ["za64rs", extension("Za64rs", "1.0.0")],
  ["zba", extension("Zba", "1.0.0")],
  ["zbb", extension("Zbb", "1.0.0")],
  ["zbs", extension("Zbs", "1.0.0")],
  ["zcb", extension("Zcb", "1.0.0")],
  ["zcmop", extension("Zcmop", "1.0.0")],
  ["zfa", extension("Zfa", "1.0.0")],
  ["zfh", extension("Zfh", "1.0.0")],
  ["zic64b", extension("Zic64b", "1.0.0")],
  ["zicbop", extension("Zicbop", "1.0.0")],
  ["zicboz", extension("Zicboz", "1.0.0")],
  ["zicbom", extension("Zicbom", "1.0.0")],
  ["ziccamoa", extension("Ziccamoa", "1.0.0")],
  ["ziccif", extension("Ziccif", "1.0.0")],
  ["ziccrse", extension("Ziccrse", "1.0.0")],
  ["ssnpm", extension("Ssnpm", "1.0.0")],
  ["supm", extension("Supm", "1.0.0")],
  ["zawrs", extension("Zawrs", "1.0.0")],
  ["zihintntl", extension("Zihintntl", "1.0.0")],
  ["zicond", extension("Zicond", "1.0.0")],
  ["zimop", extension("Zimop", "1.0.0")],
  ["zkt", extension("Zkt", "1.0.0")],
  ["v", extension("V", "1.0.0")],
  ["zve32x", extension("Zve32x", "1.0.0")],
  ["zve32f", extension("Zve32f", "1.0.0")],
  ["zve64x", extension("Zve64x", "1.0.0")],
  ["zve64f", extension("Zve64f", "1.0.0")],
  ["zve64d", extension("Zve64d", "1.0.0")],
  ["zvfhmin", extension("Zvfhmin", "1.0.0")],
  ["zvfh", extension("Zvfh", "1.0.0")],
  ["zvkb", extension("Zvkb", "1.0.0")],
  ["zvbb", extension("Zvbb", "1.0.0")],
  ["zvkt", extension("Zvkt", "1.0.0")],
  ["zvl32b", extension("Zvl32b", "1.0.0")],
  ["zvl64b", extension("Zvl64b", "1.0.0")],
  ["zvl128b", extension("Zvl128b", "1.0.0")],
  ["zihintpause", extension("Zihintpause", "2.0.0")],
  ["zicntr", extension("Zicntr", "2.0")],
  ["zicsr", extension("Zicsr", "2.0")],
  ["zifencei", extension("Zifencei", "2.0.0")],
  ["zihpm", extension("Zihpm", "2.0")]
]

fun spike_udb_extensions(profile :: SpikeConfig) :: NonemptyList.of(UdbExtension):
  def advertised = profile.hart_description.isa_profile.isa_extensions
  def mutable result = []
  for (name in advertised):
    def entries = SpikeUdbExtensions.filter(~keep: fun (entry): entry[0] == name)
    unless entries.length() == 1
    | error(~who: #'spike_udb_extensions, "no Spike UDB projection for extension: " ++ name)
    result := result ++ [entries[0][1]]
  // Expand architectural implication without borrowing another core's policies.
  result := result ++ [
    extension("Zmmul", "1.0.0"), extension("Zaamo", "1.0.0"), extension("Zalrsc", "1.0.0"),
    extension("Zca", "1.0.0"),
    extension("U", "1.0.0"), extension("S", "1.13.0"), extension("Sm", "1.13.0"),
    extension("Svbare", "1.0.0")
  ]
  when advertised.contains("c") && advertised.contains("d")
  | result := result ++ [extension("Zcd", "1.0.0")]
  when advertised.contains("c") && advertised.contains("f") && profile.hart_description.xlen == XLen.X32
  | result := result ++ [extension("Zcf", "1.0.0")]
  when advertised.contains("zfh")
  | result := result ++ [extension("Zfhmin", "1.0.0")]
  when advertised.contains("zvfh") && !advertised.contains("zvfhmin")
  | result := result ++ [extension("Zvfhmin", "1.0.0")]
  when advertised.contains("za64rs")
  | result := result ++ [extension("Za128rs", "1.0.0")]
  when profile.hart_description.mmu_type == RiscvMmuType.Sv39
  | result := result ++ [extension("Sv39", "1.0.0"), extension("Svade", "1.0.0")]
  result

fun spike_udb_configuration(profile :: SpikeConfig,
                            name :: NonemptyString,
                            description :: NonemptyString) :: UdbConfiguration:
  def advertised = profile.hart_description.isa_profile.isa_extensions
  fun has(name :: String) :: Boolean: advertised.contains(name)
  def width = profile.hart_description.xlen.width
  unless for all (name in ["i", "m", "a", "c", "zicsr", "zifencei", "zicntr", "zihpm"]): has(name)
  | error(~who: #'spike_udb_configuration, "the Spike ACT projection requires IMAC with base counters and Zihpm")
  unless profile.pmp_regions == 0 || profile.pmp_regions == 16 || profile.pmp_regions == 64
  | error(~who: #'spike_udb_configuration, "Sail models 0, 16, or 64 PMP entries")
  def mutable parameters = [
     // Bare RV32 addresses need 32 bits; enabled PMP exposes Spike's wider CSR masks.
     natural_parameter("MXLEN", width),
     natural_parameter("PHYS_ADDR_WIDTH", if width == 32 | (if profile.pmp_regions == 0 | 32 | 34) | 56),
     natural_parameter("PMA_GRANULARITY", 3),
     boolean_parameter("PRECISE_SYNCHRONOUS_EXCEPTIONS", #true),
     boolean_parameter("TRAP_ON_ECALL_FROM_M", #true), boolean_parameter("TRAP_ON_EBREAK", #true),
     boolean_parameter("TRAP_ON_ILLEGAL_WLRL", #false),
     boolean_parameter("TRAP_ON_UNIMPLEMENTED_INSTRUCTION", #true),
     boolean_parameter("TRAP_ON_RESERVED_INSTRUCTION", #true),
     boolean_parameter("TRAP_ON_UNIMPLEMENTED_CSR", #true),
     boolean_parameter("REPORT_VA_IN_MTVAL_ON_BREAKPOINT", #true),
     boolean_parameter("REPORT_VA_IN_MTVAL_ON_LOAD_MISALIGNED", #true),
     boolean_parameter("REPORT_VA_IN_MTVAL_ON_STORE_AMO_MISALIGNED", #true),
     boolean_parameter("REPORT_VA_IN_MTVAL_ON_INSTRUCTION_MISALIGNED", #true),
     boolean_parameter("REPORT_VA_IN_MTVAL_ON_LOAD_ACCESS_FAULT", #true),
     boolean_parameter("REPORT_VA_IN_MTVAL_ON_STORE_AMO_ACCESS_FAULT", #true),
     boolean_parameter("REPORT_VA_IN_MTVAL_ON_INSTRUCTION_ACCESS_FAULT", #true),
     boolean_parameter("REPORT_ENCODING_IN_MTVAL_ON_ILLEGAL_INSTRUCTION", #true),
     natural_parameter("MTVAL_WIDTH", width),
     boolean_parameter("MARCHID_IMPLEMENTED", #true), natural_parameter("ARCH_ID_VALUE", 5),
     boolean_parameter("MIMPID_IMPLEMENTED", #true), natural_parameter("IMP_ID_VALUE", 0),
     natural_parameter("CONFIG_PTR_ADDRESS", 0), natural_parameter("VENDOR_ID_BANK", 0),
     natural_parameter("VENDOR_ID_OFFSET", 0),
     boolean_parameter("MISALIGNED_LDST", #false),
     string_parameter("MISALIGNED_LDST_EXCEPTION_PRIORITY", "high"),
     string_parameter("M_MODE_ENDIANNESS", "little"),
     boolean_parameter("MISA_CSR_IMPLEMENTED", #true), string_parameter("MTVEC_ACCESS", "rw"),
     natural_list_parameter("MTVEC_MODES", [0, 1]),
     natural_parameter("MTVEC_BASE_ALIGNMENT_DIRECT", 4),
     natural_parameter("MTVEC_BASE_ALIGNMENT_VECTORED", 4),
     string_parameter("MTVEC_ILLEGAL_WRITE_BEHAVIOR", "custom"),
     boolean_parameter("MCOUNTINHIBIT_IMPLEMENTED", #true),
     boolean_list_parameter("COUNTINHIBIT_EN", InhibitableCounters),
     boolean_list_parameter("HPM_COUNTER_EN", NoHpmCounters),
     boolean_list_parameter("MCOUNTENABLE_EN", BaseCounters),
     natural_parameter("NUM_PMP_ENTRIES", profile.pmp_regions),
     boolean_parameter("MUTABLE_MISA_M", #true), boolean_parameter("MUTABLE_MISA_A", #true),
     boolean_parameter("MISALIGNED_AMO", #false),
     string_parameter("LRSC_RESERVATION_STRATEGY", "reserve exactly enough to cover the access"),
     boolean_parameter("LRSC_FAIL_ON_VA_SYNONYM", #false),
     string_parameter("LRSC_MISALIGNED_BEHAVIOR", "always raise misaligned exception"),
     boolean_parameter("LRSC_FAIL_ON_NON_EXACT_LRSC", #true),
     boolean_parameter("TIME_CSR_IMPLEMENTED", #true),
     boolean_parameter("MUTABLE_MISA_U", #false),
     string_parameter("U_MODE_ENDIANNESS", "little"), natural_list_parameter("UXLEN", [width]),
     boolean_parameter("TRAP_ON_ECALL_FROM_U", #true),
     boolean_parameter("MUTABLE_MISA_S", #false), natural_parameter("ASID_WIDTH", if width == 32 | 9 | 16),
     string_parameter("S_MODE_ENDIANNESS", "little"), natural_list_parameter("SXLEN", [width]),
     boolean_parameter("REPORT_VA_IN_MTVAL_ON_LOAD_PAGE_FAULT", #true),
     boolean_parameter("REPORT_VA_IN_MTVAL_ON_STORE_AMO_PAGE_FAULT", #true),
     boolean_parameter("REPORT_VA_IN_MTVAL_ON_INSTRUCTION_PAGE_FAULT", #true),
     boolean_parameter("REPORT_VA_IN_STVAL_ON_BREAKPOINT", #true),
     boolean_parameter("REPORT_VA_IN_STVAL_ON_LOAD_MISALIGNED", #true),
     boolean_parameter("REPORT_VA_IN_STVAL_ON_STORE_AMO_MISALIGNED", #true),
     boolean_parameter("REPORT_VA_IN_STVAL_ON_INSTRUCTION_MISALIGNED", #true),
     boolean_parameter("REPORT_VA_IN_STVAL_ON_LOAD_ACCESS_FAULT", #true),
     boolean_parameter("REPORT_VA_IN_STVAL_ON_STORE_AMO_ACCESS_FAULT", #true),
     boolean_parameter("REPORT_VA_IN_STVAL_ON_INSTRUCTION_ACCESS_FAULT", #true),
     boolean_parameter("REPORT_VA_IN_STVAL_ON_LOAD_PAGE_FAULT", #true),
     boolean_parameter("REPORT_VA_IN_STVAL_ON_STORE_AMO_PAGE_FAULT", #true),
     boolean_parameter("REPORT_VA_IN_STVAL_ON_INSTRUCTION_PAGE_FAULT", #true),
     boolean_parameter("REPORT_ENCODING_IN_STVAL_ON_ILLEGAL_INSTRUCTION", #true),
     natural_parameter("STVAL_WIDTH", width),
     boolean_list_parameter("SCOUNTENABLE_EN", BaseCounters),
     natural_list_parameter("STVEC_MODES", [0, 1]),
     natural_parameter("STVEC_BASE_ALIGNMENT_VECTORED", 4),
     boolean_parameter("SATP_MODE_BARE", #true),
     boolean_parameter("TRAP_ON_ECALL_FROM_S", #true),
     natural_list_parameter("MSTATUS_VS_LEGAL_VALUES", if profile.vector_length > 0 | [0, 1, 2, 3] | [0]),
     natural_list_parameter("MSTATUS_FS_LEGAL_VALUES", [0, 1, 2, 3]),
     boolean_parameter("MUTABLE_MISA_C", #true)]
  when profile.pmp_regions > 0
  | parameters := parameters ++ [
      natural_parameter("NUM_USABLE_PMP_ENTRIES", profile.pmp_regions),
      natural_parameter("PMP_GRANULARITY", 2),
      boolean_parameter("PMP_NA4_SUPPORTED", #true),
      boolean_parameter("PMP_NAPOT_SUPPORTED", #true),
      boolean_parameter("PMP_TOR_SUPPORTED", #true)
    ]
  when has("f")
  | parameters := parameters ++ [boolean_parameter("MUTABLE_MISA_F", #true), string_parameter("HW_MSTATUS_FS_DIRTY_UPDATE", "precise")]
  when has("d")
  | parameters := parameters ++ [boolean_parameter("MUTABLE_MISA_D", #true)]
  when has("v")
  | parameters := parameters ++ [boolean_parameter("MUTABLE_MISA_V", #true)]
  when profile.hart_description.mmu_type == RiscvMmuType.Bare
  | parameters := parameters ++ [boolean_parameter("TRAP_ON_SFENCE_VMA_WHEN_SATP_MODE_IS_READ_ONLY", #true)]
  when has("b")
  | parameters := parameters ++ [boolean_parameter("MUTABLE_MISA_B", #true)]
  when has("zic64b") || has("zicbom") || has("zicboz")
  | parameters := parameters ++ [natural_parameter("CACHE_BLOCK_SIZE", profile.hart_description.cbo_block_bytes)]
  when has("zicbom")
  | parameters := parameters ++ [boolean_parameter("FORCE_UPGRADE_CBO_INVAL_TO_FLUSH", #false)]
  when has("ssnpm")
  | parameters := parameters ++ [natural_parameter("PMLEN", 16)]
  when has("zawrs")
  | parameters := parameters ++ [boolean_parameter("ZAWRS_NTO_IS_NOP", #false)]
  when profile.vector_length > 0
  | parameters := parameters ++ [
      natural_parameter("VLEN", profile.vector_length),
      natural_parameter("ELEN", profile.vector_element_width),
      natural_parameter("SEW_MIN", 8),
      boolean_parameter("FOLLOW_VTYPE_RESET_RECOMMENDATION", #true),
      boolean_parameter("IMPRECISE_VECTOR_TRAP_SETTABLE", #false),
      string_parameter("LEGAL_VSTART", "1_stride"),
      // vector_unit.cc sets vill on a reserved VLMAX change; an old illegal
      // vtype has VLMAX zero, so a legal replacement also takes that path.
      string_parameter("RESERVED_VSET_X0X0_VILL_SET", "always"),
      string_parameter("RESERVED_VSET_X0X0_VLMAX_CHANGE", "always"),
      string_parameter("RVV_VL_WHEN_AVL_LT_DOUBLE_VLMAX", "VLMAX"),
      string_parameter("SUPPORT_FRACTIONAL_LMUL_BEYOND_REQUIRED", "no_unrequired_supported"),
      boolean_parameter("VILL_SET_ON_RESERVED_VTYPE", #true),
      string_parameter("HW_MSTATUS_VS_DIRTY_UPDATE", "precise"),
      boolean_parameter("VECTOR_FF_NO_EXCEPTION_TRIM", #false),
      string_parameter("VECTOR_FF_SEG_EXCEPTION_PARTIAL_LOAD", "custom"),
      string_parameter("VECTOR_FF_UPDATE_PAST_TRIM", "update_none"),
      boolean_parameter("VECTOR_LOAD_PAST_TRAP", #false),
      string_parameter("VECTOR_LOAD_SEG_FF_OVERWRITE_ELEMENTS_AFTER_FAULT", "no_overwrite"),
      string_parameter("VECTOR_LS_INDEX_MAX_EEW", to_string(math.min(width, profile.vector_element_width))),
      boolean_parameter("VECTOR_LS_MISALIGNED_LEGAL", #false),
      boolean_parameter("VECTOR_LS_SEG_PARTIAL_ACCESS", #true),
      boolean_parameter("VECTOR_LS_WHOLEREG_MISALIGNED_LEGAL", #false),
      string_parameter("VFREDUSUM_FINAL_NODE_ELEMENT_BEHAVIOR", "copy"),
      string_parameter("VFREDUSUM_INACTIVE_NODE_ELEMENT_BEHAVIOR", "copy"),
      // v_ext_macros.h canonicalizes an inactive NaN seed and flags sNaN.
      string_parameter("VFREDUSUM_NAN", "custom"),
      string_parameter("VFREDUSUM_NODE_ROUNDING_BEHAVIOR", "SEW_precision"),
      boolean_parameter("VSSTATUS_VS_EXISTS", #false)
    ]
  UdbConfiguration(name, description, spike_udb_extensions(profile), parameters)

export:
  spike_udb_configuration
