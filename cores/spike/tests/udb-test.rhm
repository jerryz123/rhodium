#lang rhombus
// Checks scalar and SoC Spike UDB projections with implementation-owned vector and PMP choices.
// SPDX-License-Identifier: Apache-2.0

import:
  "../profile.rhm".SpikeConfig
  "../udb.rhm".spike_udb_configuration
  "../../../riscv/isa/hart.rhm" open
  "../../../riscv/isa/profile.rhm" open
  "../../../riscv/isa/xlen.rhm".XLen
  "../../../socs/products/selection.rhm".IsaPreset
  "../../../socs/products/spike-core-profile.rhm".spike_product_profile

// This unit fixture exercises the existing projection, not a production ISA preset.
def isa = RiscvIsaProfile(
  XLen.X64,
  ["i", "m", "a", "f", "d", "c", "zicsr", "zifencei", "zicntr", "zihpm"],
  [MisaExtension.I, MisaExtension.M, MisaExtension.A, MisaExtension.F, MisaExtension.D, MisaExtension.C, MisaExtension.S, MisaExtension.U]
)
def cache = RiscvCacheDescription(64, 64, 16384)
def profile = SpikeConfig(RiscvHartDescription(isa, RiscvMmuType.Sv39, cache, cache))
def configuration = spike_udb_configuration(profile, "spike-scalar-fixture", "Scalar projection unit fixture")
def yaml = configuration.to_yaml()

check:
  configuration.name ~is "spike-scalar-fixture"
  yaml.contains("  NUM_PMP_ENTRIES: 16") ~is #true
  yaml.contains("  NUM_USABLE_PMP_ENTRIES: 16") ~is #true
  yaml.contains("  PMP_GRANULARITY: 2") ~is #true
  yaml.contains("  PHYS_ADDR_WIDTH: 56") ~is #true
  yaml.contains("  ARCH_ID_VALUE: 5") ~is #true
  yaml.contains("  CACHE_BLOCK_SIZE:") ~is #false
  yaml.contains("{ name: \"Sm\", version: \"= 1.13.0\" }") ~is #true
  yaml.contains("{ name: \"Zihpm\", version: \"= 2.0\" }") ~is #true

def rva23_profile = spike_product_profile(IsaPreset.RVA23)
def rva23 = spike_udb_configuration(rva23_profile, "spike-rva23", "Exact Spike RVA23 preset")
def rva23_yaml = rva23.to_yaml()
for (name in ["B", "Zcb", "Zcmop", "Zfa", "Zfh", "Zfhmin", "V", "Zve32x", "Zve64d", "Zvbb", "Zvkb", "Zvfh", "Zvfhmin", "Zvkt", "Zvl128b", "Ssnpm", "Supm", "Zicbom", "Zicboz", "Za64rs", "Svpbmt", "Svnapot"]):
  check: (for any (entry in rva23.extensions): entry.name == name) ~is #true
check:
  rva23_yaml.contains("{ name: \"Zicclsm\", version: \"= 1.0.0\" }") ~is #true
  rva23_yaml.contains("  MISALIGNED_LDST: true") ~is #true
  rva23_yaml.contains("  MISALIGNED_MAX_ATOMICITY_GRANULE_SIZE: 0") ~is #true
  rva23_yaml.contains("  MISALIGNED_SPLIT_STRATEGY: \"custom\"") ~is #true
  rva23_yaml.contains("  LRSC_MISALIGNED_BEHAVIOR: \"always raise access fault\"") ~is #true
  rva23_yaml.contains("  AMO_MISALIGNED_BEHAVIOR: \"always raise access fault\"") ~is #true
  rva23_yaml.contains("  VECTOR_LS_MISALIGNED_LEGAL: true") ~is #true
  yaml.contains("  MISALIGNED_LDST: false") ~is #true
  yaml.contains("  LRSC_MISALIGNED_BEHAVIOR: \"always raise misaligned exception\"") ~is #true
  yaml.contains("  AMO_MISALIGNED_BEHAVIOR: \"always raise misaligned exception\"") ~is #true
  yaml.contains("  MISALIGNED_MAX_ATOMICITY_GRANULE_SIZE:") ~is #false
  yaml.contains("  MISALIGNED_SPLIT_STRATEGY:") ~is #false
  rva23_yaml.contains("  VLEN: 128") ~is #true
  rva23_yaml.contains("  ELEN: 64") ~is #true
  rva23_yaml.contains("  CACHE_BLOCK_SIZE: 64") ~is #true
  rva23_yaml.contains("  PHYS_ADDR_WIDTH: 56") ~is #true
  rva23_yaml.contains("  SUPPORTED_PMLEN_SSNPM: [0, 7, 16]") ~is #true
  rva23_yaml.contains("  ZAWRS_NTO_IS_NOP: false") ~is #true
  rva23_yaml.contains("  RESERVED_VSET_X0X0_VLMAX_CHANGE: \"always\"") ~is #true
  rva23_yaml.contains("  VFREDUSUM_NAN: \"custom\"") ~is #true

def rv32 = spike_udb_configuration(spike_product_profile(IsaPreset.RV32Int), "spike-rv32int", "Exact Spike RV32Int preset")
def rv32_yaml = rv32.to_yaml()
for (name in ["I", "M", "A", "C", "Zca", "Zve32x", "Zvl32b", "Zvl64b", "Zvbb", "Zvkt", "Zihpm", "Svbare"]):
  check: (for any (entry in rv32.extensions): entry.name == name) ~is #true
check: rv32_yaml.contains("  MISALIGNED_LDST: true") ~is #true
check: rv32_yaml.contains("  MISALIGNED_MAX_ATOMICITY_GRANULE_SIZE: 0") ~is #true
check: rv32_yaml.contains("  MISALIGNED_SPLIT_STRATEGY: \"custom\"") ~is #true
check: rv32_yaml.contains("  LRSC_MISALIGNED_BEHAVIOR: \"always raise access fault\"") ~is #true
for (name in ["F", "D", "Zcf", "Zcd", "V", "Zve64x", "Zvl128b", "Sv39"]):
  check: (for any (entry in rv32.extensions): entry.name == name) ~is #false
for (parameter in ["MXLEN: 32", "PHYS_ADDR_WIDTH: 32", "MTVAL_WIDTH: 32", "STVAL_WIDTH: 32", "ASID_WIDTH: 9", "VLEN: 64", "ELEN: 32", "VECTOR_LS_INDEX_MAX_EEW: \"32\""]):
  check: rv32_yaml.contains("  " ++ parameter) ~is #true

for (preset in [IsaPreset.RVA23, IsaPreset.RV32Int, IsaPreset.RV32Max]):
  def product = spike_product_profile(preset)
  def product_yaml = spike_udb_configuration(product, "no-pmp", "SoC without PMP").to_yaml()
  check:
    product.pmp_regions ~is 0
    product_yaml.contains("  AMO_MISALIGNED_BEHAVIOR: \"always raise access fault\"") ~is #true
    product_yaml.contains("  NUM_PMP_ENTRIES: 0") ~is #true
    product_yaml.contains("{ name: \"Sscofpmf\", version: \"= 1.0.0\" }") ~is #true
    product_yaml.contains("  HPM_EVENTS: [0, 1, 2]") ~is #true
    product_yaml.contains("  HPM_COUNTER_EN: [false, false, false, true, false") ~is #true
    product_yaml.contains("  MCOUNTENABLE_EN: [true, true, true, true, false") ~is #true
    product_yaml.contains("  SCOUNTENABLE_EN: [true, true, true, true, false") ~is #true
    product_yaml.contains("  COUNTINHIBIT_EN: [true, false, true, true, false") ~is #true
  // UDB defines the remaining PMP parameters only when PMP entries exist.
  for (parameter in ["NUM_USABLE_PMP_ENTRIES", "PMP_GRANULARITY", "PMP_NA4_SUPPORTED", "PMP_NAPOT_SUPPORTED", "PMP_TOR_SUPPORTED"]):
    check: product_yaml.contains("  " ++ parameter ++ ":") ~is #false

// Standalone Spike configurations may still expose native RV32 PMP address bits.
def rv32_pmp = SpikeConfig(spike_product_profile(IsaPreset.RV32Max).hart_description, ~pmp_regions: 16)
check:
  spike_udb_configuration(rv32_pmp, "rv32-pmp", "Standalone PMP projection").to_yaml().contains("  PHYS_ADDR_WIDTH: 34") ~is #true
