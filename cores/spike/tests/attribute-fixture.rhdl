#lang rhodium
// SPDX-License-Identifier: Apache-2.0
import:
  "../spike.rhdl".spike_address_response
  "../protocol.rhdl" open
  lib("riscv/rtl/pma.rhdl") open
  lib("rhodium/std/interconnect.rhdl").AddressSet

def normal = RiscvPhysicalMemoryAttributes(#true, #true, #true, #true, #true, #false, #true, ~cache_block_zero: #true)
def rom = RiscvPhysicalMemoryAttributes(#true, #false, #false, #false, #false, #false, #true)
def device = RiscvPhysicalMemoryAttributes(#true, #true, #false, #false, #false, #true, #false)
def regions = [RiscvPhysicalMemoryRegion(AddressSet(0x1000, 0xff), normal),
               RiscvPhysicalMemoryRegion(AddressSet(0x2000, 0xff), rom),
               RiscvPhysicalMemoryRegion(AddressSet(0x3000, 7), device),
               RiscvPhysicalMemoryRegion(AddressSet(0x4000, 0xb), normal)]
def wide_map = RiscvPhysicalMemoryMap(64, regions ++ [RiscvPhysicalMemoryRegion(AddressSet(0xfffffffffffffff8, 7), normal)])
def narrow_map = RiscvPhysicalMemoryMap(16, regions)

circuit SpikeAttributeFixture():
  input request: SpikeAddressRequest()
  output response: SpikeAddressResponse()
  output narrow: SpikeAddressResponse()
  response <== spike_address_response(wide_map, request)
  narrow <== spike_address_response(narrow_map, request)

export:
  SpikeAttributeFixture
