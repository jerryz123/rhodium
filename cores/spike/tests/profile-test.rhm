#lang rhombus
// Checks that Spike-owned configuration projects the shared architectural hart description.
// SPDX-License-Identifier: Apache-2.0

import:
  "../profile.rhm".SpikeConfig
  "../../../riscv/isa/hart.rhm" open
  "../../../riscv/isa/profile.rhm" open
  "../../../riscv/isa/xlen.rhm".XLen

def isa = RiscvIsaProfile(
  XLen.X64,
  ["i", "m", "a", "zic64b"],
  [MisaExtension.I, MisaExtension.M, MisaExtension.A]
)
def cache = RiscvCacheDescription(64, 64, 4096)
def architecture = RiscvHartDescription(
  isa,
  RiscvMmuType.Sv39,
  cache,
  cache,
  ~cbo_block_bytes: 64
)
def default_config = SpikeConfig(architecture)
def config = SpikeConfig(architecture, ~max_retired_instructions_per_cycle: 64)

check:
  config.hart_description === architecture ~is #true
  config.isa_string ~is "rv64ima_zic64b"
  config.privilege_string ~is "m"
  default_config.max_retired_instructions_per_cycle ~is 1
  config.max_retired_instructions_per_cycle ~is 64
  config.pmp_regions ~is 16
  config.xlen_is_64 ~is #true
  config.max_vaddr_bits ~is 39
  SpikeConfig(RiscvHartDescription(isa, RiscvMmuType.Bare, cache, cache,
                                   ~cbo_block_bytes: 64)).max_vaddr_bits ~is 0
  (config.isa_bytes bits.and 0xffffffff) ~is 0x34367672
