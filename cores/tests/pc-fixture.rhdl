#lang rhodium
// SPDX-License-Identifier: Apache-2.0
import:
  "../pc.rhdl" open
  lib("riscv/isa/xlen.rhm").XLen

sync_circuit CompactPcCase(xlen :: XLen):
  input address: Bits(xlen.width)
  input capture: Bool
  output fits: Bool
  output(exact_address, predicted_address): Bits(xlen.width)
  fits <== CompactPc.fits(xlen, address)
  reg exact(CompactPc(xlen), ~init: literal(CompactPc(xlen), 0))
  reg predicted(CompactPc(xlen), ~init: literal(CompactPc(xlen), 0))
  when capture:
    predicted <== CompactPc.prediction(xlen, address)
    when fits:
      exact <== CompactPc.capture(xlen, address)

  exact_address <== exact.expanded()
  predicted_address <== predicted.expanded()

sync_circuit CompactPcFixture():
  input address: Bits(64)
  input capture: Bool
  output fits64: Vec(1, Bool)
  output fits32: Vec(1, Bool)
  output predicted64: Vec(1, Bits(64))
  output predicted32: Vec(1, Bits(32))
  output exact64: Vec(1, Bits(64))
  output exact32: Vec(1, Bits(32))
  output fetch_fits: Bool
  output fetch_address: Bits(64)
  def fetch_pc = CompactPc.capture(XLen.X64, address)
  fetch_fits <== CompactPc.fetch_fits(XLen.X64, address)
  fetch_address <== fetch_pc.fetch_address(!CompactPc.fits(XLen.X64, address))

  for (xlen in [XLen.X32, XLen.X64]):
    for (index in 0..1):
      inst entry(CompactPcCase(xlen))
      entry.address <== address[0..xlen.width]
      entry.capture <== capture

      if xlen == XLen.X32
      | block:
          fits32[index] <== entry.fits
          predicted32[index] <== entry.predicted_address
          exact32[index] <== entry.exact_address
      | block:
          fits64[index] <== entry.fits
          predicted64[index] <== entry.predicted_address
          exact64[index] <== entry.exact_address

def program = elaborate(CompactPcFixture())
export program
