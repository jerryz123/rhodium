#lang rhodium
// Exposes shared SIMD datapaths, extension, fixed-point, widening, and compaction for differential tests.
// SPDX-License-Identifier: Apache-2.0

import:
  "../simd-alu.rhdl" open

circuit SimdAluFixture():
  input(left, right): Bits(64)
  input element_width: SimdElementWidth
  input result_select: SimdResultSelect
  input arithmetic_mode: SimdArithmeticMode
  input logic_select: SimdLogicSelect
  input comparison_select: SimdComparisonSelect
  input mask_result_select: SimdMaskResultSelect
  input permutation_select: SimdPermutationSelect
  input count_select: SimdCountSelect
  input rounding_mode: SimdRoundingMode
  input(subtract, signed_compare, maximum, shift_right, arithmetic_shift, rotate, invert_right): Bool
  input rounding: Bool
  input(enabled, carry_in, select_right): Mask(8)
  input(widening, upper_half, widen_left_wide, widen_left_signed, widen_right_signed): Bool
  input widen_element_width: SimdWidenElementWidth
  input extension_ratio: SimdExtensionRatio
  input extension_part: Bits(3)
  input extension_signed: Bool
  output(prepared_left, prepared_right): Bits(64)
  output prepared_width: SimdElementWidth
  output prepared_enabled: Mask(8)
  output data: Bits(64)
  output(mask_result, write_mask): Mask(8)
  output saturated: Bool
  output compressed_data: Bits(64)
  output compressed_count: Bits(4)
  output extension_data: Bits(64)
  output extension_legal: Bool

  inst widen(SimdWidenOperands())
  widen.left <== left
  widen.right <== right
  widen.element_width <== widen_element_width
  widen.upper_half <== upper_half
  widen.left_wide <== widen_left_wide
  widen.left_signed <== widen_left_signed
  widen.right_signed <== widen_right_signed
  widen.enabled <== enabled
  prepared_left <== widen.operands.left
  prepared_right <== widen.operands.right
  prepared_width <== widen.operands.element_width
  prepared_enabled <== widen.operands.enabled
  inst extend(SimdExtend())
  extend.source <== left
  extend.destination_width <== element_width
  extend.ratio <== extension_ratio
  extend.part <== extension_part
  extend.signed <== extension_signed
  extension_data <== extend.data
  extension_legal <== extend.legal
  inst alu(SimdALU())
  alu.left <== mux(widening, widen.operands.left, left)
  alu.right <== mux(widening, widen.operands.right, right)
  alu.element_width <== mux(widening, widen.operands.element_width, element_width)
  alu.control <== SimdAluControl():
    result_select: result_select
    arithmetic_mode: arithmetic_mode
    logic_select: logic_select
    comparison_select: comparison_select
    mask_result_select: mask_result_select
    permutation_select: permutation_select
    count_select: count_select
    subtract: subtract
    signed_compare: signed_compare
    maximum: maximum
    shift_right: shift_right
    arithmetic_shift: arithmetic_shift
    rotate: rotate
    invert_right: invert_right
  alu.rounding <== rounding
  alu.rounding_mode <== rounding_mode
  alu.enabled <== mux(widening, widen.operands.enabled, enabled)
  alu.carry_in <== carry_in
  alu.select_right <== select_right
  data <== alu.result.data
  mask_result <== alu.result.mask_result
  write_mask <== alu.result.write_mask
  saturated <== alu.result.saturated
  inst compress(SimdCompress())
  compress.data <== left
  compress.element_width <== element_width
  compress.selected <== enabled
  compressed_data <== compress.compressed.data
  compressed_count <== compress.compressed.count

export:
  SimdAluFixture
