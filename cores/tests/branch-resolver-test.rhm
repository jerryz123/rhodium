#lang rhombus
// Checks the reusable branch resolver's control contract and datapath shape.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../rhodium/frontend/layers/bool.rhm" as bool
  "../branch-resolver.rhdl" as branch

def design = embedded.run_elaboration(fun (): branch.BranchResolver(64))
def module_def = design.modules[0]
def control_type = branch.BranchResolverControl()
def request_payload_type = branch.BranchResolverRequest(64)
def result_payload_type = branch.BranchResult()
def control_fields = [
  "enable", "unconditional", "compare_equal", "signed_mode", "invert"
]
def record_extracts = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.record_get"
)
def muxes = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.mux_lookup"
)

check:
  record_type(control_type) ~is #true
  control_type.fields.map(fun (field): field.name) ~is control_fields
  (for all (field in control_type.fields):
     type_equal(field.type, bool.Bool)) ~is #true
  control_type.packed_width() ~is 5
  request_payload_type.fields.map(fun (field): field.name) ~is [
    "left", "right", "control"
  ]
  type_equal(request_payload_type.field("left").type, Bits(64)) ~is #true
  type_equal(request_payload_type.field("right").type, Bits(64)) ~is #true
  type_equal(request_payload_type.field("control").type, control_type) ~is #true
  result_payload_type.fields.map(fun (field): field.name) ~is ["taken"]
  type_equal(result_payload_type.field("taken").type, bool.Bool) ~is #true
  type_equal(
    module_def.find_input("request_in").type.field("bits").type,
    request_payload_type
  ) ~is #true
  type_equal(
    module_def.find_output("result_out").type.field("bits").type,
    result_payload_type
  ) ~is #true
  type_equal(
    module_def.find_output("result_out").type.field("valid").type,
    bool.Bool
  ) ~is #true
  record_extracts.map(fun (operation): operation.attribute("field")) ~is [
    "bits", "left", "right", "control", "signed_mode", "compare_equal",
    "unconditional", "invert", "enable", "valid"
  ]
  muxes.length() ~is 2
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.eq"
  ).length() ~is 1
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.ult"
  ).length() ~is 1
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.register" || operation.opcode == "rtl.register_reset"
  ).length() ~is 0
  verify_design(design) ~is #void
  embedded.run_elaboration(
    fun (): branch.BranchResolver(0)
  ) ~throws "PosInt"
