#lang rhombus
// Defines a program for the concrete combinational 32-bit integer ALU.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../riscv/isa/xlen.rhm" open
  "../../../cores/alu.rhdl" as alu

def program = elaborate(alu.ALU(XLen.X32))
export program
