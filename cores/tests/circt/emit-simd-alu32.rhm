#lang rhombus
// Emits the 32-bit SIMD specialization through the common differential fixture.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("riscv/isa/xlen.rhm").XLen
  "../../../rhodium/backend/circt.rhm" open
  "../../../rhodium/frontend/kernel.rhm" as embedded
  "../simd-alu-fixture.rhdl" as fixture

def design = embedded.run_elaboration(fun (): fixture.SimdAluFixture(XLen.X32))
print(emit_circt(design))
