import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../riscv/isa/xlen.rhm" open
  "../../../cores/tests/load-store-fixture.rhdl" as fixture

def program = elaborate(fixture.LoadStoreFixture(XLen.X64))
def wide_program = elaborate(fixture.LoadStoreFixture(XLen.X64, 16))
export:
  program
  wide_program
