#lang rhombus
// Defines a program for the reusable eight-bit pipelined multiplier fixture.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../cores/multiplier.rhdl" as multiplier

def program = elaborate(multiplier.PipelinedMultiplier(8))
export program
