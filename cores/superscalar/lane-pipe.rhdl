#lang rhodium
/* Pipelines canonical EX and MEM/WB records and exposes scalar views of their stage-owned PCs. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("flow/main.rhdl") open
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/rtl/vector.rhdl").RiscvVectorState
  lib("riscv/rtl/pointer-masking.rhdl").PointerMaskControl
  lib("hardfloat/main.rhdl").RoundingMode
  lib("cores/mmu/vector.rhdl").VectorFastCertificate
  lib("cores/vector/bundles.rhdl").VectorDescriptor
  lib("cores/vector/decode.rhdl").VectorControl
  "decode/core-ctrl.rhdl" open
  "pairing.rhdl" open
  "bundles.rhdl" open

/* EX storage: operands and vector controls belong to each lane. The FP request
   and upper PC bits are retained once by the issue group, outside these pipes. */

/* Keeps the vector execution snapshot without duplicating its scalar instruction PC. */
bundle SuperscalarLaneVector(xlen :: XLen):
  precertified: Bool
  certificate: VectorFastCertificate(xlen)
  instruction: Bits(32)
  state: RiscvVectorState(xlen)
  control: VectorControl()
  scalar: Bits(xlen.width)
  floating_scalar: Bits(xlen.width)
  stride: Bits(xlen.width)
  masked: Bool
  rounding_mode: RoundingMode
  pointer_masking: PointerMaskControl()

  /* Supplies the reconstructed instruction PC to vector dispatch and fault reporting. */
  method with_pc(vector, pc :: Bits(xlen.width)) :: VectorDescriptor(xlen):
    VectorDescriptor(xlen):
      pc: pc
      precertified: vector.precertified
      certificate: vector.certificate
      instruction: vector.instruction
      state: vector.state
      control: vector.control
      scalar: vector.scalar
      floating_scalar: vector.floating_scalar
      stride: vector.stride
      masked: vector.masked
      rounding_mode: vector.rounding_mode
      pointer_masking: vector.pointer_masking

/* Lists exactly the bits retained between register read and execute. */
bundle SuperscalarExecute(xlen :: XLen, hypervisor :: Boolean):
  fetched: SuperscalarLaneInstruction(xlen, SuperscalarFetchFault(xlen, hypervisor))
  control: SuperscalarControl()
  operands: SuperscalarOperands(xlen)
  rd: Bits(5)
  illegal: Bool
  virtual_instruction: Bool
  vector: SuperscalarLaneVector(xlen)

  /* The vector scalar operand and the integer rs1 operand come from the same read port. */
  method with_rs1(token, word :: Bits(xlen.width)) :: SuperscalarExecute(xlen, hypervisor):
    token.updated(~operands: token.operands.updated(~rs1: word), ~vector: token.vector.updated(~scalar: word))


/* At the reserved last slot, data has one owner per edge. Completion metadata
   advances independently of the flushable instruction, including across redirects. */
sync_circuit SuperscalarReturnSlot(xlen :: XLen):
  input instruction_valid: Bool
  input instruction_word: Bits(xlen.width)
  interface incoming(Valid(SuperscalarCompletion(xlen)), ~role: consumer)
  interface outgoing(Valid(SuperscalarCompletion(xlen)), ~role: producer)
  output word: Bits(xlen.width)

  assert(!(instruction_valid & incoming.valid), "superscalar_return_slot_exclusive")
  reg shared_word(Bits(xlen.width))
  when (incoming.valid):
    shared_word <== incoming.bits.data
  elsewhen instruction_valid:
    shared_word <== instruction_word

  def metadata = incoming |> map_valid(token => token.updated(~data: Bits(xlen.width)(0))) |> valid_pipe(1)
  metadata |> map_valid(token => token.updated(~data: shared_word)) |> outgoing
  word <== shared_word

/* Captures EX lane state and exposes only address/encoding views from the shared stage prefix. */
sync_circuit SuperscalarExecutePipe(xlen :: XLen, ~hypervisor: hypervisor :: Boolean = #false, ~completion_slot: completion_slot :: Boolean = #false):
  interface ingress(Valid(SuperscalarExecute(xlen, hypervisor)), ~role: consumer)
  interface egress(Valid(SuperscalarExecute(xlen, hypervisor)), ~role: producer)
  input flush: Bool
  input pc_region: Bits(xlen.width - SuperscalarPcOffsetBits)
  output pc: Bits(xlen.width)
  output sequential_pc: Bits(xlen.width)
  output raw_instruction: Bits(32)
  output egress_step: SuperscalarPcStep(xlen)

  inst storage(ValidPipe(SuperscalarExecute(xlen, hypervisor), 1, ~flushable: #true))
  storage.flush <== flush
  if completion_slot
  | block:
      interface returned(Valid(SuperscalarCompletion(xlen)), ~role: consumer)
      interface completion(Valid(SuperscalarCompletion(xlen)), ~role: producer)
      inst slot(SuperscalarReturnSlot(xlen))
      slot.instruction_valid <== ingress.valid
      slot.instruction_word <== ingress.bits.operands.rs1
      returned |> slot.incoming
      slot.outgoing |> completion
      ingress |> map_valid(token => token.into(SuperscalarExecute(xlen, hypervisor)).with_rs1(Bits(xlen.width)(0))) |> storage.ingress
      storage.egress |> map_valid(token => token.into(SuperscalarExecute(xlen, hypervisor)).with_rs1(slot.word)) |> egress
  | block:
      ingress |> storage.ingress
      storage.egress |> egress

  def retained :: SuperscalarExecute(xlen, hypervisor) = storage.egress.bits
  pc <== pc_region ++ retained.fetched.pc
  sequential_pc <== retained.fetched.sequential_pc.apply(pc)
  raw_instruction <== retained.fetched.raw()
  egress_step <== retained.fetched.sequential_pc

/* Captures exactly the canonical MEM/WB record; the stage group owns its PC prefix and FP context. */
sync_circuit SuperscalarResultPipe(xlen :: XLen, ~hypervisor: hypervisor :: Boolean = #false, ~completion_slot: completion_slot :: Boolean = #false):
  interface ingress(Valid(SuperscalarResult(xlen, hypervisor)), ~role: consumer)
  interface egress(Valid(SuperscalarResult(xlen, hypervisor)), ~role: producer)
  input flush: Bool
  input pc_region: Bits(xlen.width - SuperscalarPcOffsetBits)
  output pc: Bits(xlen.width)
  output sequential_pc: Bits(xlen.width)
  output egress_step: SuperscalarPcStep(xlen)

  inst storage(ValidPipe(SuperscalarResult(xlen, hypervisor), 1, ~flushable: #true))
  storage.flush <== flush
  if completion_slot
  | block:
      interface returned(Valid(SuperscalarCompletion(xlen)), ~role: consumer)
      interface completion(Valid(SuperscalarCompletion(xlen)), ~role: producer)
      inst slot(SuperscalarReturnSlot(xlen))
      slot.instruction_valid <== ingress.valid
      slot.instruction_word <== ingress.bits.resolution.value
      returned |> slot.incoming
      slot.outgoing |> completion
      ingress |> map_valid(token => token.updated(~resolution: token.resolution.updated(~value: Bits(xlen.width)(0)))) |> storage.ingress
      storage.egress |> map_valid(token => token.updated(~resolution: token.resolution.updated(~value: slot.word))) |> egress
  | block:
      ingress |> storage.ingress
      storage.egress |> egress

  def retained :: SuperscalarResult(xlen, hypervisor) = storage.egress.bits
  pc <== pc_region ++ retained.fetched.pc
  sequential_pc <== retained.fetched.sequential_pc.apply(pc)
  egress_step <== retained.fetched.sequential_pc

export:
  SuperscalarExecute
  SuperscalarLaneVector
  SuperscalarExecutePipe
  SuperscalarResultPipe
