#lang rhodium
/* Stores compact Superscalar lane payloads and reconstructs their stage-local address, PC and predictor views. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("flow/main.rhdl") open
  lib("rhodium/frontend/kernel.rhm") as kernel
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/rtl/hypervisor.rhdl").RiscvGuestFault
  "bundles.rhdl" open

def SuperscalarPcOffsetBits = 12

/* Derives a storage record from its logical type, retaining every field not explicitly changed. */
fun storage_shape(T :: RecordType, replacements :: Map, omitted :: List = []) :: RecordType:
  def kept = T.fields.filter(~keep: fun (field): !(field.name in omitted))
  def fields = for List (field in kept):
    RecordField(field.name, if replacements.has_key(field.name) | replacements[field.name] | field.type)

  RecordType(fields)

/* Copies unchanged named fields in either direction; the caller supplies only derived values. */
fun copy_fields(T :: RecordType, source :: Hardware.packable, replacements :: Map):
  def fields = for List (field in T.fields):
    [field.name, if replacements.has_key(field.name) | replacements[field.name] | kernel.project(source, field.name)]

  kernel.record_create(T, fields)

/* Omit group-owned FP requests, PC aliases, and redundant training indices, and
   replace the successor by its tag. Prediction targets and histories stay independent. */
fun lane_shape(Full :: RecordType, execute :: Boolean, Fault :: DataType, Step :: DataType) :: RecordType:
  def Fetched = Full.field("fetched").type
  def prediction = storage_shape(Fetched.field("prediction").type, {}, ["pc"])
  def fetched = storage_shape(Fetched, {"pc": Bits(SuperscalarPcOffsetBits), "sequential_pc": Step, "prediction": prediction, "fault": Fault, "direction": SuperscalarDirectionCheckpoint()})
  if execute
  | storage_shape(Full, {"fetched": fetched, "vector": storage_shape(Full.field("vector").type, {}, ["pc"])}, ["fp_request"])
  | block:
      def Branch = Full.field("branch").type
      def update = storage_shape(Branch.field("update").type, {}, ["pc", "return_address", "target"])
      storage_shape(Full, {"fetched": fetched, "branch": storage_shape(Branch, {"update": update}, ["target"])}, ["fp_request"])

/* Project into storage or back into a full lane. The target schema determines
   which aliases are present. Both branch target views use the lane's address
   word; the predicted target is independent. */
fun recode_lane(T :: RecordType, source :: Hardware.packable, pc :: Hardware.packable, successor :: Hardware.packable, fault :: Hardware.packable, direction :: Hardware.packable, fp_request :: Hardware.packable, execute :: Boolean):
  def Fetched = T.field("fetched").type
  def original = kernel.project(source, "fetched")
  def prediction = copy_fields(Fetched.field("prediction").type, kernel.project(original, "prediction"), {"pc": pc})
  def fetched = copy_fields(Fetched, original, {"pc": pc, "sequential_pc": successor, "prediction": prediction, "fault": fault, "direction": direction})
  if execute
  | block:
      def vector = copy_fields(T.field("vector").type, kernel.project(source, "vector"), {"pc": pc})
      copy_fields(T, source, {"fetched": fetched, "vector": vector, "fp_request": fp_request})
  | block:
      def Branch = T.field("branch").type
      def branch = kernel.project(source, "branch")
      def address = kernel.project(source, "address")
      def update = copy_fields(Branch.field("update").type, kernel.project(branch, "update"),
                               {"pc": pc, "return_address": kernel.project(fetched, "sequential_pc"), "target": address})
      copy_fields(T, source, {"fetched": fetched, "branch": copy_fields(Branch, branch, {"update": update, "target": address}), "fp_request": fp_request})

/* Preserves the full lane interface and one-cycle flushable pipe contract. Both
   lanes rejoin the PC prefix and FP request registered once for this stage's group. */
sync_circuit SuperscalarLanePipe(xlen :: XLen, Full :: RecordType, ~hypervisor: hypervisor :: Boolean = #false):
  def execute = Full.type_equal(SuperscalarExecute(xlen, hypervisor))
  unless execute || Full.type_equal(SuperscalarResult(xlen, hypervisor))
  | error(~who: #'SuperscalarLanePipe, "expected this core's execute or result payload")

  interface ingress(Valid(Full), ~role: consumer)
  interface egress(Valid(Full), ~role: producer)
  input flush: Bool
  input pc_region: Bits(xlen.width - SuperscalarPcOffsetBits)
  input fp_request: Full.field("fp_request").type
  input ingress_step: SuperscalarPcStep(xlen)
  output egress_step: SuperscalarPcStep(xlen)

  def Fault = if execute | SuperscalarFetchFault(xlen, hypervisor) | Bool
  def Stored = lane_shape(Full, execute, Fault, SuperscalarPcStep(xlen))
  inst storage(ValidPipe(Stored, 1, ~flushable: #true))
  storage.flush <== flush

  // These aliases are not stored; guard their producer contract at capture.
  when (ingress.valid):
    def fetched :: SuperscalarInstruction(xlen, hypervisor) = ingress.bits.fetched
    assert(fetched.direction_indices_valid(), "superscalar_lane_direction_indices")

  if execute
  | block:
      def token :: SuperscalarExecute(xlen, hypervisor) = ingress.bits
      when (ingress.valid):
        assert(token.vector.pc === token.fetched.pc, "superscalar_lane_vector_pc")
  | block:
      def token :: SuperscalarResult(xlen, hypervisor) = ingress.bits
      when (ingress.valid):
        assert(token.branch.update.pc === token.fetched.pc, "superscalar_lane_branch_pc")
        assert(token.branch.update.return_address === token.fetched.sequential_pc, "superscalar_lane_branch_return")
        when (token.branch.update.branch):
          assert(token.branch.control.enable, "superscalar_lane_branch_owns_address")
          assert(token.branch.target === token.branch.update.target, "superscalar_lane_branch_target")

        when (token.memory.enable ||| (token.prefetch.is_prefetch() & (token.resolution.disposition === SuperscalarDisposition.Continue))):
          assert(!token.branch.control.enable, "superscalar_lane_data_owns_address")

        when (token.fetched.fault.valid()):
          assert(token.resolution.disposition === SuperscalarDisposition.Fault, "superscalar_fetch_fault_disposition")
          assert(token.resolution.cause === token.fetched.fault.cause(), "superscalar_fetch_fault_cause")
          assert(token.resolution.value === token.fetched.fault.value, "superscalar_fetch_fault_value")
          if hypervisor
          | assert(token.resolution.guest.as_bits() === token.fetched.fault.guest.as_bits(), "superscalar_fetch_fault_guest")
          | #void

  // EX still needs the fault payload. Later stages need only its origin bit:
  // resolution owns the surviving cause, value, and guest provenance.
  (ingress |> map_valid(token):
    def fetched :: SuperscalarInstruction(xlen, hypervisor) = token.fetched
    def fault = fetched.fault
    def encoded = if execute | fault | fault.valid()
    // Select by decode, without waiting for EX legality or MEM's taken bit.
    // The live EX lookup bypasses this mux; at WB its inputs already alias.
    def captured = if execute
    | token
    | block:
        def result :: SuperscalarResult(xlen, hypervisor) = token
        result.updated(~address: mux(result.branch.control.enable, result.branch.target, result.address))

    recode_lane(Stored, captured, fetched.pc[0..SuperscalarPcOffsetBits], ingress_step, encoded, fetched.retained_direction(), token.fp_request, execute)
  ) |> storage.ingress

  egress_step <== storage.egress.bits.fetched.sequential_pc
  (storage.egress |> map_valid(token):
    def fault:
      if execute
      | token.fetched.fault
      | block:
          def resolution :: SuperscalarSyncResolution(xlen) = token.resolution
          wire observed: SuperscalarFetchFault(xlen, hypervisor)
          observed.kind <== mux(token.fetched.fault, fetch_fault_kind(resolution.cause), SuperscalarFetchFaultKind.None)
          observed.value <== mux(token.fetched.fault, resolution.value, Bits(xlen.width)(0))
          if hypervisor
          | observed.guest <== mux(token.fetched.fault, resolution.guest, literal(RiscvGuestFault(), 0))
          | #void

          observed

    def pc = pc_region ++ token.fetched.pc
    def step :: SuperscalarPcStep(xlen) = token.fetched.sequential_pc
    def direction :: SuperscalarDirectionCheckpoint() = token.fetched.direction
    recode_lane(Full, token, pc, step.apply(pc), fault, direction.expanded(pc), fp_request, execute)
  ) |> egress

export:
  SuperscalarPcOffsetBits
  SuperscalarLanePipe
