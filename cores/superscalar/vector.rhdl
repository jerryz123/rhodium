#lang rhodium
/* Admits WB-authorized vector descriptors and joins shared execution to Superscalar's LSU timing. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/common/vector/service.rhdl").VectorExecutionService
  lib("cores/common/cosim-source.rhm").describe_cosim_signals
  lib("cores/common/vector/backend.rhdl") open
  "bundles.rhdl" open
  "vector-memory.rhdl" open
  lib("cores/common/vector/bundles.rhdl") open
  lib("cores/common/mmu/vector.rhdl") open
  lib("cores/common/misaligned-access.rhdl") open
  lib("cores/common/fp/timing.rhdl") open
  lib("riscv/isa/xlen.rhm") open
  lib("riscv/isa/vector.rhm") open
  lib("riscv/rtl/pointer-masking.rhdl") open
  lib("riscv/rtl/hypervisor.rhdl") open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

/* Queues six WB-authorized descriptors by default without conflating admission, fault certainty,
   last-beat acceptance, and final execution drain. The scalar core owns age order,
   architectural retirement, and arithmetic/write-port arbitration at these ports. */
sync_circuit SuperscalarVectorPipeline(xlen :: XLen, vlen :: VectorLength, ~vector_completion_slots: slots :: Pow2Int = 8, ~dispatch_depth: dispatch_depth :: PosInt = 6, ~multiply_latency: multiply_latency :: maybe(PosInt) = #false, ~fixed_fp: fixed_fp :: Boolean = #false, ~fp_timing: fp_timing :: FpExecutionTiming = FpExecutionTiming()):
  interface service(VectorExecutionService(xlen, slots), ~role: executor)
  interface request(Decoupled(VectorDescriptor(xlen)), ~role: consumer)
  interface pipeline(SuperscalarPipelineAccess(xlen), ~role: requester)
  interface memory(SuperscalarMemory(xlen, xlen.width), ~role: requester)
  interface split(RiscvSplitAccess(xlen, Bool), ~role: requester)
  interface precheck(VectorPrecheck(), ~role: requester)
  interface outcome(Valid(VectorCommit(xlen, slots)), ~role: producer)
  output outcome_guest: RiscvGuestFault()
  output(pipeline_physical, request_physical): Bool
  interface floating_writeback(Decoupled(Bits(4)), ~role: producer)
  output active: Bool

  inst access(SuperscalarVectorMemory(xlen, slots))
  inst backend(VectorBackend(xlen, vlen, RiscvGuestFault(), ~vector_completion_slots: slots, ~dispatch_depth: dispatch_depth, ~pipe: #false, ~multiply_latency: multiply_latency, ~packed_multiply: #true, ~fixed_fp: fixed_fp, ~fp_timing: fp_timing))
  backend.precise_fault <== access.outcome_guest
  outcome_guest <== backend.outcome_fault
  access.split <=> split
  backend.memory_drained <== memory.drained & access.idle
  active <== backend.active ||| !access.idle
  request |> backend.request
  backend.precheck <=> precheck
  backend.outcome |> outcome
  backend.issue |> access.issue
  access.feedback |> backend.decision
  access.completion |> backend.completion
  access.store_completed |> backend.store_completed
  access.outcome |> backend.precise
  backend.memory_start_ready <== access.memory_start_ready
  access.pointer_masking <== backend.pointer_masking
  access.pipeline <=> pipeline
  access.memory <=> memory
  pipeline_physical <== access.pipeline_physical
  request_physical <== access.request_physical
  backend.service <=> service
  backend.floating_writeback |> floating_writeback
  describe_cosim_signals({"admitted": request.fire()}, ~components: {"backend": backend, "memory": access})

/* Terminates the optional vector client without allocating a sequencer, VRF, or execution state. */
sync_circuit SuperscalarVectorDisabled(xlen :: XLen, ~vector_completion_slots: slots :: Pow2Int = 8):
  interface service(VectorExecutionService(xlen, slots), ~role: executor)
  interface request(Decoupled(VectorDescriptor(xlen)), ~role: consumer)
  interface pipeline(SuperscalarPipelineAccess(xlen), ~role: requester)
  interface memory(SuperscalarMemory(xlen, xlen.width), ~role: requester)
  interface split(RiscvSplitAccess(xlen, Bool), ~role: requester)
  interface precheck(VectorPrecheck(), ~role: requester)
  interface outcome(Valid(VectorCommit(xlen, slots)), ~role: producer)
  output outcome_guest: RiscvGuestFault()
  output(pipeline_physical, request_physical): Bool
  interface floating_writeback(Decoupled(Bits(4)), ~role: producer)
  output active: Bool
  for (port :: Endpoint in [pipeline.request, memory.request, split.request, precheck.request, outcome, service.fp_request, service.multiply_request, service.divide_request, service.fp_update, service.fault_start, service.truncate, service.scalar_result, service.scalar_writeback, service.floating_result]):
    port.valid <== Bool(#false)
    port.bits <== dont_care(port.bits.type)

  for (port :: Endpoint in [precheck.release, service.retire, service.execution_done, service.saturate]):
    port.valid <== Bool(#false)

  floating_writeback.valid <== Bool(#false)
  floating_writeback.bits <== Bits(4)(1)

  for (port :: Endpoint in [memory.response, precheck.response, service.fp_result, service.multiply_result, service.divide_result]):
    port.ready <== Bool(#true)

  request.ready <== Bool(#false)
  pipeline.commit <== Bool(#false)
  outcome_guest <== literal(RiscvGuestFault(), 0)
  for (value in [pipeline_physical, request_physical, active, service.sequencing, service.pending, service.stores_pending, service.loads_pending, service.fp_pending, service.certification_pending, service.available]):
    value <== Bool(#false)

export:
  SuperscalarVectorPipeline
  SuperscalarVectorDisabled
