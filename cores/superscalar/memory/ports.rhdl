#lang rhodium
/* Arbitrates scalar/vector LSU traffic and routes carried context while retaining lookup and split ownership. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/common/cosim-source.rhm").describe_cosim_signals
  "../bundles.rhdl" open
  lib("cores/common/memory-arbiter.rhdl") open
  lib("cores/common/misaligned-access.rhdl") open
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/rtl/hypervisor.rhdl") open
  lib("flow/main.rhdl") open
  lib("rhodium/std/bits.rhdl").Pow2Int

/* Gives fixed scalar EX attempts priority and fairly arbitrates irrevocable WB requests.
   Neither speculative redirects nor live requester changes affect accepted reply routing. */
sync_circuit SuperscalarMemoryPorts(xlen :: XLen, slots :: Pow2Int):
  def Context = SuperscalarMemoryContext(xlen, slots)
  interface scalar_pipeline(SuperscalarPipelineAccess(xlen), ~role: responder)
  interface vector_pipeline(SuperscalarPipelineAccess(xlen), ~role: responder)
  interface pipeline(SuperscalarPipelineAccess(xlen), ~role: requester)
  interface scalar_memory(SuperscalarMemory(xlen, xlen.width, Context), ~role: responder)
  interface vector_memory(SuperscalarMemory(xlen, xlen.width, Context), ~role: responder)
  interface memory(SuperscalarMemory(xlen, xlen.width, Context), ~role: requester)
  interface scalar_split(RiscvSplitAccess(xlen, Bool), ~role: responder)
  interface vector_split(RiscvSplitAccess(xlen, Bool), ~role: responder)
  interface split(RiscvSplitAccess(xlen, Bool), ~role: requester)
  input scalar_guest_access: RiscvGuestMemoryAccess
  output split_guest_access: RiscvGuestMemoryAccess
  output(pipeline_vector, request_vector): Bool


  /* Fixed-cycle lookup and store-candidate ownership.
     Scalar EX wins each lookup; MEM routes its response and WB qualifies commit.
     These stage registers do not track accepted slow-memory requests. */

  pipeline_vector <== !scalar_pipeline.request.valid
  def (_, mem_vector) = arbitrate_memory_lookups(
    SuperscalarMemoryReq(xlen, xlen.width, Bool), SuperscalarLookupResult(xlen), scalar_pipeline, vector_pipeline, pipeline
  )


  /* Accepted slow-memory routing travels with the completion context.
     Registered credits preserve the previous sixteen-entry admission bound. */

  request_vector <== arbitrate_memory_transactions(
    scalar_memory, vector_memory, memory, ~round_robin: #true, ~capacity: 16,
    ~vector_response: fun (reply :: MemoryResponse(Bits(xlen.width), Context)): reply.context.is(Context.Vector)
  )
  memory.fault |> filter_valid(_fault => !request_vector) |> scalar_memory.fault
  memory.fault |> filter_valid(_fault => request_vector) |> vector_memory.fault
  scalar_memory.ordered_busy <== memory.ordered_busy
  vector_memory.ordered_busy <== memory.ordered_busy


  /* Split ownership spans the entire fragment sequence.
     Capture the client at request transfer and release only on final response;
     subsequent offers and speculative recovery cannot redirect that response. */

  inst fragments(RRArbiter(split.request.bits.type, 2))
  Array(scalar_split.request, vector_split.request) <=> fragments.ingress
  reg split_busy(~init: Bool(#false))
  reg split_vector(Bool)
  fragments.egress |> gate_flow(!split_busy) |> split.request
  split_guest_access <== mux(fragments.chosen.into(Bool), RiscvGuestMemoryAccess.Normal, scalar_guest_access)
  split.response |> filter_valid(_response => !split_vector) |> scalar_split.response
  split.response |> filter_valid(_response => split_vector) |> vector_split.response
  when (split.request.fire()):
    split_busy <== Bool(#true)
    split_vector <== fragments.chosen.into(Bool)
  elsewhen (split.response.valid):
    split_busy <== Bool(#false)

  when (split.response.valid):
    assert(split_busy, "superscalar_split_response_retains_client")

  describe_cosim_signals({
    "pipeline_vector": mem_vector,
    "request_vector": request_vector,
    "split_vector": split_busy & split_vector
  })

export SuperscalarMemoryPorts
