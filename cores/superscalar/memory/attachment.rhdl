#lang rhodium
/* Routes Superscalar physical accesses through shared coherent L1D or ordered nonallocating CHI service. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/common/fetch/protocol.rhdl") open
  "../../common/cache/access.rhdl" open
  "../../common/cache/uncached-instruction.rhdl".UncachedInstructionMemory
  lib("riscv/rtl/hypervisor.rhdl") open
  "../bundles.rhdl" open
  "../../common/cache/config.rhm" open
  "../../common/cache/protocol.rhdl" open
  "../../common/cache-prefetch.rhdl" open
  "../../common/cache/l1d/cache.rhdl" open
  "../../common/cache/ordered-service.rhdl" open
  "../../common/chi-hart.rhdl" open
  "../../common/load-store.rhdl" open
  "../../../riscv/isa/xlen.rhm" open
  lib("riscv/rtl/trap.rhdl").ExceptionCause
  lib("flow/main.rhdl") open
  lib("rhodium/std/bits.rhdl") open
  lib("chi/protocol/channels.rhdl") open

/* Admits coherent RAM to L1D and exact-width device/noncacheable accesses to a committed IOMSHR.
   IO drains older cache work and blocks younger accesses through final response consumption.
   Accepted operations retain ordered, nonfaulting completion ownership through all redirects. */
sync_circuit SuperscalarL1D(cache :: CacheConfig, ~chi: config :: RiscvHartCHIConfig, ~context: Context :: DataType = Bool, ~service_queue_depth: service_queue_depth :: PosInt = 2, ~xlen: xlen :: XLen = XLen.X64, ~beat_bytes: beat_bytes :: Pow2Int = xlen.width / 8):
  def bytes = xlen.width / 8
  input node_id: Bits(config.flit.node_id_width)
  input uncached_node_id: Bits(config.flit.node_id_width)
  interface memory(SuperscalarPhysicalMemory(xlen, Context), ~role: responder)
  interface instruction(PhysicalInstructionAccess(64, 64), ~role: responder)
  interface prefetch(Valid(CachePrefetchReq(64)), ~role: consumer)
  interface pipeline_lookup(Valid(CachePipelineReq(xlen)), ~role: consumer)
  interface pipeline(CachePipelineAccess(xlen), ~role: responder)
  interface chi(CHIRNChannels(config.flit), ~role: node)
  interface uncached_chi(CHIRNIChannels(config.flit), ~role: node)


  /* Coherent storage and ordered uncached transport.
     Data and fetch share transport, but accepted data drain excludes the younger fetch owner. */

  inst storage(L1DCache(xlen, cache, ~chi: config, ~context: Context, ~service_queue_depth: service_queue_depth, ~beat_bytes: beat_bytes))
  storage.node_id <== node_id
  chi <=> storage.chi
  inst uncached(UncachedInstructionMemory(XLen.X64, config, Bool, 64))
  instruction.response <=> uncached.instruction.response
  uncached.instruction.flush <== instruction.flush
  uncached.node_id <== uncached_node_id
  uncached.chi <=> uncached_chi
  def cache_reply = map_flow(response => MemoryResponse(Bits(xlen.width), Context)):
    data: response.data[0..xlen.width]
    context: response.context
  def io_reply = map_flow(response => MemoryResponse(Bits(xlen.width), Context)):
    data: response.data[0..xlen.width] << (response.context.offset ++ Bits(3)(0))
    context: response.context.context
  def ordering = attach_ordered_memory(storage.core, uncached.core, memory.response, XLen.X64, SuperscalarUncachedContext(Context),
                                       ~physical_map: config.physical_map, ~cache_reply: cache_reply, ~io_reply: io_reply)


  /* Uncached fetch and best-effort prefetch.
     Instruction requests wait for data drain; outstanding IO/local management suppress hints. */

  instruction.request |> gate_flow(ordering.background_ready) |> uncached.instruction.request

  (prefetch |> filter_valid(_request => ordering.hints_ready) |> map_valid(hint):
    def request :: CachePrefetchReq(64) = hint
    CachePrefetchReq(xlen.width):
      address: request.address[0..xlen.width]
      operation: request.operation
  ) |> storage.prefetch


  /* Physical admission and service selection.
     Management uses physical cacheability; ordinary requests use resolved PMA/PBMT attributes. */

  def ordered_busy = ordering.ordered_busy
  def request :: AddressedPhysicalMemoryBeatReq(xlen, Context, bytes, 64) = memory.request.bits.memory
  def atomic_request = request.access.is_lr_sc_or_amo()
  def admission = classify_committed_cache_access(
    XLen.X64, config.physical_map, request.address, request.width, request.access, memory.request.bits.pbmt,
    ~require_alignment: #true
  )


  /* Speculative EX/MEM cache access.
     The MMU owns translation/PMA checks. EX indexing cannot depend on a TLB hit;
     the physical tag arrives alongside the following SRAM result. */

  /* The cache's scalar mode positions the data and returns the addressed XLEN word.
     Do not row-align the address or shift data a second time at this boundary. */
  fun pipeline_beat(request :: CachePipelineReq(xlen)) :~ CachePipelineBeatReq(xlen, beat_bytes):
    if beat_bytes == bytes
    | request
    | CachePipelineBeatReq(xlen, beat_bytes):
        raw_beat: Bool(#false)
        address: request.address
        width: request.width
        access: request.access
        unsigned: request.unsigned
        data: request.data.zext(beat_bytes * 8)
        byte_mask: place_word_byte_mask(request.address, request.byte_mask, beat_bytes)

  pipeline_lookup |> map_valid(request => pipeline_beat(request)) |> storage.pipeline_lookup
  pipeline.request |> filter_valid(_request => !ordered_busy) |> map_valid(request => pipeline_beat(request)) |> storage.pipeline.request
  (storage.pipeline.response |> map_valid(result => CachePipelineResult(xlen)):
     outcome: result.outcome
     reason: result.reason
     data: result.data[0..xlen.width]
  ) |> pipeline.response
  storage.pipeline.commit <== pipeline.commit & !ordered_busy
  pipeline.commit_ready <== storage.pipeline.commit_ready & !ordered_busy


  /* Committed cached, uncached, and local-management paths.
     Accepted operations retain response ownership across speculative redirects. */

  def admitted = memory.request |> gate_flow(admission.permitted)
  def Array(cached, uncached_requests, local_management) = route_committed_request(admitted, admission.route)
  // A statically uncached region has no cached copies. Complete after drain,
  // without issuing an invented load/store to a possibly side-effecting device.
  (local_management |> map_flow(request => MemoryResponse(Bits(xlen.width), Context)):
    data: Bits(xlen.width)(0)
    context: request.context
  ) |> ordering.management
  def Array(authorized, authorized_index) = cached |> gate_flow(!ordered_busy) |> atomic_fork(2)
  authorized_index |> to_valid() |> map_valid(request => mux(atomic_request, request.address[0..xlen.width], request.address[0..xlen.width].align_down(bytes))) |> storage.virtual_lookup
  (
    authorized |> map_flow(payload):
      def native = payload.into(AddressedPhysicalMemoryBeatReq(xlen, Context, bytes, 64))
      def address = native.address[0..xlen.width]
      // Zero initializes raw_beat (when present); completion context comes from the request.
      def scalar :: PhysicalMemoryBeatReq(xlen, Context, beat_bytes) = literal(PhysicalMemoryBeatReq(xlen, Context, beat_bytes), 0)
      scalar.updated(
        ~address: mux(atomic_request, address, address.align_down(bytes)), ~byte_mask: place_word_byte_mask(address, native.byte_mask, beat_bytes),
        ~width: mux(atomic_request, native.width, if xlen == XLen.X32 | MemoryWidth.Word | MemoryWidth.Double), ~unsigned: native.unsigned,
        ~context: native.context, ~data: native.data.zext(beat_bytes * 8), ~access: native.access, ~atomic: native.atomic, ~locality: native.locality
      )
  ) |> ordering.cached

  (
    uncached_requests |> map_flow(request => UncachedMemoryReq(XLen.X64, SuperscalarUncachedContext(Context))):
      device: admission.strongly_ordered
      request:
        PhysicalMemoryReq(XLen.X64, SuperscalarUncachedContext(Context)):
          byte_mask: place_word_byte_mask(request.address, request.byte_mask, 8)
          address: request.address
          access: request.access
          atomic: request.atomic
          width: request.width
          unsigned: Bool(#true)
          data: if xlen == XLen.X64 | request.data >> (request.address[0..3] ++ Bits(3)(0)) | (request.data >> (request.address[0..2] ++ Bits(3)(0))).zext(64)
          context:
            SuperscalarUncachedContext(Context):
              offset: if xlen == XLen.X64 | request.address[0..3] | request.address[0..2].zext(3)
              context: request.context
          locality: request.locality
  ) |> ordering.uncached


  /* Admission faults report the original address. Accepted cache service completes without a late fault. */

  memory.fault.valid <== memory.request.valid & !admission.permitted
  memory.fault.bits <== SuperscalarResolution(xlen):
    guest: literal(RiscvGuestFault(), 0)
    disposition: SuperscalarDisposition.Fault
    cause: mux(request.access.store_fault_class(), ExceptionCause.StoreAccessFault, ExceptionCause.LoadAccessFault)
    value: request.address[0..xlen.width]

  memory.drained <== ordering.drained
  memory.reservation_valid <== storage.core.reservation_valid
  memory.ordered_busy <== ordered_busy
  when (storage.core.response.valid):
    assert(!storage.core.response.bits.access_fault, "superscalar_l1d_accepted_response_nonfaulting")

export:
  SuperscalarL1D
