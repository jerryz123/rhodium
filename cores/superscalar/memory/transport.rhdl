#lang rhodium
/* Carries accepted client identity through physical memory without a parallel routing FIFO. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../bundles.rhdl" open
  lib("cores/common/memory-arbiter.rhdl").arbitrate_memory_clients
  lib("cores/common/cache/protocol.rhdl").PhysicalDataReq
  lib("riscv/isa/xlen.rhm").XLen
  lib("flow/main.rhdl") open
  lib("rhodium/std/bits.rhdl") open

/* Adds one physical-client routing layer to opaque context and removes it on reply.
   Admission faults use the live grant; accepted replies use only returned context.
   Eight registered credits preserve the former owner FIFO's admission boundary. */
sync_circuit SuperscalarMemoryTransport(xlen :: XLen, clients :: PosInt, Context :: DataType):
  def Routed = SuperscalarTransportContext(Context, clients)
  interface request[clients](Decoupled(PhysicalDataReq(xlen, Context, 64)), ~role: consumer)
  interface response[clients](Decoupled(MemoryResponse(Bits(xlen.width), Context)), ~role: producer)
  interface fault[clients](Valid(SuperscalarResolution(xlen)), ~role: producer)
  interface physical(SuperscalarPhysicalMemory(xlen, Routed), ~role: requester)
  output drained: Bool

  /* Wraps the original context so physical replies retain their accepted owner. */
  fun tag_request(selected :: PhysicalDataReq(xlen, Context, 64), chosen :: Bits(index_width(clients))):
    def route = SuperscalarTransportContext(Context, clients):
      client: chosen
      context: selected.memory.context
    selected.with_context(Routed, route)

  def (chosen, routed, all_drained) = arbitrate_memory_clients(
    request, physical, ~capacity: 8, ~tag_request: tag_request,
    ~response_client: fun (reply :: MemoryResponse(Bits(xlen.width), Routed)): reply.context.client
  )
  drained <== all_drained
  def faults = physical.fault |> fork_valid(clients)
  for (client in 0..clients):
    (routed[client] |> map_flow(reply):
      def returned :: MemoryResponse(Bits(xlen.width), Routed) = reply
      returned.with_context(Context, returned.context.context)
    ) |> response[client]
    faults[client] |> filter_valid(_fault => chosen === Bits(index_width(clients))(client)) |> fault[client]

export SuperscalarMemoryTransport
