#lang rhodium
/* Implements RV64 Sv39 and guest translation with retained walk failures. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../../common/cache/prefetch.rhdl" open
  lib("cores/common/mmu/context.rhdl") open
  lib("riscv/rtl/hypervisor.rhdl") open
  lib("riscv/rtl/pointer-masking.rhdl") open
  "../bundles.rhdl" open
  "translation.rhdl" open
  "translation-specialization.rhm" open
  lib("rhodium/frontend/foundation.rhm").CircuitDefinition
  "../../common/cache/operation.rhdl" open
  "../../common/cache-prefetch.rhdl" open
  "../../common/chi-hart.rhdl" open
  "../../common/mmu/protocol.rhdl" open
  "../../common/mmu/translation.rhdl" open
  "../../common/mmu/tlb.rhdl" open
  "../../common/mmu/walker.rhdl" open
  lib("riscv/isa/xlen.rhm") open
  lib("riscv/rtl/pma.rhdl").RiscvPhysicalMemoryMap
  lib("riscv/rtl/privilege.rhdl") open
  lib("riscv/rtl/sv39.rhdl") open
  lib("riscv/rtl/svpbmt.rhdl") open
  lib("flow/main.rhdl") open
  lib("rhodium/std/bits.rhdl") open
  lib("cores/common/mmu/vector.rhdl") open
  lib("cores/common/mmu/vector-window.rhdl") open
  lib("cores/common/mmu/vector-certificate.rhdl").VectorCertificate

/* Resolves RV64 instruction/data queries using TLBs, retained failures, and a shared walker.
   Queries are combinational; only authorized misses and registered vector probes may allocate walks. */
sync_circuit SuperscalarSv39Translation(config :: RiscvHartCHIConfig, ~svnapot: svnapot :: Boolean = #false, ~hypervisor: hypervisor :: Boolean = #true):
  input state: RiscvTranslationState(XLen.X64)
  input invalidate: Bool
  input query: SuperscalarTranslationQuery(XLen.X64)
  input(pipeline_vector, request_vector): Bool
  interface vector_precheck(VectorPrecheck(), ~role: responder)
  interface vector_fast(VectorFastCheck(XLen.X64), ~role: responder)
  interface prefetch(Valid(CachePrefetchReq(64)), ~role: consumer)
  interface physical_prefetch(Valid(CachePrefetchReq(64)), ~role: producer)
  interface instruction(SuperscalarInstructionTranslation(XLen.X64), ~role: responder)
  interface pte(RiscvTranslationMemory(), ~role: requester)
  output result: SuperscalarAddressResolution()


  /* Translation banks and pinned vector proof ownership. */

  inst itlb(RiscvTranslationTlb(~host_root_epoch: !hypervisor))
  inst dtlb(RiscvTranslationTlb(~host_root_epoch: !hypervisor))
  inst walker(RiscvTranslationWalker(~svnapot: svnapot))
  inst vector_window(VectorWindow(config.physical_map))
  vector_precheck <=> vector_window.check
  reg mem_vector(~init: Bool(#false))
  mem_vector <== pipeline_vector
  reg mem_physical(~init: Bool(#false))
  mem_physical <== pipeline_vector & vector_fast.pipeline_physical
  assert(!(invalidate & vector_window.owned), "superscalar_vector_window_drained_before_invalidation")


  /* Selects the held split owner's pointer interpretation independently of its current address. */

  def split_mask = select_pointer_mask(state.pointer_masking, state.guest_pointer_masking, query.split_access)


  /* Architectural invalidation
     Cancel the walker one cycle later; accepted physical response owners remain live. */

  reg cancel(~init: Bool(#false))
  cancel <== invalidate
  walker.cancel <== cancel
  itlb.invalidate_all <== invalidate
  dtlb.invalidate_all <== invalidate


  /* Effective data context and TLB request selection
     Authorized split/WB demand takes the DTLB ahead of speculative MEM lookup. */

  def tlb = RiscvTlbLookupBuilder(XLen.X64, state, ~sv39: #true, ~hypervisor: hypervisor)
  def guest_state = tlb.guest_state
  def normal = effective_data_context(XLen.X64, state.privilege, state.mstatus, ~virtualized: if hypervisor | guest_state.virtualized | #false)

  def instruction_lookup = tlb.lookup(instruction.request.bits, Sv39Access.Fetch, state.privilege, guest_state.virtualized)
  def data_virtual_address = query.address
  def data_demand = query.demand
  def vector_probe = vector_window.translation.request.valid & !data_demand & !query.busy
  def certified_physical = !query.split & !vector_probe & mux(query.wb_valid, request_vector & vector_fast.request_physical, query.mem_valid & mem_physical)
  vector_window.addresses <== vec(query.mem_address, query.wb_address)
  def window_hit = !query.split & !vector_probe & !certified_physical & mux(query.wb_valid, request_vector & vector_window.hits[1], mem_vector & vector_window.hits[0])
  def window_address = mux(query.wb_valid, vector_window.physical_addresses[1], vector_window.physical_addresses[0])
  def demand = if hypervisor | guest_data_context(normal, query.guest_access, guest_state.hstatus) | normal
  def execute_read = Bool(hypervisor) & (query.guest_access === RiscvGuestMemoryAccess.GuestExecuteRead)
  def normal_lookup = tlb.lookup(data_virtual_address, query.access.translation_access(), demand.privilege, demand.virtualized).updated(~execute_read: execute_read)
  def probe_request = vector_window.translation.request.bits
  def probe_access = mux(probe_request.store, Sv39Access.Store, Sv39Access.Load)
  def probe_lookup = tlb.lookup(probe_request.address, probe_access, normal.privilege, normal.virtualized)
  def fast_lookup = tlb.lookup(vector_fast.request.bits.first, mux(vector_fast.request.bits.store, Sv39Access.Store, Sv39Access.Load), normal.privilege, normal.virtualized)
  def data_lookup = mux(vector_probe, probe_lookup, normal_lookup)
  itlb.lookup <== instruction_lookup
  dtlb.lookup <== data_lookup
  inst certificate(VectorCertificate(XLen.X64, config.physical_map))
  vector_fast <=> certificate.check
  certificate.invalidate <== invalidate
  certificate.current <== tlb.lookup(Bits(64)(0), Sv39Access.Load, normal.privilege, normal.virtualized)
  // The independent probe certifies MEM while the demand port serves older work.
  // Certification checks real A/D permissions; only optional data hints may drop.
  certificate.translation.valid <== vector_fast.request.valid & dtlb.probe_hit
  certificate.translation.bits <== riscv_host_result(dtlb.probe_translation).updated(~pbmt: dtlb.probe_pbmt)


  /* Registered hints never contend with demand translation or allocate a walk.
     A context change discards both staged forms, including the outgoing edge. */

  reg prefetch_previous_state(RiscvTranslationState(XLen.X64), ~init: literal(RiscvTranslationState(XLen.X64), 0))
  prefetch_previous_state <== state
  def prefetch_flush = invalidate ||| (prefetch_previous_state.as_bits() =/= state.as_bits())
  inst virtual_prefetch_pipe(ValidPipeAlwaysCapture(CachePrefetchReq(64), 1, ~flushable: #true))
  inst physical_prefetch_pipe(PhysicalPrefetchPipe(64, config.physical_map.cacheable_address_width))
  virtual_prefetch_pipe.flush <== prefetch_flush
  physical_prefetch_pipe.flush <== prefetch_flush
  prefetch |> virtual_prefetch_pipe.ingress
  def prefetch_request :: CachePrefetchReq(64) = virtual_prefetch_pipe.egress.bits
  def prefetch_lookup = tlb.lookup(prefetch_request.address, Sv39Access.Load, normal.privilege, normal.virtualized)
  itlb.probe <== prefetch_lookup
  dtlb.probe <== mux(vector_fast.request.valid, fast_lookup, prefetch_lookup)
  def instruction_prefetch = prefetch_request.operation === CachePrefetchOperation.Instruction
  def hint_probe = mux(instruction_prefetch, itlb.prefetch_probe, dtlb.prefetch_probe)
  def prefetch_translated = tlb.enabled(normal.privilege, normal.virtualized)
  def prefetch_address_valid = prefetch_translated ||| !prefetch_request.address[56..64].any()
  def prefetch_address = hint_probe.physical_address.zext(64)
  def prefetch_physical = cache_prefetch_physical(64, config.physical_map, prefetch_address, prefetch_request.operation, hint_probe.pbmt)
  def prefetch_probe_available = instruction_prefetch ||| !vector_fast.request.valid
  def prefetch_eligible = prefetch_probe_available & !prefetch_flush & hint_probe.hit & !hint_probe.fault & prefetch_address_valid & prefetch_physical.ordinary_memory & prefetch_physical.permitted
  (virtual_prefetch_pipe.egress |> filter_valid(_request => prefetch_eligible) |> map_valid(request => request.updated(~address: prefetch_physical.address))) |> physical_prefetch_pipe.ingress
  physical_prefetch_pipe.egress |> filter_valid(_request => !prefetch_flush) |> physical_prefetch


  /* Faults are not TLB entries. Retain each port's exact failed request until
     its replay observes it; context matching prevents reuse after CSR changes. */

  reg instruction_fault_valid(~init: Bool(#false))
  reg data_fault_valid(~init: Bool(#false))
  reg instruction_fault(RiscvTranslationFailure())
  reg data_fault(RiscvTranslationFailure())
  def instruction_failed = instruction_fault_valid & instruction_fault.request.same_request(instruction_lookup)
  def data_failed = data_fault_valid & data_fault.request.same_request(data_lookup)
  def instruction_known = itlb.hit ||| instruction_failed
  def data_known = dtlb.hit ||| data_failed ||| window_hit ||| certified_physical
  def instruction_result = mux(instruction_failed, instruction_fault.mapping(), itlb.translation)
  def translated_result = mux(data_failed, data_fault.mapping(), dtlb.translation)
  def data_result = priority_mux(~default: translated_result):
    certified_physical: translated_result.updated(~physical_address: data_virtual_address[0..56], ~fault: RiscvTranslationFault.None)
    window_hit: translated_result.updated(~physical_address: window_address[0..56], ~fault: RiscvTranslationFault.None)

  def data_ok = data_known & (data_result.fault === RiscvTranslationFault.None)
  def data_pbmt = mux(window_hit ||| certified_physical, PageMemoryType.PMA, riscv_host_result(data_result).pbmt)
  vector_window.translation.request.ready <== vector_probe & data_known & !invalidate
  vector_window.translation.response.valid <== vector_window.translation.request.fire()
  vector_window.translation.response.bits <== riscv_host_result(data_result)
  instruction.pbmt <== riscv_host_result(instruction_result).pbmt
  instruction.address <== instruction_result.physical_address.zext(64)
  def instruction_disposition = priority_mux(~default: SuperscalarDisposition.Continue):
    !instruction_known: SuperscalarDisposition.Replay
    instruction_result.fault =/= RiscvTranslationFault.None: SuperscalarDisposition.Fault

  instruction.resolution <== SuperscalarResolution(XLen.X64):
    guest: riscv_guest_exception(instruction_result, guest_state.virtualized).details
    disposition: instruction_disposition
    cause: riscv_translation_fault_cause(instruction_result)
    value: instruction.request.bits


  /* Publishes physical attributes and exact faults without granting physical admission. */

  result <== SuperscalarAddressResolution():
    known: data_known
    address: data_result.physical_address.zext(64)
    pbmt: data_pbmt
    fault: data_result.fault
    cause: riscv_translation_fault_cause(data_result)
    guest: riscv_guest_exception(data_result, demand.virtualized)
    execute_read: execute_read
    probe_busy: vector_probe
    split_mask: split_mask


  /* Retained miss admission and TLB fills
     An active walk completes first; pending authorized data wins the next walk admission. */

  reg pending_data(~init: Bool(#false))
  reg pending_lookup(RiscvTlbLookup())
  reg walk_live(~init: Bool(#false))
  reg walk_data(Bool)
  reg walk_lookup(RiscvTlbLookup())
  def data_miss = (data_demand ||| vector_probe) & !data_known
  def same_active_data = walk_live & walk_data & walk_lookup.same_request(data_lookup)
  def instruction_miss = instruction.request.valid & !instruction_known
  def choose_data = pending_data ||| data_miss
  walker.request.valid <== !walk_live & !cancel & !invalidate & (choose_data ||| instruction_miss)
  def selected_data_walk = mux(pending_data, pending_lookup, data_lookup)
  walker.request.bits <== mux(choose_data, selected_data_walk, instruction_lookup)
  walker.completion.ready <== Bool(#true)
  def fill = RiscvTlbFill():
    request: walk_lookup
    result: walker.completion.bits

  itlb.fill.valid <== walker.completion.valid & walk_live & !walk_data & !invalidate
  dtlb.fill.valid <== walker.completion.valid & walk_live & walk_data & !invalidate
  itlb.fill.bits <== fill
  dtlb.fill.bits <== fill
  when invalidate:
    walk_live <== Bool(#false)
  elsewhen (walker.request.fire()):
    walk_live <== Bool(#true)
    walk_data <== choose_data
    walk_lookup <== walker.request.bits
  elsewhen (walker.completion.valid):
    walk_live <== Bool(#false)

  when (invalidate ||| (walker.request.fire() & choose_data)):
    pending_data <== Bool(#false)
  elsewhen (data_miss & !same_active_data & !pending_data):
    pending_data <== Bool(#true)
    pending_lookup <== data_lookup

  when invalidate:
    instruction_fault_valid <== Bool(#false)
  elsewhen (walker.completion.valid & walk_live & !walk_data):
    instruction_fault_valid <== walker.completion.bits.fault =/= RiscvTranslationFault.None
    instruction_fault <== fill.failure()

  when invalidate:
    data_fault_valid <== Bool(#false)
  elsewhen (walker.completion.valid & walk_live & walk_data):
    data_fault_valid <== walker.completion.bits.fault =/= RiscvTranslationFault.None
    data_fault <== fill.failure()


  walker.memory <=> pte


/* Configures the RV64 resolver and its page-walk client. */
class SuperscalarSv39Specialization(config :: RiscvHartCHIConfig, svnapot :: Boolean = #false, hypervisor :: Boolean = #true):
  implements SuperscalarTranslationSpecialization

  /* Builds the configured TLB/walker implementation without changing its query timing. */
  override method circuit() :: CircuitDefinition:
    SuperscalarSv39Translation(config, ~svnapot: svnapot, ~hypervisor: hypervisor)

  /* Sv39 resolution and its architectural adapter interfaces are always RV64. */
  override method architectural_xlen() :: XLen:
    XLen.X64

  /* Supplies the same physical attributes used by vector proofs and prefetch qualification. */
  override method physical_map() :: RiscvPhysicalMemoryMap:
    config.physical_map

  /* The shared walker contributes one physical PTE client after core and split clients. */
  override method page_walk_clients() :: matching(1): 1

export:
  SuperscalarSv39Translation
  SuperscalarSv39Specialization
