#lang rhodium
/* Shares fixed-cycle cache access, split execution, and physical ownership across identity and Sv39 translation. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/common/mmu/context.rhdl").RiscvTranslationState
  "../bundles.rhdl" open
  "translation.rhdl" open
  "translation-specialization.rhm" open
  "transport.rhdl" open
  "../../common/cache/access.rhdl" open
  "../../common/cache/protocol.rhdl" open
  "../../common/cache/operation.rhdl" open
  "../../common/cache-prefetch.rhdl" open
  "../../common/load-store.rhdl" open
  "../../common/misaligned-access.rhdl" open
  "../../common/cosim-source.rhm".describe_cosim_signals
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/rtl/trap.rhdl").ExceptionCause
  lib("riscv/rtl/hypervisor.rhdl") open
  lib("riscv/rtl/pointer-masking.rhdl").apply_pointer_mask
  lib("riscv/rtl/svpbmt.rhdl") open
  lib("cores/common/mmu/translation.rhdl").RiscvTranslationFault
  lib("cores/common/mmu/vector.rhdl") open
  lib("flow/main.rhdl") open
  lib("rhodium/std/bits.rhdl") open

/* Counts core and split clients plus the translation specialization's page-walk client. */
fun physical_client_count(translation :: SuperscalarTranslationSpecialization) :: PosInt:
  2 + translation.page_walk_clients()

/* Preserves one EX/MEM context stage and WB-only mutation with an unbuffered translation service.
   The specialization supplies the architectural width, physical map, and page-walk client count.
   Accepted owners survive invalidation. */
sync_circuit SuperscalarMemoryAdapter(translation :: SuperscalarTranslationSpecialization, ~context: Context :: DataType = Bool):
  def xlen = translation.architectural_xlen()
  input state: RiscvTranslationState(xlen)
  input invalidate: Bool
  input split_guest_access: RiscvGuestMemoryAccess
  input(pipeline_vector, request_vector): Bool
  interface vector_precheck(VectorPrecheck(), ~role: responder)
  interface vector_fast(VectorFastCheck(xlen), ~role: responder)
  interface prefetch(Valid(CachePrefetchReq(64)), ~role: consumer)
  interface physical_prefetch(Valid(CachePrefetchReq(64)), ~role: producer)
  interface instruction(SuperscalarInstructionTranslation(xlen), ~role: responder)
  interface pipeline(SuperscalarPipelineAccess(xlen), ~role: responder)
  interface memory(SuperscalarMemory(xlen, Context), ~role: responder)
  interface split(RiscvSplitAccess(xlen, Bool), ~role: responder)
  interface pipeline_lookup(Valid(CachePipelineReq(xlen)), ~role: producer)
  interface physical_pipeline(CachePipelineAccess(xlen), ~role: requester)
  interface physical_memory(SuperscalarPhysicalMemory(xlen, SuperscalarTransportContext(Context, physical_client_count(translation))), ~role: requester)

  def bytes = xlen.width / 8
  def physical_map = translation.physical_map()
  def page_walk_clients = translation.page_walk_clients()
  inst resolve(translation.circuit())
  resolve.state <== state
  resolve.invalidate <== invalidate
  resolve.pipeline_vector <== pipeline_vector
  resolve.request_vector <== request_vector
  vector_precheck <=> resolve.vector_precheck
  vector_fast <=> resolve.vector_fast
  instruction <=> resolve.instruction
  prefetch |> resolve.prefetch
  resolve.physical_prefetch |> physical_prefetch


  /* Split ownership retains its architectural access class through fragment completion. */

  inst misaligned(RiscvMisalignedEngine(xlen, Bool))
  split.request |> misaligned.start
  reg split_mode(RiscvGuestMemoryAccess)
  when (split.request.fire()):
    split_mode <== split_guest_access

  def resolved :: SuperscalarAddressResolution() = resolve.result
  def split_fault_address = apply_pointer_mask(xlen, misaligned.fault_address, resolved.split_mask)
  misaligned.completion |> map_valid(result => result.updated(~fault_address: apply_pointer_mask(xlen, result.fault_address, resolved.split_mask))) |> split.response
  def split_request = misaligned.request


  /* EX indexes immediately; exactly one context register carries that token into MEM. */

  /* Shapes an aligned native-word cache access without changing architectural size or store positioning. */
  fun cache_request(request :: PhysicalMemoryReq(xlen, Bool), address :: Bits(xlen.width)) :~ CachePipelineReq(xlen):
    CachePipelineReq(xlen):
      address: address.align_down(bytes)
      byte_mask: request.byte_mask
      access: request.access
      width: if xlen == XLen.X32 | MemoryWidth.Word | MemoryWidth.Double
      unsigned: Bool(#true)
      data: request.data

  def Array(index, context) = pipeline.request |> fork_valid(2)
  index |> map_valid(request => cache_request(request.memory, request.memory.address)) |> pipeline_lookup
  def mem_request = context |> valid_pipe(1)
  def mem :: PhysicalMemoryReq(xlen, Bool) = mem_request.bits.memory
  def committed :: PhysicalMemoryReq(xlen, Context) = memory.request.bits.memory
  def data_request :: PhysicalMemoryReq(xlen, Bool) = priority_mux(~default: mem):
    split_request.valid: split_request.bits
    memory.request.valid: committed.with_address_context(committed.address, Bool(#false))
  def guest_access = priority_mux(~default: mem_request.bits.translation):
    split_request.valid: split_mode
    memory.request.valid: memory.request.bits.translation

  resolve.query <== SuperscalarTranslationQuery(xlen):
    address: mux(split_request.valid, split_fault_address, data_request.address)
    mem_address: mem.address
    wb_address: committed.address
    access: data_request.access
    guest_access: guest_access
    split_access: split_mode
    mem_valid: mem_request.valid
    wb_valid: memory.request.valid
    demand: split_request.valid ||| (memory.request.valid & !misaligned.busy)
    split: split_request.valid
    busy: misaligned.busy


  /* MEM combines translation permission with physical attributes; a conflicting demand replays.
     No speculative access allocates a response owner or changes architectural memory. */

  def data_ok = resolved.known & (resolved.fault === RiscvTranslationFault.None)
  def region = cache_access_region(XLen.X64, physical_map, resolved.address, data_request.width, data_request.access)
  def attributes = resolve_memory_attributes(region, resolved.pbmt)
  def cacheable = allows_data_cache_allocation(attributes)
  def atomic_request = mem.access.is_one_of(CacheOperation.LoadReserved, CacheOperation.StoreConditional, CacheOperation.Atomic)
  def cache_block = mem.access.is_cache_block()
  def mem_misaligned = mem.access.requires_split(mem.width, mem.address)
  def writes = mem.access.store_fault_class()
  def atomic_service = cacheable & region.readable
  def permitted = (!resolved.execute_read ||| region.executable) & cache_access_permitted(region, mem.access, ~reads: !writes, ~writes: writes, ~atomic_service: atomic_service)
  def busy = misaligned.busy ||| memory.request.valid ||| resolved.probe_busy
  def decision = classify_cache_lookup(
    ~blocked: busy, ~split: mem_misaligned, ~known: resolved.known,
    ~page_fault: resolved.guest.page_fault ||| (resolved.fault === RiscvTranslationFault.PageFault),
    ~access_fault: resolved.fault === RiscvTranslationFault.AccessFault,
    ~permitted: permitted, ~can_probe: cacheable & !atomic_request & !cache_block
  )
  def speculative_ok = decision.is(CacheLookupDecision.Probe) & !physical_memory.ordered_busy
  mem_request |> filter_valid(_request => speculative_ok) |> map_valid(request => cache_request(request.memory, resolved.address[0..xlen.width])) |> physical_pipeline.request
  def cache_outcome = cache_lookup_outcome(decision, physical_pipeline.response.valid, physical_pipeline.response.bits.outcome)
  pipeline.response.valid <== mem_request.valid
  pipeline.response.bits <== SuperscalarLookupResult(xlen):
    guest: resolved.guest.updated(~page_fault: resolved.guest.page_fault & (cache_outcome === CachePipelineOutcome.PageFault))
    outcome: cache_outcome
    data: physical_pipeline.response.bits.data

  physical_pipeline.commit <== pipeline.commit & !misaligned.busy
  pipeline.commit_ready <== physical_pipeline.commit_ready & !misaligned.busy


  /* WB and split physical admission share an unflushed transport; a walker is an elaboration-time third client. */

  inst transport(SuperscalarMemoryTransport(xlen, physical_client_count(translation), Context))
  transport.physical <=> physical_memory
  (memory.request |> gate_flow(data_ok & !misaligned.busy & (!resolved.execute_read ||| region.executable)) |> map_flow(request):
    def native :: PhysicalMemoryReq(xlen, Context) = request.memory
    PhysicalDataReq(xlen, Context, 64):
      memory: native.with_address_context(resolved.address, native.context)
      pbmt: resolved.pbmt
  ) |> transport.request[0]
  transport.response[0] |> memory.response

  def fragment_address = resolved.address.align_down(bytes)
  def fragment_permitted = cache_fragment_permitted(
    physical_map, fragment_address, bytes, resolved.pbmt,
    ~write: data_request.access.store_fault_class(), ~execute_read: resolved.execute_read
  )
  (split_request |> gate_flow(data_ok & fragment_permitted) |> map_flow(fragment):
    def native :: PhysicalMemoryReq(xlen, Bool) = fragment
    PhysicalDataReq(xlen, Context, 64):
      memory: native.with_address_context(fragment_address, dont_care(Context))
      pbmt: resolved.pbmt
  ) |> transport.request[1]
  (transport.response[1] |> map_flow(reply => PhysicalMemoryResp(xlen, Bool)):
    data: reply.data
    context: Bool(#false)
    access_fault: Bool(#false)
  ) |> misaligned.physical_response

  def core_execute_denied = resolved.execute_read & !region.executable
  def core_local_fault = resolved.known & (!data_ok ||| core_execute_denied)
  memory.fault.valid <== memory.request.valid & !misaligned.busy & (core_local_fault ||| transport.fault[0].valid)
  def core_fault_cause = priority_mux(~default: transport.fault[0].bits.cause):
    !data_ok: resolved.cause
    core_execute_denied: ExceptionCause.LoadAccessFault

  memory.fault.bits <== SuperscalarResolution(xlen):
    guest: resolved.guest.details
    disposition: SuperscalarDisposition.Fault
    cause: core_fault_cause
    value: committed.address

  misaligned.request_guest <== resolved.guest

  misaligned.request_fault <== split_request.valid & resolved.known & resolved.fault.is_one_of(RiscvTranslationFault.PageFault, RiscvTranslationFault.GuestPageFault)
  def split_access_denied = (resolved.fault =/= RiscvTranslationFault.None) ||| !fragment_permitted ||| transport.fault[1].valid
  misaligned.request_access_fault <== split_request.valid & resolved.known & !misaligned.request_fault & !misaligned.request_guest.page_fault & split_access_denied

  if page_walk_clients == 1
  | block:
      def pte_permitted = pte_read_permitted(physical_map, resolve.pte.request.bits.address, resolve.pte.request.bits.pbmt)
      transport.request[2].valid <== resolve.pte.request.valid & pte_permitted
      transport.request[2].bits <== pte_read_request(xlen, resolve.pte.request.bits.address, resolve.pte.request.bits.pbmt, dont_care(Context))

      def pte_fault = (resolve.pte.request.valid & !pte_permitted) ||| transport.fault[2].valid
      resolve.pte.request.ready <== transport.request[2].ready ||| pte_fault
      resolve.pte.request_access_fault <== pte_fault
      transport.response[2] |> map_flow(reply => reply.data) |> to_valid() |> resolve.pte.response
  | #void

  memory.drained <== transport.drained & !misaligned.busy
  memory.ordered_busy <== physical_memory.ordered_busy
  memory.reservation_valid <== physical_memory.reservation_valid


  /* Keep the existing passive MMU observation contract at the selected adapter instance. */

  describe_cosim_signals({
    "pipeline_valid": physical_pipeline.request.valid,
    "pipeline_address": resolved.address,
    "request_valid": transport.request[0].fire(),
    "request_address": transport.request[0].bits.memory.address,
    "fragment_valid": transport.request[1].fire(),
    "fragment_address": fragment_address,
    "fragment_virtual": split_fault_address,
    "fragment_mask": split_request.bits.byte_mask,
    "fragment_data": split_request.bits.data,
    "fragment_response": transport.response[1].fire(),
    "fragment_response_data": transport.response[1].bits.data
  })

export:
  SuperscalarMemoryAdapter
