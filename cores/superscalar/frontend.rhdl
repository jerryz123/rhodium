#lang rhodium
/* Fetches eight-byte blocks into configurable instruction groups with S1 targets and fresh-S2 correction. */
// SPDX-License-Identifier: Apache-2.0

import:
  "bundles.rhdl" open
  "profile.rhm".SuperscalarPipelineConfig
  "instruction-assembler.rhdl" open
  "direction.rhdl" open
  "../cache/l1i/protocol.rhdl" open
  "../chi-hart.rhdl" open
  lib("cores/bpred/btb.rhdl").Btb
  lib("cores/bpred/btb.rhdl").DisabledBtb
  lib("cores/bpred/tournament.rhdl") open
  lib("cores/bpred/ras.rhdl").Ras
  lib("cores/bpred/ras.rhdl").DisabledRas
  lib("cores/bpred/protocol.rhdl") open
  lib("cores/pc.rhdl") open
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/rtl/svpbmt.rhdl") open
  lib("riscv/rtl/trap.rhdl").ExceptionCause
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

/* Retains a requested PC and the original prediction for a trailing-instruction continuation. */
bundle SuperscalarFetchCursor(xlen :: XLen):
  pc: Bits(xlen.width)
  prediction: BranchPrediction(xlen, compact_pc_width(xlen))
  continuation: Bool
  row: Bits(10)
  hashed: Bool
  base_taken: Vec(4, Bool)

/* Retains predictor ownership and permission outcomes through the cache-result stage. */
bundle SuperscalarFetchAttempt(xlen :: XLen, hypervisor :: Boolean):
  cursor: SuperscalarFetchCursor(xlen)
  replay: Bool
  fault: SuperscalarFetchBlockFault(xlen, hypervisor)

/* Issues one eight-byte block per cycle on hits and emits up to group_width instructions.
   Reserves returned-block storage before each lookup.
   Replay kills younger attempts but not older packets. Faults stop fetch until WB recovery.
   Invalidation stops old attempts until a restart; simultaneous redirect supplies the new PC.
   Physical PMA checks precede cache resolution; no rejected address reaches CHI. */
sync_circuit SuperscalarFrontend(config :: RiscvHartCHIConfig, profile :: SuperscalarPipelineConfig = SuperscalarPipelineConfig(), ~group_width: group_width :: matching(2) || matching(3) = 2):
  def xlen = profile.xlen
  def hypervisor = profile.hypervisor
  def pc_width = compact_pc_width(xlen)
  config.check_compact_fetch(xlen)
  interface start(Valid(Bits(64)), ~role: consumer)
  interface redirect(Valid(SuperscalarRedirect(xlen)), ~role: consumer)
  interface flush(Pulse(), ~role: consumer)
  interface memory(SuperscalarInstructionLookup(), ~role: requester)
  interface invalidate(Pulse(), ~role: consumer)
  interface virtual_lookup(Decoupled(Bits(64)), ~role: producer)
  interface translation(SuperscalarInstructionTranslation(xlen), ~role: requester)
  interface instructions(Decoupled(SuperscalarPacket(xlen, hypervisor, group_width)), ~role: producer)
  interface branch_update(Valid(BranchUpdate(xlen)), ~role: consumer)
  interface predictor_restore(Pulse(), ~role: consumer)
  interface predictor_clear(Pulse(), ~role: consumer)
  interface direction_update(Valid(TournamentUpdate(10)), ~role: consumer)
  interface ras_resolution(Valid(RasResolution(xlen)), ~role: consumer)
  interface history_commit(Valid(SuperscalarHistoryCommit(group_width)), ~role: consumer)
  interface history_restore(Valid(Bits(10)), ~role: consumer)

  when (redirect.valid):
    assert(CompactPc.fits(xlen, redirect.bits.target), "superscalar_redirect_pc_admitted")

  when (start.valid):
    assert(CompactPc.fits(xlen, start.bits[0..xlen.width]), "superscalar_start_pc_admitted")


  /* Fetch ownership and fixed-cycle context.
     Each S1/S2 context reserves one eventual block in the assembler. */

  // Covers successful Sv39 and Bare PCs; only speculative destinations may alias.
  reg active(~init: Bool(#false))
  reg cursor(~init: literal(SuperscalarFetchCursor(xlen), 0))
  inst btb(if profile.btb_entries == 0 | DisabledBtb(xlen, ~fetch_bytes: 8, ~external_direction: profile.bht) | Btb(xlen, profile.btb_entries, ~fetch_bytes: 8, ~external_direction: profile.bht, ~pc_width: pc_width, ~target_width: pc_width))
  inst ras(if profile.ras_entries == 0 | DisabledRas(xlen) | Ras(xlen, profile.ras_entries, ~target_width: pc_width))
  inst bht(if profile.bht | TournamentBht() | DisabledTournamentBht())
  inst direction(if profile.bht | SuperscalarDirection(profile) | DisabledSuperscalarDirection(profile))
  reg speculative_history(~init: Bits(10)(0))
  reg committed_history(~init: Bits(10)(0))
  wire direction_repair: Bool
  inst s1(ValidPipeAlwaysCapture(SuperscalarFetchCursor(xlen), 1, ~flushable: #true))
  inst s2(ValidPipeAlwaysCapture(SuperscalarFetchAttempt(xlen, hypervisor), 1, ~flushable: #true))
  // Sign-extended Sv39 and zero-extended physical/Bare PCs fit this width.
  // Faulting blocks retain the original upper bits in their tagged payload.
  inst assembler(SuperscalarInstructionAssembler(profile, ~group_width: group_width))


  /* Predictor control and S1 target selection.
     Continuations retain the original prediction; ordinary lookups may use the RAS. */

  def command = start.valid ||| redirect.valid ||| flush.valid ||| invalidate.valid
  def repair = assembler.repair.valid ||| direction_repair
  def restore = command ||| predictor_restore.valid
  btb.cursor <== s1.egress.bits.pc
  if profile.bht
  | btb.conditional_taken <== mux(s1.egress.bits.hashed, s1.egress.bits.base_taken, bht.base_taken)
  | #void

  def clear_prediction_context = start.valid ||| invalidate.valid ||| predictor_clear.valid
  btb.invalidate_all.valid <== clear_prediction_context
  ras.clear.valid <== clear_prediction_context
  direction_update |> bht.update
  ras.restore.valid <== restore
  branch_update |> btb.update
  ras_resolution |> ras.resolve
  assembler.discover |> btb.discover
  assembler.speculate |> ras.speculate
  assembler.ras_head_valid <== ras.head_valid & !restore
  assembler.ras_head <== ras.head
  assembler.pause <== predictor_restore.valid
  def use_ras_target = btb.prediction.ras_action.is_one_of(RasAction.Pop, RasAction.PopPush) & ras.head_valid & !restore
  def ordinary_target = mux(use_ras_target, ras.head, btb.prediction.target)
  def ordinary_prediction = BranchPrediction(xlen, pc_width):
    valid: btb.prediction.valid
    pc: btb.prediction.pc[0..pc_width]
    target: ordinary_target[0..pc_width]
    compressed: btb.prediction.compressed
    ras_action: btb.prediction.ras_action

  def prediction :: BranchPrediction(xlen, pc_width) = mux(s1.egress.bits.continuation, s1.egress.bits.prediction, ordinary_prediction)
  when (s1.egress.valid & !s1.egress.bits.continuation & btb.prediction.valid):
    assert(CompactPc.fits(xlen, btb.prediction.pc), "superscalar_cursor_prediction_pc_fits")
    assert(CompactPc.fits(xlen, ordinary_target), "superscalar_cursor_prediction_target_fits")


  /* S2 outcome classification and direction correction.
     Replay retains the current attempt for retry; fault stops further fetch. */

  def result :: SuperscalarFetchAttempt(xlen, hypervisor) = s2.egress.bits
  def s2_prediction :: BranchPrediction(xlen, pc_width) = result.cursor.prediction
  def result_fault = result.fault.valid ||| (memory.response.valid & memory.response.bits.access_fault)
  def replay = s2.egress.valid & !result.fault.valid & (result.replay ||| (memory.response.valid & memory.response.bits.replay)) & !command
  def fault = s2.egress.valid & !replay & result_fault & !command
  def stop = replay ||| fault
  def kill_younger = command ||| repair ||| stop
  def continue_fetch = active & !command & !stop
  def reserved = s1.egress.valid.as_bits().zext(2) + s2.egress.valid.as_bits().zext(2)
  assert(reserved <= assembler.available, "superscalar_fetch_reservations")
  assembler.clear.valid <== command
  assembler.instructions |> instructions
  direction.valid <== s2.egress.valid & !command & !replay
  direction.clear <== command ||| assembler.repair.valid
  direction.pc <== s2.egress.bits.cursor.pc
  direction.data <== memory.response.bits.data
  direction.fault <== result_fault
  direction.prediction <== s2_prediction
  direction.row <== s2.egress.bits.cursor.row
  direction.history <== speculative_history
  direction.base_taken <== s2.egress.bits.cursor.base_taken
  direction.gshare_taken <== bht.gshare_taken
  direction.use_gshare <== bht.use_gshare
  direction.prefix_gshare_taken <== bht.prefix_gshare_taken
  direction.prefix_use_gshare <== bht.prefix_use_gshare
  bht.base_row <== s1.egress.bits.pc[3..13]
  bht.gshare_row <== direction.row
  bht.choice_row <== direction.pc[3..13]
  bht.prefix_gshare_row <== direction.prefix_row
  bht.prefix_choice_row <== direction.prefix_choice_row
  btb.invalidate.valid <== mux(assembler.repair.valid, assembler.repair.bits.invalidate, direction.valid & direction.invalidate & Bool(profile.bht))
  btb.invalidate.bits <== mux(assembler.repair.valid, assembler.repair.bits.entry, s2_prediction.address())
  def s2_straddle = s2_prediction.valid & (s2_prediction.address()[0..3] === Bits(3)(6)) & !s2_prediction.compressed & !s2.egress.bits.cursor.continuation
  def provisional_successor = mux(s2.egress.bits.cursor.continuation ||| (s2_prediction.valid & !s2_straddle), s2_prediction.destination(), s2.egress.bits.cursor.pc.align_down(8) + Bits(xlen.width)(8))
  def direction_updates_history = Bool(profile.bht) & direction.valid & !result_fault
  direction_repair <== direction_updates_history & (direction.next_pc =/= provisional_successor)


  /* History recovery.
     Commit folds lanes in program order; speculative history follows recovery priority. */

  def mutable committed_next = committed_history
  for (lane in 0..group_width):
    def history :: Bits(10) = committed_next
    committed_next := mux(history_commit.valid & history_commit.bits.enable[lane], history[0..9] ++ history_commit.bits.taken[lane].as_bits(), history)

  def s1_history = mux(direction_updates_history, direction.history_after, speculative_history)
  when clear_prediction_context:
    speculative_history <== Bits(10)(0)
    committed_history <== Bits(10)(0)
  otherwise:
    committed_history <== committed_next
    when (history_restore.valid):
      speculative_history <== history_restore.bits
    elsewhen command:
      speculative_history <== committed_next
    elsewhen (assembler.repair.valid):
      speculative_history <== assembler.repair.bits.history
    elsewhen direction_updates_history:
      speculative_history <== direction.history_after


  /* S0 cursor selection and credited lookup admission.
     S1 prediction feeds S0 directly. Recovery cancels younger reservations,
     but direction correction still reserves the retained S2 response. */

  def straddle = prediction.valid & (prediction.address()[0..3] === Bits(3)(6)) & !prediction.compressed & !s1.egress.bits.continuation
  def next_cursor = SuperscalarFetchCursor(xlen):
    pc: mux(s1.egress.bits.continuation ||| (prediction.valid & !straddle), prediction.destination(), s1.egress.bits.pc.align_down(8) + Bits(xlen.width)(8))
    prediction: prediction
    continuation: straddle
    row: Bits(10)(0)
    hashed: Bool(#false)
    base_taken: literal(Vec(4, Bool), 0)

  def restart = start.valid ||| redirect.valid
  def replace = restart ||| (!command & (repair ||| replay))
  def selected :: SuperscalarFetchCursor(xlen) = priority_mux(~default: cursor):
    start.valid: cursor.updated(~pc: start.bits[0..xlen.width], ~continuation: Bool(#false), ~hashed: Bool(#false))
    redirect.valid: cursor.updated(~pc: redirect.bits.target, ~continuation: Bool(#false), ~hashed: Bool(#false))
    assembler.repair.valid: cursor.updated(~pc: assembler.repair.bits.target, ~continuation: Bool(#false), ~hashed: Bool(#false))
    direction_repair: cursor.updated(~pc: direction.next_pc, ~continuation: Bool(#false), ~hashed: Bool(#false))
    replay: s2.egress.bits.cursor
    s1.egress.valid: next_cursor

  def retained_response_credit = (s2.egress.valid & !replay).as_bits().zext(2)
  def replacement_room = restart ||| assembler.repair.valid ||| (assembler.available > retained_response_credit)
  def sequential_room = assembler.available > reserved
  wire attempt_ready: Bool
  def attempt = inject_interface(
    Decoupled(SuperscalarFetchCursor(xlen)),
    ~valid: (replace & replacement_room) ||| (continue_fetch & sequential_room),
    ~bits: selected,
    ~ready: attempt_ready
  )

  def requested = attempt |> trace_event("frontend/s0.request", ~fields: address):
    pc: address.pc

  def Array(array_index, context) = requested |> atomic_fork(2)
  (array_index |> map_flow(address):
    def physical = address.pc.zext(64)
    physical.align_down(8)
  ) |> virtual_lookup

  context |> to_valid() |> s1.ingress
  when (start.valid):
    active <== Bool(#true)
  elsewhen (redirect.valid):
    active <== Bool(#true)
  elsewhen (flush.valid ||| invalidate.valid):
    active <== Bool(#false)
  elsewhen repair:
    active <== Bool(#true)
  elsewhen fault:
    active <== Bool(#false)

  when (attempt.fire()):
    cursor <== selected.updated(~pc: selected.pc.align_down(8) + Bits(xlen.width)(8), ~continuation: Bool(#false), ~hashed: Bool(#false))
  elsewhen (replace ||| (continue_fetch & s1.egress.valid)):
    cursor <== selected


  /* S1 translation and physical permission resolution.
     Array outputs arrive alongside translation. A bad instruction PC becomes
     a fault token, never an aliased aligned fetch. */

  def s1_base = translation.address.align_down(8)
  def physical = config.physical_map.lookup(s1_base, s1_base +& Bits(64)(7))
  def attributes = resolve_memory_attributes(physical, translation.pbmt)
  // Guest-Bare translation can map a high GPA into low physical memory.
  // Check the original architectural PC as well as the physical permissions.
  def pc_fits = CompactPc.fits(xlen, s1.egress.bits.pc)
  def permitted = physical.mapped & physical.executable & pc_fits
  def misaligned = !s1.egress.bits.pc.is_aligned(2)
  s1.egress |> filter_valid(cursor => !kill_younger & cursor.pc.is_aligned(2)) |> map_valid(cursor => cursor.pc) |> translation.request
  def translation_replay = translation.resolution.disposition === SuperscalarDisposition.Replay
  def translation_fault = translation.resolution.disposition === SuperscalarDisposition.Fault
  def denied = misaligned ||| (!translation_replay & (translation_fault ||| !permitted))
  def fault_cause :: ExceptionCause = priority_mux(~default: ExceptionCause.InstructionAccessFault):
    misaligned: ExceptionCause.InstructionAddressMisaligned
    translation_fault: translation.resolution.cause

  def looked_up = s1.egress |> filter_valid(_pc => !kill_younger) |> trace_valid_event("frontend/s1.lookup", ~fields: address):
    pc: address.pc
    predicted: prediction.valid
    target: prediction.destination()
    replay: translation_replay
    fault: denied

  def Array(resolutions, contexts) = looked_up |> fork_valid(2)
  (resolutions |> filter_valid(_pc => !denied & !translation_replay) |> map_valid(_address => SuperscalarPhysicalInstructionReq()):
    address: s1_base
    cacheable: attributes.instruction_cacheable
    device: attributes.strongly_ordered
  ) |> memory.request

  (contexts |> map_valid(address):
    wire attempt: SuperscalarFetchAttempt(xlen, hypervisor)
    attempt.cursor <== address.updated(~prediction: prediction, ~row: mux(address.hashed, address.row, address.pc[3..13] ^ s1_history), ~hashed: Bool(#true), ~base_taken: mux(address.hashed, address.base_taken, bht.base_taken))
    attempt.replay <== translation_replay & !misaligned
    attempt.fault.valid <== denied
    attempt.fault.cause <== fault_cause
    attempt.fault.value <== address.pc
    if hypervisor
    | attempt.fault.guest <== translation.resolution.guest
    | #void

    when (contexts.valid):
      assert(attempt.fault.supported(), "superscalar_translation_fetch_fault")

    attempt
  ) |> s2.ingress

  s1.flush <== kill_younger & !attempt.fire()
  s2.flush <== kill_younger
  // Local repair/replay cancel younger lookup contexts, not accepted refills or
  // the current S2 response. Only architectural commands detach cache ownership.
  memory.flush <== command
  memory.invalidate_all <== invalidate.valid
  memory.s1_kill <== kill_younger


  /* S2 publication into reserved block storage.
     Assembly owns parcels, expansion, and continuation-page faults;
     no cache result waits for instruction issue. */

  def outcome = s2.egress |> filter_valid(_attempt => !command & !replay) |> trace_valid_event("frontend/s2.outcome", ~fields: attempt):
    pc: attempt.cursor.pc
    fault: result_fault
    direction_corrected: direction_repair

  (outcome |> map_valid(payload):
    def attempt :: SuperscalarFetchAttempt(xlen, hypervisor) = payload
    wire fetch_fault: SuperscalarFetchBlockFault(xlen, hypervisor)
    fetch_fault.valid <== result_fault
    fetch_fault.cause <== mux(attempt.fault.valid, attempt.fault.cause, ExceptionCause.InstructionAccessFault)
    fetch_fault.value <== mux(attempt.fault.valid, attempt.fault.value, attempt.cursor.pc)
    if hypervisor
    | fetch_fault.guest <== attempt.fault.guest
    | #void

    def offered_prediction :: BranchPrediction(xlen, pc_width) = mux(Bool(profile.bht), direction.corrected, attempt.cursor.prediction)
    fetch_block(xlen, hypervisor,
                attempt.cursor.pc, memory.response.bits.data, fetch_fault,
                offered_prediction.valid, offered_prediction.address(), offered_prediction.destination(), offered_prediction.compressed, offered_prediction.ras_action,
                mux(Bool(profile.bht), direction.directions, literal(Vec(4, TournamentPrediction(10)), 0)),
                mux(Bool(profile.bht), direction.prefix_direction, literal(TournamentPrediction(10), 0)), outcome.valid)
  ) |> to_decoupled() |> assembler.blocks

  when (s2.egress.valid & !result.fault.valid & !result.replay & !command):
    assert(memory.response.valid, "superscalar_fetch_has_outcome")

  when (assembler.blocks.valid):
    assert(assembler.blocks.ready, "superscalar_fetch_reserved_response")

export:
  SuperscalarFrontend
