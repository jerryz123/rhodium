#lang rhodium
/* Defines shared issue contracts, dependency predicates, and service ownership. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/common/instruction-hint.rhdl").InstructionHint
  lib("rhodium/core/ir.rhm").Module
  lib("rhodium/frontend/foundation.rhm").CircuitDefinition
  lib("rhodium/frontend/foundation.rhm").circuit_signature
  lib("rhodium/core/signature.rhm").signature_equal
  lib("rhodium/core/types.rhm").VectorType
  "bundles.rhdl".SuperscalarPcOffsetBits
  "read-operands.rhdl" open
  "pairing.rhdl" open
  "decode/core-ctrl.rhdl".SuperscalarControl
  "decode/system-ctrl.rhdl" open
  "decode/long-ctrl.rhdl".SuperscalarLongOperation
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/rtl/csr.rhdl") open
  lib("cores/common/csr/protocol.rhdl").RiscvCsrAction
  lib("cores/common/csr/protocol.rhdl").csr_pure_read
  lib("cores/common/cache/operation.rhdl").CacheOperation
  lib("cores/common/fp/types.rhdl") open
  lib("cores/common/vector/decode.rhdl").VectorOperandMode

/* Carries decoded candidates, not granted instructions; presence must not depend on readiness. */
bundle SuperscalarIssueCandidate(xlen :: XLen):
  present: Bool
  decodable: Bool
  fetch_fault: Bool
  instruction: Bits(32)
  pc: Bits(xlen.width)
  control: SuperscalarControl()
  rs1: Bits(5)
  rs2: Bits(5)
  rd: Bits(5)
  ras: Bool
  late_gpr: Bool

/* Summarizes external scoreboard/service probes without making any admission decision. */
bundle SuperscalarIssueStatus():
  execution_blocked: Bool
  destination_blocked: Bool
  fp_data_blocked: Bool
  fp_capacity_blocked: Bool
  vector_blocked: Bool
  csr_read_wait: Bool

/* Registered resource views and flush/drain state; never feed current bookings back into these probes. */
bundle SuperscalarIssueResources():
  stop: Bool
  retry_wait: Bool
  pause_blocked: Bool
  serialization_ready: Bool
  memory_order_ready: Bool
  multiply_available: Bool
  fixed_returns_collide: Bool
  training_pending: Bits(4)
  last_slot_reserved: Bool
  vector_waiting: Bool

/* Names unqualified service probe owners without depending on their readiness. */
bundle SuperscalarServiceOwners():
  scalar: Bits(2)
  fp: Bits(2)

/* Returns the oldest claimant; an empty selection names lane zero but never grants validity. */
fun superscalar_service_lane(claims :: List.of(Bool)) :~ Bits(2):
  priority_mux((for List (claim in claims, lane in 0..claims.length()): [claim, Bits(2)(lane)]), ~default: Bits(2)(0))

/* Selects service probes independently of readiness; the admitted prefix later qualifies launches. */
fun superscalar_service_owners(xlen :: XLen, group_width :: matching(2) || matching(3), candidates :: Vec(group_width, SuperscalarIssueCandidate(xlen)), traits :: Vec(group_width, SuperscalarIssueTraits())) :~ SuperscalarServiceOwners():
  SuperscalarServiceOwners():
    scalar: superscalar_service_lane(for List (lane in 0..group_width): candidates[lane].present & traits[lane].scalar_service)
    fp: superscalar_service_lane(for List (lane in 0..group_width): candidates[lane].present & traits[lane].fpr_reads)

/* Reports issue grants separately from the unqualified service-probe owners. */
bundle SuperscalarIssueDecision(group_width :: matching(2) || matching(3)):
  owners: SuperscalarServiceOwners()
  count: Bits(2)
  admitted: Vec(group_width, Bool)
  data_hazard: Vec(group_width, Bool)
  structural_hazard: Vec(group_width, Bool)

/* Classifies WB commands that require an empty pipeline rather than ordinary CSR-read ordering. */
fun superscalar_serializing_operation(system :: SuperscalarSystemControl(), instruction :: Bits(32)) :: Bool:
  def csr_read = csr_pure_read(system.csr, instruction[15..20])
  system.uses_command() & !csr_read & (system.action =/= RiscvCsrAction.VectorConfig)


/* Classifies each decoded instruction once for dependency and shared-service checks. */
bundle SuperscalarIssueTraits():
  deferred: Bool
  writes: Bool
  multiply: Bool
  vector: Bool
  scalar_service: Bool
  vector_config: Bool
  vector_frs1: Bool
  fpr_reads: Bool
  fpr_writes: Bool
  system: Bool
  csr: Bool
  branch: Bool

/* Extracts common decoded properties without choosing any instruction's admission. */
fun superscalar_issue_traits(xlen :: XLen, candidate :: SuperscalarIssueCandidate(xlen)) :~ SuperscalarIssueTraits():
  def control = candidate.control
  def vector = control.vector.integer ||| control.vector.memory ||| control.vector.floating_point ||| control.vector.multiply_divide
  def long = control.muldiv.service =/= SuperscalarLongOperation.None
  def variable_fp = control.fp.valid & (control.fp.bits.execution.unit === FloatUnit.DivideSquareRoot)
  def deferred = control.memory.access.is_memory() ||| long ||| candidate.late_gpr ||| vector
  def writes = candidate.decodable & control.writeback.enable & candidate.rd.any()
  def vector_frs1 = vector & control.vector.floating_point & (control.vector.operand === VectorOperandMode.FloatingScalar)
  SuperscalarIssueTraits():
    deferred: deferred
    writes: writes
    multiply: writes & (control.muldiv.service === SuperscalarLongOperation.Multiply)
    vector: vector
    scalar_service: control.memory.access.is_memory() ||| long ||| variable_fp
    vector_config: control.system.action === RiscvCsrAction.VectorConfig
    vector_frs1: vector_frs1
    fpr_reads: control.fp.valid ||| vector_frs1
    fpr_writes: (control.fp.valid & (control.fp.bits.registers.destination === FloatDestination.FloatingPoint)) ||| (vector & control.vector.floating_point & control.vector.floating_scalar_destination)
    system: candidate.decodable & superscalar_serializing_operation(control.system, candidate.instruction)
    csr: candidate.decodable & (control.system.csr =/= RiscvCsrOperation.None)
    branch: candidate.decodable & control.branch.resolver.enable

/* Separates data and structural blockers for the named policy and its trace outputs. */
bundle SuperscalarIssueHazards():
  data: Bool
  structural: Bool

/* Detects an unforwarded GPR dependence on one older group member. */
fun superscalar_issue_raw(xlen :: XLen, older :: SuperscalarIssueCandidate(xlen), younger :: SuperscalarIssueCandidate(xlen), older_traits :: SuperscalarIssueTraits(), forwarded :: Vec(2, Bool)) :: Bool:
  older_traits.writes & ((younger.control.operand.uses_rs1 & !forwarded[0] & (older.rd === younger.rs1)) ||| (younger.control.operand.uses_rs2 & !forwarded[1] & (older.rd === younger.rs2)))

/* Holds one operand's physical route and whether an older move can copy its RR snapshot. */
bundle SuperscalarIssueOperand():
  port: Bits(2)
  needed: Bool
  granted: Bool
  forwarded: Bool
  captured: Bool

/* Selects existing physical read paths for same-group move consumers, without changing allocation.
   Scan writers oldest-to-youngest: the nearest writer wins. A move snapshots its source's
   route at its own position, so later source overwrites cannot change the copied value.
   Non-move dependencies remain uncaptured, including those needing an EX pair rewrite. */
fun superscalar_issue_reads(xlen :: XLen, group_width :: matching(2) || matching(3), candidates :: Vec(group_width, SuperscalarIssueCandidate(xlen))) :~ SuperscalarReadRouting(group_width):
  def base = superscalar_read_routing(group_width, vec(
    for List (lane in 0..group_width):
      SuperscalarReadRequest():
        valid: candidates[lane].present & candidates[lane].decodable
        addresses: vec(candidates[lane].rs1, candidates[lane].rs2)
        used: vec(candidates[lane].control.operand.uses_rs1, candidates[lane].control.operand.uses_rs2)
  ))
  def moves = for List (lane in 0..group_width): superscalar_move_source(candidates[lane].instruction)
  def mutable routes :: List.of(Vec(2, SuperscalarIssueOperand())) = []
  for (lane in 0..group_width):
    def sources = vec(candidates[lane].rs1, candidates[lane].rs2)
    def operands = for List (source in 0..2):
      def initial = SuperscalarIssueOperand():
        port: base.ports[lane][source]
        needed: base.needed[lane][source]
        granted: base.granted[lane][source]
        forwarded: Bool(#false)
        captured: Bool(#true)

      def mutable route :: SuperscalarIssueOperand() = initial
      for (older in 0..lane):
        def writer = candidates[older]
        def matched = base.needed[lane][source] & writer.present & writer.decodable & !writer.fetch_fault & writer.control.writeback.enable & writer.rd.any() & (writer.rd === sources[source])
        def snapshot = mux(moves[older] === SuperscalarMoveSource.Rs2, routes[older][1], routes[older][0])
        def eligible = (moves[older] =/= SuperscalarMoveSource.None) & snapshot.captured
        def replacement = mux(eligible, snapshot.updated(~forwarded: Bool(#true)), initial.updated(~captured: Bool(#false)))
        route := mux(matched, replacement, route)

      route

    routes := routes ++ [vec(operands)]

  base.updated(
    ~ports: vec(for List (lane in routes): vec(lane[0].port, lane[1].port)),
    ~needed: vec(for List (lane in routes): vec(lane[0].needed, lane[1].needed)),
    ~granted: vec(for List (lane in routes): vec(lane[0].granted, lane[1].granted)),
    ~forwarded: vec(for List (lane in routes): vec(lane[0].forwarded, lane[1].forwarded))
  )

/* Checks WAW/FPR dependencies and common service conflicts for one ordered pair.
   The caller supplies unresolved GPR RAWs after any physically implemented pair rewrite. */
fun superscalar_issue_pair_hazards(xlen :: XLen, older :: SuperscalarIssueCandidate(xlen), younger :: SuperscalarIssueCandidate(xlen), a :: SuperscalarIssueTraits(), b :: SuperscalarIssueTraits(), raw :: Bool, fixed_returns_collide :: Bool) :~ SuperscalarIssueHazards():
  def waw = a.writes & a.deferred & younger.control.writeback.enable & (older.rd === younger.rd)
  def floating = younger.control.fp
  def fpr_raw1 = ((floating.valid & floating.bits.registers.uses_frs1) ||| b.vector_frs1) & (older.rd === younger.rs1)
  def fpr_raw2 = floating.valid & floating.bits.registers.uses_frs2 & (older.rd === younger.rs2)
  def fpr_raw3 = floating.valid & floating.bits.registers.uses_frs3 & (older.rd === younger.instruction[27..32])
  def fpr_raw = a.fpr_writes & (fpr_raw1 ||| fpr_raw2 ||| fpr_raw3)
  def fpr_waw = a.fpr_writes & b.fpr_writes & (older.rd === younger.rd)
  def fixed_collision = fixed_returns_collide & ((a.multiply & younger.late_gpr) ||| (older.late_gpr & b.multiply))
  def service_conflict = (a.scalar_service & b.scalar_service) ||| (a.vector & b.vector)
  def control_conflict = (older.ras & younger.ras) ||| (a.vector_config & b.vector_config)
  def qualified = older.decodable & younger.decodable
  SuperscalarIssueHazards():
    data: qualified & (raw ||| waw ||| fpr_raw ||| fpr_waw)
    structural: qualified & (service_conflict ||| control_conflict ||| (a.fpr_reads & b.fpr_reads) ||| fixed_collision)

/* Tests one candidate against external readiness and the projected branch-training occupancy. */
fun superscalar_issue_lane_hazards(xlen :: XLen, candidate :: SuperscalarIssueCandidate(xlen), traits :: SuperscalarIssueTraits(), status :: SuperscalarIssueStatus(), resources :: SuperscalarIssueResources(), operands_blocked :: Bool, training_pending :: Bits(4)) :~ SuperscalarIssueHazards():
  def control = candidate.control
  def data = candidate.decodable & (operands_blocked ||| status.fp_data_blocked ||| (control.writeback.enable & status.destination_blocked))
  def capacity = (traits.multiply & !resources.multiply_available) ||| status.fp_capacity_blocked ||| (traits.branch & (training_pending >= Bits(4)(3)))
  def ordered_memory = candidate.decodable & !control.memory.access.is_one_of(CacheOperation.None, CacheOperation.Load, CacheOperation.Store)
  SuperscalarIssueHazards():
    data: data
    structural: status.execution_blocked ||| resources.retry_wait ||| capacity ||| (traits.system & !resources.serialization_ready) ||| status.csr_read_wait ||| (ordered_memory & !resources.memory_order_ready)

/* Checks pair ordering restrictions independently of resource and operand readiness. */
fun superscalar_issue_pair_excluded(xlen :: XLen, older :: SuperscalarIssueCandidate(xlen), a :: SuperscalarIssueTraits(), b :: SuperscalarIssueTraits()) :: Bool:
  !older.decodable ||| (older.control.hint === InstructionHint.Pause) ||| a.system ||| a.csr ||| b.system ||| b.csr

/* Checks whether compact pipeline PCs can represent a candidate relative to the group's oldest PC. */
fun superscalar_issue_pc_allowed(xlen :: XLen, first_pc :: Bits(xlen.width), pc :: Bits(xlen.width)) :: Bool:
  def first_region = first_pc[SuperscalarPcOffsetBits..xlen.width]
  def region = pc[SuperscalarPcOffsetBits..xlen.width]
  (region === first_region) ||| (region === (first_region + Bits(xlen.width - SuperscalarPcOffsetBits)(1)))

/* Validates a supplied issue component's detached contract and derives its candidate width.
   No named-core import or implementation materialization is needed to inspect the boundary. */
fun superscalar_issue_width(xlen :: XLen, implementation :: Module || CircuitDefinition) :: matching(2) || matching(3):
  def signature = circuit_signature(implementation)
  def candidates = signature.input("candidates")
  unless candidates && candidates.type is_a VectorType
  | error(~who: #'superscalar_issue_width, "issue component requires a candidate vector")

  def width :: matching(2) || matching(3) = candidates.type.length
  def expected = ModuleSignature(
    [PortSignature("candidates", Vec(width, SuperscalarIssueCandidate(xlen))),
     PortSignature("status", Vec(width, SuperscalarIssueStatus())),
     PortSignature("resources", SuperscalarIssueResources()),
     PortSignature("read_blocked", Vec(4, Bool))],
    [PortSignature("reads", SuperscalarReadRouting(width)),
     PortSignature("instructions", Vec(width, SuperscalarIssueInstruction())),
     PortSignature("decision", SuperscalarIssueDecision(width))]
  )
  unless signature_equal(signature, expected)
  | error(~who: #'superscalar_issue_width, "issue component does not match the superscalar issue contract")

  width

/* Emits unchanged instruction bits and controls with the selected first-pair mux settings.
   Other candidates use ordinary datapath routes; no third-lane rewrite is introduced. */
fun superscalar_issue_instructions(xlen :: XLen, group_width :: matching(2) || matching(3), candidates :: Vec(group_width, SuperscalarIssueCandidate(xlen)), pairing :: SuperscalarPairing()) :~ Vec(group_width, SuperscalarIssueInstruction()):
  vec(
    for List (lane in 0..group_width):
      SuperscalarIssueInstruction():
        instruction: candidates[lane].instruction
        control: candidates[lane].control
        pair: if lane == 1 | superscalar_pair_control(pairing, candidates[0].control) | literal(SuperscalarPairControl(), 0)
  )

export:
  SuperscalarIssueCandidate
  SuperscalarIssueStatus
  SuperscalarIssueResources
  SuperscalarIssueDecision
  SuperscalarServiceOwners
  superscalar_service_lane
  superscalar_service_owners
  SuperscalarIssueTraits
  SuperscalarIssueHazards
  superscalar_issue_traits
  superscalar_issue_raw
  superscalar_issue_reads
  superscalar_issue_pair_hazards
  superscalar_issue_lane_hazards
  superscalar_issue_pair_excluded
  superscalar_issue_pc_allowed
  superscalar_issue_width
  superscalar_issue_instructions
