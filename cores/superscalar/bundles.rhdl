#lang rhodium
/* Defines instruction, pipeline, memory transaction, and retirement payloads for Superscalar. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/common/fetch/fault.rhdl") open
  lib("cores/common/pc.rhdl") open
  lib("cores/common/fp/profile.rhm").fp_transport_profile
  "pairing.rhdl".superscalar_pair_immediate_width
  "decode/core-ctrl.rhdl" open
  "decode/mem-ctrl.rhdl" open
  "decode/system-ctrl.rhdl" open
  "decode/long-ctrl.rhdl" open
  lib("flow/main.rhdl") open
  lib("cores/common/load-store.rhdl").MemoryWidth
  lib("cores/common/load-store.rhdl").memory_word_bytes
  lib("cores/common/cache/operation.rhdl").CacheOperation
  lib("riscv/rtl/svpbmt.rhdl").PageMemoryType
  lib("cores/common/cache-prefetch.rhdl").CachePrefetchOperation
  lib("cores/common/reservation-wait.rhdl").ReservationWaitMode
  lib("cores/common/bpred/protocol.rhdl") open
  lib("cores/common/branch-resolver.rhdl").BranchResolverControl
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/rtl/trap.rhdl").ExceptionCause
  lib("riscv/rtl/atomic.rhdl").RiscvAtomicOperation
  lib("riscv/rtl/zihintntl.rhdl").RiscvMemoryLocality
  lib("riscv/rtl/hypervisor.rhdl") open
  lib("cores/common/fp/bundles.rhdl") open
  lib("cores/common/fp/types.rhdl") open
  lib("hardfloat/main.rhdl").RoundingMode
  lib("cores/common/vector/bundles.rhdl").VectorDescriptor
  lib("cores/common/vector/decode.rhdl").VectorConfigMode


/* Resolves an S1 virtual PC combinationally; a miss requests local fetch replay. */
interface SuperscalarInstructionTranslation(xlen :: XLen):
  role requester
  role responder
  provider requester
  requester -> responder:
    request: Valid(Bits(xlen.width))

  responder -> requester:
    address: Bits(64)
    resolution: SuperscalarResolution(xlen)
    pbmt: PageMemoryType

/* A +2 or +4 successor toggles one contiguous run, starting at bit 1 or 2.
   The tag names its last changed bit, not a displacement from the PC. */
bundle SuperscalarPcStep(xlen :: XLen):
  last: Bits(index_width(xlen.width))
  short_step: Bool

  /* Restore bits 2..last and, for a two-byte step, bit 1. Bit 0 never changes. */
  method apply(step, pc :: Bits(xlen.width)) :: Bits(xlen.width):
    def below_last = Mask(xlen.width - 1).prefix(step.last).as_bits()
    def changed = below_last[1..xlen.width - 1] ++ step.short_step.as_bits() ++ Bits(1)(0)
    pc ^ changed

/* The accepted PC pair already contains the carry result, including XLEN wrap.
   Isolate the upper edge of its changed run for a parallel one-hot index encode. */
fun encode_pc_step(xlen :: XLen, pc :: Bits(xlen.width), successor :: Bits(xlen.width)) :~ SuperscalarPcStep(xlen):
  def changed = pc ^ successor
  def edge = (changed & !(changed >> 1)).into(MaybeOneHot(xlen.width))
  SuperscalarPcStep(xlen):
    last: edge.index
    short_step: changed[1].into(Bool)

/* Retains the lookup row independently of recovery history; parcel/base indices come from the PC. */
bundle SuperscalarDirectionCheckpoint():
  row: Bits(10)
  history: Bits(10)
  valid: Bool
  taken: Bool
  base_taken: Bool
  gshare_taken: Bool

  /* Restores training indices by wiring, without recomputing the earlier lookup's history hash. */
  method expanded(checkpoint, pc :: Bits) :: TournamentPrediction(10):
    TournamentPrediction(10):
      valid: checkpoint.valid
      index: checkpoint.row ++ pc[1..3]
      history: checkpoint.history
      taken: checkpoint.taken
      base_index: pc[1..13]
      base_taken: checkpoint.base_taken
      gshare_taken: checkpoint.gshare_taken

/* Restore the fetched word without decompressing again: long encodings retain
   their canonical upper half; compressed encodings have no upper parcel. */
fun superscalar_raw_instruction(instruction :: Bits(32), raw_parcel :: Bits(16)) :: Bits(32):
  mux(raw_parcel[0..2].all(), instruction[16..32], Bits(16)(0)) ++ raw_parcel

/* Stores a normalized frontend hint in the fixed architectural PC domain. */
bundle SuperscalarInstructionPrediction(xlen :: XLen):
  valid: Bool
  target: CompactPc(xlen)

/* Marks positive sequential boundary crossings, the failed parcel, and guest provenance.
   Boundary is always false for RV32, which retains every architectural PC bit. */
bundle SuperscalarInstructionFault(xlen :: XLen, hypervisor :: Boolean):
  boundary: Bool
  cause: ExceptionCause
  continuation: Bool
  if hypervisor:
    guest: RiscvGuestFault()

/* A fault never predicts, so its details reuse the normal prediction's storage. */
tagged_union SuperscalarInstructionOutcome(xlen :: XLen, hypervisor :: Boolean):
  Normal(SuperscalarInstructionPrediction(xlen))
  Fault(SuperscalarInstructionFault(xlen, hypervisor))

namespace SuperscalarInstructionOutcome:
  /* Selects fault provenance instead of prediction when a parcel failed. Check the
     full PC before truncation so sequential boundary faults keep their exact address. */
  export fun select(xlen :: XLen, hypervisor :: Boolean, pc :: Bits(xlen.width), fault :: FetchFault(xlen, hypervisor),
                    ~predicted: predicted :: Bool, ~target: target :: CompactPc(xlen)) :~ SuperscalarInstructionOutcome(xlen, hypervisor):
    def Outcome = SuperscalarInstructionOutcome(xlen, hypervisor)
    def empty :: SuperscalarInstructionFault(xlen, hypervisor) = literal(SuperscalarInstructionFault(xlen, hypervisor), 0)
    def details :: SuperscalarInstructionFault(xlen, hypervisor) = empty.updated(
      ~boundary: !CompactPc.fits(xlen, pc), ~cause: fault.cause, ~continuation: fault.continuation)
    def provenance = if hypervisor | details.updated(~guest: fault.guest) | details
    def prediction = SuperscalarInstructionPrediction(xlen):
      valid: predicted
      target: target

    mux(fault.valid, Outcome.Fault(provenance), Outcome.Normal(prediction))

/* Successful PCs sign-extend independently; a boundary fault instead zero-extends.
   Direction training indices are reconstructed from the instruction PC;
   the lookup row, history, and assembler's length decision retain independent ownership. */
bundle SuperscalarInstruction(xlen :: XLen, hypervisor :: Boolean):
  pc: CompactPc(xlen)
  instruction: Bits(32)
  raw_parcel: Bits(16)
  step: SuperscalarPcStep(xlen)
  compressed_illegal: Bool
  outcome: SuperscalarInstructionOutcome(xlen, hypervisor)
  predicted_compressed: Bool
  predicted_ras_action: RasAction
  speculated_ras_action: RasAction
  direction: SuperscalarDirectionCheckpoint()

  /* Reconstructs canonical PCs and positive sequential-boundary fault addresses. */
  method address(entry) :: Bits(xlen.width):
    def Outcome = SuperscalarInstructionOutcome(xlen, hypervisor)
    def details :: SuperscalarInstructionFault(xlen, hypervisor) = entry.outcome.view(Outcome.Fault).payload
    def fault_pc = entry.pc.fetch_address(details.boundary)
    mux(entry.outcome.is(Outcome.Fault), fault_pc, entry.pc.expanded())

  /* Supplies only active fault provenance; normal instructions never expose union garbage. */
  method fetch_fault(entry) :: FetchFault(xlen, hypervisor):
    def Outcome = SuperscalarInstructionOutcome(xlen, hypervisor)
    def details :: SuperscalarInstructionFault(xlen, hypervisor) = entry.outcome.view(Outcome.Fault).payload
    def absent :: FetchFault(xlen, hypervisor) = literal(FetchFault(xlen, hypervisor), 0)
    def fault :: FetchFault(xlen, hypervisor) = absent.updated(
      ~valid: Bool(#true), ~cause: details.cause, ~continuation: details.continuation)
    def provenance = if hypervisor | fault.updated(~guest: details.guest) | fault
    mux(entry.outcome.is(Outcome.Fault), provenance, absent)

  /* Recovers the original encoding without storing a duplicate upper parcel. */
  method raw(entry) :: Bits(32):
    superscalar_raw_instruction(entry.instruction, entry.raw_parcel)

  /* Reuses the accepted carry tag instead of adding a new successor adder. */
  method successor(entry) :: Bits(xlen.width):
    entry.step.apply(entry.address())

  /* Tests prediction ownership without expanding the instruction record. */
  method predicted(entry) :: Bool:
    def Outcome = SuperscalarInstructionOutcome(xlen, hypervisor)
    def normal :: SuperscalarInstructionPrediction(xlen) = entry.outcome.view(Outcome.Normal).payload
    entry.outcome.is(Outcome.Normal) & normal.valid

  /* Restores only the selected speculative target; inactive targets are zero. */
  method target(entry) :: Bits(xlen.width):
    def Outcome = SuperscalarInstructionOutcome(xlen, hypervisor)
    def normal :: SuperscalarInstructionPrediction(xlen) = entry.outcome.view(Outcome.Normal).payload
    mux(entry.predicted(), normal.target.expanded(), Bits(xlen.width)(0))

  /* Formats the shared predictor message at discovery, not while moving stored instructions. */
  method prediction_value(entry) :: BranchPrediction(xlen, xlen.width):
    BranchPrediction(xlen, xlen.width):
      valid: entry.predicted()
      pc: entry.address()
      target: entry.target()
      compressed: entry.predicted_compressed
      ras_action: entry.predicted_ras_action

  /* Projects an independently retained completion identity from this instruction. */
  method identity(entry) :: SuperscalarInstructionIdentity(xlen):
    SuperscalarInstructionIdentity.create(xlen, entry.address(), entry.raw())

def SuperscalarPcOffsetBits = 12


/* Instruction metadata: only the starting-PC suffix is lane-owned. Prediction
   destinations remain independent, and the successor uses the window's step tag. */

/* Retains a speculative destination without another copy of its instruction PC. */
bundle SuperscalarLanePrediction(xlen :: XLen):
  valid: Bool
  target: CompactPc(xlen)
  compressed: Bool
  ras_action: RasAction

/* Shares the compact instruction layout; EX retains a fault, MEM/WB only its origin bit. */
bundle SuperscalarLaneInstruction(xlen :: XLen, Fault :: DataType):
  pc: Bits(SuperscalarPcOffsetBits)
  instruction: Bits(32)
  raw_instruction: Bits(16)
  sequential_pc: SuperscalarPcStep(xlen)
  compressed_illegal: Bool
  fault: Fault
  prediction: SuperscalarLanePrediction(xlen)
  speculated_ras_action: RasAction
  direction: SuperscalarDirectionCheckpoint()

  /* Restores the original encoding from the canonical word and retained low parcel. */
  method raw(fetched) :: Bits(32):
    superscalar_raw_instruction(fetched.instruction, fetched.raw_instruction)

  /* Captures a delayed result's identity using the full PC supplied by its stage. */
  method identity(fetched, pc :: Bits(xlen.width)) :: SuperscalarInstructionIdentity(xlen):
    SuperscalarInstructionIdentity.create(xlen, pc, fetched.raw())

  /* Changes fault ownership at resolution while preserving the compact instruction metadata. */
  method with_fault(fetched, NextFault :: DataType, fault :: Hardware.of(NextFault)) :: SuperscalarLaneInstruction(xlen, NextFault):
    SuperscalarLaneInstruction(xlen, NextFault):
      pc: fetched.pc
      instruction: fetched.instruction
      raw_instruction: fetched.raw_instruction
      sequential_pc: fetched.sequential_pc
      compressed_illegal: fetched.compressed_illegal
      fault: fault
      prediction: fetched.prediction
      speculated_ras_action: fetched.speculated_ras_action
      direction: fetched.direction

  /* Gives an independently owned observation its PC without expanding other aliases. */
  method observed(fetched, hypervisor :: Boolean, pc :: Bits(xlen.width), fault :: FetchFault(xlen, hypervisor)) :: SuperscalarInstruction(xlen, hypervisor):
    SuperscalarInstruction(xlen, hypervisor):
      pc: CompactPc.capture(xlen, pc)
      instruction: fetched.instruction
      raw_parcel: fetched.raw_instruction
      step: fetched.sequential_pc
      compressed_illegal: fetched.compressed_illegal
      outcome: SuperscalarInstructionOutcome.select(xlen, hypervisor, pc, fault, ~predicted: fetched.prediction.valid, ~target: fetched.prediction.target)
      predicted_compressed: fetched.prediction.compressed
      predicted_ras_action: fetched.prediction.ras_action
      speculated_ras_action: fetched.speculated_ras_action
      direction: fetched.direction

namespace SuperscalarLaneInstruction:
  /* Transfers only lane-owned metadata; the stage separately captures the shared PC prefix. */
  export fun capture(xlen :: XLen, hypervisor :: Boolean, Fault :: DataType, fetched :: SuperscalarInstruction(xlen, hypervisor), fault :: Hardware.of(Fault)) :~ SuperscalarLaneInstruction(xlen, Fault):
    SuperscalarLaneInstruction(xlen, Fault):
      pc: fetched.pc.low[0..SuperscalarPcOffsetBits]
      instruction: fetched.instruction
      raw_instruction: fetched.raw_parcel
      sequential_pc: fetched.step
      compressed_illegal: fetched.compressed_illegal
      fault: fault
      prediction:
        SuperscalarLanePrediction(xlen):
          valid: fetched.predicted()
          target: CompactPc.prediction(xlen, fetched.target())
          compressed: fetched.predicted_compressed
          ras_action: fetched.predicted_ras_action
      speculated_ras_action: fetched.speculated_ras_action
      direction: fetched.direction


/* Offers a nonempty instruction prefix with an explicit two- or three-entry capacity. */
bundle SuperscalarPacket(xlen :: XLen, hypervisor :: Boolean, group_width :: matching(2) || matching(3)):
  count: Bits(2)
  entries: Vec(group_width, SuperscalarInstruction(xlen, hypervisor))

/* A valid entry is a retired branch. Keep its canonical source, full resolved
   target and lookup decisions; both predictor messages use the same outcome. */
bundle SuperscalarBranchTraining(xlen :: XLen):
  pc: CompactPc(xlen)
  target: Bits(xlen.width)
  step: SuperscalarPcStep(xlen)
  conditional: Bool
  taken: Bool
  ras_action: RasAction
  predicted_ras_action: RasAction
  direction_valid: Bool
  row: Bits(10)
  base_taken: Bool
  gshare_taken: Bool

  /* Restores the BTB message, including the fall-through across a page or XLEN wrap. */
  method branch_update(training) :: BranchUpdate(xlen):
    def pc = training.pc.expanded()
    BranchUpdate(xlen):
      pc: pc
      target: training.target
      branch: Bool(#true)
      conditional: training.conditional
      taken: training.taken
      compressed: training.step.short_step
      ras_action: training.ras_action
      predicted_ras_action: training.predicted_ras_action
      return_address: training.step.apply(pc)

  /* The hashed row is from lookup; the base index and parcel bits are wires from the saved PC. */
  method direction_update(training) :: TournamentUpdate(10):
    TournamentUpdate(10):
      index: training.row ++ training.pc.low[1..3]
      base_index: training.pc.low[1..13]
      base_taken: training.base_taken
      gshare_taken: training.gshare_taken
      taken: training.taken

/* Advances committed conditional history in retirement order, independently of table training. */
bundle SuperscalarHistoryCommit(group_width :: matching(2) || matching(3) = 2):
  enable: Vec(group_width, Bool)
  taken: Vec(group_width, Bool)

/* Distinguishes MEM continuation, synchronous trap, preacceptance replay, and WB system recovery. */
hardware_enum SuperscalarDisposition:
  Continue
  Fault
  Replay
  System

/* Carries one synchronous outcome with its compact cause and exact trap value.
   Interrupts are architectural redirect metadata, not a pipeline exception. */
bundle SuperscalarResolution(xlen :: XLen):
  disposition: SuperscalarDisposition
  cause: ExceptionCause
  value: Bits(xlen.width)
  guest: RiscvGuestFault()

  /* Keeps the exact trap value for a fault; all other dispositions retain the
     caller's result in the same XLEN word. */
  method with_result(outcome, data :: Bits(xlen.width)) :: SuperscalarResolution(xlen):
    outcome.updated(~value: mux(outcome.disposition === SuperscalarDisposition.Fault, outcome.value, data))

/* Keeps the instruction's position independent of the two physical GPR write ports. */
bundle SuperscalarFpSchedule():
  lane: Bits(2)
  speculative: Bool
  direct: Bool

/* Identifies a delayed result with a successful RV32 or canonical Sv39 PC. */
bundle SuperscalarInstructionIdentity(xlen :: XLen):
  pc: Bits(compact_pc_width(xlen))
  raw_instruction: Bits(32)

  /* Expands only the address at an architectural or observation consumer. */
  method address(identity) :: Bits(xlen.width):
    identity.pc.sext(xlen.width)

namespace SuperscalarInstructionIdentity:
  /* Captures a successful PC; the accepting producer checks representability. */
  export fun create(xlen :: XLen, pc :: Bits(xlen.width), raw :: Bits(32)) :~ SuperscalarInstructionIdentity(xlen):
    SuperscalarInstructionIdentity(xlen):
      pc: pc[0..compact_pc_width(xlen)]
      raw_instruction: raw

/* Keeps age-slot identity and result bank through scalar numerical execution. */
bundle SuperscalarFpOwner(xlen :: XLen):
  identity: SuperscalarInstructionIdentity(xlen)
  lane: Bits(2)
  rd: Bits(5)
  destination: FloatDestination
  speculative: Bool
  direct: Bool

/* Reconstructs an FP owner from its one pipeline instruction and compact scheduling tag. */
fun superscalar_fp_owner(xlen :: XLen, identity :: SuperscalarInstructionIdentity(xlen), rd :: Bits(5), request :: FpExecutionRequest(xlen, fp_transport_profile(xlen), SuperscalarFpSchedule())) :~ SuperscalarFpOwner(xlen):
  SuperscalarFpOwner(xlen):
    identity: identity
    lane: request.tag.lane
    rd: rd
    destination: request.control.registers.destination
    speculative: request.tag.speculative
    direct: request.tag.direct

/* Attaches architectural ownership only when numerical work enters a shared service. */
fun superscalar_fp_request(xlen :: XLen, identity :: SuperscalarInstructionIdentity(xlen), rd :: Bits(5), request :: FpExecutionRequest(xlen, fp_transport_profile(xlen), SuperscalarFpSchedule())) :~ FpExecutionRequest(xlen, fp_transport_profile(xlen), SuperscalarFpOwner(xlen)):
  request.with_tag(SuperscalarFpOwner(xlen), superscalar_fp_owner(xlen, identity, rd, request))

/* Retains WB ownership, timing, and divide/sqrt controls. Operand words stay
   in the owning instruction's result record, not in this group metadata. */
bundle SuperscalarFpRetirement(xlen :: XLen):
  tag: SuperscalarFpSchedule()
  destination: FloatDestination
  unit: FloatUnit
  source_precision: FloatPrecision
  destination_precision: FloatPrecision
  divide_operation: FloatDivideOperation
  rounding_mode: RoundingMode

  /* Joins scheduling metadata to the surviving instruction's architectural identity. */
  method owner(context, identity :: SuperscalarInstructionIdentity(xlen), rd :: Bits(5)) :: SuperscalarFpOwner(xlen):
    SuperscalarFpOwner(xlen):
      identity: identity
      lane: context.tag.lane
      rd: rd
      destination: context.destination
      speculative: context.tag.speculative
      direct: context.tag.direct

  /* Supplies ownership and latency selection to the existing authorization port;
     unused arithmetic operands and controls are constants, not retained state. */
  method authorization(context, identity :: SuperscalarInstructionIdentity(xlen), rd :: Bits(5)) :: FpExecutionRequest(xlen, fp_transport_profile(xlen), SuperscalarFpOwner(xlen)):
    def retained :: SuperscalarFpRetirement(xlen) = context
    def inactive :: FpExecutionRequest(xlen, fp_transport_profile(xlen), SuperscalarFpOwner(xlen)) = literal(FpExecutionRequest(xlen, fp_transport_profile(xlen), SuperscalarFpOwner(xlen)), 0)
    inactive.updated(
      ~tag: retained.owner(identity, rd),
      ~control: inactive.control.updated(
        ~registers: inactive.control.registers.updated(~destination: context.destination),
        ~execution: inactive.control.execution.updated(
          ~unit: context.unit, ~source_precision: context.source_precision,
          ~destination_precision: context.destination_precision, ~divide_operation: context.divide_operation
        )
      )
    )

  /* Joins deferred divide/sqrt controls to the surviving WB instruction's operand pair. */
  method division_request(context, identity :: SuperscalarInstructionIdentity(xlen), rd :: Bits(5), left :: Bits(xlen.width), right :: Bits(xlen.width)) :: FpExecutionRequest(xlen, fp_transport_profile(xlen), SuperscalarFpOwner(xlen)):
    def retained :: SuperscalarFpRetirement(xlen) = context
    def request = retained.authorization(identity, rd)
    request.updated(
      ~control: request.control.updated(~execution: request.control.execution.updated(~unit: FloatUnit.DivideSquareRoot)),
      ~left: left, ~right: right, ~rounding_mode: context.rounding_mode
    )

/* Selects only group metadata before the first retirement-stage register. */
fun superscalar_fp_retirement(xlen :: XLen, request :: FpExecutionRequest(xlen, fp_transport_profile(xlen), SuperscalarFpSchedule())) :~ SuperscalarFpRetirement(xlen):
  SuperscalarFpRetirement(xlen):
    tag: request.tag
    destination: request.control.registers.destination
    unit: request.control.execution.unit
    source_precision: request.control.execution.source_precision
    destination_precision: request.control.execution.destination_precision
    divide_operation: request.control.execution.divide_operation
    rounding_mode: request.rounding_mode

/* Carries an already extracted FP memory value to the architectural FPR write port. */
bundle SuperscalarFpLoad(xlen :: XLen):
  owner: SuperscalarFpOwner(xlen)
  precision: FloatPrecision
  data: Bits(64)


/* Carries the RR-computed immediate and only the forwarding controls still needed in EX/MEM. */
bundle SuperscalarExecutionRewrite(xlen :: XLen):
  composed: Bool
  immediate: Bits(superscalar_pair_immediate_width(xlen))
  memory_address: Bool
  store_data: Bool
  branch_operands: Vec(2, Bool)
  vector_scalar: Bool

/* Captures selected register-read datapath values, not issue-policy state. */
bundle SuperscalarOperands(xlen :: XLen):
  rs1: Bits(xlen.width)
  rs2: Bits(xlen.width)
  rewrite: SuperscalarExecutionRewrite(xlen)

/* Distinguishes a fixed-latency hit, retry, authorized slow service, or translation fault. */
hardware_enum SuperscalarCacheOutcome:
  Slow
  LoadHit
  StoreHit
  Replay
  PageFault
  AccessFault
  GuestPageFault

/* Retains training decisions; instruction, return, and target addresses are aliases. */
bundle SuperscalarBranchDecision():
  branch: Bool
  conditional: Bool
  taken: Bool
  ras_action: RasAction
  predicted_ras_action: RasAction

  /* Captures only the independent facts needed to train after this branch retires. */
  method training(decision, xlen :: XLen, pc :: Bits(xlen.width),
                  ~target: target :: Bits(xlen.width), ~step: step :: SuperscalarPcStep(xlen),
                  ~checkpoint: checkpoint :: SuperscalarDirectionCheckpoint()) :: SuperscalarBranchTraining(xlen):
    SuperscalarBranchTraining(xlen):
      pc: CompactPc.capture(xlen, pc)
      target: target
      step: step
      conditional: decision.conditional
      taken: decision.taken
      ras_action: decision.ras_action
      predicted_ras_action: decision.predicted_ras_action
      direction_valid: decision.conditional & checkpoint.valid
      row: checkpoint.row
      base_taken: checkpoint.base_taken
      gshare_taken: checkpoint.gshare_taken

/* Keeps comparison and recovery controls without a second resolved target word. */
bundle SuperscalarBranchResult():
  taken: Bool
  update: SuperscalarBranchDecision()
  control: BranchResolverControl()
  operands_from_older: Vec(2, Bool)
  mispredicted: Bool

/* Per-lane hazards and retirement policy survive even when a fault kills vector dispatch.
   The operands, state snapshot, and translation certificate belong to the shared descriptor. */
bundle SuperscalarVectorLane():
  operation: Bool
  floating_point: Bool
  floating_scalar_destination: Bool
  integer_destination: Bool
  memory: Bool
  store: Bool
  configure: VectorConfigMode

/* Two words owned by this instruction, not the issue group. A CSR uses left
   for its source; scalar memory uses right for its unshifted write data.
   Branch comparison, divide and vector configuration consume the pair. */
bundle SuperscalarLaneOperands(xlen :: XLen):
  left: Bits(xlen.width)
  right: Bits(xlen.width)

/* Retains exactly one lane's MEM/WB result, operands, control and fault outcome, without derived aliases. */
bundle SuperscalarResult(xlen :: XLen, hypervisor :: Boolean):
  fetched: SuperscalarLaneInstruction(xlen, Bool)
  rd: Bits(5)
  write: Bool
  result_ready: Bool
  branch: SuperscalarBranchResult()
  memory: SuperscalarMemoryControl()
  guest_access: RiscvGuestMemoryAccess
  prefetch: CachePrefetchOperation
  pause: Bool
  locality_hint: RiscvMemoryLocality
  address: Bits(xlen.width)
  cache_outcome: SuperscalarCacheOutcome
  system: SuperscalarSystemControl()
  muldiv: SuperscalarLongControl()
  operands: SuperscalarLaneOperands(xlen)
  resolution: SuperscalarResolution(xlen)
  fp: SuperscalarFpControl()
  vector_fast_eligible: Bool
  vector: SuperscalarVectorLane()

  /* After MEM compares branch operands, WB keeps either the address (including
     a not-taken branch's training target) or the left operand. The issue group
     captures service data and register-supplied vtype outside the lane. */
  method for_writeback(result) :: SuperscalarResult(xlen, hypervisor):
    def needs_address = result.memory.enable ||| result.branch.update.branch ||| result.prefetch.is_prefetch()
    def address_or_left = mux(needs_address, result.address, result.operands.left)
    result.updated(~address: address_or_left, ~operands: result.operands.updated(~left: address_or_left, ~right: Bits(xlen.width)(0)))

  /* Recovers fetch provenance only when the retained origin bit names a fetch fault. */
  method fetch_fault(token) :: FetchFault(xlen, hypervisor):
    def continuation = token.fetched.fault & (token.resolution.value[1] ^ token.fetched.pc[1]).into(Bool)
    if hypervisor
    | FetchFault(xlen, hypervisor):
        valid: token.fetched.fault
        cause: token.resolution.cause
        continuation: continuation
        guest: mux(token.fetched.fault, token.resolution.guest, literal(RiscvGuestFault(), 0))
    | FetchFault(xlen, hypervisor):
        valid: token.fetched.fault
        cause: token.resolution.cause
        continuation: continuation

  /* Formats a public instruction observation without reconstructing the pipeline record. */
  method observed(token, pc :: Bits(xlen.width)) :: SuperscalarInstruction(xlen, hypervisor):
    def retained :: SuperscalarResult(xlen, hypervisor) = token
    retained.fetched.observed(hypervisor, pc, retained.fetch_fault())

  /* Projects a live resolved lane onto the same retirement port used by service completions. */
  method retirement(result) :: SuperscalarRetirementCommand(xlen, hypervisor):
    SuperscalarRetirementCommand(xlen, hypervisor):
      fetched: result.fetched
      rd: result.rd
      write: result.write
      result_ready: result.result_ready
      branch:
        SuperscalarRetirementBranch():
          taken: result.branch.taken
          update: result.branch.update
          mispredicted: result.branch.mispredicted
      memory: result.memory
      prefetch: result.prefetch
      pause: result.pause
      locality_hint: result.locality_hint
      address: result.address
      system: result.system
      operands: result.operands
      resolution: result.resolution
      fp: result.fp
      vector: result.vector

  /* Captures only a continuing split/maintenance/wait/vector-memory owner.
     The lane's existing successor tag avoids recoding or adding a PC adder. */
  method service_owner(result, pc :: Bits(xlen.width), fp_request :: SuperscalarFpRetirement(xlen)) :: SuperscalarServiceOwner(xlen, hypervisor):
    SuperscalarServiceOwner(xlen, hypervisor):
      identity: result.fetched.identity(pc)
      instruction: result.fetched.instruction
      step: result.fetched.sequential_pc
      predicted: result.fetched.prediction.valid
      target: result.fetched.prediction.target.expanded()
      predicted_compressed: result.fetched.prediction.compressed
      predicted_ras_action: result.fetched.prediction.ras_action
      speculated_ras_action: result.fetched.speculated_ras_action
      direction: result.fetched.direction
      prediction_repair: result.branch.mispredicted
      rd: result.rd
      write: result.write
      memory: result.memory
      guest_access: result.guest_access
      address: result.address
      store_data: result.operands.right
      wait: result.system.wait
      fp: result.fp
      fp_schedule: fp_request.tag
      vector: result.vector

/* Carries only resolved training decisions; comparison controls end at MEM. */
bundle SuperscalarRetirementBranch():
  taken: Bool
  update: SuperscalarBranchDecision()
  mispredicted: Bool

/* Common retirement/CSR/observation projection. Execution controls, cache outcome,
   guest-access routing and arithmetic launch ownership stay with the live pipeline. */
bundle SuperscalarRetirementCommand(xlen :: XLen, hypervisor :: Boolean):
  fetched: SuperscalarLaneInstruction(xlen, Bool)
  rd: Bits(5)
  write: Bool
  result_ready: Bool
  branch: SuperscalarRetirementBranch()
  memory: SuperscalarMemoryControl()
  prefetch: CachePrefetchOperation
  pause: Bool
  locality_hint: RiscvMemoryLocality
  address: Bits(xlen.width)
  system: SuperscalarSystemControl()
  operands: SuperscalarLaneOperands(xlen)
  resolution: SuperscalarResolution(xlen)
  fp: SuperscalarFpControl()
  vector: SuperscalarVectorLane()

  /* Reports only successfully retired instructions; invalid fault payloads must not retain WB state. */
  method retired_instruction(token, pc :: Bits(xlen.width)) :: SuperscalarInstruction(xlen, hypervisor):
    def retained :: SuperscalarRetirementCommand(xlen, hypervisor) = token
    retained.fetched.observed(hypervisor, pc, literal(FetchFault(xlen, hypervisor), 0))

  /* Derives the architectural successor from the existing step or resolved branch address. */
  method next_pc(token, pc :: Bits(xlen.width)) :: Bits(xlen.width):
    mux(token.branch.taken, token.address, token.fetched.sequential_pc.apply(pc))

  /* Project the instruction before a capture or from a live retirement slot. */
  method boundary_instruction(result, pc :: Bits(xlen.width)) :: SuperscalarBoundaryInstruction(xlen):
    SuperscalarBoundaryInstruction(xlen):
      pc: pc
      raw_instruction: result.fetched.raw()
      next_pc: result.next_pc(pc)
      fetch_fault: result.fetched.fault
      rd: result.rd
      memory: result.memory
      address: result.address
      store_data: result.operands.right
      fp: result.fp
      vector: result.vector.operation


/* Owns accepted WB services, never a branch, CSR operation, or arithmetic launch.
   Faults and data arrive at completion; frontend observation metadata survives,
   but fetch-fault state, execution operands, and inactive controls do not. */
bundle SuperscalarServiceOwner(xlen :: XLen, hypervisor :: Boolean):
  identity: SuperscalarInstructionIdentity(xlen)
  instruction: Bits(32)
  step: SuperscalarPcStep(xlen)
  predicted: Bool
  target: Bits(xlen.width)
  predicted_compressed: Bool
  predicted_ras_action: RasAction
  speculated_ras_action: RasAction
  direction: SuperscalarDirectionCheckpoint()
  prediction_repair: Bool
  rd: Bits(5)
  write: Bool
  memory: SuperscalarMemoryControl()
  guest_access: RiscvGuestMemoryAccess
  address: Bits(xlen.width)
  store_data: Bits(xlen.width)
  wait: ReservationWaitMode
  fp: SuperscalarFpControl()
  fp_schedule: SuperscalarFpSchedule()
  vector: SuperscalarVectorLane()

  /* Supplies a completed service to retirement; inactive dispatch controls cannot relaunch work. */
  method completed(owner, data :: Bits(xlen.width), resolution :: SuperscalarResolution(xlen)) :: SuperscalarRetirementCommand(xlen, hypervisor):
    def fetched = SuperscalarLaneInstruction(xlen, Bool):
      pc: owner.identity.pc[0..SuperscalarPcOffsetBits]
      instruction: owner.instruction
      raw_instruction: owner.identity.raw_instruction[0..16]
      sequential_pc: owner.step
      compressed_illegal: Bool(#false)
      fault: Bool(#false)
      prediction:
        SuperscalarLanePrediction(xlen):
          valid: owner.predicted
          target: CompactPc.prediction(xlen, owner.target)
          compressed: owner.predicted_compressed
          ras_action: owner.predicted_ras_action
      speculated_ras_action: owner.speculated_ras_action
      direction: owner.direction

    def inactive :: SuperscalarRetirementCommand(xlen, hypervisor) = literal(SuperscalarRetirementCommand(xlen, hypervisor), 0)
    def update = inactive.branch.update.updated(~predicted_ras_action: owner.speculated_ras_action)
    def branch = inactive.branch.updated(~mispredicted: owner.prediction_repair, ~update: update)
    inactive.updated(
      ~fetched: fetched, ~rd: owner.rd, ~write: owner.write, ~resolution: resolution.with_result(data), ~result_ready: Bool(#true),
      ~branch: branch,
      ~memory: owner.memory, ~address: owner.address,
      ~operands: inactive.operands.updated(~right: owner.store_data),
      ~system: inactive.system.updated(~wait: owner.wait), ~fp: owner.fp, ~vector: owner.vector
    )

/* The instruction fields sampled by the passive WB observer. Only identity
   is needed by the trap datapath; the remaining fields need no physical
   storage in a build without that observer. */
bundle SuperscalarBoundaryInstruction(xlen :: XLen):
  pc: Bits(xlen.width)
  raw_instruction: Bits(32)
  next_pc: Bits(xlen.width)
  fetch_fault: Bool
  rd: Bits(5)
  memory: SuperscalarMemoryControl()
  address: Bits(xlen.width)
  store_data: Bits(xlen.width)
  fp: SuperscalarFpControl()
  vector: Bool

/* Holds a precise exception or an interrupt boundary, not an executable CSR
   command. Interrupt selection and delegation remain live in the CSR bank. */
bundle SuperscalarPendingTrap(xlen :: XLen, hypervisor :: Boolean):
  interrupt: Bool
  instruction: SuperscalarBoundaryInstruction(xlen)
  cause: ExceptionCause
  value: Bits(xlen.width)
  if hypervisor:
    guest: RiscvGuestFault()

/* Restarts unassembled fetch work without discarding already accepted instructions. */
bundle SuperscalarFetchRepair(xlen :: XLen):
  target: Bits(xlen.width)
  invalidate: Bool
  entry: Bits(xlen.width)
  history: Bits(10)

/* Appends a conditional outcome while leaving nonbranch history checkpoints unchanged. */
fun superscalar_history_after(history :: Bits(10), valid :: Bool, taken :: Bool) :~ Bits(10):
  mux(valid, history[0..9] ++ taken.as_bits(), history)

/* Carries exact byte addresses and XLEN beats; VA uses XLEN, while PA width is independent. */
bundle SuperscalarMemoryReq(xlen :: XLen, address_width :: PosInt):
  address: Bits(address_width)
  access: CacheOperation
  atomic: RiscvAtomicOperation
  width: MemoryWidth
  data: Bits(xlen.width)
  mask: Bits(memory_word_bytes(xlen))
  locality: RiscvMemoryLocality
  pbmt: PageMemoryType
  guest_access: RiscvGuestMemoryAccess

/* Crosses the translation boundary without changing access size or positioned store lanes. */
fun superscalar_physical_request(xlen :: XLen, request :: SuperscalarMemoryReq(xlen, xlen.width), address :: Bits(64), pbmt :: PageMemoryType) :~ SuperscalarMemoryReq(xlen, 64):
  SuperscalarMemoryReq(xlen, 64):
    address: address
    access: request.access
    atomic: request.atomic
    width: request.width
    data: request.data
    mask: request.mask
    locality: request.locality
    pbmt: pbmt
    guest_access: request.guest_access

/* Returns the MEM decision and raw aligned load beat; no allocation or mutation occurs here. */
bundle SuperscalarLookupResult(xlen :: XLen):
  outcome: SuperscalarCacheOutcome
  data: Bits(xlen.width)
  guest: RiscvGuestFault()

/* Pairs an EX lookup with next-cycle MEM feedback and a one-cycle WB store candidate. */
interface SuperscalarPipelineAccess(xlen :: XLen):
  role requester
  role responder
  provider requester
  requester -> responder:
    request: Valid(SuperscalarMemoryReq(xlen, xlen.width))
    commit: Bool

  responder -> requester:
    response: Valid(SuperscalarLookupResult(xlen))
    commit_ready: Bool

/* Authorizes slow transactions at WB. Admission resolves all synchronous faults;
   accepted responses are successful and ordered: ordinary loads return raw aligned
   beats, atomics return their architectural value/status, and stores return acknowledgements.
   A fault prevents request acceptance. Drained also covers committed hit stores;
   registered ordered_busy prevents younger memory effects, including earlier lookup hits.
   Reservation validity is live shared-cache state for WB wait-on-reservation.
   Reset must reset both participants together. */
interface SuperscalarMemory(xlen :: XLen, address_width :: PosInt):
  role requester
  role responder
  provider requester
  requester -> responder:
    request: Decoupled(SuperscalarMemoryReq(xlen, address_width))

  responder -> requester:
    fault: Valid(SuperscalarResolution(xlen))
    response: Decoupled(Bits(xlen.width))
    drained: Bool
    ordered_busy: Bool
    reservation_valid: Bool

/* Reports one successfully retired instruction and its optional architectural GPR write. */
bundle SuperscalarRetirement(xlen :: XLen, hypervisor :: Boolean):
  fetched: SuperscalarInstruction(xlen, hypervisor)
  rd: Bits(5)
  write: Bool
  data: Bits(xlen.width)
  deferred: Bool

/* Reports the eventual result of an already authorized operation, not a second retirement. */
bundle SuperscalarCompletion(xlen :: XLen):
  identity: SuperscalarInstructionIdentity(xlen)
  rd: Bits(5)
  write: Bool
  data: Bits(xlen.width)

/* Reports MEM branch recovery or the older WB fault/replay override; Continue is not retirement.
   trap_cause is the architectural trap image; resolution.cause describes only synchronous faults. */
bundle SuperscalarRedirect(xlen :: XLen):
  pc: Bits(xlen.width)
  target: Bits(xlen.width)
  resolution: SuperscalarResolution(xlen)
  interrupt: Bool
  trap_cause: Bits(xlen.width)

/* Describes a youngest-older operand match, including results not yet usable. */
bundle SuperscalarOperand(xlen :: XLen):
  blocked: Bool
  data: Bits(xlen.width)

