#lang rhodium
/* Owns identity translation, its architectural width, physical map, client capability, and Bare access policies. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/mmu/context.rhdl").RiscvTranslationState
  lib("riscv/rtl/trap.rhdl").ExceptionCause
  "../cache/config.rhm".CacheLineBytes
  "bundles.rhdl" open
  "memory-translation.rhdl" open
  "translation-specialization.rhm" open
  lib("rhodium/frontend/foundation.rhm").CircuitDefinition
  lib("cores/mmu/translation.rhdl").RiscvTranslationFault
  "../cache-prefetch.rhdl" open
  "../chi-hart.rhdl" open
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/rtl/pma.rhdl").RiscvPhysicalMemoryMap
  lib("riscv/rtl/hypervisor.rhdl") open
  lib("riscv/rtl/svpbmt.rhdl") open
  lib("flow/main.rhdl") open
  lib("rhodium/std/bits.rhdl") open
  lib("cores/mmu/vector.rhdl") open
  lib("cores/mmu/vector-window.rhdl") open
  lib("cores/mmu/vector-certificate.rhdl").VectorCertificate
  lib("cores/mmu/translation.rhdl").RiscvTlbLookup
  lib("cores/mmu/protocol.rhdl").RiscvTranslationResult

/* Resolves Bare queries immediately while preserving vector proof epochs and one-stage hints.
   Architectural addresses remain full-width through physical-map qualification. */
sync_circuit SuperscalarIdentityTranslation(xlen :: XLen, config :: RiscvHartCHIConfig):
  input state: RiscvTranslationState(xlen)
  input invalidate: Bool
  input query: SuperscalarTranslationQuery(xlen)
  input(pipeline_vector, request_vector): Bool
  interface vector_precheck(VectorPrecheck(), ~role: responder)
  interface vector_fast(VectorFastCheck(xlen), ~role: responder)
  interface prefetch(Valid(CachePrefetchReq(64)), ~role: consumer)
  interface physical_prefetch(Valid(CachePrefetchReq(64)), ~role: producer)
  interface instruction(SuperscalarInstructionTranslation(xlen), ~role: responder)
  output result: SuperscalarAddressResolution(xlen)

  inst vector_window(VectorWindow(config.physical_map))
  vector_precheck <=> vector_window.check
  vector_window.addresses <== literal(Vec(2, Bits(64)), 0)
  vector_window.translation.request.ready <== !invalidate
  vector_window.translation.response.valid <== vector_window.translation.request.fire()
  def empty_translation :: RiscvTranslationResult() = literal(RiscvTranslationResult(), 0)
  vector_window.translation.response.bits <== empty_translation.updated(~physical_address: vector_window.translation.request.bits.address[0..56])
  assert(!(invalidate & vector_window.owned), "superscalar_bare_vector_window_drained_before_invalidation")

  /* Bare certificates retain identity mappings; invalidation still separates admission epochs. */

  inst certificate(VectorCertificate(xlen, config.physical_map, ~bare: #true))
  vector_fast <=> certificate.check
  certificate.invalidate <== invalidate
  certificate.current <== literal(RiscvTlbLookup(), 0)
  certificate.translation.valid <== Bool(#false)
  certificate.translation.bits <== empty_translation


  /* Bare instruction translation.
     Preserve the architectural PC while reporting identity translation and PMA attributes. */

  instruction.address <== instruction.request.bits.zext(64)
  instruction.pbmt <== PageMemoryType.PMA
  instruction.resolution <== SuperscalarResolution(xlen):
    disposition: SuperscalarDisposition.Continue
    cause: dont_care(ExceptionCause)
    value: instruction.request.bits
    guest: literal(RiscvGuestFault(), 0)


  /* Identity resolution carries no page permissions or translation failure state. */

  result <== SuperscalarAddressResolution(xlen):
    known: Bool(#true)
    address: query.address.zext(64)
    pbmt: PageMemoryType.PMA
    fault: RiscvTranslationFault.None
    resolution:
      SuperscalarResolution(xlen):
        guest: literal(RiscvGuestFault(), 0)
        disposition: SuperscalarDisposition.Continue
        cause: dont_care(ExceptionCause)
        value: query.address
    execute_read: Bool(#false)
    probe_busy: Bool(#false)
    split_mask: state.pointer_masking


  /* Best-effort prefetch under the current physical context.
     Context changes cancel hints, never accepted demand or split-response ownership. */

  reg previous(RiscvTranslationState(xlen), ~init: literal(RiscvTranslationState(xlen), 0))
  previous <== state
  def flush = invalidate ||| (previous.as_bits() =/= state.as_bits())
  inst hints(ValidPipe(CachePrefetchReq(64), 1, ~flushable: #true))
  hints.flush <== flush
  prefetch |> hints.ingress
  def hint :: CachePrefetchReq(64) = hints.egress.bits
  def hint_address = hint.address.align_down(CacheLineBytes)
  def hint_region = config.physical_map.lookup(hint_address, hint_address +& Bits(64)(CacheLineBytes - 1))
  def hint_permission = mux_lookup(hint.operation, ~default: Bool(#false)):
    CachePrefetchOperation.Instruction: hint_region.executable
    CachePrefetchOperation.Read: hint_region.readable
    CachePrefetchOperation.Write: hint_region.writable

  // Bare retains its existing data-cacheability restriction, including for instruction hints.
  def hint_normal_memory = hint_region.cacheable & hint_region.read_idempotent & !hint_region.device
  def hint_permitted = hint_region.mapped & hint_normal_memory & hint_permission
  hints.egress |> filter_valid(_hint => !flush & hint_permitted) |> map_valid(hint => hint.updated(~address: hint_address)) |> physical_prefetch


/* Couples the identity circuit to its two-client transport shape and legacy Bare access policies. */
class SuperscalarIdentitySpecialization(xlen :: XLen, config :: RiscvHartCHIConfig):
  implements SuperscalarTranslationSpecialization

  /* Selects identity resolution at the requested architectural width and physical map. */
  override method circuit() :: CircuitDefinition:
    SuperscalarIdentityTranslation(xlen, config)

  /* Uses the captured architectural width for both identity resolution and adapter ports. */
  override method architectural_xlen() :: XLen:
    xlen

  /* Supplies the same physical attributes used by vector proofs and prefetch qualification. */
  override method physical_map() :: RiscvPhysicalMemoryMap:
    config.physical_map

  /* Identity resolution does not issue implicit page-table memory transactions. */
  override method page_walk_clients() :: matching(0): 0

  /* Bare fragments always use ordinary physical access, independently of unused guest inputs. */
  override method split_access_policy() :: SuperscalarSplitAccessPolicy:
    SuperscalarSplitAccessPolicy.Normal

  /* Preserves Bare's cacheable/readable atomic qualification without broadening the fast path. */
  override method atomic_pma_policy() :: SuperscalarAtomicPmaPolicy:
    SuperscalarAtomicPmaPolicy.CacheableReadable

export:
  SuperscalarIdentityTranslation
  SuperscalarIdentitySpecialization
