#lang rhodium
/* Selects Sv39 and optional guest translation for the shared RV64 superscalar memory adapter. */
// SPDX-License-Identifier: Apache-2.0

import:
  "memory-adapter.rhdl".SuperscalarMemoryAdapter
  "translation-sv39.rhdl".SuperscalarSv39Translation
  "../chi-hart.rhdl".RiscvHartCHIConfig
  lib("riscv/isa/xlen.rhm").XLen
  lib("rhodium/frontend/foundation.rhm").CircuitDefinition

/* Preserves the MMU entry point while selecting the paged resolver and its physical PTE client. */
fun SuperscalarMmu(config :: RiscvHartCHIConfig, ~svnapot: svnapot :: Boolean = #false, ~hypervisor: hypervisor :: Boolean = #true) :: CircuitDefinition:
  SuperscalarMemoryAdapter(XLen.X64, config, SuperscalarSv39Translation(config, ~svnapot: svnapot, ~hypervisor: hypervisor), ~paged: #true)

export:
  SuperscalarMmu
