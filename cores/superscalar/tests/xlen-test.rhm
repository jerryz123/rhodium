#lang rhombus
// SPDX-License-Identifier: Apache-2.0
import:
  lib("cores/rv2wide/issue.rhdl").RV2WideIssue
  lib("cores/rv3wide/issue.rhdl").RV3WideIssue
  lib("cores/rv3wide/hart.rhdl").RV3WideHart
  lib("cores/rv3wide/profile.rhm").RV3WideConfig
  "../issue.rhdl".superscalar_issue_width
  lib("riscv/rtl/trap.rhdl").ExceptionCause
  lib("cores/pc.rhdl").compact_pc_width
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/hart.rhm").RiscvMmuType
  "../superscalar.rhdl".Superscalar
  "../profile.rhm".SuperscalarPipelineConfig
  "../memory/translation-specialization.rhm" open
  "../memory/translation-identity.rhdl".SuperscalarIdentitySpecialization
  "../memory/translation-sv39.rhdl".SuperscalarSv39Specialization
  "cache-fixture.rhdl" open

fun child(parent, name):
  parent.operations.find(fun (op): op.opcode == "rtl.instance" && op.attribute("name") == name).attribute("module")

fun cache_payload_bits(port):
  port.type.field("request").type.field("bits").type.field("data").type.width

def sv39 = SuperscalarSv39Specialization(test_fetch_chi)
check:
  sv39.architectural_xlen() ~is XLen.X64
  sv39.physical_map() ~is test_fetch_chi.physical_map
  sv39.page_walk_clients() ~is 1
  sv39.split_access_policy() ~is SuperscalarSplitAccessPolicy.PreserveGuest
  sv39.atomic_pma_policy() ~is SuperscalarAtomicPmaPolicy.OrdinaryReadable
  sv39.same_stable_circuit_param(SuperscalarSv39Specialization(test_fetch_chi)) ~is #true
  sv39.same_stable_circuit_param(SuperscalarSv39Specialization(test_chi)) ~is #false
  sv39.same_stable_circuit_param(SuperscalarSv39Specialization(test_fetch_chi, #true)) ~is #false
  sv39.same_stable_circuit_param(SuperscalarSv39Specialization(test_fetch_chi, #false, #false)) ~is #false

for (xlen in [XLen.X32, XLen.X64]):
  def identity = SuperscalarIdentitySpecialization(xlen, test_fetch_chi)
  check:
    identity.architectural_xlen() ~is xlen
    identity.physical_map() ~is test_fetch_chi.physical_map
    identity.page_walk_clients() ~is 0
    identity.split_access_policy() ~is SuperscalarSplitAccessPolicy.Normal
    identity.atomic_pma_policy() ~is SuperscalarAtomicPmaPolicy.CacheableReadable
    identity.same_stable_circuit_param(SuperscalarIdentitySpecialization(xlen, test_fetch_chi)) ~is #true
    identity.same_stable_circuit_param(SuperscalarIdentitySpecialization(xlen, test_chi)) ~is #false
    identity.same_stable_circuit_param(SuperscalarIdentitySpecialization((if xlen == XLen.X32 | XLen.X64 | XLen.X32), test_fetch_chi)) ~is #false
    identity.same_stable_circuit_param(sv39) ~is #false
    sv39.same_stable_circuit_param(identity) ~is #false

  def two_issue = compile_program(elaborate(RV2WideIssue(xlen)), rtl_target).report.design.modules.find(fun (module_def): module_def.name == "RV2WideIssue")
  def three_issue = compile_program(elaborate(RV3WideIssue(xlen)), rtl_target).report.design.modules.find(fun (module_def): module_def.name == "RV3WideIssue")
  check:
    superscalar_issue_width(xlen, two_issue) ~is 2
    superscalar_issue_width(xlen, three_issue) ~is 3
    superscalar_issue_width((if xlen == XLen.X32 | XLen.X64 | XLen.X32), two_issue) ~throws "superscalar issue contract"

  def pc_width = compact_pc_width(xlen)
  def profile = SuperscalarPipelineConfig(~xlen: xlen, ~mmu_type: RiscvMmuType.Bare, ~instruction_cache: test_cache, ~data_cache: test_cache, ~ssnpm: xlen == XLen.X64, ~supm: xlen == XLen.X64, ~ras_entries: 0, ~bht: #false)
  def design = compile_program(elaborate(Superscalar(test_cache, ~chi: test_fetch_chi, ~profile: profile, ~issue: RV2WideIssue(profile.xlen))), rtl_target).report.design
  def core = design.modules.find(fun (module_def): module_def.name == "Superscalar")
  def hart_design = compile_program(elaborate(RV3WideHart(RV3WideConfig(profile), ~reset_address: 0, ~chi: test_fetch_chi)), rtl_target).report.design
  def hart = hart_design.modules.find(fun (module_def): module_def.name == "RV3WideHart")
  def wide_adapter = child(child(hart, "core"), "data")
  check:
    cache_payload_bits(child(child(core, "data"), "storage").find_input("core_in")) ~is xlen.width
    cache_payload_bits(wide_adapter.find_input("memory_in")) ~is xlen.width
    cache_payload_bits(child(wide_adapter, "storage").find_input("core_in")) ~is 128
  def memory = child(core, "mmu")
  def execution = design.modules.find(fun (module_def): module_def.name == "SuperscalarCore")
  def retired = core.find_output("retired_0_out").type.field("bits").type
  def completed = core.find_output("completed_out").type.field("bits").type
  def fetch_fault_width = 2 + ExceptionCause.packed_width() // Presence, architectural cause, and second-parcel flag.
  def step_width = if xlen == XLen.X32 | 6 | 7 // Last changed bit and short-step flag.
  def fifo = child(child(execution, "wb_load_response"), "owners")
  def queue_storage = fifo.memories.find(fun (mem): mem.name == "storage")
  def multiply = child(execution, "ex_multiply")
  def frontend = child(core, "frontend")
  def s2 = child(frontend, "s2")
  def attempt = s2.find_output("egress_out").type.field("bits").type
  check:
    retired.field("fetched").type ~is execution.find_input("instructions_in").type.field("bits").type.field("entries").type.element_type
    attempt.field("fault").type.packed_width() ~is 1 + ExceptionCause.packed_width() + xlen.width
    completed.field("identity").type.packed_width() ~is pc_width + 32
    completed.packed_width() ~is pc_width + xlen.width + 38
    queue_storage.depth ~is 4
    queue_storage.element_type.field("destination").type.field("identity").type.packed_width() ~is pc_width + 32
    multiply.find_input("issue_in").type.field("bits").type.packed_width() ~is 2 * xlen.width + 2
    multiply.find_input("authorize_in").type.field("bits").type.packed_width() ~is pc_width + 32 + 5 + 2

  for (stage in ["ex", "mem", "wb"]):
    def prefix_name = stage ++ "_pc_region"
    def prefix = execution.operations.find(fun (op): op.opcode == "rtl.register" && op.attribute("name") == prefix_name)
    def relative_name = stage ++ "_younger_next_region"
    def relative = execution.operations.find(fun (op): op.opcode == "rtl.register" && op.attribute("name") == relative_name)
    check:
      prefix.results[0].type.packed_width() ~is xlen.width - 12
      relative.results[0].type.packed_width() ~is 1

  def lanes = execution.operations.filter(~keep: fun (op): op.opcode == "rtl.instance" && op.attribute("module").name.contains("SuperscalarExecutePipe") || op.opcode == "rtl.instance" && op.attribute("module").name.contains("SuperscalarResultPipe"))
  check: lanes.length() ~is 6
  for (instance in lanes):
    def storage = child(instance.attribute("module"), "storage")
    def payload = storage.operations.find(fun (op): op.opcode == "rtl.register" && op.attribute("name") == "stage_bits").results[0].type.element_type
    def has_resolution = "resolution" in payload.fields.map(fun (field): field.name)
    def fault_width = if has_resolution | 1 | fetch_fault_width
    when has_resolution
    | check: payload.field("resolution").type.field("cause").type ~is ExceptionCause

    when has_resolution
    | check: payload.field("resolution").type.field("value").type.width ~is xlen.width

    check:
      payload.field("fetched").type.field("pc").type.width ~is 12
      payload.field("fetched").type.field("fault").type.packed_width() ~is fault_width
      payload.field("fetched").type.field("prediction").type.field("target").type.packed_width() ~is pc_width
      payload.field("fetched").type.field("sequential_pc").type.packed_width() ~is step_width

  check:
    execution.find_output("redirect_out").type.field("bits").type.field("resolution").type.field("cause").type ~is ExceptionCause
    retired.field("data").type.width ~is xlen.width
    retired.field("fetched").type.field("pc").type.packed_width() ~is pc_width
    core.find_input("start_in").type.field("bits").type.width ~is 64
    memory.find_input("state").type.field("satp").type.width ~is xlen.width
    execution.find_output("memory_out").type.field("request").type.field("bits").type.field("address").type.width ~is xlen.width
    memory.find_output("physical_memory_out").type.field("request").type.field("bits").type.field("address").type.width ~is 64
    design.modules.filter(~keep: fun (module_def): module_def.name == "RiscvTranslationWalker").length() ~is 0
