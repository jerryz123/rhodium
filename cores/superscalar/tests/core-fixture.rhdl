sync_circuit CoreFixture(profile :: SuperscalarPipelineConfig = SuperscalarPipelineConfig(), ~issue: issue :: Module || CircuitDefinition = RV2WideIssue(profile.xlen), ~fp_timing: selected_fp_timing :: FpExecutionTiming = FpExecutionTiming()):
  def xlen = profile.xlen
  def issue_width = superscalar_issue_width(xlen, issue)
  def hypervisor = profile.hypervisor
  input interrupts: RiscvInterrupts()
  input hart_id: Bits(64)
  input time_counter: Bits(64)
  interface instructions(Decoupled(PacketObservation(xlen, hypervisor, issue_width)), ~role: consumer)
  interface resolution[issue_width](Valid(SuperscalarResolution(xlen)), ~role: consumer)
  interface memory_stage[issue_width](Valid(InstructionObservation(xlen, hypervisor)), ~role: producer)
  interface retired[issue_width](Valid(RetirementObservation(xlen, hypervisor)), ~role: producer)
  interface prefetch(Valid(CachePrefetchReq(64)), ~role: producer)
  interface redirect(Valid(SuperscalarRedirect(xlen)), ~role: producer)
  interface fetch_flush(Pulse(), ~role: producer)
  interface instruction_invalidate(Pulse(), ~role: producer)
  interface branch_update(Valid(BranchUpdate(xlen)), ~role: producer)
  interface predictor_restore(Pulse(), ~role: producer)
  interface predictor_clear(Pulse(), ~role: producer)
  interface direction_update(Valid(TournamentUpdate(10)), ~role: producer)
  interface ras_resolution(Valid(RasResolution(xlen)), ~role: producer)
  interface history_commit(Valid(SuperscalarHistoryCommit(issue_width)), ~role: producer)
  interface history_restore(Valid(Bits(10)), ~role: producer)
  interface memory(SuperscalarMemory(xlen, xlen.width, SuperscalarMemoryContext(xlen, profile.vector_completion_slots)), ~role: requester)
  interface split(RiscvSplitAccess(xlen, Bool), ~role: requester)
  output split_guest_access: RiscvGuestMemoryAccess
  interface pipeline(SuperscalarPipelineAccess(xlen), ~role: requester)
  interface completed(Valid(SuperscalarCompletion(xlen)), ~role: producer)
  output issued: Bits(2)
  output retired_count: Bits(2)
  output instruction_capacity: Bits(4)
  output sleeping: Bool
  output translation_state: RiscvTranslationState(xlen)
  output translation_flush: Bool
  interface vector_precheck(VectorPrecheck(), ~role: requester)
  interface vector_fast(VectorFastCheck(xlen), ~role: requester)
  output(pipeline_vector, request_vector): Bool

  inst core(SuperscalarCore(profile, ~issue: issue, ~fp_timing: selected_fp_timing))
  def packet :: PacketObservation(xlen, hypervisor, issue_width) = instructions.bits
  (instructions |> map_flow(_packet => packet.captured(instructions.valid & core.instructions.ready))) |> core.instructions
  for (lane in 0..issue_width):
    (core.memory_stage[lane] |> map_valid(token => observe_instruction(xlen, hypervisor, token))) |> memory_stage[lane]
    (core.retired[lane] |> map_valid(token => observe_retirement(xlen, hypervisor, token))) |> retired[lane]

  core.interrupts <== interrupts
  core.hart_id <== hart_id
  core.time_counter <== time_counter
  for (lane in 0..issue_width):
    core.resolution[lane] <=> resolution[lane]

  core.prefetch <=> prefetch
  core.redirect <=> redirect
  core.fetch_flush <=> fetch_flush
  core.instruction_invalidate <=> instruction_invalidate
  core.branch_update <=> branch_update
  core.predictor_restore <=> predictor_restore
  core.predictor_clear <=> predictor_clear
  core.direction_update <=> direction_update
  core.ras_resolution <=> ras_resolution
  core.history_commit <=> history_commit
  core.history_restore <=> history_restore
  core.memory <=> memory
  core.split <=> split
  split_guest_access <== core.split_guest_access
  core.pipeline <=> pipeline
  core.completed <=> completed
  issued <== core.issued
  retired_count <== core.retired_count
  instruction_capacity <== core.instruction_capacity
  sleeping <== core.sleeping
  translation_state <== core.translation_state
  translation_flush <== core.translation_flush
  core.vector_precheck <=> vector_precheck
  core.vector_fast <=> vector_fast

  pipeline_vector <== core.pipeline_vector
  request_vector <== core.request_vector

export CoreFixture
