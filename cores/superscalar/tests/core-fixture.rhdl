sync_circuit CoreFixture(profile :: SuperscalarPipelineConfig = SuperscalarPipelineConfig(), ~issue: issue :: Module || CircuitDefinition = RV2WideIssue(profile.xlen), ~vector_backend: vector_backend :: VectorBackendKind = VectorBackendKind.Unified, ~fp_timing: selected_fp_timing :: FpExecutionTiming = FpExecutionTiming(), ~owns_translation_epoch: owns_translation_epoch :: Boolean = #false, ~fetch_collision: fetch_config :: maybe(RiscvHartCHIConfig) = #false):
  def xlen = profile.xlen
  def issue_width = superscalar_issue_width(xlen, issue)
  def hypervisor = profile.hypervisor
  input interrupts: RiscvInterrupts()
  input hart_id: Bits(64)
  input time_counter: Bits(64)
  interface instructions(Decoupled(PacketObservation(xlen, hypervisor, issue_width)), ~role: consumer)
  interface resolution[issue_width](Valid(SuperscalarResolution(xlen)), ~role: consumer)
  interface memory_stage[issue_width](Valid(InstructionObservation(xlen, hypervisor)), ~role: producer)
  interface retired[issue_width](Valid(RetirementObservation(xlen, hypervisor)), ~role: producer)
  interface prefetch(Valid(CachePrefetchReq(64)), ~role: producer)
  interface redirect(Valid(SuperscalarRedirect(xlen)), ~role: producer)
  interface fetch_flush(Pulse(), ~role: producer)
  interface instruction_invalidate(Pulse(), ~role: producer)
  interface branch_update(Valid(BranchUpdate(xlen)), ~role: producer)
  interface predictor_restore(Pulse(), ~role: producer)
  interface predictor_clear(Pulse(), ~role: producer)
  interface direction_update(Valid(TournamentUpdate(10)), ~role: producer)
  interface ras_resolution(Valid(RasResolution(xlen)), ~role: producer)
  interface history_commit(Valid(SuperscalarHistoryCommit(issue_width)), ~role: producer)
  interface history_restore(Valid(Bits(10)), ~role: producer)
  interface memory(SuperscalarMemory(xlen, SuperscalarMemoryContext(xlen, profile.vector_completion_slots)), ~role: requester)
  interface split(RiscvSplitAccess(xlen, Bool), ~role: requester)
  output split_guest_access: RiscvGuestMemoryAccess
  interface pipeline(SuperscalarPipelineAccess(xlen), ~role: requester)
  interface completed(Valid(SuperscalarCompletion(xlen)), ~role: producer)
  output issued: Bits(2)
  output retired_count: Bits(2)
  output instruction_capacity: Bits(4)
  output sleeping: Bool
  output translation_state: RiscvTranslationState(xlen)
  output translation_flush: Bool
  interface vector_precheck(VectorPrecheck(), ~role: requester)
  interface vector_fast(VectorFastCheck(xlen), ~role: requester)
  output(pipeline_vector, request_vector): Bool

  output local_epoch: Bool
  local_epoch <== Bool(owns_translation_epoch)
  inst core(SuperscalarCore(profile, ~issue: issue, ~fp_timing: selected_fp_timing, ~vector_backend: vector_backend, ~owns_translation_epoch: owns_translation_epoch))
  if vector_profile_enabled(profile.vector) && (vector_backend == VectorBackendKind.Distributed)
  | block:
      interface row_memory(VectorRowMemory(vector_dlen(profile.vector_length)), ~role: requester)
      core.row_memory <=> row_memory
      interface element_translation(VectorElementTranslation(), ~role: requester)
      core.element_translation <=> element_translation
      core.window_pages <== literal(VectorWindowPages, 0)
  | #void
  def packet :: PacketObservation(xlen, hypervisor, issue_width) = instructions.bits
  (instructions |> map_flow(_packet => packet.captured(instructions.valid & core.instructions.ready))) |> core.instructions
  for (lane in 0..issue_width):
    (core.memory_stage[lane] |> map_valid(token => observe_instruction(xlen, hypervisor, token))) |> memory_stage[lane]
    (core.retired[lane] |> map_valid(token => observe_retirement(xlen, hypervisor, token))) |> retired[lane]

  core.interrupts <== interrupts
  core.hart_id <== hart_id
  core.time_counter <== time_counter
  for (lane in 0..issue_width):
    core.resolution[lane] <=> resolution[lane]

  core.prefetch <=> prefetch
  core.redirect <=> redirect
  core.fetch_discard <=> fetch_flush
  if fetch_config
  | block:
      // Issue a real MEM jump or WB fence independently of the frontend's S1/S2 pair.
      inst fetch(SuperscalarFrontend(fetch_config, profile, ~group_width: issue_width))
      inst resolve(SuperscalarSv39Translation(fetch_config, ~hypervisor: #false))
      inst router(InstructionMemoryRouter(64, 64, ~executable_address_width: fetch_config.physical_map.executable_address_width))
      interface fetch_start(Valid(Bits(64)), ~role: consumer)
      interface array_lookup(Decoupled(Bits(64)), ~role: producer)
      interface pte(RiscvTranslationMemory(), ~role: requester)
      input prime: Bool
      input physical_replay: Bool
      input cache_word: Bits(64)
      output(s1_live, s1_miss, s1_discard, s2_physical, fetch_packet): Bool
      output s1_address: Bits(64)
      output fetched_instruction: Bits(32)
      fetch_start |> fetch.start
      core.redirect |> fetch.redirect
      core.fetch_discard |> fetch.discard
      core.instruction_invalidate |> fetch.invalidate
      core.branch_update |> fetch.branch_update
      core.predictor_restore |> fetch.predictor_restore
      core.predictor_clear |> fetch.predictor_clear
      core.direction_update |> fetch.direction_update
      core.ras_resolution |> fetch.ras_resolution
      core.history_commit |> fetch.history_commit
      core.history_restore |> fetch.history_restore
      fetch.virtual_lookup |> array_lookup
      fetch.instructions.ready <== Bool(#true)
      fetch_packet <== fetch.instructions.valid
      fetched_instruction <== fetch.instructions.bits.entries[0].instruction
      fetch.memory <=> router.core
      reg physical(~init: Bool(#false))
      physical <== router.cache.request.valid
      s2_physical <== physical
      router.cache.demand_present <== physical
      router.cache.response.valid <== physical & !router.cache.flush & !router.cache.invalidate_all
      router.cache.response.bits.data <== cache_word
      router.cache.response.bits.access_fault <== Bool(#false)
      router.cache.response.bits.replay <== physical_replay
      router.uncached.request.ready <== Bool(#false)
      router.uncached.response.valid <== Bool(#false)
      router.uncached.response.bits <== literal(router.uncached.response.bits.type, 0)

      resolve.instruction.request.valid <== prime ||| fetch.translation.request.valid
      resolve.instruction.request.bits <== mux(prime, Bits(64)(0x1ff8), fetch.translation.request.bits)
      resolve.instruction.discard <== !prime & fetch.translation.discard
      fetch.translation.resolution <== resolve.instruction.resolution
      fetch.translation.address <== resolve.instruction.address
      fetch.translation.pbmt <== resolve.instruction.pbmt
      s1_live <== fetch.translation.request.valid
      s1_address <== fetch.translation.request.bits
      s1_miss <== resolve.instruction.resolution.disposition === SuperscalarDisposition.Replay
      s1_discard <== fetch.translation.discard
      resolve.pte <=> pte
      def empty_state :: RiscvTranslationState(xlen) = literal(RiscvTranslationState(xlen), 0)
      resolve.state <== empty_state.updated(~privilege: PrivilegeMode.Supervisor, ~satp: Bits(64)(0x8000000000000003))
      resolve.invalidate <== Bool(#false)
      resolve.query <== literal(SuperscalarTranslationQuery(xlen), 0)
      resolve.pipeline_vector <== Bool(#false)
      resolve.request_vector <== Bool(#false)
      resolve.vector_fast.request.valid <== Bool(#false)
      resolve.vector_fast.request.bits <== literal(VectorRange(), 0)
      resolve.vector_fast.candidate <== literal(VectorFastCertificate(xlen), 0)
      resolve.vector_fast.pipeline_physical <== Bool(#false)
      resolve.vector_fast.request_physical <== Bool(#false)
      resolve.vector_precheck.request.valid <== Bool(#false)
      resolve.vector_precheck.request.bits <== literal(VectorRange(), 0)
      resolve.vector_precheck.release.valid <== Bool(#false)
      resolve.vector_precheck.response.ready <== Bool(#true)
      resolve.prefetch.valid <== Bool(#false)
      resolve.prefetch.bits <== literal(CachePrefetchReq(64), 0)
  | #void
  core.instruction_invalidate <=> instruction_invalidate
  core.branch_update <=> branch_update
  core.predictor_restore <=> predictor_restore
  core.predictor_clear <=> predictor_clear
  core.direction_update <=> direction_update
  core.ras_resolution <=> ras_resolution
  core.history_commit <=> history_commit
  core.history_restore <=> history_restore
  core.memory <=> memory
  core.split <=> split
  split_guest_access <== core.split_guest_access
  core.pipeline <=> pipeline
  core.completed <=> completed
  issued <== core.issued
  retired_count <== core.retired_count
  instruction_capacity <== core.instruction_capacity
  sleeping <== core.sleeping
  translation_state <== core.translation_state
  translation_flush <== core.translation_flush
  core.vector_precheck <=> vector_precheck
  core.vector_fast <=> vector_fast

  pipeline_vector <== core.pipeline_vector
  request_vector <== core.request_vector

export CoreFixture
