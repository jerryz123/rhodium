#lang rhombus
// Checks Superscalar configuration selection, ISA publication, and invalid subset combinations.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("riscv/isa/vector-profile.rhm") open
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/hart.rhm").RiscvMmuType
  "../profile.rhm" open
  "../udb.rhm" open
  lib("cores/rv2wide/profile.rhm").RV2WideConfig
  lib("cores/rv3wide/profile.rhm").RV3WideConfig
  lib("cores/rv2wide/udb.rhm").rv2wide_udb_configuration
  lib("cores/rv3wide/udb.rhm").rv3wide_udb_configuration
  lib("riscv/isa/fp-profile.rhm") open
  lib("riscv/isa/c.rhm") open
  lib("cores/cache/config.rhm").CacheConfig

def configured_shared = SuperscalarPipelineConfig(
    ~instruction_cache: CacheConfig(16, 2), ~data_cache: CacheConfig(32, 2),
    ~btb_entries: 16, ~ras_entries: 4, ~bht: #false,
    ~floating_point: FloatingPointProfile.D, ~half_precision: HalfPrecisionProfile.Zfh, ~zfa: #true,
    ~compressed: compressed_extensions(CompressedExtension.C, CompressedExtension.Zcb, CompressedExtension.Zcmop),
    ~zicboz: #true, ~zicbom: #true, ~zicbop: #true, ~zawrs: #true, ~zihintpause: #true, ~zihintntl: #true,
    ~sstc: #true, ~svnapot: #true, ~svpbmt: #true, ~svinval: #true,
    ~ssnpm: #true, ~supm: #true, ~sscofpmf: #true, ~smstateen: #true, ~hypervisor: #true,
    ~vector: VectorProfile.V, ~vector_extensions: [VectorExtension.Zvfh, VectorExtension.Zvbb],
    ~ziccif: #true, ~ziccamoa: #true, ~ziccrse: #true,
    ~vector_length: 256, ~vector_completion_slots: 16, ~vector_dispatch_depth: 4
  )

for (named in [RV2WideConfig(configured_shared), RV3WideConfig(configured_shared)]):
  check:
    named.pipeline ~is configured_shared
    named.isa_profile ~is configured_shared.isa_profile
    named.csr_config ~is configured_shared.csr_config
    named.hart_description ~is configured_shared.hart_description
    named.pipeline.execution_half_precision ~is configured_shared.execution_half_precision

def integer = SuperscalarPipelineConfig()
def integer32 = SuperscalarPipelineConfig(~xlen: XLen.X32)
def bare64 = SuperscalarPipelineConfig(~mmu_type: RiscvMmuType.Bare)
check:
  RV2WideConfig().pipeline ~is integer
  RV3WideConfig().pipeline ~is integer
  RV3WideConfig(integer32).pipeline ~is integer32
  (RV2WideConfig() is_a RV3WideConfig) ~is #false
  (RV3WideConfig() is_a RV2WideConfig) ~is #false
  rv3wide_udb_configuration(RV3WideConfig(), "shared", "Shared two-wide pipeline", 44) ~is rv2wide_udb_configuration(RV2WideConfig(), "shared", "Shared two-wide pipeline", 44)
  integer.vector_dispatch_depth ~is 6
  SuperscalarPipelineConfig(~vector_dispatch_depth: 1).vector_dispatch_depth ~is 1
  SuperscalarPipelineConfig(~vector_dispatch_depth: 4).vector_dispatch_depth ~is 4
  SuperscalarPipelineConfig(~vector_dispatch_depth: 8).vector_dispatch_depth ~is 8
  SuperscalarPipelineConfig(~vector_dispatch_depth: 0) ~throws "PosInt"
  integer32.xlen ~is XLen.X32
  integer32.hart_description.mmu_type ~is RiscvMmuType.Bare
  integer32.csr_config.mmu_type ~is RiscvMmuType.Bare
  integer32.isa_profile.isa_extensions.contains("ssu64xl") ~is #false
  bare64.hart_description.mmu_type ~is RiscvMmuType.Bare
  bare64.isa_profile.isa_extensions ~is integer.isa_profile.isa_extensions.filter(~keep: fun (name): name != "ssccptr")
  integer.hart_description.mmu_type ~is RiscvMmuType.Sv39
  SuperscalarPipelineConfig(~xlen: XLen.X32, ~mmu_type: RiscvMmuType.Sv39) ~throws "Bare or RV64 Sv39"
  SuperscalarPipelineConfig(~xlen: XLen.X32, ~floating_point: FloatingPointProfile.D) ~throws "disabled FP, RV32F, or RV64D"
  SuperscalarPipelineConfig(~xlen: XLen.X32, ~hypervisor: #true) ~throws "RV32 supports Bare execution"
  SuperscalarPipelineConfig(~mmu_type: RiscvMmuType.Bare, ~svpbmt: #true) ~throws "translation extensions require Sv39"

def supervisor = SuperscalarPipelineConfig(~ssnpm: #true, ~supm: #true, ~sscofpmf: #true, ~smstateen: #true)
def hypervisor = SuperscalarPipelineConfig(~hypervisor: #true)
def sha = SuperscalarPipelineConfig(~hypervisor: #true, ~smstateen: #true, ~ssnpm: #true, ~supm: #true, ~sscofpmf: #true, ~sstc: #true, ~svinval: #true)
def zero = SuperscalarPipelineConfig(~zicboz: #true)
def management = SuperscalarPipelineConfig(~zicbom: #true)
def cmo = SuperscalarPipelineConfig(~zicboz: #true, ~zicbom: #true)
def prefetch = SuperscalarPipelineConfig(~zicbop: #true)
def wait = SuperscalarPipelineConfig(~zawrs: #true)
def pause = SuperscalarPipelineConfig(~zihintpause: #true)
def locality = SuperscalarPipelineConfig(~zihintntl: #true)
def timer = SuperscalarPipelineConfig(~sstc: #true)
def pbmt = SuperscalarPipelineConfig(~svpbmt: #true)
def pbmt_napot = SuperscalarPipelineConfig(~svpbmt: #true, ~svnapot: #true, ~floating_point: FloatingPointProfile.D)
def invalidation = SuperscalarPipelineConfig(~svinval: #true)
def invalidation_fp = SuperscalarPipelineConfig(~svinval: #true, ~svnapot: #true, ~svpbmt: #true, ~floating_point: FloatingPointProfile.D)
def napot = SuperscalarPipelineConfig(~svnapot: #true)
def napot_fp = SuperscalarPipelineConfig(~svnapot: #true, ~floating_point: FloatingPointProfile.D)
def double = SuperscalarPipelineConfig(~floating_point: FloatingPointProfile.D)
def single = SuperscalarPipelineConfig(~xlen: XLen.X32, ~floating_point: FloatingPointProfile.F)
def vector32fp = SuperscalarPipelineConfig(~xlen: XLen.X32, ~floating_point: FloatingPointProfile.F, ~vector: VectorProfile.Zve32f, ~vector_length: 64, ~vector_extensions: [VectorExtension.Zvbb])
check:
  single.isa_profile.misa_extension_bits ~is integer32.isa_profile.misa_extension_bits + 32
  single.csr_config.floating_point ~is FloatingPointProfile.F
  vector32fp.isa_profile.isa_extensions.contains("zve32f") ~is #true
  vector32fp.isa_profile.isa_extensions.contains("d") ~is #false
  superscalar_udb_configuration(single, "rv32f", "RV32F", 32).to_yaml().contains("  MUTABLE_MISA_F: false") ~is #true
  superscalar_udb_configuration(single, "rv32f", "RV32F", 32).to_yaml().contains("MUTABLE_MISA_D") ~is #false

def vector64 = SuperscalarPipelineConfig(~floating_point: FloatingPointProfile.D, ~vector: VectorProfile.V)
def vector_half_min = SuperscalarPipelineConfig(~floating_point: FloatingPointProfile.D, ~vector: VectorProfile.V, ~vector_extensions: [VectorExtension.Zvfhmin])
def vector_half = SuperscalarPipelineConfig(~floating_point: FloatingPointProfile.D, ~half_precision: HalfPrecisionProfile.Zfhmin, ~vector: VectorProfile.V, ~vector_extensions: [VectorExtension.Zvfh, VectorExtension.Zvbb])
def vector32 = SuperscalarPipelineConfig(~xlen: XLen.X32, ~vector: VectorProfile.Zve32x, ~vector_length: 64, ~vector_extensions: [VectorExtension.Zvbb])
check:
  vector64.isa_profile.isa_extensions.contains("v") ~is #true
  vector64.csr_config.vector ~is VectorProfile.V
  vector64.execution_half_precision ~is HalfPrecisionProfile.None
  vector_half_min.execution_half_precision ~is HalfPrecisionProfile.Zfhmin
  vector_half_min.isa_profile.isa_extensions.contains("zvfhmin") ~is #true
  vector_half_min.half_precision ~is HalfPrecisionProfile.None
  vector_half.execution_half_precision ~is HalfPrecisionProfile.Zfh
  vector_half.half_precision ~is HalfPrecisionProfile.Zfhmin
  vector_half.isa_profile.isa_extensions.contains("zvfh") ~is #true
  vector_half.isa_profile.isa_extensions.contains("zfh") ~is #false
  SuperscalarPipelineConfig(~floating_point: FloatingPointProfile.D, ~vector: VectorProfile.V, ~vector_extensions: [VectorExtension.Zvfh]) ~throws "Zvfh requires scalar Zfhmin or Zfh"
  vector32.isa_profile.isa_extensions.contains("zve32x") ~is #true
  vector32.csr_config.vector_length ~is 64
  vector32.isa_profile.isa_extensions.contains("zvbb") ~is #true
  vector32.isa_profile.isa_extensions.contains("zvkt") ~is #true
  SuperscalarPipelineConfig(~vector: VectorProfile.V) ~throws "require scalar D"
  SuperscalarPipelineConfig(~xlen: XLen.X32, ~vector: VectorProfile.Zve64x) ~throws "64-bit vector elements require RV64"
  SuperscalarPipelineConfig(~vector: VectorProfile.Zve64x, ~vector_length: 64) ~throws "two XLEN rows"

def zfa = SuperscalarPipelineConfig(~floating_point: FloatingPointProfile.D, ~zfa: #true)
def half_min = SuperscalarPipelineConfig(~floating_point: FloatingPointProfile.D, ~half_precision: HalfPrecisionProfile.Zfhmin)
def half = SuperscalarPipelineConfig(~floating_point: FloatingPointProfile.D, ~half_precision: HalfPrecisionProfile.Zfh, ~zfa: #true)
def zcb = SuperscalarPipelineConfig(~compressed: compressed_extensions(CompressedExtension.C, CompressedExtension.Zcb))
def zcmop = SuperscalarPipelineConfig(~compressed: compressed_extensions(CompressedExtension.C, CompressedExtension.Zcmop))
def compressed_fp = SuperscalarPipelineConfig(~floating_point: FloatingPointProfile.D, ~compressed: compressed_extensions(CompressedExtension.C, CompressedExtension.Zcb, CompressedExtension.Zcmop))

check:
  supervisor.csr_config.ssnpm ~is #true
  supervisor.csr_config.sscofpmf ~is #true
  supervisor.csr_config.smstateen ~is #true
  sha.csr_config.hypervisor ~is #true
  SuperscalarPipelineConfig(~supm: #true) ~throws "Supm requires Ssnpm"
  supervisor.isa_profile.isa_extensions.sort() ~is (integer.isa_profile.isa_extensions ++ ["ssnpm", "supm", "sscofpmf", "smstateen", "ssstateen"]).sort()
  hypervisor.isa_profile.misa_extension_bits ~is integer.isa_profile.misa_extension_bits + 128
  sha.isa_profile.isa_extensions.contains("sha") ~is #true
  integer.svinval ~is #false
  invalidation.isa_profile.isa_extensions.sort() ~is (integer.isa_profile.isa_extensions ++ ["svinval"]).sort()
  invalidation_fp.isa_profile.isa_extensions.sort() ~is (pbmt_napot.isa_profile.isa_extensions ++ ["svinval"]).sort()
  invalidation.isa_profile.misa_extension_bits ~is integer.isa_profile.misa_extension_bits
  invalidation.hart_description.isa_profile ~is invalidation.isa_profile
  invalidation.csr_config.isa_profile ~is invalidation.isa_profile
  integer.svpbmt ~is #false
  integer.csr_config.svpbmt ~is #false
  pbmt.csr_config.svpbmt ~is #true
  pbmt.isa_profile.isa_extensions.sort() ~is (integer.isa_profile.isa_extensions ++ ["svpbmt"]).sort()
  pbmt_napot.isa_profile.isa_extensions.sort() ~is (double.isa_profile.isa_extensions ++ ["svnapot", "svpbmt"]).sort()
  pbmt.hart_description.isa_profile ~is pbmt.isa_profile
  pbmt.csr_config.isa_profile ~is pbmt.isa_profile
  pbmt.isa_profile.misa_extension_bits ~is integer.isa_profile.misa_extension_bits
  integer.svnapot ~is #false
  napot.isa_profile.isa_extensions.sort() ~is (integer.isa_profile.isa_extensions ++ ["svnapot"]).sort()
  napot_fp.isa_profile.isa_extensions.sort() ~is (double.isa_profile.isa_extensions ++ ["svnapot"]).sort()
  napot.isa_profile.misa_extension_bits ~is integer.isa_profile.misa_extension_bits
  napot.hart_description.isa_profile ~is napot.isa_profile
  napot.csr_config.isa_profile ~is napot.isa_profile
  timer.isa_profile.isa_extensions.sort() ~is (integer.isa_profile.isa_extensions ++ ["sstc"]).sort()
  timer.isa_profile.misa_extension_bits ~is integer.isa_profile.misa_extension_bits
  timer.csr_config.sstc ~is #true
  integer.csr_config.sstc ~is #false
  locality.isa_profile.isa_extensions.sort() ~is (integer.isa_profile.isa_extensions ++ ["zihintntl"]).sort()
  locality.isa_profile.misa_extension_bits ~is integer.isa_profile.misa_extension_bits
  pause.isa_profile.isa_extensions.sort() ~is (integer.isa_profile.isa_extensions ++ ["zihintpause"]).sort()
  pause.isa_profile.misa_extension_bits ~is integer.isa_profile.misa_extension_bits
  wait.isa_profile.isa_extensions.sort() ~is (integer.isa_profile.isa_extensions ++ ["zawrs"]).sort()
  wait.isa_profile.misa_extension_bits ~is integer.isa_profile.misa_extension_bits
  integer.bht ~is #true
  SuperscalarPipelineConfig(~bht: #false).bht ~is #false
  SuperscalarPipelineConfig(~bht: #false).isa_profile ~is integer.isa_profile
  prefetch.isa_profile.isa_extensions.sort() ~is (integer.isa_profile.isa_extensions ++ ["zicbop"]).sort()
  prefetch.isa_profile.misa_extension_bits ~is integer.isa_profile.misa_extension_bits
  management.isa_profile.isa_extensions.sort() ~is (integer.isa_profile.isa_extensions ++ ["zicbom"]).sort()
  management.csr_config.zicbom ~is #true
  management.csr_config.zicboz ~is #false
  management.isa_profile.misa_extension_bits ~is integer.isa_profile.misa_extension_bits
  cmo.isa_profile.isa_extensions.sort() ~is (integer.isa_profile.isa_extensions ++ ["zicboz", "zicbom"]).sort()
  zero.isa_profile.isa_extensions.sort() ~is (integer.isa_profile.isa_extensions ++ ["zicboz"]).sort()
  zero.isa_profile.misa_extension_bits ~is integer.isa_profile.misa_extension_bits
  zero.csr_config.zicboz ~is #true
  zero.hart_description.cbo_block_bytes ~is 64
  integer.zfa ~is #false
  double.zfa ~is #false
  integer.isa_profile.isa_extensions.contains("zfa") ~is #false
  double.isa_profile.isa_extensions.contains("zfa") ~is #false
  zfa.isa_profile.isa_extensions.sort() ~is (double.isa_profile.isa_extensions ++ ["zfa"]).sort()
  zfa.isa_profile.misa_extension_bits ~is double.isa_profile.misa_extension_bits
  zfa.hart_description.isa_profile ~is zfa.isa_profile
  SuperscalarPipelineConfig(~zfa: #true) ~throws "disabled FP, RV32F, or RV64D"
  double.half_precision ~is HalfPrecisionProfile.None
  half_min.isa_profile.isa_extensions.sort() ~is (double.isa_profile.isa_extensions ++ ["zfhmin"]).sort()
  half.isa_profile.isa_extensions.sort() ~is (zfa.isa_profile.isa_extensions ++ ["zfh"]).sort()
  half.isa_profile.misa_extension_bits ~is double.isa_profile.misa_extension_bits
  half.hart_description.isa_profile ~is half.isa_profile
  SuperscalarPipelineConfig(~half_precision: HalfPrecisionProfile.Zfhmin) ~throws "disabled FP, RV32F, or RV64D"
  SuperscalarPipelineConfig(~half_precision: HalfPrecisionProfile.Zfh) ~throws "disabled FP, RV32F, or RV64D"
  integer.compressed ~is CCompressedExtensions
  zcb.isa_profile.isa_extensions.sort() ~is (integer.isa_profile.isa_extensions ++ ["zcb"]).sort()
  zcmop.isa_profile.isa_extensions.sort() ~is (integer.isa_profile.isa_extensions ++ ["zcmop"]).sort()
  compressed_fp.isa_profile.isa_extensions.sort() ~is (double.isa_profile.isa_extensions ++ ["zcb", "zcmop"]).sort()
  zcb.isa_profile.misa_extension_bits ~is integer.isa_profile.misa_extension_bits
  compressed_fp.isa_profile.misa_extension_bits ~is double.isa_profile.misa_extension_bits
  compressed_fp.csr_config.compressed ~is compressed_fp.compressed
  compressed_fp.hart_description.isa_profile ~is compressed_fp.isa_profile
  SuperscalarPipelineConfig(~compressed: []) ~throws "requires C"
  SuperscalarPipelineConfig(~compressed: [CompressedExtension.Zca, CompressedExtension.Zcb]) ~throws "requires C"
  SuperscalarPipelineConfig(~compressed: [CompressedExtension.Zcb]) ~throws "requires Zca or C"
  SuperscalarPipelineConfig(~compressed: [CompressedExtension.C, CompressedExtension.Zcb, CompressedExtension.Zcb]) ~throws "duplicate"
  SuperscalarPipelineConfig(~compressed: [CompressedExtension.C, CompressedExtension.Zcd]) ~throws "already supplies"

for (profile in [single, vector32fp, vector32, vector64, vector_half_min, vector_half, integer32, bare64, supervisor, hypervisor, sha, integer, zero, management, cmo, prefetch, wait, pause, locality, timer, invalidation, invalidation_fp, napot, napot_fp, pbmt, pbmt_napot, double, zfa, half_min, half, zcb, zcmop, compressed_fp]):
  def configuration = superscalar_udb_configuration(profile, "rv2wide-test", "Superscalar profile contract", if profile.xlen == XLen.X32 | 32 | 44)
  def extensions = configuration.extensions.map(fun (extension): extension.name)
  check:
    configuration.parameters.filter(~keep: fun (parameter): parameter.name == "MXLEN").map(fun (parameter): parameter.value.to_yaml()) ~is [to_string(profile.xlen.width)]
    extensions.contains("Sv39") ~is (profile.mmu_type == RiscvMmuType.Sv39)
    extensions.contains("Svade") ~is (profile.mmu_type != RiscvMmuType.Bare)
    configuration.parameters.filter(~keep: fun (parameter): parameter.name == "TRAP_ON_SFENCE_VMA_WHEN_SATP_MODE_IS_READ_ONLY").map(fun (parameter): parameter.value.to_yaml()) ~is (if profile.mmu_type == RiscvMmuType.Bare | ["false"] | [])
    configuration.parameters.filter(~keep: fun (parameter): parameter.name == "FORCE_UPGRADE_CBO_INVAL_TO_FLUSH").map(fun (parameter): parameter.value.to_yaml()) ~is (if profile.zicbom | ["false"] | [])
    extensions.contains("Ssnpm") ~is profile.ssnpm
    extensions.contains("Supm") ~is profile.supm
    extensions.contains("Sscofpmf") ~is profile.sscofpmf
    extensions.contains("Smstateen") ~is profile.smstateen
    extensions.contains("Ssstateen") ~is profile.smstateen
    extensions.contains("H") ~is profile.hypervisor
    extensions.contains("Sha") ~is (profile.hypervisor && profile.smstateen)
    extensions.contains("Svinval") ~is profile.svinval
    configuration.extensions.filter(~keep: fun (extension): extension.name == "Svinval").map(fun (extension): extension.version) ~is (if profile.svinval | ["1.0.0"] | [])
    extensions.contains("Svpbmt") ~is profile.svpbmt
    configuration.extensions.filter(~keep: fun (extension): extension.name == "Svpbmt").map(fun (extension): extension.version) ~is (if profile.svpbmt | ["1.0.0"] | [])
    extensions.contains("Svnapot") ~is profile.svnapot
    configuration.extensions.filter(~keep: fun (extension): extension.name == "Svnapot").map(fun (extension): extension.version) ~is (if profile.svnapot | ["1.0.0"] | [])
    extensions.contains("Sstc") ~is profile.sstc
    extensions.contains("Zihintntl") ~is profile.zihintntl
    extensions.contains("Zihintpause") ~is profile.zihintpause
    extensions.contains("Zawrs") ~is profile.zawrs
    extensions.contains("Zicbop") ~is profile.zicbop
    extensions.contains("Zicbom") ~is profile.zicbom
    extensions.contains("Zicboz") ~is profile.zicboz
    extensions.contains("Zfa") ~is profile.zfa
    extensions.contains("F") ~is floating_point_supports_f(profile.floating_point)
    extensions.contains("D") ~is (profile.floating_point == FloatingPointProfile.D)
    extensions.contains("Zfhmin") ~is half_precision_supports_zfhmin(profile.half_precision)
    extensions.contains("Zfh") ~is half_precision_supports_zfh(profile.half_precision)
    extensions.contains("Zcb") ~is profile.compressed.contains(CompressedExtension.Zcb)
    extensions.contains("Zcmop") ~is profile.compressed.contains(CompressedExtension.Zcmop)
    extensions.contains("C") ~is #true
    extensions.contains("Zcd") ~is (profile.floating_point == FloatingPointProfile.D)
    extensions.contains("Zcf") ~is (profile.xlen == XLen.X32 && floating_point_supports_f(profile.floating_point))

  check:
    configuration.extensions.filter(~keep: fun (extension): extension.name == "Zfa").map(fun (extension): extension.version) ~is (if profile.zfa | ["1.0.0"] | [])

def wait_configuration = superscalar_udb_configuration(wait, "rv2wide-wait", "Superscalar reservation waits", 44)
def timer_configuration = superscalar_udb_configuration(timer, "rv2wide-timer", "Superscalar supervisor timer", 44)
check:
  timer_configuration.extensions.filter(~keep: fun (extension): extension.name == "Sstc").map(fun (extension): extension.version) ~is ["1.0.0"]
  wait_configuration.parameters.filter(~keep: fun (parameter): parameter.name == "ZAWRS_NTO_IS_NOP").map(fun (parameter): parameter.value.to_yaml()) ~is ["false"]
