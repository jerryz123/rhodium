import:
  "../vector.rhdl" open
  "../bundles.rhdl" open
  lib("cores/common/vector/bundles.rhdl") open
  lib("cores/common/vector/tests/decode.rhdl") open
  lib("cores/common/mmu/vector.rhdl") open
  lib("cores/common/misaligned-access.rhdl") open
  lib("riscv/isa/xlen.rhm") open
  lib("riscv/rtl/vector.rhdl") open
  lib("riscv/rtl/pointer-masking.rhdl") open
  lib("hardfloat/main.rhdl").RoundingMode
  lib("flow/main.rhdl") open

sync_circuit SuperscalarVectorFixture():
  def xlen = XLen.X64
  input instruction: Bits(32)
  input(vl, vtype, scalar, pc): Bits(64)
  input(request_valid, certificate_valid, precheck_safe): Bool
  interface pipeline(SuperscalarPipelineAccess(xlen), ~role: requester)
  interface memory(SuperscalarMemory(xlen, 64), ~role: requester)
  interface split(RiscvSplitAccess(xlen, Bool), ~role: requester)
  output(request_ready, active, sequencing, loads_pending, stores_pending, checking, released, done): Bool
  output(outcome_valid, fault_start_valid): Bool
  output(outcome_pc, fault_address, fault_cause, fault_start): Bits(64)
  output disposition: VectorDisposition
  output(scalar_valid, scalar_reserve): Bool
  output scalar_delay: Bits(4)
  output scalar_rd: Bits(5)
  output scalar_data: Bits(64)
  inst decode(VectorTestDecoder())
  inst vector(SuperscalarVectorPipeline(xlen, 128, ~vector_completion_slots: 4))
  def empty_certificate :: VectorFastCertificate(xlen) = literal(VectorFastCertificate(xlen), 0)
  def certified_range = VectorRange():
    first: scalar & !Bits(64)(0xfff)
    last: scalar ||| Bits(64)(0xfff)
    store: decode.control.store

  decode.instruction <== instruction
  vector.request.valid <== request_valid
  vector.request.bits <== VectorDescriptor(xlen):
    pc: pc
    precertified: certificate_valid
    certificate: empty_certificate.updated(~ppn: scalar[12..56], ~range: certified_range)
    instruction: instruction
    state:
      RiscvVectorState(xlen):
        vl: vl
        vtype: vtype
        vstart: Bits(64)(0)
        vxrm: Bits(2)(0)
        vxsat: Bool(#false)

    control: decode.control
    scalar: scalar
    floating_scalar: Bits(64)(0)
    stride: Bits(64)(8)
    masked: !instruction[25].into(Bool)
    rounding_mode: RoundingMode.NearEven
    pointer_masking: literal(PointerMaskControl(), 0)

  vector.pipeline <=> pipeline
  vector.memory <=> memory
  vector.split <=> split
  def proof = vector.precheck.request |> to_valid() |> map_valid(_range => precheck_safe) |> valid_pipe(1) |> to_decoupled() |> queue(1)
  proof |> vector.precheck.response
  vector.service.scalar_writeback.ready <== Bool(#true)
  vector.floating_writeback.ready <== Bool(#true)
  vector.service.fp_request.ready <== Bool(#false)
  vector.service.fp_result.valid <== Bool(#false)
  vector.service.fp_result.bits <== dont_care(vector.service.fp_result.bits.type)
  vector.service.multiply_request.ready <== Bool(#false)
  vector.service.multiply_result.valid <== Bool(#false)
  vector.service.multiply_result.bits <== dont_care(vector.service.multiply_result.bits.type)
  vector.service.divide_request.ready <== Bool(#false)
  vector.service.divide_result.valid <== Bool(#false)
  vector.service.divide_result.bits <== dont_care(vector.service.divide_result.bits.type)
  request_ready <== vector.request.ready
  active <== vector.active
  sequencing <== vector.service.sequencing
  loads_pending <== vector.service.loads_pending
  stores_pending <== vector.service.stores_pending
  checking <== vector.precheck.request.fire()
  released <== vector.precheck.release.valid
  done <== vector.service.execution_done.valid
  outcome_valid <== vector.outcome.valid
  outcome_pc <== vector.outcome.bits.pc
  disposition <== vector.outcome.bits.disposition
  fault_address <== vector.outcome.bits.fault_address
  fault_cause <== vector.outcome.bits.cause.as_bits().zext(64)
  fault_start_valid <== vector.service.fault_start.valid
  fault_start <== vector.service.fault_start.bits
  scalar_valid <== vector.service.scalar_result.valid
  scalar_data <== vector.service.scalar_result.bits.data
  scalar_rd <== vector.service.scalar_result.bits.address
  scalar_reserve <== vector.service.scalar_writeback.fire()
  scalar_delay <== vector.service.scalar_writeback.bits

export SuperscalarVectorFixture
