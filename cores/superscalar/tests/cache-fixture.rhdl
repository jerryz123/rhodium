import:
  lib("cores/common/fetch/protocol.rhdl").PhysicalInstructionReq
  "instruction-fixture.rhdl" open
  lib("riscv/isa/xlen.rhm").XLen
  "core-fixture.rhdl" open
  "../profile.rhm".SuperscalarPipelineConfig
  "../memory/attachment.rhdl" open
  "../memory/adapter.rhdl".SuperscalarMemoryAdapter
  "../memory/translation-sv39.rhdl".SuperscalarSv39Specialization
  "../bundles.rhdl" open
  "../../common/cache/config.rhm" open
  "../../common/cache/protocol.rhdl".PhysicalDataReq
  "../../common/cache/operation.rhdl".CacheOperation
  "../../common/cache-prefetch.rhdl" open
  "../../common/chi-hart.rhdl" open
  lib("rhodium/std/interconnect.rhdl").AddressSet
  lib("chi/protocol/params.rhdl").CHIFlitParams
  lib("chi/protocol/link.rhdl").CHINodeKind
  lib("chi/protocol/fabric.rhdl") open
  lib("riscv/rtl/pma.rhdl") open
  lib("riscv/rtl/svpbmt.rhdl").PageMemoryType
  lib("chi/protocol/channels.rhdl") open
  lib("flow/main.rhdl") open

def test_cache = CacheConfig(4, 2)
def test_flit = CHIFlitParams()
def test_home = CHIHomeParams("rv2wide-test-home", 1, CHINodeKind.HNF, ~max_outstanding: 2)
def test_io_home = CHIHomeParams("rv2wide-test-io", 5, CHINodeKind.HNI, ~max_outstanding: 1)
def test_chi = RiscvHartCHIConfig(test_flit, CacheLineBytes, [
  RiscvHartCHIRegion(RiscvPhysicalMemoryRegion(AddressSet(0, 4095),
                                               RiscvPhysicalMemoryAttributes(#true, #true, #true, #true, #true, #false, #true, ~cache_block_zero: #true)), test_home)
])

def test_fetch_chi = RiscvHartCHIConfig(test_flit, CacheLineBytes, test_chi.regions ++ [
  RiscvHartCHIRegion(RiscvPhysicalMemoryRegion(AddressSet(0x10000, 0xffff),
                                               RiscvPhysicalMemoryAttributes(#true, #true, #true, #true, #true, #false, #true, ~cache_block_zero: #true)), test_home),
  RiscvHartCHIRegion(RiscvPhysicalMemoryRegion(AddressSet(0x2000, 0xff),
                                               RiscvPhysicalMemoryAttributes(#true, #true, #false, #false, #false, #true, #false)), test_io_home),
  RiscvHartCHIRegion(RiscvPhysicalMemoryRegion(AddressSet(0x100002000, 0xff),
                                               RiscvPhysicalMemoryAttributes(#true, #true, #false, #false, #false, #true, #false)), test_io_home),
  RiscvHartCHIRegion(RiscvPhysicalMemoryRegion(AddressSet(0x2100, 7),
                                               RiscvPhysicalMemoryAttributes(#true, #false, #false, #false, #false, #true, #false)), test_io_home),
  RiscvHartCHIRegion(RiscvPhysicalMemoryRegion(AddressSet(0x2203, 0),
                                               RiscvPhysicalMemoryAttributes(#true, #false, #false, #false, #false, #true, #false)), test_io_home),
  RiscvHartCHIRegion(RiscvPhysicalMemoryRegion(AddressSet(0x2300, 0xff),
                                               RiscvPhysicalMemoryAttributes(#true, #true, #false, #false, #false, #false, #true, ~cache_block_zero: #true)), test_io_home),
  RiscvHartCHIRegion(RiscvPhysicalMemoryRegion(AddressSet(0x2400, 7),
                                               RiscvPhysicalMemoryAttributes(#true, #true, #false, #false, #false, #false, #true, ~cache_block_zero: #true)), test_io_home),
  RiscvHartCHIRegion(RiscvPhysicalMemoryRegion(AddressSet(0x2600, 0xff),
                                               RiscvPhysicalMemoryAttributes(#true, #false, #true, #false, #false, #false, #true, ~instruction_cacheable: #true)), test_io_home),
  RiscvHartCHIRegion(RiscvPhysicalMemoryRegion(AddressSet(0x2500, 0xff),
                                               RiscvPhysicalMemoryAttributes(#true, #true, #false, #true, #false, #false, #true, ~cache_block_zero: #true)), test_home)
])

sync_circuit SuperscalarCacheFixture():
  input node_id: Bits(test_flit.node_id_width)
  input management_pbmt: PageMemoryType
  interface instructions(Decoupled(PacketObservation(XLen.X64, #false, 2)), ~role: consumer)
  interface retired[2](Valid(RetirementObservation(XLen.X64, #false)), ~role: producer)
  interface completed(Valid(SuperscalarCompletion(XLen.X64)), ~role: producer)
  interface redirect(Valid(SuperscalarRedirect(XLen.X64)), ~role: producer)
  interface chi(CHIRNChannels(test_flit), ~role: node)
  interface uncached_chi(CHIRNIChannels(test_flit), ~role: node)
  output(issued, retired_count): Bits(2)
  output uncached_activity: Bool
  inst core(CoreFixture(SuperscalarPipelineConfig(~zicboz: #true, ~zicbom: #true, ~zicbop: #true, ~zawrs: #true, ~zihintntl: #true)))
  core.interrupts <== literal(core.interrupts.type, 0)
  core.hart_id <== Bits(64)(0)
  core.time_counter <== Bits(64)(0)
  def Context = SuperscalarMemoryContext(XLen.X64, 8)
  inst data(SuperscalarL1D(test_cache, ~chi: test_fetch_chi, ~context: SuperscalarTransportContext(Context, 3)))
  inst mmu(SuperscalarMemoryAdapter(SuperscalarSv39Specialization(test_fetch_chi), ~context: Context))
  core.vector_precheck <=> mmu.vector_precheck
  core.vector_fast |> mmu.vector_fast
  mmu.pipeline_vector <== core.pipeline_vector
  mmu.request_vector <== core.request_vector
  mmu.split_guest_access <== core.split_guest_access
  mmu.state <== core.translation_state
  mmu.invalidate <== core.translation_flush
  mmu.instruction.request.valid <== Bool(#false)
  mmu.instruction.request.bits <== Bits(64)(0)
  instructions |> core.instructions
  core.retired <=> retired
  core.completed |> completed
  core.redirect |> redirect
  core.memory <=> mmu.memory
  core.split <=> mmu.split
  core.pipeline <=> mmu.pipeline
  core.prefetch |> mmu.prefetch
  mmu.physical_prefetch |> filter_valid(request => request.into(CachePrefetchReq(64)).operation.is_one_of(CachePrefetchOperation.Read, CachePrefetchOperation.Write)) |> data.prefetch
  // Exercise maintenance through each translated physical attribute without
  // replacing the production cache, its coherent engine, or its resident data.
  (
    mmu.physical_memory.request |> map_flow(request):
      def physical = request.into(PhysicalDataReq(XLen.X64, SuperscalarTransportContext(Context, 3), 64))
      def operation :: CacheOperation = physical.memory.access
      physical.updated(~pbmt: mux(operation.is_cache_management(), management_pbmt, physical.pbmt))
  ) |> data.memory.request

  data.memory.response |> mmu.physical_memory.response
  data.memory.fault |> mmu.physical_memory.fault
  mmu.physical_memory.drained <== data.memory.drained
  mmu.physical_memory.ordered_busy <== data.memory.ordered_busy
  mmu.physical_memory.reservation_valid <== data.memory.reservation_valid
  mmu.physical_pipeline <=> data.pipeline
  mmu.pipeline_lookup |> data.pipeline_lookup
  data.instruction.flush <== Bool(#false)
  data.instruction.request.valid <== Bool(#false)
  data.instruction.request.bits <== dont_care(PhysicalInstructionReq(64))
  data.instruction.response.ready <== Bool(#true)
  data.chi <=> chi
  data.node_id <== node_id
  data.uncached_node_id <== Bits(test_flit.node_id_width)(4)
  data.uncached_chi <=> uncached_chi
  uncached_activity <== data.uncached_chi.req.valid ||| data.uncached_chi.dat.request.valid
  issued <== core.issued
  retired_count <== core.retired_count
  for (slot in 0..2):
    core.resolution[slot].valid <== Bool(#false)
    core.resolution[slot].bits <== dont_care(SuperscalarResolution(XLen.X64))

export:
  SuperscalarCacheFixture
  test_cache
  test_chi
  test_fetch_chi
