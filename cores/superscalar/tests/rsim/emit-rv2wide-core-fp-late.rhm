#lang rhombus
/* Exercises multiplier issue ownership and colliding integer/FP writeback bookings. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/rv2wide/issue.rhdl").RV2WideIssue
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("rhodium/backend/rsim-target.rhm").rsim_target
  lib("rhodium/compile/pipeline.rhm").rtl_pipeline_target
  lib("cores/common/tests/rsim/port-observers.rhm").port_observer_pass
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/fp-profile.rhm") open
  lib("cores/common/fp/timing.rhdl") open
  "../../profile.rhm" open
  "../../long-execution.rhdl".SuperscalarMultiply
  "../core-fixture.rhdl" open

def program = elaborate(CoreFixture(SuperscalarPipelineConfig(~floating_point: FloatingPointProfile.D, ~half_precision: HalfPrecisionProfile.Zfhmin, ~zfa: #true, ~zihintntl: #true), ~fp_timing: FpExecutionTiming(3, 5, 3)))
def rv32_program = elaborate(CoreFixture(SuperscalarPipelineConfig(~xlen: XLen.X32, ~floating_point: FloatingPointProfile.F, ~zihintntl: #true), ~fp_timing: FpExecutionTiming(3, 5, 3)))
def multiply_program = elaborate(SuperscalarMultiply())
def multiply_target = rtl_pipeline_target(rsim_target, [port_observer_pass([
  ["TaggedPipelinedMultiplier", "observe_multiply_launch", [["request_in", "valid"], ["request_in", "bits", "tag", "vector"]]]
])])
export:
  program
  rv32_program
  multiply_program
  multiply_target
