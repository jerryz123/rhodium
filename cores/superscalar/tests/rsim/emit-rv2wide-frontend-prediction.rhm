import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../frontend.rhdl".SuperscalarFrontend
  "../cache-fixture.rhdl".test_chi
  "../../profile.rhm".SuperscalarPipelineConfig

def program = elaborate(SuperscalarFrontend(test_chi, SuperscalarPipelineConfig(~bht: #false)))
def guest_program = elaborate(SuperscalarFrontend(test_chi, SuperscalarPipelineConfig(~bht: #false, ~hypervisor: #true)))
export program guest_program
