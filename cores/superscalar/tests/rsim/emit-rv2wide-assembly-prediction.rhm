import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("riscv/isa/fp-profile.rhm").FloatingPointProfile
  "../../profile.rhm".SuperscalarPipelineConfig
  "../assembly-fixture.rhdl".AssemblyFixture

def program = elaborate(AssemblyFixture(SuperscalarPipelineConfig(~floating_point: FloatingPointProfile.D)))
def guest_program = elaborate(AssemblyFixture(SuperscalarPipelineConfig(~floating_point: FloatingPointProfile.D, ~hypervisor: #true)))
def three_program = elaborate(AssemblyFixture(SuperscalarPipelineConfig(~floating_point: FloatingPointProfile.D, ~hypervisor: #true), ~group_width: 3))
export program guest_program three_program
