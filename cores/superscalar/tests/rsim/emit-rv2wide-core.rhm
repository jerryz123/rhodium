import:
  lib("riscv/isa/xlen.rhm").XLen
  lib("cores/rv2wide/issue.rhdl").RV2WideIssue
  lib("rhodium/compile/pipeline.rhm").rtl_pipeline_target
  lib("rhodium/backend/rsim-target.rhm").rsim_target
  lib("rhodium/statistics/pass.rhm").statistics_pass
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../core-fixture.rhdl" open
  "../../profile.rhm".SuperscalarPipelineConfig

def program = elaborate(CoreFixture(SuperscalarPipelineConfig(~zicboz: #true, ~zicbom: #true, ~zicbop: #true, ~zawrs: #true, ~zihintntl: #true, ~zihintpause: #true, ~sstc: #true, ~svinval: #true, ~ssnpm: #true, ~supm: #true, ~sscofpmf: #true, ~smstateen: #true, ~hypervisor: #true)))
def target = rtl_pipeline_target(rsim_target, [statistics_pass()])
export program target
