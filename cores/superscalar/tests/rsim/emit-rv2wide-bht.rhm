#lang rhombus
/* Elaborates tournament frontend integration and standalone prefix-retention variants. */
// SPDX-License-Identifier: Apache-2.0
import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../frontend-fixture.rhdl".FrontendFixture
  "../../fetch/direction.rhdl".SuperscalarDirection
  "../../profile.rhm".SuperscalarPipelineConfig
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/hart.rhm").RiscvMmuType
  "../cache-fixture.rhdl".test_chi

def program = elaborate(FrontendFixture(test_chi))
def compact_prefix = elaborate(SuperscalarDirection(SuperscalarPipelineConfig()))
def rv32_prefix = elaborate(SuperscalarDirection(SuperscalarPipelineConfig(~xlen: XLen.X32, ~mmu_type: RiscvMmuType.Bare)))
export program compact_prefix rv32_prefix
