import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("riscv/isa/xlen.rhm").XLen
  "../issue-window-fixture.rhdl".IssueWindowFixture

def program = elaborate(IssueWindowFixture())
def guest_program = elaborate(IssueWindowFixture(~hypervisor: #true))
def rv32_program = elaborate(IssueWindowFixture(XLen.X32))
def three_program = elaborate(IssueWindowFixture(~group_width: 3))
def three_guest_program = elaborate(IssueWindowFixture(~group_width: 3, ~hypervisor: #true))
export program guest_program rv32_program three_program three_guest_program
