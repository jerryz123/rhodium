import:
  lib("cores/common/mmu/context.rhdl").GuestMemoryReq
  lib("cores/common/mmu/context.rhdl").RiscvTranslationState
  lib("riscv/rtl/trap.rhdl").ExceptionCause
  lib("riscv/rtl/hypervisor.rhdl") open
  lib("riscv/rtl/pointer-masking.rhdl") open
  lib("flow/main.rhdl") open
  "../memory/adapter.rhdl".SuperscalarMemoryAdapter
  "../memory/translation-identity.rhdl".SuperscalarIdentitySpecialization
  "../memory/translation-sv39.rhdl".SuperscalarSv39Specialization
  "../bundles.rhdl" open
  "cache-fixture.rhdl" open
  "../../common/cache/protocol.rhdl" open
  "../../common/cache/operation.rhdl" open
  "../../common/cache-prefetch.rhdl" open
  lib("riscv/rtl/atomic.rhdl") open
  lib("riscv/rtl/svpbmt.rhdl") open
  lib("riscv/rtl/zihintntl.rhdl") open
  "../../common/load-store.rhdl" open
  lib("riscv/rtl/privilege.rhdl") open
  lib("riscv/isa/xlen.rhm") open
  lib("cores/common/mmu/vector.rhdl") open

sync_circuit SuperscalarMmuFixture(~bare: bare :: Boolean = #false):
  input privilege: Bits(2)
  input(satp, mstatus): Bits(64)
  input invalidate: Bool
  input pbmte: Bool
  input guest_state: RiscvHypervisorTranslation()
  input guest_access: RiscvGuestMemoryAccess
  input vector_access: Bool
  input ordered_precheck: Bool
  interface vector_precheck(VectorPrecheck(), ~role: responder)
  interface vector_fast(VectorFastCheck(XLen.X64), ~role: responder)
  interface prefetch(Valid(CachePrefetchReq(64)), ~role: consumer)
  interface physical_prefetch(Valid(CachePrefetchReq(64)), ~role: producer)
  input fetch_valid: Bool
  input fetch_address: Bits(64)
  output fetch_resolution: SuperscalarResolution(XLen.X64)
  output fetch_physical: Bits(64)
  output fetch_pbmt: PageMemoryType
  input lookup_outcome: CachePipelineOutcome
  input suppress_lookup_response: Bool
  input(ex_valid, wb_valid, commit): Bool
  input access: CacheOperation
  input address: Bits(64)
  input locality: RiscvMemoryLocality
  input split_valid: Bool
  input split_width: MemoryWidth
  input split_signed: Bool
  input split_data: Bits(64)
  output split_ready: Bool
  output split_completed: Bool
  output split_result: Bits(64)
  output(split_page_fault, split_access_fault): Bool
  output split_fault_address: Bits(64)
  output(index_valid, resolve_valid, result_valid): Bool
  output(index_address, resolve_address): Bits(64)
  output outcome: CachePipelineOutcome
  output lookup_guest: RiscvGuestException()
  output wb_fault: Bool
  output wb_fault_bits: SuperscalarResolution(XLen.X64)
  output wb_ready: Bool
  input(physical_ready, physical_fault, response_valid): Bool
  input response_data: Bits(64)
  output physical_valid: Bool
  output physical_address: Bits(64)
  output physical_access: CacheOperation
  output physical_data: Bits(64)
  output physical_mask: Bits(8)
  output physical_locality: RiscvMemoryLocality
  output physical_pbmt: PageMemoryType
  output response_ready: Bool
  input block_response: Bool
  output memory_drained: Bool
  output completed: Bool
  output completed_data: Bits(64)
  def translation = if bare | SuperscalarIdentitySpecialization(XLen.X64, test_fetch_chi) | SuperscalarSv39Specialization(test_fetch_chi, #true)
  inst mmu(SuperscalarMemoryAdapter(translation))
  mmu.pipeline_vector <== vector_access
  mmu.request_vector <== vector_access
  vector_precheck.request |> gate_flow(!ordered_precheck ||| mmu.memory.request.ready) |> mmu.vector_precheck.request
  mmu.vector_precheck.response |> vector_precheck.response
  vector_precheck.release |> mmu.vector_precheck.release
  vector_fast |> mmu.vector_fast
  mmu.split_guest_access <== guest_access
  mmu.state <== RiscvTranslationState(XLen.X64):
    pointer_masking: literal(PointerMaskControl(), 0)
    guest_pointer_masking: literal(PointerMaskControl(), 0)
    guest: guest_state
    privilege: privilege.into(PrivilegeMode)
    satp: satp
    mstatus: mstatus
    pbmte: pbmte

  mmu.invalidate <== invalidate
  prefetch |> mmu.prefetch
  mmu.physical_prefetch |> physical_prefetch
  mmu.instruction.request.valid <== fetch_valid
  mmu.instruction.request.bits <== fetch_address
  fetch_resolution <== mmu.instruction.resolution
  fetch_physical <== mmu.instruction.address
  fetch_pbmt <== mmu.instruction.pbmt
  def request = GuestMemoryReq(PhysicalMemoryReq(XLen.X64, Bool)):
    translation: guest_access
    memory:
      PhysicalMemoryReq(XLen.X64, Bool):
        context: Bool(#false)
        address: address
        access: access
        atomic: RiscvAtomicOperation.Swap
        width: MemoryWidth.Double
        data: Bits(64)(0)
        locality: locality
        byte_mask: Bits(8)(0xff)
        unsigned: !access.is_one_of(CacheOperation.LoadReserved, CacheOperation.StoreConditional, CacheOperation.Atomic)

  mmu.pipeline.request.valid <== ex_valid
  mmu.pipeline.request.bits <== request
  mmu.pipeline.commit <== commit
  mmu.physical_pipeline.commit_ready <== Bool(#true)
  mmu.physical_pipeline.response.valid <== mmu.physical_pipeline.request.valid & !suppress_lookup_response
  mmu.physical_pipeline.response.bits <== CachePipelineResult(XLen.X64):
    outcome: lookup_outcome
    reason: CachePipelineReason.None
    data: Bits(64)(0xabcd)

  index_valid <== mmu.pipeline_lookup.valid
  index_address <== mmu.pipeline_lookup.bits.address
  resolve_valid <== mmu.physical_pipeline.request.valid
  resolve_address <== mmu.physical_pipeline.request.bits.address
  result_valid <== mmu.pipeline.response.valid
  outcome <== mmu.pipeline.response.bits.outcome
  lookup_guest <== mmu.pipeline.response.bits.guest
  mmu.memory.request.valid <== wb_valid
  mmu.memory.request.bits <== request
  mmu.split.request.valid <== split_valid
  mmu.split.request.bits <== PhysicalMemoryReq(XLen.X64, Bool):
    address: address
    access: access
    atomic: RiscvAtomicOperation.Swap
    width: split_width
    unsigned: !split_signed
    data: split_data
    byte_mask: Bits(8)(0)
    context: Bool(#false)
    locality: locality

  split_ready <== mmu.split.request.ready
  split_completed <== mmu.split.response.valid
  split_result <== mmu.split.response.bits.response.data
  split_page_fault <== mmu.split.response.bits.page_fault
  split_access_fault <== mmu.split.response.bits.response.access_fault
  split_fault_address <== mmu.split.response.bits.fault_address
  wb_ready <== mmu.memory.request.ready
  wb_fault <== mmu.memory.fault.valid
  wb_fault_bits <== mmu.memory.fault.bits
  mmu.memory.response.ready <== !block_response
  memory_drained <== mmu.memory.drained
  completed <== mmu.memory.response.valid
  completed_data <== mmu.memory.response.bits.data
  mmu.physical_memory.request.ready <== physical_ready & !physical_fault
  mmu.physical_memory.fault.valid <== mmu.physical_memory.request.valid & physical_fault
  mmu.physical_memory.fault.bits <== SuperscalarResolution(XLen.X64):
    guest: literal(RiscvGuestFault(), 0)
    disposition: SuperscalarDisposition.Fault
    cause: ExceptionCause.LoadAccessFault
    value: mmu.physical_memory.request.bits.memory.address

  mmu.physical_memory.response.valid <== response_valid
  // The memory responder retains and echoes accepted context, just as the real cache does.
  inst response_context(Queue(mmu.physical_memory.request.bits.memory.context.type, 8))
  inject_interface(Valid(mmu.physical_memory.request.bits.memory.context.type), ~valid: mmu.physical_memory.request.fire(), ~bits: mmu.physical_memory.request.bits.memory.context) |> offer_decoupled() |> response_context.ingress
  mmu.physical_memory.response.bits.data <== response_data
  mmu.physical_memory.response.bits.context <== response_context.egress.bits
  response_context.egress.ready <== mmu.physical_memory.response.fire()
  mmu.physical_memory.drained <== Bool(#true)
  mmu.physical_memory.ordered_busy <== Bool(#false)
  mmu.physical_memory.reservation_valid <== Bool(#false)
  physical_valid <== mmu.physical_memory.request.valid
  physical_address <== mmu.physical_memory.request.bits.memory.address
  physical_access <== mmu.physical_memory.request.bits.memory.access
  physical_data <== mmu.physical_memory.request.bits.memory.data
  physical_mask <== mmu.physical_memory.request.bits.memory.byte_mask
  physical_locality <== mmu.physical_memory.request.bits.memory.locality
  physical_pbmt <== mmu.physical_memory.request.bits.pbmt
  response_ready <== mmu.physical_memory.response.ready

export:
  SuperscalarMmuFixture
