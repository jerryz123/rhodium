#lang rhodium
/* Serializes age-ordered retirement updates through a two-entry predictor-training buffer. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("riscv/isa/xlen.rhm").XLen
  "bundles.rhdl".SuperscalarBranchTraining
  lib("flow/main.rhdl") open

/* Accepts age-ordered Valid offers and emits one update every cycle, bypassing when empty.
   The caller must reserve capacity before issue; clear discards both queued and live offers. */
sync_circuit SuperscalarBranchTrainingBuffer(xlen :: XLen = XLen.X64, ~group_width: group_width :: matching(2) || matching(3) = 2):
  interface incoming[group_width](Valid(SuperscalarBranchTraining(xlen)), ~role: consumer)
  interface training(Valid(SuperscalarBranchTraining(xlen)), ~role: producer)
  interface clear(Pulse(), ~role: consumer)
  output pending: Bits(2)

  reg count(~init: Bits(2)(0))
  reg entries(Vec(2, SuperscalarBranchTraining(xlen)))


  /* Output selection and occupancy accounting.
     A queued head wins; when empty the oldest incoming offer bypasses storage. */

  def offers :: List.of(Bool) = [count > Bits(2)(0), count > Bits(2)(1)] ++ (for List (lane in 0..group_width): incoming[lane].valid)
  def payloads :: List.of(SuperscalarBranchTraining(xlen)) = [entries[0], entries[1]] ++ (for List (lane in 0..group_width): incoming[lane].bits)
  def mutable total :: Bits(3) = Bits(3)(0)
  def ranks :: List.of(Bits(3)) = for List (offer :: Bool in offers):
    def rank = total
    total := total + offer.as_bits().zext(3)
    rank

  def next_count = total - total.any().as_bits().zext(3)
  def compacted = for List (rank in 0..3):
    priority_mux((for List (index in 0..offers.length()): [offers[index] & (ranks[index] === Bits(3)(rank)), payloads[index]]), ~default: entries[0])

  pending <== count
  training.valid <== total.any() & !clear.valid
  training.bits <== compacted[0]
  assert(clear.valid ||| (next_count <= Bits(3)(2)), "superscalar_branch_training_capacity")


  /* Ordered compaction after the one emitted update.
     A retained tail stays ahead of incoming updates. Clear discards all owners. */

  when (clear.valid):
    count <== Bits(2)(0)
  otherwise:
    count <== next_count[0..2]
    when (next_count > Bits(3)(0)):
      entries[0] <== compacted[1]

    when (next_count === Bits(3)(2)):
      entries[1] <== compacted[2]

export:
  SuperscalarBranchTrainingBuffer
