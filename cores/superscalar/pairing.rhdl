#lang rhodium
/* Normalizes copies and recognizes same-group rewrites for the RR/EX/MEM datapaths. */
// SPDX-License-Identifier: Apache-2.0

import:
  "decode/core-ctrl.rhdl".SuperscalarControl
  lib("cores/common/operand.rhdl") open
  lib("cores/common/alu.rhdl").AluResultSelect
  "decode/system-ctrl.rhdl" open
  lib("cores/common/cache/operation.rhdl").CacheOperation
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/rv32i.rhm") as rv32
  lib("riscv/model/formats.rhm") as fields
  lib("riscv/rtl/instruction-fields.rhdl").instruction_field
  lib("riscv/rtl/instruction-pattern.rhdl").instruction_pattern
  lib("rhodium/std/decode.rhdl") open

/* Names operand rewrites and physical consumer muxes, not a general EX-to-EX bypass. */
hardware_enum SuperscalarPairRoute:
  Register
  Constant
  MemoryAddress
  StoreData
  BranchOperand
  ImmediateAdd
  VectorScalar

/* Sizes a signed sum of two instruction immediates without losing RV64 U-immediate carry. */
fun superscalar_pair_immediate_width(xlen :: XLen) :: PosInt:
  if xlen == XLen.X32 | 32 | 33

/* Selects an RR mux source without carrying the register, PC, or immediate value. */
hardware_enum SuperscalarReadSource:
  Register
  OlderConstant
  OlderRegister
  OlderPc

/* Identifies the captured GPR source of an exact full-XLEN identity operation. */
hardware_enum SuperscalarMoveSource:
  None
  Rs1
  Rs2

/* Recognizes ADDI with zero immediate and ADD with a zero register, including expanded C.MV.
   Word operations are not copies: their sign extension must still execute. */
fun superscalar_move_source(instruction :: Bits(32)) :~ SuperscalarMoveSource:
  def is_addi = DecodeGen([DecodeCase(instruction_pattern(rv32.ADDI), Bool(#true))], ~default: Bool(#false))
  def is_add = DecodeGen([DecodeCase(instruction_pattern(rv32.ADD), Bool(#true))], ~default: Bool(#false))
  priority_mux(~default: SuperscalarMoveSource.None):
    (is_addi(instruction) & !instruction_field(fields.immediate12, instruction).any()) ||| (is_add(instruction) & !instruction_field(fields.rs2, instruction).any()): SuperscalarMoveSource.Rs1
    is_add(instruction) & !instruction_field(fields.rs1, instruction).any(): SuperscalarMoveSource.Rs2

/* Canonicalizes full-XLEN copies before decode and physical read allocation.
   Callers retain the fetched raw encoding separately for traps and observation;
   Writes to x0 remain unchanged because ADD encodings include NTL hints.
   ADDW/ADDIW and all other operations remain unchanged. */
fun superscalar_normalize_move(instruction :: Bits(32)) :~ Bits(32):
  def move = superscalar_move_source(instruction)
  def source = mux(move === SuperscalarMoveSource.Rs2, instruction_field(fields.rs2, instruction), instruction_field(fields.rs1, instruction))
  def normalized = Bits(32)(rv32.ADDI.encoding.value) ||| (source.zext(32) << fields.rs1.low) ||| (instruction_field(fields.rd, instruction).zext(32) << fields.rd.low)
  mux((move =/= SuperscalarMoveSource.None) & instruction_field(fields.rd, instruction).any(), normalized, instruction)

/* Controls RR source selection and the existing stage-local forwarding paths. */
bundle SuperscalarPairControl():
  sources: Vec(2, SuperscalarReadSource)
  composed: Bool
  memory_address: Bool
  store_data: Bool
  branch_operands: Vec(2, Bool)
  vector_scalar: Bool

/* Carries instruction bits and decoded mux controls, never computed operand values.
   The separate admission mask qualifies which candidate records enter execution. */
bundle SuperscalarIssueInstruction():
  instruction: Bits(32)
  control: SuperscalarControl()
  pair: SuperscalarPairControl()

/* Shares one route decision between source interlocks and pipeline mux controls. */
bundle SuperscalarPairing():
  routes: Vec(2, SuperscalarPairRoute)
  unresolved: Vec(2, Bool)
  /* Only a selected physical bypass may waive a younger source's ordinary readiness check. */
  method replaced(pairing) :: Vec(2, Bool):
    vec(for List (source in 0..2): pairing.routes[source] =/= SuperscalarPairRoute.Register)

/* Identifies ordinary ALU writers whose result can feed a same-group consumer. */
fun superscalar_pair_producer(older :: SuperscalarControl(), valid :: Bool, destination :: Bits(5), deferred :: Bool) :~ Bool:
  valid & older.writeback.enable & destination.any() & !deferred & !older.fp.valid & !older.system.uses_command() & !older.branch.resolver.enable

/* Recognizes ordinary load/store addresses that need no addition after a bypass. */
fun superscalar_zero_offset_memory(control :: SuperscalarControl(), instruction :: Bits(32)) :~ Bool:
  def zero_displacement = mux_lookup(control.operand.immediate, ~default: Bool(#false)):
    OperandImmediate.Zero: Bool(#true)
    OperandImmediate.I: !instruction_field(fields.immediate12, instruction).any()
    OperandImmediate.S: all(for List (piece in fields.SImmediate.pieces): !instruction_field(piece.source, instruction).any())

  control.memory.access.is_load_or_store() & zero_displacement

/* Resolves each younger RAW against an eligible older ALU writer without changing either instruction's resource admission. */
fun superscalar_pairing(controls :: Vec(2, SuperscalarControl()), valid :: Vec(2, Bool), destination :: Bits(5), sources :: Vec(2, Bits(5)), instructions :: Vec(2, Bits(32)), older_deferred :: Bool, ~forwarded: forwarded :: Vec(2, Bool) = vec(Bool(#false), Bool(#false))) :: SuperscalarPairing():
  def older :: SuperscalarControl() = controls[0]
  def younger :: SuperscalarControl() = controls[1]
  def writes = valid[0] & older.writeback.enable & destination.any()
  def used = vec(younger.operand.uses_rs1, younger.operand.uses_rs2)
  def dependency = vec(for List (source in 0..2): valid[1] & writes & used[source] & (destination === sources[source]))
  def producer = superscalar_pair_producer(older, valid[0], destination, older_deferred)
  def scalar_memory = younger.memory.access.is_load_or_store()
  def memory_address = superscalar_zero_offset_memory(younger, instructions[1])
  def store_data = !younger.fp.valid & (younger.memory.access === CacheOperation.Store)
  def branch_operand = younger.branch.resolver.enable & !younger.branch.resolver.unconditional
  def vector_scalar = !younger.vector.memory & (younger.vector.integer ||| younger.vector.floating_point ||| younger.vector.multiply_divide) & younger.operand.uses_rs1
  def is_auipc = DecodeGen([DecodeCase(instruction_pattern(rv32.AUIPC), Bool(#true))], ~default: Bool(#false))
  def is_addi = DecodeGen([DecodeCase(instruction_pattern(rv32.ADDI), Bool(#true))], ~default: Bool(#false))
  def auipc_addi = is_auipc(instructions[0]) & is_addi(instructions[1])

  /* Early operands and composed addresses.
     A zero-based immediate adder supplies its constant directly at RR. Full-width
     register/PC-based immediate adders compose with the younger memory offset. */

  def immediate_adder = (older.operand.right === OperandBSelect.Immediate) & !older.operand.uses_rs2 & (older.alu.result_select === AluResultSelect.Adder) & !older.alu.subtract & !older.alu.unsigned_word & !older.alu.shift_add_amount.any()
  def register_base = older.operand.left === OperandASelect.Register
  def pc_base = older.operand.left === OperandASelect.Pc
  def constant = immediate_adder & ((older.operand.left === OperandASelect.Zero) ||| (register_base & !instruction_field(fields.rs1, instructions[0]).any()))
  def composed_address = scalar_memory & immediate_adder & !older.alu.word & (register_base ||| pc_base)

  /* Source-specific physical routes.
     Constants replace ordinary operand capture; only rs1 has immediate composition
     or the address bypass. An ineligible producer retains every ordinary interlock. */

  def routes = vec(
    for List (source in 0..2):
      def consumer = if source == 0 | memory_address | store_data
      def memory_route = if source == 0 | SuperscalarPairRoute.MemoryAddress | SuperscalarPairRoute.StoreData
      def selected = priority_mux(~default: SuperscalarPairRoute.Register):
        constant: SuperscalarPairRoute.Constant
        Bool(source == 0) & (auipc_addi ||| composed_address): SuperscalarPairRoute.ImmediateAdd
        consumer: memory_route
        branch_operand: SuperscalarPairRoute.BranchOperand
        Bool(source == 0) & vector_scalar: SuperscalarPairRoute.VectorScalar

      mux(producer & dependency[source] & !forwarded[source], selected, SuperscalarPairRoute.Register)
  )

  SuperscalarPairing():
    routes: routes
    unresolved: vec(for List (source in 0..2): dependency[source] & !forwarded[source] & (routes[source] === SuperscalarPairRoute.Register))

/* Projects the recognized rewrite into datapath mux controls; no operand data enters issue. */
fun superscalar_pair_control(pairing :: SuperscalarPairing(), older :: SuperscalarControl()) :~ SuperscalarPairControl():
  def composed = pairing.routes[0] === SuperscalarPairRoute.ImmediateAdd
  def base = mux(older.operand.left === OperandASelect.Pc, SuperscalarReadSource.OlderPc, SuperscalarReadSource.OlderRegister)
  SuperscalarPairControl():
    sources: vec(
      mux(composed, base, mux(pairing.routes[0] === SuperscalarPairRoute.Constant, SuperscalarReadSource.OlderConstant, SuperscalarReadSource.Register)),
      mux(pairing.routes[1] === SuperscalarPairRoute.Constant, SuperscalarReadSource.OlderConstant, SuperscalarReadSource.Register)
    )
    composed: composed
    memory_address: pairing.routes[0] === SuperscalarPairRoute.MemoryAddress
    store_data: pairing.routes[1] === SuperscalarPairRoute.StoreData
    branch_operands: vec(for List (source in 0..2): pairing.routes[source] === SuperscalarPairRoute.BranchOperand)
    vector_scalar: pairing.routes[0] === SuperscalarPairRoute.VectorScalar

export:
  SuperscalarMoveSource
  superscalar_move_source
  superscalar_normalize_move
  SuperscalarPairRoute
  superscalar_pair_immediate_width
  SuperscalarPairing
  superscalar_pairing
  superscalar_pair_producer
  superscalar_zero_offset_memory
  SuperscalarReadSource
  SuperscalarPairControl
  SuperscalarIssueInstruction
  superscalar_pair_control
