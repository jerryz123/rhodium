#lang rhodium
/* Selects identity translation for the shared RV32/RV64 superscalar memory adapter. */
// SPDX-License-Identifier: Apache-2.0

import:
  "memory-adapter.rhdl".SuperscalarMemoryAdapter
  "translation-identity.rhdl".SuperscalarIdentityTranslation
  "../chi-hart.rhdl".RiscvHartCHIConfig
  lib("riscv/isa/xlen.rhm").XLen
  lib("rhodium/frontend/foundation.rhm").CircuitDefinition

/* Selects a translation-free adapter without adding hierarchy, storage, or a walker client. */
fun SuperscalarBareMemory(xlen :: XLen, config :: RiscvHartCHIConfig) :: CircuitDefinition:
  SuperscalarMemoryAdapter(xlen, config, SuperscalarIdentityTranslation(xlen, config), ~paged: #false)

export:
  SuperscalarBareMemory
