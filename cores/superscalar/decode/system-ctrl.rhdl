#lang rhodium
/* Maps CSR and privileged instructions to shared architectural actions and core serialization. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/common/reservation-wait.rhdl").ReservationWaitMode
  "../../common/csr/decode.rhdl" open
  lib("cores/common/csr/protocol.rhdl").RiscvCsrAction
  lib("riscv/isa/rv64i.rhm") open
  lib("riscv/isa/m.rhm") open
  lib("riscv/isa/a.rhm") open
  lib("riscv/isa/b.rhm") open
  lib("riscv/isa/zicond.rhm") open
  lib("riscv/isa/zimop.rhm") open
  lib("riscv/isa/zicsr.rhm") open
  lib("riscv/isa/zifencei.rhm") open
  lib("riscv/isa/privileged.rhm") open
  lib("riscv/isa/svinval.rhm") open
  lib("riscv/rtl/csr.rhdl").RiscvCsrOperation
  lib("riscv/rtl/decode.rhdl") open
  lib("rhodium/std/decode.rhdl") open

/* Selects data draining or instruction snapshot invalidation at the WB boundary. */
hardware_enum SuperscalarFence:
  None
  Memory
  Instruction

/* Separates source mode from architectural CSR intent, fences, and trap/return/wait action. */
bundle SuperscalarSystemControl():
  csr: RiscvCsrOperation
  immediate: Bool
  action: RiscvCsrAction
  fence: SuperscalarFence
  wait: ReservationWaitMode

  /* Identifies operations using the single WB command path, independently of read ordering. */
  method uses_command(control) :: Bool:
    (control.csr =/= RiscvCsrOperation.None) ||| (control.action =/= RiscvCsrAction.None) ||| (control.fence =/= SuperscalarFence.None) ||| (control.wait =/= ReservationWaitMode.None)

def SuperscalarPrivilegedInstructions = [MRET, SRET, WFI, SFENCE_VMA]
def SuperscalarSystemInstructions = [ECALL, EBREAK, FENCE, FENCE_I] ++ ZicsrInstructions ++ SuperscalarPrivilegedInstructions
def base_system_cases = decode_groups(SuperscalarSystemControl(), ~input: instruction_pattern):
  group excluding_instructions(RV64IInstructions ++ RV64MInstructions ++ RV64AInstructions ++ RV64BInstructions ++ ZicondInstructions ++ ZimopInstructions, [ECALL, EBREAK, FENCE]):
    wait: ReservationWaitMode.None
    fence: SuperscalarFence.None
    csr: RiscvCsrOperation.None
    action: RiscvCsrAction.None

  [FENCE]:
    wait: ReservationWaitMode.None
    csr: RiscvCsrOperation.None
    action: RiscvCsrAction.None
    fence: SuperscalarFence.Memory

  [FENCE_I]:
    wait: ReservationWaitMode.None
    csr: RiscvCsrOperation.None
    action: RiscvCsrAction.None
    fence: SuperscalarFence.Instruction

def csr_inactive = partial_pattern(SuperscalarSystemControl()):
  wait: ReservationWaitMode.None
  fence: SuperscalarFence.None
  action: RiscvCsrAction.None

def system_inactive = partial_pattern(SuperscalarSystemControl()):
  wait: ReservationWaitMode.None
  fence: SuperscalarFence.None

def SuperscalarSystemCases = base_system_cases
  ++ csr_system_cases(SuperscalarSystemControl(), system_inactive, [ECALL, EBREAK] ++ SuperscalarPrivilegedInstructions)
  ++ csr_access_cases(SuperscalarSystemControl(), csr_inactive)

// Full invalidation ignores address/ASID operands; ordering retains its own privilege rule.
def SuperscalarInvalidationCases = csr_system_cases(SuperscalarSystemControl(), system_inactive, [SINVAL_VMA, SFENCE_W_INVAL, SFENCE_INVAL_IR])

export:
  SuperscalarInvalidationCases
  SuperscalarFence
  SuperscalarSystemControl
  SuperscalarSystemInstructions
  SuperscalarPrivilegedInstructions
  SuperscalarSystemCases
