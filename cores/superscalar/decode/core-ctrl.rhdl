  lib("cores/common/reservation-wait-decode.rhdl").ReservationWaitCases
  lib("cores/common/reservation-wait.rhdl").ReservationWaitMode
  "../../common/csr/decode.rhdl".csr_instruction_action
  lib("cores/common/operand.rhdl") open
  lib("cores/common/vector/instruction-metadata.rhm") open
  "../profile.rhm".SuperscalarPipelineConfig
  lib("riscv/isa/rv32i.rhm") as rv32
  lib("cores/common/memory-decode.rhdl") open
  "operand-ctrl.rhdl" open
  lib("cores/common/memory-control.rhdl").ScalarMemoryControl
  lib("cores/common/operand-decode.rhdl") open
  "system-ctrl.rhdl" open
  "long-ctrl.rhdl" open
  lib("cores/common/alu.rhdl") open
  lib("cores/common/alu-decode.rhdl") open
  lib("cores/common/branch-decode.rhdl") open
  lib("cores/common/fp/decode.rhdl") open
  lib("cores/common/fp/scalar-decode.rhdl").fp_scalar_metadata
  lib("cores/common/vector/decode.rhdl") open
  lib("riscv/isa/v.rhm") as vector_isa
  lib("riscv/isa/zvbb.rhm").ZvbbInstructions
  lib("riscv/isa/vector-profile.rhm") open
  lib("cores/common/load-store.rhdl").MemoryWidth
  lib("cores/common/cache/operation.rhdl").CacheOperation
  lib("cores/common/cache-prefetch.rhdl") open
  lib("riscv/isa/fp-profile.rhm") open
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/rv64i.rhm") open
  lib("riscv/isa/m.rhm") open
  lib("riscv/isa/a.rhm") open
  lib("riscv/isa/b.rhm") open
  lib("riscv/isa/zicond.rhm") open
  lib("riscv/isa/zimop.rhm") open
  lib("riscv/isa/zicsr.rhm") open
  lib("riscv/isa/zifencei.rhm") open
  lib("riscv/isa/zicboz.rhm") open
  lib("riscv/isa/zicbom.rhm") open
  lib("riscv/isa/zicbop.rhm") open
  lib("riscv/isa/zawrs.rhm") open
  lib("riscv/isa/zihintpause.rhm") open
  lib("riscv/isa/zihintntl.rhm") open
  lib("riscv/isa/svinval.rhm") open
  lib("riscv/isa/h.rhm") open
  lib("riscv/isa/privileged.rhm").PrivilegedInstructions
  lib("riscv/rtl/hypervisor.rhdl") open
  lib("cores/common/instruction-hint.rhdl").InstructionHint
  lib("cores/common/csr/protocol.rhdl").RiscvCsrAction
  lib("riscv/rtl/csr.rhdl").RiscvCsrOperation
  lib("riscv/rtl/decode.rhdl") open
  lib("rhodium/std/decode.rhdl") open

/* Enables architectural writes and selects the link value instead of an ALU result. */
bundle SuperscalarWritebackControl():
  enable: Bool
  link: Bool

/* Qualifies decoded FP controls inside a packed pipeline payload. */
bundle SuperscalarFpControl():
  valid: Bool
  bits: FloatingPointControl()

/* Carries independently authored physical controls without an instruction-kind enum. */
bundle SuperscalarControl():
  alu: AluControl()
  operand: OperandControl()
  branch: RiscvBranchControl()
  memory: ScalarMemoryControl()
  guest_access: RiscvGuestMemoryAccess
  prefetch: CachePrefetchOperation
  hint: InstructionHint
  writeback: SuperscalarWritebackControl()
  system: SuperscalarSystemControl()
  muldiv: SuperscalarLongControl()
  fp: SuperscalarFpControl()
  vector: VectorControl()

/* Selects canonical vector rows; runtime legality checks enforce the selected ELEN and FP widths. */
fun superscalar_vector_instructions(profile :: SuperscalarPipelineConfig) :: List.of(InstructionSpec):
  vector_base_instructions(profile.vector) ++ (if vector_extensions_support_zvbb(profile.vector_extensions) | ZvbbInstructions | [])

/* Adds vector columns to the same composed decoder without enabling the scalar LSU. */
fun superscalar_vector_cases(profile :: SuperscalarPipelineConfig) :: List.of(DecodeCase):
  for List (instruction in superscalar_vector_instructions(profile)):
    def metadata = vector_scalar_metadata(instruction)
    def configuration = metadata.configuration
    def scalar_destination = metadata.scalar_destination
    def output = pattern(SuperscalarControl()):
      alu: unused_alu
      operand:
        partial_pattern(OperandControl()):
          uses_rs1: Bool(metadata.uses_rs1)
          uses_rs2: Bool(metadata.uses_rs2)

      branch: inactive_branch
      memory: inactive_core_memory
      guest_access: RiscvGuestMemoryAccess.Normal
      prefetch: CachePrefetchOperation.None
      hint: InstructionHint.None
      writeback:
        partial_pattern(SuperscalarWritebackControl()):
          enable: Bool(configuration || scalar_destination)

      system:
        partial_pattern(SuperscalarSystemControl()):
          csr: RiscvCsrOperation.None
          action: if configuration | RiscvCsrAction.VectorConfig | RiscvCsrAction.None
          fence: SuperscalarFence.None
          wait: ReservationWaitMode.None

      muldiv: inactive_long
      fp: partial_pattern(SuperscalarFpControl()): valid: Bool(#false)
      vector: component_output(VectorControlCases ++ VectorZvbbCases, instruction_pattern(instruction))

    DecodeCase(instruction_pattern(instruction), output)

/* Inactive memory and FP rows constrain only the operation or validity discriminator. */
def inactive_core_memory = partial_pattern(ScalarMemoryControl()): access: CacheOperation.None
def inactive_core_fp = partial_pattern(SuperscalarFpControl()): valid: Bool(#false)


/* Selects canonical instruction encodings before joining their control columns. */
fun integer_instructions(xlen :: XLen) :: List.of(InstructionSpec):
  (if xlen == XLen.X32 | rv32.RV32IInstructions ++ RV32MInstructions ++ RV32AInstructions ++ RV32BInstructions | RV64IInstructions ++ RV64MInstructions ++ RV64AInstructions ++ RV64BInstructions) ++ ZicondInstructions ++ ZimopInstructions ++ ZicsrInstructions ++ ZifenceiInstructions ++ PrivilegedInstructions

/* Joins exact canonical input patterns, preserving each component's inactive care masks. */
fun compose_control_cases(xlen :: XLen) :: List.of(DecodeCase):
  def base = if xlen == XLen.X32 | rv32.RV32IInstructions | RV64IInstructions
  def multiply = if xlen == XLen.X32 | RV32MInstructions | RV64MInstructions
  def atomic = if xlen == XLen.X32 | RV32AInstructions | RV64AInstructions
  def bitmanip = if xlen == XLen.X32 | RV32BInstructions | RV64BInstructions
  def alu = if xlen == XLen.X32 | RV32ICompleteAluCases | RV64ICompleteAluCases
  def bit_alu = if xlen == XLen.X32 | RV32BAluCases | RV64BAluCases
  def operands = superscalar_operand_cases(xlen)
  def loads = RiscvWordLoads ++ (if xlen == XLen.X64 | RiscvDoubleLoads | [])
  def stores = RiscvWordStores ++ (if xlen == XLen.X64 | RiscvDoubleStores | [])
  def memory = scalar_memory_cases(ScalarMemoryControl(), ~xlen: xlen) ++ instruction_cases(excluding_instructions(base, loads ++ stores), inactive_core_memory)
  def atomics = atomic_memory_cases(ScalarMemoryControl(), ~xlen: xlen)
  def instructions = integer_instructions(xlen)
  def addition_alu_cases = instruction_cases(atomic ++ ZimopInstructions, component_output(alu, instruction_pattern(ADDI)))
  def system_alu_cases = instruction_cases(multiply ++ ZicsrInstructions ++ ZifenceiInstructions ++ PrivilegedInstructions, unused_alu)
  def inactive_memory_cases = instruction_cases(multiply ++ bitmanip ++ ZicondInstructions ++ ZimopInstructions ++ ZicsrInstructions ++ ZifenceiInstructions ++ PrivilegedInstructions, inactive_core_memory)
  def core_long_cases = long_cases(instructions, ~xlen: xlen)
  def core_branch_cases = branch_cases(instructions)
  def branches = [BEQ, BNE, BLT, BGE, BLTU, BGEU]
  def jumps = [JAL, JALR]
  def writeback_cases = decode_groups(SuperscalarWritebackControl(), ~input: instruction_pattern):
    group branches ++ stores ++ [ECALL, EBREAK, FENCE, FENCE_I] ++ PrivilegedInstructions:
      enable: Bool(#false)

    group jumps:
      enable: Bool(#true)
      link: Bool(#true)

    group ZicsrInstructions ++ loads ++ atomic ++ multiply:
      enable: Bool(#true)

    group excluding_instructions(instructions, branches ++ jumps ++ stores ++ [ECALL, EBREAK, FENCE, FENCE_I] ++ PrivilegedInstructions ++ ZicsrInstructions ++ loads ++ atomic ++ multiply):
      enable: Bool(#true)
      link: Bool(#false)

  for List (instruction in instructions):
    def input = instruction_pattern(instruction)
    DecodeCase(
      input,
      pattern(SuperscalarControl()):
        guest_access: RiscvGuestMemoryAccess.Normal
        alu: component_output(alu ++ bit_alu ++ ZicondAluCases ++ addition_alu_cases ++ system_alu_cases, input)
        operand: component_output(operands, input)
        branch: component_output(core_branch_cases, input)
        memory: component_output(memory ++ atomics ++ inactive_memory_cases, input)
        writeback: component_output(writeback_cases, input)
        system: component_output(SuperscalarSystemCases, if instruction in SuperscalarSystemInstructions | input | instruction_pattern(ADDI))
        muldiv: component_output(core_long_cases, input)
        fp: inactive_core_fp
        vector: NoVectorControl
        prefetch: CachePrefetchOperation.None
        hint: InstructionHint.None
    )


/* Optional rows reuse width-independent inactive controls, not another decoder. */

def inactive_branch = component_output(branch_cases([ADDI]), instruction_pattern(ADDI))
def inactive_long = component_output(long_cases([ADDI]), instruction_pattern(ADDI))


/* CBO rows use rs1 unchanged and have no register destination or CSR action. */

def SuperscalarCboInstructions = ZicbozInstructions ++ ZicbomInstructions
def block_cases = cache_block_memory_cases(ScalarMemoryControl())
def block_width = partial_pattern(ScalarMemoryControl()): width: MemoryWidth.Double
def SuperscalarCboControlCases = for List (instruction in SuperscalarCboInstructions):
  def input = instruction_pattern(instruction)
  def output = pattern(SuperscalarControl()):
    guest_access: RiscvGuestMemoryAccess.Normal
    alu: component_output(RV64ICompleteAluCases, instruction_pattern(ADDI))
    operand: load_reserved_operands
    branch: inactive_branch
    memory: component_output(block_cases, input).intersection(block_width).terms[0]
    writeback: partial_pattern(SuperscalarWritebackControl()): enable: Bool(#false)
    system: component_output(SuperscalarSystemCases, instruction_pattern(ADDI))
    muldiv: inactive_long
    fp: inactive_core_fp
    vector: NoVectorControl
    prefetch: CachePrefetchOperation.None
    hint: InstructionHint.None

  DecodeCase(input, output)


/* Prefetch rows refine ORI-to-x0; overlay removes only those exact hint cubes. */

def SuperscalarPrefetchCases = for List ([instruction, operation] in RiscvPrefetchHints):
  def output = pattern(SuperscalarControl()):
    guest_access: RiscvGuestMemoryAccess.Normal
    alu: component_output(RV64ICompleteAluCases, instruction_pattern(ADDI))
    operand: prefetch_operands
    branch: inactive_branch
    memory: inactive_core_memory
    prefetch: operation
    hint: InstructionHint.None
    writeback: partial_pattern(SuperscalarWritebackControl()): enable: Bool(#false)
    system: component_output(SuperscalarSystemCases, instruction_pattern(ADDI))
    muldiv: inactive_long
    fp: inactive_core_fp
    vector: NoVectorControl

  DecodeCase(instruction_pattern(instruction), output)

/* Selects the exact scalar domain used by decode and compressed expansion. */
fun superscalar_instructions(profile :: SuperscalarPipelineConfig) :: List.of(InstructionSpec):
  def cache_instructions = (if profile.zicboz | ZicbozInstructions | []) ++ (if profile.zicbom | ZicbomInstructions | []) ++ (if profile.zicbop | ZicbopInstructions | [])
  def wait_instructions = if profile.zawrs | ZawrsInstructions | []
  def hint_instructions = (if profile.zihintpause | ZihintpauseInstructions | []) ++ (if profile.zihintntl | ZihintntlInstructions | [])
  def invalidation_instructions = if profile.svinval | SvinvalInstructions | []
  def guest_instructions = if profile.hypervisor | RV64HInstructions ++ (if profile.svinval | [HINVAL_VVMA, HINVAL_GVMA] | []) | []
  def floating_instructions = fp_instructions(profile.xlen, profile.floating_point, profile.half_precision, ~zfa: profile.zfa)
  superscalar_vector_instructions(profile) ++ integer_instructions(profile.xlen) ++ cache_instructions ++ wait_instructions ++ hint_instructions ++ invalidation_instructions ++ guest_instructions ++ floating_instructions


/* WRS is operand-free and uses the core's retained WB owner, not a memory request. */

def SuperscalarWaitCases = for List (entry in ReservationWaitCases):
  def output = pattern(SuperscalarControl()):
    guest_access: RiscvGuestMemoryAccess.Normal
    alu: unused_alu
    operand: no_operands
    branch: inactive_branch
    memory: inactive_core_memory
    prefetch: CachePrefetchOperation.None
    hint: InstructionHint.None
    writeback: partial_pattern(SuperscalarWritebackControl()): enable: Bool(#false)
    system:
      partial_pattern(SuperscalarSystemControl()):
        csr: RiscvCsrOperation.None
        action: RiscvCsrAction.None
        fence: SuperscalarFence.None
        wait: entry.output

    muldiv: inactive_long
    fp: inactive_core_fp
    vector: NoVectorControl

  DecodeCase(entry.input, output)


/* PAUSE refines FENCE into an operand-free hint with no ordering or CSR action. */

def pause_control = pattern(SuperscalarControl()):
  guest_access: RiscvGuestMemoryAccess.Normal
  alu: unused_alu
  operand: no_operands
  branch: inactive_branch
  memory: inactive_core_memory
  prefetch: CachePrefetchOperation.None
  hint: InstructionHint.Pause
  writeback: partial_pattern(SuperscalarWritebackControl()): enable: Bool(#false)
  system: component_output(SuperscalarSystemCases, instruction_pattern(ADDI))
  muldiv: inactive_long
  fp: inactive_core_fp
  vector: NoVectorControl

def SuperscalarPauseCases = [DecodeCase(instruction_pattern(PAUSE), pause_control)]


/* Locality hints refine exact ADD-to-x0 words; encoded rs2 is not an operand. */

def SuperscalarLocalityCases = for List ([instruction, hint] in RiscvLocalityHints):
  def output = pattern(SuperscalarControl()):
    guest_access: RiscvGuestMemoryAccess.Normal
    alu: unused_alu
    operand: no_operands
    branch: inactive_branch
    memory: inactive_core_memory
    prefetch: CachePrefetchOperation.None
    hint: hint
    writeback: partial_pattern(SuperscalarWritebackControl()): enable: Bool(#false)
    system: component_output(SuperscalarSystemCases, instruction_pattern(ADDI))
    muldiv: inactive_long
    fp: inactive_core_fp
    vector: NoVectorControl

  DecodeCase(instruction_pattern(instruction), output)


/* Serialized invalidation commands share inactive datapaths but retain distinct CSR actions. */

def SuperscalarInvalidationControlCases = for List (instruction in SvinvalInstructions):
  def input = instruction_pattern(instruction)
  def output = pattern(SuperscalarControl()):
    guest_access: RiscvGuestMemoryAccess.Normal
    alu: unused_alu
    operand: no_operands
    branch: inactive_branch
    memory: inactive_core_memory
    prefetch: CachePrefetchOperation.None
    hint: InstructionHint.None
    writeback: partial_pattern(SuperscalarWritebackControl()): enable: Bool(#false)
    system: component_output(SuperscalarInvalidationCases, input)
    muldiv: inactive_long
    fp: inactive_core_fp
    vector: NoVectorControl

  DecodeCase(input, output)

/* Composes selected memory, hint, hypervisor, and shared FP controls with the integer decoder. */
fun superscalar_control_cases(profile :: SuperscalarPipelineConfig) :: List.of(DecodeCase):
  def xlen = profile.xlen
  def selected_fp_instructions = fp_instructions(xlen, profile.floating_point, profile.half_precision, ~zfa: profile.zfa)
  def selected_fp_controls = fp_control_cases(xlen, profile.floating_point, profile.half_precision, ~zfa: profile.zfa)


  /* Integer composition and exact hint overlays.
     Only the hint cubes replace base rows; CBO, wait, and guest rows append
     afterward in their original order. */

  def cbo_instructions = (if profile.zicboz | ZicbozInstructions | []) ++ (if profile.zicbom | ZicbomInstructions | [])
  def cbo_cases = for List (instruction in cbo_instructions):
    def input = instruction_pattern(instruction)
    DecodeCase(input, component_output(SuperscalarCboControlCases, input))

  def hint_cases = (if profile.zicbop | SuperscalarPrefetchCases | []) ++ (if profile.zihintpause | SuperscalarPauseCases | []) ++ (if profile.zihintntl | SuperscalarLocalityCases | [])
  def base_cases = compose_control_cases(xlen)
  def integer_cases = if hint_cases.length() > 0 | overlay_decode_cases(base_cases, hint_cases) | base_cases
  def wait_cases = if profile.zawrs | SuperscalarWaitCases | []
  def invalidation_cases = if profile.svinval | SuperscalarInvalidationControlCases | []
  def guest_cases = if profile.hypervisor | superscalar_hypervisor_cases(profile.svinval) | []


  /* Floating-point rows add scalar register/address policy to the shared
     execution controls. Nonmemory operands and inactive columns keep their
     existing partial-pattern care masks. */

  def floating_cases = for List (instruction in selected_fp_instructions):
    def input = instruction_pattern(instruction)
    def scalar = fp_scalar_metadata(instruction)
    def memory_control = if scalar.memory | scalar.memory_control(ScalarMemoryControl()) | inactive_core_memory

    def output = pattern(SuperscalarControl()):
      guest_access: RiscvGuestMemoryAccess.Normal
      alu: if scalar.memory | component_output(RV64ICompleteAluCases, instruction_pattern(ADDI)) | unused_alu
      operand: scalar.operands()
      branch: inactive_branch
      memory: memory_control
      prefetch: CachePrefetchOperation.None
      hint: InstructionHint.None
      writeback:
        partial_pattern(SuperscalarWritebackControl()):
          enable: Bool(scalar.integer_destination)

      system: component_output(SuperscalarSystemCases, instruction_pattern(ADDI))
      muldiv: inactive_long
      vector: NoVectorControl
      fp:
        pattern(SuperscalarFpControl()):
          valid: Bool(#true)
          bits: component_output(selected_fp_controls, input)

    DecodeCase(input, output)

  superscalar_vector_cases(profile) ++ integer_cases ++ cbo_cases ++ wait_cases ++ invalidation_cases ++ guest_cases ++ floating_cases

/* Reuses ordinary LSU controls for explicit guest accesses and serialized CSR actions for fences. */
fun superscalar_hypervisor_cases(svinval :: Boolean) :: List.of(DecodeCase):
  def scalar_cases = scalar_memory_cases(ScalarMemoryControl(), ~xlen: XLen.X64)
  def memory_cases = for List ([instruction, ordinary, execute_read] in RiscvGuestMemoryInstructions):
    def store = ordinary in (RiscvWordStores ++ RiscvDoubleStores)
    def input = instruction_pattern(ordinary)
    def output = pattern(SuperscalarControl()):
      alu: component_output(RV64ICompleteAluCases, instruction_pattern(ADDI))
      operand: if store | atomic_operands | load_reserved_operands
      branch: inactive_branch
      memory: component_output(scalar_cases, input)
      guest_access: if execute_read | RiscvGuestMemoryAccess.GuestExecuteRead | RiscvGuestMemoryAccess.Guest
      prefetch: CachePrefetchOperation.None
      hint: InstructionHint.None
      writeback:
        partial_pattern(SuperscalarWritebackControl()):
          enable: Bool(!store)

      system: component_output(SuperscalarSystemCases, input)
      muldiv: inactive_long
      fp: inactive_core_fp
      vector: NoVectorControl

    DecodeCase(instruction_pattern(instruction), output)

  def fences = [HFENCE_VVMA, HFENCE_GVMA] ++ (if svinval | [HINVAL_VVMA, HINVAL_GVMA] | [])
  memory_cases ++ for List (instruction in fences):
    def output = pattern(SuperscalarControl()):
      alu: unused_alu
      operand: no_operands
      branch: inactive_branch
      memory: inactive_core_memory
      guest_access: RiscvGuestMemoryAccess.Normal
      prefetch: CachePrefetchOperation.None
      hint: InstructionHint.None
      writeback: partial_pattern(SuperscalarWritebackControl()): enable: Bool(#false)
      system:
        pattern(SuperscalarSystemControl()):
          csr: RiscvCsrOperation.None
          immediate: pattern(Bool, _)
          action: csr_instruction_action(instruction)
          fence: SuperscalarFence.None
          wait: ReservationWaitMode.None

      muldiv: inactive_long
      fp: inactive_core_fp
      vector: NoVectorControl

    DecodeCase(instruction_pattern(instruction), output)

export:
  SuperscalarControl
  SuperscalarFpControl
  superscalar_instructions
  superscalar_control_cases
