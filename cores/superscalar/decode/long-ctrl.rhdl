#lang rhodium
/* Composes XLEN-selected M service selection with the shared physical multiply/divide control relations. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("riscv/isa/xlen.rhm").XLen
  lib("cores/common/multiply-decode.rhdl") open
  lib("cores/common/divide-decode.rhdl") open
  lib("riscv/isa/m.rhm") open
  lib("riscv/isa/zmmul.rhm") open
  lib("riscv/rtl/decode.rhdl") open
  lib("rhodium/std/decode.rhdl") open

/* Selects a shared execution service independently of its unobserved physical controls. */
hardware_enum SuperscalarLongOperation:
  None
  Multiply
  Divide

/* Keeps signedness and result projection with each service while inactive fields remain don't-cares. */
bundle SuperscalarLongControl():
  service: SuperscalarLongOperation
  multiply: RiscvMultiplyControl()
  divide: RiscvDivideControl()

/* Adds one service column to each canonical instruction using the existing exact-pattern mappings. */
fun long_cases(instructions :: List.of(InstructionSpec), ~xlen: xlen :: XLen = XLen.X64):
  def multiply = for List (row in (if xlen == XLen.X32 | RV32ZmmulControlCases | RV64ZmmulControlCases)):
    def output = partial_pattern(SuperscalarLongControl()):
      service: SuperscalarLongOperation.Multiply
      multiply: row.output

    DecodeCase(row.input, output)

  def divide = for List (row in (if xlen == XLen.X32 | RV32MDivideControlCases | RV64MDivideControlCases)):
    def output = partial_pattern(SuperscalarLongControl()):
      service: SuperscalarLongOperation.Divide
      divide: row.output

    DecodeCase(row.input, output)

  multiply ++ divide ++ instruction_cases(excluding_instructions(instructions, if xlen == XLen.X32 | RV32MInstructions | RV64MInstructions), partial_pattern(SuperscalarLongControl()): service: SuperscalarLongOperation.None)

export:
  SuperscalarLongOperation
  SuperscalarLongControl
  long_cases
