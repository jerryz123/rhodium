#lang rhodium
/* Compacts two- or three-entry fetch packets into an eight-entry buffer with ordered prefix consumption. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("riscv/isa/xlen.rhm").XLen
  lib("cores/bpred/protocol.rhdl") open
  lib("cores/pc.rhdl") open
  "bundles.rhdl" open
  lib("flow/main.rhdl") open

/* Exposes group_width oldest entries and coalesces partial consumes; clear discards resident and live offers. */
sync_circuit SuperscalarIssueWindow(xlen :: XLen = XLen.X64, ~group_width: group_width :: matching(2) || matching(3) = 2, ~hypervisor: hypervisor :: Boolean = #false):
  interface ingress(Decoupled(SuperscalarPacket(xlen, hypervisor, group_width)), ~role: consumer)
  interface clear(Pulse(), ~role: consumer)
  output head: SuperscalarPacket(xlen, hypervisor, group_width)
  output head_steps: Vec(group_width, SuperscalarPcStep(xlen))
  interface candidates[group_width](Valid(SuperscalarInstruction(xlen, hypervisor)), ~role: producer)
  output available: Bits(4)
  input consume: Bits(2)

  reg count(~init: Bits(4)(0))
  reg entries(Vec(8, SuperscalarInstruction(xlen, hypervisor)))
  def remaining = count - consume.zext(4)
  available <== Bits(4)(8) - count
  ingress.ready <== !clear.valid & (remaining <= Bits(4)(8 - group_width))
  head.count <== mux(count >= Bits(4)(group_width), Bits(2)(group_width), count[0..2])
  def visible = vec(for List (lane in 0..group_width): entries[lane])
  head.entries <== visible
  head_steps <== vec(for List (lane in 0..group_width): entries[lane].step)
  def added = mux(ingress.fire(), ingress.bits.count.zext(4), Bits(4)(0))
  // Observe accepted packets without changing their independent ingress readiness.
  def accepted = interface_link(Valid(SuperscalarPacket(xlen, hypervisor, group_width)))
  accepted.left.valid <== ingress.fire()
  accepted.left.bits <== ingress.bits
  describe_interface_contract(ingress, accepted.left, "packet-acceptance", ~trace_model: interface_trace_combinational())
  def parents = accepted.right |> fork_valid(group_width)
  for (lane in 0..group_width):
    candidates[lane].valid <== (count > Bits(4)(lane)) & !clear.valid
    candidates[lane].bits <== visible[lane]

    def name = "head" ++ to_string(lane)
    describe_interface_window_storage(8, ingress.fire(), consume.zext(4), count, clear.valid, for List (index in 0..group_width): Bool(index == lane), ~name: name, ~append_count: ingress.bits.count.zext(4))
    describe_interface_contract(parents[lane], candidates[lane], "instruction-window-" ++ name, ~trace_model: interface_trace_window(~name: name))

  when (clear.valid):
    count <== Bits(4)(0)
  otherwise:
    count <== remaining + added
    for (index in 0..8):
      def position = Bits(4)(index)
      def append = ingress.fire() & (position >= remaining) & (position < (remaining + added))
      def incoming = position - remaining
      when append:
        entries[index] <== ingress.bits.entries[incoming[0..index_width(group_width)]]
      elsewhen ((consume =/= Bits(2)(0)) & (position < remaining)):
        // Only a consumed prefix can move a survivor. Wire the reachable
        // neighbors at elaboration; no tail row ever wraps to the head.
        def reach = math.min(group_width, 7 - index)
        if reach > 0
        | block:
            def first = entries[index + 1]
            def others = for List (distance in 2 .. (reach + 1)): [distance, entries[index + distance]]
            entries[index] <== (if reach == 1 | first | mux_lookup(consume, ~default: first, others))
        | #void

  assert(count <= Bits(4)(8), "superscalar_instruction_capacity")
  assert(consume <= head.count, "superscalar_issue_prefix")
  when (ingress.valid):
    assert(ingress.bits.count.any() & (ingress.bits.count <= Bits(2)(group_width)), "superscalar_packet_count")

export:
  SuperscalarIssueWindow
