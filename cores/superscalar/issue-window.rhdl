#lang rhodium
/* Compacts two- or three-entry fetch packets into an eight-entry buffer with ordered prefix consumption. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("riscv/isa/xlen.rhm").XLen
  lib("cores/bpred/protocol.rhdl") open
  lib("cores/pc.rhdl") open
  "bundles.rhdl" open
  lib("flow/main.rhdl") open

/* Stores a normalized frontend hint at the frontend's configured width. */
bundle SuperscalarWindowPrediction(xlen :: XLen, target_width :: PosInt):
  valid: Bool
  target: CompactPc(xlen, target_width)

/* Sizes the exceptional PC upper bits; their field is omitted for full-width storage. */
fun window_pc_high_width(xlen :: XLen, pc_width :: PosInt):
  xlen.width - pc_width

/* Preserves exceptional PC bits, the failed parcel, and optional guest provenance. */
bundle SuperscalarWindowFault(xlen :: XLen, hypervisor :: Boolean, pc_width :: PosInt):
  if pc_width < xlen.width:
    pc_high: Bits(window_pc_high_width(xlen, pc_width))

  fault: SuperscalarFetchFault(xlen, hypervisor)

/* A fault never predicts, so its details reuse the normal prediction's storage. */
tagged_union SuperscalarWindowOutcome(xlen :: XLen, hypervisor :: Boolean, pc_width :: PosInt):
  Normal(SuperscalarWindowPrediction(xlen, pc_width))
  Fault(SuperscalarWindowFault(xlen, hypervisor, pc_width))

/* Successful PCs sign-extend independently; faults retain exact high bits in the
   outcome. Direction training indices are reconstructed from the instruction PC;
   the lookup row, history, and assembler's length decision retain independent ownership. */
bundle SuperscalarWindowEntry(xlen :: XLen, hypervisor :: Boolean, pc_width :: PosInt):
  pc: CompactPc(xlen, pc_width)
  instruction: Bits(32)
  raw_parcel: Bits(16)
  step: SuperscalarPcStep(xlen)
  compressed_illegal: Bool
  outcome: SuperscalarWindowOutcome(xlen, hypervisor, pc_width)
  predicted_compressed: Bool
  predicted_ras_action: RasAction
  speculated_ras_action: RasAction
  direction: SuperscalarDirectionCheckpoint()

  /* Expands only visible head entries; compaction moves the narrow records. */
  method expanded(entry) :: SuperscalarInstruction(xlen, hypervisor):
    def Outcome = SuperscalarWindowOutcome(xlen, hypervisor, pc_width)
    def fault = entry.outcome.is(Outcome.Fault).into(Bool)
    def details :: SuperscalarWindowFault(xlen, hypervisor, pc_width) = entry.outcome.view(Outcome.Fault).payload
    def normal :: SuperscalarWindowPrediction(xlen, pc_width) = entry.outcome.view(Outcome.Normal).payload
    def normal_pc = entry.pc.expanded()
    def fault_pc = if pc_width < xlen.width | details.pc_high ++ entry.pc.low | entry.pc.low
    def pc = mux(fault, fault_pc, normal_pc)
    def predicted = !fault & normal.valid
    def target = normal.target.expanded()
    SuperscalarInstruction(xlen, hypervisor):
      pc: pc
      instruction: entry.instruction
      raw_instruction: superscalar_raw_instruction(entry.instruction, entry.raw_parcel)
      sequential_pc: entry.step.apply(pc)
      compressed_illegal: entry.compressed_illegal
      fault: mux(fault, details.fault, literal(SuperscalarFetchFault(xlen, hypervisor), 0))
      prediction:
        BranchPrediction(xlen):
          valid: predicted
          pc: pc
          target: mux(predicted, target, Bits(xlen.width)(0))
          compressed: entry.predicted_compressed
          ras_action: entry.predicted_ras_action
      speculated_ras_action: entry.speculated_ras_action
      direction: entry.direction.expanded(pc)

/* Captures the actual successor and selects mutually exclusive fault/prediction payloads. */
fun pack_entry(xlen :: XLen, hypervisor :: Boolean, pc_width :: PosInt, token :: SuperscalarInstruction(xlen, hypervisor)) :~ SuperscalarWindowEntry(xlen, hypervisor, pc_width):
  def Outcome = SuperscalarWindowOutcome(xlen, hypervisor, pc_width)
  def details:
    if pc_width < xlen.width
    | SuperscalarWindowFault(xlen, hypervisor, pc_width):
        pc_high: token.pc[pc_width..xlen.width]
        fault: token.fault
    | SuperscalarWindowFault(xlen, hypervisor, pc_width):
        fault: token.fault

  def prediction = SuperscalarWindowPrediction(xlen, pc_width):
    valid: token.prediction.valid
    target: CompactPc.prediction(xlen, pc_width, token.prediction.target)

  SuperscalarWindowEntry(xlen, hypervisor, pc_width):
    pc: CompactPc.capture(xlen, pc_width, token.pc)
    instruction: token.instruction
    raw_parcel: token.raw_instruction[0..16]
    step: encode_pc_step(xlen, token.pc, token.sequential_pc)
    compressed_illegal: token.compressed_illegal
    outcome: mux(token.fault.valid(), Outcome.Fault(details), Outcome.Normal(prediction))
    predicted_compressed: token.prediction.compressed
    predicted_ras_action: token.prediction.ras_action
    speculated_ras_action: token.speculated_ras_action
    direction: token.retained_direction()

/* Exposes group_width oldest entries and coalesces partial consumes; clear discards resident and live offers. */
sync_circuit SuperscalarIssueWindow(xlen :: XLen = XLen.X64, ~group_width: group_width :: matching(2) || matching(3) = 2, ~hypervisor: hypervisor :: Boolean = #false, ~pc_width: pc_width :: PosInt = xlen.width):
  unless pc_width <= xlen.width
  | error(~who: #'SuperscalarIssueWindow, "PC storage width must not exceed XLEN")

  interface ingress(Decoupled(SuperscalarPacket(xlen, hypervisor, group_width)), ~role: consumer)
  interface clear(Pulse(), ~role: consumer)
  output head: SuperscalarPacket(xlen, hypervisor, group_width)
  output head_steps: Vec(group_width, SuperscalarPcStep(xlen))
  interface candidates[group_width](Valid(SuperscalarInstruction(xlen, hypervisor)), ~role: producer)
  output available: Bits(4)
  input consume: Bits(2)

  reg count(~init: Bits(4)(0))
  reg entries(Vec(8, SuperscalarWindowEntry(xlen, hypervisor, pc_width)))
  def remaining = count - consume.zext(4)
  available <== Bits(4)(8) - count
  ingress.ready <== !clear.valid & (remaining <= Bits(4)(8 - group_width))
  head.count <== mux(count >= Bits(4)(group_width), Bits(2)(group_width), count[0..2])
  def visible = vec(for List (lane in 0..group_width): entries[lane].expanded())
  head.entries <== visible
  head_steps <== vec(for List (lane in 0..group_width): entries[lane].step)
  def packed :: Vec(group_width, SuperscalarWindowEntry(xlen, hypervisor, pc_width)) = vec(for List (lane in 0..group_width): pack_entry(xlen, hypervisor, pc_width, ingress.bits.entries[lane]))
  def added = mux(ingress.fire(), ingress.bits.count.zext(4), Bits(4)(0))
  // Observe accepted packets without changing their independent ingress readiness.
  def accepted = interface_link(Valid(SuperscalarPacket(xlen, hypervisor, group_width)))
  accepted.left.valid <== ingress.fire()
  accepted.left.bits <== ingress.bits
  describe_interface_contract(ingress, accepted.left, "packet-acceptance", ~trace_model: interface_trace_combinational())
  def parents = accepted.right |> fork_valid(group_width)
  for (lane in 0..group_width):
    candidates[lane].valid <== (count > Bits(4)(lane)) & !clear.valid
    candidates[lane].bits <== visible[lane]
    when (ingress.fire() & (ingress.bits.count > Bits(2)(lane))):
      def token :: SuperscalarInstruction(xlen, hypervisor) = ingress.bits.entries[lane]
      assert(token.raw_instruction === superscalar_raw_instruction(token.instruction, token.raw_instruction[0..16]), "superscalar_window_raw_encoding")
      assert(token.sequential_pc.is_one_of(token.pc + Bits(xlen.width)(2), token.pc + Bits(xlen.width)(4)), "superscalar_window_instruction_length")
      assert(!token.prediction.valid ||| (token.prediction.pc === token.pc), "superscalar_window_prediction_pc")
      assert(!token.prediction.valid ||| CompactPc.fits(xlen, pc_width, token.prediction.target), "superscalar_window_prediction_target")
      assert(token.direction_indices_valid(), "superscalar_window_direction_indices")
      assert(token.fault.supported(), "superscalar_supported_fetch_fault")
      assert(!token.fault.valid() ||| !token.prediction.valid, "superscalar_fault_does_not_predict")
      def pc_fits = CompactPc.fits(xlen, pc_width, token.pc)
      assert(token.fault.valid() ||| pc_fits, "superscalar_window_success_pc_fits")

    def name = "head" ++ to_string(lane)
    describe_interface_window_storage(8, ingress.fire(), consume.zext(4), count, clear.valid, for List (index in 0..group_width): Bool(index == lane), ~name: name, ~append_count: ingress.bits.count.zext(4))
    describe_interface_contract(parents[lane], candidates[lane], "instruction-window-" ++ name, ~trace_model: interface_trace_window(~name: name))

  when (clear.valid):
    count <== Bits(4)(0)
  otherwise:
    count <== remaining + added
    for (index in 0..8):
      def position = Bits(4)(index)
      def append = ingress.fire() & (position >= remaining) & (position < (remaining + added))
      def incoming = position - remaining
      when append:
        entries[index] <== packed[incoming[0..index_width(group_width)]]
      elsewhen ((consume =/= Bits(2)(0)) & (position < remaining)):
        // Only a consumed prefix can move a survivor. Wire the reachable
        // neighbors at elaboration; no tail row ever wraps to the head.
        def reach = math.min(group_width, 7 - index)
        if reach > 0
        | block:
            def first = entries[index + 1]
            def others = for List (distance in 2 .. (reach + 1)): [distance, entries[index + distance]]
            entries[index] <== (if reach == 1 | first | mux_lookup(consume, ~default: first, others))
        | #void

  assert(count <= Bits(4)(8), "superscalar_instruction_capacity")
  assert(consume <= head.count, "superscalar_issue_prefix")
  when (ingress.valid):
    assert(ingress.bits.count.any() & (ingress.bits.count <= Bits(2)(group_width)), "superscalar_packet_count")

export:
  SuperscalarIssueWindow
