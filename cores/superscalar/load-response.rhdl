#lang rhodium
/* Retains accepted memory owners and joins ordered responses for reserved-slot writeback. */
// SPDX-License-Identifier: Apache-2.0

import:
  "bundles.rhdl" open
  lib("cores/load-store.rhdl") open
  lib("cores/cache/operation.rhdl") open
  lib("cores/fp/types.rhdl") open
  lib("riscv/isa/xlen.rhm") open
  lib("flow/main.rhdl") open
  lib("rhodium/std/bits.rhdl").alignment_bits

/* Keeps only return routing, destination identity, and subword formatting until the beat arrives. */
bundle SuperscalarLoadOwner(xlen :: XLen):
  destination: SuperscalarFpOwner(xlen)
  fp_load: Bool
  write: Bool
  precision: FloatPrecision
  access: CacheOperation
  offset: Bits(alignment_bits(memory_word_bytes(xlen)))
  width: MemoryWidth
  unsigned: Bool

/* Joins the live response beat to its queued owner without adding a pipeline stage. */
bundle SuperscalarLoadReturn(xlen :: XLen):
  owner: SuperscalarLoadOwner(xlen)
  data: Bits(xlen.width)

/* Reserves one context per accepted request; pipeline flushes cannot discard committed owners. */
sync_circuit SuperscalarLoadResponse(xlen :: XLen = XLen.X64):
  interface allocate(Valid(SuperscalarLoadOwner(xlen)), ~role: consumer)
  interface response(Decoupled(Bits(xlen.width)), ~role: consumer)
  interface completed(Decoupled(SuperscalarCompletion(xlen)), ~role: producer)
  interface fp_completed(Decoupled(SuperscalarFpLoad(xlen)), ~role: producer)
  output available: Bool
  output pending: Bool
  output drained: Bool
  interface ordered_completed(Pulse(), ~role: producer)

  inst owners(Queue(SuperscalarLoadOwner(xlen), 4))
  allocate |> to_decoupled() |> owners.ingress
  available <== owners.ingress.ready
  // Admission queries retained owners; drain also covers this cycle's allocation.
  pending <== owners.count.any()
  drained <== !pending & !allocate.valid
  def joined = Array(response, owners.egress) |> zip_flow(data, owner):
    SuperscalarLoadReturn(xlen):
      owner: owner
      data: data

  def result :: SuperscalarLoadReturn(xlen) = joined.bits
  ordered_completed.valid <== joined.fire() & !result.owner.access.is_one_of(CacheOperation.Load, CacheOperation.Store)
  inst load(LoadGen(xlen, memory_word_bytes(xlen)))
  load.address <== result.owner.offset.zext(xlen.width)
  load.width <== result.owner.width
  load.unsigned_load <== result.owner.unsigned
  load.data <== result.data
  def Array(integer_return, fp_return) = joined |> demux_flow(2, beat => beat.owner.fp_load)
  (fp_return |> map_flow(beat => SuperscalarFpLoad(xlen)):
    owner: beat.owner.destination
    precision: beat.owner.precision
    data: load.value.zext(64)
  ) |> fp_completed

  def completion = integer_return |> map_flow(beat => SuperscalarCompletion(xlen)):
    identity: beat.owner.destination.identity
    rd: beat.owner.destination.rd
    write: beat.owner.write
    data: mux(beat.owner.access === CacheOperation.Load, load.value, beat.data)

  completion |> completed

export:
  SuperscalarLoadOwner
  SuperscalarLoadResponse
