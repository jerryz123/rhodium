#lang rhodium
/* Translates Superscalar cache lookups, raw-word returns, and explicit split requests for the vector LSU controller. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/common/mmu/context.rhdl").GuestMemoryReq
  lib("cores/common/cosim-source.rhm").describe_cosim_signals
  lib("cores/common/vector/memory-controller.rhdl") open
  "bundles.rhdl" open
  lib("cores/common/vector/bundles.rhdl") open
  lib("cores/common/cache/operation.rhdl") open
  lib("cores/common/cache/protocol.rhdl") open
  lib("cores/common/load-store.rhdl") open
  lib("cores/common/misaligned-access.rhdl") open
  lib("riscv/isa/xlen.rhm") open
  lib("riscv/rtl/trap.rhdl") open
  lib("riscv/rtl/atomic.rhdl") open
  lib("riscv/rtl/hypervisor.rhdl") open
  lib("riscv/rtl/pointer-masking.rhdl") open
  lib("riscv/rtl/zihintntl.rhdl") open
  lib("rhodium/std/bits.rhdl").Pow2Int
  lib("flow/main.rhdl") open

/* Resolves each attempt after the EX/MEM lookup and reserves accepted response tags.
   A retry flushes only unaccepted attempts. Split requests retain their token until
   the final fault or response, while previously accepted ordinary returns drain. */
sync_circuit SuperscalarVectorMemory(xlen :: XLen, slots :: Pow2Int):
  def Token = VectorToken(xlen, Bits(xlen.width), slots)
  def Tag = Bits(index_width(slots))
  def Context = SuperscalarMemoryContext(xlen, slots)
  /* Keeps the original beat and exact masked address beside its fixed-cycle lookup. */
  bundle Attempt():
    token: Token
    request: PhysicalMemoryReq(xlen, Bool)
    misaligned: Bool

  /* Retains the MEM outcome until its WB authorization edge. */
  bundle Decision():
    attempt: Attempt()
    response: SuperscalarLookupResult(xlen)

  interface issue(Decoupled(Token), ~role: consumer)
  interface pipeline(SuperscalarPipelineAccess(xlen), ~role: requester)
  interface memory(SuperscalarMemory(xlen, Context), ~role: requester)
  interface split(RiscvSplitAccess(xlen, Bool), ~role: requester)
  interface feedback(Valid(VectorCommit(xlen, slots)), ~role: producer)
  interface outcome(Valid(VectorCommit(xlen, slots)), ~role: producer)
  interface completion(Decoupled(VectorCompletion(xlen, slots)), ~role: producer)
  interface store_completed(Valid(Tag), ~role: producer)
  input pointer_masking: PointerMaskControl()
  output outcome_guest: RiscvGuestFault()
  output(idle, requests_idle, memory_start_ready, pipeline_physical, request_physical): Bool


  /* Shared lookup issue and outstanding completion credits.
     Recovery flushes unaccepted attempts; memory retains accepted context and split ownership survives. */

  inst controller(VectorMemoryController(xlen, slots))
  issue |> controller.issue
  controller.feedback |> feedback
  controller.outcome |> outcome
  controller.completion |> completion
  controller.store_completed |> store_completed
  memory_start_ready <== controller.memory_start_ready
  inst outstanding(CreditCounter(slots))
  wire split_capture: Bool
  // Certified addresses are aligned, so a split never takes a retained ring entry.
  controller.skip <== Bool(#false)


  /* Lookup formation.
     The shared issue path supplies the timed beat; Superscalar positions raw cache words. */

  def Array(lookup_attempt, retained_attempt) = controller.lookup |> fork_valid(2)
  def address = mux(controller.lookup.bits.precertified, controller.lookup.bits.physical_address, apply_pointer_mask(xlen, controller.lookup.bits.address, pointer_masking))
  pipeline_physical <== controller.lookup.bits.precertified
  def width = controller.lookup.bits.memory_width.into(MemoryWidth)
  inst store_data(StoreGen(xlen, xlen.width / 8))
  store_data.address <== address
  store_data.width <== width
  store_data.value <== controller.lookup.bits.store_data
  def request = PhysicalMemoryReq(xlen, Bool):
    context: Bool(#false)
    address: address
    access: mux(controller.lookup.bits.store, CacheOperation.Store, CacheOperation.Load)
    atomic: RiscvAtomicOperation.Swap
    width: width
    data: store_data.data
    byte_mask: controller.lookup.bits.byte_mask
    locality: RiscvMemoryLocality.Default
    unsigned: Bool(#true)

  def misaligned = controller.lookup.bits.enabled & !width.is_aligned(address)
  (lookup_attempt |> filter_valid(token => token.enabled & !misaligned & !controller.recover) |> map_valid(_token => GuestMemoryReq(PhysicalMemoryReq(xlen, Bool))):
    memory: request
    translation: RiscvGuestMemoryAccess.Normal
  ) |> pipeline.request


  /* MEM: Pair the retained beat with the lookup result.
     A missing result or misaligned attempt takes the slow path, never a hit. */

  def mem = (
    retained_attempt |> map_valid(token => Attempt()):
      token: token
      request: request
      misaligned: misaligned
  ) |> valid_pipe(1, ~flush: controller.recover)

  def arrival = (
    mem |> map_valid(attempt => Decision()):
      attempt: attempt
      response: pipeline.response.bits.updated(~outcome: mux(pipeline.response.valid & !attempt.misaligned, pipeline.response.bits.outcome, SuperscalarCacheOutcome.Slow))
  ) |> valid_pipe(1, ~flush: controller.recover)


  /* Converts a split reply into the same native WB result used for aligned attempts. */
  fun finish_split(saved :: Attempt(), reply :: RiscvSplitResult(xlen, Bool)) :~ Decision():
    def result = priority_mux(~default: SuperscalarCacheOutcome.LoadHit):
      reply.guest.page_fault: SuperscalarCacheOutcome.GuestPageFault
      reply.page_fault: SuperscalarCacheOutcome.PageFault
      reply.response.access_fault: SuperscalarCacheOutcome.AccessFault
    Decision():
      attempt: saved
      response:
        SuperscalarLookupResult(xlen):
          outcome: result
          data: reply.response.data
          guest: reply.guest.details

  def (wb :: Endpoint.of(Valid(Decision())), split_owner :: Endpoint.of(Decoupled(Attempt()))) = vector_split_writeback(
    arrival, split.response, split_capture,
    ~save: fun (decision :: Decision()): decision.attempt,
    ~finish: finish_split)
  def split_pending = split_owner.valid
  controller.split_pending <== split_pending
  def saved :: Attempt() = split_owner.bits
  def Array(ordinary_request, split_request, decision_path) = wb |> fork_valid(3)
  def native :: Decision() = wb.bits
  def attempt = native.attempt
  def token = attempt.token
  request_physical <== token.precertified
  def access = wb.valid & token.enabled
  def slow = access & (native.response.outcome === SuperscalarCacheOutcome.Slow)
  def split_attempt = slow & attempt.misaligned
  def ordinary = slow & !attempt.misaligned
  def store_hit = access & (native.response.outcome === SuperscalarCacheOutcome.StoreHit)
  def store_commit = store_hit & !memory.ordered_busy
  pipeline.commit <== store_commit
  (ordinary_request |> filter_valid(_decision => ordinary & !outstanding.full & !memory.ordered_busy) |> map_valid(decision):
    def request :: PhysicalMemoryReq(xlen, Bool) = decision.attempt.request
    def owner = SuperscalarVectorMemoryOwner(xlen, slots):
      tag: decision.attempt.token.completion_tag
      offset: request.address[0..index_width(xlen.width / 8)]
      width: request.width
    GuestMemoryReq(PhysicalMemoryReq(xlen, Context)):
      memory: request.with_address_context(request.address, Context.Vector(owner))
      translation: RiscvGuestMemoryAccess.Normal
  ) |> offer_decoupled() |> memory.request
  (split_request |> filter_valid(_decision => split_attempt & !memory.ordered_busy & controller.split_capacity) |> map_valid(decision => decision.attempt.request.updated(~data: decision.attempt.token.store_data))
  ) |> offer_decoupled() |> split.request
  split_capture <== split.request.fire()


  /* Accepted ordinary replies carry their retained extraction geometry.
     Credits survive recovery without retaining another copy of each owner. */

  def accepted = memory.request.fire()
  outstanding.increment <== accepted
  def returned = memory.response.bits
  def owner :: SuperscalarVectorMemoryOwner(xlen, slots) = returned.context.view(Context.Vector).payload
  inst returned_data(LoadGen(xlen, xlen.width / 8))
  returned_data.address <== owner.offset.zext(xlen.width)
  returned_data.width <== owner.width
  returned_data.unsigned_load <== Bool(#true)
  returned_data.data <== returned.data
  (memory.response |> gate_flow(!outstanding.empty) |> map_flow(_reply => VectorCompletion(xlen, slots)):
    tag: owner.tag
    data: returned_data.value
  ) |> controller.returned
  outstanding.decrement <== memory.response.fire()


  /* Translate cache and admission failures into a vector decision. Split data
     is already assembled, while ordinary hits still need raw-word extraction. */

  def lookup_fault = access & native.response.outcome.is_one_of(SuperscalarCacheOutcome.PageFault, SuperscalarCacheOutcome.GuestPageFault, SuperscalarCacheOutcome.AccessFault)
  def admission_fault = memory.request.valid & memory.fault.valid
  def fault = lookup_fault ||| admission_fault
  def lookup_retry = native.response.outcome === SuperscalarCacheOutcome.Replay
  def ordinary_retry = ordinary & !accepted
  def store_retry = (store_hit & !store_commit) ||| (store_commit & !pipeline.commit_ready)
  def split_retry = split_attempt & !split.request.fire()
  def access_retry = access & !split_pending & !fault & (memory.ordered_busy ||| lookup_retry ||| ordinary_retry ||| store_retry ||| split_retry)
  def hit = wb.valid & !slow & !fault & !access_retry
  inst hit_data(LoadGen(xlen, xlen.width / 8))
  hit_data.address <== attempt.request.address
  hit_data.width <== attempt.request.width
  hit_data.unsigned_load <== Bool(#true)
  hit_data.data <== native.response.data
  def hit_value = hit_data.value
  def page_fault = native.response.outcome === SuperscalarCacheOutcome.PageFault
  def guest_page_fault = native.response.outcome === SuperscalarCacheOutcome.GuestPageFault
  def lookup_cause = data_fault_cause(token.store, ~page_fault: page_fault, ~guest_page_fault: guest_page_fault)
  def fault_address = priority_mux(~default: attempt.request.address):
    split_pending: split.response.bits.fault_address
    admission_fault: memory.fault.bits.value

  (decision_path |> map_valid(_decision => VectorMemoryDecision(xlen, slots)):
    token: token
    action: vector_memory_action(
      ~fault: fault, ~retry: access_retry, ~accepted: accepted,
      ~split_start: split_capture, ~split_return: split_pending
    )
    data: mux(split_pending, native.response.data, hit_value)
    cause: mux(admission_fault, memory.fault.bits.cause, lookup_cause)
    fault_address: fault_address
  ) |> controller.decision
  outcome_guest <== mux(admission_fault, memory.fault.bits.guest, native.response.guest)
  when (wb.valid & token.precertified):
    assert(!attempt.misaligned, "superscalar_certified_vector_request_is_aligned")

  /* Quiescence includes accepted owners as well as unaccepted attempts.
     A drained attempt pipeline alone does not release outstanding responses. */

  controller.mem_valid <== mem.valid
  controller.wb_valid <== arrival.valid
  requests_idle <== controller.issue_idle & !mem.valid & !arrival.valid
  idle <== requests_idle & outstanding.empty & controller.split_capacity
  assert(!(accepted & (controller.retry ||| fault)), "superscalar_vector_accepted_request_never_replays")

  /* Observe actual completion and retained split ownership without changing LSU timing. */

  describe_cosim_signals({
    "direct": hit & !token.precertified & !split_pending,
    "direct_tag": token.completion_tag,
    "direct_data": hit_value,
    "completed": completion.fire(),
    "completion": completion.bits,
    "store_completed": store_completed.valid,
    "store_completed_tag": store_completed.bits,
    "fault": fault,
    "fault_tag": token.completion_tag,
    "fault_address": fault_address,
    "split": split.request.fire(),
    "split_tag": saved.token.completion_tag,
    "request_tag": token.completion_tag
  })

export SuperscalarVectorMemory
