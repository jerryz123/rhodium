#lang rhodium
/* Implements shared two/three-lane execution with four read paths, per-lane GPR write ports, and precise WB retirement. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/pc.rhdl") open
  lib("cores/fetch/redirect.rhdl") open
  lib("rhodium/core/ir.rhm").Module
  lib("rhodium/frontend/foundation.rhm").CircuitDefinition
  lib("rhodium/frontend/layers/statistics.rhm").stat_count
  lib("cores/bpred/statistics.rhdl") open
  lib("cores/fp/profile.rhm").fp_transport_profile
  lib("cores/reservation-wait.rhdl") open
  lib("cores/integer-format.rhdl") open
  lib("cores/register-file.rhdl").RegisterFile
  lib("cores/register-write.rhdl").RegisterFileWrite
  lib("cores/operand.rhdl") open
  lib("riscv/rtl/hypervisor.rhdl") open
  "profile.rhm" open
  "bundles.rhdl" open
  "issue-window.rhdl" open
  "issue.rhdl" open
  "lane-pipe.rhdl" open
  "branch-training.rhdl".SuperscalarBranchTrainingBuffer
  "pairing.rhdl" open
  "read-operands.rhdl" open
  "load-response.rhdl" open
  "long-execution.rhdl" open
  "fp.rhdl" open
  "vector.rhdl" open
  "memory-ports.rhdl" open
  lib("cores/vector/decode.rhdl") open
  lib("cores/vector/bundles.rhdl") open
  lib("cores/vector/precheck.rhdl") open
  lib("cores/mmu/vector.rhdl") open
  lib("riscv/isa/vector-profile.rhm") open
  lib("riscv/rtl/vector.rhdl") open
  lib("hardfloat/main.rhdl").RoundingMode
  lib("cores/fp/bundles.rhdl") open
  lib("cores/fp/types.rhdl") open
  lib("cores/fp/timing.rhdl") open
  lib("cores/writeback-calendar.rhdl") open
  lib("riscv/isa/fp-profile.rhm") open
  lib("riscv/rtl/floating-point.rhdl") open
  "../cosim-source.rhm".describe_cosim_hart
  "decode/core-ctrl.rhdl" open
  "decode/mem-ctrl.rhdl".SuperscalarMemoryControl
  "decode/system-ctrl.rhdl" open
  "decode/long-ctrl.rhdl" open
  lib("cores/multiplier.rhdl").MultiplierRequest
  lib("cores/multiplier.rhdl").PipelinedMultiplierStages
  lib("cores/divider.rhdl").DividerRequest
  lib("cores/csr/file.rhdl").RiscvCsrFile
  lib("cores/csr/protocol.rhdl") open
  lib("cores/alu.rhdl") open
  lib("cores/branch-resolver.rhdl") open
  lib("cores/bpred/protocol.rhdl") open
  lib("cores/bpred/ras.rhdl").riscv_ras_action
  lib("cores/load-store.rhdl") open
  lib("cores/cache/operation.rhdl") open
  lib("cores/cache-prefetch.rhdl") open
  lib("cores/cache/protocol.rhdl").PhysicalMemoryReq
  lib("cores/misaligned-access.rhdl") open
  lib("riscv/isa/xlen.rhm") open
  lib("riscv/isa/csr.rhm") open
  lib("riscv/model/formats.rhm") as fields
  lib("riscv/rtl/instruction-fields.rhdl") open
  lib("riscv/rtl/trap.rhdl") open
  lib("riscv/rtl/csr.rhdl") open
  lib("riscv/rtl/privilege.rhdl") open
  lib("riscv/rtl/interrupt.rhdl").RiscvInterrupts
  lib("riscv/rtl/cmo.rhdl") open
  lib("riscv/rtl/zihintntl.rhdl") open
  lib("rhodium/std/decode.rhdl") open
  lib("rhodium/std/scoreboard.rhdl") open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open
  lib("riscv/rtl/svpbmt.rhdl").PageMemoryType
  lib("riscv/rtl/pointer-masking.rhdl") open

/* Tracks one nonreplayable WB owner from older-work drain through service completion. */
hardware_enum SuperscalarRetainedState:
  Idle
  Draining
  Ready
  Accepted

/* Interlocks a younger write against every older result that may complete after WB. */
fun pending_destination(xlen :: XLen, hypervisor :: Boolean, address :: Bits(5), producers :: List.of(Endpoint)) :: Bool:
  def matches = for List (producer in producers):
    def token :: SuperscalarResult(xlen, hypervisor) = producer.bits
    producer.valid & token.write & !token.result_ready & (token.rd === address)

  address.any() & any(matches)

/* Executes RV32/RV64 integer, optional RV64 F/D, and system operations with precise WB-owned state.
   The supplied issue circuit owns admission; each lane has a fixed GPR write port.
   Every lane can own a shared service; issue preserves the existing shared bandwidth.
   Resolution inputs qualify the corresponding live MEM token in the same cycle. */
sync_circuit SuperscalarCore(profile :: SuperscalarPipelineConfig = SuperscalarPipelineConfig(), ~issue: issue :: Module || CircuitDefinition, ~fp_timing: selected_fp_timing :: FpExecutionTiming = FpExecutionTiming()):
  def xlen = profile.xlen
  def hypervisor = profile.hypervisor
  def issue_width = superscalar_issue_width(xlen, issue)
  def return_port = issue_width - 1

  /* Adapts the three-lane owner encoding to this specialization's vector index. */
  fun service_index(index :: Bits(2)) :~ Bits(index_width(issue_width)):
    if issue_width == 2 | index[0..1] | index

  input interrupts: RiscvInterrupts()
  input hart_id: Bits(64)
  input time_counter: Bits(64)
  interface instructions(Decoupled(SuperscalarPacket(xlen, hypervisor, issue_width)), ~role: consumer)
  interface resolution[issue_width](Valid(SuperscalarResolution(xlen)), ~role: consumer)
  interface memory_stage[issue_width](Valid(SuperscalarInstruction(xlen, hypervisor)), ~role: producer)
  interface retired[issue_width](Valid(SuperscalarRetirement(xlen, hypervisor)), ~role: producer)
  interface prefetch(Valid(CachePrefetchReq(64)), ~role: producer)
  interface redirect(Valid(SuperscalarRedirect(xlen)), ~role: producer)
  interface fetch_flush(Pulse(), ~role: producer)
  interface instruction_invalidate(Pulse(), ~role: producer)
  interface branch_update(Valid(BranchUpdate(xlen)), ~role: producer)
  interface predictor_restore(Pulse(), ~role: producer)
  interface predictor_clear(Pulse(), ~role: producer)
  interface direction_update(Valid(TournamentUpdate(10)), ~role: producer)
  interface ras_resolution(Valid(RasResolution(xlen)), ~role: producer)
  interface history_commit(Valid(SuperscalarHistoryCommit(issue_width)), ~role: producer)
  interface history_restore(Valid(Bits(10)), ~role: producer)
  interface memory(SuperscalarMemory(xlen, xlen.width), ~role: requester)
  interface split(RiscvSplitAccess(xlen, Bool), ~role: requester)
  output split_guest_access: RiscvGuestMemoryAccess
  interface pipeline(SuperscalarPipelineAccess(xlen), ~role: requester)
  interface completed(Valid(SuperscalarCompletion(xlen)), ~role: producer)
  output issued: Bits(2)
  output retired_count: Bits(2)
  output instruction_capacity: Bits(4)
  output sleeping: Bool
  output translation_state: SuperscalarTranslationState(xlen)
  output translation_flush: Bool
  interface vector_precheck(VectorPrecheck(), ~role: requester)
  interface vector_fast(VectorFastCheck(xlen), ~role: requester)
  output(pipeline_vector, request_vector): Bool

  def fp_enabled = floating_point_supports_f(profile.floating_point)
  def vector_enabled = vector_profile_enabled(profile.vector)
  def vector_elen = vector_profile_elen(if vector_enabled | profile.vector | VectorProfile.Zve32x)
  def vector_slots = profile.vector_completion_slots
  def fp_timing = selected_fp_timing.at_least(2)
  def gpr_span = math.max(5, math.max(PipelinedMultiplierStages + 2, fp_timing.maximum + 2))
  def gpr_delay_width = index_width(gpr_span + 1)
  def trace_letters = ["i", "m", "a"] ++ (if fp_enabled | ["f"] | []) ++ (if floating_point_supports_d(profile.floating_point) | ["d"] | []) ++ ["c", "b"] ++ (if vector_profile_is_v(profile.vector) | ["v"] | [])
  def trace_isa = "rv" ++ to_string(xlen.width) ++ String.join(trace_letters, "") ++ "_" ++ String.join(profile.isa_profile.isa_extensions.filter(~keep: fun (name): name.length() > 1), "_")


  /* Shared scalar/vector memory ports and optional vector execution.
     Core WB retains architectural age and admission policy; the adapter owns
     accepted memory routing and the vector pipeline owns descriptor execution. */

  inst memory_ports(SuperscalarMemoryPorts(xlen))
  def scalar_memory = memory_ports.scalar_memory
  def scalar_pipeline = memory_ports.scalar_pipeline
  def scalar_split = memory_ports.scalar_split
  memory_ports.memory <=> memory
  memory_ports.pipeline <=> pipeline
  memory_ports.split <=> split
  split_guest_access <== memory_ports.split_guest_access
  pipeline_vector <== memory_ports.pipeline_vector
  request_vector <== memory_ports.request_vector
  inst vector(
    if vector_enabled
    | SuperscalarVectorPipeline(
        xlen, profile.vector_length,
        ~vector_completion_slots: vector_slots, ~dispatch_depth: profile.vector_dispatch_depth,
        ~fixed_fp: #true, ~fp_timing: fp_timing
      )
    | SuperscalarVectorDisabled(xlen, ~vector_completion_slots: vector_slots)
  )
  vector.memory <=> memory_ports.vector_memory
  vector.pipeline <=> memory_ports.vector_pipeline
  vector.split <=> memory_ports.vector_split
  vector.precheck <=> vector_precheck
  vector_fast.pipeline_physical <== vector.pipeline_physical
  vector_fast.request_physical <== vector.request_physical


  /* Pipeline storage and stage paths.
     Flow owns feed-forward registers; the issue window owns prefix retention.
     Backward recovery links do not add pipeline storage. */

  inst rr_window(SuperscalarIssueWindow(xlen, ~hypervisor: profile.hypervisor, ~group_width: issue_width))
  def ex_pipe = for InstanceArray (lane in 0..issue_width):
    inst stage(SuperscalarExecutePipe(xlen, ~hypervisor: hypervisor, ~completion_slot: lane == return_port))
    stage

  def mem_pipe = for InstanceArray (lane in 0..issue_width):
    inst stage(SuperscalarResultPipe(xlen, ~hypervisor: hypervisor, ~completion_slot: lane == return_port))
    stage

  def wb_pipe = for InstanceArray (lane in 0..issue_width):
    inst stage(SuperscalarResultPipe(xlen, ~hypervisor: hypervisor, ~completion_slot: lane == return_port))
    stage

  def ex_older = ex_pipe[0]
  def mem_older = mem_pipe[0]
  def wb_older = wb_pipe[0]

  // Group payload has no separate validity: every live group has an older lane.
  def Region = Bits(xlen.width - SuperscalarPcOffsetBits)
  reg ex_pc_region(Region)
  reg mem_pc_region(Region)
  reg wb_pc_region(Region)
  reg ex_younger_next_region(Vec(issue_width - 1, Bool))
  reg mem_younger_next_region(Vec(issue_width - 1, Bool))
  reg wb_younger_next_region(Vec(issue_width - 1, Bool))
  for (stage in [ex_pipe, mem_pipe, wb_pipe], region in [ex_pc_region, mem_pc_region, wb_pc_region], next_region in [ex_younger_next_region, mem_younger_next_region, wb_younger_next_region], name in ["ex", "mem", "wb"]):
    stage[0].pc_region <== region
    for (lane in 1..issue_width):
      stage[lane].pc_region <== region + next_region[lane - 1].as_bits().zext(Region.width)
      assert(!stage[lane].egress.valid ||| stage[lane - 1].egress.valid, "superscalar_" ++ name ++ "_younger_has_older_" ++ to_string(lane))


  /* One FP request per group.
     Pair admission selects one FP owner. Capture its request on the older
     transfer even when the owner is younger; lane validity still gates every
     consumer after squash. EX keeps the full numeric request; MEM/WB retain
     only authorization and divide/sqrt metadata in the group register. */

  def FpRequest = FpExecutionRequest(xlen, fp_transport_profile(xlen), SuperscalarFpSchedule())
  reg ex_fp_request(FpRequest)
  reg mem_fp_request(SuperscalarFpRetirement(xlen))
  reg wb_fp_request(SuperscalarFpRetirement(xlen))
  // Retired training survives speculative recovery; RR books its future WB occupancy.
  inst branch_training(SuperscalarBranchTrainingBuffer(xlen, ~group_width: issue_width))
  wire wb_squash: Bool
  wire rr_squash: Bool
  reg rr_vector_retry_wait(~init: Bool(#false))
  def ex_paths :: List.of(InterfaceArrayFields) = for List (lane in 0..issue_width):
    def observed = ex_pipe[lane].egress |> filter_valid(_token => !rr_squash) |> trace_valid_event("core/s2.ex.slot" ++ to_string(lane), ~fields: token):
      pc: ex_pipe[lane].pc
      instruction(~format: "riscv", ~isa: trace_isa, ~pc: "pc"): ex_pipe[lane].raw_instruction

    observed |> fork_valid(4)

  def wb_paths :: List.of(InterfaceArrayFields) = for List (lane in 0..issue_width): wb_pipe[lane].egress |> fork_valid(4)
  def ex_links :: List.of(Handle) = for List (_ in 0..issue_width): interface_link(Valid(SuperscalarResult(xlen, hypervisor)))
  def mem_links :: List.of(Handle) = for List (_ in 0..issue_width): interface_link(Valid(SuperscalarResult(xlen, hypervisor)))
  def ex_results :: List.of(Endpoint) = for List (link in ex_links): link.right
  def mem_results :: List.of(Endpoint) = for List (link in mem_links): link.right
  wire mem_branch_redirect: Bool
  wire wb_drained: Bool
  wire wb_csr_return: Vec(issue_width, Bool)


  /* Shared architectural and floating-point services.
     WB owns CSR commands and retirement; FP and fixed GPR returns use
     explicit reservations rather than independent lane backpressure. */

  inst wb_csrs(RiscvCsrFile(profile.csr_config))
  def empty_guest :: RiscvGuestFault() = literal(RiscvGuestFault(), 0)
  def guest_state :: RiscvHypervisorTranslation() = if profile.hypervisor | wb_csrs.guest_translation | literal(RiscvHypervisorTranslation(), 0)
  // Only committed redirects own this slot. An early MEM rejection merely
  // stops fetch; an older fault can still discard the resolving branch.
  wire wb_redirect_pending: Bool
  wire wb_redirect_pc: Bits(xlen.width)
  def wb_redirect_fault = rejected_fetch(xlen, wb_redirect_pc, wb_csrs.privilege, wb_csrs.satp, guest_state)
  wire wb_reject_target: Bool
  translation_state <== SuperscalarTranslationState(xlen):
    guest: guest_state
    pointer_masking: wb_csrs.pointer_masking
    guest_pointer_masking: if profile.hypervisor | wb_csrs.guest_pointer_masking | wb_csrs.pointer_masking
    privilege: wb_csrs.privilege
    mstatus: wb_csrs.mstatus
    satp: wb_csrs.satp
    pbmte: wb_csrs.pbmte

  translation_flush <== wb_csrs.translation_flush
  wb_csrs.interrupts <== interrupts
  wb_csrs.hart_id <== hart_id[0..xlen.width]
  wb_csrs.time_counter <== time_counter
  inst fp(if fp_enabled | SuperscalarFp(xlen, fp_timing, ~half_precision: profile.execution_half_precision, ~zfa: profile.zfa, ~vector_slots: vector_slots) | SuperscalarFpDisabled(xlen, ~vector_slots: vector_slots))
  vector.floating_writeback |> fp.vector_writeback
  wb_csrs.fp_update.valid <== fp.state_update.valid ||| vector.fp_update.valid ||| vector.floating_result.valid
  wb_csrs.fp_update.bits <== mux(fp.state_update.valid, fp.state_update.bits, Bits(5)(0)) ||| mux(vector.fp_update.valid, vector.fp_update.bits, Bits(5)(0))
  if fp_enabled
  | block:
      vector.fp_request |> fp.vector_request
      fp.vector_result |> vector.fp_result
      vector.floating_result |> fp.vector_write
  | block:
      vector.fp_request.ready <== Bool(#false)
      vector.fp_result.valid <== Bool(#false)
      vector.fp_result.bits <== dont_care(vector.fp_result.bits.type)
      fp.vector_request.valid <== Bool(#false)
      fp.vector_request.bits <== dont_care(fp.vector_request.bits.type)
      fp.vector_result.ready <== Bool(#true)
      fp.vector_write.valid <== Bool(#false)
      fp.vector_write.bits <== dont_care(fp.vector_write.bits.type)

  // Fixed FP and multiply share the last RF port, booked at RR before EX launch.
  inst wb_gpr_calendar(WritebackCalendar(4, gpr_span, ~queries: 3))
  wb_gpr_calendar.query_client <== vec(Bits(2)(0), Bits(2)(1), Bits(2)(3))
  wb_gpr_calendar.query_delay[1] <== Bits(gpr_delay_width)(PipelinedMultiplierStages + 1)
  wb_gpr_calendar.query_delay[2] <== Bits(gpr_delay_width)(3)
  wire wb_completion_priority: Bool
  inst wb_fp_gpr_scoreboard(Scoreboard(32))
  def wb_fp_gpr = fp.completion |> filter_valid(result => (result.tag.destination === FloatDestination.Integer) & result.tag.rd.any())
  def wb_fp_late_gpr = wb_fp_gpr |> filter_valid(result => !result.tag.direct)
  wb_fp_gpr_scoreboard.clear.valid <== wb_fp_late_gpr.valid
  wb_fp_gpr_scoreboard.clear.bits <== wb_fp_late_gpr.bits.tag.rd
  wire wb_fp_variable_accepted: Bool
  wire wb_fp_fixed_authorized: Bool
  vector.saturate |> wb_csrs.vector_saturate
  vector.fault_start |> wb_csrs.vector_fault_start
  vector.truncate |> wb_csrs.vector_truncate
  reg wb_vector_scalar_pending(~init: Bool(#false))
  reg wb_vector_scalar_owner(SuperscalarInstructionIdentity(xlen))
  reg wb_vector_scalar_rd(Bits(5))
  def wb_vector_scalar_return = vector.scalar_result.valid & vector.scalar_result.bits.address.any()
  def wb_vector_scalar_available = !wb_vector_scalar_pending ||| wb_vector_scalar_return
  reg rr_vector_writeback_waiting(~init: Bool(#false))
  inst wb_vector_scoreboard(Scoreboard(32))
  vector.scalar_result |> filter_valid(result => result.address.any()) |> map_valid(result => result.address) |> wb_vector_scoreboard.clear
  reg wb_vector_fpr_pending(~init: Bool(#false))
  vector.scalar_writeback |> gate_flow(!wb_completion_priority) |> map_flow(delay => if gpr_delay_width <= 4 | delay[0..gpr_delay_width] | delay.zext(gpr_delay_width)) |> wb_gpr_calendar.reserve[2]
  // Stop new last-port bookings long enough to create a return slot.
  // A starving scalar completion retains its existing bounded-age priority.
  rr_vector_writeback_waiting <== vector.scalar_writeback.valid & !vector.scalar_writeback.ready
  reg wb_sleeping(~init: Bool(#false))
  reg wb_resume_pc(~init: Bits(xlen.width)(0))
  reg wb_pc_known(~init: Bool(#false))
  wire wb_reservation_waiting: Bool
  sleeping <== wb_sleeping ||| wb_reservation_waiting
  inst wb_load_response(SuperscalarLoadResponse(xlen))
  reg wb_ordered_memory_pending(~init: Bool(#false))
  reg wb_prior_memory_drained(~init: Bool(#false))
  inst ex_multiply(SuperscalarMultiply(xlen, ~vector_slots: vector_slots))
  inst wb_divide(SuperscalarDivide(xlen, ~vector_slots: vector_slots))
  vector.multiply_request |> ex_multiply.vector_request
  ex_multiply.vector_result |> vector.multiply_result
  vector.divide_request |> wb_divide.vector_request
  wb_divide.vector_result |> vector.divide_result
  inst rr_completions(RRArbiter(SuperscalarCompletion(xlen), 2))
  inst wb_scoreboard(Scoreboard(32))
  wire wb_management_response: Bool
  def Array(wb_ordinary_response, wb_management_return) = scalar_memory.response |> demux_flow(2, _data => wb_management_response)
  wb_ordinary_response |> wb_load_response.response
  def wb_management_completed = wb_management_return |> to_valid()
  wb_load_response.fp_completed |> fp.load_return


  /* Committed completion transport.
     Deferred results reserve the last issue slot and travel to its WB
     write port. Already committed responses never take speculative flush. */

  for (source in [wb_load_response.completed, wb_divide.completed], index in 0..2):
    source |> rr_completions.ingress[index]

  def rr_completion = rr_completions.egress |> gate_flow(wb_gpr_calendar.registered_free[2] & (!rr_vector_writeback_waiting ||| wb_completion_priority)) |> to_valid()
  reg rr_completion_age(~init: Bits(3)(0))
  when (!rr_completions.egress.valid ||| rr_completions.egress.fire()):
    rr_completion_age <== Bits(3)(0)
  elsewhen (!rr_completion_age.all()):
    rr_completion_age <== rr_completion_age + Bits(3)(1)

  wb_completion_priority <== rr_completion_age.all()
  wb_gpr_calendar.pause <== Bool(#false)
  def ex_completion = ex_pipe[return_port].completion
  def mem_completion = mem_pipe[return_port].completion
  def wb_completion = wb_pipe[return_port].completion
  rr_completion |> ex_pipe[return_port].returned
  ex_completion |> mem_pipe[return_port].returned
  mem_completion |> wb_pipe[return_port].returned

  def wb_gpr_return = Array(wb_completion, ex_multiply.completed) |> valid_arbiter()
  def wb_vector_return = vector.scalar_result |> filter_valid(result => result.address.any()) |> map_valid(result => SuperscalarCompletion(xlen)):
    identity: wb_vector_scalar_owner
    rd: result.address
    write: result.address.any()
    data: result.data

  def rr_returns :: List.of(Endpoint) = [wb_gpr_return, mem_completion, ex_completion, rr_completion]
  reg wb_completion_count(~init: Bits(2)(0))
  when (rr_completion.valid ^ wb_completion.valid):
    wb_completion_count <== mux(rr_completion.valid, wb_completion_count + Bits(2)(1), wb_completion_count - Bits(2)(1))

  def wb_fp_return = wb_fp_late_gpr |> map_valid(result => SuperscalarCompletion(xlen)):
    identity: result.tag.identity
    rd: result.tag.rd
    write: Bool(#true)
    data: result.value

  Array(wb_gpr_return, wb_fp_return, wb_vector_return) |> valid_arbiter() |> completed

  wb_scoreboard.clear.valid <== wb_gpr_return.valid & wb_gpr_return.bits.write
  wb_scoreboard.clear.bits <== wb_gpr_return.bits.rd
  inst rr_registers(RegisterFile(xlen, ~read_ports: 4, ~write_ports: issue_width))
  instructions |> rr_window.ingress
  instruction_capacity <== rr_window.available
  rr_window.clear.valid <== rr_squash


  /* RR: Decode, dependency checks, and prefix admission.
     The issue window owns age and consumption; the younger lane cannot
     advance around an older blocked instruction. */

  def rr_head :: SuperscalarPacket(xlen, hypervisor, issue_width) = rr_window.head
  inst rr_issue(issue)
  def rr_decision :: SuperscalarIssueDecision(issue_width) = rr_issue.decision
  def rr_decode = ValidDecodeGen(superscalar_control_cases(profile))
  def rr_normalized = vec(for List (lane in 0..issue_width): superscalar_normalize_move(rr_head.entries[lane].instruction))
  def rr_decoded :: Vec(issue_width, DecodeResult(SuperscalarControl())) = vec(for List (lane in 0..issue_width): rr_decode(rr_normalized[lane]))
  def rr_controls :: Vec(issue_width, SuperscalarControl()) = vec(for List (lane in 0..issue_width): rr_decoded[lane].value)
  def rr_vector = for List (lane in 0..issue_width):
    def control = rr_controls[lane].vector
    control.integer ||| control.memory ||| control.floating_point ||| control.multiply_divide

  def rr_vector_illegal = for List (lane in 0..issue_width):
    def control = rr_controls[lane].vector
    def vector_state_disabled = (rr_vector[lane] ||| (control.configure =/= VectorConfigMode.None)) & !wb_csrs.vector_enabled
    def rounding_illegal = control.fp_service & control.fp_execution.uses_rounding_mode & (wb_csrs.frm > Bits(3)(4))
    def floating_point_illegal = control.floating_point & (!wb_csrs.fp_enabled ||| rounding_illegal)
    vector_state_disabled ||| (rr_vector[lane] & floating_point_illegal)

  def rr_vector_config = for List (lane in 0..issue_width): rr_controls[lane].system.action === RiscvCsrAction.VectorConfig

  // At most one memory instruction issues per group; the oldest scalar service owns the
  // shared permission probe. A retained younger candidate is probed again.
  def rr_cbo_lane = rr_decision.owners.scalar
  wb_csrs.cbo_operation <== mux_lookup(rr_controls[service_index(rr_cbo_lane)].memory.access, ~default: CboManagementOperation.Clean):
    CacheOperation.CacheBlockInvalidate: CboManagementOperation.Invalidate
    CacheOperation.CacheBlockFlush: CboManagementOperation.Flush

  def rr_rounding :: Vec(issue_width, RiscvRoundingMode()) = vec(for List (lane in 0..issue_width): riscv_rounding_mode(rr_head.entries[lane].instruction[12..15], wb_csrs.frm))
  def rr_fp_illegal = for List (lane in 0..issue_width): rr_controls[lane].fp.valid & (!wb_csrs.fp_enabled ||| (rr_controls[lane].fp.bits.execution.uses_rounding_mode & !rr_rounding[lane].valid))
  def rr_cbo_illegal = for List (lane in 0..issue_width):
    def access :: CacheOperation = rr_controls[lane].memory.access
    rr_controls[lane].memory.enable & ((access.is_cache_block_zero() & (wb_csrs.cbo_zero_access =/= CboAccess.Allowed)) ||| (access.is_cache_management() & (wb_csrs.cbo_permission.access =/= CboAccess.Allowed)))

  def rr_explicit_guest = for List (lane in 0..issue_width): rr_controls[lane].guest_access =/= RiscvGuestMemoryAccess.Normal
  def rr_guest_illegal = for List (lane in 0..issue_width): rr_explicit_guest[lane] & !guest_state.virtualized & (wb_csrs.privilege === PrivilegeMode.User) & !csr_flag(guest_state.hstatus, HstatusHU)
  def rr_virtual_instruction = for List (lane in 0..issue_width):
    def access :: CacheOperation = rr_controls[lane].memory.access
    (rr_explicit_guest[lane] & guest_state.virtualized) ||| (rr_controls[lane].memory.enable & ((access.is_cache_block_zero() & (wb_csrs.cbo_zero_access === CboAccess.VirtualInstruction)) ||| (access.is_cache_management() & (wb_csrs.cbo_permission.access === CboAccess.VirtualInstruction))))

  def rr_fetch_faults :: Vec(issue_width, Bool) = vec(
    for List (lane in 0..issue_width): rr_head.entries[lane].fetch_fault().valid
  )

  def rr_decodable :: Vec(issue_width, Bool) = vec(for List (lane in 0..issue_width): rr_decoded[lane].valid & !rr_fetch_faults[lane] & !rr_head.entries[lane].compressed_illegal & !rr_fp_illegal[lane] & !rr_vector_illegal[lane] & !rr_cbo_illegal[lane] & !rr_guest_illegal[lane] & !rr_virtual_instruction[lane])
  def rr_rs1 :: Vec(issue_width, Bits(5)) = vec(for List (lane in 0..issue_width): instruction_field(fields.rs1, rr_normalized[lane]))
  def rr_rs2 :: Vec(issue_width, Bits(5)) = vec(for List (lane in 0..issue_width): instruction_field(fields.rs2, rr_normalized[lane]))
  def rr_rd :: Vec(issue_width, Bits(5)) = vec(for List (lane in 0..issue_width): instruction_field(fields.rd, rr_head.entries[lane].instruction))
  def rr_wb_producers = for List (lane in 0..issue_width):
    def returned = wb_fp_gpr.valid & wb_fp_gpr.bits.tag.direct & (wb_fp_gpr.bits.tag.lane === Bits(2)(lane))
    def csr_returned = wb_csr_return[lane]
    wb_pipe[lane].egress |> map_valid(token => token.updated(
      ~resolution: token.resolution.updated(~value: mux(csr_returned, wb_csrs.writeback_value, mux(returned, wb_fp_gpr.bits.value, token.resolution.value))),
      ~result_ready: token.result_ready ||| returned ||| csr_returned
    ))

  def rr_producers :: List.of(Endpoint) = rr_wb_producers ++ mem_results ++ ex_results

  /* Floating-point reads and destination interlocks.
     Read probes may repeat while RR waits; future fixed return capacity
     is reserved only when its instruction is admitted. */

  def rr_vector_frs1 = for List (lane in 0..issue_width): rr_vector[lane] & rr_controls[lane].vector.floating_point & (rr_controls[lane].vector.operand === VectorOperandMode.FloatingScalar)
  def rr_fp_lane = rr_decision.owners.fp
  def rr_fp_control :: FloatingPointControl() = rr_controls[service_index(rr_fp_lane)].fp.bits
  fp.read_addresses <== vec(rr_rs1[service_index(rr_fp_lane)], rr_rs2[service_index(rr_fp_lane)], rr_head.entries[service_index(rr_fp_lane)].instruction[27..32])
  fp.probe <== rr_fp_control
  wb_gpr_calendar.query_delay[0] <== fp_timing.latency(rr_fp_control.execution, ~width: gpr_delay_width) + Bits(gpr_delay_width)(1)
  // Probe registered bookings only. Same-group collisions are checked separately,
  // keeping admission independent of either client's packed reserve handshake.
  def rr_fp_gpr_available = !wb_completion_priority & !rr_vector_writeback_waiting & wb_gpr_calendar.registered_free[0]

  /* Pre-WB producers bridge the architectural scoreboard; both FPR write ports forward. */
  fun rr_fp_busy(address :: Bits(5)) :: Bool:
    def registered_pending = scoreboard_busy(32, fp.busy, address)
    def producer_matches = for List (producer in rr_producers):
      def token :: SuperscalarResult(xlen, hypervisor) = producer.bits
      def scalar_writes_fpr = token.fp.valid & (token.fp.bits.registers.destination === FloatDestination.FloatingPoint)
      def vector_writes_fpr = token.vector.floating_point & token.vector.floating_scalar_destination
      producer.valid & (scalar_writes_fpr ||| vector_writes_fpr) & (token.rd === address)

    def pending = registered_pending ||| any(producer_matches)
    def execution_returned = fp.completion.valid & (fp.completion.bits.tag.destination === FloatDestination.FloatingPoint) & (fp.completion.bits.tag.rd === address)
    def load_returned = fp.load_write.valid & (fp.load_write.bits.owner.rd === address)
    pending & !(execution_returned ||| load_returned)

  def rr_fp_fixed :: Vec(issue_width, Bool) = vec(for List (lane in 0..issue_width): rr_controls[lane].fp.valid & !rr_controls[lane].fp.bits.execution.unit.is_one_of(FloatUnit.Memory, FloatUnit.DivideSquareRoot))
  def rr_fp_late_gpr :: Vec(issue_width, Bool) = vec(
    for List (lane in 0..issue_width):
      def control :: FloatingPointControl() = rr_controls[lane].fp.bits
      def integer_destination = (control.registers.destination === FloatDestination.Integer) & rr_rd[lane].any()
      def late_return = fp_timing.latency(control.execution) > Bits(fp_timing.width)(2)
      rr_fp_fixed[lane] & integer_destination & late_return
  )

  // An older MEM divide owns next cycle's shared request input at WB.
  def rr_fp_wb_reserved = any(
    for List (lane in 0..issue_width):
      def producer :: Endpoint = mem_pipe[lane].egress
      def token :: SuperscalarResult(xlen, hypervisor) = producer.bits
      producer.valid & token.fp.valid & (token.fp.bits.execution.unit === FloatUnit.DivideSquareRoot)
  )

  def rr_fp_data_blocked = for List (lane in 0..issue_width):
    def control :: FloatingPointControl() = rr_controls[lane].fp.bits
    def source1_pending = control.registers.uses_frs1 & rr_fp_busy(rr_rs1[lane])
    def source2_pending = control.registers.uses_frs2 & rr_fp_busy(rr_rs2[lane])
    def source3_pending = control.registers.uses_frs3 & rr_fp_busy(rr_head.entries[lane].instruction[27..32])
    def destination_pending = (control.registers.destination === FloatDestination.FloatingPoint) & rr_fp_busy(rr_rd[lane])
    rr_controls[lane].fp.valid & (source1_pending ||| source2_pending ||| source3_pending ||| destination_pending)

  def rr_fp_structural_blocked = for List (lane in 0..issue_width): rr_decodable[lane] & rr_fp_fixed[lane] & (!fp.available ||| rr_fp_wb_reserved ||| (rr_fp_late_gpr[lane] & !rr_fp_gpr_available))

  /* Deferred returns forward at RR admission and again at the reserved write edge.
     Each later rr_returns entry overrides earlier entries and the vector/late-FP/RF fallback. */
  fun rr_stored(address :: Bits(5), stored :: Bits(xlen.width)) :: Bits(xlen.width):
    def vector_match = vector.scalar_result.valid & (vector.scalar_result.bits.address === address)
    def late_fp_match = wb_fp_late_gpr.valid & (wb_fp_late_gpr.bits.tag.rd === address)
    def initial_value = priority_mux(~default: stored):
      vector_match: vector.scalar_result.bits.data
      late_fp_match: wb_fp_late_gpr.bits.value

    def mutable value = initial_value
    for (source in rr_returns):
      def returned :: SuperscalarCompletion(xlen) = source.bits
      value := mux(source.valid & returned.write & (returned.rd === address), returned.data, value)

    value

  /* Completion frees the registered reservation for same-cycle reads and younger writes. */
  fun rr_busy(address :: Bits(5)) :: Bool:
    def integer_completing = wb_gpr_return.valid & wb_gpr_return.bits.write & (wb_gpr_return.bits.rd === address)
    def fp_completing = wb_fp_late_gpr.valid & (wb_fp_late_gpr.bits.tag.rd === address)
    def integer_pending = scoreboard_busy(32, wb_scoreboard.busy, address) & !integer_completing
    def fp_pending = scoreboard_busy(32, wb_fp_gpr_scoreboard.busy, address) & !fp_completing
    address.any() & (integer_pending ||| fp_pending)

  /* A returned value satisfies reads immediately; younger writes still wait for its RF update. */
  fun rr_source_busy(address :: Bits(5)) :: Bool:
    def return_matches = for List (source in rr_returns):
      def owner :: SuperscalarCompletion(xlen) = source.bits
      source.valid & owner.write & (owner.rd === address)

    def returned = any(return_matches)
    (rr_busy(address) & !returned) ||| (scoreboard_busy(32, wb_vector_scoreboard.busy, address) & !(vector.scalar_result.valid & (vector.scalar_result.bits.address === address)))


  /* Operand forwarding and same-group dependencies.
     Selects the newest older producer and preserves explicit pairing routes;
     ordered elaboration folds encode forwarding priority. */

  def rr_read_routing :: SuperscalarReadRouting(issue_width) = rr_issue.reads
  rr_registers.read_addresses <== rr_read_routing.addresses
  def rr_read_paths = vec(
    for List (port in 0..4):
      def address = rr_read_routing.addresses[port]
      def forwarded = forwarded_operand(xlen, hypervisor, address, rr_stored(address, rr_registers.read_data[port]), rr_producers)
      forwarded.updated(~blocked: forwarded.blocked ||| rr_source_busy(address))
  )
  rr_issue.read_blocked <== vec(for List (port in 0..4): rr_read_paths[port].blocked)
  def rr_instructions :: Vec(issue_width, SuperscalarIssueInstruction()) = rr_issue.instructions
  def rr_operand_pcs = vec(for List (lane in 0..issue_width): rr_head.entries[lane].address())
  def rr_prepared = superscalar_prepare_operands(xlen, issue_width, rr_instructions, rr_operand_pcs, rr_read_routing, rr_read_paths)
  def rr_operands :: Vec(issue_width, SuperscalarOperands(xlen)) = vec(for List (lane in 0..issue_width): rr_prepared[lane])
  def rr_multiply = for List (lane in 0..issue_width): rr_decodable[lane] & (rr_controls[lane].muldiv.service === SuperscalarLongOperation.Multiply) & rr_rd[lane].any()
  reg rr_vector_multiply_turn(~init: Bool(#false))
  def rr_multiply_available = !wb_completion_priority & !rr_vector_writeback_waiting & wb_gpr_calendar.registered_free[1] & !rr_vector_multiply_turn
  def rr_ras = for List (lane in 0..issue_width): rr_controls[lane].branch.resolver.enable & ((riscv_ras_action(rr_head.entries[lane].instruction) =/= RasAction.None) ||| (rr_head.entries[lane].speculated_ras_action =/= RasAction.None))

  /* Branch-training capacity projection.
     Accounts for each fixed-latency retirement group and one write per cycle;
     faults and flushes can only remove records from the projection. */

  def mutable rr_training_projected = branch_training.pending.zext(4)
  for (stage_index in 0..3):
    def stage = [wb_pipe, mem_pipe, ex_pipe][stage_index]
    def mutable arrivals = Bits(4)(0)
    for (lane in 0..issue_width):
      def branch :: Bool:
        if stage_index == 2
        | block:
            def token :: SuperscalarExecute(xlen, hypervisor) = stage[lane].egress.bits
            stage[lane].egress.valid & !token.illegal & !token.fetched.fault.valid & token.control.branch.resolver.enable
        | stage[lane].egress.valid & stage[lane].egress.bits.branch.update.branch

      arrivals := arrivals + branch.as_bits().zext(4)

    def offered :: Bits(4) = rr_training_projected + arrivals
    rr_training_projected := mux(offered.any(), offered - Bits(4)(1), Bits(4)(0))
    assert(rr_training_projected <= Bits(4)(2), "superscalar_branch_training_projection")

  // Pending summaries include pre-WB owners, before service busy state is set.
  def rr_fp_updates_pending = !fp.drained ||| vector.fp_pending ||| any(
    for List (lane in 0..issue_width):
      def ex_fp = ex_pipe[lane].egress.valid & (ex_pipe[lane].egress.bits.control.fp.valid ||| ex_pipe[lane].egress.bits.control.vector.floating_point)
      def mem_fp = mem_pipe[lane].egress.valid & (mem_pipe[lane].egress.bits.fp.valid ||| mem_pipe[lane].egress.bits.vector.floating_point)
      def wb_fp = wb_pipe[lane].egress.valid & (wb_pipe[lane].egress.bits.fp.valid ||| wb_pipe[lane].egress.bits.vector.floating_point)
      ex_fp ||| mem_fp ||| wb_fp
  )
  def rr_vector_updates_pending = vector.active ||| any(
    for List (lane in 0..issue_width):
      def ex_control = ex_pipe[lane].egress.bits.control.vector
      def mem_control :: SuperscalarVectorLane() = mem_pipe[lane].egress.bits.vector
      def wb_control :: SuperscalarVectorLane() = wb_pipe[lane].egress.bits.vector
      def ex_vector = ex_pipe[lane].egress.valid & (ex_control.integer ||| ex_control.memory ||| ex_control.floating_point ||| ex_control.multiply_divide)
      def mem_vector = mem_pipe[lane].egress.valid & mem_control.operation
      def wb_vector = wb_pipe[lane].egress.valid & wb_control.operation
      ex_vector ||| mem_vector ||| wb_vector
  )

  def rr_csr_read_wait = for List (lane in 0..issue_width): csr_pure_read(rr_controls[lane].system.csr, rr_rs1[lane]) & csr_read_wait(rr_head.entries[lane].instruction[20..32], rr_fp_updates_pending, rr_vector_updates_pending)
  def rr_vector_blocked = for List (lane in 0..issue_width):
    def control :: SuperscalarControl() = rr_controls[lane]
    def floating_source_pending = rr_vector_frs1[lane] & rr_fp_busy(rr_rs1[lane])
    def floating_destination_blocked = control.vector.floating_point & control.vector.floating_scalar_destination & (wb_vector_fpr_pending ||| rr_fp_busy(rr_rd[lane]))
    def integer_result_claim = control.vector.integer & control.vector.scalar_destination & control.writeback.enable & rr_rd[lane].any()
    def vector_execution_blocked = rr_vector[lane] & ((integer_result_claim & !wb_vector_scalar_available) ||| floating_source_pending ||| floating_destination_blocked)
    def integer_destination_pending = control.writeback.enable & scoreboard_busy(32, wb_vector_scoreboard.busy, rr_rd[lane])
    def memory_order_blocked = control.memory.enable & (vector.stores_pending ||| (control.memory.access.store_fault_class() & vector.loads_pending))
    (vector.certification_pending & (rr_vector[lane] ||| rr_vector_config[lane])) ||| vector_execution_blocked ||| integer_destination_pending ||| memory_order_blocked

  def rr_pipeline_empty = !any(for List (lane in 0..issue_width): ex_pipe[lane].egress.valid ||| mem_pipe[lane].egress.valid ||| wb_pipe[lane].egress.valid)

  /* Ordering barriers and issue prefix.
     Atomics and CBO.ZERO drain older memory and hold younger memory through
     completion; PAUSE blocks younger issue without blocking accepted returns. */

  def rr_memory_in_pipeline = any(for List (lane in 0..issue_width): (ex_pipe[lane].egress.valid & ex_pipe[lane].egress.bits.control.memory.enable) ||| (mem_pipe[lane].egress.valid & mem_pipe[lane].egress.bits.memory.enable) ||| (wb_pipe[lane].egress.valid & wb_pipe[lane].egress.bits.memory.enable))
  def rr_ordered_memory_ready = !rr_memory_in_pipeline & scalar_memory.drained & wb_load_response.drained & !wb_ordered_memory_pending
  // A PAUSE may follow an older peer, but no younger issue crosses it. Its
  // post-retirement cooldown never blocks accepted service completions.
  reg rr_pause_cycles(~init: Bits(5)(0))
  def rr_pause_lanes = for List (lane in 0..issue_width):
    (ex_pipe[lane].egress.valid & ex_pipe[lane].egress.bits.control.pause) ||| (mem_pipe[lane].egress.valid & mem_pipe[lane].egress.bits.pause) ||| (wb_pipe[lane].egress.valid & wb_pipe[lane].egress.bits.pause)

  def rr_pause_blocked = vec(rr_pause_lanes).any() ||| rr_pause_cycles.any()
  def rr_last_return_reserved = rr_completion.valid ||| !wb_gpr_calendar.registered_free[2]

  /* The issue module owns all same-group checks and prefix selection. The core
     supplies service/scoreboard probes and applies only the returned grants.
     Every admitted lane can select the existing shared execution services. */

  rr_issue.candidates <== vec(
    for List (lane in 0..issue_width):
      SuperscalarIssueCandidate(xlen):
          present: rr_head.count > Bits(2)(lane)
          decodable: rr_decodable[lane]
          fetch_fault: rr_fetch_faults[lane]
          instruction: rr_normalized[lane]
          pc: rr_operand_pcs[lane]
          control: rr_controls[lane]
          rs1: rr_rs1[lane]
          rs2: rr_rs2[lane]
          rd: rr_rd[lane]
          ras: rr_ras[lane]
          late_gpr: rr_fp_late_gpr[lane]
  )
  rr_issue.status <== vec(
    for List (lane in 0..issue_width):
      SuperscalarIssueStatus():
          execution_blocked: Bool(#false)
          destination_blocked: rr_busy(rr_rd[lane]) ||| pending_destination(xlen, hypervisor, rr_rd[lane], rr_producers)
          fp_data_blocked: rr_fp_data_blocked[lane]
          fp_capacity_blocked: rr_fp_structural_blocked[lane]
          vector_blocked: rr_vector_blocked[lane]
          csr_read_wait: rr_csr_read_wait[lane]
  )
  rr_issue.resources <== SuperscalarIssueResources():
    stop: rr_squash
    retry_wait: rr_vector_retry_wait
    pause_blocked: rr_pause_blocked
    serialization_ready: rr_pipeline_empty & wb_drained
    memory_order_ready: rr_ordered_memory_ready
    multiply_available: rr_multiply_available
    fixed_returns_collide: wb_gpr_calendar.query_delay[0] === Bits(gpr_delay_width)(PipelinedMultiplierStages + 1)
    training_pending: rr_training_projected
    last_slot_reserved: rr_last_return_reserved
    vector_waiting: rr_vector_writeback_waiting

  def rr_first = rr_decision.admitted[0]
  def rr_older_region = rr_operand_pcs[0][SuperscalarPcOffsetBits..xlen.width]
  def rr_next_pc_region = vec(
    for List (lane in 1..issue_width):
      def region = rr_operand_pcs[lane][SuperscalarPcOffsetBits..xlen.width]
      def next_region = region === (rr_older_region + Region(1))
      when (rr_decision.admitted[lane]):
        assert(rr_first & ((region === rr_older_region) ||| next_region), "superscalar_paired_pc_region_" ++ to_string(lane))

      next_region
  )
  issued <== rr_decision.count
  when rr_first:
    ex_pc_region <== rr_older_region
    ex_younger_next_region <== rr_next_pc_region

  rr_window.consume <== issued
  stat_count("issue_1", issued === Bits(2)(1))
  stat_count("issue_2", issued === Bits(2)(2))
  if issue_width == 3 | stat_count("issue_3", issued === Bits(2)(3)) | #void
  def rr_fp_admitted = rr_decision.admitted[service_index(rr_fp_lane)] & rr_decodable[service_index(rr_fp_lane)] & rr_fp_fixed[service_index(rr_fp_lane)]
  fp.book.valid <== rr_fp_admitted
  fp.book.bits <== rr_fp_control
  wb_gpr_calendar.reserve[0].valid <== rr_fp_admitted & rr_fp_late_gpr[service_index(rr_fp_lane)]
  wb_gpr_calendar.reserve[0].bits <== wb_gpr_calendar.query_delay[0]
  when (wb_gpr_calendar.reserve[0].valid):
    assert(wb_gpr_calendar.reserve[0].ready, "superscalar_fp_booked_gpr_writeback")

  wb_gpr_calendar.reserve[1].valid <== any(for List (lane in 0..issue_width): rr_decision.admitted[lane] & rr_multiply[lane])
  wb_gpr_calendar.reserve[1].bits <== Bits(gpr_delay_width)(PipelinedMultiplierStages + 1)
  ex_multiply.book.valid <== wb_gpr_calendar.reserve[1].valid
  when (!vector.multiply_request.valid ||| vector.multiply_request.fire()):
    rr_vector_multiply_turn <== Bool(#false)
  elsewhen (wb_gpr_calendar.reserve[1].fire()):
    rr_vector_multiply_turn <== Bool(#true)

  // Reserve the last lane even for nonwriters; earlier lanes have independent ports.
  wb_gpr_calendar.reserve[3].valid <== rr_decision.admitted[return_port] ||| rr_completion.valid
  wb_gpr_calendar.reserve[3].bits <== Bits(gpr_delay_width)(3)
  when (wb_gpr_calendar.reserve[3].valid):
    assert(wb_gpr_calendar.reserve[3].ready, "superscalar_last_write_port_reserved")

  when (wb_gpr_calendar.reserve[1].valid):
    assert(wb_gpr_calendar.reserve[1].ready, "superscalar_multiply_booked_writeback")

  def rr_fp_request = FpExecutionRequest(xlen, fp_transport_profile(xlen), SuperscalarFpSchedule()):
    tag:
      SuperscalarFpSchedule():
        lane: rr_fp_lane
        speculative: rr_fp_fixed[service_index(rr_fp_lane)]
        direct: fp_timing.latency(rr_fp_control.execution) === Bits(fp_timing.width)(2)

    control: rr_fp_control
    left: mux(rr_fp_control.registers.uses_frs1, fp.read_values[0], rr_operands[service_index(rr_fp_lane)].rs1)
    right: fp.read_values[1]
    third: fp.read_values[2]
    left_precision: rr_fp_control.execution.source_precision
    right_precision: rr_fp_control.execution.source_precision
    third_precision: rr_fp_control.execution.source_precision
    immediate_index: rr_rs1[service_index(rr_fp_lane)]
    rounding_mode: rr_rounding[service_index(rr_fp_lane)].mode

  /* RR/EX capture and issue observations.
     Each lane reports its actual blockers, but only the shared admitted
     prefix consumes instructions and enters the execution pipes. */

  for (lane in 0..issue_width):
    def ex_ingress = ex_pipe[lane].ingress
    def rr_access :: CacheOperation = rr_controls[lane].memory.access
    ex_pipe[lane].flush <== rr_squash
    def rr_observed = rr_window.candidates[lane] |> offer_decoupled() |> trace_event("core/s1.rr.slot" ++ to_string(lane), ~stalls: #true, ~fields: fetched):
      pc: rr_head.entries[lane].address()
      instruction(~format: "riscv", ~isa: trace_isa, ~pc: "pc"): rr_head.entries[lane].raw()
      data_hazard: rr_decision.data_hazard[lane]
      structural_hazard: rr_decision.structural_hazard[lane]

    (rr_observed |> gate_flow(rr_decision.admitted[lane]) |> to_valid() |> map_valid(fetched => SuperscalarExecute(xlen, hypervisor)):
      // Compact lane storage reconstructs raw upper bits from the original expanded word.
      // A normalized ADD copy needs a zero immediate, not those original rs2 bits.
      fetched: SuperscalarLaneInstruction.capture(xlen, hypervisor, SuperscalarFetchFault(xlen, hypervisor), rr_head.entries[lane], rr_head.entries[lane].fetch_fault())
      control: rr_instructions[lane].control.updated(
        ~operand: rr_instructions[lane].control.operand.updated(~immediate: mux(rr_normalized[lane] =/= fetched.instruction, OperandImmediate.Zero, rr_instructions[lane].control.operand.immediate)),
        ~memory: rr_instructions[lane].control.memory.updated(~access: mux(rr_access.is_cache_management() & (wb_csrs.cbo_permission.operation === CboManagementOperation.Flush), CacheOperation.CacheBlockFlush, rr_access))
      )

      operands: rr_operands[lane]
      rd: rr_rd[lane]
      illegal: !rr_decoded[lane].valid ||| fetched.compressed_illegal ||| rr_fp_illegal[lane] ||| rr_vector_illegal[lane] ||| (rr_cbo_illegal[lane] & !rr_virtual_instruction[lane]) ||| rr_guest_illegal[lane]
      virtual_instruction: rr_decoded[lane].valid & rr_virtual_instruction[lane]
      vector:
        SuperscalarLaneVector(xlen):
          precertified: Bool(#false)
          certificate: dont_care(VectorFastCertificate(xlen))
          instruction: rr_instructions[lane].instruction
          state: dont_care(RiscvVectorState(xlen))
          control: rr_instructions[lane].control.vector
          scalar: rr_operands[lane].rs1
          floating_scalar: fp.read_values[0][0..xlen.width]
          stride: rr_operands[lane].rs2
          masked: !fetched.instruction[25].into(Bool)
          rounding_mode: wb_csrs.frm.into(RoundingMode)
          pointer_masking: wb_csrs.pointer_masking
    ) |> ex_ingress


  /* EX: Operand execution and speculative lookup.
     One common ALU per integer lane and independent target calculations produce registered
     results; launch validity remains separate from payload computation. */

  def ex_valid :: Vec(issue_width, Bool) = vec(for List (stage in ex_pipe): stage.egress.valid)
  def ex_tokens :: Vec(issue_width, SuperscalarExecute(xlen, hypervisor)) = vec(for List (lane in 0..issue_width): ex_pipe[lane].egress.bits)
  wire ex_descriptors: Vec(issue_width, VectorDescriptor(xlen))
  wire ex_config_states: Vec(issue_width, RiscvVectorState(xlen))
  reg mem_descriptor(VectorDescriptor(xlen))
  reg mem_descriptor_lane(Bits(2))
  reg wb_descriptor(VectorDescriptor(xlen))
  reg wb_descriptor_lane(Bits(2))


  /* EX: Forward the newest older vector configuration before legality and snapshot capture.
     Each group has at most one successful vset. MEM precedes WB, and an older
     same-group configuration supplies each younger lane. */

  /* A successful vset owns the group's forwarding snapshot independently of vector execution. */
  fun forwards_config(token :: SuperscalarResult(xlen, hypervisor)) :~ Bool:
    (token.system.action === RiscvCsrAction.VectorConfig) & (token.resolution.disposition === SuperscalarDisposition.Continue)

  def ex_prior_vector_state :: RiscvVectorState(xlen):
    if !vector_enabled
    | wb_csrs.vector_state
    | block:
        reg mem_config_state(RiscvVectorState(xlen))
        reg wb_config_state(RiscvVectorState(xlen))
        def ex_claims = for List (result in ex_results): result.valid & forwards_config(result.bits)
        def mem_claim = any(for List (lane in mem_pipe): lane.egress.valid & forwards_config(lane.egress.bits))
        def wb_claim = any(for List (lane in wb_pipe): lane.egress.valid & forwards_config(lane.egress.bits))

        for (lane in 0..issue_width):
          assert(!(ex_claims[lane] & any(for List (younger in lane + 1..issue_width): ex_claims[younger])), "superscalar_one_configuration_per_group")

        when (any(ex_claims)):
          mem_config_state <== ex_config_states[service_index(superscalar_service_lane(ex_claims))]

        when mem_claim:
          wb_config_state <== mem_config_state

        priority_mux(~default: wb_csrs.vector_state):
          mem_claim: mem_config_state
          wb_claim: wb_config_state

  def ex_alus = for InstanceArray (lane in 0..issue_width):
    inst alu(ALU(xlen))
    alu

  def ex_alu_older = ex_alus[0]
  for (lane in 0..issue_width):
    def ex :: SuperscalarExecute(xlen, hypervisor) = ex_tokens[lane]
    def ex_pc = ex_pipe[lane].pc
    def ex_successor = ex_pipe[lane].sequential_pc
    def ex_raw = ex_pipe[lane].raw_instruction
    def ex_fetch_fault :: SuperscalarFetchFault(xlen, hypervisor) = ex.fetched.fault
    def ex_input = ex_paths[lane][0]
    def ex_output = ex_links[lane].left
    def ex_alu = ex_alus[lane]
    def ex_system :: SuperscalarSystemControl() = ex.control.system
    def ex_is_vector_config = ex_system.action === RiscvCsrAction.VectorConfig
    def ex_vector_base_state :: RiscvVectorState(xlen):
      if (lane == 0) || (!vector_enabled)
      | ex_prior_vector_state
      | block:
          def older_configs = for List (index in 0..lane):
            def older = lane - index - 1
            [ex_pipe[older].egress.valid & forwards_config(ex_results[older].bits), ex_config_states[older]]

          priority_mux(older_configs, ~default: ex_prior_vector_state)

    def ex_vector_config = vector_configuration_request(xlen, ex.control.vector.configure, ex.fetched.instruction, ex.operands.rs1, ex.operands.rs2)
    def ex_configuration = vector_configure(xlen, profile.vector_length, ex_vector_config, ex_vector_base_state.vtype, ex_vector_base_state.vl[0..index_width(profile.vector_length + 1)], ~elen: vector_elen)
    def ex_configured_state = ex_vector_base_state.updated(~vl: ex_configuration.vl.zext(xlen.width), ~vtype: ex_configuration.vtype, ~vstart: Bits(xlen.width)(0))
    def ex_vector_state = mux(ex_is_vector_config, ex_configured_state, ex_vector_base_state)
    ex_config_states[lane] <== ex_configured_state
    inst ex_vector_legality(VectorOperationLegality(xlen, profile.vector_length, if vector_enabled | profile.vector | VectorProfile.Zve32x, profile.vector_extensions))
    ex_vector_legality.instruction <== ex.fetched.instruction
    ex_vector_legality.control <== ex.control.vector
    ex_vector_legality.vtype <== ex_vector_state.vtype
    ex_vector_legality.vstart <== ex_vector_state.vstart
    def ex_is_vector = ex.control.vector.integer ||| ex.control.vector.memory ||| ex.control.vector.floating_point ||| ex.control.vector.multiply_divide
    def ex_vector_illegal = (ex_is_vector & !ex_vector_legality.legal) ||| (ex_is_vector_config & ex_configuration.illegal)
    def ex_executable = !ex.illegal & !ex_vector_illegal & !ex.virtual_instruction & !ex_fetch_fault.valid
    def ex_pair_immediate = ex.operands.rewrite.immediate.sext(xlen.width)
    def ex_immediate = mux(ex.operands.rewrite.composed, ex_pair_immediate, ex.control.operand.immediate.decode(ex.fetched.instruction, xlen.width))
    ex_alu.left <== mux_lookup(ex.control.operand.left, ~default: ex.operands.rs1):
      OperandASelect.Pc: ex_pc
      OperandASelect.Zero: Bits(xlen.width)(0)

    ex_alu.right <== mux(ex.control.operand.right === OperandBSelect.Immediate, ex_immediate, ex.operands.rs2)
    ex_alu.control <== ex.control.alu

    /* Effective data address and guest context.
       Mask after the selected address bypass. Explicit guest execute-reads
       disable guest masking; ordinary MPRV/MPV applies only to data privilege. */

    def ex_raw_address = if lane > 0 | mux(ex.operands.rewrite.memory_address, ex_alus[lane - 1].result, ex_alu.result) | ex_alu.result
    def ex_explicit_guest = ex.control.guest_access =/= RiscvGuestMemoryAccess.Normal
    // Serialized CSR updates flush younger work before a new masking mode is observed.
    def ex_mask :: PointerMaskControl():
      if profile.hypervisor
      | block:
          def execute_read = ex.control.guest_access === RiscvGuestMemoryAccess.GuestExecuteRead
          def guest_mask = wb_csrs.guest_pointer_masking.updated(
            ~mode: mux(execute_read, PointerMaskMode.Disabled, wb_csrs.guest_pointer_masking.mode)
          )

          mux(ex_explicit_guest, guest_mask, wb_csrs.pointer_masking)
      | wb_csrs.pointer_masking

    def ex_address = apply_pointer_mask(xlen, ex_raw_address, ex_mask)
    // Only the proposed range is meaningful before MEM supplies a certificate.
    def ex_vector_geometry = vector_fast_footprint_geometry(xlen, profile.vector_length, ex.control.vector, ex.fetched.instruction, ex_vector_state, ex.operands.rs2)
    def ex_vector_start = vector_fast_start(xlen, ex.operands.rs1, ex_vector_geometry, ex_mask)
    def ex_vector_footprint = vector_fast_range(xlen, ex_vector_start, ex_vector_geometry, ex.control.vector.store)
    def ex_data_guest:
      if profile.hypervisor
      | block:
          def mprv_active = (wb_csrs.privilege === PrivilegeMode.Machine) & csr_flag(wb_csrs.mstatus, MstatusMPRV)
          def mprv_guest = csr_flag(wb_csrs.mstatus, MstatusMPV) & (effective_data_privilege(xlen, wb_csrs.privilege, wb_csrs.mstatus) =/= PrivilegeMode.Machine)
          ex_explicit_guest ||| mux(mprv_active, mprv_guest, guest_state.virtualized)
      | Bool(#false)

    /* Branch target and local fault classification are combinational payloads;
       recovery suppresses lane validity rather than these calculations. */

    def ex_target_sum = mux(ex.control.branch.target_from_rs1, ex.operands.rs1, ex_pc) + ex_immediate
    def ex_target = mux(ex.control.branch.target_from_rs1, ex_target_sum & !Bits(xlen.width)(1), ex_target_sum)
    def ex_actual_action = mux(ex_executable & ex.control.branch.resolver.enable, riscv_ras_action(ex.fetched.instruction), RasAction.None)
    def ex_bad_pc = ex_pc[0].into(Bool)
    def ex_memory = ex_executable & ex.control.memory.enable
    def ex_bad_address = ex_memory & ex.control.memory.access.is_one_of(CacheOperation.LoadReserved, CacheOperation.StoreConditional, CacheOperation.Atomic) & !ex.control.memory.width.is_aligned(ex_address)
    def ex_generated_guest = empty_guest.updated(~guest_virtual_address: !ex.illegal & !ex.virtual_instruction & mux(ex_bad_pc, guest_state.virtualized, ex_bad_address & ex_data_guest))
    def ex_fault = ex_fetch_fault.valid ||| ex.illegal ||| ex_vector_illegal ||| ex.virtual_instruction ||| ex_bad_pc ||| ex_bad_address

    /* Local fault provenance.
       Earlier fetch faults precede target, data alignment, and virtual
       instruction faults; the value follows that same owner's address. */

    def ex_address_cause = mux(ex.control.memory.access.store_fault_class(), ExceptionCause.StoreAddressMisaligned, ExceptionCause.LoadAddressMisaligned)
    def ex_fault_cause = priority_mux(~default: ExceptionCause.IllegalInstruction):
      ex_fetch_fault.valid: ex_fetch_fault.cause
      ex_bad_pc: ExceptionCause.InstructionAddressMisaligned
      ex_bad_address: ex_address_cause
      ex.virtual_instruction: ExceptionCause.VirtualInstruction

    def ex_fault_value = priority_mux(~default: ex_raw.zext(xlen.width)):
      ex_fetch_fault.valid: ex_fetch_fault.address(ex_pc)
      ex_bad_pc: ex_pc
      ex_bad_address: ex_address

    /* EX/MEM operand capture. Select once for this instruction. Only a CSR
       owns the immediate source mode; other decode rows may leave it unspecified.
       The right word also feeds the live lookup before byte-lane shaping. */
    def ex_fp_divide = ex.control.fp.valid & (ex.control.fp.bits.execution.unit === FloatUnit.DivideSquareRoot)
    def ex_left = priority_mux(~default: ex.operands.rs1):
      ex_fp_divide: ex_fp_request.left
      (ex_system.csr =/= RiscvCsrOperation.None) & ex_system.immediate: instruction_field(fields.rs1, ex.fetched.instruction).zext(xlen.width)

    def ex_right = priority_mux(~default: ex.operands.rs2):
      ex.control.fp.valid: ex_fp_request.right[0..xlen.width]
      ex.operands.rewrite.store_data: ex_alu_older.result

    ex_descriptors[lane] <== ex.vector.with_pc(ex_pc).updated(
      ~scalar: mux(ex.operands.rewrite.vector_scalar, ex_alu_older.result, ex.vector.scalar),
      ~state: ex_vector_state, ~certificate: ex.vector.certificate.updated(~range: ex_vector_footprint.range)
    )

    (ex_input |> filter_valid(_operation => !rr_squash) |> map_valid(_operation => SuperscalarResult(xlen, hypervisor)):
      fetched: ex.fetched.with_fault(Bool, ex_fetch_fault.valid)
      rd: ex.rd
      write: ex_executable & ex.control.writeback.enable & ex.rd.any()
      result_ready: !(ex_memory & ex.control.memory.access.returns_result()) & !(ex_system.uses_command() & !ex_is_vector_config) & ((ex.control.muldiv.service === SuperscalarLongOperation.None) ||| !ex.rd.any()) & !ex.control.fp.valid & !ex_is_vector
      branch:
        SuperscalarBranchResult():
          taken: Bool(#false)
          mispredicted: Bool(#false)
          control: ex.control.branch.resolver
          operands_from_older: ex.operands.rewrite.branch_operands
          update:
            SuperscalarBranchDecision():
              branch: ex_executable & ex.control.branch.resolver.enable
              conditional: ex.fetched.instruction[0..7] === Bits(7)(0x63)
              taken: Bool(#false)
              ras_action: ex_actual_action
              predicted_ras_action: ex.fetched.speculated_ras_action

      memory: ex.control.memory.updated(~enable: ex_memory)
      guest_access: ex.control.guest_access
      prefetch: ex.control.prefetch
      pause: ex.control.pause
      locality_hint: ex.control.locality_hint
      address: mux(ex.control.branch.resolver.enable, ex_target, ex_address)
      cache_outcome: SuperscalarCacheOutcome.Slow
      system: ex.control.system
      muldiv: ex.control.muldiv
      operands:
        SuperscalarLaneOperands(xlen):
          left: ex_left
          right: ex_right

      fp: ex.control.fp
      vector_fast_eligible: ex_vector_footprint.eligible & !ex_vector_footprint.empty
      vector:
        SuperscalarVectorLane():
          operation: ex_is_vector
          floating_point: ex.control.vector.floating_point
          floating_scalar_destination: ex.control.vector.floating_scalar_destination
          integer_destination: ex.control.vector.integer & ex.control.vector.scalar_destination
          memory: ex.control.vector.memory
          store: ex.control.vector.store
          configure: ex.control.vector.configure
      resolution:
        SuperscalarResolution(xlen):
          disposition: mux(ex_fault, SuperscalarDisposition.Fault, SuperscalarDisposition.Continue)
          cause: ex_fault_cause
          value: mux(ex_fault, ex_fault_value, mux(ex_is_vector_config, ex_configuration.vl.zext(xlen.width), mux(ex.control.writeback.link, ex_successor, ex_alu.result)))
          guest: if hypervisor | mux(ex_fetch_fault.valid, ex.fetched.fault.guest, ex_generated_guest) | ex_generated_guest
    ) |> ex_output

    ex_results[lane] |> mem_pipe[lane].ingress
    mem_pipe[lane].flush <== rr_squash

  when (ex_results[0].valid):
    mem_pc_region <== ex_pc_region
    mem_younger_next_region <== ex_younger_next_region


  /* EX to MEM: at most one live vector operation owns the descriptor.
     A faulting younger instruction can bypass pair admission but cannot own it. */

  def ex_vector_claims :: List.of(Bool) = for List (result in ex_results):
    def token :: SuperscalarResult(xlen, hypervisor) = result.bits
    result.valid & token.vector.operation & (token.resolution.disposition === SuperscalarDisposition.Continue)

  for (lane in 0..issue_width):
    assert(!(ex_vector_claims[lane] & any(for List (younger in lane + 1..issue_width): ex_vector_claims[younger])), "superscalar_one_vector_descriptor_per_group")

  when (any(ex_vector_claims)):
    mem_descriptor_lane <== superscalar_service_lane(ex_vector_claims)
    mem_descriptor <== ex_descriptors[service_index(superscalar_service_lane(ex_vector_claims))]

  /* Scheduled FP and multiply launches.
     Selects one admitted lane for each shared unit and carries its owner
     through the existing fixed-latency service. */

  def ex_fp_lane = ex_fp_request.tag.lane
  def ex_fp :: SuperscalarExecute(xlen, hypervisor) = ex_tokens[service_index(ex_fp_lane)]
  def ex_fp_link = interface_link(Valid(SuperscalarExecute(xlen, hypervisor)))
  ex_fp_link.left.valid <== ex_valid[service_index(ex_fp_lane)] & !rr_squash
  ex_fp_link.left.bits <== ex_fp
  describe_interface_selection((for List (lane in 0..issue_width): ex_fp_lane === Bits(2)(lane)), ~name: "fp")
  describe_interface_contract((for Array (lane in 0..issue_width): ex_paths[lane][3]), ex_fp_link.left, "fp-lane", ~trace_model: interface_trace_selection(~name: "fp"))
  def ex_fp_admitted = ex_fp_link.right |> filter_valid(payload):
    def operation :: SuperscalarExecute(xlen, hypervisor) = payload
    !operation.illegal & !operation.fetched.fault.valid & !operation.fetched.pc[0].into(Bool) & operation.control.fp.valid & !operation.control.fp.bits.execution.unit.is_one_of(FloatUnit.Memory, FloatUnit.DivideSquareRoot)

  (ex_fp_admitted |> map_valid(operation):
    def identity = SuperscalarInstructionIdentity.create(xlen, vec(for List (stage in ex_pipe): stage.pc)[service_index(ex_fp_lane)], vec(for List (stage in ex_pipe): stage.raw_instruction)[service_index(ex_fp_lane)])

    superscalar_fp_request(xlen, identity, operation.rd, ex_fp_request)
  ) |> fp.fixed_issue
  def ex_memory_lane = superscalar_service_lane(for List (lane in 0..issue_width): ex_valid[lane] & ex_tokens[lane].control.memory.enable)
  def ex_result_tokens :: Vec(issue_width, SuperscalarResult(xlen, hypervisor)) = vec(
    for List (lane in 0..issue_width):
      def result = ex_results[lane]
      result.bits
  )

  def ex_lookup :: SuperscalarResult(xlen, hypervisor) = ex_result_tokens[service_index(ex_memory_lane)]
  def ex_multiply_lane = superscalar_service_lane(for List (lane in 0..issue_width): ex_valid[lane] & (ex_tokens[lane].control.muldiv.service === SuperscalarLongOperation.Multiply))
  def ex_multiply_link = interface_link(Valid(SuperscalarExecute(xlen, hypervisor)))
  ex_multiply_link.left.valid <== ex_valid[service_index(ex_multiply_lane)]
  ex_multiply_link.left.bits <== ex_tokens[service_index(ex_multiply_lane)]
  describe_interface_selection((for List (lane in 0..issue_width): ex_multiply_lane === Bits(2)(lane)), ~name: "multiply")
  describe_interface_contract((for Array (lane in 0..issue_width): ex_paths[lane][1]), ex_multiply_link.left, "multiply-lane", ~trace_model: interface_trace_selection(~name: "multiply"))
  def ex_multiply_admitted = ex_multiply_link.right |> filter_valid(payload):
    def operation :: SuperscalarExecute(xlen, hypervisor) = payload
    !rr_squash & !operation.illegal & !operation.fetched.fault.valid & !operation.fetched.pc[0].into(Bool) & operation.rd.any() & (operation.control.muldiv.service === SuperscalarLongOperation.Multiply)

  (ex_multiply_admitted |> map_valid(operation => MultiplierRequest(xlen.width)):
    left: operation.operands.rs1
    right: operation.operands.rs2
    mode: operation.control.muldiv.multiply.mode
  ) |> ex_multiply.issue

  /* Speculative memory lookup.
     Byte shaping and the selected physical access use the live EX owner;
     lookup alone cannot authorize a store or external transaction. */

  inst ex_store(StoreGen(xlen, xlen.width / 8))
  ex_store.address <== ex_lookup.address
  ex_store.value <== ex_lookup.operands.right
  ex_store.width <== ex_lookup.memory.width
  scalar_pipeline.request.valid <== ex_valid[service_index(ex_memory_lane)] & ex_lookup.memory.enable & (ex_lookup.resolution.disposition === SuperscalarDisposition.Continue) & !rr_squash
  scalar_pipeline.request.bits <== SuperscalarMemoryReq(xlen, xlen.width):
    guest_access: ex_lookup.guest_access
    address: ex_lookup.address
    access: ex_lookup.memory.access
    atomic: ex_lookup.memory.atomic
    width: ex_lookup.memory.width
    data: mux(ex_lookup.memory.access.is_store(), ex_store.data, ex_lookup.operands.right)
    mask: ex_store.mask.as_bits()
    locality: RiscvMemoryLocality.Default
    pbmt: PageMemoryType.PMA

  describe_interface_selection((for List (lane in 0..issue_width): ex_memory_lane === Bits(2)(lane)), ~name: "lookup")
  describe_interface_contract((for Array (lane in 0..issue_width): ex_paths[lane][2]), scalar_pipeline.request, "lookup-lane", ~trace_model: interface_trace_selection(~name: "lookup"))


  /* MEM: Branch and physical lookup resolution.
     Retains earlier faults ahead of local target faults, external resolution,
     and cache outcomes; captured hits may complete on the ordinary WB path. */

  def mem_valid :: Vec(issue_width, Bool) = vec(for List (stage in mem_pipe): stage.egress.valid)
  def mem_tokens :: Vec(issue_width, SuperscalarResult(xlen, hypervisor)) = vec(for List (stage in mem_pipe): stage.egress.bits)
  def mem_memory_lane = superscalar_service_lane(for List (lane in 0..issue_width): mem_valid[lane] & mem_tokens[lane].memory.enable)
  def mem_memory :: SuperscalarResult(xlen, hypervisor) = mem_tokens[service_index(mem_memory_lane)]
  def mem_vector_lane = superscalar_service_lane(for List (lane in 0..issue_width): mem_valid[lane] & mem_tokens[lane].vector.memory)
  def mem_vector :: SuperscalarResult(xlen, hypervisor) = mem_tokens[service_index(mem_vector_lane)]
  // This read-only lookup must not depend on WB service readiness through squash.
  // The normal MEM/WB transfer filter discards certificates of killed instructions.
  vector_fast.request.valid <== mem_valid[service_index(mem_vector_lane)] & mem_vector.vector.memory & mem_vector.vector_fast_eligible & (mem_vector.resolution.disposition === SuperscalarDisposition.Continue)
  vector_fast.request.bits <== mem_descriptor.certificate.range
  when (vector_fast.request.valid):
    assert(mem_descriptor_lane === mem_vector_lane, "superscalar_mem_vector_descriptor_owner")
  inst mem_load(LoadGen(xlen, xlen.width / 8))
  mem_load.address <== mem_memory.address
  mem_load.width <== mem_memory.memory.width
  mem_load.unsigned_load <== mem_memory.memory.unsigned
  mem_load.data <== scalar_pipeline.response.bits.data
  wire mem_resolved: Vec(issue_width, SuperscalarResult(xlen, hypervisor))
  for (lane in 0..issue_width):
    def Array(mem_input, mem_context, mem_branch_input) = mem_pipe[lane].egress |> fork_valid(3)
    def mem_output = mem_links[lane].left
    def mem :: SuperscalarResult(xlen, hypervisor) = mem_pipe[lane].egress.bits
    def mem_pc = mem_pipe[lane].pc
    inst mem_resolver(BranchResolver(xlen.width))
    (mem_branch_input |> filter_valid(_operation => !wb_squash) |> map_valid(_operation => BranchResolverRequest(xlen.width)):
      left: mux(mem.branch.operands_from_older[0], mem_older.egress.bits.resolution.value, mem.operands.left)
      right: mux(mem.branch.operands_from_older[1], mem_older.egress.bits.resolution.value, mem.operands.right)
      control: mem.branch.control
    ) |> mem_resolver.request

    (mem_context |> map_valid(token): token.into(SuperscalarResult(xlen, hypervisor)).observed(mem_pc)) |> memory_stage[lane]
    def mem_lookup = mem.memory.enable & (mem.resolution.disposition === SuperscalarDisposition.Continue)
    def mem_misaligned = mem.memory.access.is_one_of(CacheOperation.Load, CacheOperation.Store) & !mem.memory.width.is_aligned(mem.address)
    def mem_outcome = priority_mux(~default: SuperscalarCacheOutcome.Replay):
      mem_misaligned: SuperscalarCacheOutcome.Slow
      scalar_pipeline.response.valid: scalar_pipeline.response.bits.outcome

    def mem_hit = mem_lookup & (mem.memory.access === CacheOperation.Load) & (mem_outcome === SuperscalarCacheOutcome.LoadHit)
    def mem_page_fault = mem_outcome.is_one_of(SuperscalarCacheOutcome.PageFault, SuperscalarCacheOutcome.GuestPageFault)
    def mem_fault = mem_outcome.is_one_of(SuperscalarCacheOutcome.PageFault, SuperscalarCacheOutcome.GuestPageFault, SuperscalarCacheOutcome.AccessFault)
    def mem_disposition = priority_mux(~default: SuperscalarDisposition.Continue):
      mem_fault: SuperscalarDisposition.Fault
      mem_outcome === SuperscalarCacheOutcome.Replay: SuperscalarDisposition.Replay

    def mem_lookup_resolution = SuperscalarResolution(xlen):
      guest: scalar_pipeline.response.bits.guest
      disposition: mem_disposition
      cause: data_fault_cause(mem.memory.access.store_fault_class(), ~page_fault: mem_page_fault, ~guest_page_fault: mem_outcome === SuperscalarCacheOutcome.GuestPageFault)
      value: mem.address

    def mem_taken = mem.branch.update.branch & mem_resolver.result.bits.taken
    def mem_next_pc = mux(mem_taken, mem.address, mem.fetched.sequential_pc.apply(mem_pc))
    def mem_predicted_pc = mux(mem.fetched.prediction.valid, mem.fetched.prediction.target.expanded(), mem.fetched.sequential_pc.apply(mem_pc))
    def mem_bad_target = mem_taken & mem.address[0].into(Bool)
    def mem_target_resolution = SuperscalarResolution(xlen):
      guest: empty_guest.updated(~guest_virtual_address: guest_state.virtualized)
      disposition: SuperscalarDisposition.Fault
      cause: ExceptionCause.InstructionAddressMisaligned
      value: mem.address

    /* Final MEM resolution and forwarding.
       Earlier faults win; a permitted load hit joins the ordinary data
       path while branch recovery only cancels younger validity. */

    def external :: SuperscalarResolution(xlen) = resolution[lane].bits
    def mem_final_resolution :: SuperscalarResolution(xlen) = priority_mux(~default: mem.resolution):
      mem.resolution.disposition =/= SuperscalarDisposition.Continue: mem.resolution
      mem_bad_target: mem_target_resolution
      resolution[lane].valid: external
      mem_lookup: mem_lookup_resolution

    mem_resolved[lane] <== mem.updated(
      ~branch: mem.branch.updated(
        ~taken: mem_taken,
        ~mispredicted: (mem_next_pc =/= mem_predicted_pc) ||| (mem.fetched.direction.valid & (mem.fetched.direction.taken ^ mem_taken)) ||| (Bool(profile.ras_entries > 0) & (mem.branch.update.ras_action =/= mem.fetched.speculated_ras_action)),
        ~update: mem.branch.update.updated(~taken: mem_taken)
      ),
      ~resolution: mem_final_resolution.with_result(mux(mem_hit, mem_load.value, mem.resolution.value)),
      ~result_ready: mem.result_ready ||| mem_hit,
      ~cache_outcome: mem_outcome
    )

    mem_input |> filter_valid(_operation => !wb_squash & !any(for List (older in 0..lane): mem_branch_redirect & mem_resolved[older].branch.mispredicted & mem_pipe[older].egress.valid)) |> map_valid(_operation => mem_resolved[lane]) |> mem_output
    (mem_results[lane] |> trace_valid_event("core/s3.mem.slot" ++ to_string(lane), ~fields: token):
      pc: mem_pc
      instruction(~format: "riscv", ~isa: trace_isa, ~pc: "pc"): mem.fetched.raw()
      outcome: token.cache_outcome
      disposition: token.resolution.disposition
      branch: token.branch.update.branch
      mispredicted: token.branch.mispredicted
      predicted_target: mem.fetched.prediction.target.expanded()
      taken: token.branch.taken
    ) |> map_valid(token => token.into(SuperscalarResult(xlen, hypervisor)).for_writeback()) |> wb_pipe[lane].ingress

    wb_pipe[lane].flush <== wb_squash

  when (mem_results[0].valid):
    wb_pc_region <== mem_pc_region
    wb_younger_next_region <== mem_younger_next_region

  when (ex_pipe[0].ingress.valid):
    ex_fp_request <== rr_fp_request

  when (mem_pipe[0].ingress.valid):
    mem_fp_request <== superscalar_fp_retirement(xlen, ex_fp_request)

  when (wb_pipe[0].ingress.valid):
    wb_fp_request <== mem_fp_request


  /* MEM to WB: only surviving lanes advance. A redirect can kill the younger
     owner independently; stale payloads have no validity outside their lane. */

  def mem_right_words = for List (result in mem_results): result.bits.operands.right
  def mem_service_claims = for List (result in mem_results):
    def token :: SuperscalarResult(xlen, hypervisor) = result.bits
    def divide = (token.muldiv.service === SuperscalarLongOperation.Divide) ||| (token.fp.valid & (token.fp.bits.execution.unit === FloatUnit.DivideSquareRoot))
    // The passive memory observer needs the store operand even on a fault.
    result.valid & (token.memory.enable ||| (divide & (token.resolution.disposition === SuperscalarDisposition.Continue)))

  def mem_service_owner = vec(mem_service_claims).into(MaybeOneHot(issue_width))
  reg wb_service_right(Bits(xlen.width))
  assert(popcount(mem_service_claims) <= Bits(index_width(issue_width + 1))(1), "superscalar_one_wb_service_operand")
  when (mem_service_owner.valid):
    wb_service_right <== mem_service_owner.mux(mem_right_words, ~default: Bits(xlen.width)(0))

  /* A register-vtype configuration can retire beside the scalar service. The
     CSR command gets its own rs2; immediate configurations read the instruction. */
  def wb_register_vtype = if vector_enabled
  | block:
      def claims = for List (result in mem_results):
        def token :: SuperscalarResult(xlen, hypervisor) = result.bits
        result.valid & forwards_config(token) & (token.vector.configure === VectorConfigMode.VtypeRegister)

      def owner = vec(claims).into(MaybeOneHot(issue_width))
      reg vtype(Bits(xlen.width))
      when (owner.valid):
        vtype <== owner.mux(mem_right_words, ~default: Bits(xlen.width)(0))

      vtype
  | Bits(xlen.width)(0)

  def mem_vector_claims :: List.of(Bool) = for List (result in mem_results):
    def token :: SuperscalarResult(xlen, hypervisor) = result.bits
    result.valid & token.vector.operation & (token.resolution.disposition === SuperscalarDisposition.Continue)

  when (any(mem_vector_claims)):
    assert(mem_descriptor_lane === superscalar_service_lane(mem_vector_claims), "superscalar_mem_vector_handoff")
    wb_descriptor_lane <== mem_descriptor_lane
    wb_descriptor <== mem_descriptor.updated(~precertified: (mem_descriptor_lane === mem_vector_lane) & vector_fast.response.valid, ~certificate: vector_fast.response.bits)

  /* MEM branch recovery.
     Correct predictions preserve target-stream work. A correction keeps its
     resolving token and older peers; older WB recovery still wins. */

  def mem_corrections = for List (lane in 0..issue_width):
    def older_stops = any(for List (older in 0..lane): mem_pipe[older].egress.valid & ((mem_resolved[older].resolution.disposition =/= SuperscalarDisposition.Continue) ||| mem_resolved[older].branch.mispredicted))
    mem_pipe[lane].egress.valid & mem_resolved[lane].branch.mispredicted & (mem_resolved[lane].resolution.disposition === SuperscalarDisposition.Continue) & !older_stops

  mem_branch_redirect <== any(mem_corrections) & !wb_squash
  def mem_branch :: SuperscalarResult(xlen, hypervisor) = priority_mux((for List (lane in 0..issue_width - 1): [mem_corrections[lane], mem_resolved[lane]]), ~default: mem_resolved[issue_width - 1])
  def mem_pcs = vec(for List (stage in mem_pipe): stage.pc)
  def mem_branch_pc = priority_mux((for List (lane in 0..issue_width - 1): [mem_corrections[lane], mem_pcs[lane]]), ~default: mem_pcs[issue_width - 1])
  def mem_prediction_pc = mux(mem_branch.fetched.prediction.valid, mem_branch.fetched.prediction.target.expanded(), mem_branch.fetched.sequential_pc.apply(mem_branch_pc))
  def mem_actual_pc = mux(mem_branch.branch.taken, mem_branch.address, mem_branch.fetched.sequential_pc.apply(mem_branch_pc))
  def mem_prediction_failure = prediction_failure(
    mem_branch.branch.update.branch, mem_branch.branch.update.conditional,
    ((mem_actual_pc =/= mem_prediction_pc) & (mem_branch.branch.taken ^ (mem_prediction_pc =/= mem_branch.fetched.sequential_pc.apply(mem_branch_pc)))) ||| (mem_branch.fetched.direction.valid & (mem_branch.fetched.direction.taken ^ mem_branch.branch.taken)),
    mem_actual_pc =/= mem_prediction_pc, mem_branch.fetched.instruction[0..7] === Bits(7)(0x67),
    mem_branch.branch.update.ras_action.is_one_of(RasAction.Pop, RasAction.PopPush),
    Bool(profile.ras_entries > 0) & (mem_branch.branch.update.ras_action =/= mem_branch.fetched.speculated_ras_action)
  )
  count_prediction_failure(mem_branch_redirect, mem_prediction_failure)
  def mem_redirect_bits = SuperscalarRedirect(xlen):
    pc: mem_branch_pc
    target: mux(mem_branch.branch.taken, mem_branch.address, mem_branch.fetched.sequential_pc.apply(mem_branch_pc))
    resolution: mem_branch.resolution
    interrupt: Bool(#false)
    trap_cause: Bits(xlen.width)(0)


  /* WB: Retained owners and ordered service admission.
     Hits retire directly; ordinary services allocate deferred owners. Split,
     management, and reservation waits retain context through final completion. */

  reg wb_retained_state(~init: SuperscalarRetainedState.Idle)
  def wb_retained_pending = wb_retained_state =/= SuperscalarRetainedState.Idle
  def wb_retained_sent = wb_retained_state === SuperscalarRetainedState.Accepted
  def wb_retained_ready = wb_retained_state === SuperscalarRetainedState.Ready
  reg wb_retained_owner(SuperscalarServiceOwner(xlen, hypervisor))
  reg wb_retained_vector(~init: Bool(#false))
  reg wb_retained_locality(RiscvMemoryLocality)
  reg wb_pending_locality(~init: RiscvMemoryLocality.Default)
  def wb_management = wb_retained_pending & wb_retained_owner.memory.enable & wb_retained_owner.memory.access.is_cache_management()
  wb_reservation_waiting <== wb_retained_pending & (wb_retained_owner.wait =/= ReservationWaitMode.None)

  /* Reservation-wait completion uses retained instruction context.
     Wake wins over timeout faults; the counter saturates until completion. */

  inst wb_wait(ReservationWait())
  wb_wait.active <== wb_reservation_waiting
  wb_wait.reservation_valid <== scalar_memory.reservation_valid
  wb_wait.interrupt_wake <== wb_csrs.wfi_wake
  wb_wait.short_timeout <== wb_retained_owner.wait === ReservationWaitMode.ShortTimeout
  wb_wait.trap_on_timeout <== (wb_csrs.privilege =/= PrivilegeMode.Machine) & csr_flag(wb_csrs.mstatus, MstatusTW)
  wb_wait.virtual_trap_on_timeout <== guest_state.virtualized & csr_flag(guest_state.hstatus, HstatusVTW)
  def wb_wait_complete = wb_wait.completion.valid
  def wb_wait_fault = wb_wait.completion.bits.as_bits().any()
  def wb_wait_resolution = SuperscalarResolution(xlen):
    guest: literal(RiscvGuestFault(), 0)
    disposition: mux(wb_wait_fault, SuperscalarDisposition.Fault, SuperscalarDisposition.Continue)
    cause: mux(wb_wait.completion.bits.illegal_instruction, ExceptionCause.IllegalInstruction, ExceptionCause.VirtualInstruction)
    value: wb_retained_owner.identity.raw_instruction.zext(xlen.width)

  /* Split, management, and vector completion resolve the captured owner, not live WB.
     Completion may precede acceptance for a wait or local admission fault. */

  wb_management_response <== wb_management & wb_retained_sent
  wire wb_management_fault: Bool
  wire wb_management_accepted: Bool
  def wb_retained_complete = scalar_split.response.valid ||| wb_management_completed.valid ||| wb_management_fault ||| wb_wait_complete ||| (wb_retained_pending & wb_retained_vector & vector.outcome.valid)
  def wb_split_fault = scalar_split.response.bits.page_fault ||| scalar_split.response.bits.guest.page_fault ||| scalar_split.response.bits.response.access_fault
  def wb_split_resolution = SuperscalarResolution(xlen):
    guest: scalar_split.response.bits.guest.details
    disposition: mux(wb_split_fault, SuperscalarDisposition.Fault, SuperscalarDisposition.Continue)
    cause: data_fault_cause(wb_retained_owner.memory.access.store_fault_class(), ~page_fault: scalar_split.response.bits.page_fault, ~guest_page_fault: scalar_split.response.bits.guest.page_fault)
    value: scalar_split.response.bits.fault_address[0..xlen.width]

  def wb_vector_resolution = SuperscalarResolution(xlen):
    guest: vector.outcome_guest
    disposition: mux(vector.outcome.bits.disposition === VectorDisposition.Fault, SuperscalarDisposition.Fault, SuperscalarDisposition.Continue)
    cause: vector.outcome.bits.cause
    value: vector.outcome.bits.fault_address

  def wb_admission_outcome :: SuperscalarResolution(xlen) = scalar_memory.fault.bits
  def wb_admission_resolution = wb_admission_outcome
  def wb_retained_resolution = priority_mux(~default: wb_split_resolution):
    wb_retained_vector: wb_vector_resolution
    wb_reservation_waiting: wb_wait_resolution
    wb_management: mux(wb_management_fault, wb_admission_resolution, literal(SuperscalarResolution(xlen), 0))

  def wb_retained_result = wb_retained_owner.completed(scalar_split.response.bits.response.data, wb_retained_resolution)


  /* Precise fault and interrupt retention.
     New dispatch observes live owners before ready/fault feedback;
     synchronous faults precede interrupts at the oldest unretired boundary. */

  inst wb_fault_retention(OfferRegister(SuperscalarPendingTrap(xlen, profile.hypervisor)))
  def wb_fault_pending = wb_fault_retention.egress.valid
  def wb_held_trap :: SuperscalarPendingTrap(xlen, profile.hypervisor) = wb_fault_retention.egress.bits
  reg wb_pending_redirect(Bool)
  wb_redirect_pending <== wb_fault_pending & wb_pending_redirect
  wb_redirect_pc <== wb_held_trap.instruction.pc
  wire wb_rejected_target: Bits(xlen.width)
  // Vector authorization retains the older instruction, not the scalar pipes.
  // On success its retirement may share the second slot with a simple scalar
  // result; service/CSR work instead replays to its original physical WB lane.
  def wb_vector_pending = wb_retained_pending & wb_retained_vector
  def wb_blocking_retained = wb_retained_pending & !wb_retained_vector
  def wb_vector_success = wb_vector_pending & wb_retained_complete & (wb_retained_result.resolution.disposition === SuperscalarDisposition.Continue)
  // Live owners drive admission; retained results drive only normalized retirement.
  def wb_live_valid :: Vec(issue_width, Bool) = vec(for List (stage in wb_pipe): stage.egress.valid)
  def wb_live_group :: Vec(issue_width, SuperscalarResult(xlen, hypervisor)) = vec(
    for List (stage in wb_pipe):
      def token :: SuperscalarResult(xlen, hypervisor) = stage.egress.bits
      token.updated(~operands: token.operands.updated(~right: wb_service_right))
  )

  def wb_scalar_lane = superscalar_service_lane(for List (stage in wb_pipe): stage.egress.valid)
  def wb_scalar :: SuperscalarResult(xlen, hypervisor) = wb_live_group[service_index(wb_scalar_lane)]
  def wb_scalar_vector = wb_scalar.vector.operation
  def wb_scalar_simple = !wb_scalar_vector & !wb_scalar.memory.enable & !wb_scalar.fp.valid & (wb_scalar.muldiv.service === SuperscalarLongOperation.None) & !wb_scalar.system.uses_command() & !wb_scalar.pause
  // Return eligibility must not depend on the FP completion it authorizes.
  def wb_scalar_port_available = Bool(return_port != 1) ||| !wb_gpr_calendar.occupied[0].into(Bool)
  def wb_vector_merge = wb_vector_success & wb_live_valid.any() & wb_scalar_simple & wb_scalar_port_available & (wb_scalar.resolution.disposition === SuperscalarDisposition.Continue)
  def wb_valid :: Vec(issue_width, Bool) = vec(for List (lane in 0..issue_width): if lane == 0 | mux(wb_retained_pending, wb_retained_complete, wb_older.egress.valid) | (Bool(lane == 1) & wb_vector_merge) ||| (!wb_retained_pending & wb_pipe[lane].egress.valid))
  def wb_live_pcs = vec(for List (stage in wb_pipe): stage.pc)
  def wb_group_pcs = vec(
    for List (lane in 0..issue_width):
      cond
      | lane == 0: mux(wb_retained_pending, wb_retained_owner.identity.address(), wb_live_pcs[0])
      | lane == 1: mux(wb_vector_merge, wb_live_pcs[service_index(wb_scalar_lane)], wb_live_pcs[1])
      | ~else: wb_live_pcs[lane]
  )
  def wb_group :: Vec(issue_width, SuperscalarRetirementCommand(xlen, hypervisor)) = vec(
    for List (lane in 0..issue_width):
      def live = wb_live_group[lane].retirement()
      cond
      | lane == 0: mux(wb_retained_pending, wb_retained_result, live)
      | lane == 1: mux(wb_vector_merge, wb_scalar.retirement(), live)
      | ~else: live
  )

  // New dispatch observes the live WB pipes, never the returned retained owner.
  // In particular, admission faults cannot feed back into their own request.
  def wb_raw_fault = any(for List (lane in 0..issue_width): wb_live_valid[lane] & (wb_live_group[lane].resolution.disposition === SuperscalarDisposition.Fault))
  // Interrupts precede the oldest unretired WB instruction, or use the saved
  // next PC at an empty-pipeline/sleep boundary. A synchronous fault wins.
  def wb_idle_boundary = rr_pipeline_empty & wb_pc_known
  def wb_interrupt_stop = wb_csrs.interrupt_request & !wb_retained_pending & !wb_fault_pending & !wb_raw_fault & (wb_live_valid[0] ||| wb_idle_boundary)
  def wb_interrupt_pc = mux(wb_valid[0], wb_group_pcs[0], wb_resume_pc)
  def wb_retirement_unblocked = !wb_fault_pending & !wb_interrupt_stop
  def wb_dispatch_unblocked = !wb_retained_pending & wb_retirement_unblocked

  /* Admission prefix: inspect live owners before any ready/fault outcome.
     Final retirement cannot qualify requests without creating feedback.
     Retained completion may retire, but cannot dispatch a new live owner. */

  def wb_dispatch :: Vec(issue_width, Bool) = vec(
    for List (lane in 0..issue_width):
      wb_live_valid[lane] & (wb_live_group[lane].resolution.disposition === SuperscalarDisposition.Continue) & !any(for List (older in 0..lane): wb_live_valid[older] & (wb_live_group[older].resolution.disposition =/= SuperscalarDisposition.Continue)) & wb_dispatch_unblocked
  )

  /* WB vector admission and scalar-result reservations.
     Registered descriptor credit and a sampled memory-drain boundary prevent
     requests from depending on their own LSU acceptance or fault outcomes. */

  def wb_vectors = for List (lane in 0..issue_width): wb_live_group[lane].vector.operation

  wire wb_scalar_stop: Bool
  def wb_vector_lane = superscalar_service_lane(for List (lane in 0..issue_width): wb_live_valid[lane] & wb_vectors[lane])
  def wb_vector = wb_live_group[service_index(wb_vector_lane)]
  def wb_vector_offer = wb_dispatch[service_index(wb_vector_lane)] & (if vector_enabled | wb_vector.vector.operation | Bool(#false))
  def wb_vector_pc = wb_live_pcs[service_index(wb_vector_lane)]
  def wb_vector_ordered = !wb_vector.vector.memory ||| (wb_prior_memory_drained & !wb_load_response.pending & !wb_ordered_memory_pending)
  def wb_vector_gpr_write = wb_vector.vector.integer_destination & wb_vector.write
  def wb_vector_results_available = !wb_vector_gpr_write ||| wb_vector_scalar_available
  def wb_vector_fpr_available = !wb_vector.vector.floating_scalar_destination ||| !wb_vector.vector.floating_point ||| !wb_vector_fpr_pending ||| fp.vector_written.valid
  vector_fast.candidate <== wb_descriptor.certificate
  def wb_vector_masking_current = wb_descriptor.pointer_masking.as_bits() === wb_csrs.pointer_masking.as_bits()
  def wb_vector_certified = wb_descriptor.precertified & vector_fast.candidate_current & wb_vector_masking_current
  def wb_vector_eligible = wb_vector_ordered & wb_vector_results_available & wb_vector_fpr_available
  // Credit predicts the older descriptor's acceptance without depending on
  // a request qualified by the younger scalar service's own outcome.
  def wb_scalar_service_lane = superscalar_service_lane(for List (lane in 0..issue_width): wb_live_valid[lane] & (wb_live_group[lane].memory.enable ||| (wb_live_group[lane].muldiv.service =/= SuperscalarLongOperation.None) ||| (wb_live_group[lane].fp.valid & (wb_live_group[lane].fp.bits.execution.unit === FloatUnit.DivideSquareRoot))))
  def wb_scalar_prefix = !any(for List (lane in 0..issue_width): wb_live_valid[lane] & wb_vectors[lane] & (Bits(2)(lane) < wb_scalar_service_lane)) ||| (wb_vector_eligible & vector.available & (!wb_vector.vector.memory ||| wb_vector_certified))
  def wb_vector_prefix = !wb_scalar_stop
  vector.request.valid <== wb_vector_offer & wb_vector_eligible & wb_vector_prefix
  vector.request.bits <== wb_descriptor.updated(~precertified: wb_vector_certified)
  when (vector.request.valid):
    assert(wb_descriptor_lane === wb_vector_lane, "superscalar_wb_vector_descriptor_owner")
  // Admission retains the live lane's owner even when vector memory retires later.
  describe_interface_selection((for List (lane in 0..issue_width): wb_vector_lane === Bits(2)(lane)), ~name: "vector-lane")
  describe_interface_contract((for Array (lane in 0..issue_width): wb_paths[lane][2]), vector.request, "vector-lane", ~trace_model: interface_trace_selection(~name: "vector-lane", ~pending: #true))
  def wb_vector_accepted = vector.request.fire()
  def wb_vector_capture = wb_vector_accepted & wb_vector.vector.memory & !wb_vector_certified
  def wb_vector_replay = wb_vector_offer & !wb_vector_accepted
  // Replay the oldest live scalar suffix, never the accepted vector owner.
  // A merged scalar consumes the remaining retirement slot; any second live
  // instruction must replay. The capture edge applies the same age rule.
  def wb_vector_suffix = for List (lane in 0..issue_width): wb_live_valid[lane] & mux(wb_vector_pending, !wb_vector_merge ||| (Bits(2)(lane) > wb_scalar_lane), Bits(2)(lane) > wb_vector_lane)
  def wb_vector_scalar_lane = superscalar_service_lane(wb_vector_suffix)
  def wb_vector_replay_owner = wb_live_group[service_index(wb_vector_scalar_lane)]
  def wb_vector_live_suffix = any(wb_vector_suffix)
  def wb_vector_scalar_replay = (wb_vector_pending & !(wb_retained_complete & !wb_vector_success) & wb_vector_live_suffix) ||| (wb_vector_capture & wb_vector_live_suffix)
  def wb_vector_replay_owner_pc = wb_live_pcs[service_index(wb_vector_scalar_lane)]
  // Let scalars speculate once. After rejection, retain only a retry interlock,
  // not their results; the refetched suffix waits in RR for the vector outcome.
  when (!wb_vector_pending ||| wb_retained_complete):
    rr_vector_retry_wait <== wb_vector_capture & wb_vector_scalar_replay
  elsewhen (wb_vector_scalar_replay):
    rr_vector_retry_wait <== Bool(#true)

  wb_vector_scoreboard.set.valid <== wb_vector_accepted & wb_vector_gpr_write
  wb_vector_scoreboard.set.bits <== wb_vector.rd
  fp.vector_reserve.valid <== wb_vector_accepted & wb_vector.vector.floating_point & wb_vector.vector.floating_scalar_destination
  fp.vector_reserve.bits <== wb_vector.rd

  // Only a nonzero GPR writer claims this owner; unrelated vector descriptors
  // may pass it. A returning result still observes the old owner on replacement.
  when (wb_vector_scalar_return):
    assert(wb_vector_scalar_pending & (vector.scalar_result.bits.address === wb_vector_scalar_rd), "superscalar_vector_scalar_return_owner")

  when (wb_vector_accepted & wb_vector_gpr_write):
    assert(wb_vector_scalar_available, "superscalar_vector_scalar_owner_available")
    wb_vector_scalar_pending <== Bool(#true)
    wb_vector_scalar_owner <== wb_vector.fetched.identity(wb_vector_pc)
    wb_vector_scalar_rd <== wb_vector.rd
  elsewhen (wb_vector_scalar_return):
    wb_vector_scalar_pending <== Bool(#false)

  // FPR ownership ends on the actual shared-port write, not result availability.
  when (fp.vector_reserve.valid):
    wb_vector_fpr_pending <== Bool(#true)
  elsewhen (fp.vector_written.valid):
    wb_vector_fpr_pending <== Bool(#false)

  wb_csrs.vector_retire.valid <== vector.retire.valid ||| (wb_vector_accepted & (!wb_vector.vector.memory ||| wb_vector_certified))

  /* Scalar admission follows the older descriptor's registered credit.
     The reverse age order qualifies vector admission with scalar outcomes;
     neither direction depends on final retirement feedback. */

  def wb_memory_lane = superscalar_service_lane(for List (lane in 0..issue_width): wb_live_valid[lane] & wb_live_group[lane].memory.enable)
  def wb_memory :: SuperscalarResult(xlen, hypervisor) = wb_live_group[service_index(wb_memory_lane)]
  def wb_memory_pc = wb_live_pcs[service_index(wb_memory_lane)]
  // A younger request consumes its older peer's hint on this same WB edge.
  // This selection must not depend on request readiness or retirement feedback.
  def wb_memory_locality = priority_mux((for List (lane in 1..issue_width): [wb_memory_lane === Bits(2)(lane), wb_live_group[lane - 1].locality_hint]), ~default: wb_pending_locality)
  def wb_memory_active = wb_dispatch[service_index(wb_memory_lane)] & wb_memory.memory.enable & wb_scalar_prefix
  def wb_split_capture = wb_memory_active & wb_memory.memory.access.is_one_of(CacheOperation.Load, CacheOperation.Store) & !wb_memory.memory.width.is_aligned(wb_memory.address)
  def wb_management_capture = wb_memory_active & wb_memory.memory.access.is_cache_management()
  def wb_memory_capture = wb_split_capture ||| wb_management_capture
  def wb_wait_capture = wb_dispatch[0] & (wb_live_group[0].system.wait =/= ReservationWaitMode.None)
  def wb_retained_capture = wb_split_capture ||| wb_management_capture ||| wb_wait_capture ||| wb_vector_capture
  def wb_retained_lane = mux(wb_vector_capture, wb_vector_lane, mux(wb_wait_capture, Bits(2)(0), wb_memory_lane))
  def wb_retained_candidate :: SuperscalarResult(xlen, hypervisor) = wb_live_group[service_index(wb_retained_lane)]
  def wb_retained_candidate_pc = wb_live_pcs[service_index(wb_retained_lane)]
  when wb_retained_capture:
    assert((wb_retained_candidate.resolution.disposition === SuperscalarDisposition.Continue) & !wb_retained_candidate.fetched.fault, "superscalar_service_capture_continuing")
    assert(!wb_retained_candidate.branch.update.branch & (wb_retained_candidate.muldiv.service === SuperscalarLongOperation.None) & !wb_retained_candidate.prefetch.is_prefetch() & !wb_retained_candidate.pause, "superscalar_service_capture_not_execution")
    assert((wb_retained_candidate.system.csr === RiscvCsrOperation.None) & (wb_retained_candidate.system.action === RiscvCsrAction.None) & (wb_retained_candidate.system.fence === SuperscalarFence.None), "superscalar_service_capture_not_command")
    assert(!wb_retained_candidate.fp.valid ||| (wb_retained_candidate.fp.bits.execution.unit === FloatUnit.Memory), "superscalar_service_capture_fp_memory")
    assert(!wb_retained_candidate.fp.valid ||| (wb_fp_request.destination === wb_retained_candidate.fp.bits.registers.destination), "superscalar_service_capture_fp_destination")

  /* Retained lineage follows capture and final completion.
     Normal retirement selects between the live oldest and returned owner. */

  def wb_retained_input = interface_link(Valid(SuperscalarResult(xlen, hypervisor)))
  def wb_retained_output = interface_link(Valid(SuperscalarRetirementCommand(xlen, hypervisor)))
  wb_retained_input.left.valid <== wb_retained_capture
  wb_retained_input.left.bits <== wb_retained_candidate
  wb_retained_output.left.valid <== wb_retained_pending & wb_retained_complete
  wb_retained_output.left.bits <== wb_retained_result
  describe_interface_selection((for List (lane in 0..issue_width): wb_retained_lane === Bits(2)(lane)), ~name: "retained-operation-lane")
  describe_interface_contract((for Array (lane in 0..issue_width): wb_paths[lane][1]), wb_retained_input.left, "retained-operation-lane", ~trace_model: interface_trace_selection(~name: "retained-operation-lane"))
  describe_interface_retained_storage(wb_retained_capture, wb_retained_complete, wb_retained_pending, ~name: "retained-operation")
  describe_interface_contract(wb_retained_input.right, wb_retained_output.left, "retained-operation-owner", ~trace_model: interface_trace_retained(~name: "retained-operation"))
  def wb_owners = interface_link(Valid(SuperscalarRetirementCommand(xlen, hypervisor)))
  wb_owners.left.valid <== wb_valid[0]
  wb_owners.left.bits <== wb_group[0]
  describe_interface_selection([!wb_retained_pending, wb_retained_pending], ~name: "wb-owner")
  describe_interface_contract(Array(wb_paths[0][0], wb_retained_output.right), wb_owners.left, "wb-owner", ~trace_model: interface_trace_selection(~name: "wb-owner"))
  def wb_second_owner = interface_link(Valid(SuperscalarRetirementCommand(xlen, hypervisor)))
  wb_second_owner.left.valid <== wb_valid[1]
  wb_second_owner.left.bits <== wb_group[1]
  def wb_second_lane = mux(wb_vector_merge, wb_scalar_lane, Bits(2)(1))
  describe_interface_selection((for List (lane in 0..issue_width): wb_second_lane === Bits(2)(lane)), ~name: "wb-second-owner")
  describe_interface_contract((for Array (lane in 0..issue_width): wb_paths[lane][3]), wb_second_owner.left, "wb-second-owner", ~trace_model: interface_trace_selection(~name: "wb-second-owner"))

  /* Drain older services before launching retained split work.
     Capture, completion, acceptance, then drain define state-update priority. */

  def wb_slow = wb_memory_active & !wb_memory_capture & (wb_memory.cache_outcome === SuperscalarCacheOutcome.Slow)
  def wb_store_hit = wb_memory_active & wb_memory.memory.access.is_store() & (wb_memory.cache_outcome === SuperscalarCacheOutcome.StoreHit)
  def wb_older_vector_memory = wb_live_valid[service_index(wb_vector_lane)] & wb_vector.vector.memory & (wb_vector_lane < wb_memory_lane)
  def wb_vector_store_pending = vector.stores_pending ||| (wb_older_vector_memory & wb_vector.vector.store)
  def wb_vector_load_pending = vector.loads_pending ||| (wb_older_vector_memory & !wb_vector.vector.store)
  def wb_memory_blocked = scalar_memory.ordered_busy ||| wb_ordered_memory_pending ||| wb_vector_store_pending ||| (wb_memory.memory.access.store_fault_class() & wb_vector_load_pending)
  def wb_prior_drained = wb_load_response.drained & scalar_memory.drained & ex_multiply.drained & wb_divide.drained & !wb_completion_count.any() & !rr_completion.valid & fp.drained & !vector.active & !wb_vector_scalar_pending & !wb_vector_fpr_pending
  scalar_split.request.valid <== wb_retained_ready & !wb_management & !wb_reservation_waiting & !wb_retained_vector
  memory_ports.scalar_guest_access <== wb_retained_owner.guest_access
  scalar_split.request.bits <== PhysicalMemoryReq(xlen, Bool):
    address: wb_retained_owner.address
    access: wb_retained_owner.memory.access
    atomic: dont_care(scalar_split.request.bits.atomic.type)
    width: wb_retained_owner.memory.width
    unsigned: wb_retained_owner.memory.unsigned
    data: wb_retained_owner.store_data
    byte_mask: dont_care(Bits(xlen.width / 8))
    context: Bool(#false)
    locality: wb_retained_locality

  def wb_retained_accepted = scalar_split.request.fire() ||| wb_management_accepted
  def wb_retained_drained = (wb_retained_state === SuperscalarRetainedState.Draining) & wb_prior_drained
  when wb_retained_capture:
    wb_retained_state <== mux(wb_vector_capture, SuperscalarRetainedState.Accepted, SuperscalarRetainedState.Draining)
    wb_retained_owner <== wb_retained_candidate.service_owner(wb_retained_candidate_pc, wb_fp_request)
    wb_retained_locality <== wb_memory_locality
    wb_retained_vector <== wb_vector_capture
  elsewhen wb_retained_complete:
    wb_retained_state <== SuperscalarRetainedState.Idle
  elsewhen wb_retained_accepted:
    wb_retained_state <== SuperscalarRetainedState.Accepted
  elsewhen wb_retained_drained:
    wb_retained_state <== SuperscalarRetainedState.Ready

  wb_wait.capture.valid <== wb_wait_capture

  when (scalar_split.response.valid):
    assert(wb_retained_pending & wb_retained_sent, "superscalar_split_response_has_retirement_owner")

  /* WB service dispatch and admission outcomes.
     Request offers depend on pre-dispatch owners, not final retirement;
     successful acceptance, admission faults, and replay remain distinct. */

  def wb_request_address = mux(wb_management, wb_retained_owner.address, wb_memory.address)
  def wb_request_data = mux(wb_management, wb_retained_owner.store_data, wb_memory.operands.right)
  def wb_request_memory :: SuperscalarMemoryControl() = mux(wb_management, wb_retained_owner.memory, wb_memory.memory)
  def wb_request_guest = mux(wb_management, wb_retained_owner.guest_access, wb_memory.guest_access)
  inst wb_store(StoreGen(xlen, xlen.width / 8))
  wb_store.address <== wb_request_address
  wb_store.value <== wb_request_data
  wb_store.width <== wb_request_memory.width
  scalar_memory.request.valid <== (wb_slow & wb_load_response.available & !wb_memory_blocked) ||| (wb_management & wb_retained_ready)
  scalar_memory.request.bits <== SuperscalarMemoryReq(xlen, xlen.width):
    guest_access: wb_request_guest
    address: wb_request_address
    access: wb_request_memory.access
    atomic: wb_request_memory.atomic
    width: wb_request_memory.width
    data: mux(wb_request_memory.access.is_store(), wb_store.data, wb_request_data)
    mask: wb_store.mask.as_bits()
    locality: mux(wb_request_memory.access.is_one_of(CacheOperation.Load, CacheOperation.Store), wb_memory_locality, RiscvMemoryLocality.Default)
    pbmt: PageMemoryType.PMA

  scalar_pipeline.commit <== wb_store_hit & !wb_memory_blocked
  // The physical service's drain may depend on today's admission. Sample a
  // quiet boundary before allowing a vector descriptor to begin page proof.
  wb_prior_memory_drained <== scalar_memory.drained & !scalar_memory.request.fire() & !scalar_pipeline.commit & !scalar_split.request.fire()
  def wb_admission_fault = scalar_memory.request.valid & scalar_memory.fault.valid
  wb_management_fault <== wb_management & wb_admission_fault
  wb_management_accepted <== wb_management & scalar_memory.request.fire()
  def wb_accepted = scalar_memory.request.fire() & !wb_admission_fault & !wb_management
  def wb_memory_replay = (wb_memory_active & !wb_memory_capture & wb_memory_blocked) ||| (wb_slow & !wb_accepted & !wb_admission_fault) ||| (wb_store_hit & !scalar_pipeline.commit_ready)
  wb_load_response.allocate.valid <== wb_accepted
  wb_load_response.allocate.bits <== SuperscalarLoadOwner(xlen):
    destination: wb_fp_request.owner(wb_memory.fetched.identity(wb_memory_pc), wb_memory.rd)
    fp_load: wb_memory.fp.valid & (wb_memory.fp.bits.registers.destination === FloatDestination.FloatingPoint)
    write: wb_memory.write
    precision: wb_memory.fp.bits.execution.destination_precision
    access: wb_memory.memory.access
    offset: wb_memory.address[0..alignment_bits(memory_word_bytes(xlen))]
    width: wb_memory.memory.width
    unsigned: wb_memory.memory.unsigned

  when (wb_accepted & !wb_memory.memory.access.is_one_of(CacheOperation.Load, CacheOperation.Store)):
    wb_ordered_memory_pending <== Bool(#true)
  elsewhen (wb_load_response.ordered_completed.valid):
    wb_ordered_memory_pending <== Bool(#false)

  assert(!(scalar_memory.request.fire() & wb_admission_fault), "superscalar_fault_prevents_acceptance")
  def wb_memory_resolution = SuperscalarResolution(xlen):
    guest: literal(RiscvGuestFault(), 0)
    disposition: SuperscalarDisposition.Replay
    cause: dont_care(ExceptionCause)
    value: dont_care(Bits(xlen.width))

  def wb_fp_lane = superscalar_service_lane(for List (lane in 0..issue_width): wb_valid[lane] & wb_group[lane].fp.valid)
  def wb_empty_fp :: SuperscalarFpRetirement(xlen) = literal(SuperscalarFpRetirement(xlen), 0)
  def wb_retained_fp = wb_empty_fp.updated(~tag: wb_retained_owner.fp_schedule, ~destination: wb_retained_owner.fp.bits.registers.destination)
  def wb_selected_fp = mux(wb_retained_pending, wb_retained_fp, wb_fp_request)
  def wb_fp_token :: SuperscalarRetirementCommand(xlen, hypervisor) = wb_group[service_index(wb_fp_lane)]
  def wb_fp_token_pc = wb_group_pcs[service_index(wb_fp_lane)]
  fp.variable_issue.valid <== wb_dispatch[service_index(wb_fp_lane)] & wb_fp_token.fp.valid & (wb_fp_token.fp.bits.execution.unit === FloatUnit.DivideSquareRoot) & wb_scalar_prefix
  fp.variable_issue.bits <== wb_selected_fp.division_request(wb_fp_token.fetched.identity(wb_fp_token_pc), wb_fp_token.rd, wb_fp_token.operands.left, wb_fp_token.operands.right)
  wb_fp_variable_accepted <== fp.variable_issue.fire()
  def wb_fp_replay = fp.variable_issue.valid & !fp.variable_issue.ready

  /* Deferred integer arithmetic authorization.
     WB authorizes surviving multiply work and retains divider context;
     accepted services reserve their architectural destination. */

  def wb_long_lane = superscalar_service_lane(for List (lane in 0..issue_width): wb_valid[lane] & (wb_live_group[lane].muldiv.service =/= SuperscalarLongOperation.None))
  def wb_long :: SuperscalarResult(xlen, hypervisor) = wb_live_group[service_index(wb_long_lane)]
  def wb_long_active = wb_dispatch[service_index(wb_long_lane)] & wb_long.write & (wb_long.muldiv.service =/= SuperscalarLongOperation.None) & wb_scalar_prefix
  def wb_long_pc = wb_live_pcs[service_index(wb_long_lane)]
  def wb_multiply_accepted = wb_long_active & (wb_long.muldiv.service === SuperscalarLongOperation.Multiply)
  ex_multiply.authorize.valid <== wb_multiply_accepted
  ex_multiply.authorize.bits <== SuperscalarMultiplyWriteback(xlen):
    identity: wb_long.fetched.identity(wb_long_pc)
    rd: wb_long.rd
    high_result: wb_long.muldiv.multiply.high_result
    word_result: wb_long.muldiv.multiply.word_result

  def wb_divide_link = interface_link(Decoupled(SuperscalarResult(xlen, hypervisor)))
  wb_divide_link.left.valid <== wb_long_active & (wb_long.muldiv.service === SuperscalarLongOperation.Divide)
  wb_divide_link.left.bits <== wb_long
  (wb_divide_link.right |> map_flow(payload):
    def operation :: SuperscalarResult(xlen, hypervisor) = payload
    def control = operation.muldiv.divide
    def request = DividerRequest(xlen.width):
      dividend: integer_word_operand(xlen, operation.operands.left, control.signed_mode, control.word_result)
      divisor: integer_word_operand(xlen, operation.operands.right, control.signed_mode, control.word_result)
      signed_mode: control.signed_mode

    def owner = SuperscalarCompletion(xlen):
      identity: operation.fetched.identity(wb_long_pc)
      rd: operation.rd
      write: operation.write
      data: dont_care(Bits(xlen.width))

    SuperscalarDivideIssue(xlen):
      request: request
      control: control
      owner: owner
  ) |> wb_divide.issue

  def wb_divide_accepted = wb_divide_link.right.fire()
  def wb_divide_replay = wb_divide_link.right.valid & !wb_divide_accepted
  def wb_long_accepted = wb_multiply_accepted ||| wb_divide_accepted
  // The scalar side can retain or reject its owner. A younger memory
  // descriptor also waits for any same-group scalar memory to drain.
  wb_scalar_stop <== (wb_memory_active & (wb_memory_lane < wb_vector_lane) & (wb_memory_replay ||| wb_admission_fault ||| wb_memory_capture ||| wb_vector.vector.memory)) ||| (wb_divide_replay & (wb_long_lane < wb_vector_lane)) ||| (wb_fp_replay & (wb_fp_lane < wb_vector_lane))
  wb_scoreboard.set.valid <== (wb_accepted & wb_memory.write) ||| wb_long_accepted
  wb_scoreboard.set.bits <== mux(wb_long_accepted, wb_long.rd, wb_memory.rd)
  assert(!(wb_accepted & wb_long_accepted), "superscalar_one_deferred_owner_per_group")

  /* Oldest-first stop and retirement decisions.
     Folds service faults and replay into each owner's resolution before
     choosing the successful retirement prefix or a retained precise trap. */

  def wb_service_tokens :: Vec(issue_width, SuperscalarRetirementCommand(xlen, hypervisor)) = vec(
    for List (lane in 0..issue_width):
      def token :: SuperscalarRetirementCommand(xlen, hypervisor) = wb_group[lane]
      def selected = wb_memory_active & (wb_memory_lane === Bits(2)(lane))
      def replay = ((selected & wb_memory_replay) ||| (wb_divide_replay & (wb_long_lane === Bits(2)(lane))) ||| (wb_fp_replay & (wb_fp_lane === Bits(2)(lane))) ||| (wb_vector_replay & (wb_vector_lane === Bits(2)(lane))))
      def resolved :: SuperscalarResolution(xlen) = priority_mux(~default: token.resolution):
        selected & wb_admission_fault: wb_admission_resolution
        replay: wb_memory_resolution

      token.updated(~resolution: resolved.with_result(token.resolution.value))
  )

  // Select the command candidate before consulting its fault result. This
  // keeps side-effect-free CSR validation independent of authorization.
  def wb_service_stop = for List (lane in 0..issue_width): wb_valid[lane] & (wb_service_tokens[lane].resolution.disposition =/= SuperscalarDisposition.Continue)
  def wb_service_selected = priority_mux((for List (lane in 0..issue_width - 1): [wb_service_stop[lane], wb_service_tokens[lane]]), ~default: wb_service_tokens[issue_width - 1])
  def wb_service_selected_pc = priority_mux((for List (lane in 0..issue_width - 1): [wb_service_stop[lane], wb_group_pcs[lane]]), ~default: wb_group_pcs[issue_width - 1])
  def wb_system_lane = superscalar_service_lane(for List (lane in 0..issue_width): wb_valid[lane] & wb_group[lane].system.uses_command())
  def wb_system_token :: SuperscalarRetirementCommand(xlen, hypervisor) = wb_group[service_index(wb_system_lane)]
  def wb_system_token_pc = wb_group_pcs[service_index(wb_system_lane)]
  def wb_system_control :: SuperscalarSystemControl() = wb_system_token.system
  def wb_csr_read = csr_pure_read(wb_system_control.csr, wb_system_token.fetched.instruction[15..20])
  def wb_tokens :: Vec(issue_width, SuperscalarRetirementCommand(xlen, hypervisor)) = vec(
    for List (lane in 0..issue_width):
      def token :: SuperscalarRetirementCommand(xlen, hypervisor) = wb_service_tokens[lane]
      def fault = wb_csr_read & (wb_system_lane === Bits(2)(lane)) & !any(wb_service_stop) & wb_csrs.command_fault.valid
      def denied = SuperscalarResolution(xlen):
        guest: literal(RiscvGuestFault(), 0)
        disposition: SuperscalarDisposition.Fault
        cause: wb_csrs.command_fault.cause
        value: wb_csrs.command_fault.value

      token.updated(~resolution: mux(fault, denied, token.resolution))
  )

  def wb_stop = for List (lane in 0..issue_width):
    wb_retirement_unblocked & wb_valid[lane] & (wb_tokens[lane].resolution.disposition =/= SuperscalarDisposition.Continue) & !(wb_retained_capture & (wb_retained_lane <= Bits(2)(lane)))

  def wb_selected :: SuperscalarRetirementCommand(xlen, hypervisor) = priority_mux((for List (lane in 0..issue_width - 1): [wb_stop[lane], wb_tokens[lane]]), ~default: wb_tokens[issue_width - 1])
  def wb_stop_valid = any(wb_stop)
  def wb_selected_pc = priority_mux((for List (lane in 0..issue_width - 1): [wb_stop[lane], wb_group_pcs[lane]]), ~default: wb_group_pcs[issue_width - 1])
  wb_drained <== wb_prior_drained & !wb_accepted & !wb_divide_accepted & !wb_retained_pending & !wb_retained_capture & !wb_fp_variable_accepted & !wb_fp_fixed_authorized & !wb_vector_accepted
  def wb_explicit_fault = wb_stop_valid & (wb_selected.resolution.disposition === SuperscalarDisposition.Fault)
  def wb_vector_config = wb_system_control.action === RiscvCsrAction.VectorConfig
  def wb_system_prefix = !any(for List (lane in 0..issue_width): wb_stop[lane] & (!wb_vector_config ||| (Bits(2)(lane) <= wb_system_lane))) & !(wb_retained_capture & (wb_retained_lane <= wb_system_lane))
  def wb_system = wb_valid[service_index(wb_system_lane)] & wb_system_control.uses_command() & !wb_wait_capture & !wb_fault_pending & !wb_interrupt_stop & wb_system_prefix
  wb_csr_return <== vec(for List (lane in 0..issue_width): wb_system & (wb_system_lane === Bits(2)(lane)) & wb_csrs.writeback_valid)
  // The CSR port commits an older configuration before taking its younger peer's trap.
  // Existing fault retention carries that trap across the single-command boundary.
  def wb_defer_fault = wb_system & wb_vector_config & wb_explicit_fault
  def wb_hold_fault = (wb_explicit_fault ||| wb_interrupt_stop) & (!wb_drained ||| wb_defer_fault)
  def wb_trap_owner :: SuperscalarRetirementCommand(xlen, hypervisor) = mux(wb_interrupt_stop, wb_group[0], wb_selected)
  def wb_trap_owner_pc = mux(wb_interrupt_stop, wb_group_pcs[0], wb_selected_pc)
  def wb_trap_instruction = wb_trap_owner.boundary_instruction(wb_trap_owner_pc)
  def wb_target_instruction :: SuperscalarBoundaryInstruction(xlen) = literal(SuperscalarBoundaryInstruction(xlen), 0)
  wb_fault_retention.update.valid <== wb_reject_target ||| wb_hold_fault
  when (wb_reject_target ||| wb_hold_fault):
    wb_pending_redirect <== wb_reject_target

  wb_fault_retention.update.bits.interrupt <== !wb_reject_target & wb_interrupt_stop
  wb_fault_retention.update.bits.instruction <== mux(
    wb_reject_target,
    wb_target_instruction.updated(~pc: wb_rejected_target, ~next_pc: wb_rejected_target, ~fetch_fault: Bool(#true)),
    wb_trap_instruction.updated(~pc: mux(wb_interrupt_stop, wb_interrupt_pc, wb_trap_instruction.pc))
  )

  wb_fault_retention.update.bits.cause <== wb_trap_owner.resolution.cause
  wb_fault_retention.update.bits.value <== wb_trap_owner.resolution.value
  if profile.hypervisor
  | wb_fault_retention.update.bits.guest <== wb_trap_owner.resolution.guest
  | #void

  wb_fault_retention.egress.ready <== wb_drained & !wb_defer_fault
  def wb_fault_command = wb_drained & !wb_defer_fault & (wb_explicit_fault ||| (wb_fault_pending & !wb_held_trap.interrupt))
  def wb_configuration_before_fault = wb_valid[service_index(wb_system_lane)] & wb_vector_config & !any(for List (lane in 0..issue_width): (Bits(2)(lane) <= wb_system_lane) & wb_service_stop[lane])
  def wb_command :: SuperscalarRetirementCommand(xlen, hypervisor) = mux(any(wb_service_stop) & !wb_configuration_before_fault, wb_service_selected, wb_system_token)
  def wb_command_pc = mux(any(wb_service_stop) & !wb_configuration_before_fault, wb_service_selected_pc, wb_system_token_pc)
  def wb_boundary_instruction = mux(wb_fault_pending, wb_held_trap.instruction, wb_command.boundary_instruction(wb_command_pc))
  def wb_command_exception = mux(wb_fault_pending, !wb_held_trap.interrupt, wb_command.resolution.disposition === SuperscalarDisposition.Fault)
  wb_csrs.commit.valid <== wb_fault_command ||| wb_system
  wb_csrs.commit.bits <== RiscvCsrCommand(xlen):
    pc: wb_boundary_instruction.pc
    instruction: wb_boundary_instruction.raw_instruction
    rd: wb_command.rd
    csr_operation: mux(wb_command_exception, RiscvCsrOperation.None, wb_command.system.csr)
    action: mux(wb_command_exception, RiscvCsrAction.None, wb_command.system.action)
    csr_address: wb_command.fetched.instruction[20..32]
    csr_source: wb_command.operands.left
    vector_config: vector_configuration_request(xlen, wb_command.vector.configure, wb_command.fetched.instruction, wb_command.operands.left, wb_register_vtype)
    exception_valid: wb_command_exception
    exception_cause: mux(wb_redirect_pending, wb_redirect_fault.cause, mux(wb_fault_pending, wb_held_trap.cause, wb_command.resolution.cause))
    exception_value: mux(wb_redirect_pending, wb_redirect_pc, mux(wb_fault_pending, wb_held_trap.value, wb_command.resolution.value))

  when (wb_system & wb_vector_config):
    assert(wb_csrs.command_success, "superscalar_ex_validated_vector_configuration")

  if profile.hypervisor
  | block:
      wb_csrs.guest_fault.valid <== wb_fault_command
      wb_csrs.guest_fault.bits <== mux(wb_redirect_pending, wb_redirect_fault.guest, mux(wb_fault_pending, wb_held_trap.guest, wb_selected.resolution.guest))
  | #void

  /* Architectural redirects and recovery.
     Selects trap, interrupt, wake, and replay targets without canceling
     already accepted services or changing their completion ownership. */

  def wb_interrupt_boundary = wb_drained & (wb_interrupt_stop ||| (wb_fault_pending & wb_held_trap.interrupt))
  wb_csrs.interrupt_boundary <== wb_interrupt_boundary
  wb_csrs.interrupt_pc <== mux(wb_fault_pending, wb_held_trap.instruction.pc, wb_interrupt_pc)
  def wb_replay = (wb_stop_valid & (wb_selected.resolution.disposition === SuperscalarDisposition.Replay)) ||| wb_vector_scalar_replay
  def wb_replay_owner = mux(wb_vector_scalar_replay, wb_vector_replay_owner.retirement(), wb_selected)
  def wb_replay_owner_pc = mux(wb_vector_scalar_replay, wb_vector_replay_owner_pc, wb_selected_pc)
  def wb_wake = wb_sleeping & wb_csrs.wfi_wake
  def wb_system_resume = wb_system & !wb_vector_config & !wb_csr_read & wb_csrs.command_success & !wb_csrs.wfi
  def wb_retained_resume = wb_blocking_retained & wb_retained_complete & (wb_retained_result.resolution.disposition === SuperscalarDisposition.Continue)
  instruction_invalidate.valid <== wb_system_resume & (wb_system_control.fence === SuperscalarFence.Instruction)
  predictor_clear.valid <== translation_flush ||| wb_csrs.trap_event.valid ||| (wb_system & wb_csrs.command_success & wb_system_control.action.is_one_of(RiscvCsrAction.Mret, RiscvCsrAction.Sret))
  def wb_redirect_valid = wb_csrs.redirect.valid ||| wb_replay ||| wb_system_resume ||| wb_interrupt_boundary ||| wb_wake ||| wb_retained_resume
  def wb_redirect_disposition = priority_mux(~default: SuperscalarDisposition.System):
    wb_csrs.trap_event.valid & !wb_interrupt_boundary: SuperscalarDisposition.Fault
    wb_replay: SuperscalarDisposition.Replay

  def wb_redirect_bits = SuperscalarRedirect(xlen):
    pc:
      priority_mux(~default: wb_boundary_instruction.pc):
        wb_interrupt_boundary: wb_csrs.interrupt_pc
        wb_wake: wb_resume_pc
        wb_replay: wb_replay_owner_pc

    target:
      priority_mux(~default: wb_command.fetched.sequential_pc.apply(wb_command_pc)):
        wb_csrs.redirect.valid: wb_csrs.redirect.bits
        wb_interrupt_boundary: wb_csrs.interrupt_pc
        wb_wake: wb_resume_pc
        wb_replay: wb_replay_owner_pc

    resolution:
      SuperscalarResolution(xlen):
        guest: literal(RiscvGuestFault(), 0)
        disposition: wb_redirect_disposition
        cause: wb_csrs.command_fault.cause
        value: wb_csrs.trap_event.value

    interrupt: wb_csrs.trap_event.valid & wb_csrs.trap_event.cause[xlen.width - 1].into(Bool)
    trap_cause: wb_csrs.trap_event.cause

  def wb_redirect = inject_interface(Valid(SuperscalarRedirect(xlen)), ~valid: wb_redirect_valid, ~bits: wb_redirect_bits)
  wb_squash <== wb_stop_valid ||| wb_fault_pending ||| wb_reject_target ||| wb_interrupt_stop ||| (wb_system & ((!wb_vector_config & !wb_csr_read) ||| !wb_csrs.command_success)) ||| wb_sleeping ||| (wb_retained_capture & !wb_vector_capture) ||| wb_blocking_retained ||| wb_vector_scalar_replay
  rr_squash <== wb_squash ||| mem_branch_redirect
  fetch_flush.valid <== rr_squash
  redirect.valid <== (wb_redirect.valid & CompactPc.fits(xlen, wb_redirect.bits.target)) ||| (mem_branch_redirect & CompactPc.fits(xlen, mem_redirect_bits.target))
  redirect.bits <== mux(wb_redirect.valid, wb_redirect.bits, mem_redirect_bits)


  /* Retirement publication and architectural updates.
     Per-lane success controls register writes and predictor observations;
     retirement remains distinct from deferred result completion. */

  wire wb_writes: Vec(issue_width, Bool)
  wire wb_recover_ras: Vec(issue_width, Bool)
  wire wb_train: Vec(issue_width, Bool)
  def wb_retirement_links :: List.of(Handle) = for List (_ in 0..issue_width): interface_link(Valid(SuperscalarRetirement(xlen, hypervisor)))
  // Publish only the successful retirement prefix; architectural writes and
  // predictor updates below all consume these per-lane decisions.
  def wb_retire = for List (lane in 0..issue_width):
    def token :: SuperscalarRetirementCommand(xlen, hypervisor) = wb_tokens[lane]
    def retained = wb_retained_capture & (wb_retained_lane <= Bits(2)(lane))
    def system_success = !(wb_system & (wb_system_lane === Bits(2)(lane))) ||| wb_csrs.command_success
    def prefix_success = !any(for List (older in 0..lane): wb_stop[older]) & (if lane == 0 | Bool(#true) | !wb_system ||| (wb_vector_config & wb_csrs.command_success))
    !retained & wb_retirement_unblocked & wb_valid[lane] & (token.resolution.disposition === SuperscalarDisposition.Continue) & system_success & prefix_success

  /* Target faults follow successful retirement, never replace the jump's link
     write. CSR redirects have priority and are classified in their new context
     on the following cycle. Invalid trap vectors can replace the consumed fault. */

  def wb_bad_branch = for List (lane in 0..issue_width):
    wb_retire[lane] & wb_tokens[lane].branch.taken & !CompactPc.fits(xlen, wb_tokens[lane].address)

  def wb_addresses = vec(for List (lane in 0..issue_width): wb_tokens[lane].address)
  wb_reject_target <== (wb_redirect.valid & !CompactPc.fits(xlen, wb_redirect.bits.target)) ||| (!wb_redirect.valid & any(wb_bad_branch))
  wb_rejected_target <== mux(wb_redirect.valid, wb_redirect.bits.target, priority_mux((for List (lane in 0..issue_width - 1): [wb_bad_branch[lane], wb_addresses[lane]]), ~default: wb_addresses[issue_width - 1]))

  def wb_retirement_paths :: List.of(InterfaceArrayFields) = for List (lane in 0..issue_width):
    def wb :: SuperscalarRetirementCommand(xlen, hypervisor) = wb_tokens[lane]
    def next_pc = wb.next_pc(wb_group_pcs[lane])
    def predicted_pc = mux(wb.fetched.prediction.valid, wb.fetched.prediction.target.expanded(), wb.fetched.sequential_pc.apply(wb_group_pcs[lane]))
    def observed = wb_retirement_links[lane].right |> trace_valid_event("core/s4.wb.slot" ++ to_string(lane), ~fields: result):
      pc: wb_group_pcs[lane]
      instruction(~format: "riscv", ~isa: trace_isa, ~pc: "pc"): wb.fetched.raw()
      deferred: result.deferred
      rd: result.rd
      branch_prediction(~format: "enum"): mux(wb.branch.update.branch, mux(next_pc =/= predicted_pc, SuperscalarBranchPrediction.Mispredicted, SuperscalarBranchPrediction.Correct), SuperscalarBranchPrediction.NotBranch)
      ras_mismatch: wb.branch.update.ras_action =/= wb.branch.update.predicted_ras_action
      direction_valid: result.fetched.direction.valid
      bimodal_taken: result.fetched.direction.base_taken
      gshare_taken: result.fetched.direction.gshare_taken
      direction_taken: result.fetched.direction.taken

    observed |> fork_valid(4)

  for (lane in 0..issue_width):
    def wb :: SuperscalarRetirementCommand(xlen, hypervisor) = wb_tokens[lane]
    def wb_eligible = wb_retire[lane]
    def wb_fp_compute = wb.fp.valid & (wb.fp.bits.execution.unit =/= FloatUnit.Memory)
    def wb_fp_direct = wb_fp_compute & wb_selected_fp.tag.speculative & wb_selected_fp.tag.direct
    def wb_deferred = ((wb_accepted & (wb_memory_lane === Bits(2)(lane))) ||| (wb_long_accepted & (wb_long_lane === Bits(2)(lane))) ||| (wb_fp_compute & !wb_fp_direct) ||| (wb_vector_accepted & (wb_vector_lane === Bits(2)(lane))))
    def wb_lane_system = wb_system & (wb_system_lane === Bits(2)(lane))
    def wb_data = priority_mux(~default: wb.resolution.value):
      wb_lane_system: wb_csrs.writeback_value
      wb_fp_direct & wb.write: fp.completion.bits.value

    def retirement = wb_retirement_links[lane].left
    retirement.valid <== wb_eligible
    when wb_eligible:
      assert(!wb.fetched.fault, "superscalar_fetch_fault_cannot_retire")

    retirement.bits <== SuperscalarRetirement(xlen, hypervisor):
      fetched: wb.retired_instruction(wb_group_pcs[lane])
      rd: wb.rd
      write: wb.write
      data: wb_data
      deferred: wb_deferred

    describe_interface_contract(if lane == 0 | wb_owners.right | (if lane == 1 | wb_second_owner.right | wb_paths[lane][0]), retirement, "retirement-" ++ to_string(lane), ~trace_model: interface_trace_combinational())
    wb_retirement_paths[lane][0] |> retired[lane]
    wb_writes[lane] <== wb_eligible & wb.write & !wb_deferred & (!wb_lane_system ||| wb_csrs.writeback_valid)
    wb_train[lane] <== wb_eligible & wb.branch.update.branch
    wb_recover_ras[lane] <== wb_eligible & wb.branch.mispredicted

  /* Hints and predictor training.
     Hints are best-effort and never stall a lane. Retired branch training
     is buffered, while architectural history and RAS recovery stay immediate. */

  def wb_prefetch_paths = for List (lane in 0..issue_width):
    def token :: SuperscalarRetirementCommand(xlen, hypervisor) = wb_tokens[lane]
    wb_retirement_paths[lane][2] |> filter_valid(_retired => token.prefetch.is_prefetch()) |> map_valid(_retired => CachePrefetchReq(64)):
      address: token.address.zext(64)
      operation: token.prefetch

  (for Array (path in wb_prefetch_paths): path) |> valid_arbiter() |> prefetch
  def wb_training :: Vec(issue_width, SuperscalarBranchTraining(xlen)) = vec(
    for List (lane in 0..issue_width):
      def token = wb_tokens[lane]
      def pc = wb_group_pcs[lane]
      when (wb_train[lane]):
        assert(CompactPc.fits(xlen, pc), "superscalar_training_pc_canonical_" ++ to_string(lane))

      token.branch.update.training(xlen, pc, ~target: token.address,
                                   ~step: token.fetched.sequential_pc, ~checkpoint: token.fetched.direction)
  )

  for (lane in 0..issue_width):
    wb_retirement_paths[lane][3] |> filter_valid(_retired => wb_tokens[lane].branch.update.branch) |> map_valid(_retired => wb_training[lane]) |> branch_training.incoming[lane]

  branch_training.clear.valid <== predictor_clear.valid
  def wb_training_head :: SuperscalarBranchTraining(xlen) = branch_training.training.bits
  branch_update.valid <== branch_training.training.valid
  branch_update.bits <== wb_training_head.branch_update()
  direction_update.valid <== branch_update.valid & wb_training_head.direction_valid
  direction_update.bits <== wb_training_head.direction_update()
  // Architectural history and RAS reconciliation are never delayed behind table writes.
  def wb_ras :: Vec(issue_width, Bool) = vec(for List (lane in 0..issue_width): wb_train[lane] & ((wb_tokens[lane].branch.update.ras_action =/= RasAction.None) ||| (wb_tokens[lane].branch.update.predicted_ras_action =/= RasAction.None)))
  def wb_ras_branch = wb_training[service_index(superscalar_service_lane(for List (lane in 0..issue_width): wb_ras[lane]))].branch_update()
  ras_resolution.valid <== wb_ras.any()
  ras_resolution.bits <== RasResolution(xlen):
    actual:
      RasUpdate(xlen):
        action: wb_ras_branch.ras_action
        return_address: wb_ras_branch.return_address

    predicted_action: wb_ras_branch.predicted_ras_action

  history_commit.valid <== wb_train.any()
  history_commit.bits <== SuperscalarHistoryCommit(issue_width):
    enable: vec(for List (lane in 0..issue_width): wb_train[lane] & wb_training[lane].direction_valid)
    taken: vec(for List (lane in 0..issue_width): wb_tokens[lane].branch.update.taken)

  // A MEM correction keeps its branch. WB rejection is older and instead
  // restores the checkpoint before the oldest instruction being discarded.
  def wb_system_history_restore = wb_system & ((!wb_vector_config & !wb_csr_read) ||| !wb_csrs.command_success)
  history_restore.valid <== mem_branch_redirect ||| wb_stop_valid ||| wb_vector_scalar_replay ||| (wb_retained_capture & !wb_vector_capture) ||| wb_system_history_restore
  history_restore.bits <== priority_mux(~default: superscalar_history_after(mem_branch.fetched.direction.history, mem_branch.fetched.direction.valid, mem_branch.branch.taken)):
    wb_stop_valid: wb_selected.fetched.direction.history
    wb_vector_scalar_replay: wb_vector_replay_owner.fetched.direction.history
    wb_retained_capture & !wb_vector_capture: wb_memory.fetched.direction.history
    wb_system_history_restore: wb_system_token.fetched.direction.history

  predictor_restore.valid <== wb_squash ||| wb_recover_ras.any()
  for (lane in 0..issue_width):
    assert(!(wb_ras[lane] & any(for List (younger in lane + 1..issue_width): wb_ras[younger])), "superscalar_one_ras_resolution_per_group")

  /* Floating-point authorization and load completion.
     Qualifies the successful WB prefix without CSR feedback; accepted loads
     retain FP ownership independently of younger pipeline recovery. */

  // Authorization must not depend on wb_retire or CSR command_success:
  // those outcomes consume the FP authorization/drain decision themselves.
  // EX-validated vset may commit beside FP; other system commands serialize.
  def wb_fp_older_allows = !any(for List (lane in 0..issue_width): (Bits(2)(lane) < wb_fp_lane) & wb_stop[lane])
  def wb_fp_not_displaced = !wb_retained_capture ||| (wb_fp_lane < wb_retained_lane)
  def wb_fp_success = wb_valid[service_index(wb_fp_lane)] & wb_retirement_unblocked & (!wb_system ||| wb_vector_config) & (wb_tokens[service_index(wb_fp_lane)].resolution.disposition === SuperscalarDisposition.Continue) & wb_fp_older_allows & wb_fp_not_displaced
  fp.authorize.valid <== wb_fp_success & wb_fp_token.fp.valid & !wb_fp_token.fp.bits.execution.unit.is_one_of(FloatUnit.Memory, FloatUnit.DivideSquareRoot)
  wb_fp_fixed_authorized <== fp.authorize.valid
  fp.authorize.bits <== wb_selected_fp.authorization(wb_fp_token.fetched.identity(wb_fp_token_pc), wb_fp_token.rd)
  wb_fp_gpr_scoreboard.set.valid <== fp.authorize.valid & !fp.authorize.bits.tag.direct & (fp.authorize.bits.tag.destination === FloatDestination.Integer) & fp.authorize.bits.tag.rd.any()
  wb_fp_gpr_scoreboard.set.bits <== fp.authorize.bits.tag.rd
  fp.load_reserve.valid <== wb_accepted & wb_memory.fp.valid & (wb_memory.fp.bits.registers.destination === FloatDestination.FloatingPoint)
  fp.load_reserve.bits <== wb_fp_request.owner(wb_memory.fetched.identity(wb_memory_pc), wb_memory.rd)
  fp.load_hit.valid <== vec(for List (lane in 0..issue_width): retired[lane].valid)[service_index(wb_fp_lane)] & wb_fp_token.fp.valid & wb_fp_token.memory.enable & (wb_fp_token.memory.access === CacheOperation.Load) & !wb_accepted
  fp.load_hit.bits <== SuperscalarFpLoad(xlen):
    owner: wb_selected_fp.owner(wb_fp_token.fetched.identity(wb_fp_token_pc), wb_fp_token.rd)
    precision: wb_fp_token.fp.bits.execution.destination_precision
    data: wb_fp_token.resolution.value.zext(64)

  when (fp.load_hit.valid):
    assert(fp.load_hit.bits.owner.destination === FloatDestination.FloatingPoint, "superscalar_load_hit_fpr_destination")

  when wb_vector_pending:
    assert(!scalar_memory.request.valid & !scalar_pipeline.commit & !fp.variable_issue.valid & !fp.authorize.valid & !wb_multiply_accepted & !wb_divide_accepted & !vector.request.valid & !wb_csrs.commit.valid, "superscalar_vector_authorization_blocks_younger_effects")
    when (!wb_retained_complete):
      assert(!any(for List (lane in 0..issue_width): retired[lane].valid), "superscalar_vector_authorization_orders_retirement")

  // Accepted services inherit successful WB, never a live lane's later payload.
  def wb_service = interface_link(Valid(SuperscalarRetirement(xlen, hypervisor)))
  def wb_service_lane = mux(wb_accepted, wb_memory_lane, wb_long_lane)
  wb_service.left.valid <== wb_accepted ||| wb_divide_accepted
  wb_service.left.bits <== vec(for List (lane in 0..issue_width): retired[lane].bits)[service_index(wb_service_lane)]
  describe_interface_selection((for List (lane in 0..issue_width): wb_service_lane === Bits(2)(lane)), ~name: "service-lane")
  describe_interface_contract((for Array (lane in 0..issue_width): wb_retirement_paths[lane][1]), wb_service.left, "service-lane", ~trace_model: interface_trace_selection(~name: "service-lane"))
  describe_interface_contract(wb_service.right, Array(wb_load_response.allocate, wb_divide_link.left), "committed-service", ~trace_model: interface_trace_routing([wb_accepted, wb_divide_accepted]))


  /* Architectural GPR write ports.
     Each lane owns its port; fixed FP and deferred completions share the last.
     Only actual successful younger writes suppress an older same-rd write.
     Retirement records remain separate, including fault/replay/deferred cases. */

  def wb_completion_write = wb_gpr_return.valid & wb_gpr_return.bits.write
  def wb_return_address = priority_mux(~default: Bits(5)(0)):
    vector.scalar_result.valid: vector.scalar_result.bits.address
    wb_fp_late_gpr.valid: wb_fp_late_gpr.bits.tag.rd
    wb_completion_write: wb_gpr_return.bits.rd

  def wb_return_data = priority_mux(~default: Bits(xlen.width)(0)):
    vector.scalar_result.valid: vector.scalar_result.bits.data
    wb_fp_late_gpr.valid: wb_fp_late_gpr.bits.value
    wb_completion_write: wb_gpr_return.bits.data

  def wb_last_valid = wb_pipe[return_port].egress.valid
  assert(!(vector.scalar_result.valid & (wb_completion_write ||| wb_last_valid ||| wb_fp_late_gpr.valid)), "superscalar_vector_reserved_last_slot")
  assert(!(wb_fp_late_gpr.valid & (wb_completion_write ||| wb_last_valid)), "superscalar_fixed_fp_reserved_last_slot")
  assert(!(ex_multiply.completed.valid & (wb_completion.valid ||| wb_last_valid)), "superscalar_multiply_reserved_last_slot")
  when (ex_multiply.completed.valid):
    assert(wb_gpr_calendar.occupied[0].into(Bool), "superscalar_multiply_booked_return")

  assert(!(wb_completion_write & wb_last_valid), "superscalar_completion_reserved_last_slot")
  def wb_physical_writes = vec(
    for List (lane in 0..issue_width):
      def suppressed = any(for List (younger in lane + 1..issue_width): (wb_tokens[lane].rd === wb_tokens[younger].rd) & wb_writes[younger])
      wb_writes[lane] & !suppressed
  )
  def wb_write_values = for List (lane in 0..issue_width):
    RegisterFileWrite(xlen):
      address: wb_tokens[lane].rd
      data: retired[lane].bits.data

  def wb_return_value = RegisterFileWrite(xlen):
    address: wb_return_address
    data: wb_return_data

  for (port in 0..issue_width):
    def completion = Bool(port == return_port) & (wb_completion_write ||| wb_fp_late_gpr.valid ||| (vector.scalar_result.valid & vector.scalar_result.bits.address.any()))
    assert(!(wb_physical_writes[port] & completion), "superscalar_write_port_exclusive_" ++ to_string(port))
    rr_registers.writes[port].valid <== wb_physical_writes[port] ||| completion
    rr_registers.writes[port].bits <== mux(completion, wb_return_value, wb_write_values[port])

  def mutable wb_retired_count = Bits(2)(0)
  for (lane in 0..issue_width):
    wb_retired_count := wb_retired_count + retired[lane].valid.as_bits().zext(2)

  retired_count <== wb_retired_count
  wb_csrs.retire_count <== retired_count
  stat_count("retired_slot0", retired[0].valid)
  stat_count("retired_slot1", retired[1].valid)
  if issue_width == 3 | stat_count("retired_slot2", retired[2].valid) | #void

  /* Retired locality, PAUSE, and resume state.
     Only the successful prefix advances hints and the architectural cursor;
     trap/interrupt recovery clears pending locality and takes wake priority. */

  def youngest_retired = priority_mux(
    (for List (offset in 1..issue_width):
       def slot = issue_width - offset
       [retired[slot].valid, Bits(index_width(issue_width))(slot)]),
    ~default: Bits(index_width(issue_width))(0)
  )
  def last_retired :: SuperscalarRetirementCommand(xlen, hypervisor) = wb_tokens[youngest_retired]
  when (wb_csrs.redirect.valid):
    wb_pending_locality <== RiscvMemoryLocality.Default
  elsewhen (retired[0].valid):
    wb_pending_locality <== last_retired.locality_hint

  def wb_pause_commit = any(for List (lane in 0..issue_width): retired[lane].valid & wb_tokens[lane].pause)
  when (rr_squash ||| wb_csrs.interrupt_request):
    rr_pause_cycles <== Bits(5)(0)
  elsewhen wb_pause_commit:
    rr_pause_cycles <== Bits(5)(16)
  elsewhen (rr_pause_cycles.any()):
    rr_pause_cycles <== rr_pause_cycles - Bits(5)(1)

  when (wb_redirect.valid):
    wb_resume_pc <== wb_redirect.bits.target
    wb_pc_known <== Bool(#true)
    wb_sleeping <== Bool(#false)
  elsewhen (retired[0].valid):
    wb_resume_pc <== last_retired.next_pc(wb_group_pcs[youngest_retired])
    wb_pc_known <== Bool(#true)
    wb_sleeping <== wb_csrs.wfi


  /* Passive architectural observations.
     Publishes the declared core contract without adding functional ports,
     retirement state, or simulator-selected policy. */

  describe_cosim_hart("rv2wide", {"profile": profile, "fp_timing": fp_timing}, {
    "wb_tokens": wb_tokens,
    "wb_pcs": wb_group_pcs,
    "wb_retired": vec(for List (lane in 0..issue_width): retired[lane].valid),
    "wb_retirement": vec(for List (lane in 0..issue_width): retired[lane].bits),
    "wb_writes": wb_writes,
    "wb_split_capture": wb_split_capture,
    "wb_vector_capture": wb_vector_capture,
    "wb_vector_lane": wb_vector_lane,
    "wb_memory_lane": wb_memory_lane,
    "wb_multiply_accepted": wb_multiply_accepted,
    "fp_valid": fp.completion.valid,
    "fp_completion": fp.completion.bits,
    "fp_load_valid": fp.load_write.valid,
    "fp_load": fp.load_write.bits,
    "wb_boundary_instruction": wb_boundary_instruction,
    "completion_fire": vec(wb_load_response.completed.fire(), ex_multiply.completed.valid, wb_divide.completed.fire(), completed.valid & !wb_vector_return.valid),
    "completion": vec(wb_load_response.completed.bits, ex_multiply.completed.bits, wb_divide.completed.bits, completed.bits)
  }, (if vector_enabled | {"csr": wb_csrs, "vector": vector, "lsu": memory_ports} | {"csr": wb_csrs}))

export:
  SuperscalarCore
