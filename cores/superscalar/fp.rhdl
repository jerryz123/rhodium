#lang rhodium
/* Owns Superscalar FPR state and scheduled scalar/vector writes without completion storage. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/pc.rhdl").CompactPc
  lib("cores/fp/profile.rhm").fp_transport_profile
  lib("cores/fp/launch-calendar.rhdl") open
  lib("cores/fp/authorization.rhdl").align_fp_authorization
  lib("cores/writeback-calendar.rhdl").WritebackCalendar
  "bundles.rhdl" open
  lib("cores/fp/bundles.rhdl") open
  lib("cores/fp/types.rhdl") open
  lib("cores/fp/timing.rhdl") open
  lib("cores/fp/execute.rhdl") open
  lib("cores/fp/register-file.rhdl") open
  lib("cores/fp/load-store.rhdl") open
  lib("riscv/isa/fp-profile.rhm") open
  lib("riscv/isa/xlen.rhm") open
  lib("flow/main.rhdl") open
  lib("rhodium/std/bits.rhdl").Pow2Int

/* Snapshots operands at RR; fixed returns write only with their aligned WB authorization.
   Accepted variable work and load owners survive all speculative pipeline flushes. */
sync_circuit SuperscalarFp(xlen :: XLen, timing :: FpExecutionTiming, ~half_precision: half_precision :: HalfPrecisionProfile = HalfPrecisionProfile.None, ~zfa: zfa :: Boolean = #false, ~vector_slots: slots :: Pow2Int = 8, ~instruction_pc_width: pc_width :: PosInt = xlen.width):
  def Request = FpExecutionRequest(xlen, fp_transport_profile(xlen), SuperscalarFpOwner(xlen))
  def Result = FpExecutionResult(xlen, fp_transport_profile(xlen), SuperscalarFpOwner(xlen))
  input read_addresses: Vec(3, Bits(5))
  output read_values: Vec(3, Bits(floating_point_register_width(fp_transport_profile(xlen))))
  input probe: FloatingPointControl()
  interface book(Valid(FloatingPointControl()), ~role: consumer)
  output available: Bool
  interface fixed_issue(Valid(Request), ~role: consumer)
  interface variable_issue(Decoupled(Request), ~role: consumer)
  interface authorize(Valid(Request), ~role: consumer)
  interface completion(Valid(Result), ~role: producer)
  interface load_reserve(Valid(SuperscalarFpOwner(xlen)), ~role: consumer)
  interface load_hit(Valid(SuperscalarFpLoad(xlen)), ~role: consumer)
  interface load_return(Decoupled(SuperscalarFpLoad(xlen)), ~role: consumer)
  interface load_write(Valid(SuperscalarFpLoad(xlen)), ~role: producer)
  interface state_update(Valid(Bits(5)), ~role: producer)
  output busy: Mask(32)
  output drained: Bool
  interface vector_request(Decoupled(FpExecutionRequest(xlen, fp_transport_profile(xlen), Bits(index_width(slots)))), ~role: consumer)
  interface vector_result(Decoupled(FpExecutionResult(xlen, fp_transport_profile(xlen), Bits(index_width(slots)))), ~role: producer)
  interface vector_reserve(Valid(Bits(5)), ~role: consumer)
  interface vector_writeback(Decoupled(Bits(4)), ~role: consumer)
  interface vector_write(Valid(FloatingPointRegisterWrite(fp_transport_profile(xlen))), ~role: consumer)
  interface vector_written(Valid(FloatingPointRegisterWrite(fp_transport_profile(xlen))), ~role: producer)


  /* RR return booking and EX launch ownership.
     The booked slot selects execution even when speculative fixed issue is killed. */

  def span = timing.maximum + 1
  def return_width = index_width(span + 1)
  /* Separates speculative scalar authorization from irrevocable vector completion ownership. */
  tagged_union Owner():
    Scalar(SuperscalarCompactFpOwner(xlen, pc_width))
    Vector(Bits(index_width(slots)))

  def SharedRequest = FpExecutionRequest(xlen, fp_transport_profile(xlen), Owner())
  def SharedResult = FpExecutionResult(xlen, fp_transport_profile(xlen), Owner())
  inst launch_calendar(FpLaunchCalendar(timing, span))
  launch_calendar.probe <== probe.execution
  book |> map_valid(control => control.execution) |> launch_calendar.book
  inst execution(FpExecutionService(xlen, fp_transport_profile(xlen), Owner(), ~half_precision: half_precision, ~zfa: zfa, ~scheduled_writeback: #true, ~timing: timing))
  launch_calendar.fixed_available <== execution.fixed_admission_available
  launch_calendar.vector_waiting <== vector_request.valid


  /* Arithmetic FPR writes reserve their physical port before execution.
     Vector moves book at sequencing; scalar fixed work books one cycle before EX.
     Variable returns remain at their producer while an already-promised write drains. */

  inst fpr_calendar(WritebackCalendar(2, span))
  fpr_calendar.pause <== !execution.fixed_admission_available
  // Match the GPR calendar's RR-before-vector claim order across both banks.
  fpr_calendar.query_client[0] <== Bits(1)(0)
  fpr_calendar.query_delay[0] <== timing.latency(probe.execution, ~width: return_width) + Bits(return_width)(1)
  vector_writeback
    |> map_flow(delay => if return_width < 4 | delay[0..return_width] | delay.zext(return_width))
    |> fpr_calendar.reserve[1]
  def scalar_fpr_booking = book |> filter_valid(control => control.registers.destination === FloatDestination.FloatingPoint)
  scalar_fpr_booking
    |> map_valid(control => timing.latency(control.execution, ~width: return_width) + Bits(return_width)(1))
    |> to_decoupled()
    |> fpr_calendar.reserve[0]
  available <== launch_calendar.available & ((probe.registers.destination =/= FloatDestination.FloatingPoint) ||| fpr_calendar.registered_free[0])
  when (scalar_fpr_booking.valid):
    assert(fpr_calendar.reserve[0].ready, "superscalar_fp_booked_fpr_writeback")


  /* Shared launch selection preserves the RR scalar booking.
     An unreserved slot fairly chooses scalar variable or vector work. A killed
     fixed scalar issue does not donate its already booked slot to vector work. */

  def scalar_fixed = fixed_issue |> to_decoupled() |> map_flow(payload):
    def request :: FpExecutionRequest(xlen, fp_transport_profile(xlen), SuperscalarFpOwner(xlen)) = payload
    def owner :: SuperscalarFpOwner(xlen) = request.tag
    request.with_tag(Owner(), Owner().Scalar(owner.compact(pc_width)))

  def scalar_variable = variable_issue |> map_flow(payload):
    def request :: FpExecutionRequest(xlen, fp_transport_profile(xlen), SuperscalarFpOwner(xlen)) = payload
    def owner :: SuperscalarFpOwner(xlen) = request.tag
    request.with_tag(Owner(), Owner().Scalar(owner.compact(pc_width)))

  def vector = vector_request |> map_flow(payload):
    def request :: FpExecutionRequest(xlen, fp_transport_profile(xlen), Bits(index_width(slots))) = payload
    request.with_tag(Owner(), Owner().Vector(request.tag))

  def unreserved = Array(scalar_variable, vector) |> rr_arbiter()
  inst selection(GrantMerge(SharedRequest, 2))
  selection.grants <== vec([launch_calendar.reserved, !launch_calendar.reserved]).into(MaybeOneHot(2))
  Array(scalar_fixed, unreserved) <=> selection.ingress


  /* Atomic launch and fixed return booking.
     Tagged replies write directly on their reserved edge; variable results
     remain backpressurable at the execution lane, without a response queue. */

  def Array(launch, booking) = selection.egress |> atomic_fork(2)
  launch |> execution.request
  booking
    |> filter_flow(request => request.tag.is(Owner().Vector).into(Bool) & (request.control.execution.unit =/= FloatUnit.DivideSquareRoot))
    |> map_flow(request => request.control.execution)
    |> launch_calendar.vector_book
  launch_calendar.vector_accepted <== vector_request.fire()

  def Array(scalar_return, vector_return) = execution.result |> demux_flow(2, result => result.tag.is(Owner().Vector).into(Bool))
  (vector_return |> map_flow(payload):
     def result :: FpExecutionResult(xlen, fp_transport_profile(xlen), Owner()) = payload
     result.with_tag(Bits(index_width(slots)), result.tag.view(Owner().Vector).payload)
  ) |> vector_result
  def scalar_result = scalar_return |> map_flow(payload):
    def result :: FpExecutionResult(xlen, fp_transport_profile(xlen), Owner()) = payload
    def owner :: SuperscalarCompactFpOwner(xlen, pc_width) = result.tag.view(Owner().Scalar).payload
    result.with_tag(SuperscalarFpOwner(xlen), owner.expanded())

  when (fixed_issue.valid):
    assert(launch_calendar.reserved & selection.ingress[0].ready, "superscalar_fp_ex_launch_reserved")
    assert(CompactPc.fits(xlen, pc_width, fixed_issue.bits.tag.identity.pc), "superscalar_fp_fixed_owner_pc_fits")

  when (variable_issue.fire()):
    assert(CompactPc.fits(xlen, pc_width, variable_issue.bits.tag.identity.pc), "superscalar_fp_variable_owner_pc_fits")


  /* WB authorization and scheduled return qualification.
     Variable work is already authorized; fixed work writes only with its aligned WB owner. */

  def wb_owner = fixed_issue |> valid_pipe(2)
  def authorization_matches = wb_owner.valid & (wb_owner.bits.tag.as_bits() === authorize.bits.tag.as_bits())
  when (authorize.valid):
    assert(authorization_matches, "superscalar_fp_wb_owner")

  def authorized = align_fp_authorization(
    authorize, timing,
    fun (operation :: FpExecutionRequest(xlen, fp_transport_profile(xlen), SuperscalarFpOwner(xlen))): operation.control.execution,
    ~elapsed: 2
  )

  def return_matches = scalar_result.valid & (scalar_result.bits.tag.as_bits() === authorized.bits.tag.as_bits())
  when (authorized.valid):
    assert(return_matches, "superscalar_fp_authorized_return")

  def scalar_return_available = scalar_result.bits.tag.speculative ||| (scalar_result.bits.tag.destination =/= FloatDestination.FloatingPoint) ||| !fpr_calendar.occupied[0].into(Bool)
  def completed = scalar_result |> gate_flow(scalar_return_available) |> filter_flow(result => !result.tag.speculative ||| authorized.valid) |> to_valid() |> fork_valid(2)
  completed[0] |> completion


  /* FPR reads and architectural write ports.
     Scalar arithmetic and vector moves share the scheduled port. Immediate
     load hits outrank backpressurable returns on the independent load port. */

  inst registers(FloatingPointRegisterFile(fp_transport_profile(xlen)))
  registers.read_address_1 <== read_addresses[0]
  registers.read_address_2 <== read_addresses[1]
  registers.read_address_3 <== read_addresses[2]
  read_values <== vec(registers.read_data_1, registers.read_data_2, registers.read_data_3)
  def arithmetic_write = completed[1] |> filter_valid(result => result.tag.destination === FloatDestination.FloatingPoint)
  def arithmetic_port = arithmetic_write |> map_valid(result => FloatingPointRegisterWrite(fp_transport_profile(xlen))):
    address: result.tag.rd
    data: result.value

  Array(arithmetic_port, vector_write) |> valid_arbiter() |> registers.writes[1]
  vector_write |> vector_written
  when (vector_write.valid):
    assert(fpr_calendar.occupied[0].into(Bool), "superscalar_vector_fpr_write_is_reserved")
    assert(!arithmetic_write.valid, "superscalar_fpr_reserved_writes_exclusive")


  /* Port zero remains available during a vector move's scheduled write.
     Accepted miss responses wait at their producer only for an immediate hit. */

  def delayed_load = load_return |> gate_flow(!load_hit.valid) |> to_valid()
  def loaded = Array(load_hit, delayed_load) |> valid_arbiter() |> fork_valid(2)
  loaded[0] |> load_write
  def load_port = loaded[1] |> map_valid(result => FloatingPointRegisterWrite(fp_transport_profile(xlen))):
    address: result.owner.rd
    data: fp_load_value(fp_transport_profile(xlen), result.precision, result.data)

  load_port |> registers.writes[0]


  /* Destination reservations and completion forwarding.
     Clears immediately release the busy view. A replacement vector owner
     keeps its new claim when the older owner writes on the allocation edge. */

  reg reservations(~init: Mask(32)(0))
  def admitted = mux(authorize.valid, authorize.bits.tag, variable_issue.bits.tag)
  def arithmetic_set = (authorize.valid ||| variable_issue.fire()) & (admitted.destination === FloatDestination.FloatingPoint)
  def arithmetic_reservation = Mask(32).from_index(admitted.rd, ~valid: arithmetic_set)
  def load_reservation = Mask(32).from_index(load_reserve.bits.rd, ~valid: load_reserve.valid)
  def arithmetic_release = Mask(32).from_index(arithmetic_write.bits.tag.rd, ~valid: arithmetic_write.valid)
  def load_release = Mask(32).from_index(delayed_load.bits.owner.rd, ~valid: delayed_load.valid)
  def vector_reservation = Mask(32).from_index(vector_reserve.bits, ~valid: vector_reserve.valid)
  def vector_release = Mask(32).from_index(vector_written.bits.address, ~valid: vector_written.valid)
  def set_mask = arithmetic_reservation ||| load_reservation
  def clear_mask = arithmetic_release ||| load_release ||| vector_release
  reservations <== ((reservations ||| set_mask) & !clear_mask) ||| vector_reservation
  busy <== reservations & !clear_mask


  /* Accepted-work drain and architectural-state updates.
     Outstanding counts track authorization/load reservation through consumed completion. */

  def count_width = index_width(timing.maximum + 8)
  reg outstanding(~init: Bits(count_width)(0))
  def accepted = authorize.valid.as_bits().zext(count_width) + variable_issue.fire().as_bits().zext(count_width) + load_reserve.valid.as_bits().zext(count_width) + vector_reserve.valid.as_bits().zext(count_width)
  def finished = completion.valid.as_bits().zext(count_width) + delayed_load.valid.as_bits().zext(count_width) + vector_written.valid.as_bits().zext(count_width)
  outstanding <== outstanding + accepted - finished
  drained <== !outstanding.any()
  def flags_update = completion.valid & completion.bits.exception_flags_valid
  state_update.valid <== arithmetic_write.valid ||| load_write.valid ||| flags_update
  state_update.bits <== mux(flags_update, completion.bits.exception_flags, Bits(5)(0))

/* Provides the same pipeline-facing ports without FP state, execution, or accepted work. */
sync_circuit SuperscalarFpDisabled(xlen :: XLen = XLen.X64, ~vector_slots: slots :: Pow2Int = 8):
  def Request = FpExecutionRequest(xlen, fp_transport_profile(xlen), SuperscalarFpOwner(xlen))
  def Result = FpExecutionResult(xlen, fp_transport_profile(xlen), SuperscalarFpOwner(xlen))
  input read_addresses: Vec(3, Bits(5))
  output read_values: Vec(3, Bits(floating_point_register_width(fp_transport_profile(xlen))))
  input probe: FloatingPointControl()
  interface book(Valid(FloatingPointControl()), ~role: consumer)
  output available: Bool
  interface fixed_issue(Valid(Request), ~role: consumer)
  interface variable_issue(Decoupled(Request), ~role: consumer)
  interface authorize(Valid(Request), ~role: consumer)
  interface completion(Valid(Result), ~role: producer)
  interface load_reserve(Valid(SuperscalarFpOwner(xlen)), ~role: consumer)
  interface load_hit(Valid(SuperscalarFpLoad(xlen)), ~role: consumer)
  interface load_return(Decoupled(SuperscalarFpLoad(xlen)), ~role: consumer)
  interface load_write(Valid(SuperscalarFpLoad(xlen)), ~role: producer)
  interface state_update(Valid(Bits(5)), ~role: producer)
  output busy: Mask(32)
  output drained: Bool
  interface vector_request(Decoupled(FpExecutionRequest(xlen, fp_transport_profile(xlen), Bits(index_width(slots)))), ~role: consumer)
  interface vector_result(Decoupled(FpExecutionResult(xlen, fp_transport_profile(xlen), Bits(index_width(slots)))), ~role: producer)
  interface vector_reserve(Valid(Bits(5)), ~role: consumer)
  interface vector_writeback(Decoupled(Bits(4)), ~role: consumer)
  interface vector_write(Valid(FloatingPointRegisterWrite(fp_transport_profile(xlen))), ~role: consumer)
  interface vector_written(Valid(FloatingPointRegisterWrite(fp_transport_profile(xlen))), ~role: producer)

  read_values <== literal(Vec(3, Bits(floating_point_register_width(fp_transport_profile(xlen)))), 0)
  available <== Bool(#false)
  variable_issue.ready <== Bool(#false)
  completion.valid <== Bool(#false)
  completion.bits <== dont_care(Result)
  load_return.ready <== Bool(#false)
  load_write.valid <== Bool(#false)
  load_write.bits <== dont_care(SuperscalarFpLoad(xlen))
  state_update.valid <== Bool(#false)
  state_update.bits <== Bits(5)(0)
  busy <== Mask(32)(0)
  drained <== Bool(#true)
  vector_request.ready <== Bool(#false)
  vector_writeback.ready <== Bool(#false)
  vector_result.valid <== Bool(#false)
  vector_result.bits <== dont_care(vector_result.bits.type)
  vector_written.valid <== Bool(#false)
  vector_written.bits <== dont_care(vector_written.bits.type)

export:
  SuperscalarFp
  SuperscalarFpDisabled
