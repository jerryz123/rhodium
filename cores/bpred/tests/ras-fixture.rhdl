#lang rhodium
/* Exposes shared RAS state and call/return classification in one behavioral fixture. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/bpred/protocol.rhdl") open
  lib("cores/bpred/ras.rhdl") open
  "../../../riscv/isa/xlen.rhm".XLen
  lib("flow/main.rhdl") open

sync_circuit RasFixture():
  input instruction: Bits(32)
  input compressed_instruction: Bits(16)
  interface speculate(Valid(RasUpdate(XLen.X64)), ~role: consumer)
  interface resolve(Valid(RasResolution(XLen.X64)), ~role: consumer)
  interface restore(Pulse(), ~role: consumer)
  interface clear(Pulse(), ~role: consumer)
  output classification: RasAction
  output compressed_classification: RasAction
  output compressed_classification_rv32: RasAction
  output head_valid: Bool
  output head: Bits(64)

  inst ras(Ras(XLen.X64, 3))
  speculate |> ras.speculate
  resolve |> ras.resolve
  restore |> ras.restore
  clear |> ras.clear
  classification <== riscv_ras_action(instruction)
  compressed_classification <== riscv_compressed_ras_action(XLen.X64, compressed_instruction)
  compressed_classification_rv32 <== riscv_compressed_ras_action(XLen.X32, compressed_instruction)
  head_valid <== ras.head_valid
  head <== ras.head

def program = elaborate(RasFixture())

export:
  program
