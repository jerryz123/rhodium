#lang rhombus
/* Defines a compact three-entry, two-page BTB to test entry and shared-page replacement. */
// SPDX-License-Identifier: Apache-2.0
import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../../riscv/isa/xlen.rhm".XLen
  lib("cores/bpred/btb.rhdl").Btb

def program = elaborate(Btb(XLen.X64, 3, 14, 2))
def compact_program = elaborate(Btb(XLen.X64, 3, 14, 2, ~target_width: 45))
def bounded_program = elaborate(Btb(XLen.X64, 3, 14, 2, ~pc_width: 45, ~target_width: 45))
def bounded_source_program = elaborate(Btb(XLen.X64, 3, 14, 2, ~pc_width: 45))
export program compact_program bounded_program bounded_source_program
