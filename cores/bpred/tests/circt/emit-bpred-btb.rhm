#lang rhombus
/* Emits a compact three-entry, two-page BTB to test entry and shared-page replacement. */
// SPDX-License-Identifier: Apache-2.0
import:
  "../../../../rhodium/backend/circt.rhm".emit_circt
  "../../../../rhodium/frontend/kernel.rhm" as embedded
  "../../../../riscv/isa/xlen.rhm".XLen
  lib("cores/bpred/btb.rhdl").Btb
print(emit_circt(embedded.run_elaboration(fun (): Btb(XLen.X64, 3, 14, 2))))
