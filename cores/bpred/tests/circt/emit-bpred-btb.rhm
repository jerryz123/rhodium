#lang rhombus
/* Defines a compact three-entry, two-page BTB to test entry and shared-page replacement. */
// SPDX-License-Identifier: Apache-2.0
import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../../riscv/isa/xlen.rhm".XLen
  lib("cores/bpred/btb.rhdl").Btb
def program = elaborate(Btb(XLen.X64, 3, 14, 2))
export program
