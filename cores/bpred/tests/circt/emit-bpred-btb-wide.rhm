#lang rhombus
// Checks eight-byte BTB selection through a public eight-entry instance.
// SPDX-License-Identifier: Apache-2.0
import:
  lib("rhodium/backend/circt.rhm").emit_circt
  lib("rhodium/frontend/kernel.rhm") as embedded
  lib("riscv/isa/xlen.rhm").XLen
  lib("cores/bpred/btb.rhdl").Btb
print(emit_circt(embedded.run_elaboration(fun (): Btb(XLen.X64, 8, ~fetch_bytes: 8))))
