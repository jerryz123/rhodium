#lang rhodium
/* Defines core-neutral branch prediction, next-PC accuracy, training, and return-stack payloads. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../../riscv/isa/xlen.rhm" open

/* Canonicalizes only a speculative destination before both fetch steering and
   prediction capture. Architectural targets and exception addresses must not use this. */
fun prediction_target(xlen :: XLen, target_width :: PosInt, address :: Bits(xlen.width)) :~ Bits(xlen.width):
  address[0..target_width].sext(xlen.width)

/* Trains a saved direction-table address independently of the caller's current history. */
bundle BhtUpdate(row_bits :: PosInt):
  index: Bits(row_bits + 2)
  taken: Bool

/* Retains an instruction's conditional lookup and pre-instruction recovery checkpoint. */
bundle BhtPrediction(row_bits :: PosInt):
  valid: Bool
  index: Bits(row_bits + 2)
  history: Bits(row_bits)
  taken: Bool

/* Trains both direction components and the chooser from an instruction's saved predictions. */
bundle TournamentUpdate(row_bits :: PosInt):
  index: Bits(row_bits + 2)
  base_index: Bits(row_bits + 2)
  base_taken: Bool
  gshare_taken: Bool
  taken: Bool

/* Retains S1 bimodal and S2 gshare predictions together with the selected recovery checkpoint. */
bundle TournamentPrediction(row_bits :: PosInt):
  valid: Bool
  index: Bits(row_bits + 2)
  history: Bits(row_bits)
  taken: Bool
  base_index: Bits(row_bits + 2)
  base_taken: Bool
  gshare_taken: Bool

/* Classifies effective next-PC accuracy independently of RAS-action repair or recovery qualification. */
hardware_enum BranchPredictionStatus:
  NotBranch
  Correct
  Mispredicted

/* Encodes the x1/x5 implicit call/return hints, including coroutine pop-then-push. */
hardware_enum RasAction:
  None
  Push
  Pop
  PopPush

/* Pairs a speculative or resolved stack action with the return address for a push. */
bundle RasUpdate(xlen :: XLen):
  action: RasAction
  return_address: Bits(xlen.width)

/* Compares the actual stack action with its prediction for speculative-state reconciliation. */
bundle RasResolution(xlen :: XLen):
  actual: RasUpdate(xlen)
  predicted_action: RasAction

/* Names a predicted control-flow instruction and target without expanding
   either address in retained transport records. Full addresses are scalar views. */
bundle BranchPrediction(xlen :: XLen, width :: Int.in(1, xlen.width) = xlen.width):
  valid: Bool
  pc: Bits(width)
  target: Bits(width)
  compressed: Bool
  ras_action: RasAction

  /* Restores the exact admitted source PC using sign wiring only. */
  method address(prediction) :: Bits(xlen.width):
    prediction.pc.sext(xlen.width)

  /* Restores the normalized speculative destination using sign wiring only. */
  method destination(prediction) :: Bits(xlen.width):
    prediction.target.sext(xlen.width)

/* Carries a caller-qualified resolved control-flow outcome for BTB training and RAS recovery. */
bundle BranchUpdate(xlen :: XLen):
  pc: Bits(xlen.width)
  target: Bits(xlen.width)
  branch: Bool
  conditional: Bool
  taken: Bool
  compressed: Bool
  ras_action: RasAction
  predicted_ras_action: RasAction
  return_address: Bits(xlen.width)

export:
  BranchPredictionStatus
  prediction_target
  BhtUpdate
  BhtPrediction
  TournamentUpdate
  TournamentPrediction
  RasAction
  RasUpdate
  RasResolution
  BranchPrediction
  BranchUpdate
