#lang rhombus
// Checks the shared CSR command and state ports under XLEN specialization.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../rhodium/core/main.rhm" open
  "../../../rhodium/frontend/kernel.rhm" as embedded
  "../../../rhodium/frontend/layers/bool.rhm".Bool
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/rtl/pointer-masking.rhdl".PointerMaskControl
  "../csr/file.rhdl" as csr
  "../csr/config.rhm".RiscvCsrConfig
  "csr-profile.rhm".csr_test_isa
  "../../../riscv/isa/c.rhm".CCompressedExtensions

for (compressed in [[], CCompressedExtensions]):
  for (hypervisor in [#false, #true]):
    def config = RiscvCsrConfig(csr_test_isa(XLen.X64), ~compressed: compressed, ~hypervisor: hypervisor)
    def base_mask = if compressed == [] | 0xcb3ff | 0xcb3fe
    check:
      config.medeleg_mask ~is base_mask bits.or (if hypervisor | 0xf00400 | 0)
      config.hedeleg_mask ~is (if hypervisor | base_mask bits.and 0xcb1ff | 0)
      config.warl_policy()["medeleg_mask"] ~is config.medeleg_mask
      config.warl_policy()["hedeleg_mask"] ~is config.hedeleg_mask
      config.warl_policy()["pmm_unsupported_write"] ~is "disabled"

def rv64_design = embedded.run_elaboration(fun (): csr.RiscvCsrFile(RiscvCsrConfig(csr_test_isa(XLen.X64))))
def rv64 = rv64_design.modules[0]
def rv32_design = embedded.run_elaboration(fun (): csr.RiscvCsrFile(RiscvCsrConfig(csr_test_isa(XLen.X32))))
def rv32 = rv32_design.modules[0]
check:
  rv64.inputs.map(fun (port): port.name) ~is [
    "clock", "reset", "interrupts", "hart_id", "time_counter", "interrupt_boundary", "interrupt_pc", "retire_count", "commit_in", "fp_update_in", "vector_retire_in", "vector_saturate_in", "vector_fault_start_in", "vector_truncate_in", "cbo_operation"
  ]
  rv64.outputs.map(fun (port): port.name) ~is [
    "redirect_out", "trap_event", "interrupt_request", "command_success", "wfi", "wfi_wake",
    "writeback_valid", "writeback_value", "privilege", "mstatus", "satp",
    "frm", "fp_enabled", "vector_enabled", "vector_state", "cbo_zero_access", "cbo_permission", "translation_flush", "pbmte",
    "pointer_masking", "pointer_masking_changed"
  ]
  rv64.find_input("interrupts").type.field("machine_timer").type.packed_width() ~is 1
  rv64.find_input("commit_in").type.field("bits").type.field("pc").type.width ~is 64
  rv32.find_input("commit_in").type.field("bits").type.field("pc").type.width ~is 32
  rv64.find_input("vector_fault_start_in").type.field("bits").type.width ~is 64
  rv32.find_input("vector_fault_start_in").type.field("bits").type.width ~is 32
  rv64.find_input("vector_truncate_in").type.field("bits").type.width ~is 64
  rv32.find_input("vector_truncate_in").type.field("bits").type.width ~is 32
  rv64.find_output("writeback_value").type.width ~is 64
  rv32.find_output("satp").type.width ~is 32
  rv64.find_output("pbmte").type.type_equal(Bool) ~is #true
  rv32.find_output("pbmte").type.type_equal(Bool) ~is #true
  rv64.find_output("pointer_masking").type.type_equal(PointerMaskControl()) ~is #true
  rv32.find_output("pointer_masking").type.type_equal(PointerMaskControl()) ~is #true
  rv64.find_output("pointer_masking_changed").type.type_equal(Bool) ~is #true
  rv32.find_output("pointer_masking_changed").type.type_equal(Bool) ~is #true
