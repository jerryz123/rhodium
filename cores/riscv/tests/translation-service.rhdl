#lang rhodium
// Serializes public test commands around the shared combinational TLB and shared host/guest walker.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/riscv/mmu/translation.rhdl") open
  lib("cores/riscv/mmu/tlb.rhdl") open
  lib("cores/riscv/mmu/walker.rhdl") open
  lib("riscv/rtl/sv39.rhdl").PageMemoryType
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

hardware_enum RiscvTranslationTestServiceState:
  Idle
  Lookup
  Issue
  Walk
  Complete

sync_circuit RiscvTranslationTestService(entry_count :: Pow2Int = 8, ~svnapot: svnapot :: Boolean = #false):
  interface request(Decoupled(RiscvTlbLookup()), ~role: consumer)
  interface completion(Irrevocable(RiscvTlbMapping()), ~role: producer)
  interface memory(RiscvTranslationMemory(), ~role: requester)
  input cancel: Bool
  input invalidate_all: Bool
  output probe_hit: Bool
  output probe_fault: Bool
  output probe_pbmt: PageMemoryType

  inst tlb(RiscvTranslationTlb(entry_count))
  inst walker(RiscvTranslationWalker(~svnapot: svnapot))
  walker.memory <=> memory
  reg state(~init: RiscvTranslationTestServiceState.Idle)
  reg operation(RiscvTlbLookup())
  reg result(RiscvTlbMapping())
  def killed = cancel ||| invalidate_all
  walker.cancel <== killed
  tlb.invalidate_all <== invalidate_all
  tlb.lookup <== operation
  tlb.probe <== operation
  probe_hit <== tlb.probe_hit
  probe_fault <== tlb.probe_fault
  probe_pbmt <== tlb.probe_pbmt
  // A canceled walk retains its response owner inside the walker. Do not admit
  // even a cache hit until that owner has drained; there is only one consumer.
  request.ready <== (state === RiscvTranslationTestServiceState.Idle) & walker.request.ready & !killed
  walker.request.valid <== (state === RiscvTranslationTestServiceState.Issue) & !killed
  walker.request.bits <== operation
  (
    walker.completion |> gate_flow((state === RiscvTranslationTestServiceState.Walk) & !killed)
      |> map_flow(completed => RiscvTlbFill()):
           request: operation
           result: completed
  ) |> to_valid() |> tlb.fill
  completion.valid <== (state === RiscvTranslationTestServiceState.Complete) & !killed
  completion.bits <== result

  when killed:
    state <== RiscvTranslationTestServiceState.Idle
  elsewhen (request.fire()):
    operation <== request.bits
    state <== RiscvTranslationTestServiceState.Lookup
  elsewhen ((state === RiscvTranslationTestServiceState.Lookup) & tlb.hit):
    result <== tlb.translation
    state <== RiscvTranslationTestServiceState.Complete
  elsewhen (state === RiscvTranslationTestServiceState.Lookup):
    state <== RiscvTranslationTestServiceState.Issue
  elsewhen (walker.request.fire()):
    state <== RiscvTranslationTestServiceState.Walk
  elsewhen (walker.completion.fire()):
    result <== walker.completion.bits
    state <== RiscvTranslationTestServiceState.Complete
  elsewhen (completion.fire()):
    state <== RiscvTranslationTestServiceState.Idle

export RiscvTranslationTestService
