#lang rhombus
/* Declares remappable passive hart observations without constructing observer hardware. */
// SPDX-License-Identifier: Apache-2.0
import:
  lib("rhodium/core/ir.rhm") open
  lib("rhodium/frontend/kernel.rhm") as kernel
  lib("rhodium/frontend/support/clocking.rhm").ambient_clock
  lib("rhodium/frontend/support/clocking.rhm").ambient_reset_active

export:
  CosimSignals
  CosimSource
  CosimContext
  describe_cosim_signals
  describe_cosim_hart
  describe_cosim_context

/* Holds local read-only taps and detached interpretation parameters for one component. */
class CosimSignals(taps :: Map, parameters :: List, clock :: Value, reset :: Value, components :: Map = {}):
  implements ModuleMetadataPayload
  /* Rebind every live value while retaining only immutable host parameters. */
  override method remap_ir(remap :: Function.of_arity(1)):
    CosimSignals(remap(taps), parameters, remap(clock), remap(reset), remap(components))

/* Names a versioned observation contract with detached configuration and explicit taps.
   Simulation selects its adapter; source metadata never stores executable observer code. */
class CosimSource(contract :: String, configuration :: Map, taps :: Map, components :: Map):
  implements ModuleMetadataPayload
  /* Instance views preserve child selection through occurrence specialization. */
  override method remap_ir(remap :: Function.of_arity(1)):
    CosimSource(contract, configuration, remap(taps), remap(components))

/* Adds sibling-component taps to an explicitly selected child hart at integration.
   No ports exist until the observation pass realizes this relationship. */
class CosimContext(hart :: Instance, components :: Map):
  implements ModuleMetadataPayload
  /* Preserve occurrence identity when a prior pass specializes this integration. */
  override method remap_ir(remap :: Function.of_arity(1)):
    CosimContext(remap(hart), remap(components))

/* Materialize local read-only references, rejecting taps owned by another module. */
fun local_taps(taps :: Map):
  def owner = kernel.active_module()
  for Map (name in taps.keys()):
    def value = kernel.read(taps[name])
    unless value.module_def === owner
    | error(~who: #'describe_cosim_hart, "observation taps must be local values")
    values(name, value)

/* Attach a component's semantic taps without ports, state, or foreign calls. */
fun describe_cosim_signals(taps :: Map, parameters :: List = [], ~components: components :: Map = {}):
  kernel.active_module().add_metadata("riscv.cosim.signals", CosimSignals(local_taps(taps), parameters, ambient_clock(), ambient_reset_active(), components))

/* Declare a versioned contract and immutable host configuration beside read-only hardware taps. */
fun describe_cosim_hart(contract :: String, configuration :: Map, taps :: Map, components :: Map):
  def signals = local_taps(taps ++ {"clock": ambient_clock(), "reset": kernel.cast(ambient_reset_active(), Reset)})
  kernel.active_module().add_metadata("riscv.cosim.hart", CosimSource(contract, configuration, signals, components))

/* Bind sibling components to a local child hart without changing functional interfaces. */
fun describe_cosim_context(hart :: Instance, components :: Map):
  kernel.active_module().add_metadata("riscv.cosim.context", CosimContext(hart, components))
