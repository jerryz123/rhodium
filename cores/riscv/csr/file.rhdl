#lang rhodium
/* Implements reusable RISC-V CSR storage, privilege transitions, traps, and interrupts. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../cosim-source.rhm".describe_cosim_signals
  "config.rhm".RiscvCsrConfig
  "protocol.rhdl" open
  lib("riscv/isa/hart.rhm").RiscvMmuType
  "vector.rhdl" open
  "../../../riscv/rtl/vector.rhdl" open
  "../../../riscv/isa/c.rhm" open
  "../../../riscv/isa/csr.rhm" open
  "../../../riscv/isa/fp-profile.rhm" open
  "../../../riscv/isa/vector-profile.rhm" open
  "../../../riscv/isa/interrupt.rhm" open
  "../../../riscv/isa/sv39.rhm".Sv39Mode
  "../../../riscv/isa/trap.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/model/formats.rhm" as riscv_fields
  "../../../riscv/rtl/csr.rhdl" open
  "../../../riscv/rtl/cmo.rhdl" open
  "../../../riscv/rtl/counters.rhdl" open
  "../../../riscv/rtl/hpm-counter.rhdl" open
  "../../../riscv/rtl/timer.rhdl" open
  "../../../riscv/rtl/state-enable.rhdl" open
  "../../../riscv/rtl/interrupt.rhdl" open
  "../../../riscv/rtl/instruction-fields.rhdl".instruction_field
  "../../../riscv/rtl/trap.rhdl" open
  "../../../riscv/rtl/privilege.rhdl" open
  "../../../riscv/rtl/hypervisor.rhdl" open
  "../../../riscv/rtl/pointer-masking.rhdl" open
  "../../../riscv/rtl/svpbmt.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/ready-valid.rhdl") open

/* Retains machine/supervisor state plus profile-selected timers, state-enable, and guest trap
   banks. */
bundle RiscvCsrState(xlen :: XLen, hypervisor :: Boolean, sstc :: Boolean, smstateen :: Boolean):
  menvcfg: Bits(xlen.width)
  senvcfg: Bits(xlen.width)
  mstatus: Bits(xlen.width)
  medeleg: Bits(xlen.width)
  mideleg: Bits(xlen.width)
  mie: Bits(xlen.width)
  mip: Bits(xlen.width)
  mtvec: Bits(xlen.width)
  mcounteren: Bits(xlen.width)
  mscratch: Bits(xlen.width)
  mepc: Bits(xlen.width)
  mcause: Bits(xlen.width)
  mtval: Bits(xlen.width)
  stvec: Bits(xlen.width)
  scounteren: Bits(xlen.width)
  sscratch: Bits(xlen.width)
  sepc: Bits(xlen.width)
  scause: Bits(xlen.width)
  stval: Bits(xlen.width)
  satp: Bits(xlen.width)
  if sstc:
    stce: Bool
    stimecmp: Bits(64)
  if sstc && hypervisor:
    vstimecmp: Bits(64)
  if smstateen:
    mstateen: Vec(4, Bits(64))
  if smstateen && hypervisor:
    hstateen: Vec(4, Bits(64))
  if hypervisor:
    virtualized: Bool
    hstatus: Bits(64)
    hedeleg: Bits(64)
    hideleg: Bits(64)
    hvip: Bits(64)
    hcounteren: Bits(64)
    henvcfg: Bits(64)
    htimedelta: Bits(64)
    htval: Bits(64)
    htinst: Bits(64)
    mtval2: Bits(64)
    mtinst: Bits(64)
    vsstatus: Bits(64)
    guest_fp_status: Bits(2)
    guest_vector_status: Bits(2)
    vstvec: Bits(64)
    vsscratch: Bits(64)
    vsepc: Bits(64)
    vscause: Bits(64)
    vstval: Bits(64)
    vsatp: Bits(64)
    hgatp: Bits(64)

/* Carries an explicit fflags/frm/fcsr write, independently of execution flag updates. */
bundle RiscvFpCsrWrite():
  address: Bits(12)
  value: Bits(8)

/* Checks committed CSR and privileged operations and resolves explicit or generated synchronous
   traps.
   Captured pipeline exceptions retain priority; guest controls distinguish virtual-instruction
   traps. */
fun resolve_csr_trap(xlen :: XLen,
                     commit_valid :: Bool,
                     operation :: RiscvCsrCommand(xlen),
                     privilege :: PrivilegeMode,
                     mstatus :: Bits(xlen.width),
                     csr_access_legal :: Bool,
                     medeleg :: Bits(xlen.width),
                     ~virtualized: virtualized :: Bool = Bool(#false),
                     ~virtual_csr: virtual_csr :: Bool = Bool(#false),
                     ~vtsr: vtsr :: Bool = Bool(#false),
                     ~vtw: vtw :: Bool = Bool(#false),
                     ~vtvm: vtvm :: Bool = Bool(#false)) :~ RiscvTrapDecision(xlen):
  def width = xlen.width
  def zero = bits(0, width)
  def csr_commit = commit_valid & (operation.csr_operation =/= RiscvCsrOperation.None)
  def illegal_csr = csr_commit & !csr_access_legal
  def supervisor = privilege === PrivilegeMode.Supervisor
  def less_than_machine = privilege =/= PrivilegeMode.Machine
  def illegal_mret = (operation.action === RiscvCsrAction.Mret) & less_than_machine
  def illegal_sret = (operation.action === RiscvCsrAction.Sret) & (
    (privilege === PrivilegeMode.User) ||| (supervisor & !virtualized & csr_flag(mstatus, MstatusTSR))
  )
  def illegal_wfi = (operation.action === RiscvCsrAction.Wfi) & (
    (privilege === PrivilegeMode.User) ||| (supervisor & csr_flag(mstatus, MstatusTW))
  )
  def illegal_sfence_vma = (operation.action === RiscvCsrAction.SfenceVma) & (
    (privilege === PrivilegeMode.User) ||| (supervisor & !virtualized & csr_flag(mstatus, MstatusTVM))
  )
  def hfence = operation.action.is_one_of(RiscvCsrAction.HfenceVvma, RiscvCsrAction.HfenceGvma)
  def illegal_hfence = !virtualized & hfence & ((privilege === PrivilegeMode.User) ||| (supervisor & csr_flag(mstatus, MstatusTVM) & (operation.action === RiscvCsrAction.HfenceGvma)))
  // Svinval ordering-only instructions have no TVM/VTVM restriction.
  def invalidation_order = operation.action === RiscvCsrAction.TranslationOrder
  def illegal_invalidation_order = invalidation_order & !virtualized & (privilege === PrivilegeMode.User)
  def virtual_instruction = virtualized & (
    hfence ||| (invalidation_order & (privilege === PrivilegeMode.User)) ||| (csr_commit & virtual_csr) ||| (
      (operation.action === RiscvCsrAction.Sret) & ((privilege === PrivilegeMode.User) ||| vtsr)
    ) ||| (
      (operation.action === RiscvCsrAction.Wfi) & !csr_flag(mstatus, MstatusTW) & ((privilege === PrivilegeMode.User) ||| vtw)
    ) ||| (
      (operation.action === RiscvCsrAction.SfenceVma) & ((privilege === PrivilegeMode.User) ||| vtvm)
    )
  )
  def illegal_privileged_operation = commit_valid & (
    illegal_mret ||| illegal_sret ||| illegal_wfi ||| illegal_sfence_vma ||| illegal_hfence ||| illegal_invalidation_order
  )
  def explicit_exception = commit_valid & operation.exception_valid
  def ecall = commit_valid & (operation.action === RiscvCsrAction.Ecall)
  def ebreak = commit_valid & (operation.action === RiscvCsrAction.Ebreak)
  def generated_exception = illegal_csr ||| illegal_privileged_operation ||| ecall ||| ebreak ||| (commit_valid & virtual_instruction)
  def ecall_cause = mux_lookup(
    privilege,
    ~default: exception_cause_bits(ExceptionCause.EnvironmentCallFromMachine, width),
    [
      [PrivilegeMode.User, exception_cause_bits(ExceptionCause.EnvironmentCallFromUser, width)],
      [PrivilegeMode.Supervisor, mux(virtualized, exception_cause_bits(ExceptionCause.EnvironmentCallFromVirtualSupervisor, width), exception_cause_bits(ExceptionCause.EnvironmentCallFromSupervisor, width))],
      [PrivilegeMode.Machine, exception_cause_bits(ExceptionCause.EnvironmentCallFromMachine, width)]
    ]
  )
  def generated_cause = mux(
    ecall,
    ecall_cause,
    mux(
      ebreak,
      exception_cause_bits(ExceptionCause.Breakpoint, width),
      mux(virtual_instruction, exception_cause_bits(ExceptionCause.VirtualInstruction, width), exception_cause_bits(ExceptionCause.IllegalInstruction, width))
    )
  )
  def instruction = if width == 32 | operation.instruction | operation.instruction.zext(width)
  resolve_riscv_trap(
    xlen,
    explicit_exception,
    operation.exception_cause,
    operation.exception_value,
    generated_exception,
    generated_cause,
    mux(illegal_csr ||| illegal_privileged_operation ||| virtual_instruction, instruction, zero),
    privilege,
    medeleg
  )

/* Supplies disabled FP status and zero flags/rounding state without architectural FP storage. */
sync_circuit RiscvDisabledFpCsrs():
  interface write(Valid(RiscvFpCsrWrite()), ~role: consumer)
  interface update(Valid(Bits(5)), ~role: consumer)
  interface status_write(Valid(Bits(2)), ~role: consumer)
  output fflags: Bits(5)
  output frm: Bits(3)
  output status: Bits(2)

  fflags <== bits(0, 5)
  frm <== bits(0, 3)
  status <== bits(0, 2)

/* Owns shared fflags, frm, and host FS status; explicit writes override accrued flags and dirty
   updates. */
sync_circuit RiscvFpCsrs():
  interface write(Valid(RiscvFpCsrWrite()), ~role: consumer)
  interface update(Valid(Bits(5)), ~role: consumer)
  interface status_write(Valid(Bits(2)), ~role: consumer)
  output fflags: Bits(5)
  output frm: Bits(3)
  output status: Bits(2)

  reg fflags_state(~init: bits(0, 5))
  reg frm_state(~init: bits(0, 3))
  reg status_state(~init: bits(0, 2))
  def write_fflags = write.valid & (write.bits.address === csr_bits(CsrId.Fflags))
  def write_frm = write.valid & (write.bits.address === csr_bits(CsrId.Frm))
  def write_fcsr = write.valid & (write.bits.address === csr_bits(CsrId.Fcsr))

  when write_fcsr:
    fflags_state <== csr_field(write.bits.value, FcsrFlags)
  elsewhen write_fflags:
    fflags_state <== csr_field(write.bits.value, FcsrFlags)
  elsewhen (update.valid):
    fflags_state <== fflags_state ||| update.bits

  when write_fcsr:
    frm_state <== csr_field(write.bits.value, FcsrRoundingMode)
  elsewhen write_frm:
    frm_state <== write.bits.value[0..FcsrRoundingMode.width]

  when (status_write.valid):
    status_state <== status_write.bits
  elsewhen (write.valid ||| update.valid):
    status_state <== bits(ExtensionStatusDirty, MstatusFS.width)

  fflags <== fflags_state
  frm <== frm_state
  status <== status_state

/* Owns commit-time CSR access, privilege transitions, traps, interrupts, and profile-selected
   state.
   Synchronous traps outrank boundary interrupts; architectural state changes suppress
   illegal writes, and shared FP/vector data retains separate host/guest status ownership. */
sync_circuit RiscvCsrFile(config :: RiscvCsrConfig):
  def hypervisor = config.hypervisor
  def xlen = config.xlen
  def profile = config.floating_point
  def compressed_extensions = config.compressed
  def width = xlen.width
  def compressed_enabled = compressed_extensions_enabled(compressed_extensions)
  def paged_memory = config.mmu_type != RiscvMmuType.Bare
  def zero = bits(0, width)
  def mstatus_writable_fields = [
    MstatusSIE, MstatusMIE, MstatusUPIE, MstatusSPIE, MstatusMPIE,
    MstatusSPP, MstatusMPP, MstatusMPRV, MstatusMXR, MstatusTVM,
    MstatusTW, MstatusTSR
  ] ++ (if paged_memory | [MstatusSUM] | [])
  def sstatus_writable_fields = [MstatusSIE, MstatusUPIE, MstatusSPIE, MstatusSPP, MstatusMXR] ++ (if paged_memory | [MstatusSUM] | [])
  def mstatus_write_mask = bits(csr_fields_mask(mstatus_writable_fields ++ (if hypervisor | [MstatusMPV, MstatusGVA] | [])), width)
  def sstatus_write_mask = bits(csr_fields_mask(sstatus_writable_fields), width)
  def xlen64_encoding = bits(XLen64Encoding, MstatusUXL.width)
  def rv64_uxl = if xlen == XLen.X32 | zero | csr_field_value(MstatusUXL, xlen64_encoding, width)
  def rv64_sxl = if xlen == XLen.X32 | zero | csr_field_value(MstatusSXL, xlen64_encoding, width)
  def mstatus_fixed = rv64_sxl ||| rv64_uxl
  def sstatus_fixed = rv64_uxl
  def medeleg_causes = DelegatableExceptionCauses.filter(
    ~keep: fun (cause): (!compressed_enabled) || (cause != ExceptionCause.InstructionAddressMisaligned)
  )
  def medeleg_mask = bits(exception_mask(medeleg_causes ++ (if hypervisor | HypervisorExceptionCauses | [])), width)
  def sscofpmf = config.sscofpmf
  def lcof_mask = bits(if sscofpmf | interrupt_mask([InterruptCause.LocalCounterOverflow]) | 0, width)
  def hpm_mask = bits(if sscofpmf | 8 | 0, width)
  def mideleg_mask = bits(interrupt_mask(SupervisorInterruptCauses), width) ||| lcof_mask
  def guest_interrupt_mask = bits(interrupt_mask(if hypervisor | VirtualSupervisorInterruptCauses | []), width)
  def guest_software_mask = bits(interrupt_mask([InterruptCause.VirtualSupervisorSoftware]), width)
  def interrupt_enable_mask = bits(interrupt_mask(InterruptCauses), width) ||| guest_interrupt_mask ||| lcof_mask
  def supervisor_interrupt_mask = bits(interrupt_mask(SupervisorInterruptCauses), width) ||| lcof_mask
  def supervisor_software_interrupt_mask = bits(interrupt_mask([InterruptCause.SupervisorSoftware]), width) ||| lcof_mask
  def counter_enable_fields = [CounterenCY, CounterenTM, CounterenIR]
  def counter_enable_mask = bits(csr_fields_mask(counter_enable_fields), width) ||| hpm_mask
  def tvec_alignment = 4
  def epc_alignment = if compressed_enabled | 2 | 4
  def misa_value = bits(config.isa_profile.misa_value, width)

  input interrupts: RiscvInterrupts()
  input hart_id: Bits(width)
  input time_counter: Bits(64)
  input interrupt_boundary: Bool
  input interrupt_pc: Bits(width)
  input retire: Bool
  interface commit(Valid(RiscvCsrCommand(xlen)), ~role: consumer)
  interface fp_update(Valid(Bits(5)), ~role: consumer)
  interface redirect(Valid(Bits(width)), ~role: producer)
  output interrupt_request: Bool
  output command_success: Bool
  output wfi: Bool
  output wfi_wake: Bool
  output writeback_valid: Bool
  output writeback_value: Bits(width)
  output privilege: PrivilegeMode
  output mstatus: Bits(width)
  output satp: Bits(width)
  output frm: Bits(3)
  output fp_enabled: Bool
  output vector_enabled: Bool
  output vector_state: RiscvVectorState(xlen)
  interface vector_retire(Pulse(), ~role: consumer)
  interface vector_saturate(Pulse(), ~role: consumer)
  interface vector_fault_start(Valid(Bits(xlen.width)), ~role: consumer)
  interface vector_truncate(Valid(Bits(xlen.width)), ~role: consumer)
  output cbo_zero_access: CboAccess
  input cbo_operation: CboManagementOperation
  output cbo_permission: CboManagementPermission()
  output translation_flush: Bool
  output pbmte: Bool
  output pointer_masking: PointerMaskControl()
  output pointer_masking_changed: Bool

  reg privilege_state(PrivilegeMode, ~init: PrivilegeMode.Machine)
  def sstc = config.sstc
  def smstateen = config.smstateen
  def State = RiscvCsrState(xlen, hypervisor, sstc, smstateen)
  reg state(State, ~init: literal(State, 0))
  def machine_timer_enabled = if sstc | state.stce | Bool(#false)
  def guest_timer_enabled = if sstc && hypervisor | machine_timer_enabled & csr_flag(state.henvcfg, EnvcfgSTCE) | Bool(#false)
  def machine_timer_field = if xlen == XLen.X64 | csr_field_value(EnvcfgSTCE, machine_timer_enabled.as_bits(), width) | zero
  def virtualized = if hypervisor | state.virtualized | Bool(#false)
  def context = RiscvExecutionContext():
    privilege: privilege_state
    virtualized: virtualized
  def guest_fault_details :: RiscvGuestFault():
    if hypervisor
    | block:
        interface guest_fault(Valid(RiscvGuestFault()), ~role: consumer)
        mux(guest_fault.valid, guest_fault.bits, literal(RiscvGuestFault(), 0))
    | literal(RiscvGuestFault(), 0)
  pbmte <== svpbmt_enabled(xlen, state.menvcfg)
  def guest_envcfg = if hypervisor | state.henvcfg | zero
  cbo_zero_access <== cbo_zero_permission(xlen, privilege_state === PrivilegeMode.User, privilege_state === PrivilegeMode.Supervisor, state.menvcfg, state.senvcfg, ~zicboz: config.zicboz, ~virtualized: virtualized, ~henvcfg: guest_envcfg)
  cbo_permission <== cbo_management_permission(xlen, cbo_operation, privilege_state === PrivilegeMode.User, privilege_state === PrivilegeMode.Supervisor, state.menvcfg, state.senvcfg, ~zicbom: config.zicbom, ~virtualized: virtualized, ~henvcfg: guest_envcfg)
  inst counters(RiscvBaseCounters(xlen))
  inst hpm(RiscvHpmCounter(xlen, ~hypervisor: hypervisor))
  reg hpm_inhibit(~init: Bool(#false))
  reg hpm_pending(~init: Bool(#false))
  def hpm_value :: Bits(64) = if sscofpmf | hpm.counter | bits(0, 64)
  def hpm_selector :: Bits(64) = if sscofpmf | hpm.selector | bits(0, 64)
  def hpm_low = if xlen == XLen.X32 | hpm_value[0..32] | hpm_value
  def hpm_high = if xlen == XLen.X32 | hpm_value[32..64] | zero
  def selector_low = if xlen == XLen.X32 | hpm_selector[0..32] | hpm_selector
  def selector_high = if xlen == XLen.X32 | hpm_selector[32..64] | zero
  def overflow_visible = (privilege_state === PrivilegeMode.Machine) ||| (state.mcounteren[3].into(Bool) & (if hypervisor | !virtualized ||| state.hcounteren[3].into(Bool) | Bool(#true)))
  def FpCsrModule = if floating_point_supports_f(profile) | RiscvFpCsrs() | RiscvDisabledFpCsrs()
  inst fp_csrs(FpCsrModule)
  inst vector_csrs(RiscvVectorCsrs(xlen, config.vector, config.vector_length))
  vector_retire |> vector_csrs.retire
  vector_saturate |> vector_csrs.saturate
  vector_fault_start |> vector_csrs.fault_start
  vector_truncate |> vector_csrs.truncate
  fp_update |> fp_csrs.update

  /* Preserves nonwritable status bits and maps reserved MPP encoding to User. */
  fun legalize_mstatus(value :: Bits(width)) :~ Bits(width):
    def masked = state.mstatus.masked_merge(value, mstatus_write_mask)
    def mpp = csr_field(masked, MstatusMPP)
    csr_field_replace(masked, MstatusMPP, mux(mpp === bits(2, MstatusMPP.width), bits(0, MstatusMPP.width), mpp))

  /* Keeps only the implemented FIOM environment-control field. */
  fun fiom_field(value :: Bits(width)) :~ Bits(width):
    csr_keep_fields(value, [EnvcfgFIOM])

  def fp_status_value = csr_field_value(MstatusFS, fp_csrs.status, width)
  def fp_status_dirty = fp_csrs.status === bits(ExtensionStatusDirty, MstatusFS.width)
  def vector_status_value = csr_field_value(MstatusVS, vector_csrs.status, width)
  def vector_status_dirty = vector_csrs.status === bits(ExtensionStatusDirty, MstatusVS.width)
  def status_dirty_value = mstatus_sd_value(width, fp_status_dirty ||| vector_status_dirty)
  def mstatus_value = state.mstatus ||| mstatus_fixed ||| fp_status_value ||| vector_status_value ||| status_dirty_value
  def sstatus_value = (state.mstatus & sstatus_write_mask) ||| sstatus_fixed ||| fp_status_value ||| vector_status_value ||| status_dirty_value
  // Extension status is independent of trap-stack writes. FPRs and fcsr are
  // shared; only the host and guest dirty/enabled state have separate owners.
  def guest_fp_status = if hypervisor | state.guest_fp_status | bits(0, MstatusFS.width)
  def guest_fp_dirty = guest_fp_status === bits(ExtensionStatusDirty, MstatusFS.width)
  def guest_vector_status = if hypervisor | state.guest_vector_status | bits(0, MstatusVS.width)
  def guest_vector_dirty = guest_vector_status === bits(ExtensionStatusDirty, MstatusVS.width)
  def vsstatus_value = (if hypervisor | state.vsstatus | zero) ||| sstatus_fixed ||| csr_field_value(MstatusFS, guest_fp_status, width) ||| csr_field_value(MstatusVS, guest_vector_status, width) ||| mstatus_sd_value(width, guest_fp_dirty ||| guest_vector_dirty)
  def cycle_value = if xlen == XLen.X32 | counters.cycle[0..32] | counters.cycle
  def cycleh_value = if xlen == XLen.X32 | counters.cycle[32..64] | zero
  def virtual_time = if hypervisor | time_counter + mux(virtualized, state.htimedelta, zero) | time_counter
  def time_value = if xlen == XLen.X32 | time_counter[0..32] | virtual_time
  def timeh_value = if xlen == XLen.X32 | time_counter[32..64] | zero
  def instret_value = if xlen == XLen.X32 | counters.instret[0..32] | counters.instret
  def instreth_value = if xlen == XLen.X32 | counters.instret[32..64] | zero
  def legacy_pending = riscv_interrupt_pending(xlen, interrupts) ||| state.mip ||| mux(hpm_pending, lcof_mask, zero) ||| (if hypervisor | state.hvip | zero)
  def supervisor_timer_mask = bits(interrupt_mask([InterruptCause.SupervisorTimer]), width)
  def virtual_timer_mask = bits(interrupt_mask([InterruptCause.VirtualSupervisorTimer]), width)
  def supervisor_timer_pending = if sstc | sstc_pending(time_counter, bits(0, 64), state.stimecmp) | Bool(#false)
  def guest_timer_pending = if sstc && hypervisor | guest_timer_enabled & sstc_pending(time_counter, state.htimedelta, state.vstimecmp) | Bool(#false)
  def interrupt_pending = (legacy_pending & mux(machine_timer_enabled, !supervisor_timer_mask, !zero)) ||| mux(machine_timer_enabled & supervisor_timer_pending, supervisor_timer_mask, zero) ||| mux(guest_timer_pending, virtual_timer_mask, zero)
  def interrupt_delegation = state.mideleg ||| guest_interrupt_mask
  def supervisor_visible_mask = state.mideleg & supervisor_interrupt_mask
  def csr = commit.bits.csr_address
  def bank_address = if hypervisor | virtual_supervisor_csr(csr, virtualized) | csr
  def bank = csr_bank(bank_address, ~default: zero):
    read CsrId.Fflags: fp_csrs.fflags.zext(width)
    read CsrId.Frm: fp_csrs.frm.zext(width)
    read CsrId.Fcsr: concat(fp_csrs.frm, fp_csrs.fflags).zext(width)
    read CsrId.Vstart: vector_csrs.state.vstart
    read CsrId.Vxrm: vector_csrs.state.vxrm.zext(width)
    read CsrId.Vxsat: vector_csrs.state.vxsat.as_bits().zext(width)
    read CsrId.Vcsr: (vector_csrs.state.vxrm ++ vector_csrs.state.vxsat.as_bits()).zext(width)
    read CsrId.Vl: vector_csrs.state.vl
    read CsrId.Vtype: vector_csrs.state.vtype
    read CsrId.Vlenb: bits(if vector_profile_enabled(config.vector) | config.vector_length / 8 | 0, width)
    csr CsrId.Sstatus:
      read: sstatus_value
      write value:
        state.mstatus <== state.mstatus.masked_merge(value, sstatus_write_mask)
    csr CsrId.Sie:
      read: state.mie & supervisor_visible_mask
      write value:
        state.mie <== state.mie.masked_merge(value, supervisor_visible_mask)
    csr CsrId.Stvec:
      read: state.stvec
      write value:
        state.stvec <== align_down(value, tvec_alignment)
    csr CsrId.Scounteren:
      read: state.scounteren
      write value:
        state.scounteren <== value & counter_enable_mask
    csr CsrId.Senvcfg:
      read: state.senvcfg
      write value:
        state.senvcfg <== fiom_field(value) ||| cmo_envcfg_fields(xlen, value, ~zicbom: config.zicbom, ~zicboz: config.zicboz) ||| pointer_mask_envcfg_fields(xlen, value, ~enabled: config.ssnpm)
    storage CsrId.Sscratch: state.sscratch
    csr CsrId.Sepc:
      read: state.sepc
      write value:
        state.sepc <== align_down(value, epc_alignment)
    storage CsrId.Scause: state.scause
    storage CsrId.Stval: state.stval
    csr CsrId.Sip:
      read: interrupt_pending & supervisor_visible_mask
      write value:
        state.mip <== state.mip.masked_merge(value, state.mideleg & supervisor_software_interrupt_mask & !lcof_mask)
    csr CsrId.Satp:
      read: state.satp
      write value:
        def satp_replacement = value.as_bits()
        def satp_mode = if xlen == XLen.X32 | bits(0, Satp64Mode.width) | csr_field(satp_replacement, Satp64Mode)
        def satp_mode_supported = if xlen == XLen.X32 | Bool(#false) | satp_mode.is_one_of(bits(0, Satp64Mode.width), bits(Sv39Mode, Satp64Mode.width))
        def satp_ppn = if xlen == XLen.X32 | bits(0, Satp64PPN.width) | csr_field(satp_replacement, Satp64PPN)
        def satp_value = if xlen == XLen.X32 | zero | csr_field_value(Satp64Mode, satp_mode, width) ||| csr_field_value(Satp64PPN, satp_ppn, width)
        when satp_mode_supported:
          state.satp <== satp_value
    read CsrId.Cycle: cycle_value
    read CsrId.Time: time_value
    read CsrId.Instret: instret_value
    read CsrId.Cycleh: cycleh_value
    read CsrId.Timeh: timeh_value
    read CsrId.Instreth: instreth_value
    // Slot 3 is the optional PMU; the remaining Zihpm slots stay hardwired zero.
    read CsrId.Hpmcounter3: hpm_low
    read CsrId.Hpmcounter3h: hpm_high
    read CsrId.Mhpmcounter3: hpm_low
    read CsrId.Mhpmcounter3h: hpm_high
    read CsrId.Mhpmevent3: selector_low
    read CsrId.Mhpmevent3h: selector_high
    read_all HpmCounterIds.drop(1): zero
    read_all HpmCounterHighIds.drop(1): zero
    read_all MachineHpmCounterIds.drop(1): zero
    read_all MachineHpmCounterHighIds.drop(1): zero
    read_all MachineHpmEventIds.drop(1): zero
    read_all MachineHpmEventHighIds.drop(1): zero
    read CsrId.Scountovf: mux(overflow_visible & hpm_selector[63].into(Bool), hpm_mask, zero)
    csr CsrId.Mcountinhibit:
      read: mux(hpm_inhibit, hpm_mask, zero)
      write value:
        hpm_inhibit <== value.as_bits()[3].into(Bool)
    csr CsrId.Mstatus:
      read: mstatus_value
      write value:
        state.mstatus <== legalize_mstatus(value)
    read CsrId.Misa: misa_value
    csr CsrId.Medeleg:
      read: state.medeleg
      write value:
        state.medeleg <== value & medeleg_mask
    csr CsrId.Mideleg:
      read: interrupt_delegation
      write value:
        state.mideleg <== value & mideleg_mask
    csr CsrId.Mie:
      read: state.mie
      write value:
        state.mie <== value & interrupt_enable_mask
    csr CsrId.Mtvec:
      read: state.mtvec
      write value:
        state.mtvec <== align_down(value, tvec_alignment)
    csr CsrId.Mcounteren:
      read: state.mcounteren
      write value:
        state.mcounteren <== value & counter_enable_mask
    csr CsrId.Menvcfg:
      read: state.menvcfg ||| machine_timer_field
      write value:
        state.menvcfg <== fiom_field(value) ||| cmo_envcfg_fields(xlen, value, ~zicbom: config.zicbom, ~zicboz: config.zicboz) ||| svpbmt_envcfg_fields(xlen, value, ~enabled: config.svpbmt)
        if sstc && xlen == XLen.X64
        | state.stce <== csr_flag(value, EnvcfgSTCE)
        | #void
    storage CsrId.Mscratch: state.mscratch
    csr CsrId.Mepc:
      read: state.mepc
      write value:
        state.mepc <== align_down(value, epc_alignment)
    storage CsrId.Mcause: state.mcause
    storage CsrId.Mtval: state.mtval
    csr CsrId.Mip:
      read: interrupt_pending
      write value:
        state.mip <== state.mip.masked_merge(value, supervisor_interrupt_mask & !lcof_mask & mux(machine_timer_enabled, !supervisor_timer_mask, !zero))
        if hypervisor
        | state.hvip <== state.hvip.masked_merge(value, guest_software_mask)
        | #void
    read CsrId.Mcycle: cycle_value
    read CsrId.Minstret: instret_value
    read CsrId.Mcycleh: cycleh_value
    read CsrId.Minstreth: instreth_value
    read CsrId.Mvendorid: zero
    read CsrId.Marchid: zero
    read CsrId.Mimpid: zero
    read CsrId.Mhartid: hart_id
    read CsrId.Mconfigptr: zero
    // RV32 status high fields are fixed zero without hypervisor or big-endian support.
    read CsrId.Mstatush: zero
    // All implemented delegation causes are below 32; the RV32 upper half
    // is accessible, reads zero, and ignores writes without changing medeleg.
    read CsrId.Medelegh: zero
    csr CsrId.Menvcfgh:
      read: csr_field_value(EnvcfghSTCE, machine_timer_enabled.as_bits(), width)
      write value:
        if sstc && xlen == XLen.X32
        | state.stce <== csr_flag(value, EnvcfghSTCE)
        | #void
  def hypervisor_bank :: CsrBank:
    if hypervisor
    | csr_bank(bank_address, ~default: zero):
        csr CsrId.Hstatus:
          read: state.hstatus ||| csr_field_value(HstatusVSXL, xlen64_encoding, width)
          write value:
            state.hstatus <== csr_keep_fields(value, [HstatusGVA, HstatusSPV, HstatusSPVP, HstatusHU, HstatusVTVM, HstatusVTW, HstatusVTSR]) ||| pointer_mask_hstatus_fields(value, ~enabled: config.ssnpm)
        csr CsrId.Hedeleg:
          read: state.hedeleg
          write value:
            def guest_causes = medeleg_causes.filter(~keep: fun (cause): cause != ExceptionCause.EnvironmentCallFromSupervisor)
            state.hedeleg <== value & bits(exception_mask(guest_causes), width)
        csr CsrId.Hcounteren:
          read: state.hcounteren
          write value:
            state.hcounteren <== value & counter_enable_mask
        csr CsrId.Henvcfg:
          read: state.henvcfg & mux(pbmte, !zero, !bits(MenvcfgPBMTE.mask(), width)) & mux(machine_timer_enabled, !zero, !bits(EnvcfgSTCE.mask(), width))
          write value:
            state.henvcfg <== fiom_field(value) ||| cmo_envcfg_fields(xlen, value, ~zicbom: config.zicbom, ~zicboz: config.zicboz) ||| svpbmt_envcfg_fields(xlen, value, ~enabled: config.svpbmt) ||| pointer_mask_envcfg_fields(xlen, value, ~enabled: config.ssnpm) ||| (if sstc | mux(machine_timer_enabled, csr_keep_fields(value, [EnvcfgSTCE]), bits(0, 64)) | bits(0, 64))
        csr CsrId.Hideleg:
          read: state.hideleg
          write value:
            state.hideleg <== value & guest_interrupt_mask
        csr CsrId.Hvip:
          read: state.hvip
          write value:
            state.hvip <== value & guest_interrupt_mask
        csr CsrId.Hip:
          read: interrupt_pending & guest_interrupt_mask
          write value:
            state.hvip <== state.hvip.masked_merge(value, guest_software_mask)
        csr CsrId.Hie:
          read: state.mie & guest_interrupt_mask
          write value:
            state.mie <== state.mie.masked_merge(value, guest_interrupt_mask)
        csr CsrId.Vsip:
          read: (interrupt_pending & state.hideleg) >> 1
          write value:
            state.hvip <== state.hvip.masked_merge(value << 1, state.hideleg & guest_software_mask)
        csr CsrId.Vsie:
          read: (state.mie & state.hideleg) >> 1
          write value:
            state.mie <== state.mie.masked_merge(value << 1, state.hideleg)
        // No direct-assigned guest interrupt files: GEILEN=0, VGEIN=0.
        read CsrId.Hgeip: zero
        read CsrId.Hgeie: zero
        storage CsrId.Htimedelta: state.htimedelta
        storage CsrId.Htval: state.htval
        storage CsrId.Htinst: state.htinst
        storage CsrId.Mtval2: state.mtval2
        storage CsrId.Mtinst: state.mtinst
        csr CsrId.Vsstatus:
          read: vsstatus_value
          write value:
            state.vsstatus <== value & sstatus_write_mask
        csr CsrId.Vstvec:
          read: state.vstvec
          write value:
            state.vstvec <== align_down(value, tvec_alignment)
        storage CsrId.Vsscratch: state.vsscratch
        csr CsrId.Vsepc:
          read: state.vsepc
          write value:
            state.vsepc <== align_down(value, epc_alignment)
        storage CsrId.Vscause: state.vscause
        storage CsrId.Vstval: state.vstval
        csr CsrId.Vsatp:
          read: state.vsatp
          write value:
            def mode = csr_field(value, Satp64Mode)
            when (mode.is_one_of(bits(0, 4), bits(Sv39Mode, 4))):
              state.vsatp <== csr_keep_fields(value, [Satp64Mode, Satp64PPN])
        csr CsrId.Hgatp:
          read: state.hgatp
          write value:
            def mode = csr_field(value, Hgatp64Mode)
            when (mode.is_one_of(bits(0, 4), bits(Sv39Mode, 4))):
              // Sv39x4 has a four-page root; ASID/VMID are intentionally zero.
              state.hgatp <== csr_keep_fields(value, [Hgatp64Mode, Hgatp64PPN]) & !bits(3, 64)
    | bank
  def timer_bank :: CsrBank:
    cond
    | sstc && xlen == XLen.X32:
        csr_bank(bank_address, ~default: zero):
          csr CsrId.Stimecmp:
            read: state.stimecmp[0..32]
            write value:
              state.stimecmp <== state.stimecmp[32..64] ++ value
          csr CsrId.Stimecmph:
            read: state.stimecmp[32..64]
            write value:
              state.stimecmp <== value ++ state.stimecmp[0..32]
    | sstc && hypervisor:
        csr_bank(bank_address, ~default: zero):
          storage CsrId.Stimecmp: state.stimecmp
          storage CsrId.Vstimecmp: state.vstimecmp
    | sstc:
        csr_bank(bank_address, ~default: zero):
          storage CsrId.Stimecmp: state.stimecmp
    | ~else: bank
  // Only SE and ENVCFG describe implemented state. SSTATEEN has no writable
  // bits; its shared, software-switched view is therefore constant zero.
  def stateen_banks :: List.of(CsrBank):
    for List (index in 0..(if smstateen | 4 | 0)):
      def fields = [StateenSE] ++ (if index == 0 | [StateenENVCFG] | [])
      cond
      | xlen == XLen.X32:
          csr_bank(csr, ~default: zero):
            read MachineStateEnableIds[index]: zero
            csr MachineStateEnableHighIds[index]:
              read: state.mstateen[index][32..64]
              write value:
                state.mstateen[index] <== csr_keep_fields(value ++ bits(0, 32), fields)
            read SupervisorStateEnableIds[index]: zero
      | hypervisor:
          csr_bank(csr, ~default: zero):
            csr MachineStateEnableIds[index]:
              read: state.mstateen[index]
              write value:
                state.mstateen[index] <== csr_keep_fields(value, fields)
            csr HypervisorStateEnableIds[index]:
              read: state.hstateen[index] & state.mstateen[index]
              write value:
                state.hstateen[index] <== state.hstateen[index].masked_merge(csr_keep_fields(value, fields), state.mstateen[index])
            read SupervisorStateEnableIds[index]: zero
      | ~else:
          csr_bank(csr, ~default: zero):
            csr MachineStateEnableIds[index]:
              read: state.mstateen[index]
              write value:
                state.mstateen[index] <== csr_keep_fields(value, fields)
            read SupervisorStateEnableIds[index]: zero
  def mutable stateen_selected = Bool(#false)
  def mutable stateen_read_value = zero
  for (entry :: CsrBank in stateen_banks):
    stateen_selected := stateen_selected ||| entry.recognized
    stateen_read_value := stateen_read_value ||| entry.read_value
  def stateen_access :: RiscvStateEnableAccess():
    if smstateen
    | state_enable_access(context, csr, state.mstateen, if hypervisor | state.hstateen | literal(Vec(4, Bits(64)), 0))
    | literal(RiscvStateEnableAccess(), 0)
  def timer_selected = Bool(sstc) & timer_bank.recognized
  def hypervisor_selected = Bool(hypervisor) & hypervisor_bank.recognized
  def rv32_counter_halves = if xlen == XLen.X32 | Bool(#true) | Bool(#false)
  def high_counter_ids = [CsrId.Cycleh, CsrId.Timeh, CsrId.Instreth, CsrId.Mcycleh, CsrId.Minstreth] ++ HpmCounterHighIds ++ MachineHpmCounterHighIds ++ MachineHpmEventHighIds
  def high_counter_unavailable = !rv32_counter_halves & csr.is_one_of(high_counter_ids.map(csr_bits))
  def fp_csr = csr.is_one_of(csr_bits(CsrId.Fflags), csr_bits(CsrId.Frm), csr_bits(CsrId.Fcsr))
  def fp_access_enabled = Bool(floating_point_supports_f(profile)) & fp_csrs.status.or_reduce() & (!virtualized ||| guest_fp_status.or_reduce())
  assert(!fp_update.valid ||| fp_access_enabled, "riscv_fp_update_enabled")
  def high_machine_csr_unavailable = !rv32_counter_halves & csr.is_one_of(csr_bits(CsrId.Mstatush), csr_bits(CsrId.Medelegh), csr_bits(CsrId.Menvcfgh))
  def vector_csr = csr.is_one_of([CsrId.Vstart, CsrId.Vxrm, CsrId.Vxsat, CsrId.Vcsr, CsrId.Vl, CsrId.Vtype, CsrId.Vlenb].map(csr_bits))
  def vector_access_enabled = vector_csrs.status.or_reduce() & (!virtualized ||| guest_vector_status.or_reduce())
  def hpm_extension_unavailable = Bool(!sscofpmf) & csr.is_one_of(([CsrId.Scountovf, CsrId.Mcountinhibit] ++ MachineHpmEventHighIds).map(csr_bits))
  def csr_recognized = (bank.recognized ||| hypervisor_selected ||| timer_selected ||| stateen_selected) & !hpm_extension_unavailable & !high_counter_unavailable & !high_machine_csr_unavailable & (!fp_csr ||| fp_access_enabled) & (!vector_csr ||| vector_access_enabled)
  def csr_read_value = mux(stateen_selected, stateen_read_value, mux(timer_selected, timer_bank.read_value, mux(hypervisor_selected, hypervisor_bank.read_value, bank.read_value)))
  def csr_source_specifier = instruction_field(riscv_fields.rs1, commit.bits.instruction)
  def write_requested = riscv_csr_write_requested(commit.bits.csr_operation, csr_source_specifier)
  def csr_read_only = csr_field(csr, CsrAddressReadOnly) === bits(3, CsrAddressReadOnly.width)
  def required_privilege = csr_field(csr, CsrAddressPrivilege)
  def privilege_bits = privilege_state.into(Bits(2))
  def cycle_csr = csr.is_one_of(csr_bits(CsrId.Cycle), csr_bits(CsrId.Cycleh))
  def time_csr = csr.is_one_of(csr_bits(CsrId.Time), csr_bits(CsrId.Timeh))
  def instret_csr = csr.is_one_of(csr_bits(CsrId.Instret), csr_bits(CsrId.Instreth))
  def hpm_csr = csr.is_one_of((HpmCounterIds ++ HpmCounterHighIds).map(csr_bits))
  def counter_csr = cycle_csr ||| time_csr ||| instret_csr ||| hpm_csr
  def satp_restricted = (csr === csr_bits(CsrId.Satp)) & (
    privilege_state === PrivilegeMode.Supervisor
  ) & !virtualized & csr_flag(state.mstatus, MstatusTVM)
  def hgatp_restricted = Bool(hypervisor) & (csr === csr_bits(CsrId.Hgatp)) & (privilege_state === PrivilegeMode.Supervisor) & !virtualized & csr_flag(state.mstatus, MstatusTVM)
  def hpm3_csr = csr.is_one_of(csr_bits(CsrId.Hpmcounter3), csr_bits(CsrId.Hpmcounter3h))
  /* Checks the enable bit for the selected base counter or implemented HPM slot three. */
  fun counter_enabled(counteren :: Bits(width)) :~ Bool:
    mux(hpm_csr, hpm3_csr & counteren[3].into(Bool), mux(cycle_csr, csr_flag(counteren, CounterenCY), mux(time_csr, csr_flag(counteren, CounterenTM), csr_flag(counteren, CounterenIR))))
  def machine_counter_enabled = counter_enabled(state.mcounteren)
  def supervisor_counter_enabled = counter_enabled(state.scounteren)
  def counter_access_enabled = mux_lookup(
    privilege_state,
    ~default: machine_counter_enabled & supervisor_counter_enabled,
    [
      [PrivilegeMode.Machine, Bool(#true)],
      [PrivilegeMode.Supervisor, machine_counter_enabled]
    ]
  )
  def hypervisor_counter_enabled = if hypervisor | counter_enabled(state.hcounteren) | Bool(#true)
  def guest_counter_restricted = virtualized & counter_csr & machine_counter_enabled & (!hypervisor_counter_enabled ||| ((privilege_state === PrivilegeMode.User) & !supervisor_counter_enabled))
  def virtual_satp_restricted = if hypervisor | virtualized & (privilege_state === PrivilegeMode.Supervisor) & (csr === csr_bits(CsrId.Satp)) & csr_flag(state.hstatus, HstatusVTVM) | Bool(#false)
  def hypervisor_privilege = required_privilege === bits(2, 2)
  def timer_access = sstc_access(context, machine_timer_enabled, csr_flag(state.mcounteren, CounterenTM), guest_timer_enabled, if hypervisor | csr_flag(state.hcounteren, CounterenTM) | Bool(#false))
  def timer_illegal = timer_selected & timer_access.illegal
  def virtual_csr = virtualized & csr_recognized & !timer_illegal & !stateen_access.illegal & !(write_requested & csr_read_only) & (
    hypervisor_privilege ||| ((required_privilege === bits(1, 2)) & (privilege_state === PrivilegeMode.User)) ||| guest_counter_restricted ||| virtual_satp_restricted ||| (timer_selected & timer_access.virtual_instruction) ||| stateen_access.virtual_instruction
  )
  def privilege_sufficient = !(privilege_bits < required_privilege) ||| (Bool(hypervisor) & !virtualized & (privilege_state === PrivilegeMode.Supervisor) & hypervisor_privilege)
  def csr_access_legal = csr_recognized & privilege_sufficient & !(write_requested & csr_read_only) & !satp_restricted & !hgatp_restricted & !timer_illegal & !stateen_access.illegal & !virtual_csr & (!counter_csr ||| (counter_access_enabled & (!virtualized ||| hypervisor_counter_enabled)))
  def csr_commit = commit.valid & (commit.bits.csr_operation =/= RiscvCsrOperation.None)
  def vector_config_commit = commit.valid & (commit.bits.action === RiscvCsrAction.VectorConfig)
  def illegal_vector_config = vector_config_commit & (!vector_access_enabled ||| vector_csrs.configuration_illegal)
  def checked_commit = commit.bits.updated(
    ~exception_valid: commit.bits.exception_valid ||| illegal_vector_config,
    ~exception_cause: mux(commit.bits.exception_valid, commit.bits.exception_cause, exception_cause_bits(ExceptionCause.IllegalInstruction, width)),
    ~exception_value: mux(commit.bits.exception_valid, commit.bits.exception_value, if width == 32 | commit.bits.instruction | commit.bits.instruction.zext(width))
  )
  def synchronous_trap = resolve_csr_trap(
    xlen, commit.valid, checked_commit, privilege_state, state.mstatus, csr_access_legal, state.medeleg,
    ~virtualized: virtualized, ~virtual_csr: virtual_csr,
    ~vtsr: (if hypervisor | csr_flag(state.hstatus, HstatusVTSR) | Bool(#false)),
    ~vtw: (if hypervisor | csr_flag(state.hstatus, HstatusVTW) | Bool(#false)),
    ~vtvm: (if hypervisor | csr_flag(state.hstatus, HstatusVTVM) | Bool(#false))
  )
  def interrupt :: RiscvInterruptDecision(xlen):
    if hypervisor
    | resolve_riscv_hypervisor_interrupt(interrupt_pending, state.mie, interrupt_delegation, state.hideleg, state.mstatus, state.vsstatus, context)
    | resolve_riscv_interrupt(xlen, interrupt_pending, state.mie, state.mideleg, state.mstatus, privilege_state)
  def interrupt_take = interrupt_boundary & !synchronous_trap.valid & interrupt.valid
  def synchronous_target :: RiscvTrapTarget:
    if hypervisor
    | hypervisor_trap_target(context, synchronous_trap.cause, state.medeleg, state.hedeleg)
    | synchronous_trap.target
  def trap = RiscvTrapDecision(xlen):
    valid: synchronous_trap.valid ||| interrupt_take
    cause: mux(synchronous_trap.valid, synchronous_trap.cause, interrupt.cause)
    value: mux(synchronous_trap.valid, synchronous_trap.value, zero)
    target: mux(synchronous_trap.valid, synchronous_target, interrupt.target)
  def trap_pc = mux(interrupt_take, interrupt_pc, commit.bits.pc)
  def trap_to_guest = trap.target === RiscvTrapTarget.VirtualSupervisor
  def trap_to_supervisor = trap.target === RiscvTrapTarget.Supervisor

  def csr_replacement :: Bits(width) = mux_lookup(
    commit.bits.csr_operation,
    ~default: csr_read_value,
    [
      [RiscvCsrOperation.Write, commit.bits.csr_source],
      [RiscvCsrOperation.Set, csr_read_value ||| commit.bits.csr_source],
      [RiscvCsrOperation.Clear, csr_read_value & !commit.bits.csr_source]
    ]
  )
  def csr_write = csr_commit & csr_access_legal & write_requested & !trap.valid
  vector_csrs.configure.valid <== vector_config_commit & !trap.valid
  vector_csrs.candidate <== commit.bits.vector_config
  vector_csrs.write.valid <== csr_write & vector_csr & !trap.valid
  vector_csrs.write.bits <== RiscvVectorCsrWrite(xlen):
    address: csr
    value: csr_replacement
  vector_csrs.status_write.valid <== csr_write & bank_address.is_one_of(csr_bits(CsrId.Mstatus), csr_bits(CsrId.Sstatus))
  vector_csrs.status_write.bits <== csr_field(csr_replacement, MstatusVS)
  def user_mask_changed = (csr === csr_bits(CsrId.Senvcfg)) & (pointer_mask_mode(xlen, csr_replacement) =/= pointer_mask_mode(xlen, state.senvcfg))
  def guest_mask_changed:
    if hypervisor
    | block:
        /* Derives pointer masking for normal or explicit guest data access from the live
           execution context. */
        fun masking(access :: RiscvGuestMemoryAccess) :~ PointerMaskControl():
          hypervisor_pointer_mask_control(context, mstatus_value, state.satp, state.senvcfg, state.hstatus, state.vsstatus, state.vsatp, state.henvcfg, access, ~enabled: config.ssnpm)
        pointer_masking <== masking(RiscvGuestMemoryAccess.Normal)
        output guest_pointer_masking: PointerMaskControl()
        guest_pointer_masking <== masking(RiscvGuestMemoryAccess.Guest)
        ((csr === csr_bits(CsrId.Henvcfg)) & (pointer_mask_mode(xlen, csr_replacement) =/= pointer_mask_mode(xlen, state.henvcfg))) ||| ((csr === csr_bits(CsrId.Hstatus)) & (pointer_mask_hstatus_fields(csr_replacement, ~enabled: #true) =/= pointer_mask_hstatus_fields(state.hstatus, ~enabled: #true)))
    | block:
        pointer_masking <== user_pointer_mask_control(xlen, privilege_state, mstatus_value, state.satp, state.senvcfg, ~enabled: config.ssnpm)
        Bool(#false)
  pointer_masking_changed <== Bool(config.ssnpm) & csr_write & (user_mask_changed ||| guest_mask_changed)
  def fp_csr_write = csr_write & fp_csr
  fp_csrs.write.valid <== fp_csr_write
  fp_csrs.write.bits <== RiscvFpCsrWrite():
    address: csr
    value: csr_replacement[0..8]
  fp_csrs.status_write.valid <== csr_write & bank_address.is_one_of(csr_bits(CsrId.Mstatus), csr_bits(CsrId.Sstatus))
  fp_csrs.status_write.bits <== csr_field(csr_replacement, MstatusFS)
  def sfence_vma_commit = commit.valid & commit.bits.action.is_one_of(RiscvCsrAction.SfenceVma, RiscvCsrAction.HfenceVvma, RiscvCsrAction.HfenceGvma)
  def pbmte_changed = Bool(config.svpbmt) & csr_write & !trap.valid & (csr === csr_bits(CsrId.Menvcfg)) & (svpbmt_enabled(xlen, csr_replacement) =/= pbmte)
  def guest_pbmte_changed = if hypervisor | Bool(config.svpbmt) & csr_write & !trap.valid & (csr === csr_bits(CsrId.Henvcfg)) & pbmte & (svpbmt_enabled(xlen, csr_replacement) =/= svpbmt_enabled(xlen, state.henvcfg)) | Bool(#false)
  translation_flush <== pbmte_changed ||| guest_pbmte_changed ||| (sfence_vma_commit & !synchronous_trap.valid) ||| (
    csr_write & bank_address.is_one_of(csr_bits(CsrId.Satp), csr_bits(CsrId.Vsatp), csr_bits(CsrId.Hgatp))
  )
  def machine_counter_csr = csr.is_one_of(csr_bits(CsrId.Mcycle),
                                          csr_bits(CsrId.Minstret),
                                          csr_bits(CsrId.Mcycleh),
                                          csr_bits(CsrId.Minstreth))
  command_success <== commit.valid & !synchronous_trap.valid
  counters.retire <== retire
  counters.machine_write.valid <== csr_write & machine_counter_csr
  counters.machine_write.bits <== RiscvCounterWrite(xlen):
    address: csr
    value: csr_replacement
  // Events use the retiring context, not speculative issue or individual vector beats.
  hpm.event.valid <== Bool(sscofpmf) & ((hpm_selector[0..56] === bits(1, 56)) ||| ((hpm_selector[0..56] === bits(2, 56)) & retire))
  hpm.event.bits <== context
  hpm.inhibit <== hpm_inhibit ||| Bool(!sscofpmf)
  hpm.counter_write.valid <== Bool(sscofpmf) & csr_write & csr.is_one_of(csr_bits(CsrId.Mhpmcounter3), csr_bits(CsrId.Mhpmcounter3h))
  hpm.counter_write.bits.value <== csr_replacement
  hpm.selector_write.valid <== Bool(sscofpmf) & csr_write & csr.is_one_of(csr_bits(CsrId.Mhpmevent3), csr_bits(CsrId.Mhpmevent3h))
  def event_width = if xlen == XLen.X32 | 32 | 56
  def event_replacement :: Bits(event_width) = if xlen == XLen.X32 | csr_replacement | csr_replacement[0..56]
  def legal_event = mux(event_replacement <= bits(2, event_width), event_replacement, bits(0, event_width))
  hpm.selector_write.bits.value <== if xlen == XLen.X32 | mux(csr === csr_bits(CsrId.Mhpmevent3h), csr_replacement, legal_event) | csr_replacement[56..64] ++ legal_event
  if xlen == XLen.X32
  | block:
      hpm.counter_write.bits.high <== csr === csr_bits(CsrId.Mhpmcounter3h)
      hpm.selector_write.bits.high <== csr === csr_bits(CsrId.Mhpmevent3h)
  | #void
  def mret = commit.valid & !trap.valid & (commit.bits.action === RiscvCsrAction.Mret)
  def sret = commit.valid & !trap.valid & (commit.bits.action === RiscvCsrAction.Sret)
  def mret_privilege = mstatus_mret_privilege(state.mstatus)
  def sret_privilege = mstatus_sret_privilege(if hypervisor | mux(virtualized, state.vsstatus, state.mstatus) | state.mstatus)
  def supervisor_trap_status = mstatus_on_supervisor_trap(state.mstatus, privilege_state)
  def machine_trap_status = mstatus_on_machine_trap(state.mstatus, privilege_state)
  def fault_details_valid = synchronous_trap.valid & commit.bits.exception_valid
  def fault_gva = fault_details_valid & guest_fault_details.guest_virtual_address
  def guest_page_fault = synchronous_trap.cause.is_one_of([ExceptionCause.InstructionGuestPageFault, ExceptionCause.LoadGuestPageFault, ExceptionCause.StoreGuestPageFault].map(fun (cause): exception_cause_bits(cause, width)))
  def fault_gpa = mux(fault_details_valid & guest_page_fault, guest_fault_details.guest_physical_address >> 2, bits(0, 64))
  def fault_inst = mux(fault_details_valid & guest_page_fault, guest_fault_instruction(guest_fault_details), bits(0, 64))
  def trap_mstatus :: Bits(width):
    if hypervisor
    | mux(trap_to_supervisor, supervisor_trap_status, csr_flag_replace(csr_flag_replace(machine_trap_status, MstatusMPV, virtualized), MstatusGVA, fault_gva))
    | mux(trap_to_supervisor, supervisor_trap_status, machine_trap_status)
  def mret_status = mstatus_after_mret(state.mstatus)
  def sret_status = mstatus_after_sret(state.mstatus)

  writeback_valid <== !trap.valid & ((csr_commit & csr_access_legal) ||| vector_config_commit) & commit.bits.rd.or_reduce()
  writeback_value <== mux(vector_config_commit, vector_csrs.configuration_vl, csr_read_value)
  interrupt_request <== interrupt.valid
  wfi <== command_success & (commit.bits.action === RiscvCsrAction.Wfi)
  wfi_wake <== or_reduce(interrupt_pending & state.mie)
  privilege <== privilege_state
  mstatus <== mstatus_value
  satp <== mux(virtualized, zero, state.satp)
  frm <== fp_csrs.frm
  fp_enabled <== fp_access_enabled
  vector_enabled <== vector_access_enabled
  vector_state <== vector_csrs.state
  redirect.valid <== trap.valid ||| mret ||| sret
  redirect.bits <== mux(
    trap.valid,
    mux(trap_to_guest, if hypervisor | state.vstvec | zero, mux(trap_to_supervisor, state.stvec, state.mtvec)),
    mux(mret, state.mepc, if hypervisor | mux(virtualized, state.vsepc, state.sepc) | state.sepc)
  )

  when (trap.valid):
    privilege_state <== mux(trap.target === RiscvTrapTarget.Machine, PrivilegeMode.Machine, PrivilegeMode.Supervisor)
  elsewhen mret:
    privilege_state <== mret_privilege
  elsewhen sret:
    privilege_state <== sret_privilege

  when (trap.valid & trap_to_guest):
    if hypervisor
    | block:
        state.vsstatus <== mstatus_on_supervisor_trap(state.vsstatus, privilege_state)
        state.vsepc <== align_down(trap_pc, epc_alignment)
        state.vscause <== trap.cause
        state.vstval <== trap.value
    | #void
  elsewhen (trap.valid & trap_to_supervisor):
    state.mstatus <== trap_mstatus
    state.sepc <== align_down(trap_pc, epc_alignment)
    state.scause <== trap.cause
    state.stval <== trap.value
    if hypervisor
    | block:
        def previous_privilege = mux(virtualized, privilege_state === PrivilegeMode.Supervisor, csr_flag(state.hstatus, HstatusSPVP))
        def previous_context = csr_flag_replace(csr_flag_replace(state.hstatus, HstatusSPV, virtualized), HstatusSPVP, previous_privilege)
        state.hstatus <== csr_flag_replace(previous_context, HstatusGVA, fault_gva)
        state.htval <== fault_gpa
        state.htinst <== fault_inst
    | #void
  elsewhen (trap.valid):
    state.mstatus <== trap_mstatus
    state.mepc <== align_down(trap_pc, epc_alignment)
    state.mcause <== trap.cause
    state.mtval <== trap.value
    if hypervisor
    | block:
        state.mtval2 <== fault_gpa
        state.mtinst <== fault_inst
    | #void
  elsewhen mret:
    state.mstatus <== if hypervisor | csr_flag_replace(mret_status, MstatusMPV, Bool(#false)) | mret_status
  elsewhen (sret & virtualized):
    if hypervisor
    | state.vsstatus <== mstatus_after_sret(state.vsstatus)
    | #void
  elsewhen sret:
    state.mstatus <== sret_status
    if hypervisor
    | state.hstatus <== csr_flag_replace(state.hstatus, HstatusSPV, Bool(#false))
    | #void
  elsewhen (csr_write & stateen_selected):
    for (entry :: CsrBank in stateen_banks):
      entry.write(csr_replacement)
  elsewhen (csr_write & timer_selected):
    timer_bank.write(csr_replacement)
  elsewhen (csr_write & hypervisor_selected):
    hypervisor_bank.write(csr_replacement)
  elsewhen csr_write:
    bank.write(csr_replacement)

  // Pending is independent of sticky OF. Fresh overflow wins a software clear.
  when (hpm.overflow.valid & Bool(sscofpmf)):
    hpm_pending <== Bool(#true)
  elsewhen (csr_write & Bool(sscofpmf) & ((bank_address === csr_bits(CsrId.Mip)) ||| ((bank_address === csr_bits(CsrId.Sip)) & state.mideleg[13].into(Bool)))):
    hpm_pending <== csr_replacement[13].into(Bool)

  if hypervisor
  | block:
      // Completion runs before a context transition can commit; sample live V
      // here rather than banking the shared FP register file or flags.
      when (csr_write & (bank_address === csr_bits(CsrId.Vsstatus))):
        state.guest_fp_status <== if floating_point_supports_f(profile) | csr_field(csr_replacement, MstatusFS) | bits(0, MstatusFS.width)
      elsewhen (virtualized & (fp_csr_write ||| fp_update.valid)):
        state.guest_fp_status <== bits(ExtensionStatusDirty, MstatusFS.width)
      when (csr_write & (bank_address === csr_bits(CsrId.Vsstatus))):
        state.guest_vector_status <== if vector_profile_enabled(config.vector) | csr_field(csr_replacement, MstatusVS) | bits(0, MstatusVS.width)
      elsewhen (virtualized & (vector_csrs.configure.valid ||| vector_csrs.write.valid ||| vector_retire.valid ||| vector_fault_start.valid ||| vector_truncate.valid ||| vector_saturate.valid)):
        state.guest_vector_status <== bits(ExtensionStatusDirty, MstatusVS.width)
      output execution_context: RiscvExecutionContext()
      execution_context <== context
      output guest_translation: RiscvHypervisorTranslation()
      guest_translation <== RiscvHypervisorTranslation():
        vs_pbmte: pbmte & svpbmt_enabled(xlen, state.henvcfg)
        virtualized: state.virtualized
        hstatus: state.hstatus
        vsstatus: vsstatus_value
        vsatp: state.vsatp
        hgatp: state.hgatp
      // Trap and return events own V. CSR writes can only alter saved V state.
      when (trap.valid):
        state.virtualized <== trap_to_guest
      elsewhen mret:
        state.virtualized <== (mret_privilege =/= PrivilegeMode.Machine) & csr_flag(state.mstatus, MstatusMPV)
      elsewhen sret:
        state.virtualized <== virtualized ||| csr_flag(state.hstatus, HstatusSPV)
  | #void

  def csr_taps = {
    "interrupt_inputs": interrupts,
    "time_input": time_counter,
    "interrupt_boundary": interrupt_boundary & !synchronous_trap.valid,
    "interrupt_take": interrupt_take,
    "synchronous_trap": synchronous_trap.valid,
    "commit": commit.valid,
    "retired": retire,
    "privilege": privilege_state,
    "virtualized": virtualized,
    "trap_cause": trap.cause,
    "trap_target": trap.target,
    "trap_pc": trap_pc,
    "trap_value": trap.value,
    "redirect": redirect.bits,
    "mret": mret,
    "sret": sret,
    "mret_privilege": mret_privilege,
    "sret_privilege": sret_privilege,
    "trap_to_guest": trap_to_guest,
    "fault_details_valid": fault_details_valid,
    "guest_page_fault": guest_page_fault,
    "fault_gpa": fault_gpa,
    "fault_inst": fault_inst,
    "returned_virtual": if hypervisor | mux(mret, (mret_privilege =/= PrivilegeMode.Machine) & csr_flag(state.mstatus, MstatusMPV), virtualized ||| csr_flag(state.hstatus, HstatusSPV)) | Bool(#false)
  }
  describe_cosim_signals(csr_taps)

export:
  RiscvCsrFile
  resolve_csr_trap
