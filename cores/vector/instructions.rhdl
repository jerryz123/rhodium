#lang rhodium
/* Retains instruction lifetimes and register-row hazards until their accepted work has drained. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../cosim-source.rhm".describe_cosim_signals
  lib("cores/vector-layout.rhm") open
  "bundles.rhdl" open
  "dependencies.rhdl" open
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/isa/vector.rhm" open
  lib("rhodium/std/bits.rhdl").Pow2Int
  lib("flow/main.rhdl") open

/* Closes one instruction owner's issue lifetime while retaining its outstanding slots. */
bundle VectorIssueFinished(slots :: Pow2Int):
  owner: Bits(index_width(slots))
  fault: Bool

/* Tracks macro lifetimes independently of sequencing and completion-slot identities.
   Conservative destination intents hand off to exact rows; ordered owner reclamation
   waits for slots, packed carry, and splat drain, with a separate committed-store barrier. */
sync_circuit VectorInstructions(xlen :: XLen, vlen :: VectorLength, vector_completion_slots :: Pow2Int):
  def tag_width = index_width(vector_completion_slots)
  def row_frontier_width = index_width(VectorRegisterLayout(vlen, xlen.width).depth + 1)
  def Result = VectorOwnedResult(xlen, vlen, vector_completion_slots)
  interface request(Valid(VectorDescriptor(xlen)), ~role: consumer)
  interface finished(Valid(VectorIssueFinished(vector_completion_slots)), ~role: consumer)
  interface resolved(Valid(Result), ~role: consumer)
  interface compute_maturity(Valid(Result), ~role: consumer)
  interface packed_finished(Valid(Bits(tag_width)), ~role: consumer)
  interface cancel(Pulse(), ~role: consumer)
  interface retire(Pulse(), ~role: producer)
  input slots: Vec(vector_completion_slots, VectorSlotState(xlen, vlen, vector_completion_slots))
  input packed_rows: Vec(VectorRegisterLayout(vlen, xlen.width).depth, Bool)
  input splat_rows: Vec(VectorRegisterLayout(vlen, xlen.width).depth, Bool)
  input splat_owner: Bits(tag_width)
  input splat_active: Bool
  input(packed_memory, packed_drain_blocked, memory_drained): Bool
  output blocked_rows: Vec(VectorRegisterLayout(vlen, xlen.width).depth, Bool)
  output splat_blocked_rows: Vec(VectorRegisterLayout(vlen, xlen.width).depth, Bool)
  output(allocate_id, sequencing_id): Bits(tag_width)
  output(closed, serial, memory): Vec(vector_completion_slots, Bool)
  output(available, active, loads_pending, stores_pending, fp_pending): Bool


  /* Macro ownership ring.
     Sequencing can hand off while slots and destination intents remain live. */

  def layout = VectorRegisterLayout(vlen, xlen.width)
  def row_count = layout.depth
  def rows_per_register = layout.rows_per_register
  def compute_beat = compute_maturity.bits.beat
  def compute_owner = compute_maturity.bits.owner
  def element_resolved = resolved.valid
  def resolution_beat = resolved.bits.beat
  def resolution_owner = resolved.bits.owner
  reg macro_valid(~init: Bits(vector_completion_slots)(0).as_vec(Bool))
  reg macro_load(Vec(vector_completion_slots, Bool))
  reg macro_store(Vec(vector_completion_slots, Bool))
  reg macro_fp(Vec(vector_completion_slots, Bool))
  reg macro_serial(Vec(vector_completion_slots, Bool))
  reg macro_destinations(Vec(vector_completion_slots, Bits(32)))
  reg macro_classified(Vec(vector_completion_slots, Bool))
  reg macro_progressive(Vec(vector_completion_slots, Bool))
  reg macro_row_frontier(Vec(vector_completion_slots, Bits(row_frontier_width)))
  reg macro_issued(~init: Bits(vector_completion_slots)(0).as_vec(Bool))
  reg macro_fault(~init: Bits(vector_completion_slots)(0).as_vec(Bool))
  reg next_owner(~init: Bits(tag_width)(0))
  reg current_owner(~init: Bits(tag_width)(0))
  reg drain_owner(~init: Bits(tag_width)(0))
  reg store_barrier(~init: Bool(#false))


  /* Destination-intent classification.
     Only ordinary in-order row schedules can progressively release their group. */

  def destination_registers = vector_destination_registers(xlen, vlen, request.bits)
  // These schedules visit destination rows in order. Other schedules retain
  // their whole-group intent until the final beat resolves.
  def requested_control = request.bits.control
  def special_schedule = requested_control.reduction ||| requested_control.scan ||| requested_control.compress ||| requested_control.element_move ||| requested_control.whole_register_move ||| requested_control.gather
  def special_geometry = requested_control.mask_destination ||| requested_control.mask_logic ||| requested_control.widening ||| requested_control.narrowing ||| requested_control.extension ||| requested_control.wide_vs2
  def row_ordered_compute = requested_control.integer ||| requested_control.fp_service ||| requested_control.multiply_divide
  def scalar_destination = requested_control.scalar_destination ||| requested_control.floating_scalar_destination
  def progressive_write = row_ordered_compute & !requested_control.memory & !scalar_destination & !special_schedule & !special_geometry


  /* Issue closure and ordered owner reclamation.
     Allocation wins a collision. Cancellation closes unissued/unauthorized work;
     already accepted slots still drain. */

  def owner_has_slots = vec(for List (slot in 0..vector_completion_slots): slots[slot].allocated & (slots[slot].owner === drain_owner)).as_bits().or_reduce()
  def owner_has_splat = splat_active & (splat_owner === drain_owner)
  def macro_complete = macro_valid[drain_owner] & macro_issued[drain_owner] & !owner_has_slots & !packed_drain_blocked & !owner_has_splat
  for (owner in 0..vector_completion_slots):
    def owner_tag = Bits(tag_width)(owner)
    def unauthorized = vec(for List (slot in 0..vector_completion_slots): slots[slot].allocated & !slots[slot].accepted & (slots[slot].owner === owner_tag)).as_bits().or_reduce()
    def allocate_owner = request.valid & (next_owner === owner_tag)
    def reclaim_owner = macro_complete & (drain_owner === owner_tag)
    def cancel_owner = cancel.valid & macro_valid[owner] & (!macro_issued[owner] ||| unauthorized)
    def finish_owner = finished.valid & (finished.bits.owner === owner_tag)
    when allocate_owner:
      macro_valid[owner] <== Bool(#true)
      macro_issued[owner] <== Bool(#false)
      macro_fault[owner] <== Bool(#false)
      macro_destinations[owner] <== destination_registers
      macro_progressive[owner] <== progressive_write
      macro_load[owner] <== request.bits.control.memory & !request.bits.control.store
      macro_store[owner] <== request.bits.control.memory & request.bits.control.store
      macro_fp[owner] <== request.bits.control.floating_point
      macro_serial[owner] <== (request.bits.control.scan & !request.bits.control.scan_control.index) ||| request.bits.control.compress
    elsewhen reclaim_owner:
      macro_valid[owner] <== Bool(#false)
    elsewhen cancel_owner:
      macro_issued[owner] <== Bool(#true)
      macro_fault[owner] <== Bool(#true)
    elsewhen finish_owner:
      macro_issued[owner] <== Bool(#true)
      macro_fault[owner] <== finished.bits.fault ||| cancel.valid
  when macro_complete:
    drain_owner <== if vector_completion_slots == 1 | Bits(tag_width)(0) | drain_owner + Bits(tag_width)(1)


  /* Conservative destination intents and exact pending rows.
     Each row reduces independent claims. The sequencer excludes itself;
     splat waits only for older owners, measured from the retirement frontier. */

  def owner_is_foreign = for List (owner in 0..vector_completion_slots): Bits(tag_width)(owner) =/= current_owner
  def owner_precedes_splat = for List (owner in 0..vector_completion_slots): (Bits(tag_width)(owner) - drain_owner) < (splat_owner - drain_owner)
  def slot_is_foreign = for List (slot in 0..vector_completion_slots): slots[slot].owner =/= current_owner
  def slot_precedes_splat = for List (slot in 0..vector_completion_slots): (slots[slot].owner - drain_owner) < (splat_owner - drain_owner)
  def row_hazards = for List (row in 0..row_count):
    def pending_owners = for List (owner in 0..vector_completion_slots):
      def future_row = !macro_progressive[owner] ||| (Bits(row_frontier_width)(row) >= macro_row_frontier[owner])
      def destination_row = macro_destinations[owner][row div rows_per_register].into(Bool)
      macro_valid[owner] & !macro_classified[owner] & destination_row & future_row
    def pending_slots = for List (slot in 0..vector_completion_slots):
      def exact_write = slots[slot].allocated & !slots[slot].packed & slots[slot].writes
      exact_write & (slots[slot].write_address === Bits(index_width(row_count))(row))

    def foreign_intents = or_reduce(for List (owner in 0..vector_completion_slots): pending_owners[owner] & owner_is_foreign[owner])
    def foreign_writes = or_reduce(for List (slot in 0..vector_completion_slots): pending_slots[slot] & slot_is_foreign[slot])
    def foreign_splat = splat_active & (splat_owner =/= current_owner) & splat_rows[row]
    def foreign = packed_rows[row] ||| foreign_splat ||| foreign_intents ||| foreign_writes
    // A younger dependent writer must not block the splat that supplies it.
    def older_intents = or_reduce(for List (owner in 0..vector_completion_slots): pending_owners[owner] & owner_precedes_splat[owner])
    def older_writes = or_reduce(for List (slot in 0..vector_completion_slots): pending_slots[slot] & slot_precedes_splat[slot])
    [foreign, older_intents ||| older_writes]
  blocked_rows <== vec(for List ([foreign, _older] in row_hazards): foreign)
  splat_blocked_rows <== vec(for List ([_foreign, older] in row_hazards): older)


  /* Allocation and pending-work summaries.
     A committed store barrier outlives macro reclamation until memory drains. */

  when (request.valid):
    current_owner <== next_owner
    next_owner <== if vector_completion_slots == 1 | Bits(tag_width)(0) | next_owner + Bits(tag_width)(1)
  active <== macro_valid.as_bits().or_reduce()
  def store_macro_pending = vec(for List (owner in 0..vector_completion_slots): macro_valid[owner] & macro_store[owner]).as_bits().or_reduce()
  stores_pending <== store_barrier ||| store_macro_pending
  loads_pending <== vec(for List (owner in 0..vector_completion_slots): macro_valid[owner] & macro_load[owner]).as_bits().or_reduce()
  fp_pending <== vec(for List (owner in 0..vector_completion_slots): macro_valid[owner] & macro_fp[owner]).as_bits().or_reduce()
  when (request.valid & request.bits.control.memory & request.bits.control.store):
    store_barrier <== Bool(#true)
  elsewhen (store_barrier & !store_macro_pending & memory_drained):
    store_barrier <== Bool(#false)


  /* Destination handoff at maturity.
     Classification closes the whole-group intent; progressive rows advance separately. */

  def row_element_mask = Bits(index_width(vlen + 1))(vector_word_bytes(xlen) - 1) >> compute_beat.element_width.as_bits()
  def row_finished = compute_beat.last ||| ((compute_beat.end & row_element_mask) === Bits(index_width(vlen + 1))(0))
  for (owner in 0..vector_completion_slots):
    def owner_tag = Bits(tag_width)(owner)
    when (request.valid & (next_owner === owner_tag)):
      macro_classified[owner] <== Bool(#false)
    elsewhen (packed_finished.valid & (packed_finished.bits === owner_tag)):
      macro_classified[owner] <== Bool(#true)
    elsewhen (element_resolved & resolution_beat.last & (resolution_owner === owner_tag)):
      macro_classified[owner] <== Bool(#true)
    when (request.valid & (next_owner === owner_tag)):
      macro_row_frontier[owner] <== Bits(row_frontier_width)(0)
    elsewhen (compute_maturity.valid & (compute_owner === owner_tag) & macro_progressive[owner] & row_finished):
      assert(compute_beat.write.address.zext(row_frontier_width) >= macro_row_frontier[owner], "vector_progressive_write_rows_are_ordered")
      macro_row_frontier[owner] <== compute_beat.write.address.zext(row_frontier_width) + Bits(row_frontier_width)(1)


  /* Retirement versus ownership release.
     Faulted macros reclaim their owner but do not emit successful retirement. */

  retire.valid <== macro_complete & !macro_fault[drain_owner]
  allocate_id <== next_owner
  sequencing_id <== current_owner
  available <== !macro_valid[next_owner]
  closed <== macro_issued
  serial <== macro_serial
  memory <== vec(for List (i in 0..vector_completion_slots): macro_load[i] ||| macro_store[i])
  // Faulted instructions reclaim an owner without retiring. Observers must
  // close both lifetimes at actual drain, not infer them from successful retire.
  describe_cosim_signals({"drained": macro_complete, "owner": drain_owner})

export:
  VectorInstructions
  VectorIssueFinished
