#lang rhodium
/* Composes descriptor admission and vector execution behind a core-independent LSU service boundary. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/vector/admission.rhdl") open
  lib("cores/mmu/vector.rhdl") open
  lib("cores/integer-execution.rhdl") open
  lib("cores/register-write.rhdl") open
  "../fp/bundles.rhdl" open
  "../fp/timing.rhdl" open
  "../cosim-source.rhm".describe_cosim_signals
  "bundles.rhdl" open
  "pipeline.rhdl" open
  "muldiv.rhdl" open
  "../multiplier.rhdl" open
  "../divider.rhdl" open
  "../fp/register-file.rhdl".FloatingPointRegisterWrite
  "../../riscv/isa/fp-profile.rhm" open
  "../../riscv/isa/vector.rhm" open
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/rtl/pointer-masking.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

/* Accepts nonspeculative descriptors and preserves their certification, sequencing, and completion
   lifetimes. The caller chooses admission credit timing and arithmetic resources; its LSU
   owns fixed lookup timing, translation faults, split transactions, and physical memory drain. */
sync_circuit VectorBackend(xlen :: XLen, vlen :: VectorLength, Fault :: DataType,
                           ~vector_completion_slots: slots :: Pow2Int = 8,
                           ~dispatch_depth: dispatch_depth :: PosInt = 2,
                           ~pipe: pipe :: Boolean,
                           ~trace_isa: trace_isa :: maybe(String) = #false,
                           ~multiply_latency: multiply_latency :: maybe(PosInt) = #false,
                           ~packed_multiply: packed_multiply :: Boolean = #false,
                           ~fixed_fp: fixed_fp :: Boolean = #false,
                           ~fp_timing: fp_timing :: FpExecutionTiming = FpExecutionTiming()):
  def fp_profile = if xlen == XLen.X32 | FloatingPointProfile.F | FloatingPointProfile.D
  def Tag = Bits(index_width(slots))
  def MultiplyTag = VectorMultiplyTag(slots)
  def DivideTag = VectorDivideTag(slots)
  interface request(Decoupled(VectorDescriptor(xlen)), ~role: consumer)
  interface outcome(Valid(VectorCommit(xlen, slots)), ~role: producer)
  interface precheck(VectorPrecheck(), ~role: requester)
  interface fp_request(Decoupled(FpExecutionRequest(xlen, fp_profile, Tag)), ~role: producer)
  interface fp_result(Decoupled(FpExecutionResult(xlen, fp_profile, Tag)), ~role: consumer)
  interface multiply_request(Decoupled(IntegerExecutionRequest(MultiplierRequest(xlen.width), MultiplyTag)), ~role: producer)
  interface multiply_result(Irrevocable(IntegerExecutionResult(Bits(xlen.width * 2), MultiplyTag)), ~role: consumer)
  interface divide_request(Decoupled(IntegerExecutionRequest(DividerRequest(xlen.width), DivideTag)), ~role: producer)
  interface divide_result(Irrevocable(IntegerExecutionResult(DividerResponse(xlen.width), DivideTag)), ~role: consumer)
  interface fp_update(Valid(Bits(5)), ~role: producer)
  interface fault_start(Valid(Bits(xlen.width)), ~role: producer)
  interface truncate(Valid(Bits(xlen.width)), ~role: producer)
  interface retire(Pulse(), ~role: producer)
  interface execution_done(Pulse(), ~role: producer)
  interface saturate(Pulse(), ~role: producer)
  interface scalar_result(Valid(RegisterFileWrite(xlen)), ~role: producer)
  interface scalar_writeback(Decoupled(Bits(4)), ~role: producer)
  interface floating_result(Valid(FloatingPointRegisterWrite(fp_profile)), ~role: producer)
  output(active, sequencing, pending, stores_pending): Bool
  output(certification_pending, loads_pending, fp_pending): Bool
  output available: Bool
  interface issue(Decoupled(VectorToken(xlen, Bits(xlen.width), slots)), ~role: producer)
  interface decision(Valid(VectorCommit(xlen, slots)), ~role: consumer)
  interface completion(Decoupled(VectorCompletion(xlen, slots)), ~role: consumer)
  interface store_completed(Valid(Tag), ~role: consumer)
  interface precise(Valid(VectorCommit(xlen, slots)), ~role: consumer)
  input precise_fault: Fault
  output outcome_fault: Fault
  input(memory_start_ready, memory_drained): Bool
  output store: Bool
  output pointer_masking: PointerMaskControl()

  inst execution(VectorExecution(xlen, vlen, Bits(xlen.width), ~vector_completion_slots: slots, ~trace_isa: trace_isa, ~multiply_latency: multiply_latency, ~packed_multiply: packed_multiply, ~fixed_fp: fixed_fp, ~fp_timing: fp_timing))
  inst admission(VectorAdmission(xlen, vlen, slots, Fault, ~pipe: pipe, ~dispatch_depth: dispatch_depth))
  request |> admission.request
  admission.dispatch |> execution.request
  admission.precheck <=> precheck
  execution.sequencing_done |> admission.sequencing_done
  // The single sequencer owns descriptor replacement. LSU isolation belongs
  // at its first faultable read, not at descriptor installation.
  admission.requests_idle <== Bool(#true)
  execution.packed_memory <== admission.packed_memory
  precise |> admission.precise
  admission.precise_fault <== precise_fault
  admission.outcome |> outcome
  outcome_fault <== admission.outcome_fault
  available <== admission.available
  store <== admission.store
  pointer_masking <== admission.pointer_masking

  execution.issue |> filter_flow(token => token.memory) |> issue
  decision |> execution.decision
  completion |> execution.completion
  store_completed |> execution.store_completed
  when (admission.execution_certified & decision.valid):
    assert(decision.bits.disposition.is_one_of(VectorDisposition.Authorized, VectorDisposition.Retry), "certified_vector_cannot_fault")

  // Only LSU rejection rewinds allocated work; younger scalar redirects never cancel it.
  execution.cancel.valid <== Bool(#false)
  execution.schedule_enable <== !execution.memory_start_pending ||| memory_start_ready
  execution.memory_drained <== memory_drained
  execution.fp_request |> fp_request
  fp_result |> execution.fp_result
  execution.multiply_request |> multiply_request
  multiply_result |> execution.multiply_result
  execution.divide_request |> divide_request
  divide_result |> execution.divide_result
  execution.fp_update |> fp_update
  execution.fault_start |> fault_start
  execution.truncate |> truncate
  retire.valid <== outcome.valid & (outcome.bits.disposition =/= VectorDisposition.Fault)
  execution.retire |> execution_done
  execution.saturate |> saturate
  execution.scalar_result |> scalar_result
  execution.scalar_writeback |> scalar_writeback
  execution.floating_result |> floating_result
  active <== execution.active ||| admission.active
  sequencing <== execution.sequencing
  pending <== execution.pending
  stores_pending <== execution.stores_pending ||| admission.stores_pending
  loads_pending <== execution.loads_pending ||| admission.loads_pending
  fp_pending <== execution.fp_pending ||| admission.fp_pending
  certification_pending <== admission.certification_pending
  describe_cosim_signals({}, ~components: {"execution": execution})

export VectorBackend
