#lang rhodium
/* Defines vector snapshots, packed beats, local memory attempts, and acceptance feedback. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/mmu/vector.rhdl") open
  lib("cores/vector-layout.rhm") open
  lib("rhodium/std/bits.rhdl").Pow2Int
  lib("hardfloat/main.rhdl").RoundingMode
  "packed-bundles.rhdl" open
  "register-file.rhdl" open
  "decode.rhdl" open
  "../simd-alu.rhdl" open
  "../../riscv/isa/vector.rhm" open
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/rtl/vector.rhdl" open
  "../../riscv/rtl/pointer-masking.rhdl" open

/* Requests packed-memory byte rotation through the existing SIMD full-word alignment slice. */
bundle VectorAlignment(xlen :: XLen):
  data: Bits(xlen.width)
  bytes: Bits(vector_byte_offset_width(xlen))

/* Snapshots macro controls, architectural vector state, scalar operands, and optional page
   proof. */
bundle VectorDescriptor(xlen :: XLen):
  pc: Bits(xlen.width)
  precertified: Bool
  certificate: VectorFastCertificate(xlen)
  instruction: Bits(32)
  state: RiscvVectorState(xlen)
  control: VectorControl()
  scalar: Bits(xlen.width)
  floating_scalar: Bits(xlen.width)
  stride: Bits(xlen.width)
  masked: Bool
  rounding_mode: RoundingMode
  pointer_masking: PointerMaskControl()

/* Pairs scalar instruction context with an immutable admitted vector descriptor. */
bundle VectorInstruction(xlen :: XLen, Context :: DataType):
  context: Context
  descriptor: VectorDescriptor(xlen)

/* Retains the not-yet-written packed compression suffix and destination progress. */
bundle VectorCompressState(xlen :: XLen, vlen :: VectorLength):
  data: Bits(xlen.width)
  count: Bits(vector_lane_count_width(xlen))
  destination: Bits(index_width(vlen + 1))

/* Carries memory-attempt context and completion identity without retaining SIMD operands. */
bundle VectorToken(xlen :: XLen, Context :: DataType, vector_completion_slots :: Pow2Int):
  precertified: Bool
  physical_address: Bits(xlen.width)
  store: Bool
  byte_mask: Bits(vector_word_bytes(xlen))
  context: Context
  last: Bool
  truncate_on_fault: Bool
  memory: Bool
  memory_width: Bits(2)
  enabled: Bool
  address: Bits(xlen.width)
  store_data: Bits(xlen.width)
  completion_tag: Bits(index_width(vector_completion_slots))

/* Carries resolved operands, per-beat progress, lane masks, and captured execution controls. */
bundle VectorBeat(xlen :: XLen, vlen :: VectorLength):
  sequence: Bits(vector_sequence_width(vlen))
  first: Bits(index_width(vlen + 1))
  end: Bits(index_width(vlen + 1))
  destination_first: Bits(index_width(vlen + 1))
  last: Bool
  empty: Bool
  address: Bits(xlen.width)
  left: Bits(xlen.width)
  right: Bits(xlen.width)
  destination_data: Bits(xlen.width)
  enabled: Mask(vector_word_bytes(xlen))
  carry_in: Mask(vector_word_bytes(xlen))
  select_right: Mask(vector_word_bytes(xlen))
  mask_enabled: Bits(xlen.width)
  element_width: SimdElementWidth
  fp_source_width: SimdElementWidth
  fp_result_width: SimdElementWidth
  rounding_mode: SimdRoundingMode
  fp_rounding_mode: RoundingMode
  control: VectorControl()
  destination: Bits(5)
  compress_state: VectorCompressState(xlen, vlen)

/* Pairs instruction context with an ordinary beat or packed transport metadata. */
bundle VectorMicroOp(xlen :: XLen, vlen :: VectorLength, Context :: DataType):
  context: Context
  beat: VectorBeat(xlen, vlen)
  packed: Bool
  packed_layout: VectorPackedLayout(xlen, vlen)
  byte_mask: Bits(vector_word_bytes(xlen))

/* Retains destination, recurrence, service-route, and memory metadata until the result matures. */
bundle VectorResultBeat(xlen :: XLen, vlen :: VectorLength):
  sequence: Bits(vector_sequence_width(vlen))
  first: Bits(index_width(vlen + 1))
  end: Bits(index_width(vlen + 1))
  last: Bool
  reduction: Bool
  scan: Bool
  scan_carry: Bits(xlen.width)
  scalar_destination: Bool
  floating_scalar_destination: Bool
  destination: Bits(5)
  element_width: SimdElementWidth
  memory: Bool
  floating_point: Bool
  fp_execute: Bool
  mask_destination: Bool
  fp_result: VectorFloatResult
  multiply_divide: Bool
  multiply_execute: Bool
  divide: Bool
  multiply_accumulate: Bool
  multiply_subtract: Bool
  store: Bool
  saturated: Bool
  shift: Bits(vector_bit_offset_width(xlen))
  write: VectorRegisterWrite(xlen, vlen)
  compress_state: VectorCompressState(xlen, vlen)

/* Reports one slot-tagged LSU attempt's disposition and precise fault information. */
bundle VectorCommit(xlen :: XLen, vector_completion_slots :: Pow2Int):
  tag: Bits(index_width(vector_completion_slots))
  pc: Bits(xlen.width)
  disposition: VectorDisposition
  slow: Bool
  data: Bits(xlen.width)
  cause: Bits(xlen.width)
  fault_address: Bits(xlen.width)

/* Returns delayed LSU data by persistent completion slot, not current sequencing identity. */
bundle VectorCompletion(xlen :: XLen, vector_completion_slots :: Pow2Int):
  tag: Bits(index_width(vector_completion_slots))
  data: Bits(xlen.width)

/* Separates irreversible authorization from retry, precise fault, and fault-only-first
   truncation. */
hardware_enum VectorDisposition:
  Authorized
  Retry
  Fault
  Truncate

/* Returns an exclusive architectural position, not an active-lane count, and a replay
   checkpoint. Authorization is not result drain; accepted effects must never be retried. */
bundle VectorFeedback(xlen :: XLen, vlen :: VectorLength, Context :: DataType):
  packed_layout: VectorPackedLayout(xlen, vlen)
  context: Context
  sequence: Bits(vector_sequence_width(vlen))
  first: Bits(index_width(vlen + 1))
  end: Bits(index_width(vlen + 1))
  disposition: VectorDisposition
  cause: Bits(xlen.width)
  fault_address: Bits(xlen.width)
  last: Bool
  compress_state: VectorCompressState(xlen, vlen)

/* Carries only beat-specific progress and masks; invariant controls remain in the descriptor. */
bundle VectorBeatControl(xlen :: XLen, vlen :: VectorLength):
  sequence: Bits(vector_sequence_width(vlen))
  first: Bits(index_width(vlen + 1))
  end: Bits(index_width(vlen + 1))
  last: Bool
  empty: Bool
  address: Bits(xlen.width)
  mask_enabled: Bits(xlen.width)
  destination: Bits(5)

/* Retains the descriptor, restart bounds, and preparation metadata across fixed VRF latency. */
bundle VectorSequenceContext(xlen :: XLen, vlen :: VectorLength, Context :: DataType):
  instruction: VectorInstruction(xlen, Context)
  minimum: Bits(index_width(vlen + 1))
  gather_in_range: Bool
  gather_offset: Bits(vector_byte_offset_width(xlen))
  suffix: Bool
  suffix_state: VectorCompressState(xlen, vlen)
  packed: Bool
  packed_layout: VectorPackedLayout(xlen, vlen)
  packed_mask: Bits(vector_word_bytes(xlen))
  packed_data: Bits(xlen.width)
  packed_store_read: Bool
  beat_control: VectorBeatControl(xlen, vlen)
  slide_valid: Bits(vector_slide_bytes(xlen))

/* Schedules enabled general/mask reads atomically with the downstream beat's resources. */
bundle VectorSequenceRequest(xlen :: XLen, vlen :: VectorLength, Context :: DataType):
  context: VectorSequenceContext(xlen, vlen, Context)
  enables: Bits(3)
  addresses: Vec(3, Bits(index_width(VectorRegisterLayout(vlen, xlen.width).depth)))
  mask_enable: Bool
  mask_address: Bits(index_width(VectorRegisterLayout(vlen, xlen.width).rows_per_register))

/* Pairs a mature beat with distinct persistent instruction-owner and completion-slot
   identities. */
bundle VectorOwnedResult(xlen :: XLen, vlen :: VectorLength, slots :: Pow2Int):
  beat: VectorResultBeat(xlen, vlen)
  tag: Bits(index_width(slots))
  owner: Bits(index_width(slots))
  pc: Bits(xlen.width)
  splat: Bool

/* Claims a completion slot for one instruction owner and ordinary/packed route. */
bundle VectorSlotAllocation(slots :: Pow2Int):
  owner: Bits(index_width(slots))
  packed: Bool

/* Returns the retained result beat and unshifted service data to owner-indexed recurrence
   state. */
bundle VectorDrained(xlen :: XLen, vlen :: VectorLength, slots :: Pow2Int):
  beat: VectorResultBeat(xlen, vlen)
  owner: Bits(index_width(slots))
  data: Bits(xlen.width)

/* Publishes read-only allocation, acceptance, and exact pending-row metadata for routing and
   hazards. */
bundle VectorSlotState(xlen :: XLen, vlen :: VectorLength, slots :: Pow2Int):
  allocated: Bool
  accepted: Bool
  packed: Bool
  owner: Bits(index_width(slots))
  write_address: Bits(index_width(VectorRegisterLayout(vlen, xlen.width).depth))
  writes: Bool

export:
  VectorDrained
  VectorOwnedResult
  VectorSlotAllocation
  VectorSlotState
  VectorBeatControl
  VectorSequenceContext
  VectorSequenceRequest
  VectorAlignment
  vector_sequence_width
  VectorDescriptor
  VectorInstruction
  VectorCompressState
  VectorToken
  VectorBeat
  VectorMicroOp
  VectorResultBeat
  VectorDisposition
  VectorFeedback
  VectorCommit
  VectorCompletion
