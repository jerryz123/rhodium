#lang rhodium
/* Retains certified vector requests across retries and stores completion acknowledgements by slot. */
// SPDX-License-Identifier: Apache-2.0

import:
  "bundles.rhdl" open
  lib("riscv/isa/xlen.rhm") open
  lib("rhodium/std/bits.rhdl").Pow2Int
  lib("flow/main.rhdl") open

/* Captures durable requests without buffering their results. Attempts run ahead of ordered
   release; retry rewinds to the oldest owner. Skip resumes after that owner when a split
   transaction owns it outside the attempt pipeline. Recovery suppresses same-cycle issue. */
sync_circuit VectorReplay(Token :: DataType, slots :: Pow2Int):
  interface request(Decoupled(Token), ~role: consumer)
  interface captured(Valid(Token), ~role: producer)
  interface attempt(Valid(Token), ~role: producer)
  input(blocked, recover, retry, skip, release): Bool
  output occupied: Bool
  output oldest: Token
  def Cursor = Bits(bits.length(slots))
  /* Projects an extended cursor onto physical storage, including the depth-one case. */
  fun request_index(cursor :: Bits(bits.length(slots))) :~ Bits(index_width(slots)):
    if slots == 1 | bits(0, 1) | cursor[0..index_width(slots)]
  reg requests(Vec(slots, Token))
  reg head(~init: bits(0, Cursor.width))
  reg tail(~init: bits(0, Cursor.width))
  reg next_request(~init: bits(0, Cursor.width))
  def count = tail - head
  occupied <== count.or_reduce()
  oldest <== requests[request_index(head)]
  def capture = request |> gate_flow(count < bits(slots, Cursor.width)) |> to_valid()
  def Array(retention, live, feedback) = capture |> fork_valid(3)
  feedback |> captured
  def pending = next_request =/= tail
  def captures = retention |> fork_valid(slots)
  def retained = for Array (slot in 0..slots):
    def index = bits(slot, index_width(slots))
    def entry = captures[slot] |> filter_valid(_token => request_index(tail) === index)
    def offered = inject_interface(Valid(Token), ~valid: pending & !recover & !blocked & (request_index(next_request) === index), ~bits: requests[slot])
    def present = if slots == 1 | occupied | (index - request_index(head)).zext(Cursor.width) < count
    def name = "request-" ++ to_string(slot)
    describe_interface_retained_storage(entry.valid, release & (request_index(head) === index), present, ~name: name)
    describe_interface_contract(entry, offered, name, ~trace_model: interface_trace_retained(~name: name))
    offered
  def bypassed = live |> filter_valid(_token => !pending & !recover & !blocked)
  Array(retained |> valid_arbiter(), bypassed) |> valid_arbiter() |> attempt
  when (capture.valid):
    requests[request_index(tail)] <== capture.bits
    tail <== tail + bits(1, Cursor.width)
  when (skip & occupied):
    next_request <== head + bits(1, Cursor.width)
  elsewhen (retry & occupied):
    next_request <== head
  elsewhen (attempt.valid):
    next_request <== next_request + bits(1, Cursor.width)
  when release:
    head <== head + bits(1, Cursor.width)

/* Retains store acknowledgements independently of cache commit readiness; each allocated
   completion slot can hold one acknowledgement until the result arbiter accepts it. */
sync_circuit VectorStoreAcknowledgements(xlen :: XLen, slots :: Pow2Int):
  interface capture(Valid(Bits(index_width(slots))), ~role: consumer)
  interface completion(Decoupled(VectorCompletion(xlen, slots)), ~role: producer)
  output pending: Bool
  reg acknowledgements(~init: bits(0, slots).as_vec(Bool))
  pending <== acknowledgements.as_bits().or_reduce()
  wire ready: Vec(slots, Bool)
  def captures = capture |> fork_valid(slots)
  def entries = for Array (slot in 0..slots):
    def tag = bits(slot, index_width(slots))
    def entry = captures[slot] |> filter_valid(value => value === tag)
    def value = VectorCompletion(xlen, slots):
      tag: tag
      data: bits(0, xlen.width)
    def offered = inject_interface(Decoupled(VectorCompletion(xlen, slots)), ~valid: acknowledgements[slot], ~bits: value, ~ready: ready[slot])
    def name = "ack-" ++ to_string(slot)
    describe_interface_retained_storage(entry.valid, offered.fire(), acknowledgements[slot], ~name: name)
    describe_interface_contract(entry, offered, name, ~trace_model: interface_trace_retained(~name: name))
    when (offered.fire()):
      acknowledgements[slot] <== Bool(#false)
    elsewhen (entry.valid):
      acknowledgements[slot] <== Bool(#true)
    when (entry.valid):
      assert(!acknowledgements[slot], "vector_store_ack_has_unique_owner")
    offered
  entries |> arbiter() |> completion

export:
  VectorReplay
  VectorStoreAcknowledgements
