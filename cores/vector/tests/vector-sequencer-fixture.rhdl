#lang rhodium
// Composes decode, captured vxrm, VRF reads, packed execution, and a cancelable WB test boundary.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/vector-layout.rhm").VectorRegisterLayout
  "../../../riscv/isa/vector-profile.rhm" open
  "../bundles.rhdl" open
  "../packed-bundles.rhdl" open
  "../operand-fetch.rhdl" open
  "../sequencer.rhdl" open
  "../register-file.rhdl" open
  "../execute.rhdl" open
  "decode.rhdl" open
  "../decode.rhdl" open
  "../../../riscv/isa/vector.rhm" open
  "../../../riscv/isa/xlen.rhm" open
  "../../../riscv/rtl/vector.rhdl" open
  "../../../riscv/rtl/pointer-masking.rhdl" open
  lib("hardfloat/main.rhdl").RoundingMode
  lib("flow/main.rhdl") open

sync_circuit VectorSequencerFixture(xlen :: XLen, vlen :: VectorLength, vector_extensions :: List.of(VectorExtension) = DefaultVectorExtensions):
  input instruction: Bits(32)
  input(vtype, vl, vstart, scalar): Bits(xlen.width)
  input floating_scalar: Bits(xlen.width)
  input vxrm: Bits(2)
  input(request_valid, issue_ready, cancel, retry_enable): Bool
  input retry_first: Bits(index_width(vlen + 1))
  interface initialize(Valid(VectorRegisterWrite(xlen, vlen)), ~role: consumer)
  output(active, request_ready, legal, issued, committed, retried): Bool
  output result: VectorResultBeat(xlen, vlen)
  def profile = if xlen == XLen.X32 | VectorProfile.Zve32x | VectorProfile.V
  inst decode(VectorTestDecoder(profile, vector_extensions))
  inst operation_legality(VectorOperationLegality(xlen, vlen, profile, vector_extensions))
  inst sequencer(VectorSequencer(xlen, vlen, Bits(xlen.width)))
  sequencer.blocked_rows <== bits(0, VectorRegisterLayout(vlen, xlen.width).depth).as_vec(Bool)
  sequencer.packed_memory <== Bool(#false)
  sequencer.alignment_available <== Bool(#false)
  sequencer.aligned <== bits(0, xlen.width)
  sequencer.prepare_mask_result.valid <== Bool(#false)
  sequencer.prepare_mask_result.bits <== bits(0, xlen.width)
  inst operand_fetch(VectorOperandFetch(xlen, vlen, Bits(xlen.width)))
  operand_fetch.aligned <== bits(0, xlen.width)
  inst bank(VectorRegisterFile(xlen, vlen))
  inst execute(VectorExecute(xlen, vlen))
  execute.alignment.valid <== Bool(#false)
  execute.alignment.bits <== dont_care(VectorAlignment(xlen))
  inst pipeline(ValidPipe(VectorResultBeat(xlen, vlen), 3, ~flushable: #true))
  decode.instruction <== instruction
  operation_legality.instruction <== instruction
  operation_legality.control <== decode.control
  operation_legality.vtype <== vtype
  operation_legality.vstart <== vstart
  legal <== decode.valid & operation_legality.legal
  sequencer.request.valid <== request_valid
  sequencer.request.bits <== VectorInstruction(xlen, Bits(xlen.width)):
    context: bits(0x100, xlen.width)
    descriptor:
      VectorDescriptor(xlen):
        pc: bits(0x100, xlen.width)
        precertified: Bool(#false)
        certificate: dont_care(sequencer.request.bits.descriptor.certificate.type)
        instruction: instruction
        state:
          RiscvVectorState(xlen):
            vl: vl
            vtype: vtype
            vstart: vstart
            vxrm: vxrm
            vxsat: Bool(#false)
        control: decode.control
        scalar: scalar
        floating_scalar: floating_scalar
        stride: bits(0, xlen.width)
        masked: !instruction[25].into(Bool)
        rounding_mode: RoundingMode.NearEven
        pointer_masking:
          PointerMaskControl():
            mode: PointerMaskMode.Disabled
            virtual_address: Bool(#false)
  sequencer.sequence_request |> gate_flow(issue_ready) |> operand_fetch.request
  operand_fetch.flush <== sequencer.read_flush
  operand_fetch.suffix |> sequencer.suffix
  operand_fetch.begin_macro <== sequencer.request.fire()
  for (port in 0..3):
    Array(operand_fetch.reads[port], sequencer.prepare_reads[port]) |> valid_arbiter() |> bank.reads[port]
    def Array(operand_result, preparation_result) = bank.results[port] |> fork_valid(2)
    operand_result |> operand_fetch.results[port]
    preparation_result |> sequencer.prepare_results[port]
  operand_fetch.mask_read |> bank.mask_read
  bank.mask_result |> operand_fetch.mask_result
  sequencer.cancel.valid <== cancel
  operand_fetch.issue.ready <== Bool(#true)
  execute.beat <== operand_fetch.issue.bits.beat
  execute.scan_carry <== bits(0, xlen.width)
  pipeline.ingress.valid <== operand_fetch.issue.fire()
  pipeline.ingress.bits <== execute.result
  def retained_control = sequencer.retained.descriptor.control
  def serialized = retained_control.integer & (retained_control.scan ||| retained_control.compress)
  def retry = pipeline.egress.valid & retry_enable & (pipeline.egress.bits.first === retry_first) & !cancel & serialized
  pipeline.flush <== cancel ||| retry
  def authorization = pipeline.egress.valid & !retry & !cancel
  operand_fetch.feedback.valid <== pipeline.egress.valid & !cancel & serialized
  operand_fetch.feedback.bits <== VectorFeedback(xlen, vlen, Bits(xlen.width)):
    context: bits(0x100, xlen.width)
    sequence: pipeline.egress.bits.sequence
    first: pipeline.egress.bits.first
    end: pipeline.egress.bits.end
    disposition: mux(retry, VectorDisposition.Retry, VectorDisposition.Authorized)
    cause: bits(0, xlen.width)
    fault_address: bits(0, xlen.width)
    last: pipeline.egress.bits.last
    compress_state: pipeline.egress.bits.compress_state
    packed_layout: dont_care(VectorPackedLayout(xlen, vlen))
  sequencer.feedback.valid <== operand_fetch.feedback.valid
  sequencer.feedback.bits <== operand_fetch.feedback.bits
  bank.write.valid <== initialize.valid ||| (authorization & pipeline.egress.bits.write.mask.or_reduce())
  bank.write.bits <== mux(initialize.valid, initialize.bits, pipeline.egress.bits.write)
  assert(!(initialize.valid & sequencer.active), "vector_fixture_initialization_is_exclusive")
  request_ready <== sequencer.request.ready
  active <== sequencer.active ||| operand_fetch.active
  issued <== operand_fetch.issue.fire()
  committed <== authorization
  retried <== retry
  result <== pipeline.egress.bits

export:
  VectorSequencerFixture
