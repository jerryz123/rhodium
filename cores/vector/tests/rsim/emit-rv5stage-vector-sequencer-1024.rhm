import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../../riscv/isa/xlen.rhm" open
  "../vector-sequencer-fixture.rhdl" as fixture

def program = elaborate(fixture.VectorSequencerFixture(XLen.X64, 1024))
export program
