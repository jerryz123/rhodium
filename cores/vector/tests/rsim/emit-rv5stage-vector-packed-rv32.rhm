#lang rhombus
// Defines four-byte packed transport with native four-byte VRF rows and SIMD rotation.
// SPDX-License-Identifier: Apache-2.0
import:
  "../vector-packed-fixture.rhdl" open
  "../../../../riscv/isa/xlen.rhm".XLen
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("rhodium/event/main.rhm").EventInstrumentationConfig
  lib("rhodium/event/tests/rsim/trace-sites.rhm").traced_target
  "emit-rv5stage-vector-packed.rhm".site_header

def program = elaborate(VectorPackedFixture(8, ~xlen: XLen.X32))
def target = traced_target(site_header, EventInstrumentationConfig(~partial: #true))
export program target
