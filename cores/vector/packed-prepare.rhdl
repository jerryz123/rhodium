#lang rhodium
/* Forms packed layouts and preparation data under the standard sequencer's cursor and phase. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/vector-layout.rhm") open
  "bundles.rhdl" open
  "packed-bundles.rhdl" open
  "precheck.rhdl".vector_field_extent
  "decode.rhdl" open
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/isa/vector.rhm" open
  "../../riscv/model/formats.rhm" as riscv_fields
  "../../riscv/rtl/instruction-fields.rhdl".instruction_field
  "../../riscv/rtl/vector.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

/* Names sequencer-owned phases for packed mapping, mask capture, source reads, and alignment. */
hardware_enum VectorPreparePhase:
  Map
  MaskLow
  MaskHigh
  MaskDone
  Read
  ReadDone
  Align
  Issue

/* Forms byte-to-row layouts from the sequencer's cursor and phase.
   Unmasked loads and direct stores use the common read schedule; masked/segmented
   preparation retains scratch data but never advances an independent issue cursor. */
sync_circuit VectorPackedPrepare(xlen :: XLen, vlen :: VectorLength, Context :: DataType):
  def bytes = vector_word_bytes(xlen)
  def Address = Bits(index_width(VectorRegisterLayout(vlen, xlen.width).depth))
  def Layout = VectorPackedLayout(xlen, vlen)
  input instruction: VectorInstruction(xlen, Context)
  input cursor: VectorPackedCursor(xlen, vlen)
  input prepare: VectorPreparePhase
  input(enable, alignment_available): Bool
  input aligned: Bits(xlen.width)
  input blocked_rows: Vec(VectorRegisterLayout(vlen, xlen.width).depth, Bool)
  output next_phase: VectorPreparePhase
  output(ready, sources_ready, masks_ready_out, fast_store): Bool
  output candidate: Layout
  output candidate_mask: Bits(bytes)
  output candidate_data: Bits(xlen.width)
  output read_enables: Bits(3)
  output read_addresses: Vec(3, Address)
  interface reads[3](Valid(Address), ~role: producer)
  interface results[3](Valid(Bits(xlen.width)), ~role: consumer)
  interface mask_read(Valid(Bits(index_width(VectorRegisterLayout(vlen, xlen.width).rows_per_register))), ~role: producer)
  interface mask_result(Valid(Bits(xlen.width)), ~role: consumer)
  interface alignment(Valid(VectorAlignment(xlen)), ~role: producer)


  /* Preparation scratch state
     The parent sequencer owns the phase and architectural cursor; these registers hold only preparation data. */

  reg layout(Layout)
  reg byte_mask(Bits(bytes))
  reg low_mask(Bits(xlen.width))
  reg high_mask(Bits(xlen.width))
  reg store_data(Bits(xlen.width))
  reg store_remaining(Bits(bytes))
  reg read_row(Address)
  reg read_lane(Bits(index_width(bytes)))
  reg read_data(Bits(xlen.width))


  /* Transfer geometry */

  def descriptor = instruction.descriptor
  def vd = instruction_field(riscv_fields.rd, descriptor.instruction)
  def whole = descriptor.control.memory_mode === VectorMemoryMode.WholeRegister
  def mask_transfer = descriptor.control.memory_mode === VectorMemoryMode.Mask
  def eew = mux(mask_transfer, bits(0, 2), descriptor.control.memory_data_eew)
  def nf = mux(whole ||| mask_transfer, bits(0, 3), descriptor.control.memory_nf)
  def segmented = nf.or_reduce()
  def geometry = vector_type(xlen, vlen, descriptor.state.vtype)
  def emul = geometry.lmul.into(SInt(3)).sext(5) + eew.zext(5).into(SInt(5)) - geometry.sew.zext(5).into(SInt(5))
  def group_shift = mux(emul < SInt(5)(0), bits(0, 3), emul.as_bits()[0..3])
  def limit = priority_mux(~default: descriptor.state.vl[0..index_width(vlen + 1)]):
    whole: (vector_field_extent(bits(vlen / 8, 68), descriptor.control.memory_nf) >> eew)[0..index_width(vlen + 1)]
    mask_transfer: ((descriptor.state.vl + bits(7, xlen.width)) >> 3)[0..index_width(vlen + 1)]
  def store = descriptor.control.store
  def masked = descriptor.masked & !whole & !mask_transfer


  /* Increment the logical byte/field cursor; no element-address multiplier or divider. */

  def mutable element :: Bits(index_width(vlen + 1)) = cursor.element
  def mutable field :: Bits(3) = cursor.field
  def mutable byte :: Bits(vector_byte_offset_width(xlen)) = cursor.byte
  def mutable row_values = []
  def mutable offset_values = []
  def mutable element_values = []
  def mutable live_values = []
  for (lane in 0..bytes):
    def live = (bits(lane, vector_byte_offset_width(xlen)) >= cursor.leading) & (element < limit)
    def register = vd + (field.zext(5) << group_shift)
    def position = (element.zext(index_width(vlen + 1) + 3) << eew) + byte.zext(index_width(vlen + 1) + 3)
    def register_base = register.zext(index_width(VectorRegisterLayout(vlen, xlen.width).depth)) << bits.length(VectorRegisterLayout(vlen, xlen.width).rows_per_register - 1)
    def register_row = (position >> vector_byte_offset_width(xlen))[0..index_width(VectorRegisterLayout(vlen, xlen.width).depth)]
    row_values := row_values ++ [register_base + register_row]
    offset_values := offset_values ++ [position[0..vector_byte_offset_width(xlen)]]
    element_values := element_values ++ [element]
    live_values := live_values ++ [live]
    def end_byte = byte === ((bits(1, vector_lane_count_width(xlen)) << eew) - bits(1, vector_lane_count_width(xlen)))[0..vector_byte_offset_width(xlen)]
    def end_field = field === nf
    element := element + (live & end_byte & end_field).as_bits().zext(index_width(vlen + 1))
    field := mux(live & end_byte, mux(end_field, bits(0, 3), field + bits(1, 3)), field)
    byte := mux(live, mux(end_byte, bits(0, vector_byte_offset_width(xlen)), byte + bits(1, vector_byte_offset_width(xlen))), byte)
  def mapped = VectorPackedLayout(xlen, vlen):
    before: cursor
    after:
      VectorPackedCursor(xlen, vlen):
        address: cursor.address + bits(bytes, xlen.width)
        element: element
        field: field
        byte: byte
        leading: bits(0, vector_byte_offset_width(xlen))
    rows: vec(row_values)
    offsets: vec(offset_values)
    elements: vec(element_values)
    live: vec(live_values).as_bits()
    last: element >= limit


  /* Direct schedule and candidate selection */

  def fast_load = !store & !masked
  def direct_store = store & !masked & !segmented
  def offered_layout = mux(fast_load ||| direct_store, mapped, layout)
  candidate <== offered_layout
  candidate_mask <== mux(fast_load ||| direct_store, mapped.live, byte_mask)
  candidate_data <== store_data
  fast_store <== direct_store
  ready <== fast_load ||| direct_store ||| (prepare === VectorPreparePhase.Issue)
  sources_ready <== !vec(for List (lane in 0..bytes): offered_layout.live[lane].into(Bool) & blocked_rows[offered_layout.rows[lane]]).as_bits().or_reduce()


  /* The mask shadow remains independent of the three general VRF read ports. */

  def start_mask = layout.elements[0] >> vector_bit_offset_width(xlen)
  def end_mask = layout.elements[bytes - 1] >> vector_bit_offset_width(xlen)
  def start_mask_row = start_mask[0..index_width(VectorRegisterLayout(vlen, xlen.width).rows_per_register)].zext(index_width(VectorRegisterLayout(vlen, xlen.width).depth))
  def end_mask_row = end_mask[0..index_width(VectorRegisterLayout(vlen, xlen.width).rows_per_register)].zext(index_width(VectorRegisterLayout(vlen, xlen.width).depth))
  def masks_ready = !blocked_rows[start_mask_row] & !blocked_rows[end_mask_row]
  mask_read.valid <== enable & masks_ready & prepare.is_one_of(VectorPreparePhase.MaskLow, VectorPreparePhase.MaskHigh)
  mask_read.bits <== mux(prepare === VectorPreparePhase.MaskHigh, end_mask, start_mask)[0..index_width(VectorRegisterLayout(vlen, xlen.width).rows_per_register)]
  def enabled_bytes = vec(for List (lane in 0..bytes):
                            def word = mux((layout.elements[lane] >> vector_bit_offset_width(xlen)) === start_mask, low_mask, high_mask)
                            layout.live[lane].into(Bool) & (!masked ||| word.as_vec(Bool)[layout.elements[lane][0..vector_bit_offset_width(xlen)]])).as_bits()


  /* Store-row selection and shared alignment */

  def source_lane = priority_encoder(store_remaining)
  def source_row = layout.rows[source_lane]
  def first_store_lane = priority_encoder(mapped.live)
  def mutable last_store_row :: Bits(index_width(VectorRegisterLayout(vlen, xlen.width).depth)) = mapped.rows[first_store_lane]
  for (lane in 0..bytes):
    last_store_row := mux(mapped.live[lane].into(Bool), mapped.rows[lane], last_store_row)
  read_enables <== vec([direct_store, direct_store, Bool(#false)]).as_bits()
  read_addresses <== vec([mapped.rows[first_store_lane], last_store_row, source_row])
  def store_read_pending = store & store_remaining.or_reduce()
  def read_step_ready = !store ||| !store_remaining.or_reduce() ||| !blocked_rows[source_row]
  for (port in 0..3):
    reads[port].valid <== Bool(port == 0) & !direct_store & enable & (prepare === VectorPreparePhase.Read) & store_read_pending & !blocked_rows[source_row]
    reads[port].bits <== source_row
  def store_group = vec(for List (lane in 0..bytes): store_remaining[lane].into(Bool) & (layout.rows[lane] === read_row)).as_bits()
  def store_rotation = layout.offsets[read_lane] - read_lane
  def slow_store_alignment = enable & store & !direct_store & (prepare === VectorPreparePhase.Align) & alignment_available
  alignment.valid <== slow_store_alignment
  alignment.bits <== VectorAlignment(xlen):
    data: read_data
    bytes: store_rotation
  masks_ready_out <== masks_ready
  def gathered_word = vec(
    for List (lane in 0..bytes):
      def index = layout.offsets[lane] - store_rotation
      mux(segmented, aligned.as_vec(Bits(8))[index], aligned[lane * 8..lane * 8 + 8])
  ).as_bits()


  /* Preparation-state transition decode */

  def first_phase = priority_mux(~default: VectorPreparePhase.Issue):
    masked: VectorPreparePhase.MaskLow
    store: VectorPreparePhase.Read
  def phase_after_read = mux(store_read_pending, VectorPreparePhase.ReadDone, VectorPreparePhase.Issue)
  def phase_after_alignment = mux((store_remaining & !store_group).or_reduce(), VectorPreparePhase.Read, VectorPreparePhase.Issue)
  def prepared_next_phase = mux_lookup(prepare, ~default: prepare):
    VectorPreparePhase.Map: first_phase
    VectorPreparePhase.MaskLow: mux(masks_ready, VectorPreparePhase.MaskHigh, prepare)
    VectorPreparePhase.MaskHigh: mux(masks_ready, VectorPreparePhase.MaskDone, prepare)
    VectorPreparePhase.MaskDone: VectorPreparePhase.Read
    VectorPreparePhase.Read: mux(read_step_ready, phase_after_read, prepare)
    VectorPreparePhase.ReadDone: mux(results[0].valid, VectorPreparePhase.Align, prepare)
    VectorPreparePhase.Align: mux(slow_store_alignment, phase_after_alignment, prepare)
  next_phase <== mux(!enable ||| fast_load ||| direct_store, prepare, prepared_next_phase)


  /* Preparation scratch updates
     Capture mapped layout, mask responses, and store source data without advancing an independent issue cursor. */

  when (enable & !fast_load & !direct_store):
    when (prepare === VectorPreparePhase.Map):
      layout <== mapped
      byte_mask <== mapped.live
      store_remaining <== mapped.live
      store_data <== bits(0, xlen.width)
    elsewhen ((prepare === VectorPreparePhase.MaskHigh) & masks_ready):
      low_mask <== mask_result.bits
    elsewhen (prepare === VectorPreparePhase.MaskDone):
      high_mask <== mask_result.bits
    elsewhen ((prepare === VectorPreparePhase.Read) & read_step_ready):
      // MaskDone's second word is now registered; retain the exact per-byte predicate.
      byte_mask <== enabled_bytes
      when store_read_pending:
        read_row <== source_row
        read_lane <== source_lane
    elsewhen (prepare === VectorPreparePhase.ReadDone):
      when (results[0].valid):
        read_data <== results[0].bits
    elsewhen (slow_store_alignment):
      def mask = vec(for List (lane in 0..bytes): mux(if lane < bytes | store_group[lane].into(Bool) | Bool(#false), !bits(0, 8), bits(0, 8))).as_bits()
      store_data <== store_data.masked_merge(gathered_word, mask)
      store_remaining <== store_remaining & !store_group

export:
  VectorPreparePhase
  VectorPackedPrepare
