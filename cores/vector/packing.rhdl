#lang rhodium
/* Adapts vector chunks for extension/widening and packs lane-local fixed-point results. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("riscv/isa/xlen.rhm").XLen
  lib("cores/vector-layout.rhm") open
  "../../riscv/isa/vector.rhm" open
  "../simd-alu.rhdl" open
  "register-file.rhdl" open
  lib("rhodium/std/bits.rhdl") open

/* Selects a VRF row or replicated scalar/immediate operand. */
hardware_enum VectorOperandSelect:
  Vector
  Scalar
  Immediate

/* Selects signed-five-bit or unsigned-five/six-bit immediate interpretation. */
hardware_enum VectorImmediateKind:
  Signed5
  Unsigned5
  Unsigned6

/* Captures element bounds, predication, broadcast selection, and width-change packing policy. */
bundle VectorPackingControl(vlen :: VectorLength):
  element_width: SimdElementWidth
  first_element: Bits(index_width(vlen + 1))
  vl: Bits(index_width(vlen + 1))
  vstart: Bits(index_width(vlen + 1))
  vlmax: Bits(index_width(vlen + 1))
  masked: Bool
  operand_select: VectorOperandSelect
  immediate_kind: VectorImmediateKind
  widening: Bool
  narrowing: Bool
  extension: Bool
  extension_ratio: SimdExtensionRatio
  extension_signed: Bool
  extension_part: Bits(3)
  upper_half: Bool
  left_wide: Bool
  left_signed: Bool
  right_signed: Bool

/* Carries physical row operands, execution width, and enabled lanes into SIMD execution. */
bundle VectorPackedOperands(xlen :: XLen, vlen :: VectorLength):
  left: Bits(xlen.width)
  right: Bits(xlen.width)
  element_width: SimdElementWidth
  enabled: Mask(vector_word_bytes(xlen))
  first_element: Bits(index_width(vlen + 1))

/* Pairs packed narrowing data with saturation until result maturity authorizes the
   architectural sticky update. */
bundle VectorNarrowedResult(xlen :: XLen):
  result: SimdAluResult(xlen)
  saturated: Bool

/* Broadcasts and extends operands or selects widening halves with bounded lane enables.
   Its local geometry check does not establish architectural register-group legality. */
circuit VectorOperands(xlen :: XLen, vlen :: VectorLength):
  input control: VectorPackingControl(vlen)
  input(left, right, mask_word, scalar): Bits(xlen.width)
  input immediate: Bits(6)
  output operands: VectorPackedOperands(xlen, vlen)
  output legal: Bool

  def count_width = index_width(vlen + 1)
  def widths = [SimdElementWidth.E8, SimdElementWidth.E16, SimdElementWidth.E32, SimdElementWidth.E64]


  /* Scalar/immediate broadcast and per-format lane enables.
     Element bounds and predication are computed before width-changing paths. */

  def signed_immediate = immediate[0..5].into(SInt(5)).sext(xlen.width).into(Bits(xlen.width))
  def immediate_value = mux_lookup(control.immediate_kind, ~default: signed_immediate, [[VectorImmediateKind.Unsigned5, immediate[0..5].zext(xlen.width)], [VectorImmediateKind.Unsigned6, immediate.zext(xlen.width)]])
  def broadcast_source = mux(control.operand_select === VectorOperandSelect.Immediate, immediate_value, scalar)
  def source_mask = (mask_word >> control.first_element[0..vector_bit_offset_width(xlen)])[0..vector_word_bytes(xlen)]
  def alternatives:
    for List (format in 0..vector_format_count(xlen)):
      def width = 8 << format
      def lanes = xlen.width / width
      def enabled = vec(for List (lane in 0..vector_word_bytes(xlen)):
                          def element = control.first_element.zext(count_width + 1) + Bits(count_width + 1)(lane)
                          def in_body = (element >= control.vstart.zext(count_width + 1)) & (element < control.vl.zext(count_width + 1))
                          def in_group = element < control.vlmax.zext(count_width + 1)
                          def unmasked = !control.masked ||| source_mask[lane].into(Bool)
                          Bool(lane < lanes) & in_body & in_group & unmasked)

      VectorPackedOperands(xlen, vlen):
        left: left
        right: mux(control.operand_select === VectorOperandSelect.Vector, right, vec(for List (_ in 0..lanes): broadcast_source[0..width]).as_bits())
        element_width: widths[format]
        enabled: enabled.as_bits().into(Mask(vector_word_bytes(xlen)))
        first_element: control.first_element

  def packed :: VectorPackedOperands(xlen, vlen) = mux_lookup(control.element_width, ~default: alternatives[0], for List (format in 1..vector_format_count(xlen)): [widths[format], alternatives[format]])


  /* Extension and half-row widening/narrowing preparation.
     Extension has selection priority; width legality remains a separate result. */

  inst extend(SimdExtend(xlen))
  extend.source <== packed.left
  extend.destination_width <== control.element_width
  extend.ratio <== control.extension_ratio
  extend.part <== control.extension_part
  extend.signed <== control.extension_signed
  def extended = packed.updated(~left: extend.data)
  inst widen(SimdWidenOperands(xlen))
  widen.left <== packed.left
  widen.right <== packed.right
  widen.enabled <== packed.enabled
  widen.upper_half <== control.upper_half
  widen.left_wide <== control.left_wide
  widen.left_signed <== control.left_signed
  widen.right_signed <== control.right_signed
  widen.element_width <== control.element_width.as_bits().into(SimdWidenElementWidth)
  def half_elements = Bits(count_width)(vector_word_bytes(xlen) / 2) >> control.element_width.as_bits()
  def widened = VectorPackedOperands(xlen, vlen):
    left: widen.operands.left
    right: widen.operands.right
    element_width: widen.operands.element_width
    enabled: widen.operands.enabled
    first_element: control.first_element + mux(control.upper_half, half_elements, Bits(count_width)(0))

  def changes_width = control.widening ||| control.narrowing
  operands <== priority_mux(~default: packed):
    control.extension: extended
    changes_width: widened


  /* Local row geometry checks, not architectural register-group legality. */

  def aligned = !(control.first_element & (Bits(count_width)(vector_word_bytes(xlen) - 1) >> control.element_width.as_bits())).or_reduce()
  def supported_width = control.element_width.as_bits() <= Bits(2)(vector_format_count(xlen) - 1)
  def bounded_length = (control.vl <= control.vlmax) & (control.vlmax <= Bits(count_width)(vlen)) & control.vlmax.or_reduce()
  def valid_cursor = control.first_element < control.vlmax
  def width_change_fits = !(changes_width & (control.element_width.as_bits() >= Bits(2)(vector_format_count(xlen) - 1)))
  legal <== supported_width & aligned & bounded_length & valid_cursor & width_change_fits & (!control.extension ||| extend.legal)

/* Maps data or mask results into a bit-enabled VRF row, including narrowing clipping.
   Retains address overflow until bounds checking and reports saturation separately. */
circuit VectorResult(xlen :: XLen, vlen :: VectorLength):
  input destination: Bits(5)
  input first_element: Bits(index_width(vlen + 1))
  input element_width: SimdElementWidth
  input mask_destination: Bool
  input narrowing: Bool
  input clip: Bool
  input clip_unsigned: Bool
  input enabled: Mask(vector_word_bytes(xlen))
  input result: SimdAluResult(xlen)
  output write: VectorRegisterWrite(xlen, vlen)
  output legal: Bool
  output saturated: Bool


  /* Destination-row geometry.
     Retain the carry above the physical address until the bank-bound check. */

  def address_width = index_width(VectorRegisterLayout(vlen, xlen.width).depth)
  def calculation_width = index_width(vlen + 1) + 1
  def base = destination.zext(calculation_width) << bits.length(VectorRegisterLayout(vlen, xlen.width).rows_per_register - 1)
  def element = first_element.zext(calculation_width)
  def data_chunk = element >> (Bits(2)(vector_byte_offset_width(xlen)) - element_width.as_bits())
  def address = base + mux(mask_destination, element >> vector_bit_offset_width(xlen), data_chunk)
  def mask_write_mask = enabled.as_bits().zext(xlen.width) << first_element[0..vector_bit_offset_width(xlen)]
  def upper_half = (first_element & (Bits(index_width(vlen + 1))(vector_word_bytes(xlen) / 2) >> element_width.as_bits())).or_reduce()


  /* Per-format narrowing and clipping.
     Preserve enabled-lane saturation separately from packed data and masks. */

  def narrowed_results = for List (format in 0..(vector_format_count(xlen) - 1)):
    def element_bits = 8 * (2 ** format)
    def source_bits = 2 * element_bits
    def lanes = (xlen.width / 2) div element_bits
    def elements = for List (lane in 0..lanes):
      def source = result.data[lane * source_bits..(lane + 1) * source_bits]
      def low = source[0..element_bits]
      def upper = source[element_bits..source_bits]
      def result_negative = source[source_bits - 1].into(Bool)
      def low_negative = low[element_bits - 1].into(Bool)
      def sign_fill = mux(low_negative, !Bits(element_bits)(0), Bits(element_bits)(0))
      def unsigned_overflow = upper.or_reduce()
      def signed_overflow = upper =/= sign_fill
      def overflow = mux(clip_unsigned, unsigned_overflow, signed_overflow)
      def unsigned_limit = !Bits(element_bits)(0)
      def signed_limit = mux(result_negative, Bits(element_bits)(1 << (element_bits - 1)), Bits(element_bits)((1 << (element_bits - 1)) - 1))
      def clipped = mux(clip_unsigned, unsigned_limit, signed_limit)
      [mux(clip & overflow, clipped, low), (enabled[lane] & clip & overflow).as_bits()]

    def low_data :: Bits(xlen.width / 2) = if lanes == 1 | elements[0][0] | concat(elements.map(fun (element :: List): element[0]).reverse())
    def saturation_bits :: Bits(lanes) = if lanes == 1 | elements[0][1] | concat(elements.map(fun (element :: List): element[1]).reverse())
    def mask_bits = for List (byte in 0..(vector_word_bytes(xlen) / 2)): enabled[byte div (2 ** format)].as_bits()
    def low_mask = concat(mask_bits.reverse()).into(Mask(vector_word_bytes(xlen) / 2))
    VectorNarrowedResult(xlen):
      result:
        SimdAluResult(xlen):
          data: mux(upper_half, low_data ++ Bits(xlen.width / 2)(0), Bits(xlen.width / 2)(0) ++ low_data)
          mask_result: result.mask_result
          write_mask: mux(upper_half, low_mask.as_bits() ++ Bits(vector_word_bytes(xlen) / 2)(0), Bits(vector_word_bytes(xlen) / 2)(0) ++ low_mask.as_bits()).into(Mask(vector_word_bytes(xlen)))
          saturated: result.saturated

      saturated: saturation_bits.or_reduce()

  def narrowed :: VectorNarrowedResult(xlen) = mux_lookup(element_width, ~default: narrowed_results[0], for List (format in 1..(vector_format_count(xlen) - 1)): [SimdElementWidth.values()[format], narrowed_results[format]])


  /* Final data/mask write packing and physical-bank legality. */

  def effective_result :: SimdAluResult(xlen) = mux(narrowing, narrowed.result, result)
  saturated <== result.saturated ||| (narrowing & narrowed.saturated)
  write <== VectorRegisterWrite(xlen, vlen):
    address: address[0..address_width]
    data: mux(mask_destination, effective_result.mask_result.as_bits().zext(xlen.width) << first_element[0..vector_bit_offset_width(xlen)], effective_result.data)
    mask: mux(mask_destination, mask_write_mask, expand_mask(effective_result.write_mask.as_bits(), 8))

  def aligned = !(first_element & (Bits(index_width(vlen + 1))(vector_word_bytes(xlen) - 1) >> element_width.as_bits())).or_reduce()
  def half_aligned = !(first_element & (Bits(index_width(vlen + 1))(vector_word_bytes(xlen) / 2 - 1) >> element_width.as_bits())).or_reduce() & (element_width.as_bits() < Bits(2)(vector_format_count(xlen) - 1))
  def supported_width = element_width.as_bits() <= Bits(2)(vector_format_count(xlen) - 1)
  def address_in_bank = address < Bits(calculation_width)(VectorRegisterLayout(vlen, xlen.width).depth)
  def mask_in_register = !mask_destination ||| (first_element < Bits(index_width(vlen + 1))(vlen))
  legal <== supported_width & mux(narrowing, half_aligned, aligned) & address_in_bank & mask_in_register

export:
  VectorOperandSelect
  VectorImmediateKind
  VectorPackingControl
  VectorPackedOperands
  VectorOperands
  VectorResult
