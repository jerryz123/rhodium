#lang rhodium
/* Retains accepted packed responses and partial VRF rows independently of replayable request
   preparation. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../cosim-source.rhm".describe_cosim_signals
  lib("cores/vector-layout.rhm") open
  "bundles.rhdl" open
  "packed-bundles.rhdl" open
  "load-response.rhdl" open
  "register-file.rhdl" open
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/isa/vector.rhm" open
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/reduction.rhdl").tree_reduce
  lib("flow/main.rhdl") open

/* Retains accepted packed words and drains them in request order through shared byte alignment.
   Partial-row carry survives replay and owner closure; completed prefixes can write
   while the same transport's suffix is retained for the next row. */
sync_circuit VectorPackedLoad(xlen :: XLen, vlen :: VectorLength, slots :: Pow2Int, owner_count :: Pow2Int):
  def bytes = xlen.width / 8
  def Tag = Bits(index_width(slots))
  def Owner = Bits(index_width(owner_count))
  def Entry = VectorPackedEntry(xlen, vlen, owner_count)
  interface reserve(Valid(VectorPackedReservation(xlen, vlen, slots, owner_count)), ~role: consumer)
  interface commit(Valid(VectorCommit(xlen, slots)), ~role: consumer)
  interface completion(Valid(VectorCompletion(xlen, slots)), ~role: consumer)
  interface alignment(Valid(VectorAlignment(xlen)), ~role: producer)
  input aligned: Bits(xlen.width)
  interface write(Valid(VectorRegisterWrite(xlen, vlen)), ~role: producer)
  interface released(Valid(Tag), ~role: producer)
  input head: Tag
  input owner: Owner
  input(drain_enable, alignment_available): Bool
  input write_available: Bool
  input accepted_slots: Vec(slots, Bool)
  input closed_owners: Vec(owner_count, Bool)
  output(busy_rows, foreign_rows): Vec(VectorRegisterLayout(vlen, xlen.width).depth, Bool)
  output(active, drain_blocked): Bool
  output resolved: Entry


  /* Accepted-word and partial-row ownership.
     Completion slots and carry remain live independently of replayable preparation. */

  def row_count = VectorRegisterLayout(vlen, xlen.width).depth
  def wb = commit |> map_valid(event => event.tag)
  def successful = commit.valid & (commit.bits.disposition === VectorDisposition.Authorized)
  inst loads(VectorLoadResponse(xlen, slots))
  reg entries(Vec(slots, Entry))
  reg completed(~init: Bits(slots)(0).as_vec(Bool))
  reg data(Vec(slots, Bits(xlen.width)))
  reg drain_remaining(~init: Bits(bytes)(0))
  reg draining(~init: Bool(#false))
  reg carry_valid(~init: Bool(#false))
  reg carry(VectorRegisterWrite(xlen, vlen))
  reg carry_owner(Owner)
  active <== accepted_slots.as_bits().any() ||| carry_valid
  // A closed issue owner cannot add another fragment. Flush its retained
  // suffix once all accepted words have drained, including a canceled prefix.
  def carry_has_slots = vec(for List (s in 0..slots): accepted_slots[s] & (entries[s].owner === carry_owner)).as_bits().any()
  def carry_pending = carry_valid & closed_owners[carry_owner.as_bits()] & !carry_has_slots
  def flush_carry = carry_pending & write_available
  resolved <== entries[wb.bits]
  drain_blocked <== carry_pending


  /* Ordered head drain and shared alignment offer.
     Stores reclaim metadata without a VRF grant; load writes still require it.
     Response arrival may reorder; alignment offers must not depend on the write-port grant. */

  def entry = entries[head]
  def head_ready = drain_enable & !carry_pending & accepted_slots[head] & completed[head]
  def drainable = head_ready & (entry.store ||| write_available)
  def remaining = mux(draining, drain_remaining, entry.mask)
  def target_lane = priority_encoder(remaining)
  def target_row = entry.layout.rows[target_lane]
  def group = vec(for List (lane in 0..bytes): remaining[lane].into(Bool) & (entry.layout.rows[lane] === target_row)).as_bits()
  def rotation = target_lane - entry.layout.offsets[target_lane]
  // Offer the alignment independently of write-port arbitration; only a free
  // write cycle consumes it. This keeps the shared ALU out of its own grant path.
  def load_alignment = head_ready & !entry.store & remaining.any() & alignment_available
  def load_piece = load_alignment & write_available
  alignment.valid <== load_alignment
  alignment.bits <== VectorAlignment(xlen):
    data: data[head]
    bytes: rotation


  /* Byte routing and row-boundary assembly.
     One aligned word can write its completed prefix and retain a suffix on the same edge. */

  /* Maps selected transport lanes to byte enables at their current row offsets. */
  fun row_byte_mask(lanes :: Bits(bytes)) :~ Bits(xlen.width):
    vec(
      for List (offset in 0..bytes):
        def selected = vec(
          for List (lane in 0..bytes):
            lanes[lane].into(Bool) & (entry.layout.offsets[lane] === Bits(vector_byte_offset_width(xlen))(offset))
        ).as_bits().any()

        mux(selected, !Bits(8)(0), Bits(8)(0))
    ).as_bits()

  def aligned_bytes = aligned.as_vec(Bits(8))
  def piece_data = vec(
    for List (offset in 0..bytes):
      // Preserve lane order in this priority fold for segmented byte routing.
      def mutable value = Bits(8)(0)
      for (lane in 0..bytes):
        def index = Bits(vector_byte_offset_width(xlen))(lane) - rotation
        def selected = group[lane].into(Bool) & (entry.layout.offsets[lane] === Bits(vector_byte_offset_width(xlen))(offset))
        value := mux(selected, aligned_bytes[index], value)

      mux(entry.segmented, value, aligned[offset * 8..offset * 8 + 8])
  ).as_bits()

  def piece_mask = row_byte_mask(group)
  def same_row = carry_valid & (carry.address === target_row)
  def suffix = remaining & !group
  def suffix_lane = priority_encoder(suffix)
  def suffix_row = entry.layout.rows[suffix_lane]
  def suffix_mask = row_byte_mask(suffix)
  def carry_can_merge = !carry_valid ||| same_row
  // One rotated word supplies both sides of a row boundary. Emit the completed
  // prefix and retain its suffix on the same edge, sustaining one beat/cycle.
  def split_load = load_piece & !entry.segmented & suffix.any() & carry_can_merge
  def carry_data = mux(same_row, carry.data, Bits(xlen.width)(0))
  def combined = VectorRegisterWrite(xlen, vlen):
    address: target_row
    data: carry_data.masked_merge(piece_data, piece_mask)
    mask: mux(same_row, carry.mask, Bits(xlen.width)(0)) ||| piece_mask

  def full_row = load_piece & !entry.segmented & combined.mask.all() & carry_can_merge
  def word_drained = entry.store ||| !remaining.any() ||| (load_piece & (!suffix.any() ||| split_load))
  def release_slot = drainable & word_drained
  def write_previous_carry = load_piece & carry_valid & !same_row
  def write_event = inject_interface(Valid(VectorRegisterWrite(xlen, vlen)), ~valid: write_previous_carry ||| flush_carry ||| split_load ||| full_row, ~bits: mux(split_load ||| full_row, combined, carry))
  (
    write_event |> trace_valid_event("vector/complete", ~fields: result):
      packed: Bool(#true)
      destination(~format: "unsigned"): (result.address >> bits.length(VectorRegisterLayout(vlen, xlen.width).rows_per_register - 1))[0..5]
      row(~format: "unsigned"): result.address
      write_enabled: result.mask.any()
      write_mask: result.mask
  ) |> write
  describe_cosim_signals({"write_owner": mux(split_load ||| full_row, entry.owner, carry_owner)})


  /* Accepted-beat lineage and response capture.
     Slot release follows ordered assembly, not raw response arrival. */

  def accepted = wb |> filter_valid(_tag => successful)
  def release_event = inject_interface(Valid(Tag), ~valid: release_slot, ~bits: head)
  describe_interface_queue_storage(slots, successful, release_slot, head, wb.bits, accepted_slots[head], Bool(#false), ~name: "accepted-beats")
  describe_interface_contract(accepted, release_event, "accepted-beats", ~trace_model: interface_trace_queue(~name: "accepted-beats"))
  (
    release_event |> trace_valid_event("vector/slot.release", ~fields: tag):
      packed: Bool(#true)
      memory_bytes(~format: "unsigned"): Bits(4)(bytes)
      store: entry.store
      byte_mask: entry.mask
      slot(~format: "unsigned"): tag
  ) |> released

  (
    commit |> filter_valid(_event => successful) |> map_valid(event => VectorMemoryAcceptance(xlen, slots)):
      tag: wb.bits
      pending: event.slow
      data: event.data
  ) |> loads.accepted

  completion |> loads.response


  /* Carry, per-word drain cursor, and response state.
     Prefix/suffix updates share an edge; preserve independent slot-completion collision priority. */

  when split_load:
    carry_valid <== Bool(#true)
    carry_owner <== entry.owner
    carry <== VectorRegisterWrite(xlen, vlen):
      address: suffix_row
      data: aligned
      mask: suffix_mask
  elsewhen full_row:
    carry_valid <== Bool(#false)
  elsewhen (load_piece):
    carry_valid <== Bool(#true)
    carry_owner <== entry.owner
    carry <== combined
  elsewhen flush_carry:
    carry_valid <== Bool(#false)

  when release_slot:
    draining <== Bool(#false)
  elsewhen load_piece:
    draining <== Bool(#true)
    drain_remaining <== remaining & !group

  for (slot in 0..slots):
    def tag = Bits(index_width(slots))(slot)
    def reserve_here = reserve.valid & (reserve.bits.tag === tag)
    def delayed_here = loads.completed[1].valid & (loads.completed[1].bits.tag === tag)
    def immediate_here = loads.completed[0].valid & (loads.completed[0].bits.tag === tag)
    def release_here = release_slot & (head === tag)
    when reserve_here:
      entries[slot] <== reserve.bits.entry

    when delayed_here:
      completed[slot] <== Bool(#true)
      data[slot] <== loads.completed[1].bits.data
    elsewhen immediate_here:
      completed[slot] <== Bool(#true)
      data[slot] <== loads.completed[0].bits.data
    elsewhen (reserve_here ||| release_here):
      completed[slot] <== Bool(#false)


  /* Exact pending-row claims.
     Accepted load words and retained carry block younger accesses until their writes drain.
     Lane and slot contributions are unordered sets, so each union is a balanced OR tree. */

  def carry_rows = mux(carry_valid, Bits(row_count)(1) << carry.address, Bits(row_count)(0))
  def slot_rows = for List (slot in 0..slots):
    def lane_rows = for List (lane in 0..bytes):
      mux(entries[slot].mask[lane].into(Bool), Bits(row_count)(1) << entries[slot].layout.rows[lane], Bits(row_count)(0))

    def rows = tree_reduce(lane_rows, fun (left, right): left ||| right)
    mux(accepted_slots[slot] & !entries[slot].store, rows, Bits(row_count)(0))

  def foreign_slot_rows = for List (slot in 0..slots):
    mux(entries[slot].owner =/= owner, slot_rows[slot], Bits(row_count)(0))

  def foreign_carry_rows = mux(carry_owner =/= owner, carry_rows, Bits(row_count)(0))
  def busy :: Bits(row_count) = tree_reduce([carry_rows] ++ slot_rows, fun (left, right): left ||| right)
  def foreign :: Bits(row_count) = tree_reduce([foreign_carry_rows] ++ foreign_slot_rows, fun (left, right): left ||| right)
  busy_rows <== busy.as_vec(Bool)
  foreign_rows <== foreign.as_vec(Bool)
  when (commit.valid):
    assert(wb.valid, "packed_memory_feedback_has_attempt")
    assert(commit.bits.disposition.is_one_of(VectorDisposition.Authorized, VectorDisposition.Retry), "packed_memory_is_certified")

  when (completion.valid):
    assert(accepted_slots[completion.bits.tag] & !completed[completion.bits.tag], "packed_response_has_unique_accepted_owner")

export VectorPackedLoad
