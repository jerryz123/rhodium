#lang rhodium
/* Retains one faultable zero-stride load value and splats it through masked VRF row writes. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/vector-layout.rhm") open
  "bundles.rhdl" open
  "register-file.rhdl" open
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/isa/vector.rhm" open
  "../../riscv/model/formats.rhm" as riscv_fields
  "../../riscv/rtl/instruction-fields.rhdl".instruction_field
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open

/* Retains one encoded-zero-stride load value and its macro owner beyond sequencing.
   Writes selected destination rows with cached mask words and publishes unfinished
   row/mask claims so younger work cannot overwrite unread sources or pending writes. */
sync_circuit VectorSplatLoad(xlen :: XLen, vlen :: VectorLength, slots :: Pow2Int):
  def Owner = Bits(index_width(slots))
  def Row = Bits(index_width(VectorRegisterLayout(vlen, xlen.width).depth + 1))
  def MaskAddress = Bits(index_width(VectorRegisterLayout(vlen, xlen.width).rows_per_register))
  interface launch(Valid(VectorInstruction(xlen, Owner)), ~role: consumer)
  interface read_started(Pulse(), ~role: consumer)
  interface skipped(Pulse(), ~role: consumer)
  interface decision(Valid(VectorCommit(xlen, slots)), ~role: consumer)
  input(decision_first, decision_last): Bool
  interface completion(Valid(VectorCompletion(xlen, slots)), ~role: consumer)
  interface mask_read(Valid(MaskAddress), ~role: producer)
  interface mask_result(Valid(Bits(xlen.width)), ~role: consumer)
  interface write(Valid(VectorRegisterWrite(xlen, vlen)), ~role: producer)
  input blocked_rows: Vec(VectorRegisterLayout(vlen, xlen.width).depth, Bool)
  input(write_available, mask_read_available): Bool
  output pending_rows: Vec(VectorRegisterLayout(vlen, xlen.width).depth, Bool)
  output(active, probing, probe_pending): Bool
  output owner: Owner


  /* Probe and retained-value ownership.
     Sequencing may finish before the response or final destination row drains. */

  reg occupied(~init: Bool(#false))
  reg waiting(~init: Bool(#false))
  reg value_valid(~init: Bool(#false))
  reg lookup_pending(~init: Bool(#false))
  reg response_tag(Bits(index_width(slots)))
  reg instruction(VectorDescriptor(xlen))
  reg instruction_owner(Owner)
  reg value(Bits(xlen.width))
  reg row(Row)
  reg mask_cached(~init: Bool(#false))
  reg mask_waiting(~init: Bool(#false))
  reg mask_index(MaskAddress)
  reg mask_word(Bits(xlen.width))
  active <== occupied
  probing <== occupied & !waiting & !value_valid
  probe_pending <== lookup_pending
  owner <== instruction_owner


  /* Row geometry and unfinished destination/mask claims.
     Retain unread v0 ownership while draining so younger writers cannot change the mask. */

  def layout = VectorRegisterLayout(vlen, xlen.width)
  def address_width = index_width(layout.depth)
  def geometry_width = index_width(vlen + 1) + 4
  def rows_per_register = layout.rows_per_register
  def eew = instruction.control.memory_data_eew
  def vd = instruction_field(riscv_fields.rd, instruction.instruction)
  def start = instruction.state.vstart[0..index_width(vlen + 1)]
  def limit = instruction.state.vl[0..index_width(vlen + 1)]
  def body_bytes = limit.zext(geometry_width) << eew
  def row_limit = (body_bytes + Bits(geometry_width)(vector_word_bytes(xlen) - 1)) >> vector_byte_offset_width(xlen)
  def unfinished_row = row < row_limit[0..Row.width]
  def first_element = row.zext(index_width(vlen + 1) + 1) << (Bits(2)(vector_byte_offset_width(xlen)) - eew)
  def needed_mask = (first_element >> vector_bit_offset_width(xlen))[0..MaskAddress.width]
  def mask_ready = !instruction.masked ||| (mask_cached & (mask_index === needed_mask))
  def address = (vd.zext(address_width) << bits.length(rows_per_register - 1)) + row[0..address_width]
  def need_mask_word = value_valid & instruction.masked & !mask_ready & !mask_waiting & unfinished_row
  def mask_source_free = !blocked_rows[needed_mask.zext(address_width)]
  mask_read.valid <== need_mask_word & mask_source_free & mask_read_available
  mask_read.bits <== needed_mask
  // Retain destination writes and unread mask words after sequencing releases.
  // Younger work must not overwrite v0 while this owner still consumes it.
  def destination_base = vd.zext(Row.width) << bits.length(rows_per_register - 1)
  pending_rows <== vec(
    for List (r in 0..layout.depth):
      def offset = Bits(Row.width)(r) - destination_base
      def destination = (offset >= row) & (offset < row_limit[0..Row.width])
      def mask_source = instruction.masked & Bool(r < rows_per_register)
      occupied & (destination ||| mask_source)
  )


  /* Value replication and masked row writes.
     Empty row masks advance without a write-port booking; blocked rows never advance. */

  def replications = for List (format in 0..(vector_format_count(xlen) - 1)):
    [format, vec(for List (_ in 0..(vector_word_bytes(xlen) >> format)): value[0..(8 << format)]).as_bits()]

  def repeated = mux_lookup(eew, ~default: value, replications)
  def byte_mask = vec(
    for List (byte in 0..vector_word_bytes(xlen)):
      def element = ((row.zext(geometry_width) << vector_byte_offset_width(xlen)) + Bits(geometry_width)(byte)) >> eew
      def in_body = (element >= start.zext(geometry_width)) & (element < limit.zext(geometry_width))
      def mask_enabled = !instruction.masked ||| (mask_word >> element[0..vector_bit_offset_width(xlen)])[0].into(Bool)
      def enabled = in_body & mask_enabled
      mux(enabled, !Bits(8)(0), Bits(8)(0))
  ).as_bits()

  def has_enabled_bytes = byte_mask.any()
  def row_write_ready = !has_enabled_bytes ||| write_available
  def can_advance = value_valid & unfinished_row & mask_ready & !mask_waiting & !blocked_rows[address] & row_write_ready
  def next_row = row + Bits(Row.width)(1)
  def row_done = can_advance & (next_row === row_limit[0..Row.width])
  write.valid <== can_advance & has_enabled_bytes
  write.bits <== VectorRegisterWrite(xlen, vlen):
    address: address
    data: repeated
    mask: byte_mask


  /* Probe decision, delayed value, and final-row lifetime.
     Launch and decision take priority over later completion/progress events. */

  when (launch.valid):
    occupied <== Bool(#true)
    waiting <== Bool(#false)
    value_valid <== Bool(#false)
    lookup_pending <== Bool(#false)
    instruction <== launch.bits.descriptor
    instruction_owner <== launch.bits.context
  elsewhen (decision.valid):
    lookup_pending <== Bool(#false)
    def authorized = decision.bits.disposition === VectorDisposition.Authorized
    def failed_probe = decision.bits.disposition.is_one_of(VectorDisposition.Fault, VectorDisposition.Truncate)
    def masked_tail = authorized & !decision_first & decision_last
    when (failed_probe ||| masked_tail):
      occupied <== Bool(#false)

    when (authorized & decision_first & decision.bits.slow):
      waiting <== Bool(#true)
      response_tag <== decision.bits.tag

    when (authorized & decision_first & !decision.bits.slow):
      value <== decision.bits.data
      value_valid <== Bool(#true)
  elsewhen (completion.valid & waiting & (completion.bits.tag === response_tag)):
    value <== completion.bits.data
    value_valid <== Bool(#true)
    waiting <== Bool(#false)
  elsewhen (read_started.valid):
    lookup_pending <== Bool(#true)
  elsewhen (skipped.valid):
    lookup_pending <== Bool(#false)
  elsewhen row_done:
    occupied <== Bool(#false)
    value_valid <== Bool(#false)


  /* Mask cache and row cursor.
     These independent update chains may progress alongside value/probe bookkeeping. */

  when (launch.valid):
    mask_waiting <== Bool(#false)
    mask_cached <== Bool(#false)
  elsewhen (mask_read.valid):
    mask_waiting <== Bool(#true)
    mask_index <== needed_mask
  elsewhen (mask_result.valid & mask_waiting):
    mask_word <== mask_result.bits
    mask_cached <== Bool(#true)
    mask_waiting <== Bool(#false)

  when (launch.valid):
    def start_bytes = launch.bits.descriptor.state.vstart[0..index_width(vlen + 1)].zext(geometry_width) << launch.bits.descriptor.control.memory_data_eew
    row <== (start_bytes >> vector_byte_offset_width(xlen))[0..Row.width]
  elsewhen can_advance:
    row <== next_row

export VectorSplatLoad
