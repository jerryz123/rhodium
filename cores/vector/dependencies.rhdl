#lang rhodium
/* Computes conservative destination groups for pending vector read interlocks. */
// SPDX-License-Identifier: Apache-2.0

import:
  "bundles.rhdl" open
  "decode.rhdl" open
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/isa/vector.rhm" open
  "../../riscv/model/formats.rhm" as riscv_fields
  "../../riscv/rtl/instruction-fields.rhdl".instruction_field
  "../../riscv/rtl/vector.rhdl" open

/* Conservatively claims destination register groups until exact pending write rows are known. */
fun vector_destination_registers(xlen :: XLen, vlen :: VectorLength, descriptor :: VectorDescriptor(xlen)) :~ Bits(32):
  def control = descriptor.control
  def geometry = vector_type(xlen, vlen, descriptor.state.vtype)
  def memory = control.memory
  def fp_service = control.floating_point & control.fp_service
  def whole = memory & (control.memory_mode === VectorMemoryMode.WholeRegister)
  def mask = memory & (control.memory_mode === VectorMemoryMode.Mask)
  def indexed = control.memory_addressing.is_one_of(VectorMemoryAddressing.IndexedOrdered, VectorMemoryAddressing.IndexedUnordered)
  def memory_eew = mux(indexed, geometry.sew, control.memory_data_eew)

  /* Destination group geometry keeps signed EMUL arithmetic separate from
     the nonnegative register-count shift. Fractional groups claim one register. */

  def widened = (control.integer ||| control.multiply_divide ||| fp_service) & control.widening
  def memory_emul_adjustment = memory_eew.zext(5).into(SInt(5)) - geometry.sew.zext(5).into(SInt(5))
  def widening_adjustment = widened.as_bits().zext(5).into(SInt(5))
  def emul_adjustment = mux(memory, memory_emul_adjustment, widening_adjustment)
  def exponent = geometry.lmul.into(SInt(3)).sext(5) + emul_adjustment
  def group_shift = mux(exponent < SInt(5)(0), Bits(3)(0), exponent.as_bits()[0..3])
  def group = Bits(6)(1) << group_shift
  def fields = control.memory_nf.zext(6) + Bits(6)(1)

  /* Forms a selected field-count extent using constant elaboration-time repeated additions. */
  fun extent_for(n :: Nat) :~ Bits(6):
    def mutable total :: Bits(6) = group
    for (_ in 0..n):
      total := total + group

    total

  def extent = mux_lookup(control.memory_nf, ~default: group, for List (n in 1..8): [n, extent_for(n)])


  /* Register coverage follows whole-register, move, and singleton overrides
     before ordinary memory extent or compute group size. */

  def integer_singleton = control.integer & (control.mask_destination ||| control.reduction ||| control.element_move)
  def fp_service_singleton = fp_service & (control.mask_destination ||| control.reduction)
  def fp_move_singleton = control.floating_point & !control.fp_service & control.element_move
  def singleton = mask ||| integer_singleton ||| fp_service_singleton ||| fp_move_singleton
  def count = priority_mux(~default: group):
    whole: fields
    control.integer & control.whole_register_move: control.whole_register_count.zext(6)
    singleton: Bits(6)(1)
    memory: extent

  def writes = !(memory & control.store) & !(control.integer & control.scalar_destination) & !(control.floating_point & control.floating_scalar_destination)
  def vd = instruction_field(riscv_fields.rd, descriptor.instruction)
  vec(for List (r in 0..32): writes & (Bits(6)(r) >= vd.zext(6)) & (Bits(6)(r) < vd.zext(6) + count)).as_bits()

export vector_destination_registers
