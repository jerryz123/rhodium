#lang rhodium
/* Defines packed transport layouts and replay checkpoints shared by preparation and load
   assembly. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/vector-layout.rhm") open
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/isa/vector.rhm" open
  lib("rhodium/std/bits.rhdl").Pow2Int

/* Returns the byte capacity of one physical memory transport word. */
fun vector_transport_bytes(xlen :: XLen) :: PosInt:
  xlen.width / 8

/* Sizes operation identity for element progress plus up to eight segment fields. */
fun vector_sequence_width(vlen :: VectorLength) :: PosInt:
  index_width(vlen + 1) + 3

/* Captures element, field, byte, and aligned-address progress for exact packed retry. */
bundle VectorPackedCursor(xlen :: XLen, vlen :: VectorLength):
  address: Bits(xlen.width)
  element: Bits(index_width(vlen + 1))
  field: Bits(3)
  byte: Bits(vector_byte_offset_width(xlen))
  leading: Bits(vector_byte_offset_width(xlen))

/* Maps transport bytes to VRF rows/elements with before/after replay checkpoints. */
bundle VectorPackedLayout(xlen :: XLen, vlen :: VectorLength):
  before: VectorPackedCursor(xlen, vlen)
  after: VectorPackedCursor(xlen, vlen)
  rows: Vec(vector_transport_bytes(xlen), Bits(index_width(VectorRegisterLayout(vlen, xlen.width).depth)))
  offsets: Vec(vector_transport_bytes(xlen), Bits(vector_byte_offset_width(xlen)))
  elements: Vec(vector_transport_bytes(xlen), Bits(index_width(vlen + 1)))
  live: Bits(vector_transport_bytes(xlen))
  last: Bool

/* Retains one transport's byte enables, direction, layout, and instruction owner. */
bundle VectorPackedEntry(xlen :: XLen, vlen :: VectorLength, owners :: Pow2Int):
  sequence: Bits(vector_sequence_width(vlen))
  layout: VectorPackedLayout(xlen, vlen)
  mask: Bits(vector_transport_bytes(xlen))
  store: Bool
  segmented: Bool
  owner: Bits(index_width(owners))

/* Recognizes a complete, lane-aligned VRF row that needs no rotation or retained carry. */
fun vector_packed_direct_row(xlen :: XLen, vlen :: VectorLength, layout :: VectorPackedLayout(xlen, vlen), mask :: Bits(xlen.width / 8)) :~ Bool:
  def aligned = vec(
    for List (lane in 0..vector_transport_bytes(xlen)):
      (layout.rows[lane] === layout.rows[0]) & (layout.offsets[lane] === Bits(vector_byte_offset_width(xlen))(lane))
  ).as_bits().all()
  mask.all() & aligned

/* Associates a prepared transport with its persistent completion slot. */
bundle VectorPackedReservation(xlen :: XLen, vlen :: VectorLength, slots :: Pow2Int, owners :: Pow2Int):
  tag: Bits(index_width(slots))
  entry: VectorPackedEntry(xlen, vlen, owners)

export:
  vector_sequence_width
  vector_packed_direct_row
  VectorPackedCursor
  VectorPackedLayout
  VectorPackedEntry
  VectorPackedReservation
