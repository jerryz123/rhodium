#lang rhodium
// Defines fixed-priority arbiters and grant-certified ready-valid trace selection.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/ready-valid.rhdl") open
  lib("flow/ready-valid-support.rhdl") open

// Lower indices have priority. Since Valid has no backpressure, simultaneous
// lower-priority events are intentionally dropped instead of held for retry.
circuit ValidArbiter(T :: DataType, n :: PosInt):

  interface ingress[n](Valid(T), ~role: consumer)
  interface egress(Valid(T), ~role: producer)
  output chosen: Bits(index_width(n))

  def requests = vec(for List (index in 0..n): ingress[index].valid).into(Mask(n))
  def grant = priority_encoder_oh(requests)

  egress.valid <== grant.valid
  egress.bits <== grant.mux(
    for List (index in 0..n): ingress[index].bits,
    ~default: ingress[0].bits
  )
  chosen <== grant.index

// Lower indices have higher priority. The output uses Decoupled because a new
// higher-priority arrival may change the selected payload while stalled.
circuit Arbiter(T :: DataType, n :: PosInt):

  interface ingress[n](Decoupled(T), ~role: consumer)
  interface egress(Decoupled(T), ~role: producer)
  output chosen: Bits(index_width(n))

  def requests = vec(for List (index in 0..n): ingress[index].valid).into(Mask(n))
  def grant = priority_encoder_oh(requests)
  for (index in 0..n):
    ingress[index].ready <== egress.ready & grant[index]

  egress.valid <== grant.valid
  egress.bits <== grant.mux(
    for List (index in 0..n): ingress[index].bits,
    ~default: ingress[0].bits
  )
  chosen <== grant.index
  describe_interface_selection(for List (index in 0..n): grant[index])
  describe_interface_contract(ingress, egress, "data", ~kind: "arbiter", ~trace_model: interface_trace_selection())

// Lower indices have higher priority among payloadless token offers.
circuit CtrlArbiter(n :: PosInt):

  interface ingress[n](DecoupledCtrl(), ~role: consumer)
  interface egress(DecoupledCtrl(), ~role: producer)
  output chosen: Bits(index_width(n))

  def requests = vec(for List (index in 0..n): ingress[index].valid).into(Mask(n))
  def grant = priority_encoder_oh(requests)
  for (index in 0..n):
    ingress[index].ready <== egress.ready & grant[index]

  egress.valid <== grant.valid
  chosen <== grant.index

// A connected endpoint array supplies its input count. A disconnected
// topology starts from a payload type and states the count in arbiter.
fun arbiter(n :: False || PosInt = #false)
  :: ((source :: FlowSource || Array) -> InterfaceTransformResult(source, Endpoint)):
  fun (source :: FlowSource || Array) :~ InterfaceTransformResult(source, Endpoint):
    def inputs:
      if source is_a Handle | source.right | source
    def typed = !(inputs is_a Array)
    def input_count:
      if typed
      | block:
          unless n is_a PosInt
          | error(~who: #'arbiter,
                  "typed fixed-priority arbitration requires a positive input count")
          n
      | block:
          unless inputs.length() > 0
          | error(~who: #'arbiter,
                  "fixed-priority arbitration requires at least one input endpoint")
          if n
          | unless n == inputs.length()
            | error(~who: #'arbiter,
                    "configured input count does not match the endpoint array")
          | #void
          inputs.length()
    def T:
      if typed | source | flow_payload_type(inputs[0])
    inst arbiter_stage(Arbiter(T, input_count))
    finish_interface_transform(
      source,
      describe_interface_transform(
        InterfaceHandle(arbiter_stage.ingress, arbiter_stage.egress),
        "arbiter", {"inputs": input_count}, arbiter_stage
      )
    )

// A connected Valid endpoint array supplies its own input count. A
// disconnected topology starts from a payload type and states the count once.
fun valid_arbiter(n :: False || PosInt = #false)
  :: ((source :: FlowSource || Array) -> InterfaceTransformResult(source, Endpoint)):
  fun (source :: FlowSource || Array) :~ InterfaceTransformResult(source, Endpoint):
    def inputs:
      if source is_a Handle | source.right | source
    def typed = !(inputs is_a Array)
    def input_count:
      if typed
      | block:
          unless n is_a PosInt
          | error(~who: #'valid_arbiter,
                  "typed Valid arbitration requires a positive input count")
          n
      | block:
          unless inputs.length() > 0
          | error(~who: #'valid_arbiter,
                  "Valid arbitration requires at least one input endpoint")
          if n
          | unless n == inputs.length()
            | error(~who: #'valid_arbiter,
                    "configured input count does not match the endpoint array")
          | #void
          inputs.length()
    def T:
      if typed
      | valid_flow_payload_type(source)
      | valid_flow_payload_type(inputs[0])
    inst valid_arbiter_stage(ValidArbiter(T, input_count))
    finish_interface_transform(
      source,
      describe_interface_transform(
        InterfaceHandle(valid_arbiter_stage.ingress,
                        valid_arbiter_stage.egress),
        "valid-arbiter",
        {"inputs": input_count},
        valid_arbiter_stage
      )
    )

export:
  ValidArbiter
  valid_arbiter
  Arbiter
  arbiter
  CtrlArbiter
