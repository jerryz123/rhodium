#lang rhodium
// Defines inline filtering for nonbackpressured Valid flows.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/meta open
  lib("rhodium/std/ready-valid.rhdl") open
  lib("flow/ready-valid-support.rhdl") open

fun finish_filter_valid_handle(input_link :: Handle,
                               output_link :: Handle,
                               keep :: Bool):
  def input_endpoint = input_link.right
  def output_endpoint = output_link.left
  output_endpoint.field("valid") <== input_endpoint.field("valid") & keep
  output_endpoint.field("bits") <== input_endpoint.field("bits")
  describe_interface_transform(
    interface_transform(input_link, output_link),
    "filter-valid",
    ~trace_model: interface_trace_combinational(~guard: keep)
  )

// A rejected Valid event is dropped because the source cannot be
// backpressured. The payload is forwarded combinationally when retained.
expr.macro
| 'filter_valid($(payload :: Identifier) => $predicate ...)':
    'filter_valid($payload): $predicate ...'
| 'filter_valid($(payload :: Identifier)): $predicate':
    'filter_valid_impl(#false, $payload): $predicate'

expr.macro
| 'filter_valid_impl($payload_infos,
                     $(payload :: Identifier)): $predicate':
    'fun (filter_valid_source :: FlowSource) :~ InterfaceTransformResult(filter_valid_source, Endpoint):
       def filter_valid_protocol :: FlowSource.to_valid_protocol = filter_valid_source
       def filter_valid_input_link = interface_link(
         filter_valid_protocol,
         "filter_valid_input"
       )
       def filter_valid_input :: Endpoint = filter_valid_input_link.right
       def filter_valid_keep :: Bool = flow_payload_body(
         $payload_infos,
         $payload,
         filter_valid_input.bits
       ): $predicate
       def filter_valid_output_link = interface_link(
         filter_valid_protocol,
         "filter_valid_output"
       )
       def filter_valid_handle = finish_filter_valid_handle(
         filter_valid_input_link,
         filter_valid_output_link,
         filter_valid_keep
       )
       finish_interface_transform(filter_valid_source, filter_valid_handle)'

// Direct Valid pipelines retain the exact payload surface in the predicate.
immediate_callee.macro 'filter_valid $tail ...':
  ~static_infos: source_infoss
  def payload_infos = flow_payload_static_infos(source_infoss[0])
  match '$tail ...'
  | '($(payload :: Identifier) => $predicate ...) $rest ...':
      values(
        'filter_valid_impl($(payload_infos), $payload): $predicate ...',
        '$rest ...'
      )
  | '($(payload :: Identifier)): $predicate':
      values(
        'filter_valid_impl($(payload_infos), $payload): $predicate',
        ''
      )
  | ~else:
      syntax_meta.error("invalid filter_valid immediate pipeline form", '$tail ...')

export:
  filter_valid
