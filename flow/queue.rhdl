#lang rhodium
// Defines payload-bearing and control-only configurable ready-valid queues.

import:
  lib("rhodium/std/ready-valid.rhdl") open
  lib("rhodium/std/counter.rhdl") open
  lib("flow/ready-valid-support.rhdl") open

// Queue uses asynchronous-read storage. A synchronous-read option belongs here
// once Rhodium has a corresponding memory primitive. Stored payloads remain stable
// under backpressure.
sync_circuit Queue(T :: DataType,
                   depth :: PosInt,
                   ~pipe: pipe :: Boolean = #false,
                   ~flow: flow :: Boolean = #false):

  interface ingress(Decoupled(T), ~role: consumer)
  def Egress = if flow | Decoupled(T) | Irrevocable(T)
  interface egress(Egress, ~role: producer)
  output count: Bits(index_width(depth + 1))

  // Flow changes an empty queue into a combinational bypass. Pipe lets a full
  // queue replace the item being removed without inserting a bubble. These
  // host choices remove disabled paths from the elaborated hardware instead
  // of leaving constant-false dependencies for hierarchy analysis to follow.
  fun ready_for_input(full :: Bool):
    if pipe | (!full ||| egress.ready) | !full
  fun valid_for_output(empty :: Bool):
    if flow | (!empty ||| ingress.valid) | !empty
  fun bits_for_output(empty :: Bool, stored_bits :: Hardware.of(T)):
    if flow | mux(empty, ingress.bits, stored_bits) | stored_bits

  // A flow-through transfer does not touch storage, so internal enqueue and
  // dequeue events differ from the externally visible ready-valid handshakes.
  fun stores_input(empty :: Bool, ingress_ready :: Bool):
    if flow
    | ingress.valid & ingress_ready & !(empty & egress.ready)
    | ingress.valid & ingress_ready
  fun removes_output(empty :: Bool): !empty & egress.ready

  if (depth == 1)
  | block:
      reg occupied(~init: Bool(#false))
      reg payload(T)
      def empty = !occupied
      def input_ready = ready_for_input(occupied)
      def output_valid = valid_for_output(empty)
      def enqueue = stores_input(empty, input_ready)
      def dequeue = removes_output(empty)

      ingress.ready <== input_ready
      egress.valid <== output_valid
      egress.bits <== bits_for_output(empty, payload)
      count <== occupied.as_bits()

      when (enqueue ^ dequeue):
        occupied <== enqueue
      when (enqueue):
        payload <== ingress.bits
      describe_interface_queue_storage(depth, enqueue, dequeue, bits(0, 1), bits(0, 1), !empty, if flow | empty | Bool(#false))
      #void
  | block:
      def count_width = index_width(depth + 1)
      mem storage(depth, T)
      reg occupancy(~init: bits(0, count_width))
      def PointerCounter = Counter(depth)
      inst read_pointer(PointerCounter)
      inst write_pointer(PointerCounter)

      def empty = !or_reduce(occupancy)
      def full = occupancy === bits(depth, count_width)
      // Detects an encoded count beyond the queue's physical capacity.
      assert(occupancy <= bits(depth, count_width),
             "queue_occupancy_in_range")
      def input_ready = ready_for_input(full)
      def output_valid = valid_for_output(empty)
      def stored_bits = storage[read_pointer.value]
      def enqueue = stores_input(empty, input_ready)
      def dequeue = removes_output(empty)

      ingress.ready <== input_ready
      egress.valid <== output_valid
      egress.bits <== bits_for_output(empty, stored_bits)
      count <== occupancy
      storage.write(write_pointer.value, ingress.bits, ~enable: enqueue)

      read_pointer.enable <== dequeue
      write_pointer.enable <== enqueue
      when (enqueue ^ dequeue):
        occupancy <== mux(
          enqueue,
          occupancy + bits(1, count_width),
          occupancy - bits(1, count_width)
        )
      describe_interface_queue_storage(depth, enqueue, dequeue, read_pointer.value, write_pointer.value, !empty, if flow | empty | Bool(#false))
      #void

// Tokens are indistinguishable, so the control-only queue needs occupancy
// state but no payload memory or read/write pointers.
sync_circuit CtrlQueue(depth :: PosInt,
                       ~pipe: pipe :: Boolean = #false,
                       ~flow: flow :: Boolean = #false):

  interface ingress(DecoupledCtrl(), ~role: consumer)
  def Egress = if flow | DecoupledCtrl() | IrrevocableCtrl()
  interface egress(Egress, ~role: producer)
  output count: Bits(index_width(depth + 1))

  fun ready_for_input(full :: Bool):
    if pipe | (!full ||| egress.ready) | !full
  fun valid_for_output(empty :: Bool):
    if flow | (!empty ||| ingress.valid) | !empty
  fun stores_input(empty :: Bool, ingress_ready :: Bool):
    if flow
    | ingress.valid & ingress_ready & !(empty & egress.ready)
    | ingress.valid & ingress_ready
  fun removes_output(empty :: Bool): !empty & egress.ready

  if (depth == 1)
  | block:
      reg occupied(~init: Bool(#false))
      def empty = !occupied
      def input_ready = ready_for_input(occupied)
      def enqueue = stores_input(empty, input_ready)
      def dequeue = removes_output(empty)

      ingress.ready <== input_ready
      egress.valid <== valid_for_output(empty)
      count <== occupied.as_bits()

      when (enqueue ^ dequeue):
        occupied <== enqueue
      #void
  | block:
      def count_width = index_width(depth + 1)
      reg occupancy(~init: bits(0, count_width))
      def empty = !or_reduce(occupancy)
      def full = occupancy === bits(depth, count_width)
      // The payloadless specialization obeys the same capacity invariant.
      assert(occupancy <= bits(depth, count_width),
             "ctrl_queue_occupancy_in_range")
      def input_ready = ready_for_input(full)
      def enqueue = stores_input(empty, input_ready)
      def dequeue = removes_output(empty)

      ingress.ready <== input_ready
      egress.valid <== valid_for_output(empty)
      count <== occupancy

      when (enqueue ^ dequeue):
        occupancy <== mux(
          enqueue,
          occupancy + bits(1, count_width),
          occupancy - bits(1, count_width)
        )
      #void
// Instantiates a queue in the ambient sync domain and returns its downstream
// endpoint. Use an explicit Queue instance when count must remain accessible.
fun queue(depth :: PosInt,
          ~pipe: pipe_enabled :: Boolean = #false,
          ~flow: flow_enabled :: Boolean = #false)
  :: ((source :: FlowSourceArgument) -> InterfaceTransformResult(source, Endpoint)):
  fun (source :~ FlowSource) :~ InterfaceTransformResult(source, Endpoint):
    def T = flow_payload_type(source)
    def QueueModule = Queue(T,
                            depth,
                            ~pipe: pipe_enabled,
                            ~flow: flow_enabled)
    inst queue_stage(QueueModule)
    finish_interface_transform(
      source,
      describe_interface_transform(
        InterfaceHandle(queue_stage.ingress, queue_stage.egress),
        "queue",
        {"depth": depth, "pipe": pipe_enabled, "flow": flow_enabled},
        queue_stage,
        ~trace_model: interface_trace_queue(queue_stage)
      )
    )

// Configures the payloadless token FIFO in the ambient sync domain.
fun ctrl_queue(depth :: PosInt,
               ~pipe: pipe_enabled :: Boolean = #false,
               ~flow: flow_enabled :: Boolean = #false)
  :: ((source :: FlowSourceArgument) -> InterfaceTransformResult(source, Endpoint)):
  fun (source :~ FlowSource) :~ InterfaceTransformResult(source, Endpoint):
    ctrl_flow_protocol_type(source)
    def CtrlQueueModule = CtrlQueue(depth,
                                    ~pipe: pipe_enabled,
                                    ~flow: flow_enabled)
    inst ctrl_queue_stage(CtrlQueueModule)
    finish_interface_transform(
      source,
      describe_interface_transform(
        InterfaceHandle(ctrl_queue_stage.ingress, ctrl_queue_stage.egress),
        "ctrl-queue",
        {"depth": depth, "pipe": pipe_enabled, "flow": flow_enabled},
        ctrl_queue_stage,
        ~trace_model: interface_trace_passthrough()
      )
    )

export:
  Queue
  queue
  CtrlQueue
  ctrl_queue
