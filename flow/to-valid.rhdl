#lang rhodium
// Converts an always-accepted ready-valid flow into same-cycle Valid events.

import:
  lib("rhodium/std/ready-valid.rhdl") open
  lib("flow/ready-valid-support.rhdl") open

fun to_valid()
  :: ((source :: FlowSource) -> InterfaceTransformResult(source, Endpoint)):
  fun (source :: FlowSource) :~ InterfaceTransformResult(source, Endpoint):
    def input_protocol = flow_protocol_type(source)
    def input_link = interface_link(input_protocol, "to_valid_input")
    def input_endpoint = input_link.right
    def output_link = interface_link(
      Valid(flow_payload_type(source)),
      "to_valid_output"
    )
    def output_endpoint = output_link.left
    input_endpoint.field("ready") <== Bool(#true)
    output_endpoint.field("valid") <== input_endpoint.field("valid")
    output_endpoint.field("bits") <== input_endpoint.field("bits")
    finish_interface_transform(
      source,
      describe_interface_transform(
        interface_transform(input_link, output_link),
        "to-valid",
        ~trace_model: interface_trace_combinational()
      )
    )

export:
  to_valid
