#lang rhodium
/* Converts ready-valid offers or observes accepted transfers as same-cycle events. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/ready-valid.rhdl") open
  lib("flow/ready-valid-support.rhdl") open

/* Configures an always-ready sink that forwards every input offer as a
   same-cycle Valid occurrence, with no buffering or downstream backpressure. */
fun to_valid()
  :: ((source :: FlowSource) -> InterfaceTransformResult(source, Endpoint)):
  fun (source :: FlowSource) :~ InterfaceTransformResult(source, Endpoint):
    def input_protocol :: FlowSource.to_ready_valid_protocol = source
    def input_link = interface_link(input_protocol, "to_valid_input")
    def input_endpoint = input_link.right
    def output_link = interface_link(
      Valid(flow_payload_type(source)),
      "to_valid_output"
    )
    def output_endpoint = output_link.left
    input_endpoint.field("ready") <== Bool(#true)
    output_endpoint.field("valid") <== input_endpoint.field("valid")
    output_endpoint.field("bits") <== input_endpoint.field("bits")
    finish_interface_transform(
      source,
      describe_interface_transform(
        interface_transform(input_link, output_link),
        "to-valid",
        ~trace_model: interface_trace_combinational()
      )
    )

/* Taps the actual handshake, preserving the receiver's exclusive control of
   ready. Payload channels yield Valid(T) and control channels yield Pulse. */
fun observe_transfer(source :: Endpoint.supports(DecoupledCtrl())) :~ Endpoint:
  def payload = decoupled_protocol_type(source.type)
  unless payload | ctrl_endpoint(source)
  def events = interface_link(if payload | Valid(decoupled_payload_type(source)) | Pulse(),
                              "observed_transfer")
  events.left.valid <== fire(source)
  if payload
  | events.left.bits <== source.field("bits")
  | #void
  describe_interface_observation(source, events.right)
  events.right

export:
  to_valid
  observe_transfer
