#lang rhodium
// Preserves flow-named aliases for the generic interface boundary operations.

fun flow_fields(~& bindings :: Map):
  interface_fields(~& bindings)

fun inject_flow(type :: InterfaceType, ~& bindings :: Map) :: Endpoint:
  inject_interface(type, ~& bindings)

fun eject_flow(~& bindings :: Map):
  eject_interface(~& bindings)

export:
  flow_fields
  inject_flow
  eject_flow
