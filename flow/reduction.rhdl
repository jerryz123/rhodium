#lang rhodium
// Builds shared balanced Boolean reductions for all-except-one flow conditions.

import:
  lib("rhodium/std/reduction.rhdl").tree_reduce

class AndReductionNode(value :: Bool,
                       left :: False || AndReductionNode,
                       right :: False || AndReductionNode)

bundle AndExclusionReduction(n :: PosInt):
  all: Bool
  except: Vec(n, Bool)

fun build_and_reduction_tree(input_values :: List) :: AndReductionNode:
  tree_reduce(
    input_values.map(
      fun (value): AndReductionNode(value, #false, #false)
    ),
    fun (left :: AndReductionNode, right :: AndReductionNode):
      AndReductionNode(left.value & right.value, left, right)
  )

fun distribute_and_exclusions(node :: AndReductionNode, outside :: Bool):
  if !node.left
  | [outside]
  | distribute_and_exclusions(node.left, outside & node.right.value) ++ (
      distribute_and_exclusions(node.right, outside & node.left.value)
    )

// Returns the full conjunction and one conjunction per omitted input. A
// balanced up-sweep/down-sweep shares work between every result, giving linear
// hardware size and logarithmic logic depth.
fun and_exclusion_reduce(input_values :: Hardware.packable) :~ Hardware.packable:
  def input_type = hardware_value_type(input_values)
  unless input_type is_a VectorType && bool_type(input_type.element_type)
  | error(~who: #'and_exclusion_reduce,
          "values must be a nonempty Vec of Bool")
  def elements = for List (index in 0..input_type.length): input_values[index]
  def tree = build_and_reduction_tree(elements)
  AndExclusionReduction(input_type.length):
    all: tree.value
    except: vec(distribute_and_exclusions(tree, Bool(#true)))

export:
  AndExclusionReduction
  and_exclusion_reduce
