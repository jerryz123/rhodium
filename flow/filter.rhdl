#lang rhodium
// Defines inline ready-valid filtering that consumes rejected payloads.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/meta open
  lib("rhodium/std/ready-valid.rhdl") open
  lib("flow/ready-valid-support.rhdl") open

// Filtering may depend on live sideband state, so its output is conservatively
// Decoupled even when its input is Irrevocable. A rejected token is consumed
// without waiting for downstream readiness.
fun finish_filter_flow_handle(input_link :: Handle,
                              output_link :: Handle,
                              keep :: Bool):
  def input_endpoint = input_link.right
  def output_endpoint = output_link.left
  output_endpoint.field("valid") <== input_endpoint.field("valid") & keep
  output_endpoint.field("bits") <== input_endpoint.field("bits")
  input_endpoint.field("ready") <== !keep ||| output_endpoint.field("ready")
  describe_interface_transform(
    interface_transform(input_link, output_link),
    "filter",
    ~trace_model: interface_trace_combinational(~guard: keep)
  )

expr.macro
| 'filter_flow($(payload :: Identifier) => $predicate ...)':
    'filter_flow($payload): $predicate ...'
| 'filter_flow($(payload :: Identifier)): $predicate':
    'filter_flow_impl(#false, $payload): $predicate'

expr.macro
| 'filter_flow_impl($payload_infos,
                    $(payload :: Identifier)): $predicate':
    'fun (filter_flow_source :: FlowSource) :~ InterfaceTransformResult(filter_flow_source, Endpoint):
       def filter_flow_protocol :: FlowSource.to_ready_valid_protocol = filter_flow_source
       def filter_flow_input_link = interface_link(
         filter_flow_protocol,
         "filter_input"
       )
       def filter_flow_input :: Endpoint = filter_flow_input_link.right
       def filter_flow_keep :: Bool = flow_payload_body(
         $payload_infos,
         $payload,
         filter_flow_input.bits
       ): $predicate
       def filter_flow_output_link = interface_link(
         Decoupled(flow_payload_type(filter_flow_source)),
         "filter_output"
       )
       def filter_flow_handle = finish_filter_flow_handle(
         filter_flow_input_link,
         filter_flow_output_link,
         filter_flow_keep
       )
       finish_interface_transform(filter_flow_source, filter_flow_handle)'

// Direct pipelines retain the precise payload surface inside the predicate.
immediate_callee.macro 'filter_flow $tail ...':
  ~static_infos: source_infoss
  def payload_infos = flow_payload_static_infos(source_infoss[0])
  match '$tail ...'
  | '($(payload :: Identifier) => $predicate ...) $rest ...':
      values(
        'filter_flow_impl($(payload_infos), $payload): $predicate ...',
        '$rest ...'
      )
  | '($(payload :: Identifier)): $predicate':
      values(
        'filter_flow_impl($(payload_infos), $payload): $predicate',
        ''
      )
  | ~else:
      syntax_meta.error("invalid filter_flow immediate pipeline form", '$tail ...')

export:
  filter_flow
