def direct_arbiter_compiled = compile_program(elaborate(arbiter.Arbiter(Bits(8), 1)), rtl_target)
def direct_valid_arbiter_compiled = compile_program(elaborate(arbiter.ValidArbiter(Bits(8), 1)), rtl_target)
def direct_rr_arbiter_compiled = compile_program(elaborate(rr_arbiter.RRArbiter(Bits(8), 1)), rtl_target)
def direct_demux_compiled = compile_program(elaborate(demux.Demux(Bits(8), 1)), rtl_target)
def direct_matcher_compiled = compile_program(elaborate(matcher.GreedyMatcher(1, 1)), rtl_target)
def direct_output_greedy_matcher_compiled = compile_program(elaborate(matcher.OutputGreedyRoundRobinMatcher(1, 1)), rtl_target)
def direct_grant_demux_compiled = compile_program(elaborate(grant.GrantDemux(Bits(8), 1)), rtl_target)
def direct_grant_merge_compiled = compile_program(elaborate(grant.GrantMerge(Bits(8), 1)), rtl_target)
def direct_crossbar_compiled = compile_program(elaborate(crossbar.GrantCrossbar(Bits(8), 1, 1)), rtl_target)
def direct_join_compiled = compile_program(elaborate(join.Join(Bits(8), 1)), rtl_target)
def direct_broadcast_compiled = compile_program(elaborate(broadcast.Broadcast(Bits(8), 1)), rtl_target)
def direct_atomic_fork_compiled = compile_program(elaborate(atomic_fork.AtomicFork(Bits(8), 1)), rtl_target)
def direct_ctrl_pipe_compiled = compile_program(elaborate(pipe.CtrlPipe(1)), rtl_target)
def direct_ctrl_queue_compiled = compile_program(elaborate(queue.CtrlQueue(1)), rtl_target)
def direct_ctrl_arbiter_compiled = compile_program(elaborate(arbiter.CtrlArbiter(1)), rtl_target)
def direct_ctrl_rr_arbiter_compiled = compile_program(elaborate(rr_arbiter.CtrlRRArbiter(1)), rtl_target)
def direct_ctrl_demux_compiled = compile_program(elaborate(demux.CtrlDemux(1)), rtl_target)
def direct_ctrl_join_compiled = compile_program(elaborate(join.CtrlJoin(1)), rtl_target)
def direct_ctrl_broadcast_compiled = compile_program(elaborate(broadcast.CtrlBroadcast(1)), rtl_target)
def direct_ctrl_atomic_fork_compiled = compile_program(elaborate(atomic_fork.CtrlAtomicFork(1)), rtl_target)

def pipe_one_design = compile_program(elaborate(flow.Pipe(Bits(8), 1)), rtl_target).report.design
def pipe_one = pipe_one_design.modules[0]
def pipe_three_design = compile_program(elaborate(flow.Pipe(Bits(16), 3)), rtl_target).report.design
def pipe_three = pipe_three_design.modules[0]
def valid_pipe_one_design = compile_program(elaborate(flow.ValidPipe(Bits(8), 1)), rtl_target).report.design
def valid_pipe_one = valid_pipe_one_design.modules[0]
def valid_pipe_three_design = compile_program(elaborate(flow.ValidPipe(Bits(16), 3)), rtl_target).report.design
def valid_pipe_three = valid_pipe_three_design.modules[0]
def queue_one_design = compile_program(elaborate(flow.Queue(Bits(8), 1)), rtl_target).report.design
def queue_one = queue_one_design.modules[0]
def queue_three_design = compile_program(elaborate(flow.Queue(Bits(8), 3)), rtl_target).report.design
def queue_three = queue_three_design.modules[0]
def queue_three_pointer_counter = queue_three_design.modules[1]
def queue_pipe_compiled = compile_program(elaborate(flow.Queue(Bits(8), 2, ~pipe: #true)), rtl_target)
def queue_flow_compiled = compile_program(elaborate(flow.Queue(Bits(8), 2, ~flow: #true)), rtl_target)
def queue_options_design = compile_program(elaborate(flow.Queue(Bits(8), 2, ~pipe: #true, ~flow: #true)), rtl_target).report.design
def queue_options = queue_options_design.modules[0]
def arbiter_one_design = compile_program(elaborate(flow.Arbiter(Bits(8), 1)), rtl_target).report.design
def arbiter_one = arbiter_one_design.modules[0]
def valid_arbiter_three_design = compile_program(elaborate(flow.ValidArbiter(Bits(8), 3)), rtl_target).report.design
def valid_arbiter_three = valid_arbiter_three_design.modules[0]
def arbiter_three_design = compile_program(elaborate(flow.Arbiter(Bits(8), 3)), rtl_target).report.design
def arbiter_three = arbiter_three_design.modules[0]
