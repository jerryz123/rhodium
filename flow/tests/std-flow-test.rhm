def output_greedy_matcher_design = compile_program(elaborate(flow.OutputGreedyRoundRobinMatcher(3, 2)), rtl_target).report.design
def output_greedy_matcher_module = output_greedy_matcher_design.modules[0]
def grant_demux_design = compile_program(elaborate(flow.GrantDemux(Bits(8), 3)), rtl_target).report.design
def grant_demux_module = grant_demux_design.modules[0]
def grant_merge_design = compile_program(elaborate(flow.GrantMerge(Bits(8), 3)), rtl_target).report.design
def grant_merge_module = grant_merge_design.modules[0]
def crossbar_design = compile_program(elaborate(flow.GrantCrossbar(Bits(8), 2, 3)), rtl_target).report.design
def crossbar_module = crossbar_design.modules[0]
def join_three_design = compile_program(elaborate(flow.Join(Bits(8), 3)), rtl_target).report.design
def join_three = join_three_design.modules[0]
def broadcast_three_design = compile_program(elaborate(flow.Broadcast(Bits(8), 3)), rtl_target).report.design
def broadcast_three = broadcast_three_design.modules[0]
