#lang rhombus
// Checks standard flow generators, internal invariants, parameters, and public IR shape.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/rtl.rhm").rtl_target
  lib("rhodium/compile/program.rhm").compile_program
  "../../rhodium/core/main.rhm" open
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../rhodium/frontend/layers/bool.rhm" as bool
  "../../flow/main.rhdl" as flow
  "../../flow/pipe.rhdl" as pipe
  "../../flow/offer-register.rhdl" as offer_register
  "../../flow/queue.rhdl" as queue
  "../../flow/arbiter.rhdl" as arbiter
  "../../flow/rr-arbiter.rhdl" as rr_arbiter
  "../../flow/demux.rhdl" as demux
  "../../flow/matcher.rhdl" as matcher
  "../../flow/grant.rhdl" as grant
  "../../flow/crossbar.rhdl" as crossbar
  "../../flow/join.rhdl" as join
  "../../flow/broadcast.rhdl" as broadcast
  "../../flow/atomic-fork.rhdl" as atomic_fork

// The aggregate and focused modules are both supported public import paths.
def direct_pipe_compiled = compile_program(elaborate(pipe.Pipe(Bits(8), 1)), rtl_target)
def direct_valid_pipe_compiled = compile_program(elaborate(pipe.ValidPipe(Bits(8), 1)), rtl_target)
