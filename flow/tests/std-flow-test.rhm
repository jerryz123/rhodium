def atomic_fork_three = atomic_fork_three_design.modules[0]
def ctrl_pipe_three_design = compile_program(elaborate(flow.CtrlPipe(3)), rtl_target).report.design
def ctrl_pipe_three = ctrl_pipe_three_design.modules[0]
def ctrl_queue_one_design = compile_program(elaborate(flow.CtrlQueue(1)), rtl_target).report.design
def ctrl_queue_one = ctrl_queue_one_design.modules[0]
def ctrl_queue_three_design = compile_program(elaborate(flow.CtrlQueue(3)), rtl_target).report.design
def ctrl_queue_three = ctrl_queue_three_design.modules[0]
