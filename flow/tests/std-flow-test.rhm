def ctrl_arbiter_three_design = compile_program(elaborate(flow.CtrlArbiter(3)), rtl_target).report.design
def ctrl_arbiter_three = ctrl_arbiter_three_design.modules[0]
def ctrl_rr_arbiter_three_design = compile_program(elaborate(flow.CtrlRRArbiter(3)), rtl_target).report.design
def ctrl_rr_arbiter_three = ctrl_rr_arbiter_three_design.modules[0]
def ctrl_demux_three_design = compile_program(elaborate(flow.CtrlDemux(3)), rtl_target).report.design
def ctrl_demux_three = ctrl_demux_three_design.modules[0]
def ctrl_join_three_design = compile_program(elaborate(flow.CtrlJoin(3)), rtl_target).report.design
def ctrl_join_three = ctrl_join_three_design.modules[0]
def ctrl_broadcast_three_design = compile_program(elaborate(flow.CtrlBroadcast(3)), rtl_target).report.design
def ctrl_broadcast_three = ctrl_broadcast_three_design.modules[0]
def ctrl_atomic_fork_three_design = compile_program(elaborate(flow.CtrlAtomicFork(3)), rtl_target).report.design
def ctrl_atomic_fork_three = ctrl_atomic_fork_three_design.modules[0]
def aggregate_type = RecordType([
  RecordField("tag", Bits(2)),
  RecordField("data", Bits(8))
])
def aggregate_pipe_compiled = compile_program(elaborate(flow.Pipe(aggregate_type, 2)), rtl_target)
def aggregate_queue_compiled = compile_program(elaborate(flow.Queue(aggregate_type, 2)), rtl_target)
def aggregate_arbiter_compiled = compile_program(elaborate(flow.Arbiter(aggregate_type, 2)), rtl_target)
def aggregate_rr_arbiter_compiled = compile_program(elaborate(flow.RRArbiter(aggregate_type, 2)), rtl_target)
def aggregate_demux_compiled = compile_program(elaborate(flow.Demux(aggregate_type, 2)), rtl_target)
def aggregate_crossbar_compiled = compile_program(elaborate(flow.GrantCrossbar(aggregate_type, 2, 2)), rtl_target)
def aggregate_join_compiled = compile_program(elaborate(flow.Join(aggregate_type, 2)), rtl_target)
def aggregate_broadcast_compiled = compile_program(elaborate(flow.Broadcast(aggregate_type, 2)), rtl_target)
def aggregate_atomic_fork_compiled = compile_program(elaborate(flow.AtomicFork(aggregate_type, 2)), rtl_target)

fun operations(module_def, opcode):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == opcode
  )

fun assertion_labels(module_def):
  operations(module_def, "verif.assert").map(
    fun (operation): operation.attribute("label")
  )

check:
  direct_pipe_compiled.has_errors ~is #false
  direct_valid_pipe_compiled.has_errors ~is #false
  direct_offer_register_compiled.has_errors ~is #false
  direct_queue_compiled.has_errors ~is #false
  direct_arbiter_compiled.has_errors ~is #false
  direct_valid_arbiter_compiled.has_errors ~is #false
  direct_rr_arbiter_compiled.has_errors ~is #false
  direct_demux_compiled.has_errors ~is #false
  direct_matcher_compiled.has_errors ~is #false
  direct_output_greedy_matcher_compiled.has_errors ~is #false
  direct_grant_demux_compiled.has_errors ~is #false
  direct_grant_merge_compiled.has_errors ~is #false
  direct_crossbar_compiled.has_errors ~is #false
  direct_join_compiled.has_errors ~is #false
  direct_broadcast_compiled.has_errors ~is #false
  direct_atomic_fork_compiled.has_errors ~is #false
  direct_ctrl_pipe_compiled.has_errors ~is #false
  direct_ctrl_queue_compiled.has_errors ~is #false
  direct_ctrl_arbiter_compiled.has_errors ~is #false
  direct_ctrl_rr_arbiter_compiled.has_errors ~is #false
  direct_ctrl_demux_compiled.has_errors ~is #false
  direct_ctrl_join_compiled.has_errors ~is #false
  direct_ctrl_broadcast_compiled.has_errors ~is #false
  direct_ctrl_atomic_fork_compiled.has_errors ~is #false

  pipe_one.inputs.map(fun (port): port.name) ~is [
    "clock", "reset", "ingress_in", "egress_in"
  ]
  pipe_one.outputs.map(fun (port): port.name) ~is [
    "ingress_out", "egress_out"
  ]
  operations(pipe_one, "rtl.register_reset").length() ~is 1
  operations(pipe_one, "rtl.register").length() ~is 1
  operations(pipe_three, "rtl.register_reset")[0].results[0].type.length ~is 3
  operations(pipe_three, "rtl.register")[0].results[0].type.length ~is 3

  valid_pipe_one.inputs.map(fun (port): port.name) ~is [
    "clock", "reset", "ingress_in"
  ]
  valid_pipe_one.outputs.map(fun (port): port.name) ~is ["egress_out"]
  valid_pipe_one.find_output("egress_out").type.fields.map(
    fun (field): field.name
  ) ~is ["valid", "bits"]
  operations(valid_pipe_one, "rtl.register_reset").length() ~is 1
  operations(valid_pipe_one, "rtl.register").length() ~is 1
  operations(valid_pipe_three, "rtl.register_reset")[0].results[0].type.length ~is 3
  operations(valid_pipe_three, "rtl.register")[0].results[0].type.length ~is 3

  queue_one.memories.length() ~is 0
  operations(queue_one, "rtl.register_reset").length() ~is 1
  operations(queue_one, "rtl.register").length() ~is 1
  queue_three.memories[0].depth ~is 3
  operations(queue_three, "rtl.memory_read_async").length() ~is 1
  operations(queue_three, "rtl.memory_write").length() ~is 1
  operations(queue_three, "rtl.register_reset").length() ~is 1
  operations(queue_three, "rtl.instance").length() ~is 2
  assertion_labels(queue_one) ~is []
  assertion_labels(queue_three) ~is ["queue_occupancy_in_range"]
  queue_three_design.modules.length() ~is 2
  queue_three_pointer_counter.name ~is "Counter"
  queue_three_pointer_counter.find_output("value").type.width ~is 2
  operations(queue_three_pointer_counter, "rtl.register_reset").length() ~is 1
  assertion_labels(queue_three_pointer_counter) ~is ["counter_state_in_range"]
  queue_one.find_output("count").type.width ~is 1
  queue_three.find_output("count").type.width ~is 2
  queue_options.inputs.map(fun (port): port.name) ~is [
    "clock", "reset", "ingress_in", "egress_in"
  ]
  queue_options.outputs.map(fun (port): port.name) ~is [
    "ingress_out", "egress_out", "count"
  ]

  arbiter_one.find_output("chosen").type.width ~is 1
  valid_arbiter_three.inputs.map(fun (port): port.name) ~is [
    "ingress_0_in", "ingress_1_in", "ingress_2_in"
  ]
  valid_arbiter_three.outputs.map(fun (port): port.name) ~is [
    "egress_out", "chosen"
  ]
  valid_arbiter_three.find_output("chosen").type.width ~is 2
  arbiter_three.inputs.map(fun (port): port.name) ~is [
    "ingress_0_in", "ingress_1_in", "ingress_2_in", "egress_in"
  ]
  arbiter_three.outputs.map(fun (port): port.name) ~is [
    "ingress_0_out", "ingress_1_out", "ingress_2_out", "egress_out", "chosen"
  ]
  arbiter_three.find_output("chosen").type.width ~is 2

  rr_arbiter_three.inputs.map(fun (port): port.name) ~is [
    "clock", "reset", "ingress_0_in", "ingress_1_in", "ingress_2_in", "egress_in"
  ]
  rr_arbiter_three.find_output("chosen").type.width ~is 2
  assertion_labels(rr_arbiter_three) ~is ["rr_priority_in_range"]
  operations(rr_arbiter_three, "rtl.register_reset").length() ~is 1
  operations(rr_arbiter_three, "rtl.instance").length() ~is 0
  operations(rr_arbiter_three, "rtl.onehot_mux").length() ~is 1

  demux_three.inputs.map(fun (port): port.name) ~is [
    "ingress_in", "select", "egress_0_in", "egress_1_in", "egress_2_in"
  ]
  demux_three.outputs.map(fun (port): port.name) ~is [
    "ingress_out", "egress_0_out", "egress_1_out", "egress_2_out"
  ]

  matcher_module.find_input("requests").type.length ~is 2
  matcher_module.find_input("requests").type.element_type.length ~is 3
  bool.bool_type(
    matcher_module.find_input("requests").type.element_type.element_type
  ) ~is #true
  matcher_module.find_output("grants").type.length ~is 2
  matcher_module.find_output("grants").type.element_type.length ~is 3
  bool.bool_type(
    matcher_module.find_output("grants").type.element_type.element_type
  ) ~is #true
  operations(matcher_module, "rtl.register_reset").length() ~is 0
  operations(matcher_module, "rtl.register").length() ~is 0

  output_greedy_matcher_module.inputs.map(fun (port): port.name) ~is [
    "clock", "reset", "requests", "accepts"
  ]
  output_greedy_matcher_module.find_input("requests").type.length ~is 3
  output_greedy_matcher_module.find_input("requests").type.element_type.length ~is 2
  output_greedy_matcher_module.find_input("accepts").type.length ~is 2
  output_greedy_matcher_module.find_output("grants").type.length ~is 3
  output_greedy_matcher_module.find_output("grants").type.element_type.length ~is 2
  assertion_labels(output_greedy_matcher_module) ~is [
    "output_greedy_round_robin_matcher_priority_in_range_0",
    "output_greedy_round_robin_matcher_priority_in_range_1"
  ]
  operations(output_greedy_matcher_module, "rtl.register_reset").length() ~is 1
  operations(output_greedy_matcher_module, "rtl.register").length() ~is 0

  grant_demux_module.inputs.map(fun (port): port.name) ~is [
    "ingress_in", "grants",
    "egress_0_in", "egress_1_in", "egress_2_in"
  ]
  grant_demux_module.outputs.map(fun (port): port.name) ~is [
    "ingress_out", "egress_0_out", "egress_1_out", "egress_2_out"
  ]
  bool.maybe_one_hot_type(grant_demux_module.find_input("grants").type) ~is #true
  bool.maybe_one_hot_width(grant_demux_module.find_input("grants").type) ~is 3
  grant_merge_module.inputs.map(fun (port): port.name) ~is [
    "ingress_0_in", "ingress_1_in", "ingress_2_in", "grants", "egress_in"
  ]
  grant_merge_module.outputs.map(fun (port): port.name) ~is [
    "ingress_0_out", "ingress_1_out", "ingress_2_out", "egress_out"
  ]
  bool.maybe_one_hot_type(grant_merge_module.find_input("grants").type) ~is #true
  bool.maybe_one_hot_width(grant_merge_module.find_input("grants").type) ~is 3
  operations(grant_merge_module, "rtl.onehot_mux").length() ~is 1

  crossbar_module.inputs.map(fun (port): port.name) ~is [
    "ingress_0_in", "ingress_1_in", "grants",
    "egress_0_in", "egress_1_in", "egress_2_in"
  ]
  crossbar_module.outputs.map(fun (port): port.name) ~is [
    "ingress_0_out", "ingress_1_out",
    "egress_0_out", "egress_1_out", "egress_2_out"
  ]
  crossbar_module.find_input("grants").type.element_type.length ~is 3
  bool.bool_type(
    crossbar_module.find_input("grants").type.element_type.element_type
  ) ~is #true
  operations(crossbar_module, "rtl.register_reset").length() ~is 0
  operations(crossbar_module, "rtl.register").length() ~is 0
  operations(crossbar_module, "rtl.instance").length() ~is 5

  join_three.find_output("egress_out").type.field("bits").type.length ~is 3
  join_three.find_output("egress_out").type.field("bits").type.element_type.width ~is 8

  broadcast_three.inputs.map(fun (port): port.name) ~is [
    "clock", "reset", "ingress_in", "egress_0_in", "egress_1_in", "egress_2_in"
  ]
  operations(broadcast_three, "rtl.register_reset").length() ~is 1
  operations(broadcast_three, "rtl.register").length() ~is 1

  // Control-only modules expose only valid/ready protocol fields and avoid
  // payload registers, memories, and pointer instances.
  ctrl_pipe_three.find_output("egress_out").type.fields.map(
    fun (field): field.name
  ) ~is ["valid"]
  operations(ctrl_pipe_three, "rtl.register_reset").length() ~is 1
  operations(ctrl_pipe_three, "rtl.register").length() ~is 0
  operations(ctrl_pipe_three, "rtl.register_reset")[0].results[0].type.length ~is 3

  ctrl_queue_one.memories.length() ~is 0
  operations(ctrl_queue_one, "rtl.register_reset").length() ~is 1
  operations(ctrl_queue_one, "rtl.register").length() ~is 0
  ctrl_queue_three.memories.length() ~is 0
  operations(ctrl_queue_three, "rtl.instance").length() ~is 0
  operations(ctrl_queue_three, "rtl.register_reset").length() ~is 1
  operations(ctrl_queue_three, "rtl.register").length() ~is 0
  ctrl_queue_three.find_output("count").type.width ~is 2
  assertion_labels(ctrl_queue_one) ~is []
  assertion_labels(ctrl_queue_three) ~is ["ctrl_queue_occupancy_in_range"]

  ctrl_arbiter_three.find_output("chosen").type.width ~is 2
  ctrl_rr_arbiter_three.find_output("chosen").type.width ~is 2
  assertion_labels(ctrl_rr_arbiter_three) ~is ["ctrl_rr_priority_in_range"]
  operations(ctrl_rr_arbiter_three, "rtl.register_reset").length() ~is 1
  operations(ctrl_rr_arbiter_three, "rtl.instance").length() ~is 0
  ctrl_demux_three.find_output("egress_0_out").type.fields.map(
    fun (field): field.name
  ) ~is ["valid"]
  ctrl_join_three.find_output("egress_out").type.fields.map(
    fun (field): field.name
  ) ~is ["valid"]
  operations(ctrl_broadcast_three, "rtl.register_reset").length() ~is 1
  operations(ctrl_broadcast_three, "rtl.register").length() ~is 0

  // AtomicFork is purely combinational and exposes every fanout endpoint.
  atomic_fork_three.inputs.map(fun (port): port.name) ~is [
    "ingress_in", "egress_0_in", "egress_1_in", "egress_2_in"
  ]
  atomic_fork_three.outputs.map(fun (port): port.name) ~is [
    "ingress_out", "egress_0_out", "egress_1_out", "egress_2_out"
  ]
  operations(atomic_fork_three, "rtl.register_reset").length() ~is 0
  operations(atomic_fork_three, "rtl.register").length() ~is 0
  ctrl_atomic_fork_three.find_output("egress_0_out").type.fields.map(
    fun (field): field.name
  ) ~is ["valid"]
  operations(ctrl_atomic_fork_three, "rtl.register_reset").length() ~is 0
  verify_design(pipe_one_design) ~is #void
  verify_design(pipe_three_design) ~is #void
  verify_design(valid_pipe_one_design) ~is #void
  verify_design(valid_pipe_three_design) ~is #void
  verify_design(queue_one_design) ~is #void
  verify_design(queue_three_design) ~is #void
  queue_pipe_compiled.has_errors ~is #false
  queue_flow_compiled.has_errors ~is #false
  verify_design(queue_options_design) ~is #void
  verify_design(arbiter_one_design) ~is #void
  verify_design(valid_arbiter_three_design) ~is #void
  verify_design(arbiter_three_design) ~is #void
  verify_design(rr_arbiter_three_design) ~is #void
  verify_design(demux_three_design) ~is #void
  verify_design(matcher_design) ~is #void
  verify_design(output_greedy_matcher_design) ~is #void
  verify_design(grant_demux_design) ~is #void
  verify_design(grant_merge_design) ~is #void
  verify_design(crossbar_design) ~is #void
  verify_design(join_three_design) ~is #void
  verify_design(broadcast_three_design) ~is #void
  verify_design(atomic_fork_three_design) ~is #void
  aggregate_pipe_compiled.has_errors ~is #false
  aggregate_queue_compiled.has_errors ~is #false
  aggregate_arbiter_compiled.has_errors ~is #false
  aggregate_rr_arbiter_compiled.has_errors ~is #false
  aggregate_demux_compiled.has_errors ~is #false
  aggregate_crossbar_compiled.has_errors ~is #false
  aggregate_join_compiled.has_errors ~is #false
  aggregate_broadcast_compiled.has_errors ~is #false
