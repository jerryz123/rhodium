#lang rhombus
// Checks packet-locked arbitration structure, composition, and invalid uses.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/rtl.rhm").rtl_target
  lib("rhodium/compile/program.rhm").compile_program
  "../../rhodium/core/main.rhm" open
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../flow/main.rhdl" as flow
  "../../flow/packet-rr-arbiter.rhdl" as packet_arbiter
  "std-packet-rr-arbiter.rhdl" as fixture

def direct_compiled = compile_program(elaborate(packet_arbiter.PacketRRArbiter(Bits(8), 3)), rtl_target)
def facade_design = compile_program(elaborate(flow.PacketRRArbiter(Bits(8), 3)), rtl_target).report.design
def chain_design = compile_program(elaborate(fixture.PacketRRArbiterChain()), rtl_target).report.design
def disconnected_design = compile_program(elaborate(fixture.DisconnectedPacketRRArbiterChain()), rtl_target).report.design
def packet_module = facade_design.modules[0]

fun operations(module_def, opcode):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == opcode
  )

fun assertion_labels(module_def):
  operations(module_def, "verif.assert").map(
    fun (operation): operation.attribute("label")
  )

check:
  direct_compiled.has_errors ~is #false
  verify_design(facade_design) ~is #void
  verify_design(chain_design) ~is #void
  verify_design(disconnected_design) ~is #void

  packet_module.inputs.map(fun (port): port.name) ~is [
    "clock", "reset", "ingress_0_in", "ingress_1_in", "ingress_2_in",
    "ends_packet", "egress_in"
  ]
  packet_module.outputs.map(fun (port): port.name) ~is [
    "ingress_0_out", "ingress_1_out", "ingress_2_out", "egress_out", "chosen"
  ]
  packet_module.find_output("chosen").type.width ~is 2
  assertion_labels(packet_module) ~is [
    "packet_rr_priority_in_range",
    "packet_rr_owner_in_range"
  ]
  operations(packet_module, "rtl.register_reset").length() ~is 3
  operations(packet_module, "rtl.onehot_mux").length() ~is 2
  chain_design.modules.map(fun (module_def): module_def.name) ~is [
    "PacketRRArbiterChain", "PacketRRArbiter"
  ]
  disconnected_design.modules.map(fun (module_def): module_def.name) ~is [
    "DisconnectedPacketRRArbiterChain", "PacketRRArbiter", "Pipe"
  ]

  elaborate(fixture.EmptyPacketRRArbiterChain()) ~throws "requires at least one input endpoint"
  elaborate(fixture.MismatchedPacketRRArbiterCount()) ~throws "configured input count does not match"
  elaborate(fixture.PacketRRArbiterWrongProtocol()) ~throws "flow-control chaining requires a Decoupled or Irrevocable endpoint"
  elaborate(fixture.PacketRRArbiterWrongPredicate()) ~throws "annotation"
