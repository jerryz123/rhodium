#lang rhombus
// Checks selection-controlled joining, public exports, result shape, and diagnostics.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/rtl.rhm").rtl_target
  lib("rhodium/compile/program.rhm").compile_program
  "../../rhodium/core/main.rhm" open
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../flow/main.rhdl" as flow
  "../../flow/join.rhdl" as join
  "../../examples/std/selective-join.rhdl" as example
  "std-selective-join-invalid.rhdl" as invalid

def example_design_rtl = compile_program(example.program, rtl_target).report.design

def direct_design = compile_program(elaborate(join.SelectiveJoin(Bits(8), 3)), rtl_target).report.design
def facade_compiled = compile_program(elaborate(flow.SelectiveJoin(Bits(8), 3)), rtl_target)
def example_design = example_design_rtl
def direct_module = direct_design.modules[0]
def result_type = direct_module.find_output("egress_out").type.field("bits").type

fun operations(module_def, opcode):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == opcode
  )

check:
  verify_design(direct_design) ~is #void
  facade_compiled.has_errors ~is #false
  verify_design(example_design) ~is #void

  direct_module.inputs.map(fun (port): port.name) ~is [
    "selection_in", "ingress_0_in", "ingress_1_in", "ingress_2_in", "egress_in"
  ]
  direct_module.outputs.map(fun (port): port.name) ~is [
    "selection_out", "ingress_0_out", "ingress_1_out", "ingress_2_out", "egress_out"
  ]
  result_type.field("selection").type.packed_width() ~is 3
  result_type.field("values").type.length ~is 3
  result_type.field("values").type.element_type.width ~is 8
  operations(direct_module, "rtl.register").length() ~is 0
  operations(direct_module, "rtl.register_reset").length() ~is 0
  example_design.modules.map(fun (module_def): module_def.name) ~is [
    "SelectiveRendezvous", "SelectiveJoin"
  ]

  elaborate(invalid.MissingSelectiveJoinData()) ~throws "one selection flow and at least one data flow"
  elaborate(invalid.WrongSelectiveJoinSelection()) ~throws "first source must carry a Mask"
  elaborate(invalid.MismatchedSelectiveJoinData()) ~throws "data flows must carry the same payload type"
