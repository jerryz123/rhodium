#lang rhodium
// Defines inline ready-valid gating that holds tokens while disabled.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/ready-valid.rhdl") open
  lib("flow/ready-valid-support.rhdl") open

// Gating may change with live sideband state, so it deliberately weakens the
// output to Decoupled. Unlike filtering, a disabled gate does not consume its
// input token.
fun gate_flow(enabled :: Bool)
  :: ((source :: FlowSource) -> InterfaceTransformResult(source, Endpoint)):
  fun (source :: FlowSource) :~ InterfaceTransformResult(source, Endpoint):
    def gate_flow_protocol = flow_protocol_type(source)
    def gate_flow_input_link = interface_link(
      gate_flow_protocol,
      "gate_input"
    )
    def gate_flow_input = gate_flow_input_link.right
    def gate_flow_output_link = interface_link(
      Decoupled(flow_payload_type(source)),
      "gate_output"
    )
    def gate_flow_output = gate_flow_output_link.left
    gate_flow_output.field("valid") <== gate_flow_input.field("valid") & enabled
    gate_flow_output.field("bits") <== gate_flow_input.field("bits")
    gate_flow_input.field("ready") <== gate_flow_output.field("ready") & enabled
    finish_interface_transform(
      source,
      describe_interface_transform(
        interface_transform(gate_flow_input_link, gate_flow_output_link),
        "gate",
        ~trace_model: interface_trace_combinational(~guard: enabled)
      )
    )

export:
  gate_flow
