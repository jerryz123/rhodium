#lang rhodium
// Bridges ready-valid requests to nonstallable issues and completions with reserved response buffering.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/ready-valid.rhdl") open
  lib("flow/queue.rhdl").Queue

// Each accepted request reserves one response slot and emits one immediate
// Valid issue. The producer must later present exactly one Valid completion;
// completions cannot be backpressured and emerge in their arrival order.
sync_circuit CompletionQueue(Request :: DataType,
                             Response :: DataType,
                             depth :: PosInt):

  interface request(Decoupled(Request), ~role: consumer)
  interface issue(Valid(Request), ~role: producer)
  interface completion(Valid(Response), ~role: consumer)
  interface response(Irrevocable(Response), ~role: producer)

  inst completed(Queue(Response, depth, ~pipe: #true))
  completed.egress |> response

  def count_width = index_width(depth + 1)
  def accounting_width = count_width + 1
  reg outstanding(~init: bits(0, count_width))

  def response_fire = response.fire()
  def capacity_available = outstanding < bits(depth, count_width)
  request.ready <== capacity_available ||| response_fire
  def request_fire = request.fire()

  issue.valid <== request_fire
  issue.bits <== request.bits
  completed.ingress.valid <== completion.valid
  completed.ingress.bits <== completion.bits

  def queued_count = completed.count.zext(accounting_width)
  def completion_count = completion.valid.as_bits().zext(accounting_width)
  def reserved_count = outstanding.zext(accounting_width)
  def request_count = request_fire.as_bits().zext(accounting_width)
  assert((queued_count + completion_count) <= (reserved_count + request_count),
         "completion_queue_completion_has_request")
  when (completion.valid):
    assert(completed.ingress.ready, "completion_queue_slot_reserved")
  assert(outstanding <= bits(depth, count_width),
         "completion_queue_reservations_in_range")

  def next_outstanding = mux(
    request_fire,
    outstanding + bits(1, count_width),
    outstanding - bits(1, count_width)
  )
  when (request_fire ^ response_fire):
    outstanding <== next_outstanding

export:
  CompletionQueue
