#lang rhodium
/* Routes ready-valid grants and selects already-owned Valid events with their lineage. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/ready-valid.rhdl") open
  lib("flow/ready-valid-support.rhdl").valid_flow_payload_type

export:
  GrantDemux
  GrantMerge
  grant_merge
  valid_owner_mux

/* Route an already-owned event. The clock only samples misuse assertions;
   neither payload selection nor launch has storage or backpressure. */
sync_circuit ValidOwnerMux(T :: DataType):
  input select_first: Bool
  interface ingress[2](Valid(T), ~role: consumer)
  interface egress(Valid(T), ~role: producer)

  egress.bits <== mux(select_first, ingress[0].bits, ingress[1].bits)
  egress.valid <== ingress[0].valid ||| ingress[1].valid
  assert(!ingress[0].valid ||| select_first, "valid_owner_mux_first_not_selected")
  assert(!ingress[1].valid ||| !select_first, "valid_owner_mux_second_not_selected")

  describe_interface_selection([select_first, !select_first])
  describe_interface_contract(ingress, egress, "data", ~trace_model: interface_trace_selection(~pending: #true))

/* Select two like-typed Valid sources by an external owner, including during
   bubbles. Only the selected source may emit an event. */
fun valid_owner_mux(select_first :: Bool, first :: Endpoint,
                    second :: Endpoint.supports(Valid(valid_flow_payload_type(first)))) :~ Endpoint:
  inst owner_mux(ValidOwnerMux(valid_flow_payload_type(first)))
  owner_mux.select_first <== select_first
  first |> owner_mux.ingress[0]
  second |> owner_mux.ingress[1]
  owner_mux.egress

/* A zero grant blocks the input; a one-hot grant routes it to the selected
   output. At most one grant bit may be asserted. Selection may change while
   stalled, so the output offers use the Decoupled contract. */
circuit GrantDemux(T :: DataType, output_count :: PosInt):
  interface ingress(Decoupled(T), ~role: consumer)
  input grants: MaybeOneHot(output_count)
  interface egress[output_count](Decoupled(T), ~role: producer)

  ingress.ready <== any(vec(
    for List (output_index in 0..output_count):
      grants[output_index] & egress[output_index].ready
  ))

  for (output_index in 0..output_count):
    def selected = grants[output_index]
    egress[output_index].valid <== ingress.valid & selected
    egress[output_index].bits <== ingress.bits

  describe_interface_contract(ingress, egress, "data", ~kind: "grant-demux", ~trace_model: interface_trace_routing(for List (index in 0..output_count): grants[index]))

/* A zero grant produces no offer; a one-hot grant selects the corresponding
   input. At most one grant bit may be asserted. Readiness is returned only to
   the selected input, and the output remains Decoupled under changing grants. */
circuit GrantMerge(T :: DataType, input_count :: PosInt):
  interface ingress[input_count](Decoupled(T), ~role: consumer)
  input grants: MaybeOneHot(input_count)
  interface egress(Decoupled(T), ~role: producer)

  def active = grants.mask(
    vec(
      for List (input_index in 0..input_count): ingress[input_index].valid
    ).into(Mask(input_count))
  )

  for (input_index in 0..input_count):
    def selected = grants[input_index]
    ingress[input_index].ready <== selected & egress.ready

  egress.valid <== active.valid
  // Grants select the operand independently of validity. A consumer may use
  // that operand to compute readiness without a valid-to-ready feedback path.
  egress.bits <== grants.mux(
    for List (input_index in 0..input_count): ingress[input_index].bits,
    ~default: ingress[0].bits
  )

  describe_interface_selection(for List (index in 0..input_count): grants[index])
  describe_interface_contract(ingress, egress, "data", ~kind: "grant-merge", ~trace_model: interface_trace_selection())

/* Connects an externally granted array of payload offers to one Decoupled
   output. GrantMerge owns the handshake and selected-parent trace contract. */
fun grant_merge(grants :~ Hardware.packable, sources :: Array) :~ Endpoint:
  unless sources.length() > 0
  | error(~who: #'grant_merge, "requires at least one input")
  inst merge(GrantMerge(decoupled_payload_type(sources[0]), sources.length()))
  merge.grants <== grants
  sources <=> merge.ingress
  merge.egress
