#lang rhodium
// Defines a rewritable one-slot offer with intrinsic capture, replacement, and release lineage.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/ready-valid.rhdl") open

// A Valid update installs or replaces the current offer, including while the
// egress is stalled. Without an update, an accepted offer clears the slot.
// Replacement under stall is why the egress contract is Decoupled.
sync_circuit OfferRegister(T :: DataType):

  interface update(Valid(T), ~role: consumer)
  interface egress(Decoupled(T), ~role: producer)

  reg occupied(~init: Bool(#false))
  reg payload(T)

  egress.valid <== occupied
  egress.bits <== payload

  when (update.valid):
    occupied <== Bool(#true)
    payload <== update.bits
  elsewhen (egress.fire()):
    occupied <== Bool(#false)

  // Updating a busy slot abandons its old owner even without a transfer.
  // The pre-edge output still belongs to the old update on simultaneous delivery.
  describe_interface_retained_storage(update.valid, occupied & (update.valid ||| egress.ready), occupied)
  describe_interface_contract(update, egress, "offer", ~trace_model: interface_trace_retained())

export:
  OfferRegister
