#lang rhodium
// Defines inline one-to-many fanout for non-backpressured Valid flows.

import:
  lib("rhodium/std/ready-valid.rhdl") open
  lib("flow/ready-valid-support.rhdl") open

fun fork_valid(n :: PosInt)
  :: ((source :: FlowSource) -> InterfaceTransformResult(source, InterfaceArrayFields)):
  fun (source :: FlowSource) :~ InterfaceTransformResult(source, InterfaceArrayFields):
    def protocol = valid_flow_protocol_type(source)
    def input_link = interface_link(protocol, "fork_valid_input")
    def output_links = for Array (index in 0..n):
      interface_link(protocol, "fork_valid_output_" ++ to_string(index))
    for (output_link in output_links):
      output_link.left.field("valid") <== input_link.right.field("valid")
      output_link.left.field("bits") <== input_link.right.field("bits")
    finish_interface_transform(
      source,
      describe_interface_transform(
        interface_transform(input_link, output_links),
        "fork-valid",
        {"outputs": n}
      )
    )

export:
  fork_valid
