#lang rhodium
// Defines transparent event checkpoints with explicit transfer controls for tracing.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/meta open
  lib("rhodium/std/ready-valid.rhdl") open
  lib("flow/ready-valid-support.rhdl") open

// Preserves a ready-valid transaction while attaching a compiler-visible event
// site to the identity transform.
fun trace_event_config(label :: String,
                       ~parents: parents :: maybe(List.of(Endpoint)) = #false,
                       ~when: qualification :: Bool = Bool(#true),
                       ~stalls: stalls :: Boolean = #false,
                       ~residency: residency :: maybe(String) = #false,
                       ~payload: raw :: Boolean = #false,
                       ~capture: capture :: maybe(Function) = #false)
  :: ((source :: FlowSourceArgument) -> InterfaceTransformResult(source, Endpoint)):
  fun (source :~ FlowSource) :~ InterfaceTransformResult(source, Endpoint):
    def protocol = flow_protocol_type(source)
    def input_link = interface_link(protocol, "event_input")
    def output_link = interface_link(protocol, "event_output")
    def input_endpoint = input_link.right
    def output_endpoint = output_link.left
    output_endpoint.field("valid") <== input_endpoint.field("valid")
    output_endpoint.field("bits") <== input_endpoint.field("bits")
    input_endpoint.field("ready") <== output_endpoint.field("ready")
    finish_interface_transform(
      source,
      describe_interface_event(
        interface_transform(input_link, output_link),
        label,
        ~parents: parents,
        ~residency: residency,
        ~payload: if raw | input_endpoint.field("bits") | #false,
        ~fields: if capture | capture(flow_payload_type(source), input_endpoint.field("bits")) | [],
        ~valid: input_endpoint.field("valid") & qualification,
        ~ready: output_endpoint.field("ready"),
        ~stalls
      )
    )

// Valid has no reverse readiness member, so its transparent event checkpoint
// forwards only the offer and payload.
fun trace_valid_event_config(label :: String,
                             ~parents: parents :: maybe(List.of(Endpoint)) = #false,
                             ~when: qualification :: Bool = Bool(#true),
                             ~payload: raw :: Boolean = #false,
                             ~capture: capture :: maybe(Function) = #false)
  :: ((source :: FlowSourceArgument) -> InterfaceTransformResult(source, Endpoint)):
  fun (source :~ FlowSource) :~ InterfaceTransformResult(source, Endpoint):
    def protocol = valid_flow_protocol_type(source)
    def input_link = interface_link(protocol, "valid_event_input")
    def output_link = interface_link(protocol, "valid_event_output")
    def input_endpoint = input_link.right
    def output_endpoint = output_link.left
    output_endpoint.field("valid") <== input_endpoint.field("valid")
    output_endpoint.field("bits") <== input_endpoint.field("bits")
    finish_interface_transform(
      source,
      describe_interface_event(
        interface_transform(input_link, output_link),
        label,
        ~parents: parents,
        ~payload: if raw | input_endpoint.field("bits") | #false,
        ~fields: if capture | capture(valid_flow_payload_type(source), input_endpoint.field("bits")) | [],
        ~valid: input_endpoint.field("valid") & qualification
      )
    )

// Binds upstream checkpoint selection after both endpoints exist, without
// introducing a functional connection or specifying a storage lifetime.
fun trace_parents(child :: Endpoint, parents :: List.of(Endpoint)):
  describe_interface_event_parents(child, parents)

// Connects a child event to a previously retained parent event without
// changing the ready-valid datapath. The named retained-storage declaration
// owns the cross-cycle lifetime; this helper only records the causal relation.
fun trace_edge(parent :: Endpoint,
               child :: Endpoint,
               ~scope: scope :: String = "data"):
  describe_interface_trace_edge(parent, child, ~scope: scope)

// Bind the observed payload with its hardware surface, like map_valid. The
// generic annotation owns validation; these macros only configure observation.
expr.macro
| 'trace_event($label, $option, ..., ~fields: $(payload :: Identifier)): $field; ...':
    'trace_event_config($label, $option, ..., ~capture: capture_fields($payload): $field; ...)'
| 'trace_event($arg, ...)': 'trace_event_config($arg, ...)'
| 'trace_event': 'trace_event_config'

expr.macro
| 'trace_valid_event($label, $option, ..., ~fields: $(payload :: Identifier)): $field; ...':
    'trace_valid_event_config($label, $option, ..., ~capture: capture_fields($payload): $field; ...)'
| 'trace_valid_event($arg, ...)': 'trace_valid_event_config($arg, ...)'
| 'trace_valid_event': 'trace_valid_event_config'

expr.macro 'capture_fields($(payload :: Identifier)): $field; ...':
  'capture_fields_impl(#false, $payload): $field; ...'

expr.macro 'capture_fields_impl($payload_infos,
                                $(payload :: Identifier)): $field; ...':
  def [capture, ...] = for List (clause in [field, ...]):
    match clause
    | '$(name :: Identifier): $value':
        def text = name.to_source_string()
        'event_field($text, $value)'
    | '$(name :: Identifier)($option, ...): $value':
        def text = name.to_source_string()
        'event_field($text, $value, $option, ...)'
    | ~else: error(~who: #'trace_event, "expected name: capture expression", clause)
  'fun (capture_type, capture_bits):
     def typed_capture_bits :: Hardware.of(capture_type) = capture_bits
     flow_payload_body($payload_infos, $payload, typed_capture_bits):
       [$capture, ...]'

// A direct checkpoint pipeline can expose the exact source payload surface in
// named capture expressions without changing the configured checkpoint API.
immediate_callee.macro 'trace_event $tail ...':
  ~static_infos: source_infoss
  def payload_infos = flow_payload_static_infos(source_infoss[0])
  match '$tail ...'
  | '($label,
      $option, ...,
      ~fields: $(payload :: Identifier)): $field; ...':
      values(
        'trace_event_config($label,
                            $option, ...,
                            ~capture: capture_fields_impl($(payload_infos), $payload): $field; ...)',
        ''
      )
  | '($arg, ...) $rest ...':
      values('trace_event_config($arg, ...)', '$rest ...')
  | ~else:
      syntax_meta.error("invalid trace_event immediate pipeline form", '$tail ...')

immediate_callee.macro 'trace_valid_event $tail ...':
  ~static_infos: source_infoss
  def payload_infos = flow_payload_static_infos(source_infoss[0])
  match '$tail ...'
  | '($label,
      $option, ...,
      ~fields: $(payload :: Identifier)): $field; ...':
      values(
        'trace_valid_event_config($label,
                                  $option, ...,
                                  ~capture: capture_fields_impl($(payload_infos), $payload): $field; ...)',
        ''
      )
  | '($arg, ...) $rest ...':
      values('trace_valid_event_config($arg, ...)', '$rest ...')
  | ~else:
      syntax_meta.error(
        "invalid trace_valid_event immediate pipeline form",
        '$tail ...'
      )

export:
  trace_event
  trace_valid_event
  trace_parents
  trace_edge
