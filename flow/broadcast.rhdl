#lang rhodium
// Defines payload-bearing and control-only exactly-once broadcast buffers.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/ready-valid.rhdl") open
  lib("flow/ready-valid-support.rhdl") open

// One payload is held while a pending mask records which consumers still need
// it. Each output can accept independently without receiving duplicates, and
// every asserted output remains stable until its consumer accepts it.
sync_circuit Broadcast(T :: DataType, n :: PosInt):

  interface ingress(Decoupled(T), ~role: consumer)
  interface egress[n](Irrevocable(T), ~role: producer)

  def initial_pending = vec(
    for List (_ in 0..n): Bool(#false)
  )
  reg pending(~init: initial_pending)
  reg payload(T)

  def any_pending = pending.or_reduce()
  def all_pending_ready = and_reduce(vec(
    for List (index in 0..n): !pending[index] ||| egress[index].ready
  ))
  for (index in 0..n):
    egress[index].valid <== pending[index]
    egress[index].bits <== payload

  // The final recipients can drain while the next item is accepted, avoiding
  // an input bubble without exposing the replacement payload in this cycle.
  def input_ready = !any_pending ||| all_pending_ready
  def accept_input = ingress.valid & input_ready
  ingress.ready <== input_ready
  describe_interface_broadcast_storage(accept_input, for List (index in 0..n): pending[index])
  describe_interface_contract(ingress, egress, "data", ~kind: "broadcast", ~trace_model: interface_trace_buffered_broadcast())

  when (accept_input):
    payload <== ingress.bits

  for (index in 0..n):
    when (accept_input):
      pending[index] <== Bool(#true)
    elsewhen (pending[index] & egress[index].ready):
      pending[index] <== Bool(#false)

// Payloadless broadcast retains only the per-recipient pending mask. Each
// output's valid offer remains asserted until that recipient accepts it.
sync_circuit CtrlBroadcast(n :: PosInt):

  interface ingress(DecoupledCtrl(), ~role: consumer)
  interface egress[n](IrrevocableCtrl(), ~role: producer)

  def initial_pending = vec(
    for List (_ in 0..n): Bool(#false)
  )
  reg pending(~init: initial_pending)

  def any_pending = pending.or_reduce()
  def all_pending_ready = and_reduce(vec(
    for List (index in 0..n): !pending[index] ||| egress[index].ready
  ))
  for (index in 0..n):
    egress[index].valid <== pending[index]

  def input_ready = !any_pending ||| all_pending_ready
  def accept_input = ingress.valid & input_ready
  ingress.ready <== input_ready

  for (index in 0..n):
    when (accept_input):
      pending[index] <== Bool(#true)
    elsewhen (pending[index] & egress[index].ready):
      pending[index] <== Bool(#false)

// Configures a one-slot broadcast with independently accepted irrevocable outputs.
fun broadcast(n :: PosInt)
  :: ((source :: FlowSourceArgument) -> InterfaceTransformResult(source, InterfaceArrayFields)):
  fun (source :~ FlowSource) :~ InterfaceTransformResult(source, InterfaceArrayFields):
    def T = flow_payload_type(source)
    inst broadcast_stage(Broadcast(T, n))
    finish_interface_transform(
      source,
      describe_interface_transform(
        InterfaceHandle(broadcast_stage.ingress, broadcast_stage.egress),
        "broadcast", {"outputs": n}, broadcast_stage
      )
    )

export:
  Broadcast
  broadcast
  CtrlBroadcast
