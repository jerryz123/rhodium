#lang rhodium
// Bridges ready-valid flows across bounded single-hop credited transport.

import:
  lib("rhodium/std/ready-valid.rhdl") open
  lib("rhodium/std/credited.rhdl") open
  lib("flow/ready-valid-support.rhdl") open
  lib("flow/queue.rhdl").Queue

// Tracks an owned resource balance. A decrement requires a resource present
// before the edge; simultaneous increment and decrement therefore cannot
// manufacture a zero-balance resource for immediate use.
sync_circuit CreditCounter(limit :: PosInt):

  def count_width = index_width(limit + 1)
  input increment: Bool
  input decrement: Bool
  output count: Bits(count_width)
  output empty: Bool
  output full: Bool

  reg state(~init: bits(0, count_width))
  def state_empty = state === bits(0, count_width)
  def state_full = state === bits(limit, count_width)

  assert(!decrement ||| !state_empty, "credit_counter_underflow")
  assert(!increment ||| decrement ||| !state_full,
         "credit_counter_overflow")
  assert(state <= bits(limit, count_width), "credit_counter_in_range")

  when (increment ^ decrement):
    state <== mux(
      increment,
      state + bits(1, count_width),
      state - bits(1, count_width)
    )

  count <== state
  empty <== state_empty
  full <== state_full

// Converts internal ready-valid traffic to credited transport. Readiness is
// based only on registered credits, never on a grant arriving this cycle.
sync_circuit CreditSender(T :: DataType, credit_limit :: PosInt):

  interface ingress(Decoupled(T), ~role: consumer)
  interface link(Credited(T, credit_limit), ~role: transmitter)
  output credit_count: Bits(index_width(credit_limit + 1))

  inst balance(CreditCounter(credit_limit))
  def can_send = !balance.empty

  ingress.ready <== can_send
  link.valid <== ingress.valid & can_send
  link.bits <== ingress.bits
  balance.increment <== link.credit
  balance.decrement <== link.valid
  credit_count <== balance.count

// Converts credited transport back to a buffered ready-valid flow. Reserved
// capacity includes both buffered payloads and credits still held remotely.
sync_circuit CreditBuffer(T :: DataType, depth :: PosInt):

  input grant_enable: Bool
  interface link(Credited(T, depth), ~role: receiver)
  interface egress(Irrevocable(T), ~role: producer)
  output count: Bits(index_width(depth + 1))
  output reserved: Bits(index_width(depth + 1))

  inst storage(Queue(T, depth, ~pipe: #true))
  inst reservations(CreditCounter(depth))
  storage.egress |> egress

  storage.ingress.valid <== link.valid
  storage.ingress.bits <== link.bits
  def dequeue = egress.fire()
  def grant = grant_enable & (!reservations.full ||| dequeue)
  link.credit <== grant
  reservations.increment <== grant
  reservations.decrement <== dequeue
  count <== storage.count
  reserved <== reservations.count

  assert(!link.valid ||| storage.ingress.ready,
         "credit_buffer_reserved_slot_available")
  assert(storage.count <= reservations.count,
         "credit_buffer_occupancy_reserved")
  monitor_credited(link)

fun credited_stage_protocol(source_or_type :: FlowSource, credit_limit :: PosInt):
  def protocol:
    cond
    | source_or_type is_a Endpoint: source_or_type.type
    | source_or_type is_a Handle:
        unless source_or_type.right is_a Endpoint
        | error(~who: #'credit_buffer,
                "credited handle output must be one interface endpoint")
        source_or_type.right.type
    | source_or_type is_a InterfaceType: source_or_type
    | ~else:
        Credited(source_or_type, credit_limit)
  def normalized = credited_protocol_type(protocol)
  unless normalized
  | error(~who: #'credit_buffer,
          "credited-flow chaining requires a Credited protocol")
  unless normalized.specialization_arguments[1] == credit_limit
  | error(~who: #'credit_buffer,
          "credit buffer depth must match the protocol credit limit")
  normalized

fun credit_sender(credit_limit :: PosInt)
  :: ((source :: FlowSource) -> InterfaceTransformResult(source, Endpoint)):
  fun (source :: FlowSource) :~ InterfaceTransformResult(source, Endpoint):
    def T = flow_payload_type(source)
    inst credit_sender_stage(CreditSender(T, credit_limit))
    finish_interface_transform(
      source,
      describe_interface_transform(
        InterfaceHandle(credit_sender_stage.ingress, credit_sender_stage.link),
        "credit-sender",
        {"credits": credit_limit},
        credit_sender_stage
      )
    )

fun credit_buffer(depth :: PosInt,
                  ~grant_enable: grant_enable :: Bool = Bool(#true))
  :: ((source :: FlowSource) -> InterfaceTransformResult(source, Endpoint)):
  fun (source :: FlowSource) :~ InterfaceTransformResult(source, Endpoint):
    def protocol = credited_stage_protocol(source, depth)
    def T = protocol.members.find(fun (member :: InterfaceMember): member.name == "bits").type
    inst credit_buffer_stage(CreditBuffer(T, depth))
    credit_buffer_stage.grant_enable <== grant_enable
    finish_interface_transform(
      source,
      describe_interface_transform(
        InterfaceHandle(credit_buffer_stage.link, credit_buffer_stage.egress),
        "credit-buffer",
        {"depth": depth},
        credit_buffer_stage
      )
    )

export:
  CreditCounter
  CreditSender
  CreditBuffer
  credit_sender
  credit_buffer
