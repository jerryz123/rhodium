#lang rhodium
/* Defines round-robin arbiters and grant-certified ready-valid trace selection. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/bits.rhdl").wrap_increment
  lib("rhodium/std/ready-valid.rhdl") open
  lib("flow/ready-valid-support.rhdl") open
  lib("flow/circular-priority.rhdl") open

/* The arbiter owns transfer-based rotation around one combinational circular
   selector. Selection may change while stalled, so the output deliberately
   remains Decoupled rather than claiming an irrevocable offer. */
sync_circuit RRArbiter(T :: DataType, n :: PosInt):

  interface ingress[n](Decoupled(T), ~role: consumer)
  interface egress(Decoupled(T), ~role: producer)
  output chosen: Bits(index_width(n))

  def width = index_width(n)
  reg next_priority(~init: Bits(width)(0))
  assert(next_priority <= Bits(width)(n - 1), "rr_priority_in_range")
  def requests = vec(for List (index in 0..n): ingress[index].valid)
  def choice :: CircularPriorityChoice(n, width) = circular_priority_onehot(requests, next_priority)
  def grant = choice.grant

  for (index in 0..n):
    ingress[index].ready <== egress.ready & grant[index]

  egress.valid <== choice.valid
  egress.bits <== grant.mux(
    for List (index in 0..n): ingress[index].bits,
    ~default: ingress[0].bits
  )

  chosen <== choice.index
  describe_interface_selection(for List (index in 0..n): grant[index])
  describe_interface_contract(ingress, egress, "data", ~kind: "rr-arbiter", ~trace_model: interface_trace_selection())

  when (egress.fire()):
    next_priority <== wrap_increment(choice.index, n)

/* The payloadless specialization owns the same direct rotating state. */
sync_circuit CtrlRRArbiter(n :: PosInt):

  interface ingress[n](DecoupledCtrl(), ~role: consumer)
  interface egress(DecoupledCtrl(), ~role: producer)
  output chosen: Bits(index_width(n))

  def width = index_width(n)
  reg next_priority(~init: Bits(width)(0))
  assert(next_priority <= Bits(width)(n - 1), "ctrl_rr_priority_in_range")
  def requests = vec(for List (index in 0..n): ingress[index].valid)
  def choice :: CircularPriorityChoice(n, width) = circular_priority_onehot(requests, next_priority)
  def grant = choice.grant

  for (index in 0..n):
    ingress[index].ready <== egress.ready & grant[index]

  egress.valid <== choice.valid
  chosen <== choice.index

  when (egress.fire()):
    next_priority <== wrap_increment(choice.index, n)

/* A connected endpoint array supplies its own input count. A disconnected
   topology starts from a payload type and states the count once in rr_arbiter. */
fun rr_arbiter(n :: maybe(PosInt) = #false)
  :: ((source :: FlowSource || Array) -> InterfaceTransformResult(source, Endpoint)):
  fun (source :: FlowSource || Array) :~ InterfaceTransformResult(source, Endpoint):
    def inputs:
      if source is_a Handle | source.right | source

    def typed = !(inputs is_a Array)
    def input_count:
      if typed
      | block:
          unless n is_a PosInt
          | error(~who: #'rr_arbiter,
                  "typed round-robin arbitration requires a positive input count")

          n
      | block:
          unless inputs.length() > 0
          | error(~who: #'rr_arbiter,
                  "round-robin arbitration requires at least one input endpoint")

          if n
          | unless n == inputs.length()
            | error(~who: #'rr_arbiter,
                    "configured input count does not match the endpoint array")
          | #void

          inputs.length()

    def T:
      if typed | source | flow_payload_type(inputs[0])

    inst arbiter_stage(RRArbiter(T, input_count))
    finish_interface_transform(
      source,
      describe_interface_transform(
        InterfaceHandle(arbiter_stage.ingress, arbiter_stage.egress),
        "rr-arbiter",
        {"inputs": input_count},
        arbiter_stage
      )
    )

export:
  RRArbiter
  rr_arbiter
  CtrlRRArbiter
