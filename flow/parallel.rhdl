#lang rhodium
// Provides parallel composition for generic interface-handle shapes.

import:
  rhombus/meta open
  lib("flow/ready-valid-support.rhdl").FlowSource

// Endpoint, handle, and sink topology objects are callable for ordinary `|>`
// composition, but they are not configured stage functions.
fun configured_parallel_stage(path :: Function.of_arity(1)):
  path is_a Function && !(
    path is_a Endpoint || path is_a Handle || path is_a Sink
  )

// Configures independent unary stages for an array-shaped source. Connected
// endpoint arrays produce endpoint arrays; type seeds and earlier handles
// produce one composed array-shaped handle.
expr.macro 'parallel($path, ...)':
  'fun (parallel_source :: FlowSource || Array) :~ InterfaceTransformResult(parallel_source, InterfaceArrayFields):
     def parallel_paths = Array($path, ...)
     cond
     | parallel_paths.length() > 0 && (
         parallel_paths[0] is_a Handle || parallel_paths[0] is_a Sink
       ):
         parallel_handles(parallel_paths)(parallel_source)
     | parallel_paths.length() > 0 && configured_parallel_stage(parallel_paths[0]):
         for (path in parallel_paths):
           unless configured_parallel_stage(path)
           | error(~who: #'parallel,
                   "parallel flow composition requires all configured stages, all handles, or all sinks")
         def parallel_inputs:
           if parallel_source is_a Handle
           | parallel_source.right
           | parallel_source
         unless parallel_inputs is_a Array
         | error(~who: #'parallel,
                 "parallel flow composition requires an array-shaped source")
         unless parallel_inputs.length() == parallel_paths.length()
         | error(~who: #'parallel,
                 "parallel flow source and path arrays must have the same length")
         if parallel_source is_a Handle
         | block:
             def path_handles = for Array (index in 0..parallel_paths.length()):
               parallel_paths[index](parallel_inputs[index].type)
             finish_interface_transform(parallel_source, parallel_handles(path_handles))
         | block:
             def results = for Array (index in 0..parallel_paths.length()):
               parallel_paths[index](parallel_inputs[index])
             if results.length() == 0 || results[0] is_a Endpoint
             | results
             | parallel_handles(results)
     | ~else:
         error(~who: #'parallel,
               "parallel flow composition requires configured stages, handles, or sinks")'

export:
  parallel
