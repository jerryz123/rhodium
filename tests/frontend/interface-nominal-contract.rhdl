#lang rhodium
// Defines one side of a same-named interface collision used to test nominal identity.
// SPDX-License-Identifier: Apache-2.0

interface Collision(T):
  role producer
  role consumer

  producer -> consumer:
    payload: T

fun require_collision(
  endpoint :: Endpoint.of(Collision(Bits(8)))
) :~ Endpoint:
  endpoint

export:
  Collision
  require_collision
