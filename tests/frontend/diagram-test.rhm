#lang rhombus
// Checks hierarchical block extraction and compound ready-valid flow channels.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("json/main.rkt").#{string->jsexpr} as parse_json
  "../../rhodium/diagram/main.rhm" open
  "diagram-fixture.rhdl" as fixture
  "event-pipeline-fixture.rhdl" as event_fixture

def nested_top = diagram(event_fixture.nested_channels).module("EventNestedChannels")
def nested_routes = nested_top.channels.filter(~keep: fun (channel): channel.kind == "interface" && channel.source_block.starts_with("instance:") && channel.destination_block.starts_with("instance:"))
def projected_top = diagram(event_fixture.nested_projected_channels).module("EventNestedProjectedChannels")
def projected_routes = projected_top.channels.filter(~keep: fun (channel): channel.kind == "interface" && channel.source_block.starts_with("instance:") && channel.destination_block.starts_with("instance:"))
check:
  projected_routes.map(fun (channel): channel.source_block ++ ":" ++ channel.source_port ++ "->" ++ channel.destination_block ++ ":" ++ channel.destination_port).sort() ~is nested_routes.map(fun (channel): channel.source_block ++ ":" ++ channel.source_port ++ "->" ++ channel.destination_block ++ ":" ++ channel.destination_port).sort()
  nested_routes.map(fun (channel): channel.source_block ++ ":" ++ channel.source_port ++ "->" ++ channel.destination_block ++ ":" ++ channel.destination_port).sort() ~is [
    "instance:requester:bus.traffic.auxiliary->instance:responder:bus.traffic.auxiliary",
    "instance:requester:bus.traffic.request->instance:responder:bus.traffic.request",
    "instance:responder:bus.traffic.response->instance:requester:bus.traffic.response"
  ]

def view = diagram(fixture.logical)
def top = view.module("DiagramFlow")
def flow_blocks = top.blocks.filter(
  ~keep: fun (block): block.kind == "flow"
)
def flow_kinds = flow_blocks.map(fun (block): block.label)
def flow_behaviors = flow_blocks.map(fun (block): block.behavior)
def boundary_behaviors = top.blocks.filter(
  ~keep: fun (block): block.kind == "boundary" || block.kind == "boundary-array"
).map(fun (block): block.behavior)
def all_channels_typed = for all (channel in top.channels):
  channel.protocol.contains("bits<8>")
def all_channels_backpressured = for all (channel in top.channels):
  channel.backpressured
def all_channels_are_interfaces = for all (channel in top.channels):
  channel.kind == "interface"
def json = diagram_to_json(view)
def parsed_json = parse_json(json)
def module_json = diagram_module_to_json(top)
def parsed_module_json = parse_json(module_json)
def dot = diagram_module_to_dot(top)
def pipe_module = view.module(flow_blocks[2].child_module)
def transparent_link_top = diagram(fixture.transparent_link_logical).module(
  "DiagramTransparentLink"
)
def transparent_link_channel = transparent_link_top.channels[0]
def transparent_link_dot = diagram_module_to_dot(transparent_link_top)
def behavior_top = diagram(fixture.behavior_logical).module("DiagramBehavior")
def explicit_control_top = diagram(fixture.explicit_control_logical).module(
  "DiagramExplicitControl"
)
def reconvergent_top = diagram(fixture.reconvergent_logical).module(
  "DiagramReconvergent"
)
def stateful_instance = behavior_top.blocks.find(
  fun (block): block.id == "instance:stateful"
)
def combinational_instance = behavior_top.blocks.find(
  fun (block): block.id == "instance:combinational"
)
def channel_style_module = DiagramModule(
  "channel-styles",
  "ChannelStyles",
  [],
  [DiagramChannel("decoupled", "a", "out", "b", "in",
                  "Decoupled<bits<8>>", #true, "interface", "Decoupled"),
   DiagramChannel("irrevocable", "b", "out", "c", "in",
                  "Irrevocable<bits<8>>", #true, "interface", "Irrevocable"),
   DiagramChannel("valid", "c", "out", "d", "in",
                  "Valid<bits<8>>", #false, "interface", "Valid"),
   DiagramChannel("data", "d", "out", "e", "in",
                  "bits<8>", #false, "data", "data")]
)
def channel_style_dot = diagram_module_to_dot(channel_style_module)
def combo_stub_module = DiagramModule(
  "combo-stubs",
  "ComboStubs",
  [DiagramBlock(
    "mixed",
    "mixed",
    "instance",
    [DiagramPort("flow_in", "flow_in", "input", "Valid<bits<8>>", #false, #true),
     DiagramPort("flow_out", "flow_out", "output", "Valid<bits<8>>", #false, #true),
     DiagramPort("control", "control", "input", "bool"),
     DiagramPort("status", "status", "output", "bool")]
  )],
  []
)
def combo_stub_dot = diagram_module_to_dot(combo_stub_module)

check:
  top != #false ~is #true
  flow_kinds ~is ["map", "filter", "pipe", "atomic-fork"]
  flow_behaviors ~is ["combinational", "combinational", "sequential", "combinational"]
  boundary_behaviors ~is ["boundary", "boundary"]
  flow_blocks[2].properties["stages"] ~is 1
  flow_blocks[2].delegate_ports ~is {"in": "ingress", "out": "egress"}
  flow_blocks[2].trace_model ~is #false
  pipe_module.blocks.find(fun (block): block.id == "contract:data").behavior ~is "sequential"
  pipe_module.blocks.find(fun (block): block.id == "contract:data").trace_model.elastic_stages().length() ~is 1
  flow_blocks[3].properties["outputs"] ~is 2
  flow_blocks[0].ports.find(fun (port): port.id == "combo") != #false ~is #true
  flow_blocks[1].ports.find(fun (port): port.id == "combo") != #false ~is #true
  flow_blocks[2].ports.find(fun (port): port.id == "combo") ~is #false
  top.channels.length() ~is 6
  all_channels_typed ~is #true
  all_channels_backpressured ~is #true
  all_channels_are_interfaces ~is #true
  top.blocks.find(fun (block): block.id == "instance:pipe_stage") ~is #false
  top.blocks.find(fun (block): block.id == "instance:fork_stage") ~is #false
  top.blocks.find(fun (block): block.id == "input:clock") ~is #false
  top.blocks.find(fun (block): block.id == "input:reset") ~is #false
  transparent_link_top.channels.length() ~is 1
  transparent_link_channel.source_block ~is "boundary:source"
  transparent_link_channel.destination_block ~is "boundary:sink"
  transparent_link_channel.protocol ~is "Valid<bits<8>>"
  transparent_link_channel.kind ~is "interface"
  transparent_link_top.blocks.find(
    fun (block): block.label == "first_bridge" || block.label == "second_bridge"
  ) ~is #false
  transparent_link_dot.contains("style=dashed") ~is #true
  json.contains("\"top\":\"DiagramFlow\"") ~is #true
  json.contains("\"modules\":[{") ~is #true
  json.contains("\"blocks\":[{") ~is #true
  json.contains("\"backpressured\":true") ~is #true
  json.contains("\"behavior\":\"sequential\"") ~is #true
  json.contains("\"protocol_family\":\"Decoupled\"") ~is #true
  json.contains("\"protocol_family\":\"Irrevocable\"") ~is #true
  parsed_json != #false ~is #true
  module_json.contains("\"name\":\"DiagramFlow\"") ~is #true
  module_json.contains("\"modules\"") ~is #false
  parsed_module_json != #false ~is #true
  dot.contains("digraph \"DiagramFlow\"") ~is #true
  dot.contains("subgraph \"cluster_DiagramFlow\"") ~is #true
  dot.contains("PORT=\"p0\"") ~is #true
  dot.contains("rank=source") ~is #true
  dot.contains("rank=sink") ~is #true
  dot.contains("\"boundary:source::interface\" [shape=point") ~is #true
  dot.contains("xlabel=\"source\"") ~is #true
  dot.contains("margin=0") ~is #true
  dot.contains("\"transform:0\":\"p0\"") ~is #true
  dot.contains("dir=both") ~is #true
  dot.contains("BGCOLOR=\"lightgray\"") ~is #true
  channel_style_dot.contains("penwidth=3") ~is #true
  channel_style_dot.contains("style=dashed") ~is #true
  channel_style_dot.contains("style=dotted") ~is #false
  channel_style_dot.contains("\"d\" -> \"e\"") ~is #false
  channel_style_dot.contains("bits<8>") ~is #false
  combo_stub_dot.contains("\"mixed::ether::control\" -> \"mixed\":\"p2\"") ~is #true
  combo_stub_dot.contains("\"mixed\":\"p3\" -> \"mixed::ether::status\"") ~is #true
  combo_stub_dot.contains("style=dotted") ~is #true
  pipe_module != #false ~is #true
  pipe_module.blocks.find(fun (block): block.kind == "register").behavior ~is "sequential"
  stateful_instance.behavior ~is "sequential"
  combinational_instance.behavior ~is "combinational"
  stateful_instance.ports.find(fun (port): port.id == "clock") ~is #false
  stateful_instance.ports.find(fun (port): port.id == "reset") ~is #false
  combinational_instance.ports.find(fun (port): port.id == "clock") ~is #false
  combinational_instance.ports.find(fun (port): port.id == "reset") ~is #false
  explicit_control_top.blocks.find(fun (block): block.id == "input:clock") != #false ~is #true
  explicit_control_top.blocks.find(fun (block): block.id == "input:reset") != #false ~is #true
  reconvergent_top.channels.length() ~is 1
  reconvergent_top.channels[0].source_block ~is "input:source"
  reconvergent_top.channels[0].destination_block ~is "output:result"
