  configured0.left.bits <== sources[0].bits
  configured0.right.ready <== sinks[0].ready
  sources[0] |> lane0.ingress
  lane0.egress |> sinks[0]
  reference0.ingress.valid <== sources[0].valid
  reference0.ingress.bits <== sources[0].bits
  reference0.egress.ready <== sinks[0].ready
