#lang rhodium
// Defines invalid RISC-V field uses retained as frontend rejection fixtures.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../riscv/model/fields.rhm" open
  "../../riscv/model/formats.rhm" open
  "../../riscv/rtl/instruction-fields.rhdl" open

circuit NarrowImmediateFixture():
  input instruction: Bits(32)
  output immediate: Bits(11)
  immediate <== instruction_immediate(IImmediate, instruction, 11)

circuit OutsideFieldFixture():
  input instruction: Bits(32)
  output value: Bits(1)
  value <== instruction_field(BitField("outside", 32, 32), instruction)

export:
  NarrowImmediateFixture
  OutsideFieldFixture
