#lang rhombus
// Checks bundle-owned methods, typed results, and exact producer propagation.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "bundle-method-fixture.rhdl" as fixture

def module_def = fixture.design.modules[0]
def equalities = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.eq"
)
def ands = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.and"
)
def ors = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.or"
)

check:
  record_type(module_def.find_input("envelope").type) ~is #true
  vector_type(module_def.find_input("envelopes").type) ~is #true
  equalities.length() ~is 34
  ands.length() ~is 10
  ors.length() ~is 0
  verify_design(fixture.design) ~is #void
  verify_design(fixture.parameterized_design) ~is #void
  verify_design(fixture.direct_interface_design) ~is #void
