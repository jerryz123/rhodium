#lang rhodium
// Exercises composed fixed delays and filters across an annotated child boundary.

import:
  lib("rhodium/std/flow.rhdl") open

sync_circuit EventPipelineChild():
  interface ingress(Valid(Bits(8)), ~role: consumer)
  interface egress(Valid(Bits(8)), ~role: producer)
  ingress
    |> valid_pipe(2)
    |> trace_valid_event("middle")
    |> map_valid(payload => payload + bits(1, 8))
    |> valid_pipe(1)
    |> egress

sync_circuit EventPipeline():
  interface source(Valid(Bits(8)), ~role: consumer)
  interface sink(Valid(Bits(8)), ~role: producer)
  inst child(EventPipelineChild())
  source
    |> trace_valid_event("accepted")
    |> filter_valid(payload => !(payload === bits(0, 8)))
    |> valid_pipe(1)
    |> child.ingress
  child.egress
    |> filter_valid(payload => !(payload === bits(4, 8)))
    |> trace_valid_event("completed", ~terminal: #true)
    |> sink

def pipeline = elaborate_with_top(EventPipeline())

// Invalid use of the supported fixed-latency contract: a route cannot
// describe two inputs as a one-to-one pipeline.
sync_circuit EventBadLatencyShape():
  interface source[2](Valid(Bits(8)), ~role: consumer)
  interface sink(Valid(Bits(8)), ~role: producer)
  sink <=> source[0]
  describe_interface_transform(InterfaceHandle(source, sink), "invalid-delay", ~trace_model: interface_trace_fixed_latency(1))

fun bad_latency_shape(): elaborate_with_top(EventBadLatencyShape())
fun bad_latency_count(): interface_trace_fixed_latency(0)

export:
  pipeline
  bad_latency_shape
  bad_latency_count
