#lang rhombus
// Checks generic shift-register typing, reset modes, initialization, enable, and errors.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "std-shift-register.rhdl" as fixture

fun operations(module_def, opcode):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == opcode
  )

def bundle_module = fixture.bundle_design.modules[0]
def resetless_module = fixture.resetless_design.modules[0]
def per_stage_module = fixture.per_stage_design.modules[0]
def dual_module = fixture.dual_design.modules[0]
def option_module = fixture.option_design.modules[0]

check:
  type_equal(
    bundle_module.find_output("stages").type,
    VectorType(3, fixture.Sample())
  ) ~is #true
  operations(bundle_module, "rtl.register_reset").length() ~is 1
  operations(bundle_module, "rtl.mux_lookup").length() ~is 1
  operations(resetless_module, "rtl.register").length() ~is 1
  operations(resetless_module, "rtl.register_reset").length() ~is 0
  type_equal(
    operations(resetless_module, "rtl.register")[0].results[0].type,
    VectorType(2, Bits(4))
  ) ~is #true
  operations(per_stage_module, "rtl.register_reset").length() ~is 1
  operations(dual_module, "rtl.register").length() ~is 2
  operations(option_module, "rtl.register").length() ~is 1
  operations(option_module, "rtl.register_reset").length() ~is 1
  operations(option_module, "rtl.mux_lookup").length() ~is 2
  verify_design(fixture.bundle_design) ~is #void
  verify_design(fixture.resetless_design) ~is #void
  verify_design(fixture.per_stage_design) ~is #void
  verify_design(fixture.dual_design) ~is #void
  verify_design(fixture.option_design) ~is #void
  embedded.run_elaboration(
    fun (): fixture.BadShiftRegisterInitialType()
  ) ~throws "element type or the full stage-vector type"
  embedded.run_elaboration(
    fun (): fixture.BadShiftRegisterInitialLength()
  ) ~throws "element type or the full stage-vector type"
  embedded.run_elaboration(
    fun (): fixture.BadShiftRegisterDynamicInitial()
  ) ~throws "initial value must be a hardware literal"
  embedded.run_elaboration(
    fun (): fixture.BadShiftRegisterEnable()
  ) ~throws "enable must have Bool hardware type"
