#lang rhodium
// Exercises traced wrappers, shared untouched subtrees, and wide Valid payloads.

import:
  lib("flow/main.rhdl") open

circuit EventRuntimeIdentity():
  input data: Bits(8)
  output result: Bits(8)
  result <== data

circuit EventRuntimeMapper():
  input data: Bits(8)
  output result: Bits(8)
  inst identity(EventRuntimeIdentity())
  identity.data <== data
  result <== identity.result + bits(1, 8)

sync_circuit EventRuntimeChild():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  interface egress(Decoupled(Bits(8)), ~role: producer)
  inst mapper(EventRuntimeMapper())
  mapper.data <== ingress.bits
  ingress
    |> map_flow(payload => mapper.result)
    |> trace_event("mapped")
    |> filter_flow(payload => !(payload === bits(3, 8)))
    |> egress

sync_circuit EventRuntimeWrapper():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  interface egress(Decoupled(Bits(8)), ~role: producer)
  inst child(EventRuntimeChild())
  ingress |> child.ingress
  child.egress |> egress

sync_circuit EventRuntime():
  input enabled: Bool
  output heartbeat: Bits(8)
  reg functional_count(~init: bits(0, 8))
  functional_count <== functional_count + bits(1, 8)
  inst identity(EventRuntimeIdentity())
  identity.data <== functional_count
  heartbeat <== identity.result
  interface sources[2](Decoupled(Bits(8)), ~role: consumer)
  interface sinks[2](Decoupled(Bits(8)), ~role: producer)
  interface wide_source(Valid(Bits(65)), ~role: consumer)
  interface wide_sink(Valid(Bits(65)), ~role: producer)
  inst left(EventRuntimeWrapper())
  inst right(EventRuntimeWrapper())
  sources[0] |> trace_event("left-input") |> gate_flow(enabled) |> left.ingress
  left.egress |> trace_event("left-output", ~terminal: #true) |> sinks[0]
  sources[1] |> trace_event("right-input") |> right.ingress
  right.egress |> trace_event("right-output", ~terminal: #true) |> sinks[1]
  wide_source
    |> trace_valid_event("wide-input")
    |> map_valid(payload => payload)
    |> filter_valid(payload => !(payload === bits(0, 65)))
    |> trace_valid_event("wide-output", ~terminal: #true)
    |> wide_sink

circuit EventWrongDomain():
  input clock: Clock
  input reset: Reset
  input other_clock: Clock
  inst child(EventRuntimeChild(), ~clock: other_clock, ~reset: reset)
  interface source(Decoupled(Bits(8)), ~role: consumer)
  interface sink(Decoupled(Bits(8)), ~role: producer)
  source |> trace_event("before") |> child.ingress
  child.egress |> trace_event("after") |> sink

def runtime = elaborate_with_top(EventRuntime())
fun wrong_domain(): elaborate_with_top(EventWrongDomain())

sync_circuit EventTerminalChain():
  interface source(Decoupled(Bits(8)), ~role: consumer)
  interface sink(Decoupled(Bits(8)), ~role: producer)
  source |> trace_event("stop", ~terminal: #true) |> trace_event("after-stop") |> sink

circuit EventBadGuard():
  def invalid = interface_trace_combinational(~guard: bits(0, 2))

def terminal_chain = elaborate_with_top(EventTerminalChain())
fun bad_guard(): elaborate_with_top(EventBadGuard())
export:
  runtime
  wrong_domain
  terminal_chain
  bad_guard
