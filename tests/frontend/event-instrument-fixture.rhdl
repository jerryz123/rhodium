#lang rhodium
// Exercises traced wrappers, shared untouched subtrees, and wide Valid payloads.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("flow/main.rhdl") open

circuit EventRuntimeIdentity():
  input data: Bits(8)
  output result: Bits(8)
  result <== data

circuit EventRuntimeMapper():
  input data: Bits(8)
  output result: Bits(8)
  inst identity(EventRuntimeIdentity())
  identity.data <== data
  result <== identity.result + bits(1, 8)

sync_circuit EventRuntimeChild():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  interface egress(Decoupled(Bits(8)), ~role: producer)
  inst mapper(EventRuntimeMapper())
  mapper.data <== ingress.bits
  ingress
    |> map_flow(payload => mapper.result)
    |> trace_event("mapped", ~payload: #true)
    |> filter_flow(payload => !(payload === bits(3, 8)))
    |> egress

sync_circuit EventRuntimeWrapper():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  interface egress(Decoupled(Bits(8)), ~role: producer)
  inst child(EventRuntimeChild())
  ingress |> child.ingress
  child.egress |> egress

sync_circuit EventRuntime():
  input enabled: Bool
  output heartbeat: Bits(8)
  reg functional_count(~init: bits(0, 8))
  functional_count <== functional_count + bits(1, 8)
  inst identity(EventRuntimeIdentity())
  identity.data <== functional_count
  heartbeat <== identity.result
  interface sources[2](Decoupled(Bits(8)), ~role: consumer)
  interface sinks[2](Decoupled(Bits(8)), ~role: producer)
  interface wide_source(Valid(Bits(65)), ~role: consumer)
  interface wide_sink(Valid(Bits(65)), ~role: producer)
  inst left(EventRuntimeWrapper())
  inst right(EventRuntimeWrapper())
  sources[0] |> trace_event("left-input", ~payload: #true) |> gate_flow(enabled) |> left.ingress
  left.egress |> trace_event("left-output", ~payload: #true) |> sinks[0]
  sources[1] |> trace_event("right-input", ~payload: #true) |> right.ingress
  right.egress |> trace_event("right-output", ~payload: #true) |> sinks[1]
  def observed_wide = wide_source
    |> trace_valid_event("wide-input", ~payload: #true)
    |> map_valid(payload => payload)
    |> filter_valid(payload => !(payload === bits(0, 65)))
    |> trace_valid_event("wide-output", ~fields: payload):
         low: payload[0..37]
         high: payload[64]
  observed_wide |> wide_sink

circuit EventWrongDomain():
  input clock: Clock
  input reset: Reset
  input other_clock: Clock
  inst child(EventRuntimeChild(), ~clock: other_clock, ~reset: reset)
  interface source(Decoupled(Bits(8)), ~role: consumer)
  interface sink(Decoupled(Bits(8)), ~role: producer)
  source |> trace_event("before", ~payload: #true) |> child.ingress
  child.egress |> trace_event("after", ~payload: #true) |> sink

def runtime = elaborate_with_top(EventRuntime())
fun wrong_domain(): elaborate_with_top(EventWrongDomain())

sync_circuit EventCheckpointChain():
  interface source(Decoupled(Bits(8)), ~role: consumer)
  interface sink(Decoupled(Bits(8)), ~role: producer)
  source |> trace_event("first", ~payload: #true) |> trace_event("second", ~payload: #true) |> trace_event("third", ~payload: #true) |> sink

circuit EventBadGuard():
  def invalid = interface_trace_combinational(~guard: bits(0, 2))

def checkpoint_chain = elaborate_with_top(EventCheckpointChain())
fun bad_guard(): elaborate_with_top(EventBadGuard())

sync_circuit EventUntouchedCounter():
  output value: Bits(8)
  reg count(~init: bits(7, 8))
  count <== count + bits(1, 8)
  value <== count

bundle EventOpaquePayload():
  tag: Bits(3)
  data: Bits(70)

sync_circuit EventOpaqueSource():
  interface output_link(Decoupled(EventOpaquePayload()), ~role: producer)
  def local_reset = !reset_active().into(Bool)
  inst state(EventUntouchedCounter(), ~reset_when: local_reset)
  output_link.valid <== bits(1, 1).into(Bool)
  output_link.bits <== EventOpaquePayload():
    tag: bits(5, 3)
    data: state.value.zext(70)

sync_circuit EventRootBoundary(root :: Boolean):
  interface sink(Decoupled(EventOpaquePayload()), ~role: producer)
  inst opaque(EventOpaqueSource())
  opaque.output_link |> trace_event("start", ~payload: #true, ~root: root) |> trace_event("end", ~payload: #true) |> sink

sync_circuit EventRootCut():
  interface source(Valid(Bits(8)), ~role: consumer)
  interface sink(Valid(Bits(8)), ~role: producer)
  source |> trace_valid_event("before", ~payload: #true) |> trace_valid_event("start", ~payload: #true, ~root: #true) |> trace_valid_event("end", ~payload: #true) |> sink

fun root_boundary(root :: Boolean): elaborate_with_top(EventRootBoundary(root))
def root_cut = elaborate_with_top(EventRootCut())
export:
  runtime
  wrong_domain
  checkpoint_chain
  bad_guard
  root_boundary
  root_cut
