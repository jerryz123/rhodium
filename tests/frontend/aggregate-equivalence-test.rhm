#lang rhombus
// Proves concise bundles and interfaces elaborate like their explicit record forms.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../examples/lop/bundle-kernel.rhdl" as bundle_kernel
  "../../examples/lop/bundle-standard.rhdl" as bundle_standard
  "../../examples/lop/interface-records.rhdl" as interface_records
  "../../examples/rtl/interface.rhdl" as interface_standard

check:
  dump_ir(bundle_standard.design) ~is dump_ir(bundle_kernel.design)
  dump_ir(interface_standard.design) ~is dump_ir(interface_records.design)
