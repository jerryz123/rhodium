#lang rhodium
// Defines invalid DPI bindings and unsupported conditional DPI effects for diagnostics.
// SPDX-License-Identifier: Apache-2.0

dpi_import procedure rhodium_trace(value: Bits(8))
dpi_import function rhodium_step(value: Bits(8)) -> result: Bits(8)
dpi_import function rhodium_step_pair(value: Bits(8)) -> (out doubled: Bits(8), return incremented: Bits(8))

sync_circuit SingularBinding():
  input value: Bits(8)
  output result: Bits(8)

  dpi_reg step = rhodium_step_pair(value)
  result <== step

sync_circuit WrongResultCount():
  input value: Bits(8)
  output result: Bits(8)

  dpi_reg (first, second, third) = rhodium_step_pair(value)
  result <== first

sync_circuit ConditionalProcedure():
  input guard: Bits(1)
  input value: Bits(8)

  when guard:
    rhodium_trace.call(value)

sync_circuit ConditionalRegister():
  input guard: Bits(1)
  input value: Bits(8)

  when guard:
    dpi_reg result = rhodium_step(value)
    #void

sync_circuit ConditionalRegisters():
  input guard: Bits(1)
  input value: Bits(8)

  when guard:
    dpi_reg (doubled, incremented) = rhodium_step_pair(value)
    #void

export:
  SingularBinding
  WrongResultCount
  ConditionalProcedure
  ConditionalRegister
  ConditionalRegisters
