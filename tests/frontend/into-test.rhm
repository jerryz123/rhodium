#lang rhombus
// Checks that base `.into` syntax preserves the existing explicit-cast semantics.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "into-fixture.rhdl" as fixture

def module_def = fixture.design.modules[0]
def casts = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.cast"
)

check:
  casts.length() ~is 2
  type_equal(casts[0].operands[0].type, Bits(1)) ~is #true
  reset_type(casts[0].results[0].type) ~is #true
  reset_type(casts[1].operands[0].type) ~is #true
  type_equal(casts[1].results[0].type, Bits(1)) ~is #true
  module_def.find_output("restored").place.driver === casts[1].results[0] ~is #true
  verify_design(fixture.design) ~is #void
