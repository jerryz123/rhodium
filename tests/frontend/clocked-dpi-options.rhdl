#lang rhodium
// Exercises order-independent clock and enable options on single and multiple DPI registers.
// SPDX-License-Identifier: Apache-2.0

dpi_import function option_step(value: Bits(8)) -> result: Bits(8)
dpi_import function option_step_pair(value: Bits(8)) -> (out doubled: Bits(8), return incremented: Bits(8))

circuit ReorderedDPIOptions():
  input clock: Clock
  input enable: Bool
  input value: Bits(8)
  output(single, doubled, incremented): Bits(8)

  dpi_reg stepped = option_step(value, ~enable: enable, ~clock: clock)
  dpi_reg (pair_doubled, pair_incremented) = option_step_pair(
    value,
    ~enable: enable,
    ~clock: clock
  )
  single <== stepped
  doubled <== pair_doubled
  incremented <== pair_incremented

def design = elaborate(ReorderedDPIOptions())

export:
  design
