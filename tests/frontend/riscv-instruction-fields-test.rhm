#lang rhombus
// Checks hardware extraction generated from RISC-V field and immediate descriptors.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../examples/riscv/instruction-fields.rhdl" as example
  "riscv-instruction-fields-fixture.rhdl" as fixture

def design = example.design
def module_def = design.modules[0]
def extracts = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.extract"
)
def sign_extensions = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.sext"
)
def zero_extensions = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.zext"
)
fun has_extract(low, high):
  extracts.find(
    fun (operation):
      operation.attribute("low") == low && operation.attribute("high") == high
  ) != #false

check:
  module_def.outputs.map(fun (port): port.name) ~is [
    "rd_value", "rs1_value", "rs2_value",
    "i_value", "s_value", "b_value", "u_value", "j_value", "shift_value"
  ]
  module_def.outputs.map(fun (port): port.type.width) ~is [
    5, 5, 5, 64, 64, 64, 64, 64, 64
  ]
  has_extract(7, 11) ~is #true
  has_extract(15, 19) ~is #true
  has_extract(20, 24) ~is #true
  has_extract(25, 31) ~is #true
  has_extract(31, 31) ~is #true
  has_extract(12, 19) ~is #true
  has_extract(21, 30) ~is #true
  sign_extensions.length() ~is 5
  zero_extensions.length() ~is 1
  verify_design(design) ~is #void
  embedded.run_elaboration(
    fun (): fixture.NarrowImmediateFixture()
  ) ~throws "must cover the architectural immediate"
  embedded.run_elaboration(
    fun (): fixture.OutsideFieldFixture()
  ) ~throws "must fit the 32-bit instruction word"
