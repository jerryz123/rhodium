#lang rhodium/base
// Builds the enum switch state machine from explicitly selected frontend layers.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/layers/comb.rhm") open
  lib("rhodium/frontend/layers/sequential.rhm") open
  lib("rhodium/frontend/layers/enum.rhm") open
  lib("rhodium/frontend/layers/conditional.rhm") open

hardware_enum State:
  Idle
  Running
  Done

circuit StateMachine():
  input clock: Clock
  input reset: Reset
  output state_out: State

  reg current(State, ~clock: clock, ~reset: reset, ~init: State.Idle)
  switch current:
    case State.Idle:
      current <== State.Running
    case State.Running:
      current <== State.Done
    case State.Done:
      current <== State.Idle
    otherwise:
      current <== State.Idle
  state_out <== current

def design = elaborate(StateMachine())

export:
  State
  StateMachine
  design
