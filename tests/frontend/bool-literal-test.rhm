#lang rhombus
// Checks that callable Bool literals lower through explicit Bits constants and casts.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/frontend/layers/bool.rhm" as bool
  "bool-literal-fixture.rhdl" as fixture

def module_def = fixture.design.modules[0]
def constants = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.constant"
)
def casts = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.cast"
)

check:
  constants.map(fun (operation): operation.attribute("value")) ~is [1, 0]
  constants.map(fun (operation): operation.results[0].type) ~is [Bits(1), Bits(1)]
  casts.length() ~is 2
  casts.map(fun (operation): bool.bool_type(operation.results[0].type)) ~is [#true, #true]
  module_def.find_output("high").place.driver === casts[0].results[0] ~is #true
  module_def.find_output("low").place.driver === casts[1].results[0] ~is #true
  verify_design(fixture.design) ~is #void
