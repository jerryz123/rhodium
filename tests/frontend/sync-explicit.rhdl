#lang rhodium
// Constructs the sync-counter hierarchy with fully explicit clock and reset wiring.
// SPDX-License-Identifier: Apache-2.0

circuit Counter(width):
  input clock: Clock
  input reset: Reset
  output count: Bits(width)

  def zero = bits(0, width)
  reg state(Bits(width), ~clock: clock, ~reset: reset, ~init: zero)
  def one = bits(1, width)
  state <== state + one
  count <== state

circuit CounterTop(width):
  input clock: Clock
  input reset: Reset
  output count: Bits(width)

  def CounterModule = Counter(width)
  inst counter(CounterModule)
  counter.clock <== clock
  counter.reset <== reset
  count <== counter.count

def design = elaborate(CounterTop(8))

export:
  Counter
  CounterTop
  design
