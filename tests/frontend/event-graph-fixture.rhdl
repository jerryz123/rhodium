#lang rhodium
// Defines annotated ready-valid flow topologies for static event-graph tests.

import:
  lib("flow/main.rhdl") open
  lib("flow/ready-valid-support.rhdl").flow_protocol_type

sync_circuit EventLinear():
  interface source(Decoupled(Bits(8)), ~role: consumer)
  interface sink(Decoupled(Bits(8)), ~role: producer)

  source
    |> trace_event("accepted", ~payload: #true)
    |> map_flow(payload => payload + bits(1, 8))
    |> pipe(1)
    |> trace_event("issued", ~payload: #true)
    |> queue(2, ~flow: #true)
    |> trace_event("completed", ~payload: #true, ~terminal: #true)
    |> sink

sync_circuit EventFork():
  interface source(Decoupled(Bits(8)), ~role: consumer)
  interface sinks[2](Decoupled(Bits(8)), ~role: producer)

  def Array(left, right) = source
    |> trace_event("fork-root", ~payload: #true)
    |> atomic_fork(2)
  left |> trace_event("left", ~payload: #true) |> sinks[0]
  right |> trace_event("right", ~payload: #true) |> sinks[1]

sync_circuit EventMerge():
  interface left_source(Decoupled(Bits(8)), ~role: consumer)
  interface right_source(Decoupled(Bits(8)), ~role: consumer)
  interface sink(Decoupled(Bits(8)), ~role: producer)

  def left = left_source |> trace_event("left", ~payload: #true)
  def right = right_source |> trace_event("right", ~payload: #true)
  Array(left, right)
    |> zip_flow(left_bits, right_bits => left_bits ^ right_bits)
    |> trace_event("joined", ~payload: #true)
    |> sink

circuit EventValid():
  interface source(Valid(Bits(8)), ~role: consumer)
  interface sink(Valid(Bits(8)), ~role: producer)

  source |> trace_valid_event("observed", ~payload: #true) |> sink

sync_circuit EventChild():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  interface egress(Decoupled(Bits(8)), ~role: producer)

  ingress |> trace_event("inside", ~payload: #true) |> egress

sync_circuit EventHierarchy():
  interface sources[2](Decoupled(Bits(8)), ~role: consumer)
  interface sinks[2](Decoupled(Bits(8)), ~role: producer)

  inst left_child(EventChild())
  inst right_child(EventChild())
  sources[0] |> trace_event("before-left", ~payload: #true) |> left_child.ingress
  left_child.egress |> trace_event("after-left", ~payload: #true) |> sinks[0]
  sources[1] |> trace_event("before-right", ~payload: #true) |> right_child.ingress
  right_child.egress |> trace_event("after-right", ~payload: #true) |> sinks[1]

fun opaque_flow()
  :: ((source :: FlowSource) -> InterfaceTransformResult(source, Endpoint)):
  fun (source :: FlowSource) :~ InterfaceTransformResult(source, Endpoint):
    def protocol = flow_protocol_type(source)
    def input_link = interface_link(protocol, "opaque_input")
    def output_link = interface_link(protocol, "opaque_output")
    def input_endpoint = input_link.right
    def output_endpoint = output_link.left
    output_endpoint.field("valid") <== input_endpoint.field("valid")
    output_endpoint.field("bits") <== input_endpoint.field("bits")
    input_endpoint.field("ready") <== output_endpoint.field("ready")
    finish_interface_transform(
      source,
      describe_interface_transform(
        interface_transform(input_link, output_link),
        "opaque"
      )
    )

sync_circuit EventOpaque():
  interface source(Decoupled(Bits(8)), ~role: consumer)
  interface sink(Decoupled(Bits(8)), ~role: producer)

  source
    |> trace_event("before", ~payload: #true)
    |> opaque_flow()
    |> trace_event("after", ~payload: #true)
    |> sink

circuit EmptyEventLabel():
  interface source(Decoupled(Bits(8)), ~role: consumer)
  interface sink(Decoupled(Bits(8)), ~role: producer)

  source |> trace_event("", ~payload: #true) |> sink

circuit DuplicateEventLabel():
  interface sources[2](Decoupled(Bits(8)), ~role: consumer)
  interface sinks[2](Decoupled(Bits(8)), ~role: producer)

  sources[0] |> trace_event("duplicate", ~payload: #true) |> sinks[0]
  sources[1] |> trace_event("duplicate", ~payload: #true) |> sinks[1]

def linear = elaborate_with_top(EventLinear())
def forked = elaborate_with_top(EventFork())
def merged = elaborate_with_top(EventMerge())
def valid = elaborate_with_top(EventValid())
def hierarchical = elaborate_with_top(EventHierarchy())
def opaque = elaborate_with_top(EventOpaque())

fun elaborate_empty_event(): elaborate_with_top(EmptyEventLabel())
fun elaborate_duplicate_event(): elaborate_with_top(DuplicateEventLabel())

bundle CaptureNested():
  pc: Bits(64)
  instruction: Bits(32)

bundle CapturePayload():
  ignored: Bits(256)
  nested: CaptureNested()
  fault: Bool

sync_circuit EventCaptures():
  interface source(Decoupled(CapturePayload()), ~role: consumer)
  interface sink(Decoupled(CapturePayload()), ~role: producer)
  def selected = source |> trace_event("selected", ~fields: payload):
    pc: payload.nested.pc
    instruction(~format: "riscv", ~isa: "rv64im", ~pc: "pc"): payload.nested.instruction
    fault: payload.fault
    low(~format: "unsigned"): payload.nested.pc[0..5] + bits(1, 5)
  selected |> trace_event("identity-only") |> sink

sync_circuit InvalidCaptures(kind :: String):
  interface source(Valid(CapturePayload()), ~role: consumer)
  interface sink(Valid(CapturePayload()), ~role: producer)
  cond
  | kind.starts_with("riscv"):
      def selected = source |> trace_valid_event("invalid", ~fields: payload):
        pc: if kind == "riscv-pc-width" | payload.nested.instruction | payload.nested.pc
        opcode(~format: "riscv", ~isa: (if kind == "riscv-isa" | "missing" | "rv64im"), ~pc: (if kind == "riscv-pc" | "absent" | "pc")): if kind == "riscv-width" | payload.nested.pc | payload.nested.instruction
      selected |> sink
  | kind == "metadata":
      def selected = source |> trace_valid_event("invalid", ~fields: payload):
        value(~isa: "rv64i"): payload.nested.instruction
      selected |> sink
  | kind == "duplicate":
      def selected = source |> trace_valid_event("invalid", ~fields: payload):
        pc: payload.nested.pc
        pc: payload.nested.instruction
      selected |> sink
  | kind == "aggregate":
      def selected = source |> trace_valid_event("invalid", ~fields: payload):
        nested: payload.nested
      selected |> sink
  | kind == "cycle":
      def selected = source |> trace_valid_event("invalid", ~fields: payload):
        cycle: payload.nested.pc
      selected |> sink
  | kind == "sequence":
      def selected = source |> trace_valid_event("invalid", ~fields: payload):
        sequence: payload.nested.pc
      selected |> sink
  | ~else:
      def selected = source |> trace_valid_event("invalid", ~fields: payload):
        value(~format: kind): payload.nested.pc
      selected |> sink

def captures = elaborate_with_top(EventCaptures())
fun invalid_captures(kind :: String): elaborate_with_top(InvalidCaptures(kind))

export:
  captures
  invalid_captures
  linear
  forked
  merged
  valid
  hierarchical
  opaque
  elaborate_empty_event
  elaborate_duplicate_event
