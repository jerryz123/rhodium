#lang rhombus
// Checks generic decode composition and the example that grows a control relation.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/frontend/layers/comb.rhm" open
  "../../rhodium/std/decode.rhdl" open
  "../../examples/std/decode-composition.rhdl" as fixture

def module_def = fixture.design.modules[0]
def control_width = fixture.Control().packed_width()
def fallback = DecodeCase(
  Pattern(~value: bits(0, 4), ~care: bits(0, 4)),
  as_pattern(bits(0, 2))
)
def override = DecodeCase(
  Pattern(~value: bits(2, 4), ~care: bits(3, 4)),
  as_pattern(bits(1, 2))
)
def overlaid = overlay_decode_cases([fallback], [override])

fun named_group_cases(inputs):
  decode_groups(fixture.SideEffectControl()):
    group inputs:
      writeback: _

check:
  fixture.base_execute_cases.length() ~is 3
  fixture.extension_execute_cases.length() ~is 2
  fixture.execute_cases.length() ~is 5

  fixture.side_effect_cases.length() ~is 5
  named_group_cases([fixture.add_opcode]).length() ~is 1
  named_group_cases(fixture.non_branch_opcodes).length() ~is 4
  named_group_cases(PatternSet(fixture.Opcode(), [])).length() ~is 0
  decode_cases(
    fixture.non_branch_opcodes,
    fixture.side_effect_cases[0].output
  ).length() ~is 4
  fixture.control_cases.length() ~is 5
  fixture.control_cases[0].input === fixture.add_opcode ~is #true
  type_equal(fixture.control_cases[0].output.type,
             fixture.Control()) ~is #true

  fixture.instruction_cases.length() ~is 5
  type_equal(fixture.instruction_cases[0].input.type,
             fixture.Instruction()) ~is #true
  fixture.instruction_cases[0].input.value_bits ~is 0b0000000
  fixture.instruction_cases[0].input.care_bits ~is 0b1111110
  fixture.instruction_cases[0].output === fixture.control_cases[0].output ~is #true

  fixture.instruction_decode.table.packed_cases.length() ~is 5
  fixture.instruction_decode.table.default.value_bits ~is 0
  control_width ~is 6
  fixture.instruction_decode.table.default.care_bits ~is 0b1000000
  type_equal(module_def.find_input("instruction").type,
             fixture.Instruction()) ~is #true
  type_equal(module_def.find_output("control").type,
             fixture.Control()) ~is #true
  verify_design(fixture.design) ~is #void
  overlaid.length() ~is 3
  DecodeTable(overlaid, ~default: as_pattern(bits(0, 2))).packed_cases.length() ~is 3
  overlaid.find(fun (case): case.input.matches(bits(2, 4))).output.value_bits ~is 1
  overlaid.find(fun (case): case.input.matches(bits(6, 4))).output.value_bits ~is 1
  overlaid.find(fun (case): case.input.matches(bits(1, 4))).output.value_bits ~is 0
  overlay_decode_cases([fallback], []) ~is [fallback]

def unknown_opcode = pattern(fixture.Opcode()):
  major: bits(7, 3)
  minor: bits(3, 2)

check:
  zip_decode_cases(
    fixture.execute_cases,
    [fixture.side_effect_cases[0]],
    fun (left, _): left
  ) ~throws "same number of input cubes"
  zip_decode_cases(
    fixture.execute_cases,
    fixture.side_effect_cases.drop(1) ++ [DecodeCase(
      unknown_opcode,
      fixture.side_effect_cases[0].output
    )],
    fun (left, _): left
  ) ~throws "exactly one right counterpart"
