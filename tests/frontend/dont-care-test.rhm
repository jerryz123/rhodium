#lang rhombus
// Checks typed frontend don't-cares and Pattern-based partial output values.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/frontend/layers/comb.rhm" open
  "../../rhodium/frontend/support/hardware-literal.rhm".HardwareLiteral
  "../../rhodium/std/decode/pattern-value.rhdl".pattern_value
  "../../examples/std/dont-care.rhdl" as fixture

def module_def = fixture.design.modules[0]
def dont_cares = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.dont_care"
)
def casts = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.cast"
)

check:
  fixture.partial is_a HardwareLiteral ~is #false
  dont_cares.length() ~is 3
  dont_cares.map(fun (operation): operation.results[0].type.width) ~is [8, 8, 8]
  casts.filter(
    ~keep: fun (operation): type_equal(operation.results[0].type, fixture.Pair())
  ).length() ~is 2
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.and"
  ).length() ~is 1
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.or"
  ).length() ~is 1
  verify_design(fixture.design) ~is #void
  dont_care(Clock) ~throws "DataType"
  pattern_value(bits(0, 1)) ~throws "Pattern"
