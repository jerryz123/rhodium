#lang rhombus
// Checks generic Bits ordering, layout, alignment, lane-mask widths, and host constraints.

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../rhodium/frontend/layers/bool.rhm" as bool
  "../../rhodium/std/bits.rhdl" as bits_std
  "std-bits-fixture.rhdl" as fixture

fun checked_pow2(value :: bits_std.Pow2Int):
  value

def design = embedded.run_elaboration(fun (): fixture.BitsAlignmentFixture())
def module_def = design.modules[0]
def bit_order_design = embedded.run_elaboration(fun (): fixture.BitOrderFixture())
def bit_order_module = bit_order_design.modules[0]
def extracts = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.extract"
)
def bitwise_ands = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.and" && operation.results[0].type.type_equal(Bits(8))
)
def transfer_design = embedded.run_elaboration(
  fun (): fixture.TransferByteMaskFixture()
)
def transfer_module = transfer_design.modules[0]
def registered_transfer_design = embedded.run_elaboration(
  fun (): fixture.RegisteredTransferByteMaskFixture()
)
def pack_design = embedded.run_elaboration(fun (): fixture.PackFieldsFixture())
def pack_module = pack_design.modules[0]
def mask_design = embedded.run_elaboration(fun (): fixture.MaskExpansionFixture())

check:
  embedded.run_elaboration(fun (): fixture.InvalidRuntimeAlignmentBoundFixture(-1)) ~throws "Nat"
  embedded.run_elaboration(fun (): fixture.InvalidRuntimeAlignmentBoundFixture(9)) ~throws "maximum alignment must fit the Bits width"
  embedded.run_elaboration(fun (): fixture.NonBitsRuntimeAlignmentFixture()) ~throws "Bits"
  embedded.run_elaboration(fun (): fixture.NonBitsAlignmentExponentFixture()) ~throws "Bits"
  mask_design.modules[0].outputs.map(fun (port): port.type) ~is [Bits(8), Bits(24), Bits(64), Bits(1), Bits(7), Bits(20)]
  embedded.run_elaboration(fun (): fixture.InvalidMaskLaneWidthFixture(0)) ~throws "PosInt"
  embedded.run_elaboration(fun (): fixture.InvalidMaskLaneWidthFixture(-1)) ~throws "PosInt"
  embedded.run_elaboration(fun (): fixture.NonBitsMaskExpansionFixture()) ~throws "Bits"
  bits_std.power_of_two(-2) ~is #false
  bits_std.power_of_two(0) ~is #false
  bits_std.power_of_two(1) ~is #true
  bits_std.power_of_two(8) ~is #true
  bits_std.power_of_two(12) ~is #false
  bits_std.power_of_two("8") ~is #false
  checked_pow2(1) ~is 1
  checked_pow2(8) ~is 8
  checked_pow2(2 * 4) + 1 ~is 9
  checked_pow2(3) ~throws "Pow2Int"
  checked_pow2("8") ~throws "Pow2Int"
  bits_std.unsigned_value_count(0) ~is 1
  bits_std.unsigned_value_count(1) ~is 2
  bits_std.unsigned_value_count(8) ~is 256
  bits_std.unsigned_value_count(-1) ~throws "Nat"
  bit_order_module.outputs.map(fun (port): port.type) ~is [
    Bits(8), Bits(4), Bits(1), Bits(1)
  ]
  bit_order_module.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.concat"
  ).length() >= 2 ~is #true
  bit_order_module.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.extract"
  ).length() >= 8 ~is #true
  verify_design(bit_order_design) ~is #void
  bits_std.alignment_bits(1) ~is 0
  bits_std.alignment_bits(2) ~is 1
  bits_std.alignment_bits(8) ~is 3
  bits_std.alignment_bits(256) ~is 8
  module_def.outputs.map(fun (port): port.name) ~is [
    "aligned_1", "aligned_2", "aligned_4", "aligned_8", "aligned_256",
    "down_1", "down_4", "down_256", "merged"
  ]
  extracts.map(fun (operation): operation.attribute("high")) ~is [0, 1, 2, 7]
  bitwise_ands.length() >= 2 ~is #true
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.constant" && operation.attribute("value", #false) == 252
  ).length() ~is 1
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.constant" && operation.attribute("value", #false) == 0 && operation.results[0].type.type_equal(Bits(8))
  ).length() >= 1 ~is #true
  verify_design(design) ~is #void
  transfer_module.outputs.map(fun (port): port.type) ~is [
    bool.Mask(1), bool.Mask(4), bool.Mask(16)
  ]
  transfer_module.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.shl"
  ).length() ~is 3
  verify_design(transfer_design) ~is #void
  verify_design(registered_transfer_design) ~is #void
  pack_module.outputs.map(fun (port): port.type) ~is [Bits(8), Bits(2), Bits(8)]
  pack_module.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.concat"
  ).length() ~is 1
  pack_module.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.or"
  ).length() ~is 0
  verify_design(pack_design) ~is #void
  bits_std.alignment_bits(0) ~throws "Pow2Int"
  bits_std.alignment_bits(3) ~throws "Pow2Int"
  embedded.run_elaboration(
    fun (): fixture.AlignmentTooWideFixture()
  ) ~throws "alignment must fit the Bits width"
  embedded.run_elaboration(
    fun (): fixture.NonPowerAlignmentFixture()
  ) ~throws "Pow2Int"
  embedded.run_elaboration(
    fun (): fixture.NonBitsAlignmentFixture()
  ) ~throws "Bits"
  embedded.run_elaboration(
    fun (): fixture.NonPowerTransferBeatFixture()
  ) ~throws "Pow2Int"
  embedded.run_elaboration(
    fun (): fixture.TransferBeatTooWideFixture()
  ) ~throws "alignment must fit the Bits width"
  embedded.run_elaboration(
    fun (): fixture.OverlappingPackFieldsFixture()
  ) ~throws "fields must not overlap"
  embedded.run_elaboration(
    fun (): fixture.OutOfRangePackFieldsFixture()
  ) ~throws "field must fit the result width"
