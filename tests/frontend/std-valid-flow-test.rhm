#lang rhombus
// Checks Valid mapping/fanout and completion-reservation queue structure and diagnostics.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../examples/std/valid-flow.rhdl" as valid_example
  "../../examples/std/completion-queue.rhdl" as completion_example
  "std-valid-flow.rhdl" as fixture

def valid_top = valid_example.design.modules[0]
def accepted_top = valid_example.accepted_design.modules[0]
def checked_decoupled_top = valid_example.decoupled_design.modules[0]
def generic_boundary_top = fixture.generic_boundary_design.modules[0]
def control_boundary_top = fixture.control_boundary_design.modules[0]
def reverse_provider_boundary_top = fixture.reverse_provider_boundary_design.modules[0]
def detached_boundary_top = fixture.detached_boundary_design.modules.find(
  fun (module_def): module_def.name == "DetachedFlowBoundary"
)
def nested_boundary_top = fixture.nested_boundary_design.modules[0]
def completion_top = completion_example.design.modules.find(
  fun (module_def): module_def.name == "CompletionQueue"
)
def assertions = completion_top.operations.filter(
  ~keep: fun (operation): operation.opcode == "verif.assert"
)

fun operations(module_def, opcode):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == opcode
  )

check:
  valid_example.design.modules.map(fun (module_def): module_def.name) ~is [
    "ValidMapForkChain"
  ]
  operations(valid_top, "rtl.instance").length() ~is 0
  operations(valid_top, "rtl.concat").length() ~is 1
  valid_top.find_output("egress_0_out").type.field("bits").type.width ~is 9
  valid_top.find_output("egress_1_out").type.field("bits").type.width ~is 9
  verify_design(valid_example.design) ~is #void

  valid_example.accepted_design.modules.map(fun (module_def): module_def.name) ~is [
    "AcceptedFilteredValid"
  ]
  accepted_top.find_output("ingress_out").type.field("ready").type.packed_width() ~is 1
  accepted_top.find_output("egress_out").type.field("bits").type.width ~is 8
  operations(accepted_top, "rtl.instance").length() ~is 0
  operations(accepted_top, "rtl.and").length() ~is 1
  verify_design(valid_example.accepted_design) ~is #void

  valid_example.decoupled_design.modules.map(
    fun (module_def): module_def.name
  ) ~is ["CheckedValidToDecoupled"]
  checked_decoupled_top.find_output("egress_out").type.field("bits").type.width ~is 8
  operations(checked_decoupled_top, "rtl.instance").length() ~is 0
  operations(checked_decoupled_top, "verif.assert").length() ~is 1
  verify_design(valid_example.decoupled_design) ~is #void

  fixture.generic_boundary_design.modules.map(
    fun (module_def): module_def.name
  ) ~is ["GenericFlowBoundary"]
  generic_boundary_top.find_output("source_ready").type.packed_width() ~is 1
  generic_boundary_top.find_output("sink_bits").type.width ~is 8
  generic_boundary_top.find_output("sink_tag").type.width ~is 2
  operations(generic_boundary_top, "rtl.instance").length() ~is 0
  verify_design(fixture.generic_boundary_design) ~is #void

  fixture.control_boundary_design.modules.map(
    fun (module_def): module_def.name
  ) ~is ["ControlFlowBoundary"]
  control_boundary_top.find_output("source_ready").type.packed_width() ~is 1
  control_boundary_top.find_output("sink_valid").type.packed_width() ~is 1
  operations(control_boundary_top, "rtl.instance").length() ~is 0
  verify_design(fixture.control_boundary_design) ~is #void

  fixture.reverse_provider_boundary_design.modules.map(
    fun (module_def): module_def.name
  ) ~is ["ReverseProviderFlowBoundary"]
  reverse_provider_boundary_top.find_output("source_request").type.width ~is 8
  reverse_provider_boundary_top.find_output("sink_response").type.width ~is 16
  operations(reverse_provider_boundary_top, "rtl.instance").length() ~is 0
  verify_design(fixture.reverse_provider_boundary_design) ~is #void

  fixture.detached_boundary_design.modules.map(
    fun (module_def): module_def.name
  ) ~is ["DetachedFlowBoundary", "Pipe"]
  detached_boundary_top.find_output("source_ready").type.packed_width() ~is 1
  detached_boundary_top.find_output("sink_bits").type.width ~is 8
  operations(detached_boundary_top, "rtl.instance").length() ~is 1
  verify_design(fixture.detached_boundary_design) ~is #void

  fixture.nested_boundary_design.modules.map(
    fun (module_def): module_def.name
  ) ~is ["NestedFlowBoundary"]
  nested_boundary_top.find_output("source_acknowledge").type.packed_width() ~is 1
  nested_boundary_top.find_output("sink_data").type.width ~is 8
  operations(nested_boundary_top, "rtl.instance").length() ~is 0
  verify_design(fixture.nested_boundary_design) ~is #void

  completion_example.design.modules.map(fun (module_def): module_def.name) ~is [
    "CompletionQueueWrapper", "CompletionQueue", "Queue", "Counter"
  ]
  operations(completion_top, "rtl.instance").length() ~is 1
  operations(completion_top, "rtl.register_reset").length() ~is 1
  assertions.map(fun (operation): operation.attribute("label")) ~is [
    "completion_queue_completion_has_request",
    "completion_queue_slot_reserved",
    "completion_queue_reservations_in_range"
  ]
  verify_design(completion_example.design) ~is #void
  completion_example.single_design.modules.map(
    fun (module_def): module_def.name
  ) ~is ["CompletionQueue", "Queue"]
  verify_design(completion_example.single_design) ~is #void

  embedded.run_elaboration(
    fun (): fixture.MapValidWrongProtocol()
  ) ~throws "Valid-flow chaining requires a Valid endpoint"
  embedded.run_elaboration(
    fun (): fixture.ForkValidWrongProtocol()
  ) ~throws "Valid-flow chaining requires a Valid endpoint"
  embedded.run_elaboration(
    fun (): fixture.ForkValidZeroOutputs()
  ) ~throws "PosInt"
  embedded.run_elaboration(
    fun (): fixture.FilterValidWrongProtocol()
  ) ~throws "Valid-flow chaining requires a Valid endpoint"
  embedded.run_elaboration(
    fun (): fixture.InjectFlowMissingBinding()
  ) ~throws "interface boundary requires exactly one named binding for every interface member"
  embedded.run_elaboration(
    fun (): fixture.EjectFlowMissingBinding()
  ) ~throws "interface boundary requires exactly one named binding for every interface member"
  embedded.run_elaboration(
    fun (): fixture.ToValidWrongProtocol()
  ) ~throws "flow-control chaining requires a Decoupled or Irrevocable endpoint"
  embedded.run_elaboration(
    fun (): fixture.ToDecoupledWrongProtocol()
  ) ~throws "Valid-flow chaining requires a Valid endpoint"
  embedded.run_elaboration(
    fun (): fixture.CompletionQueueZeroDepth()
  ) ~throws "PosInt"
