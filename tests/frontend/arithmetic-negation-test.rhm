#lang rhombus
// Checks unary arithmetic negation lowering, exact hardware types, and host fallback.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/frontend/standard.rhm" as frontend
  "../../examples/rtl/bit-utilities.rhdl" as fixture

def design = fixture.negation_design
def module_def = design.modules[0]
def subtractions = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.sub"
)
def unsigned_zero = module_def.find_operation(subtractions[0].operands[0].defining_op_id)
def signed_zero_cast = module_def.find_operation(subtractions[1].operands[0].defining_op_id)
def signed_zero = module_def.find_operation(signed_zero_cast.operands[0].defining_op_id)

check:
  subtractions.length() ~is 2
  type_equal(subtractions[0].results[0].type, Bits(8)) ~is #true
  type_equal(subtractions[1].results[0].type, frontend.SInt(8)) ~is #true
  unsigned_zero.opcode ~is "rtl.constant"
  unsigned_zero.attribute("value") ~is 0
  signed_zero_cast.opcode ~is "rtl.cast"
  signed_zero.opcode ~is "rtl.constant"
  signed_zero.attribute("value") ~is 0
  verify_design(design) ~is #void
  frontend.(-) 7 ~is -7
