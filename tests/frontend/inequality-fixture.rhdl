#lang rhodium
// Exercises typed hardware inequality over Bits and a nominal enum.
// SPDX-License-Identifier: Apache-2.0

hardware_enum ComparisonState:
  Idle
  Busy

circuit Inequality():
  input(left_bits, right_bits): Bits(8)
  input left_state: ComparisonState
  input right_state: ComparisonState
  output bits_differ: Bool
  output states_differ: Bool

  bits_differ <== left_bits =/= right_bits
  states_differ <== left_state =/= right_state

def design = elaborate(Inequality())

export:
  ComparisonState
  Inequality
  design
