#lang rhombus
// Checks that host control uses Rhombus truthiness while hardware control remains hardware-only.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "host-control-fixture.rhdl" as standard_fixture
  "host-control-base-fixture.rhdl" as base_fixture

def standard = standard_fixture.design.modules[0]
def signal = standard.find_input("signal").value
def fallback = standard.find_input("fallback").value
def base = base_fixture.design.modules[0]

check:
  standard.find_output("if_selected").place.driver === signal ~is #true
  standard.find_output("unless_selected").place.driver === signal ~is #true
  standard.find_output("cond_selected").place.driver === signal ~is #true
  standard.find_output("and_selected").place.driver === signal ~is #true
  standard.find_output("or_selected").place.driver === signal ~is #true
  standard.find_output("host_inverted_selected").place.driver === fallback ~is #true
  base.find_output("selected").place.driver === base.find_input("signal").value ~is #true
  verify_design(standard_fixture.design) ~is #void
  verify_design(base_fixture.design) ~is #void
