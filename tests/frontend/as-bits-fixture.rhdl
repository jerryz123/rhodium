#lang rhodium
// Exercises inferred canonical packing and vector-shaped representation casts.
// SPDX-License-Identifier: Apache-2.0

bundle Pair(T):
  high: T
  low: T

circuit AsBits():
  input pair: Pair(Bits(2))
  input lanes: Vec(2, Bits(3))
  input raw: Bits(2)
  output pair_bits: Bits(4)
  output lane_bits: Bits(6)
  output raw_bits: Bits(2)
  output bool_lanes: Vec(2, Bool)
  output round_trip: Bits(2)
  output restored_lanes: Vec(2, Bits(3))
  output same_lanes: Vec(2, Bits(3))

  pair_bits <== pair.as_bits()
  def packed_lanes = lanes.as_bits()
  lane_bits <== packed_lanes
  raw_bits <== raw.as_bits()
  def unpacked = raw.as_vec(Bool)
  bool_lanes <== unpacked
  round_trip <== unpacked.as_bits()
  restored_lanes <== packed_lanes.as_vec(Bits(3))
  same_lanes <== lanes.as_vec(Bits(3))

circuit ControlAsBits():
  input clk: Clock
  output result: Bits(1)
  result <== clk.as_bits()

// Directly exercises the nominal Boolean surface of all ordered comparisons.
circuit ComparisonAsBits():
  input(a, b): Bits(4)
  output(lt, gt, le, ge): Bits(1)
  lt <== (a < b).as_bits()
  gt <== (a > b).as_bits()
  le <== (a <= b).as_bits()
  ge <== (a >= b).as_bits()

circuit UnevenAsVec():
  input raw: Bits(5)
  output lanes: Vec(2, Bits(2))
  lanes <== raw.as_vec(Bits(2))

def design = elaborate(AsBits())

export:
  AsBits
  ComparisonAsBits
  ControlAsBits
  UnevenAsVec
  design
