#lang rhodium
// Defines explicit-clock, single-port, and invalid synchronous-memory frontend cases.
// SPDX-License-Identifier: Apache-2.0

circuit ReadOnlySyncMemory():
  input clock: Clock
  input address: Bits(2)
  input enable: Bits(1)
  output data: Bits(8)

  sync_mem storage(4, Bits(8), ~clock: clock):
    read
  storage.read.address <== address
  storage.read.enable <== enable
  data <== storage.read.data

circuit WriteOnlySyncMemory():
  input clock: Clock
  input address: Bits(2)
  input data: Bits(8)
  input enable: Bits(1)

  sync_mem storage(4, Bits(8), ~clock: clock):
    write
  storage.write.address <== address
  storage.write.data <== data
  storage.write.enable <== enable

circuit MaskedWriteOnlySyncMemory():
  input clock: Clock
  input address: Bits(2)
  input data: Bits(32)
  input mask: Bits(4)
  input enable: Bits(1)

  sync_mem storage(4, Bits(32), ~mask_granularity: 8, ~clock: clock):
    write
  storage.write.address <== address
  storage.write.data <== data
  storage.write.mask <== mask
  storage.write.enable <== enable

circuit UnmaskedMaskAccess():
  input clock: Clock
  input mask: Bits(1)

  sync_mem storage(4, Bits(8), ~clock: clock):
    write
  storage.write.mask <== mask

circuit WrongMaskWidth():
  input clock: Clock
  input mask: Bits(2)

  sync_mem storage(4, Bits(32), ~clock: clock, ~mask_granularity: 8):
    write
  storage.write.mask <== mask

circuit MissingWritePort():
  input clock: Clock
  input address: Bits(2)

  sync_mem storage(4, Bits(8), ~clock: clock):
    read
  storage.write.address <== address

circuit MaskedReadOnlySyncMemory():
  input clock: Clock

  sync_mem storage(4, Bits(8), ~mask_granularity: 8, ~clock: clock):
    read
  #void

export:
  ReadOnlySyncMemory
  WriteOnlySyncMemory
  MaskedWriteOnlySyncMemory
  UnmaskedMaskAccess
  WrongMaskWidth
  MissingWritePort
  MaskedReadOnlySyncMemory
