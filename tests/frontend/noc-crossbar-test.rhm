#lang rhombus
// Checks that a linkless one-router NoC elaborates as an independently indexed 3-by-3 crossbar.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../examples/noc/noc-crossbar.rhdl" as fixture

def top = fixture.design.modules.find(
  fun (module_def): module_def.name == "OneRouterCrossbarFixture"
)

check:
  fixture.routing.dependency_graph.vertices ~is []
  fixture.router_plan.origins.length() ~is 3
  fixture.router_plan.targets.length() ~is 3
  fixture.router_plan.rows.length() ~is 9
  fixture.router_plan.rows.map(fun (row): row.target_mask) ~is [
    0b001, 0b010, 0b100,
    0b001, 0b010, 0b100,
    0b001, 0b010, 0b100
  ]
  fixture.router_config.input_count ~is 3
  fixture.router_config.target_count ~is 3
  top.inputs.length() ~is 8
  top.outputs.length() ~is 6
  verify_design(fixture.design) ~is #void
