#lang rhodium
// Proves configured flow stages preserve exact topology under static checking.

import:
  lib("rhodium/std/flow.rhdl") open

use_static

bundle CapturedPayload():
  word: Bits(8)
  method low_nibble(payload) :: Bits(4):
    payload.word[0..4]

sync_circuit FlowStaticInformation():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)

  def piped = ingress |> pipe(1)
  def piped_bits = piped.bits
  def observed = piped |> trace_event("piped")
  def observed_bits = observed.bits
  def forked = observed |> atomic_fork(2)
  def indexed_bits = forked[0].bits
  def Array(first_path, second_path) = forked
  def first_bits = first_path.bits
  def second_bits = second_path.bits

  def disconnected = Bits(8) |> trace_event("detached") |> pipe(1) |> queue(2)
  def disconnected_bits = disconnected.right.bits
  def composed = disconnected |> pipe(1)
  def composed_bits = composed.right.bits

  interface detached_source(Decoupled(Bits(8)), ~role: consumer)
  def detached_path = Bits(8) |> pipe(1) |> queue(2)
  def detached_output = detached_source |> detached_path
  def detached_output_bits = detached_output.bits

  inst valid_source(ValidPipe(Bits(8), 1))
  def instance_fork = valid_source.egress |> trace_valid_event("valid") |> fork_valid(2)
  def instance_bits = instance_fork[0].bits

  interface valid_inputs[2](Valid(Bits(8)), ~role: consumer)
  def selected_valid = valid_inputs |> valid_arbiter()
  def selected_valid_bits = selected_valid.bits

  interface arbiter_inputs[3](Decoupled(Bits(8)), ~role: consumer)
  def selected = arbiter_inputs |> arbiter()
  def selected_bits = selected.bits
  def disconnected_rr = Bits(8) |> rr_arbiter(3)
  def disconnected_rr_bits = disconnected_rr.right.bits

  def capture_stage = valid_pipe_always_capture(2)
  def captured_valid = selected_valid |> capture_stage
  def captured_bits = captured_valid.bits
  def detached_valid = Valid(Bits(8)) |> capture_stage
  def detached_valid_bits = detached_valid.right.bits

  inst captured_payload(ValidPipeAlwaysCapture(CapturedPayload(), 1))
  def captured_nibble = captured_payload.egress.bits.low_nibble()

  interface control(DecoupledCtrl(), ~role: consumer)
  def control_fork = control |> ctrl_pipe(1) |> ctrl_atomic_fork(2)
  def control_valid = control_fork[0].valid
  def disconnected_control = DecoupledCtrl() |> ctrl_queue(2) |> ctrl_pipe(1)
  def disconnected_control_valid = disconnected_control.right.valid

  #void

export:
  FlowStaticInformation
