#lang rhombus
// Checks popcount result widths and capacity-sized balanced-adder lowering.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "popcount-fixture.rhdl" as fixture

def module_def = fixture.design.modules[0]
def additions = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.add"
)

check:
  type_equal(module_def.find_output("bits_count").type, Bits(3)) ~is #true
  type_equal(module_def.find_output("flags_count").type, Bits(3)) ~is #true
  type_equal(module_def.find_output("list_count").type, Bits(2)) ~is #true
  type_equal(module_def.find_output("single_count").type, Bits(1)) ~is #true
  type_equal(module_def.find_output("empty_count").type, Bits(1)) ~is #true
  additions.length() ~is 9
  additions.map(fun (operation): operation.results[0].type.width) ~is [2, 2, 3, 3, 2, 2, 3, 2, 2]
  verify_design(fixture.design) ~is #void
