#lang rhombus
// Checks frontend bit and host-range indexing plus its failure boundaries.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "indexing-fixture.rhdl" as fixture

def indexed = fixture.design.modules[0]
def extracts = indexed.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.extract"
)
def indexed_members = fixture.member_design.modules.find(
  fun (module_def): module_def.name == "IndexedMembers"
)
def member_extracts = indexed_members.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.extract"
)

check:
  extracts.length() ~is 6
  [extracts[0].attribute("high"), extracts[0].attribute("low")] ~is [2, 2]
  [extracts[1].attribute("high"), extracts[1].attribute("low")] ~is [5, 2]
  [extracts[2].attribute("high"), extracts[2].attribute("low")] ~is [6, 2]
  [extracts[3].attribute("high"), extracts[3].attribute("low")] ~is [5, 3]
  [extracts[4].attribute("high"), extracts[4].attribute("low")] ~is [5, 2]
  [extracts[5].attribute("high"), extracts[5].attribute("low")] ~is [1, 1]
  extracts.map(fun (operation): operation.results[0].type.width) ~is [1, 4, 5, 3, 4, 1]
  verify_design(fixture.design) ~is #void
  member_extracts.length() ~is 3
  member_extracts.map(fun (operation): operation.attribute("low")) ~is [0, 1, 2]
  verify_design(fixture.member_design) ~is #void
  embedded.run_elaboration(fun (): fixture.DynamicIndex()) ~throws "hardware index must be a host natural number or bounded host natural-number range"
  embedded.run_elaboration(fun (): fixture.UnboundedIndex()) ~throws "hardware slice indices must form a bounded host natural-number range"
  embedded.run_elaboration(fun (): fixture.EmptyIndex()) ~throws "hardware slice range must select at least one bit"
  embedded.run_elaboration(fun (): fixture.OutOfBoundsIndex()) ~throws "extract indices must satisfy 0 <= low <= high < source width"
  embedded.run_elaboration(fun (): fixture.NonBitsIndex()) ~throws "extract operand must have a Bits type"
  embedded.run_elaboration(fun (): fixture.SelectedPlace()) ~throws "connection target must be a driveable hardware place"
