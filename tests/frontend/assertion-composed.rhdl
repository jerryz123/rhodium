#lang rhodium/base
// Selects only sync-domain and assertion layers over the compositional profile.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/layers/assertion.rhm") open
  lib("rhodium/frontend/layers/sync.rhm") open

sync_circuit ComposedAssertion():
  input condition: Bits(1)
  assert(condition, "composed_holds")

def design = elaborate(ComposedAssertion())

export:
  design
