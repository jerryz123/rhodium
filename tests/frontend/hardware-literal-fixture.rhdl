#lang rhodium
// Exercises static literal shadows, aggregate packing, and extension-defined literals.

import:
  "../../rhodium/core/types.rhm".BitwiseType

// This type and its semantic literal class model an independently authored
// frontend extension using only the public HardwareLiteral protocol.
hardware_type Nibble():
  width: 4
  describe: "nibble"

hardware_type ExplicitScalar():
  implements ScalarDataType
  width: 4
  describe: "explicit-scalar"

hardware_type BitwiseNibble():
  implements BitwiseType
  width: 4
  describe: "bitwise-nibble"

hardware_type CustomWidth(width):
  width: width
  describe: "custom-width"

class NibbleLiteral(value):
  implements HardwareLiteral
  constructor (value):
    unless value is_a Nat && value < 16
    | error(~who: #'NibbleLiteral, "value must fit four bits")
    super(value)

  override method literal_type(): Nibble()
  override method packed_value(): value

hardware_enum Mode:
  Idle
  Run

def Grant = OneHot(4)

bundle Pair():
  left: Bits(4)
  right: Bits(4)

bundle Aggregate():
  pair: Pair()
  lanes: Vec(2, Bits(4))

def bits_initial = bits(9, 4)
def bool_initial = Bool(#true)
def mode_initial = Mode.Run
def grant_initial = Grant(2)
def nibble_initial = NibbleLiteral(10)
def raw_nibble_initial = literal(Nibble(), 5)
def pair_initial = Pair():
  left: bits(10, 4)
  right: bits(3, 4)
def reordered_pair_initial = Pair():
  right: bits(9, 4)
  left: bits(8, 4)
def PairType = Pair()
def dynamic_pair_initial = record(PairType):
  left: bits(6, 4)
  right: bits(7, 4)
def lanes_initial = vec(bits(4, 4), bits(5, 4))
def aggregate_initial = Aggregate():
  pair: pair_initial
  lanes: lanes_initial

// Named construction retains the generic record checks for completeness,
// uniqueness, and field types.
circuit MissingBundleField():
  def invalid = Pair():
    left: bits(1, 4)
  #void

circuit DuplicateBundleField():
  def invalid = Pair():
    left: bits(1, 4)
    left: bits(2, 4)
  #void

circuit WrongBundleFieldType():
  def invalid = Pair():
    left: bits(1, 4)
    right: bits(2, 3)
  #void

circuit LiteralParameters(bits_value,
                          bool_value,
                          mode_value,
                          grant_value,
                          nibble_value,
                          raw_nibble_value,
                          aggregate_value):
  output bits_out: Bits(4)
  output bool_out: Bool
  output mode_out: Mode
  output grant_out: Grant
  output nibble_out: Nibble()
  output raw_nibble_out: Nibble()
  output aggregate_out: Aggregate()

  bits_out <== bits_value
  bool_out <== bool_value
  mode_out <== mode_value
  grant_out <== grant_value
  nibble_out <== nibble_value
  raw_nibble_out <== raw_nibble_value
  aggregate_out <== aggregate_value

def design = elaborate(
  LiteralParameters(bits_initial,
                    bool_initial,
                    mode_initial,
                    grant_initial,
                    nibble_initial,
                    raw_nibble_initial,
                    aggregate_initial)
)

export:
  ExplicitScalar
  BitwiseNibble
  CustomWidth
  Nibble
  NibbleLiteral
  Mode
  Grant
  Pair
  Aggregate
  bits_initial
  bool_initial
  mode_initial
  grant_initial
  nibble_initial
  raw_nibble_initial
  pair_initial
  reordered_pair_initial
  dynamic_pair_initial
  lanes_initial
  aggregate_initial
  LiteralParameters
  MissingBundleField
  DuplicateBundleField
  WrongBundleFieldType
  design
