#lang rhodium
// Exercises retained window lineage locally, through a child, and in the real frontend.
import:
  lib("flow/main.rhdl") open
  "../../cores/rv5stage/frontend.rhdl" open
  "../../cores/rv5stage/frontend-control.rhdl" open
  "../../cores/rv5stage/bundles.rhdl" open
  "../../cores/rv5stage/icache/protocol.rhdl" open
  "../../cores/rv5stage/profile.rhm" open
  "../../riscv/isa/c.rhm" open
  "../../riscv/isa/xlen.rhm" open

sync_circuit WindowCell(intrinsic :: Boolean):
  interface source(Valid(Bits(8)), ~role: consumer)
  interface sink(Decoupled(Bits(8)), ~role: producer)
  input(flush, emit): Bool
  input(remove_count, selected): Bits(2)
  output occupancy: Bits(2)
  reg count(~init: bits(0, 2))
  reg words(~init: vec([bits(0, 8), bits(0, 8), bits(0, 8)]))
  def remaining = count - remove_count
  occupancy <== count
  sink.valid <== emit & !flush
  sink.bits <== mux(selected[0].into(Bool), words[0], bits(0, 8)) ^ mux(selected[1].into(Bool), words[1], bits(0, 8))
  when flush:
    count <== bits(0, 2)
  otherwise:
    count <== remaining + source.valid.as_bits().zext(2)
  for (index in 0..3):
    def mutable shifted = bits(0, 8)
    for (offset in 0..(3 - index)):
      shifted := mux(remove_count === bits(offset, 2), words[index + offset], shifted)
    when flush:
      words[index] <== bits(0, 8)
    elsewhen (source.valid & (remaining === bits(index, 2))):
      words[index] <== source.bits
    otherwise:
      words[index] <== shifted
  describe_interface_window_storage(3, source.valid, remove_count, count, flush, [selected[0], selected[1]])
  if intrinsic
  | describe_interface_contract(source, sink, "window", ~trace_model: interface_trace_window())
  | #void

sync_circuit EventWindow(intrinsic :: Boolean = #true):
  interface source(Valid(Bits(8)), ~role: consumer)
  interface sink(Decoupled(Bits(8)), ~role: producer)
  input(flush, emit): Bool
  input(remove_count, selected): Bits(2)
  output occupancy: Bits(2)
  inst storage(WindowCell(intrinsic))
  storage.flush <== flush
  storage.emit <== emit
  storage.remove_count <== remove_count
  storage.selected <== selected
  occupancy <== storage.occupancy
  source |> trace_valid_event("word", ~root: #true, ~payload: #true) |> storage.source
  if !intrinsic
  | describe_interface_transform(InterfaceHandle(storage.source, storage.sink), "window", {}, storage, ~trace_model: interface_trace_window(storage))
  | #void
  storage.sink |> pipe(1) |> trace_event("instruction", ~payload: #true) |> sink

sync_circuit EventFrontend():
  def xlen = XLen.X64
  interface control(RV5StageFrontendControl(xlen), ~role: frontend)
  interface memory(RV5StageFetchAccess(xlen), ~role: requester)
  interface fetched(Decoupled(FetchDecode(xlen)), ~role: producer)
  inst frontend(RV5StageFrontend(RVCoreProfile(~xlen: xlen, ~extensions: RV5StageExtensions(~compressed: CCompressedExtensions))))
  control <=> frontend.control
  memory <=> frontend.memory
  def output = frontend.fetched |> trace_event("core.s1.fetch", ~stalls: #true, ~fields: instruction):
    pc: instruction.pc
  output |> fetched

fun child_flush(instance): instance.module_def.find_input("flush").value

sync_circuit BadWindow(kind :: String):
  input flag: Bool
  input amount: Bits(2)
  cond
  | kind == "missing": interface_trace_window()
  | kind == "width": describe_interface_window_storage(3, flag, flag, amount, flag, [flag])
  | kind == "selection": describe_interface_window_storage(1, flag, flag, flag, flag, [flag, flag])
  | kind == "selection-width": describe_interface_window_storage(3, flag, amount, amount, flag, [amount])
  | kind == "foreign":
      inst child(WindowCell(#false))
      describe_interface_window_storage(3, flag, amount, amount, child_flush(child), [flag])
  | kind == "duplicate":
      describe_interface_window_storage(3, flag, amount, amount, flag, [flag])
      describe_interface_window_storage(3, flag, amount, amount, flag, [flag])

fun bad_window(kind): elaborate_with_top(BadWindow(kind))
fun window(intrinsic): elaborate_with_top(EventWindow(intrinsic))
def frontend = elaborate_with_top(EventFrontend())
export:
  window
  frontend
  bad_window
