#lang rhodium
// Defines ambient, explicit, and priority-guarded assertions for frontend inspection.
// SPDX-License-Identifier: Apache-2.0

sync_circuit AmbientAssertions():
  input condition: Bool
  input request: Bool
  input request_condition: Bool

  assert(condition, "always_holds")
  when request:
    assert(request_condition, "request_holds")

sync_circuit PriorityAssertions():
  input first: Bool
  input second: Bool
  input first_condition: Bool
  input second_condition: Bool
  input fallback_condition: Bool

  when first:
    assert(first_condition, "first_holds")
  elsewhen second:
    assert(second_condition, "second_holds")
  otherwise:
    assert(fallback_condition, "fallback_holds")

circuit ExplicitAssertion():
  input clock: Clock
  input reset: Reset
  input condition: Bits(1)

  assert(condition, ~clock: clock, ~reset: reset)

def design = elaborate(AmbientAssertions())

export:
  AmbientAssertions
  PriorityAssertions
  ExplicitAssertion
  design
