#lang rhombus
// Checks specialization reuse, declaration identity, context isolation, and recursion tracking.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/frontend/kernel.rhm" as kernel
  "../../examples/rtl/fresh-generators.rhdl" open

def outer_identity = kernel.new_circuit_identity("SameName")
def inner_identity = kernel.new_circuit_identity("SameName")

fun inner_generator():
  fun implementation(): #void
  kernel.build_circuit(inner_identity, "SameName", [], implementation)

fun outer_generator():
  fun implementation(): inner_generator()
  kernel.build_circuit(outer_identity, "SameName", [], implementation)

def same_name_design = kernel.run_elaboration(fun (): outer_generator())
def first_adder_design = kernel.run_elaboration(fun (): Adder(8))
def second_adder_design = kernel.run_elaboration(fun (): Adder(8))

check:
  design.modules.map(fun (module_def): module_def.name) ~is ["Top", "Adder"]
  design.modules.filter(~keep: fun (module_def): module_def.name.starts_with("Adder")).length() ~is 1
  verify_design(design) ~is #void
  same_name_design.modules.map(fun (module_def): module_def.name) ~is ["SameName", "SameName_1"]
  verify_design(same_name_design) ~is #void
  first_adder_design.modules.map(fun (module_def): module_def.name) ~is ["Adder"]
  second_adder_design.modules.map(fun (module_def): module_def.name) ~is ["Adder"]
  first_adder_design.modules[0] === second_adder_design.modules[0] ~is #false
  verify_design(first_adder_design) ~is #void
  verify_design(second_adder_design) ~is #void
