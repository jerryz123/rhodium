#lang rhodium
// Defines valid and invalid flow handle and sink chains for frontend tests.

import:
  lib("flow/main.rhdl") open

fun require_byte_irrevocable(
  endpoint :: Endpoint.of(Irrevocable(Bits(8)))
) :~ Endpoint:
  endpoint

bundle MapFlowInput():
  request: Bits(8)
  processor: Bool

bundle MapFlowOutput():
  data: Bits(8)
  owner: Bool

bundle ZipFlowOutput():
  data: Bits(8)
  owner: Bool

interface StableAlias8() refines Irrevocable(Bits(8))

circuit MapFlowWrongProtocol():
  interface ingress(Valid(MapFlowInput()), ~role: consumer)
  interface egress(Decoupled(MapFlowOutput()), ~role: producer)

  (
    ingress |> map_flow(payload):
      MapFlowOutput():
        data: payload.request
        owner: payload.processor
  ) |> egress

circuit MapFlowStrongerDestination():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  interface egress(Irrevocable(Bits(8)), ~role: producer)

  (
    ingress |> map_flow(payload):
      payload
  ) |> egress

circuit MapFlowReusedSource():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  interface egress0(Decoupled(Bits(8)), ~role: producer)
  interface egress1(Decoupled(Bits(8)), ~role: producer)

  def mapping = map_flow(payload): payload
  def mapped = ingress |> mapping
  mapped |> egress0
  ingress |> mapping

// A renamed nominal refinement can explicitly preserve its irrevocable
// stability promise for a payload-only mapping.
circuit RefinedMapFlowChain():
  interface ingress(StableAlias8(), ~role: consumer)
  interface egress(Irrevocable(Bits(8)), ~role: producer)

  ingress |> map_flow(~stable: #true, payload => payload) |> egress

// An ordinary mapping conservatively weakens an irrevocable source because its
// body may capture changing hardware.
circuit UnstableMapFlowToIrrevocable():
  interface ingress(Irrevocable(Bits(8)), ~role: consumer)
  interface egress(Irrevocable(Bits(8)), ~role: producer)

  ingress |> map_flow(payload => payload) |> egress

// Payload-only demultiplexing can explicitly retain an irrevocable contract.
circuit StableDemuxFlowChain():
  interface ingress(Irrevocable(Bits(8)), ~role: consumer)
  interface egress[2](Irrevocable(Bits(8)), ~role: producer)

  (ingress |> demux_flow(2, ~stable: #true, payload => payload[0])) <=> egress

// An ordinary demultiplexer is conservatively Decoupled even when its source
// is irrevocable.
circuit UnstableDemuxFlowToIrrevocable():
  interface ingress(Irrevocable(Bits(8)), ~role: consumer)
  interface egress[2](Irrevocable(Bits(8)), ~role: producer)

  (ingress |> demux_flow(2, payload => payload[0])) <=> egress

circuit FilterFlowWrongProtocol():
  interface ingress(Valid(Bits(8)), ~role: consumer)
  ingress |> filter_flow(payload => Bool(#true))

circuit GateFlowWrongProtocol():
  interface ingress(Valid(Bits(8)), ~role: consumer)
  ingress |> gate_flow(Bool(#true))

// The arrow binder keeps a single-expression zip directly inside ordinary
// call and pipeline syntax without grouping a trailing block.
circuit ZipFlowArrowChain():
  interface data(Decoupled(Bits(8)), ~role: consumer)
  interface owner(Decoupled(Bool), ~role: consumer)
  interface egress(Decoupled(Bits(8)), ~role: producer)

  def zipped = Array(data, owner) |> zip_flow(
    data_bits,
    owner_bits => mux(owner_bits, data_bits, bits(0, 8))
  )
  zipped |> egress

circuit ZipFlowWrongProtocol():
  interface data(Valid(Bits(8)), ~role: consumer)
  interface owner(Decoupled(Bool), ~role: consumer)
  Array(data, owner) |> zip_flow(data_bits, owner_bits):
    ZipFlowOutput():
      data: data_bits
      owner: owner_bits

circuit ZipFlowHostValue():
  interface data(Decoupled(Bits(8)), ~role: consumer)
  interface owner(Decoupled(Bool), ~role: consumer)
  Array(data, owner) |> zip_flow(data_bits, owner_bits):
    8

sync_circuit FlowThroughQueueStrongerDestination():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  interface egress(Irrevocable(Bits(8)), ~role: producer)

  def forwarded = ingress |> queue(2, ~flow: #true)
  forwarded |> egress

circuit ParallelMapFlowMixedPaths():
  interface ingress(Decoupled(MapFlowInput()), ~role: consumer)
  def forked = ingress |> atomic_fork(2)
  forked |> parallel(
    map_flow(payload):
      payload.request,
    ingress
  )

circuit ParallelMapFlowLengthMismatch():
  interface ingress(Decoupled(MapFlowInput()), ~role: consumer)
  def forked = ingress |> atomic_fork(2)
  def (data_path, owner_path, duplicate_path):
    forked |> parallel(
      map_flow(payload):
        payload.request,
      map_flow(payload):
        payload.processor,
      map_flow(payload):
        payload.request
    )
  #void

circuit ParallelMapFlowHostValue():
  interface ingress(Decoupled(MapFlowInput()), ~role: consumer)
  def forked = ingress |> atomic_fork(2)
  def (data_path, owner_path):
    forked |> parallel(
      map_flow(payload):
        8,
      map_flow(payload):
        payload.processor
    )
  #void

sync_circuit EmptyRRArbiterPipeline():
  Array() |> rr_arbiter()

sync_circuit MismatchedRRArbiterPipeline():
  interface byte_input(Decoupled(Bits(8)), ~role: consumer)
  interface word_input(Decoupled(Bits(16)), ~role: consumer)
  Array(byte_input, word_input) |> rr_arbiter()

sync_circuit FixedArbiterPipeline():
  interface ingress[2](Decoupled(Bits(8)), ~role: consumer)
  interface egress(Decoupled(Bits(8)), ~role: producer)
  ingress |> arbiter() |> egress

sync_circuit EmptyArbiterPipeline():
  Array() |> arbiter()

sync_circuit MismatchedArbiterPipeline():
  interface byte_input(Decoupled(Bits(8)), ~role: consumer)
  interface word_input(Decoupled(Bits(16)), ~role: consumer)
  Array(byte_input, word_input) |> arbiter()

sync_circuit EmptyValidArbiterPipeline():
  Array() |> valid_arbiter()

sync_circuit ValidArbiterWrongProtocol():
  interface first(Decoupled(Bits(8)), ~role: consumer)
  interface second(Decoupled(Bits(8)), ~role: consumer)
  Array(first, second) |> valid_arbiter()

// Verifies that one-to-one helpers accept the stronger Pipe output contract.
sync_circuit PipeToQueueChain():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  interface egress(Decoupled(Bits(8)), ~role: producer)

  ingress |> pipe(1) |> queue(2) |> egress

sync_circuit ValidPipeWrongProtocol():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  ingress |> valid_pipe(1)

sync_circuit ValidPipeNonEndpoint():
  bits(0, 8) |> valid_pipe(1)

// Verifies that the stronger CtrlPipe result can feed a CtrlQueue.
sync_circuit CtrlPipeToQueueChain():
  interface ingress(DecoupledCtrl(), ~role: consumer)
  interface egress(DecoupledCtrl(), ~role: producer)

  ingress |> ctrl_pipe(1) |> ctrl_queue(2) |> egress

// Connects an array-shaped payload path while keeping grants as an explicit
// crossbar-control sideband.
circuit GrantCrossbarChain():
  interface ingress[2](Decoupled(Bits(8)), ~role: consumer)
  input grants: Vec(2, Vec(3, Bool))
  interface egress[3](Decoupled(Bits(8)), ~role: producer)

  (
    ingress |> grant_crossbar(3, ~grants: grants)
  ) <=> egress

circuit EmptyGrantCrossbarChain():
  Array() |> grant_crossbar(1, ~grants: #false)

circuit GrantCrossbarWrongProtocol():
  interface ingress[1](Valid(Bits(8)), ~role: consumer)
  input grants: Vec(1, Vec(1, Bool))
  ingress |> grant_crossbar(1, ~grants: grants)

sync_circuit WrongProtocolChain():
  interface ingress(Valid(Bits(8)), ~role: consumer)
  ingress |> queue(2)

sync_circuit WrongEndpointType():
  interface ingress(Decoupled(Bits(16)), ~role: consumer)
  require_byte_irrevocable(ingress)

sync_circuit NonEndpointChain():
  bits(0, 8) |> queue(2)

sync_circuit CtrlWrongProtocolChain():
  interface ingress(Valid(Bits(8)), ~role: consumer)
  ingress |> ctrl_queue(2)

sync_circuit CtrlNonEndpointChain():
  bits(0, 8) |> ctrl_queue(2)

circuit MissingSyncDomain():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  ingress |> queue(2)

circuit CtrlMissingSyncDomain():
  interface ingress(DecoupledCtrl(), ~role: consumer)
  ingress |> ctrl_queue(2)

circuit ValidPipeMissingSyncDomain():
  interface ingress(Valid(Bits(8)), ~role: consumer)
  ingress |> valid_pipe(1)

export:
  PipeToQueueChain
  ValidPipeWrongProtocol
  ValidPipeNonEndpoint
  CtrlPipeToQueueChain
  GrantCrossbarChain
  EmptyGrantCrossbarChain
  GrantCrossbarWrongProtocol
  MapFlowInput
  MapFlowOutput
  MapFlowWrongProtocol
  MapFlowStrongerDestination
  MapFlowReusedSource
  RefinedMapFlowChain
  UnstableMapFlowToIrrevocable
  StableDemuxFlowChain
  UnstableDemuxFlowToIrrevocable
  FilterFlowWrongProtocol
  GateFlowWrongProtocol
  ZipFlowOutput
  ZipFlowArrowChain
  ZipFlowWrongProtocol
  ZipFlowHostValue
  FlowThroughQueueStrongerDestination
  ParallelMapFlowMixedPaths
  ParallelMapFlowLengthMismatch
  ParallelMapFlowHostValue
  EmptyRRArbiterPipeline
  MismatchedRRArbiterPipeline
  FixedArbiterPipeline
  EmptyArbiterPipeline
  MismatchedArbiterPipeline
  EmptyValidArbiterPipeline
  ValidArbiterWrongProtocol
  WrongProtocolChain
  WrongEndpointType
  NonEndpointChain
  CtrlWrongProtocolChain
  CtrlNonEndpointChain
  MissingSyncDomain
  CtrlMissingSyncDomain
  ValidPipeMissingSyncDomain
