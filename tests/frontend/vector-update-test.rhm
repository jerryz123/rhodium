#lang rhombus
// Checks total functional updates and unordered dynamic vector-register writes.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../examples/rtl/vector-update.rhdl" as fixture

def module_def = fixture.design.modules[0]
def register_module = fixture.register_design.modules[0]

fun operation_count(opcode):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == opcode
  ).length()

check:
  module_def.name ~is "VectorUpdate"
  operation_count("rtl.vector_get") ~is 3
  operation_count("rtl.constant") ~is 3
  operation_count("rtl.eq") ~is 3
  operation_count("rtl.mux_lookup") ~is 3
  operation_count("rtl.vector_create") ~is 1
  type_equal(module_def.find_output("result").type,
             VectorType(3, Bits(4))) ~is #true
  verify_design(fixture.design) ~is #void
  register_module.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.register_reset"
  ).length() ~is 1
  register_module.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.mux_lookup"
  ).length() ~is 1
  register_module.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.vector_get"
  ).length() ~is 0
  register_module.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.vector_write_set"
  ).length() ~is 1
  type_equal(register_module.find_output("result").type,
             VectorType(3, Bits(4))) ~is #true
  verify_design(fixture.register_design) ~is #void
