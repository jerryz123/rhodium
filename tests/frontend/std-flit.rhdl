#lang rhodium
// Defines valid and invalid standard flit-conversion fixtures for frontend tests.

import:
  lib("flow/main.rhdl") open

bundle FixedFlitImpostor(T :: DataType):
  payload: T

bundle PacketPayload():
  tag: Bits(4)
  data: Bits(7)

sync_circuit PacketRoundTrip():
  interface ingress(Decoupled(PacketPayload()), ~role: consumer)
  interface egress(Irrevocable(PacketPayload()), ~role: producer)

  inst packetizer(Packetizer(PacketPayload(), 4))
  inst reassembler(Reassembler(PacketPayload(), 4))

  ingress <=> packetizer.ingress
  packetizer.egress <=> reassembler.ingress
  reassembler.egress <=> egress

sync_circuit FixedFramingRoundTrip():
  interface ingress(Decoupled(FixedFlit(Bits(8))), ~role: consumer)
  interface egress(Decoupled(FixedFlit(Bits(8))), ~role: producer)

  ingress |> frame_fixed_flits(3) |> strip_fixed_framing(3) |> egress

sync_circuit VariableFixedRoundTrip():
  interface ingress(Decoupled(VariableFlit(Bits(8))), ~role: consumer)
  interface egress(Decoupled(VariableFlit(Bits(8))), ~role: producer)

  ingress |> require_fixed_framing(2) |> forget_fixed_framing() |> egress

sync_circuit FrameWrongShape():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  ingress |> frame_fixed_flits(3)

sync_circuit RequireWrongShape():
  interface ingress(Decoupled(FixedFlit(Bits(8))), ~role: consumer)
  ingress |> require_fixed_framing(3)

sync_circuit StripVariableShape():
  interface ingress(Decoupled(VariableFlit(Bits(8))), ~role: consumer)
  ingress |> strip_fixed_framing(3)

circuit DirectFramingConnection():
  interface ingress(Decoupled(VariableFlit(Bits(8))), ~role: consumer)
  interface egress(Decoupled(FramedFixedFlit(Bits(8))), ~role: producer)
  ingress |> egress

circuit FrameMissingSyncDomain():
  interface ingress(Decoupled(FixedFlit(Bits(8))), ~role: consumer)
  ingress |> frame_fixed_flits(3)

export:
  FixedFlitImpostor
  PacketPayload
  PacketRoundTrip
  FixedFramingRoundTrip
  VariableFixedRoundTrip
  FrameWrongShape
  RequireWrongShape
  StripVariableShape
  DirectFramingConnection
  FrameMissingSyncDomain
