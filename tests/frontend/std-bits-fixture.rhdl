#lang rhodium
// Exercises generic bit ordering, layout, alignment, and lane-mask operations and invalid parameters.

import:
  lib("rhodium/std/bits.rhdl") open

circuit BitOrderFixture():
  input value: Bits(8)
  input single: Bits(1)
  output reversed: Bits(8)
  output leading_zeros: Bits(4)
  output reversed_single: Bits(1)
  output leading_zeros_single: Bits(1)

  reversed <== reverse_bits(value)
  leading_zeros <== count_leading_zeros(value)
  reversed_single <== reverse_bits(single)
  leading_zeros_single <== count_leading_zeros(single)

circuit BitsAlignmentFixture():
  input value: Bits(8)
  output aligned_1: Bool
  output aligned_2: Bool
  output aligned_4: Bool
  output aligned_8: Bool
  output aligned_256: Bool
  output down_1: Bits(8)
  output down_4: Bits(8)
  output down_256: Bits(8)
  output merged: Bits(8)

  aligned_1 <== is_aligned(value, 1)
  aligned_2 <== is_aligned(value, 2)
  aligned_4 <== is_aligned(value, 4)
  aligned_8 <== is_aligned(value, 8)
  aligned_256 <== is_aligned(value, 256)
  down_1 <== align_down(value, 1)
  down_4 <== align_down(value, 4)
  down_256 <== align_down(value, 256)
  merged <== masked_merge(value, bits(0xa0, 8), bits(0xf0, 8))

circuit RuntimeAlignmentFixture():
  input value: Bits(8)
  input exponent: Bits(6)
  output full: Bool
  output bounded: Bool
  output five_bit: Bool
  output single_bit: Bool
  output narrow_exponent: Bool
  output unit: Bool
  full <== is_aligned_log2(value, exponent)
  bounded <== is_aligned_log2(value, exponent, ~max_log2: 6)
  five_bit <== is_aligned_log2(value[0..5], exponent)
  single_bit <== is_aligned_log2(value[0..1], exponent)
  narrow_exponent <== is_aligned_log2(value, exponent[0..1])
  unit <== is_aligned_log2(value, exponent, ~max_log2: 0)

circuit InvalidRuntimeAlignmentBoundFixture(bound :: Int):
  input value: Bits(8)
  input exponent: Bits(4)
  output aligned: Bool
  aligned <== is_aligned_log2(value, exponent, ~max_log2: bound)

circuit NonBitsRuntimeAlignmentFixture():
  input value: Bool
  input exponent: Bits(3)
  output aligned: Bool
  aligned <== is_aligned_log2(value, exponent)

circuit NonBitsAlignmentExponentFixture():
  input value: Bits(8)
  input exponent: Bool
  output aligned: Bool
  aligned <== is_aligned_log2(value, exponent)

circuit MaskExpansionFixture():
  input mask: Bits(8)
  input single: Bits(1)
  output lanes_1: Bits(8)
  output lanes_3: Bits(24)
  output lanes_8: Bits(64)
  output single_1: Bits(1)
  output single_7: Bits(7)
  output sliced_5: Bits(20)

  lanes_1 <== mask.expand_mask(1)
  lanes_3 <== mask.expand_mask(3)
  lanes_8 <== expand_mask(mask, 8)
  single_1 <== single.expand_mask(1)
  single_7 <== single.expand_mask(7)
  sliced_5 <== mask[2..6].expand_mask(5)

circuit InvalidMaskLaneWidthFixture(lane_width :: Int):
  input mask: Bits(8)
  output expanded: Bits(8)
  expanded <== mask.expand_mask(lane_width)

circuit NonBitsMaskExpansionFixture():
  input mask: Bool
  output expanded: Bits(8)
  expanded <== expand_mask(mask, 8)

circuit PackFieldsFixture():
  input low: Bool
  input middle: Bits(2)
  input high: Bool
  output sparse: Bits(8)
  output whole: Bits(2)
  output empty: Bits(8)

  sparse <== pack_fields(8, [[0, low], [3, middle], [7, high]])
  whole <== pack_fields(2, [[0, middle]])
  empty <== pack_fields(8, [])

circuit OverlappingPackFieldsFixture():
  input low: Bits(3)
  input high: Bits(2)
  output packed: Bits(8)
  packed <== pack_fields(8, [[1, low], [3, high]])

circuit OutOfRangePackFieldsFixture():
  input value: Bits(2)
  output packed: Bits(8)
  packed <== pack_fields(8, [[7, value]])

circuit AlignmentTooWideFixture():
  input value: Bits(3)
  output aligned: Bool
  aligned <== is_aligned(value, 16)

circuit NonPowerAlignmentFixture():
  input value: Bits(8)
  output aligned: Bits(8)
  aligned <== align_down(value, 3)

circuit NonBitsAlignmentFixture():
  input value: Bool
  output aligned: Bool
  aligned <== is_aligned(value, 1)

circuit TransferByteMaskFixture():
  input address: Bits(8)
  input size: Bits(3)
  output mask_1: Mask(1)
  output mask_4: Mask(4)
  output mask_16: Mask(16)

  mask_1 <== transfer_byte_mask(address, size, 1)
  mask_4 <== transfer_byte_mask(address, size, 4)
  mask_16 <== transfer_byte_mask(address, size, 16)

sync_circuit RegisteredTransferByteMaskFixture():
  input address: Bits(8)
  input size: Bits(3)
  output mask: Mask(4)

  reg stored_address(Bits(8))
  stored_address <== address
  mask <== transfer_byte_mask(stored_address, size, 4)

circuit NonPowerTransferBeatFixture():
  input address: Bits(8)
  input size: Bits(3)
  output mask: Mask(3)
  mask <== transfer_byte_mask(address, size, 3)

circuit TransferBeatTooWideFixture():
  input address: Bits(3)
  input size: Bits(3)
  output mask: Mask(16)
  mask <== transfer_byte_mask(address, size, 16)

export:
  BitOrderFixture
  BitsAlignmentFixture
  RuntimeAlignmentFixture
  InvalidRuntimeAlignmentBoundFixture
  NonBitsRuntimeAlignmentFixture
  NonBitsAlignmentExponentFixture
  MaskExpansionFixture
  InvalidMaskLaneWidthFixture
  NonBitsMaskExpansionFixture
  PackFieldsFixture
  OverlappingPackFieldsFixture
  OutOfRangePackFieldsFixture
  AlignmentTooWideFixture
  NonPowerAlignmentFixture
  NonBitsAlignmentFixture
  TransferByteMaskFixture
  RegisteredTransferByteMaskFixture
  NonPowerTransferBeatFixture
  TransferBeatTooWideFixture
