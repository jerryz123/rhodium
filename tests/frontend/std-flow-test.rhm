def aggregate_type = RecordType([
  RecordField("tag", Bits(2)),
  RecordField("data", Bits(8))
])
def aggregate_pipe_design = embedded.run_elaboration(
  fun (): flow.Pipe(aggregate_type, 2)
)
def aggregate_queue_design = embedded.run_elaboration(
  fun (): flow.Queue(aggregate_type, 2)
