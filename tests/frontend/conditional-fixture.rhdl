#lang rhodium
// Defines valid and invalid circuits for hardware conditional-assignment tests.
// SPDX-License-Identifier: Apache-2.0

circuit PrioritySelect():
  input first: Bool
  input second: Bool
  input a: Bits(4)
  input b: Bits(4)
  input fallback: Bits(4)
  output selected: Bits(4)

  when first:
    selected <== a
  elsewhen second:
    selected <== b
  otherwise:
    selected <== fallback

circuit NestedSelect():
  input outer: Bool
  input inner: Bool
  input a: Bits(4)
  input b: Bits(4)
  input fallback: Bits(4)
  output selected: Bits(4)

  when outer:
    when inner:
      selected <== a
    otherwise:
      selected <== b
  otherwise:
    selected <== fallback

bundle ConditionalCell():
  value: Bits(8)

bundle NestedConditionalCell():
  cell: ConditionalCell()

circuit ProjectedRegisterHold():
  input clock: Clock
  input load: Bool
  input data: Bits(8)
  output result: Bits(8)

  reg state(ConditionalCell(), ~clock: clock)
  when load:
    state.value <== data
  result <== state.value

circuit NestedProjectedRegisterHold():
  input clock: Clock
  input load: Bool
  input data: Bits(8)
  output result: Bits(8)

  reg state(NestedConditionalCell(), ~clock: clock)
  when load:
    state.cell.value <== data
  result <== state.cell.value

circuit IndexedRegisterHold():
  input clock: Clock
  input load: Bool
  input data: Bits(8)
  output result: Bits(8)

  reg state(Vec(1, Bits(8)), ~clock: clock)
  when load:
    state[0] <== data
  result <== state[0]

sync_circuit StateOrientedRegisterUpdates():
  input start: Bool
  input step: Bool
  input finish: Bool
  output active_out: Bool
  output count_out: Bits(4)
  output result_out: Bits(4)

  reg active(~init: Bool(#false))
  reg count(~init: bits(0, 4))
  reg result(Bits(4))

  when start:
    active <== Bool(#true)
    count <== bits(0, 4)
  elsewhen finish:
    active <== Bool(#false)
    result <== count
  elsewhen step:
    count <== count + bits(1, 4)

  active_out <== active
  count_out <== count
  result_out <== result

circuit DynamicRegisterIndex():
  input clock: Clock
  input index: Bits(1)
  input data: Bits(8)

  reg state(Vec(2, Bits(8)), ~clock: clock)
  state[index] <== data

circuit MultiportDynamicRegisterIndex():
  input clock: Clock
  input enable: Bool
  input index: Bits(1)
  input(first, second): Bits(8)

  reg state(Vec(2, Bits(8)), ~clock: clock)
  when enable:
    state[index] <== first
    state[index] <== second

circuit ExclusiveDynamicRegisterIndex():
  input clock: Clock
  input select: Bool
  input(first_index, second_index): Bits(1)
  input(first, second): Bits(8)

  reg state(Vec(2, Bits(8)), ~clock: clock)
  when select:
    state[first_index] <== first
  otherwise:
    state[second_index] <== second

sync_circuit ConditionalMemoryWrites():
  input first: Bool
  input second: Bool
  input second_enable: Bool
  input read_address: Bits(2)
  input first_address: Bits(2)
  input second_address: Bits(2)
  input first_data: Bits(8)
  input second_data: Bits(8)
  output read_data: Bits(8)

  mem storage(4, Bits(8))
  when first:
    storage.write(first_address, first_data)
  elsewhen second:
    storage.write(second_address, second_data, ~enable: second_enable)
  read_data <== storage[read_address]

sync_circuit ConditionalMemoryWritePorts():
  input first: Bool
  input second: Bool
  input read_address: Bits(2)
  input first_address: Bits(2)
  input second_address: Bits(2)
  input alternate_address: Bits(2)
  input first_data: Bits(8)
  input second_data: Bits(8)
  input alternate_data: Bits(8)
  output read_data: Bits(8)

  mem storage(4, Bits(8))
  when first:
    storage.write(first_address, first_data)
    storage.write(second_address, second_data)
  elsewhen second:
    storage.write(alternate_address, alternate_data)
  read_data <== storage[read_address]

circuit HostCondition():
  output selected: Bits(1)
  when #true:
    selected <== bits(1, 1)

circuit WideCondition():
  input condition: Bits(2)
  output selected: Bits(1)
  when condition:
    selected <== bits(1, 1)

circuit MissingOtherwise():
  input condition: Bool
  output selected: Bits(1)
  when condition:
    selected <== bits(1, 1)

circuit DuplicateBranch():
  input condition: Bool
  output selected: Bits(1)
  when condition:
    selected <== bits(0, 1)
    selected <== bits(1, 1)

circuit MissingBranch():
  input first: Bool
  input second: Bool
  input a: Bits(1)
  input fallback: Bits(1)
  output selected: Bits(1)
  when first:
    selected <== a
  elsewhen second:
    def unused = a
    #void
  otherwise:
    selected <== fallback

circuit SeparateConditionals():
  input first: Bool
  input second: Bool
  output selected: Bits(1)
  when first:
    selected <== bits(0, 1)
  otherwise:
    selected <== bits(1, 1)
  when second:
    selected <== bits(0, 1)
  otherwise:
    selected <== bits(1, 1)

export:
  PrioritySelect
  NestedSelect
  ProjectedRegisterHold
  NestedProjectedRegisterHold
  IndexedRegisterHold
  StateOrientedRegisterUpdates
  DynamicRegisterIndex
  MultiportDynamicRegisterIndex
  ExclusiveDynamicRegisterIndex
  ConditionalMemoryWrites
  ConditionalMemoryWritePorts
  HostCondition
  WideCondition
  MissingOtherwise
  DuplicateBranch
  MissingBranch
  SeparateConditionals
