#lang rhombus
// Checks variadic, host-list, and empty receiver membership lowering and result types.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/frontend/layers/bool.rhm" as bool
  "../../examples/rtl/bit-utilities.rhdl" as fixture
  "base-is-one-of-fixture.rhdl" as base_fixture
  "is-one-of-surfaces-fixture.rhdl" as surfaces

def module_def = fixture.membership_design.modules[0]
def equalities = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.eq"
)
def disjunctions = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.or"
)
def surface_module = surfaces.design.modules[0]
def base_module = base_fixture.design.modules[0]
def surface_outputs_boolean = for all (name in ["bool_member",
                                                "signed_member",
                                                "mask_member",
                                                "exact_member",
                                                "optional_member",
                                                "union_member",
                                                "generic_member"]):
  bool.bool_type(surface_module.find_output(name).type)

check:
  bool.bool_type(module_def.find_output("active").type) ~is #true
  bool.bool_type(module_def.find_output("small").type) ~is #true
  bool.bool_type(module_def.find_output("exact").type) ~is #true
  bool.bool_type(module_def.find_output("listed").type) ~is #true
  bool.bool_type(module_def.find_output("never").type) ~is #true
  equalities.length() ~is 11
  disjunctions.length() ~is 0
  verify_design(fixture.membership_design) ~is #void
  bool.bool_type(base_module.find_output("member").type) ~is #true
  verify_design(base_fixture.design) ~is #void
  surface_outputs_boolean ~is #true
  verify_design(surfaces.design) ~is #void
