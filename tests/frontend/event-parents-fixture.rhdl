#lang rhodium
// Exercises selected upstream parents through filtering, reconvergence, and flushed storage.
// SPDX-License-Identifier: Apache-2.0
import:
  lib("flow/main.rhdl") open

sync_circuit EventParents(kind :: String = "valid"):
  interface source(Valid(Bits(8)), ~role: consumer)
  interface wb(Valid(Bits(8)), ~role: producer)
  interface cache(Valid(Bits(8)), ~role: producer)
  interface both(Valid(Bits(8)), ~role: producer)
  input flush: Bool
  def root = source |> trace_valid_event("root", ~payload: #true)
  def Array(memory, bypass) = root |> fork_valid(2)
  def middle = memory |> filter_valid(data => data[0].into(Bool)) |> trace_valid_event("middle", ~payload: #true)
  def other = bypass |> filter_valid(data => !data[0].into(Bool))
  def stored = Array(middle, other) |> valid_arbiter() |> valid_pipe_always_capture(1, ~flush: flush)
  def Array(wb_path, cache_path, both_path) = stored |> fork_valid(3)
  def selected:
    cond
    | kind == "empty": []
    | kind == "duplicate": [root, root]
    | kind == "endpoint": [source]
    | kind == "unreachable": [middle]
    | ~else: [root]
  wb_path |> trace_valid_event("wb", ~parents: selected, ~payload: #true) |> wb
  if kind == "fanout"
  | wb_path |> trace_valid_event("duplicate-output", ~parents: [root])
  | #void
  cache_path |> filter_valid(data => data[0].into(Bool)) |> trace_valid_event("cache", ~payload: #true) |> cache
  both_path |> filter_valid(data => data[0].into(Bool)) |> trace_valid_event("both", ~parents: [root, middle], ~payload: #true) |> both

fun selected(kind = "valid"): elaborate_with_top(EventParents(kind))

sync_circuit EventParentsSibling():
  interface source(Valid(Bits(8)), ~role: consumer)
  interface sink(Valid(Bits(8)), ~role: producer)
  def root = source |> trace_valid_event("root")
  def Array(left, right) = root |> fork_valid(2)
  def sibling = left |> trace_valid_event("sibling")
  right |> trace_valid_event("child", ~parents: [sibling]) |> sink

sync_circuit EventParentsTwice():
  interface source(Valid(Bits(8)), ~role: consumer)
  inst left(EventParents())
  inst right(EventParents())
  def Array(a, b) = source |> fork_valid(2)
  a |> left.source
  b |> right.source
  left.flush <== Bool(#false)
  right.flush <== Bool(#false)

fun sibling(): elaborate_with_top(EventParentsSibling())
fun repeated(): elaborate_with_top(EventParentsTwice())

// WB is declared first, but references a later MEM checkpoint. Qualified
// checkpoints preserve the only functional pipe and its ordinary consumer fork.
sync_circuit EventQualifiedParents(kind :: String = "valid"):
  interface source(Valid(Bits(8)), ~role: consumer)
  interface wb(Valid(Bits(8)), ~role: producer)
  interface cache(Valid(Bits(8)), ~role: producer)
  interface both(Valid(Bits(8)), ~role: producer)
  input flush: Bool
  input force_cache_event: Bool
  inst stored(ValidPipeAlwaysCapture(Bits(8), 1, ~flushable: #true))
  inst reference(ValidPipeAlwaysCapture(Bits(8), 1, ~flushable: #true))
  stored.flush <== flush
  reference.flush <== flush
  reference.ingress.valid <== source.valid
  reference.ingress.bits <== source.bits
  def retired = stored.egress |> trace_valid_event("wb", ~payload: #true)
  def Array(wb_path, cache_path, both_path) = retired |> fork_valid(3)
  wb_path |> wb
  def root = source |> trace_valid_event("root", ~payload: #true)
  def middle = root |> trace_valid_event("middle", ~when: source.bits[0].into(Bool), ~payload: #true)
  middle |> stored.ingress
  cond
  | kind == "empty": trace_parents(retired, [])
  | kind == "duplicate": trace_parents(retired, [root, root])
  | kind == "parent": trace_parents(retired, [source])
  | kind == "child": trace_parents(source, [root])
  | kind == "unbound": #void
  | kind == "conditional":
      when (source.valid):
        trace_parents(retired, [root])
  | ~else: trace_parents(retired, [root])
  if kind == "rebind"
  | trace_parents(retired, [middle])
  | #void
  def response = cache_path |> trace_valid_event("cache", ~parents: [middle], ~when: cache_path.bits[0].into(Bool) ||| force_cache_event, ~payload: #true)
  response |> cache
  if kind == "mixed"
  | trace_parents(response, [root])
  | #void
  both_path |> trace_valid_event("both", ~parents: [root, middle], ~when: both_path.bits[0].into(Bool), ~payload: #true) |> both
  for (output :: Endpoint in [wb, cache, both]):
    assert(output.valid === reference.egress.valid, "qualified_valid_unchanged")
    assert(output.bits === reference.egress.bits, "qualified_payload_unchanged")

fun qualified(kind = "valid"): elaborate_with_top(EventQualifiedParents(kind))

sync_circuit EventInvalidQualification():
  interface source(Valid(Bits(8)), ~role: consumer)
  source |> trace_valid_event("bad", ~when: bits(1, 2))
fun invalid_qualification(): elaborate_with_top(EventInvalidQualification())
export:
  selected
  sibling
  repeated
  qualified
  invalid_qualification
