#lang rhombus
// Checks concise memory syntax and its elaborated public IR structure.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../examples/rtl/async-read-memory.rhdl" as fixture

def design = fixture.design
def module_def = design.modules[0]
def memory = module_def.memories[0]
def read = module_def.operations.find(
  fun (operation): operation.opcode == "rtl.memory_read_async"
)
def write = module_def.operations.find(
  fun (operation): operation.opcode == "rtl.memory_write"
)

check:
  memory.name ~is "storage"
  memory.depth ~is 4
  memory.element_type.type_equal(Bits(8)) ~is #true
  read.attribute("memory") === memory ~is #true
  read.operands[0].name ~is "read_address"
  write.attribute("memory") === memory ~is #true
  write.operands[0].name ~is "write_address"
  write.operands[1].name ~is "write_data"
  write.operands[2].name ~is "clock"
  write.operands[3].name ~is "write_enable"
  verify_design(design) ~is #void
