#lang rhombus
// Checks typed Pattern normalization, relations, aggregates, and extension literals.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/types.rhm".Bits
  "../../rhodium/frontend/layers/comb.rhm" open
  "../../rhodium/frontend/layers/vector.rhm".Vec
  "../../rhodium/frontend/support/hardware-literal.rhm".HardwareLiteral
  "../../rhodium/std/decode/pattern.rhdl" open
  "hardware-literal-fixture.rhdl" as literals
  "pattern-fixture.rhdl" as fixture

def narrower_pattern = Pattern(
  ~value: bits(0b1000, 4),
  ~care: bits(0b1000, 4)
)
def disjoint_pattern = Pattern(
  ~value: bits(0b0100, 4),
  ~care: bits(0b1100, 4)
)
def crossing_pattern = Pattern(
  ~value: bits(0b0010, 4),
  ~care: bits(0b0110, 4)
)
def empty_intersection_pattern = Pattern(
  ~value: bits(0b0100, 4),
  ~care: bits(0b1100, 4)
)

fun signatures(set :: PatternSet):
  set.terms.map(fun (term): [term.value_bits, term.care_bits])

fun equivalent_over_bits(set :: PatternSet, predicate :: Function):
  for all (candidate in 0..16):
    set.matches(bits(candidate, 4)) == predicate(bits(candidate, 4))

def singleton = as_pattern_set(fixture.bits_pattern)
def empty = PatternSet(Bits(4), [])
def union = fixture.bits_pattern.union(crossing_pattern)
def intersection = fixture.bits_pattern.intersection(crossing_pattern)
def subtraction = fixture.bits_pattern.subtract(crossing_pattern)
def inverse = fixture.bits_pattern.inverse()
def pair_set = pattern_set(
  fixture.concise_pair_pattern,
  (pattern(literals.Pair()):
     left: bits(0b0011, 4)
     right: _)
)

check:
  fixture.bits_pattern is_a HardwareLiteral ~is #false
  fixture.bits_pattern.width ~is 4
  fixture.bits_pattern.value_bits ~is 0b1000
  fixture.bits_pattern.care_bits ~is 0b1100
  fixture.bits_pattern.matches(bits(0b1011, 4)) ~is #true
  fixture.bits_pattern.matches(bits(0b0110, 4)) ~is #false

  fixture.bool_pattern.matches(literals.bool_initial) ~is #true
  fixture.enum_pattern.matches(literals.mode_initial) ~is #true
  fixture.one_hot_pattern.matches(literals.grant_initial) ~is #true
  fixture.nibble_pattern.matches(literals.NibbleLiteral(0b1011)) ~is #true
  fixture.nibble_pattern.matches(literals.NibbleLiteral(0b0111)) ~is #false

  fixture.aggregate_pattern.width ~is 16
  fixture.aggregate_pattern.care_bits ~is 0xF08F
  fixture.aggregate_pattern.value_bits ~is 0xA004
  fixture.aggregate_pattern.matches(fixture.aggregate_match) ~is #true
  fixture.aggregate_pattern.matches(fixture.aggregate_miss) ~is #false

  fixture.concise_pair_pattern.value_bits ~is 0xA0
  fixture.concise_pair_pattern.care_bits ~is 0xF0
  fixture.partial_pair_pattern.value_bits ~is 0xA0
  fixture.partial_pair_pattern.care_bits ~is 0xF0
  fixture.concise_lanes_pattern.value_bits ~is 0x04
  fixture.concise_lanes_pattern.care_bits ~is 0x0F
  fixture.concise_aggregate_pattern.value_bits ~is 0xA004
  fixture.concise_aggregate_pattern.care_bits ~is 0xF00F
  fixture.concise_aggregate_pattern.matches(fixture.aggregate_match) ~is #true
  fixture.concise_exact_bits.value_bits ~is 0b1010
  fixture.concise_exact_bits.care_bits ~is 0b1111
  fixture.concise_wildcard_bits.value_bits ~is 0
  fixture.concise_wildcard_bits.care_bits ~is 0
  as_pattern(fixture.bits_pattern) === fixture.bits_pattern ~is #true
  as_pattern(bits(0b1010, 4)).value_bits ~is 0b1010
  as_pattern(bits(0b1010, 4)).care_bits ~is 0b1111

  fixture.bits_pattern.overlaps(narrower_pattern) ~is #true
  fixture.bits_pattern.overlaps(disjoint_pattern) ~is #false
  narrower_pattern.subsumes(fixture.bits_pattern) ~is #true
  fixture.bits_pattern.subsumes(narrower_pattern) ~is #false

  singleton.type.type_equal(Bits(4)) ~is #true
  signatures(singleton) ~is [[0b1000, 0b1100]]
  as_pattern_set(bits(0b1010, 4)).matches(bits(0b1010, 4)) ~is #true
  empty.is_empty() ~is #true
  empty.matches(bits(0, 4)) ~is #false
  signatures(empty.inverse()) ~is [[0, 0]]

  // Union removes overlapping coverage while retaining the exact denotation.
  signatures(union) ~is [[0b0010, 0b0110], [0b1000, 0b1110]]
  union.matches(bits(0b0010, 4)) ~is #true
  union.matches(bits(0b1011, 4)) ~is #true
  union.matches(bits(0b1100, 4)) ~is #false
  union.terms[0].overlaps(union.terms[1]) ~is #false
  signatures(crossing_pattern.union(fixture.bits_pattern)) ~is signatures(union)
  equivalent_over_bits(
    union,
    fun (candidate):
      fixture.bits_pattern.matches(candidate) || crossing_pattern.matches(candidate)
  ) ~is #true

  signatures(intersection) ~is [
    [0b1010, 0b1110]
  ]
  equivalent_over_bits(
    intersection,
    fun (candidate):
      fixture.bits_pattern.matches(candidate) && crossing_pattern.matches(candidate)
  ) ~is #true
  fixture.bits_pattern.intersection(empty_intersection_pattern).is_empty() ~is #true
  signatures(subtraction) ~is [
    [0b1000, 0b1110]
  ]
  equivalent_over_bits(
    subtraction,
    fun (candidate):
      fixture.bits_pattern.matches(candidate) && !crossing_pattern.matches(candidate)
  ) ~is #true
  signatures(inverse) ~is [
    [0b0100, 0b0100],
    [0b0000, 0b1100]
  ]
  equivalent_over_bits(
    inverse,
    fun (candidate): !fixture.bits_pattern.matches(candidate)
  ) ~is #true
  union.subsumes(fixture.bits_pattern) ~is #true
  fixture.bits_pattern.subsumes(union) ~is #false
  union.overlaps(crossing_pattern) ~is #true

  pair_set.matches(
    literals.Pair():
      left: bits(0b0011, 4)
      right: bits(0b1111, 4)
  ) ~is #true
  as_pattern_set(fixture.nibble_pattern).matches(
    literals.NibbleLiteral(0b1011)
  ) ~is #true

  Pattern(~value: bits(0, 4),
          ~care: literal(literals.Nibble(), 0)) ~throws "exactly the same hardware type"
  fixture.bits_pattern.matches(literal(literals.Nibble(), 0)) ~throws "exactly the same hardware type"
  (pattern(literals.Pair()):
     left: bits(0, 4)) ~throws "every field exactly once"
  (pattern(Vec(2, Bits(4)), [bits(0, 4)])) ~throws "element count"
  as_pattern("not a pattern") ~throws "expected a HardwareLiteral or Pattern"
  PatternSet(Bits(4), [fixture.nibble_pattern]) ~throws "PatternSet hardware type"
