#lang rhombus
// Checks hardware and host-list OR and AND reduction lowering and identities.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/frontend/layers/bool.rhm" as bool
  "../../examples/rtl/bit-utilities.rhdl" as fixture

def module_def = fixture.reduction_design.modules[0]
def equalities = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.eq"
)
def negations = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.not"
)
def constants = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.constant"
)
def concatenations = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.concat"
)

check:
  bool.bool_type(module_def.find_output("any_bits").type) ~is #true
  bool.bool_type(module_def.find_output("any_flags").type) ~is #true
  bool.bool_type(module_def.find_output("all_bits").type) ~is #true
  bool.bool_type(module_def.find_output("all_flags").type) ~is #true
  bool.bool_type(module_def.find_output("any_list").type) ~is #true
  bool.bool_type(module_def.find_output("all_list").type) ~is #true
  bool.bool_type(module_def.find_output("any_empty").type) ~is #true
  bool.bool_type(module_def.find_output("all_empty").type) ~is #true
  equalities.length() ~is 6
  equalities.map(fun (operation): operation.operands[0].type.width) ~is [8, 4, 8, 4, 4, 4]
  equalities.map(fun (operation): operation.operands[1].type.width) ~is [8, 4, 8, 4, 4, 4]
  negations.length() ~is 3
  concatenations.length() ~is 2
  concatenations.map(fun (operation): operation.results[0].type.width) ~is [4, 4]
  constants.map(fun (operation): operation.attribute("value")) ~is [0, 0, 255, 15, 0, 15, 0, 1]
  (for all (negation in negations):
     bool.bool_type(negation.results[0].type)) ~is #true
  verify_design(fixture.reduction_design) ~is #void
