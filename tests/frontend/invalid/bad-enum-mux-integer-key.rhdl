#lang rhodium
// Invalid fixture using an untyped integer key with an enum mux selector.
// SPDX-License-Identifier: Apache-2.0

hardware_enum State:
  Idle
  Running

circuit BadEnumMuxIntegerKey():
  input state: State
  output next_state: State

  next_state <== mux_lookup(state, ~default: State.Idle):
    0: State.Running

def design = elaborate(BadEnumMuxIntegerKey())
