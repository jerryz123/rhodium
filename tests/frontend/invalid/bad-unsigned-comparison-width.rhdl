#lang rhodium
// Rejects unsigned comparison between bit vectors with different widths.
// SPDX-License-Identifier: Apache-2.0

circuit BadUnsignedComparisonWidth():
  input a: Bits(4)
  input b: Bits(8)
  output result: Bool

  result <== (a < b)

def design = elaborate(BadUnsignedComparisonWidth())
