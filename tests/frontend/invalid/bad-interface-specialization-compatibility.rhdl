#lang rhodium
// Rejects a provider specialization that does not satisfy its peer's declared requirement.
// SPDX-License-Identifier: Apache-2.0

interface CapacityLink(capacity):
  role producer
  role consumer
  provider producer
  connection_compatible producer (provided, required):
    provided[0] >= required[0]

  producer -> consumer:
    payload: Bits(8)

circuit BadInterfaceSpecializationCompatibility():
  interface source(CapacityLink(2), ~role: consumer)
  interface sink(CapacityLink(4), ~role: producer)
  source <=> sink

def design = elaborate(BadInterfaceSpecializationCompatibility())
