#lang rhodium
// Rejects an interface connection policy that returns a non-Boolean host value.
// SPDX-License-Identifier: Apache-2.0

interface BadPolicy(tag):
  role producer
  role consumer
  provider producer
  connection_compatible producer (provided, required):
    provided[0]

  producer -> consumer:
    payload: Bits(8)

circuit BadInterfaceCompatibilityResult():
  interface source(BadPolicy("source"), ~role: consumer)
  interface sink(BadPolicy("sink"), ~role: producer)
  source <=> sink

def design = elaborate(BadInterfaceCompatibilityResult())
