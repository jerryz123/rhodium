#lang rhodium
// Rejects a one-hot enum mux whose named arms do not match its declaration.
// SPDX-License-Identifier: Apache-2.0

hardware_enum Select(~encoding: one_hot):
  First
  Second

hardware_enum OtherSelect(~encoding: one_hot):
  First
  Second

circuit BadOneHotEnumMuxUnknown():
  input select: Select
  input(first, second): Bits(8)
  output result: Bits(8)
  result <== select.mux({
    Select.First: first,
    OtherSelect.Second: second
  })

def design = elaborate(BadOneHotEnumMuxUnknown())
