#lang rhodium
// Invalid fixture using a member of another nominal enum as a mux key.
// SPDX-License-Identifier: Apache-2.0

hardware_enum State:
  Idle
  Running

hardware_enum OtherState:
  Idle
  Running

circuit BadEnumMuxForeignKey():
  input state: State
  output next_state: State

  next_state <== mux_lookup(state, ~default: State.Idle):
    OtherState.Idle: State.Running

def design = elaborate(BadEnumMuxForeignKey())
