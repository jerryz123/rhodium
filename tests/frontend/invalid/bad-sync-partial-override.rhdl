#lang rhodium
// Rejects an explicit sync-child override that supplies only one domain signal.
// SPDX-License-Identifier: Apache-2.0

sync_circuit Child():
  output value: Bits(1)
  value <== bits(0, 1)

circuit BadSyncOverride():
  input source_clock: Clock
  output value: Bits(1)
  def ChildModule = Child()
  inst child(ChildModule, ~clock: source_clock)
  value <== child.value

def design = elaborate(BadSyncOverride())
