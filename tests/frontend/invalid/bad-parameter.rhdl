#lang rhodium
// Rejects passing a runtime hardware value directly to a circuit generator.
// SPDX-License-Identifier: Apache-2.0

circuit Child(parameter):
  input x: Bits(1)
  output y: Bits(1)
  y <== x

circuit BadParameter():
  input hardware_argument: Bits(1)
  Child(hardware_argument)

def design = elaborate(BadParameter())
