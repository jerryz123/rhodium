#lang rhodium
// Rejects automatic sync-child propagation when the parent has no ambient domain.
// SPDX-License-Identifier: Apache-2.0

sync_circuit Child():
  output value: Bits(1)
  value <== bits(0, 1)

circuit BadSyncParent():
  output value: Bits(1)
  def ChildModule = Child()
  inst child(ChildModule)
  value <== child.value

def design = elaborate(BadSyncParent())
