#lang rhodium
// Rejects sign extension on a receiver without signed-arithmetic semantics.
// SPDX-License-Identifier: Apache-2.0

circuit BadSignExtension():
  input value: Bits(4)
  output widened: Bits(8)

  widened <== value.sext(8)

def design = elaborate(BadSignExtension())

export:
  BadSignExtension
  design
