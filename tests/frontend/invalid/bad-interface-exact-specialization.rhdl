#lang rhodium
// Keeps Endpoint.of exact when an interface family declares relaxed connection compatibility.
// SPDX-License-Identifier: Apache-2.0

interface CapacityLink(capacity):
  role producer
  role consumer
  provider producer
  connection_compatible producer (provided, required):
    provided[0] >= required[0]

  producer -> consumer:
    payload: Bits(8)

fun require_exact(
  endpoint :: Endpoint.of(CapacityLink(2))
) :~ Endpoint:
  endpoint

circuit BadInterfaceExactSpecialization():
  interface source(CapacityLink(4), ~role: consumer)
  require_exact(source)
  #void

def design = elaborate(BadInterfaceExactSpecialization())
