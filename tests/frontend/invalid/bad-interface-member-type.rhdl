#lang rhodium
// Rejects an interface member that is neither hardware data nor a nested interface type.
// SPDX-License-Identifier: Apache-2.0

interface BadNested():
  role producer
  role consumer

  producer -> consumer:
    invalid: 42

  consumer -> producer:
    ready: Bool

circuit BadInterfaceMemberType():
  interface endpoint(BadNested(), ~role: producer)
  #void

def design = elaborate(BadInterfaceMemberType())
