#lang rhodium
// Invalid fixture using a non-Int host value as a mux lookup key.
// SPDX-License-Identifier: Apache-2.0

circuit BadMuxKeyType():
  input selector: Bits(3)
  input value: Bits(1)
  output result: Bits(1)

  result <== mux_lookup(selector, ~default: value):
    #true: value

def design = elaborate(BadMuxKeyType())
