#lang rhodium
// Rejects explicit assertion controls inside a sync circuit.
// SPDX-License-Identifier: Apache-2.0

sync_circuit ExplicitAssertionDomain():
  input other_clock: Clock
  input other_reset: Reset
  input condition: Bool
  assert(condition, ~clock: other_clock, ~reset: other_reset)

def design = elaborate(ExplicitAssertionDomain())
