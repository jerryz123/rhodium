#lang rhodium
// Rejects semantically compatible specializations whose realized wire widths differ.
// SPDX-License-Identifier: Apache-2.0

interface WidthLink(capacity, width):
  role producer
  role consumer
  provider producer
  connection_compatible producer (provided, required):
    provided[0] >= required[0]

  producer -> consumer:
    payload: Bits(width)

circuit BadInterfaceSpecializationShape():
  interface source(WidthLink(4, 8), ~role: consumer)
  interface sink(WidthLink(2, 16), ~role: producer)
  source <=> sink

def design = elaborate(BadInterfaceSpecializationShape())
