#lang rhodium
// Rejects expanding arithmetic applied to a nominal non-Bits hardware value.
// SPDX-License-Identifier: Apache-2.0

circuit BadExpandingArithmeticType():
  input flag: Bool
  input value: Bits(1)
  output result: Bits(2)

  result <== add_expanding(flag, value)

def design = elaborate(BadExpandingArithmeticType())
