#lang rhodium
// Rejects connections between distinct nominal hardware-enum declarations.
// SPDX-License-Identifier: Apache-2.0

hardware_enum FirstState:
  Idle
  Run

hardware_enum SecondState:
  Idle
  Run

circuit BadEnumAssignment():
  input source: FirstState
  output result: SecondState
  result <== source

def design = elaborate(BadEnumAssignment())
