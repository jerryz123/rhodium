#lang rhodium
// Rejects hardware values used to index elaboration-time interface arrays.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/ready-valid.rhdl") open

circuit BadInterfaceArrayIndex():
  input select: Bool
  interface ingress[2](Decoupled(Bits(8)), ~role: consumer)
  interface egress[2](Decoupled(Bits(8)), ~role: producer)

  egress[select] <=> ingress[0]

elaborate(BadInterfaceArrayIndex())
