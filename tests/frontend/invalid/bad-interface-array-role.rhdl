#lang rhodium
// Rejects incompatible roles in whole-array interface connections.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/ready-valid.rhdl") open

circuit BadInterfaceArrayRole():
  interface left[2](Decoupled(Bits(8)), ~role: producer)
  interface right[2](Decoupled(Bits(8)), ~role: producer)

  left <=> right

elaborate(BadInterfaceArrayRole())
