#lang rhodium
// Rejects one-hot priority encoding of a non-data hardware clock value.
// SPDX-License-Identifier: Apache-2.0

circuit BadPriorityEncoderOHType():
  input source: Clock
  output result: Bits(1)

  result <== priority_encoder_oh(source)

def design = elaborate(BadPriorityEncoderOHType())
