#lang rhodium
// Rejects an explicit DPI procedure clock inside a sync circuit.
// SPDX-License-Identifier: Apache-2.0

dpi_import procedure observe(value: Bits(1))

sync_circuit ExplicitDpiClock():
  input other_clock: Clock
  input value: Bits(1)
  observe.call(value, ~clock: other_clock)

def design = elaborate(ExplicitDpiClock())
