#lang rhodium
// Rejects an endpoint monitor that attempts to drive its read-only observation.
// SPDX-License-Identifier: Apache-2.0

interface BadObservationDrive():
  role producer
  role consumer
  producer -> consumer:
    valid: Bool
  consumer -> producer:
    ready: Bool

fun drive_observation(link :: Observation):
  link.ready <== Bool(#true)

sync_circuit BadInterfaceObservationDrive():
  interface stream(BadObservationDrive(), ~role: producer)
  stream.valid <== Bool(#false)
  drive_observation(stream.observe())

def design = elaborate(BadInterfaceObservationDrive())
