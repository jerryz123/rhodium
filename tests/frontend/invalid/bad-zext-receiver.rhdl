#lang rhodium
// Rejects zero extension on a receiver that is not an unsigned Bits value.
// SPDX-License-Identifier: Apache-2.0

circuit BadZeroExtension():
  input value: SInt(4)
  output widened: Bits(8)

  widened <== value.zext(8)

def design = elaborate(BadZeroExtension())

export:
  BadZeroExtension
  design
