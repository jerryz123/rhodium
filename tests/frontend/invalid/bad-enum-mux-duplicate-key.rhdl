#lang rhodium
// Invalid fixture repeating an enum member key in one mux lookup.
// SPDX-License-Identifier: Apache-2.0

hardware_enum State:
  Idle
  Running

circuit BadEnumMuxDuplicateKey():
  input state: State
  output next_state: State

  next_state <== mux_lookup(state, ~default: State.Idle):
    State.Idle: State.Running
    State.Idle: State.Idle

def design = elaborate(BadEnumMuxDuplicateKey())
