#lang rhombus
// Checks expanding arithmetic widths and its composition from existing core operations.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/frontend/layers/expanding-arithmetic.rhm" as expanding
  "../../rhodium/frontend/standard.rhm" as frontend
  "../../examples/rtl/expanding-arithmetic.rhdl" as fixture

def module_def = fixture.design.modules[0]
def extensions = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.zext"
)
def addition = module_def.operations.find(
  fun (operation): operation.opcode == "rtl.add"
)
def signed_extensions = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.sext"
)
def multiplications = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.mul"
)
def multiplication = multiplications.find(
  fun (operation): bits_type(operation.results[0].type)
)
def signed_multiplication = multiplications.find(
  fun (operation): signed_arithmetic_type(operation.results[0].type)
)

check:
  extensions.length() ~is 4
  extensions.map(fun (operation): operation.results[0].type.width) ~is [9, 9, 12, 12]
  addition.operands.map(fun (value): value.type.width) ~is [9, 9]
  addition.results[0].type.width ~is 9
  multiplication.operands.map(fun (value): value.type.width) ~is [12, 12]
  multiplication.results[0].type.width ~is 12
  signed_extensions.length() ~is 2
  signed_extensions.map(fun (operation): operation.results[0].type.width) ~is [12, 12]
  signed_multiplication.operands.map(fun (value): value.type.width) ~is [12, 12]
  type_equal(signed_multiplication.results[0].type, frontend.SInt(12)) ~is #true
  module_def.find_output("sum").place.driver === addition.results[0] ~is #true
  module_def.find_output("product").place.driver === multiplication.results[0] ~is #true
  module_def.find_output("signed_product").place.driver === signed_multiplication.results[0] ~is #true
  verify_design(fixture.design) ~is #void
  "width" expanding.(+&) 9 ~is "width9"
  6 expanding.(*&) 7 ~is 42
