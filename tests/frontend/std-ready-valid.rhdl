#lang rhodium
// Provides elaboration fixtures for the canonical Rhodium ready-valid protocols.

import:
  lib("rhodium/std/ready-valid.rhdl") open

// Differently named protocols exercise nominal refinement and explicit support
// without relying on the canonical declarations' display names.
interface Buffered8() refines Decoupled(Bits(8))

interface StableBuffered8() refines Irrevocable(Bits(8))

interface BufferedCtrl() refines DecoupledCtrl()

interface BufferedPulse() refines Pulse()

interface BufferedValid8() refines Valid(Bits(8))

interface Alternate8() refines DecoupledCtrl():
  supports producer: Decoupled(Bits(8))

  producer -> consumer:
    bits: Bits(8)

interface NestedReadyValid():
  role producer
  role consumer
  provider producer

  producer -> consumer:
    channel: Decoupled(Bits(8))

interface DeepReadyValid():
  role producer
  role consumer
  provider producer

  producer -> consumer:
    group: NestedReadyValid()

circuit ValidAdapter():
  interface ingress(Valid(Bits(8)), ~role: consumer)
  interface egress(Valid(Bits(8)), ~role: producer)
  egress <=> ingress

circuit PulseAdapter():
  interface ingress(Pulse(), ~role: consumer)
  interface egress(Pulse(), ~role: producer)
  egress <=> ingress

// A payload-bearing producer may satisfy the payloadless control-event
// contract, while the reverse direction remains intentionally unavailable.
circuit ValidToPulse():
  interface ingress(Valid(Bits(8)), ~role: consumer)
  interface egress(Pulse(), ~role: producer)
  egress <=> ingress

circuit DecoupledAdapter():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  interface egress(Decoupled(Bits(8)), ~role: producer)
  egress <=> ingress

circuit IrrevocableAdapter():
  interface ingress(Irrevocable(Bits(8)), ~role: consumer)
  interface egress(Irrevocable(Bits(8)), ~role: producer)
  egress <=> ingress

circuit DecoupledCtrlAdapter():
  interface ingress(DecoupledCtrl(), ~role: consumer)
  interface egress(DecoupledCtrl(), ~role: producer)
  egress <=> ingress

circuit IrrevocableCtrlAdapter():
  interface ingress(IrrevocableCtrl(), ~role: consumer)
  interface egress(IrrevocableCtrl(), ~role: producer)
  egress <=> ingress

circuit RefinedProtocolHelpers():
  interface payload(Buffered8(), ~role: consumer)
  interface control(BufferedCtrl(), ~role: consumer)
  def PayloadType = decoupled_payload_type(payload)
  output payload_value: PayloadType
  output control_valid: Bool

  payload.ready <== Bool(#true)
  ctrl_endpoint(control).ready <== Bool(#true)
  payload_value <== payload.bits
  control_valid <== ctrl_endpoint(control).valid

circuit PayloadIsNotCtrl():
  interface payload(Decoupled(Bits(8)), ~role: consumer)
  ctrl_endpoint(payload)

// Exercises the common control annotation on a payload-bearing endpoint.
circuit DecoupledFire():
  input accept: Bool
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  output transferred: Bool

  ingress.ready <== accept
  transferred <== ingress.fire()

// Exercises transitive refinement through IrrevocableCtrl.
circuit IrrevocableFire():
  input accept: Bool
  interface ingress(Irrevocable(Bits(8)), ~role: consumer)
  output transferred: Bool

  ingress.ready <== accept
  transferred <== ingress.fire()

// Exercises extension-method dispatch after a precise nested interface member.
circuit NestedFire():
  input accept: Bool
  interface ingress(DeepReadyValid(), ~role: consumer)
  output transferred: Bool

  def group = ingress.group
  group.channel.ready <== accept
  transferred <== group.channel.fire()

circuit ReversedCompatibleSpelling():
  interface ingress(Irrevocable(Bits(8)), ~role: consumer)
  interface egress(Decoupled(Bits(8)), ~role: producer)
  ingress <=> egress

circuit IrrevocableCtrlToDecoupledCtrl():
  interface ingress(IrrevocableCtrl(), ~role: consumer)
  interface egress(DecoupledCtrl(), ~role: producer)
  egress <=> ingress

circuit TransitiveCtrlCompatibility():
  interface ingress(Irrevocable(Bits(8)), ~role: consumer)
  interface egress(DecoupledCtrl(), ~role: producer)
  egress <=> ingress

fun require_exact_control(
  endpoint :: Endpoint.of(DecoupledCtrl())
) :~ Endpoint:
  endpoint

circuit MismatchedAdapter():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  interface egress(Irrevocable(Bits(8)), ~role: producer)
  egress <=> ingress

circuit UnsupportedFire():
  interface ingress(Valid(Bits(8)), ~role: consumer)
  ingress.fire()

circuit RefinedIsNotExact():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  require_exact_control(ingress)

circuit WrongMergeParent():
  input payload: Bits(8)
  interface ingress(DecoupledCtrl(), ~role: consumer)
  interface egress(Irrevocable(Bits(8)), ~role: producer)
  egress <=> (ingress, payload)

circuit MissingMergeMember():
  interface ingress(DecoupledCtrl(), ~role: consumer)
  interface egress(Decoupled(Bits(8)), ~role: producer)
  egress <=> (ingress)

circuit ExtraMergeMember():
  input payload: Bits(8)
  interface ingress(DecoupledCtrl(), ~role: consumer)
  interface egress(Decoupled(Bits(8)), ~role: producer)
  egress <=> (ingress, payload, payload)

circuit WrongMergeMemberType():
  input payload: Bits(16)
  interface ingress(DecoupledCtrl(), ~role: consumer)
  interface egress(Decoupled(Bits(8)), ~role: producer)
  egress <=> (ingress, payload)

circuit WrongSplitMemberDirection():
  input payload: Bits(8)
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  interface egress(DecoupledCtrl(), ~role: producer)
  egress <=> (ingress, payload)

circuit ValidIsNotReadyValidCompatible():
  interface ingress(Valid(Bits(8)), ~role: consumer)
  interface egress(Decoupled(Bits(8)), ~role: producer)
  egress <=> ingress

circuit UnsafeCtrlStrengthening():
  interface ingress(DecoupledCtrl(), ~role: consumer)
  interface egress(IrrevocableCtrl(), ~role: producer)
  egress <=> ingress

export:
  PulseAdapter
  ValidToPulse
  ValidAdapter
  DecoupledAdapter
  IrrevocableAdapter
  DecoupledCtrlAdapter
  IrrevocableCtrlAdapter
  Buffered8
  StableBuffered8
  BufferedCtrl
  BufferedPulse
  BufferedValid8
  Alternate8
  RefinedProtocolHelpers
  PayloadIsNotCtrl
  DecoupledFire
  IrrevocableFire
  NestedFire
  ReversedCompatibleSpelling
  IrrevocableCtrlToDecoupledCtrl
  TransitiveCtrlCompatibility
  MismatchedAdapter
  UnsupportedFire
  RefinedIsNotExact
  WrongMergeParent
  MissingMergeMember
  ExtraMergeMember
  WrongMergeMemberType
  WrongSplitMemberDirection
  ValidIsNotReadyValidCompatible
  UnsafeCtrlStrengthening
