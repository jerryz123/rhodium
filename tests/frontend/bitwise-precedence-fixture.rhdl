#lang rhodium
// Exercises the canonical symbolic bitwise operators and their precedence.
// SPDX-License-Identifier: Apache-2.0

circuit BitwisePrecedence():
  input(a, b, c): Bits(8)
  output result: Bits(8)

  result <== a ||| b & c

def design = elaborate(BitwisePrecedence())

export:
  BitwisePrecedence
  design
