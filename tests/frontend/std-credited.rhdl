#lang rhodium
// Provides focused adapter wrappers and invalid credited-transport test cases.

import:
  lib("flow/main.rhdl") open

sync_circuit CreditSenderWrapper():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  interface link(Credited(Bits(8), 2), ~role: transmitter)
  output credit_count: Bits(2)

  inst sender(CreditSender(Bits(8), 2))
  ingress |> sender.ingress
  sender.link |> link
  credit_count <== sender.credit_count

sync_circuit CreditBufferWrapper():
  input grant_enable: Bool
  interface link(Credited(Bits(8), 2), ~role: receiver)
  interface egress(Irrevocable(Bits(8)), ~role: producer)
  output count: Bits(2)
  output reserved: Bits(2)

  inst buffer(CreditBuffer(Bits(8), 2))
  buffer.grant_enable <== grant_enable
  link |> buffer.link
  buffer.egress |> egress
  count <== buffer.count
  reserved <== buffer.reserved

sync_circuit InvalidCreditLimit():
  interface link(Credited(Bits(8), 0), ~role: transmitter)
  link.valid <== Bool(#false)
  link.bits <== bits(0, 8)

sync_circuit InvalidSenderLimit():
  inst sender(CreditSender(Bits(8), 0))

sync_circuit InvalidBufferDepth():
  inst buffer(CreditBuffer(Bits(8), 0))

sync_circuit MismatchedCreditLimits():
  interface transmitter(Credited(Bits(8), 2), ~role: transmitter)
  interface receiver(Credited(Bits(8), 3), ~role: receiver)
  transmitter <=> receiver

sync_circuit WrongCreditBufferProtocol():
  interface ingress(Decoupled(Bits(8)), ~role: producer)
  ingress |> credit_buffer(2)

sync_circuit WrongCreditBufferLimit():
  interface ingress(Credited(Bits(8), 3), ~role: transmitter)
  ingress |> credit_buffer(2)

def sender_design = elaborate(CreditSenderWrapper())
def buffer_design = elaborate(CreditBufferWrapper())

export:
  CreditSenderWrapper
  CreditBufferWrapper
  InvalidCreditLimit
  InvalidSenderLimit
  InvalidBufferDepth
  MismatchedCreditLimits
  WrongCreditBufferProtocol
  WrongCreditBufferLimit
  sender_design
  buffer_design
