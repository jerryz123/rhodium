#lang rhombus
// Checks concise synchronous-memory port elaboration and ambient clock wiring.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../examples/rtl/sync-memory.rhdl" as fixture
  "../../examples/rtl/sync-memory-1rw.rhdl" as shared_fixture
  "../../examples/rtl/sync-memory-masked.rhdl" as masked_fixture
  "sync-memory-fixture.rhdl" as focused

def module_def = fixture.design.modules[0]
def operation = module_def.operations.find(
  fun (candidate): candidate.opcode == "rtl.sync_memory"
)
def read_only_design = embedded.run_elaboration(fun (): focused.ReadOnlySyncMemory())
def read_only = read_only_design.modules[0].operations.find(
  fun (candidate): candidate.opcode == "rtl.sync_memory"
)
def write_only_design = embedded.run_elaboration(fun (): focused.WriteOnlySyncMemory())
def write_only = write_only_design.modules[0].operations.find(
  fun (candidate): candidate.opcode == "rtl.sync_memory"
)
def shared_module = shared_fixture.design.modules[0]
def shared = shared_module.operations.find(
  fun (candidate): candidate.opcode == "rtl.sync_memory"
)
def masked_module = masked_fixture.design.modules[0]
def masked = masked_module.operations.find(
  fun (candidate): candidate.opcode == "rtl.sync_memory"
)
def explicit_masked_design = embedded.run_elaboration(
  fun (): focused.MaskedWriteOnlySyncMemory()
)
def explicit_masked = explicit_masked_design.modules[0].operations.find(
  fun (candidate): candidate.opcode == "rtl.sync_memory"
)

check:
  operation.attribute("name") ~is "storage"
  operation.attribute("has_read") ~is #true
  operation.attribute("has_write") ~is #true
  operation.attribute("has_read_write") ~is #false
  operation.attribute("mask_granularity") ~is #false
  operation.operands[0] === module_def.find_input("clock").value ~is #true
  operation.places.map(fun (place): place.name) ~is ["storage.read.address",
                                                     "storage.read.enable",
                                                     "storage.write.address",
                                                     "storage.write.data",
                                                     "storage.write.enable"]
  operation.results[0].name ~is "storage.read.data"
  verify_design(fixture.design) ~is #void
  read_only.attribute("has_read") ~is #true
  read_only.attribute("has_write") ~is #false
  read_only.places.length() ~is 2
  read_only.results.length() ~is 1
  verify_design(read_only_design) ~is #void
  write_only.attribute("has_read") ~is #false
  write_only.attribute("has_write") ~is #true
  write_only.places.length() ~is 3
  write_only.results.length() ~is 0
  verify_design(write_only_design) ~is #void
  shared.attribute("has_read") ~is #false
  shared.attribute("has_write") ~is #false
  shared.attribute("has_read_write") ~is #true
  shared.places.map(fun (place): place.name) ~is ["storage.read_write.address",
                                                  "storage.read_write.enable",
                                                  "storage.read_write.write",
                                                  "storage.read_write.write_data"]
  shared.results[0].name ~is "storage.read_write.read_data"
  shared.operands[0] === shared_module.find_input("clock").value ~is #true
  masked.attribute("mask_granularity") ~is 8
  masked.places[4].type.width ~is 4
  masked.places.map(fun (place): place.name) ~is ["storage.read_write.address",
                                                  "storage.read_write.enable",
                                                  "storage.read_write.write",
                                                  "storage.read_write.write_data",
                                                  "storage.read_write.write_mask"]
  explicit_masked.attribute("mask_granularity") ~is 8
  explicit_masked.places[3].type.width ~is 4
  verify_design(shared_fixture.design) ~is #void
  verify_design(masked_fixture.design) ~is #void
  verify_design(explicit_masked_design) ~is #void
  embedded.run_elaboration(fun (): focused.MissingWritePort()) ~throws "has no write port"
  embedded.run_elaboration(fun (): focused.UnmaskedMaskAccess()) ~throws "has no mask"
  embedded.run_elaboration(fun (): focused.WrongMaskWidth()) ~throws "exactly the same hardware type"
  embedded.run_elaboration(fun (): focused.MaskedReadOnlySyncMemory()) ~throws "requires a write or read-write port"
