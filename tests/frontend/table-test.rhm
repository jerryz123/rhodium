#lang rhombus
// Checks host-generated table contents and direct hardware vector indexing.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus.bits.(<<) as <<
  "../../rhodium/core/main.rhm" open
  "../../examples/rtl/table.rhdl" as fixture

def module_def = fixture.design.modules[0]
def table_cast = module_def.operations.find(
  fun (operation):
    operation.opcode == "rtl.cast" && vector_type(operation.results[0].type)
)
def table_constant = module_def.find_operation(table_cast.operands[0].defining_op_id)
def dynamic_index = module_def.operations.find(
  fun (operation): operation.opcode == "rtl.vector_index"
)

fun packed_bytes(items):
  def mutable packed = 0
  for (value in items, index in 0..items.length()):
    packed := packed + (value << (index * 8))
  packed

check:
  module_def.name ~is "Tbl"
  type_equal(module_def.find_input("addr").type, Bits(8)) ~is #true
  type_equal(module_def.find_output("out").type, Bits(8)) ~is #true
  type_equal(table_cast.results[0].type, VectorType(256, Bits(8))) ~is #true
  table_constant.opcode ~is "rtl.constant"
  type_equal(table_constant.results[0].type, Bits(2048)) ~is #true
  table_constant.attribute("value") ~is packed_bytes(for List (i in 0..256): i)
  dynamic_index.operands[1] === module_def.find_input("addr").value ~is #true
  type_equal(dynamic_index.results[0].type, Bits(8)) ~is #true
  verify_design(fixture.design) ~is #void
