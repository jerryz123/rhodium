#lang rhombus
// Checks exact-key switch typing, direct mux lowering, effects, and diagnostics.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "switch-fixture.rhdl" as fixture

fun elaborate(generator):
  embedded.run_elaboration(generator)

fun operations(module_def, opcode):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == opcode
  )

def bits_design = elaborate(fun (): fixture.BitsSwitch())
def bits_module = bits_design.modules[0]
def bits_mux = operations(bits_module, "rtl.mux_lookup")[0]

def enum_design = elaborate(fun (): fixture.EnumSwitch())
def enum_module = enum_design.modules[0]
def enum_mux = operations(enum_module, "rtl.mux_lookup")[0]

def one_hot_design = elaborate(fun (): fixture.OneHotSwitch())
def one_hot_module = one_hot_design.modules[0]
def one_hot_mux = operations(one_hot_module, "rtl.mux_lookup")[0]

def hold_design = elaborate(fun (): fixture.SwitchRegisterHold())
def hold_module = hold_design.modules[0]
def hold_register = operations(hold_module, "rtl.register")[0]
def hold_mux = operations(hold_module, "rtl.mux_lookup")[0]

def nested_design = elaborate(fun (): fixture.NestedSwitch())
def nested_module = nested_design.modules[0]

def memory_design = elaborate(fun (): fixture.SwitchMemoryWrites())
def memory_module = memory_design.modules[0]
def memory_write = operations(memory_module, "rtl.memory_write")[0]
def memory_muxes = operations(memory_module, "rtl.mux_lookup")

def assertion_design = elaborate(fun (): fixture.SwitchAssertions())
def assertion_module = assertion_design.modules[0]
def assertions = operations(assertion_module, "verif.assert")

check:
  bits_mux.attribute("keys") ~is [0, 2]
  bits_mux.operands[0] === bits_module.find_input("selector").value ~is #true
  bits_mux.operands[1] === bits_module.find_input("fallback").value ~is #true
  bits_mux.operands[2] === bits_module.find_input("a").value ~is #true
  bits_mux.operands[3] === bits_module.find_input("b").value ~is #true
  operations(bits_module, "rtl.eq").length() ~is 0
  verify_design(bits_design) ~is #void

  enum_mux.attribute("keys") ~is [0, 1]
  enum_mux.operands[0].type.type_equal(Bits(2)) ~is #true
  verify_design(enum_design) ~is #void

  one_hot_mux.attribute("keys") ~is [1, 2]
  one_hot_mux.operands[0].type.type_equal(Bits(2)) ~is #true
  verify_design(one_hot_design) ~is #void

  hold_mux.attribute("keys") ~is [1]
  hold_mux.operands[1] === hold_register.results[0] ~is #true
  hold_register.places[0].driver === hold_mux.results[0] ~is #true
  verify_design(hold_design) ~is #void

  operations(nested_module, "rtl.mux_lookup").length() ~is 2
  verify_design(nested_design) ~is #void

  operations(memory_module, "rtl.memory_write").length() ~is 1
  memory_muxes.length() ~is 3
  (for all (mux in memory_muxes): mux.attribute("keys") == [0, 2]) ~is #true
  (for all (operand in [memory_write.operands[0],
                        memory_write.operands[1],
                        memory_write.operands[3]]):
     memory_module.find_operation(operand.defining_op_id).opcode == "rtl.mux_lookup") ~is #true
  verify_design(memory_design) ~is #void

  assertions.length() ~is 3
  operations(assertion_module, "rtl.eq").length() ~is 2
  operations(assertion_module, "rtl.not").length() ~is 2
  operations(assertion_module, "rtl.and").length() ~is 1
  verify_design(assertion_design) ~is #void

  elaborate(fun (): fixture.HostSwitchSelector()) ~throws "switch selector must be a hardware value"
  elaborate(fun (): fixture.UnsupportedSwitchSelector()) ~throws "switch selector must be Bits or a typed mux-key selector"
  elaborate(fun (): fixture.DuplicateSwitchKey()) ~throws "switch case keys must be unique"
  elaborate(fun (): fixture.WideSwitchKey()) ~throws "switch case key does not fit the selector width"
  elaborate(fun (): fixture.NonIntegerSwitchKey()) ~throws "host natural-number keys"
  elaborate(fun (): fixture.MissingSwitchOtherwise()) ~throws "requires otherwise"
  elaborate(fun (): fixture.MissingSwitchBranch()) ~throws "does not assign selected"
  elaborate(fun (): fixture.IntegerEnumSwitchKey()) ~throws "enum mux lookup keys"
  elaborate(fun (): fixture.ForeignEnumSwitchKey()) ~throws "enum mux lookup keys"
