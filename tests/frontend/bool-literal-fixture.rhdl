#lang rhodium
// Constructs both extension-defined Bool literal values through the callable type object.
// SPDX-License-Identifier: Apache-2.0

circuit BoolLiterals():
  output(high, low): Bool

  high <== Bool(#true)
  low <== Bool(#false)

def design = elaborate(BoolLiterals())

export:
  BoolLiterals
  design
