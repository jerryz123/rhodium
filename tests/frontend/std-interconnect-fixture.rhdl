#lang rhodium
// Supplies address matching, transfer containment, and stripe-projection validation fixtures.

import:
  lib("rhodium/std/interconnect.rhdl") open

circuit AddressSetMatchFixture():
  input address: Bits(16)
  output single: Bool
  output multiple: Bool
  output empty: Bool

  single <== AddressSet(0x8000, 0x0fff).matches(address)
  multiple <== address_sets_match(address,
                                  [AddressSet(0x8000, 0x0fff),
                                   AddressSet(0xa000, 0x0fff)])
  empty <== address_sets_match(address, [])

def design = elaborate(AddressSetMatchFixture())

circuit StripedProjectionFixture(layout :: StripedAddressLayout, width :: PosInt):
  input address: Bits(width)
  output projected: Bits(width)
  projected <== layout.project_offset(address)

fun projection_design(layout :: StripedAddressLayout, width :: PosInt):
  elaborate(StripedProjectionFixture(layout, width))

circuit TransferRangeFixture():
  input address: Bits(4)
  input length: Bits(4)
  input base: Bits(4)
  output contained: Vec(16, Bool)
  contained <== vec(for List (size in 1..=16): transfer_in_range(address, length, base, size))

circuit TransferRangeTypeFixture(T :: DataType, window :: PosInt):
  input address: Bits(4)
  input length: T
  output matches: Bool
  matches <== transfer_in_range(address, length, bits(0, 4), window)

fun transfer_range_design(T :: DataType, window :: PosInt):
  elaborate(TransferRangeTypeFixture(T, window))

export:
  TransferRangeFixture
  transfer_range_design
  projection_design
  AddressSetMatchFixture
  design
