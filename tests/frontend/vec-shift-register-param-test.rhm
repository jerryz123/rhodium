#lang rhombus
// Checks host-parameterized vector register construction and static shifting.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../examples/rtl/vec-shift-register-param.rhdl" as fixture

def module_def = fixture.design.modules[0]
def register_operation = module_def.operations.find(
  fun (operation): operation.opcode == "rtl.register_reset"
)
def alternate_design = embedded.run_elaboration(
  fun (): fixture.VecShiftRegisterParam(2, 8)
)
def alternate = alternate_design.modules[0]
def single_stage_design = embedded.run_elaboration(
  fun (): fixture.VecShiftRegisterParam(1, 3)
)
def single_stage = single_stage_design.modules[0]

check:
  module_def.name ~is "VecShiftRegisterParam"
  type_equal(register_operation.results[0].type,
             VectorType(4, Bits(4))) ~is #true
  type_equal(module_def.find_output("data_out").type, Bits(4)) ~is #true
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.mux_lookup"
  ).length() ~is 0
  type_equal(alternate.operations.find(
               fun (operation): operation.opcode == "rtl.register_reset"
             ).results[0].type,
             VectorType(2, Bits(8))) ~is #true
  type_equal(alternate.find_output("data_out").type, Bits(8)) ~is #true
  type_equal(single_stage.operations.find(
               fun (operation): operation.opcode == "rtl.register_reset"
             ).results[0].type,
             VectorType(1, Bits(3))) ~is #true
  verify_design(fixture.design) ~is #void
  verify_design(alternate_design) ~is #void
  verify_design(single_stage_design) ~is #void
