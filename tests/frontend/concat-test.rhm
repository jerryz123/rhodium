#lang rhombus
// Checks function and operator concatenation, host append, and frontend type boundaries.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "concat-fixture.rhdl" as fixture

def module_def = fixture.design.modules[0]
def concatenations = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.concat"
)
def casts = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.cast"
)
def nested_design = embedded.run_elaboration(fun (): fixture.NestedAppend(2))
def nested_module = nested_design.modules[0]
def nested_result = nested_module.find_output("result").place.driver
def nested_concatenations = nested_module.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.concat"
)

check:
  concatenations.length() ~is 6
  concatenations[0].operands.map(fun (value): value.name) ~is ["high", "middle", "low"]
  concatenations[1].operands.map(fun (value): value.name) ~is ["high", "middle"]
  concatenations[2].operands[0] === concatenations[1].results[0] ~is #true
  concatenations[2].operands[1].name ~is "low"
  concatenations[0].results[0].type.width ~is 5
  concatenations[2].results[0].type.width ~is 5
  module_def.find_output("direct").place.driver === concatenations[0].results[0] ~is #true
  module_def.find_output("appended").place.driver === concatenations[2].results[0] ~is #true
  module_def.find_output("generated").place.driver === concatenations[3].results[0] ~is #true
  casts.length() ~is 4
  record_type(casts[0].operands[0].type) ~is #true
  casts[0].results[0].type.width ~is 4
  casts[1].operands[0].type.describe() ~is "bool"
  casts[1].results[0].type.width ~is 1
  concatenations[4].operands ~is [casts[0].results[0], casts[1].results[0]]
  module_def.find_output("packed").place.driver === concatenations[4].results[0] ~is #true
  concatenations[5].operands ~is [casts[2].results[0], casts[3].results[0]]
  module_def.find_output("appended_packed").place.driver === concatenations[5].results[0] ~is #true
  fixture.host_string ~is "highlow"
  fixture.host_list ~is [1, 2, 3]
  nested_concatenations.length() ~is 1
  nested_result === nested_concatenations[0].results[0] ~is #true
  nested_result.type.width ~is 4
  verify_design(fixture.design) ~is #void
  verify_design(nested_design) ~is #void
  embedded.run_elaboration(fun (): fixture.ControlConcat()) ~throws "concat operand must have a packable DataType"
  embedded.run_elaboration(fun (): fixture.ControlAppend()) ~throws "++: left operand must have a packable DataType"
  embedded.run_elaboration(fun (): fixture.TooFewConcat()) ~throws "concat requires at least two operands"
