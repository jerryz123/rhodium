#lang rhombus
// Covers design-level DPI imports and mandatory-clock stateful call construction.

import:
  "../../rhodium/core/main.rhm" open

block:
  def design = Design()
  def builder = Builder(design)
  def procedure = builder.dpi_import("rhodium_trace", ["value"], [Bits(8)])
  def function = builder.dpi_import("rhodium_step",
                                    ["value"],
                                    [Bits(8)],
                                    "result",
                                    Bits(8))
  def module_def = builder.module("ClockedDPI")
  def clock = builder.input(module_def, "clock", Clock)
  def enable = builder.input(module_def, "enable", Bits(1))
  def value = builder.input(module_def, "value", Bits(8))
  def output = builder.output(module_def, "result", Bits(8))
  def call = builder.dpi_call(module_def,
                              procedure,
                              [value],
                              clock,
                              enable)
  def result = builder.dpi_register(module_def,
                                    "dpi_result",
                                    function,
                                    [value],
                                    clock,
                                    enable)
  builder.drive(output, result)
  builder.finish(module_def)
  check:
    design.dpi_imports.length() ~is 2
    call.results.length() ~is 0
    result.type.width ~is 8
    module_def.find_operation(result.defining_op_id).opcode ~is "sim.dpi_register"
    dump_ir(design).contains("sim.dpi_import @rhodium_trace(input value: bits<8>)") ~is #true
    dump_ir(design).contains("sim.dpi_import @rhodium_step(input value: bits<8>) -> return result: bits<8>") ~is #true
    dump_ir(design).contains("sim.dpi_call @rhodium_trace(%value) clock %clock enable %enable") ~is #true
    dump_ir(design).contains("sim.dpi_register @rhodium_step(%value) clock %clock enable %enable") ~is #true
    verify_design(design) ~is #void

block:
  def design = Design()
  def builder = Builder(design)
  def function = builder.dpi_import_results(
    "rhodium_step_pair",
    ["value"],
    [Bits(8)],
    [DpiResult("doubled", Bits(8), "out"),
     DpiResult("incremented", Bits(8), "return")]
  )
  def module_def = builder.module("MultiResultDPI")
  def clock = builder.input(module_def, "clock", Clock)
  def enable = builder.input(module_def, "enable", Bits(1))
  def value = builder.input(module_def, "value", Bits(8))
  def doubled = builder.output(module_def, "doubled", Bits(8))
  def incremented = builder.output(module_def, "incremented", Bits(8))
  def results = builder.dpi_register_results(module_def,
                                             ["dpi_doubled", "dpi_incremented"],
                                             function,
                                             [value],
                                             clock,
                                             enable)
  builder.drive(doubled, results[0])
  builder.drive(incremented, results[1])
  builder.finish(module_def)
  check:
    results.map(fun (result): result.name) ~is ["dpi_doubled", "dpi_incremented"]
    dump_ir(design).contains("sim.dpi_import @rhodium_step_pair(input value: bits<8>) -> (out doubled: bits<8>, return incremented: bits<8>)") ~is #true
    dump_ir(design).contains("%dpi_doubled, %dpi_incremented = sim.dpi_register @rhodium_step_pair") ~is #true
    builder.dpi_register(module_def, "single", function, [value], clock, enable) ~throws "exactly one result"
    verify_design(design) ~is #void

block:
  def design = Design()
  def builder = Builder(design)
  def dpi = builder.dpi_import("rhodium_step",
                               ["value"],
                               [Bits(8)],
                               "result",
                               Bits(8))
  def procedure = builder.dpi_import("rhodium_trace", ["value"], [Bits(8)])
  def same = builder.dpi_import("rhodium_step",
                                ["value"],
                                [Bits(8)],
                                "result",
                                Bits(8))
  def module_def = builder.module("BadClockedDPI")
  def clock = builder.input(module_def, "clock", Clock)
  def enable = builder.input(module_def, "enable", Bits(1))
  def wide_enable = builder.input(module_def, "wide_enable", Bits(2))
  def value = builder.input(module_def, "value", Bits(8))
  def wrong_value = builder.input(module_def, "wrong_value", Bits(4))
  check:
    same === dpi ~is #true
    builder.dpi_import("rhodium_step", ["value"], [Bits(4)], "result", Bits(8)) ~throws "conflicting signatures"
    builder.dpi_register(module_def, "wrong", dpi, [wrong_value], clock, enable) ~throws "wrong hardware type"
    builder.dpi_register(module_def, "clock", dpi, [value], enable, enable) ~throws "clock must be Clock"
    builder.dpi_register(module_def, "enable", dpi, [value], clock, wide_enable) ~throws "one-bit ScalarDataType"
    builder.dpi_call(module_def, dpi, [value], clock, enable) ~throws "must be instantiated with dpi_register"
    builder.dpi_register(module_def, "procedure", procedure, [value], clock, enable) ~throws "exactly one result"

block:
  def design = Design()
  def builder = Builder(design)
  check:
    builder.dpi_import_results("missing_return",
                               ["value"],
                               [Bits(8)],
                               [DpiResult("output", Bits(8), "out")]) ~throws "exactly one return"
    builder.dpi_import_results("return_first",
                               ["value"],
                               [Bits(8)],
                               [DpiResult("result", Bits(8), "return"),
                                DpiResult("output", Bits(8), "out")]) ~throws "must be last"
    builder.dpi_import_results("duplicate_result",
                               ["value"],
                               [Bits(8)],
                               [DpiResult("result", Bits(8), "out"),
                                DpiResult("result", Bits(8), "return")]) ~throws "must be unique"
    builder.dpi_import_results("bad_direction",
                               ["value"],
                               [Bits(8)],
                               [DpiResult("result", Bits(8), "inout")]) ~throws "out or return"
