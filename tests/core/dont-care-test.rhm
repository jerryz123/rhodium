#lang rhombus
// Verifies synthesis don't-care construction, printing, and malformed-IR rejection.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("DontCare")
  def output_place = builder.output(module_def, "result", Bits(8))
  def value = builder.dont_care(module_def, Bits(8), "free")
  builder.drive(output_place, value)
  builder.finish(module_def)
  def operation = module_def.find_operation(value.defining_op_id)

  check:
    operation.opcode ~is "rtl.dont_care"
    operation.operands ~is []
    type_equal(value.type, Bits(8)) ~is #true
    combinational_opcode("rtl.dont_care") ~is #true
    dump_ir(design).contains("%free = rtl.dont_care : bits<8>") ~is #true
    verify_design(design) ~is #void

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("BadDontCare")

  check:
    builder.dont_care(module_def, Clock) ~throws "expected a Bits type"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("MalformedDontCare")
  def operation_id = design.fresh_id()
  def result = Value(design.fresh_id(), "result", Clock, module_def, operation_id)
  def operation = Operation(operation_id,
                            "rtl.dont_care",
                            module_def,
                            [],
                            [result],
                            [],
                            {"name": "result"})
  module_def.add_value(result)
  module_def.add_operation(operation)
  builder.finish(module_def)

  check:
    verify_design(design) ~throws "don't-care result must have a valid Bits type"
