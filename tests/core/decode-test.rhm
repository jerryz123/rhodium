#lang rhombus
// Verifies typed core decode construction, canonical patterns, and validation.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("Decode")
  def selector = builder.input(module_def, "selector", Bits(4))
  def output = builder.output(module_def, "result", Bits(2))
  def result = builder.decode(module_def,
                              selector,
                              Bits(4),
                              Bits(2),
                              [[0b1011, 0b1100, 0b01, 0b11],
                               [0b0101, 0b1100, 0b10, 0b10]],
                              0b11,
                              0b10,
                              "decoded")
  builder.drive(output, result)
  builder.finish(module_def)
  def operation = module_def.find_operation(result.defining_op_id)

  check:
    operation.opcode ~is "rtl.decode"
    operation.attribute("cases") ~is [[0b1000, 0b1100, 0b01, 0b11],
                                      [0b0100, 0b1100, 0b10, 0b10]]
    operation.attribute("default_value") ~is 0b10
    operation.attribute("default_care") ~is 0b10
    combinational_opcode("rtl.decode") ~is #true
    dump_ir(design).contains("rtl.decode %selector [8/12 -> 1/3, 4/12 -> 2/2] default 2/2") ~is #true
    verify_design(design) ~is #void

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("BadDecode")
  def selector = builder.input(module_def, "selector", Bits(4))

  check:
    builder.decode(module_def,
                   selector,
                   Bits(4),
                   Bits(1),
                   [[0b1000, 0b1000, 0, 1],
                    [0b1001, 0b1100, 1, 1]],
                   0,
                   1) ~throws "overlap"
    builder.decode(module_def,
                   selector,
                   Bits(3),
                   Bits(1),
                   [],
                   0,
                   1) ~throws "wrong DataType"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("MalformedDecode")
  def selector = builder.input(module_def, "selector", Bits(2))
  def operation_id = design.fresh_id()
  def result = Value(design.fresh_id(), "result", Bits(1), module_def, operation_id)
  def operation = Operation(operation_id,
                            "rtl.decode",
                            module_def,
                            [selector],
                            [result],
                            [],
                            {"cases": [[0, 0b100, 0, 1]],
                             "default_value": 0,
                             "default_care": 1,
                             "name": "result"})
  selector.add_user(operation_id)
  module_def.add_value(result)
  module_def.add_operation(operation)
  builder.finish(module_def)

  check:
    verify_design(design) ~throws "input is malformed"
