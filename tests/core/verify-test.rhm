block:
  def design = Design()
  def builder = Builder(design)
  def pair_type = RecordType([RecordField("left", Bits(1)),
                              RecordField("right", Bits(1))])
  def child = builder.module("FieldSelectiveChild")
  def child_input = builder.input(child, "input", pair_type)
  def child_output = builder.output(child, "output", pair_type)
  def child_left = builder.record_get(child, child_input, "left")
  def zero = builder.constant(child, Bits(1), 0)
  builder.drive(
    child_output,
    builder.record_create(child,
                          pair_type,
                          [["left", child_left], ["right", zero]])
  )
  builder.finish(child)
  def top = builder.module("FieldSelectiveTop")
  def instance = builder.instance(top, child, "u")
  def top_zero = builder.constant(top, Bits(1), 0)
  def output_left = builder.record_get(top,
                                       instance.output("output"),
                                       "left")
  builder.drive(builder.project(instance.input("input"), "left"), top_zero)
  builder.drive(builder.project(instance.input("input"), "right"), output_left)
  builder.finish(top)
  check:
    // The feedback reaches an input field that cannot affect output.left.
    verify_design(design) ~is #void

