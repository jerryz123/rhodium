block:
  def design = Design()
  def builder = Builder(design)
  def child = builder.module("NameChild")
  builder.finish(child)
  def top = builder.module("InstanceNames")
  def first = builder.suggested_instance(top, child, "adder")
  def second = builder.suggested_instance(top, child, "adder")
  def reserved = builder.instance(top, child, "adder_2")
  def fourth = builder.suggested_instance(top, child, "adder")
  check:
    first.operation.attribute("name") ~is "adder"
    second.operation.attribute("name") ~is "adder_1"
    reserved.operation.attribute("name") ~is "adder_2"
    fourth.operation.attribute("name") ~is "adder_3"
    builder.instance(top, child, "adder") ~throws "duplicate instance name adder"
  builder.finish(top)
  check:
    verify_design(design) ~is #void

block:
  def design = Design()
  def builder = Builder(design)
  def child = builder.module("ForgedNameChild")
  builder.finish(child)
  def top = builder.module("ForgedInstanceNames")
  def first = Operation(design.fresh_id(),
                        "rtl.instance",
                        top,
                        [],
                        [],
                        [],
                        {"name": "same", "module": child})
  def second = Operation(design.fresh_id(),
                         "rtl.instance",
                         top,
                         [],
                         [],
                         [],
                         {"name": "same", "module": child})
  top.add_operation(first)
  top.add_operation(second)
  builder.finish(top)
  check:
    verify_design(design) ~throws "instance name same is not unique"

block:
  def design = Design()
  def builder = Builder(design)
  def child = builder.module("Child")
  def child_in = builder.input(child, "in", Bits(1))
  def child_out = builder.output(child, "out", Bits(1))
  builder.drive(child_out, child_in)
  def finished_child = builder.finish(child)
  def top = builder.module("Top")
  def instance = builder.instance(top, child, "u")
  def top_out = builder.output(top, "out", Bits(1))
  builder.drive(top_out, instance.output("out"))
  def finished_top = builder.finish(top)
  check:
    verify_design(design) ~throws "place u.in is undriven"

block:
  def source_design = Design()
  def source_builder = Builder(source_design)
  def source_module = source_builder.module("Source")
  def foreign_value = source_builder.input(source_module, "value", Bits(1))
  def target_design = Design()
  def target_builder = Builder(target_design)
  def target_module = target_builder.module("Target")
  def target = target_builder.output(target_module, "target", Bits(1))
  check:
    source_module.id ~is target_module.id
    (source_module === target_module) ~is #false
    target_builder.drive(target, foreign_value) ~throws "different module"

