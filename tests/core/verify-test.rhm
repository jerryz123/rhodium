  def top = builder.module("NestedCycleTop")
  def outer = builder.instance(top, wrapper, "outer")
  builder.drive(outer.input("a"), outer.output("y"))
  def finished_top = builder.finish(top)
  check:
    verify_design(design) ~throws "combinational cycle reaches value outer.y"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("Names")
  def a = builder.input(module_def, "a", Bits(8))
  check:
