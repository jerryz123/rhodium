block:
  def design = Design()
  def builder = Builder(design)
  def child = builder.module("SelectiveChild")
  def used = builder.input(child, "used", Bits(1))
  def unused = builder.input(child, "unused", Bits(1))
  def child_output = builder.output(child, "y", Bits(1))
  builder.drive(child_output, used)
  def finished_child = builder.finish(child)
  def top = builder.module("SelectiveTop")
