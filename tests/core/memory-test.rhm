#lang rhombus
// Covers core async-read memory construction, verification, and rejection rules.

import:
  "../../rhodium/core/main.rhm" open

check:
  memory_address_width(1) ~is 1
  memory_address_width(2) ~is 1
  memory_address_width(3) ~is 2
  memory_address_width(5) ~is 3
  schema_for("rtl.memory").type_rule ~is "memory"
  schema_for("rtl.memory_read_async").type_rule ~is "memory_read_async"
  schema_for("rtl.memory_write").type_rule ~is "memory_write"

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("MemoryCore")
  def clock = builder.input(module_def, "clock", Clock)
  def read_address = builder.input(module_def, "read_address", Bits(3))
  def write_address = builder.input(module_def, "write_address", Bits(3))
  def second_write_address = builder.input(module_def, "second_write_address", Bits(3))
  def write_data = builder.input(module_def, "write_data", Bits(8))
  def second_write_data = builder.input(module_def, "second_write_data", Bits(8))
  def write_enable = builder.input(module_def, "write_enable", Bits(1))
  def second_write_enable = builder.input(module_def, "second_write_enable", Bits(1))
  def read_data = builder.output(module_def, "read_data", Bits(8))
  def storage = builder.memory(module_def, "storage", 5, Bits(8))
  def read_value = builder.memory_read_async(module_def, storage, read_address)
  def second_read_value = builder.memory_read_async(module_def, storage, read_address)
  def write = builder.memory_write(module_def,
                                   storage,
                                   write_address,
                                   write_data,
                                   clock,
                                   write_enable)
  def second_write = builder.memory_write(module_def,
                                          storage,
                                          second_write_address,
                                          second_write_data,
                                          clock,
                                          second_write_enable)
  builder.drive(read_data, read_value)
  builder.finish(module_def)
  check:
    module_def.memories.length() ~is 1
    storage.depth ~is 5
    storage.element_type.type_equal(Bits(8)) ~is #true
    read_value.type.type_equal(Bits(8)) ~is #true
    second_read_value.type.type_equal(Bits(8)) ~is #true
    module_def.operations.filter(
      ~keep: fun (operation): operation.opcode == "rtl.memory_read_async"
    ).length() ~is 2
    write.opcode ~is "rtl.memory_write"
    second_write.opcode ~is "rtl.memory_write"
    module_def.operations.filter(
      ~keep: fun (operation): operation.opcode == "rtl.memory_write"
    ).length() ~is 2
    dump_ir(design).contains("@storage = rtl.memory depth 5 : bits<8>") ~is #true
    dump_ir(design).contains("rtl.memory_read_async @storage[%read_address]") ~is #true
    dump_ir(design).contains("rtl.memory_write @storage[%write_address] = %write_data") ~is #true
    verify_design(design) ~is #void

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("BadMemory")
  def clock = builder.input(module_def, "clock", Clock)
  def address = builder.input(module_def, "address", Bits(2))
  def bad_address = builder.input(module_def, "bad_address", Bits(3))
  def data = builder.input(module_def, "data", Bits(8))
  def bad_data = builder.input(module_def, "bad_data", Bits(4))
  def enable = builder.input(module_def, "enable", Bits(1))
  def bad_enable = builder.input(module_def, "bad_enable", Bits(2))
  def storage = builder.memory(module_def, "storage", 4, Bits(8))
  check:
    builder.memory(module_def, "zero", 0, Bits(8)) ~throws "PosInt"
    builder.memory(module_def, "control", 4, Clock) ~throws "DataType"
    builder.memory_read_async(module_def, storage, bad_address) ~throws "Bits(2)"
    builder.memory_write(module_def, storage, address, bad_data, clock, enable) ~throws "wrong DataType"
    builder.memory_write(module_def, storage, address, data, enable, enable) ~throws "clock must be Clock"
    builder.memory_write(module_def, storage, address, data, clock, bad_enable) ~throws "one-bit ScalarDataType"
  def valid_write = builder.memory_write(module_def, storage, address, data, clock, enable)
  check:
    valid_write.opcode ~is "rtl.memory_write"

block:
  def design = Design()
  def builder = Builder(design)
  def owner = builder.module("Owner")
  def other = builder.module("Other")
  def storage = builder.memory(owner, "storage", 2, Bits(8))
  def other_address = builder.input(other, "address", Bits(1))
  check:
    builder.memory_read_async(other, storage, other_address) ~throws "different module"
