#lang rhombus
// Checks closed-design input contracts, clock relationships, validation, and reports.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/analysis/clocking.rhm" open

fun local_sink(summary, name):
  summary.sinks.find(
    fun (sink): sink.instance_path.length() == 0 && sink.operation.attribute("name", #false) == name
  )

fun nested_sink(summary, instance_name, name):
  summary.sinks.find(
    fun (sink): sink.instance_path.length() == 1 && sink.instance_path[0].attribute("name") == instance_name && sink.operation.attribute("name", #false) == name
  )

fun next_classification(sink):
  sink.inputs.find(fun (input): input.name == "next").classification

block:
  def design = Design()
  def builder = Builder(design)
  def top = builder.module("ClosedClockRelationships")
  def clock = builder.input(top, "clock", Clock)
  def identical_clock = builder.input(top, "identical_clock", Clock)
  def transitive_clock = builder.input(top, "transitive_clock", Clock)
  def derived_clock = builder.input(top, "derived_clock", Clock)
  def asynchronous_clock = builder.input(top, "asynchronous_clock", Clock)
  def exclusive_clock = builder.input(top, "exclusive_clock", Clock)
  def unknown_clock = builder.input(top, "unknown_clock", Clock)
  def same_data = builder.input(top, "same_data", Bits(8))
  def identical_data = builder.input(top, "identical_data", Bits(8))
  def transitive_data = builder.input(top, "transitive_data", Bits(8))
  def derived_data = builder.input(top, "derived_data", Bits(8))
  def asynchronous_data = builder.input(top, "asynchronous_data", Bits(8))
  def exclusive_data = builder.input(top, "exclusive_data", Bits(8))
  def unknown_clock_data = builder.input(top, "unknown_clock_data", Bits(8))
  def asynchronous_input = builder.input(top, "asynchronous_input", Bits(1))
  def unknown_input = builder.input(top, "unknown_input", Bits(8))
  def same_sink = builder.register(top, "same_sink", Bits(8), clock)
  def identical_sink = builder.register(top, "identical_sink", Bits(8), clock)
  def transitive_sink = builder.register(top, "transitive_sink", Bits(8), clock)
  def derived_sink = builder.register(top, "derived_sink", Bits(8), clock)
  def asynchronous_sink = builder.register(top, "asynchronous_sink", Bits(8), clock)
  def exclusive_sink = builder.register(top, "exclusive_sink", Bits(8), clock)
  def unknown_clock_sink = builder.register(top, "unknown_clock_sink", Bits(8), clock)
  def asynchronous_input_sink = builder.register(top,
                                                 "asynchronous_input_sink",
                                                 Bits(1),
                                                 clock)
  def unknown_input_sink = builder.register(top,
                                            "unknown_input_sink",
                                            Bits(8),
                                            clock)
  def identical_fan_in_sink = builder.register(top,
                                               "identical_fan_in_sink",
                                               Bits(8),
                                               clock)
  def multi_clock_sink = builder.register(top,
                                          "multi_clock_sink",
                                          Bits(8),
                                          clock)
  builder.drive(same_sink.next, same_data)
  builder.drive(identical_sink.next, identical_data)
  builder.drive(transitive_sink.next, transitive_data)
  builder.drive(derived_sink.next, derived_data)
  builder.drive(asynchronous_sink.next, asynchronous_data)
  builder.drive(exclusive_sink.next, exclusive_data)
  builder.drive(unknown_clock_sink.next, unknown_clock_data)
  builder.drive(asynchronous_input_sink.next, asynchronous_input)
  builder.drive(unknown_input_sink.next, unknown_input)
  builder.drive(identical_fan_in_sink.next,
                builder.add(top, same_data, identical_data))
  builder.drive(multi_clock_sink.next,
                builder.add(top, same_data, derived_data))
  builder.finish(top)
  verify_design(design)
  def elaboration = DesignElaboration(design, top)
  def environment = TemporalEnvironment(
    [TopInputContract(same_data, [], SynchronousInputTiming(clock)),
     TopInputContract(identical_data,
                      [],
                      SynchronousInputTiming(identical_clock)),
     TopInputContract(transitive_data,
                      [],
                      SynchronousInputTiming(transitive_clock)),
     TopInputContract(derived_data,
                      [],
                      SynchronousInputTiming(derived_clock)),
     TopInputContract(asynchronous_data,
                      [],
                      SynchronousInputTiming(asynchronous_clock)),
     TopInputContract(exclusive_data,
                      [],
                      SynchronousInputTiming(exclusive_clock)),
     TopInputContract(unknown_clock_data,
                      [],
                      SynchronousInputTiming(unknown_clock)),
     TopInputContract(asynchronous_input,
                      [],
                      AsynchronousInputTiming()),
     TopInputContract(unknown_input, [], UnknownInputTiming())],
    [IdenticalClockRelationship(clock, identical_clock),
     IdenticalClockRelationship(identical_clock, transitive_clock),
     DerivedClockRelationship(clock,
                              derived_clock,
                              "generated divide-by-two"),
     AsynchronousClockRelationship(clock, asynchronous_clock),
     ExclusiveClockRelationship(clock,
                                exclusive_clock,
                                "mode-selected clocks")]
  )
  def summary = summarize_design_temporal(elaboration, environment)
  def report = dump_design_temporal_report(summary)
  check:
    next_classification(local_sink(summary, "same_sink")) is_a SameClock ~is #true
    next_classification(local_sink(summary, "identical_sink")) is_a IdenticalClock ~is #true
    next_classification(local_sink(summary, "transitive_sink")) is_a IdenticalClock ~is #true
    next_classification(local_sink(summary, "derived_sink")) is_a DerivedClock ~is #true
    next_classification(local_sink(summary, "asynchronous_sink")) is_a AsynchronousClock ~is #true
    next_classification(local_sink(summary, "exclusive_sink")) is_a ExclusiveClock ~is #true
    next_classification(local_sink(summary, "unknown_clock_sink")) is_a UnknownClockRelationship ~is #true
    next_classification(local_sink(summary, "asynchronous_input_sink")) is_a AsynchronousEnvironmentInput ~is #true
    next_classification(local_sink(summary, "unknown_input_sink")) is_a UnknownInput ~is #true
    next_classification(local_sink(summary, "identical_fan_in_sink")) is_a SameClock ~is #true
    next_classification(local_sink(summary, "multi_clock_sink")) is_a MultiClockFanIn ~is #true
    report.contains("input same_data: synchronous %clock") ~is #true
    report.contains("clock_relation derived %clock %derived_clock generated divide-by-two") ~is #true
    report.contains("next: unknown_clock_relationship") ~is #true
    dump_design_temporal_report(summary) ~is report

block:
  def design = Design()
  def builder = Builder(design)
  def top = builder.module("AggregateEnvironmentContracts")
  def clock = builder.input(top, "clock", Clock)
  def pair_type = RecordType([RecordField("left", Bits(8)),
                              RecordField("right", Bits(8))])
  def pair = builder.input(top, "pair", pair_type)
  def left = builder.record_get(top, pair, "left")
  def right = builder.record_get(top, pair, "right")
  def left_sink = builder.register(top, "left_sink", Bits(8), clock)
  def right_sink = builder.register(top, "right_sink", Bits(8), clock)
  builder.drive(left_sink.next, left)
  builder.drive(right_sink.next, right)
  builder.finish(top)
  verify_design(design)
  def elaboration = DesignElaboration(design, top)
  def environment = TemporalEnvironment(
    [TopInputContract(pair, ["left"], SynchronousInputTiming(clock))]
  )
  def summary = summarize_design_temporal(elaboration, environment)
  check:
    next_classification(local_sink(summary, "left_sink")) is_a SameClock ~is #true
    next_classification(local_sink(summary, "right_sink")) is_a UnknownInput ~is #true
    dump_design_temporal_report(summary).contains("input pair.left: synchronous %clock") ~is #true
    dump_design_temporal_report(summary).contains("input pair.right: unknown") ~is #true
    summarize_design_temporal(
      elaboration,
      TemporalEnvironment(
        [TopInputContract(pair, [], UnknownInputTiming()),
         TopInputContract(pair, ["left"], SynchronousInputTiming(clock))]
      )
    ) ~throws "input contracts must not overlap"

block:
  def design = Design()
  def builder = Builder(design)
  def child = builder.module("EnvironmentChild")
  def child_clock = builder.input(child, "clock", Clock)
  def child_data = builder.input(child, "data", Bits(8))
  def child_state = builder.register(child, "state", Bits(8), child_clock)
  builder.drive(child_state.next, child_data)
  builder.finish(child)
  def top = builder.module("EnvironmentHierarchy")
  def clock_a = builder.input(top, "clock_a", Clock)
  def clock_b = builder.input(top, "clock_b", Clock)
  def data = builder.input(top, "data", Bits(8))
  def first = builder.instance(top, child, "first")
  builder.drive(first.input("clock"), clock_a)
  builder.drive(first.input("data"), data)
  def second = builder.instance(top, child, "second")
  builder.drive(second.input("clock"), clock_b)
  builder.drive(second.input("data"), data)
  builder.finish(top)
  verify_design(design)
  def summary = summarize_design_temporal(
    DesignElaboration(design, top),
    TemporalEnvironment(
      [TopInputContract(data, [], SynchronousInputTiming(clock_a))],
      [AsynchronousClockRelationship(clock_a, clock_b)]
    )
  )
  check:
    next_classification(nested_sink(summary, "first", "state")) is_a SameClock ~is #true
    next_classification(nested_sink(summary, "second", "state")) is_a AsynchronousClock ~is #true

block:
  def design = Design()
  def builder = Builder(design)
  def top = builder.module("InvalidEnvironment")
  def clock_a = builder.input(top, "clock_a", Clock)
  def clock_b = builder.input(top, "clock_b", Clock)
  def data = builder.input(top, "data", Bits(8))
  def state = builder.register(top, "state", Bits(8), clock_a)
  builder.drive(state.next, data)
  builder.finish(top)
  def other = builder.module("OtherEnvironment")
  def other_data = builder.input(other, "data", Bits(8))
  def other_clock = builder.input(other, "clock", Clock)
  builder.finish(other)
  verify_design(design)
  def elaboration = DesignElaboration(design, top)
  check:
    summarize_design_temporal(
      elaboration,
      TemporalEnvironment([TopInputContract(other_data, [], UnknownInputTiming())])
    ) ~throws "input of top module"
    summarize_design_temporal(
      elaboration,
      TemporalEnvironment([TopInputContract(clock_a, [], UnknownInputTiming())])
    ) ~throws "must reference a data input"
    summarize_design_temporal(
      elaboration,
      TemporalEnvironment([TopInputContract(data, ["missing"], UnknownInputTiming())])
    ) ~throws "invalid aggregate path"
    summarize_design_temporal(
      elaboration,
      TemporalEnvironment([TopInputContract(data, [], StaticInput())])
    ) ~throws "unknown timing kind"
    summarize_design_temporal(
      elaboration,
      TemporalEnvironment([TopInputContract(data, [], SynchronousInputTiming(data))])
    ) ~throws "Clock input of the same top module"
    summarize_design_temporal(
      elaboration,
      TemporalEnvironment([], [AsynchronousClockRelationship(clock_a, clock_a)])
    ) ~throws "two distinct top clocks"
    summarize_design_temporal(
      elaboration,
      TemporalEnvironment([], [AsynchronousClockRelationship(clock_a, data)])
    ) ~throws "Clock inputs of the same top module"
    summarize_design_temporal(
      elaboration,
      TemporalEnvironment([], [AsynchronousClockRelationship(clock_a, other_clock)])
    ) ~throws "Clock inputs of the same top module"
    summarize_design_temporal(
      elaboration,
      TemporalEnvironment([], [DerivedClockRelationship(clock_a, clock_b, "")])
    ) ~throws "nonempty description"
    summarize_design_temporal(
      elaboration,
      TemporalEnvironment([], [AsynchronousClockRelationship(clock_a, clock_b),
                               AsynchronousClockRelationship(clock_b, clock_a)])
    ) ~throws "duplicate clock relationship"
    summarize_design_temporal(
      elaboration,
      TemporalEnvironment([], [AsynchronousClockRelationship(clock_a, clock_b),
                               ExclusiveClockRelationship(clock_a, clock_b, "test modes")])
    ) ~throws "contradictory clock relationships"
    summarize_design_temporal(
      elaboration,
      TemporalEnvironment([], [IdenticalClockRelationship(clock_a, clock_b),
                               AsynchronousClockRelationship(clock_a, clock_b)])
    ) ~throws "contradicts the identical clock equivalence"
