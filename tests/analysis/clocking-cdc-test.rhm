#lang rhombus
// Checks strict CDC policy, sync-level approval, lineage, and pre-crossing fan-in rejection.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/analysis/clocking.rhm" open

fun add_sync_level(builder, module_def, name, source, clock):
  def stage0 = builder.register(module_def,
                                name ++ "_stage0",
                                Bits(1),
                                clock)
  def stage1 = builder.register(module_def,
                                name ++ "_stage1",
                                Bits(1),
                                clock)
  builder.drive(stage0.next, source)
  builder.drive(stage1.next, stage0.current)
  def evidence = builder.sync_level_crossing(module_def,
                                             source,
                                             clock,
                                             [stage0, stage1])
  [stage1.current, evidence]

block:
  def design = Design()
  def builder = Builder(design)
  def top = builder.module("RawClockCrossing")
  def source_clock = builder.input(top, "source_clock", Clock)
  def destination_clock = builder.input(top, "destination_clock", Clock)
  def zero = builder.constant(top, Bits(1), 0)
  def source = builder.register(top, "source", Bits(1), source_clock)
  def destination = builder.register(top, "destination", Bits(1), destination_clock)
  builder.drive(source.next, zero)
  builder.drive(destination.next, source.current)
  builder.finish(top)
  verify_design(design)
  def elaboration = DesignElaboration(design, top)
  def environment = TemporalEnvironment(
    [],
    [AsynchronousClockRelationship(source_clock, destination_clock)]
  )
  def summary = summarize_design_temporal(elaboration, environment)
  check:
    summary.cdc_violations.length() ~is 1
    summary.cdc_violations[0] is_a CdcViolation ~is #true
    summary.cdc_violations[0].operation === destination.operation ~is #true
    summary.cdc_violations[0].classification is_a AsynchronousClock ~is #true
    dump_design_temporal_report(summary).contains("destination.next: asynchronous_clock") ~is #true
    verify_design_cdc(elaboration, environment) ~throws "1 CDC violation"
    verify_design_cdc(elaboration, environment) ~throws "requires explicit crossing evidence"

block:
  def design = Design()
  def builder = Builder(design)
  def top = builder.module("ApprovedSyncLevel")
  def clock = builder.input(top, "clock", Clock)
  def level = builder.input(top, "level", Bits(1))
  def synchronized = builder.output(top, "synchronized", Bits(1))
  def stage0 = builder.register(top, "stage0", Bits(1), clock)
  def stage1 = builder.register(top, "stage1", Bits(1), clock)
  builder.drive(stage0.next, level)
  builder.drive(stage1.next, stage0.current)
  builder.drive(synchronized, stage1.current)
  def evidence = builder.sync_level_crossing(top,
                                             level,
                                             clock,
                                             [stage0, stage1])
  builder.finish(top)
  verify_design(design)
  def summary = verify_design_cdc(
    DesignElaboration(design, top),
    TemporalEnvironment(
      [TopInputContract(level, [], AsynchronousInputTiming())]
    )
  )
  def first_stage = summary.sinks.find(
    fun (sink): sink.operation === stage0.operation
  )
  def final_stage = summary.sinks.find(
    fun (sink): sink.operation === stage1.operation
  )
  check:
    summary.cdc_violations.length() ~is 0
    first_stage.inputs[0].classification is_a AsynchronousEnvironmentInput ~is #true
    first_stage.inputs[0].crossing.operation === evidence ~is #true
    final_stage.inputs[0].crossing ~is #false
    summary.output_leaves[0].origins[0] is_a CrossedProvenance ~is #true
    summary.output_leaves[0].origins[0].crossing.operation === evidence ~is #true

block:
  def design = Design()
  def builder = Builder(design)
  def top = builder.module("MultiClockBeforeSyncLevel")
  def clock_a = builder.input(top, "clock_a", Clock)
  def clock_b = builder.input(top, "clock_b", Clock)
  def destination_clock = builder.input(top, "destination_clock", Clock)
  def zero = builder.constant(top, Bits(1), 0)
  def source_a = builder.register(top, "source_a", Bits(1), clock_a)
  def source_b = builder.register(top, "source_b", Bits(1), clock_b)
  def stage0 = builder.register(top, "stage0", Bits(1), destination_clock)
  def stage1 = builder.register(top, "stage1", Bits(1), destination_clock)
  builder.drive(source_a.next, zero)
  builder.drive(source_b.next, zero)
  def combined = builder.bit_xor(top, source_a.current, source_b.current)
  builder.drive(stage0.next, combined)
  builder.drive(stage1.next, stage0.current)
  builder.sync_level_crossing(top,
                              combined,
                              destination_clock,
                              [stage0, stage1])
  builder.finish(top)
  verify_design(design)
  check:
    verify_design_cdc(
      DesignElaboration(design, top),
      TemporalEnvironment(
        [],
        [AsynchronousClockRelationship(clock_a, destination_clock),
         AsynchronousClockRelationship(clock_b, destination_clock)]
      )
    ) ~throws "expected one declared timing source"

block:
  def design = Design()
  def builder = Builder(design)
  def top = builder.module("MixedTimingBeforeSyncLevel")
  def source_clock = builder.input(top, "source_clock", Clock)
  def destination_clock = builder.input(top, "destination_clock", Clock)
  def asynchronous_pin = builder.input(top, "asynchronous_pin", Bits(1))
  def zero = builder.constant(top, Bits(1), 0)
  def source_state = builder.register(top, "source_state", Bits(1), source_clock)
  def stage0 = builder.register(top, "stage0", Bits(1), destination_clock)
  def stage1 = builder.register(top, "stage1", Bits(1), destination_clock)
  builder.drive(source_state.next, zero)
  def combined = builder.bit_xor(top, source_state.current, asynchronous_pin)
  builder.drive(stage0.next, combined)
  builder.drive(stage1.next, stage0.current)
  builder.sync_level_crossing(top,
                              combined,
                              destination_clock,
                              [stage0, stage1])
  builder.finish(top)
  verify_design(design)
  check:
    verify_design_cdc(
      DesignElaboration(design, top),
      TemporalEnvironment(
        [TopInputContract(asynchronous_pin, [], AsynchronousInputTiming())],
        [AsynchronousClockRelationship(source_clock, destination_clock)]
      )
    ) ~throws "mixed_timing_fan_in"

block:
  def design = Design()
  def builder = Builder(design)
  def top = builder.module("DuplicatedSynchronizersReconverge")
  def clock = builder.input(top, "clock", Clock)
  def asynchronous_level = builder.input(top, "asynchronous_level", Bits(1))
  let [left, left_evidence] = add_sync_level(builder,
                                             top,
                                             "left",
                                             asynchronous_level,
                                             clock)
  let [right, right_evidence] = add_sync_level(builder,
                                               top,
                                               "right",
                                               asynchronous_level,
                                               clock)
  def sampled = builder.register(top, "sampled", Bits(1), clock)
  builder.drive(sampled.next, builder.bit_xor(top, left, right))
  builder.finish(top)
  verify_design(design)
  def summary = verify_design_cdc(
    DesignElaboration(design, top),
    TemporalEnvironment(
      [TopInputContract(asynchronous_level, [], AsynchronousInputTiming())]
    )
  )
  def finding = summary.reconvergences[0]
  check:
    summary.reconvergences.length() ~is 1
    finding.operation === sampled.operation ~is #true
    finding.arrivals.length() ~is 2
    finding.arrivals[0].provenance.crossing.operation === left_evidence ~is #true
    finding.arrivals[1].provenance.crossing.operation === right_evidence ~is #true
    finding.arrivals[0].provenance.source_origins[0] is_a ExternalProvenance ~is #true
    dump_design_temporal_report(summary).contains("reconvergence sampled rtl.register") ~is #true

block:
  def design = Design()
  def builder = Builder(design)
  def child = builder.module("HierarchicalSink")
  def child_clock = builder.input(child, "clock", Clock)
  def child_data = builder.input(child, "data", Bits(1))
  def child_state = builder.register(child, "state", Bits(1), child_clock)
  builder.drive(child_state.next, child_data)
  builder.finish(child)

  def top = builder.module("MultipleMissingCrossings")
  def source_clock = builder.input(top, "source_clock", Clock)
  def worker_clock = builder.input(top, "worker_clock", Clock)
  def response_clock = builder.input(top, "response_clock", Clock)
  def data = builder.input(top, "data", Bits(1))
  def worker = builder.instance(top, child, "worker")
  builder.drive(worker.input("clock"), worker_clock)
  builder.drive(worker.input("data"), data)
  def response = builder.instance(top, child, "response")
  builder.drive(response.input("clock"), response_clock)
  builder.drive(response.input("data"), data)
  builder.finish(top)
  verify_design(design)

  def elaboration = DesignElaboration(design, top)
  def environment = TemporalEnvironment(
    [TopInputContract(data, [], SynchronousInputTiming(source_clock))],
    [AsynchronousClockRelationship(source_clock, worker_clock),
     AsynchronousClockRelationship(source_clock, response_clock)]
  )
  def summary = summarize_design_temporal(elaboration, environment)
  def report = dump_design_temporal_report(summary)
  check:
    summary.cdc_violations.length() ~is 2
    summary.cdc_violations[0].instance_path[0] === worker.operation ~is #true
    summary.cdc_violations[1].instance_path[0] === response.operation ~is #true
    report.contains("worker.state.next: asynchronous_clock") ~is #true
    report.contains("response.state.next: asynchronous_clock") ~is #true
    verify_design_cdc(elaboration, environment) ~throws "2 CDC violations"

block:
  def design = Design()
  def builder = Builder(design)
  def top = builder.module("OneSynchronizerFanout")
  def clock = builder.input(top, "clock", Clock)
  def asynchronous_level = builder.input(top, "asynchronous_level", Bits(1))
  let [synchronized, _evidence] = add_sync_level(builder,
                                                 top,
                                                 "level",
                                                 asynchronous_level,
                                                 clock)
  def sampled = builder.register(top, "sampled", Bits(1), clock)
  builder.drive(sampled.next,
                builder.bit_xor(top, synchronized, synchronized))
  builder.finish(top)
  verify_design(design)
  def summary = verify_design_cdc(
    DesignElaboration(design, top),
    TemporalEnvironment(
      [TopInputContract(asynchronous_level, [], AsynchronousInputTiming())]
    )
  )
  check:
    summary.reconvergences.length() ~is 0

block:
  def design = Design()
  def builder = Builder(design)
  def top = builder.module("IndependentControlsReconverge")
  def clock = builder.input(top, "clock", Clock)
  def asynchronous_left = builder.input(top, "asynchronous_left", Bits(1))
  def asynchronous_right = builder.input(top, "asynchronous_right", Bits(1))
  let [left, _left_evidence] = add_sync_level(builder,
                                              top,
                                              "left",
                                              asynchronous_left,
                                              clock)
  let [right, _right_evidence] = add_sync_level(builder,
                                                top,
                                                "right",
                                                asynchronous_right,
                                                clock)
  def sampled = builder.register(top, "sampled", Bits(1), clock)
  builder.drive(sampled.next, builder.bit_xor(top, left, right))
  builder.finish(top)
  verify_design(design)
  def summary = verify_design_cdc(
    DesignElaboration(design, top),
    TemporalEnvironment(
      [TopInputContract(asynchronous_left, [], AsynchronousInputTiming()),
       TopInputContract(asynchronous_right, [], AsynchronousInputTiming())]
    )
  )
  check:
    summary.reconvergences.length() ~is 1
