#lang rhombus
// Checks clock-analysis summaries, reset inventory, aliases, and one-clock certification.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/analysis/clocking.rhm" open

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("CombinationalOnly")
  builder.input(module_def, "value", Bits(1))
  builder.finish(module_def)
  def summary = summarize_module_clocking(module_def)
  check:
    summary is_a Combinational ~is #true
    summary.reset_uses ~is []
    verify_design(design) ~is #void

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("ClockedEffects")
  def clock = builder.input(module_def, "clock", Clock)
  def reset = builder.input(module_def, "reset", Reset)
  def local_reset = builder.input(module_def, "local_reset", Reset)
  def address = builder.input(module_def, "address", Bits(2))
  def data = builder.input(module_def, "data", Bits(8))
  def enable = builder.input(module_def, "enable", Bits(1))
  def zero = builder.constant(module_def, Bits(8), 0, "zero")
  def resetless = builder.register(module_def, "resetless", Bits(8), clock)
  def ambient = builder.register(module_def, "ambient", Bits(8), clock, reset, zero)
  def local = builder.register(module_def, "local", Bits(8), clock, local_reset, zero)
  builder.drive(resetless.next, resetless.current)
  builder.drive(ambient.next, ambient.current)
  builder.drive(local.next, local.current)
  def memory = builder.memory(module_def, "memory", 4, Bits(8))
  builder.memory_write(module_def, memory, address, data, clock, enable)
  def sync_memory = builder.sync_memory(module_def,
                                        "sync_memory",
                                        4,
                                        Bits(8),
                                        clock,
                                        #true,
                                        #false)
  builder.drive(sync_memory.read_port.address, address)
  builder.drive(sync_memory.read_port.enable, enable)
  builder.assert(module_def, enable, clock, local_reset, enable)
  builder.finish(module_def)
  def summary = summarize_module_clocking(module_def, reset)
  def no_reset = summary.reset_uses.find(fun (use): use is_a NoReset)
  def ambient_reset = summary.reset_uses.find(fun (use): use is_a AmbientReset)
  def local_reset_use = summary.reset_uses.find(fun (use): use is_a LocalReset)
  check:
    summary is_a SingleClock ~is #true
    summary.clock === clock ~is #true
    summary.clocked_operations.map(fun (operation): operation.opcode) ~is [
      "rtl.register",
      "rtl.register_reset",
      "rtl.register_reset",
      "rtl.memory_write",
      "rtl.sync_memory",
      "verif.assert"
    ]
    no_reset.operations.length() ~is 3
    ambient_reset.reset === reset ~is #true
    ambient_reset.operations.length() ~is 1
    local_reset_use.reset === local_reset ~is #true
    local_reset_use.operations.length() ~is 2
    verify_single_clock(module_def, clock, reset) is_a SingleClock ~is #true
    verify_design(design) ~is #void

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("MultipleClocks")
  def clock = builder.input(module_def, "clock", Clock)
  def other_clock = builder.input(module_def, "other_clock", Clock)
  def first = builder.register(module_def, "first", Bits(1), clock)
  def second = builder.register(module_def, "second", Bits(1), other_clock)
  builder.drive(first.next, first.current)
  builder.drive(second.next, second.current)
  builder.finish(module_def)
  def summary = summarize_module_clocking(module_def)
  check:
    summary is_a MultiClock ~is #true
    summary.clock_groups.length() ~is 2
    verify_single_clock(module_def, clock) ~throws "uses clock %other_clock instead of expected clock %clock"
    verify_design(design) ~is #void

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("WireClockAlias")
  def clock = builder.input(module_def, "clock", Clock)
  def clock_alias = builder.wire(module_def, "clock_alias", Clock)
  builder.drive(clock_alias, clock)
  def state = builder.register(module_def,
                               "state",
                               Bits(1),
                               builder.read(clock_alias))
  builder.drive(state.next, state.current)
  builder.finish(module_def)
  def summary = summarize_module_clocking(module_def)
  check:
    summary is_a SingleClock ~is #true
    summary.clock === clock ~is #true
    verify_single_clock(module_def, clock) is_a SingleClock ~is #true
    verify_design(design) ~is #void

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("CastClock")
  def clock = builder.input(module_def, "clock", Clock)
  def bits = builder.input(module_def, "bits", Bits(1))
  def cast_clock = builder.cast(module_def, bits, Clock, "cast_clock")
  def state = builder.register(module_def, "state", Bits(1), cast_clock)
  builder.drive(state.next, state.current)
  builder.finish(module_def)
  check:
    summarize_module_clocking(module_def).clock === cast_clock ~is #true
    verify_single_clock(module_def, clock) ~throws "uses clock %cast_clock instead of expected clock %clock"
    verify_design(design) ~is #void
