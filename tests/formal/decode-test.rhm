#lang rhombus
// Checks fully cared decode equivalence, counterexamples, aggregates, and fail-closed output freedom.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/formal/main.rhm" open

fun flat_decode_module(name, cases, default_value = 0b111, default_care = 0b111):
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module(name)
  def selector = builder.input(module_def, "selector", Bits(3))
  def result = builder.output(module_def, "result", Bits(3))
  def decoded:
    builder.decode(module_def,
                   selector,
                   Bits(3),
                   Bits(3),
                   cases,
                   default_value,
                   default_care)
  builder.drive(result, decoded)
  builder.finish(module_def)

def reference_cases = [[0b000, 0b011, 0b001, 0b111],
                       [0b001, 0b011, 0b010, 0b111]]
def reordered_cases = [[0b001, 0b011, 0b010, 0b111],
                       [0b000, 0b011, 0b001, 0b111]]
def defective_cases = [[0b000, 0b011, 0b011, 0b111],
                       [0b001, 0b011, 0b010, 0b111]]
def reference = flat_decode_module("DecodeReference", reference_cases)
def reordered = flat_decode_module("DecodeReordered", reordered_cases)
def defective = flat_decode_module("DecodeDefective", defective_cases)
def equivalent_result = check_equivalent(reference, reordered)
def counterexample_result = check_equivalent(reference, defective)

def decode_record_type = RecordType([RecordField("tag", Bits(2)),
                                     RecordField("payload", Bits(3))])
def decode_vector_type = VectorType(3, Bits(2))

fun aggregate_decode_module(name, cases):
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module(name)
  def selector = builder.input(module_def, "selector", decode_record_type)
  def result = builder.output(module_def, "result", decode_vector_type)
  def decoded:
    builder.decode(module_def,
                   selector,
                   decode_record_type,
                   decode_vector_type,
                   cases,
                   0b111111,
                   0b111111)
  builder.drive(result, decoded)
  builder.finish(module_def)

def aggregate_cases = [[0b00000, 0b11000, 0b000110, 0b111111],
                       [0b01000, 0b11000, 0b111000, 0b111111]]
def aggregate_reordered_cases = [[0b01000, 0b11000, 0b111000, 0b111111],
                                 [0b00000, 0b11000, 0b000110, 0b111111]]
def aggregate_result:
  check_equivalent(aggregate_decode_module("AggregateDecode", aggregate_cases),
                   aggregate_decode_module("AggregateDecodeReordered",
                                           aggregate_reordered_cases))

def partially_cared:
  flat_decode_module("PartialDecode",
                     [[0b000, 0b111, 0b000, 0b110]],
                     0b000,
                     0b111)
def unsupported_result = check_equivalent(partially_cared, partially_cared)

check:
  equivalent_result.equivalent() ~is #true
  counterexample_result.counterexample() ~is #true
  counterexample_result.assignments.length() ~is 1
  counterexample_result.differences.length() ~is 1
  aggregate_result.equivalent() ~is #true
  unsupported_result.unsupported() ~is #true
  unsupported_result.diagnostic.opcode ~is "rtl.decode"
  unsupported_result.diagnostic.message.contains("every output bit is cared") ~is #true
