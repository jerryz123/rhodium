#lang rhombus
// Proves differential identities and prints replayable Rosette counterexample vectors.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/formal/main.rhm" open
  "differential-fixture.rhm" as fixture

fun require_equivalent(label, left, right, query = FormalQuery()):
  def result = check_equivalent(left, right, query)
  unless result.equivalent()
  | error(~who: #'replay_models, label ++ " did not prove equivalent: " ++ result.describe())

fun require_counterexample(label, left, right, query = FormalQuery()):
  def result = check_equivalent(left, right, query)
  unless result.counterexample()
  | error(~who: #'replay_models,
          label ++ " did not produce a counterexample: " ++ result.describe())
  result

fun require_reachable(label, subject, target, query = FormalQuery()):
  def result = check_reachable(subject, target, query)
  unless result.reachable()
  | error(~who: #'replay_models,
          label ++ " did not produce a reachability witness: " ++ result.describe())
  result

fun require_property_proved(label, subject, target, query = FormalQuery()):
  def result = check_output_property(subject, target, query)
  unless result.proved()
  | error(~who: #'replay_models,
          label ++ " did not prove: " ++ result.describe())

fun require_property_counterexample(label, subject, target,
                                    query = FormalQuery()):
  def result = check_output_property(subject, target, query)
  unless result.counterexample()
  | error(~who: #'replay_models,
          label ++ " did not produce a property counterexample: " ++ result.describe())
  result

fun assignment(result, port):
  def found = result.assignments.find(fun (candidate): candidate.port == port)
  unless found
  | error(~who: #'replay_models, "counterexample omitted input " ++ port)
  found.packed_value

fun difference(result, port):
  def found = result.differences.find(fun (candidate): candidate.port == port)
  unless found
  | error(~who: #'replay_models, "counterexample omitted differing output " ++ port)
  found

fun emit(name, value):
  print(name ++ "=" ++ to_string(value) ++ "\n")

require_equivalent("unequal-width shift", fixture.shift_reference, fixture.shift_candidate)
require_equivalent("aggregate layout", fixture.aggregate_reference, fixture.aggregate_candidate)
require_equivalent("hierarchy", fixture.hierarchy_reference, fixture.hierarchy_candidate)
require_equivalent("fully cared decode", fixture.decode_reference, fixture.decode_candidate)
def onehot_query = FormalQuery([FormalOneHotAssumption("selector")])
require_equivalent("one-hot selection",
                   fixture.onehot_reference,
                   fixture.onehot_candidate,
                   onehot_query)

def shift_result:
  require_counterexample("shift defect", fixture.shift_reference, fixture.shift_defect)
def shift_difference = difference(shift_result, "left")
emit("SHIFT_VALUE", assignment(shift_result, "value"))
emit("SHIFT_AMOUNT", assignment(shift_result, "amount"))
emit("SHIFT_REFERENCE", shift_difference.left_value)
emit("SHIFT_DEFECT", shift_difference.right_value)

def aggregate_result:
  require_counterexample("aggregate defect",
                         fixture.aggregate_reference,
                         fixture.aggregate_defect)
def aggregate_difference = difference(aggregate_result, "record_bits")
emit("RECORD_HIGH", assignment(aggregate_result, "high"))
emit("RECORD_LOW", assignment(aggregate_result, "low"))
emit("RECORD_REFERENCE", aggregate_difference.left_value)
emit("RECORD_DEFECT", aggregate_difference.right_value)

def hierarchy_result:
  require_counterexample("hierarchy defect",
                         fixture.hierarchy_reference,
                         fixture.hierarchy_defect)
def hierarchy_difference = difference(hierarchy_result, "difference")
emit("PAIR_LEFT", assignment(hierarchy_result, "left"))
emit("PAIR_RIGHT", assignment(hierarchy_result, "right"))
emit("PAIR_REFERENCE", hierarchy_difference.left_value)
emit("PAIR_DEFECT", hierarchy_difference.right_value)

def decode_result:
  require_counterexample("decode defect", fixture.decode_reference, fixture.decode_defect)
def decode_difference = difference(decode_result, "result")
emit("DECODE_SELECTOR", assignment(decode_result, "selector"))
emit("DECODE_REFERENCE", decode_difference.left_value)
emit("DECODE_DEFECT", decode_difference.right_value)

def onehot_result:
  require_counterexample("one-hot defect",
                         fixture.onehot_reference,
                         fixture.onehot_defect,
                         onehot_query)
def onehot_difference = difference(onehot_result, "result")
emit("ONEHOT_SELECTOR", assignment(onehot_result, "selector"))
emit("ONEHOT_A", assignment(onehot_result, "a"))
emit("ONEHOT_B", assignment(onehot_result, "b"))
emit("ONEHOT_C", assignment(onehot_result, "c"))
emit("ONEHOT_REFERENCE", onehot_difference.left_value)
emit("ONEHOT_DEFECT", onehot_difference.right_value)

def reachability_result:
  require_reachable("one-hot output",
                    fixture.onehot_candidate,
                    FormalOutputPattern("result", 7),
                    onehot_query)
emit("REACH_SELECTOR", assignment(reachability_result, "selector"))
emit("REACH_A", assignment(reachability_result, "a"))
emit("REACH_B", assignment(reachability_result, "b"))
emit("REACH_C", assignment(reachability_result, "c"))
emit("REACH_OUTPUT", reachability_result.output.packed_value)

require_property_proved(
  "fixed one-hot output",
  fixture.onehot_candidate,
  FormalOutputPattern("result", 7),
  FormalQuery([FormalOneHotAssumption("selector"),
               FormalInputAssumption("a", 7),
               FormalInputAssumption("b", 7),
               FormalInputAssumption("c", 7)]))
def property_result:
  require_property_counterexample("unconstrained one-hot output",
                                  fixture.onehot_candidate,
                                  FormalOutputPattern("result", 7),
                                  onehot_query)
emit("PROPERTY_SELECTOR", assignment(property_result, "selector"))
emit("PROPERTY_A", assignment(property_result, "a"))
emit("PROPERTY_B", assignment(property_result, "b"))
emit("PROPERTY_C", assignment(property_result, "c"))
emit("PROPERTY_OUTPUT", property_result.output.packed_value)
