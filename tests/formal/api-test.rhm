#lang rhombus
// Checks the public formal API for equivalence, counterexamples, and fail-closed results.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/formal/main.rhm" open

fun binary_module(name, opcode):
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module(name)
  def a = builder.input(module_def, "a", Bits(4))
  def b = builder.input(module_def, "b", Bits(4))
  def result = builder.output(module_def, "result", Bits(4))
  def value:
    match opcode
    | "add": builder.add(module_def, a, b)
    | "add-reversed": builder.add(module_def, b, a)
    | "sub": builder.sub(module_def, a, b)
  builder.drive(result, value)
  builder.finish(module_def)

def add = binary_module("Add", "add")
def add_reversed = binary_module("AddReversed", "add-reversed")
def subtract = binary_module("Subtract", "sub")
def equivalent_result = check_equivalent(add, add_reversed)
def elaboration_result:
  check_equivalent(DesignElaboration(add.design, add),
                   DesignElaboration(add_reversed.design, add_reversed))
def counterexample_result = check_equivalent(add, subtract)

def free_design = Design()
def free_builder = Builder(free_design)
def free_module = free_builder.module("Free")
def free_output = free_builder.output(free_module, "result", Bits(4))
free_builder.drive(free_output, free_builder.dont_care(free_module, Bits(4)))
def finished_free = free_builder.finish(free_module)
def unsupported_result = check_equivalent(finished_free, finished_free)

def narrow_design = Design()
def narrow_builder = Builder(narrow_design)
def narrow_module = narrow_builder.module("Narrow")
def narrow_a = narrow_builder.input(narrow_module, "a", Bits(3))
def narrow_b = narrow_builder.input(narrow_module, "b", Bits(3))
def narrow_result = narrow_builder.output(narrow_module, "result", Bits(3))
narrow_builder.drive(narrow_result, narrow_builder.add(narrow_module, narrow_a, narrow_b))
def finished_narrow = narrow_builder.finish(narrow_module)
def type_result = check_equivalent(add, finished_narrow)
def unknown_result:
  FormalResult("unknown", [], [],
               FormalDiagnostic("Synthetic", #false, #false, #false, #false,
                                "solver returned unknown"))

check:
  equivalent_result.equivalent() ~is #true
  elaboration_result.equivalent() ~is #true
  equivalent_result.describe() ~is "equivalent"
  counterexample_result.counterexample() ~is #true
  counterexample_result.assignments.length() ~is 2
  counterexample_result.differences.length() ~is 1
  counterexample_result.differences[0].left_value != counterexample_result.differences[0].right_value ~is #true
  unsupported_result.unsupported() ~is #true
  unsupported_result.diagnostic.opcode ~is "rtl.dont_care"
  unsupported_result.diagnostic.operation_id is_a Int ~is #true
  unsupported_result.diagnostic.location is_a String ~is #true
  unsupported_result.diagnostic.origin is_a String ~is #true
  type_result.unsupported() ~is #true
  type_result.diagnostic.message.contains("different Rhodium types") ~is #true
  unknown_result.unknown() ~is #true
  unknown_result.describe().contains("solver returned unknown") ~is #true
  check_equivalent(add.design, add_reversed.design) ~throws "must identify an explicit top module"
