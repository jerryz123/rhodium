#lang rhombus
// Checks record and vector packing, projection, equivalence, and aggregate counterexamples.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/formal/main.rhm" open

fun aggregate_module(name, implementation):
  def design = Design()
  def builder = Builder(design)
  def top = builder.module(name)
  def high = builder.input(top, "high", Bits(2))
  def low = builder.input(top, "low", Bits(2))
  def element0 = builder.input(top, "element0", Bits(2))
  def element1 = builder.input(top, "element1", Bits(2))
  def element2 = builder.input(top, "element2", Bits(2))
  def record_bits = builder.output(top, "record_bits", Bits(4))
  def record_high = builder.output(top, "record_high", Bits(2))
  def vector_bits = builder.output(top, "vector_bits", Bits(6))
  def vector_one = builder.output(top, "vector_one", Bits(2))
  cond
  | implementation == "direct":
      builder.drive(record_bits, builder.concat(top, [high, low]))
      builder.drive(record_high, high)
      builder.drive(vector_bits, builder.concat(top, [element2, element1, element0]))
      builder.drive(vector_one, element1)
  | implementation == "aggregate" || implementation == "defect":
      def record_type = RecordType([RecordField("high", Bits(2)),
                                    RecordField("low", Bits(2))])
      def vector_type = VectorType(3, Bits(2))
      def record_value:
        builder.record_create(
          top,
          record_type,
          if implementation == "defect"
          | [["high", low], ["low", high]]
          | [["high", high], ["low", low]]
        )
      def vector_value:
        builder.vector_create(
          top,
          vector_type,
          if implementation == "defect"
          | [element2, element1, element0]
          | [element0, element1, element2]
        )
      builder.drive(record_bits, builder.cast(top, record_value, Bits(4)))
      builder.drive(record_high, builder.record_get(top, record_value, "high"))
      builder.drive(vector_bits, builder.cast(top, vector_value, Bits(6)))
      builder.drive(vector_one, builder.vector_get(top, vector_value, 1))
  builder.finish(top)

def direct = aggregate_module("DirectAggregates", "direct")
def aggregate = aggregate_module("AggregateOperations", "aggregate")
def defect = aggregate_module("DefectiveAggregates", "defect")
def equivalent_result = check_equivalent(direct, aggregate)
def defect_result = check_equivalent(direct, defect)

check:
  equivalent_result.equivalent() ~is #true
  defect_result.counterexample() ~is #true
  defect_result.differences.length() > 0 ~is #true
