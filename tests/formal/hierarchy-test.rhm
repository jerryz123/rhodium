#lang rhombus
// Checks compositional formal interpretation across repeated and nested module instances.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/formal/main.rhm" open

fun direct_module():
  def design = Design()
  def builder = Builder(design)
  def top = builder.module("DirectPairOps")
  def a = builder.input(top, "a", Bits(4))
  def b = builder.input(top, "b", Bits(4))
  def c = builder.input(top, "c", Bits(4))
  def d = builder.input(top, "d", Bits(4))
  def sum0 = builder.output(top, "sum0", Bits(4))
  def difference0 = builder.output(top, "difference0", Bits(4))
  def sum1 = builder.output(top, "sum1", Bits(4))
  def difference1 = builder.output(top, "difference1", Bits(4))
  builder.drive(sum0, builder.add(top, a, b))
  builder.drive(difference0, builder.sub(top, a, b))
  builder.drive(sum1, builder.add(top, c, d))
  builder.drive(difference1, builder.sub(top, c, d))
  builder.finish(top)

fun hierarchical_module(swap_second):
  def design = Design()
  def builder = Builder(design)

  def leaf = builder.module("PairOpsLeaf")
  def leaf_left = builder.input(leaf, "left", Bits(4))
  def leaf_right = builder.input(leaf, "right", Bits(4))
  def leaf_sum = builder.output(leaf, "sum", Bits(4))
  def leaf_difference = builder.output(leaf, "difference", Bits(4))
  builder.drive(leaf_sum, builder.add(leaf, leaf_left, leaf_right))
  builder.drive(leaf_difference, builder.sub(leaf, leaf_left, leaf_right))
  builder.finish(leaf)

  def wrapper = builder.module("PairOpsWrapper")
  def wrapper_left = builder.input(wrapper, "left", Bits(4))
  def wrapper_right = builder.input(wrapper, "right", Bits(4))
  def wrapper_sum = builder.output(wrapper, "sum", Bits(4))
  def wrapper_difference = builder.output(wrapper, "difference", Bits(4))
  def inner = builder.instance(wrapper, leaf, "inner")
  builder.drive(inner.input("left"), wrapper_left)
  builder.drive(inner.input("right"), wrapper_right)
  builder.drive(wrapper_sum, inner.output("sum"))
  builder.drive(wrapper_difference, inner.output("difference"))
  builder.finish(wrapper)

  def top = builder.module("HierarchicalPairOps")
  def a = builder.input(top, "a", Bits(4))
  def b = builder.input(top, "b", Bits(4))
  def c = builder.input(top, "c", Bits(4))
  def d = builder.input(top, "d", Bits(4))
  def sum0 = builder.output(top, "sum0", Bits(4))
  def difference0 = builder.output(top, "difference0", Bits(4))
  def sum1 = builder.output(top, "sum1", Bits(4))
  def difference1 = builder.output(top, "difference1", Bits(4))
  def first = builder.instance(top, wrapper, "first")
  def second = builder.instance(top, wrapper, "second")
  builder.drive(first.input("left"), a)
  builder.drive(first.input("right"), b)
  builder.drive(second.input("left"), if swap_second | d | c)
  builder.drive(second.input("right"), if swap_second | c | d)
  builder.drive(sum0, first.output("sum"))
  builder.drive(difference0, first.output("difference"))
  builder.drive(sum1, second.output("sum"))
  builder.drive(difference1, second.output("difference"))
  builder.finish(top)

def direct = direct_module()
def hierarchical = hierarchical_module(#false)
def swapped = hierarchical_module(#true)
def equivalent_result = check_equivalent(direct, hierarchical)
def swapped_result = check_equivalent(direct, swapped)

check:
  equivalent_result.equivalent() ~is #true
  swapped_result.counterexample() ~is #true
  swapped_result.assignments.length() ~is 4
  swapped_result.differences.find(fun (difference): difference.port == "difference1") is_a FormalDifference ~is #true
