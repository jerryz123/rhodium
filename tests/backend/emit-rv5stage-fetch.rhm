#lang rhombus
// Emits CIRCT IR for RV5Stage compressed instruction fetch assembly.

import:
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../riscv/isa/c.rhm" open
  "../../riscv/isa/fp-profile.rhm" open
  "../../riscv/isa/xlen.rhm" open
  "../../cores/rv5stage/fetch.rhdl" open
  "../../cores/rv5stage/decode/core-ctrl.rhdl".rv5stage_instructions

def supported_instruction_names = rv5stage_instructions(
  XLen.X64, FloatingPointProfile.D, HalfPrecisionProfile.None
).map(fun (instruction): instruction.name)

def design = embedded.run_elaboration(
  fun (): RV5StageInstructionFetch(XLen.X64, FloatingPointProfile.D, ~compressed: CCompressedExtensions, ~supported_instructions: supported_instruction_names)
)
print(emit_circt(design))
