#lang rhombus
// Emits CIRCT MLIR for RV5Stage's RV64 commit-owned CSR file fixture.

import:
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../riscv/isa/c.rhm" open
  "../../riscv/isa/fp-profile.rhm" open
  "../../riscv/isa/xlen.rhm" open
  "../../cores/rv5stage/csr.rhdl" as csr
  "../../cores/rv5stage/profile.rhm" open

def design = embedded.run_elaboration(
  fun (): csr.RV5StageCsrFile(RVCoreProfile(
    ~xlen: XLen.X64,
    ~extensions: RV5StageExtensions(
      ~floating_point: FloatingPointProfile.D,
      ~zicboz: #true,
      ~compressed: CCompressedExtensions
    )
  ))
)
print(emit_circt(design))
