import:
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/isa/fp-profile.rhm" open
  "../../riscv/isa/vector-profile.rhm" open
  "../../cores/rv5stage/tests/core-fixture.rhdl" as core
  "../../cores/rv5stage/profile.rhm" open

def design = embedded.run_elaboration(fun (): core.RV5StageCoreFixture(RVCoreProfile(~xlen: XLen.X64, ~extensions: RV5StageExtensions(~floating_point: FloatingPointProfile.D), ~vector: VectorProfile.V, ~vector_length: 128), ~reset_address: 0))
print(emit_circt(design))
