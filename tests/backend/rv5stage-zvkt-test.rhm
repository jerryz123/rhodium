#lang rhombus
// Guards RV5Stage Zvkt probe coverage against changes to implemented vector catalogs.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../cores/rv5stage/tests/zvkt-program.rhm" open
  "../../riscv/isa/v.rhm".VectorVInstructions
  "../../riscv/isa/zvbb.rhm".ZvbbInstructions
  "../../riscv/isa/zvkt.rhm" open

def probes = zvkt_probes()
def names = zvkt_instruction_names()
def implemented_names = (VectorVInstructions ++ ZvbbInstructions).filter(~keep: fun (instruction): names.contains(instruction.name)).map(fun (instruction): instruction.name)
def probe_names = probes.map(fun (probe): probe.name)

check:
  implemented_names.length() ~is 163
  probe_names.length() > implemented_names.length() ~is #true
  probes.filter(~keep: fun (probe): probe.name == "VADD.VV" && probe.masked).length() ~is 1
  probes.filter(~keep: fun (probe): probe.name == "VRGATHER.VV" && probe.control_vs1).length() ~is 2
  probes.filter(~keep: fun (probe): probe.name == "VRGATHER.VX" && probe.control_rs1).length() ~is 2
  probes.filter(~keep: fun (probe): probe.name == "VSLIDE1UP.VX" && !probe.control_rs1).length() ~is 2
  probes.filter(~keep: fun (probe): probe.name == "VADC.VVM" && probe.v0_data).length() ~is 1
  probes.filter(~keep: fun (probe): probe.name == "VMERGE.VVM" && probe.v0_data).length() ~is 1
  probes.filter(~keep: fun (probe): probe.name == "VMADC.VV" && probe.v0_data).length() ~is 0

for (name in implemented_names):
  check:
    probe_names.contains(name) ~is #true
