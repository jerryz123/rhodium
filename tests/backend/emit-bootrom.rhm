#lang rhombus
// Emits CIRCT MLIR for the standalone multihart-aware CHI BootROM fixture.

import:
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../chi/main.rhdl" as chi
  "../../devices/bootrom.rhdl" as bootrom

def design = embedded.run_elaboration(
  fun (): bootrom.CHIBootROM(
    bootrom.CHIBootROMConfig(
      bootrom.CHIBootROMLayout(chi.CHIFlitParams(), ~window_bytes: 64)
    )
  )
)
print(emit_circt(design))
