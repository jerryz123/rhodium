#lang rhombus
// Emits CIRCT MLIR for the RV32 specialization of RV5Stage's core.

import:
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../riscv/isa/xlen.rhm" open
  "../../cores/rv5stage/tests/core-fixture.rhdl" as core
  "../../cores/rv5stage/profile.rhm".RVCoreProfile

def design = embedded.run_elaboration(fun (): core.RV5StageCoreFixture(RVCoreProfile(~xlen: XLen.X32), ~reset_address: 0))
print(emit_circt(design))
