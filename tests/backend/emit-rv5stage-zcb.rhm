#lang rhombus
// Emits CIRCT MLIR for an RV64 RV5Stage core with composed Zca and Zcb support.

import:
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../riscv/isa/c.rhm" open
  "../../riscv/isa/xlen.rhm" open
  "../../cores/rv5stage/core.rhdl" as core
  "../../cores/rv5stage/profile.rhm" open

def zcb_extensions = compressed_extensions(CompressedExtension.Zca, CompressedExtension.Zcb)
def design = embedded.run_elaboration(
  fun (): core.RV5StageCore(RVCoreProfile(
    ~xlen: XLen.X64,
    ~extensions: RV5StageExtensions(~compressed: zcb_extensions)
  ))
)
print(emit_circt(design))
