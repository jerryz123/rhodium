#lang rhombus
// Emits the RV32 integer Zkt timing fixture and its catalog-generated program.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../riscv/isa/c.rhm" open
  "../../riscv/isa/xlen.rhm" open
  "../../riscv/isa/fp-profile.rhm" open
  "../../cores/rv5stage/profile.rhm" open
  "../../cores/rv5stage/tests/zkt.rhdl" open

def profile = RVCoreProfile(
  ~xlen: XLen.X32,
  ~extensions: RV5StageExtensions(
    ~floating_point: FloatingPointProfile.None,
    ~compressed: compressed_extensions(CompressedExtension.C, CompressedExtension.Zcb)
  )
)
print(emit_circt(embedded.run_elaboration(fun (): RV5StageZkt(profile))))
