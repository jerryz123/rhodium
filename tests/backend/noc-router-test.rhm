#lang rhombus
// Checks that the buffered simple router lowers through CIRCT deterministically.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/backend/circt.rhm" open
  "../../examples/noc/noc-router.rhdl" as fixture

def circt = emit_circt(fixture.design)

check:
  circt.contains("hw.module @SimpleRouterFixture") ~is #true
  circt.contains("hw.module @SimpleRouter") ~is #true
  circt.contains("hw.module @Queue") ~is #true
  circt.contains("hw.module @RouterAllocator") ~is #true
  circt.contains("hw.module @OutputGreedyRoundRobinMatcher") ~is #true
  circt.contains("hw.module @GrantDemux") ~is #true
  circt.contains("hw.module @GrantMerge") ~is #true
  circt.contains("hw.module @GrantCrossbar") ~is #true
  circt.contains("seq.firreg") ~is #true
  circt.contains("verif.clocked_assert") ~is #true
  circt.contains("comb.icmp eq") ~is #true
  circt.contains("comb.mux") ~is #true
  circt.contains("rtl.decode") ~is #false
  circt ~is emit_circt(fixture.design)
