#lang rhombus
// Emits compressed fetch with a small trained BTB for predicted-stream behavioral tests.
// SPDX-License-Identifier: Apache-2.0
import:
  "../../cores/rv5stage/profile.rhm" open
  "../../rhodium/backend/circt.rhm".emit_circt
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../riscv/isa/c.rhm".CCompressedExtensions
  "../../riscv/isa/fp-profile.rhm" open
  "../../riscv/isa/xlen.rhm".XLen
  "../../cores/rv5stage/tests/fetch-fixture.rhdl".RV5StageFetchFixture
print(emit_circt(embedded.run_elaboration(fun (): RV5StageFetchFixture(RVCoreProfile(~xlen: XLen.X64, ~extensions: RV5StageExtensions(~floating_point: FloatingPointProfile.D, ~compressed: CCompressedExtensions)), ~btb_entries: 4))))
