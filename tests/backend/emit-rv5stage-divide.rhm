#lang rhombus
// Emits CIRCT MLIR for RV5Stage's commit-issued integer-division fixture.

import:
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../riscv/isa/xlen.rhm" open
  "../../cores/rv5stage/tests/core-fixture.rhdl" as core
  "../../cores/rv5stage/profile.rhm".RVCoreProfile

def design = embedded.run_elaboration(fun (): core.RV5StageCoreFixture(RVCoreProfile(~xlen: XLen.X64), ~reset_address: 0x100000000))
print(emit_circt(design))
