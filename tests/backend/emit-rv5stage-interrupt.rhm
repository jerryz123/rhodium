#lang rhombus
// Emits CIRCT MLIR for RV5Stage's precise core-interrupt fixture.

import:
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../riscv/isa/xlen.rhm" open
  "../../cores/rv5stage/core.rhdl" as core
  "../../cores/rv5stage/profile.rhm".RVCoreProfile

def design = embedded.run_elaboration(fun (): core.RV5StageCore(RVCoreProfile(~xlen: XLen.X64), ~reset_address: 0))
print(emit_circt(design))
