#lang rhombus
// Emits the reusable retryable CHI cache-maintenance requester.

import:
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/core/types.rhm".Bits
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../chi/cache-maintenance.rhdl" open
  "../../chi/params.rhdl".CHIFlitParams

def design = embedded.run_elaboration(fun (): CHICacheMaintenance(CHIFlitParams(), Bits(8)))
print(emit_circt(design))
