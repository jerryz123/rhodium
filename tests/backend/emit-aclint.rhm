import:
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../chi/main.rhdl" as chi
  "../../devices/aclint.rhdl" as aclint

def design = embedded.run_elaboration(fun (): aclint.Aclint(aclint.AclintConfig(chi.CHIFlitParams(), 2)))
print(emit_circt(design))
