#lang rhombus
// Emits fetch candidate selection and held-cursor instrumentation with its descriptor.
// SPDX-License-Identifier: Apache-2.0
import:
  "../../cores/rv5stage/tests/fetch-source-trace-fixture.rhdl".traced_fetch_source
  "../../rhodium/backend/circt.rhm".emit_circt
  "../../rhodium/event/main.rhm" open
def traced = instrument_events(traced_fetch_source, EventInstrumentationConfig(~partial: #true))
def site_constants = for List (site in traced.manifest.sites, index in 0..traced.manifest.sites.length()):
  "inline constexpr unsigned " ++ site.label.replace("/", "_").replace(".", "_") ++ " = " ++ to_string(index) ++ ";\n"
def event_manifest_cpp = event_manifest_to_cpp(traced.manifest) ++ "\nnamespace test_sites {\n" ++ String.join(site_constants, "") ++ "}\n"
export event_manifest_cpp
print(emit_circt(traced.instrumented.design))
