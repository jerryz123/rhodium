#lang rhombus
// Emits DPI-independent RV32 FESVR startup with a relocated boot-register service.

import:
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../chi/main.rhdl" open
  "../../riscv/rtl/pma.rhdl" open
  "../../riscv/isa/xlen.rhm".XLen
  "../../socs/endpoint-params.rhdl".soc_host_node
  "../../sims/fesvr/direct-memory-htif.rhdl".FesvrBootAccess

def p = CHIFlitParams()
def home = CHIHomeParams("devices", 6, CHINodeKind.HNI, ~max_outstanding: 1)
def region = AddressSet(0x3000, 7)
def service = CHIHomeServiceParams(home, [region], [
  CHIRequestSupport(CHIReqOpcode.ReadNoSnp, TransferSizes(4, 8)),
  CHIRequestSupport(CHIReqOpcode.WriteNoSnpPtl, TransferSizes(4, 8))
])
def design = embedded.run_elaboration(
  fun ():
    FesvrBootAccess(
      XLen.X32,
      p,
      soc_host_node(1),
      CHIHomeMap(p, [CHIHomeMapEntry(region, home)]),
      RiscvPhysicalMemoryMap(p.request_address_width, [
        RiscvPhysicalMemoryRegion(region, RiscvPhysicalMemoryAttributes(#true, #true, #false, #false, #false, #true, #true))
      ]),
      [service],
      0x3000
    )
)
print(emit_circt(design))
