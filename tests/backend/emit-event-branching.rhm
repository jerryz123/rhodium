#lang rhombus
// Emits queued crossbar feedback RTL and descriptor-resolved indices for both traced lanes.
// SPDX-License-Identifier: Apache-2.0
import:
  "../frontend/event-feedback-fixture.rhdl".branching
  "../../rhodium/event/main.rhm" open
  "../../rhodium/backend/circt.rhm".emit_circt
def traced = instrument_events(branching)
def indices = for List (lane in ["direct", "configured"]):
  def sites = for List (label in ["start0", "start1", "finish0", "finish1"]):
    def matches = (for List (index in 0..traced.manifest.sites.length()): index).filter(~keep: fun (index): traced.manifest.sites[index].label == label && traced.manifest.sites[index].id.contains("/" ++ lane ++ "/"))
    unless matches.length() == 1 | error("expected one branching site: " ++ lane ++ "/" ++ label)
    to_string(matches[0])
  "{" ++ String.join(sites, ",") ++ "}"
def event_manifest_cpp = event_manifest_to_cpp(traced.manifest) ++ "\nconstexpr unsigned branching_sites[2][4] = {" ++ String.join(indices, ",") ++ "};\n"
export event_manifest_cpp
print(emit_circt(traced.instrumented.design))
