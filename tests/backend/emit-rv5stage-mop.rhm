#lang rhombus
// Emits CIRCT MLIR for an RV64 RV5Stage core with Zimop and Zcmop support.

import:
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../riscv/isa/c.rhm" open
  "../../riscv/isa/xlen.rhm" open
  "../../cores/rv5stage/tests/core-fixture.rhdl" as core
  "../../cores/rv5stage/profile.rhm" open

def extensions = compressed_extensions(CompressedExtension.Zca, CompressedExtension.Zcmop)
def design = embedded.run_elaboration(
  fun (): core.RV5StageCoreFixture(RVCoreProfile(
    ~xlen: XLen.X64,
    ~extensions: RV5StageExtensions(~compressed: extensions)
  ), ~reset_address: 0x100000000)
)
print(emit_circt(design))
