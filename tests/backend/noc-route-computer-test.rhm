#lang rhombus
// Checks that router-local validated route tables lower into sparse CaseZ relations.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/backend/circt.rhm" open
  "../../examples/noc/noc-route-computer.rhdl" as fixture

def circt = emit_circt(fixture.design)

check:
  circt.contains("hw.module @RouteComputerFixture") ~is #true
  circt.contains("in %source_route_key : i1") ~is #true
  circt.contains("out source_target_mask : i2") ~is #true
  circt.contains("out source_fallback_mask : i2") ~is #true
  circt.contains("in %middle_origin_key : i1") ~is #true
  circt.contains("out middle_target_mask : i2") ~is #true
  circt.contains("out middle_fallback_mask : i2") ~is #true
  circt.contains("in %destination_origin_key : i1") ~is #true
  circt.contains("out destination_target_mask : i1") ~is #true
  circt.contains("out destination_fallback_mask : i1") ~is #true
  circt.contains("rtl.decode") ~is #false
  circt.contains("sv.case casez") ~is #true
  circt.contains("sv.logic") ~is #true
  circt.contains("comb.icmp eq") ~is #false
  circt.contains("comb.mux") ~is #false
  circt ~is emit_circt(fixture.design)
