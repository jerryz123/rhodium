import:
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../riscv/isa/xlen.rhm" open
  "../../cores/rv5stage/tests/core-fixture.rhdl" as core
  "../../cores/rv5stage/profile.rhm" open

def design = embedded.run_elaboration(fun (): core.RV5StageCoreFixture(RVCoreProfile(~xlen: XLen.X64, ~extensions: RV5StageExtensions(~zawrs: #true)), ~reset_address: 0))
print(emit_circt(design))
