#lang rhombus
// Guards timing-ROM coverage against omissions when implemented instruction catalogs change.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../cores/rv5stage/tests/zkt-program.rhm" open
  "../../riscv/isa/c.rhm" open
  "../../riscv/isa/fp-profile.rhm" open
  "../../riscv/isa/xlen.rhm" open
  "../../cores/rv5stage/profile.rhm" open

for (xlen in [XLen.X32, XLen.X64]):
  for (fp in [FloatingPointProfile.None, if xlen == XLen.X32 | FloatingPointProfile.F | FloatingPointProfile.D]):
    def program = zkt_program(RVCoreProfile(
      ~xlen: xlen,
      ~extensions: RV5StageExtensions(~floating_point: fp, ~compressed: compressed_extensions(CompressedExtension.C, CompressedExtension.Zcb))
    ))
    check:
      program.probes.length() ~is (if xlen == XLen.X32 | 50 | 66)
      program.probes.contains("C.NOP") ~is #true
      program.probes.contains("C.MUL") ~is #true
      program.probes.contains("CZERO.EQZ") ~is #true
      program.probes.contains("CZERO.NEZ") ~is #true
    for (name in program.probes):
      check: program.probes.filter(~keep: fun (candidate): candidate == name).length() ~is 1
