import:
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../cores/multiplier.rhdl" as multiplier

def design = embedded.run_elaboration(fun (): multiplier.IterativeMultiplier(8))
print(emit_circt(design))
