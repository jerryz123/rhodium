#lang rhombus
// Checks CIRCT lowering for one native shared synchronous read-write port.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/backend/circt.rhm" open
  "../../examples/rtl/sync-memory-1rw.rhdl" as fixture

def circt = emit_circt(fixture.design)

check:
  circt.contains("seq.firmem 1, 1, undefined, undefined") ~is #true
  circt.contains("seq.firmem.read_write_port") ~is #true
  circt.contains("if %write") ~is #true
  circt.contains("enable %enable") ~is #true
  circt.contains("seq.firmem.read_port") ~is #false
  circt.contains("seq.firmem.write_port") ~is #false
