#lang rhombus
// Emits production fetch stages and assembly with a traced instruction consumer.
// SPDX-License-Identifier: Apache-2.0
import:
  "../../rhodium/event/main.rhm" open
  "../../rhodium/backend/circt.rhm".emit_circt
  "../frontend/event-window-fixture.rhdl" as fixture
def traced = instrument_events(fixture.frontend, EventInstrumentationConfig(~partial: #true))
def site_constants = for List (site in traced.manifest.sites, index in 0..traced.manifest.sites.length()):
  "inline constexpr unsigned " ++ String.join(site.label.replace("/", "_").split("."), "_") ++ " = " ++ to_string(index) ++ ";\n"
def event_manifest_cpp = event_manifest_to_cpp(traced.manifest) ++ "\nnamespace test_sites {\n" ++ String.join(site_constants, "") ++ "}\n"
export event_manifest_cpp
print(emit_circt(traced.instrumented.design))
