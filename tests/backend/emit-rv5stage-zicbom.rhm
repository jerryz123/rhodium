import:
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../riscv/isa/xlen.rhm".XLen
  "../../cores/rv5stage/tests/core-fixture.rhdl".RV5StageCoreFixture
  "../../cores/rv5stage/profile.rhm" open

def design = embedded.run_elaboration(fun (): RV5StageCoreFixture(RVCoreProfile(
  ~xlen: XLen.X64,
  ~extensions: RV5StageExtensions(~zicbom: #true)
), ~reset_address: 0x100))
print(emit_circt(design))
