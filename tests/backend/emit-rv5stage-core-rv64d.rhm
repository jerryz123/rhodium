#lang rhombus
// Emits the RV64D core with prefetch hints for WB authorization checks.

import:
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../cores/rv5stage/tests/core-fixture.rhdl" open
  "../../cores/rv5stage/profile.rhm" open
  "../../riscv/isa/fp-profile.rhm" open
  "../../riscv/isa/xlen.rhm" open

def design = embedded.run_elaboration(
  fun (): RV5StageCoreFixture(RVCoreProfile(
    ~xlen: XLen.X64,
    ~extensions: RV5StageExtensions(~floating_point: FloatingPointProfile.D, ~zicbop: #true)
  ), ~reset_address: 0x100)
)
print(emit_circt(design))
