#lang rhombus
// Emits CIRCT IR for the reusable RV64 ALU with B and Zicond operations.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../riscv/isa/xlen.rhm" open
  "../../cores/alu.rhdl" as alu

def design = embedded.run_elaboration(fun (): alu.ALU(XLen.X64))
print(emit_circt(design))
