def same_shift_design = Design()
def same_shift_builder = Builder(same_shift_design)
def same_shift_module = same_shift_builder.module("SameWidthShifts")
def same_shift_value = same_shift_builder.input(same_shift_module, "value", Bits(8))
def same_shift_amount = same_shift_builder.input(same_shift_module, "amount", Bits(8))
def same_shift_left_output = same_shift_builder.output(same_shift_module, "left", Bits(8))
def same_shift_right_output = same_shift_builder.output(same_shift_module, "right", Bits(8))
def same_shift_left = same_shift_builder.shl(same_shift_module,
                                             same_shift_value,
                                             same_shift_amount)
def same_shift_right = same_shift_builder.shru(same_shift_module,
                                               same_shift_value,
                                               same_shift_amount)
same_shift_builder.drive(same_shift_left_output, same_shift_left)
same_shift_builder.drive(same_shift_right_output, same_shift_right)
def finished_same_shift_module = same_shift_builder.finish(same_shift_module)
def same_shift_circt = emit_circt(same_shift_design)

check:
  same_shift_circt.contains("comb.shl %value, %amount : i8") ~is #true
  same_shift_circt.contains("comb.shru %value, %amount : i8") ~is #true
  same_shift_circt.contains("__rhodium_shift_zero_") ~is #false

