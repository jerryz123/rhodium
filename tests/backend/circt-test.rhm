// Backend-owned decode names must depend on module structure, not IDs consumed
// elsewhere in the design before the module is built.
fun stable_decode_circt(consumed_ids):
  def design = Design()
  for (_index in 0..consumed_ids):
    design.fresh_id()
  def builder = Builder(design)
  def module_def = builder.module("StableDecode")
  def selector = builder.input(module_def, "selector", Bits(1))
  def output = builder.output(module_def, "result", Bits(1))
  def decoded = builder.decode(module_def,
                               selector,
                               Bits(1),
                               Bits(1),
                               [[1, 1, 1, 1]],
                               0,
                               1)
  builder.drive(output, decoded)
  builder.finish(module_def)
  emit_circt(design)

def early_decode_circt = stable_decode_circt(0)
def late_decode_circt = stable_decode_circt(100)

// A direct two-port write set makes the collision-undefined symmetric merge
// visible without relying on a larger frontend fixture's incidental logic.
def write_set_design = Design()
def write_set_builder = Builder(write_set_design)
def write_set_module = write_set_builder.module("VectorWriteSet")
def write_set_base = write_set_builder.input(
  write_set_module,
  "base",
  VectorType(2, Bits(4))
)
def write_set_enables = write_set_builder.input(
  write_set_module,
  "enables",
  VectorType(2, Bits(1))
)
def write_set_indices = write_set_builder.input(
  write_set_module,
  "indices",
  VectorType(2, Bits(1))
)
def write_set_elements = write_set_builder.input(
  write_set_module,
  "elements",
  VectorType(2, Bits(4))
)
def write_set_output = write_set_builder.output(
  write_set_module,
  "result",
  VectorType(2, Bits(4))
)
def write_set_result = write_set_builder.vector_write_set(
  write_set_module,
  write_set_base,
  write_set_enables,
  write_set_indices,
  write_set_elements
)
write_set_builder.drive(write_set_output, write_set_result)
def finished_write_set_module = write_set_builder.finish(write_set_module)
def write_set_circt = emit_circt(write_set_design)

