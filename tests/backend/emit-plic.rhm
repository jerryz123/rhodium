#lang rhombus
// Emits CIRCT MLIR for the three-source, two-context PLIC behavioral fixture.

import:
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../chi/main.rhdl" as chi
  "../../devices/plic.rhdl" as plic

def design = embedded.run_elaboration(
  fun (): plic.Plic(plic.PlicConfig(chi.CHIFlitParams(), 3, 2, 3))
)
print(emit_circt(design))
