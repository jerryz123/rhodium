#lang rhombus
// Emits CIRCT IR for RV32 scalar accesses over one XLEN-wide memory word.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../riscv/isa/xlen.rhm" open
  "../../cores/tests/load-store-fixture.rhdl" as fixture

def design = embedded.run_elaboration(fun (): fixture.LoadStoreFixture(XLen.X32, 4))
print(emit_circt(design))
