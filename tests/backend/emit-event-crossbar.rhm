#lang rhombus
// Emits crossbar trace RTL and manifest-resolved site indices for its independent scoreboard.
// SPDX-License-Identifier: Apache-2.0
import:
  "../frontend/event-crossbar-fixture.rhdl".crossed
  "../../rhodium/event/main.rhm" open
  "../../rhodium/backend/circt.rhm".emit_circt
def traced = instrument_events(crossed)
def indices = for List (lane in ["direct", "configured"]):
  def sites = for List (label in ["input0", "input1", "input2", "output0", "output1"]):
    def matches = (for List (index in 0..traced.manifest.sites.length()): index).filter(~keep: fun (index): traced.manifest.sites[index].label == label && traced.manifest.sites[index].id.contains("/" ++ lane ++ "/"))
    unless matches.length() == 1 | error("expected one crossbar site: " ++ lane ++ "/" ++ label)
    to_string(matches[0])
  "{" ++ String.join(sites, ",") ++ "}"
def event_manifest_cpp = event_manifest_to_cpp(traced.manifest) ++ "\nconstexpr unsigned crossbar_sites[2][5] = {" ++ String.join(indices, ",") ++ "};\n"
export event_manifest_cpp
print(emit_circt(traced.instrumented.design))
