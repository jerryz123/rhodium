#lang rhombus
// Checks immutable instrumentation, exact stage plans, observed controls, and diagnostics.

import:
  lib("json/main.rkt").#{string->jsexpr} as parse_json
  "../../rhodium/event/main.rhm" open
  "../../rhodium/core/ir.rhm".Module
  "../../rhodium/core/verify.rhm".verify_design
  "../../rhodium/backend/circt.rhm".emit_circt
  "../frontend/event-instrument-fixture.rhdl" as fixture
  "../frontend/event-graph-fixture.rhdl" as static_fixture
  "../frontend/event-pipeline-fixture.rhdl" as pipeline_fixture
  "../frontend/event-elastic-fixture.rhdl" as elastic_fixture
  "../frontend/event-queue-fixture.rhdl" as queue_fixture
  "../frontend/event-arbiter-fixture.rhdl" as arbiter_fixture
  "../frontend/event-demux-fixture.rhdl" as demux_fixture

def before = emit_circt(fixture.runtime.design)
def result = instrument_events(fixture.runtime)
def after = emit_circt(fixture.runtime.design)
def emitted = emit_circt(result.instrumented.design)

fun child(module_def :: Module, name :: String):
  module_def.operations.find(fun (op): op.opcode == "rtl.instance" && op.attribute("name") == name).attribute("module")
fun has_trace_ports(module_def :: Module):
  (module_def.inputs ++ module_def.outputs).find(fun (port): port.name.starts_with("__event_")) != #false
def left_wrapper = child(result.instrumented.top, "left")
def right_wrapper = child(result.instrumented.top, "right")
def left_child = child(left_wrapper, "child")
def right_child = child(right_wrapper, "child")
def shared_mapper = child(left_child, "mapper")
def shared_identity = child(shared_mapper, "identity")
def original_mapper = child(child(child(fixture.runtime.top, "left"), "child"), "mapper")
check:
  before ~is after
  result.original === fixture.runtime ~is #true
  result.instrumented.design === fixture.runtime.design ~is #false
  result.instrumented.top.inputs.map(fun (port): port.name) ~is fixture.runtime.top.inputs.map(fun (port): port.name)
  result.instrumented.top.outputs.map(fun (port): port.name) ~is fixture.runtime.top.outputs.map(fun (port): port.name)
  result.manifest.sites.length() ~is 8
  result.manifest.sites.map(fun (site): site.label) ~is ["left-input", "left-output", "right-input", "right-output", "wide-input", "wide-output", "mapped", "mapped"]
  result.manifest.dependencies.length() ~is 5
  emitted.contains("sim.func.dpi.call @rhodium_event_node") ~is #true
  emitted.contains("sim.func.dpi.call @rhodium_event_edge") ~is #true
  emitted.contains("__event_in_") ~is #true
  emitted.contains("__event_out_") ~is #true
  instrument_events(static_fixture.linear).manifest.sites.length() ~is 3
  instrument_events(static_fixture.forked) ~throws "dynamic trace semantics"
  instrument_events(static_fixture.merged) ~throws "dynamic trace semantics"
  instrument_events(fixture.wrong_domain()) ~throws "one clock and reset epoch"
  instrument_events(fixture.terminal_chain) ~throws "terminal event has a downstream annotation"
  fixture.bad_guard() ~throws "trace guard must be local one-bit data"
  instrument_events(fixture.runtime, EventInstrumentationConfig("missing", "reset")) ~throws "top-level Clock"
  parse_json(event_manifest_to_json(result.manifest)) != #false ~is #true
  // Occurrence-specific IDs require distinct traced children and ancestor targets.
  left_wrapper === right_wrapper ~is #false
  left_child === right_child ~is #false
  has_trace_ports(left_wrapper) ~is #true
  has_trace_ports(right_wrapper) ~is #true
  left_wrapper.values.find(fun (value): value.name.starts_with("__event_cycle") || value.name.starts_with("__event_sequence")) ~is #false
  left_wrapper.operations.find(fun (op): op.opcode == "sim.dpi_call") ~is #false
  // Repeated unchanged definitions, including nested/direct diamond sharing,
  // are imported only once and acquire neither trace ports nor trace state.
  child(right_child, "mapper") === shared_mapper ~is #true
  child(result.instrumented.top, "identity") === shared_identity ~is #true
  has_trace_ports(shared_mapper) ~is #false
  has_trace_ports(shared_identity) ~is #false
  shared_mapper.values.find(fun (value): value.name.starts_with("__event_")) ~is #false
  shared_mapper.operations.length() ~is original_mapper.operations.length()
  shared_mapper === original_mapper ~is #false
  shared_mapper.design === result.instrumented.design ~is #true
  shared_identity.design === result.instrumented.design ~is #true
  shared_mapper.name ~is original_mapper.name

def pipeline_before = emit_circt(pipeline_fixture.pipeline.design)
def pipeline = instrument_events(pipeline_fixture.pipeline)
check:
  pipeline.manifest.sites.map(fun (site): site.label) ~is ["accepted", "completed", "middle"]
  pipeline.manifest.dependencies.map(fun (edge): edge.latency_cycles) ~is [1, 3]
  result.manifest.dependencies.map(fun (edge): edge.latency_cycles) ~is [0, 0, 0, 0, 0]
  infer_event_manifest(static_fixture.linear).dependencies.map(fun (edge): edge.latency_cycles) ~is [#false, #false]
  event_manifest_to_json(pipeline.manifest).contains("\"latency_cycles\":3") ~is #true
  emit_circt(pipeline_fixture.pipeline.design) ~is pipeline_before
  pipeline_fixture.bad_latency_count() ~throws "PosInt"
  pipeline_fixture.bad_latency_shape() ~throws "exactly one input and output"

def elastic_before = emit_circt(elastic_fixture.elastic.design)
def elastic = instrument_events(elastic_fixture.elastic)
def elastic_left = child(elastic.instrumented.top, "left")
def elastic_right = child(elastic.instrumented.top, "right")
check:
  elastic.manifest.sites.map(fun (site): site.label) ~is ["accepted", "completed", "middle", "accepted", "completed", "middle"]
  elastic.manifest.dependencies.map(fun (edge): edge.latency_cycles) ~is [#false, #false, #false, #false]
  elastic.manifest.dependencies.map(fun (edge): edge.trace_stages.length()) ~is [1, 3, 1, 3]
  elastic.manifest.dependencies[1].trace_stages.map(fun (stage): stage.instance_path.take(2)) ~is [["EventElastic", "left"], ["EventElastic", "left"], ["EventElastic", "left"]]
  elastic.manifest.dependencies[3].trace_stages.map(fun (stage): stage.instance_path.take(2)) ~is [["EventElastic", "right"], ["EventElastic", "right"], ["EventElastic", "right"]]
  emit_circt(elastic_fixture.elastic.design) ~is elastic_before
  emit_circt(elastic.instrumented.design).contains("__event_control_") ~is #true
  elastic_left === elastic_right ~is #false
  child(elastic.instrumented.top, "gold_left") === child(elastic.instrumented.top, "gold_right") ~is #true
  has_trace_ports(child(elastic.instrumented.top, "gold_left")) ~is #false
  elastic_fixture.bad_width() ~throws "local one-bit data"
  elastic_fixture.bad_count() ~throws "matching lengths"
  elastic_fixture.missing_controls() ~throws "requires declared stage controls"

def queue_before = emit_circt(queue_fixture.queued.design)
def queued = instrument_events(queue_fixture.queued)
def queue_stages = queued.manifest.dependencies.map(fun (edge): edge.trace_stages)
check:
  queued.manifest.sites.length() ~is 20
  queued.manifest.dependencies.map(fun (edge): edge.latency_cycles) ~is [#false, #false, #false, #false, #false, #false, #false, #false, #false, #false]
  queue_stages.take(9).map(fun (stages): stages[0].depth) ~is [1, 1, 1, 1, 3, 3, 3, 3, 3]
  queue_stages[9].map(fun (stage): stage is_a EventTraceQueue) ~is [#false, #true, #false, #true]
  queue_stages[8][0].instance_path.take(3) ~is ["EventQueue", "lane8", "storage"]
  emit_circt(queue_fixture.queued.design) ~is queue_before
  child(queued.instrumented.top, "lane7") === child(queued.instrumented.top, "lane8") ~is #false
  child(queued.instrumented.top, "gold7") === child(queued.instrumented.top, "gold8") ~is #true
  has_trace_ports(child(child(queued.instrumented.top, "gold8"), "storage")) ~is #false
  queue_fixture.bad_width() ~throws "required width"
  queue_fixture.bad_enable() ~throws "required width"
  queue_fixture.missing_controls() ~throws "requires declared storage controls"
  queue_fixture.mismatched_instance() ~throws "must match the transform implementation"
  queue_fixture.duplicate_controls() ~throws "already declared"

def arbiter_before = emit_circt(arbiter_fixture.arbitrated.design)
def arbitrated = instrument_events(arbiter_fixture.arbitrated)
def completions = arbitrated.manifest.sites.filter(~keep: fun (site): site.label == "completed")
def selection_plans = completions.map(fun (site): arbitrated.manifest.trace_plans[site.id])
check:
  arbitrated.manifest.sites.length() ~is 20
  arbitrated.manifest.dependencies.length() ~is 15
  arbitrated.manifest.dependencies.take(6).map(fun (edge): edge.latency_cycles) ~is [0, 0, 0, 0, 0, 0]
  selection_plans[0] is_a EventTraceSelection ~is #true
  selection_plans[1] is_a EventTraceSelection ~is #true
  selection_plans[2].input.input is_a EventTraceSelection ~is #true
  selection_plans[4].input.input.inputs[0].input is_a EventTraceSelection ~is #true
  emit_circt(arbiter_fixture.arbitrated.design) ~is arbiter_before
  child(arbitrated.instrumented.top, "lane2") === child(arbitrated.instrumented.top, "lane3") ~is #false
  child(arbitrated.instrumented.top, "gold2") === child(arbitrated.instrumented.top, "gold3") ~is #true
  has_trace_ports(child(child(arbitrated.instrumented.top, "gold3"), "network")) ~is #false
  arbiter_fixture.bad_width() ~throws "local one-bit data"
  arbiter_fixture.duplicate_controls() ~throws "already declared"
  arbiter_fixture.missing_controls() ~throws "requires declared grants"
  arbiter_fixture.mismatched_instance() ~throws "must match the transform implementation"
  arbiter_fixture.bad_shape() ~throws "one grant and route per input"
  instrument_events(arbiter_fixture.partial()) ~throws "annotated ancestor on every input path"

def demux_before = emit_circt(demux_fixture.routed.design)
def routed = instrument_events(demux_fixture.routed)
def branch_sites = routed.manifest.sites.filter(~keep: fun (site): site.label.starts_with("branch"))
def routing_plans = branch_sites.map(fun (site): routed.manifest.trace_plans[site.id])
check:
  routed.manifest.sites.length() ~is 12
  routed.manifest.dependencies.length() ~is 9
  routed.manifest.dependencies.take(3).map(fun (edge): edge.latency_cycles) ~is [0, 0, 0]
  routed.manifest.dependencies.map(fun (edge): edge.trace_stages) ~is [#false, #false, #false, #false, #false, #false, #false, #false, #false]
  routing_plans.take(3).map(fun (plan): plan is_a EventTraceRouting) ~is [#true, #true, #true]
  routing_plans.take(3).map(fun (plan): plan.output_index) ~is [0, 1, 2]
  routing_plans[0].routing_id ~is routing_plans[2].routing_id
  routing_plans[3].input is_a EventTraceRouting ~is #true
  routing_plans[3].input.input is_a EventTracePipeline ~is #true
  routing_plans[3].input.routing_id != routing_plans[6].input.routing_id ~is #true
  emit_circt(demux_fixture.routed.design) ~is demux_before
  child(routed.instrumented.top, "lane1") === child(routed.instrumented.top, "lane2") ~is #false
  child(routed.instrumented.top, "gold1") === child(routed.instrumented.top, "gold2") ~is #true
  has_trace_ports(child(child(routed.instrumented.top, "gold2"), "network")) ~is #false
  instrument_events(demux_fixture.nested()).manifest.dependencies.length() ~is 3
  instrument_events(demux_fixture.rejoined()).manifest.dependencies.length() ~is 2
  demux_fixture.bad_width() ~throws "local one-bit data"
  demux_fixture.bad_shape() ~throws "one predicate and route per output"
  demux_fixture.bad_routes() ~throws "one predicate and route per output"
  demux_fixture.foreign_controls() ~throws "local one-bit data"
  instrument_events(demux_fixture.uncertified_fanout()) ~throws "uncertified fanout"
  instrument_events(demux_fixture.singleton()).manifest.dependencies.map(fun (edge): edge.latency_cycles) ~is [0]
