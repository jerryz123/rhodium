#lang rhombus
// Emits CIRCT MLIR for RV5Stage's standalone double-profile FP pipeline.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/backend/circt.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../riscv/isa/fp-profile.rhm" open
  "../../riscv/isa/xlen.rhm" open
  "../../cores/rv5stage/fp/pipeline.rhdl" as pipeline

def design = embedded.run_elaboration(
  fun (): pipeline.RV5StageFpPipeline(
    XLen.X64,
    FloatingPointProfile.D,
    Bits(8),
    ~half_precision: HalfPrecisionProfile.Zfh,
    ~zfa: #true
  )
)
print(emit_circt(design))
