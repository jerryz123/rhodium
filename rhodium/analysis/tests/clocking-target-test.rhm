#lang rhombus
// Checks target-only clock analysis, fresh declaration bindings, retained expansion, and CDC failures.
// SPDX-License-Identifier: Apache-2.0
import:
  "../clocking.rhm" open
  "../../compile/program.rhm".compile_program
  "../../core/main.rhm" open
  "../../lowering/program.rhm" open

def design = Design()
def builder = Builder(design)
def top = builder.module("Crossing")
def source_clock = builder.input(top, "source_clock", Clock)
def destination_clock = builder.input(top, "destination_clock", Clock)
def data = builder.input(top, "data", Bits(8))
def state = builder.register(top, "sample", Bits(8), destination_clock)
builder.drive(state.next, data)
def environment = TemporalEnvironment([TopInputContract(data, [], SynchronousInputTiming(source_clock))],
                                      [AsynchronousClockRelationship(source_clock, destination_clock)])
declare_clocking_environment(top, environment)
builder.finish(top)
def program = ElaboratedProgram(design, top)
def before = dump_ir(design)
def target = clocking_target()
def first = compile_program(program, target)
def second = compile_program(program, target)
def report = first.report
check:
  first.target ~is "clocking"
  report is_a ClockingReport ~is #true
  report.summary.cdc_violations.length() ~is 1
  report.summary.cdc_violations[0].reason.contains("crossing evidence") ~is #true
  report.clocks[0] is_a SingleClock ~is #true
  first.artifacts[0].name ~is "Crossing.clocking.txt"
  first.artifacts[0].content ~is second.artifacts[0].content
  first.artifacts[0].content.contains("asynchronous_clock") ~is #true
  report.top === top ~is #false
  report.top === second.report.top ~is #false
  report.environment.input_contracts[0].input === report.top.find_input("data").value ~is #true
  report.environment.input_contracts[0].timing.clock === report.top.find_input("source_clock").value ~is #true
  report.environment.clock_relationships[0].right === report.top.find_input("destination_clock").value ~is #true
  environment.input_contracts[0].input === data ~is #true
  dump_ir(design) ~is before
  design.sealed ~is #false

// Enforcement completes the same analysis and fails without returning a result.
def mutable published = #false
fun strict(): published := compile_program(program, clocking_target(~check_cdc: #true))
check:
  strict() ~throws "1 CDC violation"
  published ~is #false
  design.sealed ~is #false

// External environments bind to the prepared top and augment declarations.
// Capturing old IR is an ownership error, not an implicit name-based remapping.
fun overlapping_environment(prepared_top :: Module):
  TemporalEnvironment([TopInputContract(prepared_top.find_input("data").value, [], UnknownInputTiming())])
check:
  compile_program(program, clocking_target(~environment: fun (prepared_top): environment)) ~throws "input of top module"
  compile_program(program, clocking_target(~environment: overlapping_environment)) ~throws "must not overlap"

def clean_design = Design()
def clean_builder = Builder(clean_design)
def clean_top = clean_builder.module("Local")
def clean_clock = clean_builder.input(clean_top, "clock", Clock)
def clean_data = clean_builder.input(clean_top, "data", Bits(8))
def clean_state = clean_builder.register(clean_top, "sample", Bits(8), clean_clock)
clean_builder.drive(clean_state.next, clean_data)
clean_builder.finish(clean_top)
def clean = ElaboratedProgram(clean_design, clean_top)
fun clean_environment(prepared_top :: Module):
  TemporalEnvironment([TopInputContract(prepared_top.find_input("data").value, [], SynchronousInputTiming(prepared_top.find_input("clock").value))])
def checked = compile_program(clean, clocking_target(~check_cdc: #true, ~environment: clean_environment))
check:
  checked.report.summary.cdc_violations ~is []
  checked.report.environment.input_contracts[0].input.module_def === checked.report.top ~is #true
  clean_design.sealed ~is #false

// A retained top expands before temporal analysis; declarations from its
// provider bind to the copied implementation, without any frontend dependency.
def signature = ModuleSignature([PortSignature("clock", Clock), PortSignature("reset", Reset), PortSignature("data", Bits(8))],
                                [PortSignature("result", Bits(8))])
def definition = ConstructDefinition(ConstructIdentity("RetainedSampler"), [], signature,
                                     [[OutputLeafDependency([], [])]], ~state: SingleClockState("clock", "reset"))
def mutable calls = 0
fun expand(builder :: Builder, selected :: ConstructDefinition):
  calls := calls + 1
  def body = builder.module("Sampler")
  def clock = builder.input(body, "clock", Clock)
  def reset = builder.input(body, "reset", Reset)
  def input = builder.input(body, "data", Bits(8))
  def sample = builder.register(body, "sample", Bits(8), clock)
  builder.drive(sample.next, input)
  builder.drive(builder.output(body, "result", Bits(8)), sample.current)
  declare_clocking_environment(body, TemporalEnvironment([TopInputContract(input, [], SynchronousInputTiming(clock))]))
  builder.finish(body)
  ExpansionResult(body)
def retained = ElaboratedProgram(Design(), definition, Map.by(===){definition: ExpansionProvider(expand)})
def retained_result = compile_program(retained, clocking_target(~check_cdc: #true))
check:
  calls ~is 1
  retained_result.manifest.lowerings.length() ~is 1
  retained_result.manifest.lowerings[0].path ~is []
  retained_result.manifest.lowerings[0].definition === definition ~is #true
  retained_result.report.summary.cdc_violations ~is []
  retained_result.report.environment.input_contracts[0].input.module_def === retained_result.report.top ~is #true
  retained.design.modules ~is []
  retained.design.sealed ~is #false
