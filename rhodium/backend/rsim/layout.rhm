#lang rhombus
/* Plans evaluation-long backing, aggregate borrows, and typed scratch groups without rendering C++ references. */
// SPDX-License-Identifier: Apache-2.0
import:
  "../../core/types.rhm" open
  "plan.rhm" open
  "regions.rhm".RsimRegion
  "types.rhm".CppTypes

export:
  StateStorage ConstantStorage ScratchSlot StorageRef ScratchGroup BoundaryStorage
  aggregate_state_read aggregate_projection aggregate_decode backed_reference scratch_slot boundary_layout

/* Identify a register, synchronous-read result, or foreign result on the current
   model. Only foreign results use the secondary result index. */
class StateStorage(kind :: String, slot :: Nat, result :: Nat = 0)

/* Refer to the constant pool by schedule value, independently of symbol names
   and deduplication chosen during constant emission. */
class ConstantStorage(value :: Nat)

/* A unique location within a typed scratch group. Indirect slots hold pointers
   refreshed during this evaluation; they do not imply cross-call validity. */
class ScratchSlot(group :: Nat, index :: Nat, indirect :: Boolean)

/* A stable root plus a static record/vector path. Projection preserves the
   root's lifetime and, for indirect scratch, follows the selected aggregate.
   Paths contain authored field names or logical vector indices, never C++ text. */
class StorageRef(root :: StateStorage || ConstantStorage || ScratchSlot,
                 path :: List.of(String || Nat) = [])

/* Describe one physical array by its C++ carrier and pointer policy. Group
   position supplies its identity; the renderer owns declarations and names. */
class ScratchGroup(carrier :: String, indirect :: Boolean, count :: PosInt)

/* One authoritative binding map per phase, with groups in allocation order.
   Scratch ownership and borrowing are derived from each structured reference. */
class BoundaryStorage(bindings :: Map, groups :: List.of(ScratchGroup))

/* Aggregate state roots permit reference-valued local loads. Scalar roots use
   the same stable backing but must load into unsigned arithmetic carriers. */
fun aggregate_state_read(step :: RsimStep) :: Boolean:
  step.opcode in ["state", "sync_read", "foreign_result"] && (record_type(step.type) || vector_type(step.type))

/* Static aggregate projections expose subobjects without bounds-dependent
   temporaries or scalar normalization. Dynamic projections retain copies. */
fun aggregate_projection(step :: RsimStep) :: Boolean:
  step.opcode in ["rtl.record_get", "rtl.vector_get"] && (record_type(step.type) || vector_type(step.type))

/* Aggregate decode arms and the default are pooled immutable rows, so selecting
   any arm yields an lvalue that outlives every evaluation and model instance. */
fun aggregate_decode(step :: RsimStep) :: Boolean:
  step.opcode == "rtl.decode" && (record_type(step.type) || vector_type(step.type))

/* Resolve evaluation-long backing through static subobjects only. The immutable
   steps list was checked by RsimSchedule; :~ avoids rescanning it on each walk.
   Scalars resolve the same normalized backing but load into arithmetic carriers.
   Constants take precedence so consumers need no local ancestor aliases. A
   helper-local computed parent has no backing and its crossing projection copies. */
fun backed_reference(index :: Nat, steps :~ List.of(RsimStep), constants :: Map, bindings :: ReadableMap) :: maybe(StorageRef):
  cond
  | constants.has_key(index): StorageRef(ConstantStorage(index))
  | bindings.has_key(index): bindings[index]
  | steps[index].opcode in ["state", "sync_read", "foreign_result"]:
      def step = steps[index]
      StorageRef(StateStorage(step.opcode, step.attributes["slot"], step.attributes.get("result", 0)))
  | steps[index].opcode in ["rtl.record_get", "rtl.vector_get"]:
      def step = steps[index]
      def parent = backed_reference(step.operands[0], steps, constants, bindings)
      if parent
      | def member = (if step.opcode == "rtl.record_get" | step.attributes["field"] | step.attributes["index"])
        StorageRef(parent.root, parent.path ++ [member])
      | #false
  | ~else: #false

/* Only a whole scratch binding owns an assignable value/pointer slot. A
   projection into that slot must neither overwrite it nor become a gather lane. */
fun scratch_slot(binding :: maybe(StorageRef)) :: maybe(ScratchSlot):
  if binding && binding.path.length() == 0 && binding.root is_a ScratchSlot
  | binding.root
  | #false

/* Allocate crossing values in deterministic region/value order, sharing groups
   only by physical carrier and indirection. Scalar slots use compact storage;
   the emitter reloads them into arithmetic carriers. Borrow mux branches only when they
   already have stable backing; conditional branch locals cannot escape this way.
   Decode rows always have stable backing. Eager scalar slots may be reused after
   their last consuming region, never within it. Cached evaluation retains unique
   slots. Aggregate/wide backing is never recycled because references can escape
   through projections or borrowed muxes. State and static projections alias
   their original roots without extra payload or pointers. */
fun boundary_layout(regions :: List.of(RsimRegion), plan :: RsimSchedule, types :: CppTypes, constants :: Map,
                    ~reuse_scalars: reuse_scalars :: Boolean = #true) :: BoundaryStorage:
  def bindings = MutableMap{}
  def carriers = MutableList[]
  def groups = MutableMap{}
  def counts = MutableMap{}
  def last_uses = MutableMap{}
  for (region in regions, number in 0..regions.length()):
    for (value in region.inputs): last_uses[value] := number
  def expirations = MutableMap{}
  def free = MutableMap{}
  for (region in regions, number in 0..regions.length()):
    for (entry in expirations.get(number, [])):
      free[entry[0]] := [entry[1], free.get(entry[0], [])]
    for (index in region.outputs):
      def step = plan.steps[index]
      def direct = backed_reference(index, plan.steps, constants, bindings)
      if direct
      | bindings[index] := direct
      | def borrow_mux:
          step.opcode == "rtl.mux_lookup" && (record_type(step.type) || vector_type(step.type))
            && !region.conditionals.has_key(index)
            && (for all (operand in step.operands.drop(1)): constants.has_key(operand) || bindings.has_key(operand))
        def borrow = aggregate_decode(step) || borrow_mux
        def carrier = [types.storage_name(step.type), borrow]
        unless groups.has_key(carrier)
        | groups[carrier] := carriers.length()
          counts[carrier] := 0
          carriers.add(carrier)
        def width = scalar_width(step.type)
        def reusable = reuse_scalars && !borrow && width != #false && width <= 64
        def available = if reusable | free.get(carrier, []) | []
        def slot = if available.length() > 0 | available[0] | counts[carrier]
        if available.length() > 0
        | free[carrier] := available[1]
        | counts[carrier] := counts[carrier] + 1
        bindings[index] := StorageRef(ScratchSlot(groups[carrier], slot, borrow))
        when reusable
        | def expiry = last_uses[index] + 1
          unless expirations.has_key(expiry) | expirations[expiry] := MutableList[]
          expirations[expiry].add([carrier, slot])
  BoundaryStorage(bindings.snapshot(), for List (carrier in carriers): ScratchGroup(carrier[0], carrier[1], counts[carrier]))
