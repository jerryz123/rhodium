#lang rhombus
/* Folds exclusive array update/selection trees into register destinations without changing value identities. */
// SPDX-License-Identifier: Apache-2.0
import:
  "../../core/types.rhm" open
  "plan.rhm" open

export RsimArrayAssignment plan_array_assignments

/* Retain original schedule IDs for an assignment tree and its external leaves.
   Absorbed steps have exactly one consumer and are emitted only at this sink;
   leaf values remain immutable, normally scheduled pre-edge computations. */
class RsimArrayAssignment(steps :: Set, values :: List.of(Nat))

/* Count all graph and interface/effect uses before recognizing exclusive trees.
   Roots include both evaluation phases and reset operands. Shared values stop
   folding even when their consumers happen to belong to the same register. */
fun plan_array_assignments(schedule :: RsimSchedule, roots :: List.of(Nat)) :: Map:
  def uses = MutableMap{}
  for (index in 0..schedule.steps.length()): uses[index] := 0
  for (step in schedule.steps):
    for (value in step.operands): uses[value] := uses[value] + 1
  for (value in roots): uses[value] := uses[value] + 1
  def assignments = MutableMap{}
  for (reg in schedule.registers, slot in 0..schedule.registers.length()):
    when vector_type(reg.type)
    | def absorbed = MutableSet{}
      def leaves = MutableSet{}
      def mutable updated = #false
      /* Follow only same-array base/choice edges, retaining selectors, indices,
         replacement rows, and shared subtrees as sampled value dependencies. */
      fun visit(value :: Nat):
        def step = schedule.steps[value]
        cond
        | uses[value] != 1: leaves.add(value)
        | step.opcode == "rtl.vector_inject":
            updated := #true
            absorbed.add(value)
            visit(step.operands[0])
            leaves.add(step.operands[1])
            leaves.add(step.operands[2])
        | step.opcode == "rtl.mux_lookup":
            absorbed.add(value)
            leaves.add(step.operands[0])
            for (branch in step.operands.drop(1)): visit(branch)
        | ~else: leaves.add(value)
      visit(reg.next_value)
      when updated
      | def leaf_values = for List (value in leaves): value
        assignments[slot] := RsimArrayAssignment(absorbed.snapshot(), leaf_values.sort())
  assignments.snapshot()
