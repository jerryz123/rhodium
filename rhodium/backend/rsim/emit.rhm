#lang rhombus
/* Renders separate value and consumer helpers with typed scratch and double-buffered state commits. */
// SPDX-License-Identifier: Apache-2.0
import:
  "../../core/types.rhm" open
  "plan.rhm" open
  "evaluation.rhm" open
  "regions.rhm" open
  "cache.rhm" open
  "conditional.rhm".plan_conditionals
  "layout.rhm" open
  "arrays.rhm" open
  "types.rhm" open
  rhombus/meta open
  rhombus/runtime_path
  lib("racket/file.rkt") as file
  lib("racket/base.rkt") as rkt

export emit_rsim

/* RsimSchedule checks its immutable steps list at construction, and emit_rsim
   checks the schedule at entry. Private helpers only receive that same list:
   use :~ to retain element type information without rescanning every step on
   each call. Keep this checked boundary if a helper gains another caller. */

// Resolve support relative to the installed emitter, independent of the caller's cwd.
runtime_path.def bits_header: "rsim-bits.hpp"

/* Refer to a previously scheduled temporary. */
fun ref(index :: Nat) :: String:
  "v" ++ to_string(index)

/* Quote diagnostic paths without letting source punctuation or line breaks
   become C++ syntax. Labels and occurrence names are already identifiers. */
fun cpp_string(value :: String) :: String:
  def mutable escaped = value
  for (pair in [["\\", "\\\\"], ["\"", "\\\""], ["\n", "\\n"], ["\r", "\\r"], ["\t", "\\t"]]):
    escaped := escaped.replace(pair[0], pair[1], ~all: #true)
  "\"" ++ escaped ++ "\""

/* Distinguish the ABI's native widths from packed vectors, independently of
   author-level signedness and the model's scalar carriers. */
fun foreign_packed(type :: HardwareType) :: Boolean:
  !(scalar_width(type) in [1, 8, 16, 32, 64])

/* Use the same native and packed-word types as the SystemVerilog DPI ABI.
   Packed returns use one uint32 word; packed arguments use arrays of words. */
fun foreign_type(type :: HardwareType) :: String:
  {1: "unsigned char", 8: "char", 16: "short", 32: "int", 64: "long long"}.get(scalar_width(type), "std::uint32_t")

/* Identify one held result independently of both its sibling results and
   other occurrences of the same imported function. */
fun foreign_slot(call_index :: Nat, result_index :: Nat) :: String:
  "f" ++ to_string(call_index) ++ "_" ++ to_string(result_index)

/* Recognize exact scalar set membership from the existing decode relation.
   Fully cared keys are unique after verification. Wide/aggregate selectors and
   partial or non-Boolean results retain the general typed decode lowering. */
fun membership_decode(step :: RsimStep, input_type :: HardwareType) :: Boolean:
  def width = scalar_width(input_type)
  width != #false && width <= 64 && scalar_width(step.type) == 1
    && step.attributes["default_value"] == 0 && step.attributes["default_care"] == 1
    && step.attributes["cases"].length() > 0
    && (for all (row in step.attributes["cases"]): row[1] == 2 ** width - 1 && row[2] == 1 && row[3] == 1)

/* Emit one operation; normalization at the caller preserves each intermediate
   hardware width before any later comparison or conversion. */
fun expression(step :: RsimStep, steps :~ List.of(RsimStep), types :: CppTypes) :: String:
  def args = step.operands.map(ref)
  def binary = {"rtl.and": "&", "rtl.or": "|", "rtl.xor": "^", "rtl.add": "+",
                "rtl.sub": "-", "rtl.mul": "*", "rtl.eq": "==", "rtl.ult": "<"}
  cond
  | step.opcode == "input": "inputs." ++ cpp_name(step.attributes["name"])
  | step.opcode == "state": "current.s" ++ to_string(step.attributes["slot"])
  | step.opcode == "foreign_result": "current." ++ foreign_slot(step.attributes["slot"], step.attributes["result"])
  | step.opcode == "sync_read": "current.r" ++ to_string(step.attributes["slot"])
  | step.opcode == "memory_read": "vector_index(memory" ++ to_string(step.attributes["slot"]) ++ "_, " ++ args[0] ++ ")"
  | step.opcode == "rtl.constant": types.constant(step.type, step.attributes["value"])
  // Deterministic choices for partial values do not introduce four-state logic
  // or promise values for uncared bits or invalid one-hot selectors.
  | step.opcode == "rtl.dont_care": types.constant(step.type, 0)
  | step.opcode == "rtl.onehot_mux":
      def selector_type = steps[step.operands[0]].type
      def cases = for List (value in args.drop(1), index in 0..(args.length() - 1)):
        types.bit_test(selector_type, args[0], index) ++ " ? " ++ value ++ " : "
      String.join(cases, "") ++ types.name(step.type) ++ "{}"
  | step.opcode == "rtl.decode" && membership_decode(step, steps[step.operands[0]].type):
      def keys = step.attributes["cases"].map(fun (row): "case " ++ literal(row[0]) ++ ":")
      "([&]() -> std::uint64_t { switch (" ++ args[0] ++ ") { " ++ String.join(keys, " ") ++ " return UINT64_C(1); default: return UINT64_C(0); } }())"
  | step.opcode == "rtl.decode":
      def input_type = steps[step.operands[0]].type
      /* All aggregate arms, including the default, must be same-type lvalues
         so the conditional selects a row without constructing a temporary. */
      fun row_value(value :: Nat) :: String:
        if aggregate_decode(step)
        | types.constant_reference(step.type, value)
        | types.constant(step.type, value)
      def cases = for List (row in step.attributes["cases"]):
        types.cube_match(input_type, args[0], row[0], row[1]) ++ " ? " ++ row_value(row[2] bits.and row[3]) ++ " : "
      String.join(cases, "") ++ row_value(step.attributes["default_value"] bits.and step.attributes["default_care"])
  | step.opcode == "rtl.not": "~" ++ args[0]
  | step.opcode == "rtl.cast":
      def source_type = steps[step.operands[0]].type
      if scalar_width(step.type) && scalar_width(source_type)
      | args[0]
      | def packed = types.pack(source_type, args[0])
        cond
        | scalar_width(step.type): packed
        | scalar_width(source_type): types.unpack(step.type, packed)
        | ~else: "([&]() { const auto packed = " ++ packed ++ "; return " ++ types.unpack(step.type, "packed") ++ "; }())"
  | step.opcode in ["rtl.record_create", "rtl.vector_create"]: types.construct(step.type, args)
  | step.opcode == "rtl.record_get": args[0] ++ "." ++ cpp_name(step.attributes["field"])
  | step.opcode == "rtl.vector_get": args[0] ++ "[" ++ to_string(step.attributes["index"]) ++ "]"
  | step.opcode in ["rtl.vector_index", "rtl.vector_write_set"]:
      def name = {"rtl.vector_index": "vector_index", "rtl.vector_write_set": "vector_write_set"}[step.opcode]
      name ++ "(" ++ String.join(args, ", ") ++ ")"
  | step.opcode in ["rtl.zext", "rtl.trunc", "rtl.extract", "rtl.sext"] && (scalar_carrier_width(step.type) > 64 || scalar_carrier_width(steps[step.operands[0]].type) > 64):
      def target_width = scalar_carrier_width(step.type)
      def source_width = scalar_carrier_width(steps[step.operands[0]].type)
      def helper = if step.opcode == "rtl.sext" | "sign_extend" | "slice"
      def offset = if step.opcode == "rtl.extract" | ", " ++ to_string(step.attributes["low"]) | ""
      "rhodium_rsim::" ++ helper ++ "<" ++ to_string(target_width) ++ ", " ++ to_string(source_width) ++ ">(" ++ args[0] ++ offset ++ ")"
  | step.opcode in ["rtl.zext", "rtl.trunc"]: args[0]
  | step.opcode == "rtl.extract": args[0] ++ " >> " ++ to_string(step.attributes["low"])
  | step.opcode == "rtl.concat" && scalar_carrier_width(step.type) > 64:
      def widths = [scalar_carrier_width(step.type)] ++ step.operands.map(fun (operand): scalar_carrier_width(steps[operand].type))
      "rhodium_rsim::concat<" ++ String.join(widths.map(to_string), ", ") ++ ">(" ++ String.join(args, ", ") ++ ")"
  | step.opcode == "rtl.concat":
      def mutable remaining = scalar_carrier_width(step.type)
      def terms = for List (operand in step.operands, arg in args):
        remaining := remaining - scalar_carrier_width(steps[operand].type)
        if remaining == 0 | arg | "(" ++ arg ++ " << " ++ to_string(remaining) ++ ")"
      String.join(terms, " | ")
  | step.opcode == "rtl.slt" && scalar_carrier_width(steps[step.operands[0]].type) > 64:
      "rhodium_rsim::signed_less(" ++ args[0] ++ ", " ++ args[1] ++ ")"
  | step.opcode in ["rtl.sext", "rtl.slt"]:
      // Flipping the sign bit orders two's-complement values as unsigned.
      // Subtracting that bit afterward instead gives sign extension modulo 2^64.
      def sign = literal(2 ** (scalar_carrier_width(steps[step.operands[0]].type) - 1))
      if step.opcode == "rtl.sext"
      | "(" ++ args[0] ++ " ^ " ++ sign ++ ") - " ++ sign
      | "(" ++ args[0] ++ " ^ " ++ sign ++ ") < (" ++ args[1] ++ " ^ " ++ sign ++ ")"
  | step.opcode in ["rtl.shl", "rtl.shru", "rtl.shrs"]:
      def name = {"rtl.shl": "shift_left", "rtl.shru": "shift_right", "rtl.shrs": "shift_signed"}[step.opcode]
      def width = scalar_carrier_width(step.type)
      def count_width = scalar_carrier_width(steps[step.operands[1]].type)
      if width > 64 || count_width > 64
      | "rhodium_rsim::" ++ name ++ "<" ++ to_string(width) ++ ", " ++ to_string(count_width) ++ ">(" ++ String.join(args, ", ") ++ ")"
      | name ++ "(" ++ args[0] ++ ", " ++ args[1] ++ ", " ++ to_string(width) ++ ")"
  | binary.has_key(step.opcode): args[0] ++ " " ++ binary[step.opcode] ++ " " ++ args[1]
  | step.opcode == "rtl.mux_lookup":
      def selector_type = steps[step.operands[0]].type
      def cases = for List (key in step.attributes["keys"], value in args.drop(2)):
        "(" ++ args[0] ++ " == " ++ types.constant(selector_type, key) ++ ") ? " ++ value ++ " : "
      String.join(cases, "") ++ args[1]
  | ~else: error(~who: #'rsim, "missing expression renderer for " ++ step.opcode)

/* Collect planned constants and aggregate decode rows into one immutable pool.
   Only unconditional constant steps receive step-to-symbol bindings: a decode
   must still select its row on every evaluation. */
fun emit_constants(steps :~ List.of(RsimStep), constant_values :: Map, types :: CppTypes) :: Map:
  def bindings = MutableMap{}
  for (step in steps, index in 0..steps.length()):
    when constant_values.has_key(index)
    | bindings[index] := types.constant_reference(step.type, constant_values[index])
    when aggregate_decode(step)
    | for (row in step.attributes["cases"]): types.constant_reference(step.type, row[2] bits.and row[3])
      types.constant_reference(step.type, step.attributes["default_value"] bits.and step.attributes["default_care"])
  bindings.snapshot()

/* Spell a physical slot without dereferencing it, for pointer assignment or
   indexed gathers. Group names are private and follow allocation order. */
fun scratch_reference(slot :: ScratchSlot, ~index: index :: String = to_string(slot.index)) :: String:
  "scratch.g" ++ to_string(slot.group) ++ "[" ++ index ++ "]"

/* Render one planned backing reference against this evaluation's current bank.
   Projection parentheses retain dereference precedence for nested paths. Direct
   state roots resolve afresh; retained indirect roots require the cache planner's
   separate lifetime proof. */
fun storage_reference(binding :: StorageRef, constants :: Map) :: String:
  def root = binding.root
  def mutable value:
    cond
    | root is_a ConstantStorage: constants[root.value]
    | root is_a ScratchSlot: (if root.indirect | "*" | "") ++ scratch_reference(root)
    | root.kind == "state": "current.s" ++ to_string(root.slot)
    | root.kind == "sync_read": "current.r" ++ to_string(root.slot)
    | root.kind == "foreign_result": "current." ++ foreign_slot(root.slot, root.result)
    | ~else: error(~who: #'rsim, "unknown state backing: " ++ root.kind)
  for (member in binding.path):
    value := "(" ++ value ++ ")" ++ (if member is_a String | "." ++ cpp_name(member) | "[" ++ to_string(member) ++ "]")
  value

/* Render one original schedule index with its usual leaf normalization.
   Constant aliases bind namespace storage, never another evaluator's locals;
   callers choose the dependency-ordered indices without renumbering operands. */
fun step_declaration(index :: Nat, steps :~ List.of(RsimStep), types :: CppTypes, constants :: Map, ~destination: destination :: maybe(String) = #false, ~bindings: bindings :: Map = {}) :: String:
  if constants.has_key(index)
  | "  [[maybe_unused]] const auto& " ++ ref(index) ++ " = " ++ constants[index] ++ ";"
  | def step = steps[index]
    def array = match step.opcode
    | "rtl.vector_create": array_construction(index, step, types, bindings, destination)
    | "rtl.vector_inject": array_update(index, step, types, destination)
    | ~else: #false
    if array
    | array
    | def rendered = expression(step, steps, types)
      // External aggregates need leaf masking. Internal aggregate operations use
      // normalized members; scalar expressions are masked at every boundary.
      def value:
        if step.opcode == "input" || (!record_type(step.type) && !vector_type(step.type))
        | types.normalize(step.type, rendered)
        | rendered
      cond
      | aggregate_state_read(step) || aggregate_decode(step) || (aggregate_projection(step) && !destination): "  [[maybe_unused]] const auto& " ++ ref(index) ++ " = " ++ value ++ ";"
      | destination: "  " ++ destination ++ " = " ++ value ++ ";\n  [[maybe_unused]] const auto& " ++ ref(index) ++ " = " ++ destination ++ ";"
      | ~else: "  [[maybe_unused]] const " ++ types.name(step.type) ++ " " ++ ref(index) ++ " = " ++ value ++ ";"

/* Emit each private producer once within its planned lexical branch path.
   The planner admits sharing only within that path, so later uses see the first
   declaration. Nested selections assign complete locals; external values and
   selectors retain their unconditional bindings. */
fun emit_branch_producer(value :: Nat, absorbed :: Set, steps :~ List.of(RsimStep), types :: CppTypes,
                         constants :: Map, source :: MutableList, indent :: String, emitted :: MutableSet):
  when value in absorbed && !(value in emitted)
  | def step = steps[value]
    if step.opcode == "rtl.mux_lookup"
    | source.add(indent ++ types.name(step.type) ++ " " ++ ref(value) ++ ";")
      emit_branch_assignment(value, absorbed, ref(value), steps, types, constants, source, indent, emitted)
    | for (operand in step.operands): emit_branch_producer(operand, absorbed, steps, types, constants, source, indent, emitted)
      source.add(indent ++ step_declaration(value, steps, types, constants).trim())
    emitted.add(value)

/* Evaluate only the selected pure cone, assigning the complete destination on
   every path, including holds. Lookup order and the default match expression
   emission; current state remains immutable throughout all conditional work. */
fun emit_branch_assignment(value :: Nat, absorbed :: Set, target :: String, steps :~ List.of(RsimStep),
                           types :: CppTypes, constants :: Map, source :: MutableList, indent :: String, emitted :: MutableSet):
  def step = steps[value]
  if value in absorbed && step.opcode == "rtl.mux_lookup"
  | def selector = step.operands[0]
    for (key in step.attributes["keys"], branch in 0..step.attributes["keys"].length()):
      source.add(indent ++ (if branch == 0 | "if (" | "else if (") ++ ref(selector) ++ " == " ++ types.constant(steps[selector].type, key) ++ ") {")
      emit_branch_assignment(step.operands[branch + 2], absorbed, target, steps, types, constants, source, indent ++ "  ", emitted)
      source.add(indent ++ "}")
    when step.attributes["keys"].length() > 0 | source.add(indent ++ "else {")
    emit_branch_assignment(step.operands[1], absorbed, target, steps, types, constants, source,
                           indent ++ (if step.attributes["keys"].length() > 0 | "  " | ""), emitted)
    when step.attributes["keys"].length() > 0 | source.add(indent ++ "}")
  | emit_branch_producer(value, absorbed, steps, types, constants, source, indent, emitted)
    source.add(indent ++ target ++ " = " ++ ref(value) ++ ";")

/* Materialize a scheduled conditional result in owned local or scratch storage.
   Branch-local references cannot escape their scope; consumers see one fully
   assigned value regardless of how many uses the mux result has. */
fun emit_conditional_step(value :: Nat, conditional :: RsimConditional, destination :: maybe(String),
                          plan :: RsimSchedule, types :: CppTypes, constants :: Map, source :: MutableList):
  unless destination | source.add("  [[maybe_unused]] " ++ types.name(plan.steps[value].type) ++ " " ++ ref(value) ++ ";")
  emit_branch_assignment(value, conditional.steps, destination || ref(value), plan.steps, types, constants, source, "  ", MutableSet{})
  when destination | source.add("  [[maybe_unused]] const auto& " ++ ref(value) ++ " = " ++ destination ++ ";")

/* Render one planned final consumer without executing effects or publishing
   staged state. The planner owns its value/storage uses and sampling order; this
   renderer owns C++ expressions and the frame/output representation. */
fun emit_sink(sink :: RsimSink, plan :: RsimSchedule, types :: CppTypes, constants :: Map, source :: MutableList):
  def index = sink.index
  def emitted = MutableSet{}
  match sink.kind
  | "foreign":
      def call = plan.foreign_calls[index]
      def slot = to_string(index)
      source.add("  frame.call" ++ slot ++ "_enable = " ++ ref(call.enable) ++ " != 0;")
      if sink.conditional
      | for (arg in 0..call.arguments.length()): source.add("  frame.call" ++ slot ++ "_arg" ++ to_string(arg) ++ " = {};")
        source.add("  if (frame.call" ++ slot ++ "_enable) {")
        for (argument in call.arguments, arg in 0..call.arguments.length()):
          emit_branch_producer(argument, sink.conditional.steps, plan.steps, types, constants, source, "    ", emitted)
          source.add("    frame.call" ++ slot ++ "_arg" ++ to_string(arg) ++ " = " ++ ref(argument) ++ ";")
        source.add("  }")
      | for (argument in call.arguments, arg in 0..call.arguments.length()):
          source.add("  frame.call" ++ slot ++ "_arg" ++ to_string(arg) ++ " = " ++ ref(argument) ++ ";")
      for (result_index in 0..call.import_decl.results.length()):
        def name = foreign_slot(index, result_index)
        source.add("  next." ++ name ++ " = current." ++ name ++ ";")
  | "assertion":
      // Only sample predicates here; tick reports failures before any effects.
      def assertion = plan.assertions[index]
      def active = ref(assertion.guard) ++ " != 0 && " ++ ref(assertion.reset) ++ " == 0"
      if sink.conditional
      | source.add("  frame.assertion" ++ to_string(index) ++ "_failed = false;\n  if (" ++ active ++ ") {")
        emit_branch_producer(assertion.condition, sink.conditional.steps, plan.steps, types, constants, source, "    ", emitted)
        source.add("    frame.assertion" ++ to_string(index) ++ "_failed = " ++ ref(assertion.condition) ++ " == 0;\n  }")
      | source.add("  frame.assertion" ++ to_string(index) ++ "_failed = " ++ active ++ " && " ++ ref(assertion.condition) ++ " == 0;")
  | "register":
      def reg = plan.registers[index]
      def target = "next.s" ++ to_string(index)
      cond
      | sink.conditional:
          when reg.reset != #false
          | source.add("  if (" ++ ref(reg.reset) ++ ") {\n    " ++ target ++ " = " ++ ref(reg.reset_value) ++ ";\n  } else {")
          emit_branch_assignment(reg.next_value, sink.conditional.steps, target, plan.steps, types, constants, source,
                                 if reg.reset != #false | "    " | "  ", emitted)
          when reg.reset != #false | source.add("  }")
      | sink.array:
          when reg.reset != #false
          | source.add("  if (" ++ ref(reg.reset) ++ ") {\n    " ++ target ++ " = " ++ ref(reg.reset_value) ++ ";\n  } else {")
          emit_array_assignment(reg.next_value, sink.array.steps, target, plan.steps, types, source, if reg.reset != #false | "    " | "  ")
          when reg.reset != #false | source.add("  }")
      | ~else:
          def value:
            if reg.reset | ref(reg.reset) ++ " ? " ++ ref(reg.reset_value) ++ " : " ++ ref(reg.next_value) | ref(reg.next_value)
          source.add("  " ++ target ++ " = " ++ value ++ ";")
  | "sync_read":
      // Ports and consumers sample old storage; disabled results are unspecified.
      def read = plan.reads[index]
      def enabled = ref(read.enable) ++ " != 0" ++ (if read.write_mode | " && " ++ ref(read.write_mode) ++ " == 0" | "")
      def value = "vector_index(memory" ++ to_string(read.memory) ++ "_, " ++ ref(read.address) ++ ")"
      if sink.conditional
      | source.add("  if (" ++ enabled ++ ") {")
        emit_branch_producer(read.address, sink.conditional.steps, plan.steps, types, constants, source, "    ", emitted)
        source.add("    next.r" ++ to_string(index) ++ " = " ++ value ++ ";\n  } else {\n    next.r" ++ to_string(index) ++ " = {};\n  }")
      | source.add("  next.r" ++ to_string(index) ++ " = (" ++ enabled ++ ") ? " ++ value ++ " : " ++ types.name(plan.memories[read.memory].type) ++ "{};")
  | "write":
      def write = plan.writes[index]
      def prefix = "frame.write" ++ to_string(index)
      def enabled = ref(write.enable) ++ " != 0" ++ (if write.write_mode | " && " ++ ref(write.write_mode) ++ " != 0" | "")
      cond
      | sink.conditional:
          source.add("  " ++ prefix ++ "_enable = " ++ enabled ++ ";\n  " ++ prefix ++ "_address = 0;\n  " ++ prefix ++ "_data = {};\n  if (" ++ prefix ++ "_enable) {")
          for (value in [write.address, write.data] ++ (if write.mask_value == #false | [] | [write.mask_value])):
            emit_branch_producer(value, sink.conditional.steps, plan.steps, types, constants, source, "    ", emitted)
          source.add("    " ++ prefix ++ "_address = " ++ ref(write.address) ++ ";")
          if write.mask_value
          | def old = "write" ++ to_string(index) ++ "_old"
            def data = types.masked_merge(plan.memories[write.memory].type, old, ref(write.data), ref(write.mask_value), scalar_carrier_width(plan.steps[write.mask_value].type), write.mask_granularity)
            source.add("    const auto " ++ old ++ " = vector_index(memory" ++ to_string(write.memory) ++ "_, " ++ ref(write.address) ++ ");\n    " ++ prefix ++ "_data = " ++ data ++ ";")
          | source.add("    " ++ prefix ++ "_data = " ++ ref(write.data) ++ ";")
          source.add("  }")
      | write.mask_value:
        // Skip old-word loads and merges for disabled ports, including shared
        // ports in read mode. Still initialize every frame field on each attempt.
        // Enabled merges sample old storage before any commit, even when the
        // mask comes from a stored read result; vector_index handles bad addresses.
          def old = "write" ++ to_string(index) ++ "_old"
          def data = types.masked_merge(plan.memories[write.memory].type, old, ref(write.data), ref(write.mask_value), scalar_carrier_width(plan.steps[write.mask_value].type), write.mask_granularity)
          source.add("  " ++ prefix ++ "_address = " ++ ref(write.address) ++ ";\n  " ++ prefix ++ "_enable = " ++ enabled ++ ";\n  " ++ prefix ++ "_data = {};\n  if (" ++ prefix ++ "_enable) {\n    const auto " ++ old ++ " = vector_index(memory" ++ to_string(write.memory) ++ "_, " ++ ref(write.address) ++ ");\n    " ++ prefix ++ "_data = " ++ data ++ ";\n  }")
      | ~else: source.add("  " ++ prefix ++ "_address = " ++ ref(write.address) ++ ";\n  " ++ prefix ++ "_data = " ++ ref(write.data) ++ ";\n  " ++ prefix ++ "_enable = " ++ enabled ++ ";")
  | "output":
      def port = plan.outputs[index]
      source.add("  next_outputs." ++ cpp_name(port.name) ++ " = " ++ ref(port.value) ++ ";")
  | ~else: error(~who: #'rsim, "unknown evaluation sink: " ++ sink.kind)

/* Assign one exclusive array tree into inactive state. Each selected path
   copies one immutable leaf, then applies updates from base to outermost value.
   Selection order matches mux_lookup; invalid indices preserve the base.
   Precomputed replacements never alias this destination, including old-state
   reads and shared intermediate versions sampled before any state publication. */
fun emit_array_assignment(value :: Nat, absorbed :: Set, target :: String,
                          steps :~ List.of(RsimStep), types :: CppTypes,
                          source :: MutableList, indent :: String):
  if !(value in absorbed)
  | source.add(indent ++ target ++ " = " ++ ref(value) ++ ";")
  | def step = steps[value]
    if step.opcode == "rtl.vector_inject"
    | emit_array_assignment(step.operands[0], absorbed, target, steps, types, source, indent)
      source.add(indent ++ "if (" ++ ref(step.operands[1]) ++ " < " ++ to_string(step.type.length) ++ ") " ++ target ++ "[" ++ ref(step.operands[1]) ++ "] = " ++ ref(step.operands[2]) ++ ";")
    | def selector = step.operands[0]
      for (key in step.attributes["keys"], branch in 0..step.attributes["keys"].length()):
        source.add(indent ++ (if branch == 0 | "if (" | "else if (") ++ ref(selector) ++ " == " ++ types.constant(steps[selector].type, key) ++ ") {")
        emit_array_assignment(step.operands[branch + 2], absorbed, target, steps, types, source, indent ++ "  ")
        source.add(indent ++ "}")
      when step.attributes["keys"].length() > 0 | source.add(indent ++ "else {")
      emit_array_assignment(step.operands[1], absorbed, target, steps, types, source, indent ++ (if step.attributes["keys"].length() > 0 | "  " | ""))
      when step.attributes["keys"].length() > 0 | source.add(indent ++ "}")

/* Copy an update's base once into fresh local or uniquely owned scratch storage,
   then replace its selected lane. Sources cannot alias this new destination;
   the bounds guard preserves the backend's out-of-range hold choice. */
fun array_update(index :: Nat, step :: RsimStep, types :: CppTypes, destination :: maybe(String)) :: String:
  def target = destination || ("array" ++ to_string(index))
  def address = ref(step.operands[1])
  "  " ++ (if destination | "" | types.name(step.type) ++ " ") ++ target ++ " = " ++ ref(step.operands[0]) ++ ";\n"
    ++ "  if (" ++ address ++ " < " ++ to_string(step.type.length) ++ ") " ++ target ++ "[" ++ address ++ "] = " ++ ref(step.operands[2]) ++ ";\n"
    ++ "  [[maybe_unused]] const auto& " ++ ref(index) ++ " = " ++ target ++ ";"

/* Render a constructor's planned runs into a fresh local or boundary array.
   Recognition and source addressing live in the planners; this function owns
   loop spelling and declarations. Small local constructors keep initializers. */
fun array_construction(index :: Nat, step :: RsimStep, types :: CppTypes, bindings :: Map, destination :: maybe(String)) :: maybe(String):
  def runs = plan_array(step.operands, bindings)
  def looped = for any (run in runs): !(run is_a ArrayElement)
  if destination || looped
  | def target = destination || ("array" ++ to_string(index))
    def lines = for List (run in runs):
      if run is_a ArrayElement
      | "  " ++ target ++ "[" ++ to_string(run.offset) ++ "] = " ++ ref(run.value) ++ ";"
      | def value:
          if run is_a ArrayFill
          | ref(run.value)
          | def slot = run.source
            def offset = to_string(slot.index) ++ (if run.stride < 0 | " - i * " ++ to_string(-run.stride) | " + i * " ++ to_string(run.stride))
            (if slot.indirect | "*" | "") ++ scratch_reference(slot, ~index: offset)
        "  for (std::size_t i = 0; i < " ++ to_string(run.length) ++ "; ++i) " ++ target ++ "[" ++ to_string(run.offset) ++ " + i] = " ++ value ++ ";"
    (if destination | "" | "  " ++ types.name(step.type) ++ " " ++ target ++ ";\n")
      ++ String.join(lines, "\n")
      ++ "\n  [[maybe_unused]] const auto& " ++ ref(index) ++ " = " ++ target ++ ";"
  | #false

/* Keep a body inline when its total work fits the budget, even though planning
   separates values and consumers. A lone oversized item still needs no helper
   boundary; separation alone must not add calls to otherwise small models. */
fun needs_helpers(regions :: List.of(RsimRegion), budget :: PosInt) :: Boolean:
  def mutable cost = 0
  for (region in regions): cost := cost + region.cost
  regions.length() > 1 && cost > budget

/* Declare phase-local reusable buffers and bounded sampling helpers. Scratch is
   initialized once per model. Eager emission overwrites before every read; the
   optional cache retains values and immutable-backed pointers with invalidation. Current/next
   references select distinct banks for the whole pre-edge phase. Pure helpers write only scratch; consumer helpers
   read scratch and prepare their destinations. No scratch reference escapes
   into the frame. */
fun declare_regions(regions :: List.of(RsimRegion), layout :: BoundaryStorage, phase :: String, destination :: String, helpers :: Boolean, header :: MutableList):
  when helpers
  | def declarations = for List (group in layout.groups, index in 0..layout.groups.length()):
      def carrier = (if group.indirect | "const " | "") ++ group.carrier ++ (if group.indirect | "*" | "")
      "    std::array<" ++ carrier ++ ", " ++ to_string(group.count) ++ "> g" ++ to_string(index) ++ ";"
    header.add("  struct " ++ phase ++ "Scratch {\n" ++ String.join(declarations, "\n") ++ "\n  };\n  mutable " ++ phase ++ "Scratch " ++ phase ++ "_scratch_{};")
    for (region in regions, index in 0..regions.length()):
      def consumer = region.sinks.length() > 0
      header.add("  void " ++ phase ++ "_region" ++ to_string(index) ++ "(" ++ (if consumer | "const " | "") ++ phase ++ "Scratch& scratch, const State& current" ++ (if consumer | ", " ++ destination | "") ++ ") const;")

/* Emit helpers in schedule order, importing only direct boundary operands and
   shared constants. Store crossing results directly in their slots; local-only
   computations keep ordinary locals. Value helpers have no next-state, frame,
   or output destination. Consumer helpers cannot overwrite scratch. Effects
   and publication stay outside both kinds of helper. */
fun emit_regions(regions :: List.of(RsimRegion), layout :: BoundaryStorage, phase :: String, destination :: String, helpers :: Boolean, plan :: RsimSchedule, types :: CppTypes, constants :: Map, source :: MutableList):
  when helpers
  | for (region in regions, index in 0..regions.length()):
      def consumer = region.sinks.length() > 0
      source.add("RHODIUM_RSIM_NOINLINE void Model::" ++ phase ++ "_region" ++ to_string(index) ++ "([[maybe_unused]] " ++ (if consumer | "const " | "") ++ phase ++ "Scratch& scratch, [[maybe_unused]] const State& current" ++ (if consumer | ", [[maybe_unused]] " ++ destination | "") ++ ") const {")
      for (input in region.inputs):
        source.add("  [[maybe_unused]] const auto& " ++ ref(input) ++ " = " ++ storage_reference(layout.bindings[input], constants) ++ ";")
      for (constant in region.constants):
        source.add(step_declaration(constant, plan.steps, types, constants))
      for (step in region.steps):
        unless constants.has_key(step)
        | def binding = layout.bindings.get(step, #false)
          def slot = scratch_slot(binding)
          cond
          | region.conditionals.has_key(step):
              emit_conditional_step(step, region.conditionals[step], if slot | scratch_reference(slot) | #false, plan, types, constants, source)
          // All branches are normalized aggregate lvalues backed for this whole
          // invocation. Taking the selected lvalue's address performs no copy.
          | slot && slot.indirect:
              source.add("  " ++ scratch_reference(slot) ++ " = &(" ++ expression(plan.steps[step], plan.steps, types) ++ ");\n  [[maybe_unused]] const auto& " ++ ref(step) ++ " = " ++ storage_reference(binding, constants) ++ ";")
          | ~else:
              // Only owned slots need writes. The layout has already resolved
              // which crossing projections borrow and which require a copy.
              def destination = if slot | scratch_reference(slot) | #false
              source.add(step_declaration(step, plan.steps, types, constants, ~destination: destination, ~bindings: layout.bindings))
      for (sink in region.sinks): emit_sink(sink, plan, types, constants, source)
      source.add("}")

/* Small bodies stay inline in their coordinator. Larger bodies call eager
   helpers and dirty cacheable helpers in unchanged order, passing scratch by
   reference. Clear a dirty bit only after its helper returns successfully. */
fun emit_region_calls(regions :: List.of(RsimRegion), phase :: String, destination :: String, helpers :: Boolean, cache :: RsimRegionCache, plan :: RsimSchedule, types :: CppTypes, constants :: Map, source :: MutableList):
  if helpers
  | for (region in regions, index in 0..regions.length()):
      def call = phase ++ "_region" ++ to_string(index) ++ "(" ++ phase ++ "_scratch_, current" ++ (if region.sinks.length() > 0 | ", " ++ destination | "") ++ ");"
      if index in cache.regions
      | def dirty = phase ++ "_dirty_[" ++ to_string((index - index mod 64) / 64) ++ "]"
        def bit = literal(2 ** (index mod 64))
        source.add("  if (" ++ dirty ++ " & " ++ bit ++ ") {\n    " ++ call ++ "\n    " ++ dirty ++ " &= ~" ++ bit ++ ";\n  }")
      | source.add("  " ++ call)
  | for (region in regions):
      for (index in region.steps):
        if region.conditionals.has_key(index)
        | emit_conditional_step(index, region.conditionals[index], #false, plan, types, constants, source)
        | source.add(step_declaration(index, plan.steps, types, constants))
      for (sink in region.sinks): emit_sink(sink, plan, types, constants, source)

/* Produce model sources and optional wide support, with private state per model object.
   The evaluator writes only inactive state; tick publishes it only after every
   next-state expression and pending write has sampled the old state. Memory
   arrays live outside the frame, so evaluation never copies whole memories.
   Private budget, module-cut, and cache controls permit experiments without
   extending target options. */
fun emit_rsim(plan :: RsimSchedule, ~region_budget: region_budget :: PosInt = 4096, ~cache_regions: cache_regions :: Boolean = #false, ~module_cuts: module_cuts :: Boolean = #false) :: List.of(String):
  def evaluation = plan_conditionals(plan, build_evaluation_plan(plan))
  def pre_regions = build_regions(plan, evaluation, evaluation.pre_edge, ~budget: region_budget, ~module_cuts: module_cuts)
  def output_regions = build_regions(plan, evaluation, evaluation.outputs, ~budget: region_budget, ~module_cuts: module_cuts)
  def pre_helpers = needs_helpers(pre_regions, region_budget)
  def output_helpers = needs_helpers(output_regions, region_budget)
  def namespace = "rsim_" ++ cpp_name(plan.name)
  def types = CppTypes()
  for (step in plan.steps):
    types.name(step.type)
    // An aggregate-to-aggregate cast may need a wide temporary even when all
    // stored leaves are narrow. Decide support packaging before the header.
    when step.opcode == "rtl.cast" && step.type.packed_width() > 64
    | types.wide := #true
  for (memory in plan.memories): types.name(memory.type)
  // Live calls own every ABI result even when no scheduled value consumes it.
  // Discover these types before deciding whether to package wide support.
  for (call in plan.foreign_calls):
    for (type in call.import_decl.input_types ++ call.import_decl.results.map(fun (result): result.type)):
      types.name(type)
  // Resolve shared constant symbols before layout so projected bindings can
  // name them even in consumers whose original operands were only projections.
  def constants = emit_constants(plan.steps, evaluation.constants, types)
  def pre_layout = boundary_layout(pre_regions, plan, types, constants)
  def output_layout = boundary_layout(output_regions, plan, types, constants)
  def empty_cache = RsimRegionCache(Set{}, {}, 0)
  def pre_cache = if cache_regions && pre_helpers | plan_region_cache(plan, evaluation, pre_regions, pre_layout) | empty_cache
  def output_cache = if cache_regions && output_helpers | plan_region_cache(plan, evaluation, output_regions, output_layout) | empty_cache
  def caches = [["pre", pre_cache], ["output", output_cache]]
  /* Render deterministic bit updates for both independently consumed phases. */
  fun invalidate(root :: RsimCacheSource) :: String:
    def lines = MutableList[]
    for (entry in caches):
      def cache :: RsimRegionCache = entry[1]
      def masks = cache.invalidations.get(root, {})
      for (word in 0..cache.words):
        when masks.has_key(word)
        | lines.add("    " ++ entry[0] ++ "_dirty_[" ++ to_string(word) ++ "] |= " ++ literal(masks[word]) ++ ";")
    String.join(lines.snapshot(), "\n")
  def input_checks = MutableList[]
  for (port in plan.inputs, index in 0..plan.inputs.length()):
    def invalidation = invalidate(RsimCacheSource("input", index))
    when invalidation != ""
    | def field = cpp_name(port.name)
      input_checks.add("  if (!" ++ types.equal(port.type, "inputs." ++ field, "cached_inputs_." ++ field) ++ ") {\n" ++ invalidation ++ "\n    cached_inputs_." ++ field ++ " = inputs." ++ field ++ ";\n  }")
  def state_checks = MutableList[]
  /* Compare committed logical resources before switching banks. Failed attempts
     must not invalidate against unpublished next-state or snapshot that state. */
  fun state_check(root :: RsimCacheSource, type :: HardwareType, field :: String):
    def invalidation = invalidate(root)
    when invalidation != ""
    | state_checks.add("  if (!" ++ types.equal(type, "states_[active_state_]." ++ field, "next." ++ field) ++ ") {\n" ++ invalidation ++ "\n  }")
  for (reg in plan.registers, index in 0..plan.registers.length()):
    state_check(RsimCacheSource("register", index), reg.type, "s" ++ to_string(index))
  for (read in plan.reads, index in 0..plan.reads.length()):
    state_check(RsimCacheSource("sync_read", index), plan.memories[read.memory].type, "r" ++ to_string(index))
  for (call in plan.foreign_calls, index in 0..plan.foreign_calls.length()):
    for (result in call.import_decl.results, result_index in 0..call.import_decl.results.length()):
      state_check(RsimCacheSource("foreign", index, result_index), result.type, foreign_slot(index, result_index))
  def header = MutableList["// Declares the typed simulator for " ++ plan.name ++ ".",
                           "// SPDX-License-Identifier: Apache-2.0", "#pragma once", "#include <cstdint>", "#include <array>" ++ (if types.wide | "\n#include \"rsim-bits.hpp\"" | ""),
                           "namespace " ++ namespace ++ " {", String.join(types.declarations.snapshot(), "\n"), "class Model {", "public:",
                           "  struct Inputs {"]
  for (port in plan.inputs): header.add("    " ++ types.name(port.type) ++ " " ++ cpp_name(port.name) ++ "{};")
  header.add("  } inputs;\n  struct Outputs {")
  for (port in plan.outputs): header.add("    " ++ types.name(port.type) ++ " " ++ cpp_name(port.name) ++ "{};")
  header.add("  };\n  void eval();\n  void tick();\n  const Outputs& outputs() const { return outputs_; }\nprivate:\n  struct State {")
  // Both owned banks start initialized. Each tick overwrites the inactive bank
  // completely; publishing its index avoids copying state or retaining self-pointers.
  for (reg in plan.registers, index in 0..plan.registers.length()):
    header.add("    " ++ types.name(reg.type) ++ " s" ++ to_string(index) ++ "; // " ++ String.join(reg.path ++ [reg.name], "/"))
  for (read in plan.reads, index in 0..plan.reads.length()):
    header.add("    " ++ types.name(plan.memories[read.memory].type) ++ " r" ++ to_string(index) ++ "; // synchronous read result")
  for (call in plan.foreign_calls, index in 0..plan.foreign_calls.length()):
    for (result_index in 0..call.import_decl.results.length()):
      header.add("    " ++ types.name(call.import_decl.results[result_index].type) ++ " " ++ foreign_slot(index, result_index) ++ "; // held foreign result")
  header.add("  };\n  State states_[2]{};\n  unsigned active_state_ = 0;")
  for (memory in plan.memories, index in 0..plan.memories.length()):
    header.add("  std::array<" ++ types.storage_name(memory.type) ++ ", " ++ to_string(memory.depth) ++ "> memory" ++ to_string(index) ++ "_{}; // " ++ String.join(memory.path ++ [memory.name], "/"))
  header.add("  struct Frame {")
  for (call in plan.foreign_calls, index in 0..plan.foreign_calls.length()):
    def prefix = "call" ++ to_string(index)
    header.add("    bool " ++ prefix ++ "_enable;")
    for (arg in 0..call.arguments.length()):
      header.add("    " ++ types.name(call.import_decl.input_types[arg]) ++ " " ++ prefix ++ "_arg" ++ to_string(arg) ++ ";")
  for (index in 0..plan.assertions.length()):
    header.add("    bool assertion" ++ to_string(index) ++ "_failed;")
  for (write in plan.writes, index in 0..plan.writes.length()):
    def prefix = "write" ++ to_string(index)
    header.add("    std::uint64_t " ++ prefix ++ "_address;\n    " ++ types.name(plan.memories[write.memory].type) ++ " " ++ prefix ++ "_data;\n    bool " ++ prefix ++ "_enable;")
  header.add("  };\n  Outputs outputs_;\n  Frame evaluate(const State& current, State& next) const;")
  for (entry in caches):
    def cache :: RsimRegionCache = entry[1]
    when cache.words > 0
    | header.add("  mutable std::array<std::uint64_t, " ++ to_string(cache.words) ++ "> " ++ entry[0] ++ "_dirty_{{" ++ String.join(for List (word in 0..cache.words): "~UINT64_C(0)", ", ") ++ "}};")
  when input_checks.length() > 0
  | header.add("  Inputs cached_inputs_{};\n  void observe_inputs();")
  declare_regions(pre_regions, pre_layout, "pre", "State& next, [[maybe_unused]] Frame& frame", pre_helpers, header)
  declare_regions(output_regions, output_layout, "output", "Outputs& next_outputs", output_helpers, header)
  header.add("};\n}")
  def source = MutableList["// Evaluates " ++ plan.name ++ " with simultaneous state commits.",
                           "// SPDX-License-Identifier: Apache-2.0", "#include \"" ++ plan.name ++ ".hpp\"", "#include <cstddef>"]
  when plan.assertions.length() > 0
  | source.add("#include <stdexcept>")
  when plan.foreign_calls.length() > 0
  | source.add("#include <climits>\n#include <cstring>\n#include <type_traits>")
  source.add("namespace " ++ namespace ++ " {")
  for (line in types.equality_declarations): source.add(line)
  when input_checks.length() > 0
  | source.add("void Model::observe_inputs() {\n" ++ String.join(input_checks.snapshot(), "\n") ++ "\n}")
  when plan.foreign_calls.length() > 0
  | source.add("static_assert(CHAR_BIT == 8 && sizeof(short) == 2 && sizeof(int) == 4 && sizeof(long long) == 8, \"unsupported native foreign ABI\");")
    // A private namespace isolates declarations from model/helper names while
    // C linkage preserves the authored external symbol without mangling.
    source.add("namespace foreign {")
    def declared = MutableSet{}
    for (call in plan.foreign_calls):
      def imp = call.import_decl
      unless imp.name in declared
      | declared.add(imp.name)
        def result = if imp.has_result() | foreign_type(imp.return_result().type) | "void"
        def out_types = for List (result in imp.results.filter(~keep: fun (result): result.direction == "out")):
          foreign_type(result.type) ++ "*"
        def input_types = imp.input_types.map(fun (type): if foreign_packed(type) | "const std::uint32_t*" | foreign_type(type))
        source.add("extern \"C\" " ++ result ++ " " ++ imp.name ++ "(" ++ String.join(input_types ++ out_types, ", ") ++ ");")
    source.add("}\ntemplate <typename T>\nstatic T foreign_arg(std::uint64_t value) {\n  const auto bits = static_cast<typename std::make_unsigned<T>::type>(value);\n  T result;\n  std::memcpy(&result, &bits, sizeof(result));\n  return result;\n}")
  // Runtime guards precede every variable shift. Keeping them in ordinary
  // functions also avoids invalid constant-shift diagnostics in unreachable
  // expression branches. Counts remain unsigned 64-bit values until checked.
  def opcodes = plan.steps.map(fun (step): step.opcode)
  // Partial RTL results may be computed behind an unselected mux. Guard every
  // array access instead of throwing or invoking C++ undefined behavior. Zero
  // reads and skipped invalid writes are backend choices for unconstrained
  // results; loop order does not create a hardware collision-priority contract.
  def masked_writes = plan.writes.filter(~keep: fun (write): write.mask_value != #false)
  when "rtl.vector_index" in opcodes || "memory_read" in opcodes || plan.reads.length() > 0 || masked_writes.length() > 0
  | source.add("template <typename T, std::size_t N>\nstatic T vector_index(const std::array<T, N>& value, std::uint64_t index) {\n  return index < N ? value[index] : T{};\n}")
  when "rtl.vector_write_set" in opcodes
  | source.add("template <typename T, std::size_t N, typename Enable, typename Index, std::size_t P>\nstatic std::array<T, N> vector_write_set(std::array<T, N> value, const std::array<Enable, P>& enables, const std::array<Index, P>& indices, const std::array<T, P>& elements) {\n  for (std::size_t port = 0; port < P; ++port) {\n    if (enables[port] != 0 && indices[port] < N) value[indices[port]] = elements[port];\n  }\n  return value;\n}")
  // Emit narrow helpers only when called; models with exclusively wide shift
  // operations use the shared support header and need no unused local functions.
  def narrow_shifts = plan.steps.filter(~keep: fun (step): step.opcode in ["rtl.shl", "rtl.shru", "rtl.shrs"] && scalar_carrier_width(step.type) <= 64 && scalar_carrier_width(plan.steps[step.operands[1]].type) <= 64).map(fun (step): step.opcode)
  for (entry in [["rtl.shl", "shift_left", "<<"], ["rtl.shru", "shift_right", ">>"]]):
    when entry[0] in narrow_shifts
    | source.add("static inline std::uint64_t " ++ entry[1] ++ "(std::uint64_t value, std::uint64_t amount, unsigned width) {\n  return amount >= width ? UINT64_C(0) : value " ++ entry[2] ++ " amount;\n}")
  when "rtl.shrs" in narrow_shifts
  | source.add("static inline std::uint64_t shift_signed(std::uint64_t value, std::uint64_t amount, unsigned width) {\n  const bool negative = (value >> (width - 1)) != 0;\n  if (amount >= width) return negative ? ~UINT64_C(0) : UINT64_C(0);\n  if (amount == 0) return value;\n  return (value >> amount) | (negative ? (~UINT64_C(0) << (width - amount)) : UINT64_C(0));\n}")
  for (line in types.constant_declarations): source.add(line)
  when pre_helpers || output_helpers
  | // Preserve the compilation boundary even under optimization/LTO. Applying
    // this only to region helpers leaves expression/runtime helpers optimizable.
    source.add("#if defined(_MSC_VER)\n#define RHODIUM_RSIM_NOINLINE __declspec(noinline)\n#elif defined(__GNUC__) || defined(__clang__)\n#define RHODIUM_RSIM_NOINLINE __attribute__((noinline))\n#else\n#define RHODIUM_RSIM_NOINLINE\n#endif")
    emit_regions(pre_regions, pre_layout, "pre", "State& next, [[maybe_unused]] Frame& frame", pre_helpers, plan, types, constants, source)
    emit_regions(output_regions, output_layout, "output", "Outputs& next_outputs", output_helpers, plan, types, constants, source)
    source.add("#undef RHODIUM_RSIM_NOINLINE")
  // Every next-state and frame field is assigned on each attempt, including
  // disabled-call holds. Failed assertions may dirty the inactive bank, but
  // retries overwrite it without reading stale values or clearing either bank.
  source.add("Model::Frame Model::evaluate([[maybe_unused]] const State& current, [[maybe_unused]] State& next) const {\n  Frame frame;")
  emit_region_calls(pre_regions, "pre", "next, frame", pre_helpers, pre_cache, plan, types, constants, source)
  source.add("  return frame;\n}\nvoid Model::eval() {\n" ++ (if input_checks.length() > 0 | "  observe_inputs();\n" | "") ++ "  [[maybe_unused]] const State& current = states_[active_state_];\n  Outputs next_outputs{};")
  emit_region_calls(output_regions, "output", "next_outputs", output_helpers, output_cache, plan, types, constants, source)
  // Publish only after every output has sampled the current inputs/storage.
  // The pre-edge frame and all assertion/foreign/commit sequencing stay in tick.
  source.add("  outputs_ = next_outputs;\n}\nvoid Model::tick() {\n" ++ (if input_checks.length() > 0 | "  observe_inputs();\n" | "") ++ "  const unsigned next_index = active_state_ ^ 1u;\n  State& next = states_[next_index];\n  [[maybe_unused]] auto before = evaluate(states_[active_state_], next);")
  for (assertion in plan.assertions, index in 0..plan.assertions.length()):
    def message = "assertion failed: " ++ (assertion.label || "<unlabeled>") ++ " [" ++ String.join([plan.name] ++ assertion.path, "/") ++ "] " ++ assertion.location
    source.add("  if (before.assertion" ++ to_string(index) ++ "_failed) throw std::runtime_error(" ++ cpp_string(message) ++ ");")
  // All arguments and ordinary next-state values were sampled before the first
  // effect. Assertions above suppress the whole batch; external effects cannot
  // be rolled back if a host function fails after another call has run.
  for (call in plan.foreign_calls, index in 0..plan.foreign_calls.length()):
    def imp = call.import_decl
    def slot = to_string(index)
    source.add("  if (before.call" ++ slot ++ "_enable) {")
    def arguments = for List (type in imp.input_types, arg in 0..call.arguments.length()):
      def name = "call" ++ slot ++ "_arg" ++ to_string(arg)
      if foreign_packed(type)
      | def width = scalar_width(type)
        if width > 64
        | source.add("    const auto " ++ name ++ " = rhodium_rsim::to_words<" ++ to_string(width) ++ ">(before." ++ name ++ ");")
        | def words = (if width <= 32 | 1 | 2)
          def elements = for List (word in 0..words):
            "static_cast<std::uint32_t>(before." ++ name ++ " >> " ++ to_string(32 * word) ++ ")"
          source.add("    const std::array<std::uint32_t, " ++ to_string(words) ++ "> " ++ name ++ "{{" ++ String.join(elements, ", ") ++ "}};")
        name ++ ".data()"
      | "foreign_arg<" ++ foreign_type(type) ++ ">(before." ++ name ++ ")"
    // Out parameters point to native temporaries or low-word-first packed
    // arrays, never directly to model state. Core guarantees ordered outs then a return.
    def out_results = imp.results.filter(~keep: fun (result): result.direction == "out")
    def out_arguments = for List (result in out_results, result_index in 0..out_results.length()):
      def name = foreign_slot(index, result_index)
      if foreign_packed(result.type)
      | def words = rkt.quotient(scalar_width(result.type) + 31, 32)
        source.add("    std::array<std::uint32_t, " ++ to_string(words) ++ "> " ++ name ++ "{};")
        name ++ ".data()"
      | source.add("    " ++ foreign_type(result.type) ++ " " ++ name ++ "{};")
        "&" ++ name
    def invocation = "foreign::" ++ imp.name ++ "(" ++ String.join(arguments ++ out_arguments, ", ") ++ ")"
    if imp.has_result()
    | source.add("    const auto " ++ foreign_slot(index, imp.results.length() - 1) ++ " = " ++ invocation ++ ";")
      for (result in imp.results, result_index in 0..imp.results.length()):
        def name = foreign_slot(index, result_index)
        def raw:
          if result.direction == "out" && foreign_packed(result.type)
          | if scalar_width(result.type) > 64
            | "rhodium_rsim::from_words<" ++ to_string(scalar_width(result.type)) ++ ">(" ++ name ++ ".data())"
            | "static_cast<std::uint64_t>(" ++ name ++ "[0])" ++ (if scalar_width(result.type) > 32 | " | (static_cast<std::uint64_t>(" ++ name ++ "[1]) << 32)" | "")
          | "static_cast<std::uint64_t>(" ++ name ++ ")"
        def value = types.normalize(result.type, raw)
        source.add("    next." ++ name ++ " = " ++ value ++ ";")
    | source.add("    " ++ invocation ++ ";")
    source.add("  }")
  // Publication is the only bank switch. Assertions have passed and foreign
  // results are normalized; no staged reference is read by output evaluation.
  for (line in state_checks): source.add(line)
  source.add("  active_state_ = next_index;")
  // Registers and writes sample the same old state. Guard addresses independently
  // of register reset; statement order only chooses unspecified collision results.
  for (write in plan.writes, index in 0..plan.writes.length()):
    def prefix = "before.write" ++ to_string(index)
    source.add("  if (" ++ prefix ++ "_enable && " ++ prefix ++ "_address < " ++ to_string(plan.memories[write.memory].depth) ++ ") {\n    memory" ++ to_string(write.memory) ++ "_[" ++ prefix ++ "_address] = " ++ prefix ++ "_data;\n" ++ invalidate(RsimCacheSource("memory", write.memory)) ++ "\n  }")
  source.add("  eval();\n}\n}")
  [String.join(header.snapshot(), "\n") ++ "\n", String.join(source.snapshot(), "\n") ++ "\n"] ++ (if types.wide | [rkt.#{string->immutable-string}(file.#{file->string}(bits_header))] | [])
