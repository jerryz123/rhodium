#lang rhombus
/* Renders bounded rsim C++ evaluators with typed boundary storage and simultaneous commits. */
// SPDX-License-Identifier: Apache-2.0
import:
  "../../core/types.rhm" open
  "plan.rhm" open
  "evaluation.rhm" open
  "regions.rhm" open
  "types.rhm" open
  rhombus/meta open
  rhombus/runtime_path
  lib("racket/file.rkt") as file
  lib("racket/base.rkt") as rkt

export emit_rsim

/* RsimSchedule checks its immutable steps list at construction, and emit_rsim
   checks the schedule at entry. Private helpers only receive that same list:
   use :~ to retain element type information without rescanning every step on
   each call. Keep this checked boundary if a helper gains another caller. */

// Resolve support relative to the installed emitter, independent of the caller's cwd.
runtime_path.def bits_header: "rsim-bits.hpp"

/* Refer to a previously scheduled temporary. */
fun ref(index :: Nat) :: String:
  "v" ++ to_string(index)

/* Quote diagnostic paths without letting source punctuation or line breaks
   become C++ syntax. Labels and occurrence names are already identifiers. */
fun cpp_string(value :: String) :: String:
  def mutable escaped = value
  for (pair in [["\\", "\\\\"], ["\"", "\\\""], ["\n", "\\n"], ["\r", "\\r"], ["\t", "\\t"]]):
    escaped := escaped.replace(pair[0], pair[1], ~all: #true)
  "\"" ++ escaped ++ "\""

/* Distinguish the ABI's native widths from packed vectors, independently of
   author-level signedness and the model's scalar carriers. */
fun foreign_packed(type :: HardwareType) :: Boolean:
  !(scalar_width(type) in [1, 8, 16, 32, 64])

/* Use the same native and packed-word types as the SystemVerilog DPI ABI.
   Packed returns use one uint32 word; packed arguments use arrays of words. */
fun foreign_type(type :: HardwareType) :: String:
  {1: "unsigned char", 8: "char", 16: "short", 32: "int", 64: "long long"}.get(scalar_width(type), "std::uint32_t")

/* Identify one held result independently of both its sibling results and
   other occurrences of the same imported function. */
fun foreign_slot(call_index :: Nat, result_index :: Nat) :: String:
  "f" ++ to_string(call_index) ++ "_" ++ to_string(result_index)

/* Emit one operation; normalization at the caller preserves each intermediate
   hardware width before any later comparison or conversion. */
fun expression(step :: RsimStep, steps :~ List.of(RsimStep), types :: CppTypes) :: String:
  def args = step.operands.map(ref)
  def binary = {"rtl.and": "&", "rtl.or": "|", "rtl.xor": "^", "rtl.add": "+",
                "rtl.sub": "-", "rtl.mul": "*", "rtl.eq": "==", "rtl.ult": "<"}
  cond
  | step.opcode == "input": "inputs." ++ cpp_name(step.attributes["name"])
  | step.opcode == "state": "state_.s" ++ to_string(step.attributes["slot"])
  | step.opcode == "foreign_result": "state_." ++ foreign_slot(step.attributes["slot"], step.attributes["result"])
  | step.opcode == "sync_read": "state_.r" ++ to_string(step.attributes["slot"])
  | step.opcode == "memory_read": "vector_index(memory" ++ to_string(step.attributes["slot"]) ++ "_, " ++ args[0] ++ ")"
  | step.opcode == "rtl.constant": types.constant(step.type, step.attributes["value"])
  // Deterministic choices for partial values do not introduce four-state logic
  // or promise values for uncared bits or invalid one-hot selectors.
  | step.opcode == "rtl.dont_care": types.constant(step.type, 0)
  | step.opcode == "rtl.onehot_mux":
      def selector_type = steps[step.operands[0]].type
      def cases = for List (value in args.drop(1), index in 0..(args.length() - 1)):
        types.bit_test(selector_type, args[0], index) ++ " ? " ++ value ++ " : "
      String.join(cases, "") ++ types.name(step.type) ++ "{}"
  | step.opcode == "rtl.decode":
      def input_type = steps[step.operands[0]].type
      def cases = for List (row in step.attributes["cases"]):
        types.cube_match(input_type, args[0], row[0], row[1]) ++ " ? " ++ types.constant(step.type, row[2] bits.and row[3]) ++ " : "
      String.join(cases, "") ++ types.constant(step.type, step.attributes["default_value"] bits.and step.attributes["default_care"])
  | step.opcode == "rtl.not": "~" ++ args[0]
  | step.opcode == "rtl.cast":
      def source_type = steps[step.operands[0]].type
      if scalar_width(step.type) && scalar_width(source_type)
      | args[0]
      | def packed = types.pack(source_type, args[0])
        cond
        | scalar_width(step.type): packed
        | scalar_width(source_type): types.unpack(step.type, packed)
        | ~else: "([&]() { const auto packed = " ++ packed ++ "; return " ++ types.unpack(step.type, "packed") ++ "; }())"
  | step.opcode in ["rtl.record_create", "rtl.vector_create"]: types.construct(step.type, args)
  | step.opcode == "rtl.record_get": args[0] ++ "." ++ cpp_name(step.attributes["field"])
  | step.opcode == "rtl.vector_get": args[0] ++ "[" ++ to_string(step.attributes["index"]) ++ "]"
  | step.opcode in ["rtl.vector_index", "rtl.vector_inject", "rtl.vector_write_set"]:
      def name = {"rtl.vector_index": "vector_index", "rtl.vector_inject": "vector_inject", "rtl.vector_write_set": "vector_write_set"}[step.opcode]
      name ++ "(" ++ String.join(args, ", ") ++ ")"
  | step.opcode in ["rtl.zext", "rtl.trunc", "rtl.extract", "rtl.sext"] && (scalar_carrier_width(step.type) > 64 || scalar_carrier_width(steps[step.operands[0]].type) > 64):
      def target_width = scalar_carrier_width(step.type)
      def source_width = scalar_carrier_width(steps[step.operands[0]].type)
      def helper = if step.opcode == "rtl.sext" | "sign_extend" | "slice"
      def offset = if step.opcode == "rtl.extract" | ", " ++ to_string(step.attributes["low"]) | ""
      "rhodium_rsim::" ++ helper ++ "<" ++ to_string(target_width) ++ ", " ++ to_string(source_width) ++ ">(" ++ args[0] ++ offset ++ ")"
  | step.opcode in ["rtl.zext", "rtl.trunc"]: args[0]
  | step.opcode == "rtl.extract": args[0] ++ " >> " ++ to_string(step.attributes["low"])
  | step.opcode == "rtl.concat" && scalar_carrier_width(step.type) > 64:
      def widths = [scalar_carrier_width(step.type)] ++ step.operands.map(fun (operand): scalar_carrier_width(steps[operand].type))
      "rhodium_rsim::concat<" ++ String.join(widths.map(to_string), ", ") ++ ">(" ++ String.join(args, ", ") ++ ")"
  | step.opcode == "rtl.concat":
      def mutable remaining = scalar_carrier_width(step.type)
      def terms = for List (operand in step.operands, arg in args):
        remaining := remaining - scalar_carrier_width(steps[operand].type)
        if remaining == 0 | arg | "(" ++ arg ++ " << " ++ to_string(remaining) ++ ")"
      String.join(terms, " | ")
  | step.opcode == "rtl.slt" && scalar_carrier_width(steps[step.operands[0]].type) > 64:
      "rhodium_rsim::signed_less(" ++ args[0] ++ ", " ++ args[1] ++ ")"
  | step.opcode in ["rtl.sext", "rtl.slt"]:
      // Flipping the sign bit orders two's-complement values as unsigned.
      // Subtracting that bit afterward instead gives sign extension modulo 2^64.
      def sign = literal(2 ** (scalar_carrier_width(steps[step.operands[0]].type) - 1))
      if step.opcode == "rtl.sext"
      | "(" ++ args[0] ++ " ^ " ++ sign ++ ") - " ++ sign
      | "(" ++ args[0] ++ " ^ " ++ sign ++ ") < (" ++ args[1] ++ " ^ " ++ sign ++ ")"
  | step.opcode in ["rtl.shl", "rtl.shru", "rtl.shrs"]:
      def name = {"rtl.shl": "shift_left", "rtl.shru": "shift_right", "rtl.shrs": "shift_signed"}[step.opcode]
      def width = scalar_carrier_width(step.type)
      def count_width = scalar_carrier_width(steps[step.operands[1]].type)
      if width > 64 || count_width > 64
      | "rhodium_rsim::" ++ name ++ "<" ++ to_string(width) ++ ", " ++ to_string(count_width) ++ ">(" ++ String.join(args, ", ") ++ ")"
      | name ++ "(" ++ args[0] ++ ", " ++ args[1] ++ ", " ++ to_string(width) ++ ")"
  | binary.has_key(step.opcode): args[0] ++ " " ++ binary[step.opcode] ++ " " ++ args[1]
  | step.opcode == "rtl.mux_lookup":
      def selector_type = steps[step.operands[0]].type
      def cases = for List (key in step.attributes["keys"], value in args.drop(2)):
        "(" ++ args[0] ++ " == " ++ types.constant(selector_type, key) ++ ") ? " ++ value ++ " : "
      String.join(cases, "") ++ args[1]
  | ~else: error(~who: #'rsim, "missing expression renderer for " ++ step.opcode)

/* Emit planned constant values as canonical immutable objects in the model
   namespace. Return step-to-symbol bindings independent of evaluator locals,
   so any dependency-closed subset can refer to the same constant storage. */
fun emit_constants(steps :~ List.of(RsimStep), constant_values :: Map, types :: CppTypes, source :: MutableList) :: Map:
  def storage = MutableMap{}
  def bindings = MutableMap{}
  for (step in steps, index in 0..steps.length()):
    when constant_values.has_key(index)
    | def constant = constant_values[index]
      def rendered = types.constant(step.type, constant)
      def key = [types.name(step.type), rendered]
      unless storage.has_key(key)
      | def name = "constant" ++ to_string(storage.length())
        storage[key] := name
        // Internal linkage and constant initialization share immutable tables
        // across evaluator bodies and model instances without runtime guards.
        source.add("[[maybe_unused]] static constexpr " ++ types.name(step.type) ++ " " ++ name ++ " = " ++ rendered ++ ";")
      bindings[index] := storage[key]
  bindings.snapshot()

/* Aggregate current-state roots are normalized lvalues that remain stable until
   all frame/output consumers finish. Bind them afresh in each evaluation; never
   borrow inputs needing normalization or computed asynchronous memory results. */
fun aggregate_state_read(step :: RsimStep) :: Boolean:
  step.opcode in ["state", "sync_read", "foreign_result"] && (record_type(step.type) || vector_type(step.type))

/* Only static aggregate projections expose subobjects without normalization or
   bounds-dependent temporaries. Scalar and dynamic reads retain value semantics. */
fun aggregate_projection(step :: RsimStep) :: Boolean:
  step.opcode in ["rtl.record_get", "rtl.vector_get"] && (record_type(step.type) || vector_type(step.type))

/* Find evaluation-long backing, following only static aggregate subobjects.
   A helper-local computed parent has no backing here and must be copied when
   its projection crosses a region. Existing slots are never recycled. */
fun backed_reference(index :: Nat, steps :~ List.of(RsimStep), types :: CppTypes, constants :: Map, bindings :: ReadableMap) :: maybe(String):
  cond
  | constants.has_key(index): constants[index]
  | bindings.has_key(index): bindings[index]
  | aggregate_state_read(steps[index]): expression(steps[index], steps, types)
  | aggregate_projection(steps[index]):
      def step = steps[index]
      def parent = backed_reference(step.operands[0], steps, types, constants, bindings)
      if parent
      | "(" ++ parent ++ ")" ++ (if step.opcode == "rtl.record_get" | "." ++ cpp_name(step.attributes["field"]) | "[" ++ to_string(step.attributes["index"]) ++ "]")
      | #false
  | ~else: #false

/* Render one original schedule index with its usual leaf normalization.
   Constant aliases bind namespace storage, never another evaluator's locals;
   callers choose the dependency-ordered indices without renumbering operands. */
fun step_declaration(index :: Nat, steps :~ List.of(RsimStep), types :: CppTypes, constants :: Map, ~destination: destination :: maybe(String) = #false, ~slots: slots :: Map = {}) :: String:
  if constants.has_key(index)
  | "  [[maybe_unused]] const auto& " ++ ref(index) ++ " = " ++ constants[index] ++ ";"
  | def step = steps[index]
    def array = if step.opcode == "rtl.vector_create" | array_construction(index, step, types, slots, destination) | #false
    if array
    | array
    | def rendered = expression(step, steps, types)
      // External aggregates need leaf masking. Internal aggregate operations use
      // normalized members; scalar expressions are masked at every boundary.
      def value:
        if step.opcode == "input" || (!record_type(step.type) && !vector_type(step.type))
        | types.normalize(step.type, rendered)
        | rendered
      cond
      | aggregate_state_read(step) || (aggregate_projection(step) && !destination): "  [[maybe_unused]] const auto& " ++ ref(index) ++ " = " ++ value ++ ";"
      | destination: "  " ++ destination ++ " = " ++ value ++ ";\n  [[maybe_unused]] const auto& " ++ ref(index) ++ " = " ++ destination ++ ";"
      | ~else: "  [[maybe_unused]] const " ++ types.name(step.type) ++ " " ++ ref(index) ++ " = " ++ value ++ ";"

/* Render one planned final consumer without executing effects or committing
   storage. The planner owns its value/storage uses and sampling order; this
   renderer owns C++ expressions and the frame/output representation. */
fun emit_sink(sink :: RsimSink, plan :: RsimSchedule, types :: CppTypes, source :: MutableList):
  def index = sink.index
  match sink.kind
  | "foreign":
      def call = plan.foreign_calls[index]
      def slot = to_string(index)
      source.add("  frame.call" ++ slot ++ "_enable = " ++ ref(call.enable) ++ " != 0;")
      for (argument in call.arguments, arg in 0..call.arguments.length()):
        source.add("  frame.call" ++ slot ++ "_arg" ++ to_string(arg) ++ " = " ++ ref(argument) ++ ";")
      for (result_index in 0..call.import_decl.results.length()):
        def name = foreign_slot(index, result_index)
        source.add("  frame.next." ++ name ++ " = state_." ++ name ++ ";")
  | "assertion":
      // Only sample predicates here; tick reports failures before any effects.
      def assertion = plan.assertions[index]
      source.add("  frame.assertion" ++ to_string(index) ++ "_failed = " ++ ref(assertion.guard) ++ " != 0 && " ++ ref(assertion.reset) ++ " == 0 && " ++ ref(assertion.condition) ++ " == 0;")
  | "register":
      def reg = plan.registers[index]
      def value = if reg.reset | ref(reg.reset) ++ " ? " ++ ref(reg.reset_value) ++ " : " ++ ref(reg.next_value) | ref(reg.next_value)
      source.add("  frame.next.s" ++ to_string(index) ++ " = " ++ value ++ ";")
  | "sync_read":
      // Ports and consumers sample old storage; disabled results are unspecified.
      def read = plan.reads[index]
      def enabled = ref(read.enable) ++ " != 0" ++ (if read.write_mode | " && " ++ ref(read.write_mode) ++ " == 0" | "")
      def value = "vector_index(memory" ++ to_string(read.memory) ++ "_, " ++ ref(read.address) ++ ")"
      source.add("  frame.next.r" ++ to_string(index) ++ " = (" ++ enabled ++ ") ? " ++ value ++ " : " ++ types.name(plan.memories[read.memory].type) ++ "{};")
  | "write":
      def write = plan.writes[index]
      def prefix = "frame.write" ++ to_string(index)
      def enabled = ref(write.enable) ++ " != 0" ++ (if write.write_mode | " && " ++ ref(write.write_mode) ++ " != 0" | "")
      // Merge before committing any state, including a mask fed by an old read
      // result. Guard the old-word load even for disabled or invalid writes.
      def data:
        if write.mask_value
        | def old = "write" ++ to_string(index) ++ "_old"
          source.add("  const auto " ++ old ++ " = vector_index(memory" ++ to_string(write.memory) ++ "_, " ++ ref(write.address) ++ ");")
          types.masked_merge(plan.memories[write.memory].type, old, ref(write.data), ref(write.mask_value), scalar_carrier_width(plan.steps[write.mask_value].type), write.mask_granularity)
        | ref(write.data)
      source.add("  " ++ prefix ++ "_address = " ++ ref(write.address) ++ ";\n  " ++ prefix ++ "_data = " ++ data ++ ";\n  " ++ prefix ++ "_enable = " ++ enabled ++ ";")
  | "output":
      def port = plan.outputs[index]
      source.add("  next_outputs." ++ cpp_name(port.name) ++ " = " ++ ref(port.value) ++ ";")
  | ~else: error(~who: #'rsim, "unknown evaluation sink: " ++ sink.kind)

/* Value expressions, borrowed-result pointer slots, and typed arrays for one
   evaluation phase. Logical regions remain independent of C++ storage policy. */
class BoundaryStorage(bindings :: Map, borrowed :: Map, slots :: Map, declarations :: List.of(String))

/* Keep the physical array location alongside its rendered binding. Indirect
   slots hold aggregate pointers refreshed during this evaluation. This metadata
   supports indexed kernels without recovering addresses from generated C++. */
class ScratchSlot(group :: String, index :: Nat, indirect :: Boolean)

/* Fill a fresh vector destination from normalized operands in logical order.
   Repeated values and affine runs in one scratch group become counted loops;
   all other elements retain scalar assignments. Slots never overlap operands
   or get recycled, so an indirect gather cannot overwrite its own backing.
   Local constructors use this path only when a loop replaces at least four
   assignments; otherwise keep their compact aggregate initializer. */
fun array_construction(index :: Nat, step :: RsimStep, types :: CppTypes, slots :: Map, destination :: maybe(String)) :: maybe(String):
  def operands = step.operands
  def target = destination || ("array" ++ to_string(index))
  def lines = MutableList[]
  def mutable looped = #false
  def mutable start = 0
  while start < operands.length():
    def first = operands[start]
    def mutable end = start + 1
    while end < operands.length() && operands[end] == first:
      end := end + 1
    def mutable value = ref(first)
    when end == start + 1 && end < operands.length() && slots.has_key(first) && slots.has_key(operands[end])
    | def a = slots[first] :: ScratchSlot
      def b = slots[operands[end]] :: ScratchSlot
      def stride = b.index - a.index
      when a.group == b.group && a.indirect == b.indirect
      | end := end + 1
        def mutable matching = #true
        while end < operands.length() && matching:
          def next = slots.get(operands[end], #false)
          if next && next.group == a.group && next.indirect == a.indirect && next.index == a.index + (end - start) * stride
          | end := end + 1
          | matching := #false
        def offset = to_string(a.index) ++ (if stride < 0 | " - i * " ++ to_string(-stride) | " + i * " ++ to_string(stride))
        value := (if a.indirect | "*" | "") ++ "scratch." ++ a.group ++ "[" ++ offset ++ "]"
    if end - start >= 4
    | looped := #true
      lines.add("  for (std::size_t i = 0; i < " ++ to_string(end - start) ++ "; ++i) " ++ target ++ "[" ++ to_string(start) ++ " + i] = " ++ value ++ ";")
    | lines.add("  " ++ target ++ "[" ++ to_string(start) ++ "] = " ++ ref(first) ++ ";")
      end := start + 1
    start := end
  if destination || looped
  | (if destination | "" | "  " ++ types.name(step.type) ++ " " ++ target ++ ";\n")
      ++ String.join(lines.snapshot(), "\n")
      ++ "\n  [[maybe_unused]] const auto& " ++ ref(index) ++ " = " ++ target ++ ";"
  | #false

/* Bind aggregate state roots and backed projections directly; allocate other values,
   grouping slots by C++ carrier rather than generating one member per value.
   Stable region/value order gives deterministic names; each phase owns independent scratch and slot bindings.
   Aggregate lookup muxes may borrow already-backed operands: constants or earlier
   boundary values (including state roots and borrowed muxes). Never borrow a
   helper-local value or recycle a backing slot within the evaluation. */
fun boundary_layout(regions :: List.of(RsimRegion), plan :: RsimSchedule, types :: CppTypes, constants :: Map) :: BoundaryStorage:
  def bindings = MutableMap{}
  def borrowed = MutableMap{}
  def slots = MutableMap{}
  def carriers = MutableList[]
  def groups = MutableMap{}
  def counts = MutableMap{}
  for (region in regions):
    for (index in region.outputs):
      def step = plan.steps[index]
      def direct = backed_reference(index, plan.steps, types, constants, bindings)
      if direct
      | // State and backed subobjects need no payload slot or cached pointer.
        // Consumers resolve the binding on their own model each time.
        bindings[index] := direct
      | def borrow:
          step.opcode == "rtl.mux_lookup" && (record_type(step.type) || vector_type(step.type))
            && (for all (operand in step.operands.drop(1)): constants.has_key(operand) || bindings.has_key(operand))
        def carrier = (if borrow | "const " | "") ++ types.name(step.type) ++ (if borrow | "*" | "")
        unless groups.has_key(carrier)
        | groups[carrier] := "g" ++ to_string(carriers.length())
          counts[carrier] := 0
          carriers.add(carrier)
        def slot = "scratch." ++ groups[carrier] ++ "[" ++ to_string(counts[carrier]) ++ "]"
        slots[index] := ScratchSlot(groups[carrier], counts[carrier], borrow)
        bindings[index] := (if borrow | "*" | "") ++ slot
        when borrow | borrowed[index] := slot
        counts[carrier] := counts[carrier] + 1
  def declarations = for List (carrier in carriers):
    "    std::array<" ++ carrier ++ ", " ++ to_string(counts[carrier]) ++ "> " ++ groups[carrier] ++ ";"
  BoundaryStorage(bindings.snapshot(), borrowed.snapshot(), slots.snapshot(), declarations)

/* Declare phase-local reusable buffers and bounded sampling helpers. Scratch is
   overwritten before every read, never a cache; initialization happens once per
   model, not per evaluation. No scratch reference escapes into the frame. */
fun declare_regions(regions :: List.of(RsimRegion), layout :: BoundaryStorage, phase :: String, destination :: String, header :: MutableList):
  when regions.length() > 1
  | header.add("  struct " ++ phase ++ "Scratch {\n" ++ String.join(layout.declarations, "\n") ++ "\n  };\n  mutable " ++ phase ++ "Scratch " ++ phase ++ "_scratch_{};")
    for (index in 0..regions.length()):
      header.add("  void " ++ phase ++ "_region" ++ to_string(index) ++ "(" ++ phase ++ "Scratch& scratch, " ++ destination ++ ") const;")

/* Emit helpers in schedule order, importing only direct boundary operands and
   shared constants. Store crossing results directly in their slots; local-only
   computations keep ordinary locals. Effects and publication stay outside. */
fun emit_regions(regions :: List.of(RsimRegion), layout :: BoundaryStorage, phase :: String, destination :: String, plan :: RsimSchedule, types :: CppTypes, constants :: Map, source :: MutableList):
  when regions.length() > 1
  | for (region in regions, index in 0..regions.length()):
      source.add("RHODIUM_RSIM_NOINLINE void Model::" ++ phase ++ "_region" ++ to_string(index) ++ "([[maybe_unused]] " ++ phase ++ "Scratch& scratch, [[maybe_unused]] " ++ destination ++ ") const {")
      for (input in region.inputs):
        source.add("  [[maybe_unused]] const auto& " ++ ref(input) ++ " = " ++ layout.bindings[input] ++ ";")
      for (constant in region.constants):
        source.add(step_declaration(constant, plan.steps, types, constants))
      for (step in region.steps):
        unless constants.has_key(step)
        | cond
          // All branches are normalized aggregate lvalues backed for this whole
          // invocation. Taking the selected lvalue's address performs no copy.
          | layout.borrowed.has_key(step):
              source.add("  " ++ layout.borrowed[step] ++ " = &(" ++ expression(plan.steps[step], plan.steps, types) ++ ");\n  [[maybe_unused]] const auto& " ++ ref(step) ++ " = " ++ layout.bindings[step] ++ ";")
          | ~else:
              // Local subobjects outlive local consumers. Crossing projections
              // may omit the copy only when their parent has stable backing.
              def projection = aggregate_projection(plan.steps[step]) && backed_reference(plan.steps[step].operands[0], plan.steps, types, constants, layout.bindings) != #false
              def destination = if projection | #false | layout.bindings.get(step, #false)
              source.add(step_declaration(step, plan.steps, types, constants, ~destination: destination, ~slots: layout.slots))
      for (sink in region.sinks): emit_sink(sink, plan, types, source)
      source.add("}")

/* Small bodies stay inline in their coordinator. Larger bodies execute every
   helper exactly once, passing buffers by reference without copying or clearing. */
fun emit_region_calls(regions :: List.of(RsimRegion), phase :: String, destination :: String, plan :: RsimSchedule, types :: CppTypes, constants :: Map, source :: MutableList):
  if regions.length() > 1
  | for (index in 0..regions.length()):
      source.add("  " ++ phase ++ "_region" ++ to_string(index) ++ "(" ++ phase ++ "_scratch_, " ++ destination ++ ");")
  | for (region in regions):
      for (index in region.steps): source.add(step_declaration(index, plan.steps, types, constants))
      for (sink in region.sinks): emit_sink(sink, plan, types, source)

/* Produce model sources and optional wide support, with private state per model object.
   The evaluator is pure with respect to state; tick commits only after every
   next-state expression and pending write has sampled the old state. Memory
   arrays live outside the frame, so evaluation never copies whole memories.
   The private budget permits boundary stress tests without a target option. */
fun emit_rsim(plan :: RsimSchedule, ~region_budget: region_budget :: PosInt = 4096) :: List.of(String):
  def evaluation = build_evaluation_plan(plan)
  def pre_regions = build_regions(plan, evaluation, evaluation.pre_edge, ~budget: region_budget)
  def output_regions = build_regions(plan, evaluation, evaluation.outputs, ~budget: region_budget)
  def namespace = "rsim_" ++ cpp_name(plan.name)
  def types = CppTypes()
  for (step in plan.steps):
    types.name(step.type)
    // An aggregate-to-aggregate cast may need a wide temporary even when all
    // stored leaves are narrow. Decide support packaging before the header.
    when step.opcode == "rtl.cast" && step.type.packed_width() > 64
    | types.wide := #true
  for (memory in plan.memories): types.name(memory.type)
  // Live calls own every ABI result even when no scheduled value consumes it.
  // Discover these types before deciding whether to package wide support.
  for (call in plan.foreign_calls):
    for (type in call.import_decl.input_types ++ call.import_decl.results.map(fun (result): result.type)):
      types.name(type)
  // Resolve shared constant symbols before layout so projected bindings can
  // name them even in consumers whose original operands were only projections.
  def constant_source = MutableList[]
  def constants = emit_constants(plan.steps, evaluation.constants, types, constant_source)
  def pre_layout = boundary_layout(pre_regions, plan, types, constants)
  def output_layout = boundary_layout(output_regions, plan, types, constants)
  def header = MutableList["// Declares the typed simulator for " ++ plan.name ++ ".",
                           "// SPDX-License-Identifier: Apache-2.0", "#pragma once", "#include <cstdint>", "#include <array>" ++ (if types.wide | "\n#include \"rsim-bits.hpp\"" | ""),
                           "namespace " ++ namespace ++ " {", String.join(types.declarations.snapshot(), "\n"), "class Model {", "public:",
                           "  struct Inputs {"]
  for (port in plan.inputs): header.add("    " ++ types.name(port.type) ++ " " ++ cpp_name(port.name) ++ "{};")
  header.add("  } inputs;\n  struct Outputs {")
  for (port in plan.outputs): header.add("    " ++ types.name(port.type) ++ " " ++ cpp_name(port.name) ++ "{};")
  header.add("  };\n  void eval();\n  void tick();\n  const Outputs& outputs() const { return outputs_; }\nprivate:\n  struct State {")
  // State is a carrier shared with the temporary frame. Initialize persistent
  // storage at state_, not on its fields, so frame creation need not clear it.
  for (reg in plan.registers, index in 0..plan.registers.length()):
    header.add("    " ++ types.name(reg.type) ++ " s" ++ to_string(index) ++ "; // " ++ String.join(reg.path ++ [reg.name], "/"))
  for (read in plan.reads, index in 0..plan.reads.length()):
    header.add("    " ++ types.name(plan.memories[read.memory].type) ++ " r" ++ to_string(index) ++ "; // synchronous read result")
  for (call in plan.foreign_calls, index in 0..plan.foreign_calls.length()):
    for (result_index in 0..call.import_decl.results.length()):
      header.add("    " ++ types.name(call.import_decl.results[result_index].type) ++ " " ++ foreign_slot(index, result_index) ++ "; // held foreign result")
  header.add("  } state_{};")
  for (memory in plan.memories, index in 0..plan.memories.length()):
    header.add("  std::array<" ++ types.name(memory.type) ++ ", " ++ to_string(memory.depth) ++ "> memory" ++ to_string(index) ++ "_{}; // " ++ String.join(memory.path ++ [memory.name], "/"))
  header.add("  struct Frame {\n    State next;")
  for (call in plan.foreign_calls, index in 0..plan.foreign_calls.length()):
    def prefix = "call" ++ to_string(index)
    header.add("    bool " ++ prefix ++ "_enable;")
    for (arg in 0..call.arguments.length()):
      header.add("    " ++ types.name(call.import_decl.input_types[arg]) ++ " " ++ prefix ++ "_arg" ++ to_string(arg) ++ ";")
  for (index in 0..plan.assertions.length()):
    header.add("    bool assertion" ++ to_string(index) ++ "_failed;")
  for (write in plan.writes, index in 0..plan.writes.length()):
    def prefix = "write" ++ to_string(index)
    header.add("    std::uint64_t " ++ prefix ++ "_address;\n    " ++ types.name(plan.memories[write.memory].type) ++ " " ++ prefix ++ "_data;\n    bool " ++ prefix ++ "_enable;")
  header.add("  };\n  Outputs outputs_;\n  Frame evaluate() const;")
  declare_regions(pre_regions, pre_layout, "pre", "Frame& frame", header)
  declare_regions(output_regions, output_layout, "output", "Outputs& next_outputs", header)
  header.add("};\n}")
  def source = MutableList["// Evaluates " ++ plan.name ++ " with simultaneous state commits.",
                           "// SPDX-License-Identifier: Apache-2.0", "#include \"" ++ plan.name ++ ".hpp\"", "#include <cstddef>"]
  when plan.assertions.length() > 0
  | source.add("#include <stdexcept>")
  when plan.foreign_calls.length() > 0
  | source.add("#include <climits>\n#include <cstring>\n#include <type_traits>")
  source.add("namespace " ++ namespace ++ " {")
  when plan.foreign_calls.length() > 0
  | source.add("static_assert(CHAR_BIT == 8 && sizeof(short) == 2 && sizeof(int) == 4 && sizeof(long long) == 8, \"unsupported native foreign ABI\");")
    // A private namespace isolates declarations from model/helper names while
    // C linkage preserves the authored external symbol without mangling.
    source.add("namespace foreign {")
    def declared = MutableSet{}
    for (call in plan.foreign_calls):
      def imp = call.import_decl
      unless imp.name in declared
      | declared.add(imp.name)
        def result = if imp.has_result() | foreign_type(imp.return_result().type) | "void"
        def out_types = for List (result in imp.results.filter(~keep: fun (result): result.direction == "out")):
          foreign_type(result.type) ++ "*"
        def input_types = imp.input_types.map(fun (type): if foreign_packed(type) | "const std::uint32_t*" | foreign_type(type))
        source.add("extern \"C\" " ++ result ++ " " ++ imp.name ++ "(" ++ String.join(input_types ++ out_types, ", ") ++ ");")
    source.add("}\ntemplate <typename T>\nstatic T foreign_arg(std::uint64_t value) {\n  const auto bits = static_cast<typename std::make_unsigned<T>::type>(value);\n  T result;\n  std::memcpy(&result, &bits, sizeof(result));\n  return result;\n}")
  // Runtime guards precede every variable shift. Keeping them in ordinary
  // functions also avoids invalid constant-shift diagnostics in unreachable
  // expression branches. Counts remain unsigned 64-bit values until checked.
  def opcodes = plan.steps.map(fun (step): step.opcode)
  // Partial RTL results may be computed behind an unselected mux. Guard every
  // array access instead of throwing or invoking C++ undefined behavior. Zero
  // reads and skipped invalid writes are backend choices for unconstrained
  // results; loop order does not create a hardware collision-priority contract.
  def masked_writes = plan.writes.filter(~keep: fun (write): write.mask_value != #false)
  when "rtl.vector_index" in opcodes || "memory_read" in opcodes || plan.reads.length() > 0 || masked_writes.length() > 0
  | source.add("template <typename T, std::size_t N>\nstatic T vector_index(const std::array<T, N>& value, std::uint64_t index) {\n  return index < N ? value[index] : T{};\n}")
  when "rtl.vector_inject" in opcodes
  | source.add("template <typename T, std::size_t N>\nstatic std::array<T, N> vector_inject(std::array<T, N> value, std::uint64_t index, const T& element) {\n  if (index < N) value[index] = element;\n  return value;\n}")
  when "rtl.vector_write_set" in opcodes
  | source.add("template <typename T, std::size_t N, std::size_t P>\nstatic std::array<T, N> vector_write_set(std::array<T, N> value, const std::array<std::uint64_t, P>& enables, const std::array<std::uint64_t, P>& indices, const std::array<T, P>& elements) {\n  for (std::size_t port = 0; port < P; ++port) {\n    if (enables[port] != 0 && indices[port] < N) value[indices[port]] = elements[port];\n  }\n  return value;\n}")
  // Emit narrow helpers only when called; models with exclusively wide shift
  // operations use the shared support header and need no unused local functions.
  def narrow_shifts = plan.steps.filter(~keep: fun (step): step.opcode in ["rtl.shl", "rtl.shru", "rtl.shrs"] && scalar_carrier_width(step.type) <= 64 && scalar_carrier_width(plan.steps[step.operands[1]].type) <= 64).map(fun (step): step.opcode)
  for (entry in [["rtl.shl", "shift_left", "<<"], ["rtl.shru", "shift_right", ">>"]]):
    when entry[0] in narrow_shifts
    | source.add("static inline std::uint64_t " ++ entry[1] ++ "(std::uint64_t value, std::uint64_t amount, unsigned width) {\n  return amount >= width ? UINT64_C(0) : value " ++ entry[2] ++ " amount;\n}")
  when "rtl.shrs" in narrow_shifts
  | source.add("static inline std::uint64_t shift_signed(std::uint64_t value, std::uint64_t amount, unsigned width) {\n  const bool negative = (value >> (width - 1)) != 0;\n  if (amount >= width) return negative ? ~UINT64_C(0) : UINT64_C(0);\n  if (amount == 0) return value;\n  return (value >> amount) | (negative ? (~UINT64_C(0) << (width - amount)) : UINT64_C(0));\n}")
  for (line in constant_source): source.add(line)
  when pre_regions.length() > 1 || output_regions.length() > 1
  | // Preserve the compilation boundary even under optimization/LTO. Applying
    // this only to region helpers leaves expression/runtime helpers optimizable.
    source.add("#if defined(_MSC_VER)\n#define RHODIUM_RSIM_NOINLINE __declspec(noinline)\n#elif defined(__GNUC__) || defined(__clang__)\n#define RHODIUM_RSIM_NOINLINE __attribute__((noinline))\n#else\n#define RHODIUM_RSIM_NOINLINE\n#endif")
    emit_regions(pre_regions, pre_layout, "pre", "Frame& frame", plan, types, constants, source)
    emit_regions(output_regions, output_layout, "output", "Outputs& next_outputs", plan, types, constants, source)
    source.add("#undef RHODIUM_RSIM_NOINLINE")
  // Every frame field is assigned unconditionally by emit_sink before return,
  // including disabled-call holds and inactive read/write/check controls. Keep
  // carrier defaults (records and WideBits) intact for their other callers.
  source.add("Model::Frame Model::evaluate() const {\n  Frame frame;")
  emit_region_calls(pre_regions, "pre", "frame", plan, types, constants, source)
  source.add("  return frame;\n}\nvoid Model::eval() {\n  Outputs next_outputs{};")
  emit_region_calls(output_regions, "output", "next_outputs", plan, types, constants, source)
  // Publish only after every output has sampled the current inputs/storage.
  // The pre-edge frame and all assertion/foreign/commit sequencing stay in tick.
  source.add("  outputs_ = next_outputs;\n}\nvoid Model::tick() {\n  auto before = evaluate();")
  for (assertion in plan.assertions, index in 0..plan.assertions.length()):
    def message = "assertion failed: " ++ (assertion.label || "<unlabeled>") ++ " [" ++ String.join([plan.name] ++ assertion.path, "/") ++ "] " ++ assertion.location
    source.add("  if (before.assertion" ++ to_string(index) ++ "_failed) throw std::runtime_error(" ++ cpp_string(message) ++ ");")
  // All arguments and ordinary next-state values were sampled before the first
  // effect. Assertions above suppress the whole batch; external effects cannot
  // be rolled back if a host function fails after another call has run.
  for (call in plan.foreign_calls, index in 0..plan.foreign_calls.length()):
    def imp = call.import_decl
    def slot = to_string(index)
    source.add("  if (before.call" ++ slot ++ "_enable) {")
    def arguments = for List (type in imp.input_types, arg in 0..call.arguments.length()):
      def name = "call" ++ slot ++ "_arg" ++ to_string(arg)
      if foreign_packed(type)
      | def width = scalar_width(type)
        if width > 64
        | source.add("    const auto " ++ name ++ " = rhodium_rsim::to_words<" ++ to_string(width) ++ ">(before." ++ name ++ ");")
        | def words = (if width <= 32 | 1 | 2)
          def elements = for List (word in 0..words):
            "static_cast<std::uint32_t>(before." ++ name ++ " >> " ++ to_string(32 * word) ++ ")"
          source.add("    const std::array<std::uint32_t, " ++ to_string(words) ++ "> " ++ name ++ "{{" ++ String.join(elements, ", ") ++ "}};")
        name ++ ".data()"
      | "foreign_arg<" ++ foreign_type(type) ++ ">(before." ++ name ++ ")"
    // Out parameters point to native temporaries or low-word-first packed
    // arrays, never directly to model state. Core guarantees ordered outs then a return.
    def out_results = imp.results.filter(~keep: fun (result): result.direction == "out")
    def out_arguments = for List (result in out_results, result_index in 0..out_results.length()):
      def name = foreign_slot(index, result_index)
      if foreign_packed(result.type)
      | def words = rkt.quotient(scalar_width(result.type) + 31, 32)
        source.add("    std::array<std::uint32_t, " ++ to_string(words) ++ "> " ++ name ++ "{};")
        name ++ ".data()"
      | source.add("    " ++ foreign_type(result.type) ++ " " ++ name ++ "{};")
        "&" ++ name
    def invocation = "foreign::" ++ imp.name ++ "(" ++ String.join(arguments ++ out_arguments, ", ") ++ ")"
    if imp.has_result()
    | source.add("    const auto " ++ foreign_slot(index, imp.results.length() - 1) ++ " = " ++ invocation ++ ";")
      for (result in imp.results, result_index in 0..imp.results.length()):
        def name = foreign_slot(index, result_index)
        def raw:
          if result.direction == "out" && foreign_packed(result.type)
          | if scalar_width(result.type) > 64
            | "rhodium_rsim::from_words<" ++ to_string(scalar_width(result.type)) ++ ">(" ++ name ++ ".data())"
            | "static_cast<std::uint64_t>(" ++ name ++ "[0])" ++ (if scalar_width(result.type) > 32 | " | (static_cast<std::uint64_t>(" ++ name ++ "[1]) << 32)" | "")
          | "static_cast<std::uint64_t>(" ++ name ++ ")"
        def value = types.normalize(result.type, raw)
        source.add("    before.next." ++ name ++ " = " ++ value ++ ";")
    | source.add("    " ++ invocation ++ ";")
    source.add("  }")
  source.add("  state_ = before.next;")
  // Registers and writes sample the same old state. Guard addresses independently
  // of register reset; statement order only chooses unspecified collision results.
  for (write in plan.writes, index in 0..plan.writes.length()):
    def prefix = "before.write" ++ to_string(index)
    source.add("  if (" ++ prefix ++ "_enable && " ++ prefix ++ "_address < " ++ to_string(plan.memories[write.memory].depth) ++ ") memory" ++ to_string(write.memory) ++ "_[" ++ prefix ++ "_address] = " ++ prefix ++ "_data;")
  source.add("  eval();\n}\n}")
  [String.join(header.snapshot(), "\n") ++ "\n", String.join(source.snapshot(), "\n") ++ "\n"] ++ (if types.wide | [rkt.#{string->immutable-string}(file.#{file->string}(bits_header))] | [])
