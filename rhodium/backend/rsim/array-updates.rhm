#lang rhombus
/* Recovers array updates, forwards their reads, and prunes unused values before rsim storage planning. */
// SPDX-License-Identifier: Apache-2.0
import:
  "../../core/types.rhm" open
  "plan.rhm" open
  "evaluation.rhm".prune_schedule

export compact_array_updates

/* Recognize an exact lane equality, optionally conjoined with one shared
   one-bit enable. Compare full constants so narrow-index wrapping cannot merge
   lanes. The returned guard is an original value identity, never an inferred
   equivalence; native dynamic indexing accepts only indices up to 64 bits. */
fun update_lane(value :: Nat, lane :: Nat, steps :~ List.of(RsimStep)) :: maybe(List):
  def mux = steps[value]
  /* Return the unsigned index tested against this exact lane. */
  fun index_test(value :: Nat) :: maybe(Nat):
    def test = steps[value]
    cond
    | test.opcode != "rtl.eq" || scalar_width(test.type) != 1: #false
    | ~else:
        def a = steps[test.operands[0]]
        def index = if a.opcode == "rtl.constant" | test.operands[1] | test.operands[0]
        def constant = if a.opcode == "rtl.constant" | a | steps[test.operands[1]]
        def width = scalar_width(steps[index].type)
        if constant.opcode == "rtl.constant" && constant.attributes["value"] == lane && width && width <= 64
        | index
        | #false

  cond
  | mux.opcode != "rtl.mux_lookup" || mux.attributes["keys"] != [1]: #false
  | ~else:
      def test = steps[mux.operands[0]]
      def direct = index_test(mux.operands[0])
      cond
      | direct != #false: [mux.operands[1], direct, mux.operands[2], #false]
      | test.opcode == "rtl.and" && scalar_width(test.type) == 1:
          def left = index_test(test.operands[0])
          def right = index_test(test.operands[1])
          cond
          | left != #false: [mux.operands[1], left, mux.operands[2], test.operands[1]]
          | right != #false: [mux.operands[1], right, mux.operands[2], test.operands[0]]
          | ~else: #false
      | ~else: #false

/* Forward bounded projection trees through immutable update versions. Recipes
   refer to original values until accepted, so declining a large query emits no
   speculative computations. New recipes inherit the requesting occurrence, while
   shared recipes keep the first owner. Dynamic reads retain zero-on-miss behavior. */
fun forward_array_reads(schedule :: RsimSchedule) :: RsimSchedule:
  def steps = MutableList[]
  def refs = MutableMap{}
  def queries = MutableMap{}
  def expressions = MutableMap{}
  def mutable changed = #false
  /* Resolve an original dependency after its replacement has been emitted. */
  fun remap(value :: Nat) :: Nat: refs[value]
  /* Materialize each accepted recipe once, even when a mux DAG shares branches.
     Shallow expression keys use type_equal before sharing nominal hardware types. */
  fun emit(value :: Nat, recipes :: MutableList, emitted :: MutableMap) :: Nat:
    if value < schedule.steps.length()
    | remap(value)
    | unless emitted.has_key(value)
      | def recipe = recipes[value - schedule.steps.length()]
        def operands = recipe.operands.map(fun (operand): emit(operand, recipes, emitted))
        def key = [recipe.opcode, operands, recipe.attributes]
        def candidates = expressions.get(key, [])
        def found = candidates.find(fun (candidate): type_equal(recipe.type, steps[candidate].type))
        if found != #false
        | emitted[value] := found
        | emitted[value] := steps.length()
          expressions[key] := candidates ++ [steps.length()]
          steps.add(RsimStep(recipe.opcode, recipe.type, operands, recipe.attributes, recipe.occurrence))

      emitted[value]

  /* Record one static field/lane or dynamic unsigned lane selection. */
  fun part(step :: RsimStep) :: List:
    match step.opcode
    | "rtl.record_get": ["field", step.attributes["field"]]
    | "rtl.vector_get": ["lane", step.attributes["index"]]
    | ~else: ["dynamic", step.operands[1]]

  for (step in schedule.steps, position in 0..schedule.steps.length()):
    def mutable result = #false
    when step.opcode in ["rtl.record_get", "rtl.vector_get", "rtl.vector_index"]
    | def key = [step.operands[0], [part(step)]]
      unless queries.has_key(key)
      | def mutable remaining = 64
        def mutable found = #false
        def mutable aborted = #false
        def projections = MutableMap{}
        def recipes = MutableList[]
        /* Use shallow recipe IDs instead of recursively hashed expression trees. */
        fun node(opcode :: String, type :: HardwareType, operands :: List.of(Nat), attributes :: Map = {}) :: Nat:
          def id = schedule.steps.length() + recipes.length()
          recipes.add(RsimStep(opcode, type, operands, attributes, step.occurrence))
          id

        /* Build a projection without assuming that its container is materialized.
           Whole-value leaves retain their original source identities. */
        fun project(value :: Nat, path :: List):
          def key = [value, path]
          unless projections.has_key(key)
          | remaining := remaining - 1
            def source = schedule.steps[value]
            def recipe:
              cond
              | remaining < 0:
                  aborted := #true
                  value
              | path.length() == 0: value
              | source.opcode in ["rtl.record_get", "rtl.vector_get", "rtl.vector_index"]:
                  project(source.operands[0], [part(source)] ++ path)
              | source.opcode == "rtl.record_create" && path[0][0] == "field":
                  project(source.operands[source.attributes["fields"].index(path[0][1])], path.drop(1))
              | source.opcode == "rtl.vector_create" && path[0][0] == "lane":
                  project(source.operands[path[0][1]], path.drop(1))
              | source.opcode == "rtl.mux_lookup":
                  node("rtl.mux_lookup", step.type, [source.operands[0]] ++ source.operands.drop(1).map(fun (branch): project(branch, path)), source.attributes)
              | source.opcode == "rtl.vector_inject" && path[0][0] in ["lane", "dynamic"]:
                  found := #true
                  def index = source.operands[1]
                  def width = scalar_width(schedule.steps[index].type)
                  def dynamic = path[0][0] == "dynamic"
                  def read = path[0][1]
                  def read_width = if dynamic | scalar_width(schedule.steps[read].type) | width
                  def compare_width = if width > read_width | width | read_width
                  /* Extend unequal index widths before comparing their full values. */
                  fun extend(value :: Nat, width :: PosInt):
                    if width == compare_width | value | node("rtl.zext", Bits(compare_width), [value])

                  def other = if dynamic | extend(read, read_width) | node("rtl.constant", Bits(width), [], {"value": read})
                  def equal = if dynamic && remap(index) == remap(read)
                  | node("rtl.constant", Bits(1), [], {"value": 1})
                  | node("rtl.eq", Bits(1), [extend(index, width), other])

                  def length = source.type.length
                  def condition = if dynamic && length < 2 ** read_width
                  | node("rtl.and", Bits(1), [equal, node("rtl.ult", Bits(1), [read, node("rtl.constant", Bits(read_width), [], {"value": length})])])
                  | equal

                  if !dynamic && read >= 2 ** width
                  | project(source.operands[0], path)
                  | node("rtl.mux_lookup", step.type, [condition, project(source.operands[0], path), project(source.operands[2], path.drop(1))], {"keys": [1]})
              | ~else:
                  def mutable type = source.type
                  def mutable recipe = value
                  for (selection in path):
                    def kind = selection[0]
                    type := if kind == "field" | type.field(selection[1]).type | type.element_type
                    recipe := if kind == "dynamic"
                    | node("rtl.vector_index", type, [recipe, selection[1]])
                    | node((if kind == "field" | "rtl.record_get" | "rtl.vector_get"), type, [recipe], {(if kind == "field" | "field" | "index"): selection[1]})

                  recipe

            projections[key] := recipe

          projections[key]

        def recipe = project(key[0], key[1])
        queries[key] := if found && !aborted | emit(recipe, recipes, MutableMap{}) | #false

      result := queries[key]

    if result != #false
    | changed := #true
      refs[position] := result
    | refs[position] := steps.length()
      def operands = step.operands.map(remap)
      // Forwarded aliases can make an existing comparison reflexive. Fold only
      // those new aliases, avoiding tautological-comparison warnings in C++.
      if step.opcode in ["rtl.eq", "rtl.ult", "rtl.slt"] && step.operands[0] != step.operands[1] && operands[0] == operands[1]
      | changed := #true
        steps.add(RsimStep("rtl.constant", step.type, [], {"value": if step.opcode == "rtl.eq" | 1 | 0}, step.occurrence))
      | steps.add(RsimStep(step.opcode, step.type, operands, step.attributes, step.occurrence))

  if changed | remap_schedule(schedule, steps.snapshot(), remap) | schedule

/* Fold only a complete vector of matching lanes. Shared original lane values
   remain available to other consumers; a later liveness scan decides removal.
   Replacement operands are earlier steps and retain their hardware identities. */
fun compact_array_updates(schedule :: RsimSchedule) :: RsimSchedule:
  def rewritten = MutableList[]
  def refs = MutableMap{}
  def signatures = MutableMap{}
  def interned = MutableMap{}
  def candidates = MutableMap{}
  /* Intern shallow structural keys so shared mux trees do not become large
     recursively hashed keys. Leaves retain their exact source identities. */
  fun intern(key :: List) :: Nat:
    unless interned.has_key(key) | interned[key] := interned.length()
    interned[key]

  /* Compare a value with virtual static projections through constructors and
     lookup muxes. Original steps preserve lanes of already recovered updates.
     The depth bound declines expensive matches; it never changes semantics. */
  fun signature(value :: Nat, path :: List, fuel :: Nat = 64) :: maybe(Nat):
    def key = [value, path]
    unless signatures.has_key(key)
    | def step = schedule.steps[value]
      def result:
        cond
        | fuel == 0: #false
        | step.opcode == "rtl.vector_get":
            signature(step.operands[0], [step.attributes["index"]] ++ path, fuel - 1)
        | step.opcode == "rtl.record_get":
            signature(step.operands[0], [step.attributes["field"]] ++ path, fuel - 1)
        | path.length() > 0 && step.opcode == "rtl.vector_create":
            signature(step.operands[path[0]], path.drop(1), fuel - 1)
        | path.length() > 0 && step.opcode == "rtl.record_create":
            signature(step.operands[step.attributes["fields"].index(path[0])], path.drop(1), fuel - 1)
        | step.opcode == "rtl.mux_lookup":
            def branches = step.operands.drop(1).map(fun (operand): signature(operand, path, fuel - 1))
            def attributes = MutableMap{}
            for ((name, attr) in step.attributes):
              unless name == "name" | attributes[name] := attr

            if #false in branches
            | #false
            | intern(["mux", step.operands[0], attributes.snapshot(), branches])
        | ~else: intern(["leaf", value, path])

      signatures[key] := result

    signatures[key]

  /* Recover one indexed replacement, keeping the existing projection proof
     for its base. Every lane must agree on the enable as well as the update. */
  fun indexed(lane_values :: List.of(Nat), type :: HardwareType) :: maybe(List):
    def lanes = for List (operand in lane_values, lane in 0..lane_values.length()): update_lane(operand, lane, schedule.steps)
    def update = lanes.length() > 0 && lanes[0]
    // Scalar CSE removes representation-preserving casts (for example Bits(1)
    // to Bool). Accept those carriers without conflating nominal aggregates.
    def replacement_type = if update | schedule.steps[update[2]].type | type.element_type
    def width = scalar_width(type.element_type)
    def compatible = type_equal(type.element_type, replacement_type) || (width != #false && width == scalar_width(replacement_type))
    def consistent = update && compatible
      && (for all (lane in lanes): lane && lane[1] == update[1] && lane[2] == update[2] && lane[3] == update[3])
    def mutable base = #false
    when consistent
    | def old = schedule.steps[update[0]]
      // Direct projections need no structural signature search.
      when old.opcode == "rtl.vector_get" && old.attributes["index"] == 0
        && type_equal(type, schedule.steps[old.operands[0]].type)
        && (for all (lane in lanes, index in 0..lanes.length()):
              def source = schedule.steps[lane[0]]
              source.opcode == "rtl.vector_get" && source.operands[0] == old.operands[0]
                && source.attributes["index"] == index)
      | base := old.operands[0]

      when base == #false
      | def first = signature(update[0], [])
        when first != #false
        | base := candidates.get(first, []).find(
            fun (candidate):
              type_equal(type, schedule.steps[candidate].type)
                && (for all (lane in lanes, index in 0..lanes.length()):
                      def actual = signature(lane[0], [])
                      actual != #false && actual == signature(candidate, [index]))
          )

    if base != #false | ["update", base, update[1], update[2], update[3]] | #false

  /* Resolve original values only when emitting an accepted recipe. Rejected
     candidates add no computations or changed dependencies to the schedule. */
  fun remap(value :: Nat) :: Nat: refs[value]

  def mutable changed = #false
  for (step in schedule.steps, position in 0..schedule.steps.length()):
    def mutable remaining = 64
    /* Transpose shared lookup choices only around a proven indexed update.
       Selector identities, ordered keys, and defaults must match every lane.
       Unrecognized sibling branches retain their original lane computations;
       the total query budget bounds nested choices without partial rewrites. */
    fun recover(lanes :: List.of(Nat)) :: maybe(List):
      remaining := remaining - 1
      cond
      | remaining < 0: #false
      | ~else:
          def update = indexed(lanes, step.type)
          def first = schedule.steps[lanes[0]]
          cond
          | update: update
          | first.opcode == "rtl.mux_lookup"
              && (for all (lane in lanes):
                    def other = schedule.steps[lane]
                    other.opcode == first.opcode && other.operands[0] == first.operands[0]
                      && other.attributes["keys"] == first.attributes["keys"]):
              if first.operands.length() - 1 > remaining
              | remaining := -1
                #false
              | block:
                  def alternatives = for List (arm in 1..first.operands.length()):
                    for List (lane in lanes): schedule.steps[lane].operands[arm]

                  def branches = alternatives.map(recover)
                  if remaining >= 0 && (for any (branch in branches): branch != #false)
                  | ["mux", first.operands[0], first.attributes["keys"],
                     for List (branch in branches, arm_lanes in alternatives): branch || ["lanes", arm_lanes]]
                  | #false
          | ~else: #false

    def recipe = if step.opcode == "rtl.vector_create" && step.operands.length() > 0
    | recover(step.operands)
    | #false

    /* Emit ordinary schedule operations in dependency order. Existing array
       fusion and liveness pruning own destinations and shared consumers. */
    fun emit(recipe :: List) :: Nat:
      /* Append one generated aggregate operation with the source occurrence. */
      fun add(opcode :: String, operands :: List.of(Nat), attributes :: Map = {}) :: Nat:
        def id = rewritten.length()
        rewritten.add(RsimStep(opcode, step.type, operands, attributes, step.occurrence))
        id

      match recipe[0]
      | "update":
          def base = remap(recipe[1])
          def updated = add("rtl.vector_inject", [base, remap(recipe[2]), remap(recipe[3])], step.attributes)
          if recipe[4] == #false
          | updated
          | add("rtl.mux_lookup", [remap(recipe[4]), base, updated], {"keys": [1]})
      | "mux": add("rtl.mux_lookup", [remap(recipe[1])] ++ recipe[3].map(emit), {"keys": recipe[2]})
      | "lanes": add("rtl.vector_create", recipe[1].map(remap))
      | ~else: error(~who: #'rsim, "unknown array update recipe")

    if recipe
    | changed := #true
      refs[position] := emit(recipe)
    | refs[position] := rewritten.length()
      rewritten.add(RsimStep(step.opcode, step.type, step.operands.map(remap), step.attributes, step.occurrence))

    // Only earlier whole aggregates can become bases. Bound each bucket and
    // prefer recent candidates; type equality and every lane still require proof.
    when vector_type(step.type) && step.opcode in ["rtl.vector_create", "rtl.mux_lookup"]
    | def first = signature(position, [0])
      when first != #false
      | def earlier = candidates.get(first, [])
        candidates[first] := [position] ++ earlier.take(if earlier.length() < 15 | earlier.length() | 15)

  def recovered = if changed | remap_schedule(schedule, rewritten.snapshot(), remap) | schedule
  def interim = forward_array_reads(recovered)
  if interim === schedule
  | schedule
  | prune_schedule(interim)
