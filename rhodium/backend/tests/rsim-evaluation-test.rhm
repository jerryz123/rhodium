#lang rhombus
// SPDX-License-Identifier: Apache-2.0
import:
  "../../core/main.rhm" open
  "../../lowering/program.rhm".ElaboratedProgram
  "../../compile/rtl.rhm".prepare_rtl
  "../../compile/contracts.rhm".CompileOptions
  "../rsim/plan.rhm" open
  "../rsim/evaluation.rhm" open
  "../rsim/regions.rhm" open
  "../rsim/emit.rhm".emit_rsim
  "rsim/fixtures.rhm".make_scalar
  "rsim/aggregate-fixtures.rhm".make_aggregate
  "rsim/wide-fixtures.rhm".make_constant_rom
  "rsim/wide-foreign-fixtures.rhm".make_unused_wide_foreign
  "rsim/memory-fixtures.rhm".make_memory

// Mix storage roots with frame-only consumers. Reset deliberately occupies
// step zero, while write controls/data must not enter the output closure.
def design = Design()
def b = Builder(design)
def top = b.module("Evaluation")
def clock = b.input(top, "clock", Clock)
def reset = b.input(top, "reset", Reset)
def address = b.input(top, "address", Bits(2))
def data = b.input(top, "data", Bits(8))
def enable = b.input(top, "enable", Bits(1))
def mode = b.input(top, "mode", Bits(1))
def mask = b.input(top, "mask", Bits(8))
def reset_data = b.input(top, "reset_data", Bits(8))
def reg = b.register(top, "q", Bits(8), clock, reset, reset_data)
b.drive(reg.next, b.add(top, reg.current, data))
def memory = b.memory(top, "async", 4, Bits(8))
def word = b.memory_read_async(top, memory, address)
b.memory_write(top, memory, address, data, clock, enable)
def sync = b.sync_memory(top, "sync", 4, Bits(8), clock, #false, #false, #true, 1)
def port = sync.read_write_ports[0]
b.drive(port.address, address)
b.drive(port.enable, enable)
b.drive(port.write, mode)
b.drive(port.write_data, data)
b.drive(port.write_mask, mask)
def imp = b.dpi_import_results("evaluation_foreign", ["data"], [Bits(8)],
                               [DpiResult("unused", Bits(8), "out"), DpiResult("used", Bits(8), "return")])
def foreign = b.dpi_register_results(top, ["unused", "used"], imp, [data], clock, enable)
def shared = b.add(top, reg.current, foreign[1])
for (name in ["shared", "shared_again"]):
  b.drive(b.output(top, name, Bits(8)), shared)
b.drive(b.output(top, "word", Bits(8)), word)
b.drive(b.output(top, "sync_word", Bits(8)), port.read_data)
b.assert(top, b.eq(top, reg.current, data), clock, reset, enable, "sampled")
b.finish(top)
def prepared = prepare_rtl(ElaboratedProgram(design, top), CompileOptions(), "evaluation test")
def schedule = build_schedule(prepared.rtl)
def evaluation = build_evaluation_plan(schedule)

fun input(name :: String):
  schedule.inputs.filter(~keep: fun (port): port.name == name)[0].value

fun sink(kind :: String):
  evaluation.pre_edge.sinks.filter(~keep: fun (sink): sink.kind == kind)[0]

fun storage(reads :: List.of(RsimStorageRead)):
  reads.map(fun (read): [read.kind, read.slot, read.result])

fun ids(indices :: List.of(Nat)):
  for Set (index in indices): index

check:
  evaluation ~is build_evaluation_plan(schedule)
  evaluation.pre_edge.steps ~is for List (index in 0..schedule.steps.length()): index
  evaluation.pre_edge.sinks.map(fun (sink): sink.kind) ~is ["foreign", "assertion", "register", "sync_read", "write", "write"]
  input("reset") ~is 0
  sink("register").dependencies.values ~is [schedule.registers[0].next_value, 0, input("reset_data")]
  sink("register").dependencies.storage ~is []
  sink("assertion").dependencies.values ~is [input("enable"), 0, schedule.assertions[0].condition]
  sink("foreign").dependencies.values ~is [input("enable"), input("data")]
  storage(sink("foreign").dependencies.storage) ~is [["foreign", 0, 0], ["foreign", 0, 1]]
  sink("sync_read").dependencies.values ~is [input("address"), input("enable"), input("mode")]

def memory_slots = for Map (memory in schedule.memories, index in 0..schedule.memories.length()):
  values(memory.name, index)
def writes = evaluation.pre_edge.sinks.filter(~keep: fun (sink): sink.kind == "write")
check:
  storage(sink("sync_read").dependencies.storage) ~is [["memory", memory_slots["sync"], #false]]
  writes[0].dependencies.values ~is [input("address"), input("data"), input("enable")]
  writes[0].dependencies.storage ~is []
  writes[1].dependencies.values ~is [input("address"), input("data"), input("enable"), input("mode"), input("mask")]
  storage(writes[1].dependencies.storage) ~is [["memory", memory_slots["sync"], #false]]

// Only the address input contributes to outputs; the state roots must not
// recursively pull in resets, updates, call arguments, or memory writers.
def output_inputs = evaluation.outputs.steps.filter(~keep: fun (index): schedule.steps[index].opcode == "input")
def roots = evaluation.outputs.steps.filter(~keep: fun (index): schedule.steps[index].opcode in ["state", "foreign_result", "sync_read", "memory_read"])
def root_storage = for Map (index in roots):
  values(schedule.steps[index].opcode, storage(evaluation.dependencies[index].storage))
check:
  output_inputs ~is [input("address")]
  ids(evaluation.outputs.steps).length() ~is evaluation.outputs.steps.length()
  evaluation.outputs.sinks.map(fun (sink): sink.kind) ~is ["output", "output", "output", "output"]
  evaluation.outputs.sinks.map(fun (sink): sink.dependencies.values) ~is schedule.outputs.map(fun (port): [port.value])
  root_storage ~is {"state": [["register", 0, #false]], "foreign_result": [["foreign", 0, 1]], "memory_read": [["memory", memory_slots["async"], #false]], "sync_read": [["sync_read", 0, #false]]}

// Every scheduled operand and final consumer remains available in its body.
// This also protects shared output computations without renumbering value IDs.
for (body in [evaluation.pre_edge, evaluation.outputs]):
  def available = MutableSet{}
  for (index in body.steps):
    for (operand in evaluation.dependencies[index].values):
      check: operand in available ~is #true
    available.add(index)
  for (sink in body.sinks):
    for (value in sink.dependencies.values):
      check: value in available ~is #true

// No output traversal is needed to retain calls and their unconsumed results.
def unused = build_schedule(prepare_rtl(make_unused_wide_foreign(), CompileOptions(), "unused test").rtl)
def unused_plan = build_evaluation_plan(unused)
check:
  unused_plan.outputs ~is RsimEvaluation([], [])
  unused_plan.pre_edge.sinks.length() ~is unused.foreign_calls.length()
  unused_plan.pre_edge.sinks[0].dependencies.storage.length() ~is unused.foreign_calls[0].import_decl.results.length()

// Shared definitions must still identify different storage at each occurrence.
def repeated = build_schedule(prepare_rtl(make_memory(3, #false), CompileOptions(), "occurrences").rtl)
def repeated_plan = build_evaluation_plan(repeated)
def sampled = for List (sink in repeated_plan.pre_edge.sinks.filter(~keep: fun (sink): sink.kind == "register")):
  def read = repeated_plan.dependencies[repeated.registers[sink.index].next_value]
  if read.storage.length() == 0 | #false | read.storage[0].slot
def sampled_slots = sampled.filter(~keep: fun (slot): slot != #false)
def sampled_paths = sampled_slots.map(fun (slot): repeated.memories[slot].path)
check:
  ids(sampled_slots).length() ~is 2
  sampled_paths ~is [["side0"], ["side1"]]

// Check forward partitioning against an independent backward liveness walk.
// Only direct region consumers are inputs; passing across an unrelated region
// must not create a redundant argument or a new producer for a live value.
fun check_regions(schedule :: RsimSchedule, evaluation :: RsimEvaluationPlan, body :: RsimEvaluation, budget :: PosInt):
  def regions = build_regions(schedule, evaluation, body, ~budget: budget)
  def steps = MutableList[]
  def sinks = MutableList[]
  for (region in regions):
    for (index in region.steps): steps.add(index)
    for (sink in region.sinks): sinks.add(sink)
    check:
      region.steps.length() + region.sinks.length() > 0 ~is #true
      region.cost <= budget || region.steps.length() + region.sinks.length() == 1 ~is #true
  check:
    steps.snapshot() ~is body.steps
    sinks.snapshot() ~is body.sinks
    regions ~is build_regions(schedule, evaluation, body, ~budget: budget)
  def future = MutableSet{}
  for (offset in 0..regions.length()):
    def region = regions[regions.length() - 1 - offset]
    def defined = ids(region.steps.filter(~keep: fun (index): !evaluation.constants.has_key(index)))
    def uses = MutableSet{}
    def resources = MutableSet{}
    def constant_uses = MutableSet{}
    for (index in region.steps):
      if evaluation.constants.has_key(index)
      | constant_uses.add(index)
      | for (operand in evaluation.dependencies[index].values): uses.add(operand)
        for (read in evaluation.dependencies[index].storage): resources.add(read)
    for (sink in region.sinks):
      for (value in sink.dependencies.values): uses.add(value)
      for (read in sink.dependencies.storage): resources.add(read)
    for (value in uses):
      when evaluation.constants.has_key(value) | constant_uses.add(value)
    def incoming = MutableSet{}
    for (value in uses):
      unless value in defined || evaluation.constants.has_key(value) | incoming.add(value)
    def outgoing = MutableSet{}
    for (value in defined):
      when value in future | outgoing.add(value)
    check:
      ids(region.inputs) ~is incoming.snapshot()
      ids(region.outputs) ~is outgoing.snapshot()
      ids(region.constants) ~is constant_uses.snapshot()
      (for Set (read in region.storage): read) ~is resources.snapshot()
    for (value in defined): future.remove(value)
    for (value in incoming): future.add(value)
  check: future.snapshot() ~is Set{}

def scalar = build_schedule(prepare_rtl(make_scalar(5), CompileOptions(), "scalar regions").rtl)
def rom = build_schedule(prepare_rtl(make_constant_rom(65), CompileOptions(), "constant regions").rtl)
for (scheduled in [schedule, repeated, unused, scalar, rom]):
  def planned = build_evaluation_plan(scheduled)
  for (body in [planned.pre_edge, planned.outputs]):
    for (budget in [1, 24, 4096]): check_regions(scheduled, planned, body, budget)

// A single region keeps every intermediate local, including values needed by
// its final frame consumers. An outputless body produces no empty helper region.
def together = build_regions(schedule, evaluation, evaluation.pre_edge, ~budget: 1000000)
check:
  together.length() ~is 1
  together[0].inputs ~is []
  together[0].outputs ~is []
  build_regions(unused, unused_plan, unused_plan.outputs) ~is []

// With one item per region, reset remains live directly from its producer to
// the assertion and register consumers, through unrelated intervening regions.
def single = build_regions(schedule, evaluation, evaluation.pre_edge, ~budget: 1)
def reset_sinks = single.filter(~keep: fun (region): region.sinks.length() > 0 && region.sinks[0].kind in ["assertion", "register"])
check:
  single.length() ~is evaluation.pre_edge.steps.length() + evaluation.pre_edge.sinks.length()
  single[0].steps ~is [input("reset")]
  single[0].outputs ~is [input("reset")]
  single[1].inputs ~is []
  reset_sinks.length() ~is 2
  (for all (region in reset_sinks): input("reset") in region.inputs) ~is #true

// Materialized constant casts bind immutable objects in every consumer region.
// Their source aliases need no scratch storage even when separated by a cut.
def rom_plan = build_evaluation_plan(rom)
def rom_regions = build_regions(rom, rom_plan, rom_plan.pre_edge, ~budget: 1)
def constant_regions = rom_regions.filter(~keep: fun (region): region.steps.length() == 1 && rom_plan.constants.has_key(region.steps[0]))
check:
  constant_regions.length() > 0 ~is #true
  (for any (region in constant_regions): rom.steps[region.steps[0]].opcode == "rtl.cast") ~is #true
  (for all (region in constant_regions): region.cost == 1 && region.inputs == [] && region.outputs == []) ~is #true

// The budget reflects carrier work, not just the number of RTL nodes. A large
// aggregate input or result copy may exceed it alone and must still make progress.
fun copy_regions(type :: HardwareType):
  def d = Design()
  def builder = Builder(d)
  def module = builder.module("CopyCost")
  def input = builder.input(module, "value", type)
  builder.drive(builder.output(module, "result", type), input)
  builder.finish(module)
  def schedule = build_schedule(prepare_rtl(ElaboratedProgram(d, module), CompileOptions(), "copy cost").rtl)
  def evaluation = build_evaluation_plan(schedule)
  build_regions(schedule, evaluation, evaluation.outputs, ~budget: 8)

def narrow_copy = copy_regions(Bits(5))
def wide_copy = copy_regions(Bits(512))
def aggregate_copy = copy_regions(RecordType([RecordField("tag", Bits(5)), RecordField("words", VectorType(4, Bits(512)))]))
check:
  narrow_copy.length() ~is 1
  wide_copy.length() ~is 2
  aggregate_copy.length() ~is 2
  wide_copy[0].cost > narrow_copy[0].cost ~is #true
  aggregate_copy[0].cost > wide_copy[0].cost ~is #true
  aggregate_copy[1].cost > 8 ~is #true // Output/frame copies count too.

// Reject broken bodies at planning, before generated helpers could read an
// uninitialized boundary value. These IDs come from the valid Builder fixture.
check:
  build_regions(schedule, evaluation, RsimEvaluation([schedule.outputs[0].value], [])) ~throws "before its definition"
  build_regions(schedule, evaluation, RsimEvaluation([input("data"), input("reset")], [])) ~throws "retain schedule order"

// Protect the emitted compilation boundary and storage contract in addition to
// the planner's liveness checks. Native fixtures test the resulting semantics.
for (budget in [1, 24, 4096]):
  def contents = emit_rsim(schedule, ~region_budget: budget)
  check: contents ~is emit_rsim(schedule, ~region_budget: budget)
  for (body in [evaluation.pre_edge, evaluation.outputs], phase in ["pre", "output"]):
    def regions = build_regions(schedule, evaluation, body, ~budget: budget)
    def split = regions.length() > 1
    check:
      contents[0].contains("struct " ++ phase ++ "Scratch") ~is split
      contents[1].split("RHODIUM_RSIM_NOINLINE void Model::" ++ phase ++ "_region").length() - 1 ~is (if split | regions.length() | 0)
    when split
    | for (region in regions, number in 0..regions.length()):
        def helper = contents[1].split("RHODIUM_RSIM_NOINLINE void Model::" ++ phase ++ "_region" ++ to_string(number) ++ "(")[1].split("\n}")[0]
        for (value in region.outputs):
          check: helper.contains("const auto& v" ++ to_string(value) ++ " = scratch.") ~is #true
        for (value in region.steps):
          unless value in region.outputs || evaluation.constants.has_key(value)
          | check: helper.contains(" v" ++ to_string(value) ++ " = scratch.") ~is #false
        check:
          helper.contains("foreign::") ~is #false
          helper.contains("throw ") ~is #false
          helper.contains("state_ =") ~is #false

// A crossing mux can borrow only storage that outlives its producer. With a
// one-step budget both branches cross; at 22 both branches are helper locals
// and only the result crosses into the output consumer.
def borrow_design = Design()
def borrow_builder = Builder(borrow_design)
def borrow_top = borrow_builder.module("BoundaryMux")
def borrow_type = VectorType(2, Bits(5))
def borrow_select = borrow_builder.input(borrow_top, "select", Bits(1))
def borrow_data = borrow_builder.input(borrow_top, "data", borrow_type)
def borrow_scalar = borrow_builder.input(borrow_top, "scalar", Bits(5))
def borrow_local = borrow_builder.vector_create(borrow_top, borrow_type, [borrow_scalar, borrow_scalar])
def borrow_mux = borrow_builder.mux_lookup(borrow_top, borrow_select, borrow_data, [[1, borrow_local]])
borrow_builder.drive(borrow_builder.output(borrow_top, "result", borrow_type), borrow_mux)
borrow_builder.finish(borrow_top)
def borrow_schedule = build_schedule(prepare_rtl(ElaboratedProgram(borrow_design, borrow_top), CompileOptions(), "borrow lifetime").rtl)
def borrow_evaluation = build_evaluation_plan(borrow_schedule)
def local_regions = build_regions(borrow_schedule, borrow_evaluation, borrow_evaluation.outputs, ~budget: 22)
check:
  local_regions.length() ~is 2
  local_regions[0].outputs ~is [borrow_schedule.outputs[0].value]
  local_regions[0].inputs ~is []
  emit_rsim(borrow_schedule, ~region_budget: 1)[1].contains(" = &(") ~is #true
  emit_rsim(borrow_schedule, ~region_budget: 1)[0].contains("const std::array<std::uint64_t, 2>*") ~is #true
  emit_rsim(borrow_schedule, ~region_budget: 22)[1].contains(" = &(") ~is #false
  emit_rsim(borrow_schedule, ~region_budget: 22)[0].contains("std::array<std::array<std::uint64_t, 2>, 1>") ~is #true

// Native aggregate scoreboards include constants, chained/multi-arm lookup
// muxes, nested records/vectors, state capture, and dirty input padding. Protect
// that their forced-boundary run actually exercises pointer-backed results.
def aggregate_schedule = build_schedule(prepare_rtl(make_aggregate(5), CompileOptions(), "aggregate borrowing").rtl)
def aggregate_emission = emit_rsim(aggregate_schedule, ~region_budget: 24)
check:
  aggregate_emission ~is emit_rsim(aggregate_schedule, ~region_budget: 24)
  aggregate_emission[1].contains(" = &(") ~is #true
