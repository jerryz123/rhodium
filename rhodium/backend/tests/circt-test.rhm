def shifts_circt = emit_circt(shifts_fixture_design)
// Derive temporary names from the prepared graph, whose IDs differ from source construction.
def shift_ids = shifts_fixture_design.modules[0].operations.filter(
  ~keep: fun (op): op.opcode in ["rtl.shl", "rtl.shru"]
).map(fun (op): to_string(op.id))

check:
  shifts_circt.contains("comb.concat %__rhodium_shift_zero_" ++ shift_ids[0] ++ ", %amount : i5, i3") ~is #true
  shifts_circt.contains("comb.shl %value, %__rhodium_shift_amount_" ++ shift_ids[0] ++ " : i8") ~is #true
  shifts_circt.contains("comb.shru %value, %__rhodium_shift_amount_" ++ shift_ids[1] ++ " : i8") ~is #true
  shifts_circt.contains("comb.concat %__rhodium_shift_zero_" ++ shift_ids[2] ++ ", %value : i4, i8") ~is #true
  shifts_circt.contains("comb.shl %__rhodium_shift_value_" ++ shift_ids[2] ++ ", %wide_amount : i12") ~is #true
  shifts_circt.contains("comb.shru %__rhodium_shift_value_" ++ shift_ids[3] ++ ", %wide_amount : i12") ~is #true
  shifts_circt.contains("comb.extract %__rhodium_shift_wide_" ++ shift_ids[2] ++ " from 0 : (i12) -> i8") ~is #true
  shifts_circt.contains("comb.extract %__rhodium_shift_wide_" ++ shift_ids[3] ++ " from 0 : (i12) -> i8") ~is #true
  shifts_circt.contains("hw.constant 3 : i2") ~is #true

def same_shift_design = Design()
def same_shift_builder = Builder(same_shift_design)
def same_shift_module = same_shift_builder.module("SameWidthShifts")
def same_shift_value = same_shift_builder.input(same_shift_module, "value", Bits(8))
def same_shift_amount = same_shift_builder.input(same_shift_module, "amount", Bits(8))
def same_shift_left_output = same_shift_builder.output(same_shift_module, "left", Bits(8))
def same_shift_right_output = same_shift_builder.output(same_shift_module, "right", Bits(8))
def same_shift_left = same_shift_builder.shl(same_shift_module,
                                             same_shift_value,
                                             same_shift_amount)
def same_shift_right = same_shift_builder.shru(same_shift_module,
                                               same_shift_value,
                                               same_shift_amount)
same_shift_builder.drive(same_shift_left_output, same_shift_left)
same_shift_builder.drive(same_shift_right_output, same_shift_right)
def finished_same_shift_module = same_shift_builder.finish(same_shift_module)
def same_shift_circt = emit_circt(same_shift_design)

check:
  same_shift_circt.contains("comb.shl %value, %amount : i8") ~is #true
  same_shift_circt.contains("comb.shru %value, %amount : i8") ~is #true
  same_shift_circt.contains("__rhodium_shift_zero_") ~is #false

