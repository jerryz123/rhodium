  bundle_circt.contains("!hw.struct<left: i8, right: i8>") ~is #true
  bundle_circt.contains("hw.bitcast") ~is #true
  bundle_circt.contains("comb.mux %select, %direct, %alternate : !hw.typealias<@rhodium_types::@Pair") ~is #true
  bundle_circt.contains("seq.firreg") ~is #true
  bundle_circt.contains("reset sync %reset") ~is #true
  record_cast_circt.contains("hw.bitcast %source : (!hw.typealias<@rhodium_types::@Pair, !hw.struct<left: i8, right: i8>>) -> i16") ~is #true
  record_cast_circt.contains("-> !hw.typealias<@rhodium_types::@Pair") ~is #true
  bundle_specializations_circt.contains("hw.typedecl @Pair : !hw.struct<left: i8, right: i8>") ~is #true
  bundle_specializations_circt.contains("hw.typedecl @Pair_1 : !hw.struct<left: i16, right: i16>") ~is #true
  bundle_specializations_circt.contains("out narrow_result : !hw.typealias<@rhodium_types::@Pair") ~is #true
  bundle_specializations_circt.contains("out wide_result : !hw.typealias<@rhodium_types::@Pair_1") ~is #true
  nested_bundle_circt.contains("hw.typedecl @Envelope : !hw.struct<payload: !hw.typealias<@rhodium_types::@Pair") ~is #true

// One shared anonymous type must render against only the current design's aliases.
fun alias_scope_design(shared :: RecordType, preferred_name :: maybe(String)):
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("AliasScope")
  def named = builder.input(module_def, "named", RecordType(shared.fields, preferred_name))
  def plain = builder.input(module_def, "plain", shared)
  def named_output = builder.output(module_def, "named_result", shared)
  def plain_output = builder.output(module_def, "plain_result", shared)
  builder.drive(named_output, named)
  builder.drive(plain_output, plain)
  builder.finish(module_def)
  design

def shared_record = RecordType([RecordField("word", Bits(8))])
def first_alias_design = alias_scope_design(shared_record, "First")
def second_alias_design = alias_scope_design(shared_record, "Second")
def anonymous_alias_design = alias_scope_design(shared_record, #false)
def standalone_alias_module = emit_module_circt(first_alias_design.modules[0])
def first_alias_circt = emit_circt(first_alias_design)
def second_alias_circt = emit_circt(second_alias_design)
def anonymous_alias_circt = emit_circt(anonymous_alias_design)

check:
  first_alias_circt.contains("out plain_result : !hw.typealias<@rhodium_types::@First") ~is #true
  second_alias_circt.contains("out plain_result : !hw.typealias<@rhodium_types::@Second") ~is #true
  second_alias_circt.contains("@First") ~is #false
  anonymous_alias_circt.contains("out plain_result : !hw.struct<word: i8>") ~is #true
  anonymous_alias_circt.contains("hw.type_scope") ~is #false
  emit_circt(first_alias_design) ~is first_alias_circt
  emit_circt(second_alias_design) ~is second_alias_circt
  emit_module_circt(first_alias_design.modules[0]) ~is standalone_alias_module
  standalone_alias_module.contains("hw.typealias") ~is #false

def interface_circt = emit_circt(interface_fixture_design)

check:
  interface_circt.contains("in %ingress_in : !hw.struct<valid: i1, bits: i8>") ~is #true
  interface_circt.contains("out ingress_out : !hw.struct<ready: i1>") ~is #true
  interface_circt.contains("hw.output %egress_in, %ingress_in") ~is #true

def nested_interface_circt = emit_circt(nested_interface_fixture_design)

check:
  nested_interface_circt.contains("!hw.struct<command: !hw.struct<valid: i1, bits: i8>, enable: i1, response: !hw.struct<ready: i1>>") ~is #true
  nested_interface_circt.contains("!hw.struct<command: !hw.struct<ready: i1>, response: !hw.struct<valid: i1, bits: i8>, status: i8>") ~is #true
  nested_interface_circt.contains("hw.output %egress_in, %ingress_in") ~is #true

class ScalarToken():
  implements ScalarDataType
  override method describe(): "scalar-token"
  override method type_equal(other): other is_a ScalarToken
  override method packed_width(): 7

block:
  def design = Design()
  def builder = Builder(design)
  def module_def = builder.module("ScalarTokenCast")
  def source = builder.input(module_def, "source", ScalarToken())
  def target = builder.output(module_def, "target", Bits(7))
  builder.drive(target, builder.cast(module_def, source, Bits(7)))
  builder.finish(module_def)
  def circt = emit_circt(design)
  check:
    circt.contains("in %source : i7") ~is #true
    circt.contains("out target : i7") ~is #true
    circt.contains("hw.output %source : i7") ~is #true

class OpaqueData(name):
  implements DataType
  override method describe(): "opaque<" ++ name ++ ">"
  override method type_equal(other):
    other is_a OpaqueData && name == other.name
  override method packed_width(): #false

def unsupported_design = Design()
def unsupported_builder = Builder(unsupported_design)
def unsupported_module = unsupported_builder.module("UnsupportedType")
def opaque_type = OpaqueData("payload")
def opaque_input = unsupported_builder.input(unsupported_module, "source", opaque_type)
def opaque_output = unsupported_builder.output(unsupported_module, "target", opaque_type)
unsupported_builder.drive(opaque_output, opaque_input)
def finished_unsupported_module = unsupported_builder.finish(unsupported_module)

check:
  emit_circt(unsupported_design) ~throws "CIRCT lowering does not support hardware type opaque<payload>"
