#lang rhombus
// SPDX-License-Identifier: Apache-2.0
import:
  "../../../core/main.rhm" open
export make_assertions

fun make_assertions():
  def design = Design()
  def b = Builder(design)
  def leaf = b.module("AssertionLeaf")
  def clock = b.input(leaf, "clock", Clock)
  def alias = b.wire(leaf, "clock_alias", Clock)
  b.drive(alias, clock)
  def reset = b.input(leaf, "reset", Reset)
  def guard = b.input(leaf, "guard", Bits(1))
  def condition = b.input(leaf, "condition", Bits(1))
  def unnamed_guard = b.input(leaf, "unnamed_guard", Bits(1))
  def unnamed_condition = b.input(leaf, "unnamed_condition", Bits(1))
  def sample_guard = b.input(leaf, "sample_guard", Bits(1))
  def expected = b.input(leaf, "expected_state", Bits(8))
  def next_state = b.input(leaf, "next_state", Bits(8))
  def write_enable = b.input(leaf, "write_enable", Bits(1))
  def write_data = b.input(leaf, "write_data", Bits(8))
  def read_enable = b.input(leaf, "read_enable", Bits(1))
  def read_address = b.input(leaf, "read_address", Bits(1))
  def write_address = b.input(leaf, "write_address", Bits(1))
  def late_next = b.input(leaf, "late_next", Bits(1))
  def late_mode = b.input(leaf, "late_mode", Bits(2))
  def state = b.register(leaf, "qstate", Bits(8), b.read(alias), reset, b.constant(leaf, Bits(8), 0))
  def late = b.register(leaf, "qlate", Bits(1), b.read(alias), reset, b.constant(leaf, Bits(1), 0))
  b.drive(state.next, next_state)
  b.drive(late.next, late_next)
  // A failed tick may dirty this inactive-bank array. Retrying must rebuild it
  // from current storage, preserving both the written and untouched element.
  def array_type = VectorType(2, Bits(8))
  def array_zero = b.vector_create(leaf, array_type, [b.constant(leaf, Bits(8), 0), b.constant(leaf, Bits(8), 0)])
  def array = b.register(leaf, "qarray", array_type, b.read(alias), reset, array_zero)
  def array_next = b.vector_inject(leaf, array.current, write_address, next_state)
  b.drive(array.next, array_next)
  for (index in 0..2):
    b.drive(b.output(leaf, "array" ++ to_string(index), Bits(8)), b.vector_get(leaf, array.current, index))
  def reset_bits = b.mux_lookup(leaf, late_mode, b.cast(leaf, reset, Bits(1)), [[1, late.current], [2, b.bit_not(leaf, late.current)]])
  def assertion_reset = b.cast(leaf, reset_bits, Reset)
  // The named failure condition observes the pending array version. Forwarding
  // this read must not change assertion ordering or expose a failed bank on retry.
  def checked_next = b.vector_index(leaf, array_next, write_address)
  def expected_next = b.mux_lookup(leaf, condition, b.bit_xor(leaf, next_state, b.constant(leaf, Bits(8), 1)), [[1, next_state]])
  b.assert(leaf, b.eq(leaf, checked_next, expected_next), b.read(alias), assertion_reset, guard, "named_check", Location("assert-fixture.rhdl", 30, 2))
  b.assert(leaf, unnamed_condition, b.read(alias), reset, unnamed_guard, #false, Location("dir/\"quoted\"\\checks\nline.rhdl", 41, 7))
  b.assert(leaf, b.eq(leaf, state.current, expected), b.read(alias), reset, sample_guard, "sample_check", Location("assert-fixture.rhdl", 42, 0))
  def address = b.constant(leaf, Bits(1), 0)
  def async_memory = b.memory(leaf, "async_storage", 1, Bits(8))
  b.memory_write(leaf, async_memory, address, write_data, b.read(alias), write_enable)
  def sync_memory = b.sync_memory(leaf, "sync_storage", 2, Bits(8), b.read(alias))
  b.drive(sync_memory.read_ports[0].address, read_address)
  b.drive(sync_memory.read_ports[0].enable, read_enable)
  b.drive(sync_memory.write_ports[0].address, write_address)
  b.drive(sync_memory.write_ports[0].data, write_data)
  b.drive(sync_memory.write_ports[0].enable, write_enable)
  b.drive(b.output(leaf, "state", Bits(8)), state.current)
  b.drive(b.output(leaf, "async_data", Bits(8)), b.memory_read_async(leaf, async_memory, address))
  b.drive(b.output(leaf, "sync_data", Bits(8)), sync_memory.read_ports[0].data)
  b.finish(leaf)
  // A child with no result ports must still contribute its verification sinks.
  def monitor = b.module("AssertionMonitor")
  def mc = b.input(monitor, "clock", Clock)
  def mr = b.input(monitor, "reset", Reset)
  def mg = b.input(monitor, "guard", Bits(1))
  b.assert(monitor, b.constant(monitor, Bits(1), 0), mc, mr, mg, "monitor_check", Location("monitor.rhdl", 9, 1))
  b.finish(monitor)
  def top = b.module("RsimAssertions")
  def tc = b.input(top, "clock", Clock)
  for (side in ["first", "second"]):
    def child = b.instance(top, leaf, side)
    b.drive(child.input("clock"), tc)
    for (port in leaf.inputs.filter(~keep: fun (port): port.name != "clock")):
      b.drive(child.input(port.name), b.input(top, side ++ "_" ++ port.name, port.type))
    for (port in leaf.outputs): b.drive(b.output(top, side ++ "_" ++ port.name, port.type), child.output(port.name))
  def child = b.instance(top, monitor, "monitor")
  b.drive(child.input("clock"), tc)
  b.drive(child.input("reset"), b.cast(top, b.constant(top, Bits(1), 0), Reset))
  b.drive(child.input("guard"), b.input(top, "monitor_guard", Bits(1)))
  b.assert(top, b.constant(top, Bits(1), 0), tc, b.cast(top, b.constant(top, Bits(1), 0), Reset), b.input(top, "top_guard", Bits(1)),
           #false, Location("top.rhdl", 70, 3))
  b.finish(top)
  DesignElaboration(design, top)
