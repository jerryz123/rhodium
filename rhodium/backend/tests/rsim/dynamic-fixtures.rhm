#lang rhombus
// SPDX-License-Identifier: Apache-2.0
import:
  "../../../core/main.rhm" open
export make_dynamic

fun make_dynamic(length :: PosInt, aggregate :: Boolean):
  def design = Design()
  def b = Builder(design)
  def top = b.module("Dynamic" ++ (if aggregate | "Record" | "Scalar") ++ to_string(length))
  def index_width = count_index_width(length)
  def lanes = VectorType(2, Bits(64))
  def element_type = if aggregate | RecordType([RecordField("tag", Bits(5)), RecordField("lanes", lanes)]) | Bits(64)
  def vector = VectorType(length, element_type)
  def clock = b.input(top, "clock", Clock)
  def reset = b.input(top, "reset", Reset)
  def selector = b.input(top, "selector", Bits(index_width))
  def index0 = b.input(top, "index0", Bits(index_width))
  def index1 = b.input(top, "index1", Bits(index_width))
  def enables = b.input(top, "enables", Bits(2))
  // The bench observes valid write sets, and hides invalid sets behind this mux.
  // Both backends still elaborate the partial operation in the unused arm.
  def valid_write = b.input(top, "valid_write", Bits(1))
  def a = b.input(top, "a", Bits(64))
  def z = b.input(top, "b", Bits(64))
  fun element(seed :: Nat):
    def sum = b.add(top, a, b.constant(top, Bits(64), seed))
    if aggregate
    | b.record_create(top, element_type, [["tag", b.extract(top, sum, 4, 0)], ["lanes", b.vector_create(top, lanes, [sum, b.bit_xor(top, z, b.constant(top, Bits(64), seed))])]])
    | sum
  def zero = b.constant(top, Bits(64), 0)
  def zero_element = if aggregate | b.record_create(top, element_type, [["tag", b.constant(top, Bits(5), 0)], ["lanes", b.vector_create(top, lanes, [zero, zero])]]) | zero
  def zero_vector = b.vector_create(top, vector, for List (_ in 0..length): zero_element)
  def base = b.vector_create(top, vector, for List (index in 0..length): element(index))
  def read_ok = b.ult(top, b.zext(top, selector, index_width + 1), b.constant(top, Bits(index_width + 1), length))
  def read = b.vector_index(top, base, selector)
  def injected = b.vector_inject(top, base, selector, element(11))
  def enable_values = [b.extract(top, enables, 0, 0), b.extract(top, enables, 1, 1)]
  def index_values = [index0, index1]
  def elements = [element(17), element(29)]
  fun writes(source :: Value, reverse :: Boolean):
    b.vector_write_set(top, source,
                       b.vector_create(top, VectorType(2, Bits(1)), if reverse | enable_values.reverse() | enable_values),
                       b.vector_create(top, VectorType(2, Bits(index_width)), if reverse | index_values.reverse() | index_values),
                       b.vector_create(top, VectorType(2, element_type), if reverse | elements.reverse() | elements))
  def state = b.register(top, "stored", vector, clock, reset, zero_vector)
  def captured = b.register(top, "old_read", element_type, clock, reset, zero_element)
  // Expanded updates exercise recovery from lane muxes over stable storage.
  // A separate lane observer keeps one old mux live after the vector is folded.
  def replacement = element(11)
  def expanded_lanes = for List (lane in 0..length):
    def equals = b.eq(top, b.constant(top, Bits(index_width), lane), selector)
    b.mux_lookup(top, equals, b.vector_get(top, state.current, lane), [[1, replacement]])
  def expanded = b.vector_create(top, vector, expanded_lanes)
  def updated_state = b.register(top, "q_updated_state", vector, clock, reset, zero_vector)
  b.drive(updated_state.next, expanded)
  b.drive(b.output(top, "expanded", vector), expanded)
  b.drive(b.output(top, "expandedlane", element_type), expanded_lanes[0])
  b.drive(b.output(top, "updatedstate", vector), updated_state.current)
  b.drive(state.next, b.mux_lookup(top, valid_write, state.current, [[1, writes(state.current, #false)]]))
  b.drive(captured.next, b.mux_lookup(top, read_ok, zero_element, [[1, b.vector_index(top, state.current, selector)]]))
  b.drive(b.output(top, "read", element_type), b.mux_lookup(top, read_ok, zero_element, [[1, read]]))
  b.drive(b.output(top, "injected", vector), b.mux_lookup(top, read_ok, base, [[1, injected]]))
  b.drive(b.output(top, "written", vector), b.mux_lookup(top, valid_write, base, [[1, writes(base, #false)]]))
  b.drive(b.output(top, "reversed", vector), b.mux_lookup(top, valid_write, base, [[1, writes(base, #true)]]))
  b.drive(b.output(top, "state", vector), state.current)
  b.drive(b.output(top, "captured", element_type), captured.current)
  // Private update trees exercise direct next-bank construction. The outer
  // guard masks partial indices; overlapping writes retain last-write priority.
  def fused = b.register(top, "qfused", vector, clock, reset, zero_vector)
  def first = b.vector_inject(top, fused.current, index0, element(37))
  def chained = b.vector_inject(top, first, index1, element(41))
  def alternatives = b.mux_lookup(top, enables, fused.current,
                                  [[1, b.vector_inject(top, fused.current, index0, element(17))],
                                   [2, b.vector_inject(top, fused.current, index1, element(29))], [3, chained]])
  fun in_bounds(index :: Value): b.ult(top, b.zext(top, index, index_width + 1), b.constant(top, Bits(index_width + 1), length))
  def valid_indices = b.bit_and(top, in_bounds(index0), in_bounds(index1))
  b.drive(fused.next, b.mux_lookup(top, valid_indices, fused.current, [[1, alternatives]]))
  def sampled = b.register(top, "fused_old", element_type, clock, reset, zero_element)
  b.drive(sampled.next, b.vector_get(top, fused.current, 0))
  b.drive(b.output(top, "fused", vector), fused.current)
  b.drive(b.output(top, "fusedold", element_type), sampled.current)
  // An output and another register observe this intermediate version. Its
  // consumer may fold a subsequent update, but the shared version must survive.
  def shared = b.mux_lookup(top, read_ok, fused.current, [[1, b.vector_inject(top, fused.current, selector, element(53))]])
  def shared_copy = b.register(top, "shared_copy", vector, clock, reset, zero_vector)
  def shared_update = b.register(top, "shared_update", vector, clock, reset, zero_vector)
  b.drive(shared_copy.next, shared)
  b.drive(shared_update.next, b.vector_inject(top, shared, b.constant(top, Bits(index_width), 0), element(59)))
  b.drive(b.output(top, "shared", vector), shared)
  b.drive(b.output(top, "sharedcopy", vector), shared_copy.current)
  b.drive(b.output(top, "sharedupdate", vector), shared_update.current)
  // With no reset, each successful tick still fully assigns the destination.
  def unreset = b.register(top, "qunreset", vector, clock)
  b.drive(unreset.next, b.vector_inject(top, zero_vector, b.constant(top, Bits(index_width), 0), element(61)))
  b.drive(b.output(top, "unreset", vector), unreset.current)
  // Whole work versions and projected rows coexist. The later expanded grant
  // must recover one update over the shared nested mux, preserving both views.
  def nested = b.register(top, "qnested", vector, clock, reset, zero_vector)
  def nested_old = b.register(top, "nested_old", element_type, clock, reset, zero_element)
  fun expanded_update(source :: Value, index :: Value, replacement :: Value):
    def lanes = for List (lane in 0..length):
      b.mux_lookup(top, b.eq(top, index, b.constant(top, Bits(index.type.packed_width()), lane)), b.vector_get(top, source, lane), [[1, replacement]])
    b.vector_create(top, vector, lanes)
  def work_low = expanded_update(nested.current, index0, element(67))
  def work_high = expanded_update(nested.current, index1, element(71))
  def work = b.mux_lookup(top, enable_values[1], b.mux_lookup(top, enable_values[0], nested.current, [[1, work_low]]), [[1, work_high]])
  def grant = expanded_update(work, selector, element(73))
  def nested_next = b.mux_lookup(top, valid_write, work, [[1, grant]])
  b.drive(nested.next, nested_next)
  b.drive(nested_old.next, b.vector_get(top, nested.current, 0))
  b.drive(b.output(top, "nestedbase", vector), work)
  b.drive(b.output(top, "nestednext", vector), nested_next)
  b.drive(b.output(top, "nestedstate", vector), nested.current)
  b.drive(b.output(top, "nestedold", element_type), nested_old.current)
  b.drive(b.output(top, "nestedrow", element_type), b.mux_lookup(top, read_ok, zero_element, [[1, b.vector_index(top, work, selector)]]))
  // Raw reads qualify native zero-on-miss choices; the SV oracle ignores only
  // out-of-range partial results. Mixed widths must compare full indices.
  b.drive(b.output(top, "forwardread", element_type), b.vector_index(top, chained, selector))
  def wide_chain = expanded_update(expanded_update(base, index0, element(83)), a, element(89))
  b.drive(b.output(top, "forwardwide", element_type), b.vector_index(top, wide_chain, selector))
  def last_row = b.vector_get(top, chained, length - 1)
  def last_leaf = if aggregate | b.vector_get(top, b.record_get(top, last_row, "lanes"), 1) | last_row
  b.drive(b.output(top, "forwardleaf", Bits(64)), last_leaf)
  b.finish(top)
  DesignElaboration(design, top)
