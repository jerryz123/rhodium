#lang rhodium
// SPDX-License-Identifier: Apache-2.0

hardware_enum MembershipState:
  Idle = 0
  Busy = 2
  Done = 3

sync_circuit RsimMembership():
  input value: Bits(64)
  input other: Bits(64)
  input wide: Bits(65)
  input enable: Bool
  output result: Bits(10)
  output sampled: Bits(10)
  def small = value[0..5]
  def state = value[0..2].into(MembershipState)
  def predicates = vec(
    value.is_one_of([Bits(64)(0), Bits(64)(1), Bits(64)(7), Bits(64)(63), Bits(64)(2 ** 63), Bits(64)(2 ** 64 - 1), Bits(64)(7)]),
    small.is_one_of(Bits(5)(0), Bits(5)(3), Bits(5)(5), Bits(5)(13), Bits(5)(31), Bits(5)(31)),
    small.is_one_of(for List (index in 8..24): Bits(5)(index)),
    wide.is_one_of(Bits(65)(0), Bits(65)(1), Bits(65)(2 ** 64), Bits(65)(2 ** 65 - 1)),
    value.is_one_of(other, Bits(64)(7)),
    value.is_one_of([]),
    value.is_one_of(Bits(64)(3), Bits(64)(3), Bits(64)(3)),
    value[0].into(Bool).is_one_of(Bool(#true), Bool(#true)),
    value.into(SInt(64)).is_one_of(sint(-1, 64), sint(-2 ** 63, 64), sint(7, 64)),
    state.is_one_of(MembershipState.Idle, MembershipState.Done)
  ).as_bits()
  reg held(~init: Bits(10)(0))
  when enable: held <== predicates
  result <== predicates
  sampled <== held

def program = elaborate(RsimMembership())
export program
