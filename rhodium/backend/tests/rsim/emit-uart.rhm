#lang rhombus
// SPDX-License-Identifier: Apache-2.0
import:
  rhombus/cmdline open
  lib("racket/base.rkt") as rkt
  lib("racket/file.rkt") as file
  "uart-fixture.rhdl".program
  "../../../core/printer.rhm".dump_ir
  "../../../compile/program.rhm".compile_program
  "../../rsim-target.rhm".rsim_target
  "../../verilog-target.rhm".verilog_target

def arguments = current_command_line()
unless arguments.length() == 2 && arguments[1] in ["native", "differential"]
| error("expected OUTPUT_DIRECTORY native|differential")
def before = dump_ir(program.design)
def was_sealed = program.design.sealed
def native = compile_program(program, rsim_target)
def results:
  if arguments[1] == "native"
  | [native]
  | def reference = compile_program(program, verilog_target)
    unless native.manifest.top == reference.manifest.top && native.manifest.signature == reference.manifest.signature && native.manifest.modules == reference.manifest.modules
    | error("UART compilation target manifests disagree")
    [native, reference]
unless dump_ir(program.design) == before && program.design.sealed == was_sealed | error("UART compilation changed source RTL")
for (result in results):
  for (artifact in result.artifacts):
    file.#{display-to-file}(artifact.content, rkt.#{build-path}(arguments[0], artifact.name), ~exists: #'#{truncate/replace})
