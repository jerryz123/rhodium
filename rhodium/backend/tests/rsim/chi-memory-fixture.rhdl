#lang rhodium
// SPDX-License-Identifier: Apache-2.0
import:
  lib("chi/protocol/params.rhdl").CHIFlitParams
  lib("chi/protocol/flits.rhdl") open
  lib("chi/subordinate/memory-controller.rhdl") open
  lib("chi/subordinate/dpi-memory.rhdl").CHIDPIMemory

def p = CHIFlitParams(~data_width: 512)
// Testbench launch registers keep all boundary outputs state-derived. The
// production memory and its CHI transaction timing are unchanged behind them.
sync_circuit RsimCHIMemory():
  input req_valid: Bool
  input req_bits: Bits(CHIReqFlit(p).packed_width())
  input dat_valid: Bool
  input dat_bits: Bits(CHIDatFlit(p).packed_width())
  input rsp_ready: Bool
  input read_ready: Bool
  output req_ready: Bool
  output dat_ready: Bool
  output rsp_valid: Bool
  output rsp_bits: Bits(CHIRspFlit(p).packed_width())
  output read_valid: Bool
  output read_bits: Bits(CHIDatFlit(p).packed_width())
  reg launch_req_valid(~init: Bool(#false))
  launch_req_valid <== req_valid
  reg launch_req_bits(~init: bits(0, CHIReqFlit(p).packed_width()))
  launch_req_bits <== req_bits
  reg launch_dat_valid(~init: Bool(#false))
  launch_dat_valid <== dat_valid
  reg launch_dat_bits(~init: bits(0, CHIDatFlit(p).packed_width()))
  launch_dat_bits <== dat_bits
  reg launch_rsp_ready(~init: Bool(#false))
  launch_rsp_ready <== rsp_ready
  reg launch_read_ready(~init: Bool(#false))
  launch_read_ready <== read_ready
  inst memory(CHIDPIMemory(CHIRamConfig(p, 4096, ~max_outstanding: 2, ~max_transfer_bytes: 64), 0))
  memory.identity <== CHIRamIdentity(p):
    node_id: bits(9, p.node_id_width)
    base_address: bits(0x80000000, p.request_address_width)
  memory.port.req.valid <== launch_req_valid
  memory.port.req.bits <== launch_req_bits.into(CHIReqFlit(p))
  memory.port.dat.request.valid <== launch_dat_valid
  memory.port.dat.request.bits <== launch_dat_bits.into(CHIDatFlit(p))
  memory.port.rsp.ready <== launch_rsp_ready
  memory.port.dat.response.ready <== launch_read_ready
  req_ready <== memory.port.req.ready
  dat_ready <== memory.port.dat.request.ready
  rsp_valid <== memory.port.rsp.valid
  rsp_bits <== memory.port.rsp.bits.as_bits()
  read_valid <== memory.port.dat.response.valid
  read_bits <== memory.port.dat.response.bits.as_bits()

def program = elaborate(RsimCHIMemory())
export program p
