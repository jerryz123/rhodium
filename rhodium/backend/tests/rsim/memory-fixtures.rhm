#lang rhombus
// SPDX-License-Identifier: Apache-2.0
import:
  "../../../core/main.rhm" open
  "../../../lowering/program.rhm".ElaboratedProgram
export make_memory

fun make_memory(depth :: PosInt, aggregate :: Boolean, width :: PosInt = 64):
  def design = Design()
  def b = Builder(design)
  def suffix = (if aggregate | "Record" | "Scalar") ++ to_string(depth) ++ (if width == 64 | "" | "W" ++ to_string(width))
  def address_type = Bits(memory_address_width(depth))
  def lanes = VectorType(2, Bits(width))
  def element_type = if aggregate | RecordType([RecordField("tag", Bits(5)), RecordField("lanes", lanes)]) | Bits(width)
  def leaf = b.module("MemoryLeaf" ++ suffix)
  def clock = b.input(leaf, "clock", Clock)
  def reset = b.input(leaf, "reset", Reset)
  def alias = b.wire(leaf, "clock_alias", Clock)
  b.drive(alias, clock)
  def reads = for List (index in 0..2): b.input(leaf, "read" ++ to_string(index), address_type)
  def addresses = for List (index in 0..2): b.input(leaf, "address" ++ to_string(index), address_type)
  def enables = for List (index in 0..2): b.input(leaf, "enable" ++ to_string(index), Bits(1))
  def data = for List (index in 0..2): b.input(leaf, "data" ++ to_string(index), element_type)
  def copy = b.input(leaf, "copy", Bits(1))
  def saved = b.input(leaf, "use_saved", Bits(1))
  def zero = b.constant(leaf, Bits(width), 0)
  def zero_element = if aggregate | b.record_create(leaf, element_type, [["tag", b.constant(leaf, Bits(5), 0)], ["lanes", b.vector_create(leaf, lanes, [zero, zero])]]) | zero
  def storage = b.memory(leaf, "storage", depth, element_type)
  def read_values = reads.map(fun (address): b.memory_read_async(leaf, storage, address))
  def sample = b.register(leaf, "sampled", element_type, b.read(alias), reset, zero_element)
  def address_reg = b.register(leaf, "saved_address", address_type, b.read(alias), reset, b.constant(leaf, address_type, 0))
  b.drive(sample.next, read_values[0])
  b.drive(address_reg.next, addresses[0])
  def destination0 = b.mux_lookup(leaf, saved, addresses[0], [[1, address_reg.current]])
  // Cross-copied data must come from the old memory even when the other port
  // overwrites that source address on this edge. The saved address is old too.
  b.memory_write(leaf, storage, destination0, b.mux_lookup(leaf, copy, data[0], [[1, read_values[1]]]), b.read(alias), enables[0])
  b.memory_write(leaf, storage, addresses[1], b.mux_lookup(leaf, copy, data[1], [[1, read_values[0]]]), b.read(alias), enables[1])
  for (name in ["out0", "out1", "sample"], value in read_values ++ [sample.current]):
    b.drive(b.output(leaf, name, element_type), value)
  b.drive(b.output(leaf, "address", address_type), address_reg.current)
  // Storage-only declarations must register their types even without value steps.
  b.memory(leaf, "unused", 2, RecordType([RecordField("metadata", VectorType(2, Bits(if width > 64 | width | 7)))]))
  def write_only = b.memory(leaf, "write_only", 1, Bits(width))
  b.memory_write(leaf, write_only, b.constant(leaf, Bits(1), 0), b.constant(leaf, Bits(width), 17), b.read(alias), b.constant(leaf, Bits(1), 1))
  def read_only = b.memory(leaf, "read_only", 2, Bits(width))
  b.drive(b.output(leaf, "masked", Bits(width)), b.bit_and(leaf, b.memory_read_async(leaf, read_only, b.constant(leaf, Bits(1), 0)), zero))
  b.finish(leaf)
  def top = b.module("Memory" ++ suffix)
  def tc = b.input(top, "clock", Clock)
  def controls = for Map (port in leaf.inputs.filter(~keep: fun (port): port.name != "clock" && !port.name.starts_with("enable") && !port.name.starts_with("data"))):
    values(port.name, b.input(top, port.name, port.type))
  def mask = b.input(top, "enables", Bits(4))
  def a = b.input(top, "a", Bits(width))
  def z = b.input(top, "b", Bits(width))
  fun payload(first :: Value, second :: Value):
    if aggregate
    | b.record_create(top, element_type, [["tag", b.extract(top, first, 4, 0)], ["lanes", b.vector_create(top, lanes, [first, second])]])
    | first
  def packets = [payload(a, z), payload(z, a)]
  for (side in 0..2):
    def child = b.instance(top, leaf, "side" ++ to_string(side))
    b.drive(child.input("clock"), tc)
    for ((name, value) in controls): b.drive(child.input(name), value)
    for (port in 0..2):
      b.drive(child.input("enable" ++ to_string(port)), b.extract(top, mask, side * 2 + port, side * 2 + port))
      b.drive(child.input("data" ++ to_string(port)), packets[(side + port) mod 2])
    for (port in leaf.outputs): b.drive(b.output(top, "side" ++ to_string(side) ++ "_" ++ port.name, port.type), child.output(port.name))
  b.finish(top)
  ElaboratedProgram(design, top)
