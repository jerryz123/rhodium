#lang rhombus
// SPDX-License-Identifier: Apache-2.0
import:
  "../../../core/main.rhm" open

export make_branches make_conditionals

fun make_branches():
  def design = Design()
  def b = Builder(design)
  def top = b.module("RsimBranches")
  def clock = b.input(top, "clock", Clock)
  def reset = b.input(top, "reset", Reset)
  def enable = b.input(top, "enable", Bits(1))
  def select = b.input(top, "select", Bits(2))
  def allow = b.input(top, "allow", Bits(1))
  def a = b.input(top, "a", Bits(17))
  def z = b.input(top, "b", Bits(17))
  def zero = b.constant(top, Bits(17), 0)
  def q = b.register(top, "q_state", Bits(17), clock, reset, zero)
  // Two consumers share this multiplication inside the same capture branch.
  // The native test counts actual executions of this one emitted operator.
  def product = b.mul(top, a, z)
  def adjusted = b.add(top, product, b.shru(top, product, b.constant(top, Bits(17), 3)))
  def selected = b.mux_lookup(top, select, q.current, [[1, b.add(top, adjusted, q.current)], [2, b.bit_not(top, z)]])
  b.drive(q.next, b.mux_lookup(top, enable, q.current, [[1, selected]]))
  b.drive(b.output(top, "q", Bits(17)), q.current)
  def shared = b.add(top, a, z)
  b.drive(b.output(top, "shared", Bits(17)), shared)
  // Capture and output consumers keep this producer outside the branch.
  def peer = b.register(top, "peer_state", Bits(17), clock, reset, zero)
  b.drive(peer.next, b.mux_lookup(top, enable, peer.current, [[1, b.bit_not(top, shared)]]))
  b.drive(b.output(top, "peer", Bits(17)), peer.current)
  // Control depends on datapath arithmetic; it must precede conditional work.
  def control = b.ult(top, shared, z)
  def carried = b.register(top, "carried_state", Bits(17), clock)
  b.drive(carried.next, b.mux_lookup(top, control, carried.current, [[1, b.bit_not(top, a)]]))
  b.drive(b.output(top, "carried", Bits(17)), carried.current)
  // Exclusive nested aggregate construction and old-state reads, with a
  // dynamic reset value, must survive both local and boundary representations.
  def pair = RecordType([RecordField("x", Bits(17)), RecordField("y", Bits(17))], "BranchPair")
  def reset_pair = b.record_create(top, pair, [["x", a], ["y", z]])
  def packet = b.register(top, "packet", pair, clock, reset, reset_pair)
  def next_pair = b.record_create(top, pair, [["x", b.add(top, q.current, a)], ["y", b.bit_not(top, z)]])
  b.drive(packet.next, b.mux_lookup(top, enable, packet.current, [[1, next_pair]]))
  b.drive(b.output(top, "x", Bits(17)), b.record_get(top, packet.current, "x"))
  b.drive(b.output(top, "y", Bits(17)), b.record_get(top, packet.current, "y"))
  b.assert(top, allow, clock, reset, b.constant(top, Bits(1), 1), "branch_retry")
  b.finish(top)
  DesignElaboration(design, top)

fun make_conditionals(~onehot_width: onehot_width :: maybe(PosInt) = #false):
  def design = Design()
  def b = Builder(design)
  def top = b.module("RsimConditionals" ++ (if onehot_width | to_string(onehot_width) | ""))
  // Exercise the same observable contract through lookup, narrow one-hot, or
  // wide one-hot selection. The default occupies the highest selector bit.
  fun select_value(selector :: Value, fallback :: Value, cases :: List):
    if !onehot_width
    | b.mux_lookup(top, selector, fallback, cases)
    | def matches = cases.map(fun (entry): b.eq(top, selector, b.constant(top, selector.type, entry[0])))
      def mutable matched = b.constant(top, Bits(1), 0)
      for (match in matches): matched := b.bit_or(top, matched, match)
      def bits = for List (index in 0..onehot_width):
        if index == onehot_width - 1 | b.bit_not(top, matched) | (if index < matches.length() | matches[index] | b.constant(top, Bits(1), 0))
      def choices = for List (index in 0..onehot_width):
        if index == onehot_width - 1 | fallback | (if index < cases.length() | cases[index][1] | b.constant(top, fallback.type, 0))
      b.onehot_mux(top, b.concat(top, bits.reverse()), choices)
  def clock = b.input(top, "clock", Clock)
  def reset = b.input(top, "reset", Reset)
  def select = b.input(top, "select", Bits(2))
  def write_enable = b.input(top, "write_enable", Bits(1))
  def read_enable = b.input(top, "read_enable", Bits(1))
  def call_enable = b.input(top, "call_enable", Bits(1))
  def check_enable = b.input(top, "check_enable", Bits(1))
  def expected = b.input(top, "expected", Bits(32))
  def index = b.input(top, "index", Bits(2))
  def raw_call = b.input(top, "raw_call", Bits(32))
  def products = for List (name in ["comb_data", "default_data", "shared_data", "write_data", "call_data", "check_data", "read_index", "sibling_data", "group_data"]):
    b.mul(top, b.input(top, name, Bits(32)), b.constant(top, Bits(32), 3))
  // Both arms compute; default must also be lazy. Multiple uses of the mux
  // result must not duplicate or eagerly evaluate its exclusive producers.
  def selected = select_value(select, products[1], [[1, products[0]], [2, products[2]]])
  b.drive(b.output(top, "combined", Bits(32)), b.add(top, selected, products[2]))
  b.drive(b.output(top, "inverted", Bits(32)), b.bit_not(top, selected))
  b.drive(b.output(top, "shared", Bits(32)), products[2])
  // Sharing across alternative paths must not create a reference to a local
  // declared only in the other branch. This producer remains unconditional.
  def sibling = select_value(select, b.add(top, products[7], b.constant(top, Bits(32), 1)), [[1, b.bit_not(top, products[7])]])
  b.drive(b.output(top, "sibling", Bits(32)), sibling)
  // Pure register inputs need no hold branch to skip work during reset.
  def captured = b.register(top, "capture_state", Bits(32), clock, reset, b.constant(top, Bits(32), 17))
  b.drive(captured.next, b.bit_not(top, selected))
  b.drive(b.output(top, "captured", Bits(32)), captured.current)
  // Adjacent consumers share work only within an identical explicit guard.
  // Registers must still initialize the inactive bank on every reset/retry.
  for (name in ["group_a", "group_b"], index in 0..2):
    def reg = b.register(top, name ++ "_state", Bits(32), clock, reset, b.constant(top, Bits(32), 17 + index * 2))
    b.drive(reg.next, if index == 0 | products[8] | b.add(top, products[8], b.constant(top, Bits(32), 1)))
    b.drive(b.output(top, name, Bits(32)), reg.current)
  def memory = b.sync_memory(top, "memory", 4, Bits(32), clock, #true, #true, #false)
  def read = memory.read_ports[0]
  b.drive(read.address, b.trunc(top, products[6], 2))
  b.drive(read.enable, read_enable)
  def write = memory.write_ports[0]
  b.drive(write.address, index)
  b.drive(write.enable, write_enable)
  b.drive(write.data, products[3])
  b.drive(b.output(top, "read_data", Bits(32)), read.data)
  // A full byte-indexed memory also checks compact frame addresses at the
  // carrier bound; these stimuli intentionally access the same four words.
  def peer_memory = b.sync_memory(top, "peer_memory", 256, Bits(32), clock, #true, #true, #false)
  b.drive(peer_memory.read_ports[0].address, b.zext(top, b.trunc(top, products[6], 2), 8))
  b.drive(peer_memory.read_ports[0].enable, read_enable)
  b.drive(peer_memory.write_ports[0].address, b.zext(top, index, 8))
  b.drive(peer_memory.write_ports[0].enable, write_enable)
  b.drive(peer_memory.write_ports[0].data, products[3])
  b.drive(b.output(top, "read_peer", Bits(32)), peer_memory.read_ports[0].data)
  def imp = b.dpi_import("rsim_conditional_call", ["arg", "again"], [Bits(32), Bits(32)], "result", Bits(32))
  // A shared mux result is declared once in the call guard, and its private
  // branch work remains lazy inside that declaration.
  def call_arg = select_value(select, products[4], [[1, raw_call]])
  def result = b.dpi_register(top, "held_call", imp, [call_arg, call_arg], clock, call_enable)
  b.drive(b.output(top, "call_result", Bits(32)), result)
  def peer_result = b.dpi_register(top, "held_peer", imp, [call_arg, b.add(top, call_arg, b.constant(top, Bits(32), 2))], clock, call_enable)
  b.drive(b.output(top, "call_peer", Bits(32)), peer_result)
  b.assert(top, b.eq(top, products[5], expected), clock, reset, check_enable, "conditional_check")
  b.assert(top, b.eq(top, products[5], expected), clock, reset, check_enable, "conditional_peer")
  b.finish(top)
  DesignElaboration(design, top)
