#lang rhombus
// Checks the real CIRCT target against internal emission, graph preparation, and atomic failure.
// SPDX-License-Identifier: Apache-2.0
import:
  "../circt-target.rhm".circt_target
  "../circt.rhm".emit_circt
  "../../compile/contracts.rhm" open
  "../../compile/program.rhm".compile_program
  "../../compile/rtl.rhm".prepare_rtl
  "../../core/main.rhm" open
  "../../lowering/program.rhm" open

fun make_body(builder :: Builder):
  def body = builder.module("Identity")
  def source = builder.input(body, "source", Bits(8))
  builder.drive(builder.output(body, "result", Bits(8)), source)
  builder.finish(body)
  body
def source_design = Design()
def source_program = ElaboratedProgram(source_design, make_body(Builder(source_design)))
def source_before = dump_ir(source_program.design)
def result = compile_program(source_program, circt_target)
def again = compile_program(source_program, circt_target)
check:
  result.target ~is "circt"
  result.report ~is #false
  result.diagnostics ~is []
  result.has_errors ~is #false
  result.manifest.top ~is "Identity"
  result.artifacts.map(fun (artifact): artifact.name) ~is ["Identity.mlir"]
  result.artifacts[0].content ~is again.artifacts[0].content
  result.manifest.signature.inputs.map(fun (port): port.name) ~is ["source"]
  dump_ir(source_program.design) ~is source_before
  source_program.design.sealed ~is #false

// The target delegates to the internal emitter on the prepared graph.
def plan = circt_target.prepare(source_program)
def prepared = prepare_rtl(source_program)
check:
  plan.emit()[0].content ~is emit_circt(prepared.rtl.design)

// Shared children preserve hierarchy and source attribution.
def mixed_design = Design()
def mixed_builder = Builder(mixed_design)
def shared_child = make_body(mixed_builder)
def mixed_top = mixed_builder.module("Mixed")
def mixed_source = mixed_builder.input(mixed_top, "source", Bits(8))
for (name in ["first", "second"]):
  def instance = mixed_builder.instance(mixed_top, shared_child, name, Location("compile-fixture", 7, 2))
  mixed_builder.drive(instance.input("source"), mixed_source)
  mixed_builder.drive(mixed_builder.output(mixed_top, name, Bits(8)), instance.output("result"))
mixed_builder.finish(mixed_top)
def unused = mixed_builder.module("Unused")
mixed_builder.finish(unused)
def mixed = ElaboratedProgram(mixed_design, mixed_top)
def mixed_before = dump_ir(mixed_design)
def compiled = compile_program(mixed, circt_target)
check:
  compiled.manifest.modules ~is ["Mixed", "Identity"]
  compiled.artifacts[0].content.contains("Unused") ~is #false
  dump_ir(mixed_design) ~is mixed_before
  mixed_design.sealed ~is #false

// Ordinary Builder programs compile without frontend dependencies.
def concrete_design = Design()
def concrete_top = make_body(Builder(concrete_design))
def concrete = ElaboratedProgram(concrete_design, concrete_top)
def concrete_before = dump_ir(concrete_design)
def concrete_result = compile_program(concrete, circt_target)
def concrete_again = compile_program(concrete, circt_target)
check:
  concrete_result.manifest.top ~is "Identity"
  concrete_result.artifacts[0].content ~is concrete_again.artifacts[0].content
  concrete_result.artifacts[0].content ~is result.artifacts[0].content
  dump_ir(concrete_design) ~is concrete_before
  concrete_design.sealed ~is #false

// Inject failures around the actual CIRCT plan to exercise the publication
// boundary without inventing another backend or a simulation implementation.
class BrokenEmission(plan :: TargetPlan, duplicate :: Boolean):
  implements TargetPlan
  override method manifest(): plan.manifest()
  override method emit():
    def artifacts = plan.emit()
    if duplicate
    | artifacts ++ artifacts
    | error("emission failed after producing text")
def mutable published = #false
def fail_emission = CompilationTarget("circt-failure-test", fun (program): BrokenEmission(circt_target.prepare(program), #false))
def duplicate_artifacts = CompilationTarget("circt-duplicate-test", fun (program): BrokenEmission(circt_target.prepare(program), #true))
fun publish_failed_emission(): published := compile_program(source_program, fail_emission)
check:
  publish_failed_emission() ~throws "emission failed after producing text"
  published ~is #false
  compile_program(source_program, duplicate_artifacts) ~throws "unique artifact names"
  source_program.design.sealed ~is #false

// Diagnostic projection failures cannot leak an otherwise valid prepared result.
class BrokenDiagnostics(plan :: TargetPlan):
  implements TargetPlan
  override method manifest(): plan.manifest()
  override method diagnostics(): error("diagnostics failed deliberately")
  override method emit(): plan.emit()
def fail_diagnostics = CompilationTarget("circt-diagnostics-test", fun (program): BrokenDiagnostics(circt_target.prepare(program)))
fun publish_failed_diagnostics(): published := compile_program(source_program, fail_diagnostics)
check:
  publish_failed_diagnostics() ~throws "diagnostics failed deliberately"
  published ~is #false
  Diagnostic("circt.test", "fatal", "invalid severity") ~throws "diagnostic severity"
  Diagnostic("", "error", "missing code") ~throws "must not be empty"
  Diagnostic("circt.test", "note", "") ~throws "must not be empty"

// Each plan projection is collected once; findings do not suppress real emission.
def projections = MutableList[]
class ObservedPlan(plan :: TargetPlan):
  implements TargetPlan
  override method manifest():
    projections.add("manifest")
    plan.manifest()
  override method report():
    projections.add("report")
    plan.report()
  override method diagnostics():
    projections.add("diagnostics")
    [Diagnostic("circt.test", "note", "observed compilation")]
  override method emit():
    projections.add("emit")
    plan.emit()
def observed = compile_program(concrete, CompilationTarget("circt-observed", fun (program): ObservedPlan(circt_target.prepare(program))))
check:
  projections.snapshot() ~is ["manifest", "report", "diagnostics", "emit"]
  observed.has_errors ~is #false
  observed.diagnostics[0].severity ~is "note"
  observed.artifacts[0].content ~is concrete_result.artifacts[0].content
