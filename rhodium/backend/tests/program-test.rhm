#lang rhombus
// Checks byte-identical CIRCT across program materialization and legacy authoring paths.
// SPDX-License-Identifier: Apache-2.0

import:
  "../circt.rhm".emit_circt
  "../../lowering/program.rhm".materialize_rtl
  "../../frontend/tests/program-fixture.rhdl" as fixture

for (program in fixture.programs, legacy in fixture.legacy_designs):
  check:
    emit_circt(materialize_rtl(program).design) ~is emit_circt(legacy)
