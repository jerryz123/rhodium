#lang rhombus
/* Emits the same Builder fixtures through CIRCT for behavioral comparison. */
// SPDX-License-Identifier: Apache-2.0
import:
  lib("racket/base.rkt") as rkt
  "fixtures.rhm" open
  "../../../compile/program.rhm".compile_program
  "../../circt-target.rhm".circt_target
// One selected program per MLIR artifact; request its width and fixture kind.
def width = rkt.#{string->number}(rkt.#{vector-ref}(rkt.#{current-command-line-arguments}(), 0))
def kind = rkt.#{vector-ref}(rkt.#{current-command-line-arguments}(), 1)
def program:
  match kind
  | "hierarchy": make_hierarchy_program(width)
  | "aggregate": make_aggregate_program(width)
  | "sequential": make_sequential_program(width)
  // The pinned CIRCT exporter uses an unqualified Packet typedef, which a
  // same-named port hides. Compare identical logic with a distinct port name;
  // the direct fixture still exercises the collision unchanged.
  | "types": make_type_program(0, "restored")
  | "dpi": make_dpi_program()
  | "cdc": make_cdc_program()
  | "assertion": make_assertion_program()
  | "sync_memory": make_sync_memory_program(width)
  | "memory": make_memory_program(width)
  | "partial": make_partial_program(width)
  | "write_set": make_write_set_program(width)
  | "dynamic": make_dynamic_program(width)
  | "arithmetic": make_arithmetic_program(width)
  | "scalar": make_program(width)
  | ~else: error("unknown fixture kind")
print(compile_program(program, circt_target).artifacts[0].content)
