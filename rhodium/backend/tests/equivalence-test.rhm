#lang rhombus
// Proves all frontend profiles and aggregate abstractions reach identical CIRCT MLIR.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  "../../../rhodium/backend/circt.rhm" open
  "../../../examples/lop/adder-core.rhm" as core_adder
  "../../../examples/lop/adder-kernel.rhm" as kernel_adder
  "../../../examples/lop/adder-composed.rhdl" as composed_adder
  "../../../examples/lop/adder-standard.rhdl" as standard_adder
  "../../../examples/lop/bundle-kernel.rhdl" as bundle_kernel
  "../../../examples/lop/bundle-standard.rhdl" as bundle_standard
  "../../../examples/lop/interface-records.rhdl" as interface_records
  "../../../examples/rtl/interface.rhdl" as interface_standard
  "../../../examples/lop/width-ops-kernel.rhm" as width_kernel
  "../../../examples/rtl/width-ops.rhdl" as width_standard
  "../../../examples/rtl/sync-counter.rhdl" as sync_implicit
  "../../../examples/lop/counter-composed.rhdl" as sync_composed
  "../../frontend/tests/sync-explicit.rhdl" as sync_explicit
  "../../../examples/rtl/enum-state.rhdl" as enum_standard
  "../../frontend/tests/enum-composed.rhdl" as enum_composed

def kernel_adder_design = compile_program(kernel_adder.program, rtl_target).report.design
def composed_adder_design = compile_program(composed_adder.program, rtl_target).report.design
def standard_adder_design = compile_program(standard_adder.program, rtl_target).report.design
def bundle_kernel_design = compile_program(bundle_kernel.program, rtl_target).report.design
def bundle_standard_design = compile_program(bundle_standard.program, rtl_target).report.design
def interface_records_design = compile_program(interface_records.program, rtl_target).report.design
def interface_standard_design = compile_program(interface_standard.program, rtl_target).report.design
def width_kernel_design = compile_program(width_kernel.program, rtl_target).report.design
def width_standard_design = compile_program(width_standard.program, rtl_target).report.design
def sync_implicit_design = compile_program(sync_implicit.program, rtl_target).report.design
def sync_composed_design = compile_program(sync_composed.program, rtl_target).report.design
def enum_standard_design = compile_program(enum_standard.program, rtl_target).report.design

check:
  emit_circt(core_adder.design) ~is emit_circt(kernel_adder_design)
  emit_circt(kernel_adder_design) ~is emit_circt(composed_adder_design)
  emit_circt(composed_adder_design) ~is emit_circt(standard_adder_design)
  emit_circt(bundle_standard_design) ~is emit_circt(bundle_kernel_design)
  emit_circt(interface_standard_design) ~is emit_circt(interface_records_design)
  emit_circt(width_standard_design) ~is emit_circt(width_kernel_design)
  emit_circt(sync_implicit_design) ~is emit_circt(sync_explicit.design)
  emit_circt(sync_composed_design) ~is emit_circt(sync_explicit.design)
  emit_circt(enum_standard_design) ~is emit_circt(enum_composed.design)
