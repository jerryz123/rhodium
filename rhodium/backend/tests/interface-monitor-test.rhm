#lang rhombus
// Checks that an explicit endpoint monitor reaches CIRCT assertion IR.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  "../../../rhodium/backend/circt.rhm" open
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../examples/rtl/interface-monitor.rhdl" as fixture

def design = compile_program(elaborate(fixture.MonitoredProducer()), rtl_target).report.design
def circt = emit_circt(design)

check:
  circt.contains("verif.clocked_assert") ~is #true
  circt.contains("label \"producer_ready_requires_valid\"") ~is #true
