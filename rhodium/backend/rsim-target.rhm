#lang rhombus
/* Owns rsim program preparation and prepared-RTL consumption for native and SV-bound models. */
// SPDX-License-Identifier: Apache-2.0
import:
  "../compile/contracts.rhm" open
  "../compile/rtl.rhm" open
  "rsim/plan.rhm" open
  "rsim/cse.rhm".share_scalar_expressions
  "rsim/array-updates.rhm".compact_array_updates
  "rsim/emit.rhm".emit_rsim
  "rsim/sv-binding.rhm" open

export RsimTarget rsim_target rsim_sv_target

/* Keep only the detached compilation boundary and executable schedule, so model
   emission does not depend on the graph used to produce them. Partitioning is
   fixed for this plan, independently of later compilations of the same program. */
class RsimPlan(compiled_manifest :: CompileManifest, schedule :: RsimSchedule, partitioning :: String):
  implements TargetPlan
  /* Preserve logical ports and emitted module inventory. */
  override method manifest(): compiled_manifest
  /* Return standalone C++ sources; compilation and file publication belong to the caller. */
  override method emit():
    def contents = emit_rsim(schedule, ~module_cuts: partitioning == "module")
    def artifacts = [Artifact(schedule.name ++ ".hpp", "text/x-c++hdr", contents[0]),
                     Artifact(schedule.name ++ ".cpp", "text/x-c++src", contents[1])]
    if contents.length() == 3
    | artifacts ++ [Artifact("rsim-bits.hpp", "text/x-c++hdr", contents[2])]
    | artifacts

/* Lower already-verified RTL without copying or repeating certification; retain the
   selected partition policy for emission through either preparation path. */
fun plan_rtl(prepared :: PreparedRTL, partitioning :: String) :: RsimPlan:
  RsimPlan(prepared.manifest, compact_array_updates(share_scalar_expressions(build_schedule(prepared.rtl))), partitioning)

/* Prepare a fresh verified RTL graph before building the executable schedule. */
fun prepare_rsim(program :: ElaboratedProgram, partitioning :: String) :: RsimPlan:
  plan_rtl(prepare_rtl(program), partitioning)

/* Add simulator-host bindings to the same model plan without preparing or
   scheduling the circuit a second time. The manifest remains the logical RTL boundary. */
class RsimSVPlan(model :: RsimPlan, clock :: String):
  implements TargetPlan
  /* Reuse the model's boundary manifest verbatim. */
  override method manifest(): model.manifest()
  /* Return the C++ model and support sources followed by the SV wrapper and DPI bridge. */
  override method emit():
    def binding = emit_sv_binding(model.schedule, clock)
    def name = model.schedule.name
    model.emit() ++ [Artifact(name ++ ".sv", "text/x-systemverilog", binding[0]),
                     Artifact(name ++ "_bridge.cpp", "text/x-c++src", binding[1])]

/* Validate the optional binding from the model's detached boundary and schedule. */
fun finish_plan(model :: RsimPlan, bind_sv :: Boolean) :: TargetPlan:
  if bind_sv
  | RsimSVPlan(model, validate_sv_binding(model.schedule, model.manifest().signature))
  | model

/* Own program preparation while also accepting concrete instrumentation results.
   Artifact binding and partitioning are independent target choices. Each target
   captures its policy before compilation; the shared RTL boundary stays unchanged. */
class RsimTarget(bind_sv :: Boolean, partitioning :: String):
  extends CompilationTarget
  implements PreparedRTLConsumer
  /* Validate the strategy before preparing any RTL. Cost preserves the default
     identity; module cuts use a distinct result identity, including in pipelines. */
  constructor (~bind_sv: bind_sv :: Boolean = #false, ~partitioning: partitioning :: String = "cost"):
    unless partitioning in ["cost", "module"]
    | error(~who: #'RsimTarget, "partitioning must be cost or module")
    def name = (if bind_sv | "rsim-sv" | "rsim") ++ (if partitioning == "module" | "-module" | "")
    super(name, fun (program): finish_plan(prepare_rsim(program, partitioning), bind_sv))(bind_sv, partitioning)
  /* Reuse an instrumented graph with this target's policy, without preparing again. */
  override method plan(prepared :: PreparedRTL) :: TargetPlan:
    finish_plan(plan_rtl(prepared, partitioning), bind_sv)

def rsim_target = RsimTarget()
def rsim_sv_target = RsimTarget(~bind_sv: #true)
