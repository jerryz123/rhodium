#lang rhombus
/* Implements internal concrete-IR emission for the CIRCT compile target and backend fixtures. */
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus.bits.(<<) as <<
  lib("racket/base.rkt") as rkt
  "../core/main.rhm" open

export:
  emit_circt
  emit_module_circt

/* Associates one canonical packed record shape with its first allocated CIRCT alias. */
class CirctRecordAlias(key :: String, type :: RecordType, name :: String)
/* Owns shape, alias, and rendered-type caches for one emission environment. */
class CirctTypes(shapes :: MutableMap, aliases :: MutableMap, rendered :: MutableMap)

Parameter.def current_circt_types = #false
Parameter.def current_circt_sync_register_ids = []

/* Creates independent caches so standalone and whole-design emissions cannot share aliases. */
fun fresh_circt_types():
  CirctTypes(MutableMap.by(===){}, MutableMap{}, MutableMap.by(===){})

/* Produces the canonical CIRCT representation used to identify equal packed
   record shapes before any source-level bundle names are attached. */
fun circt_shape_type(type :: HardwareType):
  def types :: CirctTypes = current_circt_types()
  unless types.shapes.has_key(type)
  | types.shapes[type] := render_circt_shape_type(type)
  types.shapes[type]

/* Recursively renders physical scalar/record/vector shapes, treating clocks and resets as i1. */
fun render_circt_shape_type(type :: HardwareType):
  cond
  | scalar_data_type(type):
      "i" ++ to_string(scalar_width(type))
  | record_type(type):
      "!hw.struct<" ++ String.join(
        type.fields.map(fun (field): field.name ++ ": " ++ circt_shape_type(field.type)),
        ", "
      ) ++ ">"
  | vector_type(type):
      "!hw.array<" ++ to_string(type.length) ++ "x" ++ circt_shape_type(type.element_type) ++ ">"
  | clock_type(type) || reset_type(type):
      "i1"
  | ~else:
      error(~who: #'emit_circt,
            "CIRCT lowering does not support hardware type " ++ type.describe())

/* Looks up a record's alias by canonical shape rather than preferred name or object identity. */
fun record_alias(type :: RecordType):
  def types :: CirctTypes = current_circt_types()
  def key = circt_shape_type(type)
  if types.aliases.has_key(key) | types.aliases[key] | #false

/* Renders a record body with child aliases from the current emission environment. */
fun circt_record_underlying_type(type :: RecordType):
  "!hw.struct<" ++ String.join(
    type.fields.map(fun (field): field.name ++ ": " ++ circt_type(field.type)),
    ", "
  ) ++ ">"

/* Memoizes the rendered type within the current alias environment. */
fun circt_type(type :: HardwareType):
  def types :: CirctTypes = current_circt_types()
  unless types.rendered.has_key(type)
  | types.rendered[type] := render_circt_type(type)
  types.rendered[type]

/* Renders supported CIRCT storage types, attaching shape-selected record aliases when present. */
fun render_circt_type(type :: HardwareType):
  cond
  | scalar_data_type(type):
      "i" ++ to_string(scalar_width(type))
  | record_type(type):
      def underlying = circt_record_underlying_type(type)
      def alias = record_alias(type)
      if alias
      | "!hw.typealias<@rhodium_types::@" ++ alias.name ++ ", " ++ underlying ++ ">"
      | underlying
  | vector_type(type):
      "!hw.array<" ++ to_string(type.length) ++ "x" ++ circt_type(type.element_type) ++ ">"
  | clock_type(type) || reset_type(type):
      "i1"
  | ~else:
      error(~who: #'emit_circt,
            "CIRCT lowering does not support hardware type " ++ type.describe())

/* Returns scalar width, or the one-bit control width, for scalar/control emission helpers. */
fun circt_width(type :: HardwareType):
  if scalar_data_type(type) | scalar_width(type) | 1

/* Collects nested record aliases before users in first-seen order across DPI and module types. */
fun collect_circt_record_aliases(design :: Design):
  def types :: CirctTypes = current_circt_types()
  def mutable aliases = []

  /* Finds the first unused suffix for a requested record alias in this emission. */
  fun unique_name(base_name :: String):
    /* Searches alias suffixes deterministically without changing previously assigned names. */
    fun loop(index :: Nat):
      def candidate = if index == 0 | base_name | base_name ++ "_" ++ to_string(index)
      if aliases.find(fun (alias): alias.name == candidate)
      | loop(index + 1)
      | candidate
    loop(0)

  /* Visits nested aggregate dependencies before interning a preferred record alias by physical shape. */
  fun collect(type :: HardwareType):
    cond
    | record_type(type):
        for (field in type.fields):
          collect(field.type)
        when type.preferred_name
        | def key = circt_shape_type(type)
          unless types.aliases.has_key(key)
          | def alias = CirctRecordAlias(key, type, unique_name(type.preferred_name))
            types.aliases[key] := alias
            aliases := aliases ++ [alias]
    | vector_type(type):
        collect(type.element_type)
    | ~else:
        #void

  for (dpi_import in design.dpi_imports):
    for (type in dpi_import.input_types):
      collect(type)
    for (result in dpi_import.results):
      collect(result.type)
  for (module_def in design.modules):
    for (value in module_def.values):
      collect(value.type)
    for (place in module_def.places):
      collect(place.type)
    for (memory in module_def.memories):
      collect(memory.element_type)
  aliases

/* Emits one ordered type scope, or no declaration for an empty alias inventory. */
fun emit_circt_record_aliases(aliases :: List.of(CirctRecordAlias)):
  if aliases.length() == 0
  | ""
  | String.append(
      "  hw.type_scope @rhodium_types {\n",
      String.join(
        aliases.map(
          fun (alias):
            "    hw.typedecl @" ++ alias.name ++ " : " ++ circt_record_underlying_type(alias.type)
        ),
        "\n"
      ),
      "\n  }")

/* CIRCT array indices use Rhodium's minimum nonzero width for a collection count. */
fun circt_array_index_width(length :: PosInt):
  count_index_width(length)

/* Identifies structural wires and casts whose rendered CIRCT representation is already identical. */
fun alias_operation(operation :: Operation):
  (operation.opcode == "rtl.cast" && circt_type(operation.operands[0].type) == circt_type(operation.results[0].type)) || operation.opcode == "rtl.wire"

/* Selects input and register results whose SSA spelling preserves their authored name. */
fun named_result_opcode(opcode :: String):
  match opcode
  | "rtl.input_port" || "rtl.register" || "rtl.register_reset":
      #true
  | ~else:
      #false

/* Resolves transparent wire/cast aliases before selecting an authored or generated SSA reference. */
fun value_ref(value :: Value):
  def defining_operation = value.module_def.find_operation(value.defining_op_id)
  def opcode = defining_operation && defining_operation.opcode
  if defining_operation && alias_operation(defining_operation)
  | if defining_operation.opcode == "rtl.wire"
    | value_ref(defining_operation.places[0].driver)
    | value_ref(defining_operation.operands[0])
  | if opcode && named_result_opcode(opcode)
    | "%" ++ value.name
    | "%__rhodium_value_" ++ to_string(value.id)

/* Backend-owned names are scoped to one emitted module. Use the operation's
   module-local order so elaborating a child module cannot perturb visible RTL. */
fun operation_local_index(operation :: Operation):
  def mutable found = #false
  for (candidate in operation.module_def.operations,
       index in 0..operation.module_def.operations.length()):
    when candidate === operation
    | found := index
  unless found
  | error(~who: #'emit_circt, "operation is not owned by its module")
  found

/* Tests one host integer bit when rendering packed decode cubes. */
fun decode_bit_set(value :: Nat, index :: Nat):
  (value bits.and (1 << index)) != 0

/* Renders a packed input cube as the native bit pattern accepted by CIRCT's
   sv.case operation. CaseZ treats z positions as relation-level don't-cares. */
fun decode_case_pattern(value :: Nat, care :: Nat, width :: PosInt):
  String.join(
    for List (index in (width - 1) >=..= 0):
      if !decode_bit_set(care, index)
      | "z"
      | block:
          if decode_bit_set(value, index) | "1" | "0",
    ""
  )

/* Emits a fixed-width scalar constant, using hexadecimal for very large host integers. */
fun emit_constant(operation :: Operation):
  def result = operation.results[0]
  def integer :: Nat = operation.attribute("value")
  def literal = if bits.length(integer) >= 256 | "0x" ++ rkt.#{number->string}(integer, 16) | to_string(integer)
  String.append("    ", value_ref(result), " = hw.constant ",
                literal, " : ",
                circt_type(result.type))

/* Represents an unconstrained result with sv.constantX without defining a public four-state value. */
fun emit_dont_care(operation :: Operation):
  def result = operation.results[0]
  String.append("    ", value_ref(result), " = sv.constantX : ",
                circt_type(result.type))

/* Lowers a non-overlapping packed decode relation to a fully assigned combinational casez;
   aggregate selectors/results are bitcast without changing cared or unconstrained bits. */
fun emit_decode(operation :: Operation):
  def selector = operation.operands[0]
  def result = operation.results[0]
  def cases = operation.attribute("cases")
  def input_width = selector.type.packed_width()
  def output_width = result.type.packed_width()
  def operation_prefix = "%__rhodium_decode_" ++ to_string(operation_local_index(operation))
  def selector_ref:
    if scalar_data_type(selector.type)
    | value_ref(selector)
    | operation_prefix ++ "_selector"
  def mutable lines:
    if scalar_data_type(selector.type)
    | []
    | [String.append("    ", selector_ref, " = hw.bitcast ", value_ref(selector),
                     " : (", circt_type(selector.type), ") -> i",
                     to_string(input_width))]
  def mutable zero_bit_ref = #false
  def mutable one_bit_ref = #false
  def mutable x_bit_ref = #false

  /* Lazily emits reusable zero, one, or unconstrained single-bit constants for decode outputs. */
  fun output_bit_ref(kind :: String):
    match kind
    | "zero":
        unless zero_bit_ref
        | zero_bit_ref := operation_prefix ++ "_bit_zero"
          lines := lines ++ [String.append("    ", zero_bit_ref,
                                           " = hw.constant 0 : i1")]
        zero_bit_ref
    | "one":
        unless one_bit_ref
        | one_bit_ref := operation_prefix ++ "_bit_one"
          lines := lines ++ [String.append("    ", one_bit_ref,
                                           " = hw.constant 1 : i1")]
        one_bit_ref
    | "x":
        unless x_bit_ref
        | x_bit_ref := operation_prefix ++ "_bit_x"
          lines := lines ++ [String.append("    ", x_bit_ref,
                                           " = sv.constantX : i1")]
        x_bit_ref

  /* Materializes a partial output cube without choosing values for uncared
     bits. Mixed patterns use concat so ExportVerilog exposes each X directly. */
  fun emit_output_pattern(value :: Nat, care :: Nat, suffix :: String):
    def pattern_ref = operation_prefix ++ "_" ++ suffix
    def full_care = (1 bits.(<<) output_width) - 1
    cond
    | care == full_care:
        lines := lines ++ [String.append("    ", pattern_ref, " = hw.constant ",
                                         to_string(value), " : i",
                                         to_string(output_width))]
    | care == 0:
        lines := lines ++ [String.append("    ", pattern_ref,
                                         " = sv.constantX : i",
                                         to_string(output_width))]
    | ~else:
        def bit_refs = for List (index in (output_width - 1) >=..= 0):
          if !decode_bit_set(care, index)
          | output_bit_ref("x")
          | block:
              if decode_bit_set(value, index)
              | output_bit_ref("one")
              | output_bit_ref("zero")
        lines := lines ++ [String.append("    ", pattern_ref, " = comb.concat ",
                                         String.join(bit_refs, ", "), " : ",
                                         String.join(bit_refs.map(fun (_): "i1"), ", "))]
    pattern_ref

  def case_outputs = for List (case in cases, index in 0..cases.length()):
    emit_output_pattern(case[2], case[3], "case_" ++ to_string(index))
  def default_output = emit_output_pattern(operation.attribute("default_value"),
                                           operation.attribute("default_care"),
                                           "default")
  def result_variable = operation_prefix ++ "_result"
  lines := lines ++ [String.append("    ", result_variable,
                                   " = sv.logic : !hw.inout<i",
                                   to_string(output_width), ">"),
                     "    sv.alwayscomb {",
                     String.append("      sv.case casez ", selector_ref, " : i",
                                   to_string(input_width))]
  for (case in cases, case_output in case_outputs):
    lines := lines ++ [String.append("      case b",
                                     decode_case_pattern(case[0], case[1], input_width),
                                     ": {"),
                       String.append("        sv.bpassign ", result_variable, ", ",
                                     case_output, " : i", to_string(output_width)),
                       "      }"]
  lines := lines ++ ["      default: {",
                     String.append("        sv.bpassign ", result_variable, ", ",
                                   default_output, " : i", to_string(output_width)),
                     "      }",
                     "    }"]
  def packed_result_ref:
    if scalar_data_type(result.type)
    | value_ref(result)
    | operation_prefix ++ "_packed_result"
  lines := lines ++ [String.append("    ", packed_result_ref, " = sv.read_inout ",
                                   result_variable, " : !hw.inout<i",
                                   to_string(output_width), ">")]
  unless scalar_data_type(result.type)
  | lines := lines ++ [String.append("    ", value_ref(result), " = hw.bitcast ",
                                     packed_result_ref, " : (i", to_string(output_width),
                                     ") -> ", circt_type(result.type))]
  String.join(lines, "\n")

/* Renders a two-operand Comb operation at the verified result width. */
fun emit_binary(operation :: Operation, circt_opcode :: String):
  def result = operation.results[0]
  String.append("    ", value_ref(result), " = ", circt_opcode, " ",
                value_ref(operation.operands[0]), ", ",
                value_ref(operation.operands[1]), " : ",
                circt_type(result.type))

/* Builds a sign extension from primitive Comb extraction and concatenation so
   the public signed semantic operation does not depend on a backend type flag. */
fun emit_sign_extension(source_ref :: String,
                        source_type :: ScalarDataType,
                        result_ref :: String,
                        result_type :: ScalarDataType,
                        prefix :: String):
  def source_width = scalar_width(source_type)
  def result_width = scalar_width(result_type)
  def extension_width = result_width - source_width
  def sign_ref = prefix ++ "_sign"
  def sign_operands:
    for List (_index in 0..extension_width):
      sign_ref
  def operand_refs = sign_operands ++ [source_ref]
  def operand_types:
    (for List (_index in 0..extension_width): "i1") ++ [circt_type(source_type)]
  String.append("    ", sign_ref, " = comb.extract ", source_ref,
                " from ", to_string(source_width - 1), " : (",
                circt_type(source_type), ") -> i1\n",
                "    ", result_ref, " = comb.concat ",
                String.join(operand_refs, ", "), " : ",
                String.join(operand_types, ", "))

/* CIRCT shifts require equal-width operands. Rhodium permits an independently
   sized amount, so normalize without changing fixed-width overshift behavior.
   A signed value is sign-extended when a wider amount forces widening. */
fun emit_shift(operation :: Operation,
               circt_opcode :: String,
               signed_value :: Boolean = #false):
  def value = operation.operands[0]
  def amount = operation.operands[1]
  def result = operation.results[0]
  def value_width = scalar_width(value.type)
  def amount_width = scalar_width(amount.type)
  if value_width == amount_width
  | emit_binary(operation, circt_opcode)
  | if amount_width < value_width
    | block:
        def zero_width = value_width - amount_width
        def zero_ref = "%__rhodium_shift_zero_" ++ to_string(operation.id)
        def normalized_amount_ref = "%__rhodium_shift_amount_" ++ to_string(operation.id)
        String.append("    ", zero_ref, " = hw.constant 0 : i", to_string(zero_width), "\n",
                      "    ", normalized_amount_ref, " = comb.concat ", zero_ref, ", ",
                      value_ref(amount), " : i", to_string(zero_width), ", ",
                      circt_type(amount.type), "\n",
                      "    ", value_ref(result), " = ", circt_opcode, " ",
                      value_ref(value), ", ", normalized_amount_ref, " : ",
                      circt_type(result.type))
    | block:
        def widened_value_ref = "%__rhodium_shift_value_" ++ to_string(operation.id)
        def wide_result_ref = "%__rhodium_shift_wide_" ++ to_string(operation.id)
        def widen_lines:
          if signed_value
          | emit_sign_extension(value_ref(value),
                                value.type,
                                widened_value_ref,
                                value.type.with_bit_width(amount_width),
                                "%__rhodium_shift_" ++ to_string(operation.id))
          | block:
              def zero_width = amount_width - value_width
              def zero_ref = "%__rhodium_shift_zero_" ++ to_string(operation.id)
              String.append("    ", zero_ref, " = hw.constant 0 : i", to_string(zero_width), "\n",
                            "    ", widened_value_ref, " = comb.concat ", zero_ref, ", ",
                            value_ref(value), " : i", to_string(zero_width), ", ",
                            circt_type(value.type))
        String.append(widen_lines, "\n",
                      "    ", wide_result_ref, " = ", circt_opcode, " ",
                      widened_value_ref, ", ", value_ref(amount), " : ",
                      circt_type(amount.type), "\n",
                      "    ", value_ref(result), " = comb.extract ", wide_result_ref,
                      " from 0 : (", circt_type(amount.type), ") -> ",
                      circt_type(result.type))

/* Implements fixed-width bitwise inversion as XOR with an all-ones constant. */
fun emit_not(operation :: Operation):
  def operand = operation.operands[0]
  def result = operation.results[0]
  def mask_ref = "%__rhodium_not_mask_" ++ to_string(operation.id)
  def mask = (1 << circt_width(result.type)) - 1
  String.append("    ", mask_ref, " = hw.constant ", to_string(mask),
                " : ", circt_type(result.type), "\n",
                "    ", value_ref(result), " = comb.xor ",
                value_ref(operand), ", ", mask_ref,
                " : ", circt_type(result.type))

/* Emits an equality comparison with the operand type and one-bit result. */
fun emit_eq(operation :: Operation):
  def result = operation.results[0]
  String.append("    ", value_ref(result), " = comb.icmp eq ",
                value_ref(operation.operands[0]), ", ",
                value_ref(operation.operands[1]), " : ",
                circt_type(operation.operands[0].type))

/* Emits an unsigned comparison, independent of source-level scalar naming. */
fun emit_ult(operation :: Operation):
  def result = operation.results[0]
  String.append("    ", value_ref(result), " = comb.icmp ult ",
                value_ref(operation.operands[0]), ", ",
                value_ref(operation.operands[1]), " : ",
                circt_type(operation.operands[0].type))

/* Emits an explicitly signed comparison on the packed operand bits. */
fun emit_slt(operation :: Operation):
  def result = operation.results[0]
  String.append("    ", value_ref(result), " = comb.icmp slt ",
                value_ref(operation.operands[0]), ", ",
                value_ref(operation.operands[1]), " : ",
                circt_type(operation.operands[0].type))

/* Builds default-backed equality/mux selection, specializing the one-bit key-one case. */
fun emit_mux_lookup(operation :: Operation):
  def selector = operation.operands[0]
  def default_value = operation.operands[1]
  def case_values = operation.operands.drop(2)
  def keys = operation.attribute("keys")
  def result = operation.results[0]
  if selector_width(selector.type) == 1 && keys == [1]
  | String.append("    ", value_ref(result), " = comb.mux ",
                  value_ref(selector), ", ", value_ref(case_values[0]), ", ",
                  value_ref(default_value), " : ", circt_type(result.type))
  | block:
      def mutable selected_ref = value_ref(default_value)
      def mutable remaining = keys.length()
      def mutable lines = []
      for (key in keys.reverse(), case_value in case_values.reverse()):
        remaining := remaining - 1
        def suffix = to_string(remaining)
        def key_ref = "%__rhodium_mux_key_" ++ to_string(operation.id) ++ "_" ++ suffix
        def compare_ref = "%__rhodium_mux_cmp_" ++ to_string(operation.id) ++ "_" ++ suffix
        def step_ref:
          if remaining == 0
          | value_ref(result)
          | "%__rhodium_mux_step_" ++ to_string(operation.id) ++ "_" ++ suffix
        lines := lines ++ [String.append("    ", key_ref, " = hw.constant ",
                                         to_string(key), " : ",
                                         circt_type(selector.type)),
                           String.append("    ", compare_ref, " = comb.icmp eq ",
                                         value_ref(selector), ", ", key_ref, " : ",
                                         circt_type(selector.type)),
                           String.append("    ", step_ref, " = comb.mux ",
                                         compare_ref, ", ", value_ref(case_value),
                                         ", ", selected_ref, " : ",
                                         circt_type(result.type))]
        selected_ref := step_ref
      String.join(lines, "\n")

/* A one-hot mux has a deliberately partial contract: exactly one selector bit
   is set. Gating each packed choice and OR-reducing the leaves implements that
   contract without adding comparators or defining invalid selector encodings. */
fun emit_onehot_mux(operation :: Operation):
  def selector = operation.operands[0]
  def choices = operation.operands.drop(1)
  def result = operation.results[0]
  def width = result.type.packed_width()
  def prefix = "%__rhodium_onehot_" ++ to_string(operation.id)
  def packed_result_ref:
    if scalar_data_type(result.type)
    | value_ref(result)
    | prefix ++ "_result"
  def mutable lines = []
  def mutable leaves = []
  for (choice in choices, index in 0..choices.length()):
    def suffix = to_string(index)
    def selector_bit_ref:
      if choices.length() == 1
      | value_ref(selector)
      | prefix ++ "_select_" ++ suffix
    when choices.length() != 1
    | lines := lines ++ [String.append(
        "    ", selector_bit_ref, " = comb.extract ", value_ref(selector),
        " from ", suffix, " : (", circt_type(selector.type), ") -> i1"
      )]
    def packed_choice_ref:
      if scalar_data_type(choice.type)
      | value_ref(choice)
      | prefix ++ "_choice_" ++ suffix
    unless scalar_data_type(choice.type)
    | lines := lines ++ [String.append(
        "    ", packed_choice_ref, " = hw.bitcast ", value_ref(choice),
        " : (", circt_type(choice.type), ") -> i", to_string(width)
      )]
    def mask_ref:
      if width == 1
      | selector_bit_ref
      | prefix ++ "_mask_" ++ suffix
    when width != 1
    | lines := lines ++ [String.append(
        "    ", mask_ref, " = comb.concat ",
        String.join(for List (_index in 0..width): selector_bit_ref, ", "),
        " : ", String.join(for List (_index in 0..width): "i1", ", ")
      )]
    def leaf_ref:
      if choices.length() == 1
      | packed_result_ref
      | prefix ++ "_gated_" ++ suffix
    lines := lines ++ [String.append(
      "    ", leaf_ref, " = comb.and ", packed_choice_ref, ", ", mask_ref,
      " : i", to_string(width)
    )]
    leaves := leaves ++ [leaf_ref]
  def mutable level = 0
  def mutable current = leaves
  while current.length() > 1:
    def mutable next = []
    def mutable remaining = current
    def mutable pair_index = 0
    while remaining.length() > 1:
      def combined_ref:
        if current.length() == 2
        | packed_result_ref
        | String.append(prefix, "_or_", to_string(level), "_", to_string(pair_index))
      lines := lines ++ [String.append(
        "    ", combined_ref, " = comb.or ", remaining[0], ", ", remaining[1],
        " : i", to_string(width)
      )]
      next := next ++ [combined_ref]
      remaining := remaining.drop(2)
      pair_index := pair_index + 1
    when remaining.length() == 1
    | next := next ++ [remaining[0]]
    current := next
    level := level + 1
  unless scalar_data_type(result.type)
  | lines := lines ++ [String.append(
      "    ", value_ref(result), " = hw.bitcast ", packed_result_ref,
      " : (i", to_string(width), ") -> ", circt_type(result.type)
    )]
  String.join(lines, "\n")

/* Concatenates operand bits in core order with explicit per-operand CIRCT types. */
fun emit_concat(operation :: Operation):
  def result = operation.results[0]
  def operands = String.join(operation.operands.map(value_ref), ", ")
  def operand_types = String.join(
    operation.operands.map(fun (operand): circt_type(operand.type)),
    ", "
  )
  String.append("    ", value_ref(result), " = comb.concat ", operands,
                " : ", operand_types)

/* Extracts the verified range using its low offset and result width. */
fun emit_extract(operation :: Operation):
  def operand = operation.operands[0]
  def result = operation.results[0]
  String.append("    ", value_ref(result), " = comb.extract ",
                value_ref(operand), " from ",
                to_string(operation.attribute("low")), " : (",
                circt_type(operand.type), ") -> ", circt_type(result.type))

/* Prepends explicit zero bits to the scalar operand. */
fun emit_zext(operation :: Operation):
  def operand = operation.operands[0]
  def result = operation.results[0]
  def zero_width = result.type.width - operand.type.width
  def zero_ref = "%__rhodium_zext_zero_" ++ to_string(operation.id)
  String.append("    ", zero_ref, " = hw.constant 0 : i", to_string(zero_width), "\n",
                "    ", value_ref(result), " = comb.concat ", zero_ref, ", ",
                value_ref(operand), " : i", to_string(zero_width), ", ",
                circt_type(operand.type))

/* Delegates scalar widening to explicit sign-bit replication. */
fun emit_sext(operation :: Operation):
  def operand = operation.operands[0]
  def result = operation.results[0]
  emit_sign_extension(value_ref(operand),
                      operand.type,
                      value_ref(result),
                      result.type,
                      "%__rhodium_sext_" ++ to_string(operation.id))

/* Extracts the low result-width bits without changing their interpretation. */
fun emit_trunc(operation :: Operation):
  def operand = operation.operands[0]
  def result = operation.results[0]
  String.append("    ", value_ref(result), " = comb.extract ",
                value_ref(operand), " from 0 : (", circt_type(operand.type),
                ") -> ", circt_type(result.type))

/* Bitcasts equal packed widths between supported hardware representations. */
fun emit_cast(operation :: Operation):
  def source = operation.operands[0]
  def result = operation.results[0]
  String.append("    ", value_ref(result), " = hw.bitcast ",
                value_ref(source), " : (", circt_type(source.type),
                ") -> ", circt_type(result.type))

/* Creates a packed struct in verified field order. */
fun emit_record_create(operation :: Operation):
  def result = operation.results[0]
  String.append("    ", value_ref(result), " = hw.struct_create (",
                String.join(operation.operands.map(value_ref), ", "),
                ") : ", circt_type(result.type))

/* Extracts the named verified struct field using the source record type. */
fun emit_record_get(operation :: Operation):
  def record = operation.operands[0]
  def result = operation.results[0]
  String.append("    ", value_ref(result), " = hw.struct_extract ",
                value_ref(record), "[\"", operation.attribute("field"),
                "\"] : ", circt_type(record.type))

/* Reverses logical element order for CIRCT's most-significant-first array construction. */
fun emit_vector_create(operation :: Operation):
  def result = operation.results[0]
  // CIRCT array_create lists elements from most- to least-significant, while
  // Rhodium's logical vector element zero occupies the least-significant slot.
  String.append("    ", value_ref(result), " = hw.array_create ",
                String.join(operation.operands.reverse().map(value_ref), ", "),
                " : ", circt_type(result.type.element_type))

/* Materializes a fixed array index with the core collection-index width. */
fun emit_vector_get(operation :: Operation):
  def vector = operation.operands[0]
  def result = operation.results[0]
  def index_width = circt_array_index_width(vector.type.length)
  def index_ref = "%__rhodium_vector_index_" ++ to_string(operation.id)
  String.append("    ", index_ref, " = hw.constant ",
                to_string(operation.attribute("index")), " : i",
                to_string(index_width), "\n",
                "    ", value_ref(result), " = hw.array_get ",
                value_ref(vector), "[", index_ref, "] : ",
                circt_type(vector.type), ", i", to_string(index_width))

/* Emits dynamic array selection, preserving a named wire for selectors narrower than eight bits. */
fun emit_vector_index(operation :: Operation):
  def vector = operation.operands[0]
  def index = operation.operands[1]
  def result = operation.results[0]
  if index.type.width >= 8
  | String.append("    ", value_ref(result), " = hw.array_get ",
                  value_ref(vector), "[", value_ref(index), "] : ",
                  circt_type(vector.type), ", ", circt_type(index.type))
  | block:
      def index_ref = "%__rhodium_vector_index_" ++ to_string(operation.id)
      def index_symbol = "@__rhodium_vector_index_" ++ to_string(operation.id)
      String.append("    ", index_ref, " = hw.wire ", value_ref(index),
                    " sym ", index_symbol, " : ", circt_type(index.type), "\n",
                    "    ", value_ref(result), " = hw.array_get ",
                    value_ref(vector), "[", index_ref, "] : ",
                    circt_type(vector.type), ", ", circt_type(index.type))

/* Produces a new array value with one selected element replaced, not a mutation of its source. */
fun emit_vector_inject(operation :: Operation):
  def vector = operation.operands[0]
  def index = operation.operands[1]
  def element = operation.operands[2]
  def result = operation.results[0]
  String.append("    ", value_ref(result), " = hw.array_inject ",
                value_ref(vector), "[", value_ref(index), "], ",
                value_ref(element), " : ", circt_type(vector.type), ", ",
                circt_type(index.type))

/* Lowers an unordered vector write set as symmetric per-element decode and
   merge logic. Colliding enabled ports OR their data, which is one legal
   implementation of the operation's deliberately undefined collision case. */
fun emit_vector_write_set(operation :: Operation):
  def vector = operation.operands[0]
  def enables = operation.operands[1]
  def indices = operation.operands[2]
  def elements = operation.operands[3]
  def result = operation.results[0]
  def port_count = enables.type.length
  def element_width = vector.type.element_type.packed_width()
  def port_index_width = circt_array_index_width(port_count)
  def vector_index_width = circt_array_index_width(vector.type.length)
  def prefix = "%__rhodium_vector_write_" ++ to_string(operation.id)
  def mutable lines = []
  def mutable enable_refs = []
  def mutable index_refs = []
  def mutable data_refs = []

  for (port_index in 0..port_count):
    def suffix = to_string(port_index)
    def port_index_ref = prefix ++ "_port_index_" ++ suffix
    def enable_ref = prefix ++ "_enable_" ++ suffix
    def index_ref = prefix ++ "_index_" ++ suffix
    def data_ref = prefix ++ "_data_" ++ suffix
    lines := lines ++ [String.append(
      "    ", port_index_ref, " = hw.constant ", suffix, " : i",
      to_string(port_index_width)
    ), String.append(
      "    ", enable_ref, " = hw.array_get ", value_ref(enables), "[",
      port_index_ref, "] : ", circt_type(enables.type), ", i",
      to_string(port_index_width)
    ), String.append(
      "    ", index_ref, " = hw.array_get ", value_ref(indices), "[",
      port_index_ref, "] : ", circt_type(indices.type), ", i",
      to_string(port_index_width)
    ), String.append(
      "    ", data_ref, " = hw.array_get ", value_ref(elements), "[",
      port_index_ref, "] : ", circt_type(elements.type), ", i",
      to_string(port_index_width)
    )]
    enable_refs := enable_refs ++ [enable_ref]
    index_refs := index_refs ++ [index_ref]
    data_refs := data_refs ++ [data_ref]

  /* Builds a balanced nonempty OR tree, carrying an unpaired leaf unchanged to the next level. */
  fun reduce_or(refs :: List.of(String), width :: PosInt, stem :: String):
    def mutable current = refs
    def mutable level = 0
    while current.length() > 1:
      def mutable next = []
      def mutable remaining = current
      def mutable pair_index = 0
      while remaining.length() > 1:
        def combined_ref = String.append(stem, "_", to_string(level), "_",
                                         to_string(pair_index))
        lines := lines ++ [String.append(
          "    ", combined_ref, " = comb.or ", remaining[0], ", ",
          remaining[1], " : i", to_string(width)
        )]
        next := next ++ [combined_ref]
        remaining := remaining.drop(2)
        pair_index := pair_index + 1
      when remaining.length() == 1
      | next := next ++ [remaining[0]]
      current := next
      level := level + 1
    current[0]

  def mutable result_element_refs = []
  for (element_index in 0..vector.type.length):
    def suffix = to_string(element_index)
    def destination_ref = prefix ++ "_destination_" ++ suffix
    def old_ref = prefix ++ "_old_" ++ suffix
    lines := lines ++ [String.append(
      "    ", destination_ref, " = hw.constant ", suffix, " : i",
      to_string(vector_index_width)
    ), String.append(
      "    ", old_ref, " = hw.array_get ", value_ref(vector), "[",
      destination_ref, "] : ", circt_type(vector.type), ", i",
      to_string(vector_index_width)
    )]
    def mutable hit_refs = []
    def mutable gated_data_refs = []
    for (port_index in 0..port_count):
      def port_suffix = to_string(port_index)
      def compare_ref = prefix ++ "_compare_" ++ suffix ++ "_" ++ port_suffix
      def hit_ref = prefix ++ "_hit_" ++ suffix ++ "_" ++ port_suffix
      def packed_data_ref:
        if scalar_data_type(vector.type.element_type)
        | data_refs[port_index]
        | prefix ++ "_packed_data_" ++ suffix ++ "_" ++ port_suffix
      lines := lines ++ [String.append(
        "    ", compare_ref, " = comb.icmp eq ", index_refs[port_index], ", ",
        destination_ref, " : ", circt_type(indices.type.element_type)
      ), String.append(
        "    ", hit_ref, " = comb.and ", enable_refs[port_index], ", ",
        compare_ref, " : i1"
      )]
      unless scalar_data_type(vector.type.element_type)
      | lines := lines ++ [String.append(
          "    ", packed_data_ref, " = hw.bitcast ", data_refs[port_index],
          " : (", circt_type(vector.type.element_type), ") -> i",
          to_string(element_width)
        )]
      hit_refs := hit_refs ++ [hit_ref]
      if port_count == 1
      | gated_data_refs := gated_data_refs ++ [packed_data_ref]
      | block:
          def mask_ref:
            if element_width == 1
            | hit_ref
            | prefix ++ "_mask_" ++ suffix ++ "_" ++ port_suffix
          when element_width != 1
          | lines := lines ++ [String.append(
              "    ", mask_ref, " = comb.concat ",
              String.join(for List (_index in 0..element_width): hit_ref, ", "),
              " : ",
              String.join(for List (_index in 0..element_width): "i1", ", ")
            )]
          def gated_data_ref = prefix ++ "_gated_data_" ++ suffix ++ "_" ++ port_suffix
          lines := lines ++ [String.append(
            "    ", gated_data_ref, " = comb.and ", packed_data_ref, ", ",
            mask_ref, " : i", to_string(element_width)
          )]
          gated_data_refs := gated_data_refs ++ [gated_data_ref]
    def any_hit_ref = reduce_or(hit_refs,
                                1,
                                prefix ++ "_any_hit_" ++ suffix)
    def merged_data_ref = reduce_or(gated_data_refs,
                                    element_width,
                                    prefix ++ "_merged_data_" ++ suffix)
    def packed_old_ref:
      if scalar_data_type(vector.type.element_type)
      | old_ref
      | prefix ++ "_packed_old_" ++ suffix
    unless scalar_data_type(vector.type.element_type)
    | lines := lines ++ [String.append(
        "    ", packed_old_ref, " = hw.bitcast ", old_ref, " : (",
        circt_type(vector.type.element_type), ") -> i", to_string(element_width)
      )]
    def element_ref:
      if scalar_data_type(vector.type.element_type)
      | prefix ++ "_result_element_" ++ suffix
      | prefix ++ "_packed_result_element_" ++ suffix
    lines := lines ++ [String.append(
      "    ", element_ref, " = comb.mux ", any_hit_ref, ", ",
      merged_data_ref, ", ", packed_old_ref, " : i", to_string(element_width)
    )]
    def result_element_ref:
      if scalar_data_type(vector.type.element_type)
      | element_ref
      | prefix ++ "_result_element_" ++ suffix
    unless scalar_data_type(vector.type.element_type)
    | lines := lines ++ [String.append(
        "    ", result_element_ref, " = hw.bitcast ", element_ref, " : (i",
        to_string(element_width), ") -> ", circt_type(vector.type.element_type)
      )]
    result_element_refs := result_element_refs ++ [result_element_ref]

  lines := lines ++ [String.append(
    "    ", value_ref(result), " = hw.array_create ",
    String.join(result_element_refs.reverse(), ", "), " : ",
    circt_type(vector.type.element_type)
  )]
  String.join(lines, "\n")

/* Renders asynchronous-read memory storage with its depth and logical element type. */
fun circt_memory_type(memory :: Memory):
  String.append("!seq.hlmem<", to_string(memory.depth), "x",
                circt_type(memory.element_type), ">")

/* Assigns an SSA reference to one module-local memory resource identity. */
fun memory_ref(memory :: Memory):
  "%__rhodium_memory_" ++ to_string(memory.id)

/* CIRCT represents the sole address of a depth-one memory with i0, while Rhodium
   deliberately keeps collection indices authorable as at least Bits(1). */
fun memory_index_ref(operation :: Operation, memory :: Memory, address :: Value):
  if memory.depth == 1
  | "%__rhodium_memory_index_" ++ to_string(operation.id)
  | value_ref(address)

/* Emits the sole i0 address for depth-one storage and no adapter for larger memories. */
fun emit_memory_index(operation :: Operation, memory :: Memory, address :: Value):
  if memory.depth == 1
  | String.append("    ", memory_index_ref(operation, memory, address),
                  " = hw.constant 0 : i0\n")
  | ""

/* Declares uninitialized high-level memory using its shared write clock or an inert clock if unwritten. */
fun emit_memory(operation :: Operation):
  def memory = operation.attribute("memory")
  def writes = operation.module_def.operations.filter(
    ~keep: fun (candidate): candidate.opcode == "rtl.memory_write" && candidate.attribute("memory", #false) === memory
  )
  def write = if writes.length() == 0 | #false | writes[0]
  def clock_ref = "%__rhodium_memory_clock_" ++ to_string(memory.id)
  def reset_ref = "%__rhodium_memory_reset_" ++ to_string(memory.id)
  def clock_text:
    if write
    | String.append("    ", clock_ref, " = seq.to_clock ",
                    value_ref(write.operands[2]))
    | String.append("    ", clock_ref, " = seq.const_clock low")
  String.append(clock_text, "\n",
                "    ", reset_ref, " = hw.constant 0 : i1\n",
                "    ", memory_ref(memory), " = seq.hlmem @", memory.name,
                " ", clock_ref, ", ", reset_ref, " : ",
                circt_memory_type(memory))

/* Emits a zero-latency read with the depth-one address-width adaptation when needed. */
fun emit_memory_read_async(operation :: Operation):
  def memory = operation.attribute("memory")
  def address = operation.operands[0]
  String.append(emit_memory_index(operation, memory, address),
                "    ", value_ref(operation.results[0]), " = seq.read ",
                memory_ref(memory), "[", memory_index_ref(operation, memory, address),
                "] {latency = 0 : i64} : ", circt_memory_type(memory))

/* Emits an enabled one-cycle write to the declared memory without adding reset or collision priority. */
fun emit_memory_write(operation :: Operation):
  def memory = operation.attribute("memory")
  def address = operation.operands[0]
  String.append(emit_memory_index(operation, memory, address),
                "    seq.write ", memory_ref(memory), "[",
                memory_index_ref(operation, memory, address), "] ",
                value_ref(operation.operands[1]), " wren ",
                value_ref(operation.operands[3]),
                " {latency = 1 : i64} : ", circt_memory_type(memory))

/* Computes the flat packed storage and optional granule-mask widths for a synchronous memory. */
fun sync_memory_type(operation :: Operation):
  def width = operation.attribute("element_type").packed_width()
  unless width is_a PosInt
  | error(~who: #'emit_circt,
          "synchronous memory element type must have a packed width")
  def mask_granularity = operation.attribute("mask_granularity", #false)
  def mask_width:
    if !mask_granularity
    | #false
    | width / mask_granularity
  String.append("!seq.firmem<", to_string(operation.attribute("depth")),
                " x ", to_string(width),
                if mask_width | ", mask " ++ to_string(mask_width) | "",
                ">")

/* Emits fixed-latency firmem ports, packing aggregate data and preserving undefined read results. */
fun emit_sync_memory(operation :: Operation):
  def clock_ref = "%__rhodium_sync_memory_clock_" ++ to_string(operation.id)
  def memory_ref = "%" ++ operation.attribute("name")
  def memory_type = sync_memory_type(operation)
  def element_type = operation.attribute("element_type")
  def packed_type = "i" ++ to_string(element_type.packed_width())
  def flat_element = scalar_data_type(element_type)
  def mask_granularity = operation.attribute("mask_granularity", #false)
  def mask_width:
    if !mask_granularity
    | #false
    | element_type.packed_width() / mask_granularity
  def mutable place_index = 0
  def mutable result_index = 0
  def mutable port_operations = []
  /* CIRCT 1.155 drops a single whole-word mask when creating memory helpers.
     Fold that mask into the write enable explicitly. On shared ports, leave
     reads enabled independently of the mask and keep write mode unchanged. */
  fun port_enable(enable :: Place, mask :: maybe(Place), write :: maybe(Place)) :: String:
    def original = value_ref(enable.driver)
    if mask && mask_width == 1
    | block:
        def masked = "%__rhodium_sync_memory_masked_enable_" ++ to_string(operation.id)
        port_operations := port_operations ++ ["    " ++ masked ++ " = comb.and " ++ original ++ ", " ++ value_ref(mask.driver) ++ " : i1"]
        if write
        | block:
            def selected = "%__rhodium_sync_memory_enable_" ++ to_string(operation.id)
            port_operations := port_operations ++ ["    " ++ selected ++ " = comb.mux " ++ value_ref(write.driver) ++ ", " ++ masked ++ ", " ++ original ++ " : i1"]
            selected
        | masked
    | original
  when operation.attribute("has_read")
  | def address = operation.places[place_index]
    def enable = operation.places[place_index + 1]
    def result = operation.results[result_index]
    def port_result_ref:
      if flat_element
      | value_ref(result)
      | "%__rhodium_sync_memory_read_data_" ++ to_string(operation.id)
    port_operations := port_operations ++ [
      String.append("    ", port_result_ref,
                    " = seq.firmem.read_port ", memory_ref, "[",
                    value_ref(address.driver), "], clock ", clock_ref,
                    " enable ", value_ref(enable.driver), " : ", memory_type)
    ]
    unless flat_element
    | port_operations := port_operations ++ [
        String.append("    ", value_ref(result), " = hw.bitcast ",
                      port_result_ref, " : (", packed_type, ") -> ",
                      circt_type(element_type))
      ]
    place_index := place_index + 2
    result_index := result_index + 1
  when operation.attribute("has_write")
  | def address = operation.places[place_index]
    def data = operation.places[place_index + 1]
    def enable = operation.places[place_index + 2]
    def mask:
      if mask_width | operation.places[place_index + 3] | #false
    def enable_ref = port_enable(enable, mask, #false)
    def port_data_ref:
      if flat_element
      | value_ref(data.driver)
      | "%__rhodium_sync_memory_write_data_" ++ to_string(operation.id)
    unless flat_element
    | port_operations := port_operations ++ [
        String.append("    ", port_data_ref, " = hw.bitcast ",
                      value_ref(data.driver), " : (", circt_type(element_type),
                      ") -> ", packed_type)
      ]
    port_operations := port_operations ++ [
      String.append("    seq.firmem.write_port ", memory_ref, "[",
                    value_ref(address.driver), "] = ", port_data_ref,
                    ", clock ", clock_ref, " enable ",
                    enable_ref,
                    if mask | " mask " ++ value_ref(mask.driver) | "",
                    " : ", memory_type,
                    if mask_width | ", i" ++ to_string(mask_width) | "")
    ]
    place_index := place_index + 3 + (if mask_width | 1 | 0)
  when operation.attribute("has_read_write")
  | def address = operation.places[place_index]
    def enable = operation.places[place_index + 1]
    def write = operation.places[place_index + 2]
    def write_data = operation.places[place_index + 3]
    def write_mask:
      if mask_width | operation.places[place_index + 4] | #false
    def read_data = operation.results[result_index]
    def enable_ref = port_enable(enable, write_mask, write)
    def port_write_data_ref:
      if flat_element
      | value_ref(write_data.driver)
      | "%__rhodium_sync_memory_read_write_input_" ++ to_string(operation.id)
    def port_read_data_ref:
      if flat_element
      | value_ref(read_data)
      | "%__rhodium_sync_memory_read_write_output_" ++ to_string(operation.id)
    unless flat_element
    | port_operations := port_operations ++ [
        String.append("    ", port_write_data_ref, " = hw.bitcast ",
                      value_ref(write_data.driver), " : (",
                      circt_type(element_type), ") -> ", packed_type)
      ]
    port_operations := port_operations ++ [
      String.append("    ", port_read_data_ref,
                    " = seq.firmem.read_write_port ", memory_ref, "[",
                    value_ref(address.driver), "] = ", port_write_data_ref,
                    " if ", value_ref(write.driver), ", clock ", clock_ref,
                    " enable ", enable_ref,
                    if write_mask
                    | " mask " ++ value_ref(write_mask.driver)
                    | "",
                    " : ", memory_type,
                    if mask_width | ", i" ++ to_string(mask_width) | "")
    ]
    unless flat_element
    | port_operations := port_operations ++ [
        String.append("    ", value_ref(read_data), " = hw.bitcast ",
                      port_read_data_ref, " : (", packed_type, ") -> ",
                      circt_type(element_type))
      ]
  String.append("    ", clock_ref, " = seq.to_clock ",
                value_ref(operation.operands[0]), "\n",
                "    ", memory_ref,
                " = seq.firmem 1, 1, undefined, undefined : ", memory_type,
                if port_operations.length() == 0
                | ""
                | "\n" ++ String.join(port_operations, "\n"))

/* Declares the verified foreign input and result ABI without changing external function identity. */
fun emit_dpi_import(dpi_import :: DpiImport):
  def inputs:
    for List (name in dpi_import.input_names, type in dpi_import.input_types):
      "in %" ++ name ++ " : " ++ circt_type(type)
  def arguments:
    inputs ++ dpi_import.results.map(
      fun (result): result.direction ++ " " ++ result.name ++ " : " ++ circt_type(result.type)
    )
  String.append("  sim.func.dpi @", dpi_import.name, "(",
                String.join(arguments, ", "),
                ")")

/* Emits a rising-edge assertion gated by the sampled guard and inverse synchronous reset. */
fun emit_assert(operation :: Operation):
  def condition = operation.operands[0]
  def clock = operation.operands[1]
  def reset = operation.operands[2]
  def guard = operation.operands[3]
  def prefix = "%__rhodium_assert_" ++ to_string(operation.id)
  def true_ref = prefix ++ "_true"
  def not_reset_ref = prefix ++ "_not_reset"
  def effective_guard_ref = prefix ++ "_guard"
  def label = operation.attribute("label", #false)
  String.append("    ", true_ref, " = hw.constant 1 : i1\n",
                "    ", not_reset_ref, " = comb.xor ", value_ref(reset), ", ",
                true_ref, " : i1\n",
                "    ", effective_guard_ref, " = comb.and ", value_ref(guard),
                ", ", not_reset_ref, " : i1\n",
                "    verif.clocked_assert ", value_ref(condition), " if ",
                effective_guard_ref, ", posedge ", value_ref(clock),
                if label | " label \"" ++ label ++ "\"" | "",
                " : i1")

/* Emits an enabled clocked foreign call with zero, one, or multiple typed results. */
fun emit_dpi_operation(operation :: Operation):
  def dpi_import = operation.attribute("dpi_import")
  def clock_ref = "%__rhodium_dpi_clock_" ++ to_string(operation.id)
  def inputs = operation.operands.drop(2)
  def input_refs = String.join(inputs.map(value_ref), ", ")
  def input_types = String.join(inputs.map(fun (input): circt_type(input.type)), ", ")
  def result_prefix:
    if operation.results == []
    | ""
    | String.join(operation.results.map(value_ref), ", ") ++ " = "
  def result_type:
    if operation.results == []
    | "()"
    | if operation.results.length() == 1
      | circt_type(operation.results[0].type)
      | "(" ++ String.join(operation.results.map(fun (result): circt_type(result.type)), ", ") ++ ")"
  String.append("    ", clock_ref, " = seq.to_clock ",
                value_ref(operation.operands[0]), "\n",
                "    ", result_prefix, "sim.func.dpi.call @",
                dpi_import.name, "(", input_refs, ") clock ", clock_ref,
                " enable ", value_ref(operation.operands[1]),
                " : (", input_types, ") -> ", result_type)

/* Emits explicit-clock firreg state with optional synchronous reset and verified async_reg stage metadata. */
fun emit_register(operation :: Operation):
  def current = operation.results[0]
  def next = operation.places[0]
  def clock = operation.operands[0]
  def clock_ref = "%__rhodium_clock_" ++ to_string(operation.id)
  def reset_text:
    if operation.opcode == "rtl.register_reset"
    | String.append(" reset sync ",
                    value_ref(operation.operands[1]), ", ",
                    value_ref(operation.operands[2]))
    | ""
  def attribute_text:
    if current_circt_sync_register_ids().find(
         fun (id): id == operation.id
       )
    | " {sv.attributes = [#sv.attribute<\"async_reg\" = \"\\\"TRUE\\\"\">]}"
    | ""
  String.append("    ", clock_ref, " = seq.to_clock ", value_ref(clock), "\n",
                "    ", value_ref(current), " = seq.firreg ",
                value_ref(next.driver), " clock ", clock_ref,
                reset_text, attribute_text, " : ", circt_type(current.type))

/* Connects one child occurrence in verified input/result order with the child module's port types. */
fun emit_instance(operation :: Operation):
  def child = operation.attribute("module")
  def instance_name = operation.attribute("name")
  def mutable inputs = []
  def mutable outputs = []
  for (port in child.inputs,
       place in operation.places):
    def input_text:
      String.append(port.name, ": ",
                    value_ref(place.driver), ": ",
                    circt_type(port.type))
    inputs := inputs ++ [input_text]
  for (port in child.outputs):
    outputs := outputs ++ [port.name ++ ": " ++ circt_type(port.type)]
  def result_prefix:
    if operation.results.length() == 0
    | ""
    | String.join(operation.results.map(value_ref), ", ") ++ " = "
  String.append("    ", result_prefix,
                "hw.instance \"", instance_name, "\" @", child.name,
                "(", String.join(inputs, ", "), ") -> (",
                String.join(outputs, ", "), ")")

/* Dispatches concrete operations to CIRCT lowering, omitting alias/structural metadata and rejecting gaps. */
fun emit_operation(operation :: Operation):
  if alias_operation(operation)
  | ""
  | match operation.opcode
    | "rtl.input_port" || "rtl.output_port" || "rtl.wire" || "rtl.drive":
        ""
    | "cdc.sync_level":
        ""
    | "rtl.constant":
        emit_constant(operation)
    | "rtl.dont_care":
        emit_dont_care(operation)
    | "rtl.decode":
        emit_decode(operation)
    | "rtl.and":
        emit_binary(operation, "comb.and")
    | "rtl.or":
        emit_binary(operation, "comb.or")
    | "rtl.xor":
        emit_binary(operation, "comb.xor")
    | "rtl.add":
        emit_binary(operation, "comb.add")
    | "rtl.mul":
        emit_binary(operation, "comb.mul")
    | "rtl.sub":
        emit_binary(operation, "comb.sub")
    | "rtl.shl":
        emit_shift(operation, "comb.shl")
    | "rtl.shru":
        emit_shift(operation, "comb.shru")
    | "rtl.shrs":
        emit_shift(operation, "comb.shrs", #true)
    | "rtl.not":
        emit_not(operation)
    | "rtl.eq":
        emit_eq(operation)
    | "rtl.ult":
        emit_ult(operation)
    | "rtl.slt":
        emit_slt(operation)
    | "rtl.mux_lookup":
        emit_mux_lookup(operation)
    | "rtl.onehot_mux":
        emit_onehot_mux(operation)
    | "rtl.concat":
        emit_concat(operation)
    | "rtl.extract":
        emit_extract(operation)
    | "rtl.zext":
        emit_zext(operation)
    | "rtl.sext":
        emit_sext(operation)
    | "rtl.trunc":
        emit_trunc(operation)
    | "rtl.cast":
        emit_cast(operation)
    | "rtl.record_create":
        emit_record_create(operation)
    | "rtl.record_get":
        emit_record_get(operation)
    | "rtl.vector_create":
        emit_vector_create(operation)
    | "rtl.vector_get":
        emit_vector_get(operation)
    | "rtl.vector_index":
        emit_vector_index(operation)
    | "rtl.vector_inject":
        emit_vector_inject(operation)
    | "rtl.vector_write_set":
        emit_vector_write_set(operation)
    | "rtl.memory":
        emit_memory(operation)
    | "rtl.memory_read_async":
        emit_memory_read_async(operation)
    | "rtl.memory_write":
        emit_memory_write(operation)
    | "rtl.sync_memory":
        emit_sync_memory(operation)
    | "verif.assert":
        emit_assert(operation)
    | "sim.dpi_call" || "sim.dpi_register":
        emit_dpi_operation(operation)
    | "rtl.register" || "rtl.register_reset":
        emit_register(operation)
    | "rtl.instance":
        emit_instance(operation)
    | ~else:
        error(~who: #'emit_circt,
              "no CIRCT lowering for operation " ++ operation.opcode)

/* Renders one concrete module in a fresh alias-free type environment. */
fun emit_module_circt(module_def :: Module):
  parameterize { current_circt_types: fresh_circt_types() }:
    render_module_circt(module_def)

/* Renders a concrete module under the current type environment, deriving synchronizer stage
   attributes from verified evidence and resolving output drivers to their SSA values. */
fun render_module_circt(module_def :: Module):
  require_concrete_module(module_def)
  def ports:
    module_def.inputs.map(
      fun (port):
        "in %" ++ port.name ++ " : " ++ circt_type(port.type)
    ) ++ module_def.outputs.map(
      fun (port):
        "out " ++ port.name ++ " : " ++ circt_type(port.type)
    )
  def mutable sync_register_ids = []
  for (operation in module_def.operations):
    when operation.opcode == "cdc.sync_level"
    | sync_register_ids := sync_register_ids ++ operation.operands.drop(2).map(
        fun (stage): stage.defining_op_id
      )
  def operations:
    parameterize { current_circt_sync_register_ids: sync_register_ids }:
      module_def.operations.map(emit_operation).filter(~keep: fun (text): text != "")
  def output_values = module_def.outputs.map(fun (port): value_ref(port.place.driver))
  def output_types = module_def.outputs.map(fun (port): circt_type(port.type))
  def output:
    if output_values.length() == 0
    | "    hw.output"
    | String.append("    hw.output ", String.join(output_values, ", "),
                    " : ", String.join(output_types, ", "))
  String.append("  hw.module @", module_def.name,
                "(", String.join(ports, ", "), ") {\n",
                String.join(operations ++ [output], "\n"),
                "\n  }")

/* Verifies the design and emits ordered aliases, DPI declarations, and modules with emission-local caches. */
fun emit_circt(design :: Design):
  verify_design(design)
  parameterize { current_circt_types: fresh_circt_types() }:
    def aliases = collect_circt_record_aliases(design)
    def declarations = emit_circt_record_aliases(aliases)
    def imports = design.dpi_imports.map(emit_dpi_import)
    def sections = (if declarations == "" | [] | [declarations]) ++ imports ++ design.modules.map(render_module_circt)
    String.append("module attributes {circt.loweringOptions = \"disallowLocalVariables\"} {\n",
                  String.join(sections, "\n\n"),
                  "\n}\n")
