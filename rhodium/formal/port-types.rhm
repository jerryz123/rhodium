#lang rhombus
/* Projects scalar RTL port descriptors into the sampled sorts used by specs and wiring graphs. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../core/types.rhm" as hw
  "../core/ir.rhm".Module
  "../core/ir.rhm".Port
  "spec.rhm" open

export sampled_type SampledPorts check_output_types
export leaf_layout port_leaves

/* Detached input/output sorts for one sampled edge; contains no module, drivers, or live RTL values. */
class SampledPorts(inputs :: Map, outputs :: Map)

/* Record logical sampled names and widths in each physical pin's most-significant-first order. */
fun leaf_layout(top :: Module, prefixes :: Map):
  /* A scalar is a one-member word, while interface records retain declaration order. */
  fun layout(ports :: List):
    for Map (p in ports.filter(~keep: fun (p :: Port): !hw.clock_type(p.type))):
      def fields:
        if prefixes.has_key(p.name)
        | for List (f in p.type.fields): PairList[prefixes[p.name] ++ "." ++ f.name, f.type.packed_width()]
        | [PairList[p.name, p.type.packed_width()]]
      values(p.name, PairList[& fields])
  PairList[layout(top.inputs), layout(top.outputs)]

/* Give a scalar port or each member of a declared directional record its public endpoint name. */
fun port_leaves(p :: Port, prefixes :: Map, visit :: Function.of_arity(2)):
  cond
  | prefixes.has_key(p.name):
      for Map (f in p.type.fields):
        values(f.name, visit(prefixes[p.name] ++ "." ++ f.name, f.type))
  | ~else: visit(p.name, p.type)

/* Convert nominal Bool and Reset to logical samples, leaving Bits(1) as a packed word. */
fun sampled_type(type :: hw.HardwareType, bool :: hw.HardwareType):
  cond
  | hw.reset_type(type) || hw.type_equal(type, bool): SpecBool()
  | hw.bits_type(type): SpecBits(type.width)
  | ~else: error("unsupported sampled port type: " ++ type.describe())

/* Check names and sorts even for observations whose care guard happens to be false. */
fun check_output_types(model :: LeafModel, expected :: Map, ignored :: List.of(String) = []):
  def seen = MutableSet{}
  for (name in ignored):
    unless expected.has_key(name) && !model.outputs.has_key(name) && !(name in seen)
    | error("invalid ignored output: " ++ name)
    seen.add(name)
  for (name in model.outputs.keys()):
    unless expected.has_key(name) | error("observation is not a signature output: " ++ name)
  for ((name, type) in expected):
    unless name in seen
    | block:
        unless model.outputs.has_key(name) | error("missing output observation: " ++ name)
        unless spec_type_equal(model.outputs[name].value.type, type)
        | error("output observation type mismatch: " ++ name)
  model
