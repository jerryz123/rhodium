#lang rhombus
/* Builds a spec execution graph from parent-local RTL and explicit child boundaries without expanding child implementations. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../core/main.rhm" open
  "spec.rhm" open
  "parent-local.rhm" open
  "port-types.rhm".sampled_type
  "port-types.rhm".leaf_layout
  "port-types.rhm".port_leaves

export wiring_cut series_wiring check_fifo_series_wiring wrapper_wiring bind_wiring proof_cut cut_parts leaf_protocol leaf_layout

/* The first proof profiles have unrestricted traffic: clockless, or one named rising-edge clock. */
fun leaf_protocol(top :: Module):
  def clocks = (top.inputs ++ top.outputs).filter(~keep: fun (p :: Port): clock_type(p.type))
  cond
  | clocks.length() == 0: "combinational"
  | clocks.length() == 1 && clocks[0].name == "clock" && clocks[0].direction == "input": "single-clock-reset"
  | ~else: error("unsupported leaf clock boundary")

/* Stop at child signatures. Record creation and selection only route existing wires. */
fun wiring_cut(top :: Module, interface_prefixes :: Function.of_arity(1)):
  def values(children, wires, _) = extract_cut(top, prefix_reader(interface_prefixes), #false)
  values(children, wires)

/* Cycle cuts use the logical member names supplied by the RTL interface adapter. */
fun prefix_reader(interface_prefixes :: Function.of_arity(1)):
  def cached = MutableMap.by(===){}
  fun (_, m, p, visit):
    unless cached.has_key(m) | cached[m] := interface_prefixes(m)
    port_leaves(p, cached[m], visit)

/* Decode top ports using the bound parent view and child ports using exact occurrence evidence.
   Record creation/selection follows physical fields, independently of the claimed handshakes. */
fun layout_reader(top :: Module, top_layout :: PairList, child_layout :: Function.of_arity(2), comb :: Map = {}):
  unless leaf_protocol(top) == "single-clock-reset" | error("expected a clocked transaction parent")
  def layouts = MutableMap{#false: top_layout}
  /* Reconstruct each directional record in physical field order before visiting logical pins. */
  fun read_port(site :: maybe(String), m :: Module, p :: Port, visit :: Function.of_arity(2)):
    unless layouts.has_key(site)
    | block:
        def protocol = if comb.has_key(site) | "combinational" | "single-clock-reset"
        when site.contains(".") || leaf_protocol(m) != protocol
        | error("invalid transaction occurrence: " ++ site)
        layouts[site] := child_layout(site, m)
    cond
    | clock_type(p.type): visit("clock", p.type)
    | ~else:
        let PairList[inputs, outputs] = layouts[site]
        def layout = if p.direction == "input" | inputs | outputs
        def members = PairList.to_list(layout[p.name])
        cond
        | record_type(p.type):
            unless members.length() == p.type.fields.length() | error("transaction record layout mismatch")
            for Map (field in p.type.fields, member in members):
              let PairList[name, width] = member
              unless name.ends_with("." ++ field.name) && width == field.type.packed_width()
              | error("transaction member layout mismatch: " ++ field.name)
              values(field.name, visit(name, field.type))
        | ~else:
            unless members == [PairList[p.name, p.type.packed_width()]] | error("transaction scalar layout mismatch")
            visit(p.name, p.type)
  read_port

/* Extract a direct, two-occurrence wiring cut with the supplied physical layouts. */
fun series_wiring(top :: Module, top_layout :: PairList, child_layout :: Function.of_arity(2)):
  def values(children, wires, _) = extract_cut(top, layout_reader(top, top_layout, child_layout), #false)
  unless children.length() == 2 | error("expected two FIFO occurrences")
  values(children, wires)

/* Verify the complete physical handoff from concrete endpoint descriptors; this check never issues evidence. */
fun check_fifo_series_wiring(top :: Module, layout :: PairList, ingress :: PairList, egress :: PairList,
                             a :: ReadableString.to_string, front :: Map, b :: ReadableString.to_string, back :: Map):
  def mismatch = "transaction evidence does not match the RTL occurrences"
  when a == b | error(mismatch)
  def descriptors = {a: front, b: back}
  /* Release a child layout only to the occurrence of its exact definition. */
  fun layout_at(site :: String, m :: Module):
    def child = descriptors.get(site, #false)
    unless child && child["definition"] === m | error(mismatch)
    child["layout"]
  def pins = MutableList[]
  for (direction in layout):
    for ((_, members) in direction):
      for (member in members): pins.add(member[0])
  def endpoints = MutableList["reset"]
  for (lane in ingress):
    for (p in lane): endpoints.add(p)
  for (p in egress): endpoints.add(p)
  unless front["width"] == back["width"] && ingress.length() == front["ingress"].length()
         && pins.snapshot().sort() == endpoints.snapshot().sort()
         && !(pins.snapshot().find(fun (p): p.starts_with(a ++ ".") || p.starts_with(b ++ ".")))
  | error("incompatible FIFO endpoints")
  def values(_, wires) = series_wiring(top, layout, layout_at)
  /* Qualify all three endpoint members at their RTL occurrence. */
  fun at(site :: String, members :: PairList):
    for PairList (p in members): site ++ "." ++ p
  /* Compare the actual driver, retaining the failing sink in the diagnostic. */
  fun wire(sink :: String, source :: String):
    def actual = wires.get(sink, #false)
    unless actual == source | error("expected " ++ sink ++ " driven by " ++ source ++ ", got " ++ to_string(actual))
  /* Forward valid and data; reverse ready. */
  fun link(from :: PairList, to :: PairList):
    let PairList[fv, fr, fd] = from
    let PairList[tv, tr, td] = to
    wire(tv, fv)
    wire(fr, tr)
    wire(td, fd)
  for (site in [a,b]):
    for (p in ["clock","reset"]): wire(site ++ "." ++ p, p)
  for (lane in ingress, f in front["ingress"]): link(lane, at(a, f))
  unless back["ingress"].length() == 1 | error("expected a single FIFO ingress")
  link(at(a, front["egress"]), at(b, back["ingress"][0]))
  link(at(b, back["egress"]), egress)
  unless wires.length() == 4 + 3 * (2 + ingress.length()) | error("unexpected parent or child wiring")

/* Open the declared transaction occurrences: child outputs are independent graph inputs and child inputs
   are observed sinks. Only actual parent-local RTL is executed, never a child transition. */
fun wrapper_wiring(top :: Module, top_layout :: PairList, visible :: Map, child_layout :: Function.of_arity(2),
                   bool :: HardwareType, comb :: Map = {}, clockless_monitors :: Map = {}):
  // Both profiles are clockless, but only cycle evidence supplies an executable graph actor.
  def read = layout_reader(top, top_layout, child_layout, comb ++ clockless_monitors)
  def inputs = MutableMap{}
  def outputs = MutableMap{}
  when comb.keys().find(visible.has_key) | error("overlapping monitor and combinational sites")
  def sites = visible.keys() ++ comb.keys()
  when local_site in sites | error("reserved transaction occurrence")
  /* Keep the full environment, but do not expose hidden child outputs to the local graph. */
  fun boundary(at :: maybe(String), m :: Module, p :: Port, visit :: Function.of_arity(2)):
    /* Declare each open net in the direction seen from outside the local graph. */
    fun member(name :: String, type :: HardwareType):
      unless clock_type(type) || comb.has_key(at)
      | block:
          when !at && (sites ++ [local_site]).find(fun (site): name.starts_with(site ++ "."))
          | error("ambiguous wrapper endpoint: " ++ name)
          def pin = if at | at ++ "." ++ name | name
          def source = if at | p.direction == "output" | p.direction == "input"
          unless at && source && !(name in visible[at])
          | (if source | inputs | outputs)[pin] := sampled_type(type, bool)
      visit(name, type)
    read(at, m, p, member)
  def values(children, wires, locals) = extract_cut(top, boundary, bool)
  unless children.keys().sort() == sites.sort() | error("transaction evidence does not match the RTL occurrences")
  def mutable data_wires = wires
  for (site in visible.keys()):
    unless clockless_monitors.has_key(site)
    | block:
        unless wires[site ++ ".clock"] == "clock" && wires[site ++ ".reset"] == "reset"
        | error("expected direct parent clock/reset at " ++ site)
        data_wires := data_wires.remove(site ++ ".clock")
  composition_snapshot(make_composition(inputs.snapshot(), outputs.snapshot(), locals ++ comb, data_wires))

/* For proof cuts, retain supported parent operations as one derived local actor. Never visit child bodies. */
fun extract_cut(top :: Module, read_port :: Function.of_arity(4), bool :: maybe(HardwareType)):
  unless top.finished | error("expected completed RTL parent")
  def sources = MutableMap{}
  def sinks = MutableMap{}
  def children = MutableMap{}
  def sites = top.operations.filter(~keep: fun (op :: Operation): op.opcode == "rtl.instance")
  for (p in top.inputs):
    sources[p.value.id] := read_port(#false, top, p, fun (name, _): name)
  for (op in sites):
    def site = op.attribute("name")
    def child = op.attribute("module")
    children[site] := child
    for (p in child.outputs, v in op.results):
      sources[v.id] := read_port(site, child, p, fun (name, _): site ++ "." ++ name)
  def local_ops = top.operations.filter(~keep: fun (op :: Operation): local_opcode(op.opcode))
  when bool && local_ops.length() > 0 && children.has_key(local_site)
  | error("reserved local RTL site: " ++ local_site)
  for (op in top.operations):
    match op.opcode
    | "rtl.record_get":
        sources[op.results[0].id] := sources[op.operands[0].id][op.attribute("field")]
    | "rtl.record_create":
        sources[op.results[0].id] := for Map (f in op.attribute("fields"), v in op.operands): values(f, sources[v.id])
    | "rtl.input_port" || "rtl.output_port" || "rtl.drive" || "rtl.instance": #void
    | ~else:
        unless bool | error("not a wiring-only parent: " ++ op.opcode)
        unless local_opcode(op.opcode) | error("unsupported parent operation: " ++ op.opcode)
        sources[op.results[0].id] := local_site ++ "." ++ local_output(op.results[0])
  /* Preserve the member correspondence of whole-record connections as well as partial drives. */
  fun connect(site :: maybe(String), m :: Module, p :: Port, driver :: Value):
    def prefix = if site | site ++ "." | ""
    def pins = read_port(site, m, p, fun (name, _): prefix ++ name)
    def source = sources[driver.id]
    if pins is_a Map
    | for ((field, pin) in pins): sinks[pin] := source[field]
    | sinks[pins] := source
  for (op in sites):
    def site = op.attribute("name")
    def child = children[site]
    for (p in child.inputs, place in op.places): connect(site, child, p, place.driver)
  for (p in top.outputs): connect(#false, top, p, p.place.driver)
  def locals:
    if bool && local_ops.length() > 0
    | {local_site: lower_local(local_ops, sources, sinks, bool)}
    | {}
  values(children.snapshot(), sinks.snapshot(), locals)

/* Substitute by exact definition identity, checking sampled member types and direct clocking. */
fun bind_wiring(top :: Module, bindings :: Map, bool :: HardwareType, interface_prefixes :: Function.of_arity(1)):
  def values(children, wires) = wiring_cut(top, interface_prefixes)
  link_cut(top, bindings, bool, interface_prefixes, children, wires)

/* A run-local cut carries the actual child definitions alongside the graph built from that same cut. */
class ProofCut(top :: Module, layout :: PairList, graph :: Map, definitions :: Map, layouts :: Map, locals :: Map)

/* Build an unproved candidate without snapshotting the child implementations. */
fun proof_cut(top :: Module, bindings :: Map, bool :: HardwareType, interface_prefixes :: Function.of_arity(1)):
  def prefixes = MutableMap.by(===){}
  /* Use the same captured naming map to decode the wires and to identify the expected sampled view. */
  fun fields(module_def :: Module):
    unless prefixes.has_key(module_def) | prefixes[module_def] := interface_prefixes(module_def)
    prefixes[module_def]
  def values(children, wires, locals) = extract_cut(top, prefix_reader(fields), bool)
  def model = link_cut(top, bindings, bool, fields, children, wires, locals)
  for ((site, child) in children):
    when leaf_protocol(child) == "single-clock-reset" && wires.get(site ++ ".reset", #false) != "reset"
    | error("expected direct parent reset at " ++ site)
  def layouts = for Map ((site, child) in children): values(site, leaf_layout(child, fields(child)))
  ProofCut(top, leaf_layout(top, fields(top)), composition_snapshot(model), children, layouts,
           for Map ((site, rtl) in locals): values(site, spec_snapshot(rtl)))

/* Only a cut constructed from a completed RTL parent may enter evidence preflight. */
fun cut_parts(cut :: ProofCut): values(cut.top, cut.layout, cut.graph, cut.definitions, cut.layouts, cut.locals)

/* Check a single extraction before constructing either a concrete model or a proof candidate. */
fun link_cut(top :: Module, bindings :: Map, bool :: HardwareType, interface_prefixes :: Function.of_arity(1),
             children :: Map, wires :: Map, locals :: Map = {}):
  def names = MutableSet{}
  def clocks = MutableSet{}
  /* Keep each public sample, omitting only the named rising-edge clock. */
  fun schema(ports :: List):
    def result = MutableMap{}
    for (p in ports.filter(~keep: fun (p :: Port): !clock_type(p.type))):
      /* Add one public sample with its nominal hardware sort. */
      fun add_sample(key :: String, type :: HardwareType):
        names.add(key)
        result[key] := sampled_type(type, bool)
      port_leaves(p, interface_prefixes(top), add_sample)
    result.snapshot()
  unless top.inputs.find(fun (p :: Port): p.name == "clock" && clock_type(p.type))
         && top.inputs.filter(~keep: fun (p :: Port): clock_type(p.type)).length() == 1
         && !top.outputs.find(fun (p :: Port): clock_type(p.type))
  | error("expected one parent clock input named clock")
  def inputs = schema(top.inputs)
  def outputs = schema(top.outputs)
  def models = for Map ((site, child) in children):
    unless bindings.has_key(child) | error("unbound RTL child definition: " ++ site)
    def model :: LeafModel = bindings[child]
    def seen = MutableSet{}
    def prefixes = interface_prefixes(child)
    for (p in child.inputs ++ child.outputs):
      cond
      | clock_type(p.type):
          def pin = site ++ "." ++ p.name
          unless p.direction == "input" && p.name == "clock" && wires[pin] == "clock"
          | error("expected direct parent clock at " ++ pin)
          clocks.add(pin)
      | ~else:
          /* Validate one directed member before exposing it to the composition. */
          fun bind_sample(key :: String, type :: HardwareType):
            def pin = site ++ "." ++ key
            def input = p.direction == "input"
            def fields = if input | model.inputs | model.outputs
            cond
            | fields.has_key(key):
                def t = if input | fields[key] | fields[key].value.type
                unless !(key in seen) && spec_type_equal(t, sampled_type(type, bool))
                | error("ambiguous or mistyped RTL/spec pin: " ++ pin)
                names.add(pin)
                seen.add(key)
            | input: error("unbound RTL/spec pin: " ++ pin)
            | ~else: #void
          port_leaves(p, prefixes, bind_sample)
    unless seen.length() == model.inputs.length() + model.outputs.length()
    | error("spec pin missing from RTL signature: " ++ site)
    values(site, model)
  for ((site, model :: LeafModel) in locals):
    for (key in model.outputs.keys()): names.add(site ++ "." ++ key)
  def connected = for Map (sink in wires.keys().filter(~keep: fun (k :: String): !(k in clocks))):
    def source = wires[sink]
    unless source in names | error("parent uses an unmodeled child output or clock: " ++ source)
    values(sink, source)
  make_composition(inputs, outputs, models ++ locals, connected)
