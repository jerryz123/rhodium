#lang rhombus
/* Lowers the supported parent RTL operations into a scheduled actor without traversing instances. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../core/main.rhm" open
  "spec.rhm" open
  "port-types.rhm".sampled_type

export local_site local_opcode local_output lower_local

// Not a legal RTL instance name. Child substitution can never supply this model.
def local_site = "@local"

/* Only these opcodes have a local interpretation; other parent logic fails closed. */
fun local_opcode(opcode :: String):
  opcode in {"rtl.constant", "rtl.cast", "rtl.not", "rtl.and", "rtl.or",
             "rtl.eq", "rtl.mux_lookup", "rtl.register", "rtl.register_reset"}

/* Give each local result an endpoint distinct from sampled operand ports. */
fun local_output(value :: Value): "v" ++ to_string(value.id)

/* Read only parent operations, their actual drivers, and the named direct clock/reset domain. */
fun lower_local(ops :: List, sources :: MutableMap, sinks :: MutableMap, bool :: HardwareType):
  def inputs = MutableMap{}
  def outputs = MutableMap{}
  def state = MutableMap{}
  def initial = MutableMap{}
  def updates = MutableMap{}
  def constants = MutableMap{}
  def bit = SpecBool()
  def one_bit = SpecBits(1)
  /* Preserve the RTL distinction between Bool and its one-bit packed representation. */
  fun packed_bit(test :: SpecExpr): choose_if(test, literal(one_bit, 1), literal(one_bit, 0))
  /* Interpret an already width-checked one-bit control as a logical condition. */
  fun predicate(word :: SpecExpr): bits_equal(word, literal(one_bit, 1))
  /* A tap receives the once-settled physical net, including arbitrary values on uncared child pins. */
  fun tap(value :: Value):
    def type = sampled_type(value.type, bool)
    def name = "i" ++ to_string(value.id)
    inputs[name] := type
    sinks[local_site ++ "." ++ name] := sources[value.id]
    input_ref(name, type)
  for (op :: Operation in ops):
    def result = op.results[0]
    def logical = type_equal(result.type, bool)
    def packed_one = bits_type(result.type) && result.type.width == 1
    def packed_result = packed_one && (op.opcode == "rtl.cast" || op.opcode == "rtl.eq")
    def packed_data = bits_type(result.type) && op.opcode in {"rtl.constant", "rtl.mux_lookup", "rtl.register"}
    unless logical || packed_result || packed_data
    | error("unsupported local RTL result type: " ++ op.opcode)
    def expr:
      match op.opcode
      | "rtl.constant":
          def n = op.attribute("value")
          when logical && n != 0 && n != 1 | error("expected Boolean constant")
          constants[result.id] := n
          if logical | literal(bit, n == 1) | literal(sampled_type(result.type, bool), n)
      | "rtl.cast":
          def source = op.operands[0]
          when constants.has_key(source.id) | constants[result.id] := constants[source.id]
          cond
          | logical && bits_type(source.type) && source.type.width == 1: predicate(tap(source))
          | packed_one && type_equal(source.type, bool): packed_bit(tap(source))
          | ~else: error("expected a cast between Bool and Bits(1)")
      | "rtl.eq":
          unless packed_one | error("expected a one-bit packed equality result")
          packed_bit(bits_equal(tap(op.operands[0]), tap(op.operands[1])))
      | "rtl.not": bool_not(tap(op.operands[0]))
      | "rtl.or": bool_not(bool_and(bool_not(tap(op.operands[0])), bool_not(tap(op.operands[1]))))
      | "rtl.mux_lookup":
          unless op.attribute("keys") == [1] && op.operands.length() == 3
          | error("expected a binary mux with a one-bit selector")
          choose_if(predicate(tap(op.operands[0])), tap(op.operands[2]), tap(op.operands[1]))
      | "rtl.and": bool_and(tap(op.operands[0]), tap(op.operands[1]))
      | "rtl.register":
          def [clk] = op.operands
          unless bits_type(result.type) && sources[clk.id] == "clock" | error("expected a directly clocked packed register")
          def name = op.attribute("name")
          when state.has_key(name) | error("duplicate parent register name: " ++ name)
          def type = sampled_type(result.type, bool)
          state[name] := type
          // make_spec needs a concrete simulation seed. Proof cuts allocate fresh symbolic
          // old state for every register, including on reset; the actual D has no reset mux.
          initial[name] := 0
          updates[name] := tap(op.places[0].driver)
          state_ref(name, type)
      | "rtl.register_reset":
          def [clk, rst, init] = op.operands
          unless sources[clk.id] == "clock" && sources[rst.id] == "reset" && constants.has_key(init.id)
          | error("expected direct parent clock/reset and constant register start")
          def name = op.attribute("name")
          when state.has_key(name) | error("duplicate parent register name: " ++ name)
          state[name] := bit
          initial[name] := constants[init.id] == 1
          updates[name] := choose_if(tap(rst), tap(init), tap(op.places[0].driver))
          state_ref(name, bit)
      | ~else: error("unsupported parent operation: " ++ op.opcode)
    outputs[local_output(result)] := Observed(expr)
  make_spec(inputs.snapshot(), state.snapshot(), initial.snapshot(), outputs.snapshot(), {}, updates.snapshot())
