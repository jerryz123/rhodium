#lang rhombus
/* Lowers the supported parent RTL operations into a scheduled actor without traversing instances. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../core/main.rhm" open
  "spec.rhm" open

export local_site local_opcode local_output lower_local

// Not a legal RTL instance name. Child substitution can never supply this model.
def local_site = "@local"

/* Only these opcodes have a local interpretation; other parent logic fails closed. */
fun local_opcode(opcode :: String):
  opcode == "rtl.constant" || opcode == "rtl.cast" || opcode == "rtl.and" || opcode == "rtl.register_reset"

/* Give each local result an endpoint distinct from sampled operand ports. */
fun local_output(value :: Value): "v" ++ to_string(value.id)

/* Read only parent operations, their actual drivers, and the named direct clock/reset domain. */
fun lower_local(ops :: List, sources :: MutableMap, sinks :: MutableMap, bool :: HardwareType):
  def inputs = MutableMap{}
  def outputs = MutableMap{}
  def state = MutableMap{}
  def initial = MutableMap{}
  def updates = MutableMap{}
  def constants = MutableMap{}
  def bit = SpecBool()
  /* A tap receives the once-settled physical net, including arbitrary values on uncared child pins. */
  fun tap(value :: Value):
    unless type_equal(value.type, bool) || reset_type(value.type) | error("expected Boolean local RTL operand")
    def name = "i" ++ to_string(value.id)
    inputs[name] := bit
    sinks[local_site ++ "." ++ name] := sources[value.id]
    input_ref(name, bit)
  for (op :: Operation in ops):
    def result = op.results[0]
    def logical = type_equal(result.type, bool)
    unless logical || (op.opcode == "rtl.constant" && bits_type(result.type) && result.type.width == 1)
    | error("expected Boolean local RTL or a one-bit literal: " ++ op.opcode)
    def expr:
      match op.opcode
      | "rtl.constant":
          def n = op.attribute("value")
          unless n == 0 || n == 1 | error("expected one-bit local constant")
          constants[result.id] := n
          if logical | literal(bit, n == 1) | literal(SpecBits(1), n)
      | "rtl.cast":
          def source = op.operands[0]
          unless bits_type(source.type) && source.type.width == 1 && constants.has_key(source.id)
          | error("only one-bit literal casts to Bool are supported in local RTL")
          constants[result.id] := constants[source.id]
          literal(bit, constants[result.id] == 1)
      | "rtl.and": bool_and(tap(op.operands[0]), tap(op.operands[1]))
      | "rtl.register_reset":
          def [clk, rst, init] = op.operands
          unless sources[clk.id] == "clock" && sources[rst.id] == "reset" && constants.has_key(init.id)
          | error("expected direct parent clock/reset and constant register start")
          def name = op.attribute("name")
          when state.has_key(name) | error("duplicate parent register name: " ++ name)
          state[name] := bit
          initial[name] := constants[init.id] == 1
          updates[name] := choose_if(tap(rst), tap(init), tap(op.places[0].driver))
          state_ref(name, bit)
      | ~else: error("unsupported parent operation: " ++ op.opcode)
    outputs[local_output(result)] := Observed(expr)
  make_spec(inputs.snapshot(), state.snapshot(), initial.snapshot(), outputs.snapshot(), {}, updates.snapshot())
