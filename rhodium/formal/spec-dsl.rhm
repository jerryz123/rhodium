#lang rhombus/and_meta
/* Provides the typed expression operators shared by RSPECL and ordinary Rhombus helpers. */
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus
  rhombus/meta open
  "spec.rhm" open

export:
  SpecExpr Bool select append seq_concat bool_equal bits_equal bits_slice ! && || operand
  rename:
    SpecBits as Bits
    SpecSeq as Seq
    literal as const
    seq_empty as empty
    seq_full as full
    seq_front as front
    seq_tail as tail

def Bool = SpecBool()

/* Lift host Boolean literals at spec boundaries; the IR constructors check operand types. */
fun operand(v :: Boolean || SpecExpr): if v is_a Boolean | literal(Bool, v) | v

/* Construct both branches as IR; on a sampled edge only the selected branch must be defined. */
fun select(test :: Boolean || SpecExpr, yes :: Boolean || SpecExpr, no :: Boolean || SpecExpr):
  choose_if(operand(test), operand(yes), operand(no))

/* Compare two logical predicates; neither operand may be a packed one-bit word. */
fun bool_equal(left :: Boolean || SpecExpr, right :: Boolean || SpecExpr) :: SpecExpr:
  def rhs = operand(right)
  choose_if(operand(left), rhs, bool_not(rhs))

/* Booleans can be sequence elements; packed constants still need an explicit width. */
fun append(seq :: SpecExpr, value :: Boolean || SpecExpr): seq_append(seq, operand(value))

/* Short-circuit static Boolean decisions during construction. A sampled left operand
   builds a guarded expression; the construction thunk never enters the IR. */
fun combine(left :: Boolean || SpecExpr, right :: Function.of_arity(0), disjoin :: Boolean):
  cond
  | (left is_a Boolean) rhombus.(&&) (left == disjoin): left
  | ~else:
      def rhs = right()
      cond
      | (left is_a Boolean) rhombus.(&&) (rhs is_a Boolean): rhs
      | disjoin: select(left, #true, rhs)
      | ~else: bool_and(operand(left), operand(rhs))

expr.macro '! $v':
  ~order: logical_negation
  'block:
     def value = $v
     if value is_a Boolean | value == #false | bool_not(value)'

expr.macro '$a && $b':
  ~order: logical_conjunction
  'combine($a, fun (): $b, #false)'

expr.macro '$a || $b':
  ~order: logical_disjunction
  'combine($a, fun (): $b, #true)'
