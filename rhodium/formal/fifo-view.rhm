#lang rhombus
/* Binds scalar or grouped FIFO handshakes on an elaborated module to a passive pre-edge sampler. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../core/ir.rhm".Module
  "../core/types.rhm" as hw
  "spec.rhm" open
  "fifo-monitor.rhm".fifo_monitor
  "port-types.rhm".sampled_type
  "port-types.rhm".leaf_layout
  "port-types.rhm".port_leaves

export make_fifo_view fifo_view_parts fifo_view_layout fifo_view_bool sample_fifo_events
export bind_fifo_behavior attach_fifo_series fifo_series_parts fifo_view_behavior fifo_behavior_view

/* Only the checked binder constructs this passive view of a particular elaborated definition. */
class FifoView(top :: Module, ingress :: List, egress :: List, width :: PosInt, sampler :: LeafModel, layout :: PairList,
               bool :: hw.HardwareType, behavior :: maybe(LeafModel) = #false, series :: maybe(PairList) = #false)

/* These seals promise standard FIFO semantics. Reject another monitor even when its shape matches. */
fun bind_fifo_behavior(view :: FifoView, model :: LeafModel):
  def q = model.state.get("q", #false)
  unless q is_a SpecSeq && spec_snapshot(model) == spec_snapshot(fifo_monitor(q.capacity, view.width))
  | error("expected the bounded FIFO monitor for this endpoint width")
  FifoView(view.top, view.ingress, view.egress, view.width, view.sampler, view.layout, view.bool, model)

/* Keep the implementation relation private; its only inputs are two independent child histories. */
fun attach_fifo_series(view :: FifoView, sites :: PairList, cuts :: Map, relation :: LeafModel, checks :: LeafModel):
  unless view.behavior && sites.length() == 2 && cuts.length() == 2
         && cuts.keys().sort() == PairList.to_list(sites).sort()
         && !cuts.values().find(fun (cut): !(cut is_a String))
         && relation.outputs.keys() == ["q"]
         && relation.inputs.keys().sort() == cuts.values().sort()
         && spec_type_equal(relation.outputs["q"].value.type, view.behavior.state["q"])
  | error("expected two FIFO histories and a projection to the public history q")
  for (model in [relation, checks]):
    unless model.state.length() == 0 && model.assumptions.length() == 0 | error("expected unconditional, stateless hints")
  for (table in [relation.events, checks.outputs, checks.events]):
    for ((name, f) in table):
      unless f.value.type is_a SpecBool | error("expected Boolean refinement predicate: " ++ name)
  FifoView(view.top, view.ingress, view.egress, view.width, view.sampler, view.layout, view.bool, view.behavior,
           PairList[sites, cuts, spec_snapshot(relation), spec_snapshot(checks)])

/* Identify the FIFO protocol adapter without exposing its constructor. */
fun fifo_behavior_view(v :~ matching(_)): v is_a FifoView

/* Read the declared public monitor, not a proof of the implementation. */
fun fifo_view_behavior(view :: FifoView): view.behavior

/* Only the proof issuer needs the occurrence names and the checked relation IR. */
fun fifo_series_parts(view :: FifoView): view.series || error("no two-FIFO refinement")

/* Resolve grouped fields in physical order. Keep scalar Boolean control inputs such as enable
   in the sample without treating them as transfers or imposing conditions on them. */
fun make_fifo_view(top :: Module, rst :: String, lanes :: List.of(List), egress :: List.of(String),
                   bool :: hw.HardwareType, prefixes :: Map = {}):
  unless lanes.length() == 1 || lanes.length() == 2 | error("expected one or two FIFO ingress lanes")
  let [ov, or_pin, ow] = egress
  def names = [rst] ++ lanes[0] ++ (if lanes.length() == 2 | lanes[1] | []) ++ egress
  def distinct = for Set (name in names): name
  def clock = top.find_input("clock")
  def epoch = top.find_input(rst)
  unless clock && hw.clock_type(clock.type) && rst == "reset" && epoch && hw.reset_type(epoch.type)
         && distinct.length() == names.length()
  | error("expected a synchronous FIFO with distinct scalar handshake pins and sampled reset")
  /* Preserve scalar side inputs; hidden outputs do not enter the sampler schema. */
  fun schema(ports :: List, inputs :: Boolean):
    def fields = MutableMap{}
    /* Grouped endpoints may have an independent scalar Bool control, never an omitted lane. */
    fun visit(name :: String, type :: hw.HardwareType):
      cond
      | name in distinct || (inputs && prefixes.length() > 0 && top.find_input(name) && hw.type_equal(type, bool)):
          when fields.has_key(name) | error("duplicate FIFO member: " ++ name)
          fields[name] := sampled_type(type, bool)
      | inputs || prefixes.length() == 0: error("unexpected FIFO pin: " ++ name)
      | ~else: #void
    for (p in ports):
      unless p.name == "clock" | port_leaves(p, prefixes, visit)
    fields.snapshot()
  def inputs = schema(top.inputs, #true)
  def outputs = schema(top.outputs, #false)
  /* Reject a reversed direction or an unknown pin even when its packed width would match. */
  fun pin(schema :: Map, key :: String):
    unless schema.has_key(key) | error("wrong FIFO pin name or direction: " ++ key)
    input_ref(key, schema[key])
  def reset = pin(inputs, rst)
  def valid = pin(outputs, ov)
  def consume = pin(inputs, or_pin)
  def outgoing = pin(outputs, ow)
  def transfers = for List (lane in lanes):
    let [v, r, w] = lane
    def word = pin(inputs, w)
    unless word.type is_a SpecBits && spec_type_equal(word.type, outgoing.type)
    | error("expected equal-width FIFO payload pins")
    [bool_and(pin(inputs, v), pin(outputs, r)), word]
  def active = bool_not(reset)
  let [fire, first_word] = transfers[0]
  def values(push, word, domain):
    cond
    | transfers.length() == 1: values(fire, first_word, {})
    | ~else:
        let [other, second_word] = transfers[1]
        // Selection is unambiguous on the sampler domain; this is not an arbitration policy.
        values(bool_not(bool_and(bool_not(fire), bool_not(other))), choose_if(fire, first_word, second_word),
               {"exclusive-ingress": bool_not(bool_and(active, bool_and(fire, other)))})
  def events = {"reset": Observed(literal(SpecBool(), #true), reset),
                "accepted": Observed(word, bool_and(active, push)),
                "retired": Observed(outgoing, bool_and(active, bool_and(valid, consume)))}
  FifoView(top, lanes, egress, outgoing.type.width,
           make_spec(inputs ++ outputs, {}, {}, {}, events, {}, ~assumptions: domain), leaf_layout(top, prefixes), bool)

/* Use the same nominal Boolean when lowering the wrapper that supplies the sampled pins. */
fun fifo_view_bool(view :: FifoView): view.bool

/* Check the physical member order of a passive view against already-proved cycle evidence. */
fun fifo_view_layout(view :: FifoView): view.layout

/* Expose checked pin roles for structural wiring verification and the sampler for symbolic execution. */
fun fifo_view_parts(view :: FifoView):
  values(view.top, (for PairList (lane in view.ingress): PairList[& lane]), PairList[& view.egress], view.width, view.sampler)

/* Sample concrete pre-edge pins in rspecsim; normalize raw one-bit control values but not payloads. */
fun sample_fifo_events(view :: FifoView, pins :: Map):
  def values_by_name = for Map ((name, value) in pins):
    def flag = view.sampler.inputs.get(name, #false) is_a SpecBool
    values(name, if flag && value is_a Int && (value == 0 || value == 1) | value == 1 | value)
  step_spec(view.sampler, {}, values_by_name).events
