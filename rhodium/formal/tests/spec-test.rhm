#lang rhombus
// SPDX-License-Identifier: Apache-2.0

import:
  "../spec.rhm" open
  "../fifo-monitor.rhm" open
  lib("flow/shift-queue.rhdl") as rtl
  lib("rhodium/frontend/foundation.rhm").Bits
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../examples/formal/shift-queue.rspl".ShiftQueue
  "../fifo-view.rhm".sample_fifo_events

def top = elaborate(rtl.ShiftQueue(Bits(2), 2)).top
def fifo = ShiftQueue(top)
def grouped = ShiftQueue(top, ~event_view: #true)
def simultaneous = {"reset": 0, "ingress.valid": 1, "ingress.ready": 1, "ingress.bits": 0,
                    "egress.ready": 1, "egress.valid": 1, "egress.bits": 3}
check:
  sample_fifo_events(grouped, simultaneous) ~is {"accepted": 0, "retired": 3}
  sample_fifo_events(grouped, simultaneous ++ {"reset": 1}) ~is {"reset": #true}
  sample_fifo_events(grouped, simultaneous ++ {"mask": 3}) ~throws "exact spec bindings"
def flags = [#false, #true]
def mutable cases = 0

def monitor = fifo_monitor(2, 2)
fun replay(q, batch): step_fifo_monitor(monitor, q, batch)
check:
  replay([], Map{}) ~is []
  replay([2], Map{}) ~is [2]
  replay([2, 1], {"reset": #true}) ~is []
  replay([], {"accepted": 0}) ~is [0]
  replay([2, 1], {"retired": 2, "accepted": 0}) ~is [1, 0]
  replay([3], {"retired": 3}) ~is []
  replay([2], {"retired": 1}) ~is #false
  replay([], {"retired": 0, "accepted": 0}) ~is #false
  replay([2, 1], {"accepted": 0}) ~is #false
  replay([], {"reset": #true, "accepted": 1}) ~is #false
  replay([1], {"reset": #true, "retired": 1}) ~is #false
  replay([], {"ready": #true}) ~throws "unknown FIFO event"
  replay([], {"accepted": 4}) ~throws "does not fit"

// The oracle enumerates legal transfers from concrete old occupancy, without IR constructors.
fun check_state(q):
  def n = q.length()
  for (reset in flags):
    for (offer in flags):
      for (consume in flags):
        for (word in 0..4):
          def state = {"q": q}
          def sample = {"reset": reset, "ingress.valid": offer, "egress.ready": consume, "ingress.bits": word}
          def step = step_spec(fifo, state, sample)
          def en = offer && n < 2
          def de = consume && n > 0
          def expected_q:
            cond
            | reset: []
            | en && de: [word] // At depth two only a singleton permits both.
            | de: q.drop(1)
            | en: q ++ [word]
            | ~else: q
          def outputs:
            cond
            | reset: Map{}
            | n == 0: {"ingress.ready": #true, "egress.valid": #false}
            | ~else: {"ingress.ready": n == 1, "egress.valid": #true, "egress.bits": q[0]}
          def events:
            cond
            | reset: {"reset": #true}
            | en && de: {"retired": q[0], "accepted": word}
            | de: {"retired": q[0]}
            | en: {"accepted": word}
            | ~else: Map{}
          // Give uncared pins concrete values, including asserted handshakes during reset.
          def pins = sample ++ {"ingress.ready": #true, "egress.valid": #true, "egress.bits": 3} ++ step.outputs
          check:
            step.outputs ~is outputs
            step.events ~is events
            sample_fifo_events(grouped, pins) ~is events
            step.next_state ~is {"q": expected_q}
          cases := cases + 1

check_state([])
for (a in 0..4):
  check_state([a])
  for (b in 0..4):
    check_state([a,b])
check:
  cases ~is 672
  fifo.initial ~is {"q": []}

// Multiple writes must all see the old sample; unspecified state holds.
def bit = SpecBits(1)
def swap = make_spec(Map{}, {"x": bit, "y": bit, "held": bit}, {"x": 1, "y": 0, "held": 1},
                     {"old_x": Observed(state_ref("x", bit))}, Map{},
                     {"x": state_ref("y", bit), "y": state_ref("x", bit)})
def swapped = step_spec(swap, swap.initial, Map{})
check:
  swapped.outputs ~is {"old_x": 1}
  swapped.next_state ~is {"x": 0, "y": 1, "held": 1}
  step_spec(swap, swapped.next_state, Map{}).next_state ~is swap.initial

def seq = SpecSeq(SpecBits(2), 2)
def empty = literal(seq, [])
def full = literal(seq, [0,1])
fun view(expr):
  make_spec(Map{}, Map{}, Map{}, {"v": Observed(expr)}, Map{}, Map{})
fun observe(expr):
  step_spec(view(expr), Map{}, Map{}).outputs
check:
  observe(bits_equal(literal(SpecBits(2), 2), literal(SpecBits(2), 2))) ~is {"v": #true}
  observe(bits_equal(literal(SpecBits(2), 2), literal(SpecBits(2), 0))) ~is {"v": #false}
  bits_equal(literal(bit, 1), literal(SpecBits(2), 1)) ~throws "equal-width"
  bits_equal(literal(bit, 1), literal(SpecBool(), #true)) ~throws "equal-width"
  literal(bit, 2) ~throws "does not fit"
  literal(seq, [0,1,2]) ~throws "capacity"
  literal(seq, [4]) ~throws "does not fit"
  Observed(empty, literal(bit, 0)) ~throws "boolean"
  choose_if(literal(SpecBool(), #true), full, literal(bit, 0)) ~throws "branch type"
  seq_append(empty, literal(SpecBool(), #false)) ~throws "element type"
  observe(seq_front(empty)) ~throws "empty sequence"
  observe(seq_tail(empty)) ~throws "empty sequence"
  observe(seq_append(full, literal(SpecBits(2), 0))) ~throws "full sequence"
  view(choose_if(literal(SpecBool(), #true), empty, state_ref("bad", seq))) ~throws "reference"
  make_spec({"x": bit}, Map{}, Map{}, {"v": Observed(input_ref("x", SpecBool()))}, Map{}, Map{}) ~throws "reference"
  make_spec(Map{}, {"q": seq}, {"q": []}, Map{}, Map{}, {"q": literal(bit, 0)}) ~throws "update type"
  make_spec(Map{}, {"x": bit}, {"z": 1}, Map{}, Map{}, Map{}) ~throws "missing spec binding"
  make_spec({}, {}, {}, {}, {}, {}, ~assumptions: {"width": literal(bit, 1)}) ~throws "boolean"
  make_spec({}, {"ok": SpecBool()}, {"ok": #true}, {}, {}, {},
            ~assumptions: {"old": bool_not(state_ref("ok", SpecBool()))}) ~throws "only scalar inputs"
  make_spec({}, {}, {}, {}, {}, {}, ~assumptions: {"missing": input_ref("go", SpecBool())}) ~throws "reference"
  step_spec(swap, swap.initial, {"extra": 0}) ~throws "exact spec bindings"
  step_spec(swap, {"x": 2, "y": 0, "held": 1}, Map{}) ~throws "does not fit"
