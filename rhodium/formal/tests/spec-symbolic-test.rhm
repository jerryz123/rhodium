#lang rhombus
// SPDX-License-Identifier: Apache-2.0

import:
  "../spec.rhm" open
  lib("flow/shift-queue.rhdl") as rtl
  lib("rhodium/frontend/foundation.rhm").Bits
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../examples/formal/shift-queue.rspl".ShiftQueue
  "spec-symbolic-checks.rkt" as solver

def fifo = ShiftQueue(elaborate(rtl.ShiftQueue(Bits(2), 2)).top)
fun fifo_row(contents, reset, offer, consume, data):
  def s = step_spec(fifo, {"q": PairList.to_list(contents)},
                    {"reset": reset, "ingress.valid": offer, "egress.ready": consume, "ingress.bits": data})
  PairList[s.outputs, s.events, PairList[& s.next_state["q"]]]

solver.check_fifo(spec_snapshot(fifo), fifo_row)

def older = input_ref("older", SpecSeq(SpecBits(2), 2))
def younger = input_ref("younger", SpecSeq(SpecBits(2), 1))
def joined = make_spec({"older": older.type, "younger": younger.type}, {}, {},
                       {"joined": Observed(seq_concat(older, younger))}, {}, {})
for (a in [[], [1], [0, 2]]):
  for (b in [[], [3]]):
    check: step_spec(joined, {}, {"older": a, "younger": b}).outputs["joined"] ~is a ++ b
check: seq_concat(older, literal(SpecSeq(SpecBool(), 1), [])) ~throws "element type mismatch"
solver.check_concat(spec_snapshot(joined))

// One symbolic flag controls whether each partial operation is executed.
def flag = SpecBool()
def seq = SpecSeq(flag, 1)
def gate = input_ref("gate", flag)
def empty = literal(seq, [])
def full = literal(seq, [#true])
def bad = seq_front(empty)
fun guarded(output, event, update):
  spec_snapshot(make_spec({"gate": flag}, {"q": seq}, {"q": []},
                          {"out": output}, {"ev": event}, {"q": update}))

def off = Observed(bad, literal(flag, #false))
solver.check_guard(guarded(Observed(bad, gate), off, empty))
solver.check_guard(guarded(off, Observed(bool_and(gate, bad)), empty))
solver.check_guard(guarded(off, off, choose_if(gate, seq_tail(empty), full)))
solver.check_guard(guarded(off, off, choose_if(gate, seq_append(full, gate), empty)))
solver.check_guard(guarded(Observed(gate, bool_and(gate, bad)), off, empty))

// A demanded uncared pin and a violated sampler domain are undefined, not excluded inputs.
def pin = input_ref("pin", flag)
def sample_inputs = {"gate": flag, "pin": flag}
def observe_pin = make_spec(sample_inputs, {}, {}, {}, {"ev": Observed(pin, gate)}, {})
def limit_domain = make_spec(sample_inputs, {}, {}, {}, {"ev": Observed(pin)}, {},
                             ~assumptions: {"outside": bool_not(gate)})
for ([source, output] in [[observe_pin, off], [limit_domain, Observed(gate)]]):
  def outputs = {"pin": output}
  def events = include_sampled_events(source, outputs, {})
  def model = make_spec({"gate": flag}, {}, {}, outputs, events, {})
  check:
    step_spec(model, {}, {"gate": #true}) ~throws "undefined event sample"
    step_spec(model, {}, {"gate": #false}).events ~is (if source === observe_pin | {} | {"ev": #false})
    include_sampled_events(source, outputs, {"ev": off}) ~throws "duplicate spec declaration"
  solver.check_guard(spec_snapshot(model))
