import:
  "../spec.rhm".step_spec
  "spec-helper.rhm".both as handshake
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("rhodium/frontend/tests/sync-composed.rhdl") as sync
  "spec-dsl-fixture.rhdl" as rtl
  "shift-queue-fixture.rhdl" as pairs
  "queue-pair.rspl" as views
  "../fifo-view.rhm".sample_fifo_events
  "../../../examples/formal/two-tag-rob.rspl" as rob_specs
  lib("rspecl/rtl-boundary.rhm").transaction_parts
  "../spec.rhm".Observed

// Check the actual pre-edge sampler independently of any particular RTL trace or queue state.
def pair_top = elaborate(pairs.QueuePair(1)).top
def tx = rob_specs.TwoTagROB(~transaction_view: #true)
def values(_, ref_monitor, _, _) = transaction_parts(tx)

// A false pin must not make the preservation premise false. The state relation
// has no sampled pin inputs; pins may appear only in edge checks and covers.
check:
  block:
    spec for rtl.ParamProbe:
      monitor:
        sample fun (_read, write): {"value": Observed(write("bad", Bool))}
        publish []
        batch sampled = present(value)
        state flag: Bool initially #true
        guarantee "ok" = #true
      refinement:
        fifo words from queue: Seq(Bool, 1)
        output (bad): Bool
        invariant hide_bad = !bad
        relate flag = empty(words)
    ParamProbe(~transaction_view: #true)
  ~throws "undeclared or mistyped spec reference: output.bad"

fun one_event(_read, write): {"item": Observed(write("bad", Bool))}
check:
  block:
    spec for rtl.ParamProbe:
      monitor:
        sample one_event
        publish []
        batch fire = present(absent)
        guarantee "ok" = fire
    ParamProbe(~transaction_view: #true)
  ~throws "unknown sampled event: absent"
check:
  block:
    spec for rtl.ParamProbe:
      monitor:
        sample one_event
        publish []
        batch fire = present(item)
        batch word: Bits(1) = payload(item) when fire
        guarantee "ok" = fire
    ParamProbe(~transaction_view: #true)
  ~throws "batch field type mismatch: word"
check:
  block:
    spec for rtl.ParamProbe:
      monitor:
        sample one_event
        publish []
        batch fire = present(item)
        batch flag: Bool = payload(item) when flag
        guarantee "ok" = fire
    ParamProbe(~transaction_view: #true)
  ~throws "payload requires a batch presence field: flag"
check:
  block:
    spec for rtl.ParamProbe:
      monitor:
        sample one_event
        publish []
        batch fire = present(item)
        batch unbound: Bool
        guarantee "ok" = fire
    ParamProbe(~transaction_view: #true)
  ~throws "bind every monitor batch field or none"

// The monitor has its own lexical scope. A refused batch must not evaluate tail(empty)
// or append(full), and must hold even scalar state that could otherwise advance.
def probe_monitor:
  spec for rtl.ParamProbe:
    monitor:
      sample fun (_read, write): {"sample": Observed(write("bad", Bool))}
      publish ["sample"]
      batch (take, value): Bool
      state q: Seq(Bool, 1) initially []
      state previous: Bool initially #true
      state older: Bool initially #false
      guarantee "can-take" = !take || !empty(q)
      guarantee "can-put" = take || !full(q)
      let accepted_value = handshake(!take, value)
      next q = select(take, tail(q), append(q, accepted_value))
      next previous = value
      next older = previous
    observe bad = #false
  def values(_, model, _, _) = transaction_parts(ParamProbe(elaborate(rtl.ParamProbe(0)).top, ~transaction_view: #true))
  model
fun probe_edge(old, take, value):
  step_spec(probe_monitor, old, {"take": take, "value": value})
def refused_empty = probe_edge(probe_monitor.initial, #true, #false)
def put = probe_edge(probe_monitor.initial, #false, #false)
def refused_full = probe_edge(put.next_state, #false, #true)
check:
  refused_empty.outputs ~is {"allowed": #false, "can-take": #false, "can-put": #true}
  refused_empty.next_state ~is probe_monitor.initial
  put.outputs ~is {"allowed": #true, "can-take": #true, "can-put": #true}
  put.next_state ~is {"q": [#false], "previous": #false, "older": #true}
  refused_full.outputs ~is {"allowed": #false, "can-take": #true, "can-put": #false}
  refused_full.next_state ~is put.next_state
  probe_edge(put.next_state, #true, #true).next_state ~is {"q": [], "previous": #true, "older": #false}
check:
  block:
    spec for rtl.ParamProbe:
      monitor:
        sample fun (_, _write): {}
        publish []
        batch word: Bits(1)
        guarantee "bad-sort" = word
      observe bad = #false
    ParamProbe(~transaction_view: #true)
  ~throws "expected a boolean expression"
check:
  ~eval
  import lib("rspecl/language.rhm").spec
  import lib("rhodium/formal/tests/spec-dsl-fixture.rhdl") as rtl
  spec for rtl.ParamProbe:
    monitor:
      guarantee "capacity" = #true
      guarantee "capacity" = #false
  ~throws "duplicate spec declaration: capacity"
check:
  ~eval
  import lib("rspecl/language.rhm").spec
  import lib("rhodium/formal/tests/spec-dsl-fixture.rhdl") as rtl
  spec for rtl.ParamProbe:
    monitor:
      guarantee "allowed" = #true
  ~throws "allowed is the combined monitor verdict"
check:
  ~eval
  import lib("rspecl/language.rhm").spec
  import lib("rhodium/formal/tests/spec-dsl-fixture.rhdl") as rtl
  spec for rtl.ParamProbe:
    monitor:
      sample sampler
      publish []
      guarantee "ok" = #true
      batch flag: Bool
      state flag: Bool initially #false
  ~throws "batch and state share a name: flag"
check:
  ~eval
  import lib("rspecl/language.rhm").spec
  import lib("rhodium/formal/tests/spec-dsl-fixture.rhdl") as rtl
  spec for rtl.ParamProbe:
    monitor:
      batch flag: Bool
      next flag = #true
  ~throws "next requires a declared state: flag"
check:
  ~eval
  import lib("rspecl/language.rhm").spec
  import lib("rhodium/formal/tests/spec-dsl-fixture.rhdl") as rtl
  spec for rtl.ParamProbe:
    monitor:
      assume precondition = #true
  ~throws "a monitor judges batches with guarantees, not assumptions"
check:
  rob_specs.TwoTagROB(pair_top, ~transaction_view: #true) ~throws "specialization of TwoTagROB"
check:
  block:
    spec for rtl.ParamProbe:
      transactions transaction_view(ref_monitor, ["sample"], fun (read, _write): {"sample": Observed(read("bad", Bool))})
      observe bad = #false
    ParamProbe(elaborate(rtl.ParamProbe(0)).top)
  ~throws "transaction pin direction or type mismatch: bad"
check:
  block:
    spec for rtl.ParamProbe:
      transactions transaction_view(ref_monitor, ["sample"], fun (_read, write): {"sample": Observed(write("bad", Bits(1)))})
      observe bad = #false
    ParamProbe(elaborate(rtl.ParamProbe(0)).top)
  ~throws "transaction pin direction or type mismatch: bad"
def pair_view = views.QueuePair(pair_top, ~event_view: #true)
check:
  views.QueuePair(pair_top) ~throws "passive-only spec"
  views.QueuePairSeries(pair_top, ~event_view: #true) ~throws "specialization of QueuePairSeries"
check:
  block:
    spec for pairs.QueuePair:
      events fun (top): pair_view
    QueuePair(elaborate(pairs.QueuePair(2)).top, ~event_view: #true)
  ~throws "event view does not match the elaborated top"
def flags = [0, 1]
for (rst in flags):
  for (offer in flags):
    for (ready in flags):
      for (valid in flags):
        for (consume in flags):
          def pins = {"reset": rst, "offer": offer, "ready": ready, "data": 0,
                      "valid": valid, "consume": consume, "head": 3}
          def accepted = if offer == 1 && ready == 1 | {"accepted": 0} | Map{}
          def retired = if valid == 1 && consume == 1 | {"retired": 3} | Map{}
          check:
            sample_fifo_events(pair_view, pins) ~is (if rst == 1 | {"reset": #true} | accepted ++ retired)

check:
  block:
    spec for pairs.QueuePair:
      events ready_valid_events(reset, rv_pins("ready", "offer", "data"), rv_pins("valid", "consume", "head"))
    QueuePair(pair_top, ~event_view: #true)
  ~throws "wrong FIFO pin name or direction"
check:
  block:
    spec for pairs.QueuePair:
      events ready_valid_events(reset, rv_pins("offer", "ready", "data"), rv_pins("valid", "offer", "head"))
    QueuePair(pair_top, ~event_view: #true)
  ~throws "distinct scalar handshake pins"
check:
  block:
    spec for pairs.QueuePair:
      events ready_valid_events(reset, rv_pins("data", "ready", "offer"), rv_pins("valid", "consume", "head"))
    QueuePair(pair_top, ~event_view: #true)
  ~throws "equal-width FIFO payload pins"
check:
  block:
    spec for pairs.QueuePair:
      observe ready = offer
      events ready_valid_events(reset, rv_pins("offer", "ready", "data"), rv_pins("valid", "consume", "head"))
    QueuePair(pair_top, ~event_view: #true)
  ~throws "undeclared or mistyped spec reference"

// Exercise visibility from a consumer, not just lexical lookup inside the defining module.
import "spec-exports-fixture.rspl" as api
check:
  step_spec(api.ParamProbe(elaborate(rtl.ParamProbe(0)).top), Map{}, Map{}).outputs ~is {"bad": #false}
  api.local_model(elaborate(rtl.Swap(2)).top).outputs["old"].value.type.width ~is 2
check:
  ~eval
  import lib("rhodium/formal/tests/spec-exports-fixture.rspl") as api
  api.private_value()
  ~throws "private_value: no such imported identifier"
check:
  ~eval
  import lib("rhodium/formal/tests/spec-exports-fixture.rspl") as api
  api.Swap
  ~throws "Swap: no such imported identifier"

// Outer bindings must not be shadowed by either spelling of a private keyword control.
def fault = #false
def _fault = #false
spec for rtl.ParamProbe:
  observe bad = fault || _fault
  event offset_sample = const(Bits(4), offset - seed) when enabled
  event disabled = #true when !enabled
fun sample_probe(top):
  step_spec(ParamProbe(top), Map{}, Map{})
def default_probe = sample_probe(elaborate(rtl.ParamProbe(-2)).top)
def enabled_probe = sample_probe(elaborate(rtl.ParamProbe(-2, ~gate: #true, ~fault: #true)).top)
check:
  default_probe.events ~is {"disabled": #true}
  enabled_probe.events ~is {"offset_sample": 1}
  enabled_probe.outputs ~is {"bad": #false}
  sample_probe(elaborate(rtl.ParamProbe(-2, ~amount: 4, ~gate: #true)).top).events ~is {"offset_sample": 6}
check:
  block:
    spec for rtl.ParamProbe:
      observe bad = extra
    ParamProbe(elaborate(rtl.ParamProbe(0)).top)
  ~throws "not an integer or Boolean RTL parameter: extra"

spec for sync.Echo:
  observe echo = payload when !reset
def echo_model = Echo(elaborate(sync.Echo(3)).top)
check:
  step_spec(echo_model, Map{}, {"payload": 6, "reset": #false}).outputs ~is {"echo": 6}
  step_spec(echo_model, Map{}, {"payload": 6, "reset": #true}).outputs ~is Map{}

def stalled = #false
spec for rtl.Qualified:
  fun accepted(ready): handshake(offered, ready)
  fun apply_to(f, pin): f(pin)
  def fired = apply_to(accepted, ready)
  output transfer = fired
  output offered_only = apply_to(accepted, offered)
  output prior = stalled
  let stalled = !fired
  output stalled_or_idle = stalled
  event transfer = offered when fired
def qualified = Qualified(elaborate(rtl.Qualified()).top)
for (a in [#false, #true]):
  for (b in [#false, #true]):
    def edge = step_spec(qualified, Map{}, {"offered": a, "ready": b})
    check:
      edge.outputs ~is {"transfer": a && b, "offered_only": a, "prior": #false, "stalled_or_idle": !(a && b)}
      edge.events ~is (if a && b | {"transfer": #true} | Map{})

check:
  (#false && error("not reached")) ~is #false
  (#true || error("not reached")) ~is #true

// A specialization chooses the type; a port is a separate lexical model value.
spec for rtl.Swap:
  def Word = Bits(word_width)
  state x: Word initially 2 as start_x
  state y: Word initially 0
  state held: Bool initially #true
  let active = width || enable && !held
  output old = x when active
  event old = y when active
  next x = select(active, y, start_x)
  next y = x

fun swap(width): Swap(elaborate(rtl.Swap(width)).top)
def m = swap(3)
def fire = step_spec(m, m.initial, {"width": #true, "enable": #true})
def idle = step_spec(m, fire.next_state, {"width": #false, "enable": #true})
check:
  fire.outputs ~is {"old": 2}
  fire.events ~is {"old": 0}
  fire.next_state ~is {"x": 0, "y": 2, "held": #true}
  idle.outputs ~is Map{}
  idle.events ~is Map{}
  idle.next_state ~is m.initial
  swap(1) ~throws "does not fit"
  swap(0) ~throws "PosInt"

spec for rtl.LazyView:
  state q: Seq(Bool, 1) initially []
  output present_false = !empty(q) && front(q)
  output present_true = empty(q) || front(q)
  event payload = front(q) when !empty(q)
def lazy_view = LazyView(elaborate(rtl.LazyView()).top)
check:
  step_spec(lazy_view, lazy_view.initial, Map{}).outputs ~is {"present_false": #false, "present_true": #true}
  step_spec(lazy_view, lazy_view.initial, Map{}).events ~is Map{}

check:
  ~eval
  import lib("rspecl/language.rhm").spec
  import lib("rhodium/formal/tests/spec-dsl-fixture.rhdl") as rtl
  spec for rtl.Swap:
    input width: Bool
  ~throws "inputs come from the RTL declaration"

check:
  ~eval
  import lib("rspecl/language.rhm").spec
  import lib("rhodium/formal/tests/spec-dsl-fixture.rhdl") as rtl
  spec for rtl.Swap:
    observe old = width
    observe old = width
  ~throws "duplicate spec declaration: old"

check:
  ~eval
  import lib("rspecl/language.rhm").spec
  import lib("rhodium/formal/tests/spec-dsl-fixture.rhdl") as rtl
  spec for rtl.Swap:
    state s: Bool initially #true
    next s = #false
    next s = #true
  ~throws "duplicate spec declaration: s"

check:
  ~eval
  import lib("rspecl/language.rhm").spec
  import lib("rhodium/formal/tests/spec-dsl-fixture.rhdl") as rtl
  spec for rtl.Swap:
    next width = #true
  ~throws "next requires a declared state"

check:
  ~eval
  import lib("rspecl/language.rhm").spec
  import lib("rhodium/formal/tests/spec-dsl-fixture.rhdl") as rtl
  import lib("rhodium/frontend/foundation.rhm").elaborate
  spec for rtl.Swap:
    observe old = missing when #false
  Swap(elaborate(rtl.Swap(3)).top)
  ~throws "missing"

check:
  block:
    spec for sync.Echo:
      observe echo = payload when payload
    Echo(elaborate(sync.Echo(1)).top)
  ~throws "boolean"

check:
  block:
    spec for sync.Echo:
      observe echo = handshake
    Echo(elaborate(sync.Echo(1)).top)
  ~throws "SpecExpr"
