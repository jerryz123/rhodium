import:
  "../../../examples/formal/arbiter-queue.rspl".ArbiterQueue
  "../../../examples/formal/gated-arbiter-queue.rspl".GatedArbiterQueue
  "../../../examples/formal/arbiter.rspl".Arbiter
  "../../../examples/formal/shift-queue.rspl".ShiftQueue
  lib("examples/formal/arbiter-queue.rhdl") as design
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("rhodium/frontend/layers/bool.rhm").Bool
  "../wiring.rhm" open
  "../spec.rhm" open
  "../snapshot.rhm".formal_snapshot
  "composition-binding.rhm" open
  "arbiter-queue-fixture.rhdl".SeparateReset
export gated_case gated_replay
export buffered_cut separate_reset_cut
export ordering_case correct_model wrong_lane_model undersized_model
export alternate_cut swapped_view_cut fresh_cut
export undersized_rtl correct_rtl one_slot_rtl depth_two_contract

fun bindings(depth):
  Map.by(===){arbiter_definition: Arbiter(arbiter_definition),
              fifo_at(depth): ShiftQueue(fifo_at(depth))}
fun wiring(top, depth):
  bind_wiring(top, bindings(depth), Bool, interface_prefixes)
def correct_model = wiring(mixed, 2)
def wrong_lane_model = wiring(wrong_lane, 2)
def undersized_model = wiring(undersized, 1)
fun ordering_case(depth):
  def top = parent_at(depth)
  fun candidate(parent):
    def values(children, _) = wiring_cut(parent, interface_prefixes)
    def values(arb, fifo) = leaf_sites(children)
    PairList[proof_cut(parent, bindings(depth), Bool, interface_prefixes), arb, fifo]
  values(candidate(top), ArbiterQueue(top), candidate(wrong_lane_at(depth)))

fun separate_reset_cut():
  def top = elaborate(SeparateReset()).top
  def values(children, _) = wiring_cut(top, interface_prefixes)
  def child = children["storage"]
  proof_cut(top, Map.by(===){child: ShiftQueue(child)}, Bool, interface_prefixes)

fun gated_case(depth):
  def child = parent_at(depth)
  def models = Map.by(===){child: ArbiterQueue(child)}
  fun candidate(top): proof_cut(top, models, Bool, interface_prefixes)
  values(candidate(gated_at(depth)), GatedArbiterQueue(gated_at(depth)), candidate(leaky_at(depth)))

fun gated_replay(depth, leaky):
  replay_rtl(if leaky | leaky_at(depth) | gated_at(depth))

fun buffered_cut(depth):
  def parent = parent_at(depth)
  def tail = fifo_at(1)
  def models = Map.by(===){parent: ArbiterQueue(parent), tail: ShiftQueue(tail)}
  proof_cut(outer_at(depth), models, Bool, interface_prefixes)

// Same implementation and transition function, but change either the reset state or event view.
fun alternate_cut(change_start):
  def fifo = ShiftQueue(fifo_definition)
  def initial = if change_start | {"q": [0]} | fifo.initial
  def events = if change_start | fifo.events | fifo.events.remove("enqueue")
  def alternate = make_spec(fifo.inputs, fifo.state, initial, fifo.outputs, events, fifo.updates)
  proof_cut(mixed, Map.by(===){arbiter_definition: Arbiter(arbiter_definition), fifo_definition: alternate},
            Bool, interface_prefixes)

// Logical names and types still match, but this observer interchanges the two physical lanes.
fun swapped_view_cut():
  def swap = {"ingress[0]": "ingress[1]", "ingress[1]": "ingress[0]"}
  fun prefixes(top):
    def original = interface_prefixes(top)
    if top === arbiter_definition
    | for Map ((pin, name) in original): values(pin, swap.get(name, name))
    | original
  proof_cut(mixed, bindings(2), Bool, prefixes)

// Even byte-for-byte identical contracts in a fresh elaboration are not this run's proved definitions.
fun fresh_cut():
  def top = elaborate(design.ArbiterQueue(2)).top
  def values(children, _) = wiring_cut(top, interface_prefixes)
  def values(a, f) = leaf_sites(children)
  def models = Map.by(===){children[a]: Arbiter(children[a]), children[f]: ShiftQueue(children[f])}
  proof_cut(top, models, Bool, interface_prefixes)

// Lazily snapshot complete hardware only for the depth-fault replay, never for substitution.
fun replay_rtl(top):
  def PairList[inputs, outputs] = pin_layout(top)
  values(formal_snapshot(top), inputs, outputs)
fun undersized_rtl(): replay_rtl(undersized)
fun correct_rtl(): replay_rtl(mixed)
fun one_slot_rtl(): replay_rtl(parent_at(1))
def depth_two_contract = spec_snapshot(ArbiterQueue(parent_at(2)))
