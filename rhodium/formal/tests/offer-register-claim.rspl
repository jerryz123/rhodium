#lang rspecl
// SPDX-License-Identifier: Apache-2.0

import lib("flow/offer-register.rhdl") as rtl
import lib("rhodium/frontend/foundation.rhm") as hw
import lib("examples/formal/offer-register.rspl") as correct
import lib("examples/formal/stalled-offer.rspl") as protocol
import "../spec.rhm".step_spec

// Challenge the same certified cycle model with the same egress guarantee that ShiftQueue meets.
spec for rtl.OfferRegister:
  transactions protocol.stable_offer(protocol.egress_sample)
  refinement:
    adjacent_samples from correct.OfferRegister

fun offer_at(width :: PosInt): hw.elaborate(rtl.OfferRegister(hw.Bits(width))).top
def dut = offer_at(2)
def cycle = correct.OfferRegister(dut)
fun cycle_row(old, inputs):
  def edge = step_spec(cycle, (if old | old | cycle.initial), inputs)
  values(edge.outputs, edge.events, edge.next_state)
export dut offer_at cycle_row
