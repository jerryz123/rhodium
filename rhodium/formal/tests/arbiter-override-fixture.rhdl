#lang rhodium
// SPDX-License-Identifier: Apache-2.0

import:
  lib("flow/arbiter.rhdl").Arbiter
  lib("rhodium/std/ready-valid.rhdl") open

// Swap the two physical lanes, including the reported grant index.
circuit ReversedArbiter():
  interface ingress[2](Decoupled(Bits(2)), ~role: consumer)
  interface egress(Decoupled(Bits(2)), ~role: producer)
  output chosen: Bits(1)
  inst dut(Arbiter(Bits(2), 2))
  dut.ingress[0].valid <== ingress[1].valid
  dut.ingress[0].bits <== ingress[1].bits
  ingress[1].ready <== dut.ingress[0].ready
  dut.ingress[1].valid <== ingress[0].valid
  dut.ingress[1].bits <== ingress[0].bits
  ingress[0].ready <== dut.ingress[1].ready
  egress.valid <== dut.egress.valid
  egress.bits <== dut.egress.bits
  dut.egress.ready <== egress.ready
  chosen <== Bits(1)(1) - dut.chosen

export ReversedArbiter
