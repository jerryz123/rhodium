#lang rhombus
// SPDX-License-Identifier: Apache-2.0

import:
  lib("examples/formal/granted-selector.rspl") open
  lib("examples/formal/gated-capture.rspl") open
  lib("examples/formal/arbiter.rspl").Arbiter
  lib("rhodium/frontend/layers/bool.rhm").Bool
  "composition-binding.rhm" open
  "../wiring.rhm".proof_cut
  "../wiring.rhm".bind_wiring
  "../spec.rhm" open

export selector interface_prefixes leaf parent cut without_assumption impossible replay replay_wiring
export high_grant conditional circular_cut
export router router_spec routed_parent routed_cut replay_routed
export registered_lane registered_spec registered_key registered_parent registered_cut registered_variant registered_trace
export gate_spec capture_spec gate_cut capture_cut gate_variant capture_trace
def leaf = LaneSelector(selector)
def parent = GrantedSelector(granted_selector)
def router_spec = LaneRouter(router)
def routed_parent = RoutedSelector(routed_selector)
def registered_spec = RegisteredLaneSelector(registered_lane)
def registered_key = registered_lane.name ++ ".captured"
def registered_parent = RegisteredRoutedSelector(registered_routed)
def gate_spec = GatedCapture(capture_gate)
def capture_spec = ArbitratedCapture(arbitrated_capture)
fun with_assumptions(predicates):
  make_spec(leaf.inputs, leaf.state, leaf.initial, leaf.outputs, leaf.events, leaf.updates,
            ~assumptions: predicates)
def without_assumption = with_assumptions({})
def impossible = with_assumptions(leaf.assumptions ++ {"both": bool_not(leaf.assumptions["exclusive"])})
fun bindings(model): Map.by(===){selector: model, arbiter_definition: Arbiter(arbiter_definition)}
fun cut(raw, model):
  proof_cut(if raw | raw_selector | granted_selector, bindings(model), Bool, interface_prefixes)
fun replay_wiring(raw, inputs):
  def graph = bind_wiring(if raw | raw_selector | granted_selector, bindings(leaf), Bool, interface_prefixes)
  step_spec(graph, graph.initial, inputs).outputs["selected"]
fun routed_graph(build, duplicate, registered = #false):
  def top:
    if registered
    | (if duplicate | registered_duplicate | registered_routed)
    | (if duplicate | duplicate_grant | routed_selector)
  def lanes = if registered | registered_lane | selector
  def models = Map.by(===){arbiter_definition: Arbiter(arbiter_definition), router: router_spec,
                           lanes: (if registered | registered_spec | leaf)}
  build(top, models, Bool, interface_prefixes)
fun routed_cut(duplicate): routed_graph(proof_cut, duplicate)
fun replay_routed(duplicate, inputs):
  def graph = routed_graph(bind_wiring, duplicate)
  step_spec(graph, graph.initial, inputs).outputs["selected"]
fun registered_cut(duplicate): routed_graph(proof_cut, duplicate, #true)
fun phase_variant(s, mode):
  def reset = input_ref("reset", SpecBool())
  def assumptions:
    match mode
    | "only-reset": s.assumptions ++ {"phase": reset}
    | "never-reset": s.assumptions ++ {"phase": bool_not(reset)}
    | "unrestricted": {}
  make_spec(s.inputs, s.state, s.initial, s.outputs, s.events, s.updates, ~assumptions: assumptions)
fun registered_variant(mode): phase_variant(registered_spec, mode)
fun gate_variant(mode): phase_variant(gate_spec, mode)
fun gate_cut():
  proof_cut(capture_gate, Map.by(===){registered_lane: registered_spec}, Bool, interface_prefixes)
fun capture_graph(build, raw, gate):
  def models = Map.by(===){capture_gate: gate, arbiter_definition: Arbiter(arbiter_definition)}
  build(if raw | raw_capture | arbitrated_capture, models, Bool, interface_prefixes)
fun capture_cut(raw, gate = gate_spec): capture_graph(proof_cut, raw, gate)
fun capture_trace(raw, samples): selected_trace(capture_graph(bind_wiring, raw, gate_spec), samples)
fun registered_trace(duplicate, samples): selected_trace(routed_graph(bind_wiring, duplicate, #true), samples)
fun selected_trace(graph, samples):
  def mutable state = graph.initial
  for PairList (sample in samples):
    def edge = step_spec(graph, state, sample)
    state := edge.next_state
    edge.outputs.get("selected", #false)
fun replay(a, b):
  step_spec(leaf, {}, {"enable_a": a, "enable_b": b, "word_a": 1, "word_b": 2}).outputs["selected"]

// Each output is specified as high only under its own input contract. The offer
// schedule is acyclic, but using those promises to prove one another would be circular.
def flag = SpecBool()
def conditional = make_spec({"enable": flag}, {}, {}, {"grant": Observed(literal(flag, #true))}, {}, {},
                            ~assumptions: {"enabled": input_ref("enable", flag)})
fun circular_cut():
  proof_cut(circular_grants, Map.by(===){high_grant: conditional}, Bool, interface_prefixes)
