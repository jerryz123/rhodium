#lang rhodium
// SPDX-License-Identifier: Apache-2.0

import lib("flow/main.rhdl") open
import lib("examples/formal/arbiter-queue.rhdl").ArbiterQueue

// Acknowledge the actual winner, but enqueue lane one's payload even when lane zero wins.
sync_circuit WrongLane(width :: PosInt, depth :: PosInt):
  interface ingress[2](Decoupled(Bits(width)), ~role: consumer)
  interface egress(Irrevocable(Bits(width)), ~role: producer)
  def winner = ingress |> arbiter()
  inst storage(ShiftQueue(Bits(width), depth))
  storage.ingress.valid <== winner.valid
  storage.ingress.bits <== ingress[1].bits
  winner.ready <== storage.ingress.ready
  storage.egress |> egress

// Deliberately too small for the depth-two reference contract.
sync_circuit Undersized(width :: PosInt):
  interface ingress[2](Decoupled(Bits(width)), ~role: consumer)
  interface egress(Irrevocable(Bits(width)), ~role: producer)
  ingress |> arbiter() |> shift_queue(1) |> egress

// A direct wire, but a different reset epoch: child evidence cannot establish parent reset.
circuit SeparateReset():
  input clock: Clock
  input reset: Reset
  input child_reset: Reset
  interface ingress(Decoupled(Bits(2)), ~role: consumer)
  interface egress(Irrevocable(Bits(2)), ~role: producer)
  inst storage(ShiftQueue(Bits(2), 1), ~clock: clock, ~reset: child_reset)
  ingress |> storage.ingress
  storage.egress |> egress

// Hide the grant when closed but leave valid connected, creating a privately accepted word.
sync_circuit LeakyGate(width :: PosInt, ~depth: depth :: PosInt = 2):
  input enable: Bool
  interface ingress[2](Decoupled(Bits(width)), ~role: consumer)
  interface egress(Irrevocable(Bits(width)), ~role: producer)

  reg gate_open(~init: Bool(#false))
  gate_open <== enable
  inst queue(ArbiterQueue(width, ~depth: depth))
  for (i in 0..2):
    queue.ingress[i].valid <== ingress[i].valid
    queue.ingress[i].bits <== ingress[i].bits
    ingress[i].ready <== gate_open & queue.ingress[i].ready

  queue.egress |> egress

// The state is legal RTL but its independent reset cannot establish the proof's reset epoch.
circuit SeparateRegisterReset():
  input clock: Clock
  input reset: Reset
  input local_reset: Reset
  input enable: Bool
  output admitted: Bool
  reg held(~clock: clock, ~reset: local_reset, ~init: Bool(#false))
  held <== enable
  admitted <== held

// Keep both actual child specializations; change exactly one width-correct driver in each variant.
sync_circuit FaultyBuffered(~cross_payload: _cross_payload :: Boolean):
  interface ingress[2](Decoupled(Bits(2)), ~role: consumer)
  interface egress(Irrevocable(Bits(2)), ~role: producer)
  inst front(ArbiterQueue(2, ~depth: 2))
  inst tail_fifo(ShiftQueue(Bits(2), 1))
  for (i in 0..2):
    ingress[i].ready <== front.ingress[i].ready
    front.ingress[i].valid <== ingress[i].valid
    front.ingress[i].bits <== ingress[if _cross_payload && i == 0 | 1 | i].bits
  tail_fifo.ingress.valid <== front.egress.valid
  tail_fifo.ingress.bits <== front.egress.bits
  front.egress.ready <== (if _cross_payload | tail_fifo.ingress.ready | egress.ready)
  tail_fifo.egress |> egress

export SeparateRegisterReset LeakyGate WrongLane Undersized SeparateReset FaultyBuffered
