#lang rhombus
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus.bits.(?) as ?
  lib("examples/formal/two-tag-rob.rhdl") as rtl
  lib("examples/formal/logged-two-tag-rob.rhdl") as logged_rtl
  "../../../examples/formal/two-tag-rob.rspl".TwoTagROB
  "../../../examples/formal/logged-two-tag-rob.rspl".LoggedTwoTagROB
  lib("rspecl/rtl-boundary.rhm").transaction_parts
  lib("rspecl/rtl-boundary.rhm").transaction_batch_model
  "rob-sampler-fixture.rhm".dropped_generation
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../spec.rhm".step_spec

def top = elaborate(rtl.TwoTagROB()).top
def rob = TwoTagROB(top)
def view = TwoTagROB(top, ~transaction_view: #true)
def values(sampler, monitor, _, _) = transaction_parts(view)
def batch = transaction_batch_model(view)

// Execute the same public recorder monitor independently of the proof, including tag A (false).
def logged_top = elaborate(logged_rtl.LoggedTwoTagROB()).top
def logged_view = LoggedTwoTagROB(logged_top, ~transaction_view: #true)
def values(_, recorder, _, _) = transaction_parts(logged_view)
def recorder_batch = transaction_batch_model(logged_view)
def offer = {"reset": #false, "retire.valid": #true, "retire.ready": #false,
             "retire.bits": #false, "retire_result": 3,
             "has_commit": #false, "last_tag": #true, "last_payload": 1}
fun record_edge(old, pins):
  step_spec(recorder, old, step_spec(recorder_batch, {}, offer ++ pins).outputs)
def stall = record_edge(recorder.initial, {})
def capture = record_edge(stall.next_state, {"retire.ready": #true})
def recorded = {"has_commit": #true, "last_tag": #false, "last_payload": 3}
check:
  LoggedTwoTagROB(logged_top) ~throws "monitor-only spec"
  stall.outputs["allowed"] ~is #true
  stall.next_state ~is recorder.initial
  capture.next_state ~is {"occupied": #true, "tag": #false, "data": 3}
  record_edge(capture.next_state, recorded).outputs["allowed"] ~is #true
  record_edge(capture.next_state, recorded).next_state ~is capture.next_state
  record_edge(capture.next_state, recorded ++ {"last_payload": 1}).outputs["allowed"] ~is #false
  record_edge(capture.next_state, recorded ++ {"reset": #true}).next_state["occupied"] ~is #false

def sample = {"reset": #false, "grant_a": #false, "grant_b": #true, "issue_gen": #false,
              "retire.ready": #true, "retire.valid": #true, "retire.bits": #false, "retire_result": 3,
              "complete_a": #true, "complete_gen_a": #true, "result_a": 2,
              "complete_b": #true, "complete_gen_b": #false, "result_b": 0}
def pulses = {"echo_a": #true, "data_a": 2, "echo_b": #false, "data_b": 0}
def granted = {"issued": #true, "issued_gen": #false}
fun sampled(changes): step_spec(sampler, {}, sample ++ changes).events
check:
  sampled({}) ~is pulses ++ granted ++ {"retired": #false, "retired_value": 3}
  sampled({"retire.ready": #false}) ~is pulses ++ granted
  sampled({"reset": #true}) ~is {"reset": #true}

// A grant of A and a first-generation token both carry false. They still allocate a live tag.
def a_only = sample ++ {"grant_a": #true, "grant_b": #false, "retire.ready": #false,
                        "complete_a": #false, "complete_b": #false}
def a_batch = step_spec(batch, {}, a_only).outputs
def history = step_spec(monitor, monitor.initial, a_batch)
check:
  a_batch["grant"] ~is #true
  a_batch["grant_tag"] ~is #false
  a_batch["grant_gen"] ~is #false
  history.outputs["allowed"] ~is #true
  history.next_state["order"] ~is [#false]
  step_spec(dropped_generation, {}, a_only) ~throws "undefined event sample: grant_gen"
  step_spec(dropped_generation, {}, sample).outputs ~is step_spec(batch, {}, sample).outputs
  step_spec(batch, {}, sample ++ {"reset": #true}).outputs["grant"] ~is #false
def mutable cases = 0
// Use integer allocation serials. Store the full serial on each live entry and compare only
// its low bit at the wire boundary, independently of the RTL's retirement-driven toggles.
fun check_edge(rows, mask, serials, echoes):
  def reset = mask ? 0
  def request = [mask ? 1, mask ? 2]
  def pulse = [mask ? 3, mask ? 4]
  def ready = mask ? 5
  def incoming = [if ready | 1 | 0, if request[0] | 2 | 3]
  fun index(tag): if tag | 1 | 0
  def entries = rows.map(fun (r): r ++ [serials[index(r[0])] - 1])
  fun state(rows, counts):
    def finished = rows.filter(~keep: fun (r): r[1]).map(fun (r): r[0])
    fun payload(tag):
      def matches = rows.filter(~keep: fun (r): r[0] == tag && r[1])
      if matches.length() == 0 | 0 | matches[0][2]
    {"next_gen_a": counts[0] ? 0, "next_gen_b": counts[1] ? 0,
     "value_a": payload(#false), "value_b": payload(#true), "history": rows.map(fun (r): r[0]), "finished_a": #false in finished, "finished_b": #true in finished}
  def old = state(entries, serials)
  def eligible = [#false,#true].filter(~keep: fun (tag): request[index(tag)] && !(tag in old["history"]))
  def issued = if eligible.length() == 0 | [] | [eligible[0]]
  def a = #false in issued
  def b = #true in issued
  def valid = entries.length() > 0 && entries[0][1]
  def pop = valid && ready
  def remain = if pop | entries.drop(1) | entries
  def after = for List (row in remain):
    def i = index(row[0])
    if !row[1] && pulse[i] && echoes[i] == (row[3] ? 0) | [row[0], #true, incoming[i], row[3]] | row
  def expected = if reset | [] | after ++ issued.map(fun (tag): [tag, #false, 0, serials[index(tag)]])
  def counts = if reset | [0,0] | [serials[0] + (if a | 1 | 0), serials[1] + (if b | 1 | 0)]
  def input = {"reset": reset, "issue_a": request[0], "issue_b": request[1],
               "complete_gen_a": echoes[0], "complete_gen_b": echoes[1],
               "result_a": incoming[0], "result_b": incoming[1], "complete_a": pulse[0], "complete_b": pulse[1], "retire.ready": ready}
  def result = step_spec(rob, old, input)
  def offers = {"grant_a": a, "grant_b": b, "retire.valid": valid}
  def data = if valid | {"retire.bits": entries[0][0], "retire_result": entries[0][2]} | {}
  def issued_bit = serials[index(b)] ? 0
  def issue_pin = if a || b | {"issue_gen": issued_bit} | {}
  def push_event = if a || b | {"issued": b, "issued_gen": issued_bit} | {}
  def pop_event = if pop | {"retired": entries[0][0], "retired_value": entries[0][2]} | {}
  check:
    result.outputs ~is (if reset | {} | offers ++ data ++ issue_pin)
    result.events ~is (if reset | {} | push_event ++ pop_event)
    result.next_state ~is state(expected, counts)
  cases := cases + 1

fun exercise(rows):
  for (mask in 0..64):
    check_edge(rows, mask, [if mask ? 1 | 2 | 3, if mask ? 2 | 4 | 5], [mask ? 5, mask ? 3])
exercise([])
// For each tag, the five owned-result states are pending or completed with 0..3.
fun entries(tag): [[tag, #false, 0]] ++ (for List (v in 0..4): [tag, #true, v])
for (tag in [#false,#true]):
  for (old in entries(tag)):
    exercise([old])
    for (young in entries(!tag)): exercise([old, young])
// Cross both parities and both echoes independently, especially when both pulses arrive together.
for (n in 0..16):
  for (mask in 0..64):
    check_edge([[#false,#false,0],[#true,#false,0]], mask,
               [if n ? 0 | 3 | 2, if n ? 1 | 5 | 4], [n ? 2, n ? 3])
check: cases ~is 4928
