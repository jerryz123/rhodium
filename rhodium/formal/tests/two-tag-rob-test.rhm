#lang rhombus
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus.bits.(?) as ?
  lib("examples/formal/two-tag-rob.rhdl") as rtl
  "../../../examples/formal/two-tag-rob.rspl".TwoTagROB
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../spec.rhm".step_spec

def rob = TwoTagROB(elaborate(rtl.TwoTagROB()).top)
def mutable cases = 0
// The oracle stores completion on each ordered entry (tag, done), not in a per-tag scoreboard.
fun check_edge(entries, mask):
  def reset = mask ? 0
  def request = [mask ? 1, mask ? 2]
  def pulse = [mask ? 3, mask ? 4]
  def ready = mask ? 5
  fun index(tag): if tag | 1 | 0
  fun state(rows):
    def finished = rows.filter(~keep: fun (r): r[1]).map(fun (r): r[0])
    {"history": rows.map(fun (r): r[0]), "finished_a": #false in finished, "finished_b": #true in finished}
  def old = state(entries)
  def eligible = [#false,#true].filter(~keep: fun (tag): request[index(tag)] && !(tag in old["history"]))
  def issued = if eligible.length() == 0 | [] | [eligible[0]]
  def a = #false in issued
  def b = #true in issued
  def valid = entries.length() > 0 && entries[0][1]
  def pop = valid && ready
  def remain = if pop | entries.drop(1) | entries
  def after = for List (row in remain): [row[0], row[1] || pulse[index(row[0])]]
  def expected = if reset | [] | after ++ issued.map(fun (tag): [tag, #false])
  def input = {"reset": reset, "issue_a": request[0], "issue_b": request[1],
               "complete_a": pulse[0], "complete_b": pulse[1], "retire.ready": ready}
  def result = step_spec(rob, old, input)
  def offers = {"grant_a": a, "grant_b": b, "retire.valid": valid}
  def data = if valid | {"retire.bits": entries[0][0]} | {}
  def push_event = if a || b | {"issued": b} | {}
  def pop_event = if pop | {"retired": entries[0][0]} | {}
  check:
    result.outputs ~is (if reset | {} | offers ++ data)
    result.events ~is (if reset | {} | push_event ++ pop_event)
    result.next_state ~is state(expected)
  cases := cases + 1

fun exercise(rows):
  for (mask in 0..64): check_edge(rows, mask)
exercise([])
for (tag in [#false,#true]):
  for (done in [#false,#true]):
    exercise([[tag,done]])
    for (younger in [#false,#true]): exercise([[tag,done],[!tag,younger]])
check: cases ~is 832
