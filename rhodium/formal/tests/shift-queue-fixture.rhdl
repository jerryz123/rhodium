#lang rhodium
// SPDX-License-Identifier: Apache-2.0

import lib("flow/shift-queue.rhdl").ShiftQueue
import lib("examples/formal/queue-pair.rhdl").QueuePair

// Same sampled signature as GuardedAssertion, but a distinct declaration.
sync_circuit GroupedProbe():
  input (enabled, condition): Bool
  #void

sync_circuit GuardedAssertion():
  input enabled: Bool
  input condition: Bool
  when enabled:
    assert(condition, "sampled")

// Three same-width miswirings and a transfer-preserving control, separate from the example RTL.
sync_circuit FaultyQueuePair(depth :: PosInt, _fault :: String):
  input offer: Bool
  input data: Bits(2)
  input consume: Bool
  output ready: Bool
  output valid: Bool
  output head: Bits(2)

  inst a(ShiftQueue(Bits(2), depth))
  inst b(ShiftQueue(Bits(2), depth))
  a.ingress.valid <== offer
  a.ingress.bits <== data
  def handoff_ready:
    match _fault
    | "ready": consume
    | "valid-gated": b.ingress.ready & a.egress.valid
    | ~else: b.ingress.ready
  a.egress.ready <== handoff_ready
  b.ingress.valid <== a.egress.valid
  b.ingress.bits <== (if _fault == "payload" | data | a.egress.bits)
  b.egress.ready <== consume
  ready <== a.ingress.ready
  valid <== b.egress.valid
  head <== (if _fault == "mask" | b.mask | b.egress.bits)

// The middle ready is incorrectly driven by the external consumer.
sync_circuit WrongReadySeries():
  input offer: Bool
  input data: Bits(2)
  input consume: Bool
  output ready: Bool
  output valid: Bool
  output head: Bits(2)

  inst front(QueuePair(1))
  inst back(QueuePair(2))
  front.offer <== offer
  front.data <== data
  ready <== front.ready

  back.offer <== front.valid
  back.data <== front.head
  front.consume <== consume

  back.consume <== consume
  valid <== back.valid
  head <== back.head

// Uses a real diagnostic pin that the public FIFO contract deliberately does not model.
sync_circuit DiagnosticTap():
  input offer: Bool
  input data: Bits(2)
  input consume: Bool
  output mask: Bits(2)
  inst fifo(ShiftQueue(Bits(2), 2))
  fifo.ingress.valid <== offer
  fifo.ingress.bits <== data
  fifo.egress.ready <== consume
  mask <== fifo.mask

// A parent that transforms a signal is not a wiring-only cut.
sync_circuit InvertingParent():
  input enable: Bool
  output inverted: Bool
  inverted <== !enable

export InvertingParent GroupedProbe GuardedAssertion QueuePair FaultyQueuePair WrongReadySeries DiagnosticTap
