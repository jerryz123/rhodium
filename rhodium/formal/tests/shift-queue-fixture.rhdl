#lang rhodium
// SPDX-License-Identifier: Apache-2.0

import lib("flow/shift-queue.rhdl").ShiftQueue

// Same sampled signature as GuardedAssertion, but a distinct declaration.
sync_circuit GroupedProbe():
  input (enabled, condition): Bool
  #void

sync_circuit GuardedAssertion():
  input enabled: Bool
  input condition: Bool
  when enabled:
    assert(condition, "sampled")

// Only the verified ready/valid cycle interface crosses each child boundary.
sync_circuit QueuePair(depth :: PosInt = 2):
  input offer: Bool
  input data: Bits(2)
  input consume: Bool
  output ready: Bool
  output valid: Bool
  output head: Bits(2)

  inst a(ShiftQueue(Bits(2), depth))
  inst b(ShiftQueue(Bits(2), depth))
  a.ingress.valid <== offer
  a.ingress.bits <== data
  a.egress.ready <== b.ingress.ready
  b.ingress.valid <== a.egress.valid
  b.ingress.bits <== a.egress.bits
  b.egress.ready <== consume
  ready <== a.ingress.ready
  valid <== b.egress.valid
  head <== b.egress.bits

// A pure wire between two independently certified transaction endpoints.
sync_circuit QueuePairSeries(~wrong_ready: _wrong_ready :: Boolean = #false):
  input offer: Bool
  input data: Bits(2)
  input consume: Bool
  output ready: Bool
  output valid: Bool
  output head: Bits(2)

  inst front(QueuePair(1))
  inst back(QueuePair(2))
  front.offer <== offer
  front.data <== data
  ready <== front.ready

  back.offer <== front.valid
  back.data <== front.head
  front.consume <== (if _wrong_ready | consume | back.ready)

  back.consume <== consume
  valid <== back.valid
  head <== back.head

// Uses a real diagnostic pin that the public FIFO contract deliberately does not model.
sync_circuit DiagnosticTap():
  input offer: Bool
  input data: Bits(2)
  input consume: Bool
  output mask: Bits(2)
  inst fifo(ShiftQueue(Bits(2), 2))
  fifo.ingress.valid <== offer
  fifo.ingress.bits <== data
  fifo.egress.ready <== consume
  mask <== fifo.mask

// A parent that transforms a signal is not a wiring-only cut.
sync_circuit InvertingParent():
  input enable: Bool
  output inverted: Bool
  inverted <== !enable

export InvertingParent GroupedProbe GuardedAssertion QueuePair QueuePairSeries DiagnosticTap
