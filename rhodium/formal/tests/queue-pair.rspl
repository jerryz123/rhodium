import "shift-queue-fixture.rhdl" as rtl
import lib("examples/formal/queue-pair-series.rhdl") as series
import lib("rspecl/fifo.rspl") open
import lib("examples/formal/shift-queue.rspl").ShiftQueue
import lib("examples/formal/queue-pair.rspl").QueuePair
export QueuePair

fun pair_events(reset):
  ready_valid_events(reset, rv_pins("offer", "ready", "data"), rv_pins("valid", "consume", "head"))

spec for rtl.FaultyQueuePair:
  events pair_events(reset)

spec for rtl.WrongReadySeries:
  events pair_events(reset)

// Exchange capacities or reverse history order without changing the total history sort.
fun candidate_series(~swap: swap :: Boolean = #false, ~reverse: reverse :: Boolean = #false):
  spec for series.QueuePairSeries:
    def front_capacity = 2 * (if swap | back_depth | front_depth)
    def back_capacity = 2 * (if swap | front_depth | back_depth)
    def handshakes = pair_events(reset)
    events transfers = handshakes
    transactions fifo_monitor(front_capacity + back_capacity, data.type.width, transfers)
    refinement:
      child front: fifo_contract(front_capacity, data.type.width, handshakes)
      child back: fifo_contract(back_capacity, data.type.width, handshakes)
      history upstream from front.q: Seq(data.type, front_capacity)
      history downstream from back.q: Seq(data.type, back_capacity)
      relate q = if reverse | seq_concat(upstream, downstream) | seq_concat(downstream, upstream)
  QueuePairSeries
def reversed_series = candidate_series(~reverse: #true)
def wrong_capacity_series = candidate_series(~swap: #true)
export reversed_series wrong_capacity_series

// A well-typed but false claim: the environment's consume is not an ingress offer.
fun crossed_pair(top):
  spec for rtl.QueuePair:
    events ready_valid_events(reset, rv_pins("consume", "ready", "data"), rv_pins("valid", "offer", "head"))
  QueuePair(top, ~event_view: #true)
export crossed_pair

// Same RTL and public monitor, but the upstream word is wrongly treated as older.
fun reversed_pair(top):
  spec for rtl.QueuePair:
    events transfers = pair_events(reset)
    transactions fifo_monitor(2 * depth, data.type.width, transfers)
    refinement:
      child a: ShiftQueue
      child b: ShiftQueue
      history upstream from a.q: Seq(data.type, depth)
      history downstream from b.q: Seq(data.type, depth)
      relate q = seq_concat(upstream, downstream)
  QueuePair(top, ~transaction_view: #true)
export reversed_pair
