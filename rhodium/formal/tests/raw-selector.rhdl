import lib("examples/formal/granted-selector.rhdl") open
import lib("flow/arbiter.rhdl").Arbiter
import lib("examples/formal/gated-capture.rhdl").GatedCapture

sync_circuit RawSelector():
  input (request_a, request_b, accept): Bool
  input (word_a, word_b): Bits(2)
  output selected: Bits(2)
  inst lanes(LaneSelector())
  lanes.enable_a <== request_a
  lanes.enable_b <== request_b
  lanes.word_a <== word_a
  lanes.word_b <== word_b
  selected <== lanes.selected

sync_circuit DuplicateGrant(~registered: registered :: Boolean = #false):
  input (request_a, request_b, accept, swap): Bool
  input (word_a, word_b): Bits(2)
  output selected: Bits(2)
  inst arb(Arbiter(Bits(2), 2))
  arb.ingress[0].valid <== request_a
  arb.ingress[1].valid <== request_b
  arb.ingress[0].bits <== word_a
  arb.ingress[1].bits <== word_b
  arb.egress.ready <== accept
  inst router(LaneRouter())
  router.grant_a <== arb.ingress[0].ready
  router.grant_b <== arb.ingress[1].ready
  router.swap <== swap
  def storage = if registered | RegisteredLaneSelector() | LaneSelector()
  inst lanes(storage)
  lanes.enable_a <== router.route_a
  lanes.enable_b <== router.route_a
  lanes.word_a <== word_a
  lanes.word_b <== word_b
  selected <== lanes.selected

circuit HighGrant():
  input enable: Bool
  output grant: Bool
  grant <== Bool(#true)

sync_circuit CircularGrants():
  output granted: Bool
  inst a(HighGrant())
  inst b(HighGrant())
  a.enable <== b.grant
  b.enable <== a.grant
  granted <== a.grant

sync_circuit RawCapture():
  input (request_a, request_b, capture): Bool
  input (word_a, word_b): Bits(2)
  output selected: Bits(2)
  inst gate(GatedCapture())
  gate.grant_a <== request_a
  gate.grant_b <== request_b
  gate.capture <== capture
  gate.word_a <== word_a
  gate.word_b <== word_b
  selected <== gate.selected

export RawSelector DuplicateGrant HighGrant CircularGrants RawCapture
