import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("rhodium/frontend/foundation.rhm").Bits
  lib("flow/arbiter.rhdl").Arbiter
  lib("flow/shift-queue.rhdl").ShiftQueue
  "arbiter-queue-fixture.rhdl" open
  lib("rhodium/frontend/kernel.rhm").materialize_circuit
  lib("rspecl/rtl-boundary.rhm").interface_prefixes
  "../wiring.rhm".wiring_cut
  "../wiring.rhm".leaf_layout
  "shift-queue-fixture.rhdl".QueuePair
  lib("examples/formal/arbiter-queue.rhdl").ArbiterQueue
  lib("examples/formal/buffered-arbiter-queue.rhdl").BufferedArbiterQueue
  lib("examples/formal/gated-arbiter-queue.rhdl").GatedArbiterQueue
  lib("examples/formal/two-tag-rob.rhdl").TwoTagROB
  "faulty-rob.rhdl".FaultyROB
  lib("examples/formal/granted-selector.rhdl") open
  lib("examples/formal/gated-capture.rhdl") open
  "raw-selector.rhdl" open

export rob faulty_rob swapped_rob unchecked_rob
export selector granted_selector raw_selector
export router routed_selector duplicate_grant high_grant circular_grants
export registered_lane registered_routed registered_duplicate
export capture_gate arbitrated_capture raw_capture
export gated_at leaky_at outer_at
export pair pair_wires fifo_definition arbiter_definition mixed wrong_lane undersized
export interface_prefixes pin_layout leaf_sites
export proof_depths parent_at wrong_lane_at fifo_at

// Keep the actual definitions, not generated module names, in one elaboration.
def mutable pair = #false
def mutable arbiter_definition = #false
def fifos = MutableMap{}
def proof_depths = PairList[1, 2, 3]
def gated = MutableMap{}
def leaky = MutableMap{}
def outer = MutableMap{}
def parents = MutableMap{}
def faulty_parents = MutableMap{}
def mutable rob = #false
def mutable unchecked_rob = #false
def mutable swapped_rob = #false
def mutable faulty_rob = #false
def mutable undersized = #false
def mutable selector = #false
def mutable granted_selector = #false
def mutable raw_selector = #false
def mutable router = #false
def mutable routed_selector = #false
def mutable duplicate_grant = #false
def mutable high_grant = #false
def mutable circular_grants = #false
def mutable registered_lane = #false
def mutable registered_routed = #false
def mutable registered_duplicate = #false
def mutable capture_gate = #false
def mutable arbitrated_capture = #false
def mutable raw_capture = #false
fun inventory():
  arbiter_definition := materialize_circuit(Arbiter(Bits(2), 2))
  selector := materialize_circuit(LaneSelector())
  granted_selector := materialize_circuit(GrantedSelector())
  raw_selector := materialize_circuit(RawSelector())
  router := materialize_circuit(LaneRouter())
  routed_selector := materialize_circuit(RoutedSelector())
  duplicate_grant := materialize_circuit(DuplicateGrant())
  high_grant := materialize_circuit(HighGrant())
  circular_grants := materialize_circuit(CircularGrants())
  registered_lane := materialize_circuit(RegisteredLaneSelector())
  registered_routed := materialize_circuit(RegisteredRoutedSelector())
  registered_duplicate := materialize_circuit(DuplicateGrant(~registered: #true))
  capture_gate := materialize_circuit(GatedCapture())
  arbitrated_capture := materialize_circuit(ArbitratedCapture())
  raw_capture := materialize_circuit(RawCapture())
  pair := materialize_circuit(QueuePair())
  for (d in proof_depths):
    fifos[d] := materialize_circuit(ShiftQueue(Bits(2), d))
    parents[d] := materialize_circuit(ArbiterQueue(2, ~depth: d))
    gated[d] := materialize_circuit(GatedArbiterQueue(2, ~depth: d))
    leaky[d] := materialize_circuit(LeakyGate(2, ~depth: d))
    outer[d] := materialize_circuit(BufferedArbiterQueue(2, ~depth: d))
    faulty_parents[d] := materialize_circuit(WrongLane(2, d))
  rob := materialize_circuit(TwoTagROB())
  faulty_rob := materialize_circuit(FaultyROB("any-done"))
  swapped_rob := materialize_circuit(FaultyROB("swapped"))
  unchecked_rob := materialize_circuit(FaultyROB("ignore-generation"))
  undersized := materialize_circuit(Undersized(2))
  ArbiterQueue(2)
def mixed = elaborate(inventory()).top
fun gated_at(depth): gated[depth]
fun leaky_at(depth): leaky[depth]
fun outer_at(depth): outer[depth]
fun parent_at(depth): parents[depth]
fun wrong_lane_at(depth): faulty_parents[depth]
def wrong_lane = wrong_lane_at(2)
def values(pair_children, pair_wires) = wiring_cut(pair, interface_prefixes)
def values(mixed_children, _) = wiring_cut(mixed, interface_prefixes)
fun fifo_at(depth): fifos[depth]
def fifo_definition = fifo_at(2)

// Resolve roles by declaration identity (including across elaborations), never by generated instance names.
fun leaf_sites(children):
  fun family(module_def): module_def.metadata_for("rhodium.circuit.family")[0].family
  fun unique_site(exemplar):
    def matches = children.keys().filter(~keep: fun (site): family(children[site]) === family(exemplar))
    unless matches.length() == 1 | error("expected one instance of " ++ exemplar.name)
    matches[0]
  unless children.length() == 2 | error("expected exactly two Flow children")
  values(unique_site(arbiter_definition), unique_site(fifo_definition))
unless pair_children.length() == 2 && mixed_children.length() == 2
       && pair_children["a"] === fifo_definition && pair_children["b"] === fifo_definition
| error("expected both parents to share the proved FIFO specialization")


fun pin_layout(top): leaf_layout(top, interface_prefixes(top))
