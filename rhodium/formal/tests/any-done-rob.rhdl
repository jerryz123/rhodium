#lang rhodium
// SPDX-License-Identifier: Apache-2.0

import:
  lib("flow/main.rhdl") open
  lib("examples/formal/arbiter-queue.rhdl").ArbiterQueue

// Same two-tag protocol, but a younger completion incorrectly unlocks an unfinished head.
sync_circuit AnyDoneROB():
  input (issue_a, issue_b, complete_a, complete_b): Bool
  output (grant_a, grant_b): Bool
  interface retire(Irrevocable(Bool), ~role: producer)

  reg busy_a(~init: Bool(#false))
  reg busy_b(~init: Bool(#false))
  reg done_a(~init: Bool(#false))
  reg done_b(~init: Bool(#false))

  inst order(ArbiterQueue(2, ~depth: 2))
  order.ingress[0].valid <== issue_a & !busy_a
  order.ingress[0].bits <== Bits(2)(0)
  order.ingress[1].valid <== issue_b & !busy_b
  order.ingress[1].bits <== Bits(2)(1)
  def issued_a = order.ingress[0].fire()
  def issued_b = order.ingress[1].fire()
  grant_a <== issued_a
  grant_b <== issued_b

  def head_b = order.egress.bits === Bits(2)(1)
  def head_done = done_a ||| done_b
  retire.valid <== order.egress.valid & head_done
  retire.bits <== head_b
  order.egress.ready <== retire.ready & head_done
  def retired = retire.fire()
  def retired_a = retired & !head_b
  def retired_b = retired & head_b

  busy_a <== issued_a ||| (busy_a & !retired_a)
  busy_b <== issued_b ||| (busy_b & !retired_b)
  done_a <== busy_a & !retired_a & (done_a ||| complete_a)
  done_b <== busy_b & !retired_b & (done_b ||| complete_b)

export AnyDoneROB
