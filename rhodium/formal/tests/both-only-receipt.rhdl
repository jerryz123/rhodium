#lang rhodium
// SPDX-License-Identifier: Apache-2.0

import lib("rhodium/frontend/support/clocking.rhm").ambient_reset_register
import lib("flow/main.rhdl") open
import lib("examples/formal/broadcast-receipt.rhdl").BroadcastReceipt
import lib("rhodium/frontend/kernel.rhm").materialize_circuit

sync_circuit BothOnlyReceipt():
  interface ingress(Decoupled(Bits(2)), ~role: consumer)
  interface egress[2](Irrevocable(Bits(2)), ~role: producer)
  output receipt: Bool
  inst fanout(Broadcast(Bits(2), 2))
  ingress |> fanout.ingress
  for (i in 0..2): fanout.egress[i] |> egress[i]
  for (i in 0..2):
    def due = ambient_reset_register("due_" ++ to_string(i), Bool, Bool(#false))
    due <== ingress.fire() ||| (due & !egress[i].fire())
  def l = egress[0].fire()
  def r = egress[1].fire()
  // Same state and wiring: only the pulse logic forgets the earlier recipient.
  receipt <== !reset_active().into(Bool) & l & r

// Elaborate both recorders with the identical child definition. Only the parent logic differs.
def mutable direct = #false
fun inventory():
  direct := materialize_circuit(BroadcastReceipt())
  BothOnlyReceipt()
def bad_top = elaborate(inventory()).top
def queued = elaborate(BroadcastReceipt(~queued: #true)).top
def wide_direct = elaborate(BroadcastReceipt(3, 8)).top
def wide_queued = elaborate(BroadcastReceipt(3, 8, ~queued: #true)).top
export direct queued bad_top wide_direct wide_queued
