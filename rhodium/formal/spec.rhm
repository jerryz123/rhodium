#lang rhombus
/* Constructs finite, typed specification expressions and executes concrete edges with rspecsim. */
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/meta.annot
  rhombus.bits.(<<) as <<

export:
  only_space annot:
    rename: Expr as SpecExpr
    rename: Model as LeafModel
  rename: same_type as spec_type_equal
  SpecBool SpecBits SpecSeq
  literal input_ref state_ref choose_if bool_not bool_and bits_equal
  seq_empty seq_full seq_front seq_tail seq_append
  Observed make_spec include_sampled_events make_composition step_spec spec_snapshot composition_snapshot

interface SpecType

/* Logical values are distinct from one-bit packed naturals. */
class SpecBool():
  implements SpecType

/* Packed values are unsigned naturals that fit the declared width. */
class SpecBits(width :: PosInt):
  implements SpecType

/* An oldest-first bounded sequence contains only its live elements. */
class SpecSeq(element :: SpecBool || SpecBits, capacity :: PosInt):
  implements SpecType

/* Constructors below own the types and arity of these immutable IR nodes. */
class Expr(op :: String, type :: SpecType, args :: List, datum :: String || Boolean || Nat || List = #false)

/* Compare specialized types by structure, not by descriptor identity. */
fun same_type(a :: SpecType, b :: SpecType):
  cond
  | a is_a SpecBits: b is_a SpecBits && a.width == b.width
  | a is_a SpecSeq: b is_a SpecSeq && a.capacity == b.capacity && same_type(a.element, b.element)
  | ~else: b is_a SpecBool

/* Reject values outside their finite domain, including inactive or excess sequence slots. */
fun check_value(type :: SpecType, value :: Boolean || Int || List):
  cond
  | type is_a SpecSeq:
      unless value is_a List && value.length() <= type.capacity
      | error("expected a list within sequence capacity")
      for (item in value): check_value(type.element, item)
  | type is_a SpecBits:
      unless value is_a Nat && value < (1 << type.width)
      | error("value does not fit spec bits")
  | ~else:
      unless value is_a Boolean | error("expected a spec boolean")

/* Embed a checked, concrete initial or constant value in an expression. */
fun literal(type :: SpecType, value :: Boolean || Nat || List):
  check_value(type, value)
  Expr("literal", type, [], value)

/* Name a sampled input; model construction checks its declared port type. */
fun input_ref(name :: String, type :: SpecType): Expr("input", type, [], name)

/* Read a state field before the edge, never another field's pending update. */
fun state_ref(name :: String, type :: SpecType): Expr("state", type, [], name)

/* Require a Boolean predicate even when a packed input happens to have width one. */
fun check_bool(expr :: Expr):
  unless expr.type is_a SpecBool | error("expected a boolean expression")

/* Form a typed conditional; only its selected branch must be defined on an edge. */
fun choose_if(test :: Expr, yes :: Expr, no :: Expr):
  check_bool(test)
  unless same_type(yes.type, no.type) | error("conditional branch type mismatch")
  Expr("if", yes.type, [test, yes, no])

/* Negate a Boolean predicate. */
fun bool_not(expr :: Expr):
  check_bool(expr)
  Expr("not", SpecBool(), [expr])

/* Conjoin two predicates, evaluating the second only when the first holds. */
fun bool_and(left :: Expr, right :: Expr):
  check_bool(left)
  check_bool(right)
  Expr("and", SpecBool(), [left, right])

/* Compare packed words of the same width without equating Bits(1) with a logical Bool. */
fun bits_equal(left :: Expr, right :: Expr):
  unless left.type is_a SpecBits && same_type(left.type, right.type) | error("expected equal-width packed words")
  Expr("bits-equal", SpecBool(), [left, right])

/* Reject scalar operands before building a sequence operation. */
fun sequence_type(seq :: Expr) :: SpecSeq:
  unless seq.type is_a SpecSeq | error("expected a sequence expression")
  seq.type

/* Test whether a sequence contains no live items. */
fun seq_empty(seq :: Expr):
  sequence_type(seq)
  Expr("empty", SpecBool(), [seq])

/* Test whether appending another element would exceed capacity. */
fun seq_full(seq :: Expr):
  sequence_type(seq)
  Expr("full", SpecBool(), [seq])

/* Read the oldest element; the selected execution path must be nonempty. */
fun seq_front(seq :: Expr): Expr("front", sequence_type(seq).element, [seq])

/* Remove the oldest element on a nonempty execution path. */
fun seq_tail(seq :: Expr): Expr("tail", sequence_type(seq), [seq])

/* Add one live item of the declared element type, subject to available capacity. */
fun seq_append(seq :: Expr, item :: Expr):
  def type = sequence_type(seq)
  unless same_type(type.element, item.type) | error("sequence element type mismatch")
  Expr("append", type, [seq, item])

/* Omit the named output or event field entirely when its care predicate is false. */
class Observed(value :: Expr, care :: Expr = literal(SpecBool(), #true)):
  /* Reject non-Boolean care predicates before executing the model. */
  constructor (value :: Expr, care :: Expr = literal(SpecBool(), #true)):
    check_bool(care)
    super(value, care)

/* A checked model holds separate input and state namespaces and one update per field. */
class Model(inputs :: Map, state :: Map, initial :: Map, outputs :: Map, events :: Map, updates :: Map,
            assumptions :: Map)

/* Check exact bindings so absent samples and extra fields cannot silently affect a run. */
fun check_bindings(schema :: Map, bindings :: Map):
  unless bindings.length() == schema.length() | error("expected exact spec bindings")
  for ((name, type) in schema):
    unless bindings.has_key(name) | error("missing spec binding: " ++ name)
    check_value(type, bindings[name])

/* Resolve every reference, including in untaken branches, and check update result types. */
fun make_spec(inputs :: Map, state :: Map, initial :: Map, outputs :: Map, events :: Map, updates :: Map,
              ~assumptions: assumptions :: Map = {}):
  for (schema in [inputs, state]):
    for ((name, type) in schema):
      unless name is_a String && type is_a SpecType | error("invalid spec declaration")
  check_bindings(state, initial)
  /* Link expression leaves against declarations rather than guessing from sample values. */
  fun link(expr :: Expr):
    when expr.op == "input" || expr.op == "state"
    | block:
        def schema = if expr.op == "input" | inputs | state
        unless schema.has_key(expr.datum) && same_type(schema[expr.datum], expr.type)
        | error("undeclared or mistyped spec reference: " ++ expr.datum)
    for (child in expr.args): link(child)
  /* Input contracts use only total scalar expressions over the current sample. */
  fun check_input_expr(expr :: Expr):
    when expr.op == "state" || expr.type is_a SpecSeq | error("assumption must use only scalar inputs")
    for (child in expr.args): check_input_expr(child)
  for ((name, expr) in assumptions):
    unless name is_a String && expr is_a Expr | error("invalid named input assumption")
    check_bool(expr)
    check_input_expr(expr)
    link(expr)
  for (view in [outputs, events]):
    for ((name, field) in view):
      unless name is_a String && field is_a Observed | error("invalid spec observation")
      link(field.care)
      link(field.value)
  for ((name, expr) in updates):
    unless state.has_key(name) && expr is_a Expr && same_type(state[name], expr.type)
    | error("unknown state or update type mismatch")
    link(expr)
  Model(inputs, state, initial, outputs, events, updates, assumptions)

/* Inline the published fields of a stateless sampler in a cycle model. A demanded output must be
   cared for; sampler-domain checks become definedness obligations, never assumptions on the model. */
fun include_sampled_events(sampler :: Model, outputs :: Map, events :: Map, ~only: names :: maybe(List.of(String)) = #false):
  unless sampler.state.length() == 0 && sampler.outputs.length() == 0 && sampler.events.length() > 0
  | error("expected a stateless event sampler")
  /* Require a predicate on the executed path, preserving the type and value of the guarded read. */
  fun guarded(test :: Expr, value :: Expr, label :: String):
    Expr("guarded", value.type, [test, value], label)
  /* Substitute the cycle's observation only at a physical output reference in the sampler. */
  fun bind(expr :: Expr):
    cond
    | expr.op == "input" && outputs.has_key(expr.datum):
        def field :: Observed = outputs[expr.datum]
        unless same_type(field.value.type, expr.type) | error("event pin type mismatch: " ++ expr.datum)
        guarded(field.care, field.value, expr.datum)
    | ~else: Expr(expr.op, expr.type, expr.args.map(bind), expr.datum)
  def projected = for Map (name in (names || sampler.events.keys())):
    def field :: Observed = sampler.events[name]
    when events.has_key(name) | error("duplicate spec declaration: " ++ name)
    def mutable care = bind(field.care)
    for ((label, predicate) in sampler.assumptions):
      care := guarded(bind(predicate), care, label)
    values(name, Observed(bind(field.value), care))
  events ++ projected

/* A step separates pre-edge observations from the state committed on that edge. */
class Step(outputs :: Map, events :: Map, next_state :: Map)

/* Describe one finite sort using immutable plain data accepted by the optional solver. */
fun snapshot_type(type :: SpecType):
  cond
  | type is_a SpecBool: PairList["bool"]
  | type is_a SpecBits: PairList["bits", type.width]
  | type is_a SpecSeq: PairList["seq", type.capacity, snapshot_type(type.element)]

/* Copy one typed expression without executing either branch or a partial operation. */
fun snapshot_expr(expr :: Expr):
  def data = if expr.datum is_a List | PairList[& expr.datum] | expr.datum
  PairList[expr.op, snapshot_type(expr.type), data, & expr.args.map(snapshot_expr)]

/* Include the declared start for reset proofs without constraining a symbolic old state. */
fun spec_snapshot(model :: Model):
  /* Preserve the instantiated sort of each named input or state field. */
  fun schema(fields :: Map):
    for Map ((name, type) in fields): values(name, snapshot_type(type))
  /* Both care and value must survive translation, even when the value is false. */
  fun view(fields :: Map):
    for Map ((name, field) in fields):
      values(name, PairList[snapshot_expr(field.care), snapshot_expr(field.value)])
  {"inputs": schema(model.inputs), "state": schema(model.state),
   "initial": for Map ((k, v) in model.initial): values(k, if v is_a List | PairList[& v] | v),
   "outputs": view(model.outputs), "events": view(model.events),
   "assumptions": for Map ((name, expr) in model.assumptions): values(name, snapshot_expr(expr)),
   "updates": for Map ((name, expr) in model.updates): values(name, snapshot_expr(expr))}

/* Interpret guards lazily, so an inactive partial operation is not executed. */
fun evaluate(expr :: Expr, state :: Map, inputs :: Map):
  /* Evaluate one operand against this same pre-edge sample. */
  fun arg(index :: Nat): evaluate(expr.args[index], state, inputs)
  match expr.op
  | "input": inputs[expr.datum]
  | "state": state[expr.datum]
  | "literal": expr.datum
  | "guarded":
      unless arg(0) | error("undefined event sample: " ++ expr.datum)
      arg(1)
  | "if":
      if arg(0) | arg(1) | arg(2)
  | "not": !arg(0)
  | "and": arg(0) && arg(1)
  | "bits-equal": arg(0) == arg(1)
  | "empty": arg(0).length() == 0
  | "full": arg(0).length() == expr.args[0].type.capacity
  | "front" || "tail":
      def seq = arg(0)
      when seq.length() == 0 | error("cannot read or remove from an empty sequence")
      if expr.op == "front" | seq[0] | seq.drop(1)
  | "append":
      def seq = arg(0)
      when seq.length() == expr.type.capacity | error("cannot append to a full sequence")
      seq ++ [arg(1)]

/* Advance one leaf against an exact sample of its state and physical inputs. */
fun step_leaf(model :: Model, state :: Map, inputs :: Map):
  check_bindings(model.state, state)
  check_bindings(model.inputs, inputs)
  for ((name, expr) in model.assumptions):
    unless evaluate(expr, state, inputs) | error("violated spec input assumption: " ++ name)
  /* Omit uncared observations, keeping observed false and zero intact. */
  fun observe(view :: Map):
    for Map (name in view.keys().filter(~keep: fun (key :: String): evaluate(view[key].care, state, inputs))):
      values(name, evaluate(view[name].value, state, inputs))
  def next = for Map ((name, old) in state):
    values(name, if model.updates.has_key(name) | evaluate(model.updates[name], state, inputs) | old)
  Step(observe(model.outputs), observe(model.events), next)

/* A leaf instance output can settle once its care and payload input pins are bound. */
class Offer(site :: String, port :: String, deps :: List)

/* Wiring-only parent; each occurrence owns a separate old state and one simultaneous edge. */
class Composition(inputs :: Map, outputs :: Map, children :: Map, wires :: Map,
                  order :: List, initial :: Map)

/* Collect all input references, including in conditional payloads and care expressions. */
fun dependencies(expr :: Expr, names :: MutableSet):
  when expr.op == "input" | names.add(expr.datum)
  for (child in expr.args): dependencies(child, names)

/* Link named scalar endpoints, check exact drivers, and order old-state offers without a fixed point. */
fun make_composition(inputs :: Map, outputs :: Map, children :: Map, wires :: Map):
  def sources = MutableMap{}
  def sinks = MutableMap{}
  def pending = MutableMap{}
  /* A pin has one direction and a finite scalar type; sequences remain private state. */
  fun declare(table :: MutableMap, key :: String, type :: SpecType):
    when sources.has_key(key) || sinks.has_key(key) | error("duplicate composition endpoint: " ++ key)
    when type is_a SpecSeq | error("composition pins must be scalar: " ++ key)
    table[key] := type
  for ((key, type) in inputs): declare(sources, key, type)
  for ((key, type) in outputs): declare(sinks, key, type)
  for ((site, child :: Model) in children):
    def prefix = site ++ "."
    for ((port, type) in child.inputs): declare(sinks, prefix ++ port, type)
    for ((port, field) in child.outputs):
      declare(sources, prefix ++ port, field.value.type)
      def deps = MutableSet{}
      dependencies(field.care, deps)
      dependencies(field.value, deps)
      pending[prefix ++ port] := Offer(site, port, for List (dep in deps): dep)
  for ((sink, src) in wires):
    unless sinks.has_key(sink) && sources.has_key(src) | error("unknown or reversed wire: " ++ sink ++ " <== " ++ src)
    unless same_type(sinks[sink], sources[src]) | error("wire type mismatch: " ++ sink ++ " <== " ++ src)
  for (sink in sinks.keys()): unless wires.has_key(sink) | error("undriven composition pin: " ++ sink)
  def mutable order = []
  /* A source no longer pending is either external or already settled. */
  fun is_ready(key :: String):
    def offer = pending[key]
    !offer.deps.find(fun (d :: String): pending.has_key(wires[offer.site ++ "." ++ d]))
  while pending.length() > 0:
    def ready = pending.keys().filter(~keep: is_ready)
    when ready.length() == 0 | error("combinational cycle in composition wiring")
    for (key in ready):
      order := order ++ [pending[key]]
      pending.remove(key)
  Composition(inputs, outputs, children, wires, order,
              for Map ((site, child) in children): values(site, child.initial))

/* Export the checked wire graph, external schema, schedule, and specialized leaf models. */
fun composition_snapshot(model :: Composition):
  {"children": for Map ((site, child) in model.children): values(site, spec_snapshot(child)),
   "inputs": for Map ((k, t) in model.inputs): values(k, snapshot_type(t)),
   "outputs": PairList[& model.outputs.keys()],
   "output-types": for Map ((k, t) in model.outputs): values(k, snapshot_type(t)),
   "wires": model.wires,
   "order": for PairList (o in model.order): PairList[o.site, o.port, PairList[& o.deps]]}

/* Settle physical pins once, preserving care on exported observations; commit all children together. */
fun step_composition(model :: Composition, state :: Map, inputs :: Map):
  check_bindings(model.inputs, inputs)
  unless state.keys().length() == model.children.length() | error("expected exact instance states")
  def nets = MutableMap{}
  def cared = MutableMap{}
  for ((k, v) in inputs):
    nets[k] := v
    cared[k] := #true
  /* Bind only the pins required at this point in the dependency schedule. */
  fun bind(site :: String, ports :: List):
    for Map (p in ports): values(p, nets[model.wires[site ++ "." ++ p]])
  for (o in model.order):
    def field = model.children[o.site].outputs[o.port]
    def args = bind(o.site, o.deps)
    def key = o.site ++ "." ++ o.port
    def care = evaluate(field.care, state[o.site], args)
    cared[key] := care
    def physical:
      cond
      | care: evaluate(field.value, state[o.site], args)
      | field.value.type is_a SpecBool: #false
      | ~else: 0
    nets[key] := physical
  def next = for Map ((site, child) in model.children):
    def edge = step_leaf(child, state[site], bind(site, child.inputs.keys()))
    values(site, edge.next_state)
  Step(for Map (k in model.outputs.keys().filter(~keep: fun (k :: String): cared[model.wires[k]])):
         values(k, nets[model.wires[k]]),
       Map{}, next)

/* Run one concrete rspecsim edge for either a leaf or a structural parent. */
fun step_spec(model :: Model || Composition, state :: Map, inputs :: Map):
  if model is_a Model | step_leaf(model, state, inputs) | step_composition(model, state, inputs)
