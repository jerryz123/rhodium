#lang rhombus
// Exposes typed combinational equivalence, reachability, and output-property queries over verified Rhodium subjects.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus.bits.(<<) as <<
  "../core/main.rhm" open
  "snapshot.rhm" open
  "engine.rkt" as engine
  lib("racket/base.rkt") as rkt

export:
  FormalAssumption
  FormalAssignment
  FormalDifference
  FormalDiagnostic
  FormalInputAssumption
  FormalOneHotAssumption
  FormalOutputPattern
  FormalOutputWitness
  FormalPropertyResult
  FormalQuery
  FormalReachabilityResult
  FormalResult
  check_equivalent
  check_output_property
  check_reachable

interface FormalAssumption

class FormalAssignment(port :: String,
                       type :: HardwareType,
                       packed_value :: Nat)

class FormalDifference(port :: String,
                       type :: HardwareType,
                       left_value :: Nat,
                       right_value :: Nat)

class FormalDiagnostic(module_path :: False || String,
                       opcode :: False || String,
                       operation_id :: False || Nat,
                       location :: False || String,
                       origin :: False || String,
                       message :: String)

class FormalInputAssumption(port :: String,
                            value :: Nat,
                            care :: False || Nat = #false):
  implements FormalAssumption

class FormalOneHotAssumption(port :: String):
  implements FormalAssumption

class FormalOutputPattern(port :: String,
                          value :: Nat,
                          care :: False || Nat = #false)

class FormalOutputWitness(port :: String,
                          type :: HardwareType,
                          packed_value :: Nat)

class FormalQuery(assumptions :: List.of(FormalAssumption) = [])

class FormalResult(status :: String,
                   assignments :: List.of(FormalAssignment) = [],
                   differences :: List.of(FormalDifference) = [],
                   diagnostic :: False || FormalDiagnostic = #false,
                   assumptions :: List.of(FormalAssumption) = []):
  method equivalent(): status == "equivalent"
  method counterexample(): status == "counterexample"
  method vacuous(): status == "vacuous"
  method unsupported(): status == "unsupported"
  method unknown(): status == "unknown"

  method describe():
    match status
    | "equivalent": "equivalent"
    | "counterexample":
        "counterexample with " ++ to_string(differences.length()) ++ " differing output(s)"
    | "vacuous" || "unsupported" || "unknown":
        if diagnostic | status ++ ": " ++ diagnostic.message | status
    | ~else: status

class FormalReachabilityResult(status :: String,
                               target :: FormalOutputPattern,
                               assignments :: List.of(FormalAssignment) = [],
                               output :: False || FormalOutputWitness = #false,
                               diagnostic :: False || FormalDiagnostic = #false,
                               assumptions :: List.of(FormalAssumption) = []):
  method reachable(): status == "reachable"
  method unreachable(): status == "unreachable"
  method vacuous(): status == "vacuous"
  method unsupported(): status == "unsupported"
  method unknown(): status == "unknown"

  method describe():
    match status
    | "reachable":
        if output
        | String.append("reachable with ", output.port, " = ",
                        to_string(output.packed_value))
        | "reachable"
    | "unreachable": "unreachable"
    | "vacuous" || "unsupported" || "unknown":
        if diagnostic | status ++ ": " ++ diagnostic.message | status
    | ~else: status

class FormalPropertyResult(status :: String,
                           target :: FormalOutputPattern,
                           assignments :: List.of(FormalAssignment) = [],
                           output :: False || FormalOutputWitness = #false,
                           diagnostic :: False || FormalDiagnostic = #false,
                           assumptions :: List.of(FormalAssumption) = []):
  method proved(): status == "proved"
  method counterexample(): status == "counterexample"
  method vacuous(): status == "vacuous"
  method unsupported(): status == "unsupported"
  method unknown(): status == "unknown"

  method describe():
    match status
    | "proved": "proved"
    | "counterexample":
        if output
        | String.append("counterexample with ", output.port, " = ",
                        to_string(output.packed_value))
        | "counterexample"
    | "vacuous" || "unsupported" || "unknown":
        if diagnostic | status ++ ": " ++ diagnostic.message | status
    | ~else: status

fun formal_query_snapshot(query :: FormalQuery,
                          top :: Module,
                          who :: Symbol):
  def snapshots:
    for List (assumption in query.assumptions, index in 0..query.assumptions.length()):
      def port = top.inputs.find(fun (candidate): candidate.name == assumption.port)
      unless port
      | error(~who: who,
              String.append("formal assumption ", to_string(index),
                            " references unknown input ", assumption.port))
      if assumption is_a FormalInputAssumption
      | block:
          def width = port.type.packed_width()
          def care:
            if assumption.care is_a Nat
            | assumption.care
            | (1 << width) - 1
          def limit = 1 << width
          unless assumption.value < limit && care < limit && (assumption.value bits.and care) == assumption.value
          | error(~who: who,
                  String.append("formal assumption ", to_string(index),
                                " has an invalid packed pattern"))
          rkt.hash("kind", "input_pattern",
                   "port", assumption.port,
                   "value", assumption.value,
                   "care", care)
      | rkt.hash("kind", "onehot", "port", assumption.port)
  PairList[& snapshots]

fun formal_output_pattern_snapshot(target :: FormalOutputPattern,
                                   top :: Module,
                                   who :: Symbol):
  def port = top.outputs.find(fun (candidate): candidate.name == target.port)
  unless port
  | error(~who: who,
          "formal output target references unknown output " ++ target.port)
  def width = port.type.packed_width()
  def care:
    if target.care is_a Nat
    | target.care
    | (1 << width) - 1
  def limit = 1 << width
  unless target.value < limit && care < limit && (target.value bits.and care) == target.value
  | error(~who: who,
          "formal output target has an invalid packed pattern")
  rkt.hash("port", target.port, "value", target.value, "care", care)

fun interface_error(left_top :: Module, right_top :: Module):
  fun compare(kind :: String,
              left_ports :: List.of(Port),
              right_ports :: List.of(Port)):
    if left_ports.length() != right_ports.length()
    | "formal subjects have different " ++ kind ++ " port names"
    | block:
        def mutable message = #false
        for (left_port in left_ports):
          unless message
          | def right_port = right_ports.find(
              fun (candidate): candidate.name == left_port.name
            )
            cond
            | !right_port:
                message := "formal subjects have different " ++ kind ++ " port names"
            | !type_equal(left_port.type, right_port.type) || !type_equal(right_port.type, left_port.type):
                message := String.append(
                  "formal subjects have different Rhodium types for ", kind,
                  " port ", left_port.name, ": ",
                  left_port.type.describe(), " versus ", right_port.type.describe()
                )
            | ~else: #void
        message
  def input_error = compare("input", left_top.inputs, right_top.inputs)
  input_error || compare("output", left_top.outputs, right_top.outputs)

fun interface_diagnostic(top :: Module, message :: String):
  FormalDiagnostic(top.name, #false, #false, #false, #false, message)

fun entry_value(entry :: ReadableMap, key :: String):
  rkt.#{hash-ref}(entry, key)

fun optional_string(value :: False || String):
  if value | to_string(value) | #false

fun convert_diagnostic(raw :: False || ReadableMap):
  if raw
  | FormalDiagnostic(optional_string(entry_value(raw, "module_path")),
                     optional_string(entry_value(raw, "opcode")),
                     entry_value(raw, "operation_id"),
                     optional_string(entry_value(raw, "location")),
                     optional_string(entry_value(raw, "origin")),
                     to_string(entry_value(raw, "message")))
  | #false

fun convert_engine_result(raw :: satisfying(engine.formal_engine_result),
                          left_top :: Module,
                          query :: FormalQuery):
  def status = to_string(engine.engine_result_status(raw))
  def raw_assignments = PairList.to_list(engine.engine_result_inputs(raw))
  def raw_differences = PairList.to_list(engine.engine_result_differences(raw))
  def assignments:
    raw_assignments.map(
      fun (entry):
        def name = to_string(entry_value(entry, "port"))
        def port = left_top.inputs.find(fun (candidate): candidate.name == name)
        unless port
        | error(~who: #'check_equivalent,
                "formal engine returned an unknown input port " ++ name)
        FormalAssignment(name, port.type, entry_value(entry, "value"))
    )
  def differences:
    raw_differences.map(
      fun (entry):
        def name = to_string(entry_value(entry, "port"))
        def port = left_top.outputs.find(fun (candidate): candidate.name == name)
        unless port
        | error(~who: #'check_equivalent,
                "formal engine returned an unknown output port " ++ name)
        FormalDifference(name,
                         port.type,
                         entry_value(entry, "left"),
                         entry_value(entry, "right"))
    )
  FormalResult(status,
               assignments,
               differences,
               convert_diagnostic(engine.engine_result_diagnostic(raw)),
               query.assumptions)

fun check_equivalent(left :: DesignElaboration || Module || Design,
                     right :: DesignElaboration || Module || Design,
                     query :: FormalQuery = FormalQuery()):
  def left_top = formal_subject_top(left)
  def right_top = formal_subject_top(right)
  def query_snapshot = formal_query_snapshot(query, left_top, #'check_equivalent)
  def mismatch = interface_error(left_top, right_top)
  if mismatch
  | FormalResult("unsupported", [], [], interface_diagnostic(left_top, mismatch),
                 query.assumptions)
  | convert_engine_result(
      engine.check_equivalent_snapshots(formal_snapshot(left),
                                        formal_snapshot(right),
                                        query_snapshot),
      left_top,
      query
    )

fun convert_reachability_result(raw :: satisfying(engine.formal_reachability_result),
                                top :: Module,
                                target :: FormalOutputPattern,
                                query :: FormalQuery):
  def status = to_string(engine.reachability_result_status(raw))
  def raw_assignments = PairList.to_list(engine.reachability_result_inputs(raw))
  def assignments:
    raw_assignments.map(
      fun (entry):
        def name = to_string(entry_value(entry, "port"))
        def port = top.inputs.find(fun (candidate): candidate.name == name)
        unless port
        | error(~who: #'check_reachable,
                "formal engine returned an unknown input port " ++ name)
        FormalAssignment(name, port.type, entry_value(entry, "value"))
    )
  def raw_output = engine.reachability_result_output(raw)
  def output:
    if raw_output
    | block:
        def name = to_string(entry_value(raw_output, "port"))
        def port = top.outputs.find(fun (candidate): candidate.name == name)
        unless port
        | error(~who: #'check_reachable,
                "formal engine returned an unknown output port " ++ name)
        FormalOutputWitness(name, port.type, entry_value(raw_output, "value"))
    | #false
  FormalReachabilityResult(
    status,
    target,
    assignments,
    output,
    convert_diagnostic(engine.reachability_result_diagnostic(raw)),
    query.assumptions
  )

fun check_reachable(subject :: DesignElaboration || Module || Design,
                    target :: FormalOutputPattern,
                    query :: FormalQuery = FormalQuery()):
  def top = formal_subject_top(subject)
  def target_snapshot = formal_output_pattern_snapshot(target, top, #'check_reachable)
  def query_snapshot = formal_query_snapshot(query, top, #'check_reachable)
  convert_reachability_result(
    engine.check_reachable_snapshot(formal_snapshot(subject),
                                    target_snapshot,
                                    query_snapshot),
    top,
    target,
    query
  )

fun convert_property_result(raw :: satisfying(engine.formal_property_result),
                            top :: Module,
                            target :: FormalOutputPattern,
                            query :: FormalQuery):
  def status = to_string(engine.property_result_status(raw))
  def raw_assignments = PairList.to_list(engine.property_result_inputs(raw))
  def assignments:
    raw_assignments.map(
      fun (entry):
        def name = to_string(entry_value(entry, "port"))
        def port = top.inputs.find(fun (candidate): candidate.name == name)
        unless port
        | error(~who: #'check_output_property,
                "formal engine returned an unknown input port " ++ name)
        FormalAssignment(name, port.type, entry_value(entry, "value"))
    )
  def raw_output = engine.property_result_output(raw)
  def output:
    if raw_output
    | block:
        def name = to_string(entry_value(raw_output, "port"))
        def port = top.outputs.find(fun (candidate): candidate.name == name)
        unless port
        | error(~who: #'check_output_property,
                "formal engine returned an unknown output port " ++ name)
        FormalOutputWitness(name, port.type, entry_value(raw_output, "value"))
    | #false
  FormalPropertyResult(
    status,
    target,
    assignments,
    output,
    convert_diagnostic(engine.property_result_diagnostic(raw)),
    query.assumptions
  )

fun check_output_property(subject :: DesignElaboration || Module || Design,
                          target :: FormalOutputPattern,
                          query :: FormalQuery = FormalQuery()):
  def top = formal_subject_top(subject)
  def target_snapshot:
    formal_output_pattern_snapshot(target, top, #'check_output_property)
  def query_snapshot = formal_query_snapshot(query, top, #'check_output_property)
  convert_property_result(
    engine.check_property_snapshot(formal_snapshot(subject),
                                   target_snapshot,
                                   query_snapshot),
    top,
    target,
    query
  )
