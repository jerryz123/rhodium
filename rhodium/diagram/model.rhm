#lang rhombus
// Defines the tool-neutral logical block and compound-channel diagram model.

import:
  "../core/ir.rhm".DesignElaboration
  "../core/ir.rhm".Value
  "../frontend/layers/interface.rhm".InterfaceEventGroup
  "../frontend/layers/interface.rhm".InterfaceTraceModel

export:
  DiagramPort
  DiagramBlock
  DiagramChannel
  DiagramTraceEdge
  DiagramModule
  DiagramDesign

class DiagramPort(id :: String,
                  name :: String,
                  direction :: String,
                  protocol :: String,
                  backpressured :: Boolean = #false,
                  compound :: Boolean = #false)

class DiagramBlock(id :: String,
                   label :: String,
                   kind :: String,
                   ports :: List.of(DiagramPort),
                   properties :: Map = {},
                   child_module :: False || String = #false,
                   behavior :: String = "combinational",
                   trace_model :: False || InterfaceTraceModel = #false,
                   event_annotation :: False || InterfaceEventGroup = #false,
                   implementation_name :: False || String = #false,
                   delegate_ports :: False || Map = #false)

class DiagramChannel(id :: String,
                     source_block :: String,
                     source_port :: String,
                     destination_block :: String,
                     destination_port :: String,
                     protocol :: String,
                     backpressured :: Boolean = #false,
                     kind :: String = "data",
                     protocol_family :: String = "data")

// A metadata-only causal edge between two event checkpoints in one module.
// The retained controls are carried through extraction for event analysis.
class DiagramTraceEdge(parent_site :: Nat,
                       child_site :: Nat,
                       capture :: Value,
                       release :: Value,
                       active :: Value,
                       scope :: String)

class DiagramModule(id :: Nat || String,
                    name :: String,
                    blocks :: List.of(DiagramBlock),
                    channels :: List.of(DiagramChannel),
                    trace_edges :: List.of(DiagramTraceEdge) = [])

class DiagramDesign(logical :: DesignElaboration,
                    modules :: List.of(DiagramModule)):
  method module(name :: String):
    modules.find(fun (module_diagram): module_diagram.name == name)
