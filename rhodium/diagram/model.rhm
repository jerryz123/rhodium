#lang rhombus
/* Defines the tool-neutral logical block and compound-channel diagram model. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../core/ir.rhm".DesignElaboration
  "../core/ir.rhm".Value
  "../frontend/layers/interface.rhm".InterfaceEventGroup
  "../frontend/layers/interface.rhm".InterfaceTraceModel

export:
  DiagramPort
  DiagramBlock
  DiagramChannel
  DiagramTraceEdge
  DiagramModule
  DiagramDesign

/* Describes a rendered terminal's direction and protocol, retaining compound-interface and backpressure flags. */
class DiagramPort(id :: String,
                  name :: String,
                  direction :: String,
                  protocol :: String,
                  backpressured :: Boolean = #false,
                  compound :: Boolean = #false)

/* Represents a logical block with display properties and optional IR-backed hierarchy, trace, or delegation metadata. */
class DiagramBlock(id :: String,
                   label :: String,
                   kind :: String,
                   ports :: List.of(DiagramPort),
                   properties :: Map = {},
                   child_module :: maybe(String) = #false,
                   behavior :: String = "combinational",
                   trace_model :: maybe(InterfaceTraceModel) = #false,
                   event_annotation :: maybe(InterfaceEventGroup) = #false,
                   implementation_name :: maybe(String) = #false,
                   delegate_ports :: maybe(Map) = #false)

/* Connects two logical terminals, distinguishing protocol topology from ordinary data dependence. */
class DiagramChannel(id :: String,
                     source_block :: String,
                     source_port :: String,
                     destination_block :: String,
                     destination_port :: String,
                     protocol :: String,
                     backpressured :: Boolean = #false,
                     kind :: String = "data",
                     protocol_family :: String = "data")

/*
 * A metadata-only causal edge between two event checkpoints in one module.
 * The retained controls are carried through extraction for event analysis.
 */
class DiagramTraceEdge(parent_site :: Nat,
                       child_site :: Nat,
                       capture :: Value,
                       release :: Value,
                       active :: Value,
                       scope :: String)

/* Groups one module definition's ordered blocks, channels, and optional retained-owner causal edges. */
class DiagramModule(id :: Nat || String,
                    name :: String,
                    blocks :: List.of(DiagramBlock),
                    channels :: List.of(DiagramChannel),
                    trace_edges :: List.of(DiagramTraceEdge) = [])

/* Pairs the source elaboration with its read-only logical views of reachable module definitions. */
class DiagramDesign(logical :: DesignElaboration,
                    modules :: List.of(DiagramModule)):
  /* Returns the first module view with the requested name, or false when no such view exists. */
  method module(name :: String):
    modules.find(fun (module_diagram): module_diagram.name == name)
