#lang rhombus
/* Renders logical Rhodium modules as port-anchored Graphviz DOT schematics. */
// SPDX-License-Identifier: Apache-2.0

import:
  "model.rhm" open

export:
  diagram_module_to_dot
  diagram_to_dot

/* Quotes a DOT identifier or string label with host string escaping. */
fun dot_quote(value :: String):
  to_string(to_string(value), ~mode: #'expr)

/* Escapes text for Graphviz HTML table labels, including ampersands, angle brackets, and quotes. */
fun html_escape(value :: String):
  to_string(value)
    .replace("&", "&amp;", ~all: #true)
    .replace("<", "&lt;", ~all: #true)
    .replace(">", "&gt;", ~all: #true)
    .replace("\"", "&quot;", ~all: #true)

/* Recognizes grouped interfaces and ordinary ports rendered as module-boundary anchors. */
fun boundary_block(block :: DiagramBlock):
  block.kind == "boundary" || block.kind == "boundary-array" || (
    block.kind == "input"
  ) || block.kind == "output"

/* Maps a block port ID to its table-cell anchor, rejecting unknown terminal references. */
fun block_port_anchor(block :: DiagramBlock, port_id :: String):
  def mutable anchor = #false
  for (port in block.ports, index in 0..block.ports.length()):
    when port.id == port_id
    | anchor := "p" ++ to_string(index)
  unless anchor
  | error(~who: #'diagram_module_to_dot,
          "diagram channel references an unknown block port")
  anchor

/* Renders one aligned table cell with a named port anchor and escaped display name. */
fun port_cell(block :: DiagramBlock, port :: DiagramPort, side :: String):
  String.append("<TD PORT=\"", block_port_anchor(block, port.id),
                "\" ALIGN=\"", side, "\">",
                html_escape(port.name), "</TD>")

/* Pairs ordered input/output cells around a shared block label, padding the shorter side with empty cells. */
fun block_rows(block :: DiagramBlock):
  def inputs = block.ports.filter(
    ~keep: fun (port): port.direction == "input"
  )
  def outputs = block.ports.filter(
    ~keep: fun (port): port.direction == "output"
  )
  def maximum = if inputs.length() > outputs.length() | inputs.length() | outputs.length()
  def row_count = if maximum == 0 | 1 | maximum
  for List (index in 0..row_count):
    def input_cell:
      if index < inputs.length()
      | port_cell(block, inputs[index], "LEFT")
      | "<TD></TD>"
    def output_cell:
      if index < outputs.length()
      | port_cell(block, outputs[index], "RIGHT")
      | "<TD></TD>"
    def name_cell:
      if index == 0
      | String.append("<TD ROWSPAN=\"", to_string(row_count),
                      "\"><B>", html_escape(block.label), "</B></TD>")
      | ""
    "<TR>" ++ input_cell ++ name_cell ++ output_cell ++ "</TR>"

/* Renders the block's port table, adding a gray outer enclosure for sequential behavior. */
fun block_table(block :: DiagramBlock):
  def inner = String.append(
    "<TABLE BORDER=\"1\" CELLBORDER=\"1\" CELLSPACING=\"0\">",
    String.join(block_rows(block), ""),
    "</TABLE>"
  )
  if block.behavior == "sequential"
  | String.append(
      "<TABLE BORDER=\"1\" CELLBORDER=\"0\" CELLSPACING=\"2\" BGCOLOR=\"lightgray\"><TR><TD>",
      inner,
      "</TD></TR></TABLE>"
    )
  | inner

/* Emits an internal DOT node with a port-addressable HTML label. */
fun block_node(block :: DiagramBlock):
  String.append("    ", dot_quote(block.id),
                " [shape=plain, label=<", block_table(block), ">];")

/* Detects blocks with compound protocol ports that need ordinary-sideband stub rendering. */
fun block_has_flow_port(block :: DiagramBlock):
  for any (port in block.ports): port.compound

/* Builds a block/port-scoped identifier for an abstract combinational sideband stub. */
fun combo_ether_id(block :: DiagramBlock, port :: DiagramPort):
  block.id ++ "::ether::" ++ port.id

/* Emits the empty DOT anchor terminating an abstract combinational sideband stub. */
fun combo_ether_node(block :: DiagramBlock, port :: DiagramPort):
  String.append("    ", dot_quote(combo_ether_id(block, port)),
                " [shape=plain, width=0, height=0, label=\"\"];")

/* Draws a dotted sideband stub in the port's direction without inventing a functional dependency. */
fun combo_ether_edge(block :: DiagramBlock, port :: DiagramPort):
  def block_endpoint = dot_quote(block.id) ++ ":" ++ dot_quote(
    block_port_anchor(block, port.id)
  )
  def ether_endpoint = dot_quote(combo_ether_id(block, port))
  def endpoints:
    if port.direction == "input"
    | [ether_endpoint, block_endpoint]
    | [block_endpoint, ether_endpoint]
  endpoints[0] ++ " -> " ++ endpoints[1] ++ (
    " [style=dotted, color=gray50, arrowsize=0.6];"
  )

/* Removes the generic interface prefix from a boundary terminal's display name. */
fun boundary_port_suffix(port :: DiagramPort):
  port.name
    .replace("interface.", "")
    .replace("interface", "")

/* Combines the boundary label with nested or indexed suffixes when more than one terminal is exposed. */
fun boundary_port_label(block :: DiagramBlock, port :: DiagramPort):
  def suffix = boundary_port_suffix(port)
  if block.ports.length() == 1
  | block.label
  | if suffix.starts_with("[")
    | block.label ++ suffix
    | block.label ++ "." ++ suffix

/* Builds a block/port-scoped identifier for a module-boundary anchor. */
fun boundary_anchor_id(block :: DiagramBlock, port :: DiagramPort):
  block.id ++ "::" ++ port.id

/* Emits a small labeled point anchor for one module-boundary terminal. */
fun boundary_anchor_node(block :: DiagramBlock, port :: DiagramPort):
  String.append(
    "    ", dot_quote(boundary_anchor_id(block, port)),
    " [shape=point, width=0.08, fixedsize=true, label=\"\", xlabel=",
    dot_quote(boundary_port_label(block, port)), "];"
  )

/* Chooses thick Irrevocable or dashed Valid edges from nominal protocol family, leaving other families plain. */
fun channel_protocol_attributes(channel :: DiagramChannel):
  cond
  | channel.protocol_family == "Irrevocable" || channel.protocol_family == "IrrevocableCtrl":
      ["penwidth=3"]
  | channel.protocol_family == "Valid": ["style=dashed"]
  | ~else: []

/* Resolves a boundary terminal to its point anchor, rejecting unknown port references. */
fun boundary_channel_endpoint(block :: DiagramBlock, port_id :: String):
  def port = block.ports.find(fun (candidate): candidate.id == port_id)
  unless port
  | error(~who: #'diagram_module_to_dot,
          "diagram channel references an unknown boundary port")
  dot_quote(boundary_anchor_id(block, port))

/* Resolves a channel end to a boundary anchor or internal table port, falling back to the block ID if absent. */
fun channel_endpoint(module_diagram :: DiagramModule,
                     block_id :: String,
                     port_id :: String):
  def block = module_diagram.blocks.find(
    fun (candidate): candidate.id == block_id
  )
  if !block
  | dot_quote(block_id)
  | if boundary_block(block)
    | boundary_channel_endpoint(block, port_id)
    | dot_quote(block.id) ++ ":" ++ dot_quote(block_port_anchor(block, port_id))

/* Emits a protocol-styled DOT edge, adding an open reverse tail when the channel is backpressured. */
fun channel_edge(module_diagram :: DiagramModule, channel :: DiagramChannel):
  def attributes = (
    if channel.backpressured
    | ["dir=both", "arrowtail=none"]
    | []
  ) ++ channel_protocol_attributes(channel)
  def attribute_text:
    if attributes.length() == 0
    | ""
    | " [" ++ String.join(attributes, ", ") ++ "]"
  String.append(
    "    ",
    channel_endpoint(module_diagram, channel.source_block, channel.source_port),
    " -> ",
    channel_endpoint(module_diagram,
                     channel.destination_block,
                     channel.destination_port),
    attribute_text, ";"
  )

/* Renders one left-to-right module graph with boundary ranks, interface edges, and abstract ordinary-sideband stubs. */
fun diagram_module_to_dot(module_diagram :: DiagramModule):
  def internal_blocks = module_diagram.blocks.filter(
    ~keep: fun (block): !boundary_block(block)
  )
  def internal_nodes = internal_blocks.map(block_node)
  def mutable combo_ether_nodes = []
  def mutable combo_ether_edges = []
  for (block in internal_blocks):
    when block_has_flow_port(block)
    | for (port in block.ports):
        unless port.compound
        | combo_ether_nodes := combo_ether_nodes ++ [
            combo_ether_node(block, port)
          ]
          combo_ether_edges := combo_ether_edges ++ [
            combo_ether_edge(block, port)
          ]
  def mutable boundary_nodes = []
  def mutable input_anchors = []
  def mutable output_anchors = []
  for (block in module_diagram.blocks):
    when boundary_block(block)
    | for (port in block.ports):
        def anchor_id = boundary_anchor_id(block, port)
        boundary_nodes := boundary_nodes ++ [boundary_anchor_node(block, port)]
        if port.direction == "output"
        | input_anchors := input_anchors ++ [dot_quote(anchor_id)]
        | output_anchors := output_anchors ++ [dot_quote(anchor_id)]
  def source_rank:
    if input_anchors.length() == 0
    | []
    | ["    { rank=source; " ++ String.join(input_anchors, "; ") ++ "; }"]
  def sink_rank:
    if output_anchors.length() == 0
    | []
    | ["    { rank=sink; " ++ String.join(output_anchors, "; ") ++ "; }"]
  def edges = module_diagram.channels.filter(
    ~keep: fun (channel): channel.kind == "interface"
  ).map(
    fun (channel): channel_edge(module_diagram, channel)
  )
  String.join(
    ["digraph " ++ dot_quote(module_diagram.name) ++ " {",
     "  rankdir=LR;",
     "  compound=true;",
     "  subgraph " ++ dot_quote("cluster_" ++ module_diagram.name) ++ " {",
     "    label=" ++ dot_quote(module_diagram.name) ++ ";",
     "    margin=0;"] ++ (
      source_rank ++ sink_rank ++ boundary_nodes ++ internal_nodes ++ (
        combo_ether_nodes ++ edges ++ combo_ether_edges
      )
    ) ++ ["  }", "}", ""],
    "\n"
  )

/* Concatenates diagnostic DOT graphs for the extracted modules in view order. */
fun diagram_to_dot(view :: DiagramDesign):
  String.join(view.modules.map(diagram_module_to_dot), "\n")
