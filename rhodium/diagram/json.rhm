#lang rhombus
// Serializes logical Rhodium diagrams to deterministic, tool-neutral JSON.
// SPDX-License-Identifier: Apache-2.0

import:
  "model.rhm" open

export:
  diagram_module_to_json
  diagram_to_json

fun json_string(value :: String):
  to_string(value, ~mode: #'expr)

fun json_value(value :: String || Boolean || Number || Array || List || Map):
  cond
  | value is_a String: json_string(value)
  | value is_a Boolean:
      if value | "true" | "false"
  | value is_a Number: to_string(value)
  | value is_a Array:
      "[" ++ String.join(value.map(json_value), ",") ++ "]"
  | value is_a List:
      "[" ++ String.join(value.map(json_value), ",") ++ "]"
  | value is_a Map:
      def entries = value.keys(#true).map(
        fun (key): json_string(key) ++ ":" ++ json_value(value[key])
      )
      "{" ++ String.join(entries, ",") ++ "}"
  | ~else:
      error(~who: #'diagram_to_json,
            "diagram property is not JSON-serializable: " ++ to_string(value))

fun json_port(port :: DiagramPort):
  {
    "id": port.id,
    "name": port.name,
    "direction": port.direction,
    "protocol": port.protocol,
    "backpressured": port.backpressured,
    "compound": port.compound
  }

fun json_block(block :: DiagramBlock):
  def fields = {
    "id": block.id,
    "label": block.label,
    "kind": block.kind,
    "behavior": block.behavior,
    "ports": block.ports.map(json_port),
    "properties": block.properties
  }
  def complete:
    if block.child_module
    | fields.set("child_module", block.child_module)
    | fields
  complete

fun json_channel(channel :: DiagramChannel):
  {
    "id": channel.id,
    "source": {
      "block": channel.source_block,
      "port": channel.source_port
    },
    "destination": {
      "block": channel.destination_block,
      "port": channel.destination_port
    },
    "protocol": channel.protocol,
    "protocol_family": channel.protocol_family,
    "backpressured": channel.backpressured,
    "kind": channel.kind
  }

fun json_module(module_diagram :: DiagramModule):
  {
    "id": module_diagram.id,
    "name": module_diagram.name,
    "blocks": module_diagram.blocks.map(json_block),
    "channels": module_diagram.channels.map(json_channel)
  }

fun diagram_module_to_json(module_diagram :: DiagramModule):
  json_value(json_module(module_diagram)) ++ "\n"

fun diagram_to_json(view :: DiagramDesign):
  json_value({
    "top": view.logical.top.name,
    "modules": view.modules.map(json_module)
  }) ++ "\n"
