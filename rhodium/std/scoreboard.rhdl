#lang rhodium
// Defines a reusable positive-sized single-set, single-clear occupancy scoreboard.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/ready-valid.rhdl").Valid

fun scoreboard_index_capacity(entries :: PosInt):
  1 << index_width(entries)

fun scoreboard_index_in_range(entries :: PosInt,
                              index :: Bits(index_width(entries))):
  if scoreboard_index_capacity(entries) == entries
  | Bool(#true)
  | index < bits(entries, index_width(entries))

fun scoreboard_busy(entries :: PosInt,
                    busy :: Mask(entries),
                    index :: Bits(index_width(entries))) :~ Bool:
  def busy_vector = busy.as_vec(Bool)
  if scoreboard_index_capacity(entries) == entries
  | busy_vector[index]
  | busy_vector.lookup(index, ~default: Bool(#false))

fun scoreboard_index_bit(entries :: PosInt,
                         index :: Bits(index_width(entries))):
  if scoreboard_index_capacity(entries) == entries
  | one_hot(index).into(Mask(entries))
  | trunc(one_hot(index).into(Bits(scoreboard_index_capacity(entries))),
          entries).into(Mask(entries))

// Set and clear are nonbackpressured operations. Updates take effect at the
// edge, with clear winning when both operations address the same entry.
sync_circuit Scoreboard(entries :: PosInt):
  def Index = Bits(index_width(entries))

  interface set(Valid(Index), ~role: consumer)
  interface clear(Valid(Index), ~role: consumer)
  output busy: Mask(entries)

  reg state(~init: Mask(entries)(0))
  def set_bit = scoreboard_index_bit(entries, set.bits)
  def clear_bit = scoreboard_index_bit(entries, clear.bits)
  def set_mask = mux(set.valid, set_bit, Mask(entries)(0))
  def clear_mask = mux(clear.valid, clear_bit, Mask(entries)(0))
  def set_was_free = !or_reduce(state & set_bit) ||| (
    clear.valid & (clear.bits === set.bits)
  )
  def clear_was_busy = or_reduce(state & clear_bit) ||| (
    set.valid & (set.bits === clear.bits)
  )

  when (set.valid):
    assert(scoreboard_index_in_range(entries, set.bits),
           "scoreboard_set_index_in_range")
    assert(set_was_free, "scoreboard_set_free")
  when (clear.valid):
    assert(scoreboard_index_in_range(entries, clear.bits),
           "scoreboard_clear_index_in_range")
    assert(clear_was_busy, "scoreboard_clear_busy")

  def effective_busy = (state ||| set_mask) & !clear_mask
  when (set.valid ||| clear.valid):
    state <== effective_busy
  busy <== state

export:
  Scoreboard
  scoreboard_busy
