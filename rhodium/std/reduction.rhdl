#lang rhodium
// Builds an ordered balanced reduction tree with a caller-supplied binary function.
// SPDX-License-Identifier: Apache-2.0

fun tree_reduce(input_values :: List, combine :: Function.of_arity(2)):
  unless input_values.length() > 0
  | error(~who: #'tree_reduce, "expected at least one value")

  fun reduce_level(nodes :: List):
    if nodes.length() == 1
    | nodes[0]
    | block:
        def pair_count = nodes.length() div 2
        def paired = for List (pair_index in 0..pair_count):
          def left_index = pair_index * 2
          combine(nodes[left_index], nodes[left_index + 1])
        def next:
          if (pair_count * 2) == nodes.length()
          | paired
          | paired ++ [nodes[nodes.length() - 1]]
        reduce_level(next)

  reduce_level(input_values)

export:
  tree_reduce
