#lang rhodium
/* Builds ordered balanced reductions and parallel prefix scans with caller-supplied combiners. */
// SPDX-License-Identifier: Apache-2.0

/* Reduces a nonempty host list with a balanced binary tree while preserving operand order; combine owns result types and associativity. */
fun tree_reduce(input_values :: List, combine :: Function.of_arity(2)):
  unless input_values.length() > 0
  | error(~who: #'tree_reduce, "expected at least one value")

  /* Combines adjacent pairs, carries an odd final node unchanged, and recurses until one result remains. */
  fun reduce_level(nodes :: List):
    if nodes.length() == 1
    | nodes[0]
    | block:
        def pair_count = nodes.length() div 2
        def paired = for List (pair_index in 0..pair_count):
          def left_index = pair_index * 2
          combine(nodes[left_index], nodes[left_index + 1])

        def next:
          if (pair_count * 2) == nodes.length()
          | paired
          | paired ++ [nodes[nodes.length() - 1]]

        reduce_level(next)

  reduce_level(input_values)

/* Returns every inclusive prefix in source order using parallel doubling stages.
   Combine must be associative, but need not commute; the caller owns node types
   and arithmetic widths. Empty and singleton lists require no combinations. */
fun prefix_scan(input_values :: List, combine :: Function.of_arity(2)):
  def count = input_values.length()

  /* Each stage joins the preceding block before the current block, reading only
     the previous stage so no lane creates a same-stage serial dependency. */
  fun scan_level(nodes :: List, distance :: PosInt):
    if distance >= count
    | nodes
    | block:
        def next = for List (index in 0..count):
          if index < distance
          | nodes[index]
          | combine(nodes[index - distance], nodes[index])

        scan_level(next, distance * 2)

  scan_level(input_values, 1)

export:
  tree_reduce
  prefix_scan
