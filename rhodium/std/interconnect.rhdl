#lang rhodium
// Defines protocol-neutral sets, stripe geometry, and overflow-safe hardware transfer matching.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/bits.rhdl") open

class IdRange(start :: Nat, end :: PosInt):
  constructor (start :: Nat, end :: PosInt):
    unless end > start
    | error(~who: #'IdRange,
            "end must be a natural number greater than start")
    super(start, end)

  property size: end - start

  method contains(id :: Nat):
    start <= id && id < end

  method overlaps(other :: IdRange):
    start < other.end && other.start < end

  method fits_unsigned_width(width :: Nat):
    bits.length(end - 1) <= width

class IdRangeMap(local :: IdRange, global :: IdRange):
  constructor (local :: IdRange, global :: IdRange):
    unless local.size == global.size
    | error(~who: #'IdRangeMap,
            "local and global ranges must have the same size")
    super(local, global)

  method map(id :: Nat):
    unless local.contains(id)
    | error(~who: #'IdRangeMap, "ID is outside the local range")
    global.start + (id - local.start)

  method unmap(id :: Nat):
    unless global.contains(id)
    | error(~who: #'IdRangeMap, "ID is outside the global range")
    local.start + (id - global.start)

fun allocate_id_ranges(ranges :: NonemptyList.of(IdRange)):
  def mutable next_id = 0
  for List (id_range in ranges):
    def global = IdRange(next_id, next_id + id_range.size)
    next_id := global.end
    IdRangeMap(id_range, global)

// A one bit in mask makes that address bit variable. Canonical sets keep
// those variable bits clear in base.
class AddressSet(base :: Nat, mask :: Nat):
  constructor (base :: Nat, mask :: Nat):
    unless (base bits.and mask) == 0
    | error(~who: #'AddressSet,
            "base must have zeroes in every variable mask bit")
    super(base, mask)

  method contains(address :: Nat):
    (address bits.or mask) == (base bits.or mask)

  method overlaps(other :: AddressSet):
    (
      base bits.or mask bits.or other.mask
    ) == (
      other.base bits.or mask bits.or other.mask
    )

  method fits_unsigned_width(width :: Nat):
    bits.length(base bits.or mask) <= width

  // Matches a hardware address against this elaboration-time set.
  method matches(address :: Bits):
    def width = address.type.packed_width()
    (address & !bits(mask, width)) === bits(base, width)

// Matches a hardware address against any set, with false for an empty list.
fun address_sets_match(address :: Bits,
                       address_sets :: List.of(AddressSet)):
  or_reduce(
    for List (address_set in address_sets):
      address_set.matches(address)
  )

// Interleaves power-of-two banks at stripe granularity, independently of any protocol.
class StripedAddressLayout(local_bytes :: Pow2Int,
                           stripe_bytes :: Pow2Int,
                           bank_count :: Pow2Int):
  implements StableCircuitParam

  property total_bytes: local_bytes * bank_count
  property bank_mask: (bank_count - 1) * stripe_bytes
  property global_mask: total_bytes - 1 - bank_mask

  constructor (local_bytes :: Pow2Int, stripe_bytes :: Pow2Int, bank_count :: Pow2Int):
    unless stripe_bytes <= local_bytes
    | error(~who: #'StripedAddressLayout, "stripe size must not exceed the local memory size")
    super(local_bytes, stripe_bytes, bank_count)

  method fits_unsigned_width(width :: Nat):
    bits.length(total_bytes - 1) <= width

  method address_set(global_base :: Nat, bank_index :: Nat):
    unless global_base mod total_bytes == 0
    | error(~who: #'StripedAddressLayout, "global base must be aligned to the total striped memory size")
    unless bank_index < bank_count
    | error(~who: #'StripedAddressLayout, "bank index must be less than the bank count")
    AddressSet(global_base + (bank_index * stripe_bytes), global_mask)

  method project(address :: Nat, global_base :: Nat, bank_index :: Nat, ~local_base: local_base :: Nat = 0):
    def bank = address_set(global_base, bank_index)
    unless bank.contains(address)
    | error(~who: #'StripedAddressLayout, "address is outside this bank's global stripe")
    def relative = address - bank.base
    def row = relative >> (alignment_bits(stripe_bytes) + alignment_bits(bank_count))
    local_base + row * stripe_bytes + (relative bits.and (stripe_bytes - 1))

  // Removes the bank-select bits from a relative hardware address. Membership
  // and base translation remain caller-owned; this operation is combinational.
  method project_offset(relative :: Bits) :~ Bits(relative.type.packed_width()):
    def width = relative.type.packed_width()
    unless fits_unsigned_width(width)
    | error(~who: #'StripedAddressLayout, "striped memory size must fit the address width")
    def bank_width = alignment_bits(bank_count)
    def stripe_mask = bits(stripe_bytes - 1, width)
    // Keep the byte-within-stripe bits and shift the row down over the bank.
    ((relative >> bank_width) & !stripe_mask) ||| (relative & stripe_mask)

// Tests a nonempty transfer against a nonwrapping window. Widen the exclusive
// ends so a transfer ending exactly at the address-space limit is representable.
fun transfer_in_range(address :: Bits, transfer_bytes :: Bits(address.type.packed_width()), base_address :: Bits(address.type.packed_width()), window_bytes :: PosInt) :~ Bool:
  def width = address.type.packed_width()
  unless window_bytes <= (1 << width)
  | error(~who: #'transfer_in_range, "window must fit in the address space")
  def extended_address = address.zext(width + 1)
  def extended_base = base_address.zext(width + 1)
  def transfer_end = extended_address + transfer_bytes.zext(width + 1)
  def window_end = extended_base + bits(window_bytes, width + 1)
  (transfer_bytes =/= bits(0, width)) & (extended_address >= extended_base) & (transfer_end <= window_end) & (window_end <= bits(1 << width, width + 1))

class TransferSizes(min_bytes :: Pow2Int, max_bytes :: Pow2Int):
  constructor (min_bytes :: Pow2Int, max_bytes :: Pow2Int):
    unless min_bytes <= max_bytes
    | error(~who: #'TransferSizes,
            "minimum transfer size must not exceed maximum transfer size")
    super(min_bytes, max_bytes)

  method contains(bytes :: PosInt):
    power_of_two(bytes) && min_bytes <= bytes && bytes <= max_bytes

  method contains_all(other :: TransferSizes):
    min_bytes <= other.min_bytes && other.max_bytes <= max_bytes

export:
  StripedAddressLayout
  IdRange
  IdRangeMap
  allocate_id_ranges
  AddressSet
  address_sets_match
  transfer_in_range
  TransferSizes
