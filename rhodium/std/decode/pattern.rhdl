#lang rhodium
// Defines typed host-side patterns and recursive aggregate pattern construction.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/meta open

export:
  Pattern
  PatternSet
  pattern
  pattern_set
  partial_pattern
  as_pattern
  as_pattern_set

fun literal_types_equal(left :: HardwareLiteral, right :: HardwareLiteral):
  def left_type = left.literal_type()
  def right_type = right.literal_type()
  left_type.type_equal(right_type) && right_type.type_equal(left_type)

fun require_literal(value :: HardwareLiteral, role :: String):
  def width = value.literal_width()
  unless width is_a PosInt
  | error(~who: #'Pattern, role ++ " must have a positive packed width")
  def packed = value.packed_value()
  unless packed is_a Nat && bits.length(packed) <= width
  | error(~who: #'Pattern, role ++ " packed value does not fit its literal type")
  value

fun require_same_pattern_type(left :: HardwareLiteral,
                              right :: HardwareLiteral,
                              role :: String):
  unless literal_types_equal(left, right) && left.literal_width() == right.literal_width()
  | error(~who: #'Pattern,
          role ++ " must have exactly the same hardware type and width")

// Pattern is deliberately ordinary host data, not a HardwareLiteral. It
// denotes a set of packed values and therefore cannot be connected to hardware.
class Pattern(value :: HardwareLiteral,
              care :: HardwareLiteral,
              type :: DataType,
              width :: PosInt,
              value_bits :: Nat,
              care_bits :: Nat):
  constructor (~value: supplied_value :: HardwareLiteral,
               ~care: supplied_care :: HardwareLiteral):
    def value = require_literal(supplied_value, "value")
    def care = require_literal(supplied_care, "care")
    require_same_pattern_type(value, care, "value and care")
    def width = value.literal_width()
    def care_bits = care.packed_value()
    def value_bits = value.packed_value() bits.and care_bits
    super(value, care, value.literal_type(), width, value_bits, care_bits)

  method matches(candidate :: HardwareLiteral):
    def literal = require_literal(candidate, "candidate")
    require_same_pattern_type(value, literal, "candidate")
    (literal.packed_value() bits.and care_bits) == value_bits

  method overlaps(other :: Pattern || PatternSet):
    if other is_a PatternSet
    | as_pattern_set(this).overlaps(other)
    | block:
        require_same_pattern_type(value, other.value, "patterns")
        def differing = value_bits bits.xor other.value_bits
        def jointly_cared = care_bits bits.and other.care_bits
        (differing bits.and jointly_cared) == 0

  method subsumes(other :: Pattern || PatternSet):
    if other is_a PatternSet
    | as_pattern_set(this).subsumes(other)
    | block:
        require_same_pattern_type(value, other.value, "patterns")
        def shared_care = care_bits bits.and other.care_bits
        def differing = value_bits bits.xor other.value_bits
        shared_care == care_bits && (differing bits.and care_bits) == 0

  method union(other :: Pattern || PatternSet):
    as_pattern_set(this).union(other)

  method intersection(other :: Pattern || PatternSet):
    as_pattern_set(this).intersection(other)

  method subtract(other :: Pattern || PatternSet):
    as_pattern_set(this).subtract(other)

  method inverse():
    as_pattern_set(this).inverse()

fun pattern_from_bits(type :: DataType, value_bits :: Nat, care_bits :: Nat):
  Pattern(
    ~value: literal(type, value_bits bits.and care_bits),
    ~care: literal(type, care_bits)
  )

fun pattern_order(left :: Pattern, right :: Pattern):
  if left.care_bits == right.care_bits
  | left.value_bits < right.value_bits
  | left.care_bits < right.care_bits

fun pattern_intersection(left :: Pattern, right :: Pattern):
  require_same_pattern_type(left.value, right.value, "patterns")
  def shared_care = left.care_bits bits.and right.care_bits
  def differing = left.value_bits bits.xor right.value_bits
  if (differing bits.and shared_care) != 0
  | #false
  | pattern_from_bits(
      left.type,
      left.value_bits bits.or right.value_bits,
      left.care_bits bits.or right.care_bits
    )

fun least_set_bit(value :: PosInt):
  if (value bits.and 1) == 1
  | 1
  | 2 * least_set_bit(value >> 1)

// Removes one cube from another by recursively splitting on constraints that
// the removed cube adds. The returned residual cubes are pairwise disjoint.
fun subtract_pattern(left :: Pattern, right :: Pattern):
  require_same_pattern_type(left.value, right.value, "patterns")
  cond
  | !left.overlaps(right): [left]
  | right.subsumes(left): []
  | ~else:
      def all_bits = (1 << left.width) - 1
      def added_care = right.care_bits bits.and (
        all_bits bits.xor left.care_bits
      )
      def split_bit = least_set_bit(added_care)
      def matching_value = right.value_bits bits.and split_bit
      def outside_value = matching_value bits.xor split_bit
      def split_care = left.care_bits bits.or split_bit
      def outside = pattern_from_bits(
        left.type,
        left.value_bits bits.or outside_value,
        split_care
      )
      def matching = pattern_from_bits(
        left.type,
        left.value_bits bits.or matching_value,
        split_care
      )
      [outside] ++ subtract_pattern(matching, right)

fun subtract_term_cover(term :: Pattern, cover :: List):
  def mutable residual = [term]
  for (covered in cover):
    def mutable next = []
    for (candidate in residual):
      next := next ++ subtract_pattern(candidate, covered)
    residual := next
  residual

// Produces a deterministic, pairwise-disjoint cover without trying to
// minimize it; downstream RTL synthesis remains free to optimize the relation.
fun normalize_pattern_terms(type :: DataType, supplied_terms :: List):
  for (term in supplied_terms):
    unless term is_a Pattern && pattern_type_equal(term.type, type)
    | error(~who: #'PatternSet,
            "terms must have exactly the PatternSet hardware type")
  def sorted = supplied_terms.sort(pattern_order)
  def mutable terms = []
  for (term in sorted):
    terms := terms ++ subtract_term_cover(term, terms)
  terms.sort(pattern_order)

// PatternSet denotes a finite union of typed Pattern cubes. Its normalized
// terms are always pairwise disjoint so they can expand into rtl.decode rows.
class PatternSet(type :: DataType, width :: PosInt, terms :: List.of(Pattern)):
  constructor (type :: DataType, supplied_terms :: List):
    def width = type.packed_width()
    unless width is_a PosInt
    | error(~who: #'PatternSet,
            "type must have a positive packed width")
    def terms = normalize_pattern_terms(type, supplied_terms)
    super(type, width, terms)

  method is_empty():
    terms.length() == 0

  method matches(candidate :: HardwareLiteral):
    def literal = require_literal(candidate, "candidate")
    unless pattern_type_equal(type, literal.literal_type()) && width == literal.literal_width()
    | error(~who: #'PatternSet,
            "candidate must have exactly the PatternSet hardware type and width")
    for any (term in terms): term.matches(literal)

  method overlaps(other :: Pattern || PatternSet):
    def right = as_pattern_set(other)
    require_same_pattern_set_type(this, right, "sets")
    for any (left_term in terms):
      for any (right_term in right.terms):
        left_term.overlaps(right_term)

  method subsumes(other :: Pattern || PatternSet):
    def right = as_pattern_set(other)
    require_same_pattern_set_type(this, right, "sets")
    right.subtract(this).is_empty()

  method union(other :: Pattern || PatternSet):
    def right = as_pattern_set(other)
    require_same_pattern_set_type(this, right, "sets")
    PatternSet(type, terms ++ right.terms)

  method intersection(other :: Pattern || PatternSet):
    def right = as_pattern_set(other)
    require_same_pattern_set_type(this, right, "sets")
    def mutable intersections = []
    for (left_term in terms):
      for (right_term in right.terms):
        def overlap = pattern_intersection(left_term, right_term)
        if overlap
        | intersections := intersections ++ [overlap]
        | #void
    PatternSet(type, intersections)

  method subtract(other :: Pattern || PatternSet):
    def right = as_pattern_set(other)
    require_same_pattern_set_type(this, right, "sets")
    def mutable residual = []
    for (term in terms):
      residual := residual ++ subtract_term_cover(term, right.terms)
    PatternSet(type, residual)

  method inverse():
    PatternSet(type, [wildcard_pattern(type)]).subtract(this)

fun require_same_pattern_set_type(left :: PatternSet,
                                  right :: PatternSet,
                                  role :: String):
  unless pattern_type_equal(left.type, right.type) && left.width == right.width
  | error(~who: #'PatternSet,
          role ++ " must have exactly the same hardware type and width")

// Infers a nonempty set's type from its first Pattern-like value. Empty sets
// use the explicit PatternSet(type, []) constructor.
fun pattern_set(first_pattern :: Pattern || HardwareLiteral || List.of(Pattern || HardwareLiteral), ...):
  def supplied = [first_pattern, ...]
  def patterns:
    if supplied.length() == 1 && supplied[0] is_a List
    | supplied[0]
    | supplied
  unless patterns.length() >= 1
  | error(~who: #'pattern_set,
          "pattern_set requires at least one Pattern-like value")
  def terms = patterns.map(as_pattern)
  PatternSet(terms[0].type, terms)

fun as_pattern_set(value :: HardwareLiteral || Pattern || PatternSet):
  cond
  | value is_a PatternSet: value
  | value is_a Pattern: PatternSet(value.type, [value])
  | value is_a HardwareLiteral:
      def exact = exact_pattern(value)
      PatternSet(exact.type, [exact])
  | ~else:
      error(~who: #'as_pattern_set,
            "expected a HardwareLiteral, Pattern, or PatternSet")

// The wildcard is private syntax data. It means that a host-side pattern does
// not constrain a field; it is never materialized as hardware or interpreted
// as a runtime unknown value.
class _PatternWildcard()
def pattern_wildcard = _PatternWildcard()

fun pattern_type_equal(left :: DataType, right :: DataType):
  left.type_equal(right) && right.type_equal(left)

fun exact_pattern(value :: HardwareLiteral):
  def value_literal = require_literal(value, "pattern field")
  def width = value_literal.literal_width()
  Pattern(
    ~value: value_literal,
    ~care: literal(value_literal.literal_type(),
                   (1 << width) - 1)
  )

// Normalizes the two public forms accepted by typed decode consumers. Existing
// cubes retain partial care; exact literal shadows receive full care.
fun as_pattern(value :~ HardwareLiteral || Pattern):
  cond
  | value is_a Pattern:
      value
  | value is_a HardwareLiteral:
      exact_pattern(value)
  | ~else:
      error(~who: #'as_pattern,
            "expected a HardwareLiteral or Pattern")

fun wildcard_pattern(type :: DataType):
  def zero = literal(type, 0)
  Pattern(~value: zero, ~care: zero)

fun normalize_pattern_component(component :: _PatternWildcard || Pattern || HardwareLiteral,
                                expected_type :: DataType,
                                role :: String):
  def cube:
    cond
    | component is_a _PatternWildcard:
        wildcard_pattern(expected_type)
    | component is_a Pattern:
        component
    | component is_a HardwareLiteral:
        exact_pattern(component)
    | ~else:
        error(~who: #'pattern,
              role ++ " must be a hardware literal, Pattern, or _")
  unless pattern_type_equal(cube.type, expected_type)
  | error(~who: #'pattern, role ++ " has the wrong hardware type")
  cube

fun build_record_pattern(type :: RecordType,
                         fields :: List,
                         ~partial: partial :: Boolean = #false):
  for (field in fields):
    unless field is_a List && field.length() == 2 && field[0] is_a String
    | error(~who: #'pattern, "record pattern fields must be [name, value] pairs")
    unless type.fields.find(fun (declared :: RecordField): declared.name == field[0])
    | error(~who: #'pattern,
            "record pattern has no field named " ++ field[0])
    def matching_fields = fields.filter(
      ~keep: fun (candidate :: List): candidate[0] == field[0]
    )
    unless matching_fields.length() == 1
    | error(~who: #'pattern,
            "record pattern must not repeat field " ++ field[0])
  def cubes = for List (declared in type.fields):
    block:
      def matching = fields.filter(
        ~keep: fun (field :: List): field.length() == 2 && field[0] == declared.name
      )
      if matching.length() == 1
      | normalize_pattern_component(
          matching[0][1],
          declared.type,
          "pattern field " ++ declared.name
        )
      | if partial
        | wildcard_pattern(declared.type)
        | error(~who: #'pattern,
                "record pattern must supply every field exactly once")
  def value_fields = for List (declared in type.fields, cube in cubes):
    [declared.name, literal(declared.type, cube.value_bits)]
  def care_fields = for List (declared in type.fields, cube in cubes):
    [declared.name, literal(declared.type, cube.care_bits)]
  Pattern(
    ~value: RecordLiteral(type, value_fields),
    ~care: RecordLiteral(type, care_fields)
  )

fun build_vector_pattern(type :: VectorType, elements :: List):
  unless elements.length() == type.length
  | error(~who: #'pattern,
          "vector pattern element count must equal vector length")
  def cubes = for List (element in elements, index in 0..elements.length()):
    normalize_pattern_component(
      element,
      type.element_type,
      "vector pattern element " ++ to_string(index)
    )
  def value_elements = for List (cube in cubes):
    literal(type.element_type, cube.value_bits)
  def care_elements = for List (cube in cubes):
    literal(type.element_type, cube.care_bits)
  Pattern(
    ~value: VectorLiteral(type, value_elements),
    ~care: VectorLiteral(type, care_elements)
  )

expr.macro
| 'pattern_component(_)':
    'pattern_wildcard'
| 'pattern_component($value)':
    '$value'

// Exact literals receive full care automatically. An underscore contributes
// zero care, while a nested Pattern contributes its existing value/care cube.
expr.macro 'partial_pattern($type):
              $(field_name :: Identifier): $field_value
              ...':
  let [field_string, ...] = [field_name.to_source_string(), ...]
  'build_record_pattern(
     $type,
     [[$field_string, pattern_component($field_value)], ...],
     ~partial: #true
   )'

expr.macro
| 'pattern($type):
     $(field_name :: Identifier): $field_value
     ...':
    let [field_string, ...] = [field_name.to_source_string(), ...]
    'build_record_pattern(
       $type,
       [[$field_string, pattern_component($field_value)], ...]
     )'
| 'pattern($type, [$element, ...])':
    'build_vector_pattern(
       $type,
       [pattern_component($element), ...]
     )'
| 'pattern($type, $component)':
    'normalize_pattern_component(
       pattern_component($component),
       $type,
       "pattern value"
     )'
