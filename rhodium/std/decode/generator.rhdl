#lang rhodium
// Defines callable DecodeGen values that preserve typed decode relations in core IR.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/decode/pattern.rhdl") open
  lib("rhodium/std/decode/table.rhdl") open

export:
  DecodeResult
  DecodeGen
  ValidDecodeGen

bundle DecodeResult(T :: DataType):
  valid: Bool
  value: T

fun elaborate_decode(table :: DecodeTable,
                     selector :: Hardware.of(table.input_type))
  :: Hardware.of(table.output_type):
  hw_decode(selector,
            table.input_type,
            table.output_type,
            table.packed_cases,
            table.default.value_bits,
            table.default.care_bits)

class DecodeGen(table :: DecodeTable):
  implements Callable
  constructor (cases :: NonemptyList.of(DecodeCase),
               ~default: supplied_default :: Pattern):
    def table = DecodeTable(cases, ~default: supplied_default)
    super(table)

  // Method annotations cannot depend on receiver fields, so the callable
  // surface states the packable category and delegates its exact relation.
  override method call(selector :: Hardware.packable) :: Hardware.packable:
    elaborate_decode(table, selector)

// Turns a nonempty decode relation into a partial hardware function. Matched
// cases assert valid; the unmatched value is unconstrained synthesis freedom.
fun ValidDecodeGen(cases :: NonemptyList.of(DecodeCase)):
  def output_type = cases[0].output.type
  def result_type = DecodeResult(output_type)
  def wrapped_cases = for List (case in cases):
    DecodeCase(
      case.input,
      pattern(result_type):
        valid: Bool(#true)
        value: case.output
    )
  DecodeGen(
    wrapped_cases,
    ~default: (pattern(result_type):
                 valid: Bool(#false)
                 value: _)
  )
