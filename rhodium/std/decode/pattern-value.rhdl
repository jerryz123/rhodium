#lang rhodium
// Materializes an arbitrary hardware member of a typed host-side Pattern cube.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/decode/pattern.rhdl").Pattern

export:
  pattern_value

fun pattern_value(cube :: Pattern):
  def all_ones = (1 << cube.width) - 1
  def free_bits = all_ones bits.xor cube.care_bits
  def fixed = bits(cube.value_bits, cube.width)
  def freedom = dont_care(Bits(cube.width))
  def packed = bit_or(fixed,
                      bit_and(freedom, bits(free_bits, cube.width)))
  packed.into(cube.type)
