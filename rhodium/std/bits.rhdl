#lang rhodium
/* Defines bit layout, circular stepping, alignment, lane-mask expansion, and masked merge for Bits. */
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/meta open

/* Recognizes strictly positive host integers with exactly one set bit. */
fun power_of_two(value :~ matching(_)):
  value is_a PosInt && (value bits.and (value - 1)) == 0

annot.macro 'Pow2Int':
  'PosInt && satisfying(power_of_two)'

/* Returns the host cardinality of an unsigned bit-vector with the supplied width. */
fun unsigned_value_count(width :: Nat):
  1 << width

/* Advance a valid circular index without owning its storage or enable.
 * The caller maintains index < capacity; unused encodings have no promised result. */
fun wrap_increment(index :: Bits, capacity :: PosInt) :~ Bits(index.type.packed_width()):
  def width = index.type.packed_width()
  unless capacity <= (1 << width)
  | error(~who: #'wrap_increment, "capacity must fit the index width")

  cond
  | capacity == 1: Bits(width)(0)
  | capacity == (1 << width): index + Bits(width)(1)
  | ~else: mux(index === Bits(width)(capacity - 1), Bits(width)(0), index + Bits(width)(1))

/* Reverses the packed bit order, retaining a one-bit operand unchanged. */
fun reverse_bits(value :: Bits) :~ Bits(value.type.packed_width()):
  def width = value.type.packed_width()
  if width == 1
  | value
  | concat(for List (index in 0..width): value[index])

/* The leading sentinel makes the result total: an all-zero input selects the
 * sentinel at index width and therefore returns the operand width. */
fun count_leading_zeros(value :: Bits) :~ Bits(index_width(value.type.packed_width() + 1)):
  priority_encoder((Bool(#true) ++ reverse_bits(value)))

/* Validates a host offset/value pair and returns its packed hardware value and width. */
fun normalized_pack_field(field :: List):
  unless field.length() == 2 && field[0] is_a Nat
  | error(~who: #'pack_fields,
          "fields must be [offset, packable hardware value] pairs")

  def value :: Hardware.packable = field[1]
  def packed = value.as_bits()
  [field[0], packed, hardware_value_type(packed).packed_width()]

/* Packs host-positioned hardware values into one Bits value, filling every
 * unspecified bit with zero. Layout errors remain host elaboration errors. */
fun pack_fields(width :: PosInt, fields :: List) :~ Bits(width):
  def ordered = fields.map(normalized_pack_field).sort(
    fun (left, right): left[0] < right[0]
  )

  def mutable next_offset = 0
  def mutable fragments = []
  for (field in ordered):
    def offset = field[0]
    def value = field[1]
    def field_width = field[2]
    unless offset >= next_offset
    | error(~who: #'pack_fields, "fields must not overlap")

    unless (offset + field_width) <= width
    | error(~who: #'pack_fields, "field must fit the result width")

    if offset > next_offset
    | fragments := [Bits(offset - next_offset)(0)] ++ fragments
    | #void

    fragments := [value] ++ fragments
    next_offset := offset + field_width

  if next_offset < width
  | fragments := [Bits(width - next_offset)(0)] ++ fragments
  | #void

  if fragments.length() == 1
  | fragments[0]
  | concat(fragments)

/* Computes log2 of an already-validated power-of-two alignment. */
fun unchecked_alignment_bits(alignment :: PosInt):
  /* Halves the alignment while accumulating its exponent until the unit alignment is reached. */
  fun loop(value :: PosInt, bits :: Nat):
    if value == 1
    | bits
    | loop(value / 2, bits + 1)

  loop(alignment, 0)

/* Returns the host exponent of a power-of-two byte alignment. */
fun alignment_bits(alignment :: Pow2Int):
  unchecked_alignment_bits(alignment)

/* Returns operand and low-bit widths after requiring the alignment to fit the hardware address. */
fun checked_alignment_width(value :: Bits,
                            alignment :: Pow2Int,
                            who :: Symbol):
  def width = hardware_value_type(value).packed_width()
  def low_width = unchecked_alignment_bits(alignment)
  unless low_width <= width
  | error(~who: who, "alignment must fit the Bits width")

  values(width, low_width)

/* Tests that the address's alignment bits are zero; unit alignment always succeeds. */
fun is_aligned(value :: Bits, alignment :: Pow2Int) :~ Bool:
  def (_width, low_width) = checked_alignment_width(
    value,
    alignment,
    #'is_aligned
  )
  if low_width == 0
  | Bool(#true)
  | !or_reduce(value[0..low_width])

/* Checks runtime power-of-two alignment within a caller-selected bound.
 * Encodings above max_log2 are unsupported, including for the zero address. */
fun is_aligned_log2(value :: Bits,
                    log2_alignment :: Bits,
                    ~max_log2: max_log2 :: Nat = value.type.packed_width()) :~ Bool:
  unless max_log2 <= value.type.packed_width()
  | error(~who: #'is_aligned_log2, "maximum alignment must fit the Bits width")

  def representable_max = (1 << log2_alignment.type.packed_width()) - 1
  def limit = if max_log2 < representable_max | max_log2 | representable_max
  mux_lookup(
    log2_alignment,
    ~default: Bool(#false),
    for List (exponent in 0..(limit + 1)):
      [exponent, is_aligned(value, 1 << exponent)]
  )

/* Clears the low alignment bits without changing the address width. */
fun align_down(value :: Bits,
               alignment :: Pow2Int) :~ Bits(value.type.packed_width()):
  def (width, _low_width) = checked_alignment_width(
    value,
    alignment,
    #'align_down
  )
  if alignment == 1
  | value
  | value & Bits(width)((1 << width) - alignment)

/* Input bit i controls the consecutive output lane starting at i * lane_width. */
fun expand_mask(mask :: Bits, lane_width :: PosInt) :~ Bits(mask.type.packed_width() * lane_width):
  vec(
    for List (index in 0..mask.type.packed_width()):
      mux(mask[index].into(Bool), Bits(lane_width)((1 << lane_width) - 1), Bits(lane_width)(0))
  ).as_bits()

/* Selects replacement bits where mask is one and original bits where it is zero. */
fun masked_merge(original :: Bits,
                 replacement :: Bits(original.type.packed_width()),
                 mask :: Bits(original.type.packed_width())) :~ Bits(original.type.packed_width()):
  (original & !mask) ||| (replacement & mask)

/* Produces one enable bit per byte of a power-of-two beat. Size is the
 * log2(bytes) transfer encoding used by byte-addressed bus protocols.
 * Transfers wider than the beat produce the all-zero mask. */
fun transfer_byte_mask(address :: Bits,
                       size :: Bits,
                       beat_bytes :: Pow2Int) :~ Mask(beat_bytes):
  def (_width, lane_width) = checked_alignment_width(
    address,
    beat_bytes,
    #'transfer_byte_mask
  )
  def max_size = alignment_bits(beat_bytes)
  def base_mask = mux_lookup(
    size,
    ~default: Bits(beat_bytes)(0),
    for List (encoded_size in 0..(max_size + 1)):
      [encoded_size,
       Bits(beat_bytes)((1 << (1 << encoded_size)) - 1)]
  )

  def lane_offset:
    if lane_width == 0 | Bits(1)(0) | address[0..lane_width]

  (base_mask << lane_offset).into(Mask(beat_bytes))

export:
  wrap_increment
  Pow2Int
  power_of_two
  unsigned_value_count
  reverse_bits
  count_leading_zeros
  pack_fields
  alignment_bits
  is_aligned
  is_aligned_log2
  align_down
  expand_mask
  masked_merge
  transfer_byte_mask
