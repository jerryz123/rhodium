import:
  lib("rhodium/std/decode/pattern.rhdl") open
  lib("rhodium/std/decode/table.rhdl") open
  lib("rhodium/std/decode/generator.rhdl") open

export:
  all_from(lib("rhodium/std/decode/pattern.rhdl"))
  all_from(lib("rhodium/std/decode/table.rhdl"))
  all_from(lib("rhodium/std/decode/generator.rhdl"))
