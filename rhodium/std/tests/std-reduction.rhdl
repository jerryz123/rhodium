#lang rhodium
// Provides arithmetic, aggregate, singleton, and invalid reduction/scan fixtures.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  lib("rhodium/std/reduction.rhdl") open

bundle Candidate():
  valid: Bool
  data: Bits(8)

fun prefer_left(left :: Candidate(), right :: Candidate()) :: Candidate():
  Candidate():
    valid: left.valid ||| right.valid
    data: mux(left.valid, left.data, right.data)

circuit TreeReduction():
  input operands: Vec(5, Bits(8))
  input candidates: Vec(5, Candidate())
  output sum: Bits(8)
  output selected: Candidate()

  def value_list = for List (index in 0..5): operands[index]
  def candidate_list = for List (index in 0..5): candidates[index]
  sum <== tree_reduce(value_list, fun (left, right): left + right)
  selected <== tree_reduce(candidate_list, prefer_left)

circuit SingletonReduction():
  input value: Bits(8)
  output result: Bits(8)

  result <== tree_reduce([value], fun (left, right): left + right)

circuit EmptyReduction():
  output result: Bits(8)

  result <== tree_reduce([], fun (left, right): left + right)

circuit PrefixScanFixture():
  input operands: Vec(9, Bits(8))
  input candidates: Vec(9, Candidate())
  output sums: Vec(9, Bits(8))
  output selected: Vec(9, Candidate())
  output(total, singleton): Bits(8)

  def prefixes = prefix_scan(for List (index in 0..9): operands[index],
                             fun (left, right): left + right)
  sums <== vec(prefixes)
  selected <== vec(prefix_scan(for List (index in 0..9): candidates[index], prefer_left))
  total <== prefixes[8]
  singleton <== prefix_scan([operands[0]], fun (left, right): left + right)[0]

def tree_design = compile_program(elaborate(TreeReduction()), rtl_target).report.design
def singleton_design = compile_program(elaborate(SingletonReduction()), rtl_target).report.design

export:
  Candidate
  TreeReduction
  SingletonReduction
  EmptyReduction
  PrefixScanFixture
  tree_design
  singleton_design
