#lang rhodium
// Provides positive and invalid fixtures for the standard occupancy scoreboard.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/scoreboard.rhdl") open

circuit ScoreboardLookup():
  input busy: Mask(8)
  input index: Bits(3)
  output result: Bool
  result <== scoreboard_busy(8, busy, index)

circuit BadScoreboardLookup():
  input busy: Mask(4)
  input index: Bits(3)
  output result: Bool
  result <== scoreboard_busy(4, busy, index)

circuit NonPowerOfTwoScoreboardLookup():
  input busy: Mask(3)
  input index: Bits(2)
  output result: Bool
  result <== scoreboard_busy(3, busy, index)

circuit SingleScoreboardLookup():
  input busy: Mask(1)
  input index: Bits(1)
  output result: Bool
  result <== scoreboard_busy(1, busy, index)

def lookup_design = elaborate(ScoreboardLookup())
def nonpower_lookup_design = elaborate(NonPowerOfTwoScoreboardLookup())
def single_lookup_design = elaborate(SingleScoreboardLookup())

export:
  ScoreboardLookup
  BadScoreboardLookup
  NonPowerOfTwoScoreboardLookup
  SingleScoreboardLookup
  lookup_design
  nonpower_lookup_design
  single_lookup_design
