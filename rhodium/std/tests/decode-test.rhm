#lang rhodium
// Checks relational DecodeGen elaboration and typed decode-table validation.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm") as hw
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  "../../../rhodium/core/main.rhm" open
  "../../../rhodium/std/decode.rhdl" open
  "../../../examples/std/decode.rhdl" as fixture

def fixture_design = compile_program(fixture.program, rtl_target).report.design

def module_def = fixture_design.modules[0]
def decode_operations = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.decode"
)

def decode_operation = decode_operations[0]

check:
  decode_operations.length() ~is 1
  type_equal(decode_operation.operands[0].type, fixture.Instruction()) ~is #true
  type_equal(decode_operation.results[0].type, fixture.Control()) ~is #true
  decode_operation.attribute("cases") ~is [[0b00000, 0b11110, 0b010, 0b111],
                                           [0b00010, 0b11110, 0b100, 0b110]]
  decode_operation.attribute("default_value") ~is 0
  decode_operation.attribute("default_care") ~is 0b110
  verify_design(fixture_design) ~is #void

circuit WrongSelectorDecoder():
  input encoded: Bits(5)
  output control: fixture.Control()

  control <== fixture.control_decode(encoded)

check:
  compile_program(elaborate(WrongSelectorDecoder()), rtl_target).report.design ~throws "Hardware.of(table.input_type)"

def in_a = Pattern(~value: hw.Bits(4)(0b1000), ~care: hw.Bits(4)(0b1000))
def in_b = Pattern(~value: hw.Bits(4)(0b1010), ~care: hw.Bits(4)(0b1100))
def out = Pattern(~value: hw.Bits(2)(0), ~care: hw.Bits(2)(3))
def crossing = Pattern(~value: hw.Bits(4)(0b0010), ~care: hw.Bits(4)(0b0110))
def selected = Pattern(~value: hw.Bits(2)(1), ~care: hw.Bits(2)(3))
def literal_case = DecodeCase(hw.Bits(4)(0b1111), hw.Bits(2)(0b01))
def literal_table = DecodeTable([literal_case], ~default: hw.Bits(2)(0))
def literal_decode = DecodeGen([literal_case], ~default: hw.Bits(2)(0))
def set_cases = decode_cases(in_a.union(crossing), selected)
def set_decode = DecodeGen(set_cases, ~default: out)

circuit PatternSetDecoder():
  input encoded: Bits(4)
  output result: Bits(2)

  result <== set_decode(encoded)

def set_design = compile_program(elaborate(PatternSetDecoder()), rtl_target).report.design
def set_operation = set_design.modules[0].operations.find(
  fun (operation): operation.opcode == "rtl.decode"
)

check:
  literal_case.input.care_bits ~is 0b1111
  literal_case.output.value_bits ~is 0b01
  literal_table.default.care_bits ~is 0b11
  literal_decode.table.default.care_bits ~is 0b11
  set_cases.length() ~is 3
  set_decode.table.packed_cases.length() ~is 3
  set_operation.attribute("cases").length() ~is 3
  verify_design(set_design) ~is #void
  DecodeTable([DecodeCase(in_a, out), DecodeCase(in_b, out)],
              ~default: out) ~throws "overlap"

  DecodeTable([DecodeCase(in_a, out)],
              ~default: Pattern(~value: hw.Bits(3)(0),
                                ~care: hw.Bits(3)(7))) ~throws "default output type"
