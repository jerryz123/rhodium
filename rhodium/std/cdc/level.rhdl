#lang rhodium
// Defines the canonical resetless two-stage synchronizer for a stable one-bit level.
// SPDX-License-Identifier: Apache-2.0

sync_circuit SyncLevel():
  input level: Bits(1)
  output synchronized: Bits(1)

  reg stage0(Bits(1))
  reg stage1(Bits(1))
  stage0 <== level
  stage1 <== stage0
  synchronized <== stage1

  sync_level_crossing(level, [stage0, stage1])

export:
  SyncLevel
