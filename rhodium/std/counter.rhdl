#lang rhodium
/* Defines the standard enabled counter with a fixed host-selected state count. */
// SPDX-License-Identifier: Apache-2.0

import "bits.rhdl".wrap_increment

/* Counts from zero through n - 1. Wrap is asserted during an enabled cycle at
 * the final value, immediately before the following edge returns value to zero. */
sync_circuit Counter(n :: PosInt):

  def width = index_width(n)
  input enable: Bool
  output value: Bits(width)
  output wrap: Bool

  reg state(~init: Bits(width)(0))
  def at_last = state === Bits(width)(n - 1)

  // Protects the unused encodings when n is not a power of two.
  assert(state <= Bits(width)(n - 1), "counter_state_in_range")

  when enable:
    state <== wrap_increment(state, n)

  value <== state
  wrap <== enable & at_last

export:
  Counter
