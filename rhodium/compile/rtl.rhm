#lang rhombus
/* Prepares verified RTL and composes targets over a shared graph and boundary manifest. */
// SPDX-License-Identifier: Apache-2.0
import:
  "contracts.rhm" open
  "../core/ir.rhm" open
  "../core/signature.rhm".module_signature
  "../lowering/program.rhm" open

export:
  rtl_target
  RTLReport
  PreparedRTL
  RTLTarget
  prepare_rtl

/* Pairs a fresh, verified top closure with the manifest derived from that same graph. */
class PreparedRTL(rtl :: DesignElaboration, manifest :: CompileManifest)

/* Exposes the concrete graph selected by RTL compilation. All references belong
   to the same fresh, verified graph; the caller's source remains untouched. */
class RTLReport(elaboration :: DesignElaboration):
  implements CompilationReport
  property design :: Design: elaboration.design
  property top :: Module: elaboration.top

/* Returns structured RTL without rendering text or invoking another backend. */
class RTLGraphPlan(prepared :: PreparedRTL):
  implements TargetPlan
  /* Preserve the boundary manifest from the one preparation of this graph. */
  override method manifest(): prepared.manifest
  /* Deliver the graph through the ordinary target-owned report projection. */
  override method report(): RTLReport(prepared.rtl)
  /* RTL inspection has no textual artifacts to publish. */
  override method emit(): []

/* Adds prepared-RTL plan construction without imposing RTL on other targets.
   Ordinary compilation prepares once; composition calls plan with its existing
   verified graph and matching manifest, preserving the selected boundary. */
class RTLTarget(build_plan :: Function.of_arity(1)):
  extends CompilationTarget
  nonfinal
  /* Share one checked plan factory between ordinary preparation and composition.
     Plan construction must not clone the graph, rerun certification, or emit text. */
  constructor (name :: String, build_plan :: Function.of_arity(1)):
    /* Require the same prepared input and plan result on both entry paths. */
    fun make_plan(prepared :: PreparedRTL) :: TargetPlan:
      build_plan(prepared)
    super(name, fun (program): make_plan(prepare_rtl(program)))(make_plan)
  /* Reuse the checked plan factory without copying the supplied graph. */
  method plan(prepared :: PreparedRTL) :: TargetPlan:
    build_plan(prepared)

def rtl_target = RTLTarget("rtl", fun (prepared): RTLGraphPlan(prepared))

/* Copy and certify the selected closure, then describe that same physical boundary. */
fun prepare_rtl(program :: DesignElaboration) :: PreparedRTL:
  def rtl = materialize_reachable_rtl(program)
  def manifest = CompileManifest(rtl.top.name, module_signature(rtl.top), rtl.design.modules.map(fun (module_def): module_def.name))
  PreparedRTL(rtl, manifest)
