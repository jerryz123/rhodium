#lang rhombus
/* Defines immutable compile requests, target-owned plans, artifact sets, and lowering manifests. */
// SPDX-License-Identifier: Apache-2.0
import:
  "../core/ir.rhm" open
  "../core/signature.rhm".ModuleSignature
  "../core/construct.rhm".ConstructDefinition

export:
  CompileOptions
  CompilationTarget
  TargetPlan
  Artifact
  LoweringDecision
  CompileManifest
  CompilationResult
  CompilationReport

/* Bounds portable expansion per compilation, including changing-specialization recursion.
   The budget counts distinct expanded definitions, not instance occurrences. */
class CompileOptions(expansion_limit :: PosInt = 256)

/* Names an explicit target and its (program, options) preparation callback.
   The callback owns representation choices; compilation does not consult a registry. */
class CompilationTarget(name :: String, prepare :: Function.of_arity(2)):
  /* Reject an empty target identity before storing its preparation callback. */
  constructor (name :: String, prepare :: Function.of_arity(2)):
    unless name != "" | error(~who: #'CompilationTarget, "target name must not be empty")
    super(name, prepare)

/* An in-memory output with a suggested name and media type.
   Creating an artifact does not write a file or publish external state. */
class Artifact(name :: String, media_type :: String, content :: String):
  /* Require nonempty output names and media types; empty content is permitted. */
  constructor (name :: String, media_type :: String, content :: String):
    unless name != "" && media_type != ""
    | error(~who: #'Artifact, "artifact name and media type must not be empty")
    super(name, media_type, content)

/* Records one construct occurrence and why the target expanded it.
   Paths use source instance names relative to the top; a retained top has an empty
   path. Shared definitions still receive separate entries for each occurrence. */
class LoweringDecision(path :: List.of(String), definition :: ConstructDefinition,
                       action :: String, reason :: String, implementation :: String,
                       location :: maybe(Location) = #false, origin :: maybe(Origin) = #false)
/* Describes the selected physical top, emitted module order, and occurrence decisions.
   The signature is detached from live IR and can describe the artifact boundary. */
class CompileManifest(top :: String, signature :: ModuleSignature,
                      modules :: List.of(String), lowerings :: List.of(LoweringDecision))
/* Target-owned structured findings; hardware emitters may omit this projection. */
interface CompilationReport
/* A completed target result containing its manifest, artifacts, and optional report.
   The compiler constructs it only after preparation and artifact validation succeed. */
class CompilationResult(target :: String, manifest :: CompileManifest,
                        artifacts :: List.of(Artifact), report :: maybe(CompilationReport) = #false)

/* Target-owned prepared state with manifest, artifact, and optional report projections.
   No concrete RTL type is required, so later targets may retain higher-level constructs. */
interface TargetPlan:
  /* Describe this plan's selected boundary and lowering decisions without emitting text. */
  method manifest() :: CompileManifest
  /* Produce all artifacts in memory; failures propagate without a partial result. */
  method emit() :: List.of(Artifact)
  /* Return structured findings when supported; ordinary emission targets default to none. */
  method report() :: maybe(CompilationReport): #false
