#lang rhombus
// Aggregates the curated foundation and standard frontend layers without implementing features.
// SPDX-License-Identifier: Apache-2.0

import:
  "foundation.rhm" open
  "layers/comb.rhm" open
  "layers/comb.rhm".(!) as !
  "layers/comb.rhm".(|||) as |||
  "layers/signed.rhm" open
  "layers/expanding-arithmetic.rhm" open
  "layers/bool.rhm" open
  "layers/enum.rhm" open
  "layers/tagged-union.rhm" open
  "layers/one-hot.rhm" open
  "layers/bundle.rhm" open
  "layers/vector.rhm" open
  "layers/memory.rhm" open
  "layers/sync-memory.rhm" open
  "layers/assertion.rhm" open
  "layers/dpi.rhm" open
  "layers/interface.rhm" open
  "layers/wire.rhm" open
  "layers/sequential.rhm" open
  "layers/conditional.rhm" open
  "layers/hierarchy.rhm" open
  "layers/sync.rhm" open
  "layers/clocking.rhm" open

export:
  !
  |||
  all_from("foundation.rhm")
  all_from("layers/comb.rhm")
  all_from("layers/signed.rhm")
  all_from("layers/expanding-arithmetic.rhm")
  all_from("layers/bool.rhm")
  all_from("layers/enum.rhm")
  all_from("layers/tagged-union.rhm")
  all_from("layers/one-hot.rhm")
  all_from("layers/bundle.rhm")
  all_from("layers/vector.rhm")
  all_from("layers/memory.rhm"):
    except MemoryFields
  all_from("layers/sync-memory.rhm")
  all_from("layers/assertion.rhm")
  all_from("layers/dpi.rhm")
  all_from("layers/interface.rhm"):
    except InterfaceFields
  all_from("layers/wire.rhm")
  all_from("layers/sequential.rhm")
  all_from("layers/conditional.rhm")
  all_from("layers/hierarchy.rhm")
  all_from("layers/sync.rhm")
  all_from("layers/clocking.rhm")
