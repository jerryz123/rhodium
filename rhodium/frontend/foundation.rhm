#lang rhombus/and_meta
// Defines the foundational circuit, port, connection, and elaboration surface shared by Rhodium profiles.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/meta open
  "../core/types.rhm" open
  "kernel.rhm".StableCircuitParam
  "kernel.rhm".input as kernel_input
  "kernel.rhm".output as kernel_output
  "kernel.rhm".build_circuit as kernel_build_circuit
  "kernel.rhm".run_circuit_finalizers as kernel_run_circuit_finalizers
  "kernel.rhm".new_circuit_identity as kernel_new_circuit_identity
  "kernel.rhm".run_elaboration as kernel_run_elaboration
  "kernel.rhm".run_elaboration_with_top as kernel_run_elaboration_with_top
  "kernel.rhm".connect as kernel_connect
  "support/fields.rhm".HardwareFields
  "support/fields.rhm".AnyBitsHardware
  "support/fields.rhm".Bool
  "support/fields.rhm".bool_type
  "support/fields.rhm".CircuitMemberFields
  "support/fields.rhm".ValueSurfaceFields
  "support/generator-parameters.rhm".GeneratorParameter
  "support/generator-parameters.rhm".substitute_generator_parameters
  "support/hardware-types.rhm".hardware_type
  "support/fields.rhm".hardware_value_type
  "support/hardware-literal.rhm".HardwareLiteral

annot.macro
| 'Bits($width)': 'HardwareFields.of(Bits($width))'
| 'Bits': 'AnyBitsHardware'

annot.macro 'Clock':
  'HardwareFields.of(Clock)'

annot.macro 'Reset':
  'HardwareFields.of(Reset)'

export:
  StableCircuitParam
  HardwareType
  DataType
  ScalarDataType
  Bits
  Bool
  bool_type
  Clock
  Reset
  HardwareLiteral
  hardware_type
  hardware_value_type
  data_type
  rename:
    HardwareFields as Hardware
  input
  output
  <==
  circuit
  elaborate
  elaborate_with_top

defn.macro 'input $bindings: $(type :: expr_meta.Parsed)':
  match bindings
  | '$(name :: Identifier)':
      def port_name = name.to_source_string()
      'def $name :: HardwareFields.from_type($type) = kernel_input($port_name, $type)'
  | '($(name :: Identifier), ...)':
      let [port_name, ...] = [name.to_source_string(), ...]
      '«
         def $name :: HardwareFields.from_type($type) = kernel_input($port_name, $type)
         ...
       »'
  | ~else:
      syntax_meta.error("expected a port binding or parenthesized port bindings",
                        bindings)

defn.macro 'output $bindings: $(type :: expr_meta.Parsed)':
  match bindings
  | '$(name :: Identifier)':
      def port_name = name.to_source_string()
      'def $name :: HardwareFields.from_type($type) = kernel_output($port_name, $type)'
  | '($(name :: Identifier), ...)':
      let [port_name, ...] = [name.to_source_string(), ...]
      '«
         def $name :: HardwareFields.from_type($type) = kernel_output($port_name, $type)
         ...
       »'
  | ~else:
      syntax_meta.error("expected a port binding or parenthesized port bindings",
                        bindings)

defn.macro 'circuit $(name :: Identifier)($(argument :: GeneratorParameter), ...): $body; ...':
  def circuit_name = name.to_source_string()
  def implementation_name = Syntax.make_id(circuit_name ++ "_circuit", name)
  def parameter_names = [argument.binding.to_source_string(), ...]
  def mutable body_local_names = []
  for (item in [body, ...]):
    match item
    | 'def $(local_name :: Identifier) $tail ...':
        body_local_names := body_local_names ++ [local_name.to_source_string()]
    | 'fun $(local_name :: Identifier) $tail ...':
        body_local_names := body_local_names ++ [local_name.to_source_string()]
    | ~else: #void
  fun static_type_available(port_type :: Syntax):
    match port_type
    | '$(type_name :: Identifier)':
        !body_local_names.find(
          fun (local_name): local_name == type_name.to_source_string()
        )
    | '$constructor($type_argument, ...)':
        def mutable available = static_type_available(constructor)
        for (item in [type_argument, ...]):
          unless static_type_available(item)
          | available := #false
        available
    | ~else: #false
  def mutable member_entries = []
  def mutable fallback_member_entries = []
  fun type_depends_on_parameter(member_type :: Syntax):
    match member_type
    | '$(type_name :: Identifier)':
        parameter_names.find(
          fun (parameter_name):
            parameter_name == type_name.to_source_string()
        ) != #false
    | '$constructor($type_argument, ...)':
        def mutable depends = type_depends_on_parameter(constructor)
        for (item in [type_argument, ...]):
          when type_depends_on_parameter(item)
          | depends := #true
        depends
    | ~else: #true
  fun retain_data_member(member_name :: Syntax, member_type :: Syntax):
    when static_type_available(member_type)
    | def entry = '$member_name: HardwareFields.from_type($member_type)'
      member_entries := member_entries ++ [entry]
      unless type_depends_on_parameter(member_type)
      | fallback_member_entries := fallback_member_entries ++ [entry]
  fun retain_interface_member(member_name :: Syntax,
                              member_type :: Syntax,
                              array :: Boolean):
    when static_type_available(member_type)
    | def entries = (
        if array
        | ['$member_name: Array.later_of(ValueSurfaceFields($member_type))']
        | ['$member_name: ValueSurfaceFields($member_type)']
      )
      member_entries := member_entries ++ entries
      unless type_depends_on_parameter(member_type)
      | fallback_member_entries := fallback_member_entries ++ entries
  for (item in [body, ...]):
    match item
    | 'input $(port_name :: Identifier): $port_type':
        retain_data_member(port_name, port_type)
    | 'input ($(port_name :: Identifier), ...): $port_type':
        for (bound_name in [port_name, ...]):
          retain_data_member(bound_name, port_type)
    | 'output $(port_name :: Identifier): $port_type':
        retain_data_member(port_name, port_type)
    | 'output ($(port_name :: Identifier), ...): $port_type':
        for (bound_name in [port_name, ...]):
          retain_data_member(bound_name, port_type)
    | 'interface $(member_name :: Identifier)($member_type, ~role: $role)':
        retain_interface_member(member_name, member_type, #false)
    | 'interface $(member_name :: Identifier)[$length]($member_type, ~role: $role)':
        retain_interface_member(member_name, member_type, #true)
    | ~else: #void
  let [member_entry, ...] = member_entries
  let [fallback_member_entry, ...] = fallback_member_entries
  let [parameter_binding, ...] = [argument.binding, ...]
  fun substitute_parameters(form :: Syntax):
    match form
    | 'HardwareFields.from_type($type)':
        def substituted_type = substitute_parameters(type)
        'HardwareFields.from_type($substituted_type)'
    | 'ValueSurfaceFields($type)':
        def substituted_type = substitute_parameters(type)
        'ValueSurfaceFields($substituted_type)'
    | 'Array.later_of(ValueSurfaceFields($type))':
        def substituted_type = substitute_parameters(type)
        'Array.later_of(ValueSurfaceFields($substituted_type))'
    | ~else:
        substitute_generator_parameters(form, [parameter_binding, ...])
  let [substituted_member_entry, ...]:
    for List (entry in member_entries):
      match entry
      | '$(member_name :: Identifier): $annotation':
          def substituted_annotation = substitute_parameters(annotation)
          '$member_name: $substituted_annotation'
      | ~else: syntax_meta.error("invalid circuit member surface", entry)
  let [implementation_argument, ...]:
    for List (parameter in [argument, ...]):
      match parameter
      | '$(keyword :: Keyword): $(binding :: Identifier) $tail ...':
          '$keyword: $binding'
      | ~else: parameter.binding
  def mutable required_positional = #true
  for (parameter in [argument, ...]):
    match parameter
    | '$(binding :: Identifier)': #void
    | '$(binding :: Identifier) :: $annotation': #void
    | ~else: required_positional := #false
  def definition = '«
     def circuit_identity = kernel_new_circuit_identity($circuit_name)
     fun $implementation_name($argument, ...):
       fun implementation():
         $body
         ...
         kernel_run_circuit_finalizers()
       kernel_build_circuit(circuit_identity,
                            $circuit_name,
                            [$argument.binding, ...],
                            implementation)
   »'
  if [argument, ...].length() == 0
  | '«
       $definition
       fun $name() :~ CircuitMemberFields($member_entry, ...):
         $implementation_name()
     »'
  | if required_positional
    | '«
       $definition
       expr.macro
       | '$name($('$')$parameter_binding, ...)':
           '(block:
              def $parameter_binding = $('$')$parameter_binding
              ...
              $implementation_name($parameter_binding, ...)) :: CircuitMemberFields($substituted_member_entry, ...)'
       | '$name': '$implementation_name'
      »'
    | '«
       $definition
       fun $name($argument, ...) :~ CircuitMemberFields($fallback_member_entry, ...):
         $implementation_name($implementation_argument, ...)
      »'

expr.macro 'elaborate($body)':
  'kernel_run_elaboration(fun (): $body)'

expr.macro 'elaborate_with_top($body)':
  'kernel_run_elaboration_with_top(fun (): $body)'

operator (place <== entity):
  ~weaker_than: ~other
  kernel_connect(place, entity)
