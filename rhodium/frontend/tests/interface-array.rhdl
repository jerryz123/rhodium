#lang rhodium
// Provides valid and invalid endpoint-array, handle, and sink test circuits.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/ready-valid.rhdl") open

interface BidirectionalByte():
  role requester
  role responder

  requester -> responder:
    command: Bits(8)

  responder -> requester:
    response: Bits(8)

circuit IndexedInterfaceArrayAdapter(n):
  interface ingress[n](Decoupled(Bits(8)), ~role: consumer)
  interface egress[n](Decoupled(Bits(8)), ~role: producer)

  for (index in 0..n):
    ingress[index] |> egress[index]

circuit ParenthesizedInterfaceArrayLengthMismatch():
  interface ingress0(Decoupled(Bits(8)), ~role: consumer)
  interface ingress1(Decoupled(Bits(8)), ~role: consumer)
  interface ingress2(Decoupled(Bits(8)), ~role: consumer)
  interface egress[2](Decoupled(Bits(8)), ~role: producer)

  egress <=> (ingress0, ingress1, ingress2)

circuit ParenthesizedInterfaceArrayNamedMember():
  interface ingress0(Decoupled(Bits(8)), ~role: consumer)
  interface ingress1(Decoupled(Bits(8)), ~role: consumer)
  interface egress[2](Decoupled(Bits(8)), ~role: producer)

  egress <=> (ingress0, ~second: ingress1)

circuit InterfaceArrayTypeOnce(n):
  def mutable evaluations = 0
  fun counted_type():
    evaluations := evaluations + 1
    Decoupled(Bits(8))

  interface links[n](counted_type(), ~role: consumer)
  interface peers[n](Decoupled(Bits(8)), ~role: producer)
  peers <=> links
  unless evaluations == 1
  | error("interface array type expression was evaluated more than once")
  #void

// Direct handle-end access keeps endpoint field information for local links.
circuit InterfaceHandleEnds():
  input source_valid: Bool
  input source_bits: Bits(8)
  output sink_valid: Bool
  output sink_bits: Bits(8)

  def link :: Handle = interface_link(Valid(Bits(8)), "local")
  link.left.valid <== source_valid
  link.left.bits <== source_bits
  sink_valid <== link.right.valid
  sink_bits <== link.right.bits

// A sink can consume an earlier handle before any concrete source is
// attached, retaining only the earlier handle's input end.
circuit ComposedInterfaceSinkAdapter():
  interface ingress(BidirectionalByte(), ~role: responder)
  interface egress(BidirectionalByte(), ~role: requester)

  def sink = interface_link(BidirectionalByte(), "second") |> egress
  def composed = interface_link(BidirectionalByte(), "first") |> sink
  ingress |> composed

circuit ReusedInterfaceHandle():
  interface ingress[2](Decoupled(Bits(8)), ~role: consumer)
  def path = interface_link(Decoupled(Bits(8)))
  ingress[0] |> path
  ingress[1] |> path

circuit ReusedInterfaceSink():
  interface ingress[2](Decoupled(Bits(8)), ~role: consumer)
  interface egress(Decoupled(Bits(8)), ~role: producer)

  def sink = interface_link(Decoupled(Bits(8))) |> egress
  ingress[0] |> sink
  ingress[1] |> sink

circuit MixedParallelInterfacePaths():
  interface ingress[2](Decoupled(Bits(8)), ~role: consumer)
  interface egress(Decoupled(Bits(8)), ~role: producer)

  ingress |> parallel_handles(Array(
    interface_link(Decoupled(Bits(8))),
    interface_link(Decoupled(Bits(8))) |> egress
  ))

circuit ParallelInterfaceSinkLengthMismatch():
  interface ingress[3](Decoupled(Bits(8)), ~role: consumer)
  interface egress[2](Decoupled(Bits(8)), ~role: producer)

  ingress |> parallel_handles(Array(
    interface_link(Decoupled(Bits(8))) |> egress[0],
    interface_link(Decoupled(Bits(8))) |> egress[1]
  ))

circuit InterfaceSinkTypeMismatch():
  interface egress(Decoupled(Bits(16)), ~role: producer)
  interface_link(Decoupled(Bits(8))) |> egress

export:
  BidirectionalByte
  IndexedInterfaceArrayAdapter
  ParenthesizedInterfaceArrayLengthMismatch
  ParenthesizedInterfaceArrayNamedMember
  InterfaceArrayTypeOnce
  InterfaceHandleEnds
  ComposedInterfaceSinkAdapter
  ReusedInterfaceHandle
  ReusedInterfaceSink
  MixedParallelInterfacePaths
  ParallelInterfaceSinkLengthMismatch
  InterfaceSinkTypeMismatch
