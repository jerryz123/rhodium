#lang rhodium

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target

// Builds eager and retained combinational children inside ordinary and clocked RTL parents.
// SPDX-License-Identifier: Apache-2.0

def signature = ModuleSignature([PortSignature("a", Bits(8)), PortSignature("b", Bits(8))], [PortSignature("result", Bits(8))])
def dependencies = [[OutputLeafDependency([], [InputLeaf(0, []), InputLeaf(1, [])])]]
def definition = ConstructDefinition(ConstructIdentity("Sum"), [8], signature, dependencies)
def mutable calls = 0

circuit Sum():
  input (a, b): Bits(8)
  output result: Bits(8)
  result <== a + b

def reference = retained_circuit(
  definition,
  fun ():
    calls := calls + 1
    Sum()
)

circuit Parent(retain):
  input (a, b): Bits(8)
  output result: Bits(8)
  inst first(if retain | reference | Sum())
  inst second(if retain | reference | Sum())
  first.a <== a
  first.b <== b
  second.a <== first.result
  second.b <== b
  result <== second.result

sync_circuit Clocked(retain):
  input (a, b): Bits(8)
  output result: Bits(8)
  inst child(if retain | reference | Sum())
  child.a <== a
  child.b <== b
  reg stored(~init: bits(0, 8))
  stored <== child.result
  result <== stored

def nested_definition = ConstructDefinition(ConstructIdentity("Nested"), [], signature, dependencies)
circuit Nested():
  input (a, b): Bits(8)
  output result: Bits(8)
  inst child(reference)
  child.a <== a
  child.b <== b
  result <== child.result
def nested = retained_circuit(nested_definition, fun (): Nested())
circuit NestedParent():
  input (a, b): Bits(8)
  output result: Bits(8)
  inst child(nested)
  child.a <== a
  child.b <== b
  result <== child.result

def program = elaborate(Parent(#true))
def clocked_program = elaborate(Clocked(#true))
def nested_program = elaborate(NestedParent())
def calls_after_elaboration = calls
def eager = compile_program(elaborate(Parent(#false)), rtl_target).report.elaboration
def clocked_eager = compile_program(elaborate(Clocked(#false)), rtl_target).report.elaboration
fun call_count(): calls

export:
  signature
  dependencies
  definition
  reference
  program
  clocked_program
  nested_program
  eager
  clocked_eager
  calls_after_elaboration
  call_count
  Parent
  Sum
