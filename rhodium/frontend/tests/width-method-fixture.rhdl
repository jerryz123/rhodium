#lang rhodium

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target

// Exercises receiver width extension through precise frontend value producers.
// SPDX-License-Identifier: Apache-2.0

bundle WidthPair():
  unsigned: Bits(4)
  signed: SInt(4)

interface WidthStream():
  role producer
  role consumer
  provider producer

  producer -> consumer:
    bits: Bits(4)

circuit WidthSource():
  input value: Bits(4)
  interface egress(WidthStream(), ~role: producer)
  egress.bits <== value

circuit WidthEcho():
  input value: Bits(4)
  output echoed: Bits(4)
  echoed <== value

fun generic_zext(value :: Hardware, target_width :: PosInt):
  value.zext(target_width)

sync_circuit WidthMethodPropagation():
  input unsigned: Bits(4)
  input signed: SInt(4)
  input pair: WidthPair()
  input vector_values: Vec(2, Bits(4))
  input address: Bits(1)
  output direct_unsigned: Bits(8)
  output direct_signed: SInt(8)
  output field_unsigned: Bits(8)
  output field_signed: SInt(8)
  output vector_unsigned: Bits(8)
  output memory_unsigned: Bits(8)
  output instance_unsigned: Bits(8)
  output interface_unsigned: Bits(8)
  output chained_unsigned: Bits(12)
  output chained_signed: SInt(12)
  output chained_signed_bits: Bits(12)
  output converted_signed_bits: Bits(8)
  output concatenated_unsigned: Bits(8)
  output generic_unsigned: Bits(8)

  mem stored_values(2, Bits(4))
  inst echo(WidthEcho())
  inst source(WidthSource())

  echo.value <== unsigned
  source.value <== unsigned
  direct_unsigned <== unsigned.zext(8, "named_unsigned")
  direct_signed <== signed.sext(8, "named_signed")
  field_unsigned <== pair.unsigned.zext(8)
  field_signed <== pair.signed.sext(8)
  vector_unsigned <== vector_values[0].zext(8)
  memory_unsigned <== stored_values.read(address).zext(8)
  instance_unsigned <== echo.echoed.zext(8)
  interface_unsigned <== source.egress.bits.zext(8)
  chained_unsigned <== unsigned.zext(8).zext(12)
  chained_signed <== signed.sext(8).sext(12)
  chained_signed_bits <== signed.sext(12).as_bits()
  converted_signed_bits <== unsigned.sext(4).sext(8).sext(8)
  concatenated_unsigned <== (unsigned[0..2] ++ unsigned[2..4]).zext(8)
  generic_unsigned <== generic_zext(unsigned, 8)

def design = compile_program(elaborate(WidthMethodPropagation()), rtl_target).report.design

circuit WidthExtension():
  input value: Bits(4)
  input signed_value: SInt(4)
  input bit: Bits(1)
  output sign: Bits(12)
  output zero: Bits(12)
  output same: Bits(4)
  output ssame: SInt(4)
  output signed_result: SInt(12)
  output tiny: Bits(12)
  output wide_low: Bits(64)
  output wide_mid: Bits(64)
  output wide_top: Bits(1)

  def extend = value.sext
  sign <== extend(4).sext(8).sext(12)
  zero <== value.zext(4).zext(12)
  same <== value.sext(4).zext(4)
  ssame <== signed_value.sext(4)
  signed_result <== signed_value.sext(4).sext(12)
  tiny <== bit.sext(12)
  def wide = value.sext(129)
  wide_low <== wide[0..64]
  wide_mid <== wide[64..128]
  wide_top <== wide[128]

def program = elaborate(WidthExtension())

export:
  program
  WidthPair
  WidthStream
  WidthSource
  WidthEcho
  WidthMethodPropagation
  design
