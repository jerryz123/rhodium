#lang rhodium
// Exercises receiver membership across generic and specialized flat-data surfaces.
// SPDX-License-Identifier: Apache-2.0

def Mask3 = Mask(3)
def Exact3 = OneHot(3)
def Optional3 = MaybeOneHot(3)

tagged_union MembershipUnion:
  Empty
  Value(Bits(2))

fun generic_membership(value :: Hardware,
                       alternatives :: List.of(HardwareLiteral)):
  value.is_one_of(alternatives)

circuit MembershipSurfaces():
  input bool_value: Bool
  input signed_value: SInt(4)
  input mask_value: Mask3
  input exact_value: Exact3
  input optional_value: Optional3
  input union_value: MembershipUnion
  input generic_bits: Bits(4)
  output bool_member: Bool
  output signed_member: Bool
  output mask_member: Bool
  output exact_member: Bool
  output optional_member: Bool
  output union_member: Bool
  output generic_member: Bool

  bool_member <== bool_value.is_one_of(Bool(#true))
  signed_member <== signed_value.is_one_of(sint(1, 4), sint(-1, 4))
  mask_member <== mask_value.is_one_of(Mask3(0b001), Mask3(0b100))
  exact_member <== exact_value.is_one_of(Exact3(0), Exact3(2))
  optional_member <== optional_value.is_one_of(Optional3(), Optional3(1))
  union_member <== union_value.is_one_of(MembershipUnion.Empty,
                                         MembershipUnion.Value(bits(1, 2)))
  generic_member <== generic_membership(generic_bits,
                                        [bits(3, 4), bits(12, 4)])

def design = elaborate(MembershipSurfaces())

export:
  MembershipSurfaces
  design
