#lang rhodium/base

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target

// Exercises foundational zero extension without importing optional frontend layers.
// SPDX-License-Identifier: Apache-2.0

circuit BaseWidthMethod():
  input value: Bits(4)
  output widened: Bits(8)

  widened <== value.zext(8)

def design = compile_program(elaborate(BaseWidthMethod()), rtl_target).report.design

export:
  BaseWidthMethod
  design
