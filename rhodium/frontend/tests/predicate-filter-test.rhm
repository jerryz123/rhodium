#lang rhombus
// Checks stable predicate-policy parameters elaborate inline in one Valid module.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  "../../../rhodium/core/main.rhm" open
  "../../../examples/rtl/predicate-filter.rhdl" as fixture

def fixture_design = compile_program(fixture.program, rtl_target).report.design

def top = fixture_design.modules.find(
  fun (module_def): module_def.name == "SingleEvenFilter"
)
def instances = top.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.instance"
)

check:
  fixture_design.modules.length() ~is 1
  top.inputs.map(fun (port): port.name) ~is ["ingress_in"]
  top.outputs.map(fun (port): port.name) ~is ["egress_out"]
  instances.length() ~is 0
  top.operations.find(
    fun (operation): operation.opcode == "rtl.ult"
  ) != #false ~is #true
  top.operations.find(
    fun (operation): operation.opcode == "rtl.extract"
  ) != #false ~is #true
  top.operations.find(
    fun (operation): operation.opcode == "rtl.constant" && operation.attribute("value") == 9
  ) != #false ~is #true
  verify_design(fixture_design) ~is #void
