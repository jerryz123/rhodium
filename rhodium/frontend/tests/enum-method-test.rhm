#lang rhombus
// Checks enum-owned hardware methods and exact static-information propagation.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  "../../../rhodium/core/main.rhm" open
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../rhodium/frontend/layers/enum.rhm".enum_encoding
  "../../../rhodium/frontend/layers/enum.rhm".enum_width
  "../../../rhodium/frontend/layers/enum.rhm".enum_names
  "../../../rhodium/frontend/layers/enum.rhm".enum_values
  "enum-method-fixture.rhdl" as fixture

def module_def = fixture.design.modules[0]
def onehot_muxes = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.onehot_mux"
)

check:
  fixture.CacheState.names() ~is ["Invalid", "SharedClean", "SharedDirty", "UniqueClean"]
  fixture.SparseState.values().map(fun (value): value.packed_value()) ~is [1, 5]
  fixture.WideState.values().map(fun (value): value.packed_value()) ~is [0, 1]
  fixture.OneHotState.values().map(fun (value): value.packed_value()) ~is [1, 2, 4]
  fixture.ReflectionCollision.values.packed_value() ~is 7
  fixture.ReflectionCollision.names.packed_value() ~is 1
  enum_names(fixture.ReflectionCollision) ~is ["values", "names"]
  enum_values(fixture.ReflectionCollision).map(fun (value): value.packed_value()) ~is [7, 1]
  dump_ir(compile_program(elaborate(fixture.EnumeratedMethods(#true)), rtl_target).report.design) ~is dump_ir(compile_program(elaborate(fixture.EnumeratedMethods(#false)), rtl_target).report.design)
  record_type(module_def.find_input("envelope").type) ~is #true
  enum_width(fixture.SparseState) ~is 3
  enum_encoding(fixture.SparseState, "Cold") ~is 1
  enum_encoding(fixture.SparseState, "Warm") ~is 5
  enum_width(fixture.WideState) ~is 4
  enum_width(fixture.OneHotState) ~is 3
  enum_encoding(fixture.OneHotState, "Idle") ~is 1
  enum_encoding(fixture.OneHotState, "Read") ~is 2
  enum_encoding(fixture.OneHotState, "Write") ~is 4
  onehot_muxes.length() ~is 1
  verify_design(fixture.design) ~is #void

// Annotating helpers changes neither the selection IR nor its concrete widths.
for (width in [8, 16]):
  def direct = compile_program(elaborate(fixture.AnnotatedBundleSelection(width, #false)), rtl_target).report.design
  def annotated = compile_program(elaborate(fixture.AnnotatedBundleSelection(width, #true)), rtl_target).report.design
  check:
    dump_ir(annotated) ~is dump_ir(direct)
    verify_design(annotated) ~is #void

check:
  elaborate(fixture.WrongBundleSpecialization()) ~throws "annotation"
