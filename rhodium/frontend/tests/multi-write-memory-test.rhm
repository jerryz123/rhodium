#lang rhombus
// Checks that independent memory writes become same-clock physical write ports.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  "../../../rhodium/core/main.rhm" open
  "../../../examples/rtl/multi-write-memory.rhdl" as fixture

def fixture_design = compile_program(fixture.program, rtl_target).report.design

def module_def = fixture_design.modules[0]
def memory = module_def.memories[0]
def writes = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.memory_write"
)

check:
  writes.length() ~is 2
  (for all (write in writes): write.attribute("memory") === memory) ~is #true
  (for all (write in writes):
     write.operands[2] === module_def.find_input("clock").value) ~is #true
  writes[0].operands[0].name ~is "first_address"
  writes[1].operands[0].name ~is "second_address"
  verify_design(fixture_design) ~is #void
