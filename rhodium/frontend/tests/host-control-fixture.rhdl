#lang rhodium
// Exercises ordinary Rhombus host control with hardware objects in the standard profile.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  rhombus.(!) as host_invert

circuit HostControl():
  input signal: Bits(1)
  input fallback: Bits(1)
  output(if_selected,
         unless_selected,
         cond_selected,
         and_selected,
         or_selected,
         host_inverted_selected): Bits(1)

  if signal
  | if_selected <== signal
  | if_selected <== fallback

  unless signal
  | error("a hardware object must be truthy in host control")
  unless_selected <== signal

  cond
  | signal: cond_selected <== signal
  | ~else: cond_selected <== fallback

  if signal && #true
  | and_selected <== signal
  | and_selected <== fallback

  if signal || #false
  | or_selected <== signal
  | or_selected <== fallback

  if host_invert(signal)
  | host_inverted_selected <== signal
  | host_inverted_selected <== fallback

def design = compile_program(elaborate(HostControl()), rtl_target).report.design

export:
  design
