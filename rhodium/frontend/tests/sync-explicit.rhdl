#lang rhodium

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target

// Constructs the sync-counter hierarchy with fully explicit clock and reset wiring.
// SPDX-License-Identifier: Apache-2.0

circuit Counter(width):
  input clock: Clock
  input reset: Reset
  output count: Bits(width)

  def zero = Bits(width)(0)
  reg state(Bits(width), ~clock: clock, ~reset: reset, ~init: zero)
  def one = Bits(width)(1)
  state <== state + one
  count <== state

circuit CounterTop(width):
  input clock: Clock
  input reset: Reset
  output count: Bits(width)

  def CounterModule = Counter(width)
  inst counter(CounterModule)
  counter.clock <== clock
  counter.reset <== reset
  count <== counter.count

def design = compile_program(elaborate(CounterTop(8)), rtl_target).report.design

export:
  Counter
  CounterTop
  design
