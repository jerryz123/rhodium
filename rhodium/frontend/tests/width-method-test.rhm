#lang rhombus
// Checks receiver width lowering, result types, naming, and producer propagation.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../rhodium/core/main.rhm" open
  "../../../rhodium/frontend/layers/signed.rhm" as signed
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/backend/circt-target.rhm").circt_target
  lib("rhodium/backend/verilog-target.rhm").verilog_target
  "base-width-method-fixture.rhdl" as base_fixture
  "width-method-fixture.rhdl" as fixture

def module_def = fixture.design.modules.find(
  fun (candidate): candidate.name == "WidthMethodPropagation"
)

def extensions = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.zext"
)

def signed_extensions = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.sext"
)

def base_module = base_fixture.design.modules[0]

check:
  extensions.length() ~is 10
  signed_extensions.length() ~is 6
  extensions.find(fun (operation): operation.results[0].name == "named_unsigned") != #false ~is #true
  signed_extensions.find(fun (operation): operation.results[0].name == "named_signed") != #false ~is #true
  module_def.find_output("chained_unsigned").type.width ~is 12
  signed.sint_type(module_def.find_output("chained_signed").type) ~is #true
  module_def.find_output("chained_signed").type.width ~is 12
  bits_type(module_def.find_output("chained_signed_bits").type) ~is #true
  base_module.find_output("widened").type.width ~is 8
  verify_design(fixture.design) ~is #void
  verify_design(base_fixture.design) ~is #void

def signed_bits = signed_extensions.find(fun (operation): type_equal(operation.results[0].type, Bits(8)))
check:
  signed_bits != #false ~is #true
  bits_type(signed_bits.operands[0].type) ~is #true
  compile_program(fixture.program, circt_target).artifacts[0].content.contains("comb.concat") ~is #true
  compile_program(fixture.program, verilog_target).artifacts[0].content.contains("[3]") ~is #true
