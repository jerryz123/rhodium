#lang rhombus
// Checks selectable frontend clocking declarations, reports, and profile-independent hardware IR.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../rhodium/core/main.rhm" open
  "../../../rhodium/analysis/clocking.rhm" open
  "../../../rhodium/compile/program.rhm".compile_program
  "clocking-composed.rhdl" as composed
  "clocking-standard.rhdl" as standard

fun local_sink(summary, name):
  summary.sinks.find(
    fun (sink): sink.instance_path.length() == 0 && sink.operation.attribute("name", #false) == name
  )

fun next_classification(summary, name):
  local_sink(summary, name).inputs.find(
    fun (input): input.name == "next"
  ).classification

def compiled = compile_program(composed.program, clocking_target())
def clocked = compiled.report
def standard_report = compile_program(standard.program, clocking_target()).report
def summary = clocked.summary

check:
  clocked is_a ClockingReport ~is #true
  clocked.design === clocked.elaboration.design ~is #true
  clocked.top === clocked.elaboration.top ~is #true
  clocked.environment.input_contracts.length() ~is 7
  clocked.environment.clock_relationships.length() ~is 4
  summary.elaboration === clocked.elaboration ~is #true
  summary.environment === clocked.environment ~is #true
  next_classification(summary, "same_sink") is_a SameClock ~is #true
  next_classification(summary, "identical_sink") is_a IdenticalClock ~is #true
  next_classification(summary, "derived_sink") is_a DerivedClock ~is #true
  next_classification(summary, "asynchronous_clock_sink") is_a AsynchronousClock ~is #true
  next_classification(summary, "exclusive_sink") is_a ExclusiveClock ~is #true
  next_classification(summary, "asynchronous_input_sink") is_a AsynchronousEnvironmentInput ~is #true
  next_classification(summary, "unknown_input_sink") is_a UnknownInput ~is #true
  dump_ir(clocked.design) ~is dump_ir(standard_report.design)
  verify_design(clocked.design) ~is #void
