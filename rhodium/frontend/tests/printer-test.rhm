#lang rhombus
// Checks deterministic IR printing using designs elaborated by the frontend.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  "../../../rhodium/core/main.rhm" open
  "../../../examples/lop/adder-standard.rhdl" as adder_fixture
  "../../../examples/rtl/alu.rhdl" as alu_fixture
  "../../../examples/rtl/width-ops.rhdl" as width_fixture
  "../../../examples/rtl/counter.rhdl" as counter_fixture

def adder_fixture_design = compile_program(adder_fixture.program, rtl_target).report.design
def alu_fixture_design = compile_program(alu_fixture.program, rtl_target).report.design
def width_fixture_design = compile_program(width_fixture.program, rtl_target).report.design
def counter_fixture_design = compile_program(counter_fixture.program, rtl_target).report.design

def first = dump_ir(adder_fixture_design)
def second = dump_ir(adder_fixture_design)

check:
  first ~is second
  first.contains("rhodium.module @Adder") ~is #true
  first.contains("%v7 = rtl.add %a, %b : bits<8>") ~is #true
  first.contains("rtl.drive &sum, %v7") ~is #true

def counter_ir = dump_ir(counter_fixture_design)

check:
  counter_ir.contains("in %clock: clock") ~is #true
  counter_ir.contains("in %reset: reset") ~is #true
  counter_ir.contains("in %inc: bool") ~is #true
  counter_ir.contains("in %amt: bits<4>") ~is #true
  counter_ir.contains("rtl.register clock %clock reset %reset") ~is #true
  counter_ir.contains("rtl.drive &x.next") ~is #true
  counter_ir.contains("rtl.mux_lookup") ~is #true

def alu_ir = dump_ir(alu_fixture_design)

check:
  alu_ir.contains("out &equal: bool") ~is #true
  alu_ir.contains(" = rtl.not %a : bits<8>") ~is #true
  alu_ir.contains(" = rtl.eq %a, %b : bits<1>") ~is #true
  alu_ir.contains(" = rtl.cast ") ~is #true
  alu_ir.contains(" = rtl.mux_lookup %op [0:") ~is #true

def width_ir = dump_ir(width_fixture_design)

check:
  width_ir.contains("%v13 = rtl.concat %a, %b : bits<12>") ~is #true
  width_ir.contains("%v16 = rtl.extract %a 5:2 : bits<4>") ~is #true
  width_ir.contains("%v19 = rtl.zext %a to bits<12>") ~is #true
  width_ir.contains("%v22 = rtl.trunc %a to bits<4>") ~is #true
