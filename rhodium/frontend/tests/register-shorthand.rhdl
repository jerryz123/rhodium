#lang rhodium/base
// Exercises inferred-type and immediate-next register forms in ambient and explicit domains.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/layers/sequential.rhm") open
  lib("rhodium/frontend/layers/sync.rhm") open

sync_circuit AmbientShorthand():
  input(data_in, reset_only_next, init_value): Bits(8)
  output(a, b, c, d, e): Bits(8)

  reg inferred_init(~init: init_value)
  inferred_init <== data_in
  reg inferred_next(~next: data_in)
  reg inferred_both(~init: init_value, ~next: reset_only_next)
  reg typed(Bits(8))
  typed <== inferred_both
  reg typed_init(Bits(8), ~init: init_value)
  typed_init <== data_in

  a <== inferred_init
  b <== inferred_next
  c <== inferred_both
  d <== typed
  e <== typed_init

circuit ExplicitShorthand():
  input clock: Clock
  input reset: Reset
  input(data_in, init_value): Bits(8)
  output(a, b, c, d, e): Bits(8)

  reg inferred_init(~init: init_value, ~reset: reset, ~clock: clock)
  inferred_init <== data_in
  reg inferred_next(~clock: clock, ~next: data_in)
  reg inferred_both(~init: init_value,
                    ~clock: clock,
                    ~next: data_in,
                    ~reset: reset)
  reg typed(Bits(8), ~clock: clock)
  typed <== data_in
  reg typed_init(Bits(8),
                 ~init: init_value,
                 ~reset: reset,
                 ~clock: clock)
  typed_init <== data_in

  a <== inferred_init
  b <== inferred_next
  c <== inferred_both
  d <== typed
  e <== typed_init

sync_circuit DoubleDrive():
  input data_in: Bits(8)
  output result: Bits(8)

  reg state(~next: data_in)
  state <== data_in
  result <== state

sync_circuit TypedImmediateNext():
  input data_in: Bits(8)

  reg state(Bits(8), ~next: data_in)
  #void

circuit ResetWithoutInit():
  input clock: Clock
  input reset: Reset

  reg state(Bits(8), ~reset: reset, ~clock: clock)
  #void

export:
  AmbientShorthand
  ExplicitShorthand
  DoubleDrive
  TypedImmediateNext
  ResetWithoutInit
