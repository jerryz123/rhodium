#lang rhombus
// Checks bundle-owned methods, typed results, and exact producer propagation.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../rhodium/core/main.rhm" open
  "../../../rhodium/frontend/layers/bool.rhm" as bool
  lib("rhodium/frontend/foundation.rhm").elaborate
  "bundle-method-fixture.rhdl" as fixture

def module_def = fixture.design.modules[0]
def ands = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.and"
)

def ors = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.or"
)

check:
  record_type(module_def.find_input("envelope").type) ~is #true
  vector_type(module_def.find_input("envelopes").type) ~is #true
  (for all (port in module_def.outputs.filter(~keep: fun (port): port.name != "packed")):
     bool.bool_type(port.type)) ~is #true

  ands.length() ~is 10
  ors.length() ~is 0
  verify_design(fixture.design) ~is #void
  verify_design(fixture.parameterized_design) ~is #void
  verify_design(elaborate(fixture.FixedKeywordMethods("direct")).design) ~is #void
  verify_design(elaborate(fixture.FixedKeywordMethods("extracted")).design) ~is #void
  elaborate(fixture.FixedKeywordMethods("missing")) ~throws "keyword"
  elaborate(fixture.FixedKeywordMethods("wrong-type")) ~throws "annotation"
  verify_design(fixture.direct_interface_design) ~is #void
  elaborate(fixture.InvalidParameterizedMethod("argument")) ~throws "annotation"
  elaborate(fixture.InvalidParameterizedMethod("generic-argument")) ~throws "annotation"
  elaborate(fixture.InvalidParameterizedMethod("dependent-argument")) ~throws "annotation"
  elaborate(fixture.InvalidParameterizedMethod("result")) ~throws "annotation"
  elaborate(fixture.InvalidParameterizedMethod("family")) ~throws "expected a SizedCacheEnvelope specialization"
