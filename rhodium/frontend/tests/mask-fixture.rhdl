#lang rhodium
// Exercises Mask literals, conversions, set operations, indexing, and invalid numeric uses.
// SPDX-License-Identifier: Apache-2.0

def Mask4 = Mask(4)

circuit MaskFixture():
  input(left, right): Mask4
  input raw: Bits(4)
  input exact: OneHot(4)
  input optional: MaybeOneHot(4)
  input index: Bits(6)
  input enable: Bool
  output literal: Mask4
  output from_bits: Mask4
  output from_exact: Mask4
  output from_optional: Mask4
  output union: Mask4
  output intersection: Mask4
  output difference: Mask4
  output complement: Mask4
  output shifted: Mask4
  output lane_two: Bool
  output dynamic_lane: Bool
  output packed: Bits(4)
  output selected: MaybeOneHot(4)
  output decoded: Mask4
  output enabled_decoded: Mask4
  output decoded_lane: Bool
  output(prefix, interval, host_prefix, mixed_interval): Mask4
  output(prefix_lane, interval_lane): Bool

  literal <== Mask4(0b0101)
  from_bits <== raw.into(Mask4)
  from_exact <== exact.into(Mask4)
  from_optional <== optional.into(Mask4)
  def combined = left ||| right
  union <== combined
  intersection <== left & right
  difference <== left ^ right
  complement <== !left
  shifted <== (raw << 1).into(Mask4)
  lane_two <== combined[2]
  dynamic_lane <== combined[index]
  packed <== combined.into(Bits(4))
  selected <== priority_encoder_oh(combined)
  decoded <== Mask4.from_index(index)
  enabled_decoded <== Mask4.from_index(index, ~valid: enable)
  decoded_lane <== Mask4.from_index(index)[index]
  prefix <== Mask4.prefix(index)
  interval <== Mask4.range(index, raw)
  host_prefix <== Mask4.prefix(100)
  mixed_interval <== Mask4.range(1, index)
  block:
    use_static
    prefix_lane <== Mask4.prefix(index)[0]
    interval_lane <== Mask4.range(index, 4)[0]

circuit BadMaskPrefix(T :: DataType):
  input bound: T
  output result: Mask4
  result <== Mask4.prefix(bound)

circuit BadMaskRange(T :: DataType, ~first: first :: Boolean):
  input bound: T
  output result: Mask4
  result <== if first | Mask4.range(bound, 4) | Mask4.range(0, bound)

circuit BadHostMaskBounds(bound :: Int, ~range: range :: Boolean, ~first: first :: Boolean = #false):
  output result: Mask4
  result <== if range | (if first | Mask4.range(bound, 4) | Mask4.range(0, bound)) | Mask4.prefix(bound)

circuit BadMaskDecode(Index :: DataType, Enable :: DataType):
  input index: Index
  input enable: Enable
  output result: Mask4
  result <== Mask4.from_index(index, ~valid: enable)

circuit ShiftMask():
  input source: Mask4
  output result: Mask4
  result <== source << 1

circuit RightShiftMask():
  input source: Mask4
  output result: Mask4
  result <== source >> 1

circuit AddMask():
  input(left, right): Mask4
  output result: Mask4
  result <== left + right

circuit WrongMaskWidth():
  input source: Bits(3)
  output result: Mask4
  result <== source.into(Mask4)

circuit ImplicitBitsMask():
  input source: Bits(4)
  output result: Mask4
  result <== source

circuit BadMaskIndex(T :: DataType):
  input source: Mask4
  input index: T
  output result: Bool
  result <== source[index]

circuit OutOfRangeMaskIndex():
  input source: Mask4
  output result: Bool
  result <== source[4]

export:
  Mask4
  MaskFixture
  ShiftMask
  RightShiftMask
  AddMask
  WrongMaskWidth
  ImplicitBitsMask
  BadMaskIndex
  OutOfRangeMaskIndex
  BadMaskDecode
  BadMaskPrefix
  BadMaskRange
  BadHostMaskBounds
