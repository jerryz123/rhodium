#lang rhodium
// Exercises retained asynchronous-read memory, nested assertions, and scoped control binding.
// SPDX-License-Identifier: Apache-2.0

sync_circuit MemoryGuard():
  input enable: Bool
  input data: Bits(8)
  when enable: assert(data =/= bits(255, 8), "write_data_allowed")

sync_circuit MemoryLeaf():
  input (read_address, write_address): Bits(2)
  input write_data: Bits(8)
  input write_enable: Bool
  output read_data: Bits(8)
  mem storage(4, Bits(8))
  read_data <== storage[read_address]
  // Memory writes are deliberately independent of reset, matching the core.
  storage.write(write_address, write_data, ~enable: write_enable)
  inst guard(MemoryGuard())
  guard.enable <== write_enable
  guard.data <== write_data

def signature = ModuleSignature([PortSignature("clock", Clock), PortSignature("reset", Reset), PortSignature("read_address", Bits(2)), PortSignature("write_address", Bits(2)), PortSignature("write_data", Bits(8)), PortSignature("write_enable", Bool)], [PortSignature("read_data", Bits(8))])
def dependencies = [[OutputLeafDependency([], [InputLeaf(2, [])])]]
def state = SingleClockState("clock", "reset", ~async_read_memory: #true, ~clocked_assertions: #true)
def definition = ConstructDefinition(ConstructIdentity("MemoryLeaf"), [4, Bits(8)], signature, dependencies, ~state: state)
def mutable calls = 0
fun counted():
  calls := calls + 1
  MemoryLeaf()
def reference = retained_circuit(definition, counted)

sync_circuit MemoryWrapper():
  input (read_address, write_address): Bits(2)
  input write_data: Bits(8)
  input write_enable: Bool
  output read_data: Bits(8)
  inst child(reference)
  child.read_address <== read_address
  child.write_address <== write_address
  child.write_data <== write_data
  child.write_enable <== write_enable
  read_data <== child.read_data

def wrapped = retained_circuit(ConstructDefinition(ConstructIdentity("MemoryWrapper"), [], signature, dependencies, ~state: state), fun (): MemoryWrapper())

sync_circuit MemoryTop(child):
  input (read_address, write_address): Bits(2)
  input (data_a, data_b): Bits(8)
  input (enable_a, enable_b, clear_a): Bool
  output (result_a, result_b): Bits(8)
  def selected = child || MemoryLeaf()
  inst first(selected, ~reset_when: clear_a)
  inst second(selected)
  for (lane in [first, second]):
    lane.read_address <== read_address
    lane.write_address <== write_address
  first.write_data <== data_a
  first.write_enable <== enable_a
  second.write_data <== data_b
  second.write_enable <== enable_b
  result_a <== first.read_data
  result_b <== second.read_data

def program = elaborate_program(MemoryTop(reference))
def nested_program = elaborate_program(MemoryTop(wrapped))
def calls_after_composition = calls
def eager = elaborate_with_top(MemoryTop(#false))
fun call_count(): calls

sync_circuit MemoryComparison():
  input (read_address, write_address): Bits(2)
  input (data_a, data_b): Bits(8)
  input (enable_a, enable_b, clear_a): Bool
  output (result_a, result_b, eager_a, eager_b): Bits(8)
  inst mixed(MemoryTop(reference))
  inst baseline(MemoryTop(#false))
  for (lane in [mixed, baseline]):
    lane.read_address <== read_address
    lane.write_address <== write_address
    lane.data_a <== data_a
    lane.data_b <== data_b
    lane.enable_a <== enable_a
    lane.enable_b <== enable_b
    lane.clear_a <== clear_a
  result_a <== mixed.result_a
  result_b <== mixed.result_b
  eager_a <== baseline.result_a
  eager_b <== baseline.result_b

// Only the retained hierarchy is exercised by the expected-failure bench.
sync_circuit MemoryFailure():
  input write_data: Bits(8)
  input write_enable: Bool
  inst child(wrapped)
  child.read_address <== bits(0, 2)
  child.write_address <== bits(0, 2)
  child.write_data <== write_data
  child.write_enable <== write_enable

export:
  MemoryComparison
  MemoryFailure
  signature
  dependencies
  state
  definition
  reference
  program
  nested_program
  eager
  calls_after_composition
  call_count
