#lang rhombus
// Checks inferred-type and immediate-next register forms in ambient and explicit domains.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/rtl.rhm").rtl_target
  lib("rhodium/compile/program.rhm").compile_program
  "../../../rhodium/core/main.rhm" open
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../examples/rtl/register-forms.rhdl" as example
  "register-shorthand.rhdl" as fixture

def example_compiled = compile_program(example.program, rtl_target)

def ambient_design = compile_program(elaborate(fixture.AmbientShorthand()), rtl_target).report.design
def ambient = ambient_design.modules[0]
def ambient_registers = ambient.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.register" || operation.opcode == "rtl.register_reset"
)

def explicit_design = compile_program(elaborate(fixture.ExplicitShorthand()), rtl_target).report.design
def explicit = explicit_design.modules[0]
def explicit_registers = explicit.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.register" || operation.opcode == "rtl.register_reset"
)

check:
  example_compiled.has_errors ~is #false
  ambient_registers.map(fun (operation): operation.attribute("name")) ~is ["inferred_init", "inferred_next", "inferred_both", "typed", "typed_init"]
  ambient_registers.map(fun (operation): operation.results[0].type.width) ~is [8, 8, 8, 8, 8]
  ambient_registers.map(fun (operation): operation.opcode) ~is ["rtl.register_reset", "rtl.register", "rtl.register_reset", "rtl.register", "rtl.register_reset"]
  ambient_registers[0].places[0].driver === ambient.find_input("data_in").value ~is #true
  ambient_registers[1].places[0].driver === ambient.find_input("data_in").value ~is #true
  ambient_registers[2].places[0].driver === ambient.find_input("reset_only_next").value ~is #true
  ambient_registers[0].operands[2] === ambient.find_input("init_value").value ~is #true
  ambient_registers[2].operands[2] === ambient.find_input("init_value").value ~is #true
  ambient_registers[4].operands[2] === ambient.find_input("init_value").value ~is #true
  explicit_registers.map(fun (operation): operation.opcode) ~is ["rtl.register_reset", "rtl.register", "rtl.register_reset", "rtl.register", "rtl.register_reset"]
  (for all (operation in explicit_registers):
     operation.operands[0] === explicit.find_input("clock").value) ~is #true
  explicit_registers[0].operands[1] === explicit.find_input("reset").value ~is #true
  explicit_registers[2].operands[1] === explicit.find_input("reset").value ~is #true
  explicit_registers[4].operands[1] === explicit.find_input("reset").value ~is #true
  explicit_registers[0].operands[2] === explicit.find_input("init_value").value ~is #true
  explicit_registers[2].operands[2] === explicit.find_input("init_value").value ~is #true
  explicit_registers[4].operands[2] === explicit.find_input("init_value").value ~is #true
  (for all (operation in explicit_registers):
     operation.places[0].driver === explicit.find_input("data_in").value) ~is #true
  verify_design(ambient_design) ~is #void
  verify_design(explicit_design) ~is #void
  elaborate(fixture.DoubleDrive()) ~throws "already has a driver"
  elaborate(fixture.TypedImmediateNext()) ~throws "expected a type or ~next value"
  elaborate(fixture.ResetWithoutInit()) ~throws "expected a type or ~next value"
