#lang rhodium
// Rejects structural timing declarations inside runtime hardware control flow.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/analysis/clocking.rhm").clocking_target
  lib("rhodium/frontend/layers/clocking.rhm") open

circuit BadClockingConditional():
  input clock: Clock
  input data: Bits(1)
  when data:
    synchronous_input(data, clock)

def clocked = compile_program(elaborate_program(BadClockingConditional()), clocking_target())
