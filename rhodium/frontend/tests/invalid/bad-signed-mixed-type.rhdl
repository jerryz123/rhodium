#lang rhodium
// Rejects implicit arithmetic between signed integers and raw unsigned Bits.
// SPDX-License-Identifier: Apache-2.0

circuit BadSignedMixedType():
  input left: SInt(8)
  input right: Bits(8)
  output result: SInt(8)
  result <== left + right

def design = elaborate(BadSignedMixedType())
