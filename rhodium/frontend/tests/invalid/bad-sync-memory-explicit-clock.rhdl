#lang rhodium
// Rejects an explicit synchronous-memory clock inside a sync circuit.
// SPDX-License-Identifier: Apache-2.0

sync_circuit ExplicitMemoryClock():
  input other_clock: Clock
  output data: Bits(1)
  sync_mem storage(2, Bits(1), ~clock: other_clock):
    read
  storage.read.address <== bits(0, 1)
  storage.read.enable <== bits(1, 1)
  data <== storage.read.data

def design = elaborate(ExplicitMemoryClock())
