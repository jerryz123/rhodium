#lang rhodium
// Rejects passing a frontend interface endpoint directly to a circuit generator.
// SPDX-License-Identifier: Apache-2.0

interface Link(T):
  role producer
  role consumer
  producer -> consumer:
    bits: T
  consumer -> producer:
    ready: Bool

circuit Child(parameter):
  input x: Bits(1)
  output y: Bits(1)
  y <== x

circuit BadInterfaceParameter():
  interface link(Link(Bits(8)), ~role: producer)
  Child(link)

def design = elaborate(BadInterfaceParameter())
