#lang rhodium
// Rejects dot access to a port absent from an instantiated child interface.
// SPDX-License-Identifier: Apache-2.0

circuit Child():
  input value: Bits(1)
  output result: Bits(1)
  result <== value

circuit BadInstancePort():
  input value: Bits(1)
  output result: Bits(1)
  def ChildDef = Child()
  inst u(ChildDef)
  u.value <== value
  result <== u.missing

def design = elaborate(BadInstancePort())

export:
  design
