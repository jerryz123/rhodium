#lang rhodium
// Rejects element type mismatches in whole-array interface connections.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/ready-valid.rhdl") open

circuit BadInterfaceArrayType():
  interface ingress[2](Decoupled(Bits(8)), ~role: consumer)
  interface egress[2](Decoupled(Bits(4)), ~role: producer)

  egress <=> ingress

elaborate(BadInterfaceArrayType())
