#lang rhodium/base
// Rejects an input timing contract attached to a top-level output.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/analysis/clocking.rhm").clocking_target
  lib("rhodium/frontend/layers/clocking.rhm") open

circuit BadClockingOutputContract():
  input clock: Clock
  input data: Bits(1)
  output result: Bits(1)
  result <== data
  synchronous_input(result, clock)

def clocked = compile_program(elaborate(BadClockingOutputContract()), clocking_target())
