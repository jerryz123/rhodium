#lang rhodium
// Invalid fixture using a mux lookup key that does not fit the selector width.
// SPDX-License-Identifier: Apache-2.0

circuit BadMuxKeyWidth():
  input selector: Bits(3)
  input value: Bits(1)
  output result: Bits(1)

  result <== mux_lookup(selector, ~default: value):
    8: value

def design = elaborate(BadMuxKeyWidth())
