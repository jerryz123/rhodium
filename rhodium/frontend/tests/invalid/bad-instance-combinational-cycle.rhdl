#lang rhodium

// Rejects a combinational feedback loop that crosses an identity-child boundary.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/rtl.rhm").rtl_target
  lib("rhodium/compile/program.rhm").compile_program

circuit Identity():
  input a: Bits(1)
  output y: Bits(1)
  y <== a

circuit Top():
  inst u(Identity())
  u.a <== u.y

// Cross-module cycle detection belongs to target preparation.
compile_program(elaborate(Top()), rtl_target)
