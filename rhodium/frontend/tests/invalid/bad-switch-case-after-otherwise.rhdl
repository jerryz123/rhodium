#lang rhodium

// Invalid fixture placing a hardware switch case after its otherwise clause.
// SPDX-License-Identifier: Apache-2.0

circuit BadSwitchCaseAfterOtherwise():
  input selector: Bits(2)
  output selected: Bits(1)

  switch selector:
    otherwise:
      selected <== Bits(1)(0)

    case 0:
      selected <== Bits(1)(1)

elaborate(BadSwitchCaseAfterOtherwise())
