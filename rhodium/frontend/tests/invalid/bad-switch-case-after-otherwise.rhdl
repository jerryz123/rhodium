#lang rhodium
// Invalid fixture placing a hardware switch case after its otherwise clause.
// SPDX-License-Identifier: Apache-2.0

circuit BadSwitchCaseAfterOtherwise():
  input selector: Bits(2)
  output selected: Bits(1)

  switch selector:
    otherwise:
      selected <== bits(0, 1)
    case 0:
      selected <== bits(1, 1)

def design = elaborate(BadSwitchCaseAfterOtherwise())
