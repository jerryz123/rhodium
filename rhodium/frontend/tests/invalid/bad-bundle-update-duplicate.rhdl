#lang rhodium

// Rejects duplicate named replacements in one immutable bundle update.
// SPDX-License-Identifier: Apache-2.0

bundle Payload():
  data: Bits(8)

circuit DuplicateUpdate():
  input source: Payload()
  output result: Payload()
  result <== source.updated(~data: Bits(8)(0), ~data: Bits(8)(1))

elaborate(DuplicateUpdate())
