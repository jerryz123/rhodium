#lang rhodium/base
// Rejects duplicate clock relationships collected through the frontend clocking layer.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/analysis/clocking.rhm").clocking_target
  lib("rhodium/frontend/layers/clocking.rhm") open

circuit BadClockingDuplicateRelationship():
  input left: Clock
  input right: Clock
  identical_clocks(left, right)
  identical_clocks(right, left)

def clocked = compile_program(elaborate_program(BadClockingDuplicateRelationship()), clocking_target())
