#lang rhodium

// Rejects an explicit asynchronous-memory write clock inside a sync circuit.
// SPDX-License-Identifier: Apache-2.0

sync_circuit ExplicitWriteClock():
  input other_clock: Clock
  mem storage(2, Bits(1))
  storage.write(Bits(1)(0), Bits(1)(0), ~clock: other_clock)

elaborate(ExplicitWriteClock())
