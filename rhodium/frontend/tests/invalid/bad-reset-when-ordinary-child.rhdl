#lang rhodium

// Rejects derived-reset instantiation for an ordinary circuit child.
// SPDX-License-Identifier: Apache-2.0

circuit OrdinaryChild():
  output value: Bits(1)
  value <== Bits(1)(0)

sync_circuit DerivedResetOrdinaryChild():
  input condition: Bool
  output value: Bits(1)
  inst child(OrdinaryChild(), ~reset_when: condition)
  value <== child.value

elaborate(DerivedResetOrdinaryChild())
