#lang rhodium
// Invalid fixture repeating a key in a canonical mux lookup.
// SPDX-License-Identifier: Apache-2.0

circuit BadMuxDuplicateKey():
  input selector: Bits(2)
  input value: Bits(4)
  output result: Bits(4)

  result <== mux_lookup(selector, ~default: value):
    1: value
    1: value

def design = elaborate(BadMuxDuplicateKey())
