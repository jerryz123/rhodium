#lang rhodium
// Must reject bulk connection when endpoint roles and boundary directions conflict.
// SPDX-License-Identifier: Apache-2.0

interface Link(T):
  role producer
  role consumer

  producer -> consumer:
    payload: T

  consumer -> producer:
    ready: Bool

circuit BadInterfaceDirections(width):
  interface left(Link(Bits(width)), ~role: producer)
  interface right(Link(Bits(width)), ~role: producer)
  left <=> right

def design = elaborate(BadInterfaceDirections(8))
