#lang rhodium
// Rejects a scoped reset without an enclosing sync circuit.
// SPDX-License-Identifier: Apache-2.0

circuit ResetScopeOutsideSync():
  input local_reset: Reset
  output value: Bits(1)
  reset_when(local_reset):
    value <== bits(0, 1)

def design = elaborate(ResetScopeOutsideSync())
