#lang rhodium
// Rejects a one-hot enum mux that omits a declared member arm.
// SPDX-License-Identifier: Apache-2.0

hardware_enum Select(~encoding: one_hot):
  First
  Second

circuit BadOneHotEnumMuxMissing():
  input select: Select
  input(first, second): Bits(8)
  output result: Bits(8)
  result <== select.mux({Select.First: first})

def design = elaborate(BadOneHotEnumMuxMissing())
