#lang rhodium
// Applies a custom connection policy even when both interface arguments are equal.
// SPDX-License-Identifier: Apache-2.0

interface DistinctPeers(tag):
  role producer
  role consumer
  provider producer
  connection_compatible producer (provided, required):
    provided[0] != required[0]

  producer -> consumer:
    payload: Bits(8)

circuit BadInterfaceEqualSpecializationCompatibility():
  interface source(DistinctPeers("same"), ~role: consumer)
  interface sink(DistinctPeers("same"), ~role: producer)
  source <=> sink

def design = elaborate(BadInterfaceEqualSpecializationCompatibility())
