#lang rhodium
// Rejects expanding multiplication between unsigned Bits and signed arithmetic.
// SPDX-License-Identifier: Apache-2.0

circuit BadExpandingArithmeticMixed():
  input left: SInt(8)
  input right: Bits(4)
  output result: SInt(12)

  result <== left *& right

def design = elaborate(BadExpandingArithmeticMixed())
