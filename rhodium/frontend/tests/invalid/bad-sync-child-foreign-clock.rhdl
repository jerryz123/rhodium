#lang rhodium
// Rejects overriding a sync child to a foreign clock inside a sync parent.
// SPDX-License-Identifier: Apache-2.0

sync_circuit Child():
  output value: Bits(1)
  value <== bits(0, 1)

sync_circuit Parent():
  input other_clock: Clock
  input other_reset: Reset
  output value: Bits(1)

  def ChildModule = Child()
  inst child(ChildModule, ~clock: other_clock, ~reset: other_reset)
  value <== child.value

def design = elaborate(Parent())
