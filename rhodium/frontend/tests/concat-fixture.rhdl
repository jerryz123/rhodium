#lang rhodium
// Exercises function and operator concatenation across Bits, Bool, records, and host values.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/ready-valid.rhdl") open

bundle Pair(T):
  high: T
  low: T

circuit Concatenation():
  input high: Bits(2)
  input middle: Bits(1)
  input low: Bits(2)
  input flag: Bool
  input pair: Pair(Bits(2))
  output direct: Bits(5)
  output direct_msb: Bits(1)
  output appended: Bits(5)
  output appended_msb: Bits(1)
  output generated: Bits(5)
  output packed: Bits(5)
  output appended_packed: Bits(5)

  def combined = concat(high, middle, low)
  direct <== combined
  direct_msb <== combined[4]

  def appended_value = high ++ middle ++ low
  appended <== appended_value
  appended_msb <== appended_value[4]

  def pieces = [high, middle, low]
  generated <== concat(pieces)
  packed <== concat(pair, flag)
  appended_packed <== pair ++ flag

def host_string = "high" ++ "low"
def host_list = [1, 2] ++ [3]

circuit ControlConcat():
  input clk: Clock
  input bit: Bits(1)
  output result: Bits(2)
  result <== concat(clk, bit)

circuit ControlAppend():
  input clk: Clock
  input bit: Bits(1)
  output result: Bits(2)
  result <== clk ++ bit

circuit NestedAppend(width :: PosInt):
  interface source(Valid(Pair(Bits(width))), ~role: consumer)
  output result: Bits(width * 2)
  result <== source.bits.high ++ source.bits.low

circuit TooFewConcat():
  input bit: Bits(1)
  output result: Bits(1)
  result <== concat(bit)

def design = elaborate(Concatenation())

export:
  Pair
  Concatenation
  ControlConcat
  ControlAppend
  NestedAppend
  TooFewConcat
  host_string
  host_list
  design
