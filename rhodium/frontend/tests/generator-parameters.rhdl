#lang rhodium
// Exercises arbitrary host generator parameters while retaining the live-hardware boundary.
// SPDX-License-Identifier: Apache-2.0

circuit ParameterSink(~parameter: parameter):
  output result: Bits(1)
  result <== bits(0, 1)

class PlainHostConfig()

circuit InvalidKeywordHardwareParameter():
  input source: Bits(1)
  output result: Bits(1)

  def child = ParameterSink(~parameter: source)
  result <== bits(0, 1)

circuit OpaqueHostParameters():
  def host_values = Array(1)
  def helper = fun (): 1
  def config = PlainHostConfig()
  inst array_first(ParameterSink(~parameter: host_values))
  inst array_second(ParameterSink(~parameter: host_values))
  inst function_first(ParameterSink(~parameter: helper))
  inst function_second(ParameterSink(~parameter: helper))
  inst object_first(ParameterSink(~parameter: config))
  inst object_second(ParameterSink(~parameter: config))

export:
  InvalidKeywordHardwareParameter
  OpaqueHostParameters
