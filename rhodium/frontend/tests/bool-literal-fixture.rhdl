#lang rhodium

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target

// Constructs both extension-defined Bool literal values through the callable type object.
// SPDX-License-Identifier: Apache-2.0

circuit BoolLiterals():
  output(high, low): Bool

  high <== Bool(#true)
  low <== Bool(#false)

def design = compile_program(elaborate(BoolLiterals()), rtl_target).report.design

export:
  BoolLiterals
  design
