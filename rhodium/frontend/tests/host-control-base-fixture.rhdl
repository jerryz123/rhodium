#lang rhodium/base

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target

// Exercises ordinary Rhombus host control with a hardware object in the base profile.
// SPDX-License-Identifier: Apache-2.0

circuit BaseHostControl():
  input signal: Bits(1)
  input fallback: Bits(1)
  output selected: Bits(1)

  if signal
  | selected <== signal
  | selected <== fallback

def design = compile_program(elaborate(BaseHostControl()), rtl_target).report.design

export:
  design
