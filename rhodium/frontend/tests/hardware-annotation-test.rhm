#lang rhombus
// Verifies exact hardware annotations preserve type checks and frontend operations.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../rhodium/core/main.rhm" open
  lib("rhodium/frontend/foundation.rhm").elaborate
  "hardware-annotation-fixture.rhdl" as fixture

def module_def = fixture.design.modules[0]

check:
  module_def.name ~is "HardwareAnnotations"
  type_equal(module_def.find_output("bits_out").type, Bits(4)) ~is #true
  type_equal(module_def.find_output("vector_out").type,
             VectorType(2, Bits(4))) ~is #true
  type_equal(module_def.find_output("pair_left").type, Bits(4)) ~is #true
  type_equal(module_def.find_output("nibble_out").type,
             fixture.Nibble(4)) ~is #true
  type_equal(fixture.Nibble(4), fixture.Nibble(4)) ~is #true
  type_equal(fixture.Nibble(4), fixture.Nibble(5)) ~is #false
  verify_design(fixture.design) ~is #void
  elaborate(fixture.WrongWidth()) ~throws "annotation"
  elaborate(fixture.WrongBitsCategory()) ~throws "Bits"
  elaborate(fixture.WrongPackableCategory()) ~throws "Hardware.packable"
  elaborate(fixture.WrongExtensionFamily()) ~throws "annotation"
