#lang rhodium
// Exercises width-preserving bang inversion for hardware Bits and Bool values.
// SPDX-License-Identifier: Apache-2.0

circuit Inversion():
  input bits_in: Bits(8)
  input bool_in: Bool
  output bits_out: Bits(8)
  output bool_out: Bool

  bits_out <== !bits_in
  bool_out <== !bool_in

def design = elaborate(Inversion())

export:
  Inversion
  design
