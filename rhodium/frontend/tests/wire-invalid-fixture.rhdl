#lang rhodium
// Defines invalid wire uses for focused frontend diagnostic checks.
// SPDX-License-Identifier: Apache-2.0

circuit ForwardWire():
  input source: Bits(4)
  output result: Bits(4)
  wire temporary: Bits(4)
  result <== temporary
  temporary <== source

circuit UndrivenWire():
  input source: Bits(4)
  output result: Bits(4)
  wire temporary: Bits(4)
  result <== source

circuit MultipleWireDrivers():
  input(first, second): Bits(4)
  output result: Bits(4)
  wire temporary: Bits(4)
  temporary <== first
  temporary <== second
  result <== temporary

circuit PartialVectorWire():
  input source: Bits(4)
  output result: Bits(4)
  wire temporary: Vec(2, Bits(4))
  temporary[0] <== source
  result <== source

circuit MixedVectorWire():
  input(first, second): Bits(4)
  output result: Vec(2, Bits(4))
  wire temporary: Vec(2, Bits(4))
  temporary[0] <== first
  temporary <== vec(first, second)
  result <== temporary

export:
  ForwardWire
  UndrivenWire
  MultipleWireDrivers
  PartialVectorWire
  MixedVectorWire
