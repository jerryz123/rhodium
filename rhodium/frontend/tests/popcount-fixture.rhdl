#lang rhodium

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target

// Exercises population counts over packed bits, aggregates, lists, and identities.
// SPDX-License-Identifier: Apache-2.0

circuit PopcountFixture():
  input bits_value: Bits(5)
  input flags: Vec(4, Bool)
  input single: Bool
  output bits_count: Bits(3)
  output flags_count: Bits(3)
  output list_count: Bits(2)
  output single_count: Bits(1)
  output empty_count: Bits(1)

  bits_count <== popcount(bits_value)
  flags_count <== popcount(flags)
  list_count <== popcount([flags[0], flags[1], flags[2]])
  single_count <== popcount(single)
  empty_count <== popcount([])

def design = compile_program(elaborate(PopcountFixture()), rtl_target).report.design

export:
  PopcountFixture
  design
