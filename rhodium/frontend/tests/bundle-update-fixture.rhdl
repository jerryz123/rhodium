#lang rhodium


// Exercises immutable record replacement, exact result surfaces, and invalid updates.
// SPDX-License-Identifier: Apache-2.0

hardware_enum UpdateState(~width: 1):
  Idle = 0
  Active = 1
  method active(state) :: Bool:
    state === UpdateState.Active

hardware_enum OtherState(~width: 1):
  Idle = 0
  Active = 1

bundle UpdatePayload(width :: PosInt, tagged :: Boolean):
  data: Bits(width)
  if tagged:
    tag: Bits(4)

  state: UpdateState

  method active(payload) :: Bool:
    payload.state.active()

  method identity(payload) :: UpdatePayload(width, tagged):
    payload

  method plus(payload, other :: Bits(width), ~bias: bias :: Nat = width) :: Bits(width):
    payload.data + other + Bits(width)(bias)

  method tag_value(payload) :: Bits(4):
    if tagged | payload.tag | Bits(4)(0)

  method widened(payload) :: Bits(width + 1):
    payload.data.zext(width + 1)

  method nonzero(payload):
    payload.data.any()

bundle UpdateEnvelope():
  payload: UpdatePayload(8, #true)
  valid: Bool
  method active(envelope) :: Bool:
    envelope.valid & envelope.payload.state.active()

bundle UpdateBox(Tag :: DataType):
  tag: Tag
  data: Bits(8)

  method with_tag(box, To :: DataType, tag :: Hardware.of(To)) :: UpdateBox(To):
    UpdateBox(To):
      tag: tag
      data: box.data

def Structural = RecordType([RecordField("data", Bits(8)), RecordField("tag", Bits(4))])
def initial = UpdateEnvelope():
  payload:
    UpdatePayload(8, #true):
      data: Bits(8)(0x35)
      tag: Bits(4)(6)
      state: UpdateState.Idle

  valid: Bool(#true)

circuit UpdateEcho():
  input source: UpdateEnvelope()
  output result: UpdateEnvelope()
  result <== source

interface UpdateStream():
  role producer
  role consumer
  provider producer
  producer -> consumer:
    bits: UpdateEnvelope()

circuit ObservedUpdate():
  interface ingress(UpdateStream(), ~role: consumer)
  output result: UpdateEnvelope()
  result <== ingress.observe().bits.updated(~valid: Bool(#true))

sync_circuit BundleUpdateFixture():
  input source: UpdateEnvelope()
  input data: Bits(8)
  input tag: Bits(4)
  input choose: Bool
  output original: UpdateEnvelope()
  output changed: UpdateEnvelope()
  output swapped: Structural
  output plain: UpdatePayload(8, #false)
  output tagged_payload: UpdatePayload(8, #true)
  output methods: Vec(9, Bool)
  output registered: UpdateEnvelope()
  output inferred: UpdateEnvelope()
  output remembered: UpdateEnvelope()
  output observed: UpdateEnvelope()
  output payload_methods: Vec(17, Bool)
  output parameter_values: Vec(6, Bits(8))
  output widened: Bits(9)
  output retagged: UpdateBox(UpdatePayload(8, #true))
  output retagged_active: Bool
  output retagged_state: Bool

  wire connected: UpdateEnvelope()
  connected <== source
  reg saved(UpdateEnvelope(), ~init: initial)
  saved <== source.updated(~valid: Bool(#true))
  reg inferred_saved(~init: initial)
  inferred_saved <== source
  reg inferred_next(~next: source)
  mem storage(2, UpdateEnvelope())
  storage.write(Bits(1)(0), source, ~enable: Bool(#true))
  inst echo(UpdateEcho())
  echo.source <== source
  inst observer(ObservedUpdate())
  observer.ingress.bits <== source
  observed <== observer.result
  def choices = vec(source, initial)
  def selected = mux(choose, source, initial)
  def replace = source.updated
  def update = replace(~payload: source.payload.updated(~data: data, ~tag: tag))
  original <== source.updated()
  changed <== update
  registered <== saved.updated(~valid: source.valid)
  inferred <== inferred_saved.updated(~valid: source.valid)
  remembered <== storage[Bits(1)(0)].updated(~valid: source.valid)
  tagged_payload <== source.payload.updated(~data: data).updated(~tag: tag)
  def untagged = UpdatePayload(8, #false):
    data: source.payload.data
    state: source.payload.state

  plain <== untagged.updated(~data: data)
  def pair = record(Structural):
    data: data
    tag: tag

  swapped <== pair.updated(~tag: source.payload.tag, ~data: source.payload.data)
  methods <== vec(
    update.updated(~valid: Bool(#true)).active(),
    connected.updated(~valid: Bool(#true)).active(),
    saved.updated(~valid: Bool(#true)).active(),
    selected.updated(~valid: Bool(#true)).active(),
    initial.updated(~payload: source.payload).active(),
    choices[0].updated(~valid: Bool(#true)).active(),
    storage[Bits(1)(0)].updated(~valid: Bool(#true)).active(),
    echo.result.updated(~valid: Bool(#true)).payload.state.active(),
    source.as_bits().into(UpdateEnvelope()).updated(~valid: Bool(#true)).active()
  )

  def bound = source.payload.active
  def bound_plus = source.payload.plus
  def bound_identity = source.payload.identity
  def mutable receiver_evaluations = 0
  fun counted_receiver() :: UpdatePayload(8, #true):
    receiver_evaluations := receiver_evaluations + 1
    source.payload

  def counted = counted_receiver().active
  def narrow = UpdatePayload(4, #false):
    data: data[0..4]
    state: source.payload.state

  parameter_values <== vec(
    source.payload.plus(data),
    bound_plus(data, ~bias: 1),
    narrow.plus(data[4..8]).zext(8),
    narrow.tag_value().zext(8),
    source.payload.tag_value().zext(8),
    source.payload.identity().data
  )
  widened <== source.payload.widened()
  def boxed = UpdateBox(Bits(4)):
    tag: tag
    data: data

  def retag = boxed.with_tag
  retagged <== retag(UpdatePayload(8, #true), source.payload)
  retagged_active <== retag(UpdatePayload(8, #true), source.payload).tag.active()
  retagged_state <== boxed.with_tag(UpdateState, source.payload.state).tag.active()
  payload_methods <== vec(
    source.payload.active(),
    connected.payload.active(),
    saved.payload.active(),
    inferred_saved.payload.active(),
    selected.payload.active(),
    choices[0].payload.active(),
    storage[Bits(1)(0)].payload.active(),
    storage.read(Bits(1)(0)).payload.active(),
    echo.result.payload.active(),
    source.payload.as_bits().into(UpdatePayload(8, #true)).active(),
    bound(),
    source.payload.identity().active(),
    source.payload.nonzero(),
    counted(),
    counted(),
    inferred_next.payload.active(),
    bound_identity().active()
  )

  unless receiver_evaluations == 1
  | error("method extraction must evaluate its receiver exactly once")

circuit InvalidRecordUpdate(kind :: String):
  input source: UpdatePayload(8, #false)
  input entries: Vec(2, Bits(8))
  output result: Bits(8)
  cond
  | kind == "unknown": result <== source.updated(~missing: Bits(8)(0)).data
  | kind == "absent": result <== source.updated(~tag: Bits(4)(0)).data
  | kind == "width": result <== source.updated(~data: Bits(4)(0)).data
  | kind == "nominal": result <== source.updated(~state: OtherState.Active).data
  | kind == "host": result <== source.updated(~data: 3).data
  | kind == "positional": result <== source.updated(Bits(1)(0), Bits(8)(0)).data
  | kind == "mixed": result <== source.updated(Bits(1)(0), ~data: Bits(8)(0)).data
  | kind == "vector": result <== entries.updated(~data: Bits(8)(0))[0]
  | ~else: result <== source.data.updated(~data: Bits(8)(0))

def program = elaborate(BundleUpdateFixture())

export:
  program
  UpdatePayload
  UpdateEnvelope
  InvalidRecordUpdate
