#lang rhodium
// Exercises nominal identity, provider orientation, and specialization-defined interface compatibility.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  "interface-nominal-contract.rhdl" as foreign
  "../../../examples/rtl/interface-specialization.rhdl" as example

interface Collision(T):
  role producer
  role consumer

  producer -> consumer:
    payload: T

fun require_local_collision(
  endpoint :: Endpoint.of(Collision(Bits(8)))
) :~ Endpoint:
  endpoint

interface ReverseOnly():
  role receiver
  role sender
  provider sender

  sender -> receiver:
    payload: Bits(8)

interface StrongReverseOnly() refines ReverseOnly()

// Equal tags are deliberately illegal between peers so hierarchy tests prove
// that forwarding does not reinterpret one endpoint as two protocol peers.
interface ForwardingPolicy(tag :: String):
  role producer
  role consumer
  provider producer
  connection_compatible producer (provided, required):
    provided[0] != required[0]

  producer -> consumer:
    payload: Bits(8)

interface ForwardingEnvelope(tag :: String):
  role producer
  role consumer

  producer -> consumer:
    link: ForwardingPolicy(tag)

circuit PolicyForwardSource(tag :: String):
  interface port(ForwardingPolicy(tag), ~role: producer)
  port.payload <== bits(90, 8)

circuit PolicyForwardSink(tag :: String):
  interface port(ForwardingPolicy(tag), ~role: consumer)
  output observed: Bits(8)
  observed <== port.payload

circuit ProviderPolicyForwarding():
  interface port(ForwardingPolicy("same"), ~role: producer)
  inst source(PolicyForwardSource("same"))
  source.port <=> port

circuit ConsumerPolicyForwarding():
  interface port(ForwardingPolicy("same"), ~role: consumer)
  output observed: Bits(8)
  inst sink(PolicyForwardSink("same"))
  port <=> sink.port
  observed <== sink.observed

circuit NestedPolicyForwardSource(tag :: String):
  interface port(ForwardingEnvelope(tag), ~role: producer)
  port.link.payload <== bits(165, 8)

circuit NestedPolicyForwarding():
  interface port(ForwardingEnvelope("same"), ~role: producer)
  inst source(NestedPolicyForwardSource("same"))
  source.port <=> port

circuit PolicyForwardArraySource(tag :: String):
  interface ports[2](ForwardingPolicy(tag), ~role: producer)
  ports[0].payload <== bits(1, 8)
  ports[1].payload <== bits(2, 8)

circuit ArrayPolicyForwarding():
  interface ports[2](ForwardingPolicy("same"), ~role: producer)
  inst source(PolicyForwardArraySource("same"))
  source.ports <=> ports

circuit MismatchedPolicyForwarding():
  interface port(ForwardingPolicy("outer"), ~role: producer)
  inst source(PolicyForwardSource("inner"))
  source.port <=> port

circuit SameOriginPolicyConnection():
  inst first(PolicyForwardSource("same"))
  inst second(PolicyForwardSource("same"))
  first.port <=> second.port

fun require_capacity(
  endpoint :: Endpoint.supports(example.CapacityLink(2, 8))
) :~ Endpoint:
  endpoint

circuit LocalNominalIdentity():
  interface endpoint(Collision(Bits(8)), ~role: consumer)
  require_local_collision(endpoint)
  #void

circuit ForeignNominalCollision():
  interface endpoint(Collision(Bits(8)), ~role: consumer)
  foreign.require_collision(endpoint)
  #void

circuit ForeignNominalBulkCollision():
  interface local_end(Collision(Bits(8)), ~role: producer)
  interface foreign_end(foreign.Collision(Bits(8)), ~role: consumer)
  local_end <=> foreign_end

circuit ExactReverseOnly():
  interface receiver_end(ReverseOnly(), ~role: receiver)
  interface sender_end(ReverseOnly(), ~role: sender)
  receiver_end <=> sender_end

circuit CompatibleReverseOnly():
  interface strong_end(StrongReverseOnly(), ~role: receiver)
  interface base_end(ReverseOnly(), ~role: sender)
  strong_end <=> base_end

circuit CompatibleSpecializationArrays():
  interface sources[2](example.CapacityLink(4, 8), ~role: consumer)
  interface sinks[2](example.CapacityLink(2, 8), ~role: producer)
  sources <=> sinks

circuit CompatibleEndpointSupport():
  interface source(example.CapacityLink(4, 8), ~role: consumer)
  require_capacity(source)
  #void

def local_nominal_design = compile_program(elaborate(LocalNominalIdentity()), rtl_target).report.design
def exact_reverse_design = compile_program(elaborate(ExactReverseOnly()), rtl_target).report.design
def compatible_reverse_design = compile_program(elaborate(CompatibleReverseOnly()), rtl_target).report.design
def compatible_specialization_arrays_design = compile_program(elaborate(CompatibleSpecializationArrays()), rtl_target).report.design
def compatible_endpoint_support_design = compile_program(elaborate(CompatibleEndpointSupport()), rtl_target).report.design
def provider_policy_forwarding_design = compile_program(elaborate(ProviderPolicyForwarding()), rtl_target).report.design
def consumer_policy_forwarding_design = compile_program(elaborate(ConsumerPolicyForwarding()), rtl_target).report.design
def nested_policy_forwarding_design = compile_program(elaborate(NestedPolicyForwarding()), rtl_target).report.design
def array_policy_forwarding_design = compile_program(elaborate(ArrayPolicyForwarding()), rtl_target).report.design

export:
  ReverseOnly
  ForeignNominalCollision
  ForeignNominalBulkCollision
  local_nominal_design
  exact_reverse_design
  compatible_reverse_design
  compatible_specialization_arrays_design
  compatible_endpoint_support_design
  provider_policy_forwarding_design
  consumer_policy_forwarding_design
  nested_policy_forwarding_design
  array_policy_forwarding_design
  MismatchedPolicyForwarding
  SameOriginPolicyConnection
