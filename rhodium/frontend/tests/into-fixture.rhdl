#lang rhodium/base

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target

// Exercises member-style casting using only the compositional base language.
// SPDX-License-Identifier: Apache-2.0

circuit BaseInto():
  input raw: Bits(1)
  output restored: Bits(1)

  def reset = raw.into(Reset)
  restored <== reset.into(Bits(1))

def design = compile_program(elaborate(BaseInto()), rtl_target).report.design

export:
  design
