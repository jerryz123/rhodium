#lang rhodium/base
// Exercises foundational receiver membership without importing optional frontend layers.
// SPDX-License-Identifier: Apache-2.0

circuit BaseMembership():
  input value: Bits(2)
  input first: Bits(2)
  input second: Bits(2)
  output member: Bool

  member <== value.is_one_of(first, second)

def design = elaborate(BaseMembership())

export:
  BaseMembership
  design
