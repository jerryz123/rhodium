#lang rhodium/base

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target

// Exercises foundational receiver membership without importing optional frontend layers.
// SPDX-License-Identifier: Apache-2.0

circuit BaseMembership():
  input value: Bits(2)
  input first: Bits(2)
  input second: Bits(2)
  output member: Bool

  member <== value.is_one_of(first, second)

def design = compile_program(elaborate(BaseMembership()), rtl_target).report.design

export:
  BaseMembership
  design
