#lang rhodium/base
// Checks that hardware conditional assignment composes from independently selected frontend layers.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  lib("rhodium/frontend/layers/sequential.rhm") open
  lib("rhodium/frontend/layers/conditional.rhm") open

circuit ComposedConditionalRegister():
  input data_in: Bits(4)
  input enable: Bits(1)
  input clk: Clock
  output data_out: Bits(4)

  reg state(Bits(4), ~clock: clk)
  when enable:
    state <== data_in
  data_out <== state

def design = compile_program(elaborate(ComposedConditionalRegister()), rtl_target).report.design

export:
  ComposedConditionalRegister
  design
