#lang rhodium/base
// Exercises report-only clocking declarations through explicit base-profile layer composition.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/layers/sequential.rhm") open
  lib("rhodium/frontend/layers/clocking.rhm") open

circuit ClockingTop():
  input clock: Clock
  input identical_clock: Clock
  input derived_clock_input: Clock
  input asynchronous_clock: Clock
  input exclusive_clock: Clock
  input same_data: Bits(1)
  input identical_data: Bits(1)
  input derived_data: Bits(1)
  input asynchronous_clock_data: Bits(1)
  input exclusive_data: Bits(1)
  input asynchronous_data: Bits(1)
  input unknown_data: Bits(1)

  reg same_sink(Bits(1), ~clock: clock)
  reg identical_sink(Bits(1), ~clock: clock)
  reg derived_sink(Bits(1), ~clock: clock)
  reg asynchronous_clock_sink(Bits(1), ~clock: clock)
  reg exclusive_sink(Bits(1), ~clock: clock)
  reg asynchronous_input_sink(Bits(1), ~clock: clock)
  reg unknown_input_sink(Bits(1), ~clock: clock)
  same_sink <== same_data
  identical_sink <== identical_data
  derived_sink <== derived_data
  asynchronous_clock_sink <== asynchronous_clock_data
  exclusive_sink <== exclusive_data
  asynchronous_input_sink <== asynchronous_data
  unknown_input_sink <== unknown_data

  synchronous_input(same_data, clock)
  synchronous_input(identical_data, identical_clock)
  synchronous_input(derived_data, derived_clock_input)
  synchronous_input(asynchronous_clock_data, asynchronous_clock)
  synchronous_input(exclusive_data, exclusive_clock)
  asynchronous_input(asynchronous_data)
  unknown_input_timing(unknown_data)
  identical_clocks(clock, identical_clock)
  derived_clock(clock, derived_clock_input, "divide-by-two")
  asynchronous_clocks(clock, asynchronous_clock)
  exclusive_clocks(clock, exclusive_clock, "mode-selected clocks")

def clocked = elaborate_with_clocking(ClockingTop())

export:
  ClockingTop
  clocked
