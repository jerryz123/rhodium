#lang rhombus
// Checks lazy memory expansion, independent resources, and assertion provenance through hierarchy.
// SPDX-License-Identifier: Apache-2.0
import:
  "../../core/main.rhm" open
  "../../lowering/program.rhm" open
  "retained-memory-fixture.rhdl" as fixture

def before = dump_ir(fixture.program.design)
def count_before = fixture.call_count()
def first = materialize_reachable_rtl(fixture.program).rtl
def second = materialize_reachable_rtl(fixture.program).rtl
def leaf = first.top.find_instance("first").attribute("module")
def other_leaf = second.top.find_instance("first").attribute("module")
def guard = leaf.find_instance("guard").attribute("module")
def assertion = guard.operations.find(fun (op): op.opcode == "verif.assert")
def eager_leaf = fixture.eager.top.find_instance("first").attribute("module")
def eager_assertion = eager_leaf.find_instance("guard").attribute("module").operations.find(fun (op): op.opcode == "verif.assert")
check:
  fixture.calls_after_composition ~is 0
  fixture.call_count() ~is count_before + 2
  dump_ir(fixture.program.design) ~is before
  leaf === first.top.find_instance("second").attribute("module") ~is #true
  leaf.memories[0] === other_leaf.memories[0] ~is #false
  leaf.memories[0].module_def === leaf ~is #true
  assertion.attribute("label") ~is "write_data_allowed"
  assertion.location.describe() ~is eager_assertion.location.describe()
  assertion.origin.describe() ~is eager_assertion.origin.describe()
  materialize_reachable_rtl(fixture.nested_program).rtl.design.sealed ~is #true
