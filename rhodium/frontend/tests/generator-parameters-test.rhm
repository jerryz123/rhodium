#lang rhombus
// Checks normalized generator bindings for positional and keyword defaults and overrides.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  "../../../rhodium/core/main.rhm" open
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../examples/rtl/generator-parameters.rhdl" as example
  "generator-parameters.rhdl" as fixture

def example_ordinary_defaults_design = compile_program(example.ordinary_defaults_program, rtl_target).report.design
def example_ordinary_overrides_design = compile_program(example.ordinary_overrides_program, rtl_target).report.design
def example_ordinary_typed_defaults_design = compile_program(example.ordinary_typed_defaults_program, rtl_target).report.design
def example_ordinary_required_keyword_design = compile_program(example.ordinary_required_keyword_program, rtl_target).report.design
def example_sync_defaults_design = compile_program(example.sync_defaults_program, rtl_target).report.design
def example_sync_overrides_design = compile_program(example.sync_overrides_program, rtl_target).report.design
def example_sync_typed_defaults_design = compile_program(example.sync_typed_defaults_program, rtl_target).report.design

fun result_width(design):
  design.modules[0].find_output("result").type.width

def opaque_design = compile_program(elaborate(fixture.OpaqueHostParameters()), rtl_target).report.design

check:
  result_width(example_ordinary_defaults_design) ~is 9
  result_width(example_ordinary_overrides_design) ~is 7
  result_width(example_ordinary_typed_defaults_design) ~is 8
  result_width(example_ordinary_required_keyword_design) ~is 9
  result_width(example_sync_defaults_design) ~is 7
  result_width(example_sync_overrides_design) ~is 8
  result_width(example_sync_typed_defaults_design) ~is 7
  verify_design(example_ordinary_defaults_design) ~is #void
  verify_design(example_ordinary_overrides_design) ~is #void
  verify_design(example_ordinary_typed_defaults_design) ~is #void
  verify_design(example_ordinary_required_keyword_design) ~is #void
  verify_design(example_sync_defaults_design) ~is #void
  verify_design(example_sync_overrides_design) ~is #void
  verify_design(example_sync_typed_defaults_design) ~is #void
  opaque_design.modules.map(fun (module_def): module_def.name) ~is [
    "OpaqueHostParameters",
    "ParameterSink",
    "ParameterSink_1",
    "ParameterSink_2",
    "ParameterSink_3",
    "ParameterSink_4",
    "ParameterSink_5"
  ]
  verify_design(opaque_design) ~is #void
  elaborate(fixture.InvalidKeywordHardwareParameter()) ~throws "must be a host value, not live hardware"
