#lang rhodium

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target

// Exercises the canonical symbolic bitwise operators and their precedence.
// SPDX-License-Identifier: Apache-2.0

circuit BitwisePrecedence():
  input(a, b, c): Bits(8)
  output result: Bits(8)

  result <== a ||| b & c

def design = compile_program(elaborate(BitwisePrecedence()), rtl_target).report.design

export:
  BitwisePrecedence
  design
