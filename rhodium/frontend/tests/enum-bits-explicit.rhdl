#lang rhodium
// Constructs the enum state machine with its explicit two-bit representation.
// SPDX-License-Identifier: Apache-2.0

circuit StateMachine():
  input clock: Clock
  input reset: Reset
  output state_out: Bits(2)

  def idle = bits(0, 2)
  def running = bits(1, 2)
  def done = bits(2, 2)
  reg current(Bits(2), ~clock: clock, ~reset: reset, ~init: idle)
  when (current === idle):
    current <== running
  elsewhen (current === running):
    current <== done
  otherwise:
    current <== idle
  state_out <== current

def design = elaborate(StateMachine())

export:
  StateMachine
  design
