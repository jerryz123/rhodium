#lang rhodium

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target

// Exercises bundle-owned hardware methods and their exact static propagation.
// SPDX-License-Identifier: Apache-2.0

hardware_enum CacheState:
  Invalid
  SharedClean
  SharedDirty
  UniqueClean
  method is_shared(state) :: Bool:
    state.is_one_of(CacheState.SharedClean, CacheState.SharedDirty)

bundle CacheEnvelope():
  state: CacheState
  valid: Bool
  method is_shared(envelope) :: Bool:
    envelope.valid & envelope.state.is_shared()

  method matches(envelope, other) :: Bool:
    envelope.state.is_one_of(other)

  method state_value(envelope) :: CacheState:
    envelope.state

  method identity(envelope) :: CacheEnvelope():
    envelope

bundle SizedCacheEnvelope(width :: PosInt):
  state: CacheState
  payload: Bits(width)

  method is_shared(envelope) :: Bool:
    envelope.state.is_shared()

  method payload_value(envelope) :: Bits(width):
    envelope.payload

  method identity(envelope) :: SizedCacheEnvelope(width):
    envelope

  method plus(envelope, other :: Bits(width), ~extra: extra :: Nat = width) :: Bits(width):
    envelope.payload + other + Bits(width)(extra)

  method bad_result(envelope) :: Bits(width):
    envelope.payload.zext(width + 1)

bundle GenericCacheEnvelope(T :: DataType):
  nested: T

  method value(envelope) :: T:
    envelope.nested

  method choose(envelope, other :: T, select :: Bool) :: T:
    mux(select, other, envelope.nested)

  method replaced(envelope, To :: DataType, value :: Hardware.of(To)) :: GenericCacheEnvelope(To):
    GenericCacheEnvelope(To):
      nested: value

  method keyword_replaced(envelope, value, ~type: To :: DataType) :: GenericCacheEnvelope(To):
    GenericCacheEnvelope(To):
      nested: value

  method widened(envelope, width :: PosInt = 12) :: Bits(width):
    envelope.nested.as_bits().zext(width)

bundle Gate():
  enabled: Bool

  method wrap(gate, ~type: T :: DataType, ~payload: payload :: Hardware.of(T), ~enabled: enabled :: Bool = gate.enabled) :: GenericCacheEnvelope(T):
    GenericCacheEnvelope(T):
      nested: mux(enabled, payload, literal(T, 0))

circuit FixedKeywordMethods(mode :: String):
  input gate: Gate()
  input envelope: CacheEnvelope()
  output shared: Bool
  def wrap = gate.wrap
  cond
  | mode == "direct": shared <== gate.wrap(~payload: envelope, ~type: CacheEnvelope()).value().is_shared()
  | mode == "extracted": shared <== wrap(~enabled: Bool(#true), ~type: CacheEnvelope(), ~payload: envelope).value().is_shared()
  | mode == "missing": shared <== wrap(~type: CacheEnvelope()).value().is_shared()
  | ~else: shared <== wrap(~type: CacheEnvelope(), ~payload: Bits(4)(0)).value().is_shared()

bundle OtherSizedEnvelope(width :: PosInt):
  state: CacheState
  payload: Bits(width)

bundle EnvelopeGroup(width :: PosInt):
  members: Vec(2, SizedCacheEnvelope(width))

bundle LookupEnvelope(width :: PosInt):
  lookup: SizedCacheEnvelope(width)

  method is_shared(envelope) :: Bool:
    envelope.lookup.is_shared()

fun first_shared(width :: PosInt, members :: Vec(2, SizedCacheEnvelope(width))) :: Bool:
  members[0].is_shared()

// A lexical extension with the same name must not shadow exact type-owned
// methods carried by CacheEnvelope and CacheState values.
fun is_shared(_envelope :: CacheEnvelope()) :: Bool:
  Bool(#false)

interface CacheEnvelopeStream(T :: DataType):
  role producer
  role consumer
  provider producer

  producer -> consumer:
    bits: T

interface CacheStateStream():
  role producer
  role consumer
  provider producer

  producer -> consumer:
    state: CacheState

circuit CacheEnvelopeSource(T :: DataType):
  input payload: T
  interface egress(CacheEnvelopeStream(T), ~role: producer)
  egress.bits <== payload

def shared_envelope = CacheEnvelope():
  state: CacheState.SharedClean
  valid: Bool(#true)

circuit BundleMethodEcho():
  input envelope: CacheEnvelope()
  output echoed: CacheEnvelope()
  echoed <== envelope

sync_circuit BundleMethodPropagation():
  input select: Bool
  input envelope: CacheEnvelope()
  input envelopes: Vec(2, CacheEnvelope())
  input memory_address: Bits(1)
  output input_method: Bool
  output literal_method: Bool
  output wire_method: Bool
  output register_method: Bool
  output mux_method: Bool
  output argument_method: Bool
  output typed_enum_result_method: Bool
  output typed_bundle_result_method: Bool
  output vector_method: Bool
  output memory_index_method: Bool
  output memory_read_method: Bool
  output instance_method: Bool
  output packed: Bits(3)

  wire envelope_wire: CacheEnvelope()
  reg envelope_register(CacheEnvelope())
  mem envelope_memory(2, CacheEnvelope())
  inst echo(BundleMethodEcho())
  def selected = mux(select, envelope, shared_envelope)

  envelope_wire <== envelope
  envelope_register <== envelope
  echo.envelope <== envelope
  input_method <== envelope.is_shared()
  literal_method <== shared_envelope.is_shared()
  wire_method <== envelope_wire.is_shared()
  register_method <== envelope_register.is_shared()
  mux_method <== selected.is_shared()
  argument_method <== envelope.matches(CacheState.SharedClean)
  typed_enum_result_method <== envelope.state_value().is_shared()
  typed_bundle_result_method <== envelope.identity().is_shared()
  vector_method <== envelopes[0].is_shared()
  memory_index_method <== envelope_memory[memory_address].is_shared()
  memory_read_method <== envelope_memory.read(memory_address).is_shared()
  instance_method <== echo.echoed.is_shared()
  packed <== envelope.as_bits()

def design = compile_program(elaborate(BundleMethodPropagation()), rtl_target).report.design

sync_circuit ParameterizedMethodPropagation():
  input envelope: SizedCacheEnvelope(8)
  input generic_envelope: GenericCacheEnvelope(CacheEnvelope())
  input group: EnvelopeGroup(8)
  input lookup_envelope: LookupEnvelope(8)
  output bundle_method: Bool
  output generic_bundle_method: Bool
  output instance_interface_method: Bool
  output cast_method: Bool
  output into_method: Bool
  output own_method: Bool
  output bound_method: Bool
  output chained_method: Bool
  output data: Bits(8)
  output sum: Bits(8)
  output generic_result: Bool
  output nested_vector: Bool
  output annotated_vector: Bool
  output argument_vector: Bool
  output field_collision: Bool
  output registered_field_collision: Bool
  output retagged_method: Bool
  output extracted_retagged_method: Bool
  output keyword_retagged_method: Bool
  output default_width: Bits(12)

  inst source(CacheEnvelopeSource(SizedCacheEnvelope(8)))
  source.payload <== envelope
  bundle_method <== envelope.state.is_shared()
  generic_bundle_method <== generic_envelope.nested.is_shared()
  instance_interface_method <== source.egress.bits.state.is_shared()
  cast_method <== envelope.into(Bits(10)).into(SizedCacheEnvelope(8)).state.is_shared()
  into_method <== envelope.into(Bits(10)).into(SizedCacheEnvelope(8)).state.is_shared()
  own_method <== envelope.is_shared()
  def captured = envelope.is_shared
  bound_method <== captured()
  chained_method <== envelope.identity().is_shared()
  data <== envelope.payload_value()
  sum <== envelope.plus(Bits(8)(2), ~extra: 1)
  generic_result <== generic_envelope.choose(generic_envelope.value(), Bool(#true)).is_shared()
  def members :: Vec(2, SizedCacheEnvelope(8)) = group.members
  nested_vector <== group.members[0].is_shared()
  annotated_vector <== members[1].is_shared()
  argument_vector <== first_shared(8, group.members)
  reg saved_lookup(~next: lookup_envelope)
  field_collision <== lookup_envelope.lookup.into(SizedCacheEnvelope(8)).is_shared() & lookup_envelope.is_shared()
  registered_field_collision <== saved_lookup.lookup.into(SizedCacheEnvelope(8)).is_shared()
  retagged_method <== generic_envelope.replaced(CacheEnvelope(), generic_envelope.nested).value().is_shared()
  def replace = generic_envelope.replaced
  extracted_retagged_method <== replace(SizedCacheEnvelope(8), envelope).value().is_shared()
  keyword_retagged_method <== generic_envelope.keyword_replaced(envelope, ~type: SizedCacheEnvelope(8)).value().is_shared()
  default_width <== generic_envelope.widened()

circuit InvalidParameterizedMethod(kind :: String):
  input envelope: SizedCacheEnvelope(8)
  input other: OtherSizedEnvelope(8)
  input generic: GenericCacheEnvelope(Bits(8))
  output result: Bits(8)
  cond
  | kind == "argument": result <== envelope.plus(Bits(4)(0))
  | kind == "generic-argument": result <== generic.choose(Bits(4)(0), Bool(#true))
  | kind == "dependent-argument": result <== generic.replaced(Bits(8), Bits(4)(0)).nested
  | kind == "result": result <== envelope.bad_result()
  | ~else:
      def wrong_family :: SizedCacheEnvelope(8) = other
      result <== wrong_family.payload_value()

def parameterized_design = compile_program(elaborate(ParameterizedMethodPropagation()), rtl_target).report.design

sync_circuit DirectInterfaceMethodPropagation():
  interface ingress(CacheStateStream(), ~role: consumer)
  output interface_method: Bool

  def state :: CacheState = ingress.state
  interface_method <== state.is_shared()

def direct_interface_design = compile_program(elaborate(DirectInterfaceMethodPropagation()), rtl_target).report.design

export:
  CacheState
  CacheEnvelope
  SizedCacheEnvelope
  GenericCacheEnvelope
  CacheEnvelopeStream
  CacheStateStream
  CacheEnvelopeSource
  BundleMethodEcho
  BundleMethodPropagation
  ParameterizedMethodPropagation
  DirectInterfaceMethodPropagation
  InvalidParameterizedMethod
  FixedKeywordMethods
  design
  parameterized_design
  direct_interface_design
