#lang rhodium
// Exercises nominal and structural StableCircuitParam specialization equality.
// SPDX-License-Identifier: Apache-2.0

class WidthConfig(width :: PosInt):
  implements StableCircuitParam

class NominalConfig(width :: PosInt):
  implements StableCircuitParam
  opaque
  internal _NominalConfig
  constructor ~none

circuit ConfiguredLeaf(config :: WidthConfig):
  output value: Bits(config.width)
  value <== bits(0, config.width)

circuit NominalLeaf(config :: NominalConfig):
  output value: Bits(config.width)
  value <== bits(0, config.width)

circuit CircuitParamHierarchy():
  inst first(ConfiguredLeaf(WidthConfig(8)))
  inst second(ConfiguredLeaf(WidthConfig(8)))
  inst different(ConfiguredLeaf(WidthConfig(16)))
  def shared = _NominalConfig(4)
  inst nominal_first(NominalLeaf(shared))
  inst nominal_second(NominalLeaf(shared))
  inst nominal_distinct(NominalLeaf(_NominalConfig(4)))

def design = elaborate(CircuitParamHierarchy())

export:
  WidthConfig
  NominalConfig
  ConfiguredLeaf
  NominalLeaf
  CircuitParamHierarchy
  design
