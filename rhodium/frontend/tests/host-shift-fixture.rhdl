#lang rhodium
// Exercises constant host-integer shifts alongside dynamic hardware shifts.
// SPDX-License-Identifier: Apache-2.0

circuit HostShiftOps():
  input unsigned_value: Bits(8)
  input signed_value: SInt(8)
  input dynamic_amount: Bits(3)
  output(left_zero, left_three, right_three, dynamic_left): Bits(8)
  output signed_right_three: SInt(8)
  output(function_left, function_right): Bits(8)

  left_zero <== unsigned_value << 0
  left_three <== unsigned_value << 3
  right_three <== unsigned_value >> 3
  dynamic_left <== unsigned_value << dynamic_amount
  signed_right_three <== signed_value >> 3
  function_left <== hw_shl(unsigned_value, 3)
  function_right <== hw_shru(unsigned_value, 3)

circuit NegativeHostShift():
  input value: Bits(8)
  output result: Bits(8)
  result <== value << (-1)

def design = elaborate(HostShiftOps())

export:
  HostShiftOps
  NegativeHostShift
  design
