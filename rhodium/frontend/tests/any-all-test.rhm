#lang rhombus
// Checks hardware any/all lowering, list identities, and host reducer coexistence.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  "../../../rhodium/core/main.rhm" open
  "../../../rhodium/frontend/layers/bool.rhm" as bool
  "../../../examples/rtl/bit-utilities.rhdl" as fixture

def fixture_reduction_design = compile_program(fixture.reduction_program, rtl_target).report.design

def module_def = fixture_reduction_design.modules[0]
def reductions = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode in ["rtl.any", "rtl.all"]
)
def constants = module_def.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.constant"
)

check:
  bool.bool_type(module_def.find_output("any_bits").type) ~is #true
  bool.bool_type(module_def.find_output("any_flags").type) ~is #true
  bool.bool_type(module_def.find_output("all_bits").type) ~is #true
  bool.bool_type(module_def.find_output("all_flags").type) ~is #true
  bool.bool_type(module_def.find_output("any_list").type) ~is #true
  bool.bool_type(module_def.find_output("all_list").type) ~is #true
  bool.bool_type(module_def.find_output("any_empty").type) ~is #true
  bool.bool_type(module_def.find_output("all_empty").type) ~is #true
  reductions.map(fun (operation): operation.opcode) ~is ["rtl.any", "rtl.any", "rtl.all", "rtl.all", "rtl.any", "rtl.all"]
  reductions.map(fun (operation): operation.operands.map(fun (operand): operand.type.width)) ~is [[8], [4], [8], [4], [1, 1, 1, 1], [1, 1, 1, 1]]
  constants.map(fun (operation): operation.attribute("value")) ~is [0, 1]

  verify_design(fixture_reduction_design) ~is #void

// Opening the hardware functions must preserve the same names in reducer space.
import "../layers/bool.rhm" open
check:
  (for any (flag in [#false, #true]): flag) ~is #true
  (for all (flag in [#true, #false]): flag) ~is #false
