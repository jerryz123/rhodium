#lang rhodium

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target

// Exercises lazy synchronous state, nested providers, and independent scoped resets.
// SPDX-License-Identifier: Apache-2.0

sync_circuit Stage():
  input source: Bits(8)
  input enable: Bool
  input clear: Bool
  output result: Bits(8)
  output echo: Bits(8)
  reset_when(clear):
    reg held(Bits(8), ~init: bits(0, 8))
    when enable: held <== source
    result <== held
  echo <== source

def signature = ModuleSignature([PortSignature("clock", Clock), PortSignature("reset", Reset), PortSignature("source", Bits(8)), PortSignature("enable", Bool), PortSignature("clear", Bool)], [PortSignature("result", Bits(8)), PortSignature("echo", Bits(8))])
def dependencies = [[OutputLeafDependency([], [])], [OutputLeafDependency([], [InputLeaf(2, [])])]]
def definition = ConstructDefinition(ConstructIdentity("Stage"), [], signature, dependencies, ~state: SingleClockState("clock", "reset"))
def mutable calls = 0
fun counted():
  calls := calls + 1
  Stage()
def reference = retained_circuit(definition, counted)

sync_circuit Wrapped():
  input source: Bits(8)
  input enable: Bool
  input clear: Bool
  output result: Bits(8)
  output echo: Bits(8)
  inst child(reference)
  child.source <== source
  child.enable <== enable
  child.clear <== clear
  result <== child.result
  echo <== child.echo

def wrapped = retained_circuit(ConstructDefinition(ConstructIdentity("Wrapped"), [], signature, dependencies, ~state: SingleClockState("clock", "reset")), fun (): Wrapped())

sync_circuit Top(child):
  input (a, b): Bits(8)
  input (enable_a, enable_b, reset_a, clear_b): Bool
  output (left, right, delayed, bypass): Bits(8)
  def selected = child || Stage()
  inst first(selected, ~reset_when: reset_a)
  inst second(selected)
  inst third(selected)
  first.source <== a
  first.enable <== enable_a
  first.clear <== Bool(#false)
  second.source <== b
  second.enable <== enable_b
  second.clear <== clear_b
  third.source <== first.result
  third.enable <== Bool(#true)
  third.clear <== Bool(#false)
  left <== first.result
  right <== second.result
  delayed <== third.result
  bypass <== first.echo

def program = elaborate(Top(reference))
def nested_program = elaborate(Top(wrapped))
def calls_after_composition = calls
def eager = compile_program(elaborate(Top(#false)), rtl_target).report.elaboration
fun call_count(): calls

// Both lanes receive the same sampled stimulus; the bench supplies an
// independent expected-value model in addition to differential comparison.
sync_circuit ComparisonTop():
  input (a, b): Bits(8)
  input (enable_a, enable_b, reset_a, clear_b): Bool
  output (left, right, delayed, bypass): Bits(8)
  output (eager_left, eager_right, eager_delayed, eager_bypass): Bits(8)
  inst mixed(Top(reference))
  inst baseline(Top(#false))
  for (lane in [mixed, baseline]):
    lane.a <== a
    lane.b <== b
    lane.enable_a <== enable_a
    lane.enable_b <== enable_b
    lane.reset_a <== reset_a
    lane.clear_b <== clear_b
  left <== mixed.left
  right <== mixed.right
  delayed <== mixed.delayed
  bypass <== mixed.bypass
  eager_left <== baseline.left
  eager_right <== baseline.right
  eager_delayed <== baseline.delayed
  eager_bypass <== baseline.bypass

sync_circuit Feedback(bypass :: Boolean):
  output result: Bits(8)
  inst child(reference)
  child.source <== (if bypass | child.echo | child.result)
  child.enable <== Bool(#true)
  child.clear <== Bool(#false)
  result <== child.result
fun feedback(bypass :: Boolean): elaborate(Feedback(bypass))

export:
  feedback
  Stage
  Top
  ComparisonTop
  signature
  dependencies
  definition
  reference
  program
  nested_program
  eager
  calls_after_composition
  call_count
