// Marks the recursive interface branch of an interface member's type.
interface InterfaceMemberType

class InterfaceDirection(from_role :: String, to_role :: String, type :: RecordType):
  constructor (from_role :: String, to_role :: String, type :: RecordType):
    unless from_role != to_role
    | error(~who: #'InterfaceDirection,
            "interface direction requires two distinct role names")
    unless type_well_formed(type)
    | error(~who: #'InterfaceDirection,
            "interface direction type must be a well-formed RecordType")
    super(from_role, to_role, type)

class InterfaceMember(name :: String,
                      type :~ DataType || InterfaceMemberType,
                      from_role :: String,
                      to_role :: String)
class InterfaceSupport(role :: String, type :: InterfaceMemberType)
class InterfaceCompatibility(role :: String,
                             predicate :: Function.of_arity(2))
class InterfaceIdentity()

// The parent supplies inherited layout. Additional supported types declare
// behavioral substitutability for the provider role and must be structural
// subsets. Identity distinguishes declarations while recursive structure
// distinguishes their parameterized specializations.
class InterfaceType(name :: String,
                    identity :: InterfaceIdentity,
                    roles :: List.of(String),
                    members :: NonemptyList.of(InterfaceMember),
                    provider_role :: String,
                    parent :~ False || InterfaceType = #false,
                    supported_contracts :: List.of(InterfaceSupport) = [],
                    specialization_arguments :: List = [],
                    connection_compatibility :: False || InterfaceCompatibility = #false):
  implements InterfaceMemberType
  constructor (name :: String,
               roles :: List.of(String),
               declarations :: List,
               parent :~ False || InterfaceType = #false,
               supported_contracts :: List.of(InterfaceSupport) = [],
               ~provider_role: supplied_provider_role :: False || String = #false,
               ~identity: identity :: InterfaceIdentity = InterfaceIdentity(),
               ~specialization_arguments: specialization_arguments :: List = [],
               ~connection_compatibility: connection_compatibility :: False || InterfaceCompatibility = #false):
    unless roles.length() == 2 && roles[0] != roles[1]
    | error(~who: #'InterfaceType, "interfaces require exactly two distinct roles")
    def provider_role = supplied_provider_role || roles[0]
    unless provider_role in roles
    | error(~who: #'InterfaceType,
            "interface provider role must be one of the declared roles")
    when parent
    | unless parent is_a InterfaceType
      | error(~who: #'InterfaceType,
              "interface refinement parent must be an InterfaceType")
      unless roles == parent.roles
      | error(~who: #'InterfaceType,
              "refined interface roles must match the parent roles")
      unless provider_role == parent.provider_role
      | error(~who: #'InterfaceType,
              "refined interface provider role must match the parent provider role")
    when connection_compatibility
    | unless connection_compatibility.role == provider_role
      | error(~who: #'InterfaceType,
              "interface compatibility role must match the provider role")
    def mutable members = if parent | parent.members | []
    for (declaration in declarations):
      cond
      | declaration is_a InterfaceMember:
          members := members ++ [declaration]
      | declaration is_a InterfaceDirection:
          members := members ++ declaration.type.fields.map(
            fun (field):
              InterfaceMember(field.name,
                              field.type,
                              declaration.from_role,
                              declaration.to_role)
          )
      | ~else:
          members := members ++ [declaration]
    unless members.length() >= 1
    | error(~who: #'InterfaceType, "interfaces require at least one member")
    for (member in members):
      unless member is_a InterfaceMember
      | error(~who: #'InterfaceType, "interface members must be InterfaceMember values")
      unless member.from_role in roles && member.to_role in roles && member.from_role != member.to_role
      | error(~who: #'InterfaceType, "interface member uses an unknown or identical role")
      unless member.type is_a DataType || member.type is_a InterfaceType
      | error(~who: #'InterfaceType,
              "interface member type must be a DataType or InterfaceType")
      when members.filter(
        ~keep: fun (candidate): candidate.name == member.name
      ).length() != 1
      | error(~who: #'InterfaceType, "interface member names must be unique")
    for (supported_contract in supported_contracts):
      unless supported_contract.role == provider_role
      | error(~who: #'InterfaceType,
              "supported interface contract role must match the provider role")
      def supported_type = supported_contract.type
      unless supported_type is_a InterfaceType
      | error(~who: #'InterfaceType,
              "supported interface contracts must be InterfaceType values")
      unless roles == supported_type.roles
      | error(~who: #'InterfaceType,
              "supported interface roles must match")
      unless provider_role == supported_type.provider_role
      | error(~who: #'InterfaceType,
              "supported interface provider roles must match")
      for (supported_member in supported_type.members):
        def member = members.find(
          fun (candidate): candidate.name == supported_member.name
        )
        unless member
        | error(~who: #'InterfaceType,
                "supported interface members must be present with the same type and direction")
        unless member.from_role == supported_member.from_role && member.to_role == supported_member.to_role && interface_member_type_equal(member.type, supported_member.type)
        | error(~who: #'InterfaceType,
                "supported interface members must be present with the same type and direction")
    super(name,
          identity,
          roles,
          members,
          provider_role,
          parent,
          supported_contracts,
          specialization_arguments,
          connection_compatibility)

  property directions: interface_directions(this)
  property supported_types:
    supported_contracts.map(fun (contract): contract.type)

  method direction_for_field(field_name :: String):
    def member = members.find(fun (candidate): candidate.name == field_name)
    if member
    | directions.find(
        fun (direction):
          direction.from_role == member.from_role && direction.to_role == member.to_role
      )
    | #false

  method complementary_role(role :: String):
    unless role in roles
    | error(~who: #'interface, "unknown interface role " ++ role)
    if roles[0] == role | roles[1] | roles[0]

fun nested_role_to_parent(member :: InterfaceMember,
                          nested_type :: InterfaceType,
                          nested_role :: String):
  if nested_role == nested_type.roles[0]
  | member.from_role
  | member.to_role

fun nested_direction_for_parent(member :: InterfaceMember,
                                parent_from :: String,
                                parent_to :: String):
  def nested_type = member.type
  nested_type.directions.find(
    fun (direction):
      (nested_role_to_parent(member, nested_type, direction.from_role) == parent_from) && (nested_role_to_parent(member, nested_type, direction.to_role) == parent_to)
  )

fun interface_direction(type :: InterfaceType,
                        from_role :: String,
                        to_role :: String):
  def mutable fields = []
  for (member in type.members):
    if member.type is_a DataType
    | when member.from_role == from_role && member.to_role == to_role
      | fields := fields ++ [RecordField(member.name, member.type)]
    | block:
        def nested_direction = nested_direction_for_parent(member,
                                                           from_role,
                                                           to_role)
        when nested_direction
        | fields := fields ++ [RecordField(member.name, nested_direction.type)]
  if fields.length() == 0
  | #false
  | InterfaceDirection(from_role, to_role, RecordType(fields))

fun interface_directions(type :: InterfaceType):
  def forward = interface_direction(type, type.roles[0], type.roles[1])
  def backward = interface_direction(type, type.roles[1], type.roles[0])
  [forward, backward].filter(
    ~keep: fun (direction): direction
  )

class InterfaceBinding(direction :: InterfaceDirection,
                       port_name :: String,
                       entity :: Value || Place)

// Marks a linear interface object that can participate in topology composition.
interface InterfaceTopologySource

class InterfaceEndpoint(type :: InterfaceType,
                        role :: String,
                        represented_role :: String,
                        bindings :: NonemptyList.of(InterfaceBinding),
                        view :: String,
                        mutable nested_endpoints :: List = []):
  implements kernel.HardwareEntity
  implements Callable
  implements InterfaceTopologySource

  // A concrete endpoint is a generic topology terminal when it appears as
  // the callee on the right of `|>`. A detached handle remains a sink with
  // its input side open; a concrete source completes the connection.
  override method call(source :: InterfaceTopologySource || Array):
    connect_interface_fields(source, this)

  method field(field_name :: String):
    def member = type.members.find(fun (candidate): candidate.name == field_name)
    unless member
    | error(~who: #'interface,
            "interface " ++ type.name ++ " has no field named " ++ field_name)
    if member.type is_a InterfaceType
    | block:
        def cached = nested_endpoints.find(
          fun (candidate): candidate[0] == field_name
        )
        if cached
        | cached[1]
        | block:
            def endpoint = nested_endpoint(this, member)
            nested_endpoints := nested_endpoints ++ [[field_name, endpoint]]
            endpoint
    | block:
        def binding = bindings.find(
          fun (candidate):
            candidate.direction.from_role == member.from_role && candidate.direction.to_role == member.to_role
        )
        kernel.project(binding.entity, field_name)

// Presents every interface leaf as a readable value, independent of which
// endpoint role drives that leaf. Instrumentation receives this view so it can
// correlate both directions without acquiring connection or drive access.
class InterfaceObservation(endpoint :: InterfaceEndpoint,
                           mutable nested_observations :: List = []):
  method field(field_name :: String):
    def member = endpoint.type.members.find(
      fun (candidate): candidate.name == field_name
    )
    unless member
    | error(~who: #'interface,
            "interface " ++ endpoint.type.name ++ " has no field named " ++ field_name)
    if member.type is_a InterfaceType
    | block:
        def cached = nested_observations.find(
          fun (candidate): candidate[0] == field_name
        )
        if cached
        | cached[1]
        | block:
            def observation = InterfaceObservation(endpoint.field(field_name))
            nested_observations := nested_observations ++ [[field_name, observation]]
            observation
    | kernel.read(endpoint.field(field_name))

// Owns the two still-exposed ends of an interface transformation. Calling a
// handle connects a source shape to its left end and returns its right end;
// calling one handle with another composes their adjacent ends.
class InterfaceHandle(left :: InterfaceEndpoint || Array,
                      right :: InterfaceEndpoint || Array,
                      mutable consumed :: Boolean = #false):
  implements Callable
  implements InterfaceTopologySource

  override method call(source :: InterfaceTopologySource || Array):
    unless !consumed
    | error(~who: #'InterfaceHandle,
            "an interface handle can be consumed only once")
    if source is_a InterfaceHandle
    | block:
        unless !source.consumed
        | error(~who: #'InterfaceHandle,
                "an interface handle can be consumed only once")
        connect_endpoint_shapes(source.right, left)
        source.consumed := #true
        consumed := #true
        InterfaceHandle(source.left, right)
    | block:
        connect_endpoint_shapes(source, left)
        consumed := #true
        right

// Owns the still-exposed input end of a transformation whose output has
// already been connected. Applying a concrete source completes the topology;
// composing an earlier handle produces another sink with its input exposed.
class InterfaceSink(left :: InterfaceEndpoint || Array,
                    mutable consumed :: Boolean = #false):
  implements Callable

  override method call(source :: InterfaceTopologySource || Array):
    unless !consumed
    | error(~who: #'InterfaceSink,
            "an interface sink can be consumed only once")
    if source is_a InterfaceHandle
    | block:
        unless !source.consumed
        | error(~who: #'InterfaceSink,
                "an interface handle can be consumed only once")
        connect_endpoint_shapes(source.right, left)
        source.consumed := #true
        consumed := #true
        InterfaceSink(source.left)
    | block:
        connect_endpoint_shapes(source, left)
        consumed := #true
        #void

class InterfaceGroup(module_def :: Module,
                     name :: String,
                     type :: InterfaceType,
                     role :: String,
                     bindings :: NonemptyList.of(InterfaceBinding)):
  implements ModuleMetadataPayload
class InterfaceArrayGroup(module_def :: Module,
                          name :: String,
                          groups :: NonemptyList.of(InterfaceGroup)):
  implements ModuleMetadataPayload

// Describes one possible transaction route through an N-to-M interface
// transform. Indices refer to the flattened top-level endpoint arrays.
class InterfaceTraceRoute(input_index :: Nat, output_index :: Nat)

// Certifies combinational transfer separately from possible static routes.
// Absence of this contract never implies zero-latency runtime propagation.
class InterfaceTraceCombinational(guard :: False || Value = #false)

// Certifies fixed latency for survivors, with synchronous reset and optional flush.
class InterfaceTraceFixedLatency(cycles :: PosInt, flush :: False || Value = #false)

class InterfaceElasticStage(advance :: Value, valid :: Value)
class InterfaceElasticStages(module_def :: Module, stages :: NonemptyList.of(InterfaceElasticStage), name :: String = "data"):
  implements ModuleMetadataPayload
class InterfaceTraceElastic(instance :: False || Instance, stages :: NonemptyList.of(InterfaceElasticStage))

// One transaction owner may emit repeatedly until release; outputs do not pop it.
class InterfaceRetainedStorage(module_def :: Module, capture :: Value, release :: Value, active :: Value, name :: String):
  implements ModuleMetadataPayload
  method controls(): [capture, release, active]
class InterfaceTraceRetained(instance :: False || Instance, storage :: InterfaceRetainedStorage)
// Connects two annotated route occurrences through one retained transaction
// storage declaration without adding a functional interface connection.
class InterfaceTraceEdge(module_def :: Module,
                         parent :: InterfaceEndpoint,
                         child :: InterfaceEndpoint,
                         storage :: InterfaceRetainedStorage):
  implements ModuleMetadataPayload
// An intentional ancestry cut, distinct from an unsupported or missing route.
class InterfaceTraceDetached()

// Certifies an in-order, async-read queue using its functional storage controls.
class InterfaceQueueStorage(module_def :: Module, depth :: PosInt,
                            enqueue :: Value, dequeue :: Value,
                            read_address :: Value, write_address :: Value,
                            stored_valid :: Value, bypass :: Value, name :: String = "data"):
  implements ModuleMetadataPayload
  method controls(): [enqueue, dequeue, read_address, write_address, stored_valid, bypass]
class InterfaceTraceQueue(instance :: False || Instance, storage :: InterfaceQueueStorage)

// Ordered retained entries support repeated reads and multi-entry contributions.
class InterfaceWindowStorage(module_def :: Module, depth :: PosInt,
                             enqueue :: Value, release_count :: Value, count :: Value, flush :: Value,
                             selected :: NonemptyList.of(Value), name :: String):
  implements ModuleMetadataPayload
  method controls(): [enqueue, release_count, count, flush] ++ selected
class InterfaceTraceWindow(instance :: False || Instance, storage :: InterfaceWindowStorage)
class InterfaceSelection(module_def :: Module, grants :: NonemptyList.of(Value), name :: String = "data"):
  implements ModuleMetadataPayload
class InterfaceTraceSelection(instance :: False || Instance, grants :: NonemptyList.of(Value))
class InterfaceTraceRouting(predicates :: NonemptyList.of(Value))
// Zero-storage replication: every output transfers exactly when the input does.
class InterfaceTraceAtomicFork(output_count :: PosInt)
// Zero-storage rendezvous: every input transfers exactly when the output does.
class InterfaceTraceAtomicJoin(input_count :: PosInt)
// One resident item, captured on acceptance, retained for independent recipients.
class InterfaceBroadcastStorage(module_def :: Module, accept :: Value, pending :: NonemptyList.of(Value), name :: String = "data"):
  implements ModuleMetadataPayload
  method controls(): [accept] ++ pending
class InterfaceTraceBufferedBroadcast(instance :: False || Instance, storage :: InterfaceBroadcastStorage)

class InterfaceTraceModel(routes :: NonemptyList.of(InterfaceTraceRoute),
                          dynamic :: False || InterfaceTraceCombinational || InterfaceTraceFixedLatency || InterfaceTraceElastic || InterfaceTraceRetained || InterfaceTraceDetached || InterfaceTraceQueue || InterfaceTraceWindow || InterfaceTraceSelection || InterfaceTraceRouting || InterfaceTraceAtomicFork || InterfaceTraceBufferedBroadcast || InterfaceTraceAtomicJoin = #false):
  method latency_cycles():
    cond
    | dynamic is_a InterfaceTraceFixedLatency: dynamic.cycles
    | dynamic is_a InterfaceTraceCombinational: 0
    | dynamic is_a InterfaceTraceSelection: 0
    | dynamic is_a InterfaceTraceRouting: 0
    | dynamic is_a InterfaceTraceAtomicFork: 0
    | dynamic is_a InterfaceTraceAtomicJoin: 0
    | ~else: #false
  method elastic_stages():
    if dynamic is_a InterfaceTraceElastic | dynamic.stages | #false
  method fixed_latency_flush():
    if dynamic is_a InterfaceTraceFixedLatency | dynamic.flush | #false
  method elastic_instance():
    if dynamic is_a InterfaceTraceElastic | dynamic.instance | #false
  method retained_storage():
    if dynamic is_a InterfaceTraceRetained | dynamic.storage | #false
  method retained_instance():
    if dynamic is_a InterfaceTraceRetained | dynamic.instance | #false
  method detached(): dynamic is_a InterfaceTraceDetached
  method queue_storage():
    if dynamic is_a InterfaceTraceQueue | dynamic.storage | #false
  method queue_instance():
    if dynamic is_a InterfaceTraceQueue | dynamic.instance | #false
  method window_storage():
    if dynamic is_a InterfaceTraceWindow | dynamic.storage | #false
  method window_instance():
    if dynamic is_a InterfaceTraceWindow | dynamic.instance | #false
  method selection_grants():
    if dynamic is_a InterfaceTraceSelection | dynamic.grants | #false
  method selection_instance():
    if dynamic is_a InterfaceTraceSelection | dynamic.instance | #false
  method routing_predicates():
    if dynamic is_a InterfaceTraceRouting | dynamic.predicates | #false
  method atomic_fork_outputs():
    if dynamic is_a InterfaceTraceAtomicFork | dynamic.output_count | #false
  method atomic_join_inputs():
    if dynamic is_a InterfaceTraceAtomicJoin | dynamic.input_count | #false
  method broadcast_storage():
    if dynamic is_a InterfaceTraceBufferedBroadcast | dynamic.storage | #false
  method broadcast_instance():
    if dynamic is_a InterfaceTraceBufferedBroadcast | dynamic.instance | #false

  // Controls are relative to the declaring module, or an explicitly bound
  // immediate child. Occurrence expansion resolves this once for all models.
  method owner_path():
    def instance = this.elastic_instance() || this.retained_instance() || this.queue_instance() || this.window_instance() || this.selection_instance() || this.broadcast_instance()
    if instance | [instance.operation.attribute("name")] | []

class InterfaceTransformGroup(module_def :: Module,
                              kind :: String,
                              input :: InterfaceEndpoint || Array,
                              output :: InterfaceEndpoint || Array,
                              properties :: Map,
                              implementation :: False || Instance,
                              trace_model :: False || InterfaceTraceModel = #false,
                              contract_name :: False || String = #false):
  implements ModuleMetadataPayload
class InterfaceEventField(name :: String, value :: Value, encoding :: String,
                          isa :: String = "", pc :: String = "",
                          symbols :: List.of(Map) = [], label :: Boolean = #false)

// Capture expressions are local observations, independent of lineage metadata.
fun event_field(name :: String, value :: HardwareEntity,
                ~format: encoding :: False || String = #false,
                ~isa: isa :: String = "", ~pc: pc :: String = "",
                ~label: label :: Boolean = #false,
                ~location: location :: Location = Location()) :: InterfaceEventField:
  def captured = kernel.read(value, location)
  unless name is_a AsciiIdentifier && scalar_data_type(captured.type)
  | error(~who: #'event_field, "capture requires an ASCII identifier name and scalar DataType")
  when name in ["cycle", "sequence"]
  | error(~who: #'event_field, "reserved capture field name: " ++ name)
  def format = encoding || (if bool_type(captured.type) | "bool" | (if signed_arithmetic_type(captured.type) | "signed" | "hex"))
  unless format in ["hex", "unsigned", "signed", "bool", "riscv", "enum"]
  | error(~who: #'event_field, "unsupported capture format")
  when format == "bool" && captured.type.packed_width() != 1
  | error(~who: #'event_field, "boolean capture must be one bit")
  if format == "riscv"
  | block:
      unless captured.type.packed_width() in [16, 32] && isa is_a AsciiIdentifier && (isa.starts_with("rv32i") || isa.starts_with("rv64i")) && pc is_a AsciiIdentifier
      | error(~who: #'event_field, "RISC-V capture requires 16/32 bits, an rv32i/rv64i ISA, and a PC field name")
  | unless isa == "" && pc == ""
    | error(~who: #'event_field, "ISA and PC options require RISC-V capture format")
  def symbols:
    if format == "enum"
    | block:
        unless enum_type(captured.type) && captured.type.packed_width() <= 64
        | error(~who: #'event_field, "enum capture requires a hardware enum of at most 64 bits")
        enum_members(captured.type).map(fun (member): {"name": member, "value": to_string(enum_encoding(captured.type, member))})
    | []
  when label && format != "enum"
  | error(~who: #'event_field, "event label selection requires enum capture format")
  InterfaceEventField(name, captured, format, isa, pc, symbols, label)

class InterfaceEventGroup(module_def :: Module,
                          site_index :: Nat,
                          label :: String,
                          input :: InterfaceEndpoint,
                          output :: InterfaceEndpoint,
                          payload :: False || Value,
                          terminal :: Boolean,
                          location :: Location,
                          valid :: False || Value = #false,
                          ready :: False || Value = #false,
                          root :: Boolean = #false,
                          fields :: List.of(InterfaceEventField) = [],
                          stalls :: Boolean = #false):
  implements ModuleMetadataPayload
class InterfaceConnectionGroup(module_def :: Module,
                               source :: InterfaceEndpoint,
                               destination :: InterfaceEndpoint):
  implements ModuleMetadataPayload
class InterfaceLinkGroup(module_def :: Module,
                         name :: String,
                         left :: InterfaceEndpoint,
                         right :: InterfaceEndpoint):
  implements ModuleMetadataPayload

def interface_group_namespace = "rhodium.interface.group"
def interface_array_group_namespace = "rhodium.interface.array-group"
def interface_transform_group_namespace = "rhodium.interface.transform"
def interface_event_group_namespace = "rhodium.interface.event"
def interface_connection_group_namespace = "rhodium.interface.connection"
def interface_link_group_namespace = "rhodium.interface.link"
def interface_elastic_stages_namespace = "rhodium.interface.elastic-stages"
def interface_retained_storage_namespace = "rhodium.interface.retained-storage"
def interface_queue_storage_namespace = "rhodium.interface.queue-storage"
def interface_window_storage_namespace = "rhodium.interface.window-storage"
def interface_broadcast_storage_namespace = "rhodium.interface.broadcast-storage"
def interface_selection_namespace = "rhodium.interface.selection"
def interface_trace_edge_namespace = "rhodium.interface.trace-edge"

fun module_interface_groups(module_def :: Module):
  module_def.metadata_for(interface_group_namespace)

fun module_interface_array_groups(module_def :: Module):
  module_def.metadata_for(interface_array_group_namespace)

fun module_interface_transforms(module_def :: Module):
  module_def.metadata_for(interface_transform_group_namespace)

fun module_interface_events(module_def :: Module):
  module_def.metadata_for(interface_event_group_namespace)

fun module_interface_connections(module_def :: Module):
  module_def.metadata_for(interface_connection_group_namespace)

fun module_interface_links(module_def :: Module):
  module_def.metadata_for(interface_link_group_namespace)

fun module_interface_trace_edges(module_def :: Module):
  module_def.metadata_for(interface_trace_edge_namespace)

fun interface_member_type_equal(left :: DataType || InterfaceType,
                                right :: DataType || InterfaceType):
  if left is_a InterfaceType || right is_a InterfaceType
  | left is_a InterfaceType && right is_a InterfaceType && interface_type_equal(left, right)
  | type_equal(left, right)

// Connection policies may relax specialization arguments, but never the
// recursively realized wire layout that an ordinary kernel connection sees.
fun interface_member_wire_shape_equal(left :: DataType || InterfaceType,
                                      right :: DataType || InterfaceType):
  if left is_a InterfaceType || right is_a InterfaceType
  | left is_a InterfaceType && right is_a InterfaceType && interface_type_wire_shape_equal(left, right)
  | type_equal(left, right)

fun interface_type_wire_shape_equal(left :: InterfaceType,
                                    right :: InterfaceType):
  left.roles == right.roles && left.provider_role == right.provider_role && left.members.length() == right.members.length() && (
    for all (left_member in left.members, right_member in right.members):
      left_member.name == right_member.name && left_member.from_role == right_member.from_role && left_member.to_role == right_member.to_role && interface_member_wire_shape_equal(left_member.type, right_member.type)
  )

fun interface_type_equal(left :: InterfaceType, right :: InterfaceType):
  if !(left.identity === right.identity) || left.roles != right.roles || left.provider_role != right.provider_role || !interface_parent_equal(left.parent, right.parent) || left.supported_contracts.length() != right.supported_contracts.length() || left.members.length() != right.members.length()
  | #false
  | (for all (left_supported in left.supported_contracts,
              right_supported in right.supported_contracts):
       left_supported.role == right_supported.role && interface_type_equal(left_supported.type, right_supported.type)) && (
      for all (left_member in left.members, right_member in right.members):
        left_member.name == right_member.name && left_member.from_role == right_member.from_role && left_member.to_role == right_member.to_role && interface_member_type_equal(left_member.type, right_member.type)
    )

fun interface_parent_equal(left :: False || InterfaceType,
                           right :: False || InterfaceType):
  if left || right
  | left is_a InterfaceType && right is_a InterfaceType && interface_type_equal(left, right)
  | #true

fun interface_type_same_specialization(left :: InterfaceType,
                                       right :: InterfaceType):
  interface_type_equal(left, right) && !interface_type_has_compatibility_difference(left, right)

fun interface_type_has_compatibility_difference(left :: InterfaceType,
                                                right :: InterfaceType):
  left.identity === right.identity && (
    (left.connection_compatibility && !kernel.circuit_arguments_same(
       left.specialization_arguments,
       right.specialization_arguments
     )) || (
      for any (left_member in left.members, right_member in right.members):
        left_member.type is_a InterfaceType && right_member.type is_a InterfaceType && interface_type_has_compatibility_difference(left_member.type, right_member.type)
    ) || (
      left.parent is_a InterfaceType && right.parent is_a InterfaceType && interface_type_has_compatibility_difference(left.parent, right.parent)
    ) || (
      for any (left_supported in left.supported_contracts,
               right_supported in right.supported_contracts):
        interface_type_has_compatibility_difference(left_supported.type,
                                                    right_supported.type)
    )
  )

fun interface_type_has_connection_policy(type :: InterfaceType):
  type.connection_compatibility || (
    type.parent is_a InterfaceType && interface_type_has_connection_policy(type.parent)
  ) || (
    for any (supported in type.supported_contracts):
      interface_type_has_connection_policy(supported.type)
  ) || (
    for any (member in type.members):
      member.type is_a InterfaceType && interface_type_has_connection_policy(member.type)
  )

fun nested_compatibility_provider_is_left(parent_type :: InterfaceType,
                                          member :: InterfaceMember):
  def nested_type = member.type
  def nested_provider_parent_role:
    if nested_type.provider_role == nested_type.roles[0]
    | member.from_role
    | member.to_role
  nested_provider_parent_role == parent_type.provider_role

fun interface_nested_contracts_compatible(type :: InterfaceType,
                                          expected_type :: InterfaceType):
  for all (member in type.members, expected_member in expected_type.members):
    if member.type is_a InterfaceType || expected_member.type is_a InterfaceType
    | member.type is_a InterfaceType && expected_member.type is_a InterfaceType && (
        if nested_compatibility_provider_is_left(type, member)
        | interface_type_connection_compatible(member.type,
                                               expected_member.type)
        | interface_type_connection_compatible(expected_member.type,
                                               member.type)
      )
    | type_equal(member.type, expected_member.type)

fun interface_parent_contract_compatible(type :: InterfaceType,
                                         expected_type :: InterfaceType):
  if type.parent || expected_type.parent
  | type.parent is_a InterfaceType && expected_type.parent is_a InterfaceType && interface_type_connection_compatible(
      type.parent,
      expected_type.parent
    )
  | #true

fun interface_supported_contracts_compatible(type :: InterfaceType,
                                             expected_type :: InterfaceType):
  type.supported_contracts.length() == expected_type.supported_contracts.length() && (
    for all (supported in type.supported_contracts,
             expected_supported in expected_type.supported_contracts):
      supported.role == expected_supported.role && interface_type_connection_compatible(supported.type,
                                                                                        expected_supported.type)
  )

fun interface_type_connection_compatible(type :: InterfaceType,
                                         expected_type :: InterfaceType):
  cond
  | interface_type_same_specialization(type, expected_type) && !interface_type_has_connection_policy(type):
      #true
  | !(type.identity === expected_type.identity && interface_type_has_connection_policy(type)):
      #false
  | !interface_type_wire_shape_equal(type, expected_type):
      error(~who: #'connect_interfaces,
            "compatible interface specializations must have exactly the same wire shape")
  | ~else:
      def direct_result:
        if type.connection_compatibility
        | type.connection_compatibility.predicate(
            type.specialization_arguments,
            expected_type.specialization_arguments
          )
        | #true
      unless direct_result is_a Boolean
      | error(~who: #'connect_interfaces,
              "interface connection compatibility predicate must return a host Boolean")
      def parent_result = interface_parent_contract_compatible(type,
                                                               expected_type)
      def supported_result = interface_supported_contracts_compatible(
        type,
        expected_type
      )
      def nested_result = interface_nested_contracts_compatible(type,
                                                                expected_type)
      direct_result && parent_result && supported_result && nested_result

fun interface_type_declared_compatible(type :: InterfaceType,
                                       expected_type :: InterfaceType):
  interface_type_connection_compatible(type, expected_type)

fun interface_type_supports(type :: InterfaceType,
                            expected_type :: InterfaceType):
  interface_type_declared_compatible(type, expected_type) || (
    type.parent is_a InterfaceType && interface_type_supports(type.parent,
                                                              expected_type)
  ) || type.supported_contracts.find(
    fun (supported_contract):
      interface_type_supports(supported_contract.type, expected_type)
  ) != #false

fun direction_port_name(endpoint_name :: String,
                        interface_direction :: InterfaceDirection,
                        role :: String):
  def suffix = if interface_direction.from_role == role | "out" | "in"
  endpoint_name ++ "_" ++ suffix

fun nested_endpoint(endpoint :: InterfaceEndpoint,
                    member :: InterfaceMember):
  def nested_type = member.type
  def nested_role:
    if endpoint.role == member.from_role
    | nested_type.roles[0]
    | nested_type.roles[1]
  def nested_represented_role:
    if endpoint.represented_role == member.from_role
    | nested_type.roles[0]
    | nested_type.roles[1]
  def nested_bindings:
    nested_type.directions.map(
      fun (nested_direction):
        def parent_from = nested_role_to_parent(member,
                                                nested_type,
                                                nested_direction.from_role)
        def parent_to = nested_role_to_parent(member,
                                              nested_type,
                                              nested_direction.to_role)
        def parent_binding = endpoint.bindings.find(
          fun (binding):
            binding.direction.from_role == parent_from && binding.direction.to_role == parent_to
        )
        InterfaceBinding(nested_direction,
                         parent_binding.port_name ++ "__" ++ member.name,
                         kernel.project(parent_binding.entity, member.name))
    )
  InterfaceEndpoint(nested_type,
                    nested_role,
                    nested_represented_role,
                    nested_bindings,
                    endpoint.view ++ "." ++ member.name)

fun validate_interface_declaration(type :: InterfaceType, role :: String):
  unless role in type.roles
  | error(~who: #'interface, "unknown interface role " ++ to_string(role))

fun interface_name_taken(module_def :: Module, name :: String):
  module_interface_groups(module_def).find(
    fun (group): group.name == name
  ) || module_interface_array_groups(module_def).find(
    fun (group): group.name == name
  )

fun interface_boundary_endpoint(group :: InterfaceGroup):
  InterfaceEndpoint(group.type,
                    group.role,
                    group.type.complementary_role(group.role),
                    group.bindings,
                    "boundary")

fun declare_interface_unchecked(module_def :: Module,
                                name :: String,
                                type :: InterfaceType,
                                role :: String):
  def bindings:
    type.directions.map(
      fun (direction):
        def port_name = direction_port_name(name, direction, role)
        def entity:
          if direction.from_role == role
          | kernel.output(port_name, direction.type)
          | kernel.input(port_name, direction.type)
        InterfaceBinding(direction, port_name, entity)
    )
  def group = InterfaceGroup(module_def, name, type, role, bindings)
  module_def.add_metadata(interface_group_namespace, group)
  [group, interface_boundary_endpoint(group)]

fun declare_interface(name :: String,
                      type :: InterfaceType,
                      role :: String):
  validate_interface_declaration(type, role)
  def module_def = kernel.active_module()
  when interface_name_taken(module_def, name)
  | error(~who: #'interface, "duplicate interface endpoint " ++ name)
  declare_interface_unchecked(module_def, name, type, role)[1]

fun declare_interface_array(name :: String,
                            count :: PosInt,
                            type :: InterfaceType,
                            role :: String):
  validate_interface_declaration(type, role)
  def module_def = kernel.active_module()
  def element_names:
    for List (index in 0..count): name ++ "_" ++ to_string(index)
  when interface_name_taken(module_def, name) || element_names.find(
    fun (element_name): interface_name_taken(module_def, element_name)
  )
  | error(~who: #'interface, "duplicate interface endpoint " ++ name)
  def declarations:
    for List (element_name in element_names):
      declare_interface_unchecked(module_def, element_name, type, role)
  module_def.add_metadata(
    interface_array_group_namespace,
    InterfaceArrayGroup(module_def,
                        name,
                        declarations.map(fun (declaration): declaration[0]))
  )
  Array(& declarations.map(fun (declaration): declaration[1]))

// Creates a local, declaration-order-independent pair of complementary
// endpoint views. The left view accepts the first-role direction and the right view
// exposes it, with reverse-direction members mirrored.
fun interface_link(type :: InterfaceType,
                   name :: String = "interface_link"):
  validate_interface_declaration(type, type.roles[0])
  def module_def = kernel.active_module()
  def mutable left_bindings = []
  def mutable right_bindings = []
  for (direction in type.directions):
    def direction_name = kernel.fresh_name(name ++ "_flow")
    def place = kernel.wire(direction_name, direction.type)
    def value = kernel.read(place)
    def left_entity:
      if direction.from_role == type.roles[0] | place | value
    def right_entity:
      if direction.from_role == type.roles[0] | value | place
    left_bindings := left_bindings ++ [
      InterfaceBinding(direction, direction_name, left_entity)
    ]
    right_bindings := right_bindings ++ [
      InterfaceBinding(direction, direction_name, right_entity)
    ]
  def handle = InterfaceHandle(
    InterfaceEndpoint(type,
                      type.roles[0],
                      type.roles[1],
                      left_bindings,
                      "link-left"),
    InterfaceEndpoint(type,
                      type.roles[0],
                      type.roles[0],
                      right_bindings,
                      "link-right")
  )
  module_def.add_metadata(
    interface_link_group_namespace,
    InterfaceLinkGroup(module_def, name, handle.left, handle.right)
  )
  handle

fun endpoint_for_group(instance :: Instance, group :: InterfaceGroup):
  def bindings:
    group.bindings.map(
      fun (binding):
        def entity:
          if binding.direction.from_role == group.role
          | instance.output(binding.port_name)
          | instance.input(binding.port_name)
        InterfaceBinding(binding.direction, binding.port_name, entity)
    )
  InterfaceEndpoint(group.type,
                    group.role,
                    group.role,
                    bindings,
                    "instance")

fun endpoint_for_instance(instance :: Instance, name :: String):
  def group = module_interface_groups(instance.module_def).find(
    fun (candidate): candidate.name == name
  )
  if group | endpoint_for_group(instance, group) | #false

fun endpoint_array_for_instance(instance :: Instance, name :: String):
  def group = module_interface_array_groups(instance.module_def).find(
    fun (candidate): candidate.name == name
  )
  if group
  | Array(& group.groups.map(fun (element_group): endpoint_for_group(instance, element_group)))
  | #false

fun interface_member(value :: InterfaceEndpoint || HardwareEntity,
                     name :: String):
  if value is_a InterfaceEndpoint
  | value.field(name)
  | kernel.project(value, name)

fun resolve_interface_member(value :: HardwareEntity || InterfaceEndpoint,
                             name :: String):
  cond
  | value is_a InterfaceEndpoint: value.field(name)
  | value is_a Instance:
      endpoint_for_instance(value, name) || endpoint_array_for_instance(value, name)
  | ~else: #false

def registered_interface_member_resolver = register_member_resolver(resolve_interface_member)

fun interface_endpoint_has_type(value :: InterfaceEndpoint,
                                expected_type :: InterfaceType):
  interface_type_same_specialization(value.type, expected_type)

fun interface_endpoint_supports_type(value :: InterfaceEndpoint,
                                     expected_type :: InterfaceType):
  interface_type_supports(value.type, expected_type)

// Marks the static topology carried by interface annotations so higher-level
// libraries can compute precise result information without knowing runtime
// interface representation details.
statinfo.key interface_topology_key:
  ~and: fun (_left, right): right
  ~or: fun (_left, right): right

// Associates an interface type expression with the precise static surface of
// an endpoint of that specialization.
statinfo.key interface_endpoint_static_info_key:
  ~and: fun (_left, right): right
  ~or: fun (_left, right): right

statinfo.key interface_member_static_info_key:
  ~and: fun (_left, right): right
  ~or: fun (_left, right): right

statinfo.key interface_parent_static_info_key:
  ~and: fun (_left, right): right
  ~or: fun (_left, right): right

annot.macro 'InterfaceTypeSurface($(endpoint :: annot_meta.Parsed))':
  def (_endpoint_predicate, endpoint_infos) = annot_meta.unpack_predicate(endpoint)
  annot_meta.pack_predicate(
    'fun (value): value is_a InterfaceType',
    '((interface_endpoint_static_info_key, $(statinfo_meta.pack(endpoint_infos))),
      (value_surface_static_info_key, $(statinfo_meta.pack(endpoint_infos))))'
  )

// Selects precise static information for a configured interface transform
// after Rhombus supplies the transform's eventual source through `|>`.
meta.bridge interface_transform_result_static_infos:
  fun (data, dependencies :: annot_meta.Dependencies):
    let '($position, $connected_infos)' = data
    def source_infos = dependencies.arguments[position.unwrap()]
    def topology = statinfo_meta.find(
      statinfo_meta.unpack(source_infos),
      'interface_topology_key'
    )
    cond
    | topology && topology.unwrap() in [#'endpoint, #'endpoint_array]:
        statinfo_meta.pack(connected_infos)
    | topology && topology.unwrap() == #'handle:
        annot_meta.parse_to_packed_statinfo('Handle')
    | ~else:
        annot_meta.parse_to_packed_statinfo('InterfaceTopologyResult')

// A configured transform returns its connected far-end shape for endpoint
// sources and a complete handle for detached type seeds or earlier handles.
annot.macro 'InterfaceTransformResult($source, $(connected :: annot_meta.Parsed))':
  ~context context
  def position = context.argument_names[
    syntax_meta.flip_introduce(source)
  ]
  unless position is_a Nat
  | error(~who: #'InterfaceTransformResult,
          "source must name a positional argument of the annotated function")
  def (_connected_predicate, connected_infos) = annot_meta.unpack_predicate(
    connected
  )
  def dependent_infos = statinfo_meta.pack_dependent_result(
    'interface_transform_result_static_infos',
    '($position, $connected_infos)',
    {}
  )
  annot_meta.pack_predicate(
    'fun (_value): #true',
    '(($(statinfo_meta.dependent_result_key), $dependent_infos))'
  )

// Applying a linear topology object preserves whether another handle remains
// open. Concrete endpoint sources expose the object's far endpoint shape;
// statically unknown sources retain the conservative topology surface.
meta.bridge interface_topology_call_result_static_infos:
  fun (_data, dependencies :: annot_meta.Dependencies):
    def source_infos = dependencies.arguments[0]
    def topology = statinfo_meta.find(
      statinfo_meta.unpack(source_infos),
      'interface_topology_key'
    )
    cond
    | topology && topology.unwrap() == #'handle:
        annot_meta.parse_to_packed_statinfo('Handle')
    | topology && topology.unwrap() in [#'endpoint, #'endpoint_array]:
        annot_meta.parse_to_packed_statinfo('InterfaceTopologyFields')
    | ~else:
        annot_meta.parse_to_packed_statinfo('InterfaceTopologyResult')

// Calling an endpoint terminates a concrete topology. Terminating a detached
// handle preserves its open input as a sink for later composition.
meta.bridge interface_endpoint_call_result_static_infos:
  fun (_data, dependencies :: annot_meta.Dependencies):
    def source_infos = dependencies.arguments[0]
    def topology = statinfo_meta.find(
      statinfo_meta.unpack(source_infos),
      'interface_topology_key'
    )
    if topology && topology.unwrap() == #'handle
    | annot_meta.parse_to_packed_statinfo('Sink')
    | annot_meta.parse_to_packed_statinfo('Void')

annot.macro 'Endpoint':
  let '$(methods :: annot_meta.Parsed)' = 'HardwareMethodFields'
  def (_methods_predicate, method_infos) = annot_meta.unpack_predicate(methods)
  def dependent_result = statinfo_meta.pack_dependent_result(
    'interface_endpoint_call_result_static_infos',
    '(unused)',
    {}
  )
  def call_result = statinfo_meta.pack(
    '(($(statinfo_meta.dependent_result_key), $dependent_result))'
  )
  def result_infos = statinfo_meta.and(
    '(($(statinfo_meta.dot_provider_key), interface_field_dot),
      (interface_topology_key, endpoint),
      ($(statinfo_meta.call_result_key), $call_result))',
    method_infos
  )
  annot_meta.pack_predicate(
    'fun (value): value is_a InterfaceEndpoint',
    result_infos
  )

namespace Endpoint:
  export annot.macro 'of($expected_type)':
    let '$(base :: annot_meta.Parsed)' = 'Endpoint'
    def (_base_predicate, base_infos) = annot_meta.unpack_predicate(base)
    def endpoint_infos = statinfo_meta.find(
      statinfo_meta.gather(expected_type),
      'interface_endpoint_static_info_key'
    )
    annot_meta.pack_predicate(
      'fun (value): value is_a InterfaceEndpoint && interface_endpoint_has_type(value, $expected_type)',
      if endpoint_infos
      | statinfo_meta.unpack(endpoint_infos)
      | base_infos
    )

  export annot.macro 'supports($expected_type)':
    let '$(base :: annot_meta.Parsed)' = 'Endpoint'
    def (_base_predicate, base_infos) = annot_meta.unpack_predicate(base)
    annot_meta.pack_predicate(
      'fun (value): value is_a InterfaceEndpoint && interface_endpoint_supports_type(value, $expected_type)',
      base_infos
    )

// Selects an endpoint surface for nested interface members and a hardware
// value surface for ordinary data members.
annot.macro 'InterfaceMemberFields($(type :: expr_meta.Parsed))':
  def endpoint_infos = statinfo_meta.find(
    statinfo_meta.gather(type),
    'interface_endpoint_static_info_key'
  )
  if endpoint_infos
  | annot_meta.pack_predicate('fun (_value): #true', statinfo_meta.unpack(endpoint_infos))
  | 'HardwareFields.from_type($type)'

// Describes the locally declared members of one interface specialization and
// retains the inherited endpoint surface for refinement lookup.
annot.macro 'EndpointSurface($parent,
                             $(field_name :: Identifier): $(field_type :: expr_meta.Parsed), ...)':
  let '$(base :: annot_meta.Parsed)' = 'Endpoint'
  def (predicate, base_infos) = annot_meta.unpack_predicate(base)
  let [field_infos, ...]:
    for List (type in [field_type, ...]):
      let '$(field_annotation :: annot_meta.Parsed)' = 'InterfaceMemberFields($type)'
      def (_field_predicate, infos) = annot_meta.unpack_predicate(field_annotation)
      statinfo_meta.pack(infos)
  def parent_infos:
    match parent
    | '#false': #false
    | ~else:
        statinfo_meta.find(
          statinfo_meta.gather(parent),
          'interface_endpoint_static_info_key'
        )
  def local_infos = '((interface_member_static_info_key,
                       (($field_name, $field_infos), ...)))'
  def result_infos = statinfo_meta.and(base_infos, local_infos)
  annot_meta.pack_predicate(
    predicate,
    if parent_infos
    | statinfo_meta.and(
        result_infos,
        '((interface_parent_static_info_key, $parent_infos))'
      )
    | result_infos
  )

annot.macro 'InterfaceArrayFields':
  def endpoint_infos = statinfo_meta.unpack(
    annot_meta.parse_to_packed_statinfo('Endpoint')
  )
  annot_meta.pack_predicate(
    'fun (value): value is_a Array',
    '(($(statinfo_meta.index_get_key), interface_array_index), ($(statinfo_meta.index_result_key), $(statinfo_meta.pack_index_result(endpoint_infos, []))), (interface_topology_key, endpoint_array))'
  )

namespace InterfaceArrayFields:
  export annot.macro 'of($expected_type)':
    let '$(endpoint :: annot_meta.Parsed)' = 'Endpoint.of($expected_type)'
    def (_endpoint_predicate, endpoint_infos) = annot_meta.unpack_predicate(endpoint)
    annot_meta.pack_predicate(
      'fun (value): value is_a Array',
      '(($(statinfo_meta.index_get_key), interface_array_index),
        ($(statinfo_meta.index_result_key),
         $(statinfo_meta.pack_index_result(endpoint_infos, []))),
        (interface_topology_key, endpoint_array))'
    )
// A handle side can be either one endpoint or an endpoint array. The generic
// annotation deliberately exposes both access paths while precise connected
// stage results continue to use Endpoint or InterfaceArrayFields.
annot.macro 'InterfaceTopologyFields':
  let '$(methods :: annot_meta.Parsed)' = 'HardwareMethodFields'
  def (_methods_predicate, method_infos) = annot_meta.unpack_predicate(methods)
  def endpoint_infos = statinfo_meta.unpack(
    annot_meta.parse_to_packed_statinfo('Endpoint')
  )
  def result_infos = statinfo_meta.and(
    '(($(statinfo_meta.dot_provider_key), interface_field_dot),
      ($(statinfo_meta.index_get_key), interface_array_index),
      ($(statinfo_meta.index_result_key),
       $(statinfo_meta.pack_index_result(endpoint_infos, []))))',
    method_infos
  )
  annot_meta.pack_predicate(
    'fun (value): value is_a InterfaceEndpoint || value is_a Array',
    result_infos
  )

// Conservatively describes a stage result whose input topology was not known
// statically. It supports endpoint fields, endpoint-array indexing, and handle
// sides without claiming which runtime shape elaboration will produce.
annot.macro 'InterfaceTopologyResult':
  def endpoint_infos = statinfo_meta.unpack(
    annot_meta.parse_to_packed_statinfo('Endpoint')
  )
  def dependent_result = statinfo_meta.pack_dependent_result(
    'interface_topology_call_result_static_infos',
    '(unused)',
    {}
  )
  def call_result = statinfo_meta.pack(
    '(($(statinfo_meta.dependent_result_key), $dependent_result))'
  )
  annot_meta.pack_predicate(
    'fun (value): value is_a InterfaceEndpoint || value is_a Array || value is_a InterfaceHandle',
    '(($(statinfo_meta.dot_provider_key), interface_topology_result_dot), ($(statinfo_meta.index_get_key), interface_array_index), ($(statinfo_meta.index_result_key), $(statinfo_meta.pack_index_result(endpoint_infos, []))), ($(statinfo_meta.call_result_key), $call_result))'
  )

fun interface_handle_left(handle :: InterfaceHandle) :~ InterfaceTopologyFields:
  handle.left

fun interface_handle_right(handle :: InterfaceHandle) :~ InterfaceTopologyFields:
  handle.right

annot.macro 'Handle':
  def dependent_result = statinfo_meta.pack_dependent_result(
    'interface_topology_call_result_static_infos',
    '(unused)',
    {}
  )
  def call_result = statinfo_meta.pack(
    '(($(statinfo_meta.dependent_result_key), $dependent_result))'
  )
  annot_meta.pack_predicate(
    'fun (value): value is_a InterfaceHandle',
    '(($(statinfo_meta.dot_provider_key), interface_handle_dot), (interface_topology_key, handle), ($(statinfo_meta.call_result_key), $call_result))'
  )

dot.macro 'interface_handle_dot $left $dot $right':
  match right
  | 'left': 'interface_handle_left($left)'
  | 'right': 'interface_handle_right($left)'
  | ~else: #false

dot.macro 'interface_topology_result_dot $left $dot $right':
  match right
  | 'left': 'interface_handle_left($left)'
  | 'right': 'interface_handle_right($left)'
  | ~else:
      'interface_member($left, $(right.to_source_string())) :: InstanceMembers'

annot.macro 'Sink':
  annot_meta.pack_predicate('fun (value): value is_a InterfaceSink')

// Retains the implementation-facing name while the standard profile exports
// Endpoint as the public annotation for interface-producing functions.
annot.macro 'InterfaceFields': 'Endpoint'

fun interface_observation_member(value :: InterfaceObservation || HardwareEntity,
                                 name :: String):
  if value is_a InterfaceObservation
  | value.field(name)
  | kernel.project(value, name)

annot.macro 'Observation':
  let '$(base :: annot_meta.Parsed)' = 'HardwareMethodFields'
  def (_base_predicate, base_infos) = annot_meta.unpack_predicate(base)
  def result_infos = statinfo_meta.and(
    '(($(statinfo_meta.dot_provider_key), interface_observation_dot))',
    base_infos
  )
  annot_meta.pack_predicate(
    'fun (value): value is_a InterfaceObservation',
    result_infos
  )

annot.macro 'InterfaceObservationFields':
  let '$(base :: annot_meta.Parsed)' = 'HardwareMethodFields'
  def (_base_predicate, base_infos) = annot_meta.unpack_predicate(base)
  def result_infos = statinfo_meta.and(
    '(($(statinfo_meta.dot_provider_key), interface_observation_dot))',
    base_infos
  )
  annot_meta.pack_predicate(
    'fun (value): value is_a InterfaceObservation || value is_a HardwareEntity',
    result_infos
  )

dot.macro 'interface_observation_dot $left $dot $right':
  ~tail: '$tail ...'
  match '$right $tail ...'
  | 'lookup($(selector :: expr_meta.Parsed),
            ~default: $(default_value :: expr_meta.Parsed)) $rest ...': #false
  | '$(method :: Identifier)($argument, ...) $rest ...': #false
  | ~else:
      match right
      | 'field': #false
      | 'endpoint': #false
      | 'nested_observations': #false
      | 'type': #false
      | 'role': #false
      | 'bindings': #false
      | 'view': #false
      | ~else:
          'interface_observation_member($left, $(right.to_source_string())) :: InterfaceObservationFields'

// Restricts an endpoint to recursively readable leaves so instrumentation can
// inspect both interface directions without acquiring connection authority.
fun observe(endpoint :: InterfaceEndpoint) :~ Observation:
  InterfaceObservation(endpoint)

fun interface_array_index(value :: Array, index :: Nat) :~ Endpoint:
  value[index]

meta:
  fun interface_member_static_expansion(left :: Syntax,
                                        right :: Syntax,
                                        infos :: Syntax):
    def packed_members = statinfo_meta.find(
      infos,
      'interface_member_static_info_key'
    )
    def mutable expansion = #false
    when packed_members
    | let '($member_entry, ...)' = packed_members
      for (entry in [member_entry, ...]):
        match entry
        | '($(member_name :: Identifier), $(packed_infos :: Term))':
            when right.to_source_string() == member_name.to_source_string()
            | expansion := statinfo_meta.replace(
                'interface_member($left, $(right.to_source_string()))',
                statinfo_meta.unpack(packed_infos)
              )
        | ~else:
            syntax_meta.error("invalid interface member static information", entry)
    def packed_parent = statinfo_meta.find(
      infos,
      'interface_parent_static_info_key'
    )
    if expansion
    | expansion
    | if packed_parent
      | interface_member_static_expansion(
          left,
          right,
          statinfo_meta.unpack(packed_parent)
        )
      | #false

dot.macro 'interface_field_dot $left $dot $right':
  ~tail: '$tail ...'
  def precise = interface_member_static_expansion(
    left,
    right,
    statinfo_meta.gather(left)
  )
  if precise
  | precise
  | match '$right $tail ...'
    | 'observe() $rest ...':
        values('observe($left) :: Observation', '$rest ...')
    | 'lookup($(selector :: expr_meta.Parsed),
              ~default: $(default_value :: expr_meta.Parsed)) $rest ...': #false
    | '$(method :: Identifier)($argument, ...) $rest ...': #false
    | ~else:
        match right
        | 'field': #false
        | 'type': #false
        | 'role': #false
        | 'represented_role': #false
        | 'bindings': #false
        | 'view': #false
        | 'observe': 'fun () :~ Observation: observe($left)'
        | ~else:
            'interface_member($left, $(right.to_source_string())) :: InstanceMembers'

fun validate_interface_entity_pair(left_entity :: Value || Place,
                                   right_entity :: Value || Place):
  unless ((left_entity is_a Place && right_entity is_a Value) || (left_entity is_a Value && right_entity is_a Place))
  | error(~who: #'connect_interfaces,
          "interface endpoints have incompatible roles and boundary directions")
  def place = if left_entity is_a Place | left_entity | right_entity
  def value = if left_entity is_a Value | left_entity | right_entity
  unless type_equal(place.type, value.type)
  | error(~who: #'connect_interfaces, "interface member types do not match")
  when place.driver
  | error(~who: #'connect_interfaces, "interface destination already has a driver")
  [left_entity, right_entity]

fun interface_member_connection_pairs(left :: InterfaceEndpoint,
                                      right :: InterfaceEndpoint,
                                      members :: NonemptyList.of(InterfaceMember)):
  def mutable pairs = []
  for (member in members):
    def left_entity = left.field(member.name)
    def right_entity = right.field(member.name)
    if member.type is_a InterfaceType
    | pairs := pairs ++ interface_member_connection_pairs(
        left_entity,
        right_entity,
        member.type.members
      )
    | pairs := pairs ++ [validate_interface_entity_pair(left_entity,
                                                        right_entity)]
  pairs

// Endpoint provenance identifies which connected component plays the provider
// role. Operand order and the presence of any particular member are irrelevant.
fun interface_connection_direction(left :: InterfaceEndpoint,
                                   right :: InterfaceEndpoint):
  unless left.type.roles == right.type.roles
  | error(~who: #'connect_interfaces,
          "bulk-connected interface roles must match")
  unless left.type.provider_role == right.type.provider_role
  | error(~who: #'connect_interfaces,
          "compatible interface provider roles must match")
  unless left.represented_role != right.represented_role && left.represented_role in left.type.roles && right.represented_role in right.type.roles
  | error(~who: #'connect_interfaces,
          "interface endpoints have incompatible roles and boundary directions")
  def provider_role = left.type.provider_role
  def source:
    if left.represented_role == provider_role
    | left
    | if right.represented_role == provider_role
      | right
      | error(~who: #'connect_interfaces,
              "compatible interface endpoints do not represent the provider role")
  [source, if source === left | right | left]

fun exact_interface_connection_pairs(left :: InterfaceEndpoint,
                                     right :: InterfaceEndpoint):
  def pairs:
    for List (left_binding in left.bindings):
      def right_binding = right.bindings.find(
        fun (candidate):
          candidate.direction.from_role == left_binding.direction.from_role && candidate.direction.to_role == left_binding.direction.to_role
      )
      [left_binding.entity, right_binding.entity]
  for (pair in pairs):
    validate_interface_entity_pair(pair[0], pair[1])
  pairs

fun refinement_members(child_type :: InterfaceType,
                       parent_type :: InterfaceType):
  child_type.members.filter(
    ~keep: fun (member): !parent_type.members.find(
      fun (candidate): candidate.name == member.name
    )
  )

fun supplied_refinement_members(delta_members :: List.of(InterfaceMember),
                                extra_values :: List,
                                extra_fields :: Map,
                                required :: Boolean):
  when extra_values.length() > 0 && extra_fields.length() > 0
  | error(~who: #'connect_interfaces,
          "refinement members must use either positional or named arguments")
  def supplied:
    if extra_values.length() > 0
    | block:
        unless delta_members.length() == 1 && extra_values.length() == 1
        | error(~who: #'connect_interfaces,
                "a positional refinement member requires exactly one unmatched field")
        [[delta_members[0], extra_values[0]]]
    | block:
        def all_fields_present:
          for all (member in delta_members):
            extra_fields.has_key(Keyword.from_string(member.name))
        unless extra_fields.length() == 0 || extra_fields.length() == delta_members.length() && all_fields_present
        | error(~who: #'connect_interfaces,
                "named refinement members must supply every unmatched field exactly once")
        if extra_fields.length() == 0
        | []
        | for List (member in delta_members):
            [member, extra_fields[Keyword.from_string(member.name)]]
  when required && delta_members.length() > 0 && supplied.length() == 0
  | error(~who: #'connect_interfaces,
          "connection requires every refinement member")
  supplied

fun explicit_member_connection_pairs(endpoint :: InterfaceEndpoint,
                                     member :: InterfaceMember,
                                     supplied :: InterfaceEndpoint || HardwareEntity):
  def endpoint_entity = endpoint.field(member.name)
  if member.type is_a InterfaceType
  | block:
      unless supplied is_a InterfaceEndpoint
      | error(~who: #'connect_interfaces,
              "supplied refinement member has the wrong interface type")
      unless interface_type_equal(supplied.type, member.type)
      | error(~who: #'connect_interfaces,
              "supplied refinement member has the wrong interface type")
      interface_member_connection_pairs(endpoint_entity,
                                        supplied,
                                        member.type.members)
  | block:
      def supplied_entity:
        if endpoint_entity is_a Place
        | block:
            when supplied is_a Place
            | error(~who: #'connect_interfaces,
                    "supplied refinement member has the wrong direction")
            kernel.read(supplied)
        | block:
            unless supplied is_a Place
            | error(~who: #'connect_interfaces,
                    "supplied refinement member must be a driveable hardware place")
            supplied
      [validate_interface_entity_pair(endpoint_entity, supplied_entity)]

fun compatible_interface_connection_pairs(
      left :: InterfaceEndpoint,
      right :: InterfaceEndpoint,
      extra_values :: List,
      extra_fields :: Map):
  let [source, destination] = interface_connection_direction(left, right)
  def source_supports_destination = interface_type_supports(source.type,
                                                            destination.type)
  // Structural refinement can assemble a richer destination only when the
  // child actually adds fields. A fieldless refinement represents a stronger
  // behavioral promise and cannot be manufactured by wiring alone.
  def destination_delta:
    if destination.type.parent is_a InterfaceType && interface_type_equal(destination.type.parent, source.type)
    | refinement_members(destination.type, source.type)
    | []
  def destination_refines_source = destination_delta.length() > 0
  unless source_supports_destination || destination_refines_source
  | error(~who: #'connect_interfaces,
          "provider interface does not support the peer interface contract")
  def richer = if source_supports_destination | source | destination
  def poorer = if source_supports_destination | destination | source
  def delta_members = refinement_members(richer.type, poorer.type)
  def supplied = supplied_refinement_members(delta_members, extra_values, extra_fields, destination_refines_source)
  def common_members = if source_supports_destination | destination.type.members | source.type.members
  def mutable pairs = interface_member_connection_pairs(left, right, common_members)
  for (binding in supplied):
    pairs := pairs ++ explicit_member_connection_pairs(richer, binding[0], binding[1])
  pairs

// Equal declared roles identify two hierarchical views of one endpoint when
// boundary reconstruction makes their represented roles complementary. Such
// forwarding preserves one exact contract and must not apply peer legality.
fun endpoint_view_has_origin(endpoint :: InterfaceEndpoint, origin :: String):
  endpoint.view == origin || endpoint.view.starts_with(origin ++ ".")

fun same_role_interface_forwarding(left :: InterfaceEndpoint,
                                   right :: InterfaceEndpoint):
  left.role == right.role && left.represented_role != right.represented_role && (
    left.type.identity === right.type.identity
  ) && (
    endpoint_view_has_origin(left, "boundary") && endpoint_view_has_origin(right, "instance") || (
      endpoint_view_has_origin(left, "instance") && endpoint_view_has_origin(right, "boundary")
    )
  )

fun forwarded_interface_connection_pairs(left :: InterfaceEndpoint,
                                         right :: InterfaceEndpoint,
                                         extra_values :: List,
                                         extra_fields :: Map):
  unless interface_type_same_specialization(left.type, right.type)
  | error(~who: #'connect_interfaces,
          "hierarchy forwarding requires the exact interface specialization")
  unless extra_values.length() == 0 && extra_fields.length() == 0
  | error(~who: #'connect_interfaces,
          "hierarchy forwarding cannot supply refinement members")
  exact_interface_connection_pairs(left, right)

fun interface_connection_pairs(left :: InterfaceEndpoint,
                               right :: InterfaceEndpoint,
                               extra_values :: List = [],
                               extra_fields :: Map = {}):
  cond
  | same_role_interface_forwarding(left, right):
      forwarded_interface_connection_pairs(left, right, extra_values, extra_fields)
  | interface_type_same_specialization(left.type, right.type) && !interface_type_has_connection_policy(left.type) && !interface_type_has_connection_policy(right.type) && extra_values.length() == 0 && extra_fields.length() == 0:
      exact_interface_connection_pairs(left, right)
  | ~else:
      compatible_interface_connection_pairs(left, right, extra_values, extra_fields)

fun endpoint_shape_connection_pairs(left :: InterfaceEndpoint || Array,
                                    right :: InterfaceEndpoint || Array):
  cond
  | left is_a InterfaceEndpoint && right is_a InterfaceEndpoint:
      interface_connection_pairs(left, right)
  | left is_a Array && right is_a Array:
      unless left.length() == right.length()
      | error(~who: #'connect_interfaces,
              "bulk-connected interface endpoint arrays must have the same length")
      def mutable pairs = []
      for (index in 0..left.length()):
        pairs := pairs ++ endpoint_shape_connection_pairs(left[index],
                                                          right[index])
      pairs
  | ~else:
      error(~who: #'connect_interfaces,
            "bulk interface connection requires matching endpoint shapes")

fun record_interface_connection(left :: InterfaceEndpoint || Array,
                                right :: InterfaceEndpoint || Array):
  cond
  | left is_a InterfaceEndpoint && right is_a InterfaceEndpoint:
      let [source, destination] = interface_connection_direction(left, right)
      def module_def = kernel.active_module()
      module_def.add_metadata(
        interface_connection_group_namespace,
        InterfaceConnectionGroup(module_def, source, destination)
      )
  | left is_a Array && right is_a Array:
      for (index in 0..left.length()):
        record_interface_connection(left[index], right[index])
  | ~else: #void

fun connect_interfaces(left :: InterfaceEndpoint || Array,
                       right :: InterfaceEndpoint || Array):
  def pairs = endpoint_shape_connection_pairs(left, right)
  for (pair in pairs):
    if pair[0] is_a Place
    | kernel.connect(pair[0], pair[1])
    | kernel.connect(pair[1], pair[0])
  record_interface_connection(left, right)
  #void

// Recursively connects interface endpoint shapes. Arrays are the initial
// structural product; additional host product syntax can lower to Arrays.
fun connect_endpoint_shapes(left :: InterfaceEndpoint || Array,
                            right :: InterfaceEndpoint || Array):
  connect_interfaces(left, right)

// Reports whether a transform source is a concrete endpoint shape that can
// be connected immediately. Interface types and other host seeds remain
// detached handles until a concrete source is supplied.
fun connected_interface_source(source :: InterfaceEndpoint || Array || HardwareType || InterfaceType || InterfaceHandle):
  cond
  | source is_a InterfaceEndpoint: #true
  | source is_a Array && source.length() > 0:
      def mutable all_endpoints = #true
      for (element in source):
        unless element is_a InterfaceEndpoint
        | all_endpoints := #false
      all_endpoints
  | ~else: #false

// Applies a completed transform to concrete topology while preserving a
// detached handle for interface-type seeds.
fun finish_interface_transform(source_or_type :: InterfaceEndpoint || Array || HardwareType || InterfaceType || InterfaceHandle,
                               handle :: Handle):
  if connected_interface_source(source_or_type) || source_or_type is_a InterfaceHandle
  | handle(source_or_type)
  | handle

fun validate_interface_transform_links(links :: InterfaceHandle || Array,
                                       who :: Symbol):
  cond
  | links is_a InterfaceHandle:
      when links.consumed
      | error(~who: who, "an interface handle can be consumed only once")
  | links is_a Array && links.length() > 0:
      for (link in links): validate_interface_transform_links(link, who)
  | ~else:
      error(~who: who,
            "interface transform ends must be handles or nonempty handle arrays")

fun interface_transform_end(links :: InterfaceHandle || Array,
                            use_left :: Boolean):
  cond
  | links is_a InterfaceHandle:
      links.consumed := #true
      if use_left | links.left | links.right
  | ~else:
      Array(& (for List (link in links): interface_transform_end(link, use_left)))

// Adopts already-wired local links as one N-to-M transform. Input links expose
// their left sides; output links expose their right sides. Array shapes retain
// their cardinality for later `|>` composition.
fun interface_transform(input_links :: InterfaceHandle || Array,
                        output_links :: InterfaceHandle || Array) :: Handle:
  validate_interface_transform_links(input_links, #'interface_transform)
  validate_interface_transform_links(output_links, #'interface_transform)
  def left = interface_transform_end(input_links, #true)
  validate_interface_transform_links(output_links, #'interface_transform)
  def right = interface_transform_end(output_links, #false)
  InterfaceHandle(left, right)

fun interface_endpoint_shape_count(shape :: InterfaceEndpoint || Array):
  if shape is_a InterfaceEndpoint | 1 | shape.length()

fun interface_trace_passthrough():
  InterfaceTraceModel([InterfaceTraceRoute(0, 0)])

// Certifies zero-storage, non-inventing, one-to-one transfer. An optional
// guard is the original filter predicate, not a reconstructed selection policy.
fun interface_trace_combinational(~guard: guard :: False || HardwareEntity = #false):
  def value = if guard | kernel.read(guard) | #false
  when value && (!(value.module_def === kernel.active_module()) || !scalar_data_type(value.type) || scalar_width(value.type) != 1)
  | error(~who: #'interface_trace_combinational, "trace guard must be local one-bit data")
  InterfaceTraceModel([InterfaceTraceRoute(0, 0)], InterfaceTraceCombinational(value))

// Every surviving output transfer corresponds to the input exactly this many
// cycles earlier. No backpressure, clock enable, or variable latency is allowed.
fun interface_trace_fixed_latency(cycles :: PosInt, ~flush: flush :: False || HardwareEntity = #false):
  def value = if flush | kernel.read(flush) | #false
  when value && (!(value.module_def === kernel.active_module()) || !scalar_data_type(value.type) || scalar_width(value.type) != 1)
  | error(~who: #'interface_trace_fixed_latency, "trace flush must be local one-bit data")
  InterfaceTraceModel([InterfaceTraceRoute(0, 0)], InterfaceTraceFixedLatency(cycles, value))

fun describe_interface_retained_storage(capture :: HardwareEntity, release :: HardwareEntity, active :: HardwareEntity, ~name: name :: String = "data"):
  def module_def = kernel.active_module()
  unless name != "" && !module_def.metadata_for(interface_retained_storage_namespace).find(fun (declaration): declaration.name == name)
  | error(~who: #'describe_interface_retained_storage, "retained storage controls already declared or empty name")
  fun signal(entity :: HardwareEntity):
    def value = kernel.read(entity)
    unless value.module_def === module_def && scalar_data_type(value.type) && scalar_width(value.type) == 1
    | error(~who: #'describe_interface_retained_storage, "retained controls must be local one-bit data")
    value
  module_def.add_metadata(interface_retained_storage_namespace, InterfaceRetainedStorage(module_def, signal(capture), signal(release), signal(active), name))

fun interface_trace_retained(instance :: False || Instance = #false, ~name: name :: String = "data"):
  unless !instance || instance.operation.module_def === kernel.active_module()
  | error(~who: #'interface_trace_retained, "retained implementation must be a local instance")
  def owner = if instance | instance.module_def | kernel.active_module()
  def declarations = owner.metadata_for(interface_retained_storage_namespace).filter(~keep: fun (declaration): declaration.name == name)
  unless declarations.length() == 1
  | error(~who: #'interface_trace_retained, "retained implementation requires declared storage controls")
  InterfaceTraceModel([InterfaceTraceRoute(0, 0)], InterfaceTraceRetained(instance, declarations[0]))

// Adds a metadata-only causal edge between two annotated route endpoints. The
// named retained-storage declaration supplies the shared capture, active, and
// release lifetime; no functional wiring is introduced.
fun describe_interface_trace_edge(parent :: InterfaceEndpoint,
                                  child :: InterfaceEndpoint,
                                  ~scope: scope :: String = "data"):
  def module_def = kernel.active_module()
  unless scope != ""
  | error(~who: #'describe_interface_trace_edge, "trace edge scope must not be empty")
  for (endpoint in [parent, child]):
    unless for all (binding in endpoint.bindings): binding.entity.module_def === module_def
    | error(~who: #'describe_interface_trace_edge, "trace edge endpoints must belong to the local module")
  when parent === child
  | error(~who: #'describe_interface_trace_edge, "trace edge parent and child must be distinct endpoints")
  def declarations = module_def.metadata_for(interface_retained_storage_namespace).filter(
    ~keep: fun (declaration): declaration.name == scope
  )
  unless declarations.length() == 1
  | error(~who: #'describe_interface_trace_edge,
          "trace edge requires one retained-storage declaration: " ++ scope)
  when module_interface_trace_edges(module_def).find(
    fun (edge): edge.parent === parent && edge.child === child
  )
  | error(~who: #'describe_interface_trace_edge, "duplicate trace edge")
  when module_interface_trace_edges(module_def).find(
    fun (edge): edge.storage === declarations[0] && !(edge.parent === parent)
  )
  | error(~who: #'describe_interface_trace_edge,
          "trace edge scope must retain one parent route: " ++ scope)
  module_def.add_metadata(
    interface_trace_edge_namespace,
    InterfaceTraceEdge(module_def, parent, child, declarations[0])
  )
  #void

fun interface_trace_detached():
  InterfaceTraceModel([InterfaceTraceRoute(0, 0)], InterfaceTraceDetached())

// A pipeline publishes its actual stage load and input-valid signals. This
// contract describes one ordered pipeline, with synchronous reset flushing.
fun describe_interface_elastic_stages(advances :: NonemptyList.of(HardwareEntity),
                                      valids :: NonemptyList.of(HardwareEntity), ~name: name :: String = "data"):
  def module_def = kernel.active_module()
  unless advances.length() == valids.length()
  | error(~who: #'describe_interface_elastic_stages, "elastic stage controls must have matching lengths")
  unless name != "" && !module_def.metadata_for(interface_elastic_stages_namespace).find(fun (declaration): declaration.name == name)
  | error(~who: #'describe_interface_elastic_stages, "elastic stage controls already declared")
  fun signal(entity :: HardwareEntity):
    def value = kernel.read(entity)
    unless value.module_def === module_def && scalar_data_type(value.type) && scalar_width(value.type) == 1
    | error(~who: #'describe_interface_elastic_stages, "elastic stage controls must be local one-bit data")
    value
  def stages = for List (advance in advances, valid in valids):
    InterfaceElasticStage(signal(advance), signal(valid))
  module_def.add_metadata(interface_elastic_stages_namespace, InterfaceElasticStages(module_def, stages, name))

fun interface_trace_elastic(instance :: False || Instance = #false, ~name: name :: String = "data"):
  unless !instance || instance.operation.module_def === kernel.active_module()
  | error(~who: #'interface_trace_elastic, "elastic trace implementation must be a local instance")
  def owner = if instance | instance.module_def | kernel.active_module()
  def declarations = owner.metadata_for(interface_elastic_stages_namespace).filter(~keep: fun (declaration): declaration.name == name)
  unless declarations.length() == 1
  | error(~who: #'interface_trace_elastic, "elastic trace implementation requires declared stage controls")
  InterfaceTraceModel([InterfaceTraceRoute(0, 0)], InterfaceTraceElastic(instance, declarations[0].stages))

// Storage writes and removals exclude empty bypass transfers. Addresses are
// pre-edge functional pointers; stored_valid excludes bypass. Reset flushes
// occupancy, and simultaneous read/write observes the old stored item.
fun describe_interface_queue_storage(depth :: PosInt,
                                     enqueue :: HardwareEntity, dequeue :: HardwareEntity,
                                     read_address :: HardwareEntity, write_address :: HardwareEntity,
                                     stored_valid :: HardwareEntity, bypass :: HardwareEntity, ~name: name :: String = "data"):
  def module_def = kernel.active_module()
  unless name != "" && !module_def.metadata_for(interface_queue_storage_namespace).find(fun (declaration): declaration.name == name)
  | error(~who: #'describe_interface_queue_storage, "queue storage controls already declared")
  fun signal(entity :: HardwareEntity, width :: PosInt):
    def value = kernel.read(entity)
    unless value.module_def === module_def && scalar_data_type(value.type) && scalar_width(value.type) == width
    | error(~who: #'describe_interface_queue_storage, "queue controls must be local flat data with the required width")
    value
  def address_width = memory_address_width(depth)
  module_def.add_metadata(interface_queue_storage_namespace,
                          InterfaceQueueStorage(module_def, depth, signal(enqueue, 1), signal(dequeue, 1),
                                                signal(read_address, address_width), signal(write_address, address_width),
                                                signal(stored_valid, 1), signal(bypass, 1), name))

fun interface_trace_queue(instance :: False || Instance = #false, ~name: name :: String = "data"):
  unless !instance || instance.operation.module_def === kernel.active_module()
  | error(~who: #'interface_trace_queue, "queue trace implementation must be a local instance")
  def owner = if instance | instance.module_def | kernel.active_module()
  def declarations = owner.metadata_for(interface_queue_storage_namespace).filter(~keep: fun (declaration): declaration.name == name)
  unless declarations.length() == 1
  | error(~who: #'interface_trace_queue, "queue trace implementation requires declared storage controls")
  InterfaceTraceModel([InterfaceTraceRoute(0, 0)], InterfaceTraceQueue(instance, declarations[0]))

// Release a prefix, then append at the remaining occupancy. Selection observes
// pre-edge entries without consuming them; flush cancels release and append.
fun describe_interface_window_storage(depth :: PosInt, enqueue :: HardwareEntity,
                                      release_count :: HardwareEntity, count :: HardwareEntity, flush :: HardwareEntity,
                                      selected :: NonemptyList.of(HardwareEntity), ~name: name :: String = "data"):
  def module_def = kernel.active_module()
  unless name != "" && !module_def.metadata_for(interface_window_storage_namespace).find(fun (declaration): declaration.name == name)
  | error(~who: #'describe_interface_window_storage, "window storage controls already declared")
  unless selected.length() <= depth
  | error(~who: #'describe_interface_window_storage, "window selection exceeds storage depth")
  fun signal(entity :: HardwareEntity, width :: PosInt):
    def value = kernel.read(entity)
    unless value.module_def === module_def && scalar_data_type(value.type) && scalar_width(value.type) == width
    | error(~who: #'describe_interface_window_storage, "window controls must be local flat data with the required width")
    value
  def width = memory_address_width(depth + 1)
  module_def.add_metadata(interface_window_storage_namespace,
                          InterfaceWindowStorage(module_def, depth, signal(enqueue, 1), signal(release_count, width),
                                                 signal(count, width), signal(flush, 1), selected.map(fun (value): signal(value, 1)), name))

fun interface_trace_window(instance :: False || Instance = #false, ~name: name :: String = "data"):
  unless !instance || instance.operation.module_def === kernel.active_module()
  | error(~who: #'interface_trace_window, "window trace implementation must be a local instance")
  def owner = if instance | instance.module_def | kernel.active_module()
  def declarations = owner.metadata_for(interface_window_storage_namespace).filter(~keep: fun (declaration): declaration.name == name)
  unless declarations.length() == 1
  | error(~who: #'interface_trace_window, "window trace implementation requires declared storage controls")
  InterfaceTraceModel([InterfaceTraceRoute(0, 0)], InterfaceTraceWindow(instance, declarations[0]))

// Grants select the live output offer, not a remembered winner or inferred
// priority. At most one grant is asserted, and no grant means no output offer.
fun describe_interface_selection(grants :: NonemptyList.of(HardwareEntity), ~name: name :: String = "data"):
  def module_def = kernel.active_module()
  unless name != "" && !module_def.metadata_for(interface_selection_namespace).find(fun (declaration): declaration.name == name)
  | error(~who: #'describe_interface_selection, "selection controls already declared")
  def grant_values = for List (grant in grants):
    def value = kernel.read(grant)
    unless value.module_def === module_def && scalar_data_type(value.type) && scalar_width(value.type) == 1
    | error(~who: #'describe_interface_selection, "selection grants must be local one-bit data")
    value
  module_def.add_metadata(interface_selection_namespace, InterfaceSelection(module_def, grant_values, name))

fun interface_trace_selection(instance :: False || Instance = #false, ~name: name :: String = "data"):
  unless !instance || instance.operation.module_def === kernel.active_module()
  | error(~who: #'interface_trace_selection, "selection trace implementation must be a local instance")
  def owner = if instance | instance.module_def | kernel.active_module()
  def declarations = owner.metadata_for(interface_selection_namespace).filter(~keep: fun (declaration): declaration.name == name)
  unless declarations.length() == 1
  | error(~who: #'interface_trace_selection, "selection trace implementation requires declared grants")
  def grants = declarations[0].grants
  InterfaceTraceModel(for List (index in 0..grants.length()): InterfaceTraceRoute(index, 0),
                      InterfaceTraceSelection(instance, grants))

// Certifies exclusive inline routing: no output selected means input blocked,
// and each predicate is the original functional output-selection signal.
fun interface_trace_routing(predicates :: NonemptyList.of(HardwareEntity)):
  def predicate_values = for List (predicate in predicates):
    def value = kernel.read(predicate)
    unless value.module_def === kernel.active_module() && scalar_data_type(value.type) && scalar_width(value.type) == 1
    | error(~who: #'interface_trace_routing, "routing predicates must be local one-bit data")
    value
  InterfaceTraceModel(for List (index in 0..predicate_values.length()): InterfaceTraceRoute(0, index),
                      InterfaceTraceRouting(predicate_values))

fun interface_trace_atomic_fork(output_count :: PosInt):
  InterfaceTraceModel(for List (index in 0..output_count): InterfaceTraceRoute(0, index),
                      InterfaceTraceAtomicFork(output_count))

fun interface_trace_atomic_join(input_count :: PosInt):
  InterfaceTraceModel(for List (index in 0..input_count): InterfaceTraceRoute(index, 0),
                      InterfaceTraceAtomicJoin(input_count))

// Outputs observe the old resident item on an edge that accepts a replacement.
// Pending bits are the functional per-recipient ownership state; reset flushes it.
fun describe_interface_broadcast_storage(accept :: HardwareEntity, pending :: NonemptyList.of(HardwareEntity), ~name: name :: String = "data"):
  def module_def = kernel.active_module()
  unless name != "" && !module_def.metadata_for(interface_broadcast_storage_namespace).find(fun (declaration): declaration.name == name)
  | error(~who: #'describe_interface_broadcast_storage, "broadcast storage controls already declared")
  fun signal(entity :: HardwareEntity):
    def value = kernel.read(entity)
    unless value.module_def === module_def && scalar_data_type(value.type) && scalar_width(value.type) == 1
    | error(~who: #'describe_interface_broadcast_storage, "broadcast controls must be local one-bit data")
    value
  module_def.add_metadata(interface_broadcast_storage_namespace, InterfaceBroadcastStorage(module_def, signal(accept), pending.map(signal), name))

fun interface_trace_buffered_broadcast(instance :: False || Instance = #false, ~name: name :: String = "data"):
  unless !instance || instance.operation.module_def === kernel.active_module()
  | error(~who: #'interface_trace_buffered_broadcast, "broadcast trace implementation must be a local instance")
  def owner = if instance | instance.module_def | kernel.active_module()
  def declarations = owner.metadata_for(interface_broadcast_storage_namespace).filter(~keep: fun (declaration): declaration.name == name)
  unless declarations.length() == 1
  | error(~who: #'interface_trace_buffered_broadcast, "broadcast trace implementation requires declared storage controls")
  def storage = declarations[0]
  InterfaceTraceModel(for List (index in 0..storage.pending.length()): InterfaceTraceRoute(0, index),
                      InterfaceTraceBufferedBroadcast(instance, storage))

fun interface_trace_broadcast(output_count :: PosInt):
  InterfaceTraceModel(
    for List (output_index in 0..output_count):
      InterfaceTraceRoute(0, output_index)
  )

fun interface_trace_merge(input_count :: PosInt):
  InterfaceTraceModel(
    for List (input_index in 0..input_count):
      InterfaceTraceRoute(input_index, 0)
  )

fun interface_trace_crossbar(input_count :: PosInt, output_count :: PosInt):
  InterfaceTraceModel(
    for List (input_index in 0..input_count,
              output_index in 0..output_count):
      InterfaceTraceRoute(input_index, output_index)
  )

fun validate_interface_trace_model(trace_model :: InterfaceTraceModel,
                                   input_shape :: InterfaceEndpoint || Array,
                                   output_shape :: InterfaceEndpoint || Array):
  def input_count = interface_endpoint_shape_count(input_shape)
  def output_count = interface_endpoint_shape_count(output_shape)
  when trace_model.atomic_join_inputs()
  | unless output_count == 1 && input_count == trace_model.atomic_join_inputs() && trace_model.routes.length() == input_count && trace_model.routes.map(fun (route): [route.input_index, route.output_index]) == (for List (index in 0..input_count): [index, 0])
    | error(~who: #'describe_interface_transform, "atomic join trace requires exactly one output and one ordered route per input")
  when trace_model.dynamic && !trace_model.atomic_join_inputs()
  | if trace_model.selection_grants()
    | unless output_count == 1 && input_count == trace_model.selection_grants().length() && trace_model.routes.length() == input_count && trace_model.routes.map(fun (route): [route.input_index, route.output_index]) == (for List (index in 0..input_count): [index, 0])
      | error(~who: #'describe_interface_transform, "selection trace requires one grant and route per input and exactly one output")
    | if trace_model.routing_predicates()
      | unless input_count == 1 && output_count == trace_model.routing_predicates().length() && trace_model.routes.length() == output_count && trace_model.routes.map(fun (route): [route.input_index, route.output_index]) == (for List (index in 0..output_count): [0, index])
        | error(~who: #'describe_interface_transform, "routing trace requires one predicate and route per output and exactly one input")
        for (value in trace_model.routing_predicates()):
          unless value.module_def === kernel.active_module() && scalar_data_type(value.type) && scalar_width(value.type) == 1
          | error(~who: #'describe_interface_transform, "routing predicates must be local one-bit data")
      | if trace_model.atomic_fork_outputs()
        | unless input_count == 1 && output_count == trace_model.atomic_fork_outputs() && trace_model.routes.length() == output_count && trace_model.routes.map(fun (route): [route.input_index, route.output_index]) == (for List (index in 0..output_count): [0, index])
          | error(~who: #'describe_interface_transform, "atomic fork trace requires exactly one input and one ordered route per output")
        | if trace_model.broadcast_storage()
          | unless input_count == 1 && output_count == trace_model.broadcast_storage().pending.length() && trace_model.routes.length() == output_count && trace_model.routes.map(fun (route): [route.input_index, route.output_index]) == (for List (index in 0..output_count): [0, index])
            | error(~who: #'describe_interface_transform, "broadcast trace requires exactly one input and one ordered route and pending bit per output")
          | unless input_count == 1 && output_count == 1 && trace_model.routes.length() == 1 && trace_model.routes[0].input_index == 0 && trace_model.routes[0].output_index == 0
            | error(~who: #'describe_interface_transform, "dynamic trace semantics require exactly one input and output")
    def guard = if trace_model.dynamic is_a InterfaceTraceCombinational | trace_model.dynamic.guard | #false
    when guard && (!(guard.module_def === kernel.active_module()) || !scalar_data_type(guard.type) || scalar_width(guard.type) != 1)
    | error(~who: #'describe_interface_transform, "trace guard must be local one-bit data")
  for (route in trace_model.routes):
    unless route.input_index < input_count
    | error(~who: #'describe_interface_transform,
            "interface trace route input index is outside the transform input shape")
    unless route.output_index < output_count
    | error(~who: #'describe_interface_transform,
            "interface trace route output index is outside the transform output shape")
  #void

// Gives an interface transform a persistent authoring-level identity for
// inspection tools while leaving its ordinary flattened hardware unchanged.
fun module_has_interface_trace(module_def :: Module):
  module_interface_events(module_def).length() > 0 || module_interface_transforms(module_def).find(fun (transform): transform.trace_model != #false) || module_def.operations.find(fun (operation): operation.opcode == "rtl.instance" && module_has_interface_trace(operation.attribute("module")))

// Whole-instance adapters claim their implementation. Named endpoint contracts
// claim only their attachment points; diagram extraction checks that frontier.
fun validate_interface_contracts(module_def :: Module):
  def transforms = module_interface_transforms(module_def)
  for (transform in transforms):
    when transform.trace_model && transform.implementation && module_has_interface_trace(transform.implementation.module_def)
    | error(~who: #'validate_interface_contracts, "competing trace contract for implementation " ++ transform.implementation.operation.attribute("name"))
  #void

fun interface_shapes_overlap(left :: InterfaceEndpoint || Array, right :: InterfaceEndpoint || Array):
  fun elements(shape :: InterfaceEndpoint || Array):
    if shape is_a Array
    | for List (endpoint in shape): endpoint
    | [shape]
  for any (a in elements(left)):
    for any (b in elements(right)):
      a.bindings.length() == b.bindings.length() && for all (x in a.bindings, y in b.bindings): x.entity === y.entity && x.port_name == y.port_name

fun describe_interface_transform(handle :: Handle,
                                 kind :: String,
                                 properties :: Map = {},
                                 implementation :: False || Instance = #false,
                                 ~trace_model: trace_model :: False || InterfaceTraceModel = #false,
                                 ~contract_name: contract_name :: False || String = #false) :: Handle:
  def module_def = kernel.active_module()
  when implementation && !(implementation.operation.module_def === module_def)
  | error(~who: #'describe_interface_transform,
          "interface transform implementation must be a local instance")
  for (existing in module_interface_transforms(module_def)):
    when (implementation && existing.implementation === implementation) || (trace_model && existing.trace_model && (interface_shapes_overlap(handle.left, existing.input) || interface_shapes_overlap(handle.right, existing.output)))
    | error(~who: #'describe_interface_transform, "competing interface transforms: " ++ existing.kind ++ " and " ++ kind)
  when trace_model
  | validate_interface_trace_model(trace_model, handle.left, handle.right)
    when implementation && trace_model.fixed_latency_flush()
    | error(~who: #'describe_interface_transform, "flushable fixed latency must be declared locally; delegate through the implementation")
    def control_instance = trace_model.elastic_instance() || trace_model.retained_instance() || trace_model.queue_instance() || trace_model.window_instance() || trace_model.selection_instance() || trace_model.broadcast_instance()
    when control_instance
    | unless implementation && control_instance === implementation
      | error(~who: #'describe_interface_transform, "trace model must match the transform implementation")
    def owner = if control_instance | control_instance.module_def | module_def
    def mutable controls = []
    def mutable widths = []
    cond
    | trace_model.fixed_latency_flush():
        controls := [trace_model.fixed_latency_flush()]
        widths := [1]
    | trace_model.retained_storage():
        controls := trace_model.retained_storage().controls()
        widths := [1, 1, 1]
    | trace_model.elastic_stages():
        for (stage in trace_model.elastic_stages()):
          controls := controls ++ [stage.advance, stage.valid]
          widths := widths ++ [1, 1]
    | trace_model.queue_storage():
        def storage = trace_model.queue_storage()
        controls := storage.controls()
        widths := [1, 1, memory_address_width(storage.depth), memory_address_width(storage.depth), 1, 1]
    | trace_model.window_storage():
        def storage = trace_model.window_storage()
        controls := storage.controls()
        widths := [1, memory_address_width(storage.depth + 1), memory_address_width(storage.depth + 1), 1] ++ storage.selected.map(fun (_): 1)
    | trace_model.selection_grants():
        controls := trace_model.selection_grants()
        widths := controls.map(fun (_): 1)
    | trace_model.broadcast_storage():
        controls := trace_model.broadcast_storage().controls()
        widths := controls.map(fun (_): 1)
    | ~else: #void
    for (value in controls, width in widths):
      unless value.module_def === owner && scalar_data_type(value.type) && scalar_width(value.type) == width
      | error(~who: #'describe_interface_transform, "trace controls must belong to their owner with the required width")
    when implementation && module_has_interface_trace(implementation.module_def)
    | error(~who: #'describe_interface_transform, "competing trace contract for implementation " ++ implementation.operation.attribute("name") ++ "; delegate to its declared contracts instead")
  module_def.add_metadata(
    interface_transform_group_namespace,
    InterfaceTransformGroup(module_def,
                            kind,
                            handle.left,
                            handle.right,
                            properties,
                            implementation,
                            trace_model,
                            contract_name)
  )
  handle

// Declares a named local relation, including cuts at internal endpoints.
// Normalize attachment polarity with metadata-only views, never RTL wiring.
fun describe_interface_contract(input :: InterfaceEndpoint || Array,
                                output :: InterfaceEndpoint || Array,
                                name :: String,
                                ~kind: kind :: String = "contract",
                                ~trace_model: trace_model :: InterfaceTraceModel):
  def module_def = kernel.active_module()
  unless name != ""
  | error(~who: #'describe_interface_contract, "contract name must not be empty")
  for (existing in module_interface_transforms(module_def)):
    when existing.contract_name
    | when existing.contract_name == name || interface_shapes_overlap(input, existing.input) || interface_shapes_overlap(output, existing.output)
      | error(~who: #'describe_interface_contract, "competing interface contracts: " ++ existing.contract_name ++ " and " ++ name)
  fun attach(shape :: InterfaceEndpoint || Array, provider :: Boolean):
    if shape is_a Array
    | Array(& (for List (endpoint in shape): attach(endpoint, provider)))
    | block:
        unless for all (binding in shape.bindings): binding.entity.module_def === module_def
        | error(~who: #'describe_interface_contract, "contract endpoints must belong to the local module")
        def already_oriented = (shape.represented_role == shape.type.provider_role) == provider
        when endpoint_view_has_origin(shape, "boundary") && already_oriented
        | error(~who: #'describe_interface_contract, if provider | "contract output must be a produced boundary" | "contract input must be a consumed boundary")
        if already_oriented
        | shape
        | block:
            def endpoint = InterfaceEndpoint(shape.type, shape.role, shape.type.complementary_role(shape.represented_role), shape.bindings, "contract")
            record_interface_connection(shape, endpoint)
            endpoint
  def inputs = attach(input, #false)
  def outputs = attach(output, #true)
  describe_interface_transform(InterfaceHandle(inputs, outputs), kind, ~trace_model: trace_model, ~contract_name: name)
  #void

// Marks a transparent one-to-one transform as a user-visible event site while
// retaining a dedicated metadata record for compiler consumers.
fun describe_interface_event(handle :: Handle,
                             label :: String,
                             ~stalls: stalls :: Boolean = #false,
                             ~root: root :: Boolean = #false,
                             ~payload: payload :: False || HardwareEntity = #false,
                             ~fields: fields :: List.of(InterfaceEventField) = [],
                             ~terminal: terminal :: Boolean = #false,
                             ~valid: valid :: False || HardwareEntity = #false,
                             ~ready: ready :: False || HardwareEntity = #false,
                             ~location: location :: Location = Location()) :: Handle:
  unless label != ""
  | error(~who: #'describe_interface_event, "event label must not be empty")
  unless handle.left is_a InterfaceEndpoint && handle.right is_a InterfaceEndpoint
  | error(~who: #'describe_interface_event,
          "an event annotation requires one input and one output endpoint")
  def module_def = kernel.active_module()
  when payload && fields.length() > 0
  | error(~who: #'describe_interface_event, "choose either raw payload or named capture fields")
  def names = MutableSet{}
  for (field in fields):
    // Validate even descriptors constructed directly through the public class.
    def normalized = event_field(field.name, field.value, ~format: field.encoding, ~isa: field.isa, ~pc: field.pc, ~label: field.label, ~location: location)
    unless field.symbols == normalized.symbols
    | error(~who: #'describe_interface_event, "enum symbols must match the captured hardware type")
    when field.name in names
    | error(~who: #'describe_interface_event, "duplicate capture field name: " ++ field.name)
    names.add(field.name)
    unless field.value.module_def === module_def
    | error(~who: #'describe_interface_event, "capture field must belong to the annotated module")
  when fields.filter(~keep: fun (field): field.label).length() > 1
  | error(~who: #'describe_interface_event, "at most one capture may select the event label")
  for (field in fields):
    when field.encoding == "riscv"
    | def pc_field = fields.find(fun (candidate): candidate.name == field.pc)
      unless pc_field && pc_field.encoding in ["hex", "unsigned"] && pc_field.value.type.packed_width() == (if field.isa.starts_with("rv32") | 32 | 64)
      | error(~who: #'describe_interface_event, "RISC-V capture PC must reference a hex/unsigned field of ISA XLEN width")
  def existing = module_interface_events(module_def)
  def labels = if stalls | [label, label ++ ".stall"] | [label]
  when existing.find(fun (event): labels.find(fun (name): name == event.label || (event.stalls && name == (event.label ++ ".stall"))))
  | error(~who: #'describe_interface_event,
          "event label must be unique within a module: " ++ label)
  def payload_value:
    if payload
    | block:
        def value = kernel.read(payload, location)
        unless value.module_def === module_def
        | error(~who: #'describe_interface_event,
                "event payload must belong to the annotated module")
        unless data_type(value.type)
        | error(~who: #'describe_interface_event,
                "event payload must have a packed DataType")
        value
    | if fields.length() == 0
      | #false
      | block:
          // Pack only the selected observations, never the functional bundle.
          def record_fields = for List (field in fields, index in 0..fields.length()):
            RecordField("f" ++ to_string(index), field.value.type)
          kernel.record_create(RecordType(record_fields),
                               for List (field in fields, declared in record_fields):
                                 [declared.name, field.value])
  def site_index = existing.length()
  fun transfer_value(signal :: False || HardwareEntity):
    def value = if signal | kernel.read(signal, location) | #false
    when value && (!(value.module_def === module_def) || !scalar_data_type(value.type) || scalar_width(value.type) != 1)
    | error(~who: #'describe_interface_event, "event transfer controls must be local one-bit data")
    value
  when ready && !valid
  | error(~who: #'describe_interface_event, "event ready requires valid")
  when stalls && (!valid || !ready)
  | error(~who: #'describe_interface_event, "stall tracing requires valid and ready controls")
  def event = InterfaceEventGroup(module_def,
                                  site_index,
                                  label,
                                  handle.left,
                                  handle.right,
                                  payload_value,
                                  terminal,
                                  location,
                                  transfer_value(valid),
                                  transfer_value(ready),
                                  root,
                                  if payload | [InterfaceEventField("raw", payload_value, "hex")] | fields,
                                  stalls)
  module_def.add_metadata(interface_event_group_namespace, event)
  describe_interface_transform(
    handle,
    "event",
    {"label": label, "site": site_index, "terminal": terminal, "root": root},
    ~trace_model: interface_trace_passthrough()
  )

// Records one flattened interface leaf and whether the protocol provider owns
// its direction. Nested interfaces retain structural declaration order.
class InterfaceBoundaryLeaf(path :: NonemptyList.of(String),
                            from_provider :: Boolean)

fun interface_boundary_leaves(type :: InterfaceType,
                              provider_role :: String,
                              first_root_role :: String,
                              second_root_role :: String,
                              path :: List.of(String) = []):
  def mutable leaves = []
  for (member in type.members):
    def from_root_role:
      if member.from_role == type.roles[0]
      | first_root_role
      | second_root_role
    def to_root_role:
      if member.to_role == type.roles[0]
      | first_root_role
      | second_root_role
    def member_path = path ++ [member.name]
    if member.type is_a InterfaceType
    | leaves := leaves ++ interface_boundary_leaves(
        member.type,
        provider_role,
        from_root_role,
        to_root_role,
        member_path
      )
    | leaves := leaves ++ [
        InterfaceBoundaryLeaf(member_path, from_root_role == provider_role)
      ]
  leaves

fun interface_boundary_field(endpoint :: InterfaceEndpoint,
                             path :: NonemptyList.of(String)):
  def mutable field = endpoint
  for (name in path):
    field := field.field(name)
  field

fun validate_interface_boundary_bindings(type :: InterfaceType,
                                         bindings :: Map,
                                         who :: Symbol):
  unless bindings.length() == type.members.length()
  | error(~who: who,
          "interface boundary requires exactly one named binding for every interface member")
  for (member in type.members):
    def key = Keyword.from_string(member.name)
    unless bindings.has_key(key)
    | error(~who: who,
            "interface boundary is missing the ~" ++ member.name ++ " binding")
    if member.type is_a InterfaceType
    | block:
        def nested_bindings = bindings[key]
        unless nested_bindings is_a Map
        | error(~who: who, "nested interface members require named binding maps")
        validate_interface_boundary_bindings(member.type, nested_bindings, who)
    | #void

fun interface_boundary_binding(bindings :: Map,
                               path :: NonemptyList.of(String)):
  def mutable binding = bindings
  for (name in path):
    binding := binding[Keyword.from_string(name)]
  binding

fun validated_interface_boundary_leaves(type :: InterfaceType,
                                        bindings :: Map,
                                        who :: Symbol):
  validate_interface_boundary_bindings(type, bindings, who)
  interface_boundary_leaves(
    type,
    type.provider_role,
    type.roles[0],
    type.roles[1]
  )

// Captures a nested interface member's named leaves without exposing the host
// map representation at a boundary call site.
fun interface_fields(~& bindings :: Map):
  bindings

// The local circuit side owns provider-origin destinations and receives the
// reverse path. The complementary endpoint is returned for composition.
fun inject_interface(type :: InterfaceType,
                     ~& bindings :: Map) :: Endpoint:
  def leaves = validated_interface_boundary_leaves(
    type,
    bindings,
    #'inject_interface
  )
  def link :: Handle = interface_link(type, "inject_flow")
  def circuit_endpoint:
    if type.provider_role == type.roles[0] | link.left | link.right
  def interface_endpoint :: Endpoint:
    if type.provider_role == type.roles[0] | link.right | link.left
  for (leaf in leaves):
    def entity = interface_boundary_field(circuit_endpoint, leaf.path)
    def binding = interface_boundary_binding(bindings, leaf.path)
    if leaf.from_provider
    | kernel.connect(entity, binding)
    | kernel.connect(binding, entity)
  link.consumed := #true
  interface_endpoint

fun interface_provider_end(handle :: Handle):
  cond
  | handle.right is_a InterfaceEndpoint && handle.right.represented_role == handle.right.type.provider_role:
      [handle.right, handle.left]
  | handle.left is_a InterfaceEndpoint && handle.left.represented_role == handle.left.type.provider_role:
      [handle.left, handle.right]
  | ~else:
      error(~who: #'eject_interface,
            "interface ejection requires a handle with one provider-facing endpoint")

// A terminal consumes a concrete endpoint immediately or retains the input
// end of a detached handle as an InterfaceSink for later composition.
fun finish_ejected_interface(source :: InterfaceType || InterfaceEndpoint || InterfaceHandle,
                             bindings :: Map):
  def detached_link:
    if source is_a InterfaceType
    | interface_link(source, "eject_flow")
    | #false
  def handle:
    if source is_a InterfaceHandle | source | detached_link
  if handle
  | unless !handle.consumed
    | error(~who: #'eject_interface,
            "an interface handle can be consumed only once")
  | #void
  def handle_ends:
    if handle | interface_provider_end(handle) | #false
  def interface_endpoint:
    cond
    | source is_a InterfaceEndpoint: source
    | handle: handle_ends[0]
    | ~else:
        error(~who: #'eject_interface,
              "interface ejection requires an InterfaceType, endpoint, or handle")
  unless interface_endpoint.represented_role == interface_endpoint.type.provider_role
  | error(~who: #'eject_interface,
          "interface ejection requires an endpoint representing the provider role")
  def leaves = validated_interface_boundary_leaves(
    interface_endpoint.type,
    bindings,
    #'eject_interface
  )
  for (leaf in leaves):
    def entity = interface_boundary_field(interface_endpoint, leaf.path)
    def binding = interface_boundary_binding(bindings, leaf.path)
    if leaf.from_provider
    | kernel.connect(binding, entity)
    | kernel.connect(entity, binding)
  if handle
  | block:
      handle.consumed := #true
      InterfaceSink(handle_ends[1])
  | #void

// Configures a unary terminal so it naturally occupies the rightmost position
// of an ordinary Rhombus pipeline.
fun eject_interface(~& bindings :: Map):
  fun (eject_interface_source):
    finish_ejected_interface(eject_interface_source, bindings)

// Combines independent handles or already-terminated sinks. A homogeneous
// handle collection retains both array-shaped ends; a homogeneous sink
// collection retains only its array-shaped input end.
fun parallel_handles(paths :: Array):
  unless paths.length() > 0
  | error(~who: #'parallel_handles,
          "parallel interface composition requires at least one handle or sink")
  cond
  | paths[0] is_a InterfaceHandle:
      for (path in paths):
        unless path is_a InterfaceHandle
        | error(~who: #'parallel_handles,
                "parallel interface composition requires all handles or all sinks")
        when path.consumed
        | error(~who: #'parallel_handles,
                "an interface handle can be consumed only once")
      def left = Array(& (for List (path in paths): path.left))
      def right = Array(& (for List (path in paths): path.right))
      for (path in paths): path.consumed := #true
      InterfaceHandle(left, right)
  | paths[0] is_a InterfaceSink:
      for (path in paths):
        unless path is_a InterfaceSink
        | error(~who: #'parallel_handles,
                "parallel interface composition requires all handles or all sinks")
        when path.consumed
        | error(~who: #'parallel_handles,
                "an interface sink can be consumed only once")
      def left = Array(& (for List (path in paths): path.left))
      for (path in paths): path.consumed := #true
      InterfaceSink(left)
  | ~else:
      error(~who: #'parallel_handles,
            "parallel interface composition requires all handles or all sinks")

// Connects the output end of a handle now and returns its still-open input as
// a linear sink for later serial or parallel composition.
fun terminate_interface_handle(handle :: Handle,
                               terminal :: InterfaceEndpoint || Array):
  unless !handle.consumed
  | error(~who: #'InterfaceHandle,
          "an interface handle can be consumed only once")
  connect_endpoint_shapes(handle.right, terminal)
  handle.consumed := #true
  InterfaceSink(handle.left)

fun connect_interface_fields(left :: InterfaceHandle || InterfaceEndpoint || Array,
                             right :: InterfaceEndpoint || Array,
                             & extra_values :: List,
                             ~& extra_fields :: Map):
  cond
  | left is_a InterfaceHandle:
      unless extra_values.length() == 0 && extra_fields.length() == 0
      | error(~who: #'connect_interfaces,
              "handle termination requires exactly one endpoint shape")
      terminate_interface_handle(left, right)
  | left is_a Array:
      when extra_fields.length() > 0
      | error(~who: #'connect_interfaces,
              "an endpoint-array sequence cannot use named refinement members")
      def items:
        if extra_values.length() == 0 && right is_a Array
        | right
        | Array(& ([right] ++ extra_values))
      connect_interfaces(left, items)
  | ~else:
      def pairs = interface_connection_pairs(left,
                                             right,
                                             extra_values,
                                             extra_fields)
      for (pair in pairs):
        if pair[0] is_a Place
        | kernel.connect(pair[0], pair[1])
        | kernel.connect(pair[1], pair[0])
      record_interface_connection(left, right)
      #void

fun make_refined_interface(identity :: InterfaceIdentity,
                           name :: String,
                           parent :: InterfaceType,
                           declarations :: List,
                           supported_contracts :: List.of(InterfaceSupport) = [],
                           ~specialization_arguments: specialization_arguments :: List = []):
  InterfaceType(name,
                parent.roles,
                declarations,
                parent,
                supported_contracts,
                ~provider_role: parent.provider_role,
                ~identity: identity,
                ~specialization_arguments: specialization_arguments)

meta:
  fun interface_parameter_binding(parameter :: Syntax):
    match parameter
    | '$(binding :: Identifier) $_ ...': binding
    | '~$_: $(binding :: Identifier) $_ ...': binding
    | ~else:
        syntax_meta.error("expected an interface generator parameter", parameter)

  fun substitute_interface_parameters(form :: Syntax,
                                      parameters :: List):
    substitute_generator_parameters(
      form,
      parameters.map(interface_parameter_binding)
    )

  fun build_interface_definition(name :: Syntax,
                                 parameters :: List,
                                 construct :: Syntax,
                                 parent :: Syntax,
                                 members :: List):
    def implementation = Syntax.make_id(
      name.to_source_string() ++ "_interface_type",
      name
    )
    let [parameter, ...] = parameters
    let [binding, ...] = parameters.map(interface_parameter_binding)
    let [member, ...] = members
    def substituted_parent = substitute_interface_parameters(parent, parameters)
    let [substituted_member, ...]:
      for List (entry in members):
        match entry
        | '$(field :: Identifier): $type':
            def substituted_type = substitute_interface_parameters(type, parameters)
            '$field: $substituted_type'
        | ~else:
            syntax_meta.error("invalid interface member surface", entry)
    '«
       def interface_identity = InterfaceIdentity()
       fun $implementation($parameter, ...):
         $construct
       expr.macro
       | '$name($('$')$binding, ...)':
           '$implementation($('$')$binding, ...) :: InterfaceTypeSurface(
              EndpointSurface($substituted_parent, $substituted_member, ...)
            )'
       | '$name': '$implementation'
     »'

defn.macro
| 'interface $(name :: Identifier)($parameter, ...) refines $(parent :: expr_meta.Parsed):
       supports $(support_role :: Identifier): $supported
       $(first_from :: Identifier) -> $(first_to :: Identifier):
         $first_field: $first_type
         ...
       $(second_from :: Identifier) -> $(second_to :: Identifier):
         $second_field: $second_type
         ...':
    def interface_name = name.to_source_string()
    def support_role_name = support_role.to_source_string()
    def first_from_name = first_from.to_source_string()
    def first_to_name = first_to.to_source_string()
    def second_from_name = second_from.to_source_string()
    def second_to_name = second_to.to_source_string()
    let [first_field_name, ...] = [first_field.to_source_string(), ...]
    let [second_field_name, ...] = [second_field.to_source_string(), ...]
    build_interface_definition(
      name,
      [parameter, ...],
      'make_refined_interface(
         interface_identity,
         $interface_name,
         $parent,
         [InterfaceMember($first_field_name, $first_type, $first_from_name, $first_to_name), ...,
          InterfaceMember($second_field_name, $second_type, $second_from_name, $second_to_name), ...],
         [InterfaceSupport($support_role_name, $supported)],
         ~specialization_arguments: [$parameter, ...]
       )',
      parent,
      ['$first_field: $first_type', ..., '$second_field: $second_type', ...]
    )
| 'interface $(name :: Identifier)($parameter, ...) refines $(parent :: expr_meta.Parsed):
       supports $(support_role :: Identifier): $supported
       $(from_role :: Identifier) -> $(to_role :: Identifier):
         $field: $field_type
         ...':
    def interface_name = name.to_source_string()
    def support_role_name = support_role.to_source_string()
    def from_role_name = from_role.to_source_string()
    def to_role_name = to_role.to_source_string()
    let [field_name, ...] = [field.to_source_string(), ...]
    build_interface_definition(
      name,
