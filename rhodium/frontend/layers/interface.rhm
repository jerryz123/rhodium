expr.macro <=>:
  ~weaker_than: ~other
| '$left <=> ($right, $extra, ...)':
    'connect_interface_fields($left, $right, $extra, ...)'
| '$left <=> $(right :: expr_meta.AfterInfixParsed('<=>')) $()':
    'connect_interface_fields($left, $right)'
