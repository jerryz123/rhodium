#lang rhombus/and_meta
// Defines the combinational value, function, and operator layer over the elaboration kernel.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus
  rhombus.(!) as host_invert
  rhombus/meta open
  "../../core/ir.rhm".Location
  "../../core/types.rhm" open
  "../kernel.rhm" open:
    except:
      concat
      extract
      literal
      dont_care
      trunc
      bit_not
      bit_and
      bit_or
      bit_xor
      hw_add
      hw_mul
      hw_sub
      hw_shl
      hw_shru
      hw_shrs
  "../kernel.rhm".concat as kernel_concat
  "../kernel.rhm".dont_care as kernel_dont_care
  "../kernel.rhm".trunc as kernel_trunc
  "../kernel.rhm".bit_not as kernel_bit_not
  "../kernel.rhm".bit_and as kernel_bit_and
  "../kernel.rhm".bit_or as kernel_bit_or
  "../kernel.rhm".bit_xor as kernel_bit_xor
  "../kernel.rhm".hw_add as kernel_hw_add
  "../kernel.rhm".hw_mul as kernel_hw_mul
  "../kernel.rhm".hw_sub as kernel_hw_sub
  "../kernel.rhm".hw_shl as kernel_hw_shl
  "../kernel.rhm".hw_shru as kernel_hw_shru
  "../kernel.rhm".hw_shrs as kernel_hw_shrs
  "../support/fields.rhm".HardwareFields
  "../support/fields.rhm".hardware_as_bits
  "../support/hardware-literal.rhm" open
  "../support/mux-lookup.rhm" open

export:
  HardwareEntity
  bits
  literal
  dont_care
  bit_not
  bit_and
  bit_or
  bit_xor
  hw_add
  hw_mul
  hw_sub
  hw_shl
  hw_shru
  hw_eq
  hw_decode
  mux_lookup
  concat
  trunc
  +
  *
  -
  <<
  >>
  &
  |||
  ^
  !

meta:
  fun preserve_operand_surface(result :: Syntax, operand :: Syntax):
    statinfo_meta.wrap(result, statinfo_meta.gather(operand))

// Frontend literals are static host shadows. They allocate core operations
// only when a hardware consumer reads them during elaboration.
fun literal(type :: DataType,
            value :: Nat,
            name :: False || String = #false):
  packed_literal(type, value, name)

fun bits(value :: Nat,
         width :: PosInt,
         name :: False || String = #false) :~ HardwareFields:
  literal(Bits(width), value, name)

// Host shift amounts are elaboration-time constants. Convert them to the
// narrowest positive-width Bits literal while leaving dynamic hardware
// amounts untouched for the kernel's ordinary type checking.
fun required_shift_amount_width(amount :: Nat):
  fun loop(width :: PosInt, capacity :: PosInt):
    if amount < capacity
    | width
    | loop(width + 1, capacity * 2)
  loop(1, 2)

fun normalize_shift_amount(amount :: Int || HardwareEntity, who :: Symbol):
  cond
  | amount is_a Nat:
      bits(amount, required_shift_amount_width(amount))
  | amount is_a Int:
      error(~who: who, "shift amount must be a host natural number or hardware Bits")
  | ~else: amount

fun hw_shl(value :: HardwareEntity,
           amount :: Int || HardwareEntity,
           name :: False || String = #false,
           location :: Location = Location()) :~ HardwareFields:
  kernel_hw_shl(value,
                normalize_shift_amount(amount, #'hw_shl),
                name,
                location)

fun hw_shru(value :: HardwareEntity,
            amount :: Int || HardwareEntity,
            name :: False || String = #false,
            location :: Location = Location()) :~ HardwareFields:
  kernel_hw_shru(value,
                 normalize_shift_amount(amount, #'hw_shru),
                 name,
                 location)

fun hw_shrs(value :: HardwareEntity,
            amount :: Int || HardwareEntity,
            name :: False || String = #false,
            location :: Location = Location()) :~ HardwareFields:
  kernel_hw_shrs(value,
                 normalize_shift_amount(amount, #'hw_shrs),
                 name,
                 location)

fun bit_not(entity :: HardwareEntity,
            name :: False || String = #false,
            location :: Location = Location()) :~ HardwareFields:
  kernel_bit_not(entity, name, location)

fun bit_and(left :: HardwareEntity,
            right :: HardwareEntity,
            name :: False || String = #false,
            location :: Location = Location()) :~ HardwareFields:
  kernel_bit_and(left, right, name, location)

fun bit_or(left :: HardwareEntity,
           right :: HardwareEntity,
           name :: False || String = #false,
           location :: Location = Location()) :~ HardwareFields:
  kernel_bit_or(left, right, name, location)

fun bit_xor(left :: HardwareEntity,
            right :: HardwareEntity,
            name :: False || String = #false,
            location :: Location = Location()) :~ HardwareFields:
  kernel_bit_xor(left, right, name, location)

fun hw_add(left :: HardwareEntity,
           right :: HardwareEntity,
           name :: False || String = #false,
           location :: Location = Location()) :~ HardwareFields:
  kernel_hw_add(left, right, name, location)

fun hw_mul(left :: HardwareEntity,
           right :: HardwareEntity,
           name :: False || String = #false,
           location :: Location = Location()) :~ HardwareFields:
  kernel_hw_mul(left, right, name, location)

fun hw_sub(left :: HardwareEntity,
           right :: HardwareEntity,
           name :: False || String = #false,
           location :: Location = Location()) :~ HardwareFields:
  kernel_hw_sub(left, right, name, location)

// Like a literal shadow, a typed don't-care is materialized only when a
// hardware consumer reads it. Core IR carries only its packed Bits image.
class DontCareValue(type :: DataType,
                    name :: False || String = #false):
  implements StaticHardwareValue
  constructor (type :: DataType,
               name :: False || String = #false):
    unless type_well_formed(type)
    | error(~who: #'dont_care,
            "don't-care type must be a well-formed DataType")
    def width = type.packed_width()
    unless width is_a PosInt
    | error(~who: #'dont_care,
            "don't-care type must have a packed representation")
    super(type, name)

  override method materialize_hardware(location :: Location):
    def width = type.packed_width()
    if bits_type(type)
    | kernel_dont_care(type, name, location)
    | cast(kernel_dont_care(Bits(width), #false, location),
           type,
           name,
           location)

fun dont_care(type :: DataType,
              name :: False || String = #false):
  DontCareValue(type, name)

fun concat_operand(entity :: HardwareEntity):
  hardware_as_bits(entity, #'concat, "concat operand")

fun concat(entity :: HardwareEntity || List.of(HardwareEntity), ...) :~ HardwareFields:
  def supplied = [entity, ...]
  def entities:
    if supplied.length() == 1 && supplied[0] is_a List
    | supplied[0]
    | supplied
  unless entities.length() >= 2
  | error(~who: #'concat, "concat requires at least two operands")
  kernel_concat(entities.map(concat_operand))

fun trunc(entity :: HardwareEntity,
          target_width :: PosInt,
          name :: False || String = #false) :~ HardwareFields:
  kernel_trunc(entity, target_width, name)

fun build_mux_lookup(selector :: HardwareEntity,
                     default_value :: HardwareEntity,
                     cases :: List.of(List)):
  def selector_value = read(selector)
  cond
  | bits_type(selector_value.type):
      hw_mux_lookup(selector_value, default_value, cases)
  | selector_value.type is_a MuxLookupSelectorType:
      def selector_bits = hardware_as_bits(selector_value, #'mux_lookup, "mux lookup selector")
      def normalized_cases = cases.map(
        fun (case):
          unless case.length() == 2
          | error(~who: #'mux_lookup, "mux lookup cases must be [key, value] pairs")
          [selector_value.type.normalize_mux_lookup_key(case[0]), case[1]]
      )
      hw_mux_lookup(selector_bits, default_value, normalized_cases)
  | ~else:
      hw_mux_lookup(selector_value, default_value, cases)

expr.macro
| 'mux_lookup($(selector :: expr_meta.Parsed),
              ~default: $(default_value :: expr_meta.Parsed),
              $cases)':
    preserve_operand_surface(
      'build_mux_lookup($selector, $default_value, $cases)',
      default_value
    )
| 'mux_lookup($(selector :: expr_meta.Parsed),
              ~default: $(default_value :: expr_meta.Parsed)):
     $(key :: expr_meta.Parsed): $case_value
     ...':
    preserve_operand_surface(
      'build_mux_lookup($selector,
                        $default_value,
                        [[$key, $case_value], ...])',
      default_value
    )

fun add_operator(left :: HardwareEntity || Number,
                 right :: HardwareEntity || Number):
  if left is_a HardwareEntity || right is_a HardwareEntity
  | hw_add(left, right)
  | left rhombus.(+) right

fun multiply_operator(left :: HardwareEntity || Number,
                      right :: HardwareEntity || Number):
  if left is_a HardwareEntity || right is_a HardwareEntity
  | hw_mul(left, right)
  | left rhombus.(*) right

fun subtract_operator(left :: HardwareEntity || Number,
                      right :: HardwareEntity || Number):
  if left is_a HardwareEntity || right is_a HardwareEntity
  | hw_sub(left, right)
  | left rhombus.(-) right

fun negate_operator(entity :: HardwareEntity || Number):
  if entity is_a HardwareEntity
  | block:
      def value = read(entity)
      hw_sub(literal(value.type, 0), value)
  | rhombus.(-) entity

expr.macro '$left + $right':
  ~order: addition
  preserve_operand_surface('add_operator($left, $right)', left)

expr.macro '$left * $right':
  ~order: multiplication
  preserve_operand_surface('multiply_operator($left, $right)', left)

expr.macro
| '$left - $right':
    ~order: addition
    preserve_operand_surface('subtract_operator($left, $right)', left)
| '- $entity':
    ~order: multiplication
    preserve_operand_surface('negate_operator($entity)', entity)

fun shift_left_operator(left :: HardwareEntity || Int,
                        right :: HardwareEntity || Int):
  if left is_a HardwareEntity || right is_a HardwareEntity
  | hw_shl(left, right)
  | left rhombus.bits.(<<) right

fun shift_right_operator(left :: HardwareEntity || Int,
                         right :: HardwareEntity || Int):
  if left is_a HardwareEntity || right is_a HardwareEntity
  | block:
      def value = read(left)
      if signed_arithmetic_type(value.type)
      | hw_shrs(value, right)
      | hw_shru(value, right)
  | left rhombus.bits.(>>) right

expr.macro '$left << $right':
  ~order: bitwise_shift
  preserve_operand_surface('shift_left_operator($left, $right)', left)

expr.macro '$left >> $right':
  ~order: bitwise_shift
  preserve_operand_surface('shift_right_operator($left, $right)', left)

expr.macro '$left & $right':
  ~order: bitwise_conjunction
  preserve_operand_surface('bit_and($left, $right)', left)

expr.macro '$left ||| $right':
  ~order: bitwise_disjunction
  preserve_operand_surface('bit_or($left, $right)', left)

expr.macro '$left ^ $right':
  ~order: bitwise_disjunction
  preserve_operand_surface('bit_xor($left, $right)', left)

expr.macro '! $entity':
  ~order: bitwise_negation
  def result = '«
    block:
      def value = $entity
      if value is_a HardwareEntity
      | bit_not(value)
      | host_invert(value)
  »'
  preserve_operand_surface(result, entity)
