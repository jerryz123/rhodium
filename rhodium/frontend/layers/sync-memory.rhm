#lang rhombus/and_meta
// Defines circuit-shaped synchronous memories with fixed read, write, and shared ports.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/meta open
  "../../../support/annotations.rhm" open
  "../../core/ir.rhm" open
  "../kernel.rhm" as kernel
  "../support/clocking.rhm".ambient_sync_memory
  "../support/clocking.rhm".reject_explicit_sync_control
  "../support/fields.rhm".HardwareFields

export:
  sync_mem

fun declare_sync_memory(name :: AsciiIdentifier,
                        depth :: PosInt,
                        element_type :: DataType,
                        has_read :: Boolean,
                        has_write :: Boolean,
                        has_read_write :: Boolean,
                        ~clock: clock :: False || HardwareEntity = #false,
                        ~mask_granularity: mask_granularity :: False || PosInt = #false):
  when clock
  | reject_explicit_sync_control()
  when mask_granularity && !has_write && !has_read_write
  | error(~who: #'sync_mem,
          "mask granularity requires a write or read-write port")
  if clock
  | kernel.sync_memory(name,
                       depth,
                       element_type,
                       clock,
                       has_read,
                       has_write,
                       has_read_write,
                       mask_granularity)
  | ambient_sync_memory(name,
                        depth,
                        element_type,
                        has_read,
                        has_write,
                        has_read_write,
                        mask_granularity)

fun sync_memory_read_port(memory :: SyncMemory):
  unless memory.read_port
  | error(~who: #'read, "synchronous memory has no read port")
  memory.read_port

fun sync_memory_write_port(memory :: SyncMemory):
  unless memory.write_port
  | error(~who: #'write, "synchronous memory has no write port")
  memory.write_port

fun sync_memory_read_write_port(memory :: SyncMemory):
  unless memory.read_write_port
  | error(~who: #'read_write,
          "synchronous memory has no read-write port")
  memory.read_write_port

fun sync_memory_read_address(port :: SyncMemoryReadPort) :~ HardwareFields: port.address
fun sync_memory_read_enable(port :: SyncMemoryReadPort) :~ HardwareFields: port.enable
fun sync_memory_read_data(port :: SyncMemoryReadPort) :~ HardwareFields: port.data
fun sync_memory_write_address(port :: SyncMemoryWritePort) :~ HardwareFields: port.address
fun sync_memory_write_data(port :: SyncMemoryWritePort) :~ HardwareFields: port.data
fun sync_memory_write_enable(port :: SyncMemoryWritePort) :~ HardwareFields: port.enable
fun sync_memory_write_mask(port :: SyncMemoryWritePort) :~ HardwareFields:
  unless port.mask
  | error(~who: #'mask,
          "synchronous memory write port has no mask")
  port.mask
fun sync_memory_read_write_address(port :: SyncMemoryReadWritePort) :~ HardwareFields: port.address
fun sync_memory_read_write_enable(port :: SyncMemoryReadWritePort) :~ HardwareFields: port.enable
fun sync_memory_read_write_write(port :: SyncMemoryReadWritePort) :~ HardwareFields: port.write
fun sync_memory_read_write_write_data(port :: SyncMemoryReadWritePort) :~ HardwareFields: port.write_data
fun sync_memory_read_write_write_mask(port :: SyncMemoryReadWritePort) :~ HardwareFields:
  unless port.write_mask
  | error(~who: #'write_mask,
          "synchronous memory read-write port has no write mask")
  port.write_mask
fun sync_memory_read_write_read_data(port :: SyncMemoryReadWritePort) :~ HardwareFields: port.read_data

annot.macro 'SyncMemoryFields':
  annot_meta.pack_predicate(
    'fun (value): value is_a SyncMemory',
    '(($(statinfo_meta.dot_provider_key), sync_memory_dot))'
  )

annot.macro 'SyncMemoryReadFields':
  annot_meta.pack_predicate(
    'fun (value): value is_a SyncMemoryReadPort',
    '(($(statinfo_meta.dot_provider_key), sync_memory_read_dot))'
  )

annot.macro 'SyncMemoryWriteFields':
  annot_meta.pack_predicate(
    'fun (value): value is_a SyncMemoryWritePort',
    '(($(statinfo_meta.dot_provider_key), sync_memory_write_dot))'
  )

annot.macro 'SyncMemoryReadWriteFields':
  annot_meta.pack_predicate(
    'fun (value): value is_a SyncMemoryReadWritePort',
    '(($(statinfo_meta.dot_provider_key), sync_memory_read_write_dot))'
  )

dot.macro 'sync_memory_dot $left $dot $right':
  match right
  | 'read': 'sync_memory_read_port($left) :: SyncMemoryReadFields'
  | 'write': 'sync_memory_write_port($left) :: SyncMemoryWriteFields'
  | 'read_write': 'sync_memory_read_write_port($left) :: SyncMemoryReadWriteFields'
  | ~else: #false

dot.macro 'sync_memory_read_dot $left $dot $right':
  match right
  | 'address': 'sync_memory_read_address($left)'
  | 'enable': 'sync_memory_read_enable($left)'
  | 'data': 'sync_memory_read_data($left)'
  | ~else: #false

dot.macro 'sync_memory_write_dot $left $dot $right':
  match right
  | 'address': 'sync_memory_write_address($left)'
  | 'data': 'sync_memory_write_data($left)'
  | 'enable': 'sync_memory_write_enable($left)'
  | 'mask': 'sync_memory_write_mask($left)'
  | ~else: #false

dot.macro 'sync_memory_read_write_dot $left $dot $right':
  match right
  | 'address': 'sync_memory_read_write_address($left)'
  | 'enable': 'sync_memory_read_write_enable($left)'
  | 'write': 'sync_memory_read_write_write($left)'
  | 'write_data': 'sync_memory_read_write_write_data($left)'
  | 'write_mask': 'sync_memory_read_write_write_mask($left)'
  | 'read_data': 'sync_memory_read_write_read_data($left)'
  | ~else: #false

defn.macro
| 'sync_mem $(name :: Identifier)($depth, $element_type, $option, ...):
     read
     write':
    def memory_name = name.to_source_string()
    'def $name :: SyncMemoryFields = declare_sync_memory(
       $memory_name, $depth, $element_type, #true, #true, #false, $option, ...
     )'
| 'sync_mem $(name :: Identifier)($depth, $element_type, $option, ...):
     read':
    def memory_name = name.to_source_string()
    'def $name :: SyncMemoryFields = declare_sync_memory(
       $memory_name, $depth, $element_type, #true, #false, #false, $option, ...
     )'
| 'sync_mem $(name :: Identifier)($depth, $element_type, $option, ...):
     write':
    def memory_name = name.to_source_string()
    'def $name :: SyncMemoryFields = declare_sync_memory(
       $memory_name, $depth, $element_type, #false, #true, #false, $option, ...
     )'
| 'sync_mem $(name :: Identifier)($depth, $element_type, $option, ...):
     read_write':
    def memory_name = name.to_source_string()
    'def $name :: SyncMemoryFields = declare_sync_memory(
       $memory_name, $depth, $element_type, #false, #false, #true, $option, ...
     )'
