#lang rhombus/and_meta
// Defines hardware-only predicate and exact-key conditional assignment syntax.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/meta open
  "../../core/ir.rhm" open
  "../kernel.rhm".conditional_chain
  "../kernel.rhm" as kernel
  "../support/fields.rhm".hardware_as_bits
  "../support/mux-lookup.rhm".MuxLookupSelectorType

export:
  when
  switch

fun build_switch(selector :~ HardwareEntity,
                 cases :: NonemptyList.of(List),
                 otherwise_body :: False || Function.of_arity(0) = #false):
  unless selector is_a HardwareEntity
  | kernel.frontend_fail("switch selector must be a hardware value")
  for (case in cases):
    unless case.length() == 2
    | kernel.frontend_fail("switch cases must contain a key and branch body")
  def selector_value = kernel.read(selector)
  def selector_bits:
    if bits_type(selector_value.type)
    | selector_value
    | if selector_value.type is_a MuxLookupSelectorType
      | hardware_as_bits(selector_value, #'switch, "switch selector")
      | kernel.frontend_fail(
          "switch selector must be Bits or a typed mux-key selector"
        )
  def normalized_cases:
    if bits_type(selector_value.type)
    | cases.map(fun (case): [case[0](), case[1]])
    | cases.map(
        fun (case):
          [selector_value.type.normalize_mux_lookup_key(case[0]()), case[1]]
      )
  kernel.switch_chain(selector_bits, normalized_cases, otherwise_body)

defn.sequence_macro 'when $condition: $body; ...
                     $tail
                     ...':
  fun expand_chain(branches :: List.of(Syntax), remaining :: Syntax):
    match remaining
    | 'elsewhen $next_condition: $next_body; ...
       $rest
       ...':
        expand_chain(
          branches ++ [
            '[fun (): $next_condition,
              fun ():
                $next_body
                ...]'
          ],
          '$rest; ...'
        )
    | 'otherwise: $otherwise_body; ...
       $rest
       ...':
        let [branch, ...] = branches
        values(
          'conditional_chain(
             [$branch, ...],
             fun ():
               $otherwise_body
               ...
           )',
          '$rest; ...'
        )
    | ~else:
        let [branch, ...] = branches
        values(
          'conditional_chain(
             [$branch, ...]
           )',
          remaining
        )
  expand_chain(
    [
      '[fun (): $condition,
        fun ():
          $body
          ...]'
    ],
    '$tail; ...'
  )

expr.macro
| 'when $condition: $body; ...':
    'conditional_chain(
       [[fun (): $condition,
         fun ():
           $body
           ...]]
     )'

// Clause parsing stays frontend-only. Keys are host expressions evaluated
// during elaboration, while every case body is collected as a hardware branch.
defn.macro 'switch $selector: $clause; ...':
  def mutable case_entries = []
  def mutable otherwise_entry = #false
  for (item in [clause, ...]):
    match item
    | 'case $(key :: expr_meta.Parsed): $body; ...':
        when otherwise_entry
        | syntax_meta.error("switch case cannot follow otherwise", item)
        def case_entry:
          '[fun (): $key,
            fun ():
              $body
              ...]'
        case_entries := case_entries ++ [case_entry]
    | 'otherwise: $body; ...':
        when otherwise_entry
        | syntax_meta.error("switch can have only one otherwise", item)
        otherwise_entry := 'fun ():
                              $body
                              ...'
    | ~else:
        syntax_meta.error("expected switch case or otherwise", item)
  when case_entries.length() == 0
  | syntax_meta.error("switch requires at least one case", '$selector')
  let [case_entry, ...] = case_entries
  if otherwise_entry
  | 'build_switch($selector, [$case_entry, ...], $otherwise_entry)'
  | 'build_switch($selector, [$case_entry, ...])'
