#lang rhombus
// Defines reset-suppressed clocked hardware assertions with ambient or explicit domains.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../core/types.rhm" open
  "../kernel.rhm" as kernel
  "../support/clocking.rhm".ambient_assert
  "../support/clocking.rhm".reject_explicit_sync_control
  "../support/fields.rhm".HardwareFields

export:
  assert

fun assert(condition :~ HardwareFields,
           label :: False || String = #false,
           ~clock: clock :: False || HardwareFields.of(Clock) = #false,
           ~reset: reset :: False || HardwareFields.of(Reset) = #false):
  when clock || reset
  | reject_explicit_sync_control()
  if clock || reset
  | block:
      unless clock && reset
      | error(~who: #'assert,
              "explicit assertions require both ~clock and ~reset")
      kernel.assert(condition, clock, reset, label)
  | ambient_assert(condition, label)
