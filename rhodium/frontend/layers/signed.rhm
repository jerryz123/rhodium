#lang rhombus/and_meta
// Defines explicit-width signed integers, two's-complement literals, and signed resizing.

import:
  rhombus.bits.(<<) as <<
  rhombus/meta open
  "../../../support/annotations.rhm" open
  "../../core/types.rhm" open
  "../../core/ir.rhm" open
  "../kernel.rhm" as kernel
  "../support/fields.rhm".HardwareFields
  "../support/fields.rhm".hardware_as_bits
  "../support/hardware-literal.rhm".packed_literal

export:
  SInt
  SIntLiteral
  sint_type
  sint
  strunc

class _SIntType(width :: PosInt):
  implements SignedArithmeticType
  implements Callable

  override method describe():
    "sint<" ++ to_string(width) ++ ">"

  override method type_equal(other :: HardwareType):
    sint_type(other) && width == other.width

  override method packed_width():
    width

  override method with_bit_width(new_width :: PosInt):
    SInt(new_width)

  override method call(value :: Int) :~ HardwareFields:
    SIntLiteral(this, value)

fun SInt(width :: PosInt):
  _SIntType(width)

annot.macro 'SInt($width)':
  'HardwareFields.of(SInt($width))'

fun sint_type(type :: HardwareType):
  type is_a _SIntType

// Validates the signed source value, then stores only its canonical packed
// two's-complement image in the shared literal representation.
fun SIntLiteral(type :: _SIntType,
                value :: Int,
                name :: False || AsciiIdentifier = #false):
  def minimum = -(1 << (type.width - 1))
  def maximum = (1 << (type.width - 1)) - 1
  unless minimum <= value && value <= maximum
  | error(~who: #'sint,
          "literal value must fit the declared signed width")
  packed_literal(
    type,
    if value < 0 | (1 << type.width) + value | value,
    name
  )

fun sint(value :: Int,
         width :: PosInt,
         name :: False || AsciiIdentifier = #false):
  SIntLiteral(SInt(width), value, name)

fun require_signed_value(entity :: HardwareEntity,
                         who :: Symbol,
                         location :: Location):
  def value = kernel.read(entity, location)
  unless signed_arithmetic_type(value.type)
  | error(~who: who,
          location.describe() ++ ": expected a signed arithmetic hardware value")
  value

// Signed truncation retains the low bits and restores the same nominal signed
// type at the smaller width; rtl.trunc itself remains a Bits representation op.
fun strunc(entity :: HardwareEntity,
           target_width :: PosInt,
           name :: False || AsciiIdentifier = #false,
           location :: Location = Location()) :~ HardwareFields:
  def value = require_signed_value(entity, #'strunc, location)
  unless target_width < scalar_width(value.type)
  | error(~who: #'strunc, "target width must be smaller than the source width")
  def source_bits = hardware_as_bits(value, #'strunc, "strunc operand", #false, location)
  def result_bits = kernel.trunc(source_bits, target_width, #false, location)
  kernel.cast(result_bits,
              value.type.with_bit_width(target_width),
              name,
              location)
