#lang rhombus
// Defines lossless expanding arithmetic as explicit resizing plus modular core operations.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus
  "../../../support/annotations.rhm" open
  "../../core/ir.rhm" open
  "../../core/types.rhm" open
  "../kernel.rhm" open
  "../support/fields.rhm".HardwareFields

export:
  add_expanding
  mul_expanding
  +&
  *&

fun widen_unsigned_operands(left_value :: Value,
                            right_value :: Value,
                            result_width :: PosInt):
  values(zext(left_value, result_width),
         zext(right_value, result_width))

fun widen_signed_operands(left_value :: Value,
                          right_value :: Value,
                          result_width :: PosInt):
  values(sext(left_value, result_width),
         sext(right_value, result_width))

fun add_expanding(left :: HardwareEntity,
                  right :: HardwareEntity,
                  name :: False || AsciiIdentifier = #false) :~ HardwareFields:
  def left_value = read(left)
  def right_value = read(right)
  unless bits_type(left_value.type) && bits_type(right_value.type)
  | error(~who: #'add_expanding, "expanding arithmetic operands must be Bits")
  def result_width:
    if left_value.type.width > right_value.type.width
    | left_value.type.width + 1
    | right_value.type.width + 1
  def (wide_left, wide_right) = widen_unsigned_operands(left_value,
                                                        right_value,
                                                        result_width)
  hw_add(wide_left, wide_right, name)

fun mul_expanding(left :: HardwareEntity,
                  right :: HardwareEntity,
                  name :: False || AsciiIdentifier = #false) :~ HardwareFields:
  def left_value = read(left)
  def right_value = read(right)
  def unsigned_operands = bits_type(left_value.type) && bits_type(right_value.type)
  def signed_operands = signed_arithmetic_type(left_value.type) && signed_arithmetic_type(right_value.type)
  unless unsigned_operands || signed_operands
  | error(~who: #'mul_expanding,
          "expanding multiplication operands must both be Bits or signed arithmetic values")
  def result_width = scalar_width(left_value.type) + scalar_width(right_value.type)
  def (wide_left, wide_right):
    if unsigned_operands
    | block:
        widen_unsigned_operands(left_value, right_value, result_width)
    | block:
        def left_result_type = left_value.type.with_bit_width(result_width)
        def right_result_type = right_value.type.with_bit_width(result_width)
        unless type_equal(left_result_type, right_result_type)
        | error(~who: #'mul_expanding,
                "signed expanding multiplication operands must have compatible signed arithmetic types")
        widen_signed_operands(left_value, right_value, result_width)
  hw_mul(wide_left, wide_right, name)

operator (left +& right) :~ HardwareFields:
  ~order: addition
  if left is_a HardwareEntity || right is_a HardwareEntity
  | add_expanding(left, right)
  | left rhombus.(+&) right

operator (left *& right) :~ HardwareFields:
  ~order: multiplication
  if left is_a HardwareEntity || right is_a HardwareEntity
  | mul_expanding(left, right)
  | left rhombus.(*) right
