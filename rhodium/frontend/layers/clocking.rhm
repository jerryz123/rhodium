#lang rhombus
/* Records timing declarations for compile targets and authors verified sync-level evidence. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../../core/ir.rhm" open
  "../../analysis/clocking/types.rhm" open
  "../../analysis/clocking/declarations.rhm".declare_clocking_environment
  "../kernel.rhm" as kernel
  "../support/clocking.rhm".ambient_clock

export:
  sync_level_crossing
  synchronous_input
  asynchronous_input
  unknown_input_timing
  identical_clocks
  derived_clock
  asynchronous_clocks
  exclusive_clocks

/* Require a structural declaration in an active module, outside hardware conditionals. */
fun prepare_declaration(kind :: String):
  kernel.reject_unsupported_conditional_effect(
    kind,
    Location(),
    "declare timing intent structurally at the top circuit"
  )
  kernel.active_module()

/* Accept only a readable value reference; timing declarations do not synthesize reads. */
fun declaration_value(entity :: HardwareEntity, role :: String):
  unless entity is_a Value
  | kernel.frontend_fail(role ++ " must reference a readable hardware value")
  entity

/* Attach a top-input timing fragment for later target validation and analysis. */
fun add_input_contract(input :: HardwareEntity,
                       path :: List,
                       timing :: UnknownInputTiming || SynchronousInputTiming || AsynchronousInputTiming):
  def module_def = prepare_declaration("input timing declaration")
  declare_clocking_environment(module_def, TemporalEnvironment([TopInputContract(declaration_value(input, "input timing declaration"), path, timing)]))

/* Declare that an input leaf is synchronous to the supplied readable clock. */
fun synchronous_input(input :: HardwareEntity,
                      clock :: HardwareEntity,
                      path :: List = []):
  add_input_contract(input,
                     path,
                     SynchronousInputTiming(declaration_value(clock,
                                                              "synchronous input clock")))

/* Mark an input leaf as explicitly asynchronous to the design clocks. */
fun asynchronous_input(input :: HardwareEntity, path :: List = []):
  add_input_contract(input, path, AsynchronousInputTiming())

/* Record that an input leaf has no known timing provenance, without assuming safety. */
fun unknown_input_timing(input :: HardwareEntity, path :: List = []):
  add_input_contract(input, path, UnknownInputTiming())

/* Attach one structural relationship without running clock analysis during elaboration. */
fun add_clock_relationship(kind :: String,
                           make_relationship :: Function.of_arity(0)):
  def module_def = prepare_declaration(kind)
  declare_clocking_environment(module_def, TemporalEnvironment([], [make_relationship()]))

/* Declare two readable clock references to denote the same timing domain. */
fun identical_clocks(left :: HardwareEntity, right :: HardwareEntity):
  add_clock_relationship(
    "clock relationship declaration",
    fun (): IdenticalClockRelationship(declaration_value(left, "clock relationship"),
                                       declaration_value(right, "clock relationship"))
  )

/* Record a described derivation from source clock to destination clock. */
fun derived_clock(source :: HardwareEntity,
                  destination :: HardwareEntity,
                  description :: String):
  add_clock_relationship(
    "clock relationship declaration",
    fun (): DerivedClockRelationship(declaration_value(source, "clock relationship"),
                                     declaration_value(destination, "clock relationship"),
                                     description)
  )

/* Declare two clocks unrelated for synchronous transfer reasoning. */
fun asynchronous_clocks(left :: HardwareEntity, right :: HardwareEntity):
  add_clock_relationship(
    "clock relationship declaration",
    fun (): AsynchronousClockRelationship(declaration_value(left, "clock relationship"),
                                          declaration_value(right, "clock relationship"))
  )

/* Record the author's described mutual-exclusion relationship between two clocks. */
fun exclusive_clocks(left :: HardwareEntity,
                     right :: HardwareEntity,
                     description :: String):
  add_clock_relationship(
    "clock relationship declaration",
    fun (): ExclusiveClockRelationship(declaration_value(left, "clock relationship"),
                                       declaration_value(right, "clock relationship"),
                                       description)
  )

/* Attach inspectable register-chain evidence using an explicit or ambient destination
   clock. Core verification, not this authoring hook, proves the crossing shape. */
fun sync_level_crossing(source :: HardwareEntity,
                        destination_clock_or_stages :: HardwareEntity || List.of(HardwareEntity),
                        explicit_stages :: maybe(List.of(HardwareEntity)) = #false):
  kernel.reject_unsupported_conditional_effect(
    "sync-level crossing evidence",
    Location(),
    "declare crossing evidence structurally after driving its register chain"
  )
  if explicit_stages
  | kernel.sync_level_crossing(source,
                               destination_clock_or_stages,
                               explicit_stages)
  | kernel.sync_level_crossing(source,
                               ambient_clock(),
                               destination_clock_or_stages)
