#lang rhombus/and_meta
// Defines explicit procedure calls and binding-derived DPI register syntax.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/meta open
  "../../../support/annotations.rhm" open
  "../../core/ir.rhm" open
  "../kernel.rhm" as kernel
  "../support/clocking.rhm".ambient_dpi_call
  "../support/clocking.rhm".ambient_dpi_register
  "../support/clocking.rhm".ambient_dpi_register_results
  "../support/clocking.rhm".reject_explicit_sync_control
  "../support/fields.rhm".HardwareFields

export:
  dpi_import
  dpi_reg

class DpiDefinition(name :: AsciiIdentifier,
                    input_names :: List.of(AsciiIdentifier),
                    input_types :: List.of(DataType),
                    results :: List.of(DpiResult) = []):
  method has_result():
    results.length() != 0

fun materialize_import(definition :: DpiDefinition):
  kernel.dpi_import_results(definition.name,
                            definition.input_names,
                            definition.input_types,
                            definition.results)

fun resolved_enable(enable :: False || HardwareEntity):
  if enable | enable | kernel.literal(Bits(1), 1)

fun call_dpi_procedure(procedure :: DpiDefinition,
                       inputs :: List.of(HardwareEntity),
                       clock :: False || HardwareEntity = #false,
                       enable :: False || HardwareEntity = #false):
  when clock
  | reject_explicit_sync_control()
  unless !procedure.has_result()
  | error(~who: #'dpi_import, "DPI .call requires a procedure import")
  def imported = materialize_import(procedure)
  def enabled = resolved_enable(enable)
  if clock
  | kernel.dpi_call(imported, inputs, clock, enabled)
  | ambient_dpi_call(imported, inputs, enabled)

fun make_dpi_register(name :: AsciiIdentifier,
                      function :: DpiDefinition,
                      inputs :: List.of(HardwareEntity),
                      clock :: False || HardwareEntity = #false,
                      enable :: False || HardwareEntity = #false) :~ HardwareFields:
  when clock
  | reject_explicit_sync_control()
  unless function.has_result()
  | error(~who: #'dpi_reg, "dpi_reg requires a result-bearing function import")
  unless function.results.length() == 1
  | error(~who: #'dpi_reg,
          "a single dpi_reg binding requires exactly one function result")
  def imported = materialize_import(function)
  def enabled = resolved_enable(enable)
  if clock
  | kernel.dpi_register(name, imported, inputs, clock, enabled)
  | ambient_dpi_register(name, imported, inputs, enabled)

fun make_dpi_registers(result_names :: NonemptyList.of(AsciiIdentifier),
                       function :: DpiDefinition,
                       inputs :: List.of(HardwareEntity),
                       clock :: False || HardwareEntity = #false,
                       enable :: False || HardwareEntity = #false):
  when clock
  | reject_explicit_sync_control()
  unless function.results.length() > 1
  | error(~who: #'dpi_reg,
          "parenthesized dpi_reg bindings require multiple function results")
  unless result_names.length() == function.results.length()
  | error(~who: #'dpi_reg,
          "DPI result binding count must match the function result count")
  def imported = materialize_import(function)
  def enabled = resolved_enable(enable)
  if clock
  | kernel.dpi_register_results(result_names, imported, inputs, clock, enabled)
  | ambient_dpi_register_results(result_names, imported, inputs, enabled)

fun find_dpi_register_result(result_values :: List.of(Value),
                             name :: AsciiIdentifier) :~ HardwareFields:
  result_values.find(fun (result_value): result_value.name == name)

fun declare_dpi_register(name :: AsciiIdentifier,
                         function :: DpiDefinition,
                         ~clock: clock :: False || HardwareEntity = #false,
                         ~enable: enable :: False || HardwareEntity = #false,
                         & inputs :: List.of(HardwareEntity)) :~ HardwareFields:
  make_dpi_register(name, function, inputs, clock, enable)

fun declare_dpi_registers(result_names :: NonemptyList.of(AsciiIdentifier),
                          function :: DpiDefinition,
                          ~clock: clock :: False || HardwareEntity = #false,
                          ~enable: enable :: False || HardwareEntity = #false,
                          & inputs :: List.of(HardwareEntity)):
  make_dpi_registers(result_names, function, inputs, clock, enable)

annot.macro 'DpiProcedureFields':
  annot_meta.pack_predicate(
    'fun (value): value is_a DpiDefinition && !value.has_result()',
    '(($(statinfo_meta.dot_provider_key), dpi_procedure_dot))'
  )

dot.macro 'dpi_procedure_dot $left $dot $right':
  match right
  | 'call':
      'fun
       | (& inputs):
           call_dpi_procedure($left, inputs)
       | (~enable: enable, & inputs):
           call_dpi_procedure($left, inputs, #false, enable)
       | (~clock: clock, & inputs):
           call_dpi_procedure($left, inputs, clock)
       | (~clock: clock, ~enable: enable, & inputs):
           call_dpi_procedure($left, inputs, clock, enable)'
  | ~else: #false

defn.macro
| 'dpi_import procedure $(name :: Identifier)($argument_name: $argument_type, ...)':
    def import_name = name.to_source_string()
    let [input_name, ...] = [argument_name.to_source_string(), ...]
    'def $name :: DpiProcedureFields = DpiDefinition(
        $import_name,
        [$input_name, ...],
        [$argument_type, ...],
        []
      )'
| 'dpi_import function $(name :: Identifier)($argument_name: $argument_type, ...) -> $(result_name :: Identifier): $result_type':
    def import_name = name.to_source_string()
    def output_name = result_name.to_source_string()
    let [input_name, ...] = [argument_name.to_source_string(), ...]
    'def $name = DpiDefinition(
        $import_name,
        [$input_name, ...],
        [$argument_type, ...],
        [DpiResult($output_name, $result_type, "return")]
      )'
| 'dpi_import function $(name :: Identifier)($argument_name: $argument_type, ...) -> ($(result_direction :: Identifier) $(result_name :: Identifier): $result_type, ...)':
    def import_name = name.to_source_string()
    let [input_name, ...] = [argument_name.to_source_string(), ...]
    let [output_name, ...] = [result_name.to_source_string(), ...]
    let [direction_name, ...] = [result_direction.to_source_string(), ...]
    'def $name = DpiDefinition(
        $import_name,
        [$input_name, ...],
        [$argument_type, ...],
        [DpiResult($output_name, $result_type, $direction_name), ...]
      )'

defn.macro
| 'dpi_reg ($(name :: Identifier), ...) = $function($argument, ...)':
    let [register_name, ...] = [name.to_source_string(), ...]
    '«
       def result_values = declare_dpi_registers(
         [$register_name, ...], $function, $argument, ...
       )
       def $name :: HardwareFields = find_dpi_register_result(result_values, $register_name)
       ...
     »'
| 'dpi_reg $(name :: Identifier) = $function($argument, ...)':
    def register_name = name.to_source_string()
    'def $name :: HardwareFields = declare_dpi_register(
        $register_name, $function, $argument, ...
      )'
