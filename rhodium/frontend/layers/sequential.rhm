#lang rhombus/and_meta
// Defines explicit and sync-domain ambient binding-derived register syntax.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/meta open
  "../../core/types.rhm" open
  "../kernel.rhm" as kernel
  "../kernel.rhm".reg as kernel_reg
  "../support/clocking.rhm".ambient_register
  "../support/clocking.rhm".ambient_reset_register
  "../support/clocking.rhm".reject_explicit_sync_control
  "../support/fields.rhm".HardwareFields

export:
  reg

fun register_form_error():
  error(
    ~who: #'reg,
    String.append(
      "expected a type or ~next value, with optional synchronous-reset ",
      "initialization and either an ambient or explicit clock"
    )
  )

fun declare_register(name :: String,
                     type :: False || DataType = #false,
                     ~next: next :: False || HardwareFields = #false,
                     ~clock: clock :: False || HardwareFields.of(Clock) = #false,
                     ~reset: reset :: False || HardwareFields.of(Reset) = #false,
                     ~init: init :: False || HardwareFields = #false):
  when clock || reset
  | reject_explicit_sync_control()
  when type && next
  | register_form_error()
  unless type || next || init
  | register_form_error()
  when reset && !clock
  | register_form_error()
  when clock && ((reset && !init) || (!reset && init))
  | register_form_error()
  def next_value = if next | kernel.read(next) | #false
  def init_value = if init | kernel.read(init) | #false
  def state_type:
    cond
    | type: type
    | next_value: next_value.type
    | ~else: init_value.type
  def register:
    if clock
    | kernel_reg(name, state_type, clock, reset, init_value)
    | if init_value
      | ambient_reset_register(name, state_type, init_value)
      | ambient_register(name, state_type)
  when next_value
  | kernel.connect(register.next, next_value)
  register

defn.macro
| 'reg $(name :: Identifier)(~init: $(initial :: expr_meta.Parsed), $argument, ...)':
    def register_name = name.to_source_string()
    match initial.group
    | '$(type_name :: Identifier) $dot $(member :: Identifier)' when dot.to_source_string() == ".":
        'def $name :: HardwareFields.from_type($type_name) = declare_register(
           $register_name,
           ~init: $initial,
           $argument,
           ...
         )'
    | ~else:
        'def $name :: HardwareFields = declare_register(
           $register_name,
           ~init: $initial,
           $argument,
           ...
         )'
| 'reg $(name :: Identifier)(~next: $(next_value :: expr_meta.Parsed), $argument, ...)':
    def register_name = name.to_source_string()
    match next_value.group
    | '$(type_name :: Identifier) $dot $(member :: Identifier)' when dot.to_source_string() == ".":
        'def $name :: HardwareFields.from_type($type_name) = declare_register(
           $register_name,
           ~next: $next_value,
           $argument,
           ...
         )'
    | ~else:
        'def $name :: HardwareFields = declare_register(
           $register_name,
           ~next: $next_value,
           $argument,
           ...
         )'
| 'reg $(name :: Identifier)(~clock: $clock, $argument, ...)':
    def register_name = name.to_source_string()
    'def $name :: HardwareFields = declare_register($register_name, ~clock: $clock, $argument, ...)'
| 'reg $(name :: Identifier)(~reset: $reset, $argument, ...)':
    def register_name = name.to_source_string()
    'def $name :: HardwareFields = declare_register($register_name, ~reset: $reset, $argument, ...)'
| 'reg $(name :: Identifier)($(type :: expr_meta.Parsed), $argument, ...)':
    def register_name = name.to_source_string()
    'def $name :: HardwareFields.from_type($type) = declare_register($register_name, $type, $argument, ...)'
| 'reg $(name :: Identifier)($argument, ...)':
    def register_name = name.to_source_string()
    'def $name :: HardwareFields = declare_register($register_name, $argument, ...)'
