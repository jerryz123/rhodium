#lang rhombus/and_meta
// Defines the concise fixed-length vector type and construction frontend layer.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus.bits.(<<) as <<
  rhombus/meta open
  "../../core/types.rhm" open
  "../kernel.rhm" as kernel
  "../support/fields.rhm".HardwareFields
  "../support/hardware-literal.rhm" open

export:
  Vec
  VectorType
  VectorLiteral
  vec

fun build_vector_type(length :: PosInt, element_type :: DataType):
  VectorType(length, element_type)

annot.macro 'VectorFields($expected_type, $(element_type :: expr_meta.Parsed))':
  let '$(base :: annot_meta.Parsed)' = 'HardwareFields.of($expected_type)'
  let '$(element :: annot_meta.Parsed)' = 'HardwareFields.from_type($element_type)'
  def (predicate, base_infos) = annot_meta.unpack_predicate(base)
  def (_element_predicate, element_infos) = annot_meta.unpack_predicate(element)
  def result_infos = statinfo_meta.and(
    base_infos,
    '(($(statinfo_meta.index_result_key),
       $(statinfo_meta.pack_index_result(element_infos, []))))'
  )
  annot_meta.pack_predicate(predicate, result_infos)

annot.macro 'VectorTypeDescriptor':
  annot_meta.pack_predicate('fun (value): value is_a VectorType')

annot.macro 'VectorElementFields($(element :: expr_meta.Parsed))':
  let '$(base :: annot_meta.Parsed)' = 'HardwareFields'
  def (predicate, base_infos) = annot_meta.unpack_predicate(base)
  def element_infos = statinfo_meta.gather(element)
  def result_infos = statinfo_meta.and(
    base_infos,
    '(($(statinfo_meta.index_result_key),
       $(statinfo_meta.pack_index_result(element_infos, []))))'
  )
  annot_meta.pack_predicate(predicate, result_infos)

annot.macro 'Vec($length, $element_type)':
  'HardwareFields.of(build_vector_type($length, $element_type))'

expr.macro 'Vec($(length :: expr_meta.Parsed), $(element_type :: expr_meta.Parsed))':
  'build_vector_type($length, $element_type) :: HardwareFields.describes(
     VectorTypeDescriptor,
     VectorFields(build_vector_type($length, $element_type), $element_type)
   )'

// Vector element zero occupies the least-significant element-width bits, so
// recursive literal packing follows the same ordering as core VectorType casts.
class VectorLiteral(type :: VectorType, elements :: List):
  implements HardwareLiteral
  constructor (type :: VectorType, elements :: List):
    unless elements.length() == type.length
    | error(~who: #'vec, "literal element count must equal vector length")
    for (element in elements):
      def element_literal = require_hardware_literal(element, #'vec)
      unless type_equal(element_literal.literal_type(), type.element_type)
      | error(~who: #'vec, "literal elements must have exactly the same hardware type")
    super(type, elements)

  override method literal_type(): type

  override method packed_value():
    def element_width = type.element_type.packed_width()
    def mutable packed = 0
    for (element in elements, index in 0..elements.length()):
      packed := packed + (element.packed_value() << (index * element_width))
    packed

// Accepts direct elements or one host List, infers the uniform element type,
// and delegates construction to the typed elaboration kernel.
fun build_vec(entity :: HardwareFields || NonemptyList.of(HardwareFields), ...) :~ HardwareFields:
  def supplied = [entity, ...]
  def entities:
    if supplied.length() == 1 && supplied[0] is_a List
    | supplied[0]
    | supplied
  unless entities.length() >= 1
  | error(~who: #'vec, "vec requires at least one element")
  if for all (element in entities): element is_a HardwareLiteral
  | VectorLiteral(VectorType(entities.length(), entities[0].literal_type()),
                  entities)
  | block:
      def element_values = entities.map(kernel.read)
      kernel.vector_create(
        VectorType(element_values.length(), element_values[0].type),
        element_values
      )

// The first supplied element determines the vector's uniform static element
// surface, matching the runtime uniform-type inference in build_vec.
expr.macro
| 'vec($(entity :: expr_meta.Parsed), $next, $rest, ...)':
    'build_vec($entity, $next, $rest, ...) :: VectorElementFields($entity)'
| 'vec($entity)':
    'build_vec($entity) :: HardwareFields'
