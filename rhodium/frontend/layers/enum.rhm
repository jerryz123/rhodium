#lang rhombus/and_meta
// Defines hardware-enum declarations over shared nominal variant schemas.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/meta open
  "../../../support/annotations.rhm" open
  "../../core/ir.rhm" open
  "../kernel.rhm" as kernel
  "../support/fields.rhm".HardwareFields
  "../support/fields.rhm".hardware_value_type
  "../support/generator-parameters.rhm".GeneratorParameter
  "../support/hardware-methods.rhm".HardwareMethods
  "../support/one-hot-selection.rhm" as one_hot_selection
  "../support/variants.rhm" open

export:
  hardware_enum
  enum_type
  enum_width
  enum_members
  enum_encoding

fun make_automatic_enum(name :: AsciiIdentifier,
                        member_names :: NonemptyList.of(AsciiIdentifier),
                        requested_width :: False || PosInt = #false):
  enum_type_from_schema(
    make_automatic_variant_schema(
      name,
      VariantIdentity(),
      member_names.map(fun (member_name): [member_name, #false]),
      requested_width
    )
  )

fun make_explicit_enum(name :: AsciiIdentifier,
                       members :: NonemptyList.of(List),
                       requested_width :: False || PosInt = #false):
  enum_type_from_schema(
    make_explicit_variant_schema(
      name,
      VariantIdentity(),
      members.map(fun (member): [member[0], member[1], #false]),
      requested_width
    )
  )

fun make_one_hot_enum(name :: AsciiIdentifier,
                      member_names :: NonemptyList.of(AsciiIdentifier)):
  enum_type_from_schema(
    make_one_hot_variant_schema(
      name,
      VariantIdentity(),
      member_names.map(fun (member_name): [member_name, #false])
    )
  )

fun hardware_has_one_hot_enum_type(value :: HardwareEntity):
  hardware_value_type(value) is_a OneHotEnumType

meta:
  fun one_hot_enum_mux_result(result :: Syntax, cases :: Syntax):
    match cases.group
    | '{$(_key :: expr_meta.Parsed): $(first :: Block), $rest, ...}':
        match first
        | ': $(first_expr :: expr_meta.Parsed)':
            match first_expr.group
            | '$(type_name :: Identifier) $dot $(member :: Identifier)' when dot.to_source_string() == ".":
                '$result :: HardwareFields.from_type($type_name)'
            | ~else:
                statinfo_meta.wrap(result, statinfo_meta.gather(first_expr))
        | ~else: result
    | ~else: result

dot.macro 'one_hot_enum_value_dot $left $dot $right':
  ~tail: '$tail ...'
  match '$right $tail ...'
  | 'mux($(cases :: expr_meta.Parsed)) $rest ...':
      values(
        one_hot_enum_mux_result(
          'one_hot_selection.build_keyed_one_hot_mux($left, $cases)',
          cases
        ),
        '$rest ...'
      )
  | 'mux $rest ...':
      syntax_meta.error(
        "one-hot enum .mux expects one typed-key map",
        right
      )
  | ~else: #false

annot.macro 'OneHotEnumValue':
  annot_meta.pack_predicate(
    'fun (value): value is_a HardwareEntity && hardware_has_one_hot_enum_type(value)',
    '(($(statinfo_meta.dot_provider_key), one_hot_enum_value_dot))'
  )

annot.macro
| 'EnumHardwareFields($type, one_hot)':
    'HardwareFields.of($type) && OneHotEnumValue'
| 'EnumHardwareFields($type, ordinary)':
    'HardwareFields.of($type)'

annot.macro 'EnumMembers':
  annot_meta.pack_predicate(
    'fun (value): value is_a HardwareType && enum_type(value)',
    '(($(statinfo_meta.dot_provider_key), enum_member_dot))'
  )

dot.macro 'enum_member_dot $left $dot $right':
  'enum_value($left, $(right.to_source_string())) :: HardwareFields'

meta:
  // Builds all enum encodings through one declaration path so methods have
  // identical behavior on automatic, explicit, fixed-width, and one-hot forms.
  fun expand_hardware_enum(name :: Syntax, options :: List, clauses :: List):
    def enum_name = name.to_source_string()
    def mutable requested_width = #false
    def mutable one_hot = #false
    for (option in options):
      match option
      | '~width: $width':
          when requested_width
          | syntax_meta.error("duplicate ~width option", option)
          requested_width := width
      | '~encoding: one_hot':
          when one_hot
          | syntax_meta.error("duplicate ~encoding option", option)
          one_hot := #true
      | ~else:
          syntax_meta.error("expected ~width or ~encoding: one_hot", option)

    def mutable members = []
    def mutable encodings = []
    def mutable explicit = #false
    def mutable automatic = #false
    def mutable method_names = []
    def mutable method_entries = []
    def mutable method_definitions = []
    for (clause in clauses):
      match clause
      | '$(member :: Identifier)':
          when explicit
          | syntax_meta.error("cannot mix automatic and explicit enum members", clause)
          automatic := #true
          members := members ++ [member]
      | '$(member :: Identifier) = $encoding':
          when automatic
          | syntax_meta.error("cannot mix automatic and explicit enum members", clause)
          explicit := #true
          members := members ++ [member]
          encodings := encodings ++ [encoding]
      | 'method $(method_name :: Identifier)($(receiver :: Identifier), $(argument :: GeneratorParameter), ...) :: $(result_constructor :: Identifier)($result_argument, ...):
           $method_body; ...':
          when one_hot && method_name.to_source_string() == "mux"
          | syntax_meta.error("mux is reserved for one-hot enum selection", method_name)
          when method_names.find(fun (declared): declared == method_name.to_source_string())
          | syntax_meta.error("enum method names must be unique", method_name)
          method_names := method_names ++ [method_name.to_source_string()]
          def method_function = Syntax.make_id(
            enum_name ++ "_" ++ method_name.to_source_string(),
            method_name
          )
          let [argument_binding, ...] = [argument.binding, ...]
          method_entries := method_entries ++ [
            '($method_name, $method_function, ($argument_binding, ...),
              (typed ($result_constructor($result_argument, ...))))'
          ]
          method_definitions := method_definitions ++ [
            'fun $method_function($receiver :: $name, $argument, ...) :: $result_constructor($result_argument, ...):
               $method_body
               ...'
          ]
      | 'method $(method_name :: Identifier)($(receiver :: Identifier), $(argument :: GeneratorParameter), ...) :: $(result_type :: Identifier):
           $method_body; ...':
          when one_hot && method_name.to_source_string() == "mux"
          | syntax_meta.error("mux is reserved for one-hot enum selection", method_name)
          when method_names.find(fun (declared): declared == method_name.to_source_string())
          | syntax_meta.error("enum method names must be unique", method_name)
          method_names := method_names ++ [method_name.to_source_string()]
          def method_function = Syntax.make_id(
            enum_name ++ "_" ++ method_name.to_source_string(),
            method_name
          )
          let [argument_binding, ...] = [argument.binding, ...]
          method_entries := method_entries ++ [
            '($method_name, $method_function, ($argument_binding, ...), (typed ($result_type)))'
          ]
          method_definitions := method_definitions ++ [
            'fun $method_function($receiver :: $name, $argument, ...) :: $result_type:
               $method_body
               ...'
          ]
      | 'method $(method_name :: Identifier)($(receiver :: Identifier), $(argument :: GeneratorParameter), ...):
           $method_body; ...':
          when one_hot && method_name.to_source_string() == "mux"
          | syntax_meta.error("mux is reserved for one-hot enum selection", method_name)
          when method_names.find(fun (declared): declared == method_name.to_source_string())
          | syntax_meta.error("enum method names must be unique", method_name)
          method_names := method_names ++ [method_name.to_source_string()]
          def method_function = Syntax.make_id(
            enum_name ++ "_" ++ method_name.to_source_string(),
            method_name
          )
          let [argument_binding, ...] = [argument.binding, ...]
          method_entries := method_entries ++ [
            '($method_name, $method_function, ($argument_binding, ...), untyped)'
          ]
          method_definitions := method_definitions ++ [
            'fun $method_function($receiver :: $name, $argument, ...) :~ HardwareFields:
               $method_body
               ...'
          ]
      | ~else:
          syntax_meta.error("expected an enum member or method declaration", clause)

    when members.length() == 0
    | syntax_meta.error("hardware enum requires at least one member", name)
    when one_hot && explicit
    | syntax_meta.error("one-hot enums use declaration-order encodings", name)
    when one_hot && requested_width
    | syntax_meta.error("one-hot enum width is determined by its members", name)

    let [member_name, ...] = members.map(fun (member): member.to_source_string())
    let [encoding, ...] = encodings
    let [method_entry, ...] = method_entries
    let [method_definition, ...] = method_definitions
    def member_dot = Syntax.make_id(enum_name ++ "_member_dot", name)
    def member_annotation = Syntax.make_id(enum_name ++ "_members", name)
    def method_annotation = Syntax.make_id(enum_name ++ "_value_methods", name)
    def enum_value_kind = if one_hot | 'one_hot' | 'ordinary'
    def constructor:
      cond
      | one_hot:
          'make_one_hot_enum($enum_name, [$member_name, ...])'
      | explicit && requested_width:
          'make_explicit_enum($enum_name,
                              [[$member_name, $encoding], ...],
                              $requested_width)'
      | explicit:
          'make_explicit_enum($enum_name,
                              [[$member_name, $encoding], ...])'
      | requested_width:
          'make_automatic_enum($enum_name,
                               [$member_name, ...],
                               $requested_width)'
      | ~else:
          'make_automatic_enum($enum_name, [$member_name, ...])'
    if method_entries.length() > 0
    | '«
         annot.macro '$method_annotation':
           'HardwareMethods(EnumHardwareFields($name, $enum_value_kind),
                            $method_entry, ...)'
         annot.macro '$name':
           '$method_annotation'
         dot.macro '$member_dot $('$')left $('$')dot $('$')right':
           if [$member_name, ...].contains(right.to_source_string())
           | 'enum_value($('$')left, $('$')(right.to_source_string())) :: $name'
           | if ["name", "identity", "members", "width",
                 "packed_width", "enum_encodings", "member", "describe"].contains(
                  right.to_source_string()
                )
             | #false
             | 'enum_value($('$')left, $('$')(right.to_source_string())) :: $name'
         annot.macro '$member_annotation':
           annot_meta.pack_predicate(
             'fun (value): value is_a HardwareType && enum_type(value)',
             '(($(statinfo_meta.dot_provider_key), $member_dot))'
           )
         def $name :: HardwareFields.describes($member_annotation, $name) = $constructor
         $method_definition
         ...
       »'
    | '«
         annot.macro '$name':
           'EnumHardwareFields($name, $enum_value_kind)'
         dot.macro '$member_dot $('$')left $('$')dot $('$')right':
           if [$member_name, ...].contains(right.to_source_string())
           | 'enum_value($('$')left, $('$')(right.to_source_string())) :: $name'
           | if ["name", "identity", "members", "width",
                 "packed_width", "enum_encodings", "member", "describe"].contains(
                  right.to_source_string()
                )
             | #false
             | 'enum_value($('$')left, $('$')(right.to_source_string())) :: $name'
         annot.macro '$member_annotation':
           annot_meta.pack_predicate(
             'fun (value): value is_a HardwareType && enum_type(value)',
             '(($(statinfo_meta.dot_provider_key), $member_dot))'
           )
         def $name :: HardwareFields.describes($member_annotation, $name) = $constructor
       »'

defn.macro
| 'hardware_enum $(name :: Identifier): $clause; ...':
    expand_hardware_enum(name, [], [clause, ...])
| 'hardware_enum $(name :: Identifier)($option, ...): $clause; ...':
    expand_hardware_enum(name, [option, ...], [clause, ...])
