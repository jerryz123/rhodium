#lang rhombus/and_meta
// Defines lane masks, optional-one-hot values, reductions, encoders, comparisons, and selection.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus.bits.(<<) as <<
  rhombus.bits.(?) as ?
  "../../core/ir.rhm" open
  "../../core/types.rhm".count_index_width
  "../../core/types.rhm".signed_arithmetic_type
  "../kernel.rhm" as kernel
  "../support/finite-enum.rhm" as finite_enum_support
  "../support/fields.rhm".HardwareFields
  "../support/fields.rhm".Bool
  "../support/fields.rhm".bool_type
  "../support/fields.rhm".hardware_as_bits
  "../support/fields.rhm".hardware_value_type
  "../support/hardware-literal.rhm".packed_literal
  "../support/mask-type.rhm" as mask_support
  "../support/one-hot-selection.rhm" as one_hot_selection

export:
  Bool
  bool_type
  Mask
  mask_type
  mask_width
  MaybeOneHot
  maybe_one_hot_type
  maybe_one_hot_width
  bool_eq
  bool_ne
  or_reduce
  and_reduce
  popcount
  priority_encoder
  priority_encoder_oh
  enum_valid
  unsigned_lt
  signed_lt
  unsigned_gt
  unsigned_le
  unsigned_ge
  mux
  ===
  =/=
  <
  >
  <=
  >=

// Represents an arbitrary set of fixed lanes. Every packed encoding is legal,
// so bitwise set operations preserve the type while arithmetic and shifting do not.
class _MaskType(width :: PosInt):
  implements BitwiseType
  implements Callable
  implements mask_support.MaskType

  override method describe():
    "mask<" ++ to_string(width) ++ ">"

  override method type_equal(other :: HardwareType):
    mask_type(other) && width == other.width

  override method packed_width():
    width

  override method mask_width():
    width

  // Host literals name a packed lane set, not a lane index.
  override method call(value :: Nat):
    packed_literal(this, value)

fun build_mask_type(width :: PosInt):
  _MaskType(width)

fun mask_type(type :: HardwareType):
  type is_a _MaskType

fun mask_width(type :: HardwareType):
  unless mask_type(type)
  | error(~who: #'mask_width, "expected a Mask type")
  type.width

fun hardware_has_mask_type(value :: HardwareEntity):
  mask_type(hardware_value_type(value))

fun mask_index(value :: HardwareEntity, index :: Nat) :~ HardwareFields:
  def lanes = kernel.read(value)
  unless mask_type(lanes.type)
  | error(~who: #'Mask, "expected a Mask value")
  def packed = hardware_as_bits(lanes,
                                #'Mask,
                                "Mask value",
                                #false,
                                Location())
  kernel.cast(kernel.index(packed, index), Bool)

annot.macro 'MaskValue':
  let '$(base :: annot_meta.Parsed)' = 'HardwareFields'
  let '$(bool_fields :: annot_meta.Parsed)' = 'HardwareFields.of(Bool)'
  def (_base_predicate, base_infos) = annot_meta.unpack_predicate(base)
  def (_bool_predicate, bool_infos) = annot_meta.unpack_predicate(bool_fields)
  def result_infos = statinfo_meta.and(
    '(($(statinfo_meta.index_get_key), mask_index),
      ($(statinfo_meta.index_result_key),
       $(statinfo_meta.pack_index_result(bool_infos, []))))',
    base_infos
  )
  annot_meta.pack_predicate(
    'fun (value): value is_a HardwareEntity && hardware_has_mask_type(value)',
    result_infos
  )

annot.macro 'MaskTypeDescriptor':
  annot_meta.pack_predicate(
    'fun (value): value is_a HardwareType && mask_type(value)'
  )

annot.macro 'Mask($width)':
  let '$(base :: annot_meta.Parsed)' = 'HardwareFields.of(build_mask_type($width))'
  let '$(bool_fields :: annot_meta.Parsed)' = 'HardwareFields.of(Bool)'
  def (predicate, base_infos) = annot_meta.unpack_predicate(base)
  def (_bool_predicate, bool_infos) = annot_meta.unpack_predicate(bool_fields)
  def result_infos = statinfo_meta.and(
    '(($(statinfo_meta.index_get_key), mask_index),
      ($(statinfo_meta.index_result_key),
       $(statinfo_meta.pack_index_result(bool_infos, []))))',
    base_infos
  )
  annot_meta.pack_predicate(
    predicate,
    result_infos
  )

expr.macro 'Mask($(width :: expr_meta.Parsed))':
  'build_mask_type($width) :: HardwareFields.describes(
     MaskTypeDescriptor,
     MaskValue
   )'

// Represents an absent selection as zero and a present selection as exactly
// one asserted bit. The refinement is intentionally distinct from OneHot:
// MaybeOneHot cannot directly satisfy a partial one-hot mux precondition.
class _MaybeOneHotType(width :: PosInt):
  implements ScalarDataType
  implements Callable
  implements one_hot_selection.MaybeOneHotSelectorType

  override method describe():
    "maybe-onehot<" ++ to_string(width) ++ ">"

  override method type_equal(other :: HardwareType):
    maybe_one_hot_type(other) && width == other.width

  override method packed_width():
    width

  override method maybe_one_hot_selector_width():
    width

  // No argument constructs absence; a host index constructs a present lane.
  override method call(index :: False || Nat = #false):
    if !index
    | packed_literal(this, 0)
    | block:
        unless index < width
        | error(~who: #'MaybeOneHot,
                "literal index must satisfy 0 <= index < width")
        packed_literal(this, 1 << index)

fun build_maybe_one_hot_type(width :: PosInt):
  _MaybeOneHotType(width)

fun maybe_one_hot_type(type :: HardwareType):
  type is_a _MaybeOneHotType

fun maybe_one_hot_width(type :: HardwareType):
  unless maybe_one_hot_type(type)
  | error(~who: #'maybe_one_hot_width, "expected a MaybeOneHot type")
  type.width

fun hardware_has_maybe_one_hot_type(value :: HardwareEntity):
  maybe_one_hot_type(hardware_value_type(value))

meta:
  fun maybe_one_hot_mux_result(result :: Syntax, choices :: Syntax):
    match choices.group
    | '[$(first :: expr_meta.Parsed), $rest, ...]':
        statinfo_meta.wrap(result, statinfo_meta.gather(first))
    | ~else: result

dot.macro 'maybe_one_hot_value_dot $left $dot $right':
  ~tail: '$tail ...'
  match '$right $tail ...'
  | 'mux($(choices :: expr_meta.Parsed),
         ~default: $(default_value :: expr_meta.Parsed)) $rest ...':
      values(
        maybe_one_hot_mux_result(
          'one_hot_selection.build_maybe_one_hot_mux($left, $choices, $default_value)',
          choices
        ),
        '$rest ...'
      )
  | 'mux($(choices :: expr_meta.Parsed)) $rest ...':
      values(
        maybe_one_hot_mux_result(
          'one_hot_selection.build_one_hot_mux($left, $choices)',
          choices
        ),
        '$rest ...'
      )
  | 'mux $rest ...':
      syntax_meta.error(
        "MaybeOneHot.mux expects a choice list and an explicit ~default",
        right
      )
  | ~else:
      def expansion:
        match right
        | 'valid': 'maybe_one_hot_valid($left) :: Bool'
        | 'index': 'maybe_one_hot_index_value($left) :: HardwareFields'
        | 'mask': 'fun (mask) :~ MaybeOneHotValue: maybe_one_hot_mask($left, mask)'
        | ~else: #false
      if expansion
      | values(expansion, '$tail ...')
      | #false

fun maybe_one_hot_index(value :: HardwareEntity,
                        index :: Nat) :~ HardwareFields:
  def selector = kernel.read(value)
  unless maybe_one_hot_type(selector.type)
  | error(~who: #'MaybeOneHot, "expected a MaybeOneHot value")
  def selector_bits = hardware_as_bits(selector,
                                       #'MaybeOneHot,
                                       "MaybeOneHot selector",
                                       #false,
                                       Location())
  kernel.cast(kernel.index(selector_bits, index), Bool)

annot.macro 'MaybeOneHotValue':
  let '$(base :: annot_meta.Parsed)' = 'HardwareFields'
  let '$(bool_fields :: annot_meta.Parsed)' = 'HardwareFields.of(Bool)'
  def (_base_predicate, base_infos) = annot_meta.unpack_predicate(base)
  def (_bool_predicate, bool_infos) = annot_meta.unpack_predicate(bool_fields)
  def result_infos = statinfo_meta.and(
    '(($(statinfo_meta.dot_provider_key), maybe_one_hot_value_dot),
      ($(statinfo_meta.index_get_key), maybe_one_hot_index),
      ($(statinfo_meta.index_result_key),
       $(statinfo_meta.pack_index_result(bool_infos, []))))',
    base_infos
  )
  annot_meta.pack_predicate(
    'fun (value): value is_a HardwareEntity && hardware_has_maybe_one_hot_type(value)',
    result_infos
  )

annot.macro 'MaybeOneHotTypeDescriptor':
  annot_meta.pack_predicate(
    'fun (value): value is_a HardwareType && maybe_one_hot_type(value)'
  )

annot.macro 'MaybeOneHot($width)':
  let '$(base :: annot_meta.Parsed)' = 'HardwareFields.of(build_maybe_one_hot_type($width))'
  let '$(bool_fields :: annot_meta.Parsed)' = 'HardwareFields.of(Bool)'
  def (predicate, base_infos) = annot_meta.unpack_predicate(base)
  def (_bool_predicate, bool_infos) = annot_meta.unpack_predicate(bool_fields)
  def result_infos = statinfo_meta.and(
    '(($(statinfo_meta.dot_provider_key), maybe_one_hot_value_dot),
      ($(statinfo_meta.index_get_key), maybe_one_hot_index),
      ($(statinfo_meta.index_result_key),
       $(statinfo_meta.pack_index_result(bool_infos, []))))',
    base_infos
  )
  annot_meta.pack_predicate(
    predicate,
    result_infos
  )

expr.macro 'MaybeOneHot($(width :: expr_meta.Parsed))':
  'build_maybe_one_hot_type($width) :: HardwareFields.describes(
     MaybeOneHotTypeDescriptor,
     MaybeOneHotValue
   )'

// Equality remains a Bits core operation. Frontend nominal flat types compare
// by explicitly exposing equal-width representations first.
fun equality_bits(left :: HardwareEntity,
                  right :: HardwareEntity,
                  who :: Symbol,
                  spelling :: String,
                  location :: Location):
  def left_value = kernel.read(left, location)
  def right_value = kernel.read(right, location)
  unless scalar_data_type(left_value.type) && scalar_data_type(right_value.type) && type_equal(left_value.type, right_value.type)
  | error(~who: who,
          location.describe() ++ ": " ++ spelling ++ " operands must have exactly the same ScalarDataType")
  def left_bits = hardware_as_bits(left_value, who, spelling ++ " operand", #false, location)
  def right_bits = hardware_as_bits(right_value, who, spelling ++ " operand", #false, location)
  kernel.hw_eq(left_bits, right_bits, #false, location)

fun bool_eq(left :: HardwareEntity,
            right :: HardwareEntity,
            name :: False || String = #false,
            location :: Location = Location()) :~ HardwareFields.of(Bool):
  kernel.cast(equality_bits(left, right, #'bool_eq, "===", location),
              Bool,
              name,
              location)

operator (left === right) :~ HardwareFields.of(Bool):
  bool_eq(left, right)

// Inequality is the Boolean complement of typed equality. Keeping one core
// equality operation preserves exactly the same nominal type contract.
fun bool_ne(left :: HardwareEntity,
            right :: HardwareEntity,
            name :: False || String = #false,
            location :: Location = Location()) :~ HardwareFields.of(Bool):
  def equal = kernel.cast(
    equality_bits(left, right, #'bool_ne, "=/=", location),
    Bool,
    #false,
    location
  )
  kernel.bit_not(equal, name, location)

// Packs a nonempty host list without introducing a zero-length hardware type.
fun packed_reduction_list(entities :: List.of(HardwareEntity),
                          who :: Symbol,
                          spelling :: String,
                          location :: Location):
  def packed_elements = for List (entity in entities):
    def value = kernel.read(entity, location)
    def width = value.type.packed_width()
    unless data_type(value.type) && width
    | error(~who: who,
            location.describe() ++ ": " ++ spelling ++ " list elements must have packable DataTypes")
    hardware_as_bits(value, who, spelling ++ " list element", #false, location)
  def packed:
    if packed_elements.length() == 1
    | packed_elements[0]
    | kernel.concat(packed_elements, #false, location)
  def mutable total_width = 0
  for (element in packed_elements):
    total_width := total_width + element.type.width
  values(packed, total_width)

// Validates and packs the common operand accepted by Boolean bit reductions.
fun packed_reduction_operand(entity :: HardwareEntity || List.of(HardwareEntity),
                             who :: Symbol,
                             spelling :: String,
                             location :: Location):
  if entity is_a List
  | packed_reduction_list(entity, who, spelling, location)
  | block:
      def value = kernel.read(entity, location)
      def width = value.type.packed_width()
      unless data_type(value.type) && width
      | error(~who: who,
              location.describe() ++ ": " ++ spelling ++ " operand must have a packable DataType")
      values(hardware_as_bits(value, who, spelling ++ " operand", #false, location), width)

fun reduction_identity(value :: Nat,
                       name :: False || String,
                       location :: Location):
  kernel.cast(kernel.literal(Bits(1), value, #false, location),
              Bool,
              name,
              location)

// Reduces the canonical packed representation of hardware data to whether any
// bit is asserted. Existing equality and inversion IR fully express the
// operation, so the frontend does not introduce a reduction-specific opcode.
fun or_reduce(entity :: HardwareEntity || List.of(HardwareEntity),
              name :: False || String = #false,
              location :: Location = Location()) :~ HardwareFields:
  if entity is_a List && entity.length() == 0
  | reduction_identity(0, name, location)
  | block:
      def (packed, width) = packed_reduction_operand(entity, #'or_reduce, "or_reduce", location)
      def equal_zero = kernel.cast(
        kernel.hw_eq(packed,
                     kernel.literal(Bits(width), 0, #false, location),
                     #false,
                     location),
        Bool,
        #false,
        location
      )
      kernel.bit_not(equal_zero, name, location)

// Reduces the canonical packed representation of hardware data to whether
// every bit is asserted. Equality with the packed all-ones value avoids a new
// core reduction operation.
fun and_reduce(entity :: HardwareEntity || List.of(HardwareEntity),
               name :: False || String = #false,
               location :: Location = Location()) :~ HardwareFields:
  if entity is_a List && entity.length() == 0
  | reduction_identity(1, name, location)
  | block:
      def (packed, width) = packed_reduction_operand(entity, #'and_reduce, "and_reduce", location)
      def all_ones = (1 << width) - 1
      kernel.cast(
        kernel.hw_eq(packed,
                     kernel.literal(Bits(width), all_ones, #false, location),
                     #false,
                     location),
        Bool,
        name,
        location
      )

class PopcountNode(value :: Value, capacity :: PosInt)

fun widen_popcount_node(node :: PopcountNode,
                        target_width :: PosInt,
                        location :: Location):
  if node.value.type.width == target_width
  | node.value
  | kernel.zext(node.value, target_width, #false, location)

// Each node carries the number of source bits beneath it, allowing every
// internal adder to use the minimum width that can represent its subtree sum.
fun merge_popcount_nodes(left :: PopcountNode,
                         right :: PopcountNode,
                         name :: False || String,
                         location :: Location) :: PopcountNode:
  def capacity = left.capacity + right.capacity
  def result_width = count_index_width(capacity + 1)
  PopcountNode(
    kernel.hw_add(widen_popcount_node(left, result_width, location),
                  widen_popcount_node(right, result_width, location),
                  name,
                  location),
    capacity
  )

fun reduce_popcount_nodes(nodes :: List,
                          name :: False || String,
                          location :: Location):
  if nodes.length() == 1
  | nodes[0].value
  | block:
      def mutable next_nodes = []
      def mutable remaining = nodes
      while remaining.length() >= 2:
        next_nodes := [
          merge_popcount_nodes(remaining[0],
                               remaining[1],
                               if nodes.length() == 2 | name | #false,
                               location)
        ] ++ next_nodes
        remaining := remaining.drop(2)
      when remaining.length() == 1
      | next_nodes := [remaining[0]] ++ next_nodes
      reduce_popcount_nodes(next_nodes.reverse(), name, location)

// Counts asserted bits in the canonical packed representation. Pairwise
// reduction gives logarithmic depth while capacity-aware widths avoid carrying
// impossible high bits through smaller subtrees.
fun popcount(entity :: HardwareEntity || List.of(HardwareEntity),
             name :: False || String = #false,
             location :: Location = Location()) :~ HardwareFields:
  if entity is_a List && entity.length() == 0
  | kernel.literal(Bits(1), 0, name, location)
  | block:
      def (packed, width) = packed_reduction_operand(entity, #'popcount, "popcount", location)
      def nodes = for List (index in 0..width):
        PopcountNode(
          kernel.extract(packed,
                         index,
                         index,
                         if width == 1 | name | #false,
                         location),
          1
        )
      reduce_popcount_nodes(nodes, name, location)

// Statically shifts a packed value toward higher-numbered bits without
// introducing a dynamic shifter into the core IR.
fun static_shift_left(value :: Value,
                      width :: PosInt,
                      amount :: PosInt,
                      location :: Location):
  if amount >= width
  | kernel.literal(Bits(width), 0, #false, location)
  | kernel.concat(
      [kernel.extract(value, width - amount - 1, 0, #false, location),
       kernel.literal(Bits(amount), 0, #false, location)],
      #false,
      location
    )

// Isolates the least-significant asserted bit using a logarithmic-depth
// parallel prefix OR network. An all-zero operand produces all zeroes.
fun packed_priority_encoder_oh(packed :: Value,
                               width :: PosInt,
                               name :: False || String,
                               location :: Location):
  def mutable prefix = packed
  def mutable distance = 1
  while distance < width:
    prefix := kernel.bit_or(
      prefix,
      static_shift_left(prefix, width, distance, location),
      #false,
      location
    )
    distance := distance * 2
  kernel.bit_and(
    packed,
    kernel.bit_not(
      static_shift_left(prefix, width, 1, location),
      #false,
      location
    ),
    name,
    location
  )

// Returns a native optional-one-hot value selecting the lowest asserted packed
// bit. The all-zero input maps to the distinguished absent representation.
fun build_priority_encoder_oh(entity :: HardwareEntity,
                              name :: False || String = #false,
                              location :: Location = Location()) :~ HardwareFields:
  when entity is_a List
  | error(~who: #'priority_encoder_oh,
          location.describe() ++ ": priority_encoder_oh operand must be one packable DataType")
  def value = kernel.read(entity, location)
  def width = value.type.packed_width()
  unless data_type(value.type) && width
  | error(~who: #'priority_encoder_oh,
          location.describe() ++ ": priority_encoder_oh operand must have a packable DataType")
  def packed = hardware_as_bits(
    value,
    #'priority_encoder_oh,
    "priority_encoder_oh operand",
    #false,
    location
  )
  kernel.cast(packed_priority_encoder_oh(packed, width, #false, location),
              build_maybe_one_hot_type(width),
              name,
              location)

expr.macro
| 'priority_encoder_oh($(entity :: expr_meta.Parsed))':
    'build_priority_encoder_oh($entity) :: MaybeOneHotValue'
| 'priority_encoder_oh($(entity :: expr_meta.Parsed),
                       $(name :: expr_meta.Parsed))':
    'build_priority_encoder_oh($entity, $name) :: MaybeOneHotValue'
| 'priority_encoder_oh($(entity :: expr_meta.Parsed),
                       $(name :: expr_meta.Parsed),
                       $(location :: expr_meta.Parsed))':
    'build_priority_encoder_oh($entity, $name, $location) :: MaybeOneHotValue'

fun require_maybe_one_hot(selector :: HardwareEntity,
                          who :: Symbol,
                          location :: Location):
  def value = kernel.read(selector, location)
  unless maybe_one_hot_type(value.type)
  | error(~who: who,
          location.describe() ++ ": selector must have a MaybeOneHot type")
  value

// Presence is encoded without a separate hardware bit and is therefore just
// the nonzero predicate over the compact selector representation.
fun maybe_one_hot_valid(selector :: HardwareEntity,
                        name :: False || String = #false,
                        location :: Location = Location()) :~ HardwareFields:
  def value = require_maybe_one_hot(selector, #'maybe_one_hot_valid, location)
  def width = value.type.width
  def equal_zero = kernel.hw_eq(
    hardware_as_bits(value,
                     #'maybe_one_hot_valid,
                     "MaybeOneHot selector",
                     #false,
                     location),
    kernel.literal(Bits(width), 0, #false, location),
    #false,
    location
  )
  kernel.cast(kernel.bit_not(equal_zero, #false, location),
              Bool,
              name,
              location)

// Masking can remove the selected lane but cannot create a second asserted
// lane, so the result remains a MaybeOneHot value of the same width.
fun maybe_one_hot_mask(selector :: HardwareEntity,
                       mask :: HardwareEntity,
                       name :: False || String = #false,
                       location :: Location = Location()) :~ HardwareFields:
  def value = require_maybe_one_hot(selector, #'maybe_one_hot_mask, location)
  def width = value.type.width
  def mask_value = kernel.read(mask, location)
  unless mask_value.type is_a mask_support.MaskType && mask_value.type.mask_width() == width
  | error(~who: #'maybe_one_hot_mask,
          location.describe() ++ ": mask must have a matching Mask type")
  def masked = kernel.bit_and(
    hardware_as_bits(value,
                     #'maybe_one_hot_mask,
                     "MaybeOneHot selector",
                     #false,
                     location),
    hardware_as_bits(mask_value,
                     #'maybe_one_hot_mask,
                     "MaybeOneHot mask",
                     #false,
                     location),
    #false,
    location
  )
  kernel.cast(masked, value.type, name, location)

fun priority_index_mask(width :: PosInt, result_bit :: Nat):
  def mutable mask = 0
  for (index in 0..width):
    when index ? result_bit
    | mask := mask + (1 << index)
  mask

// Encodes an already-isolated zero-or-one mask without rebuilding the priority
// network used for arbitrary packed operands.
fun packed_one_hot_index(selected :: Value,
                         width :: PosInt,
                         name :: False || String,
                         location :: Location):
  def result_width = count_index_width(width)
  def result_bits = for List (result_bit in 0..result_width):
    def selected_for_bit = kernel.bit_and(
      selected,
      kernel.literal(
        Bits(width),
        priority_index_mask(width, result_bit),
        #false,
        location
      ),
      #false,
      location
    )
    kernel.bit_not(
      kernel.hw_eq(
        selected_for_bit,
        kernel.literal(Bits(width), 0, #false, location),
        #false,
        location
      ),
      if result_width == 1 | name | #false,
      location
    )
  if result_width == 1
  | result_bits[0]
  | kernel.concat(result_bits.reverse(), name, location)

fun maybe_one_hot_index_value(selector :: HardwareEntity,
                              name :: False || String = #false,
                              location :: Location = Location()) :~ HardwareFields:
  def value = require_maybe_one_hot(selector, #'MaybeOneHot, location)
  def width = value.type.width
  packed_one_hot_index(
    hardware_as_bits(value,
                     #'MaybeOneHot,
                     "MaybeOneHot selector",
                     #false,
                     location),
    width,
    name,
    location
  )

// Encodes the lowest asserted packed bit. Zero input returns index zero; use
// or_reduce when the caller must distinguish that case from bit zero winning.
fun priority_encoder(entity :: HardwareEntity,
                     name :: False || String = #false,
                     location :: Location = Location()) :~ HardwareFields:
  when entity is_a List
  | error(~who: #'priority_encoder,
          location.describe() ++ ": priority_encoder operand must be one packable DataType")
  def value = kernel.read(entity, location)
  def width = value.type.packed_width()
  unless data_type(value.type) && width
  | error(~who: #'priority_encoder,
          location.describe() ++ ": priority_encoder operand must have a packable DataType")
  def packed = hardware_as_bits(
    value,
    #'priority_encoder,
    "priority_encoder operand",
    #false,
    location
  )
  def selected = packed_priority_encoder_oh(packed, width, #false, location)
  packed_one_hot_index(selected, width, name, location)

operator (left =/= right) :~ HardwareFields.of(Bool):
  ~same_as: ===
  bool_ne(left, right)

// Avoids an extra reduction comparison for a single Boolean predicate.
fun reduce_boolean_comparisons(comparisons :: NonemptyList.of(HardwareEntity),
                               name :: False || String,
                               location :: Location):
  if comparisons.length() == 1
  | kernel.cast(comparisons[0], Bool, name, location)
  | or_reduce(comparisons, name, location)

// Generates a runtime membership predicate from the enum type's declared
// encodings, keeping sparse wire encodings distinct from host type safety.
fun enum_valid(value :: HardwareEntity,
               name :: False || String = #false,
               location :: Location = Location()) :~ HardwareFields:
  def value_read = kernel.read(value, location)
  def type = value_read.type
  unless type is_a finite_enum_support.FiniteEnumType
  | error(~who: #'enum_valid,
          location.describe() ++ ": enum_valid operand must have a hardware enum type")
  def width = type.packed_width()
  def packed = hardware_as_bits(value_read,
                                #'enum_valid,
                                "enum_valid operand",
                                #false,
                                location)
  def comparisons = type.enum_encodings().map(
    fun (encoding):
      kernel.hw_eq(packed,
                   kernel.literal(Bits(width), encoding, #false, location),
                   #false,
                   location)
  )
  reduce_boolean_comparisons(comparisons, name, location)

fun require_unsigned_bits(left :: HardwareEntity,
                          right :: HardwareEntity,
                          who :: Symbol,
                          location :: Location):
  def left_value = kernel.read(left, location)
  def right_value = kernel.read(right, location)
  unless bits_type(left_value.type) && bits_type(right_value.type) && type_equal(left_value.type, right_value.type)
  | error(~who: who,
          location.describe() ++ ": unsigned comparison operands must have exactly the same Bits width")
  values(left_value, right_value)

fun comparison_bool(value :: HardwareEntity,
                    name :: False || String,
                    location :: Location) :~ HardwareFields.of(Bool):
  kernel.cast(value, Bool, name, location)

fun unsigned_lt_bits(left :: HardwareEntity,
                     right :: HardwareEntity,
                     who :: Symbol,
                     location :: Location):
  def (left_value, right_value) = require_unsigned_bits(left, right, who, location)
  kernel.hw_ult(left_value, right_value, #false, location)

fun unsigned_lt(left :: HardwareEntity,
                right :: HardwareEntity,
                name :: False || String = #false,
                location :: Location = Location()):
  comparison_bool(unsigned_lt_bits(left, right, #'unsigned_lt, location),
                  name, location)

fun require_signed_arithmetic(left :: HardwareEntity,
                              right :: HardwareEntity,
                              who :: Symbol,
                              location :: Location):
  def left_value = kernel.read(left, location)
  def right_value = kernel.read(right, location)
  unless signed_arithmetic_type(left_value.type) && signed_arithmetic_type(right_value.type) && type_equal(left_value.type, right_value.type)
  | error(~who: who,
          location.describe() ++ ": signed comparison operands must have exactly the same signed arithmetic type and width")
  values(left_value, right_value)

fun signed_lt_bits(left :: HardwareEntity,
                   right :: HardwareEntity,
                   who :: Symbol,
                   location :: Location):
  def (left_value, right_value) = require_signed_arithmetic(left,
                                                            right,
                                                            who,
                                                            location)
  kernel.hw_slt(left_value, right_value, #false, location)

fun signed_lt(left :: HardwareEntity,
              right :: HardwareEntity,
              name :: False || String = #false,
              location :: Location = Location()):
  comparison_bool(signed_lt_bits(left, right, #'signed_lt, location),
                  name, location)

fun ordered_lt_bits(left :: HardwareEntity,
                    right :: HardwareEntity,
                    who :: Symbol,
                    location :: Location):
  def left_value = kernel.read(left, location)
  def right_value = kernel.read(right, location)
  if signed_arithmetic_type(left_value.type) || signed_arithmetic_type(right_value.type)
  | signed_lt_bits(left_value, right_value, who, location)
  | unsigned_lt_bits(left_value, right_value, who, location)

fun ordered_lt(left :: HardwareEntity,
               right :: HardwareEntity,
               name :: False || String = #false,
               location :: Location = Location()):
  comparison_bool(ordered_lt_bits(left, right, #'ordered_lt, location),
                  name, location)

fun unsigned_gt(left :: HardwareEntity,
                right :: HardwareEntity,
                name :: False || String = #false,
                location :: Location = Location()):
  unsigned_lt(right, left, name, location)

fun unsigned_le(left :: HardwareEntity,
                right :: HardwareEntity,
                name :: False || String = #false,
                location :: Location = Location()):
  def (left_value, right_value) = require_unsigned_bits(left, right, #'unsigned_le, location)
  comparison_bool(
    kernel.bit_not(kernel.hw_ult(right_value, left_value, #false, location),
                   #false,
                   location),
    name,
    location
  )

fun unsigned_ge(left :: HardwareEntity,
                right :: HardwareEntity,
                name :: False || String = #false,
                location :: Location = Location()):
  def (left_value, right_value) = require_unsigned_bits(left, right, #'unsigned_ge, location)
  comparison_bool(
    kernel.bit_not(kernel.hw_ult(left_value, right_value, #false, location),
                   #false,
                   location),
    name,
    location
  )

operator (left < right) :~ HardwareFields.of(Bool):
  ~order: order_comparison
  if left is_a HardwareEntity || right is_a HardwareEntity
  | ordered_lt(left, right)
  | (left compare_to right) .< 0

operator (left > right) :~ HardwareFields.of(Bool):
  ~order: order_comparison
  if left is_a HardwareEntity || right is_a HardwareEntity
  | ordered_lt(right, left)
  | (left compare_to right) .> 0

operator (left <= right) :~ HardwareFields.of(Bool):
  ~order: order_comparison
  if left is_a HardwareEntity || right is_a HardwareEntity
  | block:
      def result = ordered_lt_bits(right, left, #'ordered_lt, Location())
      comparison_bool(kernel.bit_not(result,
                                     #false,
                                     Location()),
                      #false,
                      Location())
  | (left compare_to right) .<= 0

operator (left >= right) :~ HardwareFields.of(Bool):
  ~order: order_comparison
  if left is_a HardwareEntity || right is_a HardwareEntity
  | block:
      def result = ordered_lt_bits(left, right, #'ordered_lt, Location())
      comparison_bool(kernel.bit_not(result,
                                     #false,
                                     Location()),
                      #false,
                      Location())
  | (left compare_to right) .>= 0

fun build_mux(condition :: HardwareEntity,
              true_value :: HardwareEntity,
              false_value :: HardwareEntity,
              name :: False || String = #false,
              location :: Location = Location()) :~ HardwareFields:
  def condition_value = kernel.read(condition, location)
  unless bool_type(condition_value.type)
  | error(~who: #'mux, location.describe() ++ ": mux condition must be Bool")
  kernel.hw_mux_lookup(hardware_as_bits(condition, #'mux, "mux condition", #false, location),
                       false_value,
                       [[1, true_value]],
                       name,
                       location,
                       Origin("embedded mux", name || ""))

meta:
  fun mux_result(result :: Syntax, true_value :: Syntax):
    match true_value.group
    | '$(type_name :: Identifier) $dot $(member :: Identifier)' when dot.to_source_string() == ".":
        '$result :: HardwareFields.from_type($type_name)'
    | ~else:
        statinfo_meta.wrap(result, statinfo_meta.gather(true_value))

expr.macro
| 'mux($(condition :: expr_meta.Parsed),
       $(true_value :: expr_meta.Parsed),
       $(false_value :: expr_meta.Parsed))':
    def result = 'build_mux($condition, $true_value, $false_value)'
    mux_result(result, true_value)
| 'mux($(condition :: expr_meta.Parsed),
       $(true_value :: expr_meta.Parsed),
       $(false_value :: expr_meta.Parsed),
       $(name :: expr_meta.Parsed))':
    def result = 'build_mux($condition, $true_value, $false_value, $name)'
    mux_result(result, true_value)
| 'mux($(condition :: expr_meta.Parsed),
       $(true_value :: expr_meta.Parsed),
       $(false_value :: expr_meta.Parsed),
       $(name :: expr_meta.Parsed),
       $(location :: expr_meta.Parsed))':
    def result = 'build_mux($condition, $true_value, $false_value, $name, $location)'
    mux_result(result, true_value)
