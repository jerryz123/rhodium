#lang rhombus/and_meta
// Defines bundle declarations, type-named record construction, and field access.

import:
  rhombus.bits.(<<) as <<
  rhombus/meta open
  "../../core/ir.rhm" open
  "../kernel.rhm" as kernel
  "../support/fields.rhm".HardwareFields
  "../support/fields.rhm".value_surface_static_info_key
  "../support/generator-parameters.rhm".GeneratorParameter
  "../support/generator-parameters.rhm".substitute_generator_parameters
  "../support/hardware-methods.rhm".HardwareMethods
  "../support/hardware-literal.rhm" open

export:
  RecordField
  RecordType
  RecordLiteral
  BundleFamily
  BundleType
  bundle
  record

class BundleIdentity()

// Retains declaration provenance and concrete generator arguments without
// changing RecordType's structural hardware equality.
class BundleType(family_identity :: BundleIdentity = BundleIdentity(),
                 specialization_arguments :: List = []):
  extends RecordType

class BundleFamily(name :: String,
                   identity :: BundleIdentity,
                   construct :: Function):
  implements Callable

  override method call(& arguments :: List, ~& keywords :: Map):
    construct(& arguments, ~& keywords)

  // Returns concrete arguments only for a specialization of this declaration.
  method specialization_arguments(type :: DataType):
    if type is_a BundleType && type.family_identity === identity
    | type.specialization_arguments
    | #false

  // Requires a specialization of this declaration and returns its arguments.
  method require_specialization(type :: DataType):
    def arguments = specialization_arguments(type)
    unless arguments
    | error(~who: name,
            "expected a " ++ name ++ " specialization")
    arguments

// A record literal recursively packs its first declared field into the most
// significant part of the canonical representation, matching core casts.
class RecordLiteral(type :: RecordType, fields :: List.of(List)):
  implements HardwareLiteral
  constructor (type :: RecordType, fields :: List.of(List)):
    unless fields.length() == type.fields.length()
    | error(~who: #'record, "literal must supply every record field exactly once")
    for (declared in type.fields):
      def matching = fields.filter(
        ~keep: fun (field): field.length() == 2 && field[0] == declared.name
      )
      unless matching.length() == 1
      | error(~who: #'record, "literal must supply every record field exactly once")
      def field_literal = require_hardware_literal(matching[0][1], #'record)
      unless type_equal(field_literal.literal_type(), declared.type)
      | error(~who: #'record,
              "literal field " ++ declared.name ++ " has the wrong hardware type")
    super(type, fields)

  override method literal_type(): type

  override method packed_value():
    def mutable packed = 0
    for (declared in type.fields):
      def field_literal = fields.find(
        fun (field): field[0] == declared.name
      )[1]
      def shifted = packed << declared.type.packed_width()
      packed := shifted + field_literal.packed_value()
    packed

fun build_record(type :: RecordType, fields :: List.of(List)) :~ HardwareFields:
  if for all (field in fields):
       field.length() == 2 && field[1] is_a HardwareLiteral
  | RecordLiteral(type, fields)
  | kernel.record_create(type, fields)

fun conditional_bundle_fields(condition :: Boolean,
                              fields_thunk :: Function.of_arity(0)):
  if condition | fields_thunk() | []

fun build_bundle_type(name :: String,
                      field_groups :: List,
                      family_identity :: BundleIdentity,
                      specialization_arguments :: List):
  def mutable fields = []
  for (group in field_groups):
    fields := fields ++ group
  unless fields.length() > 0
  | error(~who: #'bundle,
          "bundle specialization must contain at least one field")
  BundleType(fields,
             name,
             family_identity,
             specialization_arguments)

// Carries the declared type of every bundle field so projection preserves the
// field type's custom authoring surface, including enum-owned methods.
statinfo.key bundle_field_static_info_key:
  ~and: fun (_left, right): right
  ~or: fun (_left, right): right

dot.macro 'bundle_value_dot $left $dot $right':
  def packed_fields = statinfo_meta.find(
    statinfo_meta.gather(left),
    'bundle_field_static_info_key'
  )
  if packed_fields
  | block:
      let '($field_entry, ...)' = packed_fields
      def mutable expansion = #false
      for (entry in [field_entry, ...]):
        match entry
        | '($(field_name :: Identifier), $(packed_infos :: Term))':
            when right.to_source_string() == field_name.to_source_string()
            | expansion := statinfo_meta.replace(
                'kernel.project($left, $(right.to_source_string()))',
                statinfo_meta.unpack(packed_infos)
              )
        | ~else:
            syntax_meta.error("invalid bundle field static information", entry)
      expansion
  | #false

annot.macro 'BundleFields($expected_type,
                          $(field_name :: Identifier): $field_annotation, ...)':
  let '$(base :: annot_meta.Parsed)' = 'HardwareFields.of($expected_type)'
  def (predicate, base_infos) = annot_meta.unpack_predicate(base)
  let [field_infos, ...]:
    for List (annotation in [field_annotation, ...]):
      annot_meta.parse_to_packed_statinfo(annotation)
  def result_infos = statinfo_meta.and(
    '(($(statinfo_meta.dot_provider_key), bundle_value_dot),
      (bundle_field_static_info_key, (($field_name, $field_infos), ...)))',
    base_infos
  )
  annot_meta.pack_predicate(predicate, result_infos)

// Carries the statically recoverable member surface of a parameterized bundle
// on the type expression itself, without requiring its runtime specialization
// arguments to be in annotation scope.
annot.macro 'BundleStaticFields($(field_name :: Identifier): $field_annotation, ...)':
  let '$(base :: annot_meta.Parsed)' = 'HardwareFields'
  def (predicate, base_infos) = annot_meta.unpack_predicate(base)
  let [field_infos, ...]:
    for List (annotation in [field_annotation, ...]):
      annot_meta.parse_to_packed_statinfo(annotation)
  def result_infos = statinfo_meta.and(
    '(($(statinfo_meta.dot_provider_key), bundle_value_dot),
      (bundle_field_static_info_key, (($field_name, $field_infos), ...)))',
    base_infos
  )
  annot_meta.pack_predicate(predicate, result_infos)

annot.macro 'BundleTypeDescriptor':
  annot_meta.pack_predicate('fun (value): value is_a RecordType')

// Function argument annotations expand before earlier host arguments are bound.
// Recover declared type annotations without parsing those arguments as expressions;
// a host type parameter supplies only the surface statically known at the use site.
annot.macro 'BundleAnnotationField($type)':
  match type
  | '$(name :: Identifier) $tail ...' when syntax_meta.value(name, annot_meta.space, #false):
      '$type'
  | '$(name :: Identifier)':
      def infos = statinfo_meta.lookup(name, 'value_surface_static_info_key')
      if infos
      | annot_meta.pack_predicate('fun (_value): #true', statinfo_meta.unpack(infos))
      | 'HardwareFields'
  | ~else:
      'HardwareFields'

defn.macro 'bundle $(name :: Identifier)($(parameter :: GeneratorParameter), ...): $clause; ...':
  def type_constructor = Syntax.make_id(
    name.to_source_string() ++ "_bundle_type",
    name
  )
  def family_name = Syntax.make_id(
    name.to_source_string() ++ "_bundle_family",
    name
  )
  def identity_name = Syntax.make_id(
    name.to_source_string() ++ "_bundle_identity",
    name
  )
  def bundle_name = name.to_source_string()
  def parameter_count = [parameter, ...].length()
  def mutable field_groups = []
  def mutable field_names = []
  def mutable static_fields = []
  def mutable descriptor_static_fields = []
  def mutable annotation_static_fields = []
  def mutable method_names = []
  def mutable method_entries = []
  def mutable method_definitions = []
  fun substitute_bundle_parameters(field_type :: Syntax):
    substitute_generator_parameters(field_type, [parameter.binding, ...])
  fun retain_static_field(field_name :: Syntax, field_type :: Syntax):
    static_fields := static_fields ++ [
      '$field_name: HardwareFields.from_type($field_type)'
    ]
    def substituted_type = substitute_bundle_parameters(field_type)
    descriptor_static_fields := descriptor_static_fields ++ [
      '$field_name: HardwareFields.from_type($substituted_type)'
    ]
    annotation_static_fields := annotation_static_fields ++ [
      '$field_name: BundleAnnotationField($substituted_type)'
    ]
  for (item in [clause, ...]):
    match item
    | '$(field_name :: Identifier): $field_type':
        def field_string = field_name.to_source_string()
        field_names := field_names ++ [field_string]
        field_groups := field_groups ++ [
          '[RecordField($field_string, $field_type)]'
        ]
        retain_static_field(field_name, field_type)
    | 'if $condition ...: $conditional_clause; ...':
        def mutable conditional_fields = []
        for (conditional_item in [conditional_clause, ...]):
          match conditional_item
          | '$(field_name :: Identifier): $field_type':
              def field_string = field_name.to_source_string()
              field_names := field_names ++ [field_string]
              conditional_fields := conditional_fields ++ [
                'RecordField($field_string, $field_type)'
              ]
              retain_static_field(field_name, field_type)
          | ~else:
              syntax_meta.error(
                "expected a bundle field in conditional field group",
                conditional_item
              )
        when conditional_fields.length() == 0
        | syntax_meta.error(
            "conditional bundle field group requires at least one field",
            item
          )
        let [conditional_field, ...] = conditional_fields
        field_groups := field_groups ++ [
          'conditional_bundle_fields(
             ($condition ...),
             fun (): [$conditional_field, ...]
           )'
        ]
    | 'method $(method_name :: Identifier)($(receiver :: Identifier), $(argument :: GeneratorParameter), ...) :: $(result_constructor :: Identifier)($result_argument, ...):
         $method_body; ...':
        when method_names.find(fun (declared): declared == method_name.to_source_string())
        | syntax_meta.error("bundle method names must be unique", method_name)
        method_names := method_names ++ [method_name.to_source_string()]
        def method_function = Syntax.make_id(
          bundle_name ++ "_" ++ method_name.to_source_string(),
          method_name
        )
        let [argument_binding, ...] = [argument.binding, ...]
        method_entries := method_entries ++ [
          '($method_name, $method_function, ($argument_binding, ...),
            (typed ($result_constructor($result_argument, ...))))'
        ]
        method_definitions := method_definitions ++ [
          'fun $method_function($receiver :: $name(), $argument, ...) :: $result_constructor($result_argument, ...):
             $method_body
             ...'
        ]
    | 'method $(method_name :: Identifier)($(receiver :: Identifier), $(argument :: GeneratorParameter), ...) :: $(result_type :: Identifier):
         $method_body; ...':
        when method_names.find(fun (declared): declared == method_name.to_source_string())
        | syntax_meta.error("bundle method names must be unique", method_name)
        method_names := method_names ++ [method_name.to_source_string()]
        def method_function = Syntax.make_id(
          bundle_name ++ "_" ++ method_name.to_source_string(),
          method_name
        )
        let [argument_binding, ...] = [argument.binding, ...]
        method_entries := method_entries ++ [
          '($method_name, $method_function, ($argument_binding, ...), (typed ($result_type)))'
        ]
        method_definitions := method_definitions ++ [
          'fun $method_function($receiver :: $name(), $argument, ...) :: $result_type:
             $method_body
             ...'
        ]
    | 'method $(method_name :: Identifier)($(receiver :: Identifier), $(argument :: GeneratorParameter), ...):
         $method_body; ...':
        when method_names.find(fun (declared): declared == method_name.to_source_string())
        | syntax_meta.error("bundle method names must be unique", method_name)
        method_names := method_names ++ [method_name.to_source_string()]
        def method_function = Syntax.make_id(
          bundle_name ++ "_" ++ method_name.to_source_string(),
          method_name
        )
        let [argument_binding, ...] = [argument.binding, ...]
        method_entries := method_entries ++ [
          '($method_name, $method_function, ($argument_binding, ...), untyped)'
        ]
        method_definitions := method_definitions ++ [
          'fun $method_function($receiver :: $name(), $argument, ...) :~ HardwareFields:
             $method_body
             ...'
        ]
    | ~else:
        syntax_meta.error(
          "expected a bundle field, conditional field group, or method declaration",
          item
        )
  when field_groups.length() == 0
  | syntax_meta.error("bundle requires at least one field clause", name)
  when parameter_count > 0 && method_entries.length() > 0
  | syntax_meta.error("bundle methods currently require a zero-parameter bundle", name)
  for (method_name in method_names):
    when field_names.find(fun (field_name): field_name == method_name)
    | syntax_meta.error("bundle fields and methods must have distinct names", name)
  let [field_group, ...] = field_groups
  let [static_field, ...] = static_fields
  let [descriptor_static_field, ...] = descriptor_static_fields
  let [annotation_static_field, ...] = annotation_static_fields
  let [method_entry, ...] = method_entries
  let [method_definition, ...] = method_definitions
  let [parameter_binding, ...] = [parameter.binding, ...]
  if parameter_count == 0
  | block:
      def type_descriptor = Syntax.make_id(bundle_name ++ "_bundle_descriptor", name)
      '«
         def $identity_name = BundleIdentity()
         fun $type_constructor($parameter, ...):
           build_bundle_type($bundle_name,
                             [$field_group, ...],
                             $identity_name,
                             [$parameter, ...])
         def $family_name = BundleFamily($bundle_name,
                                         $identity_name,
                                         $type_constructor)
         def $type_descriptor :: HardwareFields.describes(
           BundleTypeDescriptor,
           HardwareMethods(BundleFields($type_constructor(), $static_field, ...),
                           $method_entry, ...)
         ) = $type_constructor()
         expr.macro
         | '$name(): $('$')field; $('...')':
             'record($type_descriptor):
                $('$')field
                $('...')'
         | '$name()': '$type_descriptor'
         | '$name': '$family_name'
         annot.macro '$name()':
           'HardwareMethods(BundleFields($type_constructor(), $static_field, ...),
                            $method_entry, ...)'
         $method_definition
         ...
       »'
  | '«
       def $identity_name = BundleIdentity()
       fun $type_constructor($parameter, ...):
         build_bundle_type($bundle_name,
                           [$field_group, ...],
                           $identity_name,
                           [$parameter, ...])
       def $family_name = BundleFamily($bundle_name,
                                       $identity_name,
                                       $type_constructor)
       expr.macro
       | '$name($('$')$parameter_binding, ...):
            $('$')field; $('...')':
           'record($name($('$')$parameter_binding, ...)):
              $('$')field
              $('...')'
       | '$name($('$')$parameter_binding, ...)':
           '(block:
              def $parameter_binding = $('$')$parameter_binding
              ...
              $type_constructor($parameter_binding, ...)) :: HardwareFields.describes(
                BundleTypeDescriptor,
                BundleStaticFields($descriptor_static_field, ...)
              )'
       | '$name': '$family_name'
       annot.macro '$name($('$')$parameter_binding, ...)':
         'BundleFields($type_constructor($('$')$parameter_binding, ...),
                       $annotation_static_field, ...)'
     »'

expr.macro 'record($type):
              $field_name: $field_value
              ...':
  let [field_string, ...] = [field_name.to_source_string(), ...]
  'build_record($type,
                [[$field_string, $field_value], ...]) :: HardwareFields.from_type($type)'
