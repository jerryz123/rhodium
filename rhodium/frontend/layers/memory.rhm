#lang rhombus/and_meta
// Defines binding-derived memories with async indexing and synchronous writes.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/meta open
  "../../core/ir.rhm" open
  "../kernel.rhm" as kernel
  "../support/clocking.rhm".ambient_memory_write
  "../support/clocking.rhm".reject_explicit_sync_control
  "../support/fields.rhm".HardwareFields

export:
  mem
  index_width
  MemoryFields

fun index_width(depth :: PosInt):
  memory_address_width(depth)

annot.macro 'MemoryFields':
  annot_meta.pack_predicate(
    'fun (value): value is_a Memory',
    '(($(statinfo_meta.dot_provider_key), memory_field_dot), ($(statinfo_meta.index_get_key), memory_index))'
  )

statinfo.key memory_element_static_info_key:
  ~and: fun (_left, right): right
  ~or: fun (_left, right): right

namespace MemoryFields:
  export annot.macro 'of($(element_type :: expr_meta.Parsed))':
    let '$(base :: annot_meta.Parsed)' = 'MemoryFields'
    let '$(element :: annot_meta.Parsed)' = 'HardwareFields.from_type($element_type)'
    def (predicate, base_infos) = annot_meta.unpack_predicate(base)
    def (_element_predicate, element_infos) = annot_meta.unpack_predicate(element)
    def result_infos = statinfo_meta.and(
      base_infos,
      '(($(statinfo_meta.index_result_key),
         $(statinfo_meta.pack_index_result(element_infos, []))),
        (memory_element_static_info_key, $(statinfo_meta.pack(element_infos))))'
    )
    annot_meta.pack_predicate(predicate, result_infos)

fun memory_index(memory :: Memory,
                 address :: HardwareEntity) :~ HardwareFields:
  kernel.memory_read_async(memory, address)

fun frontend_memory_write(memory :: Memory,
                          address :: HardwareEntity,
                          data :: HardwareEntity,
                          enable :: False || HardwareEntity = #false,
                          clock :: False || HardwareEntity = #false):
  when clock
  | reject_explicit_sync_control()
  def resolved_enable:
    if enable | enable | kernel.literal(Bits(1), 1)
  if clock
  | kernel.memory_write(memory, address, data, clock, resolved_enable)
  | ambient_memory_write(memory, address, data, resolved_enable)

dot.macro 'memory_field_dot $left $dot $right':
  def packed_element = statinfo_meta.find(
    statinfo_meta.gather(left),
    'memory_element_static_info_key'
  )
  match right
  | 'id': #false
  | 'name': #false
  | 'depth': #false
  | 'element_type': #false
  | 'module_def': #false
  | 'module_id': #false
  | 'design': #false
  | 'defining_op_id': #false
  | 'ref': #false
  | 'read':
      def read_function = 'fun (address) :~ HardwareFields: memory_index($left, address)'
      if packed_element
      | block:
          def call_result = statinfo_meta.pack_call_result(
            [[-1, statinfo_meta.unpack(packed_element)]]
          )
          statinfo_meta.wrap(
            read_function,
            '(($(statinfo_meta.call_result_key), $call_result))'
          )
      | read_function
  | 'write':
      'fun (address, data,
            ~enable: enable = #false,
            ~clock: clock = #false):
         frontend_memory_write($left, address, data, enable, clock)'
  | ~else: #false

defn.macro 'mem $(name :: Identifier)($depth, $(element_type :: expr_meta.Parsed))':
  def memory_name = name.to_source_string()
  'def $name :: MemoryFields.of($element_type) = kernel.memory($memory_name, $depth, $element_type)'
