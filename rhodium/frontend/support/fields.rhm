#lang rhombus/and_meta
// Provides shared field, immutable update, cast, lookup, indexing, membership, and width syntax for hardware entities.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/meta open
  "../../../support/annotations.rhm" open
  "../../core/ir.rhm" open
  "../../core/types.rhm" open
  "../kernel.rhm" as kernel
  "hardware-literal.rhm".HardwareLiteral
  "hardware-literal.rhm".packed_literal

export:
  HardwareFields
  HardwareMethodFields
  AnyBitsHardware
  HardwareVariantFields
  HardwareIntoFunction
  ValueSurfaceFields
  CircuitPortFields
  CircuitMemberFields
  hardware_port_static_info_key
  value_surface_static_info_key
  HardwareVariant
  HardwareVariantType
  HardwareVariantView
  Bool
  bool_type
  hardware_value_type
  hardware_as_bits
  hardware_append
  hardware_as_vec
  hardware_index
  hardware_into
  hardware_lookup
  hardware_method_dot
  hardware_method_static_info_key
  hardware_value_method_dot

// Stores exact receiver-owned methods under one composable key instead of
// allocating a separate static-information key for every method name.
statinfo.key hardware_method_static_info_key:
  ~and:
    fun (left, right):
      let '($left_entry, ...)' = left
      let '($right_entry, ...)' = right
      '($left_entry, ..., $right_entry, ...)'
  ~or: fun (_left, right): right

// Associates a circuit definition with the exact static surface of each
// declared data port. Hierarchy transfers this map to the resulting instance.
statinfo.key hardware_port_static_info_key:
  ~and: fun (_left, right): right
  ~or: fun (_left, right): right

// Carries the runtime-value surface advertised by any type descriptor. Data
// types and interface types share this key so circuit declarations can retain
// member precision without importing individual frontend layers.
statinfo.key value_surface_static_info_key:
  ~and: fun (_left, right): right
  ~or: fun (_left, right): right

annot.macro 'ValueSurfaceFields($(type :: expr_meta.Parsed))':
  def value_infos = statinfo_meta.find(
    statinfo_meta.gather(type),
    'value_surface_static_info_key'
  )
  if value_infos
  | annot_meta.pack_predicate('fun (_value): #true', statinfo_meta.unpack(value_infos))
  | 'HardwareFields.from_type($type)'

annot.macro 'CircuitPortFields($(port_name :: Identifier): $(port_type :: expr_meta.Parsed), ...)':
  let [port_infos, ...]:
    for List (type in [port_type, ...]):
      annot_meta.parse_to_packed_statinfo('ValueSurfaceFields($type)')
  annot_meta.pack_predicate(
    'fun (_value): #true',
    '((hardware_port_static_info_key, (($port_name, $port_infos), ...)))'
  )

// Records already-selected member annotations, including scalar and array
// interface endpoints, on a circuit generator result.
annot.macro 'CircuitMemberFields($(member_name :: Identifier): $(member_annotation :: annot_meta.Parsed), ...)':
  let [member_infos, ...]:
    for List (annotation in [member_annotation, ...]):
      // Array annotations are converters, while scalar hardware and interface
      // annotations are predicates; only their result static information matters.
      annot_meta.parse_to_packed_statinfo(annotation)
  annot_meta.pack_predicate(
    'fun (_value): #true',
    '((hardware_port_static_info_key, (($member_name, $member_infos), ...)))'
  )

// Retains the internal compatibility selector for a register's driveable
// next-state place; author-level RTL drives registers directly.
fun hardware_next(value :: Register):
  value.next

// Extracts the Rhodium type from readable or driveable data objects without
// changing their identity. Deferred extension values materialize on demand.
fun hardware_entity_type(value :~ HardwareEntity):
  cond
  | value is_a Value: value.type
  | value is_a Place: value.type
  | value is_a Register: value.current.type
  | value is_a HardwareLiteral: value.literal_type()
  | value is_a kernel.DeferredHardwareValue: kernel.read(value).type
  | ~else: #false

// Exposes type discovery to frontend libraries that derive a result protocol
// from caller-elaborated hardware without depending on core IR classes.
fun hardware_value_type(value :~ HardwareEntity):
  def type = hardware_entity_type(value)
  unless type is_a HardwareType
  | error(~who: #'hardware_value_type, "expected hardware data")
  type

fun hardware_has_type(value :: HardwareEntity,
                      expected_type :: HardwareType):
  def actual_type = hardware_entity_type(value)
  actual_type is_a HardwareType && type_equal(actual_type, expected_type)

fun hardware_has_bits_type(value :: HardwareEntity):
  def type = hardware_entity_type(value)
  type is_a HardwareType && bits_type(type)

fun hardware_has_packable_data_type(value :: HardwareEntity):
  def type = hardware_entity_type(value)
  type is_a DataType && packable_type(type)

// Lets independently selectable frontend layers attach variant inspection to
// hardware values without teaching the shared field syntax their encoding.
interface HardwareVariant

interface HardwareVariantType:
  method hardware_variant_tag(entity :: HardwareEntity, location :: Location)
  method hardware_variant_is(entity :: HardwareEntity,
                             variant :: HardwareVariant,
                             location :: Location)
  method hardware_variant_view(entity :: HardwareEntity,
                               variant :: HardwareVariant,
                               location :: Location)

class HardwareVariantView(valid :: Value, payload :: False || Value)

annot.macro 'HardwareFields':
  def result_infos = statinfo_meta.and(
    '(($(statinfo_meta.dot_provider_key), hardware_method_dot),
      ($(statinfo_meta.append_key), hardware_append))',
    '(($(statinfo_meta.dot_provider_key), hardware_field_dot),
      ($(statinfo_meta.index_get_key), hardware_index))'
  )
  annot_meta.pack_predicate(
    'fun (value): value is_a HardwareEntity',
    result_infos
  )

// Supplies common hardware method and append dispatch without claiming field
// projection. Member-bearing surfaces retain these operations after fallback.
annot.macro 'HardwareMethodFields':
  annot_meta.pack_predicate(
    'fun (value): value is_a HardwareEntity',
    '(($(statinfo_meta.dot_provider_key), hardware_method_dot),
      ($(statinfo_meta.append_key), hardware_append))'
  )

// Gives the public bare Bits annotation its existential-width predicate while
// keeping that implementation detail out of the Hardware namespace.
annot.macro 'AnyBitsHardware':
  let '$(base :: annot_meta.Parsed)' = 'HardwareFields'
  def (_base_predicate, base_infos) = annot_meta.unpack_predicate(base)
  annot_meta.pack_predicate(
    'fun (value): value is_a HardwareEntity && hardware_has_bits_type(value)',
    base_infos
  )

// Extends the broad HardwareFields annotation with an exact-type form. The
// foundation renames this root to the public Hardware annotation namespace.
namespace HardwareFields:
  // Describes any hardware value whose descriptor satisfies a generated
  // nominal-family predicate while retaining the generic hardware surface.
  export annot.macro 'family($(matches_type :: expr_meta.Parsed))':
    let '$(base :: annot_meta.Parsed)' = 'HardwareFields'
    def (_base_predicate, base_infos) = annot_meta.unpack_predicate(base)
    annot_meta.pack_predicate(
      'fun (value): value is_a HardwareEntity && $matches_type(hardware_entity_type(value))',
      base_infos
    )

  // Carries an exact value surface on a hardware type descriptor so frontend
  // declarations can recover it without evaluating the descriptor at expansion time.
  export annot.macro 'describes($(descriptor :: annot_meta.Parsed),
                                $(value :: annot_meta.Parsed))':
    def (descriptor_predicate, descriptor_infos) = annot_meta.unpack_predicate(descriptor)
    def value_infos = statinfo_meta.unpack(
      annot_meta.parse_to_packed_statinfo(value)
    )
    def result_infos = statinfo_meta.and(
      descriptor_infos,
      '((hardware_value_static_info_key, $(statinfo_meta.pack(value_infos))),
        (value_surface_static_info_key, $(statinfo_meta.pack(value_infos))))'
    )
    annot_meta.pack_predicate(descriptor_predicate, result_infos)

  // Recovers the value surface advertised by a parsed hardware type expression,
  // conservatively retaining generic field and index behavior when none is known.
  export annot.macro 'from_type($(type :: expr_meta.Parsed))':
    def value_infos = statinfo_meta.find(
      statinfo_meta.gather(type),
      'hardware_value_static_info_key'
    )
    if value_infos
    | annot_meta.pack_predicate(
        'fun (value): value is_a HardwareEntity && hardware_has_type(value, $type)',
        statinfo_meta.unpack(value_infos)
      )
    | 'HardwareFields'

  export annot.macro 'of($expected_type)':
    let '$(base :: annot_meta.Parsed)' = 'HardwareFields'
    def (_base_predicate, base_infos) = annot_meta.unpack_predicate(base)
    annot_meta.pack_predicate(
      'fun (value): value is_a HardwareEntity && hardware_has_type(value, $expected_type)',
      base_infos
    )

  // Describes an arbitrary packable DataType entity without erasing that
  // requirement to the broader Hardware category.
  export annot.macro 'packable':
    let '$(base :: annot_meta.Parsed)' = 'HardwareFields'
    def (_base_predicate, base_infos) = annot_meta.unpack_predicate(base)
    annot_meta.pack_predicate(
      'fun (value): value is_a HardwareEntity && hardware_has_packable_data_type(value)',
      base_infos
    )

// Bool is shared support because common hardware dot methods must be able to
// construct their nominal predicate result without importing a frontend layer.
class _BoolType():
  implements BitwiseType
  implements Callable
  override method describe(): "bool"
  override method type_equal(other :: HardwareType): bool_type(other)
  override method packed_width(): 1
  override method call(value :: Boolean) :~ HardwareFields:
    packed_literal(this, if value | 1 | 0)

def Bool = _BoolType()

annot.macro 'Bool':
  'HardwareFields.of(Bool)'

fun bool_type(type :: HardwareType):
  type is_a _BoolType

fun require_hardware_variant_type(value :: HardwareEntity, who :: Symbol):
  def type = hardware_entity_type(value)
  unless type is_a HardwareVariantType
  | error(~who: who, "expected hardware data with variants")
  type

fun hardware_variant_tag(value :: HardwareEntity,
                         location :: Location = Location()) :~ HardwareFields:
  require_hardware_variant_type(value, #'tag).hardware_variant_tag(value, location)

// Preserves variant tag inspection after an intermediate operation has erased
// exact static type information, while treating tag as an ordinary projection
// on non-variant records.
fun hardware_variant_tag_or_project(
      value :: HardwareEntity,
      location :: Location = Location()) :~ HardwareFields:
  def type = hardware_entity_type(value)
  if type is_a HardwareVariantType
  | type.hardware_variant_tag(value, location)
  | kernel.project(value, "tag", #false, location)

fun hardware_variant_is(value :: HardwareEntity,
                        variant :: HardwareVariant,
                        location :: Location = Location()) :~ HardwareFields:
  require_hardware_variant_type(value, #'is).hardware_variant_is(value, variant, location)

fun hardware_variant_view_valid(view :: HardwareVariantView) :~ HardwareFields:
  view.valid

fun hardware_variant_view_payload(view :: HardwareVariantView) :~ HardwareFields:
  unless view.payload
  | error(~who: #'view, "nullary hardware variants do not have payloads")
  view.payload

annot.macro 'HardwareVariantViewFields':
  annot_meta.pack_predicate(
    'fun (value): value is_a HardwareVariantView',
    '(($(statinfo_meta.dot_provider_key), hardware_variant_view_dot))'
  )

fun hardware_variant_view(
      value :: HardwareEntity,
      variant :: HardwareVariant,
      location :: Location = Location()) :~ HardwareVariantViewFields:
  require_hardware_variant_type(value, #'view).hardware_variant_view(value,
                                                                     variant,
                                                                     location)

// Adds variant inspection only to types that explicitly advertise the
// HardwareVariantType protocol, leaving ordinary fields named tag, is, or view
// available to records and bundles.
annot.macro 'HardwareVariantFields($expected_type)':
  let '$(base :: annot_meta.Parsed)' = 'HardwareFields.of($expected_type)'
  def (predicate, base_infos) = annot_meta.unpack_predicate(base)
  def result_infos = statinfo_meta.and(
    '(($(statinfo_meta.dot_provider_key), hardware_variant_field_dot))',
    base_infos
  )
  annot_meta.pack_predicate(predicate, result_infos)

dot.macro 'hardware_variant_field_dot $left $dot $right':
  match right
  | 'tag': 'hardware_variant_tag($left) :: HardwareFields'
  | 'is': 'fun (variant) :~ HardwareFields: hardware_variant_is($left, variant)'
  | 'view': 'fun (variant) :~ HardwareVariantViewFields: hardware_variant_view($left, variant)'
  | ~else: #false

dot.macro 'hardware_variant_view_dot $left $dot $right':
  match right
  | 'valid': 'hardware_variant_view_valid($left) :: HardwareFields'
  | 'payload': 'hardware_variant_view_payload($left) :: HardwareFields'
  | ~else: #false

fun hardware_index(value :: HardwareEntity,
                   index :: Nat || Range || HardwareEntity) :: HardwareFields:
  def value_type = hardware_entity_type(value)
  cond
  | index is_a Nat:
      kernel.index(value, index)
  | index is_a Range:
      def start = index.start()
      def end = index.end()
      unless start is_a Nat && end is_a Nat
      | error(~who: #'extract,
              "hardware slice indices must form a bounded host natural-number range")
      def low = start + (if index.includes_start() | 0 | 1)
      def high = end - (if index.includes_end() | 0 | 1)
      unless low <= high
      | error(~who: #'extract,
              "hardware slice range must select at least one bit")
      kernel.extract(value, high, low)
  | index is_a HardwareEntity && vector_type(value_type):
      kernel.vector_index(value, index)
  | ~else:
      error(~who: #'extract,
            "hardware index must be a host natural number or bounded host natural-number range")

// Supplies the concise frontend spelling for an explicit, equal-width
// representation cast while leaving the operation itself in the kernel.
fun hardware_into(value :: HardwareEntity,
                  target_type :: HardwareType) :~ HardwareFields:
  kernel.cast(value, target_type)

// Selects the result surface from the target type supplied to an `.into`
// function, so representation casts preserve enum and bundle methods.
meta.bridge hardware_into_result_static_infos:
  fun (_data, dependencies :: annot_meta.Dependencies):
    def target_infos = dependencies.arguments[0]
    def surface_infos = statinfo_meta.find(
      statinfo_meta.unpack(target_infos),
      'value_surface_static_info_key'
    )
    if surface_infos
    | surface_infos
    | annot_meta.parse_to_packed_statinfo('HardwareFields')

annot.macro 'HardwareIntoFunction':
  def dependent_result = statinfo_meta.pack_dependent_result(
    'hardware_into_result_static_infos',
    '(unused)',
    {}
  )
  def call_result = statinfo_meta.pack(
    '(($(statinfo_meta.dependent_result_key), $dependent_result))'
  )
  annot_meta.pack_predicate(
    'fun (_value): #true',
    '(($(statinfo_meta.call_result_key), $call_result))'
  )

// Produces the canonical packed Bits image of frontend data while preserving
// an existing Bits value without introducing a redundant cast operation.
fun hardware_as_bits(value :: HardwareEntity,
                     who :: Symbol,
                     role :: String,
                     name :: False || AsciiIdentifier = #false,
                     location :: Location = Location()) :~ HardwareFields:
  def source = kernel.read(value, location)
  def width = source.type.packed_width()
  unless data_type(source.type) && width
  | error(~who: who, role ++ " must have a packable DataType")
  if bits_type(source.type)
  | source
  | kernel.cast(source, Bits(width), name, location)

// Implements Rhombus append for hardware values as binary packed
// concatenation while preserving ordinary host append dispatch.
fun hardware_append(left :: HardwareEntity,
                    right :: HardwareEntity) :~ HardwareFields:
  kernel.concat(
    [hardware_as_bits(left, Symbol.from_string("++"), "left operand"),
     hardware_as_bits(right, Symbol.from_string("++"), "right operand")]
  )

// Reinterprets one evenly divisible packed value as a uniform vector while
// inferring the vector length from the requested element representation.
fun hardware_as_vec(value :: HardwareEntity,
                    element_type :: DataType,
                    name :: False || AsciiIdentifier = #false,
                    location :: Location = Location()) :~ HardwareFields:
  def source = kernel.read(value, location)
  def source_width = source.type.packed_width()
  unless data_type(source.type) && source_width
  | error(~who: #'as_vec, "value must have a packable DataType")
  def element_width = element_type.packed_width()
  unless element_width
  | error(~who: #'as_vec, "element type must be a packable DataType")
  unless source_width mod element_width == 0
  | error(~who: #'as_vec,
          "value width must be evenly divisible by the element width")
  def target_type = VectorType(source_width div element_width, element_type)
  if type_equal(source.type, target_type)
  | source
  | kernel.cast(source, target_type, name, location)

// Implements deterministic hardware-selected vector reads through the
// existing mux-lookup semantics and an explicit out-of-range default.
fun hardware_lookup(value :: HardwareEntity,
                    selector :: HardwareEntity,
                    ~default: default_value :: HardwareEntity) :~ HardwareFields:
  kernel.vector_lookup(value, selector, default_value)

// Reconstructs a record with named replacements, or a vector with one selected
// replacement. Preserve the concrete descriptor rather than rebuilding its type.
fun hardware_updated(value :: HardwareEntity,
                     & arguments :: List.of(HardwareEntity),
                     ~& replacements :: Map) :~ HardwareFields:
  def source = kernel.read(value)
  cond
  | source.type is_a RecordType:
      unless arguments.length() == 0
      | error(~who: #'updated, "record updates require named field replacements")
      def names = source.type.fields.map(fun (field): Keyword.from_string(field.name))
      for (key in replacements.keys()):
        unless names.contains(key)
        | error(~who: #'updated, "record has no field for " ++ to_string(key))
      def fields = for List (field in source.type.fields):
        def key = Keyword.from_string(field.name)
        [field.name,
         if replacements.has_key(key)
         | replacements[key]
         | kernel.project(source, field.name)]
      kernel.record_create(source.type, fields)
  | source.type is_a VectorType:
      unless arguments.length() == 2 && replacements.length() == 0
      | error(~who: #'updated, "vector updates require a selector and replacement")
      kernel.vector_updated(source, arguments[0], arguments[1])
  | ~else:
      error(~who: #'updated, "updated receiver must have a RecordType or VectorType")

// Statically unrolls a host transformation over every element of a hardware
// vector and reconstructs one homogeneous hardware vector from the results.
fun hardware_vector_map(value :: HardwareEntity,
                        transform :: Function.of_arity(1)) :~ HardwareFields:
  def source = kernel.read(value)
  unless source.type is_a VectorType
  | error(~who: #'map, "map receiver must have a VectorType")
  def transformed = for List (index in 0..source.type.length):
    transform(kernel.vector_get(source, index))
  def first = kernel.read(transformed[0])
  unless first.type is_a DataType
  | error(~who: #'map, "map results must have a DataType")
  kernel.vector_create(VectorType(source.type.length, first.type), transformed)

// Extends a Bits receiver with zeroes while keeping its static method surface
// available to subsequent receiver-owned operations.
fun hardware_zero_extend(value :: HardwareEntity,
                         target_width :: PosInt,
                         name :: False || AsciiIdentifier = #false,
                         location :: Location = Location()) :~ HardwareFields:
  def source = kernel.read(value, location)
  unless bits_type(source.type)
  | error(~who: #'zext,
          location.describe() ++ ": .zext receiver must have a Bits type")
  kernel.zext(source, target_width, name, location)

// Extends a signed receiver through its width-preserving nominal type family
// while keeping the receiver's static method surface.
fun hardware_sign_extend(value :: HardwareEntity,
                         target_width :: PosInt,
                         name :: False || AsciiIdentifier = #false,
                         location :: Location = Location()) :~ HardwareFields:
  def source = kernel.read(value, location)
  unless signed_arithmetic_type(source.type)
  | error(~who: #'sext,
          location.describe() ++ ": .sext receiver must have a SignedArithmeticType")
  kernel.sext(source, target_width, name, location)

// Implements receiver-owned membership without exposing a parallel free
// function. Each alternative must retain the receiver's exact flat type.
fun build_membership_predicate(value :: HardwareEntity,
                               supplied :: List.of(HardwareEntity || List.of(HardwareEntity)),
                               location :: Location = Location()) :~ HardwareFields:
  def value_read = kernel.read(value, location)
  unless scalar_data_type(value_read.type)
  | error(~who: #'is_one_of,
          location.describe() ++ ": .is_one_of subject must have a ScalarDataType")
  def candidates:
    if supplied.length() == 1 && supplied[0] is_a List
    | supplied[0]
    | supplied
  if candidates.length() == 0
  | kernel.cast(kernel.literal(Bits(1), 0, #false, location),
                Bool,
                #false,
                location)
  | block:
      def comparisons = candidates.map(
        fun (alternative):
          def alternative_read = kernel.read(alternative, location)
          unless scalar_data_type(alternative_read.type) && type_equal(value_read.type, alternative_read.type)
          | error(~who: #'is_one_of,
                  location.describe() ++ ": .is_one_of operands must have exactly the same ScalarDataType")
          kernel.hw_eq(hardware_as_bits(value_read,
                                        #'is_one_of,
                                        ".is_one_of operand",
                                        #false,
                                        location),
                       hardware_as_bits(alternative_read,
                                        #'is_one_of,
                                        ".is_one_of operand",
                                        #false,
                                        location),
                       #false,
                       location)
      )
      if comparisons.length() == 1
      | kernel.cast(comparisons[0], Bool, #false, location)
      | block:
          def packed = kernel.concat(comparisons, #false, location)
          def equal_zero = kernel.cast(
            kernel.hw_eq(packed,
                         kernel.literal(Bits(comparisons.length()), 0, #false, location),
                         #false,
                         location),
            Bool,
            #false,
            location
          )
          kernel.bit_not(equal_zero, #false, location)

meta:
  fun preserve_receiver_surface(function :: Syntax, receiver :: Syntax):
    def call_result = statinfo_meta.pack_call_result(
      [[-1, statinfo_meta.gather(receiver)]]
    )
    statinfo_meta.wrap(
      function,
      '(($(statinfo_meta.call_result_key), $call_result))'
    )

  fun hardware_width_method(left :: Syntax, right :: Syntax):
    match right
    | 'zext':
        preserve_receiver_surface(
          'fun (target_width :: PosInt,
                name :: False || AsciiIdentifier = #false) :~ HardwareFields:
             hardware_zero_extend($left, target_width, name)',
          left
        )
    | 'sext':
        preserve_receiver_surface(
          'fun (target_width :: PosInt,
                name :: False || AsciiIdentifier = #false) :~ HardwareFields:
             hardware_sign_extend($left, target_width, name)',
          left
        )
    | ~else: #false

  fun universal_hardware_method(left :: Syntax, method :: Syntax):
    match method
    | 'zext': hardware_width_method(left, method)
    | 'sext': hardware_width_method(left, method)
    | 'as_bits': 'fun () :~ HardwareFields: hardware_as_bits($left, #'as_bits, "value")'
    | 'as_vec': 'fun (element_type :: DataType) :~ HardwareFields: hardware_as_vec($left, element_type)'
    | 'into': '(fun (target_type): hardware_into($left, target_type)) :: HardwareIntoFunction'
    | 'lookup': 'fun (selector, ~default: default_value) :~ HardwareFields: hardware_lookup($left, selector, ~default: default_value)'
    | 'map': 'fun (transform :: Function.of_arity(1)) :~ HardwareFields: hardware_vector_map($left, transform)'
    | 'updated':
        preserve_receiver_surface(
          'fun (& arguments, ~& replacements) :~ HardwareFields:
             hardware_updated($left, & arguments, ~& replacements)',
          left
        )
    | ~else: #false

  fun common_hardware_method(left :: Syntax,
                             right :: Syntax,
                             form :: Syntax,
                             remainder :: Syntax):
    match form
    | 'updated($argument, ...) $rest ...':
        values(universal_hardware_method(left, right), '($argument, ...) $rest ...')
    | 'is_one_of() $rest ...':
        syntax_meta.error(".is_one_of expects alternatives or one host list", right)
    | 'is_one_of($(candidate :: expr_meta.Parsed), ...) $rest ...':
        values(
          'build_membership_predicate($left, [$candidate, ...]) :: Bool',
          '$rest ...'
        )
    | 'is($(variant :: expr_meta.Parsed)) $rest ...':
        values(
          'hardware_variant_is($left, $variant) :: HardwareFields',
          '$rest ...'
        )
    | 'view($(variant :: expr_meta.Parsed)) $rest ...':
        values(
          'hardware_variant_view($left, $variant) :: HardwareVariantViewFields',
          '$rest ...'
        )
    | 'map($(element :: Identifier) => $body ...) $rest ...':
        values(
          'hardware_vector_map($left, fun ($element): $body ...) :: HardwareFields',
          '$rest ...'
        )
    | 'lookup($(selector :: expr_meta.Parsed),
              ~default: $(default_value :: expr_meta.Parsed)) $rest ...':
        values(
          'hardware_lookup($left, $selector, ~default: $default_value) :: HardwareFields',
          '$rest ...'
        )
    | '$(method :: Identifier)($(argument :: expr_meta.Parsed), ...) $rest ...':
        def universal = universal_hardware_method(left, method)
        if universal
        | values(universal, '($argument, ...) $rest ...')
        | block:
            def arity = statinfo_meta.lookup(
              method,
              statinfo_meta.function_arity_key
            )
            if arity && statinfo_meta.check_function_arity(
                 arity,
                 [argument, ...].length() + 1,
                 []
               )
            | // A compatible ordinary lexical function is an import-scoped
              // extension method. A direct call preserves its result annotation.
              values('$method($left, $argument, ...)', '$rest ...')
            | // An incompatible binding is not an extension candidate. Let the
              // receiver's field or host-object provider resolve the name.
              #false
    | ~else:
        def expansion = universal_hardware_method(left, right)
        if expansion
        | values(expansion, remainder)
        | #false

// Exact receiver-owned annotations use a distinct provider identity so their
// full method pipeline precedes conservative surfaces such as observations.
dot.macro 'hardware_value_method_dot $left $dot $right':
  ~tail: '$tail ...'
  def packed_methods = statinfo_meta.find(
    statinfo_meta.gather(left),
    'hardware_method_static_info_key'
  )
  def mutable expansion = #false
  when packed_methods
  | let '($method_entry, ...)' = packed_methods
    for (entry in [method_entry, ...]):
      match entry
      | '($(method_name :: Identifier), $method_function, ($argument, ...), untyped)':
          when !expansion && right.to_source_string() == method_name.to_source_string()
          | expansion := 'fun ($argument, ...) :~ HardwareFields:
                            $method_function($left, $argument, ...)'
      | '($(method_name :: Identifier), $method_function, ($argument, ...), (typed ($result_type)))':
          when !expansion && right.to_source_string() == method_name.to_source_string()
          | expansion := 'fun ($argument, ...) :: $result_type:
                            $method_function($left, $argument, ...)'
      | ~else:
          syntax_meta.error("invalid hardware method static information", entry)
  if expansion
  | expansion
  | common_hardware_method(left, right, '$right $tail ...', '$tail ...')

// Generic hardware-capable surfaces use the same common method implementation
// after their specialized providers decline the call.
dot.macro 'hardware_method_dot $left $dot $right':
  ~tail: '$tail ...'
  common_hardware_method(left, right, '$right $tail ...', '$tail ...')

// Resolves hardware properties and structural projection only after every
// receiver-owned, surface-specific, and universal method provider declines.
dot.macro 'hardware_field_dot $left $dot $right':
  ~tail: '$tail ...'
  // Static-information composition can reorder providers, so structural
  // projection must independently decline syntax that belongs to methods.
  match '$right $tail ...'
  | 'lookup($(selector :: expr_meta.Parsed),
            ~default: $(default_value :: expr_meta.Parsed)) $rest ...': #false
  | '$(method :: Identifier)($argument, ...) $rest ...': #false
  | ~else:
      def reserved = [
        "id", "name", "module_def", "module_id", "design",
        "defining_op_id", "users", "ref", "owner_op_id", "driver",
        "operation", "literal_type", "packed_value", "literal_name",
        "literal_width", "current"
      ].contains(right.to_source_string())
      def expansion:
        match right
        | 'type': 'hardware_value_type($left) :: HardwareType'
        | 'next': 'hardware_next($left) :: HardwareFields'
        | 'tag': 'hardware_variant_tag_or_project($left) :: HardwareFields'
        | ~else: #false
      if expansion
      | values(expansion, '$tail ...')
      | if reserved
        | #false
        | values(
            'kernel.project($left, $(right.to_source_string())) :: HardwareFields',
            '$tail ...'
          )
