#lang rhombus/and_meta
// Extracts runtime bindings from the supported host generator-parameter forms.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/meta open

meta:
  export:
    GeneratorParameter
    substitute_generator_parameters

  syntax_class GeneratorParameter
  | '$(keyword :: Keyword): $(binding :: Identifier) $_ ...'
  | '$(binding :: Identifier) $_ ...'

  // Rewrites references in a generated result surface to the use site's
  // argument syntax. Type expressions commonly nest parameters in calls,
  // arithmetic, and host-object member access.
  fun substitute_generator_parameters(form :: Syntax,
                                      bindings :: List.of(Identifier)):
    match form
    | '$(identifier :: Identifier)':
        def mutable substituted = form
        for (binding in bindings):
          when identifier.to_source_string() == binding.to_source_string()
          | substituted := '$('$')$binding'
        substituted
    | '$constructor($item, ...) $(operator :: Operator) $right':
        def substituted_constructor = substitute_generator_parameters(
          constructor,
          bindings
        )
        let [substituted_item, ...]:
          for List (part in [item, ...]):
            substitute_generator_parameters(part, bindings)
        def substituted_right = substitute_generator_parameters(right, bindings)
        match operator.unwrap_op()
        | #'#{|.|}:
            '($substituted_constructor($substituted_item, ...)) . $substituted_right'
        | ~else: form
    | '$constructor($item, ...)':
        def substituted_constructor = substitute_generator_parameters(
          constructor,
          bindings
        )
        let [substituted_item, ...]:
          for List (part in [item, ...]):
            substitute_generator_parameters(part, bindings)
        '$substituted_constructor($substituted_item, ...)'
    | '$left $(operator :: Operator) $right':
        def substituted_left = substitute_generator_parameters(left, bindings)
        def substituted_right = substitute_generator_parameters(right, bindings)
        match operator.unwrap_op()
        | #'#{|.|}: '($substituted_left) . $substituted_right'
        | #'#{+}: '$substituted_left + $substituted_right'
        | #'#{-}: '$substituted_left - $substituted_right'
        | #'#{*}: '$substituted_left * $substituted_right'
        | #'#{/}: '$substituted_left / $substituted_right'
        | ~else: form
    | ~else: form
