#lang rhombus
/* Defines shared typed-key protocols for frontend mux lookup extensions. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../../core/types.rhm" open
  "hardware-literal.rhm" open
  "../../../support/hardware-data.rhm".MuxLookupKey
  "../../../support/hardware-data.rhm".MuxLookupSelectorType
  "../../../support/hardware-data.rhm".OneHotSelectorType

export:
  MuxLookupKey
  MuxLookupSelectorType
  OneHotSelectorType
  mux_lookup_literal

/*
 * A single semantic literal adapter serves every typed mux-key space. Types
 * retain responsibility for validating which packed encodings are legal keys.
 */
class MuxLookupLiteral(literal :: HardwareLiteral):
  implements MuxLookupKey
  /* Forwards the wrapped literal's hardware type. */
  override method literal_type(): literal.literal_type()
  /* Forwards the wrapped literal's packed integer. */
  override method packed_value(): literal.packed_value()
  /* Preserves the wrapped literal's optional constant name. */
  override method literal_name(): literal.literal_name()

/* Wraps a validated typed packed literal as a selector-normalizable lookup key. */
fun mux_lookup_literal(type :: DataType, encoding :: Nat):
  MuxLookupLiteral(packed_literal(type, encoding))
