#lang rhombus
// Carries sync-circuit metadata and expands ambient clock/reset policy into explicit kernel operations.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../support/annotations.rhm" open
  "../../core/ir.rhm" open
  "../../core/types.rhm" open
  "../../analysis/clocking/module.rhm".verify_single_clock
  "../kernel.rhm" as kernel
  "../kernel.rhm".CircuitDefinition

export:
  SyncCircuitMetadata
  module_sync_circuit_metadata
  build_sync_circuit
  ambient_clock
  ambient_reset_active
  ambient_reset_when
  reject_explicit_sync_control
  ambient_register
  ambient_reset_register
  ambient_memory_write
  ambient_sync_memory
  ambient_assert
  ambient_dpi_call
  ambient_dpi_register
  ambient_dpi_register_results
  instantiate
  instantiate_reset_when

class SyncDomain(clock :: Value, reset :: Value)

// Marks the implicit control ports introduced by sync_circuit so inspection
// tools can distinguish them from explicitly authored Clock and Reset ports.
class SyncCircuitMetadata(clock_port :: AsciiIdentifier,
                          reset_port :: AsciiIdentifier):
  implements ModuleMetadataPayload

def sync_circuit_metadata_namespace = "rhodium.sync-circuit"

fun module_sync_circuit_metadata(module_def :: Module):
  module_def.metadata_for(sync_circuit_metadata_namespace).find(
    fun (candidate):
      candidate is_a SyncCircuitMetadata
  )

// This wrapper is frontend-only. Its core module still contains ordinary
// clock/reset ports, register operands, instance inputs, and drives.
class SyncCircuitDefinition(module_def :: Module,
                            clock_port :: AsciiIdentifier = "clock",
                            reset_port :: AsciiIdentifier = "reset"):
  implements CircuitDefinition
  override method core_module(): module_def

Parameter.def current_sync_domain = #false

fun sync_fail(message :: String, location :: Location = Location()):
  error(~who: #'sync_circuit, location.describe() ++ ": " ++ message)

fun active_sync_domain(location :: Location = Location()):
  def domain = current_sync_domain()
  if domain is_a SyncDomain && domain.clock.module_def === kernel.active_module(location)
  | domain
  | #false

fun require_sync_domain(location :: Location = Location()):
  def domain = active_sync_domain(location)
  unless domain
  | sync_fail("implicit clock/reset use requires an active sync_circuit", location)
  domain

fun reject_explicit_sync_control(location :: Location = Location()):
  when active_sync_domain(location)
  | sync_fail(
      "explicit clock/reset controls are not allowed inside sync_circuit; use the ambient domain or reset_when",
      location
    )

fun ambient_reset_when(condition :: HardwareEntity,
                       body :: Function.of_arity(0),
                       location :: Location = Location()):
  def domain = require_sync_domain(location)
  def condition_value = kernel.read(condition, location)
  unless (data_type(condition_value.type) || reset_type(condition_value.type)) && condition_value.type.packed_width() == 1
  | sync_fail("reset_when condition must be readable one-bit data or Reset",
              location)
  def ambient_bits = kernel.cast(domain.reset, Bits(1), #false, location)
  def condition_bits = kernel.cast(condition_value, Bits(1), #false, location)
  def combined_bits = kernel.bit_or(ambient_bits,
                                    condition_bits,
                                    #false,
                                    location)
  def combined_reset = kernel.cast(combined_bits, Reset, #false, location)
  parameterize { current_sync_domain: SyncDomain(domain.clock, combined_reset) }:
    body()

fun ambient_reset_active(location :: Location = Location()):
  def domain = require_sync_domain(location)
  kernel.cast(domain.reset, Bits(1), #false, location)

fun ambient_clock(location :: Location = Location()):
  require_sync_domain(location).clock

fun build_sync_circuit(identity :: kernel.CircuitIdentity,
                       name :: String,
                       arguments :: List,
                       implementation :: Function.of_arity(0),
                       location :: Location = Location()):
  def module_def = kernel.build_circuit(
    identity,
    name,
    arguments,
    fun ():
      def clock_port = "clock"
      def reset_port = "reset"
      kernel.active_module(location).add_metadata(
        sync_circuit_metadata_namespace,
        SyncCircuitMetadata(clock_port, reset_port)
      )
      def clock = kernel.input(clock_port, Clock, location)
      def reset = kernel.input(reset_port, Reset, location)
      parameterize { current_sync_domain: SyncDomain(clock, reset) }:
        implementation()
        kernel.run_circuit_finalizers(),
    location
  )
  verify_single_clock(module_def,
                      module_def.find_input("clock").value,
                      module_def.find_input("reset").value)
  SyncCircuitDefinition(module_def)

fun ambient_register(name :: AsciiIdentifier,
                     type :: DataType,
                     location :: Location = Location()):
  def domain = require_sync_domain(location)
  kernel.reg(name, type, domain.clock, #false, #false, location)

fun ambient_reset_register(name :: AsciiIdentifier,
                           type :: DataType,
                           reset_value :: HardwareEntity,
                           location :: Location = Location()):
  def domain = require_sync_domain(location)
  kernel.reg(name, type, domain.clock, domain.reset, reset_value, location)

fun ambient_memory_write(memory :: Memory,
                         address :: HardwareEntity,
                         data :: HardwareEntity,
                         enable :: HardwareEntity,
                         location :: Location = Location()):
  def domain = require_sync_domain(location)
  kernel.memory_write(memory, address, data, domain.clock, enable, location)

fun ambient_sync_memory(name :: AsciiIdentifier,
                        depth :: PosInt,
                        element_type :: DataType,
                        has_read :: Boolean,
                        has_write :: Boolean,
                        has_read_write :: Boolean,
                        mask_granularity :: False || PosInt = #false,
                        location :: Location = Location()):
  def domain = require_sync_domain(location)
  kernel.sync_memory(name,
                     depth,
                     element_type,
                     domain.clock,
                     has_read,
                     has_write,
                     has_read_write,
                     mask_granularity,
                     location)

fun ambient_assert(condition :~ HardwareEntity,
                   label :: False || AsciiIdentifier = #false,
                   location :: Location = Location()):
  def domain = require_sync_domain(location)
  kernel.assert(condition,
                domain.clock,
                domain.reset,
                label,
                location)

fun ambient_dpi_call(dpi_import :: DpiImport,
                     inputs :: List.of(HardwareEntity),
                     enable :: HardwareEntity,
                     location :: Location = Location()):
  def domain = require_sync_domain(location)
  kernel.dpi_call(dpi_import, inputs, domain.clock, enable, location)

fun ambient_dpi_register(name :: AsciiIdentifier,
                         dpi_import :: DpiImport,
                         inputs :: List.of(HardwareEntity),
                         enable :: HardwareEntity,
                         location :: Location = Location()):
  def domain = require_sync_domain(location)
  kernel.dpi_register(name, dpi_import, inputs, domain.clock, enable, location)

fun ambient_dpi_register_results(
      result_names :: List.of(AsciiIdentifier),
      dpi_import :: DpiImport,
      inputs :: List.of(HardwareEntity),
      enable :: HardwareEntity,
      location :: Location = Location()):
  def domain = require_sync_domain(location)
  kernel.dpi_register_results(result_names,
                              dpi_import,
                              inputs,
                              domain.clock,
                              enable,
                              location)

// Only marked sync children participate in propagation. Ordinary circuits are
// never inferred to be synchronous from their port names or control types.
fun instantiate(name :: AsciiIdentifier,
                child :: Module || CircuitDefinition,
                clock :: False || HardwareEntity = #false,
                reset :: False || HardwareEntity = #false,
                location :: Location = Location()):
  when clock || reset
  | reject_explicit_sync_control(location)
  if child is_a SyncCircuitDefinition
  | block:
      def domain:
        if clock || reset
        | block:
            unless clock && reset
            | sync_fail("explicit sync child wiring requires both clock and reset",
                        location)
            SyncDomain(clock, reset)
        | require_sync_domain(location)
      def instance = kernel.inst(name, child, location)
      kernel.connect(instance.input(child.clock_port), domain.clock, location)
      kernel.connect(instance.input(child.reset_port), domain.reset, location)
      instance
  | block:
      when clock || reset
      | sync_fail("clock/reset overrides require a sync_circuit child", location)
      kernel.inst(name, child, location)

fun instantiate_reset_when(name :: AsciiIdentifier,
                           child :~ SyncCircuitDefinition,
                           condition :: HardwareEntity,
                           location :: Location = Location()):
  unless child is_a SyncCircuitDefinition
  | sync_fail("~reset_when requires a sync_circuit child", location)
  ambient_reset_when(
    condition,
    fun (): instantiate(name, child, #false, #false, location),
    location
  )
