#lang rhombus/and_meta
// Provides shared instance-member and chained hardware-field syntax for hierarchy-aware layers.

import:
  rhombus/meta open
  "../../core/ir.rhm" open
  "../kernel.rhm" as kernel
  "fields.rhm".HardwareFields
  "fields.rhm".HardwareMethodFields
  "fields.rhm".hardware_index

export:
  InstanceMembers
  instance_member
  register_member_resolver

def mutable member_resolvers = []

// Lets a layer contribute virtual members, such as reconstructed interface
// endpoints, without making the generic hierarchy layer import that layer.
fun register_member_resolver(resolver :: Function.of_arity(2)):
  member_resolvers := member_resolvers ++ [resolver]

fun resolved_member(value :: HardwareEntity || Array, name :: String):
  def mutable resolved = #false
  for (resolver in member_resolvers):
    unless resolved
    | resolved := resolver(value, name)
  resolved

fun instance_member(instance :: Instance, name :: String):
  def input_binding = instance.input_bindings.find(
    fun (candidate): candidate.name == name
  )
  if input_binding
  | input_binding.place
  | block:
      def output_binding = instance.output_bindings.find(
        fun (candidate): candidate.name == name
      )
      if output_binding
      | output_binding.value
      | block:
          def resolved = resolved_member(instance, name)
          unless resolved
          | error(~who: #'inst,
                  String.append("instance ",
                                instance.operation.attribute("name"),
                                " has no port or interface named ",
                                name))
          resolved

fun hardware_member(value :: HardwareEntity || Array, name :: String):
  if value is_a Instance
  | instance_member(value, name)
  | block:
      def resolved = resolved_member(value, name)
      if resolved | resolved | kernel.project(value, name)

annot.macro 'InstanceMembers':
  let '$(base :: annot_meta.Parsed)' = 'HardwareMethodFields'
  def (_base_predicate, base_infos) = annot_meta.unpack_predicate(base)
  def result_infos = statinfo_meta.and(
    '(($(statinfo_meta.dot_provider_key), instance_member_dot),
      ($(statinfo_meta.index_get_key), instance_member_index))',
    base_infos
  )
  annot_meta.pack_predicate(
    'fun (value): value is_a HardwareEntity || value is_a Array',
    result_infos
  )

// Keeps host-array indexing available after a virtual instance member has been
// reconstructed, while retaining ordinary hardware indexing for data values.
fun instance_member_index(value :: HardwareEntity || Array,
                          index :: Nat || Range || HardwareEntity) :~ InstanceMembers:
  if value is_a Array
  | block:
      unless index is_a Nat
      | error(~who: #'inst, "interface array index must be a host natural number")
      value[index]
  | hardware_index(value, index)

dot.macro 'instance_member_dot $left $dot $right':
  ~tail: '$tail ...'
  match '$right $tail ...'
  | 'lookup($(selector :: expr_meta.Parsed),
            ~default: $(default_value :: expr_meta.Parsed)) $rest ...': #false
  | '$(method :: Identifier)($argument, ...) $rest ...': #false
  | ~else:
      def expansion:
        match right
        | 'id': #false
        | 'name': #false
        | 'type': #false
        | 'role': #false
        | 'bindings': #false
        | 'view': #false
        | 'module_def': #false
        | 'module_id': #false
        | 'design': #false
        | 'defining_op_id': #false
        | 'users': #false
        | 'ref': #false
        | 'owner_op_id': #false
        | 'driver': #false
        | 'operation': #false
        | 'current': #false
        | 'next': #false
        | ~else: 'hardware_member($left, $(right.to_source_string())) :: InstanceMembers'
      if expansion
      | values(expansion, '$tail ...')
      | #false
