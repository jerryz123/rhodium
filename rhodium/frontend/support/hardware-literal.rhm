#lang rhombus
// Defines host-side typed literal shadows and their generic packed materialization.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../core/ir.rhm" open
  "../kernel.rhm" as kernel

export:
  HardwareLiteral
  PackedLiteral
  packed_literal
  require_hardware_literal

// A HardwareLiteral is immutable host data describing one exact packed image
// of a DataType. Extensions may define any number of literal classes for the
// same hardware type by implementing this protocol.
interface HardwareLiteral:
  extends kernel.StaticHardwareValue
  extends kernel.StableCircuitParam
  method literal_type()
  method packed_value()
  method literal_name(): #false
  method literal_width(): this.literal_type().packed_width()

  override method same_stable_circuit_param(other :: kernel.StableCircuitParam):
    other is_a HardwareLiteral && type_equal(this.literal_type(), other.literal_type()) && this.packed_value() == other.packed_value() && this.literal_name() == other.literal_name()

  // Core constants intentionally remain Bits-only. Materializing any literal
  // therefore creates its canonical packed Bits image and then explicitly
  // casts that image to the literal's declared type.
  override method materialize_hardware(location :: Location):
    def type = this.literal_type()
    def value = this.packed_value()
    def name = this.literal_name()
    validate_literal_parts(type, value, name, location)
    def width = type.packed_width()
    if bits_type(type)
    | kernel.literal(type, value, name, location)
    | kernel.cast(kernel.literal(Bits(width), value, #false, location),
                  type,
                  name,
                  location)

fun validate_literal_parts(type :: DataType,
                           value :: Nat,
                           name :: False || String,
                           location :: Location = Location()):
  unless type_well_formed(type)
  | kernel.frontend_fail("hardware literal type must be a well-formed DataType",
                         location)
  def width = type.packed_width()
  unless width is_a PosInt
  | kernel.frontend_fail("hardware literal type must have a packed representation",
                         location)
  unless bits.length(value) <= width
  | def message = "hardware literal packed value " ++ to_string(value) ++ " does not fit " ++ type.describe()
    kernel.frontend_fail(message, location)

// The generic shadow represents every packed image of every packable
// DataType. More semantic shadows such as Bool and enum members implement the
// same protocol while restricting their convenient constructors.
class PackedLiteral(type :: DataType,
                    value :: Nat,
                    name :: False || String = #false):
  implements HardwareLiteral
  constructor (type :: DataType,
               value :: Nat,
               name :: False || String = #false):
    validate_literal_parts(type, value, name)
    super(type, value, name)

  override method literal_type(): type
  override method packed_value(): value
  override method literal_name(): name

fun packed_literal(type :: DataType,
                   value :: Nat,
                   name :: False || String = #false):
  PackedLiteral(type, value, name)

fun require_hardware_literal(value :: HardwareLiteral,
                             who :: Symbol = #'HardwareLiteral):
  value
