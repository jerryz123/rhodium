/*
 * Opts an immutable host value into circuit specialization reuse. Ordinary
 * equality is the default; implementations may supply semantic equality.
 */
interface StableCircuitParam:
  /* Supplies semantic host equality for specialization reuse; the default uses ordinary equality. */
  method same_stable_circuit_param(other :: StableCircuitParam) :: Boolean:
    this == other

/* Exposes signature-bearing references independently of concrete implementations. */
interface CircuitDefinition:
  /* Returns a signature-bearing circuit reference without executing its implementation. */
  method definition_reference()

/* Normalizes a concrete module or frontend definition into a circuit reference. */
fun circuit_reference(definition :: Module || CircuitDefinition,
                      location :: Location = Location()):
  cond
  | definition is_a Module:
      CircuitReference(new_circuit_identity(definition.name),
                       module_signature(definition),
                       fun (): definition)
  | ~else:
      def reference = definition.definition_reference()
      unless reference is_a CircuitReference
      | frontend_fail("circuit definition must provide a circuit reference", location)
      reference

/* Inspects the normalized reference's physical signature without materializing its recipe. */
fun circuit_signature(definition :: Module || CircuitDefinition):
  circuit_reference(definition).signature

/* Resolve ordinary recipes once per context and certify their signature and layer
   declarations before caching the finished body; reject recursive construction. */
fun materialize_circuit(definition :: Module || CircuitDefinition,
                        location :: Location = Location()):
  def context = require_context(location)
  def reference = circuit_reference(definition, location)
  def cached = context.materialized_circuits.get(reference, #false)
  if cached
  | cached
  | block:
      when reference in context.materializing_circuits
      | frontend_fail("recursive materialization of circuit " ++ reference.identity.name, location)
      context.materializing_circuits.add(reference)
      try:
        def implementation = reference.implementation()
        def module_def:
          cond
          | implementation is_a Module: implementation
          | implementation is_a CircuitDefinition: materialize_circuit(implementation, location)
          | ~else: frontend_fail("circuit implementation must return a module or circuit definition", location)
        unless module_def.design === context.design && context.design.owns_module(module_def)
        | frontend_fail("circuit implementation belongs to a different design", location)
        unless module_def.finished
        | frontend_fail("circuit implementation must be a finished module", location)
        unless signature_equal(reference.signature, module_signature(module_def))
        | frontend_fail("circuit implementation does not match the declared signature of " ++ reference.identity.name, location)
        for (declaration in reference.declarations): declaration.validate_implementation(module_def)
        context.materialized_circuits[reference] := module_def
        module_def
        ~finally:
          context.materializing_circuits.remove(reference)

/* Reports a frontend construction error with its source location. */
fun frontend_fail(message :: String, location :: Location = Location()):
  error(~who: #'rhodium, location.describe() ++ ": " ++ message)

/*
 * Lets frontend layers retain authoring metadata until a value is actually
 * consumed by hardware construction.
 */
interface DeferredHardwareValue:
  extends HardwareEntity
  /* Realizes the deferred description as readable hardware in the active elaboration. */
  method materialize_hardware(location :: Location)

/*
 * Marks deferred hardware descriptions that contain no circuit-bound values.
 * Unlike Values, Places, and other live hardware entities, these host values
 * may safely cross a circuit-generator parameter boundary.
 */
interface StaticHardwareValue:
  extends DeferredHardwareValue

/*
 * Carries one register-relative path with its current-state value and its
 * next-state place until a read or drive context selects the appropriate side.
 */
interface RegisterPathValue:
  extends DeferredHardwareValue
  /* Returns the register-relative next-state place for assignment. */
  method drive_hardware(location :: Location)

/*
 * Lets a frontend-only lvalue lower an assignment without pretending that a
 * runtime-selected destination is a structural core Place.
 */
interface DynamicAssignmentTarget:
  extends DeferredHardwareValue
  /* Lowers a source assignment to this runtime-selected frontend lvalue. */
  method assign_hardware(entity :: HardwareEntity, location :: Location)

/* Retains a lazily cached current-state projection and its corresponding next-state place. */
class RegisterPath(materialize_current :: Function.of_arity(0),
                   next :: Place,
                   mutable current :: maybe(Value) = #false):
  implements RegisterPathValue

  /* Materializes and caches the current-state projection on its first read. */
  override method materialize_hardware(location :: Location):
    unless current
    | current := materialize_current()
    current
  /* Returns the stored next-state place without reading the register. */
  override method drive_hardware(location :: Location): next

/* Identifies one circuit declaration independently of its display name or specializations. */
class CircuitIdentity(name :: String)

/* A layer-owned immutable description of grouped circuit members.
   Descriptors contain no live IR; the kernel owns attachment and validation timing. */
interface CircuitDeclaration:
  /* List exposed logical member names so the kernel can reject shadowing and collisions. */
  method member_names() :: List.of(String)
  /* List physical ports owned by this declaration to reject overlapping ownership. */
  method port_names() :: List.of(String)
  /* Check that the detached physical boundary can represent this declaration. */
  method validate_signature(signature :: ModuleSignature)
  /* Certify that a finished concrete body realizes the declared logical interface. */
  method validate_implementation(module_def :: Module)
  /* Bind a declared logical member to an instance boundary. */
  method member(instance :: HardwareEntity, name :: String)

/* Reject logical-name collisions and overlapping physical-port ownership, then
   let each layer check its portion of the detached signature. */
fun validate_declarations(signature :: ModuleSignature, declarations :: List.of(CircuitDeclaration)):
  def members = MutableSet{}
  def ports = MutableSet{}
  for (declaration in declarations):
    for (name in declaration.member_names()):
      when name in members || signature.input(name) || signature.output(name)
      | frontend_fail("duplicate or shadowed declared circuit member " ++ name)
      members.add(name)
    for (name in declaration.port_names()):
      when name in ports | frontend_fail("overlapping circuit declaration port " ++ name)
      ports.add(name)
    declaration.validate_signature(signature)

/* Attaches detached member descriptions to one exact parent-owned instance operation. */
class CircuitInstanceDeclarations(operation :: Operation, declarations :: List.of(CircuitDeclaration)):
  implements ModuleMetadataPayload
  /* Rebind instance identity while sharing immutable declaration descriptors. */
  override method remap_ir(remap :: Function.of_arity(1)):
    CircuitInstanceDeclarations(remap(operation), declarations)

/* Find declarations by operation identity and ask the owning layer to bind a member.
   Return false when this instance has no declaration for the requested name. */
fun declared_instance_member(instance :: Instance, name :: String):
  def payload = instance.operation.module_def.metadata_for("rhodium.circuit.declarations").find(
    fun (entry): entry.operation === instance.operation
  )
  if payload
  | def declaration = payload.declarations.find(fun (entry): name in entry.member_names())
    declaration && declaration.member(instance, name)
  | #false

/* A detached physical signature and ordinary frontend recipe, materialized on demand.
   Layer declarations are checked before the resulting body can be reused. */
class CircuitReference(identity :: CircuitIdentity,
                       signature :: ModuleSignature,
                       implementation :: Function.of_arity(0),
                       clock_port :: maybe(String) = #false,
                       reset_port :: maybe(String) = #false,
                       declarations :: List.of(CircuitDeclaration) = []):
  implements CircuitDefinition
  /* Validate detached declarations and require paired, correctly typed sync controls. */
  constructor (identity :: CircuitIdentity,
               signature :: ModuleSignature,
               implementation :: Function.of_arity(0),
               clock_port :: maybe(String) = #false,
               reset_port :: maybe(String) = #false,
               ~declarations: declarations :: List.of(CircuitDeclaration) = []):
    validate_declarations(signature, declarations)
    unless (!clock_port && !reset_port) || (clock_port && reset_port)
    | frontend_fail("sync circuit signature requires both clock and reset ports")
    when clock_port && reset_port
    | def clock = signature.input(clock_port)
      def reset = signature.input(reset_port)
      unless clock && clock_type(clock.type) && reset && reset_type(reset.type)
      | frontend_fail("sync circuit signature requires Clock and Reset input ports")
    super(identity, signature, implementation, clock_port, reset_port, declarations)

  /* Keep the detached recipe available for specialization and instance construction. */
  override method definition_reference(): this

class.together:
  /* Tracks one active declaration's pending finalizers and dynamic vector-register writes. */
  class ActiveCircuit(identity :: CircuitIdentity,
                      name :: String,
                      mutable finalizers :: List.of(Function.of_arity(0)) = [],
                      mutable vector_writes :: List.of(ConditionalVectorWrite) = [])
  /* Records one vector-register write's selector, data, enable, and diagnostic location. */
  class ConditionalVectorWrite(register :: Register,
                               index :: Value,
                               data :: Value,
                               enable :: Value,
                               location :: Location)
/* Pairs normalized stable generator arguments with their finished reusable module. */
class CircuitSpecialization(arguments :: List, module_def :: Module)

/* Allocates a fresh nominal identity for a circuit declaration. */
fun new_circuit_identity(name :: String):
  CircuitIdentity(name)

/* Owns one elaboration's Builder, active circuits, specialization/reference caches, and symbol allocation. */
class FrontendContext(design :: Design,
                      builder :: Builder,
                      mutable active :: Boolean = #true,
                      mutable active_circuits :: List.of(ActiveCircuit) = [],
                      specializations_by_circuit :: MutableMap = MutableMap.by(===){},
                      materialized_circuits :: MutableMap = MutableMap.by(===){},
                      materializing_circuits :: MutableSet = MutableSet.by(===){},
                      mutable allocated_symbols :: List.of(String) = []):
  /* Allocates a deterministic elaboration-local name, suffixing repeated base names. */
  method allocate_symbol(circuit_name :: String):
    def base = circuit_name
    def count = allocated_symbols.filter(
      ~keep: fun (symbol): symbol == base
    ).length()
    allocated_symbols := allocated_symbols ++ [base]
    if count == 0
    | base
    | base ++ "_" ++ to_string(count)

Parameter.def current_context = #false
Parameter.def current_module = #false
Parameter.def current_conditional_branch = #false
Parameter.def current_conditional_form = "when"

/* Records a branch-local destination and its selected source value. */
class ConditionalAssignment(place :: Place, value :: Value)
/* Records a memory write's resource, address, data, clock, enable, and source location. */
class ConditionalMemoryWrite(resource :: Memory,
                             address :: Value,
                             data :: Value,
                             clock :: Value,
                             enable :: Value,
                             location :: Location)
/* Records a clocked assertion with reset suppression and an optional accumulated lexical guard. */
class ConditionalAssertion(condition :: Value,
                           clock :: Value,
                           reset :: Value,
                           guard :: maybe(Value),
                           label :: maybe(AsciiIdentifier),
                           location :: Location)

/*
 * Collects assignments and supported effects along one mutually exclusive
 * hardware branch for guarded resolution after elaboration.
 */
class ConditionalBranch(
      mutable assignments :: List.of(ConditionalAssignment) = [],
      mutable memory_writes :: List.of(ConditionalMemoryWrite) = [],
      mutable vector_writes :: List.of(ConditionalVectorWrite) = [],
      mutable assertions :: List.of(ConditionalAssertion) = []):
  /* Finds this branch's assignment to an exact place, or returns false. */
  method assignment_for(place :: Place):
    assignments.find(
      fun (assignment): assignment.place === place
    )

  /* Returns this branch's writes to one memory resource in source order. */
  method memory_writes_for(resource :: Memory):
    memory_writes.filter(
      ~keep: fun (write): write.resource === resource
    )

  /* Returns this branch's writes to one vector register in source order. */
  method vector_writes_for(register :: Register):
    vector_writes.filter(
      ~keep: fun (write): write.register === register
    )

  /* Rejects repeated writes to the same place within a branch before recording the assignment. */
  method add(place :: Place, value :: Value, location :: Location):
    when this.assignment_for(place)
    | frontend_fail("conditional branch assigns " ++ place.name ++ " more than once",
                    location)
    assignments := assignments ++ [ConditionalAssignment(place, value)]

  /* Appends a memory write to this branch's ordered effect list. */
  method add_memory_write(write :: ConditionalMemoryWrite):
    memory_writes := memory_writes ++ [write]

  /* Appends a dynamic vector-register write to this branch's ordered effect list. */
  method add_vector_write(write :: ConditionalVectorWrite):
    vector_writes := vector_writes ++ [write]

  /* Appends a guarded clocked assertion to this branch. */
  method add_assertion(assertion :: ConditionalAssertion):
    assertions := assertions ++ [assertion]

/*
 * Prevents effects with no conditional-lowering protocol from escaping a
 * hardware branch without an explicit guard in their own semantics.
 */
fun reject_unsupported_conditional_effect(
      effect :: String,
      location :: Location = Location(),
      guidance :: String = "use ~enable for hardware control"):
  when current_conditional_branch() is_a ConditionalBranch
  | frontend_fail(String.append(effect, " is not supported inside ",
                                current_conditional_form(), "; ", guidance),
                  location)

/* Requires an active, unclosed frontend elaboration context. */
fun require_context(location :: Location = Location()):
  def context = current_context()
  unless context is_a FrontendContext && context.active
  | frontend_fail("circuit generators may only be called during elaborate", location)
  context

/* Requires a current module for hardware construction. */
fun require_module(location :: Location = Location()):
  def module_def = current_module()
  unless module_def is_a Module
  | frontend_fail("hardware construction requires an active circuit", location)
  module_def

/* Returns the current module after checking the elaboration context is still active. */
fun active_module(location :: Location = Location()):
  require_context(location)
  require_module(location)

/*
 * Allocates a deterministic elaboration-local hardware name for frontend
 * facilities that introduce anonymous connection structure.
 */
fun fresh_name(base :: String, location :: Location = Location()):
  require_context(location).allocate_symbol(base)

/* Materializes deferred descriptions, reads places, and selects registers' current values; rejects unreadable entities. */
fun read(entity :~ HardwareEntity, location :: Location = Location()):
  def context = require_context(location)
  cond
  | entity is_a DeferredHardwareValue:
      entity.materialize_hardware(location)
  | entity is_a Value: entity
  | entity is_a Register: entity.current
  | entity is_a Place:
      context.builder.read(entity)
  | ~else:
      frontend_fail("expected readable hardware data", location)

/*
 * Defers source-order-independent elaboration collateral until the active
 * circuit body has created and driven all of its declared hardware places.
 */
fun defer_circuit_finalizer(finalizer :: Function.of_arity(0),
                            location :: Location = Location()):
  def context = require_context(location)
  unless context.active_circuits.length() > 0
  | frontend_fail("circuit finalizer requires an active circuit", location)
  def active = context.active_circuits[context.active_circuits.length() - 1]
  active.finalizers := active.finalizers ++ [finalizer]
  #void

/* Drains the current circuit's pending callbacks, then lowers its accumulated vector-register writes. */
fun run_circuit_finalizers(location :: Location = Location()):
  def context = require_context(location)
  unless context.active_circuits.length() > 0
  | frontend_fail("circuit finalizers require an active circuit", location)
  def active = context.active_circuits[context.active_circuits.length() - 1]
  def finalizers = active.finalizers
  active.finalizers := []
  for (finalizer in finalizers): finalizer()
  flush_vector_register_writes(active, location)
  #void

/* Recognizes immutable scalar/list parameters, hardware descriptors, and explicit stable-parameter implementations. */
fun stable_circuit_param_value(value :~ matching(_)):
  cond
  | value is_a Boolean || value is_a Int || value is_a String || value is_a Symbol: #true
  | value is_a List:
      for all (element in value): stable_circuit_param_value(element)
  | value is_a HardwareType || value is_a StableCircuitParam: #true
  | ~else: #false

/*
 * Compares arbitrary host arguments for semantic uses such as interface
 * compatibility. Cache reuse separately requires every argument to be stable.
 */
fun circuit_arguments_same(left :~ matching(_), right :~ matching(_)):
  cond
  | left is_a List && right is_a List:
      circuit_argument_lists_same(left, right)
  | left is_a HardwareType && right is_a HardwareType: type_equal(left, right)
  | left is_a StableCircuitParam && right is_a StableCircuitParam:
      left.same_stable_circuit_param(right) && right.same_stable_circuit_param(left)
  | ~else: left == right

/* Compares equal-length normalized argument lists element by element. */
fun circuit_argument_lists_same(left :: List, right :: List):
  left.length() == right.length() && (
    for all (left_value in left, right_value in right):
      circuit_arguments_same(left_value, right_value)
  )

/* Rejects live hardware parameters and recursion, reuses stable specializations, or builds and finalizes a new module. */
fun build_circuit(identity :: CircuitIdentity,
                  name :: String,
                  arguments :: List,
                  implementation :: Function.of_arity(0),
                  location :: Location = Location()):
  def context = require_context(location)
  for (argument in arguments, index in 0..arguments.length()):
    when argument is_a HardwareEntity && !(argument is_a StaticHardwareValue)
    | frontend_fail("circuit parameter " ++ to_string(index) ++ " must be a host value, not live hardware", location)
  def reusable = for all (argument in arguments): stable_circuit_param_value(argument)
  def specializations = reusable && context.specializations_by_circuit.get(identity, #false)
  def cached = specializations && specializations.find(
    fun (specialization):
      circuit_argument_lists_same(specialization.arguments, arguments)
  )
  if cached
  | cached.module_def
  | block:
      when context.active_circuits.find(
        fun (active): active.identity === identity
      )
      | frontend_fail("recursive elaboration of circuit " ++ name, location)
      def active_circuit = ActiveCircuit(identity, name)
      context.active_circuits := context.active_circuits ++ [active_circuit]
      def module_def = context.builder.module(context.allocate_symbol(name))
      parameterize { current_module: module_def }:
        implementation()
        // Direct kernel clients get a fallback flush. Frontend circuit wrappers
        // flush earlier while their ambient layer parameters are still active.
        run_circuit_finalizers(location)
      context.builder.finish(module_def)
      context.active_circuits := context.active_circuits.filter(
        ~keep: fun (active): !(active.identity === identity)
      )
      when reusable
      | block:
          def specialization = CircuitSpecialization(arguments, module_def)
          if specializations
          | specializations.add(specialization)
          | context.specializations_by_circuit[identity] := MutableList[specialization]
      module_def

/* Creates a named typed input in the active module with frontend provenance. */
fun input(name :: AsciiIdentifier,
          type :: HardwareType,
          location :: Location = Location()):
  def context = require_context(location)
  context.builder.input(require_module(location),
                        name,
                        type,
                        location,
                        Origin("embedded input", name))

/* Creates a named typed driveable output in the active module with frontend provenance. */
fun output(name :: AsciiIdentifier,
           type :: HardwareType,
           location :: Location = Location()):
  def context = require_context(location)
  context.builder.output(require_module(location),
                         name,
                         type,
                         location,
                         Origin("embedded output", name))

/* Creates a named typed driveable wire in the active module. */
fun wire(name :: AsciiIdentifier,
         type :: HardwareType,
         location :: Location = Location()):
  def context = require_context(location)
  context.builder.wire(require_module(location),
                       name,
                       type,
                       location,
                       Origin("embedded wire", name))

/* Allocates asynchronous-read memory with the requested depth and element type. */
fun memory(name :: AsciiIdentifier,
           depth :: PosInt,
           element_type :: DataType,
           location :: Location = Location()):
  def context = require_context(location)
  context.builder.memory(require_module(location),
                         name,
                         depth,
                         element_type,
                         location,
                         Origin("embedded memory", name))

/* Materializes an address and constructs an asynchronous read of the supplied memory resource. */
fun memory_read_async(memory_resource :: Memory,
                      address :: HardwareEntity,
                      name :: maybe(AsciiIdentifier) = #false,
                      location :: Location = Location()):
  def context = require_context(location)
  context.builder.memory_read_async(require_module(location),
                                    memory_resource,
                                    read(address, location),
                                    name,
                                    location,
                                    Origin("embedded async memory read",
                                           name || memory_resource.name))

/* Materializes a clocked memory write, collecting it inside hardware conditionals or emitting it directly. */
fun memory_write(memory_resource :: Memory,
                 address :: HardwareEntity,
                 data :: HardwareEntity,
                 clock :: HardwareEntity,
                 enable :: HardwareEntity,
                 location :: Location = Location()):
  def context = require_context(location)
  def write = ConditionalMemoryWrite(memory_resource,
                                     read(address, location),
                                     read(data, location),
                                     read(clock, location),
                                     read(enable, location),
                                     location)
  def branch = current_conditional_branch()
  if branch is_a ConditionalBranch
  | branch.add_memory_write(write)
  | context.builder.memory_write(require_module(location),
                                 write.resource,
                                 write.address,
                                 write.data,
                                 write.clock,
                                 write.enable,
                                 location,
                                 Origin("embedded memory write",
                                        memory_resource.name))

/* Constructs synchronous memory with explicit clock, requested port kinds, and optional mask granularity. */
fun sync_memory(name :: AsciiIdentifier,
                depth :: PosInt,
                element_type :: DataType,
                clock :: HardwareEntity,
                has_read :: Boolean = #true,
                has_write :: Boolean = #true,
                has_read_write :: Boolean = #false,
                mask_granularity :: maybe(PosInt) = #false,
                location :: Location = Location()):
  def context = require_context(location)
  context.builder.sync_memory(require_module(location),
                              name,
                              depth,
                              element_type,
                              read(clock, location),
                              has_read,
                              has_write,
                              has_read_write,
                              mask_granularity,
                              location,
                              Origin("embedded synchronous memory", name))

/* Declares a design-owned typed DPI import with zero or one result. */
fun dpi_import(name :: AsciiIdentifier,
               input_names :: NonemptyList.of(AsciiIdentifier),
               input_types :: NonemptyList.of(ScalarDataType),
               result_name :: maybe(AsciiIdentifier) = #false,
               result_type :: maybe(ScalarDataType) = #false,
               location :: Location = Location()):
  def context = require_context(location)
  context.builder.dpi_import(name,
                             input_names,
                             input_types,
                             result_name,
                             result_type,
                             location)

/* Declares a design-owned typed DPI import with an ordered list of results. */
fun dpi_import_results(name :: AsciiIdentifier,
                       input_names :: NonemptyList.of(AsciiIdentifier),
                       input_types :: NonemptyList.of(ScalarDataType),
                       results :: List.of(DpiResult),
                       location :: Location = Location()):
  def context = require_context(location)
  context.builder.dpi_import_results(name,
                                     input_names,
                                     input_types,
                                     results,
                                     location)

/* Materializes a clocked, reset-suppressed assertion and passes it through conditional-effect collection. */
fun assert(condition :~ HardwareEntity,
           clock :: HardwareEntity,
           reset :: HardwareEntity,
           label :: maybe(AsciiIdentifier) = #false,
           location :: Location = Location()):
  def context = require_context(location)
  def assertion = ConditionalAssertion(read(condition, location),
                                       read(clock, location),
                                       read(reset, location),
                                       #false,
                                       label,
                                       location)
  emit_conditional_assertion(assertion)

/* Materializes inputs and controls for a DPI procedure, rejecting unguarded use inside hardware conditionals. */
fun dpi_call(dpi_import :: DpiImport,
             inputs :: List.of(HardwareEntity),
             clock :: HardwareEntity,
             enable :: HardwareEntity,
             location :: Location = Location()):
  def context = require_context(location)
  reject_unsupported_conditional_effect("DPI call", location)
  context.builder.dpi_call(require_module(location),
                           dpi_import,
                           inputs.map(
                             fun (input): read(input, location)
                           ),
                           read(clock, location),
                           read(enable, location),
                           location,
                           Origin("embedded DPI call", dpi_import.name))

/* Creates one named registered DPI result, requiring explicit enable instead of hardware-conditional placement. */
fun dpi_register(name :: AsciiIdentifier,
                 dpi_import :: DpiImport,
                 inputs :: List.of(HardwareEntity),
                 clock :: HardwareEntity,
                 enable :: HardwareEntity,
                 location :: Location = Location()):
  def context = require_context(location)
  reject_unsupported_conditional_effect("DPI register", location)
  context.builder.dpi_register(require_module(location),
                               name,
                               dpi_import,
                               inputs.map(
                                 fun (input): read(input, location)
                               ),
                               read(clock, location),
                               read(enable, location),
                               location,
                               Origin("embedded DPI register", dpi_import.name))

/* Creates an ordered set of registered DPI results, rejecting unsupported conditional placement. */
fun dpi_register_results(result_names :: List.of(AsciiIdentifier),
                         dpi_import :: DpiImport,
                         inputs :: List.of(HardwareEntity),
                         clock :: HardwareEntity,
                         enable :: HardwareEntity,
                         location :: Location = Location()):
  def context = require_context(location)
  reject_unsupported_conditional_effect("DPI register", location)
  context.builder.dpi_register_results(require_module(location),
                                       result_names,
                                       dpi_import,
                                       inputs.map(
                                         fun (input):
                                           read(input, location)
                                       ),
                                       read(clock, location),
                                       read(enable, location),
                                       location,
                                       Origin("embedded DPI result registers", dpi_import.name))

/* Constructs a typed core constant in the active module from a host integer. */
fun literal(type :: HardwareType,
            integer :: Nat,
            name :: maybe(AsciiIdentifier) = #false,
            location :: Location = Location()):
  def context = require_context(location)
  context.builder.constant(require_module(location),
                           type,
                           integer,
                           name,
                           location,
                           Origin("embedded literal", name || ""))

/* Constructs an unconstrained value with the requested hardware type. */
fun dont_care(type :: HardwareType,
              name :: maybe(AsciiIdentifier) = #false,
              location :: Location = Location()):
  def context = require_context(location)
  context.builder.dont_care(require_module(location),
                            type,
                            name,
                            location,
                            Origin("embedded don't care", name || ""))

/* Materializes a unary operand and dispatches supported operation names to the core Builder. */
fun unary(opcode :: String,
          entity :: HardwareEntity,
          name :: maybe(AsciiIdentifier) = #false,
          location :: Location = Location()):
  def context = require_context(location)
  def module_def = require_module(location)
  def value = read(entity, location)
  match opcode
  | "not":
      context.builder.bit_not(module_def,
                              value,
                              name,
                              location,
                              Origin("embedded not", name || ""))
  | ~else: frontend_fail("unknown unary operation " ++ opcode, location)

/* Materializes both operands and dispatches bitwise, arithmetic, shift, or comparison operations to the core Builder. */
fun binary(opcode :: String,
           left_entity :: HardwareEntity,
           right_entity :: HardwareEntity,
           name :: maybe(AsciiIdentifier) = #false,
           location :: Location = Location()):
  def context = require_context(location)
  def module_def = require_module(location)
  def left = read(left_entity, location)
  def right = read(right_entity, location)
  match opcode
  | "and":
      context.builder.bit_and(module_def, left, right, name, location,
                              Origin("embedded and", name || ""))
  | "or":
      context.builder.bit_or(module_def, left, right, name, location,
                             Origin("embedded or", name || ""))
  | "xor":
      context.builder.bit_xor(module_def, left, right, name, location,
                              Origin("embedded xor", name || ""))
  | "add":
      context.builder.add(module_def, left, right, name, location,
                          Origin("embedded add", name || ""))
  | "mul":
      context.builder.mul(module_def, left, right, name, location,
                          Origin("embedded mul", name || ""))
  | "sub":
      context.builder.sub(module_def, left, right, name, location,
                          Origin("embedded sub", name || ""))
  | "shl":
      context.builder.shl(module_def, left, right, name, location,
                          Origin("embedded shl", name || ""))
  | "shru":
      context.builder.shru(module_def, left, right, name, location,
                           Origin("embedded shru", name || ""))
  | "shrs":
      context.builder.shrs(module_def, left, right, name, location,
                           Origin("embedded shrs", name || ""))
  | "eq":
      context.builder.eq(module_def, left, right, name, location,
                         Origin("embedded eq", name || ""))
  | "ult":
      context.builder.ult(module_def, left, right, name, location,
                          Origin("embedded unsigned less-than", name || ""))
  | "slt":
      context.builder.slt(module_def, left, right, name, location,
                          Origin("embedded signed less-than", name || ""))
  | ~else: frontend_fail("unknown binary operation " ++ opcode, location)

/* Constructs bitwise complement from materialized hardware operands. */
fun bit_not(entity :: HardwareEntity,
            name :: maybe(AsciiIdentifier) = #false,
            location :: Location = Location()):
  unary("not", entity, name, location)

/* Constructs bitwise conjunction from materialized hardware operands. */
fun bit_and(left :: HardwareEntity,
            right :: HardwareEntity,
            name :: maybe(AsciiIdentifier) = #false,
            location :: Location = Location()):
  binary("and", left, right, name, location)

/* Constructs bitwise disjunction from materialized hardware operands. */
fun bit_or(left :: HardwareEntity,
           right :: HardwareEntity,
           name :: maybe(AsciiIdentifier) = #false,
           location :: Location = Location()):
  binary("or", left, right, name, location)

/* Constructs bitwise exclusive-or from materialized hardware operands. */
fun bit_xor(left :: HardwareEntity,
            right :: HardwareEntity,
            name :: maybe(AsciiIdentifier) = #false,
            location :: Location = Location()):
  binary("xor", left, right, name, location)

/* Constructs fixed-width addition from materialized hardware operands. */
fun hw_add(left :: HardwareEntity,
           right :: HardwareEntity,
           name :: maybe(AsciiIdentifier) = #false,
           location :: Location = Location()):
  binary("add", left, right, name, location)

/* Constructs fixed-width multiplication from materialized hardware operands. */
fun hw_mul(left :: HardwareEntity,
           right :: HardwareEntity,
           name :: maybe(AsciiIdentifier) = #false,
           location :: Location = Location()):
  binary("mul", left, right, name, location)

/* Constructs fixed-width subtraction from materialized hardware operands. */
fun hw_sub(left :: HardwareEntity,
           right :: HardwareEntity,
           name :: maybe(AsciiIdentifier) = #false,
           location :: Location = Location()):
  binary("sub", left, right, name, location)

/* Constructs left shift from materialized hardware operands. */
fun hw_shl(value :: HardwareEntity,
           amount :: HardwareEntity,
           name :: maybe(AsciiIdentifier) = #false,
           location :: Location = Location()):
  binary("shl", value, amount, name, location)

/* Constructs logical right shift from materialized hardware operands. */
fun hw_shru(value :: HardwareEntity,
            amount :: HardwareEntity,
            name :: maybe(AsciiIdentifier) = #false,
            location :: Location = Location()):
  binary("shru", value, amount, name, location)

/* Constructs arithmetic right shift from materialized hardware operands. */
fun hw_shrs(value :: HardwareEntity,
            amount :: HardwareEntity,
            name :: maybe(AsciiIdentifier) = #false,
            location :: Location = Location()):
  binary("shrs", value, amount, name, location)

/* Constructs packed equality from materialized hardware operands. */
fun hw_eq(left :: HardwareEntity,
          right :: HardwareEntity,
          name :: maybe(AsciiIdentifier) = #false,
          location :: Location = Location()):
  binary("eq", left, right, name, location)

/* Constructs unsigned less-than comparison from materialized hardware operands. */
fun hw_ult(left :: HardwareEntity,
           right :: HardwareEntity,
           name :: maybe(AsciiIdentifier) = #false,
           location :: Location = Location()):
  binary("ult", left, right, name, location)

/* Constructs signed less-than comparison from materialized hardware operands. */
fun hw_slt(left :: HardwareEntity,
           right :: HardwareEntity,
           name :: maybe(AsciiIdentifier) = #false,
           location :: Location = Location()):
  binary("slt", left, right, name, location)

/* Builds a keyed mux with an explicit fallback after materializing the selector and arm values. */
fun hw_mux_lookup(selector :: HardwareEntity,
                  default_value :: HardwareEntity,
                  cases :: List.of(List),
                  name :: maybe(AsciiIdentifier) = #false,
                  location :: Location = Location(),
                  origin :: maybe(Origin) = #false):
  def context = require_context(location)
  context.builder.mux_lookup(
    require_module(location),
    read(selector, location),
    read(default_value, location),
    cases.map(
      fun (case): [case[0], read(case[1], location)]
    ),
    name,
    location,
    origin || Origin("embedded mux lookup", name || "")
  )

/* Builds a partial exact-one-hot mux after materializing all choices. */
fun hw_onehot_mux(selector :: HardwareEntity,
                  choices :: List.of(HardwareEntity),
                  name :: maybe(AsciiIdentifier) = #false,
                  location :: Location = Location(),
                  origin :: maybe(Origin) = #false):
  def context = require_context(location)
  context.builder.onehot_mux(
    require_module(location),
    read(selector, location),
    choices.map(
      fun (choice): read(choice, location)
    ),
    name,
    location,
    origin || Origin("embedded one-hot mux", name || "")
  )

/* Builds an ordered packed decode table with explicit input/result types and default value/care masks. */
fun hw_decode(selector :: HardwareEntity,
              input_type :: DataType,
              result_type :: DataType,
              cases :: List.of(List),
              default_value :: Nat,
              default_care :: Nat,
              name :: maybe(AsciiIdentifier) = #false,
              location :: Location = Location(),
              origin :: maybe(Origin) = #false):
  def context = require_context(location)
  context.builder.decode(
    require_module(location),
    read(selector, location),
    input_type,
    result_type,
    cases,
    default_value,
    default_care,
    name,
    location,
    origin || Origin("embedded decode", name || "")
  )

/* Preserves identical types without an operation; otherwise constructs an explicit representation cast. */
fun cast(entity :: HardwareEntity,
         target_type :: HardwareType,
         name :: maybe(AsciiIdentifier) = #false,
         location :: Location = Location()):
  def context = require_context(location)
  def module_def = require_module(location)
  def value = read(entity, location)
  if type_equal(value.type, target_type)
  | value
  | context.builder.cast(module_def, value, target_type, name, location,
                         Origin("embedded cast", name || ""))

/* Materializes an ordered operand list and concatenates its packed Bits values. */
fun concat(entities :: List.of(HardwareEntity),
           name :: maybe(AsciiIdentifier) = #false,
           location :: Location = Location()):
  def context = require_context(location)
  context.builder.concat(require_module(location),
                         entities.map(
                           fun (entity): read(entity, location)
                         ),
                         name,
                         location,
                         Origin("embedded concat", name || ""))

/* Extracts an inclusive high-to-low bit range from a materialized operand. */
fun extract(entity :: HardwareEntity,
            high :: Nat,
            low :: Nat,
            name :: maybe(AsciiIdentifier) = #false,
            location :: Location = Location()):
  def context = require_context(location)
  context.builder.extract(require_module(location),
                          read(entity, location),
                          high,
                          low,
                          name,
                          location,
                          Origin("embedded extract", name || ""))

/* Zero-extends a materialized operand to the requested packed width. */
fun zext(entity :: HardwareEntity,
         target_width :: PosInt,
         name :: maybe(AsciiIdentifier) = #false,
         location :: Location = Location()):
  def context = require_context(location)
  context.builder.zext(require_module(location),
                       read(entity, location),
                       target_width,
                       name,
                       location,
                       Origin("embedded zext", name || ""))

/* Sign-extends a materialized operand to the requested packed width. */
fun sext(entity :: HardwareEntity,
         target_width :: PosInt,
         name :: maybe(AsciiIdentifier) = #false,
         location :: Location = Location()):
  def context = require_context(location)
  context.builder.sext(require_module(location),
                       read(entity, location),
                       target_width,
                       name,
                       location,
                       Origin("embedded sext", name || ""))

/* Keeps the low bits of a materialized operand at the requested narrower width. */
fun trunc(entity :: HardwareEntity,
          target_width :: PosInt,
          name :: maybe(AsciiIdentifier) = #false,
          location :: Location = Location()):
  def context = require_context(location)
  context.builder.trunc(require_module(location),
                        read(entity, location),
                        target_width,
                        name,
                        location,
                        Origin("embedded trunc", name || ""))

/* Constructs a value of the supplied record descriptor from named materialized fields. */
fun record_create(type :: RecordType,
                  fields :: List.of(List),
                  name :: maybe(AsciiIdentifier) = #false,
                  location :: Location = Location()):
  def context = require_context(location)
  context.builder.record_create(
    require_module(location),
    type,
    fields.map(
      fun (field): [field[0], read(field[1], location)]
    ),
    name,
    location,
    Origin("embedded record create", name || "")
  )

/* Projects places structurally and values through record reads, preserving register-relative read/write identity. */
fun project(entity :: HardwareEntity,
            field_name :: AsciiIdentifier,
            name :: maybe(AsciiIdentifier) = #false,
            location :: Location = Location()):
  def context = require_context(location)
  def drive_place:
    cond
    | entity is_a Register: entity.next
    | entity is_a RegisterPathValue: entity.drive_hardware(location)
    | ~else: #false
  cond
  | entity is_a Place:
      context.builder.project(entity, field_name)
  | drive_place:
      RegisterPath(
        fun ():
          context.builder.record_get(require_module(location),
                                     read(entity, location),
                                     field_name,
                                     name,
                                     location,
                                     Origin("embedded record get", field_name)),
        context.builder.project(drive_place, field_name)
      )
  | ~else:
      context.builder.record_get(require_module(location),
                                 read(entity, location),
                                 field_name,
                                 name,
                                 location,
                                 Origin("embedded record get", field_name))

/* Constructs a value of the supplied vector descriptor from ordered materialized elements. */
fun vector_create(type :: VectorType,
                  elements :: List.of(HardwareEntity),
                  name :: maybe(AsciiIdentifier) = #false,
                  location :: Location = Location()):
  def context = require_context(location)
  context.builder.vector_create(
    require_module(location),
    type,
    elements.map(
      fun (element): read(element, location)
    ),
    name,
    location,
    Origin("embedded vector create", name || "")
  )

/* Reads one statically indexed element of a hardware vector. */
fun vector_get(entity :: HardwareEntity,
               element_index :: Nat,
               name :: maybe(AsciiIdentifier) = #false,
               location :: Location = Location()):
  def context = require_context(location)
  context.builder.vector_get(require_module(location),
                             read(entity, location),
                             element_index,
                             name,
                             location,
                             Origin("embedded vector get", to_string(element_index)))

/* Projects a vector element while preserving driveability and register-relative current/next behavior. */
fun vector_project(entity :: HardwareEntity,
                   element_index :: Nat,
                   location :: Location = Location()):
  def context = require_context(location)
  def drive_place:
    cond
    | entity is_a Register: entity.next
    | entity is_a RegisterPathValue: entity.drive_hardware(location)
    | ~else: #false
  cond
  | entity is_a Place:
      context.builder.project_vector(entity, element_index)
  | drive_place:
      RegisterPath(fun (): vector_get(entity, element_index, #false, location),
                   context.builder.project_vector(drive_place, element_index))
  | ~else:
      vector_get(entity, element_index, #false, location)

/* Selects a statically indexed Bits bit or vector element while retaining applicable driveability. */
fun index(entity :: HardwareEntity,
          element_index :: Nat,
          location :: Location = Location()):
  def type:
    cond
    | entity is_a Value: entity.type
    | entity is_a Place: entity.type
    | entity is_a Register: entity.current.type
    | ~else: read(entity, location).type
  cond
  | bits_type(type): extract(entity, element_index, element_index, #false, location)
  | vector_type(type): vector_project(entity, element_index, location)
  // Preserve the established Bits diagnostic for unsupported data types.
  | ~else: extract(entity, element_index, element_index, #false, location)

/* Lowers hardware vector lookup to exact indexed arms with an explicit out-of-range fallback. */
fun vector_lookup(entity :: HardwareEntity,
                  selector :: HardwareEntity,
                  default_value :: HardwareEntity,
                  name :: maybe(AsciiIdentifier) = #false,
                  location :: Location = Location()):
  def vector_value = read(entity, location)
  unless vector_type(vector_value.type)
  | frontend_fail("vector lookup requires a VectorType value", location)
  def cases:
    for List (element_index in 0..vector_value.type.length):
      [element_index, vector_get(vector_value, element_index, #false, location)]
  hw_mux_lookup(selector,
                default_value,
                cases,
                name,
                location,
                Origin("embedded vector lookup", name || ""))

/* Requires a vector and a Bits selector with exactly the vector's index width. */
fun validate_dynamic_vector_selector(vector_value :: Value,
                                     selector_value :: Value,
                                     location :: Location):
  unless vector_type(vector_value.type)
  | frontend_fail("hardware vector indexing requires a VectorType value", location)
  unless bits_type(selector_value.type)
  | frontend_fail("hardware vector index must have a Bits type", location)
  unless selector_value.type.width == count_index_width(vector_value.type.length)
  | frontend_fail(
      "hardware vector index must have Bits(index_width(vector length)) type",
      location
    )

/*
 * Selects dynamically from a vector. A selector encoding outside the vector
 * length makes the result unconstrained.
 */
fun vector_select(entity :: HardwareEntity,
                  selector :: HardwareEntity,
                  name :: maybe(AsciiIdentifier) = #false,
                  location :: Location = Location()):
  def vector_value = read(entity, location)
  def selector_value = read(selector, location)
  validate_dynamic_vector_selector(vector_value, selector_value, location)
  require_context(location).builder.vector_index(
    require_module(location),
    vector_value,
    selector_value,
    name,
    location,
    Origin("embedded vector index", name || "")
  )

/*
 * Injects one dynamically selected element. An out-of-range selector makes the
 * complete result vector unconstrained.
 */
fun vector_inject(entity :: HardwareEntity,
                  selector :: HardwareEntity,
                  replacement :: HardwareEntity,
                  name :: maybe(AsciiIdentifier) = #false,
                  location :: Location = Location()):
  def vector_value = read(entity, location)
  def selector_value = read(selector, location)
  def replacement_value = read(replacement, location)
  validate_dynamic_vector_selector(vector_value, selector_value, location)
  require_context(location).builder.vector_inject(
    require_module(location),
    vector_value,
    selector_value,
    replacement_value,
    name,
    location,
    Origin("embedded vector inject", name || "")
  )

/*
 * Constructs a new vector whose hardware-selected element is replaced. Each
 * element falls back to the original value, so an out-of-range selector leaves
 * the entire vector unchanged.
 */
fun vector_updated(entity :: HardwareEntity,
                   selector :: HardwareEntity,
                   replacement :: HardwareEntity,
                   name :: maybe(AsciiIdentifier) = #false,
                   location :: Location = Location()):
  def vector_value = read(entity, location)
  def selector_value = read(selector, location)
  def replacement_value = read(replacement, location)
  unless vector_type(vector_value.type)
  | frontend_fail("vector update requires a VectorType value", location)
  unless bits_type(selector_value.type)
  | frontend_fail("vector update selector must have a Bits type", location)
  unless type_equal(replacement_value.type, vector_value.type.element_type)
  | frontend_fail("vector update replacement must have the vector element type",
                  location)
  def elements:
    for List (element_index in 0..vector_value.type.length):
      def existing = vector_get(vector_value,
                                element_index,
                                #false,
                                location)
      def key = literal(selector_value.type,
                        element_index,
                        #false,
                        location)
      def selected = hw_eq(selector_value, key, #false, location)
      hw_mux_lookup(selected,
                    existing,
                    [[1, replacement_value]],
                    #false,
                    location,
                    Origin("embedded vector update", to_string(element_index)))
  vector_create(vector_value.type, elements, name, location)

/*
 * Carries a dynamically selected element of a direct vector register. Reads
 * remain ordinary mux selection; writes become one whole next-state update.
 */
class DynamicVectorRegisterPath(register :: Register,
                                vector_value :: Value,
                                selector_value :: Value,
                                mutable current :: maybe(Value) = #false):
  implements DynamicAssignmentTarget

  /* Materializes and caches the runtime-selected current vector element. */
  override method materialize_hardware(location :: Location):
    unless current
    | current := vector_select(vector_value,
                               selector_value,
                               #false,
                               location)
    current

  /* Checks the replacement element type and records an enabled dynamic register write. */
  override method assign_hardware(entity :: HardwareEntity,
                                  location :: Location):
    def replacement = read(entity, location)
    unless type_equal(replacement.type, vector_value.type.element_type)
    | frontend_fail("dynamic vector assignment requires the vector element type",
                    location)
    emit_vector_register_write(
      ConditionalVectorWrite(register,
                             selector_value,
                             replacement,
                             literal(Bits(1), 1, #false, location),
                             location)
    )

/*
 * Preserves the read behavior of hardware vector indexing while retaining an
 * assignable path only for a direct Reg<Vec>. Other vector entities stay values.
 */
fun vector_index(entity :: HardwareEntity,
                 selector :: HardwareEntity,
                 name :: maybe(AsciiIdentifier) = #false,
                 location :: Location = Location()):
  def vector_value = read(entity, location)
  def selector_value = read(selector, location)
  validate_dynamic_vector_selector(vector_value, selector_value, location)
  if entity is_a Register
  | DynamicVectorRegisterPath(entity, vector_value, selector_value)
  | vector_select(vector_value, selector_value, name, location)

/* Constructs a register with explicit clock and optional paired reset/reset value. */
fun reg(name :: AsciiIdentifier,
        type :: DataType,
        clock :: HardwareEntity,
        reset :: maybe(HardwareEntity) = #false,
        reset_value :: maybe(HardwareEntity) = #false,
        location :: Location = Location()):
  def context = require_context(location)
  context.builder.register(require_module(location),
                           name,
                           type,
                           read(clock, location),
                           reset ?> read(_, location),
                           reset_value ?> read(_, location),
                           location,
                           Origin("embedded register", name))

/* Attaches a stable-level crossing contract to the supplied source, destination clock, and register stages. */
fun sync_level_crossing(source :: HardwareEntity,
                        destination_clock :: HardwareEntity,
                        stages :: List.of(Register),
                        location :: Location = Location()):
  def context = require_context(location)
  context.builder.sync_level_crossing(
    require_module(location),
    read(source, location),
    read(destination_clock, location),
    stages,
    location,
    Origin("embedded stable level crossing")
  )

/* Creates a child instance and attaches any detached logical member declarations. */
fun inst(name :: AsciiIdentifier,
         child :: Module || CircuitDefinition,
         location :: Location = Location()):
  def context = require_context(location)
  def reference = circuit_reference(child, location)
  def instance = context.builder.suggested_instance(require_module(location), materialize_circuit(reference, location), name, location, Origin("embedded instance", name))
  when reference.declarations.length() > 0
  | instance.operation.module_def.add_metadata("rhodium.circuit.declarations", CircuitInstanceDeclarations(instance.operation, reference.declarations))
  instance

/* Resolves frontend lvalues, enforces exact type matching, and either records a conditional assignment or drives its place. */
fun connect(place :: HardwareEntity,
            entity :: HardwareEntity,
            location :: Location = Location()):
  cond
  | place is_a DynamicAssignmentTarget:
      place.assign_hardware(entity, location)
  | ~else:
      def context = require_context(location)
      def target:
        cond
        | place is_a Register: place.next
        | place is_a RegisterPathValue: place.drive_hardware(location)
        | ~else: place
      unless target is_a Place
      | frontend_fail("connection target must be a driveable hardware place",
                      location)
      def value = read(entity, location)
      unless type_equal(target.type, value.type)
      | frontend_fail("connection source and target must have exactly the same hardware type",
                      location)
      def conditional_branch = current_conditional_branch()
      if conditional_branch is_a ConditionalBranch
      | conditional_branch.add(target, value, location)
      | context.builder.drive(target,
                              value,
                              location,
                              Origin("embedded connect", target.name))

/* Recovers the current-state value corresponding to a register next-place or one of its nested projections. */
fun register_hold_value(place :: Place,
                        location :: Location = Location()):
  if place.parent
  | block:
      def parent_hold = register_hold_value(place.parent, location)
      if parent_hold
      | if record_type(place.parent.type)
        | project(parent_hold, place.projection_key, #false, location)
        | index(parent_hold, place.projection_key, location)
      | #false
  | block:
      def operation = place.module_def.find_operation(place.owner_op_id)
      if operation && (operation.opcode == "rtl.register" || operation.opcode == "rtl.register_reset")
      | operation.results[0]
      | #false

/* Propagates an assignment into an enclosing branch or emits its final core drive. */
fun emit_conditional_assignment(place :: Place,
                                value :: Value,
                                location :: Location = Location()):
  def branch = current_conditional_branch()
  if branch is_a ConditionalBranch
  | branch.add(place, value, location)
  | require_context(location).builder.drive(
      place,
      value,
      location,
      Origin("embedded conditional connect", place.name)
    )

/* Propagates a resolved memory write into an enclosing branch or emits its core effect. */
fun emit_conditional_memory_write(write :: ConditionalMemoryWrite):
  def branch = current_conditional_branch()
  if branch is_a ConditionalBranch
  | branch.add_memory_write(write)
  | require_context(write.location).builder.memory_write(
      require_module(write.location),
      write.resource,
      write.address,
      write.data,
      write.clock,
      write.enable,
      write.location,
      Origin("embedded conditional memory write", write.resource.name)
    )

/*
 * Carries a dynamic vector-register write outward through conditional scopes.
 * Top-level writes are collected until all ports for the register are known.
 */
fun emit_vector_register_write(write :: ConditionalVectorWrite):
  def branch = current_conditional_branch()
  if branch is_a ConditionalBranch
  | branch.add_vector_write(write)
  | block:
      def context = require_context(write.location)
      unless context.active_circuits.length() > 0
      | frontend_fail("vector register write requires an active circuit",
                      write.location)
      def active = context.active_circuits[context.active_circuits.length() - 1]
      active.vector_writes := active.vector_writes ++ [write]
  #void

/*
 * Emits one unordered core write set per vector register, preserving the
 * frontend's ordinary one-driver rule for the register's whole next value.
 */
fun flush_vector_register_writes(active :: ActiveCircuit,
                                 location :: Location = Location()):
  def writes = active.vector_writes
  active.vector_writes := []
  def mutable registers = []
  for (write in writes):
    unless registers.find(
      fun (register): register === write.register
    )
    | registers := registers ++ [write.register]
  for (register in registers):
    def register_writes = writes.filter(
      ~keep: fun (write): write.register === register
    )
    def representative = register_writes[0]
    def port_count = register_writes.length()
    def enables = vector_create(
      VectorType(port_count, Bits(1)),
      register_writes.map(
        fun (write): write.enable
      ),
      #false,
      representative.location
    )
    def indices = vector_create(
      VectorType(port_count, representative.index.type),
      register_writes.map(
        fun (write): write.index
      ),
      #false,
      representative.location
    )
    def elements = vector_create(
      VectorType(port_count, representative.data.type),
      register_writes.map(
        fun (write): write.data
      ),
      #false,
      representative.location
    )
    def next_value = require_context(representative.location).builder.vector_write_set(
      require_module(representative.location),
      register.current,
      enables,
      indices,
      elements,
      #false,
      representative.location,
      Origin("embedded vector register write set", register.next.name)
    )
    require_context(representative.location).builder.drive(
      register.next,
      next_value,
      representative.location,
      Origin("embedded vector register write set", register.next.name)
    )
  #void

/*
 * Combines lexical activation as assertions cross nested conditional chains.
 * A missing guard means the assertion is active throughout its current scope.
 */
fun combine_assertion_guards(left :: maybe(Value),
                             right :: maybe(Value),
                             location :: Location = Location()):
  cond
  | left && right: bit_and(left, right, #false, location)
  | left: left
  | right: right
  | ~else: #false

/* Combines lexical guards and collects the assertion or emits a guarded core assertion. */
fun emit_conditional_assertion(assertion :: ConditionalAssertion,
                               branch_guard :: maybe(Value) = #false):
  def guard = combine_assertion_guards(assertion.guard,
                                       branch_guard,
                                       assertion.location)
  def guarded = ConditionalAssertion(assertion.condition,
                                     assertion.clock,
                                     assertion.reset,
                                     guard,
                                     assertion.label,
                                     assertion.location)
  def branch = current_conditional_branch()
  if branch is_a ConditionalBranch
  | branch.add_assertion(guarded)
  | require_context(assertion.location).builder.assert(
      require_module(assertion.location),
      assertion.condition,
      assertion.clock,
      assertion.reset,
      guard || literal(Bits(1), 1, #false, assertion.location),
      assertion.label,
      assertion.location,
      Origin("embedded clocked assertion", assertion.label || "")
    )

/* Materializes a hardware condition and requires a one-bit scalar data type. */
fun validate_conditional_value(condition :~ HardwareEntity,
                               location :: Location = Location()):
  unless condition is_a HardwareEntity
  | frontend_fail("hardware condition must be a hardware value", location)
  def value = read(condition, location)
  unless scalar_data_type(value.type) && scalar_width(value.type) == 1
  | frontend_fail("hardware condition must have a one-bit ScalarDataType", location)
  value

/* Elaborates a body while collecting its assignments and supported effects without final drives. */
fun collect_conditional_branch(body :: Function.of_arity(0),
                               form :: String,
                               location :: Location = Location()):
  def branch = ConditionalBranch()
  parameterize { current_conditional_branch: branch,
                 current_conditional_form: form }:
    body()
  branch

/*
 * Resolves collected mutually exclusive branches through a caller-supplied
 * selection strategy, preserving the one-final-driver and shared-port rules.
 */
fun resolve_conditional_branches(
      branch_results :: List.of(ConditionalBranch),
      otherwise_result :: maybe(ConditionalBranch),
      select_values :: Function.of_arity(3),
      build_assertion_guards :: Function.of_arity(1),
      origin_description :: String,
      location :: Location):
  def mutable has_assertions = #false
  for (branch_result in branch_results):
    when branch_result.assertions.length() > 0
    | has_assertions := #true
  when otherwise_result && otherwise_result.assertions.length() > 0
  | has_assertions := #true

  when has_assertions
  | block:
      def guards = build_assertion_guards(
        otherwise_result && otherwise_result.assertions.length() > 0
      )
      def branch_guards = guards[0]
      def otherwise_guard = guards[1]
      for (branch_result in branch_results, branch_guard in branch_guards):
        for (assertion in branch_result.assertions):
          emit_conditional_assertion(assertion, branch_guard)
      when otherwise_result
      | for (assertion in otherwise_result.assertions):
          emit_conditional_assertion(assertion, otherwise_guard)

  def mutable places = []
  for (branch_result in branch_results):
    for (assignment in branch_result.assignments):
      unless places.find(fun (place): place === assignment.place)
      | places := places ++ [assignment.place]
  when otherwise_result
  | for (assignment in otherwise_result.assignments):
      unless places.find(fun (place): place === assignment.place)
      | places := places ++ [assignment.place]
  for (place in places):
    def hold = register_hold_value(place, location)
    def fallback:
      if otherwise_result
      | block:
          def assignment = otherwise_result.assignment_for(place)
          unless assignment
          | frontend_fail(String.append("conditional assignment to ",
                                        place.name,
                                        " is missing from otherwise"),
                          location)
          assignment.value
      | if hold
        | hold
        | frontend_fail(String.append("conditional assignment to ",
                                      place.name,
                                      " requires otherwise"),
                        location)
    def branch_values:
      for List (branch_result in branch_results):
        def assignment = branch_result.assignment_for(place)
        if assignment
        | assignment.value
        | if hold
          | hold
          | frontend_fail("conditional branch does not assign " ++ place.name,
                          location)
    def selected = select_values(
      branch_values,
      fallback,
      Origin(origin_description ++ " mux", place.name)
    )
    emit_conditional_assignment(place, selected, location)

  def mutable memories = []
  /* Adds each memory touched by a branch once to the conditional resource inventory. */
  fun include_branch_memories(
        branch_result :: maybe(ConditionalBranch)):
    when branch_result
    | for (write in branch_result.memory_writes):
        unless memories.find(
          fun (resource): resource === write.resource
        )
        | memories := memories ++ [write.resource]
  for (branch_result in branch_results):
    include_branch_memories(branch_result)
  include_branch_memories(otherwise_result)

  /* Returns a branch's source-ordered write port for a resource, or false when absent. */
  fun memory_write_at(branch_result :: maybe(ConditionalBranch),
                      resource :: Memory,
                      port_index :: Nat):
    if !branch_result
    | #false
    | block:
        def writes = branch_result.memory_writes_for(resource)
        if port_index < writes.length() | writes[port_index] | #false

  for (resource in memories):
    def all_results = branch_results ++ (if otherwise_result | [otherwise_result] | [])
    def mutable port_count = 0
    for (branch_result in all_results):
      def count = branch_result.memory_writes_for(resource).length()
      when count > port_count
      | port_count := count
    for (port_index in 0..port_count):
      def mutable representative = #false
      for (branch_result in all_results):
        def candidate = memory_write_at(branch_result, resource, port_index)
        when candidate && !representative
        | representative := candidate
      unless (for all (branch_result in all_results):
                def candidate = memory_write_at(branch_result,
                                                resource,
                                                port_index)
                !candidate || candidate.clock === representative.clock)
      | frontend_fail(String.append("conditional writes to memory ",
                                    resource.name,
                                    " must use the same clock"),
                      location)
      def disabled = literal(Bits(1), 0, #false, location)
      def fallback_write = memory_write_at(otherwise_result,
                                           resource,
                                           port_index)
      def fallback_address:
        fallback_write?.address || representative.address
      def fallback_data:
        fallback_write?.data || representative.data
      def fallback_enable:
        (fallback_write ?> fun (write): cast(write.enable, Bits(1), #false, location)) || disabled
      def branch_writes:
        for List (branch_result in branch_results):
          memory_write_at(branch_result, resource, port_index)
      def selected_address = select_values(
        branch_writes.map(
          fun (write):
            write?.address
        ),
        fallback_address,
        Origin(origin_description ++ " memory address", resource.name)
      )
      def selected_data = select_values(
        branch_writes.map(
          fun (write):
            write?.data
        ),
        fallback_data,
        Origin(origin_description ++ " memory data", resource.name)
      )
      def selected_enable = select_values(
        branch_writes.map(
          fun (write):
            (write ?> fun (write): cast(write.enable, Bits(1), #false, location)) || disabled
        ),
        fallback_enable,
        Origin(origin_description ++ " memory enable", resource.name)
      )
      emit_conditional_memory_write(
        ConditionalMemoryWrite(resource,
                               selected_address,
                               selected_data,
                               representative.clock,
                               selected_enable,
                               representative.location)
      )

  def mutable vector_registers = []
  /* Adds each dynamically written vector register once to the conditional resource inventory. */
  fun include_branch_vector_registers(
        branch_result :: maybe(ConditionalBranch)):
    when branch_result
    | for (write in branch_result.vector_writes):
        unless vector_registers.find(
          fun (register): register === write.register
        )
        | vector_registers := vector_registers ++ [write.register]
  for (branch_result in branch_results):
    include_branch_vector_registers(branch_result)
  include_branch_vector_registers(otherwise_result)

  /* Returns a branch's source-ordered vector-register write, or false when absent. */
  fun vector_write_at(branch_result :: maybe(ConditionalBranch),
                      register :: Register,
                      port_index :: Nat):
    if !branch_result
    | #false
    | block:
        def writes = branch_result.vector_writes_for(register)
        if port_index < writes.length() | writes[port_index] | #false

  for (register in vector_registers):
    def all_results = branch_results ++ (if otherwise_result | [otherwise_result] | [])
    def mutable port_count = 0
    for (branch_result in all_results):
      def count = branch_result.vector_writes_for(register).length()
      when count > port_count
      | port_count := count
    for (port_index in 0..port_count):
      def mutable representative = #false
      for (branch_result in all_results):
        def candidate = vector_write_at(branch_result, register, port_index)
        when candidate && !representative
        | representative := candidate
      def disabled = literal(Bits(1), 0, #false, location)
      def fallback_write = vector_write_at(otherwise_result,
                                           register,
                                           port_index)
      def fallback_index:
        fallback_write?.index || representative.index
      def fallback_data:
        fallback_write?.data || representative.data
      def fallback_enable:
        fallback_write?.enable || disabled
      def branch_writes:
        for List (branch_result in branch_results):
          vector_write_at(branch_result, register, port_index)
      /* Avoids a mux when every present branch value is the identical fallback object. */
      fun select_write_value(branch_values :: List.of(maybe(Value)),
                             fallback :: Value,
                             origin :: Origin):
        if branch_values.find(
             fun (value):
               value && !(value === fallback)
           )
        | select_values(branch_values, fallback, origin)
        | fallback
      def selected_index = select_write_value(
        branch_writes.map(
          fun (write):
            write?.index
        ),
        fallback_index,
        Origin(origin_description ++ " vector write index", register.next.name)
      )
      def selected_data = select_write_value(
        branch_writes.map(
          fun (write):
            write?.data
        ),
        fallback_data,
        Origin(origin_description ++ " vector write data", register.next.name)
      )
      def selected_enable = select_values(
        branch_writes.map(
          fun (write):
            write?.enable || disabled
        ),
        fallback_enable,
        Origin(origin_description ++ " vector write enable", register.next.name)
      )
      emit_vector_register_write(
        ConditionalVectorWrite(register,
                               selected_index,
                               selected_data,
                               selected_enable,
                               representative.location)
      )
  #void

/* Elaborates an ordered hardware-conditional chain into priority mux trees. */
fun conditional_chain(branches :: NonemptyList.of(List),
                      otherwise_body :: maybe(Function.of_arity(0)) = #false,
                      location :: Location = Location()):
  def conditions:
    for List (branch in branches):
      validate_conditional_value(branch[0](), location)
  def branch_results:
    for List (branch in branches):
      collect_conditional_branch(branch[1], "when", location)
  def otherwise_result:
    otherwise_body ?> collect_conditional_branch(_, "when", location)
  /* Builds first-match priority muxes for the branch values that are present. */
  fun select_values(branch_values :: List.of(maybe(Value)),
                    fallback :: Value,
                    origin :: Origin):
    def mutable selected = fallback
    for (index in (branches.length() - 1) >=..= 0):
      def branch_value = branch_values[index]
      when branch_value
      | selected := hw_mux_lookup(
          cast(conditions[index], Bits(1), #false, location),
          selected,
          [[1, branch_value]],
          #false,
          location,
          origin
        )
    selected
  /* Builds mutually exclusive first-match activation guards and any unmatched otherwise guard. */
  fun build_assertion_guards(needs_otherwise :: Boolean):
    def mutable unmatched_guard = #false
    def branch_guards:
      for List (condition in conditions, index in 0..conditions.length()):
        def condition_bits = cast(condition, Bits(1), #false, location)
        def branch_guard = combine_assertion_guards(unmatched_guard,
                                                    condition_bits,
                                                    location)
        when index + 1 < conditions.length() || needs_otherwise
        | def condition_false = bit_not(condition_bits, #false, location)
          unmatched_guard := combine_assertion_guards(unmatched_guard,
                                                      condition_false,
                                                      location)
        branch_guard
    [branch_guards, unmatched_guard]
  resolve_conditional_branches(branch_results,
                               otherwise_result,
                               select_values,
                               build_assertion_guards,
                               "embedded conditional",
                               location)

/*
 * Elaborates unordered exact-key cases into direct keyed mux lookups. Keys are
 * normalized host integers, so no switch control-flow operation enters core.
 */
fun switch_chain(selector :: HardwareEntity,
                 cases :: NonemptyList.of(List),
                 otherwise_body :: maybe(Function.of_arity(0)) = #false,
                 location :: Location = Location()):
  def selector_value = read(selector, location)
  unless bits_type(selector_value.type)
  | frontend_fail("switch selector must lower to Bits", location)
  def width = scalar_width(selector_value.type)
  def mutable keys = []
  for (case in cases):
    unless case.length() == 2 && case[0] is_a Nat
    | frontend_fail("switch cases must contain host natural-number keys and branch bodies",
                    location)
    def key = case[0]
    unless bits.length(key) <= width
    | frontend_fail("switch case key does not fit the selector width", location)
    when keys.find(fun (existing): existing == key)
    | frontend_fail("switch case keys must be unique", location)
    keys := keys ++ [key]
  def branch_results:
    for List (case in cases):
      collect_conditional_branch(case[1], "switch", location)
  def otherwise_result:
    otherwise_body ?> collect_conditional_branch(_, "switch", location)
  /* Builds a direct keyed mux for present case values, retaining the explicit fallback. */
  fun select_values(branch_values :: List.of(maybe(Value)),
                    fallback :: Value,
                    origin :: Origin):
    def mutable selected_cases = []
    for (key in keys, branch_value in branch_values):
      when branch_value
      | selected_cases := selected_cases ++ [[key, branch_value]]
    if selected_cases.length() == 0
    | fallback
    | hw_mux_lookup(selector_value,
                    fallback,
                    selected_cases,
                    #false,
                    location,
                    origin)
  /* Builds exact-key assertion guards and an optional guard for values matching no case. */
  fun build_assertion_guards(needs_otherwise :: Boolean):
    def branch_guards:
      for List (key in keys):
        hw_eq(selector_value,
              literal(Bits(width), key, #false, location),
              #false,
              location)
    def mutable otherwise_guard = #false
    when needs_otherwise
    | for (branch_guard in branch_guards):
        otherwise_guard := combine_assertion_guards(
          otherwise_guard,
          bit_not(branch_guard, #false, location),
          location
        )
    [branch_guards, otherwise_guard]
  resolve_conditional_branches(branch_results,
                               otherwise_result,
                               select_values,
                               build_assertion_guards,
                               "embedded switch",
                               location)

/* Execute a top-selecting recipe within its context and close that context on every exit.
   The selected reference is realized before the context closes. */
fun run_program_body(program :: Function.of_arity(0), context :: FrontendContext):
  try:
    parameterize { current_context: context, current_module: #false }:
      def result = program()
      unless result is_a Module || result is_a CircuitDefinition
      | error(~who: #'rhodium, "elaboration did not select a top circuit")
      def reference = circuit_reference(result)
      materialize_circuit(reference)
    ~finally:
      context.active := #false

/* Build a completed source inventory with an explicit top; targets verify and copy it. */
fun run_elaboration(program :: Function.of_arity(0)) :: DesignElaboration:
  def design = Design()
  def context = FrontendContext(design, Builder(design))
  def top = run_program_body(program, context)
  DesignElaboration(design, top)
