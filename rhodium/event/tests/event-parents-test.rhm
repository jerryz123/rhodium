#lang rhombus
// Checks upstream-parent selection, ordinary topology certification, and unchanged functional emission.
// SPDX-License-Identifier: Apache-2.0
import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  "../../../rhodium/event/main.rhm" open
  "../../../rhodium/backend/circt.rhm".emit_circt
  "event-parents-fixture.rhdl" as fixture

def logical = fixture.selected()
def before = emit_circt(logical.design)
def traced = instrument_events(logical)
def m = traced.manifest
fun labels(edges): edges.map(fun (e): m.site(e.parent).label ++ "->" ++ m.site(e.child).label)
check:
  emit_circt(logical.design) ~is before
  labels(m.dependencies).sort() ~is ["middle->both", "middle->cache", "root->both", "root->both", "root->cache", "root->middle", "root->wb", "root->wb"].sort()
  event_trace_capacity(m.trace_plans[m.sites.find(fun (s): s.label == "both").id]) ~is 2
  fixture.selected("empty") ~throws "selected parents must not be empty"
  fixture.selected("duplicate") ~throws "duplicate selected parent"
  fixture.selected("endpoint") ~throws "annotated local checkpoint endpoint"
  instrument_events(fixture.selected("fanout")) ~throws "uncertified fanout"
  infer_event_manifest(fixture.sibling()) ~throws "selected parent is not upstream"
def repeated = instrument_events(fixture.repeated()).manifest
check:
  repeated.sites.length() ~is 10
  (for all (edge in repeated.dependencies): repeated.site(edge.parent).instance_path == repeated.site(edge.child).instance_path) ~is #true

def gated = compile_program(fixture.gated(), rtl_target).report.elaboration
def gated_before = emit_circt(gated.design)
def selected = instrument_events(gated).manifest
check:
  emit_circt(gated.design) ~is gated_before
  emit_circt(compile_program(fixture.gated("unbound"), rtl_target).report.design) ~is gated_before
  selected.dependencies.map(fun (e): selected.site(e.parent).label ++ "->" ++ selected.site(e.child).label).sort() ~is ["root->middle", "root->wb", "middle->cache", "root->both", "middle->both"].sort()
  event_trace_capacity(selected.trace_plans[selected.sites.find(fun (s): s.label == "both").id]) ~is 2
  compile_program(fixture.gated("empty"), rtl_target).report.elaboration ~throws "selected parents must not be empty"
  compile_program(fixture.gated("duplicate"), rtl_target).report.elaboration ~throws "duplicate selected parent"
  compile_program(fixture.gated("parent"), rtl_target).report.elaboration ~throws "selected parent must be an annotated local checkpoint endpoint"
  compile_program(fixture.gated("child"), rtl_target).report.elaboration ~throws "child must be an annotated local checkpoint endpoint"
  compile_program(fixture.gated("rebind"), rtl_target).report.elaboration ~throws "event parents are already bound"
  compile_program(fixture.gated("mixed"), rtl_target).report.elaboration ~throws "event parents are already bound"
  compile_program(fixture.gated("conditional"), rtl_target).report.elaboration ~throws "event parent selection is not supported inside"
  fixture.invalid_predicate() ~throws "argument does not satisfy annotation"
