#lang rhodium
// Exercises retained/live window lineage locally, through a child, and in the real frontend.
// SPDX-License-Identifier: Apache-2.0
import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  lib("flow/main.rhdl") open
  "../../../cores/rv5stage/tests/fetch-fixture.rhdl" open
  "../../../cores/rv5stage/fetch/protocol.rhdl" open
  "../../../cores/rv5stage/icache/protocol.rhdl" open
  "../../../cores/rv5stage/profile.rhm" open
  "../../../riscv/isa/c.rhm" open
  "../../../riscv/isa/xlen.rhm" open

sync_circuit WindowCell(intrinsic :: Boolean, live_support :: Boolean = #true, batched :: Boolean = #false):
  interface source(Valid(Bits(8)), ~role: consumer)
  interface sink(Decoupled(Bits(8)), ~role: producer)
  input(flush, emit, live, capture): Bool
  input(remove_count, selected): Bits(2)
  input append_count: Bits(2)
  output occupancy: Bits(2)
  reg count(~init: Bits(2)(0))
  reg words(~init: vec([Bits(8)(0), Bits(8)(0), Bits(8)(0)]))
  def remaining = count - remove_count
  occupancy <== count
  sink.valid <== emit & !flush
  def include_live = if live_support | live | Bool(#false)
  def enqueue = source.valid & capture
  def appended = if batched | append_count | Bits(2)(1)
  sink.bits <== mux(selected[0].into(Bool), words[0], Bits(8)(0)) ^ mux(selected[1].into(Bool), words[1], Bits(8)(0)) ^ mux(include_live, source.bits, Bits(8)(0))
  when flush:
    count <== Bits(2)(0)
  otherwise:
    count <== remaining + mux(enqueue, appended, Bits(2)(0))
  for (index in 0..3):
    def mutable shifted = Bits(8)(0)
    for (offset in 0..(3 - index)):
      shifted := mux(remove_count === Bits(2)(offset), words[index + offset], shifted)
    when flush:
      words[index] <== Bits(8)(0)
    elsewhen (enqueue & (Bits(2)(index) >= remaining) & ((Bits(2)(index) - remaining) < appended)):
      words[index] <== source.bits
    otherwise:
      words[index] <== shifted
  describe_interface_window_storage(3, enqueue, remove_count, count, flush, [selected[0], selected[1]], ~live: if live_support | live | #false, ~append_count: if batched | append_count | #false)
  if intrinsic
  | describe_interface_contract(source, sink, "window", ~trace_model: interface_trace_window())
  | #void

sync_circuit EventWindow(intrinsic :: Boolean = #true, live_support :: Boolean = #true, batched :: Boolean = #false):
  interface source(Valid(Bits(8)), ~role: consumer)
  interface sink(Decoupled(Bits(8)), ~role: producer)
  input(flush, emit, live, capture): Bool
  input(remove_count, selected): Bits(2)
  input append_count: Bits(2)
  output occupancy: Bits(2)
  inst storage(WindowCell(intrinsic, live_support, batched))
  storage.flush <== flush
  storage.emit <== emit
  storage.live <== live
  storage.capture <== capture
  storage.remove_count <== remove_count
  storage.selected <== selected
  storage.append_count <== append_count
  occupancy <== storage.occupancy
  source |> trace_valid_event("word", ~payload: #true) |> storage.source
  if !intrinsic
  | describe_interface_transform(InterfaceHandle(storage.source, storage.sink), "window", {}, storage, ~trace_model: interface_trace_window(storage))
  | #void
  storage.sink |> pipe(1) |> trace_event("instruction", ~payload: #true) |> sink

sync_circuit EventFrontend():
  def xlen = XLen.X64
  interface control(RV5StageFrontendControl(xlen), ~role: frontend)
  interface memory(RV5StageFetchAccess(xlen, #false), ~role: requester)
  interface fetched(Decoupled(FetchDecode(xlen, #false)), ~role: producer)
  inst frontend(RV5StageFetchFixture(RV5StageConfig(~xlen: xlen, ~extensions: RV5StageExtensions(~compressed: CCompressedExtensions))))
  control <=> frontend.control
  memory <=> frontend.memory
  def output = frontend.fetched |> trace_event("core.s1.fetch", ~stalls: #true, ~fields: instruction):
    pc: instruction.pc
  output |> fetched

fun child_flush(instance): instance.module_def.find_input("flush").value

sync_circuit BadWindow(kind :: String):
  input flag: Bool
  input amount: Bits(2)
  cond
  | kind == "missing": interface_trace_window()
  | kind == "width": describe_interface_window_storage(3, flag, flag, amount, flag, [flag])
  | kind == "selection": describe_interface_window_storage(1, flag, flag, flag, flag, [flag, flag])
  | kind == "selection-width": describe_interface_window_storage(3, flag, amount, amount, flag, [amount])
  | kind == "live-width": describe_interface_window_storage(3, flag, amount, amount, flag, [flag], ~live: amount)
  | kind == "append-width": describe_interface_window_storage(3, flag, amount, amount, flag, [flag], ~append_count: flag)
  | kind == "live-foreign":
      inst child(WindowCell(#false))
      describe_interface_window_storage(3, flag, amount, amount, flag, [flag], ~live: child_flush(child))
  | kind == "foreign":
      inst child(WindowCell(#false))
      describe_interface_window_storage(3, flag, amount, amount, child_flush(child), [flag])
  | kind == "duplicate":
      describe_interface_window_storage(3, flag, amount, amount, flag, [flag])
      describe_interface_window_storage(3, flag, amount, amount, flag, [flag])

fun bad_window(kind): compile_program(elaborate(BadWindow(kind)), rtl_target).report.elaboration
fun window(intrinsic, live_support = #true, batched = #false): elaborate(EventWindow(intrinsic, live_support, batched))
def frontend = elaborate(EventFrontend())
export:
  window
  frontend
  bad_window
