#lang rhombus
// SPDX-License-Identifier: Apache-2.0
import:
  lib("rhodium/backend/rsim-target.rhm").rsim_target
  lib("rhodium/compile/pipeline.rhm").rtl_pipeline_target
  lib("rhodium/event/trace-pass.rhm").event_trace_pass
  "../event-retained-fixture.rhdl".retained
  "../../../../rhodium/event/main.rhm".EventInstrumentationConfig

def program = retained(~residency: #true)
def target = rtl_pipeline_target(rsim_target, [event_trace_pass(EventInstrumentationConfig(~partial: #true))])
export program target
