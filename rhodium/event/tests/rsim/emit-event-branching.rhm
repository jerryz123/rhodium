#lang rhombus
// SPDX-License-Identifier: Apache-2.0
import:
  "../event-feedback-fixture.rhdl".branching
  "trace-sites.rhm".traced_target

def program = branching
fun site_header(manifest):
  def indices = for List (lane in ["direct", "configured"]):
    def sites = for List (label in ["start0", "start1", "finish0", "finish1"]):
      def matches = (for List (index in 0..manifest.sites.length()): index).filter(~keep: fun (index): manifest.sites[index].label == label && manifest.sites[index].id.contains("/" ++ lane ++ "/"))
      unless matches.length() == 1 | error("expected one branching site: " ++ lane ++ "/" ++ label)
      to_string(matches[0])
    "{" ++ String.join(sites, ",") ++ "}"
  "\nconstexpr unsigned branching_sites[2][4] = {" ++ String.join(indices, ",") ++ "};\n"
def target = traced_target(site_header)
export program target
