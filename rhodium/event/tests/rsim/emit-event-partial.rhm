import:
  "../event-partial-fixture.rhdl" as fixture
  "../../../../rhodium/event/main.rhm".EventInstrumentationConfig
  "trace-sites.rhm".traced_target

def program = fixture.partial()
fun site_header(manifest):
  def constants = for List (site in manifest.sites, index in 0..manifest.sites.length()):
    "inline constexpr unsigned " ++ site.label.replace(".", "_") ++ " = " ++ to_string(index) ++ ";\n"
  "\nnamespace test_sites {\n" ++ String.join(constants, "") ++ "}\n"
def target = traced_target(site_header, EventInstrumentationConfig(~partial: #true))
export program target
