#lang rhombus
// SPDX-License-Identifier: Apache-2.0
import:
  "../../core/ir.rhm" open
  "../../frontend/kernel.rhm".active_module
export:
  Observer
  observe
class Observer(owner :: Module, value :: Value, port :: Port, operation :: Operation,
               instances :: List.of(Instance), cache :: Array):
  implements ModuleMetadataPayload
  override method remap_ir(remap :: Function.of_arity(1)):
    Observer(remap(owner), remap(value), remap(port), remap(operation), remap(instances), remap(cache))
fun observe(instances :: List.of(Instance) = []):
  def owner = active_module()
  def value = owner.inputs[0].value
  def payload = Observer(owner, value, owner.inputs[0], owner.find_operation(value.defining_op_id), instances, Array(value, value))
  owner.add_metadata("other-observer", payload)
