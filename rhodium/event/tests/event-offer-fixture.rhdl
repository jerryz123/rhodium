#lang rhodium
// Traces observation-gated best-effort offers without changing their public handshake.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  lib("flow/main.rhdl") open

sync_circuit EventOffer():
  interface source(Valid(Bits(8)), ~role: consumer)
  interface sink(Decoupled(Bits(8)), ~role: producer)
  input observe: Bool
  output offer_ready: Bool
  def attempted = source |> trace_valid_event("attempt", ~payload: #true)
  def offered = attempted |> offer_decoupled()
  offer_ready <== offered.ready
  def admitted = offered
    |> trace_event("admitted", ~when: observe, ~stalls: #true, ~fields: payload):
         value: payload
  admitted |> sink

sync_circuit InvalidEventOffer(kind :: String):
  input bad_predicate: Bits(2)
  def Source = if kind == "protocol" | Decoupled(Bits(8)) | Valid(Bits(8))
  def Sink = if kind == "stronger" | Irrevocable(Bits(8)) | Decoupled(Bits(8))
  interface source(Source, ~role: consumer)
  interface sink(Sink, ~role: producer)
  def offered = source |> offer_decoupled()
  if kind == "predicate"
  | offered |> trace_event("bad", ~when: bad_predicate) |> sink
  | offered |> sink

def offered = elaborate(EventOffer())
fun invalid(kind :: String): compile_program(elaborate(InvalidEventOffer(kind)), rtl_target).report.elaboration
export:
  offered
  invalid
