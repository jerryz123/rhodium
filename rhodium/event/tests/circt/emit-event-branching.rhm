#lang rhombus
// Emits queued crossbar feedback RTL and descriptor-resolved indices for both traced lanes.
// SPDX-License-Identifier: Apache-2.0
import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/backend/circt-target.rhm").circt_target
  lib("rhodium/compile/pipeline.rhm").rtl_pipeline_target
  lib("rhodium/event/trace-pass.rhm").event_trace_pass
  "../event-feedback-fixture.rhdl".branching
def compiled = compile_program(branching, rtl_pipeline_target(circt_target, [event_trace_pass()]))
def manifest = compiled.report.stages[0].findings.manifest
def indices = for List (lane in ["direct", "configured"]):
  def sites = for List (label in ["start0", "start1", "finish0", "finish1"]):
    def matches = (for List (index in 0..manifest.sites.length()): index).filter(~keep: fun (index): manifest.sites[index].label == label && manifest.sites[index].id.contains("/" ++ lane ++ "/"))
    unless matches.length() == 1 | error("expected one branching site: " ++ lane ++ "/" ++ label)
    to_string(matches[0])
  "{" ++ String.join(sites, ",") ++ "}"
def event_manifest_cpp = compiled.artifacts.find(fun (artifact): artifact.name == "events.h").content ++ "\nconstexpr unsigned branching_sites[2][4] = {" ++ String.join(indices, ",") ++ "};\n"
export event_manifest_cpp
print(compiled.artifacts[0].content)
