import:
  "../../../../rhodium/backend/circt.rhm".emit_circt
  "../../../../rhodium/event/main.rhm".instrument_events
  "../event-elastic-fixture.rhdl" as fixture
  "../../../core/main.rhm".materialize_constructs
  "../../../../flow/pipe.rhdl".PipeExpansions
  "../../../../flow/map.rhdl".MapExpansion

def expanded = materialize_constructs(fixture.retained_elastic, PipeExpansions ++ [MapExpansion]).elaboration
print(emit_circt(instrument_events(expanded).instrumented.design))
