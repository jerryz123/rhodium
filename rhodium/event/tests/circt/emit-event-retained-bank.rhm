#lang rhombus
// Emits indexed retained ownership with per-entry residency and its native descriptor.
// SPDX-License-Identifier: Apache-2.0
import:
  "../event-retained-bank-fixture.rhdl".bank
  "../../main.rhm" open
  "../../../backend/circt.rhm".emit_circt
def traced = instrument_events(bank())
def sites = for List (site in traced.manifest.sites, index in 0..traced.manifest.sites.length()):
  "inline constexpr unsigned " ++ site.label.replace("[", "").replace("]", "") ++ " = " ++ to_string(index) ++ ";\n"
def event_manifest_cpp = event_manifest_to_cpp(traced.manifest) ++ "\nnamespace test_sites {\n" ++ String.join(sites, "") ++ "}\n"
export event_manifest_cpp
print(emit_circt(traced.instrumented.design))
