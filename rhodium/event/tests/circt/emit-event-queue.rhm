import:
  "../../../../rhodium/backend/circt.rhm".emit_circt
  "../../../../rhodium/event/main.rhm".instrument_events
  "../event-queue-fixture.rhdl" as fixture
  "../../../core/main.rhm".materialize_constructs
  "../../../../flow/queue.rhdl".QueueExpansion

def materialized = materialize_constructs(fixture.retained_queued, [QueueExpansion])
print(emit_circt(instrument_events(materialized.elaboration).instrumented.design))
