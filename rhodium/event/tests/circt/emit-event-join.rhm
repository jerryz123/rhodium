#lang rhombus
// Emits join instrumentation and its matching runtime manifest descriptor.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/backend/circt-target.rhm").circt_target
  lib("rhodium/compile/pipeline.rhm").rtl_pipeline_target
  lib("rhodium/event/trace-pass.rhm").event_trace_pass
  "../event-join-fixture.rhdl" as fixture

export event_manifest_cpp
def compiled = compile_program(fixture.joined, rtl_pipeline_target(circt_target, [event_trace_pass()]))
def event_manifest_cpp = compiled.artifacts.find(fun (artifact): artifact.name == "events.h").content
print(compiled.artifacts[0].content)
