#lang rhombus
// Emits the instrumented event fixture through the unchanged CIRCT backend.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/backend/circt-target.rhm").circt_target
  lib("rhodium/compile/pipeline.rhm").rtl_pipeline_target
  lib("rhodium/event/trace-pass.rhm").event_trace_pass
  "../event-instrument-fixture.rhdl" as fixture

def compiled = compile_program(fixture.runtime, rtl_pipeline_target(circt_target, [event_trace_pass()]))
print(compiled.artifacts[0].content)
