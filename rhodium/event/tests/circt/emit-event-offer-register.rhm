#lang rhombus
// Emits OfferRegister lineage and matching occurrence descriptors for public-control tests.
// SPDX-License-Identifier: Apache-2.0
import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/backend/circt-target.rhm").circt_target
  lib("rhodium/compile/pipeline.rhm").rtl_pipeline_target
  lib("rhodium/event/trace-pass.rhm").event_trace_pass
  "../event-offer-register-fixture.rhdl".offered
def compiled = compile_program(offered, rtl_pipeline_target(circt_target, [event_trace_pass()]))
def manifest = compiled.report.stages[0].findings.manifest
def constants = for List (site in manifest.sites, index in 0..manifest.sites.length()):
  "inline constexpr unsigned " ++ site.label.replace(".", "_") ++ " = " ++ to_string(index) ++ ";\n"
def event_manifest_cpp = compiled.artifacts.find(fun (artifact): artifact.name == "events.h").content ++ "\nnamespace test_sites {\n" ++ String.join(constants, "") ++ "}\n"
export event_manifest_cpp
print(compiled.artifacts[0].content)
