#lang rhombus
// Emits crossbar trace RTL and manifest-resolved site indices for its independent scoreboard.
// SPDX-License-Identifier: Apache-2.0
import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/backend/circt-target.rhm").circt_target
  lib("rhodium/compile/pipeline.rhm").rtl_pipeline_target
  lib("rhodium/event/trace-pass.rhm").event_trace_pass
  "../event-crossbar-fixture.rhdl".crossed
def compiled = compile_program(crossed, rtl_pipeline_target(circt_target, [event_trace_pass()]))
def manifest = compiled.report.stages[0].findings.manifest
def indices = for List (lane in ["direct", "configured"]):
  def sites = for List (label in ["input0", "input1", "input2", "output0", "output1"]):
    def matches = (for List (index in 0..manifest.sites.length()): index).filter(~keep: fun (index): manifest.sites[index].label == label && manifest.sites[index].id.contains("/" ++ lane ++ "/"))
    unless matches.length() == 1 | error("expected one crossbar site: " ++ lane ++ "/" ++ label)
    to_string(matches[0])
  "{" ++ String.join(sites, ",") ++ "}"
def event_manifest_cpp = compiled.artifacts.find(fun (artifact): artifact.name == "events.h").content ++ "\nconstexpr unsigned crossbar_sites[2][5] = {" ++ String.join(indices, ",") ++ "};\n"
export event_manifest_cpp
print(compiled.artifacts[0].content)
