#lang rhombus
// Emits feedback instrumentation and manifest-bound indices for the transfer scoreboard.
// SPDX-License-Identifier: Apache-2.0
import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/backend/circt-target.rhm").circt_target
  lib("rhodium/compile/pipeline.rhm").rtl_pipeline_target
  lib("rhodium/event/trace-pass.rhm").event_trace_pass
  "../event-feedback-fixture.rhdl".compared
def compiled = compile_program(compared, rtl_pipeline_target(circt_target, [event_trace_pass()]))
def manifest = compiled.report.stages[0].findings.manifest
def indices = for List (label in ["start", "finish", "joined.left", "joined.right", "joined.finish"]):
  def matches = (for List (index in 0..manifest.sites.length()): index).filter(~keep: fun (index): manifest.sites[index].label == label)
  unless matches.length() == 1 | error("expected one feedback site: " ++ label)
  to_string(matches[0])
def event_manifest_cpp = compiled.artifacts.find(fun (artifact): artifact.name == "events.h").content ++ "\nconstexpr unsigned feedback_sites[5] = {" ++ String.join(indices, ",") ++ "};\n"
export event_manifest_cpp
print(compiled.artifacts[0].content)
