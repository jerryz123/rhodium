#lang rhombus
// Verifies indexed retention's occurrence graph, compiler isolation, and contract diagnostics.
// SPDX-License-Identifier: Apache-2.0
import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  "../main.rhm" open
  "../../backend/circt.rhm".emit_circt
  "event-retained-bank-fixture.rhdl" as fixture

for (residency in [#true, #false]):
  def logical = compile_program(fixture.bank(#true, residency), rtl_target).report.elaboration
  def original = emit_circt(logical.design)
  def traced = instrument_events(logical)
  check:
    emit_circt(logical.design) ~is original
    traced.manifest.sites.filter(~keep: fun (site): site.kind == "residency").map(fun (site): site.label) ~is (if residency | ["resident[0]", "resident[1]", "resident[2]"] | [])
    traced.manifest.dependencies.length() ~is (if residency | 9 | 2)
    traced.manifest.gaps ~is []
def inline = instrument_events(compile_program(fixture.bank(#false, #false), rtl_target).report.elaboration)
def selected = instrument_events(compile_program(fixture.bank(#true, #true, "parents"), rtl_target).report.elaboration)
check:
  inline.manifest.dependencies.length() ~is 2
  compile_program(fixture.bank(#true, #true, "length"), rtl_target).report.elaboration ~throws "matching lengths"
  compile_program(fixture.bank(#true, #true, "width"), rtl_target).report.elaboration ~throws "local one-bit"
  compile_program(fixture.bank(#true, #true, "grants"), rtl_target).report.elaboration ~throws "one grant per entry"
  compile_program(fixture.bank(#true, #true, "outputs"), rtl_target).report.elaboration ~throws "one input and one ordered route per output"
  compile_program(fixture.bank(#false, #false, "owner"), rtl_target).report.elaboration ~throws "trace model must match the transform implementation"
  infer_event_manifest(compile_program(fixture.bank(#true, #true, "label"), rtl_target).report.elaboration) ~throws "expanded event label must be unique"
  selected.manifest.dependencies.length() ~is 11
