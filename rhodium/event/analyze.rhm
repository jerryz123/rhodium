#lang rhombus
// Infers static parents and nested storage, selection, routing, replication, and join plans.

import:
  "../core/ir.rhm".DesignElaboration
  "../core/ir.rhm".Value
  "../diagram/main.rhm" open
  "model.rhm" open

export:
  infer_event_manifest

class FlowArc(source :: String,
              destination :: String,
              transform :: False || String = #false,
              latency_cycles :: False || Nat = 0,
              trace_stages :: False || List.of(EventTraceStage || EventTraceQueue || EventTraceRetained) = [])

class EventCandidate(site :: EventSite,
                     transform_path :: List.of(String),
                     latency_cycles :: False || Nat,
                     trace_stages :: False || List.of(EventTraceStage || EventTraceQueue || EventTraceRetained))
class FlowSelection(instance_path :: List.of(String), grants :: List, inputs :: List.of(String))
class FlowRouting(instance_path :: List.of(String), routing_id :: String, predicates :: List,
                  input :: String, output_index :: Nat)
class FlowReplication(replication_id :: String, input :: String, output_index :: Nat)
class FlowBroadcast(instance_path :: List.of(String), broadcast_id :: String, accept :: Value, pending :: Value,
                    input :: String, output_index :: Nat)

fun occurrence_prefix(instance_path :: List.of(String)):
  String.join(instance_path, "/")

fun terminal_id(instance_path :: List.of(String),
                block_id :: String,
                port_id :: String):
  occurrence_prefix(instance_path) ++ "::" ++ block_id ++ "::" ++ port_id

fun transform_port(block :: DiagramBlock,
                   side :: String,
                   index :: Nat,
                   count :: Nat):
  def port_id:
    if count == 1
    | side
    | side ++ "[" ++ to_string(index) ++ "]"
  block.ports.find(
    fun (port): port.compound && port.id == port_id
  )

fun boundary_external_name(block :: DiagramBlock, port :: DiagramPort):
  cond
  | block.kind == "boundary" || block.kind == "boundary-array":
      def suffix = port.name.replace("interface.", "").replace("interface", "")
      if suffix == ""
      | block.label
      | if suffix.starts_with("[")
        | block.label ++ suffix
        | block.label ++ "." ++ suffix
  | block.kind == "input" || block.kind == "output": block.label
  | ~else: #false

fun same_dependency(left :: EventDependency,
                    right :: EventDependency):
  left.parent == right.parent && left.child == right.child && left.transform_path == right.transform_path && left.latency_cycles == right.latency_cycles

fun infer_event_manifest(logical :: DesignElaboration,
                         ~dynamic: dynamic :: Boolean = #false):
  def view = diagram(logical)
  def incoming = MutableMap{}
  def event_by_output = MutableMap{}
  def site_inputs = MutableMap{}
  def unsupported_by_output = MutableMap{}
  def selections = MutableMap{}
  def joins = MutableMap{}
  def routings = MutableMap{}
  def replications = MutableMap{}
  def broadcasts = MutableMap{}
  def roots = MutableSet{}
  def detached = MutableSet{}
  def stalled_sites = MutableSet{}
  def mutable sites = []

  fun add_arc(source :: String,
              destination :: String,
              transform :: False || String = #false,
              latency_cycles :: False || Nat = 0,
              trace_stages :: False || List.of(EventTraceStage || EventTraceQueue || EventTraceRetained) = []):
    incoming[destination] := incoming.get(destination, []) ++ [
      FlowArc(source, destination, transform, latency_cycles, trace_stages)
    ]

  fun expand(module_diagram :: DiagramModule,
             instance_path :: List.of(String)):
    when instance_path == [logical.top.name]
    | for (boundary in module_diagram.blocks):
        for (port in boundary.ports):
          when port.compound && boundary_external_name(boundary, port)
          | roots.add(terminal_id(instance_path, boundary.id, port.id))
    for (channel in module_diagram.channels):
      when channel.kind == "interface"
      | add_arc(
          terminal_id(instance_path, channel.source_block, channel.source_port),
          terminal_id(instance_path,
                      channel.destination_block,
                      channel.destination_port)
        )

    for (flow_block in module_diagram.blocks):
      when flow_block.kind == "flow" && !flow_block.delegate_ports
      | def trace_model = flow_block.trace_model
        def input_count = flow_block.ports.filter(
          ~keep: fun (port): port.compound && (
            port.id == "in" || port.id.starts_with("in[")
          )
        ).length()
        def output_count = flow_block.ports.filter(
          ~keep: fun (port): port.compound && (
            port.id == "out" || port.id.starts_with("out[")
          )
        ).length()
        when input_count == 0 || output_count == 0
        | error(~who: #'infer_event_manifest,
                "flow transform " ++ flow_block.label ++ " has no flat interface route")
        def input_ports:
          for List (input_index in 0..input_count):
            transform_port(flow_block, "in", input_index, input_count)
        def output_ports:
          for List (output_index in 0..output_count):
            transform_port(flow_block, "out", output_index, output_count)
        when input_ports.find(fun (port): !port) || output_ports.find(fun (port): !port)
        | error(~who: #'infer_event_manifest,
                "flow transform " ++ flow_block.label ++ " uses a nested or incomplete endpoint shape")

        if flow_block.event_annotation
        | block:
            def annotation = flow_block.event_annotation
            def site_id = occurrence_prefix(instance_path) ++ "/event:" ++ to_string(annotation.site_index)
            def mutable capture_offset = if annotation.payload | annotation.payload.type.packed_width() | 0
            def captures = for List (field in annotation.fields):
              def width = field.value.type.packed_width()
              capture_offset := capture_offset - width
              EventField(field.name, field.value.type.describe(), width, capture_offset, field.encoding, field.isa, field.pc, field.symbols, field.label)
            def site = EventSite(site_id,
                                 annotation.label,
                                 module_diagram.name,
                                 instance_path,
                                 annotation.site_index,
                                 input_ports[0].protocol,
                                 if annotation.payload | annotation.payload.type.describe() | #false,
                                 if annotation.payload | annotation.payload.type.packed_width() | #false,
                                 annotation.terminal,
                                 annotation.location.describe(),
                                 annotation.root,
                                 captures)
            sites := sites ++ [site]
            when annotation.stalls | stalled_sites.add(site.id)
            site_inputs[site.id] := input_ports.map(
              fun (port): terminal_id(instance_path, flow_block.id, port.id)
            )
            for (port in output_ports):
              event_by_output[terminal_id(instance_path, flow_block.id, port.id)] := site
        | if trace_model && (!dynamic || trace_model.dynamic)
          | def stages:
              cond
              | trace_model.selection_grants(): #false
              | trace_model.atomic_join_inputs(): #false
              | trace_model.routing_predicates(): #false
              | trace_model.atomic_fork_outputs(): #false
              | trace_model.broadcast_storage(): #false
              | trace_model.retained_storage():
                  def storage = trace_model.retained_storage()
                  [EventTraceRetained(instance_path ++ trace_model.owner_path(), storage.capture, storage.release, storage.active)]
              | trace_model.queue_storage():
                  def storage = trace_model.queue_storage()
                  def owner_path = instance_path ++ trace_model.owner_path()
                  [EventTraceQueue(owner_path, storage.depth, storage.enqueue, storage.dequeue,
                                   storage.read_address, storage.write_address, storage.stored_valid, storage.bypass)]
              | trace_model.elastic_stages():
                  def owner_path = instance_path ++ trace_model.owner_path()
                  trace_model.elastic_stages().map(fun (stage): EventTraceStage(owner_path, stage.advance, stage.valid))
              | trace_model.latency_cycles():
                  def owner_path = if flow_block.implementation_name | instance_path ++ [flow_block.implementation_name] | instance_path
                  for List (_ in 0..trace_model.latency_cycles()): EventTraceStage(owner_path)
              | ~else: #false
            when trace_model.atomic_join_inputs()
            | def inputs = input_ports.map(fun (port): terminal_id(instance_path, flow_block.id, port.id))
              joins[terminal_id(instance_path, flow_block.id, output_ports[0].id)] := inputs
            when trace_model.selection_grants()
            | def owner_path = instance_path ++ trace_model.owner_path()
              def inputs = input_ports.map(fun (port): terminal_id(instance_path, flow_block.id, port.id))
              selections[terminal_id(instance_path, flow_block.id, output_ports[0].id)] := FlowSelection(owner_path, trace_model.selection_grants(), inputs)
            when trace_model.routing_predicates()
            | def routing_id = occurrence_prefix(instance_path) ++ "/" ++ flow_block.id
              def input = terminal_id(instance_path, flow_block.id, input_ports[0].id)
              for (port in output_ports, index in 0..output_count):
                def routing = FlowRouting(instance_path, routing_id, trace_model.routing_predicates(), input, index)
                routings[terminal_id(instance_path, flow_block.id, port.id)] := routing
            when trace_model.atomic_fork_outputs()
            | def replication_id = occurrence_prefix(instance_path) ++ "/" ++ flow_block.id
              def input = terminal_id(instance_path, flow_block.id, input_ports[0].id)
              for (port in output_ports, index in 0..output_count):
                def replication = FlowReplication(replication_id, input, index)
                replications[terminal_id(instance_path, flow_block.id, port.id)] := replication
            when trace_model.broadcast_storage()
            | def storage = trace_model.broadcast_storage()
              def owner_path = instance_path ++ trace_model.owner_path()
              def broadcast_id = occurrence_prefix(instance_path) ++ "/" ++ flow_block.id
              def input = terminal_id(instance_path, flow_block.id, input_ports[0].id)
              for (port in output_ports, index in 0..output_count):
                def broadcast = FlowBroadcast(owner_path, broadcast_id, storage.accept, storage.pending[index], input, index)
                broadcasts[terminal_id(instance_path, flow_block.id, port.id)] := broadcast
            for (route in trace_model.routes):
              def input_port = input_ports[route.input_index]
              def output_port = output_ports[route.output_index]
              if trace_model.detached()
              | detached.add(terminal_id(instance_path, flow_block.id, output_port.id))
              | add_arc(
                terminal_id(instance_path, flow_block.id, input_port.id),
                terminal_id(instance_path, flow_block.id, output_port.id),
                occurrence_prefix(instance_path) ++ "/" ++ flow_block.id ++ ":" ++ flow_block.label,
                trace_model.latency_cycles(),
                stages
              )
          | for (port in output_ports):
              unsupported_by_output[
                terminal_id(instance_path, flow_block.id, port.id)
              ] := occurrence_prefix(instance_path) ++ "/" ++ flow_block.id ++ ":" ++ flow_block.label

    for (instance_block in module_diagram.blocks):
      when (instance_block.kind == "instance" || instance_block.delegate_ports) && instance_block.child_module
      | def child = view.module(instance_block.child_module)
        unless child
        | error(~who: #'infer_event_manifest,
                "event analysis cannot find child module " ++ instance_block.child_module)
        def child_path = instance_path ++ [if instance_block.implementation_name | instance_block.implementation_name | instance_block.label]
        expand(child, child_path)
        def mutable child_boundary_ports = []
        for (child_block in child.blocks):
          for (child_port in child_block.ports):
            def external_name = boundary_external_name(child_block, child_port)
            when external_name
            | child_boundary_ports := child_boundary_ports ++ [
                [external_name, child_block, child_port]
              ]
        for (parent_port in instance_block.ports):
          def matched = child_boundary_ports.find(
            fun (entry): entry[0] == (if instance_block.delegate_ports | instance_block.delegate_ports.get(parent_port.id, #false) | parent_port.name)
          )
          when matched
          | def parent_terminal = terminal_id(instance_path, instance_block.id, parent_port.id)
            def child_terminal = terminal_id(child_path, matched[1].id, matched[2].id)
            if parent_port.direction == "input"
            | add_arc(parent_terminal, child_terminal)
            | add_arc(child_terminal, parent_terminal)

  def top = view.module(logical.top.name)
  unless top
  | error(~who: #'infer_event_manifest,
          "event analysis cannot find top module " ++ logical.top.name)
  expand(top, [logical.top.name])

  fun nearest_events(vertex :: String,
                     visiting :: List.of(String) = [],
                     reverse_transform_path :: List.of(String) = [],
                     latency_cycles :: False || Nat = 0,
                     trace_stages :: False || List.of(EventTraceStage || EventTraceQueue || EventTraceRetained) = []):
    def event = event_by_output.get(vertex, #false)
    cond
    | event: [EventCandidate(event, reverse_transform_path.reverse(), latency_cycles, trace_stages)]
    | vertex in detached: []
    | ~else:
        def unsupported = unsupported_by_output.get(vertex, #false)
        when unsupported
        | error(~who: #'infer_event_manifest,
                "event dependency crosses transform without " ++ (if dynamic | "dynamic trace semantics: " | "a trace model: ") ++ unsupported)
        when dynamic && incoming.get(vertex, []).length() == 0 && !(vertex in roots)
        | error(~who: #'infer_event_manifest, "event dependency reaches an opaque or disconnected boundary: " ++ vertex)
        if vertex in visiting
        | if dynamic
          | error(~who: #'infer_event_manifest, "dynamic event lineage requires an acyclic combinational path: " ++ vertex)
          | []
        | block:
            def mutable candidates = []
            for (arc in incoming.get(vertex, [])):
              def next_path:
                if arc.transform
                | reverse_transform_path ++ [arc.transform]
                | reverse_transform_path
              candidates := candidates ++ nearest_events(
                arc.source,
                visiting ++ [vertex],
                next_path,
                if latency_cycles && arc.latency_cycles | latency_cycles + arc.latency_cycles | #false,
                if trace_stages && arc.trace_stages | arc.trace_stages ++ trace_stages | #false
              )
            candidates

  def mutable dependencies = []
  for (site in sites):
    for (input in (if site.root | [] | site_inputs.get(site.id, []))):
      for (candidate in nearest_events(input)):
        def dependency = EventDependency(candidate.site.id,
                                         site.id,
                                         candidate.transform_path,
                                         candidate.latency_cycles,
                                         candidate.trace_stages)
        unless dependencies.find(
          fun (existing): same_dependency(existing, dependency)
        )
        | dependencies := dependencies ++ [dependency]

  // Construct expressions at flow vertices so storage downstream of selection
  // wraps the selected reference once, rather than duplicating it per parent.
  def plans = MutableMap{}
  def cached_plans = MutableMap{}
  fun trace_plan(vertex :: String, visiting :: List.of(String) = []):
    when vertex in visiting
    | error(~who: #'infer_event_manifest, "dynamic event lineage requires an acyclic path: " ++ vertex)
    unless cached_plans.has_key(vertex)
    | def event = event_by_output.get(vertex, #false)
      def arcs = incoming.get(vertex, [])
      def selection = selections.get(vertex, #false)
      def join = joins.get(vertex, #false)
      def routing = routings.get(vertex, #false)
      def replication = replications.get(vertex, #false)
      def broadcast = broadcasts.get(vertex, #false)
      def plan:
        cond
        | event: EventTraceSource(event.id)
        | vertex in detached: EventTraceSource(#false, #true)
        | join: EventTraceJoin(join.map(fun (input): trace_plan(input, visiting ++ [vertex])))
        | broadcast:
            EventTraceBroadcast(trace_plan(broadcast.input, visiting ++ [vertex]), broadcast.instance_path,
                                broadcast.broadcast_id, broadcast.accept, broadcast.pending, broadcast.output_index)
        | replication:
            EventTraceReplication(trace_plan(replication.input, visiting ++ [vertex]),
                                  replication.replication_id, replication.output_index)
        | routing:
            EventTraceRouting(trace_plan(routing.input, visiting ++ [vertex]), routing.instance_path,
                              routing.routing_id, routing.predicates, routing.output_index)
        | selection:
            EventTraceSelection(selection.instance_path, selection.grants,
                                selection.inputs.map(fun (input): trace_plan(input, visiting ++ [vertex])))
        | arcs.length() == 0 && vertex in roots: EventTraceSource(#false)
        | arcs.length() == 1 && arcs[0].trace_stages:
            def upstream = trace_plan(arcs[0].source, visiting ++ [vertex])
            if arcs[0].trace_stages.length() == 0
            | upstream
            | EventTracePipeline(upstream, arcs[0].trace_stages)
        | ~else: error(~who: #'infer_event_manifest, "event path requires certified selection or storage semantics: " ++ vertex)
      cached_plans[vertex] := plan
    cached_plans[vertex]
  when dynamic
  | for (site in sites):
      plans[site.id] := if site.root | EventTraceSource(#false) | trace_plan(site_inputs[site.id][0])
  // Append observations after transfer sites, preserving existing site numbering.
  // They never enter event_by_output: a stall cannot cut or advance lineage.
  for (site in sites):
    when site.id in stalled_sites
    | def stall = EventSite(site.id ++ "/stall", site.label ++ ".stall", site.module_name,
                            site.instance_path, site.local_site, site.protocol, site.payload_type,
                            site.payload_width, #true, site.source_location, site.root, site.fields,
                            "stall", site.id)
      sites := sites ++ [stall]
      // Only linear transfer contracts currently expose certified pending
      // references. Selection/routing/replication/join offers need separate contracts.
      def parents = dependencies.filter(~keep: fun (edge): edge.child == site.id && edge.trace_stages != #false)
      for (edge in parents):
        dependencies := dependencies ++ [EventDependency(edge.parent, stall.id, edge.transform_path, #false, edge.trace_stages)]
      when dynamic
      | plans[stall.id] := (if parents.length() > 0 | plans[site.id] | EventTraceSource(#false))
  EventManifest(logical, sites, dependencies, for Map (id in plans.keys()): values(id, plans[id]))
