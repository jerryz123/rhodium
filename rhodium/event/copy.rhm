#lang rhombus
/* Copies event instrumentation occurrences and remaps extension metadata into their destination ownership. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../core/ir.rhm" open
  "../core/builder.rhm".Builder
  "../lowering/copy.rhm".make_ir_remapper

export:
  ModuleCopy
  copy_module

/* Carries the copied body, instrumentation lookups, and unambiguous subtree references.
   Ambiguous source objects name multiple specialized occurrences and cannot be guessed. */
class ModuleCopy(module_def :: Module, values :: MutableMap, instances :: MutableMap,
                 objects :: MutableMap, ambiguous :: MutableSet)

/* Copy a module with child copies selected per instance, preserving source metadata.
   Reuse the portable remapping protocol and child payload identities; reject bare
   references whose source object maps to multiple specialized descendants. */
fun copy_module(builder :: Builder,
                original :: Module,
                name :: String,
                children :: MutableMap,
                imports :: MutableMap):
  def target = builder.module(name)
  def objects = MutableMap.by(===){original: target}
  def ambiguous = MutableSet.by(===){}
  for (child in children.values()):
    for (key in child.ambiguous): ambiguous.add(key)
    for (key in child.objects.keys()):
      when objects.has_key(key) && !(objects[key] === child.objects[key])
      | ambiguous.add(key)
      objects[key] := child.objects[key]
  for (key in ambiguous): objects.remove(key)
  /* DPI imports are already cloned once for the complete instrumentation design. */
  fun remap_import(imported :: DpiImport):
    unless imports.has_key(imported)
    | error(~who: #'copy_module, "unmapped DPI import in attributes or metadata")
    imports[imported]
  def remap = make_ir_remapper(objects, remap_import)
  def ids = MutableMap{}
  def value_map = MutableMap{}
  def places = MutableMap{}
  def instances = MutableMap{}
  for (op in original.operations):
    if op.opcode == "rtl.instance"
    | block:
        def instance = builder.instance(target, children[op.id].module_def, op.attribute("name"), op.location, op.origin)
        instances[op.id] := instance
        objects[op] := instance.operation
        ids[op.id] := instance.operation.id
        for (value in op.results, replacement in instance.operation.results.take(op.results.length())):
          value_map[value.id] := replacement
          objects[value] := replacement
        for (place in op.places, replacement in instance.operation.places.take(op.places.length())):
          places[place.id] := replacement
          objects[place] := replacement
    | ids[op.id] := builder.design.fresh_id()
  for (value in original.values):
    unless value_map.has_key(value.id)
    | def replacement = Value(builder.design.fresh_id(), value.name, value.type, target, ids[value.defining_op_id])
      value_map[value.id] := replacement
      objects[value] := replacement
      target.add_value(replacement)
  for (place in original.places):
    unless places.has_key(place.id)
    | def replacement = Place(builder.design.fresh_id(), place.name, place.type, target, ids[place.owner_op_id])
      places[place.id] := replacement
      objects[place] := replacement
      target.add_place(replacement)
  for (memory in original.memories):
    def replacement = Memory(builder.design.fresh_id(), memory.name, memory.depth, memory.element_type, target, ids[memory.defining_op_id])
    objects[memory] := replacement
    target.add_memory(replacement)
  for (op in original.operations):
    unless op.opcode == "rtl.instance"
    | def operands = op.operands.map(fun (value): value_map[value.id])
      def replacement = Operation(ids[op.id], op.opcode, target, operands,
                                  op.results.map(fun (value): value_map[value.id]),
                                  op.places.map(fun (place): places[place.id]),
                                  remap(op.attributes), op.location, op.origin)
      objects[op] := replacement
      for (operand in operands): operand.add_user(replacement.id)
      target.add_operation(replacement)
  for (place in original.places):
    when place.driver
    | places[place.id].set_driver(value_map[place.driver.id])
  for (port in original.inputs):
    def replacement = Port(port.name, port.direction, port.type, value_map[port.value.id])
    objects[port] := replacement
    target.add_input(replacement)
  for (port in original.outputs):
    def replacement = Port(port.name, port.direction, port.type, #false, places[port.place.id])
    objects[port] := replacement
    target.add_output(replacement)
  for (place in original.places):
    for (projected in place.projected_places): objects[place].add_projected_place(remap(projected))
  for (entry in original.metadata): target.add_metadata(entry.namespace, remap(entry.payload))
  ModuleCopy(target, value_map, instances, objects, ambiguous)
