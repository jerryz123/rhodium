#lang rhombus
// Serializes event manifests as JSON and matching compiler-owned C++ descriptors.

import:
  lib("json/main.rkt").#{jsexpr->string} as encode_json_string
  "model.rhm" open

export:
  event_manifest_to_json
  event_manifest_to_cpp

fun json_string(value :: String):
  encode_json_string(value)

fun json_value(value :: String || Boolean || Number || Array || List || Map):
  cond
  | value is_a String: json_string(value)
  | value is_a Boolean:
      if value | "true" | "false"
  | value is_a Number: to_string(value)
  | value is_a Array:
      "[" ++ String.join(value.map(json_value), ",") ++ "]"
  | value is_a List:
      "[" ++ String.join(value.map(json_value), ",") ++ "]"
  | value is_a Map:
      def entries = value.keys(#true).map(
        fun (key): json_string(key) ++ ":" ++ json_value(value[key])
      )
      "{" ++ String.join(entries, ",") ++ "}"
  | ~else:
      error(~who: #'event_manifest_to_json,
            "event manifest value is not JSON-serializable: " ++ to_string(value))

fun json_site(site :: EventSite):
  {
    "id": site.id,
    "label": site.label,
    "module": site.module_name,
    "instance_path": site.instance_path,
    "local_site": site.local_site,
    "protocol": site.protocol,
    "payload_type": site.payload_type || #false,
    "payload_width": site.payload_width || #false,
    "fields": site.fields.map(fun (field): {
      "name": field.name, "type": field.type, "width": field.width,
      "offset": field.offset, "encoding": field.encoding
    }),
    "terminal": site.terminal,
    "root": site.root,
    "source_location": site.source_location
  }

fun json_dependency(dependency :: EventDependency):
  {
    "parent": dependency.parent,
    "child": dependency.child,
    "transform_path": dependency.transform_path,
    "latency_cycles": dependency.latency_cycles
  }

fun event_manifest_to_json(manifest :: EventManifest):
  json_value({
    "format": "rhodium-event-graph",
    "version": 1,
    "top": manifest.logical.top.name,
    "sites": manifest.sites.map(json_site),
    "dependencies": manifest.dependencies.map(json_dependency)
  }) ++ "\n"

// Raw literals preserve JSON escaping and UTF-8 labels without interpreting
// JSON escapes as C++ escapes. Pick a delimiter absent from the actual JSON.
fun event_manifest_to_cpp(manifest :: EventManifest):
  unless manifest.sites.length() > 0 && manifest.sites.length() < 2 ** 32
  | error(~who: #'event_manifest_to_cpp, "runtime manifest requires a nonempty 32-bit site table")
  def json = event_manifest_to_json(manifest)
  fun delimiter(index :: Nat):
    def candidate = "rhdl" ++ to_string(index)
    if json.contains(")" ++ candidate ++ "\"")
    | delimiter(index + 1)
    | candidate
  def tag = delimiter(0)
  def ids = MutableMap{}
  for (site in manifest.sites, index in 0..manifest.sites.length()):
    if ids.has_key(site.id)
    | error(~who: #'event_manifest_to_cpp, "duplicate event site identity")
    | ids[site.id] := index
    unless (site.payload_width || 0) < 2 ** 32
    | error(~who: #'event_manifest_to_cpp, "runtime payload width must fit 32 bits")
  def widths = manifest.sites.map(fun (site): to_string(site.payload_width || 0))
  fun cpp_field(field :: EventField):
    // Names are raw literals too: quotes, backslashes and Unicode are not C++ escapes.
    def name_tag = tag ++ "f"
    when field.name.contains(")" ++ name_tag ++ "\"") || field.name.contains("\u0000")
    | error(~who: #'event_manifest_to_cpp, "capture name cannot be represented in descriptor")
    "{R\"" ++ name_tag ++ "(" ++ field.name ++ ")" ++ name_tag ++ "\"," ++ to_string(field.width) ++ "," ++ to_string(field.offset) ++ "," ++ json_string(field.encoding) ++ "}"
  def fields = manifest.sites.map(
    fun (site): "{" ++ String.join(site.fields.map(cpp_field), ",") ++ "}"
  )
  def edges = manifest.dependencies.map(
    fun (edge):
      unless ids.has_key(edge.parent) && ids.has_key(edge.child)
      | error(~who: #'event_manifest_to_cpp, "event dependency has unknown site")
      "{" ++ to_string(ids[edge.parent]) ++ "," ++ to_string(ids[edge.child]) ++ "}"
  )
  String.join([
    "// Binds this compiler manifest to its runtime site and dependency tables.\n",
    "#pragma once\n#include \"rheg.h\"\n",
    "namespace rheg_generated {\ninline rheg::Manifest manifest() {\n  return {R\"",
    tag ++ "(" ++ json ++ ")" ++ tag ++ "\", {" ++ String.join(widths, ","),
    "}, {" ++ String.join(edges, ",") ++ "}, {" ++ String.join(fields, ",") ++ "}};\n}\n}\n"
  ], "")
