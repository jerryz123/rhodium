#lang rhombus
// Defines structured lineage and bounded parent capacities through storage, routing, replication, and joins.

import:
  "../core/ir.rhm".DesignElaboration
  "../core/ir.rhm".Value

export:
  EventSite
  EventDependency
  EventTraceStage
  EventTraceQueue
  EventTracePlan
  EventTraceSource
  EventTracePipeline
  EventTraceSelection
  EventTraceRouting
  EventTraceReplication
  EventTraceBroadcast
  EventTraceJoin
  event_trace_capacity
  EventManifest

class EventSite(id :: String,
                label :: String,
                module_name :: String,
                instance_path :: List.of(String),
                local_site :: Nat,
                protocol :: String,
                payload_type :: False || String,
                payload_width :: False || PosInt,
                terminal :: Boolean,
                source_location :: String,
                root :: Boolean = #false)

// Empty controls mean an unconditional one-cycle delay. Elastic controls retain
// original IR identity plus the concrete occurrence that owns those signals.
class EventTraceStage(instance_path :: List.of(String) = [],
                      advance :: False || Value = #false,
                      valid :: False || Value = #false):
  method controls(): if advance | [advance, valid] | []

class EventTraceQueue(instance_path :: List.of(String), depth :: PosInt,
                      enqueue :: Value, dequeue :: Value,
                      read_address :: Value, write_address :: Value,
                      stored_valid :: Value, bypass :: Value):
  method controls(): [enqueue, dequeue, read_address, write_address, stored_valid, bypass]

interface EventTracePlan
class EventTraceSource(site :: False || String):
  implements EventTracePlan
class EventTracePipeline(input :: EventTracePlan, stages :: NonemptyList.of(EventTraceStage || EventTraceQueue)):
  implements EventTracePlan
class EventTraceSelection(instance_path :: List.of(String), grants :: NonemptyList.of(Value), inputs :: NonemptyList.of(EventTracePlan)):
  implements EventTracePlan
  method controls(): grants
class EventTraceRouting(input :: EventTracePlan, instance_path :: List.of(String),
                        routing_id :: String, predicates :: NonemptyList.of(Value), output_index :: Nat):
  implements EventTracePlan
  method controls(): predicates
class EventTraceReplication(input :: EventTracePlan, replication_id :: String, output_index :: Nat):
  implements EventTracePlan
class EventTraceBroadcast(input :: EventTracePlan, instance_path :: List.of(String),
                          broadcast_id :: String, accept :: Value, pending :: Value, output_index :: Nat):
  implements EventTracePlan
  method controls(): [accept, pending]

class EventTraceJoin(inputs :: NonemptyList.of(EventTracePlan)):
  implements EventTracePlan

// Capacity counts slots, not distinct identities; the runtime deduplicates edges.
// An annotation resets ancestry to one reference, so history does not accumulate.
fun event_trace_capacity(plan :: EventTracePlan) :: PosInt:
  def capacities = MutableMap.by(===){}
  fun capacity(node :: EventTracePlan):
    unless capacities.has_key(node)
    | def count:
        cond
        | node is_a EventTraceSource: 1
        | node is_a EventTraceJoin:
            def mutable total = 0
            for (input in node.inputs): total := total + capacity(input)
            total
        | node is_a EventTraceSelection:
            def mutable largest = 1
            for (input in node.inputs):
              def count = capacity(input)
              when count > largest | largest := count
            largest
        | ~else: capacity(node.input)
      capacities[node] := count
    capacities[node]
  capacity(plan)

class EventDependency(parent :: String,
                      child :: String,
                      transform_path :: List.of(String),
                      latency_cycles :: False || Nat = #false,
                      trace_stages :: False || List.of(EventTraceStage || EventTraceQueue) = #false)

class EventManifest(logical :: DesignElaboration,
                    sites :: List.of(EventSite),
                    dependencies :: List.of(EventDependency),
                    trace_plans :: Map = {}):
  method site(id :: String):
    sites.find(fun (candidate): candidate.id == id)
