#lang rhombus
/* Lowers bounded lineage graphs with preallocated feedback storage, preserved metadata, and DPI emission. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../core/ir.rhm" open
  "../core/builder.rhm".Builder
  "../core/verify.rhm".verify_design
  "../lowering/program.rhm".check_materialized_design
  "../diagram/main.rhm" open
  "model.rhm" open
  "analyze.rhm".infer_event_manifest
  "copy.rhm" open

export:
  EventInstrumentationConfig
  EventInstrumentedElaboration
  instrument_events

/* Selects the existing top clock/reset ports and whether incomplete ancestry is admitted. */
class EventInstrumentationConfig(clock_port :: String = "clock",
                                 reset_port :: String = "reset",
                                 ~partial: partial :: Boolean = #false)
/* Keeps the source graph and its manifest alongside the independent instrumented result. */
class EventInstrumentedElaboration(original :: DesignElaboration,
                                   instrumented :: DesignElaboration,
                                   manifest :: EventManifest)
/* Identifies one hierarchy occurrence even when its module definition is shared. */
class Occurrence(original :: Module, path :: List.of(String), ordinal :: Nat,
                 parent :: maybe(Nat), instance :: maybe(Operation),
                 mutable children :: List = []):
  reconstructor ~none
/* Tracks a sampled control in its owner occurrence and the consumer paths needing it. */
class TraceControl(path :: List.of(String), value :: Value, index :: Nat,
                   mutable consumers :: List = []):
  reconstructor ~none
/* Marks a visible consuming site while checking feedback fanout. */
class TraceExit(site :: String)

def reference_type = RecordType([RecordField("valid", Bits(1)),
                                 RecordField("site", Bits(32)),
                                 RecordField("sequence", Bits(64))])

/* Tests whether a hierarchy path lies within an ancestor occurrence. */
fun path_within(descendant :: List.of(String), ancestor :: List.of(String)):
  descendant.length() >= ancestor.length() && descendant.take(ancestor.length()) == ancestor
/* Tests whether an event site belongs to the selected occurrence subtree. */
fun within(site :: EventSite, path :: List.of(String)):
  path_within(site.instance_path, path)

/* Infer event semantics, copy the reachable hierarchy with metadata, and add passive tracing RTL. */
fun instrument_events(logical :: DesignElaboration,
                      config :: EventInstrumentationConfig = EventInstrumentationConfig()):
  def manifest = infer_event_manifest(logical, ~dynamic: #true, ~partial: config.partial)
  def topology = EventManifest(logical, manifest.sites, manifest.topology_dependencies || manifest.dependencies, manifest.topology_trace_plans || manifest.trace_plans)
  unless manifest.sites.length() > 0 && manifest.sites.length() < 2 ** 32
  | error(~who: #'instrument_events, "instrumentation requires 1..2^32-1 event occurrences")
  def top_clock = logical.top.inputs.find(fun (port): port.name == config.clock_port)
  def top_reset = logical.top.inputs.find(fun (port): port.name == config.reset_port)
  unless top_clock && clock_type(top_clock.type) && top_reset && reset_type(top_reset.type)
  | error(~who: #'instrument_events, "select a top-level Clock input and synchronous Reset input")
  def site_ids = MutableMap{}
  for (site in manifest.sites, index in 0..manifest.sites.length()): site_ids[site.id] := index
  def parent_plans = MutableMap{}
  /* Collects known upstream event sites from a finite lineage graph. */
  fun sources(plan :: EventTracePlan):
    event_trace_nodes(plan).filter(~keep: fun (node): node is_a EventTraceSource && !node.unknown && !node.absent).map(fun (node): node.site)
  /* Detects an unknown boundary in a lineage plan. */
  fun incomplete(plan :: EventTracePlan):
    event_trace_nodes(plan).find(fun (node): node is_a EventTraceSource && node.unknown != #false) != #false
  /* Collects storage and selection controls that must be observed in their owning occurrences. */
  fun plan_controls(plan :: EventTracePlan):
    def mutable found = []
    for (node in event_trace_nodes(plan)):
      cond
      | node is_a EventTracePipeline: found := found ++ node.stages
      | node is_a EventTraceRouting || node is_a EventTraceBroadcast || node is_a EventTraceSelection: found := found ++ [node]
      | ~else: #void
    found
  /* Detects a back reference requiring feedback-aware storage and fanout handling. */
  fun feedback(plan :: EventTracePlan):
    event_trace_nodes(plan).find(fun (node): node is_a EventTraceLink) != #false
  // Check actual graph forks, not pairs of walks: one router can be revisited
  // on different laps, so its decisions cannot be compared across those laps.
  /* Checks actual consumer forks in a cyclic graph against explicit divergence certificates. */
  fun feedback_branching(source :: String, children :: List.of(String)):
    def source_nodes = MutableMap{}
    /* Resolves back references and shares one source node per event site for fanout checking. */
    fun canonical(node :: EventTracePlan):
      cond
      | node is_a EventTraceLink: canonical(node.target)
      | node is_a EventTraceSource && node.site:
          unless source_nodes.has_key(node.site) | source_nodes[node.site] := node
          source_nodes[node.site]
      | ~else: node
    def consumers = MutableMap.by(===){}
    def discovered = MutableMap.by(===){}
    /* Records one ordered consumer edge for a canonical lineage node. */
    fun add(input :: EventTracePlan, consumer :: EventTracePlan || TraceExit, index :: Nat):
      def node = canonical(input)
      consumers[node] := consumers.get(node, []) ++ [[consumer, index]]
    for (child in children):
      def plan = topology.trace_plans[child]
      add(plan, TraceExit(child), 0)
      for (raw in event_trace_nodes(plan)):
        def node = canonical(raw)
        unless discovered.has_key(node)
        | discovered[node] := #true
          for (input in event_trace_inputs(node), index in 0..event_trace_inputs(node).length()):
            add(input, node, index)
    /* Extracts the certified router or replicator identity and its selected output. */
    fun branch(node :: EventTracePlan || TraceExit):
      cond
      | node is_a EventTraceRouting: ["routing", node.routing_id, node.output_index]
      | node is_a EventTraceReplication: ["replication", node.replication_id, node.output_index]
      | node is_a EventTraceBroadcast: ["broadcast", node.broadcast_id, node.output_index]
      | ~else: #false
    def visited = MutableMap.by(===){}
    /* Walks consumer edges once and rejects fanout without distinct certified outputs. */
    fun visit(node :: EventTracePlan || TraceExit):
      unless visited.has_key(node)
      | visited[node] := #true
        def edges = consumers.get(node, [])
        when edges.length() > 1
        | def first = branch(edges[0][0])
          def outputs = MutableSet{}
          for (edge in edges):
            def certificate = branch(edge[0])
            unless first && certificate && first.take(2) == certificate.take(2) && !(certificate[2] in outputs)
            | error(~who: #'instrument_events, "tracing does not support uncertified fanout at " ++ source)
            outputs.add(certificate[2])
        for (edge in edges): visit(edge[0])
    visit(source_nodes[source])
  // Alternatives record certified divergence from one source occurrence.
  // Different children must use distinct outputs of a shared exclusive router
  // or certified replicator. A common output or unrelated transforms do not suffice.
  /* Collects certified branch choices from the named source to a consuming plan. */
  fun alternatives(plan :: EventTracePlan, source :: String, choices :: List = []):
    cond
    | plan is_a EventTraceSource: (if plan.site == source | [choices] | [])
    | plan is_a EventTracePipeline: alternatives(plan.input, source, choices)
    | plan is_a EventTraceRouting: alternatives(plan.input, source, choices ++ [[plan.routing_id, plan.output_index]])
    | plan is_a EventTraceReplication: alternatives(plan.input, source, choices ++ [[plan.replication_id, plan.output_index]])
    | plan is_a EventTraceBroadcast: alternatives(plan.input, source, choices ++ [[plan.broadcast_id, plan.output_index]])
    | ~else:
        def mutable found = []
        for (input in plan.inputs): found := found ++ alternatives(input, source, choices)
        found
  for (site in manifest.sites):
    def edges = manifest.dependencies.filter(~keep: fun (edge): edge.child == site.id)
    when edges.length() > 0 || incomplete(manifest.trace_plans[site.id])
    | def plan = manifest.trace_plans[site.id]
      when #false in sources(plan)
      | error(~who: #'instrument_events, "selection or join requires an annotated ancestor on every input path: " ++ site.id)
      parent_plans[site.id] := plan
    def children = MutableSet{}
    for (edge in topology.dependencies):
      when edge.parent == site.id && manifest.site(edge.child).kind != "stall" | children.add(edge.child)
    when children.length() > 1
    | if (for any (child in children): feedback(topology.trace_plans[child]))
      | feedback_branching(site.id, for List (child in children): child)
      | for (left in children):
          for (right in children):
            when left != right
            | def left_edge = topology.dependencies.find(
                fun (edge): edge.parent == site.id && edge.child == left
              )
              def right_edge = topology.dependencies.find(
                fun (edge): edge.parent == site.id && edge.child == right
              )
              def shared_scope = left_edge && right_edge && left_edge.transform_path.length() == 1 && right_edge.transform_path.length() == 1 && left_edge.transform_path == right_edge.transform_path && left_edge.transform_path[0].starts_with("trace-edge:")
              unless shared_scope
              | for (left_path in alternatives(topology.trace_plans[left], site.id)):
                  for (right_path in alternatives(topology.trace_plans[right], site.id)):
                    unless left_path.find(fun (choice): right_path.find(fun (other): choice[0] == other[0] && choice[1] != other[1]))
                    | error(~who: #'instrument_events, "tracing does not support uncertified fanout at " ++ site.id)

  def mutable occurrences = []
  /* Enumerates instance occurrences without collapsing reused definitions. */
  fun expand(original :: Module, path :: List.of(String), parent :: maybe(Occurrence), instance :: maybe(Operation)):
    def occurrence = Occurrence(original, path, occurrences.length(), parent?.ordinal, instance)
    occurrences := occurrences ++ [occurrence]
    for (op in original.operations):
      when op.opcode == "rtl.instance"
      | occurrence.children := occurrence.children ++ [expand(op.attribute("module"), path ++ [op.attribute("name")], occurrence, op)]
    occurrence
  def root = expand(logical.top, [logical.top.name], #false, #false)

  // Deduplicate observed controls by original signal and concrete occurrence.
  // These ports only observe functional state; no trace value drives it.
  def mutable controls = []
  def control_ids = MutableMap{}
  for (site in manifest.sites):
    for (stage in (if parent_plans.has_key(site.id) | plan_controls(parent_plans[site.id]) | [])):
      when stage.controls().length() > 0
      | def owner = occurrences.find(fun (occurrence): occurrence.path == stage.instance_path)
        for (value in stage.controls()):
          unless owner && value.module_def === owner.original
          | error(~who: #'instrument_events, "trace controls do not belong to their occurrence")
          def key = [stage.instance_path, value.id]
          unless control_ids.has_key(key)
          | control_ids[key] := controls.length()
            controls := controls ++ [TraceControl(stage.instance_path, value, controls.length())]
          def control = controls[control_ids[key]]
          control.consumers := control.consumers ++ [site.instance_path]
  /* Selects controls owned within an occurrence subtree. */
  fun subtree_controls(occurrence :: Occurrence):
    controls.filter(~keep: fun (control): path_within(control.path, occurrence.path))
  /* Selects external controls required by consumers inside an occurrence subtree. */
  fun imported_controls(occurrence :: Occurrence):
    controls.filter(~keep: fun (control): !path_within(control.path, occurrence.path) && control.consumers.find(fun (path): path_within(path, occurrence.path)) != #false)
  /* Assigns a stable hidden observation-port name to a control index. */
  fun control_name(control :: TraceControl): "__event_control_" ++ to_string(control.index)
  /* Preserves the sampled control width in an unsigned observation port. */
  fun control_type(control :: TraceControl): Bits(scalar_width(control.value.type))

  // Trace controls must resolve to the selected root, independent of descendant port names.
  /* Resolves a control through instance bindings; probing an unused opaque input returns false. */
  fun control_root(value :: Value, occurrence :: Occurrence, consumer :: String,
                   ~probe: probe :: Boolean = #false):
    def op = occurrence.original.find_operation(value.defining_op_id)
    cond
    | op.opcode == "rtl.input_port":
        if !occurrence.parent
        | value
        | block:
            def mutable binding = #false
            for (port in occurrence.original.inputs, place in occurrence.instance.places):
              when port.value === value | binding := place.driver
            unless binding | error(~who: #'instrument_events, "unbound clock/reset in traced hierarchy")
            control_root(binding, occurrences[occurrence.parent], consumer, ~probe: probe)
    | op.opcode == "rtl.wire": control_root(op.places[0].driver, occurrence, consumer, ~probe: probe)
    | op.opcode == "rtl.cast": control_root(op.operands[0], occurrence, consumer, ~probe: probe)
    | ~else:
        if probe
        | #false
        | error(~who: #'instrument_events, "generated or opaque clock/reset in " ++ String.join(occurrence.path, "/") ++ " (" ++ op.opcode ++ ", consumed by " ++ consumer ++ ")")
  // Fixed delays have no sampled controls, but their functional storage must
  // share the epoch too. Include their implementation subtrees conservatively.
  def mutable fixed_domains = []
  for (site in manifest.sites):
    for (stage in (if parent_plans.has_key(site.id) | plan_controls(parent_plans[site.id]) | [])):
      when stage is_a EventTraceStage && !stage.advance && stage.instance_path.length() > 0
      | fixed_domains := fixed_domains ++ [stage.instance_path]
  for (occurrence in occurrences):
    def traced_domain = manifest.sites.find(fun (site): site.instance_path == occurrence.path) != #false || manifest.instances.find(fun (scope): scope.path == occurrence.path) != #false || controls.find(fun (control): control.path == occurrence.path) != #false || fixed_domains.find(fun (path): occurrence.path.length() >= path.length() && occurrence.path.take(path.length()) == path) != #false
    for (value in occurrence.original.values):
      when value.name.starts_with("__event_")
      | error(~who: #'instrument_events, "reserved instrumentation name: " ++ value.name)
      when traced_domain && occurrence.original.find_operation(value.defining_op_id).opcode == "rtl.input_port" && (clock_type(value.type) || reset_type(value.type))
      | def expected = (if clock_type(value.type) | top_clock.value | top_reset.value)
        unless control_root(value, occurrence, String.join(occurrence.path, "/") ++ ":input") === expected
        | error(~who: #'instrument_events, "tracing requires one clock and reset epoch: " ++ String.join(occurrence.path, "/"))
    for (place in occurrence.original.places):
      when place.name.starts_with("__event_")
      | error(~who: #'instrument_events, "reserved instrumentation name: " ++ place.name)
    for (op in occurrence.original.operations):
      for (operand in op.operands):
        // Merely constructing a reset for an unrelated child is not a local
        // state clock/reset use. Traced children validate their own bindings.
        when traced_domain && !(op.opcode in ["rtl.cast", "rtl.wire", "rtl.drive", "rtl.instance"]) && (clock_type(operand.type) || reset_type(operand.type))
        | def expected = (if clock_type(operand.type) | top_clock.value | top_reset.value)
          unless control_root(operand, occurrence, String.join(occurrence.path, "/") ++ ":" ++ op.opcode) === expected
          | error(~who: #'instrument_events, "tracing requires one clock and reset epoch: " ++ String.join(occurrence.path, "/"))

  def view = diagram(logical)
  for (occurrence in occurrences):
    def local_view = view.module(occurrence.original.name)
    def annotations = local_view.blocks.filter(~keep: fun (candidate): candidate.event_annotation != #false)
    def visible = manifest.sites.filter(~keep: fun (site): site.instance_path == occurrence.path && site.kind != "stall")
    def expected = for values(count = 0) (block in annotations): count + (block.event_annotation.residency_bank()?.entries?.length() || 1)
    unless expected == visible.length()
    | error(~who: #'instrument_events, "event annotations are hidden behind a transform implementation: " ++ String.join(occurrence.path, "/"))
  def design = Design([], logical.design.next_id)
  def builder = Builder(design)
  def imports = MutableMap.by(===){}
  for (original in logical.design.dpi_imports):
    when original.name.starts_with("rheg_")
    | error(~who: #'instrument_events, "reserved event DPI import: " ++ original.name)
    imports[original] := builder.dpi_import_results(original.name, original.input_names, original.input_types, original.results, original.location)
  def node_dpi = builder.dpi_import("rheg_node", ["site", "sequence", "cycle", "width"], [Bits(32), Bits(64), Bits(64), Bits(32)])
  def end_dpi = if manifest.sites.find(fun (site): site.kind == "residency") | builder.dpi_import("rheg_end", ["site", "sequence", "cycle"], [Bits(32), Bits(64), Bits(64)]) | #false
  def word_dpi = builder.dpi_import("rheg_payload", ["site", "sequence", "index", "word"], [Bits(32), Bits(64), Bits(32), Bits(32)])
  def edge_dpi = builder.dpi_import("rheg_edge", ["child", "child_sequence", "parent", "parent_sequence"], [Bits(32), Bits(64), Bits(32), Bits(64)])
  def reset_dpi = builder.dpi_import("rheg_reset", ["active"], [Bits(1)])
  def instance_dpi = if manifest.instances.length() > 0 | builder.dpi_import("rheg_instance", ["scope", "value", "cycle"], [Bits(32), Bits(64), Bits(64)]) | #false
  def unknown_dpi = if manifest.gaps.length() > 0 | builder.dpi_import("rheg_unknown", ["site", "sequence"], [Bits(32), Bits(64)]) | #false

  /* Selects visible event sites in an occurrence subtree. */
  fun subtree_sites(occurrence :: Occurrence):
    manifest.sites.filter(~keep: fun (site): within(site, occurrence.path))
  /* Selects outside event references needed by consumers within this subtree. */
  fun imported_sites(occurrence :: Occurrence):
    manifest.sites.filter(
      ~keep: fun (site): !within(site, occurrence.path) && manifest.dependencies.find(fun (edge): edge.parent == site.id && within(manifest.site(edge.child), occurrence.path)) != #false
    )
  /* Builds an instrumentation name from a prefix and the manifest site index. */
  fun ref_name(prefix :: String, site :: EventSite): prefix ++ to_string(site_ids[site.id])

  // Shadow state lives at consumers. Storage control owners and their ancestors
  // also need passive observation ports; unrelated definitions remain shared.
  def modified = MutableSet{}
  for (occurrence in occurrences):
    when subtree_sites(occurrence).length() > 0 || subtree_controls(occurrence).length() > 0 | modified.add(occurrence.ordinal)
  // Ownership forbids cross-design module references. Import each untouched
  // definition once, recursively preserving its original sharing instead.
  def unchanged = MutableMap.by(===){}
  /* Copies an untouched definition once, retaining its metadata and shared child copies. */
  fun import_unchanged(original :: Module):
    unless unchanged.has_key(original)
    | def children = MutableMap{}
      for (op in original.operations):
        when op.opcode == "rtl.instance"
        | children[op.id] := import_unchanged(op.attribute("module"))
      def copied = copy_module(builder, original, original.name, children, imports)
      builder.finish(copied.module_def)
      unchanged[original] := copied
    unchanged[original]
  /* Finds a generated name that collides with neither source nor copied modules. */
  fun specialization_name(base :: String, suffix :: Nat = 0):
    def candidate = if suffix == 0 | base | base ++ "_" ++ to_string(suffix)
    if logical.design.find_module_named(candidate) || design.find_module_named(candidate)
    | specialization_name(base, suffix + 1)
    | candidate
  /* Returns the specialized occurrence copy or the shared untouched definition copy. */
  fun rebuild(occurrence :: Occurrence):
    if occurrence.ordinal in modified
    | specialize(occurrence)
    | import_unchanged(occurrence.original)
  /* Copies one marked occurrence, preserving metadata, then wires its passive tracing state. */
  fun specialize(occurrence :: Occurrence):
    def children = MutableMap{}
    for (child in occurrence.children): children[child.instance.id] := rebuild(child)
    def module_name = if occurrence === root | logical.top.name | specialization_name(logical.top.name ++ "__event_occ_" ++ to_string(occurrence.ordinal))
    def copied = copy_module(builder, occurrence.original, module_name, children, imports)
    def module_def = copied.module_def
    /* Reuse a unique input proven to carry the trace domain, preserving local clock certification.
       Ancestors without such an input still forward a hidden control from the parent. */
    fun trace_control(expected :: Value, hidden_name :: String):
      if occurrence === root
      | copied.values[expected.id]
      | def candidates = occurrence.original.inputs.filter(
          ~keep: fun (port): type_equal(port.type, expected.type) && control_root(port.value, occurrence, hidden_name, ~probe: #true) === expected
        )
        if candidates.length() == 1
        | copied.values[candidates[0].value.id]
        | builder.input(module_def, hidden_name, expected.type)
    def clock = trace_control(top_clock.value, "__event_clock")
    def reset = trace_control(top_reset.value, "__event_reset")
    def zero = builder.constant(module_def, Bits(64), 0)
    def one = builder.constant(module_def, Bits(64), 1)
    def yes = builder.constant(module_def, Bits(1), 1)
    def active = builder.bit_not(module_def, builder.cast(module_def, reset, Bits(1)))
    def local_sites = manifest.sites.filter(~keep: fun (site): site.instance_path == occurrence.path)
    /* Builds a resettable cycle count and asserts that it never wraps. */
    fun cycle_counter():
      def cycle = builder.register(module_def, "__event_cycle", Bits(64), clock, reset, zero)
      builder.drive(cycle.next, builder.add(module_def, cycle.current, one))
      def cycle_available = builder.bit_not(module_def, builder.eq(module_def, cycle.current, builder.constant(module_def, Bits(64), 2 ** 64 - 1)))
      builder.assert(module_def, cycle_available, clock, reset, yes, "__event_cycle_no_wrap")
      cycle.current
    def local_instances = manifest.instances.filter(~keep: fun (scope): scope.path == occurrence.path)
    def cycle = if local_sites.length() > 0 || local_instances.length() > 0 | cycle_counter() | #false
    when occurrence === root
    | builder.dpi_call(module_def, reset_dpi, [builder.cast(module_def, reset, Bits(1))], clock, builder.cast(module_def, reset, Bits(1)))
    def references = MutableMap{}
    def observed = MutableMap{}
    for (control in controls.filter(~keep: fun (control): control.path == occurrence.path)):
      observed[control.index] := builder.cast(module_def, copied.values[control.value.id], control_type(control))
    for (control in imported_controls(occurrence)):
      observed[control.index] := builder.input(module_def, control_name(control), control_type(control))
    for (site in imported_sites(occurrence)):
      references[site.id] := builder.input(module_def, ref_name("__event_in_", site), reference_type)
    for (child in occurrence.children):
      when child.ordinal in modified
      | def instance = copied.instances[child.instance.id]
        when instance.module_def.find_input("__event_clock")
        | builder.drive(instance.input("__event_clock"), clock)
        when instance.module_def.find_input("__event_reset")
        | builder.drive(instance.input("__event_reset"), reset)
        for (site in subtree_sites(child)):
          references[site.id] := instance.output(ref_name("__event_out_", site))
        for (control in subtree_controls(child)):
          observed[control.index] := instance.output(control_name(control))
    def sequences = MutableMap{}
    def fires = MutableMap{}
    def annotations = MutableMap{}
    // One retained declaration represents one FSM owner. Reusing its shadow
    // register across route-specific plans preserves one parent identity.
    def retained_states = MutableMap{}
    for (site in local_sites):
      def flow_block = view.module(occurrence.original.name).blocks.find(
        fun (candidate): candidate.event_annotation && candidate.event_annotation.site_index == site.local_site
      )!!
      def annotation = flow_block.event_annotation!!
      unless annotation.valid
      | error(~who: #'instrument_events, "event requires explicit transfer controls: " ++ site.id)
      when site.kind == "stall" && !annotation.ready
      | error(~who: #'instrument_events, "stall event requires explicit ready control: " ++ site.id)
      annotations[site.id] := annotation
      def valid = builder.cast(module_def, copied.values[annotation.valid.id], Bits(1))
      def transfer:
        if annotation.ready
        | def ready = builder.cast(module_def, copied.values[annotation.ready.id], Bits(1))
          builder.bit_and(module_def, valid, if site.kind == "stall" | builder.bit_not(module_def, ready) | ready)
        | valid
      def allocated:
        if site.residency_index != #false
        | builder.bit_and(module_def, transfer, builder.cast(module_def, copied.values[annotation.residency_storage(site.residency_index).capture.id], Bits(1)))
        | transfer
      when site.residency_index == 0
      | def captures = annotation.residency_bank().entries.map(fun (entry): builder.cast(module_def, copied.values[entry.capture.id], Bits(1)))
        def mutable any = builder.constant(module_def, Bits(1), 0)
        for (capture in captures, index in 0..captures.length()):
          builder.assert(module_def, builder.bit_not(module_def, builder.bit_and(module_def, any, capture)), clock, reset, yes, ref_name("__event_residency_exclusive_", site) ++ "_" ++ to_string(index))
          any := builder.bit_or(module_def, any, capture)
        builder.assert(module_def, builder.eq(module_def, transfer, any), clock, reset, yes, ref_name("__event_residency_allocation_", site))
      def fire = builder.bit_and(module_def, active, allocated)
      fires[site.id] := fire
      def sequence = builder.register(module_def, ref_name("__event_sequence_", site), Bits(64), clock, reset, zero)
      sequences[site.id] := sequence.current
      builder.drive(sequence.next, builder.mux_lookup(module_def, fire, sequence.current, [[1, builder.add(module_def, sequence.current, one)]]))
      def available = builder.bit_not(module_def, builder.eq(module_def, sequence.current, builder.constant(module_def, Bits(64), 2 ** 64 - 1)))
      builder.assert(module_def, available, clock, reset, fire, ref_name("__event_no_wrap_", site))
      references[site.id] := builder.record_create(module_def, reference_type, [
        ["valid", fire], ["site", builder.constant(module_def, Bits(32), site_ids[site.id])], ["sequence", sequence.current]
      ])
    // One passive subtree activity signal enables a once-per-epoch identity
    // registration of the current module's identity.
    when instance_dpi
    | def mutable activity = builder.constant(module_def, Bits(1), 0)
      for (site in local_sites): activity := builder.bit_or(module_def, activity, fires[site.id])
      for (child in occurrence.children):
        when child.ordinal in modified
        | activity := builder.bit_or(module_def, activity, copied.instances[child.instance.id].output("__event_activity"))
      // Only a parent consumes exported activity. The root keeps its functional
      // boundary while still using local activity for identity registration.
      unless occurrence === root
      | builder.drive(builder.output(module_def, "__event_activity", Bits(1)), activity)
      for (scope in local_instances):
        def index = (for List (i in 0..manifest.instances.length()): i).find(fun (i): manifest.instances[i] === scope)
        def name = "__event_instance_" ++ to_string(index)
        def seen = builder.register(module_def, name ++ "_seen", Bits(1), clock, reset, builder.constant(module_def, Bits(1), 0))
        def identity = copied.values[scope.value.id]
        def value = if identity.type.packed_width() == 64 | identity | builder.zext(module_def, identity, 64)
        def saved = builder.register(module_def, name ++ "_value", Bits(64), clock, reset, zero)
        def bind = builder.bit_and(module_def, activity, builder.bit_not(module_def, seen.current))
        builder.drive(seen.next, builder.bit_or(module_def, seen.current, activity))
        builder.drive(saved.next, builder.mux_lookup(module_def, bind, saved.current, [[1, value]]))
        builder.assert(module_def, builder.eq(module_def, saved.current, value), clock, reset, seen.current, name ++ "_stable")
        builder.dpi_call(module_def, instance_dpi, [builder.constant(module_def, Bits(32), index), value, cycle], clock, builder.bit_and(module_def, active, bind))

    // Every reference exists before any consumer is wired. This supports
    // same-cycle parent/child events across siblings and hierarchy boundaries.
    for (child in occurrence.children):
      for (site in imported_sites(child)):
        builder.drive(copied.instances[child.instance.id].input(ref_name("__event_in_", site)), references[site.id])
      for (control in imported_controls(child)):
        builder.drive(copied.instances[child.instance.id].input(control_name(control)), observed[control.index])
    def incoming_references = MutableMap{}
    // Plans are occurrence-keyed and shared across local consuming checkpoints.
    def built_plans = MutableMap.by(===){}
    def built_broadcasts = MutableMap{}
    for (site in local_sites):
      def annotation = annotations[site.id]
      def id = builder.constant(module_def, Bits(32), site_ids[site.id])
      def sequence = sequences[site.id]
      def fire = fires[site.id]
      def width = annotation.payload?.type?.packed_width() || 0
      unless width is_a Nat
      | error(~who: #'instrument_events, "event payload requires a canonical packed width: " ++ site.id)
      builder.dpi_call(module_def, node_dpi, [id, sequence, cycle, builder.constant(module_def, Bits(32), width)], clock, fire)
      when site.kind == "residency"
      | def storage = annotation.residency_storage(site.residency_index)
        /* Reads a copied local Boolean control as one-bit data. */
        fun control(value :: Value): builder.cast(module_def, copied.values[value.id], Bits(1))
        def capture = control(storage.capture)
        def release = control(storage.release)
        def occupied = control(storage.active)
        def resident = builder.register(module_def, ref_name("__event_resident_", site), Bits(64), clock, reset, zero)
        def live = builder.register(module_def, ref_name("__event_residency_live_", site), Bits(1), clock, reset, builder.constant(module_def, Bits(1), 0))
        builder.drive(live.next, builder.bit_or(module_def, capture, builder.bit_and(module_def, live.current, builder.bit_not(module_def, release))))
        builder.assert(module_def, builder.eq(module_def, live.current, occupied), clock, reset, yes, ref_name("__event_residency_active_", site))
        builder.drive(resident.next, builder.mux_lookup(module_def, fire, resident.current, [[1, sequence]]))
        builder.assert(module_def, builder.eq(module_def, fire, builder.bit_and(module_def, active, capture)), clock, reset, yes, ref_name("__event_residency_capture_", site))
        builder.assert(module_def, builder.bit_or(module_def, builder.bit_not(module_def, occupied), release), clock, reset, fire, ref_name("__event_residency_no_overwrite_", site))
        builder.assert(module_def, occupied, clock, reset, release, ref_name("__event_residency_release_", site))
        builder.dpi_call(module_def, end_dpi, [id, resident.current, cycle], clock, builder.bit_and(module_def, active, release))
      when annotation.payload
      | def packed = builder.cast(module_def, copied.values[annotation.payload.id], Bits(width))
        for (index in 0..((width + 31) div 32)):
          def low = index * 32
          def high = if width - 1 < low + 31 | width - 1 | low + 31
          def word = builder.extract(module_def, packed, high, low)
          def padded = if high - low + 1 == 32 | word | builder.zext(module_def, word, 32)
          builder.dpi_call(module_def, word_dpi, [id, sequence, builder.constant(module_def, Bits(32), index), padded], clock, fire)
      when parent_plans.has_key(site.id)
      | def empty_reference = builder.record_create(module_def, reference_type, [
            ["valid", builder.constant(module_def, Bits(1), 0)],
            ["site", builder.constant(module_def, Bits(32), 0)], ["sequence", zero]
          ])
        // Transaction completeness is distinct from padded parent-slot validity.
        // Selection can choose differently sized lineages; joins require every
        // contributing input, but unused selection padding must emit no edge.
        /* Packs transaction validity, parent references, and optional unknown-ancestry state. */
        fun lineage(valid :: Value, parents :: NonemptyList.of(Value), unknown :: Value = builder.constant(module_def, Bits(1), 0)):
          def vector = builder.vector_create(module_def, VectorType(parents.length(), reference_type), parents)
          def type = RecordType([RecordField("valid", Bits(1)), RecordField("parents", vector.type), RecordField("unknown", Bits(1))])
          builder.record_create(module_def, type, [["valid", valid], ["parents", vector], ["unknown", unknown]])
        /* Extracts the packed parent-reference slots from a lineage value. */
        fun parent_slots(reference :: Value):
          def vector = builder.record_get(module_def, reference, "parents")
          for List (index in 0..vector.type.length): builder.vector_get(module_def, vector, index)
        /* Builds an invalid lineage value with the requested parent capacity. */
        fun empty_lineage(count :: PosInt):
          lineage(builder.constant(module_def, Bits(1), 0), for List (_ in 0..count): empty_reference)
        /* Pads unused parent slots while preserving validity and unknown ancestry. */
        fun pad_lineage(reference :: Value, count :: PosInt):
          def parents = parent_slots(reference)
          if parents.length() == count
          | reference
          | lineage(builder.record_get(module_def, reference, "valid"), parents ++ (for List (_ in parents.length()..count): empty_reference), builder.record_get(module_def, reference, "unknown"))
        def mutable next_stage = 0
        /* Allocates a local unique name for shadow storage or lineage logic. */
        fun stage_name():
          def name = ref_name("__event_parent_", site) ++ "_" ++ to_string(next_stage)
          next_stage := next_stage + 1
          name
        /* Lowers one certified storage stage using observed functional controls. */
        fun emit_stage(stage :: EventTraceStage || EventTraceQueue || EventTraceRetained || EventTraceWindow, reference :: Value):
            def name = stage_name()
            def empty = empty_lineage(reference.type.field("parents").type.length)
            /* Reads a routed observation value for the current storage or broadcast owner. */
            fun observe(value :: Value): observed[control_ids[[stage.instance_path, value.id]]]
            cond
            | stage is_a EventTraceWindow:
                def count = observe(stage.count)
                def release = observe(stage.release_count)
                def flush = observe(stage.flush)
                def enabled = builder.bit_not(module_def, flush)
                def enqueue = builder.bit_and(module_def, enabled, observe(stage.enqueue))
                def remaining = builder.sub(module_def, count, release)
                def appended = if stage.append_count | observe(stage.append_count) | builder.constant(module_def, count.type, 1)
                def depth = builder.constant(module_def, count.type, stage.depth)
                builder.assert(module_def, builder.bit_not(module_def, builder.ult(module_def, depth, count)), clock, reset, yes, name ++ "_count")
                builder.assert(module_def, builder.bit_not(module_def, builder.ult(module_def, count, release)), clock, reset, enabled, name ++ "_release")
                builder.assert(module_def, builder.ult(module_def, builder.constant(module_def, count.type, 0), appended), clock, reset, enqueue, name ++ "_append_nonzero")
                builder.assert(module_def, builder.bit_not(module_def, builder.ult(module_def, depth, appended)), clock, reset, enqueue, name ++ "_append_bound")
                builder.assert(module_def, builder.bit_not(module_def, builder.ult(module_def, builder.sub(module_def, depth, remaining), appended)), clock, reset, enqueue, name ++ "_space")
                builder.assert(module_def, builder.record_get(module_def, reference, "valid"), clock, reset, enqueue, name ++ "_capture_present")
                def slots = for List (index in 0..stage.depth):
                  builder.register(module_def, name ++ "_slot_" ++ to_string(index), reference.type, clock, reset, empty)
                for (slot in slots, index in 0..stage.depth):
                  def shifted = builder.mux_lookup(module_def, release, empty, for List (offset in 0..(stage.depth - index)): [offset, slots[index + offset].current])
                  def position = builder.constant(module_def, count.type, index)
                  def append = builder.bit_and(module_def, enqueue, builder.bit_and(module_def, builder.bit_not(module_def, builder.ult(module_def, position, remaining)), builder.ult(module_def, builder.sub(module_def, position, remaining), appended)))
                  def next = builder.mux_lookup(module_def, append, shifted, [[1, reference]])
                  builder.drive(slot.next, builder.mux_lookup(module_def, flush, next, [[1, empty]]))
                def mutable complete = enabled
                def mutable any_selected = builder.constant(module_def, Bits(1), 0)
                def mutable unknown = builder.constant(module_def, Bits(1), 0)
                def mutable parents = []
                for (selection in stage.selected, index in 0..stage.selected.length()):
                  def selected = observe(selection)
                  def occupied = builder.ult(module_def, builder.constant(module_def, count.type, index), count)
                  def resident = slots[index].current
                  def valid = builder.bit_and(module_def, occupied, builder.record_get(module_def, resident, "valid"))
                  complete := builder.bit_and(module_def, complete, builder.bit_or(module_def, builder.bit_not(module_def, selected), valid))
                  any_selected := builder.bit_or(module_def, any_selected, selected)
                  unknown := builder.bit_or(module_def, unknown, builder.bit_and(module_def, selected, builder.record_get(module_def, resident, "unknown")))
                  parents := parents ++ parent_slots(builder.mux_lookup(module_def, selected, empty, [[1, resident]]))
                when stage.live
                | def selected = observe(stage.live)
                  def valid = builder.record_get(module_def, reference, "valid")
                  complete := builder.bit_and(module_def, complete, builder.bit_or(module_def, builder.bit_not(module_def, selected), valid))
                  any_selected := builder.bit_or(module_def, any_selected, selected)
                  unknown := builder.bit_or(module_def, unknown, builder.bit_and(module_def, selected, builder.record_get(module_def, reference, "unknown")))
                  parents := parents ++ parent_slots(builder.mux_lookup(module_def, selected, empty, [[1, reference]]))
                lineage(builder.bit_and(module_def, complete, any_selected), parents, unknown)
            | stage is_a EventTraceRetained:
                def key = [stage.instance_path, stage.capture.id, stage.release.id, stage.active.id, reference.id]
                def existing = retained_states.get(key, #false)
                if existing
                | unless type_equal(existing[1], reference.type)
                  | error(~who: #'instrument_events, "retained trace scope is used with incompatible lineage capacities")
                  existing[0]
                | block:
                    def resident = builder.register(module_def, name, reference.type, clock, reset, empty)
                    def capture = observe(stage.capture)
                    def release = observe(stage.release)
                    def occupied = observe(stage.active)
                    def released = builder.mux_lookup(module_def, release, resident.current, [[1, empty]])
                    builder.drive(resident.next, builder.mux_lookup(module_def, capture, released, [[1, reference]]))
                    builder.assert(module_def, builder.record_get(module_def, reference, "valid"), clock, reset, capture, name ++ "_capture_present")
                    builder.assert(module_def, builder.bit_or(module_def, builder.bit_not(module_def, occupied), release), clock, reset, capture, name ++ "_no_overwrite")
                    builder.assert(module_def, occupied, clock, reset, release, name ++ "_release_active")
                    def result = builder.mux_lookup(module_def, occupied, empty, [[1, resident.current]])
                    retained_states[key] := [result, reference.type]
                    result
            | stage is_a EventTraceQueue:
                def storage = builder.memory(module_def, name, stage.depth, reference.type)
                def stored = builder.memory_read_async(module_def, storage, observe(stage.read_address))
                def enqueue = builder.bit_and(module_def, active, observe(stage.enqueue))
                builder.memory_write(module_def, storage, observe(stage.write_address), reference, clock, enqueue)
                // Functional occupancy hides stale memory after reset or dequeue;
                // no shadow pointers, occupancy counter, or payload are needed.
                def resident = builder.mux_lookup(module_def, observe(stage.stored_valid), empty, [[1, stored]])
                builder.assert(module_def, builder.record_get(module_def, resident, "valid"), clock, reset, observe(stage.dequeue), name ++ "_dequeue_present")
                // Remove disabled bypass structurally, just as Queue does;
                // even a constant-false mux arm is a dependency in core IR.
                if event_trace_registered(stage)
                | resident
                | builder.mux_lookup(module_def, observe(stage.bypass), resident, [[1, reference]])
            | ~else:
                def delayed = builder.register(module_def, name, reference.type, clock, reset, empty)
                if stage.advance
                | def incoming = builder.mux_lookup(module_def, observe(stage.valid), empty, [[1, reference]])
                  builder.drive(delayed.next, builder.mux_lookup(module_def, observe(stage.advance), delayed.current, [[1, incoming]]))
                | builder.drive(delayed.next, if stage.flush | builder.mux_lookup(module_def, observe(stage.flush), reference, [[1, empty]]) | reference)
                delayed.current
        /* Lowers a lineage graph while reusing already allocated state and shared subplans. */
        fun emit_plan(plan :: EventTracePlan):
          unless built_plans.has_key(plan)
          | def result:
              cond
              | plan is_a EventTraceLink: emit_plan(plan.target)
              | plan is_a EventTraceSource:
                  cond
                  | plan.absent: lineage(yes, [empty_reference])
                  | plan.unknown: lineage(yes, [empty_reference], yes)
                  | ~else:
                      def reference = references[plan.site]
                      lineage(builder.record_get(module_def, reference, "valid"), [reference])
              | plan is_a EventTraceRequire:
                  def incoming = emit_plan(plan.input)
                  def unknown = builder.record_get(module_def, incoming, "unknown")
                  def mutable present = unknown
                  def parents = parent_slots(incoming)
                  for (parent in parents): present := builder.bit_or(module_def, present, builder.record_get(module_def, parent, "valid"))
                  lineage(builder.bit_and(module_def, builder.record_get(module_def, incoming, "valid"), present), parents, unknown)
              | plan is_a EventTraceJoin:
                  def mutable valid = yes
                  def mutable unknown = builder.constant(module_def, Bits(1), 0)
                  def mutable parents = []
                  for (input in plan.inputs):
                    def incoming = emit_plan(input)
                    valid := builder.bit_and(module_def, valid, builder.record_get(module_def, incoming, "valid"))
                    unknown := builder.bit_or(module_def, unknown, builder.record_get(module_def, incoming, "unknown"))
                    parents := parents ++ parent_slots(incoming)
                  lineage(valid, parents, unknown)
              | plan is_a EventTraceReplication: emit_plan(plan.input)
              | plan is_a EventTraceBroadcast:
                  /* Reads a routed observation value for the current storage or broadcast owner. */
                  fun observe(value :: Value): observed[control_ids[[plan.instance_path, value.id]]]
                  unless built_broadcasts.has_key(plan.broadcast_id)
                  | def name = stage_name()
                    def incoming = emit_plan(plan.input)
                    def resident = builder.register(module_def, name, incoming.type, clock, reset, empty_lineage(event_trace_capacity(plan)))
                    builder.drive(resident.next, builder.mux_lookup(module_def, observe(plan.accept), resident.current, [[1, incoming]]))
                    builder.assert(module_def, builder.record_get(module_def, incoming, "valid"), clock, reset, observe(plan.accept), name ++ "_accept_present")
                    built_broadcasts[plan.broadcast_id] := resident.current
                  // No bypass: last-recipient delivery uses the old reference
                  // even when this same edge captures the replacement input.
                  builder.mux_lookup(module_def, observe(plan.pending), empty_lineage(event_trace_capacity(plan)), [[1, built_broadcasts[plan.broadcast_id]]])
              | plan is_a EventTracePipeline:
                  def mutable reference = emit_plan(plan.input)
                  for (stage in plan.stages): reference := emit_stage(stage, reference)
                  reference
              | plan is_a EventTraceRouting:
                  def name = stage_name()
                  def mutable seen = builder.constant(module_def, Bits(1), 0)
                  for (predicate in plan.predicates, index in 0..plan.predicates.length()):
                    def selected = observed[control_ids[[plan.instance_path, predicate.id]]]
                    def overlap = builder.bit_and(module_def, seen, selected)
                    builder.assert(module_def, builder.bit_not(module_def, overlap), clock, reset, yes, name ++ "_onehot_" ++ to_string(index))
                    seen := builder.bit_or(module_def, seen, selected)
                  def selected = observed[control_ids[[plan.instance_path, plan.predicates[plan.output_index].id]]]
                  builder.mux_lookup(module_def, selected, empty_lineage(event_trace_capacity(plan)), [[1, emit_plan(plan.input)]])
              | ~else:
                  def name = stage_name()
                  def count = event_trace_capacity(plan)
                  def mutable reference = empty_lineage(count)
                  def mutable seen = builder.constant(module_def, Bits(1), 0)
                  for (input in plan.inputs, grant in plan.grants, index in 0..plan.grants.length()):
                    def selected = observed[control_ids[[plan.instance_path, grant.id]]]
                    def overlap = builder.bit_and(module_def, seen, selected)
                    builder.assert(module_def, builder.bit_not(module_def, overlap), clock, reset, yes, name ++ "_onehot_" ++ to_string(index))
                    seen := builder.bit_or(module_def, seen, selected)
                    reference := builder.mux_lookup(module_def, selected, reference, [[1, pad_lineage(emit_plan(input), count)]])
                  reference
            built_plans[plan] := result
          built_plans[plan]
        // Storage reads exist before any feedback input is lowered. Wires are
        // passive next-state connections, not new functional flow controllers.
        def mutable pending_inputs = []
        when site.kind != "stall" && feedback(parent_plans[site.id])
        | for (plan in event_trace_nodes(parent_plans[site.id])):
            unless built_plans.has_key(plan)
            | cond
              | plan is_a EventTracePipeline:
                  def input = builder.wire(module_def, stage_name() ++ "_input", empty_lineage(event_trace_capacity(plan.input)).type)
                  def mutable result = builder.read(input)
                  for (stage in plan.stages): result := emit_stage(stage, result)
                  built_plans[plan] := result
                  pending_inputs := pending_inputs ++ [[input, plan.input]]
              | plan is_a EventTraceBroadcast:
                  def count = event_trace_capacity(plan)
                  unless built_broadcasts.has_key(plan.broadcast_id)
                  | def name = stage_name()
                    def input = builder.wire(module_def, name ++ "_input", empty_lineage(count).type)
                    def incoming = builder.read(input)
                    def resident = builder.register(module_def, name, incoming.type, clock, reset, empty_lineage(count))
                    def accept = observed[control_ids[[plan.instance_path, plan.accept.id]]]
                    builder.drive(resident.next, builder.mux_lookup(module_def, accept, resident.current, [[1, incoming]]))
                    builder.assert(module_def, builder.record_get(module_def, incoming, "valid"), clock, reset, accept, name ++ "_accept_present")
                    built_broadcasts[plan.broadcast_id] := resident.current
                    pending_inputs := pending_inputs ++ [[input, plan.input]]
                  def pending = observed[control_ids[[plan.instance_path, plan.pending.id]]]
                  built_plans[plan] := builder.mux_lookup(module_def, pending, empty_lineage(count), [[1, built_broadcasts[plan.broadcast_id]]])
              | ~else: #void
        // A companion shares its checkpoint's shadow state; it only observes
        // resident ancestry and cannot create a new carried transaction identity.
        def shared_observation = site.kind == "stall" && parent_plans[site.id] === manifest.trace_plans[site.observation_of]
        def reference = if shared_observation | incoming_references[site.observation_of] | emit_plan(parent_plans[site.id])
        for (input in pending_inputs): builder.drive(input[0], emit_plan(input[1]))
        incoming_references[site.id] := reference
        def parent_valid = builder.record_get(module_def, reference, "valid")
        when unknown_dpi
        | def unknown = builder.bit_and(module_def, parent_valid, builder.record_get(module_def, reference, "unknown"))
          builder.dpi_call(module_def, unknown_dpi, [id, sequence], clock, builder.bit_and(module_def, fire, unknown))
        unless site.kind == "stall"
        | builder.assert(module_def, parent_valid, clock, reset, fire, ref_name("__event_parent_present_", site))
        for (parent in parent_slots(reference)):
          def emit = builder.bit_and(module_def, builder.bit_and(module_def, fire, parent_valid), builder.record_get(module_def, parent, "valid"))
          builder.dpi_call(module_def, edge_dpi, [id, sequence, builder.record_get(module_def, parent, "site"), builder.record_get(module_def, parent, "sequence")], clock, emit)
    unless occurrence === root
    | for (site in subtree_sites(occurrence)):
        builder.drive(builder.output(module_def, ref_name("__event_out_", site), reference_type), references[site.id])
      for (control in subtree_controls(occurrence)):
        builder.drive(builder.output(module_def, control_name(control), control_type(control)), observed[control.index])
    builder.finish(module_def)
    copied
  def top = rebuild(root).module_def
  def instrumented = DesignElaboration(design, top)
  verify_design(design)
  check_materialized_design(design)
  EventInstrumentedElaboration(logical, instrumented, manifest)
