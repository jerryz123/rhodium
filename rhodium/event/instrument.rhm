#lang rhombus
// Lowers bounded multi-parent lineage through storage, routing, joins, and DPI emission.

import:
  "../core/ir.rhm" open
  "../core/builder.rhm".Builder
  "../core/verify.rhm".verify_design
  "../diagram/main.rhm" open
  "model.rhm" open
  "analyze.rhm".infer_event_manifest
  "copy.rhm" open

export:
  EventInstrumentationConfig
  EventInstrumentedElaboration
  instrument_events

class EventInstrumentationConfig(clock_port :: String = "clock",
                                 reset_port :: String = "reset")
class EventInstrumentedElaboration(original :: DesignElaboration,
                                   instrumented :: DesignElaboration,
                                   manifest :: EventManifest)
class Occurrence(original :: Module, path :: List.of(String), ordinal :: Nat,
                 parent :: False || Nat, instance :: False || Operation,
                 mutable children :: List = [])
class TraceControl(path :: List.of(String), value :: Value, index :: Nat,
                   mutable consumers :: List = [])

def reference_type = RecordType([RecordField("valid", Bits(1)),
                                 RecordField("site", Bits(32)),
                                 RecordField("sequence", Bits(64))])

fun path_within(descendant :: List.of(String), ancestor :: List.of(String)):
  descendant.length() >= ancestor.length() && descendant.take(ancestor.length()) == ancestor
fun within(site :: EventSite, path :: List.of(String)):
  path_within(site.instance_path, path)

fun instrument_events(logical :: DesignElaboration,
                      config :: EventInstrumentationConfig = EventInstrumentationConfig()):
  def manifest = infer_event_manifest(logical, ~dynamic: #true)
  unless manifest.sites.length() > 0 && manifest.sites.length() < 2 ** 32
  | error(~who: #'instrument_events, "instrumentation requires 1..2^32-1 event occurrences")
  def top_clock = logical.top.inputs.find(fun (port): port.name == config.clock_port)
  def top_reset = logical.top.inputs.find(fun (port): port.name == config.reset_port)
  unless top_clock && clock_type(top_clock.type) && top_reset && reset_type(top_reset.type)
  | error(~who: #'instrument_events, "select a top-level Clock input and synchronous Reset input")
  def site_ids = MutableMap{}
  for (site in manifest.sites, index in 0..manifest.sites.length()): site_ids[site.id] := index
  def parent_plans = MutableMap{}
  fun sources(plan :: EventTracePlan):
    cond
    | plan is_a EventTraceSource: [plan.site]
    | plan is_a EventTracePipeline: sources(plan.input)
    | plan is_a EventTraceRouting: sources(plan.input)
    | plan is_a EventTraceReplication: sources(plan.input)
    | plan is_a EventTraceBroadcast: sources(plan.input)
    | ~else:
        def mutable found = []
        for (input in plan.inputs): found := found ++ sources(input)
        found
  fun plan_controls(plan :: EventTracePlan):
    cond
    | plan is_a EventTraceSource: []
    | plan is_a EventTracePipeline: plan_controls(plan.input) ++ plan.stages
    | plan is_a EventTraceRouting: plan_controls(plan.input) ++ [plan]
    | plan is_a EventTraceReplication: plan_controls(plan.input)
    | plan is_a EventTraceBroadcast: plan_controls(plan.input) ++ [plan]
    | plan is_a EventTraceJoin:
        def mutable found = []
        for (input in plan.inputs): found := found ++ plan_controls(input)
        found
    | ~else:
        def mutable found = [plan]
        for (input in plan.inputs): found := found ++ plan_controls(input)
        found
  // Alternatives record certified divergence from one source occurrence.
  // Different children must use distinct outputs of a shared exclusive router
  // or certified replicator. A common output or unrelated transforms do not suffice.
  fun alternatives(plan :: EventTracePlan, source :: String, choices :: List = []):
    cond
    | plan is_a EventTraceSource: (if plan.site == source | [choices] | [])
    | plan is_a EventTracePipeline: alternatives(plan.input, source, choices)
    | plan is_a EventTraceRouting: alternatives(plan.input, source, choices ++ [[plan.routing_id, plan.output_index]])
    | plan is_a EventTraceReplication: alternatives(plan.input, source, choices ++ [[plan.replication_id, plan.output_index]])
    | plan is_a EventTraceBroadcast: alternatives(plan.input, source, choices ++ [[plan.broadcast_id, plan.output_index]])
    | ~else:
        def mutable found = []
        for (input in plan.inputs): found := found ++ alternatives(input, source, choices)
        found
  for (site in manifest.sites):
    def edges = manifest.dependencies.filter(~keep: fun (edge): edge.child == site.id)
    for (edge in edges):
      def parent = manifest.site(edge.parent)
      when parent.terminal
      | error(~who: #'instrument_events, "terminal event has a downstream annotation: " ++ parent.id)
    when edges.length() > 0
    | def plan = manifest.trace_plans[site.id]
      when #false in sources(plan)
      | error(~who: #'instrument_events, "selection or join requires an annotated ancestor on every input path: " ++ site.id)
      parent_plans[site.id] := plan
    def children = MutableSet{}
    for (edge in manifest.dependencies):
      when edge.parent == site.id | children.add(edge.child)
    when children.length() > 1
    | for (left in children):
        for (right in children):
          when left != right
          | for (left_path in alternatives(manifest.trace_plans[left], site.id)):
              for (right_path in alternatives(manifest.trace_plans[right], site.id)):
                unless left_path.find(fun (choice): right_path.find(fun (other): choice[0] == other[0] && choice[1] != other[1]))
                | error(~who: #'instrument_events, "tracing does not support uncertified fanout at " ++ site.id)

  def mutable occurrences = []
  fun expand(original :: Module, path :: List.of(String), parent :: False || Occurrence, instance :: False || Operation):
    def occurrence = Occurrence(original, path, occurrences.length(), if parent | parent.ordinal | #false, instance)
    occurrences := occurrences ++ [occurrence]
    for (op in original.operations):
      when op.opcode == "rtl.instance"
      | occurrence.children := occurrence.children ++ [expand(op.attribute("module"), path ++ [op.attribute("name")], occurrence, op)]
    occurrence
  def root = expand(logical.top, [logical.top.name], #false, #false)

  // Deduplicate observed controls by original signal and concrete occurrence.
  // These ports only observe functional state; no trace value drives it.
  def mutable controls = []
  def control_ids = MutableMap{}
  for (site in manifest.sites):
    for (stage in (if parent_plans.has_key(site.id) | plan_controls(parent_plans[site.id]) | [])):
      when stage.controls().length() > 0
      | def owner = occurrences.find(fun (occurrence): occurrence.path == stage.instance_path)
        for (value in stage.controls()):
          unless owner && value.module_def === owner.original
          | error(~who: #'instrument_events, "trace controls do not belong to their occurrence")
          def key = [stage.instance_path, value.id]
          unless control_ids.has_key(key)
          | control_ids[key] := controls.length()
            controls := controls ++ [TraceControl(stage.instance_path, value, controls.length())]
          def control = controls[control_ids[key]]
          control.consumers := control.consumers ++ [site.instance_path]
  fun subtree_controls(occurrence :: Occurrence):
    controls.filter(~keep: fun (control): path_within(control.path, occurrence.path))
  fun imported_controls(occurrence :: Occurrence):
    controls.filter(~keep: fun (control): !path_within(control.path, occurrence.path) && control.consumers.find(fun (path): path_within(path, occurrence.path)) != #false)
  fun control_name(control :: TraceControl): "__event_control_" ++ to_string(control.index)
  fun control_type(control :: TraceControl): Bits(data_width(control.value.type))

  // Trace clocks are supplied from the selected root, never guessed from a
  // port name in a descendant. Check functional domains before introducing them.
  fun control_root(value :: Value, occurrence :: Occurrence):
    def op = occurrence.original.find_operation(value.defining_op_id)
    cond
    | op.opcode == "rtl.input_port":
        if !occurrence.parent
        | value
        | block:
            def mutable binding = #false
            for (port in occurrence.original.inputs, place in occurrence.instance.places):
              when port.value === value | binding := place.driver
            unless binding | error(~who: #'instrument_events, "unbound clock/reset in traced hierarchy")
            control_root(binding, occurrences[occurrence.parent])
    | op.opcode == "rtl.wire": control_root(op.places[0].driver, occurrence)
    | op.opcode == "rtl.cast": control_root(op.operands[0], occurrence)
    | ~else: error(~who: #'instrument_events, "generated or opaque clock/reset in " ++ String.join(occurrence.path, "/"))
  for (occurrence in occurrences):
    def traced_domain = manifest.sites.find(fun (site): site.instance_path == occurrence.path) != #false || controls.find(fun (control): control.path == occurrence.path) != #false
    for (value in occurrence.original.values):
      when value.name.starts_with("__event_")
      | error(~who: #'instrument_events, "reserved instrumentation name: " ++ value.name)
      when traced_domain && (clock_type(value.type) || reset_type(value.type))
      | def expected = (if clock_type(value.type) | top_clock.value | top_reset.value)
        unless control_root(value, occurrence) === expected
        | error(~who: #'instrument_events, "tracing requires one clock and reset epoch: " ++ String.join(occurrence.path, "/"))
    for (place in occurrence.original.places):
      when place.name.starts_with("__event_")
      | error(~who: #'instrument_events, "reserved instrumentation name: " ++ place.name)
    for (op in occurrence.original.operations):
      for (operand in op.operands):
        when traced_domain && (clock_type(operand.type) || reset_type(operand.type))
        | def expected = (if clock_type(operand.type) | top_clock.value | top_reset.value)
          unless control_root(operand, occurrence) === expected
          | error(~who: #'instrument_events, "tracing requires one clock and reset epoch: " ++ String.join(occurrence.path, "/"))

  def view = diagram(logical)
  for (occurrence in occurrences):
    def local_view = view.module(occurrence.original.name)
    def annotations = local_view.blocks.filter(~keep: fun (candidate): candidate.event_annotation != #false)
    def visible = manifest.sites.filter(~keep: fun (site): site.instance_path == occurrence.path)
    unless annotations.length() == visible.length()
    | error(~who: #'instrument_events, "event annotations are hidden behind a transform implementation: " ++ String.join(occurrence.path, "/"))
  def design = Design([], logical.design.next_id)
  def builder = Builder(design)
  def imports = MutableMap{}
  for (original in logical.design.dpi_imports):
    when original.name.starts_with("rheg_")
    | error(~who: #'instrument_events, "reserved event DPI import: " ++ original.name)
    imports[original.id] := builder.dpi_import_results(original.name, original.input_names, original.input_types, original.results, original.location)
  def node_dpi = builder.dpi_import("rheg_node", ["site", "sequence", "cycle", "width"], [Bits(32), Bits(64), Bits(64), Bits(32)])
  def word_dpi = builder.dpi_import("rheg_payload", ["site", "sequence", "index", "word"], [Bits(32), Bits(64), Bits(32), Bits(32)])
  def edge_dpi = builder.dpi_import("rheg_edge", ["child", "child_sequence", "parent", "parent_sequence"], [Bits(32), Bits(64), Bits(32), Bits(64)])
  def reset_dpi = builder.dpi_import("rheg_reset", ["active"], [Bits(1)])

  fun subtree_sites(occurrence :: Occurrence):
    manifest.sites.filter(~keep: fun (site): within(site, occurrence.path))
  fun imported_sites(occurrence :: Occurrence):
    manifest.sites.filter(
      ~keep: fun (site): !within(site, occurrence.path) && manifest.dependencies.find(fun (edge): edge.parent == site.id && within(manifest.site(edge.child), occurrence.path)) != #false
    )
  fun ref_name(prefix :: String, site :: EventSite): prefix ++ to_string(site_ids[site.id])

  // Shadow state lives at consumers. Storage control owners and their ancestors
  // also need passive observation ports; unrelated definitions remain shared.
  def modified = MutableSet{}
  for (occurrence in occurrences):
    when subtree_sites(occurrence).length() > 0 || subtree_controls(occurrence).length() > 0 | modified.add(occurrence.ordinal)
  // Ownership forbids cross-design module references. Import each untouched
  // definition once, recursively preserving its original sharing instead.
  def unchanged = MutableMap.by(===){}
  fun import_unchanged(original :: Module):
    unless unchanged.has_key(original)
    | def children = MutableMap{}
      for (op in original.operations):
        when op.opcode == "rtl.instance"
        | children[op.id] := import_unchanged(op.attribute("module"))
      def copied = copy_module(builder, original, original.name, children, imports)
      unchanged[original] := builder.finish(copied.module_def)
    unchanged[original]
  fun specialization_name(base :: String, suffix :: Nat = 0):
    def candidate = if suffix == 0 | base | base ++ "_" ++ to_string(suffix)
    if logical.design.find_module_named(candidate) || design.find_module_named(candidate)
    | specialization_name(base, suffix + 1)
    | candidate
  fun rebuild(occurrence :: Occurrence):
    if occurrence.ordinal in modified
    | specialize(occurrence)
    | import_unchanged(occurrence.original)
  fun specialize(occurrence :: Occurrence):
    def children = MutableMap{}
    for (child in occurrence.children): children[child.instance.id] := rebuild(child)
    def module_name = if occurrence === root | logical.top.name | specialization_name(logical.top.name ++ "__event_occ_" ++ to_string(occurrence.ordinal))
    def copied = copy_module(builder, occurrence.original, module_name, children, imports)
    def module_def = copied.module_def
    def clock = if occurrence === root | copied.values[top_clock.value.id] | builder.input(module_def, "__event_clock", Clock)
    def reset = if occurrence === root | copied.values[top_reset.value.id] | builder.input(module_def, "__event_reset", Reset)
    def zero = builder.constant(module_def, Bits(64), 0)
    def one = builder.constant(module_def, Bits(64), 1)
    def yes = builder.constant(module_def, Bits(1), 1)
    def active = builder.bit_not(module_def, builder.cast(module_def, reset, Bits(1)))
    def local_sites = manifest.sites.filter(~keep: fun (site): site.instance_path == occurrence.path)
    fun cycle_counter():
      def cycle = builder.register(module_def, "__event_cycle", Bits(64), clock, reset, zero)
      builder.drive(cycle.next, builder.add(module_def, cycle.current, one))
      def cycle_available = builder.bit_not(module_def, builder.eq(module_def, cycle.current, builder.constant(module_def, Bits(64), 2 ** 64 - 1)))
      builder.assert(module_def, cycle_available, clock, reset, yes, "__event_cycle_no_wrap")
      cycle.current
    def cycle = if local_sites.length() > 0 | cycle_counter() | #false
    when occurrence === root
    | builder.dpi_call(module_def, reset_dpi, [builder.cast(module_def, reset, Bits(1))], clock, builder.cast(module_def, reset, Bits(1)))
    def references = MutableMap{}
    def observed = MutableMap{}
    for (control in controls.filter(~keep: fun (control): control.path == occurrence.path)):
      observed[control.index] := builder.cast(module_def, copied.values[control.value.id], control_type(control))
    for (control in imported_controls(occurrence)):
      observed[control.index] := builder.input(module_def, control_name(control), control_type(control))
    for (site in imported_sites(occurrence)):
      references[site.id] := builder.input(module_def, ref_name("__event_in_", site), reference_type)
    for (child in occurrence.children):
      when child.ordinal in modified
      | def instance = copied.instances[child.instance.id]
        builder.drive(instance.input("__event_clock"), clock)
        builder.drive(instance.input("__event_reset"), reset)
        for (site in subtree_sites(child)):
          references[site.id] := instance.output(ref_name("__event_out_", site))
        for (control in subtree_controls(child)):
          observed[control.index] := instance.output(control_name(control))
    def sequences = MutableMap{}
    def fires = MutableMap{}
    def annotations = MutableMap{}
    for (site in local_sites):
      def flow_block = view.module(occurrence.original.name).blocks.find(
        fun (candidate): candidate.event_annotation && candidate.event_annotation.site_index == site.local_site
      )
      def annotation = flow_block.event_annotation
      unless annotation.valid
      | error(~who: #'instrument_events, "event requires explicit transfer controls: " ++ site.id)
      annotations[site.id] := annotation
      def valid = builder.cast(module_def, copied.values[annotation.valid.id], Bits(1))
      def transfer = if annotation.ready | builder.bit_and(module_def, valid, builder.cast(module_def, copied.values[annotation.ready.id], Bits(1))) | valid
      def fire = builder.bit_and(module_def, active, transfer)
      fires[site.id] := fire
      def sequence = builder.register(module_def, ref_name("__event_sequence_", site), Bits(64), clock, reset, zero)
      sequences[site.id] := sequence.current
      builder.drive(sequence.next, builder.mux_lookup(module_def, fire, sequence.current, [[1, builder.add(module_def, sequence.current, one)]]))
      def available = builder.bit_not(module_def, builder.eq(module_def, sequence.current, builder.constant(module_def, Bits(64), 2 ** 64 - 1)))
      builder.assert(module_def, available, clock, reset, fire, ref_name("__event_no_wrap_", site))
      references[site.id] := builder.record_create(module_def, reference_type, [
        ["valid", fire], ["site", builder.constant(module_def, Bits(32), site_ids[site.id])], ["sequence", sequence.current]
      ])
    // Every reference exists before any consumer is wired. This supports
    // same-cycle parent/child events across siblings and hierarchy boundaries.
    for (child in occurrence.children):
      for (site in imported_sites(child)):
        builder.drive(copied.instances[child.instance.id].input(ref_name("__event_in_", site)), references[site.id])
      for (control in imported_controls(child)):
        builder.drive(copied.instances[child.instance.id].input(control_name(control)), observed[control.index])
    for (site in local_sites):
      def annotation = annotations[site.id]
      def id = builder.constant(module_def, Bits(32), site_ids[site.id])
      def sequence = sequences[site.id]
      def fire = fires[site.id]
      def width = if annotation.payload | annotation.payload.type.packed_width() | 0
      unless width is_a Nat
      | error(~who: #'instrument_events, "event payload requires a canonical packed width: " ++ site.id)
      builder.dpi_call(module_def, node_dpi, [id, sequence, cycle, builder.constant(module_def, Bits(32), width)], clock, fire)
      when annotation.payload
      | def packed = builder.cast(module_def, copied.values[annotation.payload.id], Bits(width))
        for (index in 0..((width + 31) div 32)):
          def low = index * 32
          def high = if width - 1 < low + 31 | width - 1 | low + 31
          def word = builder.extract(module_def, packed, high, low)
          def padded = if high - low + 1 == 32 | word | builder.zext(module_def, word, 32)
          builder.dpi_call(module_def, word_dpi, [id, sequence, builder.constant(module_def, Bits(32), index), padded], clock, fire)
      when parent_plans.has_key(site.id)
      | def empty_reference = builder.record_create(module_def, reference_type, [
            ["valid", builder.constant(module_def, Bits(1), 0)],
            ["site", builder.constant(module_def, Bits(32), 0)], ["sequence", zero]
          ])
        // Transaction completeness is distinct from padded parent-slot validity.
        // Selection can choose differently sized lineages; joins require every
        // contributing input, but unused selection padding must emit no edge.
        fun lineage(valid :: Value, parents :: NonemptyList.of(Value)):
          def vector = builder.vector_create(module_def, VectorType(parents.length(), reference_type), parents)
          def type = RecordType([RecordField("valid", Bits(1)), RecordField("parents", vector.type)])
          builder.record_create(module_def, type, [["valid", valid], ["parents", vector]])
        fun parent_slots(reference :: Value):
          def vector = builder.record_get(module_def, reference, "parents")
          for List (index in 0..vector.type.length): builder.vector_get(module_def, vector, index)
        fun empty_lineage(count :: PosInt):
          lineage(builder.constant(module_def, Bits(1), 0), for List (_ in 0..count): empty_reference)
        fun pad_lineage(reference :: Value, count :: PosInt):
          def parents = parent_slots(reference)
          if parents.length() == count
          | reference
          | lineage(builder.record_get(module_def, reference, "valid"), parents ++ (for List (_ in parents.length()..count): empty_reference))
        def built_plans = MutableMap.by(===){}
        def built_broadcasts = MutableMap{}
        def mutable next_stage = 0
        fun stage_name():
          def name = ref_name("__event_parent_", site) ++ "_" ++ to_string(next_stage)
          next_stage := next_stage + 1
          name
        fun emit_stage(stage :: EventTraceStage || EventTraceQueue, reference :: Value):
            def name = stage_name()
            def empty = empty_lineage(reference.type.field("parents").type.length)
            fun observe(value :: Value): observed[control_ids[[stage.instance_path, value.id]]]
            if stage is_a EventTraceQueue
            | def storage = builder.memory(module_def, name, stage.depth, reference.type)
              def stored = builder.memory_read_async(module_def, storage, observe(stage.read_address))
              def enqueue = builder.bit_and(module_def, active, observe(stage.enqueue))
              builder.memory_write(module_def, storage, observe(stage.write_address), reference, clock, enqueue)
              // Functional occupancy hides stale memory after reset or dequeue;
              // no shadow pointers, occupancy counter, or payload are needed.
              def resident = builder.mux_lookup(module_def, observe(stage.stored_valid), empty, [[1, stored]])
              builder.assert(module_def, builder.record_get(module_def, resident, "valid"), clock, reset, observe(stage.dequeue), name ++ "_dequeue_present")
              builder.mux_lookup(module_def, observe(stage.bypass), resident, [[1, reference]])
            | block:
                def delayed = builder.register(module_def, name, reference.type, clock, reset, empty)
                if stage.advance
                | def incoming = builder.mux_lookup(module_def, observe(stage.valid), empty, [[1, reference]])
                  builder.drive(delayed.next, builder.mux_lookup(module_def, observe(stage.advance), delayed.current, [[1, incoming]]))
                | builder.drive(delayed.next, reference)
                delayed.current
        fun emit_plan(plan :: EventTracePlan):
          unless built_plans.has_key(plan)
          | def result:
              cond
              | plan is_a EventTraceSource:
                  def reference = references[plan.site]
                  lineage(builder.record_get(module_def, reference, "valid"), [reference])
              | plan is_a EventTraceJoin:
                  def mutable valid = yes
                  def mutable parents = []
                  for (input in plan.inputs):
                    def incoming = emit_plan(input)
                    valid := builder.bit_and(module_def, valid, builder.record_get(module_def, incoming, "valid"))
                    parents := parents ++ parent_slots(incoming)
                  lineage(valid, parents)
              | plan is_a EventTraceReplication: emit_plan(plan.input)
              | plan is_a EventTraceBroadcast:
                  fun observe(value :: Value): observed[control_ids[[plan.instance_path, value.id]]]
                  unless built_broadcasts.has_key(plan.broadcast_id)
                  | def name = stage_name()
                    def incoming = emit_plan(plan.input)
                    def resident = builder.register(module_def, name, incoming.type, clock, reset, empty_lineage(event_trace_capacity(plan)))
                    builder.drive(resident.next, builder.mux_lookup(module_def, observe(plan.accept), resident.current, [[1, incoming]]))
                    builder.assert(module_def, builder.record_get(module_def, incoming, "valid"), clock, reset, observe(plan.accept), name ++ "_accept_present")
                    built_broadcasts[plan.broadcast_id] := resident.current
                  // No bypass: last-recipient delivery uses the old reference
                  // even when this same edge captures the replacement input.
                  builder.mux_lookup(module_def, observe(plan.pending), empty_lineage(event_trace_capacity(plan)), [[1, built_broadcasts[plan.broadcast_id]]])
              | plan is_a EventTracePipeline:
                  def mutable reference = emit_plan(plan.input)
                  for (stage in plan.stages): reference := emit_stage(stage, reference)
                  reference
              | plan is_a EventTraceRouting:
                  def name = stage_name()
                  def mutable seen = builder.constant(module_def, Bits(1), 0)
                  for (predicate in plan.predicates, index in 0..plan.predicates.length()):
                    def selected = observed[control_ids[[plan.instance_path, predicate.id]]]
                    def overlap = builder.bit_and(module_def, seen, selected)
                    builder.assert(module_def, builder.bit_not(module_def, overlap), clock, reset, yes, name ++ "_onehot_" ++ to_string(index))
                    seen := builder.bit_or(module_def, seen, selected)
                  def selected = observed[control_ids[[plan.instance_path, plan.predicates[plan.output_index].id]]]
                  builder.mux_lookup(module_def, selected, empty_lineage(event_trace_capacity(plan)), [[1, emit_plan(plan.input)]])
              | ~else:
                  def name = stage_name()
                  def count = event_trace_capacity(plan)
                  def mutable reference = empty_lineage(count)
                  def mutable seen = builder.constant(module_def, Bits(1), 0)
                  for (input in plan.inputs, grant in plan.grants, index in 0..plan.grants.length()):
                    def selected = observed[control_ids[[plan.instance_path, grant.id]]]
                    def overlap = builder.bit_and(module_def, seen, selected)
                    builder.assert(module_def, builder.bit_not(module_def, overlap), clock, reset, yes, name ++ "_onehot_" ++ to_string(index))
                    seen := builder.bit_or(module_def, seen, selected)
                    reference := builder.mux_lookup(module_def, selected, reference, [[1, pad_lineage(emit_plan(input), count)]])
                  reference
            built_plans[plan] := result
          built_plans[plan]
        def reference = emit_plan(parent_plans[site.id])
        def parent_valid = builder.record_get(module_def, reference, "valid")
        builder.assert(module_def, parent_valid, clock, reset, fire, ref_name("__event_parent_present_", site))
        for (parent in parent_slots(reference)):
          def emit = builder.bit_and(module_def, builder.bit_and(module_def, fire, parent_valid), builder.record_get(module_def, parent, "valid"))
          builder.dpi_call(module_def, edge_dpi, [id, sequence, builder.record_get(module_def, parent, "site"), builder.record_get(module_def, parent, "sequence")], clock, emit)
    unless occurrence === root
    | for (site in subtree_sites(occurrence)):
        builder.drive(builder.output(module_def, ref_name("__event_out_", site), reference_type), references[site.id])
      for (control in subtree_controls(occurrence)):
        builder.drive(builder.output(module_def, control_name(control), control_type(control)), observed[control.index])
    builder.finish(module_def)
  def top = rebuild(root)
  def instrumented = DesignElaboration(design, top)
  verify_design(design)
  EventInstrumentedElaboration(logical, instrumented, manifest)
