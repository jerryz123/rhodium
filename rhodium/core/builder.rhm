               name :: False || AsciiIdentifier = #false,
               location :: Location = Location(),
               origin :: Origin = Origin("trunc")):
    ensure_module_in_design(design, module_def, #'trunc)
    ensure_open(module_def, #'trunc)
    ensure_value_in(module_def, value, #'trunc)
    unless bits_type(value.type)
    | fail(#'trunc, "trunc operand must have a Bits type")
    unless target_width < value.type.width
    | fail(#'trunc, "trunc target width must be smaller than the source width")
    build_value_operation(design,
                          module_def,
                          "rtl.trunc",
                          [value],
                          Bits(target_width),
                          name,
                          location,
                          origin,
                          #'trunc,
                          {"target_width": target_width})

  method record_create(module_def :: Module,
                       type :: RecordType,
                       field_values :: List.of(List),
                       name :: False || AsciiIdentifier = #false,
                       location :: Location = Location(),
                       origin :: Origin = Origin("record_create")):
    ensure_module_in_design(design, module_def, #'record_create)
    ensure_open(module_def, #'record_create)
    unless record_type(type) && type_well_formed(type)
    | fail(#'record_create, "record_create type must be a well-formed RecordType")
    for (binding in field_values):
      unless binding.length() == 2 && binding[0] is_a String
      | fail(#'record_create, "record fields must be [name, value] pairs")
      unless type.field(binding[0])
      | fail(#'record_create, "record has no field named " ++ binding[0])
      when field_values.filter(
        ~keep: fun (candidate): candidate[0] == binding[0]
      ).length() != 1
      | fail(#'record_create, "record field values must be unique")
    unless field_values.length() == type.fields.length()
    | fail(#'record_create, "record_create requires exactly one value for every field")
    def normalized_values:
      type.fields.map(
        fun (field):
          def binding = field_values.find(
            fun (candidate): candidate[0] == field.name
          )
          unless binding
          | fail(#'record_create, "record_create is missing field " ++ field.name)
          ensure_value_in(module_def, binding[1], #'record_create)
          unless type_equal(field.type, binding[1].type)
          | fail(#'record_create,
                 "record field " ++ field.name ++ " has the wrong hardware type")
          binding[1]
      )
    build_value_operation(design,
                          module_def,
                          "rtl.record_create",
                          normalized_values,
                          type,
                          name,
                          location,
                          origin,
                          #'record_create,
                          {"fields": type.fields.map(
                            fun (field): field.name
                          )})

  method record_get(module_def :: Module,
                    record :: Value,
                    field_name :: AsciiIdentifier,
                    name :: False || AsciiIdentifier = #false,
                    location :: Location = Location(),
                    origin :: Origin = Origin("record_get")):
    ensure_module_in_design(design, module_def, #'record_get)
    ensure_open(module_def, #'record_get)
    ensure_value_in(module_def, record, #'record_get)
    unless record_type(record.type)
    | fail(#'record_get, "record_get operand must have a RecordType")
    def field = record.type.field(field_name)
    unless field
    | fail(#'record_get, "record has no field named " ++ field_name)
    build_value_operation(design,
                          module_def,
                          "rtl.record_get",
                          [record],
                          field.type,
                          name,
                          location,
                          origin,
                          #'record_get,
                          {"field": field_name})

  method vector_create(module_def :: Module,
                       type :: VectorType,
                       elements :: List.of(Value),
                       name :: False || AsciiIdentifier = #false,
                       location :: Location = Location(),
                       origin :: Origin = Origin("vector_create")):
    ensure_module_in_design(design, module_def, #'vector_create)
    ensure_open(module_def, #'vector_create)
    unless vector_type(type) && type_well_formed(type)
    | fail(#'vector_create, "vector_create type must be a well-formed VectorType")
    unless elements.length() == type.length
    | fail(#'vector_create, "vector_create requires exactly one value per element")
    for (element in elements):
      ensure_value_in(module_def, element, #'vector_create)
      unless type_equal(element.type, type.element_type)
      | fail(#'vector_create, "vector element has the wrong hardware type")
    build_value_operation(design,
                          module_def,
                          "rtl.vector_create",
                          elements,
                          type,
                          name,
                          location,
                          origin,
                          #'vector_create)

  method vector_get(module_def :: Module,
                    vector :: Value,
                    index :: Nat,
                    name :: False || AsciiIdentifier = #false,
                    location :: Location = Location(),
                    origin :: Origin = Origin("vector_get")):
    ensure_module_in_design(design, module_def, #'vector_get)
    ensure_open(module_def, #'vector_get)
    ensure_value_in(module_def, vector, #'vector_get)
    unless vector_type(vector.type)
    | fail(#'vector_get, "vector_get operand must have a VectorType")
    unless index < vector.type.length
    | fail(#'vector_get, "vector index must satisfy 0 <= index < vector length")
    build_value_operation(design,
                          module_def,
                          "rtl.vector_get",
                          [vector],
                          vector.type.element_type,
                          name,
                          location,
                          origin,
                          #'vector_get,
                          {"index": index})

  // Dynamic vector access is intentionally partial: an index encoding outside
  // the vector length leaves the operation result unconstrained.
  method vector_index(module_def :: Module,
                      vector :: Value,
                      index :: Value,
                      name :: False || AsciiIdentifier = #false,
                      location :: Location = Location(),
                      origin :: Origin = Origin("vector_index")):
    ensure_module_in_design(design, module_def, #'vector_index)
    ensure_open(module_def, #'vector_index)
    ensure_value_in(module_def, vector, #'vector_index)
    ensure_value_in(module_def, index, #'vector_index)
    unless vector_type(vector.type)
    | fail(#'vector_index, "vector_index operand must have a VectorType")
    unless bits_type(index.type) && index.type.width == count_index_width(vector.type.length)
    | fail(#'vector_index, "vector_index selector has the wrong Bits width")
    build_value_operation(design,
                          module_def,
                          "rtl.vector_index",
                          [vector, index],
                          vector.type.element_type,
                          name,
                          location,
                          origin,
                          #'vector_index)

  // Dynamic injection preserves the vector type. An out-of-range selector
  // makes the complete result vector unconstrained.
  method vector_inject(module_def :: Module,
                       vector :: Value,
                       index :: Value,
                       element :: Value,
                       name :: False || AsciiIdentifier = #false,
                       location :: Location = Location(),
                       origin :: Origin = Origin("vector_inject")):
    ensure_module_in_design(design, module_def, #'vector_inject)
    ensure_open(module_def, #'vector_inject)
    ensure_value_in(module_def, vector, #'vector_inject)
    ensure_value_in(module_def, index, #'vector_inject)
    ensure_value_in(module_def, element, #'vector_inject)
    unless vector_type(vector.type)
    | fail(#'vector_inject, "vector_inject operand must have a VectorType")
    unless bits_type(index.type) && index.type.width == count_index_width(vector.type.length)
    | fail(#'vector_inject, "vector_inject selector has the wrong Bits width")
    unless type_equal(element.type, vector.type.element_type)
    | fail(#'vector_inject, "vector_inject element has the wrong hardware type")
    build_value_operation(design,
                          module_def,
                          "rtl.vector_inject",
                          [vector, index, element],
                          vector.type,
                          name,
                          location,
                          origin,
                          #'vector_inject)

  // Applies an unordered set of enabled dynamic writes to one vector. Enabled
  // writes must use in-range, pairwise-distinct indices; other cases are UB.
  method vector_write_set(module_def :: Module,
                          vector :: Value,
                          enables :: Value,
                          indices :: Value,
                          elements :: Value,
                          name :: False || AsciiIdentifier = #false,
                          location :: Location = Location(),
                          origin :: Origin = Origin("vector_write_set")):
    ensure_module_in_design(design, module_def, #'vector_write_set)
    ensure_open(module_def, #'vector_write_set)
    ensure_value_in(module_def, vector, #'vector_write_set)
    ensure_value_in(module_def, enables, #'vector_write_set)
    ensure_value_in(module_def, indices, #'vector_write_set)
    ensure_value_in(module_def, elements, #'vector_write_set)
    unless vector_type(vector.type)
    | fail(#'vector_write_set, "vector_write_set base must have a VectorType")
    unless vector_type(enables.type) && enables.type.length > 0 && type_equal(enables.type.element_type, Bits(1))
    | fail(#'vector_write_set, "vector_write_set enables must be a nonempty Vec of Bits(1)")
    def port_count = if vector_type(enables.type) | enables.type.length | 0
    unless vector_type(indices.type) && indices.type.length == port_count && bits_type(indices.type.element_type) && indices.type.element_type.width == count_index_width(vector.type.length)
    | fail(#'vector_write_set, "vector_write_set indices have the wrong vector type")
    unless vector_type(elements.type) && elements.type.length == port_count && type_equal(elements.type.element_type, vector.type.element_type)
    | fail(#'vector_write_set, "vector_write_set elements have the wrong vector type")
    build_value_operation(design,
                          module_def,
                          "rtl.vector_write_set",
                          [vector, enables, indices, elements],
                          vector.type,
                          name,
                          location,
                          origin,
                          #'vector_write_set)

  method project(place :: Place, field_name :: AsciiIdentifier):
    def module_def = design.find_module(place.module_id)
    ensure_module_in_design(design, module_def, #'project)
    ensure_open(module_def, #'project)
    ensure_place_in(module_def, place, #'project)
    unless record_type(place.type)
    | fail(#'project, "field projection target must have a RecordType")
    def field = place.type.field(field_name)
    unless field
    | fail(#'project, "record has no field named " ++ field_name)
    def existing = place.projected_place(field_name)
    if existing
    | existing
    | block:
        def projected = Place(#false,
                              place.name ++ "." ++ field_name,
                              field.type,
                              module_def,
                              place.owner_op_id,
                              #false,
                              place,
                              field_name)
        place.projected_places := place.projected_places ++ [projected]
        projected

  method project_vector(place :: Place, index :: Nat):
    def module_def = design.find_module(place.module_id)
    ensure_module_in_design(design, module_def, #'project_vector)
    ensure_open(module_def, #'project_vector)
    ensure_place_in(module_def, place, #'project_vector)
    unless vector_type(place.type)
    | fail(#'project_vector, "vector projection target must have a VectorType")
    unless index < place.type.length
    | fail(#'project_vector, "vector index must satisfy 0 <= index < vector length")
    def existing = place.projected_place(index)
    if existing
    | existing
    | block:
        def projected = Place(#false,
                              place.name ++ "[" ++ to_string(index) ++ "]",
                              place.type.element_type,
                              module_def,
                              place.owner_op_id,
                              #false,
                              place,
                              index)
        place.projected_places := place.projected_places ++ [projected]
        projected

  method assemble_aggregate_place(place :: Place,
                                  location :: Location = Location()):
    if !aggregate_place_complete(place)
    | #false
    | cond
      | record_type(place.type):
          def mutable bindings = []
          for (field in place.type.fields):
            def projected = place.projected_place(field.name)
            def field_value:
              if projected.driver
              | projected.driver
              | this.assemble_aggregate_place(projected, location)
            bindings := bindings ++ [[field.name, field_value]]
          this.record_create(place.module_def,
                             place.type,
                             bindings,
                             #false,
                             location,
                             Origin("aggregate place assembly", place.name))
      | vector_type(place.type):
          def elements:
            for List (index in 0..place.type.length):
              def projected = place.projected_place(index)
              if projected.driver
              | projected.driver
              | this.assemble_aggregate_place(projected, location)
          this.vector_create(place.module_def,
                             place.type,
                             elements,
                             #false,
                             location,
                             Origin("aggregate place assembly", place.name))
      | ~else: #false

  method canonicalize_aggregate_place(
      place :: Place,
      location :: Location = Location(),
      ~preserve_projections: preserve_projections :: Boolean = #false):
    def assembled = this.assemble_aggregate_place(place, location)
    if assembled
    | block:
        def projections = place.projected_places
        place.projected_places := []
        this.drive(place,
                   assembled,
                   location,
                   Origin("aggregate place canonicalization", place.name))
        when preserve_projections
        | place.projected_places := projections
        assembled
    | #false

  // Allocates state without pretending that the memory handle is ordinary
  // hardware data. Access operations retain an explicit resource reference.
  method memory(module_def :: Module,
                name :: AsciiIdentifier,
                depth :: PosInt,
                element_type :: DataType,
                location :: Location = Location(),
                origin :: Origin = Origin("memory", name)):
    ensure_module_in_design(design, module_def, #'memory)
    ensure_open(module_def, #'memory)
    ensure_hardware_name(name, #'memory)
    ensure_data_type(element_type, #'memory)
    ensure_unique_hardware_name(module_def, name, #'memory)
    def operation_id = design.fresh_id()
    def memory = Memory(design.fresh_id(),
                        name,
                        depth,
                        element_type,
                        module_def,
                        operation_id)
    def operation = Operation(operation_id,
                              "rtl.memory",
                              module_def,
                              [],
                              [],
                              [],
                              {"memory": memory,
                               "name": name,
                               "depth": depth,
                               "element_type": element_type},
                              location,
                              origin)
    module_def.add_memory(memory)
    module_def.add_operation(operation)
    memory

  method memory_read_async(module_def :: Module,
                           memory :: Memory,
                           address :: Value,
                           name :: False || AsciiIdentifier = #false,
                           location :: Location = Location(),
                           origin :: Origin = Origin("memory read")):
    ensure_module_in_design(design, module_def, #'memory_read_async)
    ensure_open(module_def, #'memory_read_async)
    ensure_memory_in(module_def, memory, #'memory_read_async)
    ensure_value_in(module_def, address, #'memory_read_async)
    def expected_width = memory_address_width(memory.depth)
    unless bits_type(address.type) && address.type.width == expected_width
    | fail(#'memory_read_async,
           "memory address must be Bits(" ++ to_string(expected_width) ++ ")")
    build_value_operation(design,
                          module_def,
                          "rtl.memory_read_async",
                          [address],
                          memory.element_type,
                          name,
                          location,
                          origin,
                          #'memory_read_async,
                          {"memory": memory})

  method memory_write(module_def :: Module,
                      memory :: Memory,
                      address :: Value,
                      data :: Value,
                      clock :: Value,
                      enable :: Value,
                      location :: Location = Location(),
                      origin :: Origin = Origin("memory write")):
    ensure_module_in_design(design, module_def, #'memory_write)
    ensure_open(module_def, #'memory_write)
    ensure_memory_in(module_def, memory, #'memory_write)
    ensure_value_in(module_def, address, #'memory_write)
    ensure_value_in(module_def, data, #'memory_write)
    ensure_value_in(module_def, clock, #'memory_write)
    ensure_value_in(module_def, enable, #'memory_write)
    def expected_width = memory_address_width(memory.depth)
    unless bits_type(address.type) && address.type.width == expected_width
    | fail(#'memory_write,
           "memory address must be Bits(" ++ to_string(expected_width) ++ ")")
    unless data_type(data.type) && type_equal(data.type, memory.element_type)
    | fail(#'memory_write, "memory write data has the wrong DataType")
    unless clock_type(clock.type)
    | fail(#'memory_write, "memory write clock must be Clock")
    unless scalar_data_type(enable.type) && scalar_width(enable.type) == 1
    | fail(#'memory_write, "memory write enable must be a one-bit ScalarDataType")
    def existing_write = module_def.operations.find(
      fun (operation):
        operation.opcode == "rtl.memory_write" && operation.attribute("memory", #false) === memory
    )
    when existing_write && !(existing_write.operands[2] === clock)
    | fail(#'memory_write, "memory write ports must use the same clock")
    def operation_id = design.fresh_id()
    def operands = [address, data, clock, enable]
    def operation = Operation(operation_id,
                              "rtl.memory_write",
                              module_def,
                              operands,
                              [],
                              [],
                              {"memory": memory},
                              location,
                              origin)
    for (operand in operands):
      operand.add_user(operation_id)
    module_def.add_operation(operation)
    operation

  // Creates a fixed, circuit-shaped synchronous memory interface. Read and
  // write ports are declared here and subsequently wired through Places.
  method sync_memory(module_def :: Module,
                     name :: AsciiIdentifier,
                     depth :: PosInt,
                     element_type :: DataType,
                     clock :: Value,
                     has_read :: Boolean = #true,
                     has_write :: Boolean = #true,
                     has_read_write :: Boolean = #false,
                     mask_granularity :: False || PosInt = #false,
                     location :: Location = Location(),
                     origin :: Origin = Origin("synchronous memory", name)):
    ensure_module_in_design(design, module_def, #'sync_memory)
    ensure_open(module_def, #'sync_memory)
    ensure_hardware_name(name, #'sync_memory)
    ensure_unique_hardware_name(module_def, name, #'sync_memory)
    ensure_data_type(element_type, #'sync_memory)
    ensure_value_in(module_def, clock, #'sync_memory)
    unless clock_type(clock.type)
    | fail(#'sync_memory, "synchronous memory clock must be Clock")
    unless has_read || has_write || has_read_write
    | fail(#'sync_memory,
           "synchronous memory requires a read, write, or read-write port")
    when has_read_write && (has_read || has_write)
    | fail(#'sync_memory,
           "a read-write port cannot be combined with separate read or write ports yet")
    when mask_granularity
    | unless mask_granularity is_a PosInt
      | fail(#'sync_memory,
             "synchronous memory mask granularity must be PosInt")
      unless has_write || has_read_write
      | fail(#'sync_memory,
             "synchronous memory masking requires a write-capable port")
      def element_width = element_type.packed_width()
      unless element_width is_a PosInt
      | fail(#'sync_memory,
             "masked synchronous memory element type must have a packed width")
      unless element_width mod mask_granularity == 0
      | fail(#'sync_memory,
             "synchronous memory mask granularity must divide the packed element width")
    def operation_id = design.fresh_id()
    def address_type = Bits(memory_address_width(depth))
    def mask_type:
      if !mask_granularity
      | #false
      | Bits(element_type.packed_width() / mask_granularity)
    def mutable places = []
    def mutable results = []
    def read_port:
      if has_read
      | block:
          def address = Place(design.fresh_id(),
                              name ++ ".read.address",
                              address_type,
                              module_def,
                              operation_id)
          def enable = Place(design.fresh_id(),
                             name ++ ".read.enable",
                             Bits(1),
                             module_def,
                             operation_id)
          def data = Value(design.fresh_id(),
                           name ++ ".read.data",
                           element_type,
                           module_def,
                           operation_id)
          places := places ++ [address, enable]
          results := results ++ [data]
          SyncMemoryReadPort(address, enable, data)
      | #false
    def write_port:
      if has_write
      | block:
          def address = Place(design.fresh_id(),
                              name ++ ".write.address",
                              address_type,
                              module_def,
                              operation_id)
          def data = Place(design.fresh_id(),
                           name ++ ".write.data",
                           element_type,
                           module_def,
                           operation_id)
          def enable = Place(design.fresh_id(),
                             name ++ ".write.enable",
                             Bits(1),
                             module_def,
                             operation_id)
          def mask:
            if mask_type
            | Place(design.fresh_id(),
                    name ++ ".write.mask",
                    mask_type,
                    module_def,
                    operation_id)
            | #false
          places := places ++ [address, data, enable] ++ (if mask | [mask] | [])
          SyncMemoryWritePort(address, data, enable, mask)
      | #false
    def read_write_port:
      if has_read_write
      | block:
          def address = Place(design.fresh_id(),
                              name ++ ".read_write.address",
                              address_type,
                              module_def,
                              operation_id)
          def enable = Place(design.fresh_id(),
                             name ++ ".read_write.enable",
                             Bits(1),
                             module_def,
                             operation_id)
          def write = Place(design.fresh_id(),
                            name ++ ".read_write.write",
                            Bits(1),
                            module_def,
                            operation_id)
          def write_data = Place(design.fresh_id(),
                                 name ++ ".read_write.write_data",
                                 element_type,
                                 module_def,
                                 operation_id)
          def read_data = Value(design.fresh_id(),
                                name ++ ".read_write.read_data",
                                element_type,
                                module_def,
                                operation_id)
          def write_mask:
            if mask_type
            | Place(design.fresh_id(),
                    name ++ ".read_write.write_mask",
                    mask_type,
                    module_def,
                    operation_id)
            | #false
          places := places ++ [address, enable, write, write_data] ++ (if write_mask | [write_mask] | [])
          results := results ++ [read_data]
          SyncMemoryReadWritePort(address,
                                  enable,
                                  write,
                                  write_data,
                                  read_data,
                                  write_mask)
      | #false
    def operation = Operation(operation_id,
                              "rtl.sync_memory",
                              module_def,
                              [clock],
                              results,
                              places,
                              {"name": name,
                               "depth": depth,
                               "element_type": element_type,
                               "has_read": has_read,
                               "has_write": has_write,
                               "has_read_write": has_read_write,
                               "mask_granularity": mask_granularity},
                              location,
                              origin)
    clock.add_user(operation_id)
    for (place in places): module_def.add_place(place)
    for (result in results): module_def.add_value(result)
    module_def.add_operation(operation)
    SyncMemory(operation,
               name,
               depth,
               element_type,
               clock,
               if read_port | [read_port] | [],
               if write_port | [write_port] | [],
               if read_write_port | [read_write_port] | [],
               mask_granularity)

  method register(module_def :: Module,
                  name :: AsciiIdentifier,
                  type :~ DataType,
                  clock :: Value,
                  reset :: False || Value = #false,
                  reset_value :: False || Value = #false,
                  location :: Location = Location(),
                  origin :: Origin = Origin("register", name)):
    ensure_module_in_design(design, module_def, #'register)
    ensure_open(module_def, #'register)
    ensure_hardware_name(name, #'register)
    ensure_data_type(type, #'register)
    ensure_value_in(module_def, clock, #'register)
    unless clock_type(clock.type)
    | fail(#'register, "register clock must be Clock")
    unless (reset && reset_value) || (!reset && !reset_value)
    | fail(#'register,
           "synchronous reset and reset value must be supplied together")
    when reset
    | ensure_value_in(module_def, reset, #'register)
      ensure_value_in(module_def, reset_value, #'register)
      unless reset_type(reset.type)
      | fail(#'register, "register reset must be Reset")
      unless data_type(reset_value.type) && type_equal(type, reset_value.type)
      | fail(#'register, "register reset value has the wrong hardware type")
    ensure_unique_hardware_name(module_def, name, #'register)
    ensure_unique_hardware_name(module_def, name ++ ".next", #'register)
    def operation_id = design.fresh_id()
    def current = Value(design.fresh_id(), name, type, module_def, operation_id)
    def next = Place(design.fresh_id(), name ++ ".next", type, module_def, operation_id)
    def operands = if reset | [clock, reset, reset_value] | [clock]
    def operation = Operation(operation_id,
                              if reset | "rtl.register_reset" | "rtl.register",
                              module_def,
                              operands,
                              [current],
                              [next],
                              {"name": name},
                              location,
                              origin)
    for (operand in operands):
      operand.add_user(operation_id)
    module_def.add_value(current)
    module_def.add_place(next)
    module_def.add_operation(operation)
    Register(operation, current, next)

  // Records a stable one-bit level crossing while leaving its implementation
  // as ordinary, inspectable destination-clock registers.
  method sync_level_crossing(module_def :: Module,
                             source :: Value,
                             destination_clock :: Value,
                             stages :: List.of(Register),
                             location :: Location = Location(),
                             origin :: Origin = Origin("stable level crossing")):
    ensure_module_in_design(design, module_def, #'sync_level_crossing)
    ensure_open(module_def, #'sync_level_crossing)
    ensure_value_in(module_def, source, #'sync_level_crossing)
    ensure_value_in(module_def, destination_clock, #'sync_level_crossing)
    unless bits_type(source.type) && source.type.width == 1
    | fail(#'sync_level_crossing, "source must be Bits(1)")
    unless clock_type(destination_clock.type)
    | fail(#'sync_level_crossing, "destination clock must be Clock")
    unless stages.length() >= 2
    | fail(#'sync_level_crossing, "requires at least two register stages")
    for (stage in stages):
      ensure_value_in(module_def, stage.current, #'sync_level_crossing)
    def operation_id = design.fresh_id()
    def operands = [source, destination_clock] ++ stages.map(
      fun (stage): stage.current
    )
    def operation = Operation(operation_id,
                              "cdc.sync_level",
                              module_def,
                              operands,
                              [],
                              [],
                              {"promise": "stable_level"},
                              location,
                              origin)
    for (operand in operands):
      operand.add_user(operation_id)
    module_def.add_operation(operation)
    operation

  method instance(module_def :: Module,
                  child :: Module,
                  name :: AsciiIdentifier,
                  location :: Location = Location(),
                  origin :: Origin = Origin("instance", name)):
    ensure_module_in_design(design, module_def, #'instance)
    ensure_open(module_def, #'instance)
    ensure_hardware_name(name, #'instance)
    unless child.finished
    | fail(#'instance, "instance target must be a finished module definition")
    def child_owned = child.design === design && design.owns_module(child)
    unless child_owned
    | fail(#'instance, "instance target belongs to a different design")
    ensure_unique_instance_name(module_def, name, #'instance)
    for (port in child.inputs):
      ensure_unique_hardware_name(module_def, name ++ "." ++ port.name, #'instance)
    for (port in child.outputs):
      ensure_unique_hardware_name(module_def, name ++ "." ++ port.name, #'instance)
    def operation_id = design.fresh_id()
    def mutable input_bindings = []
    def mutable output_bindings = []
    def mutable places = []
    def mutable results = []
    for (port in child.inputs):
      def place = Place(design.fresh_id(),
                        name ++ "." ++ port.name,
                        port.type,
                        module_def,
                        operation_id)
      module_def.add_place(place)
      places := places ++ [place]
      input_bindings := input_bindings ++ [Port(port.name, "input", port.type, #false, place)]
    for (port in child.outputs):
      def value = Value(design.fresh_id(),
                        name ++ "." ++ port.name,
                        port.type,
                        module_def,
                        operation_id)
      module_def.add_value(value)
      results := results ++ [value]
      output_bindings := output_bindings ++ [Port(port.name, "output", port.type, value, #false)]
    def operation = Operation(operation_id,
                              "rtl.instance",
                              module_def,
                              [],
                              results,
                              places,
                              {"name": name, "module": child},
                              location,
                              origin)
    module_def.add_operation(operation)
    Instance(operation, child, input_bindings, output_bindings)

  // Treats the supplied name as a suggestion while `instance` itself retains
  // exact-name behavior for low-level callers that want collision errors.
  method suggested_instance(module_def :: Module,
                            child :: Module,
                            base_name :: AsciiIdentifier,
                            location :: Location = Location(),
                            origin :: Origin = Origin("instance", base_name)):
    this.instance(module_def,
                  child,
                  this.fresh_instance_name(module_def, base_name),
                  location,
                  origin)

  method drive(place :: Place,
               value :: Value,
               location :: Location = Location(),
               origin :: Origin = Origin("drive")):
    def module_def = design.find_module(place.module_id)
    def root = root_place(place)
    def target_owned = module_def && place.design === design && place.module_def === module_def && module_def.owns_place(root)
    unless target_owned
    | fail(#'drive, "drive target belongs to a different design")
    ensure_open(module_def, #'drive)
    ensure_place_in(module_def, place, #'drive)
    ensure_value_in(module_def, value, #'drive)
    unless type_equal(place.type, value.type)
    | fail(#'drive, "place and driver must have exactly the same hardware type")
    when place.driver
    | fail(#'drive, "place " ++ place.name ++ " already has a driver")
    when ancestor_has_driver(place) || place.projected_places.find(place_has_staged_driver)
    | fail(#'drive, "aggregate places cannot mix whole-value and element-wise drivers")
    place.driver := value
    unless place.projected()
    | def operation_id = design.fresh_id()
      def operation = Operation(operation_id,
                                "rtl.drive",
                                module_def,
                                [value],
                                [],
                                [place],
                                {},
                                location,
                                origin)
      value.add_user(operation_id)
      module_def.add_operation(operation)
    #void

  method read(place :: Place):
    def module_def = design.find_module(place.module_id)
    def root = root_place(place)
    def target_owned = module_def && place.design === design && place.module_def === module_def && module_def.owns_place(root)
    unless target_owned
    | fail(#'read, "read target belongs to a different design")
    def owner = module_def.find_operation(root.owner_op_id)
    if owner && owner.opcode == "rtl.wire"
    | if place.projected()
      | block:
          def parent_value = this.read(place.parent)
          if record_type(place.parent.type)
          | this.record_get(module_def, parent_value, place.projection_key)
          | this.vector_get(module_def, parent_value, place.projection_key)
      | owner.results[0]
    | if place.driver
      | place.driver
      | block:
          def assembled = this.assemble_aggregate_place(place)
          cond
          | assembled && place.projected():
              place.driver := assembled
              assembled
          | assembled:
              place.projected_places := []
              this.drive(place,
                         assembled,
                         Location(),
                         Origin("aggregate place canonicalization", place.name))
              assembled
          | place.projected():
              def parent_value = this.read(place.parent)
              if record_type(place.parent.type)
              | this.record_get(module_def, parent_value, place.projection_key)
              | this.vector_get(module_def, parent_value, place.projection_key)
          | ~else:
              fail(#'read, "place " ++ place.name ++ " must be driven before it is read")

  method finish(module_def :: Module):
    ensure_module_in_design(design, module_def, #'finish)
    ensure_open(module_def, #'finish)
    for (place in module_def.places):
      when !place.driver && (record_type(place.type) || vector_type(place.type))
      | when place_has_staged_driver(place) && !aggregate_place_complete(place)
        | fail(#'finish,
               if record_type(place.type)
               | "record place " ++ place.name ++ " has incomplete field-wise drivers"
               | "vector place " ++ place.name ++ " has incomplete element-wise drivers")
        when aggregate_place_complete(place)
        | def owner = module_def.find_operation(place.owner_op_id)
          this.canonicalize_aggregate_place(
            place,
            ~preserve_projections: owner && owner.opcode == "rtl.wire"
          )
    module_def.finish_collections()
    module_def.finished := #true
    module_def
