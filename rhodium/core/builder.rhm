#lang rhombus
// Builds well-owned Rhodium IR while enforcing local type, naming, and driver rules.

import:
  "../../support/annotations.rhm" open
  "types.rhm" open
  "ir.rhm" open

export:
  Builder

fun fail(who :: Symbol, message :: String):
  error(~who: who, message)

fun ensure_hardware_type(type :~ HardwareType, who :: Symbol):
  unless type_well_formed(type)
  | fail(who, "expected a well-formed HardwareType")

fun ensure_bits(type :~ HardwareType, who :: Symbol):
  ensure_hardware_type(type, who)
  unless bits_type(type)
  | fail(who, "expected a Bits type")

fun ensure_data_type(type :~ HardwareType, who :: Symbol):
  ensure_hardware_type(type, who)
  unless data_type(type)
  | fail(who, "expected a DataType")

fun ensure_packable_data_type(type :~ HardwareType, who :: Symbol):
  ensure_data_type(type, who)
  unless type.packed_width() is_a PosInt
  | fail(who, "expected a packable DataType")

fun normalize_decode_pattern(value :: Nat,
                             care :: Nat,
                             width :: PosInt,
                             who :: Symbol,
                             role :: String):
  unless bits.length(value) <= width && bits.length(care) <= width
  | fail(who, role ++ " value or care does not fit its packed width")
  [value bits.and care, care]

fun decode_patterns_overlap(left :: List, right :: List):
  def differing = left[0] bits.xor right[0]
  def jointly_cared = left[1] bits.and right[1]
  (differing bits.and jointly_cared) == 0

fun ensure_hardware_name(name :: AsciiIdentifier, who :: Symbol):
  when name.starts_with("__rhodium_")
  | fail(who, "hardware names beginning with __rhodium_ are reserved")

fun ensure_module_in_design(design :: Design,
                            module_def :: Module,
                            who :: Symbol):
  def owned = module_def.design === design && design.owns_module(module_def)
  unless owned
  | fail(who, "module belongs to a different design")

fun ensure_open(module_def :: Module, who :: Symbol):
  when module_def.finished
  | fail(who, "module " ++ module_def.name ++ " is already finished")

fun ensure_value_in(module_def :: Module, value :: Value, who :: Symbol):
  def owned = value.module_def === module_def && module_def.owns_value(value)
  unless owned
  | fail(who, "hardware value belongs to a different module")

fun ensure_memory_in(module_def :: Module, memory :: Memory, who :: Symbol):
  def owned = memory.module_def === module_def && module_def.owns_memory(memory)
  unless owned
  | fail(who, "memory belongs to a different module")

fun ensure_dpi_import_in(design :: Design,
                         dpi_import :: DpiImport,
                         who :: Symbol):
  def owned = dpi_import.design === design && design.owns_dpi_import(dpi_import)
  unless owned
  | fail(who, "DPI import belongs to a different design")

fun check_dpi_operands(design :: Design,
                       module_def :: Module,
                       dpi_import :: DpiImport,
                       inputs :: List.of(Value),
                       clock :: Value,
                       enable :: Value,
                       who :: Symbol):
  ensure_module_in_design(design, module_def, who)
  ensure_open(module_def, who)
  ensure_dpi_import_in(design, dpi_import, who)
  unless inputs.length() == dpi_import.input_types.length()
  | fail(who, "DPI input count does not match its import")
  for (input in inputs, expected_type in dpi_import.input_types):
    ensure_value_in(module_def, input, who)
    unless type_equal(input.type, expected_type)
    | fail(who, "DPI input has the wrong hardware type")
  ensure_value_in(module_def, clock, who)
  unless clock_type(clock.type)
  | fail(who, "DPI clock must be Clock")
  ensure_value_in(module_def, enable, who)
  unless scalar_data_type(enable.type) && scalar_width(enable.type) == 1
  | fail(who, "DPI enable must be a one-bit ScalarDataType")
  [clock, enable] ++ inputs

fun root_place(place :: Place):
  if place.parent is_a Place
  | root_place(place.parent)
  | place

fun ensure_place_in(module_def :: Module, place :: Place, who :: Symbol):
  def root = root_place(place)
  def owned = root && place.module_def === module_def && module_def.owns_place(root)
  unless owned
  | fail(who, "hardware place belongs to a different module")

fun place_has_staged_driver(place :: Place):
  place.driver || (for any (projected in place.projected_places): place_has_staged_driver(projected))

fun ancestor_has_driver(place :: Place):
  if place.parent is_a Place
  | place.parent.driver || ancestor_has_driver(place.parent)
  | #false

fun aggregate_place_complete(place :: Place):
  if place.driver
  | #true
  | if record_type(place.type)
    | for all (field in place.type.fields):
        def projected = place.projected_place(field.name)
        projected && aggregate_place_complete(projected)
    | if vector_type(place.type)
      | for all (index in 0..place.type.length):
          def projected = place.projected_place(index)
          projected && aggregate_place_complete(projected)
      | #false

fun ensure_unique_hardware_name(module_def :: Module,
                                name :: String,
                                who :: Symbol):
  when module_def.hardware_name_used(name)
  | fail(who, "duplicate hardware name " ++ name)

fun ensure_unique_instance_name(module_def :: Module,
                                name :: String,
                                who :: Symbol):
  when module_def.find_instance(name)
  | fail(who, "duplicate instance name " ++ name)

fun instance_name_used(module_def :: Module, name :: String):
  module_def.find_instance(name)

fun build_value_operation(design :: Design,
                          module_def :: Module,
                          opcode :: String,
                          operands :: List.of(Value),
                          result_type :: HardwareType,
                          name :: False || AsciiIdentifier,
                          location :: Location,
                          origin :: Origin,
                          who :: Symbol,
                          attributes :: Map = {}):
  def operation_id = design.fresh_id()
  def value_name = name || "v" ++ to_string(operation_id)
  ensure_hardware_name(value_name, who)
  ensure_unique_hardware_name(module_def, value_name, who)
  def value = Value(design.fresh_id(), value_name, result_type, module_def, operation_id)
  def operation = Operation(operation_id,
                            opcode,
                            module_def,
                            operands,
                            [value],
                            [],
                            attributes ++ {"name": value_name},
                            location,
                            origin)
  for (operand in operands):
    operand.add_user(operation_id)
  module_def.add_value(value)
  module_def.add_operation(operation)
  value

fun build_arithmetic_same_type_binary(design :: Design,
                                      module_def :: Module,
                                      opcode :: String,
                                      left :: Value,
                                      right :: Value,
                                      name :: False || AsciiIdentifier,
                                      location :: Location,
                                      origin :: Origin,
                                      who :: Symbol):
  ensure_module_in_design(design, module_def, who)
  ensure_open(module_def, who)
  ensure_value_in(module_def, left, who)
  ensure_value_in(module_def, right, who)
  unless arithmetic_type(left.type) && arithmetic_type(right.type) && type_equal(left.type, right.type)
  | fail(who,
         opcode ++ " operands must have exactly the same arithmetic type and width")
  build_value_operation(design,
                        module_def,
                        opcode,
                        [left, right],
                        left.type,
                        name,
                        location,
                        origin,
                        who)

fun build_bitwise_same_type_binary(design :: Design,
                                   module_def :: Module,
                                   opcode :: String,
                                   left :: Value,
                                   right :: Value,
                                   name :: False || AsciiIdentifier,
                                   location :: Location,
                                   origin :: Origin,
                                   who :: Symbol):
  ensure_module_in_design(design, module_def, who)
  ensure_open(module_def, who)
  ensure_value_in(module_def, left, who)
  ensure_value_in(module_def, right, who)
  unless bitwise_type(left.type) && bitwise_type(right.type) && type_equal(left.type, right.type)
  | fail(who,
         opcode ++ " operands must have exactly the same bitwise type")
  build_value_operation(design,
                        module_def,
                        opcode,
                        [left, right],
                        left.type,
                        name,
                        location,
                        origin,
                        who)

fun build_bits_shift(design :: Design,
                     module_def :: Module,
                     opcode :: String,
                     value :: Value,
                     amount :: Value,
                     name :: False || AsciiIdentifier,
                     location :: Location,
                     origin :: Origin,
                     who :: Symbol):
  ensure_module_in_design(design, module_def, who)
  ensure_open(module_def, who)
  ensure_value_in(module_def, value, who)
  ensure_value_in(module_def, amount, who)
  unless bits_type(value.type)
  | fail(who, opcode ++ " shifted value must be Bits")
  unless bits_type(amount.type)
  | fail(who, opcode ++ " shift amount must be Bits")
  build_value_operation(design,
                        module_def,
                        opcode,
                        [value, amount],
                        value.type,
                        name,
                        location,
                        origin,
                        who)

fun build_arithmetic_shift(design :: Design,
                           module_def :: Module,
                           opcode :: String,
                           value :: Value,
                           amount :: Value,
                           name :: False || AsciiIdentifier,
                           location :: Location,
                           origin :: Origin,
                           who :: Symbol):
  ensure_module_in_design(design, module_def, who)
  ensure_open(module_def, who)
  ensure_value_in(module_def, value, who)
  ensure_value_in(module_def, amount, who)
  unless arithmetic_type(value.type)
  | fail(who, opcode ++ " shifted value must have an ArithmeticType")
  unless bits_type(amount.type)
  | fail(who, opcode ++ " shift amount must be Bits")
  build_value_operation(design,
                        module_def,
                        opcode,
                        [value, amount],
                        value.type,
                        name,
                        location,
                        origin,
                        who)

fun build_signed_arithmetic_shift(design :: Design,
                                  module_def :: Module,
                                  opcode :: String,
                                  value :: Value,
                                  amount :: Value,
                                  name :: False || AsciiIdentifier,
                                  location :: Location,
                                  origin :: Origin,
                                  who :: Symbol):
  ensure_module_in_design(design, module_def, who)
  ensure_open(module_def, who)
  ensure_value_in(module_def, value, who)
  ensure_value_in(module_def, amount, who)
  unless signed_arithmetic_type(value.type)
  | fail(who, opcode ++ " shifted value must have a SignedArithmeticType")
  unless bits_type(amount.type)
  | fail(who, opcode ++ " shift amount must be Bits")
  build_value_operation(design,
                        module_def,
                        opcode,
                        [value, amount],
                        value.type,
                        name,
                        location,
                        origin,
                        who)

fun build_mux_lookup(design :: Design,
                     module_def :: Module,
                     selector :: Value,
                     default_value :: Value,
                     cases :: NonemptyList.of(List),
                     name :: False || AsciiIdentifier,
                     location :: Location,
                     origin :: Origin,
                     who :: Symbol):
  ensure_module_in_design(design, module_def, who)
  ensure_open(module_def, who)
  ensure_value_in(module_def, selector, who)
  ensure_value_in(module_def, default_value, who)
  unless mux_selector_type(selector.type)
  | fail(who, "mux lookup selector must be Bits")
  unless data_type(default_value.type)
  | fail(who, "mux lookup values must have a DataType")
  def width = selector_width(selector.type)
  for (case in cases):
    unless case.length() == 2
    | fail(who, "mux lookup cases must be [key, value] pairs")
    def key = case[0]
    def value = case[1]
    unless key is_a Nat
    | fail(who, "mux lookup keys must be host natural numbers")
    unless bits.length(key) <= width
    | fail(who, "mux lookup key does not fit its selector type")
    ensure_value_in(module_def, value, who)
    unless data_type(value.type) && type_equal(default_value.type, value.type)
    | fail(who, "mux lookup cases and default must have exactly the same DataType")
  def normalized_cases = cases.sort(
    fun (left, right): left[0] < right[0]
  )
  def mutable previous_key = #false
  for (case in normalized_cases):
    when previous_key && previous_key == case[0]
    | fail(who, "mux lookup keys must be unique")
    previous_key := case[0]
  build_value_operation(design,
                        module_def,
                        "rtl.mux_lookup",
                        [selector, default_value] ++ normalized_cases.map(
                          fun (case): case[1]
                        ),
                        default_value.type,
                        name,
                        location,
                        origin,
                        who,
                        {"keys": normalized_cases.map(fun (case): case[0])})

// Builds a partial one-hot selection operation. Exactly one selector bit is a
// caller precondition; zero-hot and multi-hot results are intentionally
// unspecified so backends can use direct gating and reduction.
fun build_onehot_mux(design :: Design,
                     module_def :: Module,
                     selector :: Value,
                     choices :: List.of(Value),
                     name :: False || AsciiIdentifier,
                     location :: Location,
                     origin :: Origin,
                     who :: Symbol):
  ensure_module_in_design(design, module_def, who)
  ensure_open(module_def, who)
  ensure_value_in(module_def, selector, who)
  unless bits_type(selector.type)
  | fail(who, "one-hot mux selector must be Bits")
  unless choices.length() == selector.type.width
  | fail(who, "one-hot mux choice count must equal selector width")
  for (choice in choices):
    ensure_value_in(module_def, choice, who)
  def result_type = choices[0].type
  unless data_type(result_type) && packable_type(result_type)
  | fail(who, "one-hot mux choices must have a packable DataType")
  for (choice in choices):
    unless data_type(choice.type) && type_equal(choice.type, result_type)
    | fail(who, "one-hot mux choices must have exactly the same DataType")
  build_value_operation(design,
                        module_def,
                        "rtl.onehot_mux",
                        [selector] ++ choices,
                        result_type,
                        name,
                        location,
                        origin,
                        who)

class Builder(design :: Design):
  // Materializes a design-level declaration lazily so reusable frontend
  // descriptors can be called from any circuit in one elaborated design.
  method dpi_import(name :: AsciiIdentifier,
                    input_names :: NonemptyList.of(AsciiIdentifier),
                    input_types :: NonemptyList.of(ScalarDataType),
                    result_name :: False || AsciiIdentifier = #false,
                    result_type :: False || ScalarDataType = #false,
                    location :: Location = Location()):
    unless (!result_name && !result_type) || (result_name && result_type)
    | fail(#'dpi_import, "DPI result name and type must be supplied together")
    def results:
      if !result_type
      | []
      | [DpiResult(result_name, result_type, "return")]
    this.dpi_import_results(name,
                            input_names,
                            input_types,
                            results,
                            location)

  method dpi_import_results(name :: AsciiIdentifier,
                            input_names :: NonemptyList.of(AsciiIdentifier),
                            input_types :: NonemptyList.of(ScalarDataType),
                            results :: List.of(DpiResult),
                            location :: Location = Location()):
    ensure_hardware_name(name, #'dpi_import)
    unless input_names.length() == input_types.length()
    | fail(#'dpi_import, "DPI input names and types must be equal-length Lists")
    for (input_name in input_names):
      ensure_hardware_name(input_name, #'dpi_import)
      when input_names.filter(
        ~keep: fun (candidate): candidate == input_name
      ).length() != 1
      | fail(#'dpi_import, "DPI input names must be unique")
    for (input_type in input_types):
      unless scalar_data_type(input_type) && type_well_formed(input_type)
      | fail(#'dpi_import, "DPI inputs must have well-formed ScalarDataType types")
    for (result in results):
      ensure_hardware_name(result.name, #'dpi_import)
      unless scalar_data_type(result.type) && type_well_formed(result.type)
      | fail(#'dpi_import, "DPI results must have well-formed ScalarDataType types")
      unless result.direction == "out" || result.direction == "return"
      | fail(#'dpi_import, "DPI result direction must be out or return")
    def result_names = results.map(fun (result): result.name)
    for (result_name in result_names):
      when result_names.filter(
        ~keep: fun (candidate): candidate == result_name
      ).length() != 1
      | fail(#'dpi_import, "DPI result names must be unique")
      when input_names.find(
        fun (candidate): candidate == result_name
      )
      | fail(#'dpi_import, "DPI input and result names must be unique")
    when results.length() != 0
    | def return_results = results.filter(
        ~keep: fun (result): result.direction == "return"
      )
      unless return_results.length() == 1
      | fail(#'dpi_import, "DPI function requires exactly one return result")
      unless results[results.length() - 1].direction == "return"
      | fail(#'dpi_import, "DPI return result must be last")
    def existing = design.find_dpi_import(name)
    if existing
    | block:
        def same_results:
          existing.results.length() == results.length() && (for all (existing_result in existing.results, result in results): existing_result.name == result.name && existing_result.direction == result.direction && type_equal(existing_result.type, result.type))
        def same_signature = existing.input_names == input_names && existing.input_types.length() == input_types.length() && (for all (existing_type in existing.input_types, input_type in input_types): type_equal(existing_type, input_type)) && same_results
        unless same_signature
        | fail(#'dpi_import, "DPI import " ++ name ++ " has conflicting signatures")
        existing
    | block:
        def dpi_import = DpiImport(design.fresh_id(),
                                   name,
                                   input_names,
                                   input_types,
                                   results,
                                   design,
                                   location)
        design.add_dpi_import(dpi_import)
        dpi_import

  // A clocked assertion is verification collateral, not a readable value or
  // hidden state element. Its guard records derived lexical activation.
  method assert(module_def :: Module,
                condition :: Value,
                clock :: Value,
                reset :: Value,
                guard :: Value,
                label :: False || AsciiIdentifier = #false,
                location :: Location = Location(),
                origin :: Origin = Origin("clocked assertion")):
    ensure_module_in_design(design, module_def, #'assert)
    ensure_open(module_def, #'assert)
    for (operand in [condition, clock, reset, guard]):
      ensure_value_in(module_def, operand, #'assert)
    unless scalar_data_type(condition.type) && scalar_width(condition.type) == 1
    | fail(#'assert, "assert condition must be a one-bit ScalarDataType")
    unless clock_type(clock.type)
    | fail(#'assert, "assert clock must be Clock")
    unless reset_type(reset.type)
    | fail(#'assert, "assert reset must be Reset")
    unless scalar_data_type(guard.type) && scalar_width(guard.type) == 1
    | fail(#'assert, "assert guard must be a one-bit ScalarDataType")
    when label
    | ensure_hardware_name(label, #'assert)
    def operation_id = design.fresh_id()
    def operands = [condition, clock, reset, guard]
    def operation = Operation(operation_id,
                              "verif.assert",
                              module_def,
                              operands,
                              [],
                              [],
                              {"label": label},
                              location,
                              origin)
    for (operand in operands):
      operand.add_user(operation_id)
    module_def.add_operation(operation)
    operation

  // A procedure call is a clocked side effect and therefore produces no
  // hardware value or hidden result state.
  method dpi_call(module_def :: Module,
                  dpi_import :: DpiImport,
                  inputs :: List.of(Value),
                  clock :: Value,
                  enable :: Value,
                  location :: Location = Location(),
                  origin :: Origin = Origin("DPI call")):
    ensure_dpi_import_in(design, dpi_import, #'dpi_call)
    when dpi_import.has_result()
    | fail(#'dpi_call, "result-bearing DPI functions must be instantiated with dpi_register")
    def operands = check_dpi_operands(design,
                                      module_def,
                                      dpi_import,
                                      inputs,
                                      clock,
                                      enable,
                                      #'dpi_call)
    def operation_id = design.fresh_id()
    def operation = Operation(operation_id,
                              "sim.dpi_call",
                              module_def,
                              operands,
                              [],
                              [],
                              {"dpi_import": dpi_import},
                              location,
                              origin)
    for (operand in operands):
      operand.add_user(operation_id)
    module_def.add_operation(operation)
    operation

  // A DPI register makes the state implied by a result-bearing clocked call
  // explicit in both its operation name and its required hardware binding.
  method dpi_register(module_def :: Module,
                      name :: AsciiIdentifier,
                      dpi_import :: DpiImport,
                      inputs :: List.of(Value),
                      clock :: Value,
                      enable :: Value,
                      location :: Location = Location(),
                      origin :: Origin = Origin("DPI register")):
    unless dpi_import.results.length() == 1
    | fail(#'dpi_register, "dpi_register requires a function with exactly one result")
    this.dpi_register_results(module_def,
                              [name],
                              dpi_import,
                              inputs,
                              clock,
                              enable,
                              location,
                              origin)[0]

  method dpi_register_results(module_def :: Module,
                              result_names :: List.of(AsciiIdentifier),
                              dpi_import :: DpiImport,
                              inputs :: List.of(Value),
                              clock :: Value,
                              enable :: Value,
                              location :: Location = Location(),
                              origin :: Origin = Origin("DPI result registers")):
    ensure_dpi_import_in(design, dpi_import, #'dpi_register)
    unless dpi_import.has_result()
    | fail(#'dpi_register, "DPI register requires a result-bearing function")
    def operands = check_dpi_operands(design,
                                      module_def,
                                      dpi_import,
                                      inputs,
                                      clock,
                                      enable,
                                      #'dpi_register)
    unless result_names.length() == dpi_import.results.length()
    | fail(#'dpi_register,
           "DPI register result names must match the function result count")
    for (value_name in result_names):
      ensure_hardware_name(value_name, #'dpi_register)
      when result_names.filter(
        ~keep: fun (candidate): candidate == value_name
      ).length() != 1
      | fail(#'dpi_register, "DPI register result names must be unique")
      ensure_unique_hardware_name(module_def, value_name, #'dpi_register)
    def operation_id = design.fresh_id()
    def result_values:
      for List (result in dpi_import.results,
                value_name in result_names):
        Value(design.fresh_id(),
              value_name,
              result.type,
              module_def,
              operation_id)
    def operation = Operation(operation_id,
                              "sim.dpi_register",
                              module_def,
                              operands,
                              result_values,
                              [],
                              {"dpi_import": dpi_import, "name": result_names[0]},
                              location,
                              origin)
    for (operand in operands):
      operand.add_user(operation_id)
    for (result in result_values):
      module_def.add_value(result)
    module_def.add_operation(operation)
    result_values

  method module(name :: AsciiIdentifier):
    ensure_hardware_name(name, #'module)
    when design.find_module_named(name)
    | fail(#'module, "duplicate module name " ++ name)
    def module_def = Module(design, design.fresh_id(), name)
    design.add_module(module_def)
    module_def

  // Allocates a stable name from a suggested base without weakening the IR's
  // invariant that every final instance name is unique within its parent.
  method fresh_instance_name(module_def :: Module,
                             base_name :: AsciiIdentifier):
    ensure_module_in_design(design, module_def, #'fresh_instance_name)
    ensure_open(module_def, #'fresh_instance_name)
    ensure_hardware_name(base_name, #'fresh_instance_name)
    fun find_available(suffix :: Nat):
      def candidate:
        if suffix == 0
        | base_name
        | base_name ++ "_" ++ to_string(suffix)
      if instance_name_used(module_def, candidate)
      | find_available(suffix + 1)
      | candidate
    find_available(0)

  method input(module_def :: Module,
               name :: AsciiIdentifier,
               type :~ HardwareType,
               location :: Location = Location(),
               origin :: Origin = Origin("input", name)):
    ensure_module_in_design(design, module_def, #'input)
    ensure_open(module_def, #'input)
    ensure_hardware_name(name, #'input)
    ensure_hardware_type(type, #'input)
    ensure_unique_hardware_name(module_def, name, #'input)
    def operation_id = design.fresh_id()
    def value = Value(design.fresh_id(), name, type, module_def, operation_id)
    def operation = Operation(operation_id,
                              "rtl.input_port",
                              module_def,
                              [],
                              [value],
                              [],
                              {"name": name},
                              location,
                              origin)
    module_def.add_value(value)
    module_def.add_operation(operation)
    module_def.add_input(Port(name, "input", type, value, #false))
    value

  method output(module_def :: Module,
                name :: AsciiIdentifier,
                type :~ HardwareType,
                location :: Location = Location(),
                origin :: Origin = Origin("output", name)):
    ensure_module_in_design(design, module_def, #'output)
    ensure_open(module_def, #'output)
    ensure_hardware_name(name, #'output)
    ensure_hardware_type(type, #'output)
    ensure_unique_hardware_name(module_def, name, #'output)
    def operation_id = design.fresh_id()
    def place = Place(design.fresh_id(), name, type, module_def, operation_id)
    def operation = Operation(operation_id,
                              "rtl.output_port",
                              module_def,
                              [],
                              [],
                              [place],
                              {"name": name},
                              location,
                              origin)
    module_def.add_place(place)
    module_def.add_operation(operation)
    module_def.add_output(Port(name, "output", type, #false, place))
    place

  // Creates a declaration-order-independent single-driver connection. The
  // place accepts its driver while the paired value can be consumed earlier;
  // verification still requires one complete effective driver.
  method wire(module_def :: Module,
              name :: AsciiIdentifier,
              type :~ HardwareType,
              location :: Location = Location(),
              origin :: Origin = Origin("wire", name)):
    ensure_module_in_design(design, module_def, #'wire)
    ensure_open(module_def, #'wire)
    ensure_hardware_name(name, #'wire)
    ensure_hardware_type(type, #'wire)
    ensure_unique_hardware_name(module_def, name, #'wire)
    def operation_id = design.fresh_id()
    def place = Place(design.fresh_id(), name, type, module_def, operation_id)
    def value = Value(design.fresh_id(), name, type, module_def, operation_id)
    def operation = Operation(operation_id,
                              "rtl.wire",
                              module_def,
                              [],
                              [value],
                              [place],
                              {"name": name},
                              location,
                              origin)
    module_def.add_place(place)
    module_def.add_value(value)
    module_def.add_operation(operation)
    place

  method constant(module_def :: Module,
                  type :: HardwareType,
                  integer :: Nat,
                  name :: False || AsciiIdentifier = #false,
                  location :: Location = Location(),
                  origin :: Origin = Origin("constant")):
    ensure_module_in_design(design, module_def, #'constant)
    ensure_open(module_def, #'constant)
    ensure_bits(type, #'constant)
    unless bits.length(integer) <= type.width
    | fail(#'constant,
           "constant " ++ to_string(integer) ++ " does not fit " ++ type.describe())
    def operation_id = design.fresh_id()
    def value_name = name || "v" ++ to_string(operation_id)
    ensure_hardware_name(value_name, #'constant)
    ensure_unique_hardware_name(module_def, value_name, #'constant)
    def value = Value(design.fresh_id(), value_name, type, module_def, operation_id)
    def operation = Operation(operation_id,
                              "rtl.constant",
                              module_def,
                              [],
                              [value],
                              [],
                              {"value": integer, "name": value_name},
                              location,
                              origin)
    module_def.add_value(value)
    module_def.add_operation(operation)
    value

  // A don't-care is synthesis freedom, not a runtime four-state value.
  method dont_care(module_def :: Module,
                   type :: HardwareType,
                   name :: False || AsciiIdentifier = #false,
                   location :: Location = Location(),
                   origin :: Origin = Origin("don't care")):
    ensure_module_in_design(design, module_def, #'dont_care)
    ensure_open(module_def, #'dont_care)
    ensure_bits(type, #'dont_care)
    build_value_operation(design,
                          module_def,
                          "rtl.dont_care",
                          [],
                          type,
                          name,
                          location,
                          origin,
                          #'dont_care)

  // A decode preserves an incompletely specified relation for backend
  // synthesis instead of choosing concrete values for uncared output bits.
  method decode(module_def :: Module,
                selector :: Value,
                input_type :: DataType,
                result_type :: DataType,
                cases :: List.of(List),
                default_value :: Nat,
                default_care :: Nat,
                name :: False || AsciiIdentifier = #false,
                location :: Location = Location(),
                origin :: Origin = Origin("decode")):
    ensure_module_in_design(design, module_def, #'decode)
    ensure_open(module_def, #'decode)
    ensure_value_in(module_def, selector, #'decode)
    ensure_packable_data_type(input_type, #'decode)
    unless type_equal(selector.type, input_type)
    | fail(#'decode, "decode selector has the wrong DataType")
    ensure_packable_data_type(result_type, #'decode)
    def input_width = input_type.packed_width()
    def output_width = result_type.packed_width()
    def normalized_default = normalize_decode_pattern(default_value,
                                                      default_care,
                                                      output_width,
                                                      #'decode,
                                                      "decode default")
    def normalized_cases:
      for List (case in cases, index in 0..cases.length()):
        unless case.length() == 4
        | fail(#'decode,
               String.append("decode case ", to_string(index),
                             " must be [input value, input care, output value, output care]"))
        def input_pattern = normalize_decode_pattern(case[0],
                                                     case[1],
                                                     input_width,
                                                     #'decode,
                                                     "decode case " ++ to_string(index) ++ " input")
        def output_pattern = normalize_decode_pattern(case[2],
                                                      case[3],
                                                      output_width,
                                                      #'decode,
                                                      "decode case " ++ to_string(index) ++ " output")
        input_pattern ++ output_pattern
    for (left_index in 0..normalized_cases.length()):
      for (right_index in (left_index + 1)..normalized_cases.length()):
        when decode_patterns_overlap(normalized_cases[left_index],
                                     normalized_cases[right_index])
        | fail(#'decode,
               String.append("decode cases ", to_string(left_index), " and ",
                             to_string(right_index), " overlap"))
    build_value_operation(design,
                          module_def,
                          "rtl.decode",
                          [selector],
                          result_type,
                          name,
                          location,
                          origin,
                          #'decode,
                          {"cases": normalized_cases,
                           "default_value": normalized_default[0],
                           "default_care": normalized_default[1]})

