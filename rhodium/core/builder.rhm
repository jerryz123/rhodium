  method cast(module_def :: Module,
              value :: Value,
              target_type :: HardwareType,
              name :: False || AsciiIdentifier = #false,
              location :: Location = Location(),
              origin :: Origin = Origin("cast")):
    ensure_module_in_design(design, module_def, #'cast)
    ensure_open(module_def, #'cast)
    ensure_value_in(module_def, value, #'cast)
    ensure_hardware_type(target_type, #'cast)
    unless cast_compatible(value.type, target_type)
    | fail(#'cast,
           "cast requires source and target types with the same canonical packed width")
    build_value_operation(design,
                          module_def,
                          "rtl.cast",
                          [value],
                          target_type,
                          name,
                          location,
                          origin,
                          #'cast)

  method concat(module_def :: Module,
                operands :: List.of(Value),
                name :: False || AsciiIdentifier = #false,
                location :: Location = Location(),
                origin :: Origin = Origin("concat")):
    ensure_module_in_design(design, module_def, #'concat)
    ensure_open(module_def, #'concat)
    unless operands.length() >= 2
    | fail(#'concat, "concat requires at least two operands")
    def mutable result_width = 0
    for (value in operands):
      ensure_value_in(module_def, value, #'concat)
      unless bits_type(value.type)
      | fail(#'concat, "concat operands must have Bits types")
      result_width := result_width + value.type.width
    build_value_operation(design,
                          module_def,
                          "rtl.concat",
                          operands,
                          Bits(result_width),
                          name,
                          location,
                          origin,
                          #'concat)

  method extract(module_def :: Module,
                 value :: Value,
                 high :: Nat,
                 low :: Nat,
                 name :: False || AsciiIdentifier = #false,
                 location :: Location = Location(),
                 origin :: Origin = Origin("extract")):
    ensure_module_in_design(design, module_def, #'extract)
    ensure_open(module_def, #'extract)
    ensure_value_in(module_def, value, #'extract)
    unless bits_type(value.type)
    | fail(#'extract, "extract operand must have a Bits type")
    unless low <= high && high < value.type.width
    | fail(#'extract,
           "extract indices must satisfy 0 <= low <= high < source width")
    build_value_operation(design,
                          module_def,
                          "rtl.extract",
                          [value],
                          Bits(high - low + 1),
                          name,
                          location,
                          origin,
                          #'extract,
                          {"high": high, "low": low})

  method zext(module_def :: Module,
              value :: Value,
              target_width :: PosInt,
              name :: False || AsciiIdentifier = #false,
              location :: Location = Location(),
              origin :: Origin = Origin("zext")):
    ensure_module_in_design(design, module_def, #'zext)
    ensure_open(module_def, #'zext)
    ensure_value_in(module_def, value, #'zext)
    unless bits_type(value.type)
    | fail(#'zext, "zext operand must have a Bits type")
    unless target_width > value.type.width
    | fail(#'zext, "zext target width must be larger than the source width")
    build_value_operation(design,
                          module_def,
                          "rtl.zext",
                          [value],
                          Bits(target_width),
                          name,
                          location,
                          origin,
                          #'zext,
                          {"target_width": target_width})

  method sext(module_def :: Module,
              value :: Value,
              target_width :: PosInt,
              name :: False || AsciiIdentifier = #false,
              location :: Location = Location(),
              origin :: Origin = Origin("sext")):
    ensure_module_in_design(design, module_def, #'sext)
    ensure_open(module_def, #'sext)
    ensure_value_in(module_def, value, #'sext)
    unless signed_arithmetic_type(value.type)
    | fail(#'sext, "sext operand must have a SignedArithmeticType")
    unless target_width > scalar_width(value.type)
    | fail(#'sext, "sext target width must be larger than the source width")
    def result_type = value.type.with_bit_width(target_width)
    unless signed_arithmetic_type(result_type) && scalar_width(result_type) == target_width
    | fail(#'sext, "sext operand type must preserve its signed arithmetic type when widened")
    build_value_operation(design,
                          module_def,
                          "rtl.sext",
                          [value],
                          result_type,
                          name,
                          location,
                          origin,
                          #'sext,
                          {"target_width": target_width})

