#lang rhombus
// Defines public Rhodium hardware IR objects and their ownership relationships.
// SPDX-License-Identifier: Apache-2.0

import:
  "types.rhm" open

export:
  all_from("types.rhm")
  Location
  Origin
  HardwareEntity
  Value
  Place
  Operation
  DpiResult
  DpiImport
  Memory
  SyncMemoryReadPort
  SyncMemoryWritePort
  SyncMemoryReadWritePort
  SyncMemory
  memory_address_width
  Port
  Register
  Instance
  ModuleMetadataPayload
  ModuleMetadata
  SemanticBinding
  SemanticDescription
  SemanticNode
  module_semantics
  Module
  Design
  DesignElaboration

class Location(path :: String = "<unknown>",
               line :: maybe(PosInt) = #false,
               column :: maybe(Nat) = #false):
  method describe():
    if line
    | path ++ ":" ++ to_string(line) ++ (if column | ":" ++ to_string(column) | "")
    | path

class Origin(kind :: String = "unknown",
             description :: String = "",
             parents :: List.of(Origin) = []):
  method describe():
    if description == ""
    | kind
    | kind ++ ": " ++ description

// Identifies core objects that participate directly in authored hardware.
// Frontend-only deferred values extend the same marker without coupling core
// to elaboration machinery.
interface HardwareEntity

class.together:
  class Value(id :: Nat,
              name :: String,
              type :: HardwareType,
              module_def :: Module,
              defining_op_id :: Nat,
              user_ids_seed :: List.of(Nat) = []):
    implements HardwareEntity
    // Trusted after checked seed ingress; add_user is the only mutation path.
    private field _user_ids :~ List.of(Nat) = user_ids_seed
    private field user_index_complete = user_ids_seed.length() == 0
    private field user_id_set = MutableSet{}

    property user_ids: _user_ids

    property module_id: module_def.id
    property design: module_def.design

    method add_user(operation_id :: Nat):
      design.assert_mutable()
      _user_ids := [operation_id] ++ _user_ids
      user_id_set.add(operation_id)

    method users():
      _user_ids

    method has_user(operation_id :: Nat):
      if user_index_complete
      | operation_id in user_id_set
      | operation_id in user_id_set || user_ids.find(
          fun (candidate): candidate == operation_id
        )

    method ref():
      "%" ++ name

  class Place(id :: maybe(Nat),
              name :: String,
              type :: HardwareType,
              module_def :: Module,
              owner_op_id :: Nat,
              driver_seed :: maybe(Value) = #false,
              parent :: maybe(Place) = #false,
              projection_key :: maybe(String || Nat) = #false,
              projected_places_seed :: List.of(Place) = []):
    implements HardwareEntity
    // Trusted after checked seed ingress; projection helpers preserve membership and order.
    private field _driver :~ maybe(Value) = driver_seed
    private field _projected_places :~ List.of(Place) = projected_places_seed
    property driver: _driver
    property projected_places: _projected_places

    property module_id: module_def.id
    property design: module_def.design

    method projected():
      parent is_a Place

    method projected_place(key :: String || Nat):
      _projected_places.find(
        fun (candidate): candidate.projection_key == key
      )

    method add_projected_place(projected :: Place):
      design.assert_mutable()
      _projected_places := _projected_places ++ [projected]

    method clear_projected_places():
      design.assert_mutable()
      _projected_places := []

    method replace_projected_places(projected :: List.of(Place)):
      design.assert_mutable()
      _projected_places := projected

    method set_driver(driver :: Value):
      design.assert_mutable()
      _driver := driver

    method ref():
      "&" ++ name

  class Operation(id :: Nat,
                  opcode :: String,
                  module_def :: Module,
                  operands :: List.of(Value) = [],
                  results :: List.of(Value) = [],
                  places :: List.of(Place) = [],
                  attributes :: Map = {},
                  location :: Location = Location(),
                  origin :: Origin = Origin()):
    implements HardwareEntity
    property module_id: module_def.id
    property design: module_def.design

    method attribute(name :: String,
                     default :: maybe(String || List) = #false):
      attributes.get(name, default)

  // Keeps ABI-relevant result direction distinct from ordinary hardware type:
  // output arguments and the C return are separate DPI declaration forms even
  // though both become clocked SSA results at a call site.
  class DpiResult(name :: String, type :: ScalarDataType, direction :: String)

  // DPI imports are design-owned simulation declarations. Calls reference them
  // from modules, but the declarations themselves are not module operations.
  class DpiImport(id :: Nat,
                  name :: String,
                  input_names :: List.of(String),
                  input_types :: List.of(ScalarDataType),
                  results :: List.of(DpiResult),
                  design :: Design,
                  location :: Location = Location()):
    method has_result():
      results.length() != 0

    method return_result():
      results.find(fun (result): result.direction == "return")

    method ref():
      "@" ++ name

  // Memories are stateful module-owned resources rather than hardware Values:
  // they cannot cross ports, participate in muxes, or occupy registers.
  class Memory(id :: Nat,
               name :: String,
               depth :: PosInt,
               element_type :: DataType,
               module_def :: Module,
               defining_op_id :: Nat):
    implements HardwareEntity
    property module_id: module_def.id
    property design: module_def.design

    method ref():
      "@" ++ name

  // A synchronous memory is circuit-shaped: its fixed input places and output
  // values are created together instead of being inferred from later accesses.
  class SyncMemoryReadPort(address :: Place, enable :: Place, data :: Value)
  class SyncMemoryWritePort(address :: Place,
                            data :: Place,
                            enable :: Place,
                            mask :: maybe(Place) = #false)
  class SyncMemoryReadWritePort(address :: Place,
                                enable :: Place,
                                write :: Place,
                                write_data :: Place,
                                read_data :: Value,
                                write_mask :: maybe(Place) = #false)
  class SyncMemory(operation :: Operation,
                   name :: String,
                   depth :: PosInt,
                   element_type :: DataType,
                   clock :: Value,
                   read_ports :: List.of(SyncMemoryReadPort) = [],
                   write_ports :: List.of(SyncMemoryWritePort) = [],
                   read_write_ports :: List.of(SyncMemoryReadWritePort) = [],
                   mask_granularity :: maybe(PosInt) = #false):
    property read_port:
      if read_ports.length() == 0 | #false | read_ports[0]
    property write_port:
      if write_ports.length() == 0 | #false | write_ports[0]
    property read_write_port:
      if read_write_ports.length() == 0 | #false | read_write_ports[0]

  class Port(name :: String,
             direction :: String,
             type :: HardwareType,
             value :: maybe(Value) = #false,
             place :: maybe(Place) = #false):
    implements HardwareEntity

  class Register(operation :: Operation, current :: Value, next :: Place):
    implements HardwareEntity

  class Instance(operation :: Operation,
                 module_def :: Module,
                 input_bindings :: List.of(Port),
                 output_bindings :: List.of(Port)):
    implements HardwareEntity
    method input(name :: String):
      def binding = input_bindings.find(
        fun (candidate): candidate.name == name
      )
      unless binding
      | error(~who: #'input,
              "instance has no input named " ++ name)
      binding.place

    method output(name :: String):
      def binding = output_bindings.find(
        fun (candidate): candidate.name == name
      )
      unless binding
      | error(~who: #'output,
              "instance has no output named " ++ name)
      binding.value

  // Attaches extension-owned, nonsemantic inspection data to a finished design
  // without turning the described abstraction into a hardware operation.
  interface ModuleMetadataPayload

  class ModuleMetadata(namespace :: String, payload :: ModuleMetadataPayload)

  // A field path retains aggregate typing without creating projection hardware.
  class SemanticBinding(name :: String,
                        entity :: Value || Place,
                        path :: List.of(String || Nat) = [])

  // Extension-owned documentation; a kind alone never authorizes substitution.
  class SemanticDescription(bindings :: List.of(SemanticBinding) = [],
                            properties :: Map = {},
                            references :: List.of(Operation) = [])

  // Nested expansion provenance over the same executable hardware graph.
  class SemanticNode(module_def :: Module,
                     kind :: String,
                     description :: SemanticDescription,
                     operations :: List.of(Operation) = [],
                     children :: List.of(SemanticNode) = []):
    implements ModuleMetadataPayload

  class Module(design :: Design,
               id :: Nat,
               name :: String,
               operations_seed :: List.of(Operation) = [],
               inputs_seed :: List.of(Port) = [],
               outputs_seed :: List.of(Port) = [],
               values_seed :: List.of(Value) = [],
               places_seed :: List.of(Place) = [],
               memories_seed :: List.of(Memory) = [],
               metadata_seed :: List.of(ModuleMetadata) = [],
               finished_seed :: Boolean = #false):
    // Trusted after checked seed ingress; mutation is seal-aware and method-owned.
    private field _operations :~ List.of(Operation) = operations_seed
    private field _inputs :~ List.of(Port) = inputs_seed
    private field _outputs :~ List.of(Port) = outputs_seed
    private field _values :~ List.of(Value) = values_seed
    private field _places :~ List.of(Place) = places_seed
    private field _memories :~ List.of(Memory) = memories_seed
    private field _metadata :~ List.of(ModuleMetadata) = metadata_seed
    private field _finished :~ Boolean = finished_seed
    private field collections_finished = operations_seed.length() != 0 || inputs_seed.length() != 0 || outputs_seed.length() != 0 || values_seed.length() != 0 || places_seed.length() != 0 || memories_seed.length() != 0
    private field indexes_complete = operations_seed.length() == 0 && inputs_seed.length() == 0 && outputs_seed.length() == 0 && values_seed.length() == 0 && places_seed.length() == 0 && memories_seed.length() == 0
    private field operations_by_id = MutableMap{}
    private field operation_set = MutableSet.by(===){}
    private field values_by_id = MutableMap{}
    private field value_set = MutableSet.by(===){}
    private field places_by_id = MutableMap{}
    private field place_set = MutableSet.by(===){}
    private field memories_by_id = MutableMap{}
    private field memory_set = MutableSet.by(===){}
    private field inputs_by_name = MutableMap{}
    private field outputs_by_name = MutableMap{}
    private field instances_by_name = MutableMap{}
    private field drives_by_place_id = MutableMap{}
    private field hardware_names = MutableSet{}
    private field memory_write_clocks = MutableMap.by(===){}
    private field memory_write_clock_consistency = MutableMap.by(===){}
    private field sync_crossing_use_counts = MutableMap.by(===){}

    property operations: _operations
    property inputs: _inputs
    property outputs: _outputs
    property values: _values
    property places: _places
    property memories: _memories
    property metadata: _metadata
    property finished: _finished

    method add_operation(operation :: Operation):
      design.assert_mutable()
      unless operation.module_def === this
      | error(~who: #'add_operation, "operation belongs to a different module")
      _operations := if collections_finished | _operations ++ [operation] | [operation] ++ _operations
      unless operations_by_id.has_key(operation.id)
      | operations_by_id[operation.id] := operation
      operation_set.add(operation)
      when operation.opcode == "rtl.instance"
      | def instance_name = operation.attribute("name", #false)
        unless instances_by_name.has_key(instance_name)
        | instances_by_name[instance_name] := operation
      when operation.opcode == "rtl.drive" && operation.places.length() == 1
      | def place_id = operation.places[0].id
        unless drives_by_place_id.has_key(place_id)
        | drives_by_place_id[place_id] := operation
      when operation.opcode == "rtl.sync_memory"
      | hardware_names.add(operation.attribute("name", #false))
      when operation.opcode == "rtl.memory_write" && operation.operands.length() >= 3
      | def memory = operation.attribute("memory", #false)
        def clock = operation.operands[2]
        def prior_clock = memory_write_clocks.get(memory, #false)
        when prior_clock && !(prior_clock === clock)
        | memory_write_clock_consistency[memory] := #false
        unless prior_clock
        | memory_write_clocks[memory] := clock
          memory_write_clock_consistency[memory] := #true
      when operation.opcode == "cdc.sync_level"
      | for (stage in operation.operands.drop(2)):
          sync_crossing_use_counts[stage] := sync_crossing_use_counts.get(stage, 0) + 1

    method add_value(value :: Value):
      design.assert_mutable()
      unless value.module_def === this
      | error(~who: #'add_value, "value belongs to a different module")
      _values := if collections_finished | _values ++ [value] | [value] ++ _values
      unless values_by_id.has_key(value.id)
      | values_by_id[value.id] := value
      value_set.add(value)
      hardware_names.add(value.name)

    method add_place(place :: Place):
      design.assert_mutable()
      unless place.module_def === this
      | error(~who: #'add_place, "place belongs to a different module")
      _places := if collections_finished | _places ++ [place] | [place] ++ _places
      unless places_by_id.has_key(place.id)
      | places_by_id[place.id] := place
      place_set.add(place)
      hardware_names.add(place.name)

    method add_memory(memory :: Memory):
      design.assert_mutable()
      unless memory.module_def === this
      | error(~who: #'add_memory, "memory belongs to a different module")
      _memories := if collections_finished | _memories ++ [memory] | [memory] ++ _memories
      unless memories_by_id.has_key(memory.id)
      | memories_by_id[memory.id] := memory
      memory_set.add(memory)
      hardware_names.add(memory.name)

    method add_metadata(namespace :: String, payload :: ModuleMetadataPayload):
      design.assert_mutable()
      when _finished
      | error(~who: #'add_metadata,
              "cannot attach metadata to finished module " ++ name)
      def entry = ModuleMetadata(namespace, payload)
      _metadata := _metadata ++ [entry]
      entry

    method metadata_for(namespace :: String):
      _metadata.filter(
        ~keep: fun (entry): entry.namespace == namespace
      ).map(fun (entry): entry.payload)

    method add_input(port :: Port):
      design.assert_mutable()
      _inputs := if collections_finished | _inputs ++ [port] | [port] ++ _inputs
      unless inputs_by_name.has_key(port.name)
      | inputs_by_name[port.name] := port

    method add_output(port :: Port):
      design.assert_mutable()
      _outputs := if collections_finished | _outputs ++ [port] | [port] ++ _outputs
      unless outputs_by_name.has_key(port.name)
      | outputs_by_name[port.name] := port

    method finish_collections():
      unless collections_finished
      | _operations := _operations.reverse()
        _inputs := _inputs.reverse()
        _outputs := _outputs.reverse()
        _values := _values.reverse()
        _places := _places.reverse()
        _memories := _memories.reverse()
        collections_finished := #true

    method mark_finished():
      design.assert_mutable()
      _finished := #true

    method find_operation(id :: Nat):
      if indexes_complete | operations_by_id.get(id, #false) | operations_by_id.get(id, #false) || _operations.find(fun (operation): operation.id == id)

    method find_value(id :: Nat):
      if indexes_complete | values_by_id.get(id, #false) | values_by_id.get(id, #false) || _values.find(fun (value): value.id == id)

    method find_place(id :: Nat):
      if indexes_complete | places_by_id.get(id, #false) | places_by_id.get(id, #false) || _places.find(fun (place): place.id == id)

    method find_memory(id :: Nat):
      if indexes_complete | memories_by_id.get(id, #false) | memories_by_id.get(id, #false) || _memories.find(fun (memory): memory.id == id)

    method find_input(name :: String):
      if indexes_complete | inputs_by_name.get(name, #false) | inputs_by_name.get(name, #false) || _inputs.find(fun (port): port.name == name)

    method find_output(name :: String):
      if indexes_complete | outputs_by_name.get(name, #false) | outputs_by_name.get(name, #false) || _outputs.find(fun (port): port.name == name)

    method find_instance(name :: String):
      if indexes_complete
      | instances_by_name.get(name, #false)
      | instances_by_name.get(name, #false) || _operations.find(
          fun (operation): operation.opcode == "rtl.instance" && operation.attribute("name", #false) == name
        )

    method find_drive_to(place_id :: Nat):
      if indexes_complete
      | drives_by_place_id.get(place_id, #false)
      | drives_by_place_id.get(place_id, #false) || _operations.find(
          fun (operation): operation.opcode == "rtl.drive" && operation.places.length() == 1 && operation.places[0].id == place_id
        )

    method hardware_name_used(name :: String):
      if indexes_complete
      | name in hardware_names
      | name in hardware_names || _values.find(fun (value): value.name == name) || _places.find(fun (place): place.name == name) || _memories.find(fun (memory): memory.name == name) || _operations.find(
          fun (operation): operation.opcode == "rtl.sync_memory" && operation.attribute("name", #false) == name
        )

    method memory_write_clock_consistent(memory :: Memory):
      if indexes_complete || memory_write_clocks.has_key(memory)
      | memory_write_clock_consistency.get(memory, #true)
      | block:
          def writes = _operations.filter(
            ~keep: fun (operation): operation.opcode == "rtl.memory_write" && operation.attribute("memory", #false) === memory
          )
          writes.length() < 2 || (for all (write in writes): write.operands[2] === writes[0].operands[2])

    method sync_crossing_use_count(stage :: Value):
      if indexes_complete || sync_crossing_use_counts.has_key(stage)
      | sync_crossing_use_counts.get(stage, 0)
      | _operations.filter(
          ~keep: fun (operation): operation.opcode == "cdc.sync_level" && operation.operands.drop(2).find(fun (candidate): candidate === stage)
        ).length()

    method owns_operation(operation :: Operation):
      if indexes_complete | operation in operation_set | operation in operation_set || _operations.find(fun (candidate): candidate === operation)

    method owns_value(value :: Value):
      if indexes_complete | value in value_set | value in value_set || _values.find(fun (candidate): candidate === value)

    method owns_place(place :: Place):
      if indexes_complete | place in place_set | place in place_set || _places.find(fun (candidate): candidate === place)

    method owns_memory(memory :: Memory):
      if indexes_complete | memory in memory_set | memory in memory_set || _memories.find(fun (candidate): candidate === memory)

    method walk():
      _operations

  class Design(modules_seed :: List.of(Module) = [],
               mutable next_id :: Nat = 0,
               dpi_imports_seed :: List.of(DpiImport) = []):
    // Trusted after checked seed ingress; semantic mutation is seal-aware and method-owned.
    private field _modules :~ List.of(Module) = modules_seed
    private field _dpi_imports :~ List.of(DpiImport) = dpi_imports_seed
    private field collections_finished = modules_seed.length() != 0 || dpi_imports_seed.length() != 0
    private field indexes_complete = modules_seed.length() == 0 && dpi_imports_seed.length() == 0
    private field modules_by_id = MutableMap{}
    private field module_set = MutableSet.by(===){}
    private field modules_by_name = MutableMap{}
    private field dpi_imports_by_name = MutableMap{}
    private field dpi_import_set = MutableSet.by(===){}
    private field _sealed = #false

    property modules: _modules
    property dpi_imports: _dpi_imports
    property sealed: _sealed

    method assert_mutable():
      when _sealed
      | error(~who: #'Design, "cannot mutate a sealed design")

    method seal():
      _sealed := #true

    method fresh_id():
      def id = next_id
      next_id := next_id + 1
      id

    method add_module(module_def :: Module):
      assert_mutable()
      unless module_def.design === this
      | error(~who: #'add_module, "module belongs to a different design")
      _modules := if collections_finished | _modules ++ [module_def] | [module_def] ++ _modules
      unless modules_by_id.has_key(module_def.id)
      | modules_by_id[module_def.id] := module_def
      module_set.add(module_def)
      unless modules_by_name.has_key(module_def.name)
      | modules_by_name[module_def.name] := module_def

    method add_dpi_import(dpi_import :: DpiImport):
      assert_mutable()
      unless dpi_import.design === this
      | error(~who: #'add_dpi_import, "DPI import belongs to a different design")
      _dpi_imports := if collections_finished | _dpi_imports ++ [dpi_import] | [dpi_import] ++ _dpi_imports
      unless dpi_imports_by_name.has_key(dpi_import.name)
      | dpi_imports_by_name[dpi_import.name] := dpi_import
      dpi_import_set.add(dpi_import)

    method finish_collections():
      unless collections_finished
      | _modules := _modules.reverse()
        _dpi_imports := _dpi_imports.reverse()
        collections_finished := #true

    method find_dpi_import(name :: String):
      if indexes_complete | dpi_imports_by_name.get(name, #false) | dpi_imports_by_name.get(name, #false) || _dpi_imports.find(fun (dpi_import): dpi_import.name == name)

    method find_module(id :: Nat):
      if indexes_complete | modules_by_id.get(id, #false) | modules_by_id.get(id, #false) || _modules.find(fun (module_def): module_def.id == id)

    method find_module_named(name :: String):
      if indexes_complete | modules_by_name.get(name, #false) | modules_by_name.get(name, #false) || _modules.find(fun (module_def): module_def.name == name)

    method owns_module(module_def :: Module):
      if indexes_complete | module_def in module_set | module_def in module_set || _modules.find(fun (candidate): candidate === module_def)

    method owns_dpi_import(dpi_import :: DpiImport):
      if indexes_complete | dpi_import in dpi_import_set | dpi_import in dpi_import_set || _dpi_imports.find(fun (candidate): candidate === dpi_import)

    method walk():
      def all_operations = MutableList[]
      for (module_def in _modules):
        all_operations.append(module_def.operations)
      all_operations.snapshot()
// Keeps address typing deterministic for arbitrary positive depths. Dynamic
// encodings greater than or equal to depth have unspecified hardware behavior.
fun memory_address_width(depth :: PosInt) :: PosInt:
  count_index_width(depth)

// Semantic roots are module-local; instances retain ordinary hierarchy.
fun module_semantics(module_def :: Module):
  module_def.metadata_for("rhodium.semantics")

class DesignElaboration(design :: Design, top :: Module):
  constructor (design :: Design, top :: Module):
    design.finish_collections()
    def valid_top = top.design === design && top.finished && design.modules.find(fun (candidate): candidate === top)
    unless valid_top
    | error(~who: #'DesignElaboration,
            "top must be a finished module owned by the elaborated design")
    super(design, top)
