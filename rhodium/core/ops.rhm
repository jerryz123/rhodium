#lang rhombus
// Registers namespaced Rhodium operations and their structural and behavioral schemas.
// SPDX-License-Identifier: Apache-2.0

export:
  OperationSchema
  schemas
  schema_for
  combinational_opcode

class OperationSchema(opcode :: String,
                      kind :: String,
                      operand_count :: False || Nat,
                      result_count :: False || Nat,
                      place_count :: False || Nat,
                      required_attributes :: List.of(String),
                      type_rule :: String,
                      print_form :: String)

def schemas:
  [OperationSchema("rtl.input_port", "structural", 0, 1, 0,
                   ["name"], "hardware_input_port", "input_port"),
   OperationSchema("rtl.output_port", "structural", 0, 0, 1,
                   ["name"], "hardware_output_port", "output_port"),
   OperationSchema("rtl.wire", "structural", 0, 1, 1,
                   ["name"], "hardware_wire", "wire"),
   OperationSchema("rtl.constant", "combinational", 0, 1, 0,
                   ["value", "name"], "bits_constant", "constant"),
   OperationSchema("rtl.dont_care", "combinational", 0, 1, 0,
                   ["name"], "bits_dont_care", "dont_care"),
   OperationSchema("rtl.decode", "combinational", 1, 1, 0,
                   ["cases", "default_value", "default_care", "name"],
                   "data_decode", "decode"),
   OperationSchema("rtl.not", "combinational", 1, 1, 0,
                   ["name"], "bitwise_same_type_unary", "value"),
   OperationSchema("rtl.and", "combinational", 2, 1, 0,
                   ["name"], "bitwise_same_type_binary", "value"),
   OperationSchema("rtl.or", "combinational", 2, 1, 0,
                   ["name"], "bitwise_same_type_binary", "value"),
   OperationSchema("rtl.xor", "combinational", 2, 1, 0,
                   ["name"], "bitwise_same_type_binary", "value"),
   OperationSchema("rtl.add", "combinational", 2, 1, 0,
                   ["name"], "arithmetic_same_type_binary", "value"),
   OperationSchema("rtl.mul", "combinational", 2, 1, 0,
                   ["name"], "arithmetic_same_type_binary", "value"),
   OperationSchema("rtl.sub", "combinational", 2, 1, 0,
                   ["name"], "arithmetic_same_type_binary", "value"),
   OperationSchema("rtl.shl", "combinational", 2, 1, 0,
                   ["name"], "arithmetic_shift", "value"),
   OperationSchema("rtl.shru", "combinational", 2, 1, 0,
                   ["name"], "bits_shift", "value"),
   OperationSchema("rtl.shrs", "combinational", 2, 1, 0,
                   ["name"], "signed_arithmetic_shift", "value"),
   OperationSchema("rtl.eq", "combinational", 2, 1, 0,
                   ["name"], "bits_same_width_compare", "value"),
   OperationSchema("rtl.ult", "combinational", 2, 1, 0,
                   ["name"], "bits_same_width_compare", "value"),
   OperationSchema("rtl.slt", "combinational", 2, 1, 0,
                   ["name"], "signed_arithmetic_compare", "value"),
   OperationSchema("rtl.mux_lookup", "combinational", #false, 1, 0,
                   ["keys", "name"], "data_mux_lookup", "mux_lookup"),
   OperationSchema("rtl.onehot_mux", "combinational", #false, 1, 0,
                   ["name"], "onehot_mux", "onehot_mux"),
   OperationSchema("rtl.cast", "combinational", 1, 1, 0,
                   ["name"], "packed_cast", "cast"),
   OperationSchema("rtl.concat", "combinational", #false, 1, 0,
                   ["name"], "bits_concat", "value"),
   OperationSchema("rtl.extract", "combinational", 1, 1, 0,
                   ["high", "low", "name"], "bits_extract", "extract"),
   OperationSchema("rtl.zext", "combinational", 1, 1, 0,
                   ["target_width", "name"], "bits_zext", "resize"),
   OperationSchema("rtl.sext", "combinational", 1, 1, 0,
                   ["target_width", "name"], "signed_arithmetic_sext", "resize"),
   OperationSchema("rtl.trunc", "combinational", 1, 1, 0,
                   ["target_width", "name"], "bits_trunc", "resize"),
   OperationSchema("rtl.record_create", "combinational", #false, 1, 0,
                   ["fields", "name"], "record_create", "record_create"),
   OperationSchema("rtl.record_get", "combinational", 1, 1, 0,
                   ["field", "name"], "record_get", "record_get"),
   OperationSchema("rtl.vector_create", "combinational", #false, 1, 0,
                   ["name"], "vector_create", "vector_create"),
   OperationSchema("rtl.vector_get", "combinational", 1, 1, 0,
                   ["index", "name"], "vector_get", "vector_get"),
   OperationSchema("rtl.vector_index", "combinational", 2, 1, 0,
                   ["name"], "vector_index", "vector_index"),
   OperationSchema("rtl.vector_inject", "combinational", 3, 1, 0,
                   ["name"], "vector_inject", "vector_inject"),
   OperationSchema("rtl.vector_write_set", "combinational", 4, 1, 0,
                   ["name"], "vector_write_set", "vector_write_set"),
   OperationSchema("rtl.memory", "sequential", 0, 0, 0,
                   ["memory", "name", "depth", "element_type"], "memory", "memory"),
   OperationSchema("rtl.memory_read_async", "combinational", 1, 1, 0,
                   ["memory", "name"], "memory_read_async", "memory_read_async"),
   OperationSchema("rtl.memory_write", "sequential", 4, 0, 0,
                   ["memory"], "memory_write", "memory_write"),
   OperationSchema("rtl.sync_memory", "sequential", 1, #false, #false,
                   ["name", "depth", "element_type", "has_read", "has_write", "has_read_write", "mask_granularity"],
                   "sync_memory", "sync_memory"),
   OperationSchema("verif.assert", "verification", 4, 0, 0,
                   ["label"], "clocked_assert", "assert"),
   OperationSchema("sim.dpi_call", "sequential", #false, 0, 0,
                   ["dpi_import"], "dpi_call", "dpi_call"),
   OperationSchema("sim.dpi_register", "sequential", #false, #false, 0,
                   ["dpi_import", "name"], "dpi_register", "dpi_register"),
   OperationSchema("rtl.register", "sequential", 1, 1, 1,
                   ["name"], "data_register", "register"),
   OperationSchema("rtl.register_reset", "sequential", 3, 1, 1,
                   ["name"], "data_register_reset", "register_reset"),
   OperationSchema("cdc.sync_level", "metadata", #false, 0, 0,
                   ["promise"], "sync_level_crossing", "sync_level"),
   OperationSchema("rtl.instance", "structural", #false, #false, #false,
                   ["name", "module"], "instance", "instance"),
   OperationSchema("rtl.drive", "structural", 1, 0, 1,
                   [], "type_equal_drive", "drive")]

fun schema_for(opcode :: String):
  schemas.find(fun (schema): schema.opcode == opcode)

fun combinational_opcode(opcode :: String):
  def schema = schema_for(opcode)
  schema && schema.kind == "combinational"
