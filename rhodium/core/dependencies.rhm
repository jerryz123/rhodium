#lang rhombus
// Defines shared leaf-sensitive value dependency semantics and cycle analysis.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus.bits.(<<) as <<
  "types.rhm" open
  "ir.rhm" open
  "ops.rhm" open

export:
  InputLeaf
  ValueLeaf
  ValueDependencySummary
  OutputLeafDependency
  ModuleDependencySummary
  identity_index
  leaf_paths
  describe_value_path
  place_at_path
  place_leaf_driver
  direct_operation_dependencies
  direct_value_dependencies
  verify_combinational_cycles

class InputLeaf(input_index :: Nat, path :: List.of(String || Nat))
class ValueLeaf(value :: Value, path :: List.of(String || Nat))
class ValueDependencySummary(value :: Value,
                             path :: List.of(String || Nat),
                             input_leaves :: List.of(InputLeaf))
class IndexedValueLeaf(value :: Value, leaf_index :: Nat)
class LeafLayout(paths :: List.of(List.of(String || Nat)),
                 indices_by_path :: MutableMap)
class ValueDependencyState(layout :: LeafLayout,
                           summaries :: MutableList,
                           active_indices :: MutableList)
class OutputLeafDependency(path :: List.of(String || Nat),
                           input_leaves :: List.of(InputLeaf))
class ModuleDependencySummary(
      module_def :: Module,
      output_leaf_dependencies :: List.of(List.of(OutputLeafDependency))):
  private field output_leaf_maps:
    for List (output_dependencies in output_leaf_dependencies):
      block:
        def leaves_by_path = MutableMap{}
        for (dependency in output_dependencies):
          leaves_by_path[dependency.path] := dependency
        leaves_by_path

  method find_output_leaf(output_index :: Nat,
                          path :: List.of(String || Nat)):
    output_leaf_maps[output_index].get(path, #false)

fun fail(message :: String):
  error(~who: #'verify, message)

fun fail_operation(operation :: Operation, message :: String):
  fail(operation.location.describe() ++ ": " ++ message)

fun identity_index(items :: List.of(Value), item :: Value):
  def mutable result = #false
  for (candidate in items,
       index in 0..items.length()):
    when !result && candidate === item
    | result := index
  result

fun equal_index(items :: List.of(String), item :: String):
  def mutable result = #false
  for (candidate in items,
       index in 0..items.length()):
    when !result && candidate == item
    | result := index
  result

fun leaf_paths(type :: HardwareType) :: List.of(List.of(String || Nat)):
  cond
  | record_type(type):
      def result = MutableList[]
      for (field in type.fields):
        for (path in leaf_paths(field.type)):
          result.add([field.name] ++ path)
      result.snapshot()
  | vector_type(type):
      def result = MutableList[]
      for (index in 0..type.length):
        for (path in leaf_paths(type.element_type)):
          result.add([index] ++ path)
      result.snapshot()
  | ~else:
      [[]]

fun describe_value_path(value :: Value,
                        path :: List.of(String || Nat)):
  def mutable result = value.name
  for (step in path):
    result := if step is_a String | result ++ "." ++ step | result ++ "[" ++ to_string(step) ++ "]"
  result

fun place_at_path(place :: Place,
                  path :: List.of(String || Nat)) :: maybe(Place):
  if path.length() == 0
  | place
  | block:
      def projected = place.projected_place(path[0])
      projected && place_at_path(projected, path.drop(1))

// Resolves one aggregate leaf of a Place to the Value leaf that drives it.
// A projected leaf has its own whole-value driver; otherwise the root driver
// is followed with the requested path.
fun place_leaf_driver(place :: Place,
                      path :: List.of(String || Nat)) :: ValueLeaf:
  def projected_place = place_at_path(place, path)
  if projected_place?.driver
  | ValueLeaf(projected_place!!.driver, [])
  | ValueLeaf(place.driver, path)

// Visits direct dependency leaves through one shared opcode dispatch. Public
// path-valued queries and the verifier's indexed walk supply their own sinks.
fun visit_present_operation_dependencies(
      value :: Value,
      path :: List.of(String || Nat),
      operation :: Operation,
      add_operand :: Function.of_arity(2),
      add_whole :: Function.of_arity(1)):
  use_static
  def opcode = operation.opcode
  def operands = operation.operands
  def places = operation.places
  cond
  | opcode == "rtl.wire":
      def driver = place_leaf_driver(places[0], path)
      add_operand(driver.value, driver.path)
      #true
  | combinational_opcode(opcode):
      cond
      | opcode == "rtl.record_create" && path.length() > 0:
          def field_index = equal_index(operation.attribute("fields"), path[0])
          add_operand(operands[field_index], path.drop(1))
      | opcode == "rtl.record_get":
          add_operand(operands[0],
                      [operation.attribute("field")] ++ path)
      | opcode == "rtl.vector_create" && path.length() > 0:
          add_operand(operands[path[0]], path.drop(1))
      | opcode == "rtl.vector_get":
          add_operand(operands[0],
                      [operation.attribute("index")] ++ path)
      | opcode == "rtl.vector_index":
          add_whole(operands[0])
          add_whole(operands[1])
      | opcode == "rtl.vector_inject" && path.length() > 0:
          add_operand(operands[0], path)
          add_whole(operands[1])
          add_operand(operands[2], path.drop(1))
      | opcode == "rtl.vector_write_set" && path.length() > 0:
          add_operand(operands[0], path)
          add_whole(operands[1])
          add_whole(operands[2])
          def ports_type :: VectorType = operands[3].type
          for (port_index in 0..ports_type.length):
            add_operand(operands[3],
                        [port_index] ++ path.drop(1))
      | opcode == "rtl.mux_lookup" || opcode == "rtl.onehot_mux":
          add_whole(operands[0])
          for (operand in operands.drop(1)):
            add_operand(operand, path)
      | opcode == "rtl.cast":
          add_whole(operands[0])
      | ~else:
          for (operand in operands):
            add_whole(operand)
      #true
  | ~else:
      #false

fun visit_direct_operation_dependencies(
      value :: Value,
      path :: List.of(String || Nat),
      operation :: maybe(Operation),
      add_operand :: Function.of_arity(2),
      add_whole :: Function.of_arity(1)):
  if operation is_a Operation
  | visit_present_operation_dependencies(value,
                                         path,
                                         operation,
                                         add_operand,
                                         add_whole)
  | #false

// Computes direct upstream leaves when the defining operation is already
// available, allowing analyses to reuse their own operation indexes.
fun direct_operation_dependencies(value :: Value,
                                  path :: List.of(String || Nat),
                                  operation :: maybe(Operation)):
  def dependencies = MutableList[]

  fun add_operand(operand :: Value,
                  operand_path :: List.of(String || Nat)):
    dependencies.add(ValueLeaf(operand, operand_path))

  fun add_whole(operand :: Value):
    for (operand_path in leaf_paths(operand.type)):
      add_operand(operand, operand_path)

  if visit_direct_operation_dependencies(value,
                                         path,
                                         operation,
                                         add_operand,
                                         add_whole)
  | dependencies.snapshot()
  | #false

// Returns direct upstream Value leaves for a wire or combinational result.
// A false result means the Value is a temporal or structural source. An empty
// List is a static combinational source such as a constant or don't-care.
fun direct_value_dependencies(value :: Value,
                              path :: List.of(String || Nat)):
  direct_operation_dependencies(value, path, value.module_def.find_operation(value.defining_op_id))

// Summarizes output-to-input combinational dependencies and rejects cycles.
// Temporal analysis consumes the same direct leaf dependency rules above.
fun verify_combinational_cycles(module_defs :: List.of(Module)):
  def module_summaries = MutableMap.by(===){}
  def active_modules = MutableSet.by(===){}
  def leaf_layouts = MutableMap.by(===){}
  def scalar_indices_by_path = MutableMap{}
  scalar_indices_by_path[[]] := 0
  def scalar_leaf_layout = LeafLayout([[]], scalar_indices_by_path)

  fun leaf_layout(type :: HardwareType) :: LeafLayout:
    use_static
    if !record_type(type) && !vector_type(type)
    | scalar_leaf_layout
    | block:
        def cached = leaf_layouts.get(type, #false)
        if cached
        | cached
        | block:
            def paths = leaf_paths(type)
            def indices_by_path = MutableMap{}
            for (path in paths,
                 leaf_index in 0..paths.length()):
              indices_by_path[path] := leaf_index
            def layout = LeafLayout(paths, indices_by_path)
            leaf_layouts[type] := layout
            layout

  fun leaf_index_for(layout :: LeafLayout,
                     path :: List.of(String || Nat)) :: Nat:
    def leaf_index = layout.indices_by_path.get(path, #false)
    if leaf_index is_a Nat
    | leaf_index
    | fail("invalid aggregate leaf path")

  fun false_slots(count :: Nat) :: MutableList:
    def result = MutableList[]
    for (_ in 0..count): result.add(#false)
    result

  fun indexed_place_leaf_driver(place :: Place,
                                leaf_index :: Nat) :: IndexedValueLeaf:
    use_static
    def layout = leaf_layout(place.type)
    def path = layout.paths[leaf_index]
    def projected_place = place_at_path(place, path)
    if projected_place?.driver
    | IndexedValueLeaf(projected_place!!.driver, 0)
    | IndexedValueLeaf(place.driver, leaf_index)

  fun indexed_direct_operation_dependencies(
        value :: Value,
        leaf_index :: Nat,
        operation :: maybe(Operation)) :: maybe(List):
    def dependencies = MutableList[]
    def path = leaf_layout(value.type).paths[leaf_index]

    fun add_operand(operand :: Value,
                    operand_path :: List.of(String || Nat)):
      dependencies.add(
        IndexedValueLeaf(operand,
                         leaf_index_for(leaf_layout(operand.type),
                                        operand_path))
      )

    fun add_whole(operand :: Value):
      def operand_layout = leaf_layout(operand.type)
      for (operand_leaf_index in 0..operand_layout.paths.length()):
        dependencies.add(IndexedValueLeaf(operand, operand_leaf_index))

    if visit_direct_operation_dependencies(value,
                                           path,
                                           operation,
                                           add_operand,
                                           add_whole)
    | dependencies.snapshot()
    | #false

  fun summarize_module(module_def :: Module) :: ModuleDependencySummary:
    def cached = module_summaries.get(module_def, #false)
    if cached
    | cached
    | block:
        when module_def in active_modules
        | fail("recursive module instantiation involving " ++ module_def.name)
        active_modules.add(module_def)
        def value_states = MutableMap.by(===){}
        def active_values = MutableList[]
        def input_leaf_offsets = MutableMap.by(===){}
        def input_leaves = MutableList[]

        for (port in module_def.inputs,
             input_index in 0..module_def.inputs.length()):
          input_leaf_offsets[port.value] := input_leaves.length()
          for (path in leaf_layout(port.type).paths):
            def leaf_index = input_leaves.length()
            input_leaves.add(InputLeaf(input_index, path))

        fun input_leaves_for_bits(input_bits :: Nat) :: List.of(InputLeaf):
          def result = MutableList[]
          for (input_leaf in input_leaves,
               leaf_index in 0..input_leaves.length()):
            when (input_bits bits.and (1 << leaf_index)) != 0
            | result.add(input_leaf)
          result.snapshot()

        fun state_for(value :: Value) :: ValueDependencyState:
          use_static
          def existing = value_states.get(value, #false)
          if existing
          | existing
          | block:
              def layout = leaf_layout(value.type)
              def state = ValueDependencyState(
                layout,
                false_slots(layout.paths.length()),
                false_slots(layout.paths.length())
              )
              value_states[value] := state
              state

        fun summarize_value(value :: Value,
                            leaf_index :: Nat,
                            via_operation :: maybe(Operation) = #false) :: Nat:
          use_static
          def state = state_for(value)
          def path = state.layout.paths[leaf_index]
          def cached_value = state.summaries[leaf_index]
          if cached_value
          | cached_value
          | block:
              def active_index = state.active_indices[leaf_index]
              when active_index is_a Nat
              | def repeated = ValueDependencySummary(value, path, [])
                def cycle = active_values.snapshot().drop(active_index) ++ [repeated]
                def cycle_path = String.join(
                  cycle.map(
                    fun (candidate :: ValueDependencySummary):
                      describe_value_path(candidate.value, candidate.path)
                  ),
                  " -> "
                )
                def message = String.append(
                  "combinational cycle reaches value ",
                  describe_value_path(value, repeated.path),
                  " in module ",
                  module_def.name,
                  ": ",
                  cycle_path
                )
                if via_operation
                | fail_operation(via_operation!!, message)
                | fail(message)
              def active_summary = ValueDependencySummary(value, path, [])
              state.active_indices[leaf_index] := active_values.length()
              active_values.add(active_summary)
              def operation :: maybe(Operation) = module_def.find_operation(value.defining_op_id)
              def input_leaf_offset = input_leaf_offsets.get(value, #false)
              def direct_dependencies = indexed_direct_operation_dependencies(
                value,
                leaf_index,
                operation
              )
              def input_bits:
                cond
                | input_leaf_offset is_a Nat:
                    1 << (input_leaf_offset + leaf_index)
                | direct_dependencies:
                    def mutable dependencies = 0
                    for (dependency :: IndexedValueLeaf in direct_dependencies!!):
                      dependencies := dependencies bits.or summarize_value(
                        dependency.value,
                        dependency.leaf_index,
                        operation
                      )
                    dependencies
                | operation?.opcode == "rtl.instance":
                    def instance_operation = operation!!
                    def child = instance_operation.attribute("module")
                    def child_summary = summarize_module(child)
                    def output_index = identity_index(instance_operation.results, value)
                    def mutable dependencies = 0
                    def output_leaf = child_summary.output_leaf_dependencies[output_index][leaf_index]
                    for (input_leaf in output_leaf.input_leaves):
                      def input_place = instance_operation.places[input_leaf.input_index]
                      def drive_operation :: maybe(Operation) = module_def.find_drive_to(input_place.id)
                      def input_leaf_index = leaf_index_for(
                        leaf_layout(input_place.type),
                        input_leaf.path
                      )
                      def driver = indexed_place_leaf_driver(input_place,
                                                             input_leaf_index)
                      dependencies := dependencies bits.or summarize_value(
                        driver.value,
                        driver.leaf_index,
                        drive_operation || operation
                      )
                    dependencies
                | ~else:
                    0
              active_values.delete(active_values.length() - 1)
              state.active_indices[leaf_index] := #false
              state.summaries[leaf_index] := input_bits
              input_bits

        // Visit every leaf of dead values too: an unobservable combinational
        // loop is still invalid even when it does not reach a module output.
        for (value in module_def.values):
          def layout = leaf_layout(value.type)
          for (leaf_index in 0..layout.paths.length()):
            summarize_value(value, leaf_index)
        def output_leaf_dependencies:
          for List (port in module_def.outputs):
            for List (path in leaf_layout(port.type).paths,
                      leaf_index in 0..leaf_layout(port.type).paths.length()):
              def driver = indexed_place_leaf_driver(port.place, leaf_index)
              OutputLeafDependency(path,
                                   input_leaves_for_bits(
                                     summarize_value(driver.value,
                                                     driver.leaf_index)
                                   ))
        def summary = ModuleDependencySummary(module_def,
                                              output_leaf_dependencies)
        module_summaries[module_def] := summary
        active_modules.remove(module_def)
        summary

  for (module_def in module_defs):
    summarize_module(module_def)
  #void
