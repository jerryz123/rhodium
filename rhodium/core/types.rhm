#lang rhombus
/* Defines Rhodium's canonical hardware-type abstraction and structural predicates. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../../support/annotations.rhm" open

export:
  HardwareType
  DataType
  ScalarDataType
  BitwiseType
  ArithmeticType
  SignedArithmeticType
  Bits
  Clock
  Reset
  RecordField
  RecordType
  VectorType
  hardware_type
  data_type
  scalar_data_type
  bitwise_type
  arithmetic_type
  signed_arithmetic_type
  scalar_width
  packable_type
  cast_compatible
  type_well_formed
  type_equal
  bits_type
  clock_type
  reset_type
  record_type
  vector_type
  mux_selector_type
  selector_width
  count_index_width
  bits_text

/* Defines the common description, equality, and optional canonical packed-width contract for hardware types. */
interface HardwareType:
  /* Returns a human-readable type description for diagnostics and IR inspection. */
  method describe()
  /* Tests receiver-defined hardware type equality; the public helper enforces symmetric equality for extension types. */
  method type_equal(other :: HardwareType)
  /* Returns the positive canonical packed width, or false when this type is opaque to packed operations. */
  method packed_width()

/* Marks ordinary hardware data that can occupy aggregates and registers, excluding clock and reset controls. */
interface DataType:
  extends HardwareType

/* Marks leaf data types, distinct from records and vectors, for scalar operation capability checks. */
interface ScalarDataType:
  extends DataType

/* Opts scalar data into same-type bitwise operations without granting arithmetic semantics. */
interface BitwiseType:
  extends ScalarDataType

/*
 * Marks fixed-width integer-like values whose modular arithmetic preserves
 * their nominal type. Width-changing operations use with_bit_width so core
 * can retain an extension-defined type without importing its frontend layer.
 */
interface ArithmeticType:
  extends BitwiseType
  /* Returns the same arithmetic type family at a new positive width, retaining its signedness and nominal semantics. */
  method with_bit_width(width :: PosInt)

/* Opts arithmetic scalars into signed comparisons, arithmetic right shifts, and sign extension. */
interface SignedArithmeticType:
  extends ArithmeticType

/* Represents a positive-width, unsigned packed bit vector with modular arithmetic and bitwise capabilities. */
class Bits(width :: PosInt):
  implements ArithmeticType

  /* Formats the width-parameterized Bits type for diagnostics and IR inspection. */
  override method describe():
    bits_text(this)

  /* Requires another Bits type with exactly the same width. */
  override method type_equal(other :: HardwareType):
    bits_type(other) && width == other.width

  /* Constructs an unsigned Bits type at the requested width. */
  override method with_bit_width(new_width :: PosInt):
    Bits(new_width)

  /* Returns this bit vector's explicit width. */
  override method packed_width():
    width

/* Represents the nominal one-bit clock control type, separate from ordinary data. */
class _ClockType():
  implements HardwareType
  /* Names the clock control type in diagnostics. */
  override method describe(): "clock"
  /* Accepts only another clock control type. */
  override method type_equal(other :: HardwareType): clock_type(other)
  /* Exposes the clock's one-bit representation for explicit packed casts. */
  override method packed_width(): 1

/* Represents the nominal one-bit reset control type, separate from ordinary data. */
class _ResetType():
  implements HardwareType
  /* Names the reset control type in diagnostics. */
  override method describe(): "reset"
  /* Accepts only another reset control type. */
  override method type_equal(other :: HardwareType): reset_type(other)
  /* Exposes the reset's one-bit representation for explicit packed casts. */
  override method packed_width(): 1

def Clock = _ClockType()
def Reset = _ResetType()

/* Associates an ASCII field name with its hardware data type in an ordered record layout. */
class RecordField(name :: AsciiIdentifier, type :: DataType)

/* Represents a nonempty ordered structural record; the optional preferred name is a display/lowering hint, not type identity. */
class RecordType(fields :: NonemptyList.of(RecordField),
                 preferred_name :: maybe(AsciiIdentifier) = #false):
  implements DataType
  nonfinal
  /* Validates the optional naming hint and rejects duplicate field names while preserving declared field order. */
  constructor (fields :: NonemptyList.of(RecordField),
               preferred_name :~ maybe(AsciiIdentifier) = #false):
    unless !preferred_name || preferred_name is_a AsciiIdentifier
    | error(~who: #'RecordType,
            "preferred name must be an ASCII identifier or #false")
    for (field in fields):
      when fields.filter(
        ~keep: fun (candidate): candidate.name == field.name
      ).length() != 1
      | error(~who: #'RecordType,
              "record field names must be unique")
    super(fields, preferred_name)

  /* Finds a field by name, returning false when the record has no such field. */
  method field(name :: AsciiIdentifier):
    fields.find(fun (candidate): candidate.name == name)

  /* Formats the ordered fields and their recursive type descriptions. */
  override method describe():
    "record<" ++ String.join(
      fields.map(
        fun (field): field.name ++ ": " ++ field.type.describe()
      ),
      ", "
    ) ++ ">"

  /* Compares ordered field names and structural member types, ignoring preferred names and frontend subclass identity. */
  final override method type_equal(other :: HardwareType):
    if !record_type(other) || fields.length() != other.fields.length()
    | #false
    | for all (left_field in fields,
               right_field in other.fields):
        left_field.name == right_field.name && structural_member_type_equal(left_field.type, right_field.type)

  /* Sums canonical field widths, returning false if any field is opaque. */
  override method packed_width():
    def mutable width = 0
    def mutable packable = #true
    for (field in fields):
      def field_width = checked_packed_width(field.type)
      if !field_width
      | packable := #false
      | width := width + field_width
    if packable | width | #false

/*
 * Models a fixed-length packed hardware vector. Logical element zero occupies
 * the least-significant element-width bits of the canonical representation.
 */
class VectorType(length :: PosInt, element_type :: DataType):
  implements DataType

  /* Formats the vector length and element type for diagnostics. */
  override method describe():
    "vector<" ++ to_string(length) ++ " x " ++ element_type.describe() ++ ">"

  /* Requires equal lengths and structurally equal element types. */
  override method type_equal(other :: HardwareType):
    vector_type(other) && length == other.length && structural_member_type_equal(element_type, other.element_type)

  /* Multiplies the element's canonical packed width by length, or returns false for opaque elements. */
  override method packed_width():
    def element_width = checked_packed_width(element_type)
    if !element_width | #false | length * element_width

/* Recognizes objects implementing the hardware-type contract. */
fun hardware_type(type :~ matching(_)):
  type is_a HardwareType

/* Recognizes ordinary hardware data types rather than timing controls. */
fun data_type(type :~ matching(_)):
  type is_a DataType

/* Recognizes data types that are scalar leaves rather than aggregates. */
fun scalar_data_type(type :~ matching(_)):
  type is_a ScalarDataType

/* Recognizes scalar types opted into bitwise operations. */
fun bitwise_type(type :~ matching(_)):
  type is_a BitwiseType

/* Recognizes scalar types opted into fixed-width modular arithmetic. */
fun arithmetic_type(type :~ matching(_)):
  type is_a ArithmeticType

/* Recognizes arithmetic types opted into signed operations. */
fun signed_arithmetic_type(type :~ matching(_)):
  type is_a SignedArithmeticType

/*
 * Normalize extension widths before using them in arithmetic or cast checks.
 * A false width denotes an opaque representation, never a zero-width scalar.
 */
fun checked_packed_width(type :~ matching(_)):
  if hardware_type(type)
  | block:
      def width = type.packed_width()
      if width is_a PosInt | width | #false
  | #false

/* Returns a validated scalar packed width, or false for non-scalars and opaque scalar types. */
fun scalar_width(type :~ matching(_)):
  if scalar_data_type(type) | checked_packed_width(type) | #false

/* Tests whether a hardware type has a positive canonical packed representation. */
fun packable_type(type :~ matching(_)):
  checked_packed_width(type) != #false

/* Permits explicit reinterpretation only between types with equal positive canonical packed widths. */
fun cast_compatible(source_type :~ matching(_),
                    target_type :~ matching(_)):
  def source_width = checked_packed_width(source_type)
  def target_width = checked_packed_width(target_type)
  source_width != #false && target_width != #false && source_width == target_width

/* Recognizes the built-in unsigned Bits type. */
fun bits_type(type :~ matching(_)):
  type is_a Bits

/* Recognizes the built-in clock control type. */
fun clock_type(type :~ matching(_)):
  type is_a _ClockType

/* Recognizes the built-in reset control type. */
fun reset_type(type :~ matching(_)):
  type is_a _ResetType

/* Recognizes structural records, including frontend record subclasses. */
fun record_type(type :~ matching(_)):
  type is_a RecordType

/* Recognizes fixed-length vector types. */
fun vector_type(type :~ matching(_)):
  type is_a VectorType

/* Restricts lookup selectors to the built-in Bits type. */
fun mux_selector_type(type :~ matching(_)):
  bits_type(type)

/* Returns the width of a supported lookup selector, or false for other hardware types. */
fun selector_width(type :~ matching(_)):
  if bits_type(type) | type.width | #false

/*
 * Returns the minimum nonzero Bits width that can encode every member of a
 * positive host-known collection size.
 */
fun count_index_width(count :: PosInt) :: PosInt:
  /* Doubles the representable capacity until it covers the count, returning at least one index bit. */
  fun loop(capacity :: PosInt, width :: Nat):
    if capacity >= count
    | block:
        if width == 0 | 1 | width
    | loop(capacity * 2, width + 1)
  loop(1, 0)

/* Checks every declared field's data type recursively. */
fun record_fields_well_formed(fields :: NonemptyList.of(RecordField)):
  for all (field in fields): type_well_formed(field.type)

/* Validates scalar widths and recursive aggregates while permitting extension hardware types with deliberately opaque packing. */
fun type_well_formed(type :~ matching(_)):
  cond
  | !hardware_type(type): #false
  | scalar_data_type(type): scalar_width(type) != #false
  | record_type(type): record_fields_well_formed(type.fields)
  | vector_type(type):
      type_well_formed(type.element_type)
  | ~else:
      type.packed_width() == #false || checked_packed_width(type) != #false

/* Compares hardware types without implicit casts, preserving built-in categories and requiring symmetric extension equality. */
fun type_equal(left :~ matching(_), right :~ matching(_)):
  cond
  | !hardware_type(left) || !hardware_type(right): #false
  | left === right: #true
  | left is_a Bits:
      right is_a Bits && left.width == right.width
  | right is_a Bits: #false
  | left is_a _ClockType: right is_a _ClockType
  | right is_a _ClockType: #false
  | left is_a _ResetType: right is_a _ResetType
  | right is_a _ResetType: #false
  | left is_a RecordType:
      right is_a RecordType && left.type_equal(right)
  | right is_a RecordType: #false
  | left is_a VectorType:
      right is_a VectorType && left.type_equal(right)
  | right is_a VectorType: #false
  | ~else:
      left.type_equal(right) && right.type_equal(left)

/* Applies public hardware type equality recursively to aggregate members. */
fun structural_member_type_equal(left :~ matching(_), right :~ matching(_)):
  type_equal(left, right)

/* Renders a Bits type as its canonical width-parameterized inspection text. */
fun bits_text(type :: Bits):
  "bits<" ++ to_string(type.width) ++ ">"
