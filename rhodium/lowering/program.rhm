#lang rhombus
/* Copies a selected RTL closure into a fresh verified design with remapped metadata and certification. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../core/ir.rhm" open
  "../core/builder.rhm".Builder
  "../core/verify.rhm" open
  "copy.rhm" open

export:
  ElaboratedProgram
  check_materialized_design
  materialize_reachable_rtl
  MaterializationCheck

/* Extension-owned certification after whole-design verification. */
interface MaterializationCheck:
  extends ModuleMetadataPayload
  /* Certify one finished destination module; a failure prevents a result from escaping. */
  method check_materialized(module_def :: Module)

/* Run attached certification after verification of the copied representation. */
fun check_materialized_design(design :: Design):
  for (module_def in design.modules):
    for (entry in module_def.metadata):
      when entry.payload is_a MaterializationCheck
      | entry.payload.check_materialized(module_def)

/* A completed source inventory and an explicit, finished top owned by that design.
   Construction checks ownership; targets verify without sealing the source. */
class ElaboratedProgram(design :: Design, top :: Module):
  /* Validate the selected boundary without copying or running whole-design checks. */
  constructor (design :: Design, top :: Module):
    DesignElaboration(design, top)
    super(design, top)

/* Validate all source modules, then copy only the selected top's reachable closure.
   Allocate all bodies before remapping metadata so cross-module references work.
   Each call owns fresh IR and leaves the source graph unsealed and unchanged. */
fun materialize_reachable_rtl(program :: ElaboratedProgram) :: DesignElaboration:
  verify_design_structure(program.design)
  verify_design_combinational(program.design)
  def builder = Builder(Design())
  def objects = MutableMap.by(===){}
  def copied = MutableList[]
  /* Copy each used DPI declaration once, omitting unused source imports. */
  fun copy_import(original :: DpiImport):
    unless objects.has_key(original)
    | objects[original] := builder.dpi_import_results(original.name, original.input_names, original.input_types, original.results, original.location)
    objects[original]
  def remap = make_ir_remapper(objects, copy_import)
  /* Allocate a shell before recursively copying children, preserving shared definitions. */
  fun copy(original :: Module):
    unless objects.has_key(original)
    | def target = builder.module(original.name)
      objects[original] := target
      copy_module_body(builder, original, target, fun (op): copy(op.attribute("module")), objects, remap)
      copied.add(original)
    objects[original]
  def top = copy(program.top)
  for (original in copied):
    def target = objects[original]
    for (place in original.places):
      for (projected in place.projected_places): objects[place].add_projected_place(remap(projected))
    for (entry in original.metadata):
      target.add_metadata(entry.namespace, remap(entry.payload))
  for (original in copied): builder.finish(objects[original])
  verify_design(builder.design)
  check_materialized_design(builder.design)
  DesignElaboration(builder.design, top)
