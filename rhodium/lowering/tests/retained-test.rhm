#lang rhombus
// Checks Builder-based expansion providers, dependency refinement, ownership, resources, and metadata remapping.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../core/main.rhm" open
  "../program.rhm" open

def signature = ModuleSignature([PortSignature("source", Bits(8))], [PortSignature("result", Bits(8))])
def definition = ConstructDefinition(ConstructIdentity("Identity"), [8], signature, [[OutputLeafDependency([], [InputLeaf(0, [])])]])
def omitted = ConstructDefinition(ConstructIdentity("Omitted"), [], signature, [[OutputLeafDependency([], [])]])
def mutable calls = 0
fun implementation(builder :: Builder, selected :: ConstructDefinition):
  calls := calls + 1
  def body = builder.module("Identity")
  def source = builder.input(body, "source", Bits(8))
  builder.drive(builder.output(body, "result", Bits(8)), source)
  builder.finish(body)
  ExpansionResult(body)
def provider = ExpansionProvider(implementation)

class ReferenceMetadata(value :: Value):
  implements ModuleMetadataPayload
  override method remap_ir(remap :: Function.of_arity(1)): ReferenceMetadata(remap(value))
class SharedView(value :: Value):
  implements ModuleMetadataPayload
  override method remap_ir(remap :: Function.of_arity(1)): SharedView(remap(value))
class GraphMetadata(boundary :: Module, port :: Port, instance :: Instance, views :: Array):
  implements ModuleMetadataPayload
  override method remap_ir(remap :: Function.of_arity(1)):
    GraphMetadata(remap(boundary), remap(port), remap(instance), remap(views))
class CyclicMetadata(children :: Array):
  implements ModuleMetadataPayload
  override method remap_ir(remap :: Function.of_arity(1)): CyclicMetadata(remap(children))
class OpaqueMetadata():
  implements ModuleMetadataPayload

fun make_program(selected :: ConstructDefinition, providers :: Map, ~opaque: opaque :: Boolean = #false, ~payload: payload :: maybe(ModuleMetadataPayload) = #false):
  def design = Design()
  def builder = Builder(design)
  def top = builder.module("Top")
  def source = builder.input(top, "source", Bits(8))
  def child = builder.construct_instance(top, selected, "child")
  builder.drive(child.input("source"), source)
  builder.drive(builder.output(top, "result", Bits(8)), child.output("result"))
  // Ordinary state and imports in the parent remain concrete and must be copied.
  def clock = builder.input(top, "clock", Clock)
  def address = builder.input(top, "address", Bits(2))
  def enable = builder.input(top, "enable", Bits(1))
  def memory = builder.memory(top, "storage", 4, Bits(8))
  builder.memory_write(top, memory, address, child.output("result"), clock, enable)
  builder.drive(builder.output(top, "read_data", Bits(8)), builder.memory_read_async(top, memory, address))
  def observer = builder.dpi_import("observe", ["data"], [Bits(8)])
  builder.dpi_call(top, observer, [child.output("result")], clock, enable)
  top.add_metadata("reference", payload || (if opaque | OpaqueMetadata() | ReferenceMetadata(source)))
  // This sibling is later in the source inventory. Its body and ports must
  // exist before the first module's metadata is resolved.
  def sibling = builder.module("Sibling")
  def sibling_input = builder.input(sibling, "source", Bits(8))
  builder.drive(builder.output(sibling, "result", Bits(8)), sibling_input)
  builder.finish(sibling)
  def instance = builder.instance(top, sibling, "sibling")
  builder.drive(instance.input("source"), source)
  def later = builder.module("Later")
  def later_input = builder.input(later, "source", Bits(8))
  def shared = SharedView(later_input)
  later.add_metadata("shared", shared)
  builder.finish(later)
  def later_instance = builder.instance(top, later, "later")
  builder.drive(later_instance.input("source"), source)
  def pair = RecordType([RecordField("a", Bits(8)), RecordField("b", Bits(8))])
  def output = builder.output(top, "pair", RecordType([RecordField("inner", pair)]))
  def inner = builder.project(output, "inner")
  def deep = builder.project(inner, "a")
  builder.drive(deep, source)
  builder.drive(builder.project(inner, "b"), source)
  // Output canonicalization detaches this tree; visit the deepest view first.
  def graph = GraphMetadata(later, later.inputs[0], instance, Array(shared, shared, deep, inner))
  top.add_metadata("graph", graph)
  builder.finish(top)
  ElaboratedProgram(design, top, providers)

def program = make_program(definition, {definition: provider})
def before = dump_ir(program.design)
def rtl = materialize_reachable_rtl(program).rtl
def again = materialize_reachable_rtl(program).rtl
check:
  calls ~is 2
  rtl.top.metadata_for("graph")[0].views[2] === rtl.top.metadata_for("graph")[0].views[3].projected_place("a") ~is #true
  rtl.top.metadata_for("graph")[0].views[2].parent === rtl.top.metadata_for("graph")[0].views[3] ~is #true
  rtl.top.metadata_for("graph")[0].views[3].parent === rtl.top.outputs.find(fun (port): port.name == "pair").place ~is #true
  rtl.top.metadata_for("graph")[0].views[0] === rtl.design.find_module_named("Later").metadata_for("shared")[0] ~is #true
  rtl.top.metadata_for("graph")[0].boundary === rtl.design.find_module_named("Later") ~is #true
  rtl.top.metadata_for("graph")[0].port === rtl.design.find_module_named("Later").inputs[0] ~is #true
  rtl.top.metadata_for("graph")[0].instance.operation === rtl.top.find_instance("sibling") ~is #true
  rtl.top.metadata_for("graph")[0].views[0] === rtl.top.metadata_for("graph")[0].views[1] ~is #true
  rtl.top.metadata_for("graph")[0].views[0].value === rtl.design.find_module_named("Later").inputs[0].value ~is #true
  rtl.top.metadata_for("graph")[0].views === again.top.metadata_for("graph")[0].views ~is #false
  dump_ir(program.design) ~is before
  rtl.top.metadata[0].payload.value === rtl.top.inputs[0].value ~is #true
  rtl.top.memories[0].module_def === rtl.top ~is #true
  rtl.top.memories[0] === again.top.memories[0] ~is #false
  rtl.design.dpi_imports[0].design === rtl.design ~is #true
  rtl.design.dpi_imports[0] === program.design.dpi_imports[0] ~is #false
  rtl.top.operations.find(fun (op): op.opcode == "rtl.memory_write").attribute("memory") === rtl.top.memories[0] ~is #true
  rtl.top.operations.find(fun (op): op.opcode == "sim.dpi_call").attribute("dpi_import") === rtl.design.dpi_imports[0] ~is #true
  materialize_reachable_rtl(make_program(definition, {})).rtl ~throws "missing portable provider"
  materialize_reachable_rtl(make_program(omitted, {omitted: provider})).rtl ~throws "exceeds its declared"
  materialize_reachable_rtl(make_program(definition, {definition: provider}, ~opaque: #true)).rtl ~throws "metadata does not support IR remapping"

def foreign = ExpansionProvider(fun (builder :: Builder, selected :: ConstructDefinition): ExpansionResult(rtl.top))
check:
  materialize_reachable_rtl(make_program(definition, {definition: foreign})).rtl ~throws "supplied builder"

def wrong_signature = ExpansionProvider(
  fun (builder :: Builder, selected :: ConstructDefinition):
    def body = builder.module("Wrong")
    builder.finish(body)
    ExpansionResult(body)
)
check:
  materialize_reachable_rtl(make_program(definition, {definition: wrong_signature})).rtl ~throws "declared signature"

def stateful = ExpansionProvider(
  fun (builder :: Builder, selected :: ConstructDefinition):
    def body = builder.module("Stateful")
    def source = builder.input(body, "source", Bits(8))
    builder.drive(builder.output(body, "result", Bits(8)), source)
    builder.memory(body, "hidden", 4, Bits(8))
    builder.finish(body)
    ExpansionResult(body)
)
check:
  materialize_reachable_rtl(make_program(definition, {definition: stateful})).rtl ~throws "state or effects"

// An expansion must not claim the name of a source module copied later,
// especially when that module is the explicitly selected top.
def collision = make_program(definition, {definition: provider})
def collision_builder = Builder(collision.design)
def reserved_top = collision_builder.module("Identity")
def collision_child = collision_builder.instance(reserved_top, collision.top, "reachable")
for (port in collision.top.inputs):
  collision_builder.drive(collision_child.input(port.name), collision_builder.input(reserved_top, port.name, port.type))
collision_builder.finish(reserved_top)
def renamed = materialize_reachable_rtl(ElaboratedProgram(collision.design, reserved_top, collision.providers)).rtl
check:
  renamed.top.name ~is "Identity"
  renamed.top.inputs.length() ~is 4
  renamed.design.find_module_named("Top").find_instance("child").attribute("module").name ~is "Identity_2"

// Invalid metadata must fail explicitly instead of retaining source references.
def cycle = CyclicMetadata(Array(#false))
cycle.children[0] := cycle
check:
  materialize_reachable_rtl(make_program(definition, {definition: provider}, ~payload: cycle)).rtl ~throws "cyclic metadata remapping"
  materialize_reachable_rtl(make_program(definition, {definition: provider}, ~payload: ReferenceMetadata(rtl.top.inputs[0].value))).rtl ~throws "unmapped IR reference"

// A later provider can add a check to an already expanded shared definition.
// Such checks must be merged and applied before returning the final design.
def checked = ExpansionProvider(provider.expand, [fun (module_def): error("late provider check rejected implementation")])
def wrapper_definition = ConstructDefinition(ConstructIdentity("CheckedWrapper"), [], signature, definition.dependencies)
fun checked_wrapper(builder :: Builder, selected :: ConstructDefinition):
  def body = builder.module("CheckedWrapper")
  def child = builder.construct_instance(body, definition, "shared")
  builder.drive(child.input("source"), builder.input(body, "source", Bits(8)))
  builder.drive(builder.output(body, "result", Bits(8)), child.output("result"))
  builder.finish(body)
  ExpansionResult(body, {definition: checked})
def late_builder = Builder(Design())
def late_top = late_builder.module("LateCheck")
def late_input = late_builder.input(late_top, "source", Bits(8))
for (selected in [definition, wrapper_definition], name in ["first", "second"]):
  def child = late_builder.construct_instance(late_top, selected, name)
  late_builder.drive(child.input("source"), late_input)
late_builder.finish(late_top)
def late_program = ElaboratedProgram(late_builder.design, late_top, {definition: provider, wrapper_definition: ExpansionProvider(checked_wrapper)})
check:
  materialize_reachable_rtl(late_program).rtl ~throws "late provider check rejected implementation"
