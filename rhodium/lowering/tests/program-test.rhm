#lang rhombus
// Checks direct-Builder program boundaries, fresh reachable materialization, and whole-design validation.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../core/main.rhm" open
  "../program.rhm" open

def design = Design()
def builder = Builder(design)
def top = builder.module("Top")
def source = builder.input(top, "source", Bits(8))
def result = builder.output(top, "result", Bits(8))
builder.drive(result, source)

check:
  DesignElaboration(design, top) ~throws "finished module"

builder.finish(top)
def program = DesignElaboration(design, top)
def before = dump_ir(design)
check:
  design.sealed ~is #false
  DesignElaboration(Design(), top) ~throws "owned by the elaborated design"

def rtl = materialize_reachable_rtl(program)
def again = materialize_reachable_rtl(program)
check:
  rtl is_a DesignElaboration ~is #true
  rtl.design === design ~is #false
  rtl.top === top ~is #false
  rtl.top.inputs[0].value === source ~is #false
  again.design === rtl.design ~is #false
  again.top === rtl.top ~is #false
  dump_ir(rtl.design) ~is before
  design.sealed ~is #false
  rtl.design.sealed ~is #true

// A valid selected top does not certify other modules in the design.
def invalid_design = Design()
def invalid_builder = Builder(invalid_design)
def valid_top = invalid_builder.module("ValidTop")
invalid_builder.finish(valid_top)
def unfinished = invalid_builder.module("Unfinished")
def invalid_program = DesignElaboration(invalid_design, valid_top)
check:
  materialize_reachable_rtl(invalid_program) ~throws "has not been finished"
  invalid_design.sealed ~is #false

// Attached certification runs on the complete, sealed copy and fails atomically.
class RejectCopy():
  implements MaterializationCheck
  override method remap_ir(remap :: Function.of_arity(1)): RejectCopy()
  override method check_materialized(module_def :: Module):
    check: module_def.design.sealed ~is #true
    error("certification rejected copied hardware")
def checked_design = Design()
def checked_builder = Builder(checked_design)
def checked_top = checked_builder.module("Checked")
checked_top.add_metadata("check", RejectCopy())
checked_builder.finish(checked_top)
def checked_program = DesignElaboration(checked_design, checked_top)
def mutable published = #false
fun publish(): published := materialize_reachable_rtl(checked_program)
check:
  publish() ~throws "certification rejected copied hardware"
  published ~is #false
  checked_design.sealed ~is #false
