#lang rhombus
// Validates memory/assertion permissions, transitive controls, and dependency refinement.
// SPDX-License-Identifier: Apache-2.0
import:
  "../../core/main.rhm" open
  "../program.rhm" open

def signature = ModuleSignature([PortSignature("clock", Clock), PortSignature("reset", Reset), PortSignature("read_address", Bits(2)), PortSignature("write_address", Bits(2)), PortSignature("data", Bits(8)), PortSignature("enable", Bits(1)), PortSignature("condition", Bits(1))], [PortSignature("result", Bits(8))])
def dependencies = [[OutputLeafDependency([], [InputLeaf(2, [])])]]
def both = SingleClockState("clock", "reset", ~async_read_memory: #true, ~clocked_assertions: #true)
def memory_only = SingleClockState("clock", "reset", ~async_read_memory: #true)
def assertions_only = SingleClockState("clock", "reset", ~clocked_assertions: #true)
def assertion_location = Location("retained-memory-contract", 17, 3)
def assertion_origin = Origin("contract test", "nested assertion")
def mutable child_calls = 0

fun implementation(builder :: Builder, kind :: String):
  def body = builder.module("Memory")
  def ports = for Map (port in signature.inputs): values(port.name, builder.input(body, port.name, port.type))
  def output = builder.output(body, "result", Bits(8))
  def clock = ports["clock"]
  def reset = ports["reset"]
  def foreign_clock = builder.cast(body, ports["enable"], Clock)
  if kind == "assertions-only"
  | builder.drive(output, builder.constant(body, Bits(8), 0))
  | def storage = builder.memory(body, "storage", 4, Bits(8))
    builder.memory_write(body, storage, ports["write_address"], ports["data"], if kind == "write-clock" | foreign_clock | clock, ports["enable"])
    builder.drive(output, builder.memory_read_async(body, storage, ports["read_address"]))
  unless kind == "memory-only"
  | def guard = builder.module("Guard")
    def guard_clock = builder.input(guard, "clock", Clock)
    def guard_reset = builder.input(guard, "reset", Reset)
    def condition = builder.input(guard, "condition", Bits(1))
    def enable = builder.input(guard, "enable", Bits(1))
    builder.assert(guard, condition, guard_clock, guard_reset, enable, "condition_holds", assertion_location, assertion_origin)
    builder.finish(guard)
    // Sharing a definition must not skip checking the second occurrence's controls.
    for (name in ["first", "second"]):
      def child = builder.instance(body, guard, name)
      builder.drive(child.input("clock"), if kind == "assert-clock" && name == "second" | foreign_clock | clock)
      builder.drive(child.input("reset"), if kind == "assert-reset" && name == "second" | builder.cast(body, ports["enable"], Reset) | reset)
      builder.drive(child.input("condition"), ports["condition"])
      builder.drive(child.input("enable"), ports["enable"])
  builder.finish(body)
  body

fun make_program(state :: SingleClockState, kind :: String, ~nested: nested :: Boolean = #false, ~omit_dependency: omit_dependency :: Boolean = #false):
  def declared = if omit_dependency | [[OutputLeafDependency([], [])]] | dependencies
  def outer = ConstructDefinition(ConstructIdentity("Outer"), [], signature, declared, ~state: state)
  def inner = ConstructDefinition(ConstructIdentity("Inner"), [], signature, dependencies, ~state: both)
  fun inner_expand(builder :: Builder, selected :: ConstructDefinition):
    child_calls := child_calls + 1
    ExpansionResult(implementation(builder, kind))
  def inner_provider = ExpansionProvider(inner_expand)
  fun expand(builder :: Builder, selected :: ConstructDefinition):
    if !nested
    | ExpansionResult(implementation(builder, kind))
    | def wrapper = builder.module("Wrapper")
      def child = builder.construct_instance(wrapper, inner, "child")
      for (port in signature.inputs): builder.drive(child.input(port.name), builder.input(wrapper, port.name, port.type))
      builder.drive(builder.output(wrapper, "result", Bits(8)), child.output("result"))
      builder.finish(wrapper)
      ExpansionResult(wrapper, {inner: inner_provider})
  def provider = ExpansionProvider(expand)
  def builder = Builder(Design())
  def top = builder.module("Top")
  def child = builder.construct_instance(top, outer, "child")
  for (port in signature.inputs): builder.drive(child.input(port.name), builder.input(top, port.name, port.type))
  builder.drive(builder.output(top, "result", Bits(8)), child.output("result"))
  builder.finish(top)
  ElaboratedProgram(builder.design, top, {outer: provider})

def expanded = materialize_reachable_rtl(make_program(both, "valid", ~nested: #true)).rtl
def assertions = expanded.design.find_module_named("Guard").operations.filter(~keep: fun (op): op.opcode == "verif.assert")
check:
  materialize_reachable_rtl(make_program(memory_only, "memory-only")).rtl.design.sealed ~is #true
  materialize_reachable_rtl(make_program(assertions_only, "assertions-only")).rtl.design.sealed ~is #true
  assertions[0].attribute("label") ~is "condition_holds"
  assertions[0].location === assertion_location ~is #true
  assertions[0].origin === assertion_origin ~is #true
  materialize_reachable_rtl(make_program(assertions_only, "memory-only")).rtl ~throws "undeclared asynchronous-read memory"
  materialize_reachable_rtl(make_program(memory_only, "valid")).rtl ~throws "undeclared clocked assertions"
  materialize_reachable_rtl(make_program(both, "write-clock")).rtl ~throws "outside its declared domain"
  materialize_reachable_rtl(make_program(both, "assert-clock")).rtl ~throws "outside its declared domain"
  materialize_reachable_rtl(make_program(both, "assert-reset")).rtl ~throws "does not preserve its declared reset"
  materialize_reachable_rtl(make_program(both, "valid", ~omit_dependency: #true)).rtl ~throws "exceeds its declared combinational dependencies"

def before = child_calls
check:
  materialize_reachable_rtl(make_program(assertions_only, "valid", ~nested: #true)).rtl ~throws "undeclared asynchronous-read memory"
  materialize_reachable_rtl(make_program(memory_only, "valid", ~nested: #true)).rtl ~throws "undeclared clocked assertions"
  child_calls ~is before
