#lang rhombus
// Checks RFPL physical views, placed composition, logical reuse, and CIRCT stability.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/backend/circt.rhm".emit_circt
  "../frontend/foundation.rhm".CompositeFloorplan
  "../frontend/foundation.rhm".Coordinate
  "../frontend/foundation.rhm".FloorplanPlacement
  "../frontend/foundation.rhm".FloorplanDesign
  "../frontend/foundation.rhm".HardMacro
  "../frontend/foundation.rhm".Length
  "../frontend/foundation.rhm".RectOutline
  "../../examples/rfpl/circuit-pair.rfpl" as fixture

def floorplan_design = fixture.floorplan_design
def logical = fixture.logical
def design = floorplan_design.design
def pair_view = fixture.pair_floorplan
def shell_view = fixture.shell_floorplan
def adder_view = fixture.adder_macro
def crossed_view = fixture.crossed_macro
def pair = pair_view.module_def
def shell = shell_view.module_def
def adder = adder_view.module_def
def crossed_wires = crossed_view.module_def
def left_placement = pair_view.placements.find(
  fun (placement): placement.instance.attribute("name") == "left"
)
def right_placement = pair_view.placements.find(
  fun (placement): placement.instance.attribute("name") == "right"
)
def crossed_placement = pair_view.placements.find(
  fun (placement): placement.instance.attribute("name") == "crossed"
)
def wrapped_placement = shell_view.placements[0]
def pair_instances = pair.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.instance"
)
def shell_instances = shell.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.instance"
)
def crossed_wire_drives = crossed_wires.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.drive"
)
def circt = emit_circt(design)

check:
  floorplan_design is_a FloorplanDesign ~is #true
  floorplan_design.logical === logical ~is #true
  floorplan_design.top === pair_view ~is #true
  floorplan_design.top_module === logical.top ~is #true
  floorplan_design.views.length() ~is 4
  floorplan_design.placements.length() ~is 4
  pair_view is_a CompositeFloorplan ~is #true
  shell_view is_a CompositeFloorplan ~is #true
  adder_view is_a HardMacro ~is #true
  crossed_view is_a HardMacro ~is #true
  pair_view.outline is_a RectOutline ~is #true
  pair_view.outline.width is_a Length ~is #true
  pair_view.outline.width.picometers ~is 100000000
  pair_view.outline.height.picometers ~is 50000000
  shell_view.outline.width.picometers ~is 40000000
  shell_view.outline.height.picometers ~is 24000000
  adder_view.outline.width.picometers ~is 40000000
  adder_view.outline.height.picometers ~is 24000000
  crossed_view.outline.width.picometers ~is 16000000
  crossed_view.outline.height.picometers ~is 8000000
  left_placement is_a FloorplanPlacement ~is #true
  left_placement.coordinate is_a Coordinate ~is #true
  left_placement.parent_module === pair ~is #true
  left_placement.child === shell_view ~is #true
  left_placement.coordinate.x.picometers ~is 0
  left_placement.coordinate.y.picometers ~is 0
  right_placement.child === shell_view ~is #true
  right_placement.coordinate.x.picometers ~is 50000000
  right_placement.coordinate.y.picometers ~is 0
  crossed_placement.child === crossed_view ~is #true
  crossed_placement.coordinate.x.picometers ~is 42000000
  crossed_placement.coordinate.y.picometers ~is 30000000
  wrapped_placement.child === adder_view ~is #true
  design.modules.length() ~is 4
  pair_instances.length() ~is 3
  shell_instances.length() ~is 1
  crossed_wire_drives.length() ~is 2
  adder.operations.find(fun (operation): operation.opcode == "rtl.add") != #false ~is #true
  verify_design(design) ~is #void
  circt.contains("hw.module @AdderPair") ~is #true
  circt.contains("hw.module @AdderShell") ~is #true
  circt.contains("hw.module @CrossedWires") ~is #true
  circt.contains("hw.module @Adder") ~is #true
  circt.contains("hw.instance \"left\" @AdderShell") ~is #true
  circt.contains("hw.instance \"right\" @AdderShell") ~is #true
  circt.contains("hw.instance \"crossed\" @CrossedWires") ~is #true
  circt.contains("hw.instance \"wrapped\" @Adder") ~is #true
  circt.contains("comb.add") ~is #true
  circt.contains("picometers") ~is #false
  circt.contains("rfpl.") ~is #false
  circt.contains("at:") ~is #false
  emit_circt(design) ~is circt
