#lang rfpl
// Invalid fixture placing a hard macro beyond its composite parent's bounds.
// SPDX-License-Identifier: Apache-2.0

import:
  "../support/annotation-circuits.rhm" as circuits

def logical = circuits.pair_logical
def left = child_instance(logical.top, "left")
def right = child_instance(logical.top, "right")
def leaf_view = hard_macro(left.attribute("module"), width: um(6), height: um(6))
def bad_view = floorplan(
  logical.top,
  width: um(10),
  height: um(10),
  placements: [
    place(left, leaf_view, at: (um(5), um(5))),
    place(right, leaf_view, at: (um(0), um(0)))
  ]
)
