#lang rfpl
// Invalid fixture assigning an instance the physical view of another circuit.
// SPDX-License-Identifier: Apache-2.0

import:
  "../support/annotation-circuits.rhm" as circuits

def logical = circuits.pair_logical
def left = child_instance(logical.top, "left")
def other_view = hard_macro(circuits.other_logical.top, width: um(5), height: um(5))
def bad = place(left, other_view, at: (um(0), um(0)))
