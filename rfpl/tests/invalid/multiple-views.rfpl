#lang rfpl
// Invalid fixture assigning two physical views to one logical module.
// SPDX-License-Identifier: Apache-2.0

import:
  "../support/annotation-circuits.rhm" as circuits

def logical = circuits.pair_logical
def left = child_instance(logical.top, "left")
def right = child_instance(logical.top, "right")
def leaf = left.attribute("module")
def first_view = hard_macro(leaf, width: um(5), height: um(5))
def second_view = hard_macro(leaf, width: um(5), height: um(5))
def top_view = floorplan(
  logical.top,
  width: um(10),
  height: um(10),
  placements: [
    place(left, first_view, at: (um(0), um(0))),
    place(right, second_view, at: (um(5), um(0)))
  ]
)
def physical = annotate(logical, top_view)
