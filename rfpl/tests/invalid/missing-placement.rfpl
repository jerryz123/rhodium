#lang rfpl
// Invalid fixture omitting one direct child from a composite floorplan.
// SPDX-License-Identifier: Apache-2.0

import:
  "../support/annotation-circuits.rhm" as circuits

def logical = circuits.pair_logical
def left = child_instance(logical.top, "left")
def leaf_view = hard_macro(left.attribute("module"), width: um(5), height: um(5))
def bad_view = floorplan(
  logical.top,
  width: um(10),
  height: um(10),
  placements: [place(left, leaf_view, at: (um(0), um(0)))]
)
