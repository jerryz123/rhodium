#lang rfpl
// Invalid fixture placing one direct child twice in a composite floorplan.
// SPDX-License-Identifier: Apache-2.0

import:
  "../support/annotation-circuits.rhm" as circuits

def logical = circuits.pair_logical
def left = child_instance(logical.top, "left")
def right = child_instance(logical.top, "right")
def leaf_view = hard_macro(left.attribute("module"), width: um(5), height: um(5))
def left_placement = place(left, leaf_view, at: (um(0), um(0)))
def bad_view = floorplan(
  logical.top,
  width: um(10),
  height: um(10),
  placements: [
    left_placement,
    left_placement,
    place(right, leaf_view, at: (um(5), um(0)))
  ]
)
