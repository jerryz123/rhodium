#lang rhodium
// Supplies reusable logical hierarchies for invalid RFPL annotation fixtures.
// SPDX-License-Identifier: Apache-2.0

circuit Leaf():
  input value_in: Bits(8)
  output value_out: Bits(8)
  value_out <== value_in

circuit Pair():
  input value_in: Bits(8)
  output value_out: Bits(8)
  def leaf = Leaf()
  inst left(leaf)
  inst right(leaf)
  left.value_in <== value_in
  right.value_in <== left.value_out
  value_out <== right.value_out

circuit LogicTop():
  input(a, b): Bits(8)
  output sum: Bits(8)
  sum <== a + b

circuit Other():
  input value_in: Bits(8)
  output value_out: Bits(8)
  value_out <== value_in

def pair_logical = elaborate_with_top(Pair())
def logic_logical = elaborate_with_top(LogicTop())
def other_logical = elaborate_with_top(Other())

export:
  pair_logical
  logic_logical
  other_logical
