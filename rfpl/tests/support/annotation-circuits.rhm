#lang rhodium

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target

// Supplies reusable logical hierarchies for invalid RFPL annotation fixtures.
// SPDX-License-Identifier: Apache-2.0

circuit Leaf():
  input value_in: Bits(8)
  output value_out: Bits(8)
  value_out <== value_in

circuit Pair():
  input value_in: Bits(8)
  output value_out: Bits(8)
  def leaf = Leaf()
  inst left(leaf)
  inst right(leaf)
  left.value_in <== value_in
  right.value_in <== left.value_out
  value_out <== right.value_out

circuit LogicTop():
  input(a, b): Bits(8)
  output sum: Bits(8)
  sum <== a + b

circuit Other():
  input value_in: Bits(8)
  output value_out: Bits(8)
  value_out <== value_in

def pair_logical = compile_program(elaborate(Pair()), rtl_target).report.elaboration
def logic_logical = compile_program(elaborate(LogicTop()), rtl_target).report.elaboration
def other_logical = compile_program(elaborate(Other()), rtl_target).report.elaboration

export:
  pair_logical
  logic_logical
  other_logical
