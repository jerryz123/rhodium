#lang rhombus
// Verifies that an annotated composite circuit contains only hierarchy and wiring.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/ir.rhm" open

export:
  verify_composite_module

def allowed_composite_opcodes = [
  "rtl.input_port",
  "rtl.output_port",
  "rtl.instance",
  "rtl.drive",
  "rtl.wire"
]

fun verify_composite_module(module_def :~ Module,
                            placed_instances :~ List.of(Operation)):
  unless module_def is_a Module
  | error(~who: #'floorplan, "expected an Rhodium core Module")
  unless placed_instances is_a List
  | error(~who: #'floorplan, "placed instances must be supplied as a List")
  for (operation in module_def.operations):
    unless allowed_composite_opcodes.find(
      fun (allowed): allowed == operation.opcode
    )
    | error(
        ~who: #'floorplan,
        String.append(
          operation.location.describe(),
          ": composite floorplan ", module_def.name,
          " cannot contain ", operation.opcode,
          "; annotate logic-bearing circuits as hard macros"
        )
      )
    when operation.opcode == "rtl.instance"
    | unless placed_instances.find(fun (candidate): candidate === operation)
      | error(
          ~who: #'floorplan,
          String.append(
            operation.location.describe(),
            ": composite floorplan ", module_def.name,
            " has no placement for instance ",
            operation.attribute("name")
          )
        )
  for (operation in placed_instances):
    def valid_instance = operation is_a Operation && operation.module_def === module_def && operation.opcode == "rtl.instance"
    unless valid_instance
    | error(~who: #'floorplan,
            "placement must select a direct instance of its composite floorplan")
    when placed_instances.filter(
      ~keep: fun (candidate): candidate === operation
    ).length() != 1
    | error(
        ~who: #'floorplan,
        String.append("instance ", operation.attribute("name"),
                      " is placed more than once in composite floorplan ",
                      module_def.name)
      )
  module_def
