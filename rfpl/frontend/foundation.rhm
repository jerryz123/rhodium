#lang rhombus/and_meta
/* Defines physical RFPL views over already elaborated Rhodium circuit hierarchy. */
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/meta open
  "../../rhodium/core/ir.rhm" open
  "verify.rhm".verify_composite_module

export:
  Length
  RectOutline
  Coordinate
  PhysicalView
  HardMacro
  CompositeFloorplan
  FloorplanPlacement
  FloorplanDesign
  nm
  um
  child_instance
  instance_target
  hard_macro
  floorplan
  place
  annotate

/* Stores an exact nonnegative physical distance in integer picometers. */
class Length(picometers :: Nat)

/* Describes a rectangular outline with strictly positive exact dimensions. */
class RectOutline(width :: Length, height :: Length):
  /* Rejects zero width or height before storing the outline. */
  constructor (width :: Length, height :: Length):
    unless width.picometers > 0
    | error(~who: #'RectOutline, "width must be positive")
    unless height.picometers > 0
    | error(~who: #'RectOutline, "height must be positive")
    super(width, height)

/* Locates a child rectangle's origin within its parent using nonnegative exact lengths. */
class Coordinate(x :: Length, y :: Length)

/* Defines the validation contract shared by opaque and transparent physical views. */
interface PhysicalView:
  /* Requires this view's local physical and logical-identity checks to succeed. */
  method validate()

/* Gives a finished logical module an opaque physical outline; traversal stops at this leaf,
   without hiding or changing the module's logical contents. */
class HardMacro(module_def :: Module,
                outline :: RectOutline,
                location :: Location = Location()):
  implements PhysicalView

  /* Rechecks the finished module and rectangular outline through shared view validation. */
  override method validate():
    validate_physical_view(this)

/* Records one existing parent-local instance, its matching child view, and exact coordinate;
   it never creates or reconnects a logical instance. */
class FloorplanPlacement(parent_module :: Module,
                         child :: PhysicalView,
                         instance :: Operation,
                         coordinate :: Coordinate,
                         location :: Location = Location())

/* Describes a transparent wiring-only module with exactly one placement per direct instance.
   Reusing this view stamps the same internal arrangement at each occurrence. */
class CompositeFloorplan(module_def :: Module,
                         outline :: RectOutline,
                         placements :: List.of(FloorplanPlacement),
                         location :: Location = Location()):
  implements PhysicalView

  /* Rechecks direct-instance coverage, child identity, coordinates, and rectangle containment. */
  override method validate():
    validate_physical_view(this)

/* Retains the original logical elaboration alongside the validated root and flattened view tree. */
class FloorplanDesign(logical :: DesignElaboration,
                      top :: PhysicalView,
                      views :: List.of(PhysicalView),
                      placements :: List.of(FloorplanPlacement)):
  /* Exposes the original logical Design unchanged for existing analyses and backends. */
  property design: logical.design
  /* Exposes the exact logical module associated with the physical root. */
  property top_module: top.module_def

/* Reports an RFPL authoring error with the supplied source location. */
fun rfpl_fail(message :: String, location :: Location = Location()):
  error(~who: #'rfpl, location.describe() ++ ": " ++ message)

/* Converts integer nanometers to exact picometers without floating-point arithmetic. */
fun nm(magnitude :: Nat):
  Length(magnitude * 1000)

/* Converts integer micrometers to exact picometers without floating-point arithmetic. */
fun um(magnitude :: Nat):
  Length(magnitude * 1000000)

/* Tests the common view interface before accessing physical-view fields. */
fun physical_view(value :~ PhysicalView):
  value is_a PhysicalView

/* Rejects unfinished logical modules and returns the same existing module object. */
fun require_module(module_def :: Module, location :: Location = Location()):
  unless module_def.finished
  | rfpl_fail("physical views require a finished Rhodium module", location)
  module_def

/* Checks positive dimensions with an RFPL source diagnostic before building the exact outline. */
fun require_outline(width :: Length,
                    height :: Length,
                    location :: Location = Location()):
  unless width.picometers > 0
  | rfpl_fail("physical width must be positive", location)
  unless height.picometers > 0
  | rfpl_fail("physical height must be positive", location)
  RectOutline(width, height)

/* Resolves a named direct instance in a finished module without reconstructing its hierarchy. */
fun child_instance(module_def :: Module,
                   name :: String,
                   location :: Location = Location()):
  require_module(module_def, location)
  def operation = module_def.find_instance(name)
  unless operation
  | rfpl_fail(
      String.append("circuit ", module_def.name,
                    " has no direct instance named ", name),
      location
    )
  operation

/* Reads an existing rtl.instance's exact target Module, rejecting other or malformed operations. */
fun instance_target(instance :: Operation,
                    location :: Location = Location()):
  unless instance.opcode == "rtl.instance"
  | rfpl_fail("instance_target requires an Rhodium instance operation", location)
  def target = instance.attribute("module", #false)
  unless target is_a Module
  | rfpl_fail("instance operation has no Rhodium target module", location)
  target

/* Constructs an opaque view after checking the existing module and positive outline dimensions. */
fun build_hard_macro(module_def :: Module,
                     width :: Length,
                     height :: Length,
                     location :: Location = Location()):
  require_module(module_def, location)
  HardMacro(module_def, require_outline(width, height, location), location)

/* Requires an existing instance and an exact target-module match, then records its parent and
   coordinate without changing logical connectivity. */
fun build_placement(instance :: Operation,
                    child :~ PhysicalView,
                    coordinate :: Coordinate,
                    location :: Location = Location()):
  unless instance.opcode == "rtl.instance"
  | rfpl_fail("place requires an Rhodium instance operation", location)
  unless physical_view(child)
  | rfpl_fail("place requires a hard-macro or composite-floorplan child view",
              location)
  def target = instance_target(instance, location)
  unless target === child.module_def
  | rfpl_fail(
      String.append("instance ", instance.attribute("name"),
                    " targets circuit ", target.name,
                    " but its placement uses the view of ",
                    child.module_def.name),
      location
    )
  FloorplanPlacement(instance.module_def, child, instance, coordinate, location)

/* Checks that the child's right and top edges fit inside its parent; sibling overlap is not checked. */
fun verify_containment(parent :: CompositeFloorplan,
                       placement :: FloorplanPlacement):
  def coordinate = placement.coordinate
  def child = placement.child
  def right_edge = coordinate.x.picometers + child.outline.width.picometers
  def top_edge = coordinate.y.picometers + child.outline.height.picometers
  def fits_width = right_edge <= parent.outline.width.picometers
  def fits_height = top_edge <= parent.outline.height.picometers
  unless fits_width && fits_height
  | rfpl_fail(
      String.append("instance ", placement.instance.attribute("name"),
                    " does not fit within composite floorplan ",
                    parent.module_def.name,
                    " at its coordinate"),
      placement.location
    )

/* Checks parent ownership and complete wiring-only instance coverage, then constructs the outline
   and checks every child rectangle's containment. */
fun build_composite_floorplan(module_def :: Module,
                              width :: Length,
                              height :: Length,
                              placements :: List.of(FloorplanPlacement),
                              location :: Location = Location()):
  require_module(module_def, location)
  for (placement in placements):
    unless placement.parent_module === module_def
    | rfpl_fail("placement selects an instance from a different parent circuit",
                placement.location)
  verify_composite_module(
    module_def,
    placements.map(fun (placement): placement.instance)
  )
  def view = CompositeFloorplan(
    module_def,
    require_outline(width, height, location),
    placements,
    location
  )
  for (placement in placements):
    verify_containment(view, placement)
  view

/* Revalidates a view's finished module and outline. Transparent views additionally require direct,
   uniquely placed instances, matching child modules, exact coordinates, and containment. */
fun validate_physical_view(view :: PhysicalView):
  unless physical_view(view)
  | rfpl_fail("expected a hard-macro or composite-floorplan view")
  require_module(view.module_def, view.location)
  unless view.outline is_a RectOutline
  | rfpl_fail("physical view must have a rectangular outline", view.location)
  when view is_a CompositeFloorplan
  | unless view.placements is_a List
    | rfpl_fail("floorplan placements must be supplied as a List", view.location)
    for (placement in view.placements):
      unless placement is_a FloorplanPlacement
      | rfpl_fail("floorplan placements must be created with place", view.location)
      unless placement.parent_module === view.module_def
      | rfpl_fail("placement selects an instance from a different parent circuit",
                  placement.location)
      def direct_instance = placement.instance is_a Operation && placement.instance.opcode == "rtl.instance" && placement.instance.module_def === view.module_def
      unless direct_instance
      | rfpl_fail("placement must select a direct Rhodium instance",
                  placement.location)
      unless physical_view(placement.child)
      | rfpl_fail("placement child must have a physical view", placement.location)
      unless placement.instance.attribute("module", #false) === placement.child.module_def
      | rfpl_fail("placement child view does not match its instance target",
                  placement.location)
      unless placement.coordinate is_a Coordinate
      | rfpl_fail("placement must have an exact physical coordinate",
                  placement.location)
      verify_containment(view, placement)
    verify_composite_module(
      view.module_def,
      view.placements.map(fun (placement): placement.instance)
    )
  view

/* Validates the exact logical top and reachable physical tree, requiring common Design ownership
   and one view object per module while leaving the logical IR unchanged. */
fun annotate(logical :: DesignElaboration,
             top :~ PhysicalView,
             location :: Location = Location()):
  unless physical_view(top)
  | rfpl_fail("annotate requires a hard-macro or composite-floorplan top view",
              location)
  top.validate()
  unless top.module_def === logical.top
  | rfpl_fail(
      String.append("physical top ", top.module_def.name,
                    " does not match logical top ", logical.top.name),
      location
    )
  def mutable views = []
  def mutable placements = []
  /* Visits each distinct view once, rejects conflicting module views or foreign designs, and
     traverses only composite placements; hard macros remain physical leaves. */
  fun visit(view :: PhysicalView):
    view.validate()
    unless view.module_def.design === logical.design
    | rfpl_fail(
        String.append("physical view for ", view.module_def.name,
                      " belongs to a different logical design"),
        view.location
      )
    def existing = views.find(
      fun (candidate): candidate.module_def === view.module_def
    )
    if existing
    | unless existing === view
      | rfpl_fail(
          String.append("circuit ", view.module_def.name,
                        " has more than one physical view"),
          view.location
        )
    | block:
        views := views ++ [view]
        when view is_a CompositeFloorplan
        | placements := placements ++ view.placements
          for (placement in view.placements):
            unless placement.child.module_def.design === logical.design
            | rfpl_fail(
                String.append("placed child ",
                              placement.child.module_def.name,
                              " belongs to a different logical design"),
                placement.location
              )
            visit(placement.child)
  visit(top)
  FloorplanDesign(logical, top, views, placements)

/* Expands the opaque-view authoring form into the checked builder for an existing module. */
expr.macro 'hard_macro($module, width: $width, height: $height)':
  'build_hard_macro($module, $width, $height)'

/* Expands placement syntax into an exact coordinate and checked existing-instance binding. */
expr.macro 'place($instance, $child, at: ($x, $y))':
  'build_placement($instance, $child, Coordinate($x, $y))'

/* Expands transparent-view syntax into the wiring-only, complete-placement construction path. */
expr.macro 'floorplan($module,
                      width: $width,
                      height: $height,
                      placements: $placements)':
  'build_composite_floorplan($module, $width, $height, $placements)'
