#lang rhombus
// Defines shared RISC-V operand fields, immediate layouts, and instruction formats.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus.bits.(<<) as <<
  "../../support/annotations.rhm" open
  "fields.rhm" open

export:
  RegisterBank
  RegisterOperand
  ImmediatePiece
  ImmediateLayout
  InstructionFormat
  opcode
  rd
  funct3
  rs1
  rs2
  rs3
  fmt
  rm
  funct7
  funct6
  funct5
  aq
  rl
  immediate12
  fm
  predecessor
  successor
  RFormat
  UnaryFormat
  IFormat
  SFormat
  BFormat
  UFormat
  JFormat
  Shift64Format
  Shift32Format
  PrefetchFormat
  CacheBlockFormat
  FenceFormat
  SystemFormat
  AtomicFormat
  LoadReservedFormat
  FloatingLoadFormat
  FloatingStoreFormat
  FloatingBinaryFormat
  FloatingBinaryRoundingFormat
  FloatingUnaryFormat
  FloatingUnaryRoundingFormat
  FloatingCompareFormat
  FloatingToIntegerFormat
  FloatingToIntegerRoundingFormat
  IntegerToFloatingFormat
  IntegerToFloatingRoundingFormat
  FloatingImmediateFormat
  IntegerPairToFloatingFormat
  FloatingConvertFormat
  FloatingR4RoundingFormat
  IImmediate
  SImmediate
  BImmediate
  UImmediate
  JImmediate
  Shift64Immediate
  Shift32Immediate
  PrefetchImmediate

enum RegisterBank
| Integer
| FloatingPoint
| Vector

class RegisterOperand(name :: NonemptyString, field :: BitField, role :: String, bank :: RegisterBank):
  constructor (name :: NonemptyString, field :: BitField, role :: String, bank :: RegisterBank = RegisterBank.Integer):
    unless field.width == 5
    | error(~who: #'RegisterOperand,
            "register operand field must be a five-bit BitField")
    unless role == "source" || role == "destination"
    | error(~who: #'RegisterOperand,
            "register operand role must be source or destination")
    super(name, field, role, bank)

class ImmediatePiece(source :: BitField, output_high :: Nat, output_low :: Nat):
  constructor (source :: BitField, output_high :: Nat, output_low :: Nat):
    unless output_low <= output_high
    | error(~who: #'ImmediatePiece,
            "immediate output bounds must satisfy high >= low >= 0")
    unless source.width == output_high - output_low + 1
    | error(~who: #'ImmediatePiece,
            "immediate source and destination slices must have equal widths")
    super(source, output_high, output_low)

  method output_mask():
    width_mask(output_high - output_low + 1) << output_low

class ImmediateLayout(name :: NonemptyString,
                      width :: PosInt,
                      signed :: Boolean,
                      pieces :: NonemptyList.of(ImmediatePiece),
                      zero_bits :: List.of(Nat)):
  constructor (name :: NonemptyString,
               width :: PosInt,
               signed :: Boolean,
               pieces :: NonemptyList.of(ImmediatePiece),
               zero_bits :: List.of(Nat) = []):
    def mutable covered = 0
    for (piece in pieces):
      unless piece.source.high < 32 && piece.output_high < width
      | error(~who: #'ImmediateLayout,
              "immediate piece lies outside its source or destination width")
      when (covered bits.and piece.output_mask()) != 0
      | error(~who: #'ImmediateLayout,
              "immediate output pieces must not overlap")
      covered := covered bits.or piece.output_mask()
    for (bit in zero_bits):
      unless bit < width
      | error(~who: #'ImmediateLayout,
              "immediate zero bit lies outside the output width")
      def bit_mask = 1 << bit
      when (covered bits.and bit_mask) != 0
      | error(~who: #'ImmediateLayout,
              "immediate zero bits and output pieces must not overlap")
      covered := covered bits.or bit_mask
    unless covered == width_mask(width)
    | error(~who: #'ImmediateLayout,
            "immediate pieces and zero bits must cover the output width")
    super(name, width, signed, pieces, zero_bits)

  method source_fields():
    pieces.map(fun (piece): piece.source)

  method decode(word :: Nat):
    unless word <= width_mask(32)
    | error(~who: #'decode, "instruction word must fit 32 bits")
    def mutable result = 0
    for (piece in pieces):
      result := result + (piece.source.extract(word) << piece.output_low)
    result

  // Scatters an already width-masked immediate into its instruction fields.
  // This lower-level form is also used when expanding compressed encodings.
  method scatter(value :: Nat):
    unless value <= width_mask(width)
    | error(~who: #'scatter, "immediate value does not fit its layout")
    def mutable result = 0
    for (piece in pieces):
      def fragment = bits.field(value, piece.output_low, piece.output_high + 1)
      result := result bits.or (fragment << piece.source.low)
    for (bit in zero_bits):
      when bits.field(value, bit, bit + 1) != 0
      | error(~who: #'scatter, "immediate value sets an implicit-zero bit")
    result

  // Validates a semantic signed or unsigned immediate before scattering it.
  method encode(value :: Int):
    def limit = 1 << (width - 1)
    if signed
    | unless value >= -limit && value < limit
      | error(~who: #'encode, "signed immediate is out of range")
    | unless value >= 0 && value <= width_mask(width)
      | error(~who: #'encode, "unsigned immediate is out of range")
    scatter(value bits.and width_mask(width))

fun fields_mask(fields :: List.of(BitField), who :: Symbol):
  def mutable mask = 0
  for (field in fields):
    when (mask bits.and field.mask()) != 0
    | error(~who: who, "instruction format fields must not overlap")
    mask := mask bits.or field.mask()
  mask

class InstructionFormat(name :: NonemptyString,
                        operands :: List.of(RegisterOperand),
                        immediate :: False || ImmediateLayout,
                        auxiliary_fields :: List.of(BitField),
                        variable_fields :: List.of(BitField),
                        variable_mask :: Nat):
  constructor (name :: NonemptyString,
               operands :: List.of(RegisterOperand),
               immediate :~ False || ImmediateLayout = #false,
               auxiliary_fields :: List.of(BitField) = []):
    unless !immediate || immediate is_a ImmediateLayout
    | error(~who: #'InstructionFormat,
            "format immediate must be an ImmediateLayout or #false")
    def immediate_fields:
      if immediate | immediate.source_fields() | []
    def variable_fields = operands.map(fun (operand): operand.field) ++ immediate_fields ++ auxiliary_fields
    def variable_mask = fields_mask(variable_fields, #'InstructionFormat)
    super(name,
          operands,
          immediate,
          auxiliary_fields,
          variable_fields,
          variable_mask)

def opcode = BitField("opcode", 6, 0)
def rd = BitField("rd", 11, 7)
def funct3 = BitField("funct3", 14, 12)
def rs1 = BitField("rs1", 19, 15)
def rs2 = BitField("rs2", 24, 20)
def rs3 = BitField("rs3", 31, 27)
def fmt = BitField("fmt", 26, 25)
def rm = BitField("rm", 14, 12)
def funct7 = BitField("funct7", 31, 25)
def funct6 = BitField("funct6", 31, 26)
def funct5 = BitField("funct5", 31, 27)
def aq = BitField("aq", 26, 26)
def rl = BitField("rl", 25, 25)
def immediate12 = BitField("imm[11:0]", 31, 20)
def fm = BitField("fm", 31, 28)
def predecessor = BitField("pred", 27, 24)
def successor = BitField("succ", 23, 20)

def rd_operand = RegisterOperand("rd", rd, "destination")
def rs1_operand = RegisterOperand("rs1", rs1, "source")
def rs2_operand = RegisterOperand("rs2", rs2, "source")
def frd_operand = RegisterOperand("frd", rd, "destination", RegisterBank.FloatingPoint)
def frs1_operand = RegisterOperand("frs1", rs1, "source", RegisterBank.FloatingPoint)
def frs2_operand = RegisterOperand("frs2", rs2, "source", RegisterBank.FloatingPoint)
def frs3_operand = RegisterOperand("frs3", rs3, "source", RegisterBank.FloatingPoint)

def s_immediate_high = BitField("simm[11:5]", 31, 25)
def s_immediate_low = BitField("simm[4:0]", 11, 7)
def b_immediate_sign = BitField("bimm[12]", 31, 31)
def b_immediate_10_5 = BitField("bimm[10:5]", 30, 25)
def b_immediate_4_1 = BitField("bimm[4:1]", 11, 8)
def b_immediate_11 = BitField("bimm[11]", 7, 7)
def u_immediate = BitField("uimm[31:12]", 31, 12)
def j_immediate_sign = BitField("jimm[20]", 31, 31)
def j_immediate_10_1 = BitField("jimm[10:1]", 30, 21)
def j_immediate_11 = BitField("jimm[11]", 20, 20)
def j_immediate_19_12 = BitField("jimm[19:12]", 19, 12)
def shift64 = BitField("shamt[5:0]", 25, 20)
def shift32 = BitField("shamt[4:0]", 24, 20)

def IImmediate = ImmediateLayout(
  "I-immediate",
  12,
  #true,
  [ImmediatePiece(immediate12, 11, 0)]
)
def SImmediate = ImmediateLayout(
  "S-immediate",
  12,
  #true,
  [ImmediatePiece(s_immediate_high, 11, 5),
   ImmediatePiece(s_immediate_low, 4, 0)]
)
def BImmediate = ImmediateLayout(
  "B-immediate",
  13,
  #true,
  [ImmediatePiece(b_immediate_sign, 12, 12),
   ImmediatePiece(b_immediate_11, 11, 11),
   ImmediatePiece(b_immediate_10_5, 10, 5),
   ImmediatePiece(b_immediate_4_1, 4, 1)],
  [0]
)
def UImmediate = ImmediateLayout(
  "U-immediate",
  32,
  #true,
  [ImmediatePiece(u_immediate, 31, 12)],
  for List (bit in 0..12): bit
)
def JImmediate = ImmediateLayout(
  "J-immediate",
  21,
  #true,
  [ImmediatePiece(j_immediate_sign, 20, 20),
   ImmediatePiece(j_immediate_19_12, 19, 12),
   ImmediatePiece(j_immediate_11, 11, 11),
   ImmediatePiece(j_immediate_10_1, 10, 1)],
  [0]
)
def Shift64Immediate = ImmediateLayout(
  "64-bit shift amount",
  6,
  #false,
  [ImmediatePiece(shift64, 5, 0)]
)
def Shift32Immediate = ImmediateLayout(
  "32-bit shift amount",
  5,
  #false,
  [ImmediatePiece(shift32, 4, 0)]
)
def PrefetchImmediate = ImmediateLayout(
  "prefetch offset",
  12,
  #true,
  [ImmediatePiece(s_immediate_high, 11, 5)],
  for List (bit in 0..5): bit
)

def RFormat = InstructionFormat(
  "R",
  [rd_operand, rs1_operand, rs2_operand]
)
def UnaryFormat = InstructionFormat(
  "unary-register",
  [rd_operand, rs1_operand]
)
def AtomicFormat = InstructionFormat(
  "atomic",
  [rd_operand, rs1_operand, rs2_operand],
  #false,
  [aq, rl]
)
def LoadReservedFormat = InstructionFormat(
  "load-reserved",
  [rd_operand, rs1_operand],
  #false,
  [aq, rl]
)
def IFormat = InstructionFormat(
  "I",
  [rd_operand, rs1_operand],
  IImmediate
)
def SFormat = InstructionFormat(
  "S",
  [rs1_operand, rs2_operand],
  SImmediate
)
def BFormat = InstructionFormat(
  "B",
  [rs1_operand, rs2_operand],
  BImmediate
)
def UFormat = InstructionFormat(
  "U",
  [rd_operand],
  UImmediate
)
def JFormat = InstructionFormat(
  "J",
  [rd_operand],
  JImmediate
)
def Shift64Format = InstructionFormat(
  "I-shamt6",
  [rd_operand, rs1_operand],
  Shift64Immediate
)
def Shift32Format = InstructionFormat(
  "I-shamt5",
  [rd_operand, rs1_operand],
  Shift32Immediate
)
def PrefetchFormat = InstructionFormat(
  "prefetch",
  [rs1_operand],
  PrefetchImmediate
)
def CacheBlockFormat = InstructionFormat("cache-block", [rs1_operand])
def FenceFormat = InstructionFormat(
  "FENCE",
  [],
  #false,
  [fm, predecessor, successor, rs1, rd]
)
def SystemFormat = InstructionFormat("SYSTEM", [])
def FloatingLoadFormat = InstructionFormat("floating-load", [frd_operand, rs1_operand], IImmediate)
def FloatingStoreFormat = InstructionFormat("floating-store", [rs1_operand, frs2_operand], SImmediate)
def FloatingBinaryFormat = InstructionFormat("floating-binary", [frd_operand, frs1_operand, frs2_operand])
def FloatingBinaryRoundingFormat = InstructionFormat("floating-binary-rounding", [frd_operand, frs1_operand, frs2_operand], #false, [rm])
def FloatingUnaryFormat = InstructionFormat("floating-unary", [frd_operand, frs1_operand])
def FloatingUnaryRoundingFormat = InstructionFormat("floating-unary-rounding", [frd_operand, frs1_operand], #false, [rm])
def FloatingCompareFormat = InstructionFormat("floating-compare", [rd_operand, frs1_operand, frs2_operand])
def FloatingToIntegerFormat = InstructionFormat("floating-to-integer", [rd_operand, frs1_operand])
def FloatingToIntegerRoundingFormat = InstructionFormat("floating-to-integer-rounding", [rd_operand, frs1_operand], #false, [rm])
def IntegerToFloatingFormat = InstructionFormat("integer-to-floating", [frd_operand, rs1_operand])
def IntegerToFloatingRoundingFormat = InstructionFormat("integer-to-floating-rounding", [frd_operand, rs1_operand], #false, [rm])
def FloatingImmediateFormat = InstructionFormat("floating-immediate", [frd_operand], #false, [rs1])
def IntegerPairToFloatingFormat = InstructionFormat("integer-pair-to-floating", [frd_operand, rs1_operand, rs2_operand])
def FloatingConvertFormat = InstructionFormat("floating-convert", [frd_operand, frs1_operand], #false, [rm])
def FloatingR4RoundingFormat = InstructionFormat("floating-R4-rounding", [frd_operand, frs1_operand, frs2_operand, frs3_operand], #false, [rm])
