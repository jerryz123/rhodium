#lang rhombus
/* Defines validated instruction specifications and disjoint ISA catalogs. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../../support/annotations.rhm" open
  "fields.rhm" open
  "encoding.rhm" open
  "formats.rhm" open

export:
  InstructionSpec
  InstructionCatalog
  instruction

/* Pairs a named 32-bit instruction format with fixed encoding requirements and reflected variable operands. */
class InstructionSpec(name :: NonemptyString,
                      format :: InstructionFormat,
                      requirements :: NonemptyList.of(FieldConstraint),
                      encoding :: InstructionEncoding,
                      operands :: List.of(RegisterOperand),
                      immediate :: maybe(ImmediateLayout),
                      encoding_fields :: List.of(BitField)):
  /* Requires fixed constraints and variable fields to cover 32 bits exactly without overlap. */
  constructor (name :: NonemptyString,
               format :: InstructionFormat,
               requirements :: NonemptyList.of(FieldConstraint)):
    def encoding = InstructionEncoding(requirements)
    when (encoding.care bits.and format.variable_mask) != 0
    | error(~who: #'InstructionSpec,
            "fixed encoding requirements overlap variable instruction fields")
    unless (encoding.care bits.or format.variable_mask) == width_mask(32)
    | error(~who: #'InstructionSpec,
            "encoding requirements and format fields must cover 32 bits")
    super(name,
          format,
          requirements,
          encoding,
          format.operands,
          format.immediate,
          format.variable_fields)

  /* Tests a host instruction word against this instruction's fixed encoding. */
  method matches(word :: Nat):
    encoding.matches(word)

  /* Assembles one complete instruction from values for every variable
   * register or auxiliary field plus the format-owned semantic immediate. */
  method encode(fields :: List.of(FieldConstraint),
                ~immediate: immediate_value :~ maybe(Int) = #false):
    def supplied_fields = format.operands.map(fun (operand): operand.field) ++ (
      format.auxiliary_fields
    )
    for (binding in fields):
      unless supplied_fields.contains(binding.field)
      | error(~who: #'encode,
              "field " ++ binding.field.name ++ " is not an explicit field of " ++ name)
    for (field in supplied_fields):
      unless fields.filter(~keep: fun (binding): binding.field == field).length() == 1
      | error(~who: #'encode,
              "field " ++ field.name ++ " must be supplied exactly once for " ++ name)
    when immediate_value && !format.immediate
    | error(~who: #'encode, name ++ " does not have an immediate")
    when !immediate_value && format.immediate
    | error(~who: #'encode, name ++ " requires an immediate")

    def mutable word = encoding.value
    for (binding in fields):
      word := word bits.or binding.value_bits
    if immediate_value is_a Int
    | block:
        def immediate_layout :: ImmediateLayout = format.immediate
        word := word bits.or immediate_layout.encode(immediate_value)
    | #void
    word

/* Groups named instructions with a revision and pairwise-disjoint encoding relations. */
class InstructionCatalog(name :: NonemptyString,
                         revision :: NonemptyString,
                         instructions :: NonemptyList.of(InstructionSpec)):
  /* Rejects duplicate names and overlapping encodings before retaining the catalog. */
  constructor (name :: NonemptyString,
               revision :: NonemptyString,
               instructions :: NonemptyList.of(InstructionSpec)):
    for (instruction in instructions):
      when instructions.filter(
        ~keep: fun (candidate): candidate.name == instruction.name
      ).length() != 1
      | error(~who: #'InstructionCatalog,
              "duplicate instruction name " ++ instruction.name)
    for (left_index in 0..instructions.length()):
      for (right_index in (left_index + 1)..instructions.length()):
        def left = instructions[left_index]
        def right = instructions[right_index]
        when left.encoding.overlaps(right.encoding)
        | error(~who: #'InstructionCatalog,
                String.append("instruction encodings overlap: ",
                              left.name,
                              " and ",
                              right.name))
    super(name, revision, instructions)

  /* Returns the named descriptor or reports an unknown instruction. */
  method find(instruction_name :: String):
    def found = instructions.find(
      fun (candidate): candidate.name == instruction_name
    )
    unless found
    | error(~who: #'find, "unknown instruction " ++ instruction_name)
    found

  /* Returns the matching descriptor, or false when no catalog encoding accepts the word. */
  method matching(word :: Nat):
    instructions.find(fun (instruction): instruction.matches(word))

/* Normalizes variadic requirements or one requirement list into a validated instruction descriptor. */
fun instruction(name :: NonemptyString,
                format :: InstructionFormat,
                requirement :: FieldConstraint || List.of(FieldConstraint), ...):
  def supplied = [requirement, ...]
  def requirements:
    if supplied.length() == 1 && supplied[0] is_a List
    | supplied[0]
    | supplied
  InstructionSpec(name, format, requirements)
