#lang rhombus
// Builds validated value/care encodings from named instruction-field constraints.
// SPDX-License-Identifier: Apache-2.0

import:
  "fields.rhm" open

export:
  InstructionEncoding
  instruction_encoding

fun require_word(word :: Nat, width :: PosInt, who :: Symbol):
  unless word <= width_mask(width)
  | error(~who: who, "instruction word must fit the encoding width")
  word

class InstructionEncoding(width :: PosInt,
                          constraints :: NonemptyList.of(FieldConstraint),
                          value :: Nat,
                          care :: Nat):
  constructor (constraints :: NonemptyList.of(FieldConstraint), width :: PosInt = 32):
    def all_bits = width_mask(width)
    def mutable value = 0
    def mutable care = 0
    for (constraint in constraints):
      unless constraint.field.high < width
      | error(~who: #'InstructionEncoding,
              "encoding constraint lies outside the instruction width")
      def overlap = care bits.and constraint.mask
      def disagreement = (value bits.xor constraint.value_bits) bits.and overlap
      when disagreement != 0
      | error(~who: #'InstructionEncoding,
              "encoding constraints assign conflicting values to the same bit")
      value := (value bits.and (all_bits bits.xor constraint.mask)) bits.or constraint.value_bits
      care := care bits.or constraint.mask
    super(width, constraints, value bits.and care, care)

  method matches(word :: Nat):
    def candidate = require_word(word, width, #'matches)
    (candidate bits.and care) == value

  method overlaps(other :: InstructionEncoding):
    unless other.width == width
    | error(~who: #'overlaps,
            "encoding overlap requires an InstructionEncoding of equal width")
    def differing = value bits.xor other.value
    def jointly_cared = care bits.and other.care
    (differing bits.and jointly_cared) == 0

  method subsumes(other :: InstructionEncoding):
    unless other.width == width
    | error(~who: #'subsumes,
            "encoding subsumption requires an InstructionEncoding of equal width")
    def shared_care = care bits.and other.care
    def differing = value bits.xor other.value
    shared_care == care && (differing bits.and care) == 0

fun instruction_encoding(constraint :: FieldConstraint || List.of(FieldConstraint), ...):
  def supplied = [constraint, ...]
  def constraints:
    if supplied.length() == 1 && supplied[0] is_a List
    | supplied[0]
    | supplied
  InstructionEncoding(constraints)
