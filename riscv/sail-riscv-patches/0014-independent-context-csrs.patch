Subject: [PATCH] Configure context CSRs independently of debug triggers

Purpose: Models harts with context state but no trigger registers or Sdtrig claim.
SPDX-License-Identifier: BSD-2-Clause

Keep trigger absence independent of context CSR presence, widths, aliases,
and Stateen permissions. The opt-in defaults off; existing Sdtrig behavior
and field widths are unchanged by the default writable masks.

diff --git a/config/config.json.in b/config/config.json.in
index a6b8fbf..59874cd 100644
--- a/config/config.json.in
+++ b/config/config.json.in
@@ -22,6 +22,10 @@
     // in the extensions with this field below.
     "misa_implemented": true,
     "writable_fiom": true,
+    // Context registers may be implemented without any debug triggers.
+    "independent_context_csrs": false,
+    "scontext_writable_mask": { "len": "xlen", "value": "0xffffffff" },
+    "mcontext_writable_mask": { "len": "xlen", "value": "0x3fff" },
     // Implementation-specific CSR WARL choices; defaults preserve native behavior.
     "hedeleg": {"delegatable_bits": {"len": 64, "value": "0xCB1FF"}},
     "hpm_events": {"restricted": false, "supported": []},
diff --git a/model/core/platform_config.sail b/model/core/platform_config.sail
index fb35142..bb10b98 100644
--- a/model/core/platform_config.sail
+++ b/model/core/platform_config.sail
@@ -228,6 +228,7 @@ let sdtrig_max_chain_limit : nat = config extensions.Sdtrig.mcontrol6.max_chain_
 let sdtrig_has_mcontext : bool = config extensions.Sdtrig.mcontext.supported
 let sdtrig_has_hcontext : bool = config extensions.Sdtrig.hcontext.supported
 let sdtrig_has_scontext : bool = config extensions.Sdtrig.scontext.supported
+let independent_context_csrs : bool = config base.independent_context_csrs
 
 type num_triggers : Int = config extensions.Sdtrig.num_triggers
 // The number of bits to index the triggers needs to fit into `tselect`,
diff --git a/model/extensions/Sdtrig/sdtrig_regs.sail b/model/extensions/Sdtrig/sdtrig_regs.sail
index 3f243b6..88a80a5 100644
--- a/model/extensions/Sdtrig/sdtrig_regs.sail
+++ b/model/extensions/Sdtrig/sdtrig_regs.sail
@@ -114,29 +114,29 @@ function tcontrol_mret_from_mmode() -> unit = {
 
 register scontext : SContext = Mk_SContext(zeros())
 mapping clause csr_name_map = 0x5a8  <-> "scontext"
-function clause is_CSR_accessible(0x5a8, _, _) = currentlyEnabled(Ext_Sdtrig) & sdtrig_has_scontext
+function clause is_CSR_accessible(0x5a8, _, _) = (currentlyEnabled(Ext_Sdtrig) | independent_context_csrs) & sdtrig_has_scontext
 function clause read_CSR(0x5a8) = scontext.bits
 function clause write_CSR(0x5a8, value) = {
-  let v = Mk_SContext(value);
+  let v = Mk_SContext(value & (config base.scontext_writable_mask : xlenbits));
   scontext = [scontext with data = v[data]];
   Ok(scontext.bits)
 }
 
 register mcontext : MContext = Mk_MContext(zeros())
 mapping clause csr_name_map = 0x7a8  <-> "mcontext"
-function clause is_CSR_accessible(0x7a8, _, _) = currentlyEnabled(Ext_Sdtrig) & (sdtrig_has_mcontext | sdtrig_has_hcontext)
+function clause is_CSR_accessible(0x7a8, _, _) = (currentlyEnabled(Ext_Sdtrig) | independent_context_csrs) & (sdtrig_has_mcontext | sdtrig_has_hcontext)
 function clause read_CSR(0x7a8) = mcontext.bits
 function clause write_CSR(0x7a8, value) = {
-  let v = Mk_MContext(value);
+  let v = Mk_MContext(value & (config base.mcontext_writable_mask : xlenbits));
   mcontext = [mcontext with hcontext = v[hcontext]];
   Ok(mcontext.bits)
 }
 
 mapping clause csr_name_map = 0x6a8  <-> "hcontext"
-function clause is_CSR_accessible(0x6a8, _, _) = currentlyEnabled(Ext_Sdtrig) & currentlyEnabled(Ext_H) & sdtrig_has_hcontext
+function clause is_CSR_accessible(0x6a8, _, _) = (currentlyEnabled(Ext_Sdtrig) | independent_context_csrs) & currentlyEnabled(Ext_H) & sdtrig_has_hcontext
 function clause read_CSR(0x6a8) = mcontext.bits
 function clause write_CSR(0x6a8, value) = {
-  let v = Mk_MContext(value);
+  let v = Mk_MContext(value & (config base.mcontext_writable_mask : xlenbits));
   mcontext = [mcontext with hcontext = v[hcontext]];
   Ok(mcontext.bits)
 }
diff --git a/model/extensions/Stateen/stateen_regs.sail b/model/extensions/Stateen/stateen_regs.sail
index bae888b..504190b 100644
--- a/model/extensions/Stateen/stateen_regs.sail
+++ b/model/extensions/Stateen/stateen_regs.sail
@@ -58,7 +58,7 @@ function legalize_mstateen0(m : Mstateen0, v : bits(64)) -> Mstateen0 = {
   [m with
     SE0     = legalize_csr_bit(mstateen0_se0, true, v[SE0]),
     ENVCFG  = legalize_csr_bit(mstateen0_envcfg, currentlyEnabled(Ext_S), v[ENVCFG]),
-    CONTEXT = legalize_csr_bit(mstateen0_context, currentlyEnabled(Ext_Sdtrig) & (sdtrig_has_scontext | sdtrig_has_hcontext), v[CONTEXT]),
+    CONTEXT = legalize_csr_bit(mstateen0_context, (currentlyEnabled(Ext_Sdtrig) | independent_context_csrs) & (sdtrig_has_scontext | sdtrig_has_hcontext), v[CONTEXT]),
     P1P13   = legalize_csr_bit(mstateen0_p1p13, delegh_csrs_are_defined & currentlyEnabled(Ext_H) & xlen == 32, v[P1P13]),
     SRMCFG  = legalize_csr_bit(mstateen0_srmcfg, currentlyEnabled(Ext_Ssqosid), v[SRMCFG]),
     FCSR    = legalize_csr_bit(mstateen0_fcsr, hartSupports(Ext_Zfinx) & (misa[F] == 0b0), v[FCSR]),
@@ -133,7 +133,7 @@ function legalize_hstateen0(h : Hstateen0, v : bits(64)) -> Hstateen0 = {
   [h with
     SE0     = v[SE0], // bit 63 of hstateen is always writable
     ENVCFG  = legalize_csr_bit(hstateen0_envcfg, true, v[ENVCFG]),
-    CONTEXT = legalize_csr_bit(hstateen0_context, currentlyEnabled(Ext_Sdtrig) & sdtrig_has_scontext, v[CONTEXT]),
+    CONTEXT = legalize_csr_bit(hstateen0_context, (currentlyEnabled(Ext_Sdtrig) | independent_context_csrs) & sdtrig_has_scontext, v[CONTEXT]),
     FCSR    = legalize_csr_bit(hstateen0_fcsr, hartSupports(Ext_Zfinx) & (misa[F] == 0b0), v[FCSR]),
     C       = legalize_csr_bit(hstateen0_c, true, v[C]),
   ];
