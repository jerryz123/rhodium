Subject: [PATCH] Preserve effective-address bits when reconstructing access-fault tval
Purpose: Keeps virtual fault addresses independent of implemented physical address width.
SPDX-License-Identifier: BSD-2-Clause

offset_virtaddr_by reconstructs the faulting effective address, not a physical
address. The access path already applied pointer masking before translation.
Truncating this result to physaddr_bits loses retained tag bits in Bare mode
and high virtual-address bits in translated mode. Retain XLEN modular offset
arithmetic and add a unit regression for positive, negative, and wrapped offsets.

diff --git a/model/sys/vmem_utils.sail b/model/sys/vmem_utils.sail
--- a/model/sys/vmem_utils.sail
+++ b/model/sys/vmem_utils.sail
@@ -42,10 +42,9 @@
 // of the corresponding `virtaddr`.  In particular, since the original
 // `virtaddr` access may be split into smaller `physaddr` accesses,
 // the correct offset from the base `virtaddr` needs to be reported.
 // Since `virtaddr` accesses that straddle page boundaries are already
-// split, the offset computation is quite simple. The result is also
-// masked to physaddr_bits, since bits above it aren't part of any
-// physical address this configuration implements.
+// split, the offset computation is quite simple. Retain effective-address
+// bits, including bits above the implemented physical address width.
 
 function offset_virtaddr_by(
   Virtaddr(base_vaddr) : virtaddr,
@@ -53,9 +52,7 @@ function offset_virtaddr_by(
 ) -> virtaddr = {
   // Physical addresses may have a different size.
   let offset = (exc_paddr - base_paddr)[xlen - 1 .. 0];
-  let reconstructed = base_vaddr + offset;
-  let masked = if physaddr_bits < xlen then reconstructed & zero_extend(ones(physaddr_bits)) else reconstructed;
-  Virtaddr(masked)
+  Virtaddr(base_vaddr + offset)
 }
 
 // The context for an access.
diff --git a/model/riscv.sail_project b/model/riscv.sail_project
--- a/model/riscv.sail_project
+++ b/model/riscv.sail_project
@@ -609,6 +609,7 @@ unit_tests {
 
   files
     unit_tests/test_mstatus.sail,
+    unit_tests/test_vmem_utils.sail,
 }
 
 main {
diff --git a/model/unit_tests/test_vmem_utils.sail b/model/unit_tests/test_vmem_utils.sail
new file mode 100644
--- /dev/null
+++ b/model/unit_tests/test_vmem_utils.sail
@@ -0,0 +1,17 @@
+// Fault addresses preserve effective bits above physaddr_bits and XLEN wrapping.
+// SPDX-License-Identifier: BSD-2-Clause
+$[test]
+function test_effective_fault_address_offsets() -> unit = {
+  let base : xlenbits = ~(zero_extend(0x0010));
+  let forward : xlenbits = zero_extend(0x0007);
+  let backward : xlenbits = zero_extend(0x0003);
+  let pbase : physaddrbits = zero_extend(0x2000);
+  let pforward : physaddrbits = zero_extend(0x2007);
+  let pbackward : physaddrbits = zero_extend(0x1ffd);
+  assert(bits_of(offset_virtaddr_by(Virtaddr(base), Physaddr(pbase),
+                                 Physaddr(pforward))) == base + forward);
+  assert(bits_of(offset_virtaddr_by(Virtaddr(base), Physaddr(pbase),
+                                 Physaddr(pbackward))) == base - backward);
+  assert(bits_of(offset_virtaddr_by(Virtaddr(ones()), Physaddr(pbase),
+                                 Physaddr(pforward))) == forward - 1);
+}
