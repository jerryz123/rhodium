   let meta = if read_meta then __ReadRAM_Meta(addr, width) else default_meta;
   let request : Mem_request('n, 0, physaddrbits_len, unit, access_kind) = struct {
     access_kind = match rk {
diff --git a/model/sys/interrupt_implementation.sail b/model/sys/interrupt_implementation.sail
index 07f9191e..c630ee9c 100644
--- a/model/sys/interrupt_implementation.sail
+++ b/model/sys/interrupt_implementation.sail
@@ -9,9 +9,16 @@
 // This aggregates the information from the interrupts controllers in
 // the system, which currently are the CLINT and the SIG.
 
-function external_interrupts_pending(hgeie_val : xlenbits) -> Minterrupts =
+// Embedded callers supply external interrupt pins, never CSR pending state.
+val host_external_interrupts = pure {cpp: "host_external_interrupts"} : unit -> bits(64)
+function host_external_interrupts() = zeros()
+
+function external_interrupts_pending(hgeie_val : xlenbits) -> Minterrupts = {
   // The CLINT doesn't deal with external interrupts.
-  if plat_have_sig then sig_external_interrupts_pending(hgeie_val) else Mk_Minterrupts(zeros())
+  let pending = if plat_have_sig then sig_external_interrupts_pending(hgeie_val) else Mk_Minterrupts(zeros());
+  let pins = host_external_interrupts();
+  [pending with MEI = pending[MEI] | pins[11], SEI = pending[SEI] | (if currentlyEnabled(Ext_S) then pins[9] else 0b0)]
+}
 
 function machine_software_interrupt_pending() -> bits(1) =
   (if plat_have_clint then clint_machine_software_interrupt_pending() else 0b0)
