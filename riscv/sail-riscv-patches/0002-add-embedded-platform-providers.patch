+val host_memory_read = {cpp: "host_memory_read"} : forall 'n, 0 < 'n <= max_mem_access . (bits(64), int('n), bool) -> bits(8 * 'n)
+function host_memory_read(_, width, _) = zeros(8 * width)
+val host_memory_write = {cpp: "host_memory_write"} : forall 'n, 0 < 'n <= max_mem_access . (bits(64), int('n), bits(8 * 'n)) -> bool
+function host_memory_write(_, _, _) = false
+
 instantiation sail_mem_write with
   'addr_size = physaddrbits_len,
   'addr_space = unit,
@@ -158,6 +166,7 @@ val write_ram : forall 'n, 0 < 'n <= max_mem_access.
   (write_kind, MemoryAccessType(mem_payload), physaddr, int('n), bits(8 * 'n), mem_meta) -> bool
 
 function write_ram(wk, access, Physaddr(addr), width, data, meta) = {
+  if host_memory_enabled() then return host_memory_write(zero_extend(addr), width, data);
   let request : Mem_request('n, 0, physaddrbits_len, unit, access_kind) = struct {
