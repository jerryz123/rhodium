Subject: [PATCH] Add opt-in physical memory and external interrupt providers

Purpose: Embed the generated model without replacing architectural access checks.
SPDX-License-Identifier: BSD-2-Clause

Keep standalone behavior unchanged; hosts opt into replacing physical RAM reads
and writes and supplying MEI/SEI input pins. Device replay happens before load
extension, not by substituting an architectural destination register.
The v2 access classification distinguishes fetches independently of ordering;
address announcements remain observations, not committed host writes.

diff --git a/c_emulator/riscv_platform_if.h b/c_emulator/riscv_platform_if.h
index 72e6d848..b16fc8c9 100644
--- a/c_emulator/riscv_platform_if.h
+++ b/c_emulator/riscv_platform_if.h
@@ -1,3 +1,5 @@
+// Declares the replaceable platform boundary for the generated RISC-V model.
+// SPDX-License-Identifier: BSD-2-Clause
 #pragma once
 
 #include "sail.h"
@@ -26,6 +28,12 @@ struct zz5vecz8z5unionz0zzoptionzzIRTLB_EntryzzKz9;
 
 class PlatformInterface {
 public:
+  // Opt-in embedding hooks; ordinary command-line execution keeps its own memory.
+  virtual bool host_memory_enabled(unit);
+  virtual void host_memory_read(lbits *result, fbits address, int64_t bytes, bool instruction);
+  virtual bool host_memory_write(fbits address, int64_t bytes, lbits value);
+  virtual fbits host_external_interrupts(unit);
+
   virtual unit fetch_callback(sbits opcode);
 
   virtual unit mem_write_callback(const char *type, sbits paddr, int64_t width, lbits value);
diff --git a/c_emulator/riscv_platform_if.cpp b/c_emulator/riscv_platform_if.cpp
index 455eed26..8f3516c9 100644
--- a/c_emulator/riscv_platform_if.cpp
+++ b/c_emulator/riscv_platform_if.cpp
@@ -1,7 +1,21 @@
+// Supplies inert defaults for optional platform services and observations.
+// SPDX-License-Identifier: BSD-2-Clause
 #include "riscv_platform_if.h"
 
 #include "sail_riscv_model.h"
 
+// Default-disabled providers preserve the standalone emulator's behavior.
+bool PlatformInterface::host_memory_enabled(unit) { return false; }
+void PlatformInterface::host_memory_read(lbits *result, fbits, int64_t bytes, bool) {
+  sail_int size;
+  CREATE(sail_int)(&size);
+  CONVERT_OF(sail_int, mach_int)(&size, bytes * 8);
+  zeros(result, size);
+  KILL(sail_int)(&size);
+}
+bool PlatformInterface::host_memory_write(fbits, int64_t, lbits) { return false; }
+fbits PlatformInterface::host_external_interrupts(unit) { return 0; }
+
 // We must provide default implementations so the automatically generated
 // model_test() function can instantiate hart::Model.
 //
diff --git a/model/core/phys_mem_interface.sail b/model/core/phys_mem_interface.sail
index 688350c8..c507ba30 100644
--- a/model/core/phys_mem_interface.sail
