Subject: [PATCH] Supply embedded HPM counter reads and overflow events

Purpose: Keep implementation-defined event counting outside the reference while
preserving Sail CSR access, read-modify-write, selector, and interrupt semantics.
SPDX-License-Identifier: BSD-2-Clause

Default hooks preserve standalone behavior. Only implemented counters 3..31
can be sampled. Overflow events update sticky OF and LCOFIP before arbitration;
cycle, time, and instret retain their existing providers.

diff --git a/c_emulator/riscv_platform_if.cpp b/c_emulator/riscv_platform_if.cpp
index 35e721e9..7d3ebfeb 100644
--- a/c_emulator/riscv_platform_if.cpp
+++ b/c_emulator/riscv_platform_if.cpp
@@ -19,6 +19,9 @@ bool PlatformInterface::host_time_enabled(unit) { return false; }
 fbits PlatformInterface::host_time(unit) { return 0; }
 bool PlatformInterface::host_interrupt_boundary(unit) { return true; }
 bool PlatformInterface::host_wrs_early_wake(unit) { return false; }
+fbits PlatformInterface::host_hpm_counters(unit) { return 0; }
+fbits PlatformInterface::host_hpm_counter(fbits) { return 0; }
+fbits PlatformInterface::host_hpm_overflows(unit) { return 0; }
 
 // We must provide default implementations so the automatically generated
 // model_test() function can instantiate hart::Model.
diff --git a/c_emulator/riscv_platform_if.h b/c_emulator/riscv_platform_if.h
index 798ca70c..7a0e0614 100644
--- a/c_emulator/riscv_platform_if.h
+++ b/c_emulator/riscv_platform_if.h
@@ -40,6 +40,9 @@ public:
   virtual fbits host_time(unit);
   virtual bool host_interrupt_boundary(unit);
   virtual bool host_wrs_early_wake(unit);
+  virtual fbits host_hpm_counters(unit);
+  virtual fbits host_hpm_counter(fbits index);
+  virtual fbits host_hpm_overflows(unit);
 
   virtual unit fetch_callback(sbits opcode);
 
diff --git a/model/core/counters.sail b/model/core/counters.sail
index c0fa5c60..9039a847 100644
--- a/model/core/counters.sail
+++ b/model/core/counters.sail
@@ -190,6 +190,44 @@ function read_mhpmcounter(index : hpmidx) -> xlenbits = mhpmcounter[index][(xlen
 function read_mhpmcounterh(index : hpmidx) -> bits(32) = mhpmcounter[index][63 .. 32]
 function read_mhpmevent(index : hpmidx) -> xlenbits = mhpmevent[index][(xlen - 1) .. 0]
 
+// Raw host inputs are sampled only after the CSR permission checks.
+val host_hpm_counters = pure {cpp: "host_hpm_counters"} : unit -> bits(32)
+function host_hpm_counters() = zeros()
+val host_hpm_counter = pure {cpp: "host_hpm_counter"} : bits(5) -> bits(64)
+function host_hpm_counter(_index) = zeros()
+val host_hpm_overflows = pure {cpp: "host_hpm_overflows"} : unit -> bits(32)
+function host_hpm_overflows() = zeros()
+
+// Host pulses update sticky OF and LCOFIP through the reference's own policy.
+function apply_host_hpm_overflows(pending : Minterrupts) -> Minterrupts = {
+  var updated = pending;
+  if currentlyEnabled(Ext_Sscofpmf) then {
+    let overflows = host_hpm_overflows() & sys_writable_hpm_counters;
+    foreach (index from 3 to 31) {
+      if overflows[index] == 0b1 then {
+        let event = Mk_HpmEvent(mhpmevent[index]);
+        if event[OF] == 0b0 then updated[LCOFI] = 0b1;
+        mhpmevent[index] = [event with OF = 0b1].bits;
+      }
+    }
+  };
+  updated
+}
+
+function sample_hpm_counter(index : hpmidx) -> unit =
+  if sys_writable_hpm_counters[index] == 0b1 & host_hpm_counters()[index] == 0b1 then
+    mhpmcounter[index] = legalize_hpmcounter_value(host_hpm_counter(to_bits(5, index)))
+
+function read_sampled_hpmcounter(index : hpmidx) -> xlenbits = {
+  sample_hpm_counter(index);
+  read_mhpmcounter(index)
+}
+
+function read_sampled_hpmcounterh(index : hpmidx) -> bits(32) = {
+  sample_hpm_counter(index);
+  read_mhpmcounterh(index)
+}
+
 // This index tracks any HPM event selector CSR and counter CSR
 // written by the current instruction. If the event for that counter
 // fires during that write, the counter should not be incremented,
@@ -254,8 +292,8 @@ function clause write_CSR((0b0011001 /* 0x320 */ @ index : bits(5), value) if un
 function clause is_CSR_accessible((0b1011000 /* 0xB00 */ @ index : bits(5), _, _) if unsigned(index) >= 3) = true // mhpmcounter3..31
 function clause is_CSR_accessible((0b1011100 /* 0xB80 */ @ index : bits(5), _, _) if unsigned(index) >= 3) = xlen == 32 // mhpmcounterh3..31
 
-function clause read_CSR(0b1011000 /* 0xB00 */ @ index : bits(5) if unsigned(index) >= 3) = read_mhpmcounter(hpmidx_from_bits(index))
-function clause read_CSR(0b1011100 /* 0xB80 */ @ index : bits(5) if xlen == 32 & unsigned(index) >= 3) = read_mhpmcounterh(hpmidx_from_bits(index))
+function clause read_CSR(0b1011000 /* 0xB00 */ @ index : bits(5) if unsigned(index) >= 3) = read_sampled_hpmcounter(hpmidx_from_bits(index))
+function clause read_CSR(0b1011100 /* 0xB80 */ @ index : bits(5) if xlen == 32 & unsigned(index) >= 3) = read_sampled_hpmcounterh(hpmidx_from_bits(index))
 
 function clause write_CSR((0b1011000 /* 0xB00 */ @ index : bits(5), value) if unsigned(index) >= 3) = {
   let index = hpmidx_from_bits(index);
@@ -279,6 +317,9 @@ function dispatchEventCounter(index : hpmidx, event_priv : Privilege) -> unit =
   // This must be a writable event counter.
   assert(sys_writable_hpm_counters[index] == 0b1);
 
+  // Host-owned counters and overflows are already sampled at admission.
+  if host_hpm_counters()[index] == 0b1 then return ();
+
   if mcountinhibit[HPM][index - 3] == 0b1 then return ();
 
   // Filter the privilege mode according to Sscofpmf.
diff --git a/model/core/interrupt_regs.sail b/model/core/interrupt_regs.sail
index bcbbb3de..2ca89d60 100644
--- a/model/core/interrupt_regs.sail
+++ b/model/core/interrupt_regs.sail
@@ -246,6 +246,9 @@ function read_mip(read_type : XipReadType) -> Minterrupts = {
   else pending
 }
 
+// The counter implementation supplies sticky overflow updates before arbitration.
+val apply_host_hpm_overflows : Minterrupts -> Minterrupts
+
 // This should be called once at the start of instruction execution.
 // It updates the bits in `mip` that are written by platform-specific
 // interrupt controllers, except those for external interrupts.
@@ -267,6 +270,8 @@ function update_mip() -> unit = {
   // to the mask for supported interrupts.
   var new_mip = mip;
 
+  new_mip = apply_host_hpm_overflows(new_mip);
+
   new_mip[MSI] = machine_software_interrupt_pending();
 
   if platform_has_timer then {
diff --git a/model/extensions/Zihpm/zihpm.sail b/model/extensions/Zihpm/zihpm.sail
index ddf33448..2b2973ea 100644
--- a/model/extensions/Zihpm/zihpm.sail
+++ b/model/extensions/Zihpm/zihpm.sail
@@ -74,5 +74,5 @@ mapping clause csr_name_map = 0xC9F  <-> "hpmcounter31h"
 function clause is_CSR_accessible((0b1100000 /* 0xC00 */ @ index : bits(5), priv, _) if unsigned(index) >= 3) = currentlyEnabled(Ext_Zihpm) & counter_enabled(unsigned(index), priv) // hpmcounter3..31
 function clause is_CSR_accessible((0b1100100 /* 0xC80 */ @ index : bits(5), priv, _) if unsigned(index) >= 3) = currentlyEnabled(Ext_Zihpm) & xlen == 32 & counter_enabled(unsigned(index), priv) // hpmcounterh3..31
 
-function clause read_CSR(0b1100000 /* 0xC00 */ @ index : bits(5) if unsigned(index) >= 3) = read_mhpmcounter(hpmidx_from_bits(index))
-function clause read_CSR(0b1100100 /* 0xC80 */ @ index : bits(5) if xlen == 32 & unsigned(index) >= 3) = read_mhpmcounterh(hpmidx_from_bits(index))
+function clause read_CSR(0b1100000 /* 0xC00 */ @ index : bits(5) if unsigned(index) >= 3) = read_sampled_hpmcounter(hpmidx_from_bits(index))
+function clause read_CSR(0b1100100 /* 0xC80 */ @ index : bits(5) if xlen == 32 & unsigned(index) >= 3) = read_sampled_hpmcounterh(hpmidx_from_bits(index))
