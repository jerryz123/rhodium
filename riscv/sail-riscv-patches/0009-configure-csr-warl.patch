Subject: [PATCH] Configure implementation-owned CSR WARL choices

Purpose: Preserve exact delegation, HPM selector, and pointer-mask policies.
SPDX-License-Identifier: BSD-2-Clause

Defaults retain upstream behavior. Restricted HPM selectors normalize unsupported
events to zero without changing Sscofpmf overflow/filter fields or implementing
counter events. PMM normalization covers all pointer-masking controls.

diff --git a/config/config.json.in b/config/config.json.in
index dceaf4aa..a6b8fbfe 100644
--- a/config/config.json.in
+++ b/config/config.json.in
@@ -22,6 +22,10 @@
     // in the extensions with this field below.
     "misa_implemented": true,
     "writable_fiom": true,
+    // Implementation-specific CSR WARL choices; defaults preserve native behavior.
+    "hedeleg": {"delegatable_bits": {"len": 64, "value": "0xCB1FF"}},
+    "hpm_events": {"restricted": false, "supported": []},
+    "pmm_unsupported_write_to_disabled": false,
     // The top 29 bits in this value control whether the corresponding
     // HPM counters (hpmcounter31 .. hpmcounter3) are supported
     // (i.e. are not read-only zero). A set bit specifies that the
diff --git a/model/core/counters.sail b/model/core/counters.sail
index e257aeb0..c0fa5c60 100644
--- a/model/core/counters.sail
+++ b/model/core/counters.sail
@@ -150,9 +150,21 @@ function hpmidx_from_bits(b : bits(5)) -> hpmidx = {
   index
 }
 
+// Empty restricted selector lists make every event normalize to zero.
+private function supported_hpm_event(event : bits(64), events : list(bits(32))) -> bool =
+  match events {
+    [||] => false,
+    candidate :: rest => event == zero_extend(candidate) | supported_hpm_event(event, rest),
+  }
+
+private function legalize_hpm_selector(event : bits(64)) -> bits(64) =
+  if not(config base.hpm_events.restricted : bool)
+     | supported_hpm_event(event, config base.hpm_events.supported)
+  then event else zeros()
+
 function legalize_hpmevent(v : bits(64)) -> bits(64) = {
   if not(currentlyEnabled(Ext_Sscofpmf))
-  then return zero_extend(v[plat_hpmevent_width_bits - 1 .. 0]);
+  then return legalize_hpm_selector(zero_extend(v[plat_hpmevent_width_bits - 1 .. 0]));
 
   assert(plat_hpmevent_width_bits <= 56);
   let v = Mk_HpmEvent(v);
@@ -164,7 +176,7 @@ function legalize_hpmevent(v : bits(64)) -> bits(64) = {
     UINH  = if currentlyEnabled(Ext_Sscofpmf) & currentlyEnabled(Ext_U) then v[UINH] else 0b0,
     VSINH = if currentlyEnabled(Ext_Sscofpmf) & currentlyEnabled(Ext_H) then v[VSINH] else 0b0,
     VUINH = if currentlyEnabled(Ext_Sscofpmf) & currentlyEnabled(Ext_H) then v[VUINH] else 0b0,
-    event = zero_extend(v[event][plat_hpmevent_width_bits - 1 .. 0]),
+    event = legalize_hpm_selector(zero_extend(v[event][plat_hpmevent_width_bits - 1 .. 0]))[55 .. 0],
   ].bits
 }
 
diff --git a/model/core/interrupt_regs.sail b/model/core/interrupt_regs.sail
index 756d0c0f..f1b26426 100644
--- a/model/core/interrupt_regs.sail
+++ b/model/core/interrupt_regs.sail
@@ -404,7 +404,7 @@ function hedeleg_writable_mask() -> bits(64) =
   ].bits
 
 private function legalize_hedeleg(_m : Medeleg, v : bits(64)) -> Medeleg =
-  Mk_Medeleg(v & hedeleg_writable_mask())
+  Mk_Medeleg(v & hedeleg_writable_mask() & (config base.hedeleg.delegatable_bits : bits(64)))
 
 private function legalize_hideleg(m : Minterrupts, v : xlenbits) -> Minterrupts = {
   let v = Mk_Minterrupts(v);
diff --git a/model/core/sys_regs.sail b/model/core/sys_regs.sail
