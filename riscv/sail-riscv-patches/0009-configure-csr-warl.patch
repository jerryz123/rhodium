     HUKTE = if currentlyEnabled(Ext_Svukte) then v[HUKTE] else 0b0,
@@ -399,7 +399,7 @@ private function legalize_mseccfg(o : Seccfg, v : bits(64)) -> Seccfg = {
 
   let v = Mk_Seccfg(v);
