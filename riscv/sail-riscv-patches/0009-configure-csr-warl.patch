   [h with
     // HUPMM controls pointer masking for HLV.*/HSV in U-mode (effective VU)
-    HUPMM = if currentlyEnabled(Ext_Ssnpm) & is_supported_pmm(PM_SSNPM, pmm_mode(v[HUPMM])) then v[HUPMM] else h[HUPMM],
