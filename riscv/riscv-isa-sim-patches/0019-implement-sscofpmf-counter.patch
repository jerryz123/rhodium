+
+// One instruction-precise, 64-bit performance counter, with RV32 CSR aliases.
+class hpm_counter_csr_t: public basic_csr_t {
+ public:
+  hpm_counter_csr_t(processor_t* proc, std::shared_ptr<mevent_csr_t> selector);
+  void begin_instruction() noexcept;
+  void finish_instruction(bool retired, bool attempted) noexcept;
+ protected:
+  bool unlogged_write(reg_t val) noexcept override;
+ private:
+  std::shared_ptr<mevent_csr_t> selector;
+  uint64_t selector_version = 0;
+  reg_t event = 0;
+  bool written = false;
 };
 
