 bool mevent_csr_t::unlogged_write(const reg_t val) noexcept {
-  const reg_t mask = proc->extension_enabled(EXT_SSCOFPMF) ? MHPMEVENT_OF | MHPMEVENT_MINH
+  ++write_version;
+  const bool implemented = address == CSR_MHPMEVENT3 && proc->extension_enabled_const(EXT_SSCOFPMF);
+  const reg_t mask = implemented ? MHPMEVENT_OF | MHPMEVENT_MINH
     | (proc->extension_enabled_const('U') ? MHPMEVENT_UINH : 0)
     | (proc->extension_enabled_const('S') ? MHPMEVENT_SINH : 0)
     | (proc->extension_enabled('H') ? MHPMEVENT_VUINH | MHPMEVENT_VSINH : 0) : 0;
-  return basic_csr_t::unlogged_write(val & mask);
+  const reg_t event = val & ((reg_t(1) << 56) - 1);
+  return basic_csr_t::unlogged_write((val & mask) | (implemented && event <= 2 ? event : 0));
+}
+
+hpm_counter_csr_t::hpm_counter_csr_t(processor_t* proc, std::shared_ptr<mevent_csr_t> selector):
+  basic_csr_t(proc, CSR_MHPMCOUNTER3, 0), selector(selector) {}
+
+bool hpm_counter_csr_t::unlogged_write(reg_t val) noexcept {
+  written = true;
+  return basic_csr_t::unlogged_write(val);
+}
+
+void hpm_counter_csr_t::begin_instruction() noexcept {
+  written = false;
+  selector_version = selector->write_version;
+  const reg_t config = selector->read();
+  const reg_t filter = state->prv == PRV_M ? MHPMEVENT_MINH
+    : state->prv == PRV_S ? (state->v ? MHPMEVENT_VSINH : MHPMEVENT_SINH)
+    : (state->v ? MHPMEVENT_VUINH : MHPMEVENT_UINH);
+  event = state->debug_mode || (config & filter) || (state->mcountinhibit->read() & 8)
+    ? 0 : config & ((reg_t(1) << 56) - 1);
+}
+
+void hpm_counter_csr_t::finish_instruction(bool retired, bool attempted) noexcept {
+  // Event 1 is a functional-model execution cycle, not a platform clock tick.
+  // Capture privilege before xRET/traps, and suppress either CSR's write cycle.
+  if (written || selector_version != selector->write_version ||
+      !((event == 1 && attempted) || (event == 2 && retired)))
+    return;
+  const reg_t next = read() + 1;
+  basic_csr_t::unlogged_write(next);
+  if (next == 0 && !(selector->read() & MHPMEVENT_OF)) {
+    selector->write(selector->read() | MHPMEVENT_OF);
+    state->mip->backdoor_write_with_mask(MIP_LCOFIP, MIP_LCOFIP);
+  }
 }
 
 hypervisor_csr_t::hypervisor_csr_t(processor_t* const proc, const reg_t addr):

