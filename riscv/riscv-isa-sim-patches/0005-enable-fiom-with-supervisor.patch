From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jerry Zhao <jerryz123@berkeley.edu>
Subject: [PATCH] Make FIOM writable with supervisor mode
Purpose: Preserves privileged-ISA FIOM CSR semantics in the embedded Spike hart.
SPDX-License-Identifier: Apache-2.0

FIOM may be read-only zero when satp.MODE is always Bare, but need not be.
Expose it in both machine and supervisor environment configuration CSR masks
whenever supervisor mode is implemented, including Bare-only harts.

diff --git a/riscv/csr_init.cc b/riscv/csr_init.cc
--- a/riscv/csr_init.cc
+++ b/riscv/csr_init.cc
@@ -237,2 +237,3 @@ void processor_t::register_csrs()
-  const reg_t menvcfg_mask = (proc->extension_enabled(EXT_ZICBOM) ? MENVCFG_CBCFE | MENVCFG_CBIE : 0) |
+  const reg_t menvcfg_mask = (proc->extension_enabled('S') ? MENVCFG_FIOM : 0) |
+                            (proc->extension_enabled(EXT_ZICBOM) ? MENVCFG_CBCFE | MENVCFG_CBIE : 0) |
                             (proc->extension_enabled(EXT_ZICBOZ) ? MENVCFG_CBZE : 0) |
@@ -347,2 +348,3 @@ void processor_t::register_csrs()
-  const reg_t senvcfg_mask = (proc->extension_enabled(EXT_ZICBOM) ? SENVCFG_CBCFE | SENVCFG_CBIE : 0) |
+  const reg_t senvcfg_mask = (proc->extension_enabled('S') ? SENVCFG_FIOM : 0) |
+                            (proc->extension_enabled(EXT_ZICBOM) ? SENVCFG_CBCFE | SENVCFG_CBIE : 0) |
                             (proc->extension_enabled(EXT_ZICBOZ) ? SENVCFG_CBZE : 0) |
