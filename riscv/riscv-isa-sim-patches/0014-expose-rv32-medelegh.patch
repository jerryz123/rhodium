From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jerry Zhao <jerryz123@berkeley.edu>
Subject: [PATCH] Expose RV32 medelegh
Purpose: Implements the RV32 high-half alias of machine exception delegation.
SPDX-License-Identifier: Apache-2.0

The existing medeleg CSR holds the complete exception-delegation state, but
RV32 Spike does not register its architectural high-half alias at 0x312.
Expose the alias with the existing high-half CSR proxy. Unsupported high
exception causes remain read-only zero through medeleg's existing mask.

diff --git a/riscv/csr_init.cc b/riscv/csr_init.cc
--- a/riscv/csr_init.cc
+++ b/riscv/csr_init.cc
@@ -188,5 +188,7 @@ void processor_t::register_csrs()
   add_hypervisor_csr(CSR_HIE, std::make_shared<mie_proxy_csr_t>(proc, CSR_HIE, hip_hie_accr));
 
   add_supervisor_csr(CSR_MEDELEG, medeleg = std::make_shared<medeleg_csr_t>(proc, CSR_MEDELEG));
+  if (xlen == 32)
+    add_supervisor_csr(CSR_MEDELEGH, std::make_shared<rv32_high_csr_t>(proc, CSR_MEDELEGH, medeleg));
   mideleg = std::make_shared<mideleg_csr_t>(proc, CSR_MIDELEG);
   if (xlen == 32 && proc->extension_enabled_const(EXT_SMAIA)) {
