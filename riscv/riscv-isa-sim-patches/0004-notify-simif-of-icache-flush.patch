From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jerry Zhao <jerryz123@berkeley.edu>
Subject: [PATCH] Separate instruction synchronization from decoded-cache invalidation
Purpose: Notify external instruction caches only for architectural FENCE.I synchronization.
SPDX-License-Identifier: Apache-2.0

Translation and privilege changes invalidate Spike's virtual decoded cache,
not an embedding simulator's physically addressed instruction lines. Keep
flush_icache local to the MMU and notify the external model only from FENCE.I.

diff --git a/riscv/insns/fence_i.h b/riscv/insns/fence_i.h
index 38dcaf3f..3ed7344e 100644
--- a/riscv/insns/fence_i.h
+++ b/riscv/insns/fence_i.h
@@ -1 +1 @@
-MMU.flush_icache();
+MMU.fence_i();
diff --git a/riscv/mmu.h b/riscv/mmu.h
index 1fbc0a40..a169b0fb 100644
--- a/riscv/mmu.h
+++ b/riscv/mmu.h
@@ -370,6 +370,12 @@ public:
 
   void flush_tlb();
   void flush_icache();
+  /* Synchronize architectural instruction fetch, including external physical caches. */
+  void fence_i() {
+    flush_icache();
+    sim->sync_instruction_cache();
+  }
+
 
   void register_memtracer(memtracer_t*);
 
diff --git a/riscv/simif.h b/riscv/simif.h
index ca545e21..d02acf0d 100644
--- a/riscv/simif.h
+++ b/riscv/simif.h
@@ -22,5 +22,7 @@ public:
   virtual bool mmio_load(reg_t paddr, size_t len, uint8_t* bytes) = 0;
   virtual bool mmio_store(reg_t paddr, size_t len, const uint8_t* bytes) = 0;
   virtual bool is_debug_module_access(reg_t, size_t) { return false; }
+  // Architectural instruction synchronization; translation flushes do not call this hook.
+  virtual void sync_instruction_cache() {}
   // Callback for processors to let the simulation know they were reset.
   virtual void proc_reset(unsigned id) = 0;
