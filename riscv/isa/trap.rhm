#lang rhombus
// Defines synchronous exception causes and their architectural cause codes.
// SPDX-License-Identifier: Apache-2.0

enum ExceptionCause
| InstructionAddressMisaligned
| InstructionAccessFault
| IllegalInstruction
| Breakpoint
| LoadAddressMisaligned
| LoadAccessFault
| StoreAddressMisaligned
| StoreAccessFault
| EnvironmentCallFromUser
| EnvironmentCallFromSupervisor
| EnvironmentCallFromMachine
| InstructionPageFault
| LoadPageFault
| StorePageFault

fun exception_code(cause :: ExceptionCause) :: Nat:
  match cause
  | ExceptionCause.InstructionAddressMisaligned: 0
  | ExceptionCause.InstructionAccessFault: 1
  | ExceptionCause.IllegalInstruction: 2
  | ExceptionCause.Breakpoint: 3
  | ExceptionCause.LoadAddressMisaligned: 4
  | ExceptionCause.LoadAccessFault: 5
  | ExceptionCause.StoreAddressMisaligned: 6
  | ExceptionCause.StoreAccessFault: 7
  | ExceptionCause.EnvironmentCallFromUser: 8
  | ExceptionCause.EnvironmentCallFromSupervisor: 9
  | ExceptionCause.EnvironmentCallFromMachine: 11
  | ExceptionCause.InstructionPageFault: 12
  | ExceptionCause.LoadPageFault: 13
  | ExceptionCause.StorePageFault: 15

fun exception_mask(causes :: List.of(ExceptionCause)) :: Nat:
  def mutable mask = 0
  for (cause in causes):
    mask := mask bits.or (1 bits.(<<) exception_code(cause))
  mask

export:
  ExceptionCause
  exception_code
  exception_mask
