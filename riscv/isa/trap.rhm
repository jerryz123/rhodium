#lang rhombus
/* Defines synchronous exception causes and their architectural cause codes. */
// SPDX-License-Identifier: Apache-2.0

/* Names synchronous architectural exception causes independently of trap-handler state. */
enum ExceptionCause
| InstructionAddressMisaligned
| InstructionAccessFault
| IllegalInstruction
| Breakpoint
| LoadAddressMisaligned
| LoadAccessFault
| StoreAddressMisaligned
| StoreAccessFault
| EnvironmentCallFromUser
| EnvironmentCallFromSupervisor
| EnvironmentCallFromMachine
| InstructionPageFault
| LoadPageFault
| StorePageFault
| SoftwareCheck
| HardwareError
| EnvironmentCallFromVirtualSupervisor
| InstructionGuestPageFault
| LoadGuestPageFault
| VirtualInstruction
| StoreGuestPageFault

def HypervisorExceptionCauses = [
  ExceptionCause.EnvironmentCallFromVirtualSupervisor,
  ExceptionCause.InstructionGuestPageFault,
  ExceptionCause.LoadGuestPageFault,
  ExceptionCause.VirtualInstruction,
  ExceptionCause.StoreGuestPageFault
]

def DelegatableExceptionCauses = [
  ExceptionCause.InstructionAddressMisaligned,
  ExceptionCause.InstructionAccessFault,
  ExceptionCause.IllegalInstruction,
  ExceptionCause.Breakpoint,
  ExceptionCause.LoadAddressMisaligned,
  ExceptionCause.LoadAccessFault,
  ExceptionCause.StoreAddressMisaligned,
  ExceptionCause.StoreAccessFault,
  ExceptionCause.EnvironmentCallFromUser,
  ExceptionCause.EnvironmentCallFromSupervisor,
  ExceptionCause.InstructionPageFault,
  ExceptionCause.LoadPageFault,
  ExceptionCause.StorePageFault,
  ExceptionCause.SoftwareCheck,
  ExceptionCause.HardwareError
]

/* Maps an exception cause to its architectural exception number. */
fun exception_code(cause :: ExceptionCause) :: Nat:
  match cause
  | ExceptionCause.InstructionAddressMisaligned: 0
  | ExceptionCause.InstructionAccessFault: 1
  | ExceptionCause.IllegalInstruction: 2
  | ExceptionCause.Breakpoint: 3
  | ExceptionCause.LoadAddressMisaligned: 4
  | ExceptionCause.LoadAccessFault: 5
  | ExceptionCause.StoreAddressMisaligned: 6
  | ExceptionCause.StoreAccessFault: 7
  | ExceptionCause.EnvironmentCallFromUser: 8
  | ExceptionCause.EnvironmentCallFromSupervisor: 9
  | ExceptionCause.EnvironmentCallFromMachine: 11
  | ExceptionCause.InstructionPageFault: 12
  | ExceptionCause.LoadPageFault: 13
  | ExceptionCause.StorePageFault: 15
  | ExceptionCause.SoftwareCheck: 18
  | ExceptionCause.HardwareError: 19
  | ExceptionCause.EnvironmentCallFromVirtualSupervisor: 10
  | ExceptionCause.InstructionGuestPageFault: 20
  | ExceptionCause.LoadGuestPageFault: 21
  | ExceptionCause.VirtualInstruction: 22
  | ExceptionCause.StoreGuestPageFault: 23

/* Combines exception causes into a host delegation/selection mask. */
fun exception_mask(causes :: List.of(ExceptionCause)) :: Nat:
  def mutable mask = 0
  for (cause in causes):
    mask := mask bits.or (1 bits.(<<) exception_code(cause))
  mask

export:
  ExceptionCause
  DelegatableExceptionCauses
  HypervisorExceptionCauses
  exception_code
  exception_mask
