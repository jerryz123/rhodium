#lang rhombus
// Defines the ratified RV32 and RV64 Zbb basic bit-manipulation catalogs.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../support/annotations.rhm" open
  "../model/main.rhm" open
  "integer-common.rhm" open

def OP_32 = 0x3B
def OP_IMM_32 = 0x1B

fun unary_instruction(name :: NonemptyString,
                      opcode_value :: Nat,
                      function3 :: Nat,
                      immediate :: Nat):
  instruction(name,
              UnaryFormat,
              [opcode.constrain(opcode_value), funct3.constrain(function3), immediate12.constrain(immediate)])

fun shift32_instruction(name :: NonemptyString,
                        opcode_value :: Nat,
                        function3 :: Nat,
                        function7 :: Nat):
  instruction(name,
              Shift32Format,
              [opcode.constrain(opcode_value), funct3.constrain(function3), funct7.constrain(function7)])

fun shift64_instruction(name :: NonemptyString,
                        opcode_value :: Nat,
                        function3 :: Nat,
                        function6 :: Nat):
  instruction(name,
              Shift64Format,
              [opcode.constrain(opcode_value), funct3.constrain(function3), funct6.constrain(function6)])

def ANDN = register_instruction("ANDN", OP, 7, 0x20)
def ORN = register_instruction("ORN", OP, 6, 0x20)
def XNOR = register_instruction("XNOR", OP, 4, 0x20)
def MIN = register_instruction("MIN", OP, 4, 0x05)
def MINU = register_instruction("MINU", OP, 5, 0x05)
def MAX = register_instruction("MAX", OP, 6, 0x05)
def MAXU = register_instruction("MAXU", OP, 7, 0x05)
def ROL = register_instruction("ROL", OP, 1, 0x30)
def ROR = register_instruction("ROR", OP, 5, 0x30)
def ROLW = register_instruction("ROLW", OP_32, 1, 0x30)
def RORW = register_instruction("RORW", OP_32, 5, 0x30)

def CLZ = unary_instruction("CLZ", OP_IMM, 1, 0x600)
def CTZ = unary_instruction("CTZ", OP_IMM, 1, 0x601)
def CPOP = unary_instruction("CPOP", OP_IMM, 1, 0x602)
def SEXT_B = unary_instruction("SEXT.B", OP_IMM, 1, 0x604)
def SEXT_H = unary_instruction("SEXT.H", OP_IMM, 1, 0x605)
def ORC_B = unary_instruction("ORC.B", OP_IMM, 5, 0x287)
def RV32_REV8 = unary_instruction("REV8", OP_IMM, 5, 0x698)
def REV8 = unary_instruction("REV8", OP_IMM, 5, 0x6B8)
def CLZW = unary_instruction("CLZW", OP_IMM_32, 1, 0x600)
def CTZW = unary_instruction("CTZW", OP_IMM_32, 1, 0x601)
def CPOPW = unary_instruction("CPOPW", OP_IMM_32, 1, 0x602)
def RV32_ZEXT_H = unary_instruction("ZEXT.H", OP, 4, 0x080)
def ZEXT_H = unary_instruction("ZEXT.H", OP_32, 4, 0x080)
def RV32_RORI = shift32_instruction("RORI", OP_IMM, 5, 0x30)
def RORI = shift64_instruction("RORI", OP_IMM, 5, 0x18)
def RORIW = shift32_instruction("RORIW", OP_IMM_32, 5, 0x30)

def RV32ZbbInstructions = [
  ANDN, ORN, XNOR,
  CLZ, CTZ, CPOP,
  MIN, MINU, MAX, MAXU,
  ORC_B, RV32_REV8,
  ROL, ROR, RV32_RORI,
  SEXT_B, SEXT_H, RV32_ZEXT_H
]
def RV64ZbbInstructions = [
  ANDN, ORN, XNOR,
  CLZ, CLZW, CTZ, CTZW, CPOP, CPOPW,
  MIN, MINU, MAX, MAXU,
  ORC_B, REV8,
  ROL, ROLW, ROR, RORW, RORI, RORIW,
  SEXT_B, SEXT_H, ZEXT_H
]
def RV32ZbbRevision = "RV32 Zbb 1.0.0"
def RV64ZbbRevision = "RV64 Zbb 1.0.0"
def RV32Zbb = InstructionCatalog("RV32Zbb", RV32ZbbRevision, RV32ZbbInstructions)
def RV64Zbb = InstructionCatalog("RV64Zbb", RV64ZbbRevision, RV64ZbbInstructions)

export:
  RV32ZbbInstructions
  RV64ZbbInstructions
  RV32ZbbRevision
  RV64ZbbRevision
  RV32Zbb
  RV64Zbb
  ANDN
  ORN
  XNOR
  CLZ
  CLZW
  CTZ
  CTZW
  CPOP
  CPOPW
  MIN
  MINU
  MAX
  MAXU
  ORC_B
  RV32_REV8
  REV8
  ROL
  ROLW
  ROR
  RORW
  RV32_RORI
  RORI
  RORIW
  SEXT_B
  SEXT_H
  RV32_ZEXT_H
  ZEXT_H
