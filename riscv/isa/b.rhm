#lang rhombus
// Aggregates the complete ratified RV32 and RV64 B standard extension catalogs.
// SPDX-License-Identifier: Apache-2.0

import:
  "../model/main.rhm" open
  "zba.rhm" as zba
  "zbb.rhm" as zbb
  "zbs.rhm" as zbs

def RV32BInstructions = zba.RV32ZbaInstructions ++ zbb.RV32ZbbInstructions ++ zbs.RV32ZbsInstructions
def RV64BInstructions = zba.RV64ZbaInstructions ++ zbb.RV64ZbbInstructions ++ zbs.RV64ZbsInstructions
def RV32BRevision = "RV32 B 1.0.0"
def RV64BRevision = "RV64 B 1.0.0"
def RV32B = InstructionCatalog("RV32B", RV32BRevision, RV32BInstructions)
def RV64B = InstructionCatalog("RV64B", RV64BRevision, RV64BInstructions)

export:
  RV32BInstructions
  RV64BInstructions
  RV32BRevision
  RV64BRevision
  RV32B
  RV64B
