#lang rhombus
// Defines the ratified Zfa additional floating-point instruction catalogs.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../support/annotations.rhm" open
  "../model/main.rhm" open

def OP_FP = 0x53
def SINGLE = 0
def DOUBLE = 1
def HALF = 2

fun load_immediate(name :: NonemptyString, format :: Nat):
  instruction(name, FloatingImmediateFormat, [opcode.constrain(OP_FP), funct5.constrain(30), fmt.constrain(format), rs2.constrain(1), funct3.constrain(0)])

fun minmax(name :: NonemptyString, format :: Nat, operation :: Nat):
  instruction(name, FloatingBinaryFormat, [opcode.constrain(OP_FP), funct5.constrain(5), fmt.constrain(format), funct3.constrain(operation)])

fun round_to_integral(name :: NonemptyString, format :: Nat, operation :: Nat):
  instruction(name, FloatingUnaryRoundingFormat, [opcode.constrain(OP_FP), funct5.constrain(8), fmt.constrain(format), rs2.constrain(operation)])

fun quiet_compare(name :: NonemptyString, format :: Nat, relation :: Nat):
  instruction(name, FloatingCompareFormat, [opcode.constrain(OP_FP), funct5.constrain(20), fmt.constrain(format), funct3.constrain(relation)])

def FLI_S = load_immediate("FLI.S", SINGLE)
def FMINM_S = minmax("FMINM.S", SINGLE, 2)
def FMAXM_S = minmax("FMAXM.S", SINGLE, 3)
def FROUND_S = round_to_integral("FROUND.S", SINGLE, 4)
def FROUNDNX_S = round_to_integral("FROUNDNX.S", SINGLE, 5)
def FLEQ_S = quiet_compare("FLEQ.S", SINGLE, 4)
def FLTQ_S = quiet_compare("FLTQ.S", SINGLE, 5)

def FLI_D = load_immediate("FLI.D", DOUBLE)
def FMINM_D = minmax("FMINM.D", DOUBLE, 2)
def FMAXM_D = minmax("FMAXM.D", DOUBLE, 3)
def FROUND_D = round_to_integral("FROUND.D", DOUBLE, 4)
def FROUNDNX_D = round_to_integral("FROUNDNX.D", DOUBLE, 5)
def FCVTMOD_W_D = instruction("FCVTMOD.W.D", FloatingToIntegerFormat, [opcode.constrain(OP_FP), funct5.constrain(24), fmt.constrain(DOUBLE), rs2.constrain(8), funct3.constrain(1)])
def FLEQ_D = quiet_compare("FLEQ.D", DOUBLE, 4)
def FLTQ_D = quiet_compare("FLTQ.D", DOUBLE, 5)

def FLI_H = load_immediate("FLI.H", HALF)
def FMINM_H = minmax("FMINM.H", HALF, 2)
def FMAXM_H = minmax("FMAXM.H", HALF, 3)
def FROUND_H = round_to_integral("FROUND.H", HALF, 4)
def FROUNDNX_H = round_to_integral("FROUNDNX.H", HALF, 5)
def FLEQ_H = quiet_compare("FLEQ.H", HALF, 4)
def FLTQ_H = quiet_compare("FLTQ.H", HALF, 5)

def FMVH_X_D = instruction("FMVH.X.D", FloatingToIntegerFormat, [opcode.constrain(OP_FP), funct5.constrain(28), fmt.constrain(DOUBLE), rs2.constrain(1), funct3.constrain(0)])
def FMVP_D_X = instruction("FMVP.D.X", IntegerPairToFloatingFormat, [opcode.constrain(OP_FP), funct5.constrain(22), fmt.constrain(DOUBLE), funct3.constrain(0)])

def ZfaSingleInstructions = [FLI_S, FMINM_S, FMAXM_S, FROUND_S, FROUNDNX_S, FLEQ_S, FLTQ_S]
def ZfaDoubleInstructions = [FLI_D, FMINM_D, FMAXM_D, FROUND_D, FROUNDNX_D, FCVTMOD_W_D, FLEQ_D, FLTQ_D]
def ZfaHalfInstructions = [FLI_H, FMINM_H, FMAXM_H, FROUND_H, FROUNDNX_H, FLEQ_H, FLTQ_H]
def RV32ZfaDoubleMoveInstructions = [FMVH_X_D, FMVP_D_X]
def ZfaRevision = "Zfa 1.0"
def ZfaF = InstructionCatalog("ZfaF", ZfaRevision, ZfaSingleInstructions)
def ZfaD = InstructionCatalog("ZfaD", ZfaRevision, ZfaDoubleInstructions)
def ZfaH = InstructionCatalog("ZfaH", ZfaRevision, ZfaHalfInstructions)
def RV32ZfaDMove = InstructionCatalog("RV32ZfaDMove", ZfaRevision, RV32ZfaDoubleMoveInstructions)

export:
  ZfaSingleInstructions
  ZfaDoubleInstructions
  ZfaHalfInstructions
  RV32ZfaDoubleMoveInstructions
  ZfaRevision
  ZfaF
  ZfaD
  ZfaH
  RV32ZfaDMove
  FLI_S FMINM_S FMAXM_S FROUND_S FROUNDNX_S FLEQ_S FLTQ_S
  FLI_D FMINM_D FMAXM_D FROUND_D FROUNDNX_D FCVTMOD_W_D FLEQ_D FLTQ_D
  FLI_H FMINM_H FMAXM_H FROUND_H FROUNDNX_H FLEQ_H FLTQ_H
  FMVH_X_D FMVP_D_X
