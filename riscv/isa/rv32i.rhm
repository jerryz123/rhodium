import:
  "../../support/annotations.rhm" open
  "../model/main.rhm" open
  "integer-common.rhm" open

export:
  RV32IRevision
  RV32IInstructions
  RV32I
  rv32i_instruction
  LUI
  AUIPC
  JAL
  JALR
  BEQ
  BNE
  BLT
  BGE
  BLTU
  BGEU
  LB
  LH
  LW
  LBU
  LHU
  SB
  SH
  SW
  ADDI
  SLTI
  SLTIU
  XORI
  ORI
  ANDI
  SLLI
  SRLI
  SRAI
  ADD
  SUB
  SLL
  SLT
  SLTU
  XOR
  SRL
  SRA
  OR
