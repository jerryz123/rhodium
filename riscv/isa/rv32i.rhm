  FENCE
  ECALL
  EBREAK

def RV32IRevision = "RV32I 2.1"

fun shift32_instruction(name :: NonemptyString,
                        function3 :: Nat,
                        function7 :: Nat):
  instruction(name, Shift32Format, [opcode.constrain(OP_IMM), funct3.constrain(function3), funct7.constrain(function7)])

def SLLI = shift32_instruction("SLLI", 1, 0)
def SRLI = shift32_instruction("SRLI", 5, 0)
def SRAI = shift32_instruction("SRAI", 5, 32)

def RV32IInstructions = [
  LUI, AUIPC, JAL, JALR,
  BEQ, BNE, BLT, BGE, BLTU, BGEU,
  LB, LH, LW, LBU, LHU,
  SB, SH, SW,
  ADDI, SLTI, SLTIU, XORI, ORI, ANDI,
  SLLI, SRLI, SRAI,
  ADD, SUB, SLL, SLT, SLTU, XOR, SRL, SRA, OR, AND,
  FENCE, ECALL, EBREAK
]

def RV32I = InstructionCatalog("RV32I", RV32IRevision, RV32IInstructions)

fun rv32i_instruction(name :: String):
  RV32I.find(name)
