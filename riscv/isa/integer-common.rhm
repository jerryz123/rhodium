#lang rhombus
// Defines XLEN-independent integer instruction encodings shared by RV32I and RV64I.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../support/annotations.rhm" open
  "../model/main.rhm" open

export:
  RVIntegerCommonInstructions
  LOAD
  MISC_MEM
  OP_IMM
  AUIPC_OPCODE
  STORE
  OP
  LUI_OPCODE
  BRANCH
  JALR_OPCODE
  JAL_OPCODE
  SYSTEM
  opcode_instruction
  function3_instruction
  register_instruction
  system_instruction
  LUI
  AUIPC
  JAL
  JALR
  BEQ
  BNE
  BLT
  BGE
  BLTU
  BGEU
  LB
  LH
  LW
  LBU
  LHU
  SB
  SH
  SW
  ADDI
  SLTI
  SLTIU
  XORI
  ORI
  ANDI
  ADD
