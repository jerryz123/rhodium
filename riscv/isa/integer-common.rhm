  SLL
  SLT
  SLTU
  XOR
  SRL
  SRA
  OR
  AND
  FENCE
  ECALL
  EBREAK

def LOAD = 0x03
def MISC_MEM = 0x0F
def OP_IMM = 0x13
def AUIPC_OPCODE = 0x17
def STORE = 0x23
def OP = 0x33
def LUI_OPCODE = 0x37
def BRANCH = 0x63
def JALR_OPCODE = 0x67
def JAL_OPCODE = 0x6F
def SYSTEM = 0x73

fun opcode_instruction(name :: NonemptyString,
                       format :: InstructionFormat,
                       opcode_value :: Nat):
  instruction(name, format, [opcode.constrain(opcode_value)])

fun function3_instruction(name :: NonemptyString,
                          format :: InstructionFormat,
                          opcode_value :: Nat,
                          function3 :: Nat):
  instruction(name, format, [opcode.constrain(opcode_value), funct3.constrain(function3)])

fun register_instruction(name :: NonemptyString,
                         opcode_value :: Nat,
                         function3 :: Nat,
                         function7 :: Nat):
  instruction(name, RFormat, [opcode.constrain(opcode_value), funct3.constrain(function3), funct7.constrain(function7)])

fun system_instruction(name :: NonemptyString, immediate_value :: Nat):
  instruction(name, SystemFormat, [opcode.constrain(SYSTEM), rd.constrain(0), funct3.constrain(0), rs1.constrain(0), immediate12.constrain(immediate_value)])

def LUI = opcode_instruction("LUI", UFormat, LUI_OPCODE)
def AUIPC = opcode_instruction("AUIPC", UFormat, AUIPC_OPCODE)
def JAL = opcode_instruction("JAL", JFormat, JAL_OPCODE)
def JALR = function3_instruction("JALR", IFormat, JALR_OPCODE, 0)

def BEQ = function3_instruction("BEQ", BFormat, BRANCH, 0)
def BNE = function3_instruction("BNE", BFormat, BRANCH, 1)
def BLT = function3_instruction("BLT", BFormat, BRANCH, 4)
def BGE = function3_instruction("BGE", BFormat, BRANCH, 5)
def BLTU = function3_instruction("BLTU", BFormat, BRANCH, 6)
def BGEU = function3_instruction("BGEU", BFormat, BRANCH, 7)

def LB = function3_instruction("LB", IFormat, LOAD, 0)
def LH = function3_instruction("LH", IFormat, LOAD, 1)
def LW = function3_instruction("LW", IFormat, LOAD, 2)
def LBU = function3_instruction("LBU", IFormat, LOAD, 4)
def LHU = function3_instruction("LHU", IFormat, LOAD, 5)

def SB = function3_instruction("SB", SFormat, STORE, 0)
def SH = function3_instruction("SH", SFormat, STORE, 1)
def SW = function3_instruction("SW", SFormat, STORE, 2)

def ADDI = function3_instruction("ADDI", IFormat, OP_IMM, 0)
def SLTI = function3_instruction("SLTI", IFormat, OP_IMM, 2)
def SLTIU = function3_instruction("SLTIU", IFormat, OP_IMM, 3)
def XORI = function3_instruction("XORI", IFormat, OP_IMM, 4)
def ORI = function3_instruction("ORI", IFormat, OP_IMM, 6)
def ANDI = function3_instruction("ANDI", IFormat, OP_IMM, 7)

def ADD = register_instruction("ADD", OP, 0, 0)
def SUB = register_instruction("SUB", OP, 0, 32)
def SLL = register_instruction("SLL", OP, 1, 0)
def SLT = register_instruction("SLT", OP, 2, 0)
def SLTU = register_instruction("SLTU", OP, 3, 0)
def XOR = register_instruction("XOR", OP, 4, 0)
def SRL = register_instruction("SRL", OP, 5, 0)
def SRA = register_instruction("SRA", OP, 5, 32)
def OR = register_instruction("OR", OP, 6, 0)
def AND = register_instruction("AND", OP, 7, 0)

def FENCE = function3_instruction("FENCE", FenceFormat, MISC_MEM, 0)
def ECALL = system_instruction("ECALL", 0)
def EBREAK = system_instruction("EBREAK", 1)

def RVIntegerCommonInstructions = [
  LUI, AUIPC, JAL, JALR,
  BEQ, BNE, BLT, BGE, BLTU, BGEU,
  LB, LH, LW, LBU, LHU,
  SB, SH, SW,
  ADDI, SLTI, SLTIU, XORI, ORI, ANDI,
  ADD, SUB, SLL, SLT, SLTU, XOR, SRL, SRA, OR, AND,
  FENCE, ECALL, EBREAK
]
