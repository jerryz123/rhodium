def VWMACCSU_VX = vector_arithmetic("VWMACCSU.VX", 63, VectorVXFormat, 6)
def VectorDivideInstructions = [VDIVU_VV, VDIVU_VX, VDIV_VV, VDIV_VX, VREMU_VV, VREMU_VX, VREM_VV, VREM_VX]
def VectorMultiplyInstructions = [VMULHU_VV, VMULHU_VX, VMUL_VV, VMUL_VX, VMULHSU_VV, VMULHSU_VX, VMULH_VV, VMULH_VX]
def VectorFractionalMultiplyInstructions = [VSMUL_VV, VSMUL_VX]
def VectorWideningMultiplyInstructions = [VWMULU_VV, VWMULU_VX, VWMULSU_VV, VWMULSU_VX, VWMUL_VV, VWMUL_VX]
def VectorMultiplyAccumulateInstructions = [VMACC_VV, VMACC_VX, VNMSAC_VV, VNMSAC_VX, VMADD_VV, VMADD_VX, VNMSUB_VV, VNMSUB_VX]
