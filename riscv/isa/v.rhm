def VMADC_VX = fixed_mask_arithmetic("VMADC.VX", 0x11, VectorFixedVXFormat, 4, 1)
def VMADC_VI = fixed_mask_arithmetic("VMADC.VI", 0x11, VectorFixedVIFormat, 3, 1)
