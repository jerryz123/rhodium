def VWMACC_VV = vector_arithmetic("VWMACC.VV", 61, VectorVVFormat, 2)
def VWMACC_VX = vector_arithmetic("VWMACC.VX", 61, VectorVXFormat, 6)
def VWMACCUS_VX = vector_arithmetic("VWMACCUS.VX", 62, VectorVXFormat, 6)
