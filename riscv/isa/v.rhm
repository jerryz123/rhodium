def VMSOF_M = mask_unary("VMSOF.M", 0x14, 2, VectorMaskUnaryFormat)
def VIOTA_M = mask_unary("VIOTA.M", 0x14, 0x10, VectorMaskUnaryFormat)
def VID_V = mask_unary("VID.V", 0x14, 0x11, VectorIndexFormat)
def VectorMaskScanInstructions = [VCPOP_M, VFIRST_M, VMSBF_M, VMSIF_M, VMSOF_M, VIOTA_M, VID_V]
