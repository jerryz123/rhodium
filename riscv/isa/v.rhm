def VADC_VXM = fixed_mask_arithmetic("VADC.VXM", 0x10, VectorFixedVXFormat, 4, 0)
def VADC_VIM = fixed_mask_arithmetic("VADC.VIM", 0x10, VectorFixedVIFormat, 3, 0)
