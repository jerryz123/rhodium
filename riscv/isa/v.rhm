def VMSBC_VVM = fixed_mask_arithmetic("VMSBC.VVM", 0x13, VectorFixedVVFormat, 0, 0)
def VMSBC_VXM = fixed_mask_arithmetic("VMSBC.VXM", 0x13, VectorFixedVXFormat, 4, 0)
def VMSBC_VV = fixed_mask_arithmetic("VMSBC.VV", 0x13, VectorFixedVVFormat, 0, 1)
def VMSBC_VX = fixed_mask_arithmetic("VMSBC.VX", 0x13, VectorFixedVXFormat, 4, 1)
def VSADDU_VV = vector_arithmetic("VSADDU.VV", 0x20, VectorVVFormat, 0)
def VSADDU_VX = vector_arithmetic("VSADDU.VX", 0x20, VectorVXFormat, 4)
