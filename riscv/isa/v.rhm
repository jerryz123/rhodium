fun mask_unary(name :: String, code :: Nat, selector :: Nat, form :: InstructionFormat):
  InstructionSpec(name, form, [opcode.constrain(0x57), funct3.constrain(2), funct6.constrain(code), vs1.constrain(selector)] ++ (if form == VectorIndexFormat | [vs2.constrain(0)] | []))
def VCPOP_M = mask_unary("VCPOP.M", 0x10, 0x10, VectorMaskScalarFormat)
def VFIRST_M = mask_unary("VFIRST.M", 0x10, 0x11, VectorMaskScalarFormat)
def VMSBF_M = mask_unary("VMSBF.M", 0x14, 1, VectorMaskUnaryFormat)
