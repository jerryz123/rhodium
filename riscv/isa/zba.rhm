#lang rhombus
// Defines the ratified RV32 and RV64 Zba address-generation instruction catalogs.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../support/annotations.rhm" open
  "../model/main.rhm" open
  "integer-common.rhm" open

def OP_32 = 0x3B
def OP_IMM_32 = 0x1B

def SH1ADD = register_instruction("SH1ADD", OP, 2, 0x10)
def SH2ADD = register_instruction("SH2ADD", OP, 4, 0x10)
def SH3ADD = register_instruction("SH3ADD", OP, 6, 0x10)
def ADD_UW = register_instruction("ADD.UW", OP_32, 0, 0x04)
def SH1ADD_UW = register_instruction("SH1ADD.UW", OP_32, 2, 0x10)
def SH2ADD_UW = register_instruction("SH2ADD.UW", OP_32, 4, 0x10)
def SH3ADD_UW = register_instruction("SH3ADD.UW", OP_32, 6, 0x10)
def SLLI_UW = instruction(
  "SLLI.UW",
  Shift64Format,
  [opcode.constrain(OP_IMM_32), funct3.constrain(1), funct6.constrain(0x02)]
)

def RV32ZbaInstructions = [SH1ADD, SH2ADD, SH3ADD]
def RV64ZbaInstructions = RV32ZbaInstructions ++ [
  ADD_UW, SH1ADD_UW, SH2ADD_UW, SH3ADD_UW, SLLI_UW
]
def RV32ZbaRevision = "RV32 Zba 1.0.0"
def RV64ZbaRevision = "RV64 Zba 1.0.0"
def RV32Zba = InstructionCatalog("RV32Zba", RV32ZbaRevision, RV32ZbaInstructions)
def RV64Zba = InstructionCatalog("RV64Zba", RV64ZbaRevision, RV64ZbaInstructions)

export:
  RV32ZbaInstructions
  RV64ZbaInstructions
  RV32ZbaRevision
  RV64ZbaRevision
  RV32Zba
  RV64Zba
  SH1ADD
  SH2ADD
  SH3ADD
  ADD_UW
  SH1ADD_UW
  SH2ADD_UW
  SH3ADD_UW
  SLLI_UW
