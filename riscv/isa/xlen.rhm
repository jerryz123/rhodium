#lang rhombus
/* Defines the supported architectural integer widths as host configuration values. */
// SPDX-License-Identifier: Apache-2.0

/* Provides closed RV32/RV64 host width descriptors through the X32 and X64 singleton values. */
class XLen(private width_value :: PosInt):
  internal make_xlen
  /* Prevents public construction; only the module's RV32 and RV64 singletons are exposed. */
  constructor ~none

  property width :: PosInt:
    width_value

namespace ~extend XLen:
  def X32 = make_xlen(32)
  def X64 = make_xlen(64)

  export:
    X32
    X64

export:
  XLen
