#lang rhombus
// Defines the RV32 and RV64 Zcd compressed double-precision load and store catalogs.
// SPDX-License-Identifier: Apache-2.0

import:
  "compressed.rhm" open
  "d.rhm" as riscv_d

def RV32ZcdInstructions = [
  compact_load("C.FLD", riscv_d.FLD, 1, compact_double_offset),
  compact_store("C.FSD", riscv_d.FSD, 5, compact_double_offset),
  stack_load("C.FLDSP", riscv_d.FLD, 1, stack_double_offset, #false),
  stack_store("C.FSDSP", riscv_d.FSD, 5, stack_store_double_offset)
]
def RV64ZcdInstructions = RV32ZcdInstructions

def RV32Zcd = CompressedInstructionCatalog("RV32Zcd", "Zcd 1.0.0", RV32ZcdInstructions)
def RV64Zcd = CompressedInstructionCatalog("RV64Zcd", "Zcd 1.0.0", RV64ZcdInstructions)

export:
  RV32ZcdInstructions
  RV64ZcdInstructions
  RV32Zcd
  RV64Zcd
