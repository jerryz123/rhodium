#lang rhombus
// Defines the RV32 and RV64 Zca compressed-integer instruction catalogs.
// SPDX-License-Identifier: Apache-2.0

import:
  "../model/expansion.rhm" open
  "compressed.rhm" open
  "rv32i.rhm" as rv32i
  "rv64i.rhm" as rv64i

def RV32ZcaInstructions = [
  addi4spn(rv32i.ADDI),
  compact_load("C.LW", rv32i.LW, 2, compact_word_offset),
  compact_store("C.SW", rv32i.SW, 6, compact_word_offset),
  addi("C.ADDI", rv32i.ADDI, 0),
  jump("C.JAL", rv32i.JAL, 1, link_register),
  li(rv32i.ADDI),
  addi16sp(rv32i.ADDI),
  lui(rv32i.LUI),
  compact_shift("C.SRLI", rv32i.SRLI, 0, shift5_immediate, #true),
  compact_shift("C.SRAI", rv32i.SRAI, 1, shift5_immediate, #true),
  andi(rv32i.ANDI),
  compressed_alu("C.SUB", rv32i.SUB, 0, 0),
  compressed_alu("C.XOR", rv32i.XOR, 0, 1),
  compressed_alu("C.OR", rv32i.OR, 0, 2),
  compressed_alu("C.AND", rv32i.AND, 0, 3),
  jump("C.J", rv32i.JAL, 5, zero_register),
  branch("C.BEQZ", rv32i.BEQ, 6),
  branch("C.BNEZ", rv32i.BNE, 7),
  slli(rv32i.SLLI, shift5_immediate, #true),
  stack_load("C.LWSP", rv32i.LW, 2, stack_word_offset, #true),
  register_jump("C.JR", rv32i.JALR, 0, zero_register),
  register_alu("C.MV", rv32i.ADD, 0, zero_register),
  ebreak(rv32i.EBREAK),
  register_jump("C.JALR", rv32i.JALR, 1, link_register),
  register_alu("C.ADD", rv32i.ADD, 1, direct_rd),
  stack_store("C.SWSP", rv32i.SW, 6, stack_store_word_offset)
]

def RV64ZcaInstructions = [
  addi4spn(rv64i.ADDI),
  compact_load("C.LW", rv64i.LW, 2, compact_word_offset),
  compact_load("C.LD", rv64i.LD, 3, compact_double_offset),
  compact_store("C.SW", rv64i.SW, 6, compact_word_offset),
  compact_store("C.SD", rv64i.SD, 7, compact_double_offset),
  addi("C.ADDI", rv64i.ADDI, 0),
  addi("C.ADDIW", rv64i.ADDIW, 1, [NonzeroFieldConstraint(compressed_rd_rs1)]),
  li(rv64i.ADDI),
  addi16sp(rv64i.ADDI),
  lui(rv64i.LUI),
  compact_shift("C.SRLI", rv64i.SRLI, 0, shift6_immediate, #false),
  compact_shift("C.SRAI", rv64i.SRAI, 1, shift6_immediate, #false),
  andi(rv64i.ANDI),
  compressed_alu("C.SUB", rv64i.SUB, 0, 0),
  compressed_alu("C.XOR", rv64i.XOR, 0, 1),
  compressed_alu("C.OR", rv64i.OR, 0, 2),
  compressed_alu("C.AND", rv64i.AND, 0, 3),
  compressed_alu("C.SUBW", rv64i.SUBW, 1, 0),
  compressed_alu("C.ADDW", rv64i.ADDW, 1, 1),
  jump("C.J", rv64i.JAL, 5, zero_register),
  branch("C.BEQZ", rv64i.BEQ, 6),
  branch("C.BNEZ", rv64i.BNE, 7),
  slli(rv64i.SLLI, shift6_immediate, #false),
  stack_load("C.LWSP", rv64i.LW, 2, stack_word_offset, #true),
  stack_load("C.LDSP", rv64i.LD, 3, stack_double_offset, #true),
  register_jump("C.JR", rv64i.JALR, 0, zero_register),
  register_alu("C.MV", rv64i.ADD, 0, zero_register),
  ebreak(rv64i.EBREAK),
  register_jump("C.JALR", rv64i.JALR, 1, link_register),
  register_alu("C.ADD", rv64i.ADD, 1, direct_rd),
  stack_store("C.SWSP", rv64i.SW, 6, stack_store_word_offset),
  stack_store("C.SDSP", rv64i.SD, 7, stack_store_double_offset)
]

def RV32Zca = CompressedInstructionCatalog("RV32Zca", "Zca 1.0.0", RV32ZcaInstructions)
def RV64Zca = CompressedInstructionCatalog("RV64Zca", "Zca 1.0.0", RV64ZcaInstructions)

export:
  RV32ZcaInstructions
  RV64ZcaInstructions
  RV32Zca
  RV64Zca
