#lang rhombus
// Identifies the existing vector conversions whose SEW=16 forms comprise Zvfhmin.
// SPDX-License-Identifier: Apache-2.0

import:
  "../model/main.rhm" open
  "v.rhm" open

def ZvfhminInstructions = [VFWCVT_F_F_V, VFNCVT_F_F_W]
def ZvfhminRevision = "Zvfhmin 1.0"
def Zvfhmin = InstructionCatalog("Zvfhmin", ZvfhminRevision, ZvfhminInstructions)

fun zvfhmin_instruction(name :: String): Zvfhmin.find(name)

export:
  ZvfhminInstructions
  ZvfhminRevision
  Zvfhmin
  zvfhmin_instruction
