#lang rhombus
// Defines the host-visible constants and field helpers for Sv39 translation.
// SPDX-License-Identifier: Apache-2.0

def Sv39ModeBare :: Nat = 0
def Sv39Mode :: Nat = 8
def Sv39Levels :: PosInt = 3
def Sv39PageBytes :: PosInt = 4096
def Sv39VpnBits :: PosInt = 9
def Sv39PteBytes :: PosInt = 8
def Sv39VirtualBits :: PosInt = 39
def Sv39PpnBits :: PosInt = 44

fun sv39_canonical_address(address :: Nat) :: Boolean:
  def upper = address bits.(>>) Sv39VirtualBits
  def sign = (address bits.(>>) (Sv39VirtualBits - 1)) bits.and 1
  upper == (if sign == 0 | 0 | (1 bits.(<<) (64 - Sv39VirtualBits)) - 1)

export:
  Sv39ModeBare
  Sv39Mode
  Sv39Levels
  Sv39PageBytes
  Sv39VpnBits
  Sv39PteBytes
  Sv39VirtualBits
  Sv39PpnBits
  sv39_canonical_address
