#lang rhombus
// Defines the standard double-precision floating-point instruction catalogs.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../support/annotations.rhm" open
  "../model/main.rhm" open

def LOAD_FP = 0x07
def STORE_FP = 0x27
def OP_FP = 0x53
def DOUBLE = 1

fun floating_load(name :: NonemptyString, width :: Nat):
  instruction(name, FloatingLoadFormat, [opcode.constrain(LOAD_FP), funct3.constrain(width)])

fun floating_store(name :: NonemptyString, width :: Nat):
  instruction(name, FloatingStoreFormat, [opcode.constrain(STORE_FP), funct3.constrain(width)])

fun fused(name :: NonemptyString, operation :: Nat):
  instruction(name, FloatingR4RoundingFormat, [opcode.constrain(operation), fmt.constrain(DOUBLE)])

fun binary_rounding(name :: NonemptyString, operation :: Nat):
  instruction(name, FloatingBinaryRoundingFormat, [opcode.constrain(OP_FP), funct5.constrain(operation), fmt.constrain(DOUBLE)])

fun unary_rounding(name :: NonemptyString, operation :: Nat):
  instruction(name, FloatingUnaryRoundingFormat, [opcode.constrain(OP_FP), funct5.constrain(operation), fmt.constrain(DOUBLE), rs2.constrain(0)])

fun binary_fixed(name :: NonemptyString, operation :: Nat, suboperation :: Nat):
  instruction(name, FloatingBinaryFormat, [opcode.constrain(OP_FP), funct5.constrain(operation), fmt.constrain(DOUBLE), funct3.constrain(suboperation)])

fun compare(name :: NonemptyString, relation :: Nat):
  instruction(name, FloatingCompareFormat, [opcode.constrain(OP_FP), funct5.constrain(20), fmt.constrain(DOUBLE), funct3.constrain(relation)])

fun float_to_integer_rounding(name :: NonemptyString, integer_kind :: Nat):
  instruction(name, FloatingToIntegerRoundingFormat, [opcode.constrain(OP_FP), funct5.constrain(24), fmt.constrain(DOUBLE), rs2.constrain(integer_kind)])

fun integer_to_float_rounding(name :: NonemptyString, integer_kind :: Nat):
  instruction(name, IntegerToFloatingRoundingFormat, [opcode.constrain(OP_FP), funct5.constrain(26), fmt.constrain(DOUBLE), rs2.constrain(integer_kind)])

def FLD = floating_load("FLD", 3)
def FSD = floating_store("FSD", 3)
def FMADD_D = fused("FMADD.D", 0x43)
def FMSUB_D = fused("FMSUB.D", 0x47)
def FNMSUB_D = fused("FNMSUB.D", 0x4B)
def FNMADD_D = fused("FNMADD.D", 0x4F)
def FADD_D = binary_rounding("FADD.D", 0)
def FSUB_D = binary_rounding("FSUB.D", 1)
def FMUL_D = binary_rounding("FMUL.D", 2)
def FDIV_D = binary_rounding("FDIV.D", 3)
def FSQRT_D = unary_rounding("FSQRT.D", 11)
def FSGNJ_D = binary_fixed("FSGNJ.D", 4, 0)
def FSGNJN_D = binary_fixed("FSGNJN.D", 4, 1)
def FSGNJX_D = binary_fixed("FSGNJX.D", 4, 2)
def FMIN_D = binary_fixed("FMIN.D", 5, 0)
def FMAX_D = binary_fixed("FMAX.D", 5, 1)
def FCVT_S_D = instruction("FCVT.S.D", FloatingConvertFormat, [opcode.constrain(OP_FP), funct5.constrain(8), fmt.constrain(0), rs2.constrain(1)])
def FCVT_D_S = instruction("FCVT.D.S", FloatingConvertFormat, [opcode.constrain(OP_FP), funct5.constrain(8), fmt.constrain(1), rs2.constrain(0)])
def FEQ_D = compare("FEQ.D", 2)
def FLT_D = compare("FLT.D", 1)
def FLE_D = compare("FLE.D", 0)
def FCLASS_D = instruction("FCLASS.D", FloatingToIntegerFormat, [opcode.constrain(OP_FP), funct5.constrain(28), fmt.constrain(DOUBLE), rs2.constrain(0), funct3.constrain(1)])
def FCVT_W_D = float_to_integer_rounding("FCVT.W.D", 0)
def FCVT_WU_D = float_to_integer_rounding("FCVT.WU.D", 1)
def FCVT_D_W = integer_to_float_rounding("FCVT.D.W", 0)
def FCVT_D_WU = integer_to_float_rounding("FCVT.D.WU", 1)
def FCVT_L_D = float_to_integer_rounding("FCVT.L.D", 2)
def FCVT_LU_D = float_to_integer_rounding("FCVT.LU.D", 3)
def FCVT_D_L = integer_to_float_rounding("FCVT.D.L", 2)
def FCVT_D_LU = integer_to_float_rounding("FCVT.D.LU", 3)
def FMV_X_D = instruction("FMV.X.D", FloatingToIntegerFormat, [opcode.constrain(OP_FP), funct5.constrain(28), fmt.constrain(DOUBLE), rs2.constrain(0), funct3.constrain(0)])
def FMV_D_X = instruction("FMV.D.X", IntegerToFloatingFormat, [opcode.constrain(OP_FP), funct5.constrain(30), fmt.constrain(DOUBLE), rs2.constrain(0), funct3.constrain(0)])

def RV32DInstructions = [
  FLD, FSD, FMADD_D, FMSUB_D, FNMSUB_D, FNMADD_D,
  FADD_D, FSUB_D, FMUL_D, FDIV_D, FSQRT_D,
  FSGNJ_D, FSGNJN_D, FSGNJX_D, FMIN_D, FMAX_D,
  FCVT_S_D, FCVT_D_S, FEQ_D, FLT_D, FLE_D, FCLASS_D,
  FCVT_W_D, FCVT_WU_D, FCVT_D_W, FCVT_D_WU
]
def RV64DInstructions = RV32DInstructions ++ [FCVT_L_D, FCVT_LU_D, FCVT_D_L, FCVT_D_LU, FMV_X_D, FMV_D_X]
def RV32DRevision = "RV32 D 2.2"
def RV64DRevision = "RV64 D 2.2"
def RV32D = InstructionCatalog("RV32D", RV32DRevision, RV32DInstructions)
def RV64D = InstructionCatalog("RV64D", RV64DRevision, RV64DInstructions)

fun rv32d_instruction(name :: String): RV32D.find(name)
fun rv64d_instruction(name :: String): RV64D.find(name)

export:
  RV32DInstructions
  RV64DInstructions
  RV32DRevision
  RV64DRevision
  RV32D
  RV64D
  rv32d_instruction
  rv64d_instruction
  FLD FSD FMADD_D FMSUB_D FNMSUB_D FNMADD_D
  FADD_D FSUB_D FMUL_D FDIV_D FSQRT_D
  FSGNJ_D FSGNJN_D FSGNJX_D FMIN_D FMAX_D FCVT_S_D FCVT_D_S
  FEQ_D FLT_D FLE_D FCLASS_D FCVT_W_D FCVT_WU_D FCVT_D_W FCVT_D_WU
  FCVT_L_D FCVT_LU_D FCVT_D_L FCVT_D_LU FMV_X_D FMV_D_X
