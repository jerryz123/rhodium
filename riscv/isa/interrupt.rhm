#lang rhombus
// Defines the standard RISC-V interrupt causes and architectural cause codes.
// SPDX-License-Identifier: Apache-2.0

enum InterruptCause
| SupervisorSoftware
| MachineSoftware
| SupervisorTimer
| MachineTimer
| SupervisorExternal
| MachineExternal

fun interrupt_code(cause :: InterruptCause) :: Nat:
  match cause
  | InterruptCause.SupervisorSoftware: 1
  | InterruptCause.MachineSoftware: 3
  | InterruptCause.SupervisorTimer: 5
  | InterruptCause.MachineTimer: 7
  | InterruptCause.SupervisorExternal: 9
  | InterruptCause.MachineExternal: 11

export:
  InterruptCause
  interrupt_code
