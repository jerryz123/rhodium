#lang rhombus
/* Defines the standard RISC-V interrupt causes and architectural cause codes. */
// SPDX-License-Identifier: Apache-2.0

/* Names standard physical, virtual-supervisor, guest-external, and counter-overflow interrupt causes. */
enum InterruptCause
| SupervisorSoftware
| MachineSoftware
| SupervisorTimer
| MachineTimer
| SupervisorExternal
| MachineExternal
| VirtualSupervisorSoftware
| VirtualSupervisorTimer
| VirtualSupervisorExternal
| SupervisorGuestExternal
| LocalCounterOverflow

def VirtualSupervisorInterruptCauses = [
  InterruptCause.VirtualSupervisorSoftware, InterruptCause.VirtualSupervisorTimer,
  InterruptCause.VirtualSupervisorExternal
]
def HypervisorInterruptCauses = VirtualSupervisorInterruptCauses ++ [InterruptCause.SupervisorGuestExternal]

def InterruptCauses = [
  InterruptCause.SupervisorSoftware,
  InterruptCause.MachineSoftware,
  InterruptCause.SupervisorTimer,
  InterruptCause.MachineTimer,
  InterruptCause.SupervisorExternal,
  InterruptCause.MachineExternal
]

def SupervisorInterruptCauses = [
  InterruptCause.SupervisorSoftware,
  InterruptCause.SupervisorTimer,
  InterruptCause.SupervisorExternal
]

/* Maps an interrupt cause to its architectural cause number. */
fun interrupt_code(cause :: InterruptCause) :: Nat:
  match cause
  | InterruptCause.SupervisorSoftware: 1
  | InterruptCause.MachineSoftware: 3
  | InterruptCause.SupervisorTimer: 5
  | InterruptCause.MachineTimer: 7
  | InterruptCause.SupervisorExternal: 9
  | InterruptCause.MachineExternal: 11
  | InterruptCause.VirtualSupervisorSoftware: 2
  | InterruptCause.VirtualSupervisorTimer: 6
  | InterruptCause.VirtualSupervisorExternal: 10
  | InterruptCause.SupervisorGuestExternal: 12
  | InterruptCause.LocalCounterOverflow: 13

/* Combines interrupt causes into a host pending/enable bit mask at their architectural positions. */
fun interrupt_mask(causes :: List.of(InterruptCause)) :: Nat:
  def mutable mask = 0
  for (cause in causes):
    mask := mask bits.or (1 bits.(<<) interrupt_code(cause))
  mask

export:
  InterruptCause
  InterruptCauses
  HypervisorInterruptCauses
  VirtualSupervisorInterruptCauses
  SupervisorInterruptCauses
  interrupt_code
  interrupt_mask
