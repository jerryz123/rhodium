#lang rhombus
// Defines the XLEN-independent Zifencei instruction-fetch fence catalog.
// SPDX-License-Identifier: Apache-2.0

import:
  "../model/main.rhm" open
  "integer-common.rhm" open

def FENCE_I = function3_instruction("FENCE.I", FenceFormat, MISC_MEM, 1)

def ZifenceiRevision = "Zifencei 2.0"
def ZifenceiInstructions = [FENCE_I]
def Zifencei = InstructionCatalog("Zifencei", ZifenceiRevision, ZifenceiInstructions)

export:
  FENCE_I
  ZifenceiRevision
  ZifenceiInstructions
  Zifencei
