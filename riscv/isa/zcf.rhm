#lang rhombus
// Defines the RV32 Zcf compressed single-precision load and store catalog.
// SPDX-License-Identifier: Apache-2.0

import:
  "compressed.rhm" open
  "f.rhm" as riscv_f

def RV32ZcfInstructions = [
  compact_load("C.FLW", riscv_f.FLW, 3, compact_word_offset),
  compact_store("C.FSW", riscv_f.FSW, 7, compact_word_offset),
  stack_load("C.FLWSP", riscv_f.FLW, 3, stack_word_offset, #false),
  stack_store("C.FSWSP", riscv_f.FSW, 7, stack_store_word_offset)
]

def RV32Zcf = CompressedInstructionCatalog("RV32Zcf", "Zcf 1.0.0", RV32ZcfInstructions)

export:
  RV32ZcfInstructions
  RV32Zcf
