#lang rhombus
// Defines the complete RV32 and RV64 integer multiply/divide instruction catalogs.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../support/annotations.rhm" open
  "../model/main.rhm" open
  "integer-common.rhm" open
  "zmmul.rhm" open

def multiply_divide_function7 = 1
def OP_32 = 0x3B

def DIV = register_instruction("DIV", OP, 4, multiply_divide_function7)
def DIVU = register_instruction("DIVU", OP, 5, multiply_divide_function7)
def REM = register_instruction("REM", OP, 6, multiply_divide_function7)
def REMU = register_instruction("REMU", OP, 7, multiply_divide_function7)
def DIVW = register_instruction("DIVW", OP_32, 4, multiply_divide_function7)
def DIVUW = register_instruction("DIVUW", OP_32, 5, multiply_divide_function7)
def REMW = register_instruction("REMW", OP_32, 6, multiply_divide_function7)
def REMUW = register_instruction("REMUW", OP_32, 7, multiply_divide_function7)

def RV32MDivideInstructions = [DIV, DIVU, REM, REMU]
def RV64MDivideInstructions = RV32MDivideInstructions ++ [DIVW, DIVUW, REMW, REMUW]
def RV32MInstructions = RV32ZmmulInstructions ++ RV32MDivideInstructions
def RV64MInstructions = RV64ZmmulInstructions ++ RV64MDivideInstructions
def RV32MRevision = "RV32 M 2.0"
def RV64MRevision = "RV64 M 2.0"
def RV32M = InstructionCatalog("RV32M", RV32MRevision, RV32MInstructions)
def RV64M = InstructionCatalog("RV64M", RV64MRevision, RV64MInstructions)

fun rv32m_instruction(name :: String):
  RV32M.find(name)

fun rv64m_instruction(name :: String):
  RV64M.find(name)

export:
  RV32MDivideInstructions
  RV64MDivideInstructions
  RV32MInstructions
  RV64MInstructions
  RV32MRevision
  RV64MRevision
  RV32M
  RV64M
  rv32m_instruction
  rv64m_instruction
  DIV
  DIVU
  REM
  REMU
  DIVW
  DIVUW
  REMW
  REMUW
