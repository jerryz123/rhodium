#lang rhombus
// Defines the ratified RV32 and RV64 Zicond conditional-operation catalogs.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../support/annotations.rhm" open
  "../model/main.rhm" open
  "integer-common.rhm" open

def CZERO_EQZ = register_instruction("CZERO.EQZ", OP, 5, 0x07)
def CZERO_NEZ = register_instruction("CZERO.NEZ", OP, 7, 0x07)

def ZicondInstructions = [CZERO_EQZ, CZERO_NEZ]
def RV32ZicondRevision = "RV32 Zicond 1.0.0"
def RV64ZicondRevision = "RV64 Zicond 1.0.0"
def RV32Zicond = InstructionCatalog("RV32Zicond", RV32ZicondRevision, ZicondInstructions)
def RV64Zicond = InstructionCatalog("RV64Zicond", RV64ZicondRevision, ZicondInstructions)

export:
  ZicondInstructions
  RV32ZicondRevision
  RV64ZicondRevision
  RV32Zicond
  RV64Zicond
  CZERO_EQZ
  CZERO_NEZ
