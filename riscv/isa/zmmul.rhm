#lang rhombus
// Defines the RV32 and RV64 Zmmul integer-multiplication instruction catalogs.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../support/annotations.rhm" open
  "../model/main.rhm" open
  "integer-common.rhm" open

def multiply_function7 = 1
def OP_32 = 0x3B

def MUL = register_instruction("MUL", OP, 0, multiply_function7)
def MULH = register_instruction("MULH", OP, 1, multiply_function7)
def MULHSU = register_instruction("MULHSU", OP, 2, multiply_function7)
def MULHU = register_instruction("MULHU", OP, 3, multiply_function7)
def MULW = register_instruction("MULW", OP_32, 0, multiply_function7)

def RV32ZmmulRevision = "RV32 Zmmul 1.0"
def RV64ZmmulRevision = "RV64 Zmmul 1.0"
def RV32ZmmulInstructions = [MUL, MULH, MULHSU, MULHU]
def RV64ZmmulInstructions = RV32ZmmulInstructions ++ [MULW]
def RV32Zmmul = InstructionCatalog("RV32Zmmul", RV32ZmmulRevision, RV32ZmmulInstructions)
def RV64Zmmul = InstructionCatalog("RV64Zmmul", RV64ZmmulRevision, RV64ZmmulInstructions)

fun rv32zmmul_instruction(name :: String):
  RV32Zmmul.find(name)

fun rv64zmmul_instruction(name :: String):
  RV64Zmmul.find(name)

export:
  RV32ZmmulRevision
  RV64ZmmulRevision
  RV32ZmmulInstructions
  RV64ZmmulInstructions
  RV32Zmmul
  RV64Zmmul
  rv32zmmul_instruction
  rv64zmmul_instruction
  MUL
  MULH
  MULHSU
  MULHU
  MULW
