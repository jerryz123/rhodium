#lang rhombus
// Defines the complete half-precision floating-point instruction catalogs.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../support/annotations.rhm" open
  "../model/main.rhm" open
  "zfhmin.rhm" open

def OP_FP = 0x53
def HALF = 2

fun fused(name :: NonemptyString, operation :: Nat):
  instruction(name, FloatingR4RoundingFormat, [opcode.constrain(operation), fmt.constrain(HALF)])

fun binary_rounding(name :: NonemptyString, operation :: Nat):
  instruction(name, FloatingBinaryRoundingFormat, [opcode.constrain(OP_FP), funct5.constrain(operation), fmt.constrain(HALF)])

fun unary_rounding(name :: NonemptyString, operation :: Nat):
  instruction(name, FloatingUnaryRoundingFormat, [opcode.constrain(OP_FP), funct5.constrain(operation), fmt.constrain(HALF), rs2.constrain(0)])

fun binary_fixed(name :: NonemptyString, operation :: Nat, suboperation :: Nat):
  instruction(name, FloatingBinaryFormat, [opcode.constrain(OP_FP), funct5.constrain(operation), fmt.constrain(HALF), funct3.constrain(suboperation)])

fun compare(name :: NonemptyString, relation :: Nat):
  instruction(name, FloatingCompareFormat, [opcode.constrain(OP_FP), funct5.constrain(20), fmt.constrain(HALF), funct3.constrain(relation)])

fun float_to_integer_rounding(name :: NonemptyString, integer_kind :: Nat):
  instruction(name, FloatingToIntegerRoundingFormat, [opcode.constrain(OP_FP), funct5.constrain(24), fmt.constrain(HALF), rs2.constrain(integer_kind)])

fun integer_to_float_rounding(name :: NonemptyString, integer_kind :: Nat):
  instruction(name, IntegerToFloatingRoundingFormat, [opcode.constrain(OP_FP), funct5.constrain(26), fmt.constrain(HALF), rs2.constrain(integer_kind)])

def FMADD_H = fused("FMADD.H", 0x43)
def FMSUB_H = fused("FMSUB.H", 0x47)
def FNMSUB_H = fused("FNMSUB.H", 0x4B)
def FNMADD_H = fused("FNMADD.H", 0x4F)
def FADD_H = binary_rounding("FADD.H", 0)
def FSUB_H = binary_rounding("FSUB.H", 1)
def FMUL_H = binary_rounding("FMUL.H", 2)
def FDIV_H = binary_rounding("FDIV.H", 3)
def FSQRT_H = unary_rounding("FSQRT.H", 11)
def FSGNJ_H = binary_fixed("FSGNJ.H", 4, 0)
def FSGNJN_H = binary_fixed("FSGNJN.H", 4, 1)
def FSGNJX_H = binary_fixed("FSGNJX.H", 4, 2)
def FMIN_H = binary_fixed("FMIN.H", 5, 0)
def FMAX_H = binary_fixed("FMAX.H", 5, 1)
def FEQ_H = compare("FEQ.H", 2)
def FLT_H = compare("FLT.H", 1)
def FLE_H = compare("FLE.H", 0)
def FCLASS_H = instruction("FCLASS.H", FloatingToIntegerFormat, [opcode.constrain(OP_FP), funct5.constrain(28), fmt.constrain(HALF), rs2.constrain(0), funct3.constrain(1)])
def FCVT_W_H = float_to_integer_rounding("FCVT.W.H", 0)
def FCVT_WU_H = float_to_integer_rounding("FCVT.WU.H", 1)
def FCVT_H_W = integer_to_float_rounding("FCVT.H.W", 0)
def FCVT_H_WU = integer_to_float_rounding("FCVT.H.WU", 1)
def FCVT_L_H = float_to_integer_rounding("FCVT.L.H", 2)
def FCVT_LU_H = float_to_integer_rounding("FCVT.LU.H", 3)
def FCVT_H_L = integer_to_float_rounding("FCVT.H.L", 2)
def FCVT_H_LU = integer_to_float_rounding("FCVT.H.LU", 3)

def ZfhInstructions = ZfhminInstructions ++ [
  FMADD_H, FMSUB_H, FNMSUB_H, FNMADD_H,
  FADD_H, FSUB_H, FMUL_H, FDIV_H, FSQRT_H,
  FSGNJ_H, FSGNJN_H, FSGNJX_H, FMIN_H, FMAX_H,
  FEQ_H, FLT_H, FLE_H, FCLASS_H,
  FCVT_W_H, FCVT_WU_H, FCVT_H_W, FCVT_H_WU
]
def RV32ZfhInstructions = ZfhInstructions
def RV64ZfhInstructions = ZfhInstructions ++ [FCVT_L_H, FCVT_LU_H, FCVT_H_L, FCVT_H_LU]
def ZfhRevision = "Zfh 1.0"
def RV32Zfh = InstructionCatalog("RV32Zfh", ZfhRevision, ZfhInstructions)
def RV64Zfh = InstructionCatalog("RV64Zfh", ZfhRevision, RV64ZfhInstructions)

fun rv32zfh_instruction(name :: String): RV32Zfh.find(name)
fun rv64zfh_instruction(name :: String): RV64Zfh.find(name)

export:
  ZfhInstructions
  RV32ZfhInstructions
  RV64ZfhInstructions
  ZfhRevision
  RV32Zfh
  RV64Zfh
  rv32zfh_instruction
  rv64zfh_instruction
  FMADD_H FMSUB_H FNMSUB_H FNMADD_H FADD_H FSUB_H FMUL_H FDIV_H FSQRT_H
  FSGNJ_H FSGNJN_H FSGNJX_H FMIN_H FMAX_H FEQ_H FLT_H FLE_H FCLASS_H
  FCVT_W_H FCVT_WU_H FCVT_H_W FCVT_H_WU FCVT_L_H FCVT_LU_H FCVT_H_L FCVT_H_LU
