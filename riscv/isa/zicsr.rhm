#lang rhombus
// Enumerates the six XLEN-independent Zicsr instruction encodings.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../support/annotations.rhm" open
  "../model/main.rhm" open
  "integer-common.rhm" open

export:
  ZicsrRevision
  ZicsrInstructions
  Zicsr
  CSRRW
  CSRRS
  CSRRC
  CSRRWI
  CSRRSI
  CSRRCI

def CsrRegisterFormat = InstructionFormat(
  "CSR-register",
  [RegisterOperand("rd", rd, "destination"),
   RegisterOperand("rs1", rs1, "source")],
  #false,
  [immediate12]
)
def CsrImmediateFormat = InstructionFormat(
  "CSR-immediate",
  [RegisterOperand("rd", rd, "destination")],
  #false,
  [rs1, immediate12]
)

fun csr_instruction(name :: NonemptyString,
                    format :: InstructionFormat,
                    function3 :: Nat):
  instruction(name,
              format,
              [opcode.constrain(SYSTEM), funct3.constrain(function3)])

def CSRRW = csr_instruction("CSRRW", CsrRegisterFormat, 1)
def CSRRS = csr_instruction("CSRRS", CsrRegisterFormat, 2)
def CSRRC = csr_instruction("CSRRC", CsrRegisterFormat, 3)
def CSRRWI = csr_instruction("CSRRWI", CsrImmediateFormat, 5)
def CSRRSI = csr_instruction("CSRRSI", CsrImmediateFormat, 6)
def CSRRCI = csr_instruction("CSRRCI", CsrImmediateFormat, 7)

def ZicsrRevision = "Zicsr 2.0"
def ZicsrInstructions = [CSRRW, CSRRS, CSRRC, CSRRWI, CSRRSI, CSRRCI]
def Zicsr = InstructionCatalog("Zicsr", ZicsrRevision, ZicsrInstructions)
