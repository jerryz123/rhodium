#lang rhombus
// Defines the ratified RV32 and RV64 Zbs single-bit instruction catalogs.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../support/annotations.rhm" open
  "../model/main.rhm" open
  "integer-common.rhm" open

fun shift32_instruction(name :: NonemptyString,
                        function3 :: Nat,
                        function7 :: Nat):
  instruction(name,
              Shift32Format,
              [opcode.constrain(OP_IMM), funct3.constrain(function3), funct7.constrain(function7)])

fun shift64_instruction(name :: NonemptyString,
                        function3 :: Nat,
                        function6 :: Nat):
  instruction(name,
              Shift64Format,
              [opcode.constrain(OP_IMM), funct3.constrain(function3), funct6.constrain(function6)])

def BCLR = register_instruction("BCLR", OP, 1, 0x24)
def BEXT = register_instruction("BEXT", OP, 5, 0x24)
def BINV = register_instruction("BINV", OP, 1, 0x34)
def BSET = register_instruction("BSET", OP, 1, 0x14)
def RV32_BCLRI = shift32_instruction("BCLRI", 1, 0x24)
def RV32_BEXTI = shift32_instruction("BEXTI", 5, 0x24)
def RV32_BINVI = shift32_instruction("BINVI", 1, 0x34)
def RV32_BSETI = shift32_instruction("BSETI", 1, 0x14)
def BCLRI = shift64_instruction("BCLRI", 1, 0x12)
def BEXTI = shift64_instruction("BEXTI", 5, 0x12)
def BINVI = shift64_instruction("BINVI", 1, 0x1A)
def BSETI = shift64_instruction("BSETI", 1, 0x0A)

def RV32ZbsInstructions = [
  BCLR, RV32_BCLRI,
  BEXT, RV32_BEXTI,
  BINV, RV32_BINVI,
  BSET, RV32_BSETI
]
def RV64ZbsInstructions = [
  BCLR, BCLRI,
  BEXT, BEXTI,
  BINV, BINVI,
  BSET, BSETI
]
def RV32ZbsRevision = "RV32 Zbs 1.0.0"
def RV64ZbsRevision = "RV64 Zbs 1.0.0"
def RV32Zbs = InstructionCatalog("RV32Zbs", RV32ZbsRevision, RV32ZbsInstructions)
def RV64Zbs = InstructionCatalog("RV64Zbs", RV64ZbsRevision, RV64ZbsInstructions)

export:
  RV32ZbsInstructions
  RV64ZbsInstructions
  RV32ZbsRevision
  RV64ZbsRevision
  RV32Zbs
  RV64Zbs
  BCLR
  BEXT
  BINV
  BSET
  RV32_BCLRI
  RV32_BEXTI
  RV32_BINVI
  RV32_BSETI
  BCLRI
  BEXTI
  BINVI
  BSETI
