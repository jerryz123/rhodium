#lang rhombus
// Defines the RV32A and RV64A atomic-instruction catalogs and encodings.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../support/annotations.rhm" open
  "../model/main.rhm" open

def AMO = 0x2F
def WORD = 2
def DOUBLE = 3

fun atomic_instruction(name :: NonemptyString,
                       width :: Nat,
                       operation :: Nat):
  instruction(name,
              AtomicFormat,
              [opcode.constrain(AMO),
               funct3.constrain(width),
               funct5.constrain(operation)])

fun load_reserved_instruction(name :: NonemptyString, width :: Nat):
  instruction(name,
              LoadReservedFormat,
              [opcode.constrain(AMO),
               funct3.constrain(width),
               funct5.constrain(2),
               rs2.constrain(0)])

def LR_W = load_reserved_instruction("LR.W", WORD)
def SC_W = atomic_instruction("SC.W", WORD, 3)
def AMOSWAP_W = atomic_instruction("AMOSWAP.W", WORD, 1)
def AMOADD_W = atomic_instruction("AMOADD.W", WORD, 0)
def AMOXOR_W = atomic_instruction("AMOXOR.W", WORD, 4)
def AMOAND_W = atomic_instruction("AMOAND.W", WORD, 12)
def AMOOR_W = atomic_instruction("AMOOR.W", WORD, 8)
def AMOMIN_W = atomic_instruction("AMOMIN.W", WORD, 16)
def AMOMAX_W = atomic_instruction("AMOMAX.W", WORD, 20)
def AMOMINU_W = atomic_instruction("AMOMINU.W", WORD, 24)
def AMOMAXU_W = atomic_instruction("AMOMAXU.W", WORD, 28)

def LR_D = load_reserved_instruction("LR.D", DOUBLE)
def SC_D = atomic_instruction("SC.D", DOUBLE, 3)
def AMOSWAP_D = atomic_instruction("AMOSWAP.D", DOUBLE, 1)
def AMOADD_D = atomic_instruction("AMOADD.D", DOUBLE, 0)
def AMOXOR_D = atomic_instruction("AMOXOR.D", DOUBLE, 4)
def AMOAND_D = atomic_instruction("AMOAND.D", DOUBLE, 12)
def AMOOR_D = atomic_instruction("AMOOR.D", DOUBLE, 8)
def AMOMIN_D = atomic_instruction("AMOMIN.D", DOUBLE, 16)
def AMOMAX_D = atomic_instruction("AMOMAX.D", DOUBLE, 20)
def AMOMINU_D = atomic_instruction("AMOMINU.D", DOUBLE, 24)
def AMOMAXU_D = atomic_instruction("AMOMAXU.D", DOUBLE, 28)

def RV32AInstructions = [
  LR_W, SC_W,
  AMOSWAP_W, AMOADD_W, AMOXOR_W, AMOAND_W, AMOOR_W,
  AMOMIN_W, AMOMAX_W, AMOMINU_W, AMOMAXU_W
]
def RV64AInstructions = RV32AInstructions ++ [
  LR_D, SC_D,
  AMOSWAP_D, AMOADD_D, AMOXOR_D, AMOAND_D, AMOOR_D,
  AMOMIN_D, AMOMAX_D, AMOMINU_D, AMOMAXU_D
]
def RV32ARevision = "RV32 A 2.1"
def RV64ARevision = "RV64 A 2.1"
def RV32A = InstructionCatalog("RV32A", RV32ARevision, RV32AInstructions)
def RV64A = InstructionCatalog("RV64A", RV64ARevision, RV64AInstructions)

fun rv32a_instruction(name :: String):
  RV32A.find(name)

fun rv64a_instruction(name :: String):
  RV64A.find(name)

export:
  RV32AInstructions
  RV64AInstructions
  RV32ARevision
  RV64ARevision
  RV32A
  RV64A
  rv32a_instruction
  rv64a_instruction
  LR_W
  SC_W
  AMOSWAP_W
  AMOADD_W
  AMOXOR_W
  AMOAND_W
  AMOOR_W
  AMOMIN_W
  AMOMAX_W
  AMOMINU_W
  AMOMAXU_W
  LR_D
  SC_D
  AMOSWAP_D
  AMOADD_D
  AMOXOR_D
  AMOAND_D
  AMOOR_D
  AMOMIN_D
  AMOMAX_D
  AMOMINU_D
  AMOMAXU_D
