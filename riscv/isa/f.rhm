#lang rhombus
// Defines the standard single-precision floating-point instruction catalogs.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../support/annotations.rhm" open
  "../model/main.rhm" open

def LOAD_FP = 0x07
def STORE_FP = 0x27
def OP_FP = 0x53
def SINGLE = 0

fun floating_load(name :: NonemptyString, width :: Nat):
  instruction(name, FloatingLoadFormat, [opcode.constrain(LOAD_FP), funct3.constrain(width)])

fun floating_store(name :: NonemptyString, width :: Nat):
  instruction(name, FloatingStoreFormat, [opcode.constrain(STORE_FP), funct3.constrain(width)])

fun fused(name :: NonemptyString, operation :: Nat):
  instruction(name, FloatingR4RoundingFormat, [opcode.constrain(operation), fmt.constrain(SINGLE)])

fun binary_rounding(name :: NonemptyString, operation :: Nat):
  instruction(name, FloatingBinaryRoundingFormat, [opcode.constrain(OP_FP), funct5.constrain(operation), fmt.constrain(SINGLE)])

fun unary_rounding(name :: NonemptyString, operation :: Nat):
  instruction(name, FloatingUnaryRoundingFormat, [opcode.constrain(OP_FP), funct5.constrain(operation), fmt.constrain(SINGLE), rs2.constrain(0)])

fun binary_fixed(name :: NonemptyString, operation :: Nat, suboperation :: Nat):
  instruction(name, FloatingBinaryFormat, [opcode.constrain(OP_FP), funct5.constrain(operation), fmt.constrain(SINGLE), funct3.constrain(suboperation)])

fun compare(name :: NonemptyString, relation :: Nat):
  instruction(name, FloatingCompareFormat, [opcode.constrain(OP_FP), funct5.constrain(20), fmt.constrain(SINGLE), funct3.constrain(relation)])

fun float_to_integer_rounding(name :: NonemptyString, integer_kind :: Nat):
  instruction(name, FloatingToIntegerRoundingFormat, [opcode.constrain(OP_FP), funct5.constrain(24), fmt.constrain(SINGLE), rs2.constrain(integer_kind)])

fun integer_to_float_rounding(name :: NonemptyString, integer_kind :: Nat):
  instruction(name, IntegerToFloatingRoundingFormat, [opcode.constrain(OP_FP), funct5.constrain(26), fmt.constrain(SINGLE), rs2.constrain(integer_kind)])

def FLW = floating_load("FLW", 2)
def FSW = floating_store("FSW", 2)
def FMADD_S = fused("FMADD.S", 0x43)
def FMSUB_S = fused("FMSUB.S", 0x47)
def FNMSUB_S = fused("FNMSUB.S", 0x4B)
def FNMADD_S = fused("FNMADD.S", 0x4F)
def FADD_S = binary_rounding("FADD.S", 0)
def FSUB_S = binary_rounding("FSUB.S", 1)
def FMUL_S = binary_rounding("FMUL.S", 2)
def FDIV_S = binary_rounding("FDIV.S", 3)
def FSQRT_S = unary_rounding("FSQRT.S", 11)
def FSGNJ_S = binary_fixed("FSGNJ.S", 4, 0)
def FSGNJN_S = binary_fixed("FSGNJN.S", 4, 1)
def FSGNJX_S = binary_fixed("FSGNJX.S", 4, 2)
def FMIN_S = binary_fixed("FMIN.S", 5, 0)
def FMAX_S = binary_fixed("FMAX.S", 5, 1)
def FCVT_W_S = float_to_integer_rounding("FCVT.W.S", 0)
def FCVT_WU_S = float_to_integer_rounding("FCVT.WU.S", 1)
def FMV_X_W = instruction("FMV.X.W", FloatingToIntegerFormat, [opcode.constrain(OP_FP), funct5.constrain(28), fmt.constrain(SINGLE), rs2.constrain(0), funct3.constrain(0)])
def FEQ_S = compare("FEQ.S", 2)
def FLT_S = compare("FLT.S", 1)
def FLE_S = compare("FLE.S", 0)
def FCLASS_S = instruction("FCLASS.S", FloatingToIntegerFormat, [opcode.constrain(OP_FP), funct5.constrain(28), fmt.constrain(SINGLE), rs2.constrain(0), funct3.constrain(1)])
def FCVT_S_W = integer_to_float_rounding("FCVT.S.W", 0)
def FCVT_S_WU = integer_to_float_rounding("FCVT.S.WU", 1)
def FMV_W_X = instruction("FMV.W.X", IntegerToFloatingFormat, [opcode.constrain(OP_FP), funct5.constrain(30), fmt.constrain(SINGLE), rs2.constrain(0), funct3.constrain(0)])
def FCVT_L_S = float_to_integer_rounding("FCVT.L.S", 2)
def FCVT_LU_S = float_to_integer_rounding("FCVT.LU.S", 3)
def FCVT_S_L = integer_to_float_rounding("FCVT.S.L", 2)
def FCVT_S_LU = integer_to_float_rounding("FCVT.S.LU", 3)

def RV32FInstructions = [
  FLW, FSW, FMADD_S, FMSUB_S, FNMSUB_S, FNMADD_S,
  FADD_S, FSUB_S, FMUL_S, FDIV_S, FSQRT_S,
  FSGNJ_S, FSGNJN_S, FSGNJX_S, FMIN_S, FMAX_S,
  FCVT_W_S, FCVT_WU_S, FMV_X_W, FEQ_S, FLT_S, FLE_S, FCLASS_S,
  FCVT_S_W, FCVT_S_WU, FMV_W_X
]
def RV64FInstructions = RV32FInstructions ++ [FCVT_L_S, FCVT_LU_S, FCVT_S_L, FCVT_S_LU]
def RV32FRevision = "RV32 F 2.2"
def RV64FRevision = "RV64 F 2.2"
def RV32F = InstructionCatalog("RV32F", RV32FRevision, RV32FInstructions)
def RV64F = InstructionCatalog("RV64F", RV64FRevision, RV64FInstructions)

fun rv32f_instruction(name :: String): RV32F.find(name)
fun rv64f_instruction(name :: String): RV64F.find(name)

export:
  RV32FInstructions
  RV64FInstructions
  RV32FRevision
  RV64FRevision
  RV32F
  RV64F
  rv32f_instruction
  rv64f_instruction
  FLW FSW FMADD_S FMSUB_S FNMSUB_S FNMADD_S
  FADD_S FSUB_S FMUL_S FDIV_S FSQRT_S
  FSGNJ_S FSGNJN_S FSGNJX_S FMIN_S FMAX_S
  FCVT_W_S FCVT_WU_S FMV_X_W FEQ_S FLT_S FLE_S FCLASS_S
  FCVT_S_W FCVT_S_WU FMV_W_X FCVT_L_S FCVT_LU_S FCVT_S_L FCVT_S_LU
