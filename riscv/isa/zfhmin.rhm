#lang rhombus
// Defines the standard minimal half-precision floating-point instruction catalogs.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../support/annotations.rhm" open
  "../model/main.rhm" open

def LOAD_FP = 0x07
def STORE_FP = 0x27
def OP_FP = 0x53
def HALF = 2

def FLH = instruction("FLH", FloatingLoadFormat, [opcode.constrain(LOAD_FP), funct3.constrain(1)])
def FSH = instruction("FSH", FloatingStoreFormat, [opcode.constrain(STORE_FP), funct3.constrain(1)])
def FMV_X_H = instruction("FMV.X.H", FloatingToIntegerFormat, [opcode.constrain(OP_FP), funct5.constrain(28), fmt.constrain(HALF), rs2.constrain(0), funct3.constrain(0)])
def FMV_H_X = instruction("FMV.H.X", IntegerToFloatingFormat, [opcode.constrain(OP_FP), funct5.constrain(30), fmt.constrain(HALF), rs2.constrain(0), funct3.constrain(0)])
def FCVT_S_H = instruction("FCVT.S.H", FloatingConvertFormat, [opcode.constrain(OP_FP), funct5.constrain(8), fmt.constrain(0), rs2.constrain(HALF)])
def FCVT_H_S = instruction("FCVT.H.S", FloatingConvertFormat, [opcode.constrain(OP_FP), funct5.constrain(8), fmt.constrain(HALF), rs2.constrain(0)])
def FCVT_D_H = instruction("FCVT.D.H", FloatingConvertFormat, [opcode.constrain(OP_FP), funct5.constrain(8), fmt.constrain(1), rs2.constrain(HALF)])
def FCVT_H_D = instruction("FCVT.H.D", FloatingConvertFormat, [opcode.constrain(OP_FP), funct5.constrain(8), fmt.constrain(HALF), rs2.constrain(1)])

def ZfhminInstructions = [FLH, FSH, FMV_X_H, FMV_H_X, FCVT_S_H, FCVT_H_S]
def ZfhminDInstructions = [FCVT_D_H, FCVT_H_D]
def ZfhminRevision = "Zfhmin 1.0"
def Zfhmin = InstructionCatalog("Zfhmin", ZfhminRevision, ZfhminInstructions)
def ZfhminD = InstructionCatalog("Zfhmin with D", ZfhminRevision, ZfhminInstructions ++ ZfhminDInstructions)

fun zfhmin_instruction(name :: String): Zfhmin.find(name)
fun zfhmin_d_instruction(name :: String): ZfhminD.find(name)

export:
  ZfhminInstructions
  ZfhminDInstructions
  ZfhminRevision
  Zfhmin
  ZfhminD
  zfhmin_instruction
  zfhmin_d_instruction
  FLH FSH FMV_X_H FMV_H_X FCVT_S_H FCVT_H_S FCVT_D_H FCVT_H_D
