#lang rhodium
// Exercises descriptor-derived CSR recognition, reads, writes, and invalid tables.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../riscv/isa/csr.rhm" open
  "../../../riscv/rtl/csr.rhdl" open

sync_circuit CsrBankFixture():
  input address: Bits(12)
  input write_enable: Bool
  input replacement: Bits(8)
  output recognized: Bool
  output read_value: Bits(8)

  reg stored(~init: Bits(8)(0))
  def bank = csr_bank(address, ~default: Bits(8)(0xff)):
    storage CsrId.Mscratch: stored
    read CsrId.Misa: Bits(8)(0x42)

  recognized <== bank.recognized
  read_value <== bank.read_value
  when write_enable:
    bank.write(replacement)

circuit DuplicateCsrBankFixture():
  input address: Bits(12)
  output read_value: Bits(8)
  def bank = csr_bank(address, ~default: Bits(8)(0)):
    read CsrId.Misa: Bits(8)(1)
    read CsrId.Misa: Bits(8)(2)

  read_value <== bank.read_value

circuit DuplicateCsrGroupFixture():
  input address: Bits(12)
  output read_value: Bits(8)
  def bank = csr_bank(address, ~default: Bits(8)(0)):
    read CsrId.Mhpmcounter3: Bits(8)(1)
    read_all MachineHpmCounterIds: Bits(8)(0)

  read_value <== bank.read_value

circuit NarrowCsrBankFixture():
  input address: Bits(8)
  output read_value: Bits(8)
  def bank = csr_bank(address, ~default: Bits(8)(0)):
    read CsrId.Misa: Bits(8)(1)

  read_value <== bank.read_value

export:
  CsrBankFixture
  DuplicateCsrBankFixture
  DuplicateCsrGroupFixture
  NarrowCsrBankFixture
