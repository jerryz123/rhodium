#lang rhombus
// Checks elaboration and verification of the RISC-V floating-point helper surface.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  "../../../rhodium/core/main.rhm" open
  "riscv-floating-point-fixture.rhdl" as fixture

def fixture_design = compile_program(fixture.program, rtl_target).report.design

def module_def = fixture_design.modules.find(fun (candidate): candidate.name == "RiscvFloatingPointFixture")

check:
  type_equal(module_def.find_output("boxed").type, Bits(64)) ~is #true
  type_equal(module_def.find_output("classification").type, Bits(10)) ~is #true
  verify_design(fixture_design) ~is #void
