#lang rhombus
// Checks CSR-bank expansion, aggregate effects, and table validation.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  "../../../rhodium/core/main.rhm" open
  lib("rhodium/frontend/foundation.rhm").elaborate
  "riscv-csr-bank-fixture.rhdl" as fixture

def design = compile_program(elaborate(fixture.CsrBankFixture()), rtl_target).report.design
def module_def = design.modules[0]

check:
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "rtl.register_reset"
  ).map(fun (operation): operation.attribute("name")) ~is ["stored"]
  verify_design(design) ~is #void
  elaborate(fixture.DuplicateCsrBankFixture()) ~throws "unique"
  elaborate(fixture.DuplicateCsrGroupFixture()) ~throws "unique"
  elaborate(fixture.NarrowCsrBankFixture()) ~throws "Bits(12)"
