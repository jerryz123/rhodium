#lang rhombus
// Defines a program for the reusable RV64 word/doubleword atomic ALU fixture.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../../riscv/isa/xlen.rhm" open
  "../../../../riscv/rtl/atomic.rhdl" as atomic

def program = elaborate(atomic.RiscvAtomicALU(XLen.X64)
)
export program
