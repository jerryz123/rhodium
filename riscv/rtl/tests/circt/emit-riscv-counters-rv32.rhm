#lang rhombus
// Defines a program for the RV32 specialization of reusable RISC-V base counters.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../../riscv/isa/xlen.rhm" open
  "../../../../riscv/rtl/counters.rhdl" as counters

def program = elaborate(counters.RiscvBaseCounters(XLen.X32))
export program
