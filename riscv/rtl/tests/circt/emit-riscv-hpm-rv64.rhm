import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../isa/xlen.rhm" open
  "../../hpm-counter.rhdl" as hpm

def program = elaborate(hpm.RiscvHpmCounter(XLen.X64, ~hypervisor: #true))
export program
