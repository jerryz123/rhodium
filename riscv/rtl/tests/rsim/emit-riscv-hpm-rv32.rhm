#lang rhombus
// Defines the RV32 non-hypervisor HPM counter for behavioral simulation.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../isa/xlen.rhm" open
  "../../hpm-counter.rhdl" as hpm

def program = elaborate(hpm.RiscvHpmCounter(XLen.X32, ~hypervisor: #false))
export program
