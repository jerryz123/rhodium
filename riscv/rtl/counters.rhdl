#lang rhodium
// Implements reusable 64-bit RISC-V cycle and instruction-retirement counters.
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/csr.rhm" open
  "../isa/xlen.rhm" open
  "csr.rhdl" open
  lib("rhodium/std/ready-valid.rhdl") open

bundle RiscvCounterWrite(xlen :: XLen):
  address: Bits(12)
  value: Bits(xlen.width)

sync_circuit RiscvBaseCounters(xlen :: XLen):
  input retire: Bool
  interface machine_write(Valid(RiscvCounterWrite(xlen)), ~role: consumer)
  output cycle: Bits(64)
  output instret: Bits(64)

  reg cycle_counter(~init: bits(0, 64))
  reg instret_counter(~init: bits(0, 64))

  def cycle_low_write = machine_write.valid & (machine_write.bits.address === csr_bits(CsrId.Mcycle))
  def cycle_high_write = if xlen == XLen.X32 | machine_write.valid & (machine_write.bits.address === csr_bits(CsrId.Mcycleh)) | Bool(#false)
  def instret_low_write = machine_write.valid & (machine_write.bits.address === csr_bits(CsrId.Minstret))
  def instret_high_write = if xlen == XLen.X32 | machine_write.valid & (machine_write.bits.address === csr_bits(CsrId.Minstreth)) | Bool(#false)
  def cycle_replacement:
    if xlen == XLen.X32
    | mux(cycle_high_write,
          (machine_write.bits.value ++ cycle_counter[0..32]),
          (cycle_counter[32..64] ++ machine_write.bits.value))
    | machine_write.bits.value
  def instret_replacement:
    if xlen == XLen.X32
    | mux(instret_high_write,
          (machine_write.bits.value ++ instret_counter[0..32]),
          (instret_counter[32..64] ++ machine_write.bits.value))
    | machine_write.bits.value

  when (cycle_low_write ||| cycle_high_write):
    cycle_counter <== cycle_replacement
  otherwise:
    cycle_counter <== cycle_counter + bits(1, 64)

  when (instret_low_write ||| instret_high_write):
    instret_counter <== instret_replacement
  elsewhen retire:
    instret_counter <== instret_counter + bits(1, 64)

  cycle <== cycle_counter
  instret <== instret_counter

export:
  RiscvCounterWrite
  RiscvBaseCounters
