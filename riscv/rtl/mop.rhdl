#lang rhodium
// Preserves the MOP-specific decode-overlay name over the generic std helper.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/decode.rhdl") open

fun resolve_mop_decode_cases(fallbacks :: List.of(DecodeCase),
                             overrides :: List.of(DecodeCase)):
  overlay_decode_cases(fallbacks, overrides)

export:
  resolve_mop_decode_cases
