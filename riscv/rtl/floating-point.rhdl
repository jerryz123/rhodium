#lang rhodium
// Implements reusable RISC-V policy around architectural IEEE floating-point values.

import:
  lib("hardfloat/main.rhdl") open
  lib("riscv/isa/xlen.rhm") open

hardware_enum FloatSignOperation:
  Copy
  Negate
  Xor

bundle RiscvRoundingMode():
  valid: Bool
  mode: RoundingMode

fun riscv_rounding_mode(instruction_mode :: Bits(3), dynamic_mode :: Bits(3)) :~ RiscvRoundingMode():
  def selected = mux(instruction_mode === bits(7, 3), dynamic_mode, instruction_mode)
  RiscvRoundingMode():
    valid: selected < bits(5, 3)
    mode: selected.into(RoundingMode)

fun riscv_exception_flags(flags :: ExceptionFlags()) :~ Bits(5):
  concat(flags.invalid, flags.infinite, flags.overflow, flags.underflow, flags.inexact)

fun riscv_integer_exception_flags(flags :: IntegerExceptionFlags()) :~ Bits(5):
  concat(flags.invalid ||| flags.overflow, bits(0, 3), flags.inexact)

fun riscv_canonical_nan(format :: FloatFormat) :~ IEEEFloat(format):
  concat(bits(0, 1), bits((1 << format.exponent_width) - 1, format.exponent_width), bits(1 << (format.significand_width - 2), format.significand_width - 1)).into(IEEEFloat(format))

fun riscv_canonicalize_nan(format :: FloatFormat, value :: IEEEFloat(format)) :~ IEEEFloat(format):
  mux(value.to_raw().is_nan, riscv_canonical_nan(format), value)

fun riscv_float_immediate_values(format :: FloatFormat) :: List.of(Nat):
  cond
  | format == FloatFormat.F16:
      [0xbc00, 0x0400, 0x0100, 0x0200, 0x1c00, 0x2000, 0x2c00, 0x3000,
       0x3400, 0x3500, 0x3600, 0x3700, 0x3800, 0x3900, 0x3a00, 0x3b00,
       0x3c00, 0x3d00, 0x3e00, 0x3f00, 0x4000, 0x4100, 0x4200, 0x4400,
       0x4800, 0x4c00, 0x5800, 0x5c00, 0x7800, 0x7c00, 0x7c00, 0x7e00]
  | format == FloatFormat.F32:
      [0xbf800000, 0x00800000, 0x37800000, 0x38000000,
       0x3b800000, 0x3c000000, 0x3d800000, 0x3e000000,
       0x3e800000, 0x3ea00000, 0x3ec00000, 0x3ee00000,
       0x3f000000, 0x3f200000, 0x3f400000, 0x3f600000,
       0x3f800000, 0x3fa00000, 0x3fc00000, 0x3fe00000,
       0x40000000, 0x40200000, 0x40400000, 0x40800000,
       0x41000000, 0x41800000, 0x43000000, 0x43800000,
       0x47000000, 0x47800000, 0x7f800000, 0x7fc00000]
  | format == FloatFormat.F64:
      [0xbff0000000000000, 0x0010000000000000,
       0x3ef0000000000000, 0x3f00000000000000,
       0x3f70000000000000, 0x3f80000000000000,
       0x3fb0000000000000, 0x3fc0000000000000,
       0x3fd0000000000000, 0x3fd4000000000000,
       0x3fd8000000000000, 0x3fdc000000000000,
       0x3fe0000000000000, 0x3fe4000000000000,
       0x3fe8000000000000, 0x3fec000000000000,
       0x3ff0000000000000, 0x3ff4000000000000,
       0x3ff8000000000000, 0x3ffc000000000000,
       0x4000000000000000, 0x4004000000000000,
       0x4008000000000000, 0x4010000000000000,
       0x4020000000000000, 0x4030000000000000,
       0x4060000000000000, 0x4070000000000000,
       0x40e0000000000000, 0x40f0000000000000,
       0x7ff0000000000000, 0x7ff8000000000000]
  | ~else:
      error(~who: #'riscv_float_immediate_values,
            "RISC-V floating-point immediates require F16, F32, or F64")

fun riscv_float_immediate(format :: FloatFormat, index :: Bits(5)) :~ IEEEFloat(format):
  def constants = riscv_float_immediate_values(format)
  mux_lookup(
    index,
    ~default: bits(constants[0], format.ieee_width),
    for List (value in constants, selector in 0..constants.length()):
      [selector, bits(value, format.ieee_width)]
  ).into(IEEEFloat(format))

fun riscv_nan_box(format :: FloatFormat, value :: IEEEFloat(format), width :: PosInt) :~ Bits(width):
  unless width >= format.ieee_width
  | error(~who: #'riscv_nan_box, "container width must cover the floating-point value")
  if width == format.ieee_width | value.as_bits() | (bits((1 << (width - format.ieee_width)) - 1, width - format.ieee_width) ++ value.as_bits())

fun riscv_nan_box_valid(format :: FloatFormat, width :: PosInt, value :: Bits(width)) :~ Bool:
  unless width >= format.ieee_width
  | error(~who: #'riscv_nan_box_valid, "container width must cover the floating-point value")
  if width == format.ieee_width | Bool(#true) | value[format.ieee_width..width].and_reduce()

fun riscv_unbox(format :: FloatFormat, width :: PosInt, value :: Bits(width)) :~ IEEEFloat(format):
  unless width >= format.ieee_width
  | error(~who: #'riscv_unbox, "container width must cover the floating-point value")
  def payload = if width == format.ieee_width | value | value[0..format.ieee_width]
  mux(riscv_nan_box_valid(format, width, value), payload.into(IEEEFloat(format)), riscv_canonical_nan(format))

fun riscv_sign_inject(format :: FloatFormat, left :: IEEEFloat(format), right :: IEEEFloat(format), operation :: FloatSignOperation) :~ IEEEFloat(format):
  def left_bits = left.as_bits()
  def right_sign = right.as_bits()[format.ieee_width - 1].into(Bool)
  def sign = mux_lookup(operation, ~default: left_bits[format.ieee_width - 1].into(Bool) ^ right_sign, [[FloatSignOperation.Copy, right_sign], [FloatSignOperation.Negate, !right_sign]])
  (sign ++ left_bits[0..(format.ieee_width - 1)]).into(IEEEFloat(format))

fun riscv_float_to_integer_move(xlen :: XLen, format :: FloatFormat, value :: IEEEFloat(format)) :~ Bits(xlen.width):
  unless format.ieee_width <= xlen.width
  | error(~who: #'riscv_float_to_integer_move, "floating-point value must fit XLEN")
  if format.ieee_width == xlen.width | value.as_bits() | value.as_bits().into(SInt(format.ieee_width)).sext(xlen.width).as_bits()

fun riscv_integer_to_float_move(format :: FloatFormat, width :: PosInt, value :: Bits(width)) :~ IEEEFloat(format):
  unless width >= format.ieee_width
  | error(~who: #'riscv_integer_to_float_move, "integer value must cover the floating-point value")
  if width == format.ieee_width | value.into(IEEEFloat(format)) | value[0..format.ieee_width].into(IEEEFloat(format))

fun riscv_classify(format :: FloatFormat, value :: IEEEFloat(format)) :~ Bits(10):
  value.to_recoded().classify().as_bits()

export:
  FloatSignOperation
  RiscvRoundingMode
  riscv_rounding_mode
  riscv_exception_flags
  riscv_integer_exception_flags
  riscv_canonical_nan
  riscv_canonicalize_nan
  riscv_float_immediate_values
  riscv_float_immediate
  riscv_nan_box
  riscv_nan_box_valid
  riscv_unbox
  riscv_sign_inject
  riscv_float_to_integer_move
  riscv_integer_to_float_move
  riscv_classify
