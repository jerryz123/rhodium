#lang rhodium
/* Resolves physical M/S and software-injected VS interrupts, priority, and delegation. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/csr.rhm" open
  "../isa/interrupt.rhm" open
  "../isa/xlen.rhm" open
  "csr.rhdl".csr_flag
  "privilege.rhdl" open
  lib("rhodium/std/bits.rhdl") open

/* Carries the six physical machine/supervisor software, timer, and external pending sources. */
bundle RiscvInterrupts():
  supervisor_software: Bool
  machine_software: Bool
  supervisor_timer: Bool
  machine_timer: Bool
  supervisor_external: Bool
  machine_external: Bool

/* Carries selected-interrupt validity, an XLEN-sized architectural cause, and the trap target. */
bundle RiscvInterruptDecision(xlen :: XLen):
  valid: Bool
  cause: Bits(xlen.width)
  target: RiscvTrapTarget

/* Packs physical pending sources at their architectural interrupt bit positions. */
fun riscv_interrupt_pending(xlen :: XLen,
                            interrupts :: RiscvInterrupts()) :~ Bits(xlen.width):
  pack_fields(xlen.width, [
    [interrupt_code(InterruptCause.SupervisorSoftware), interrupts.supervisor_software],
    [interrupt_code(InterruptCause.MachineSoftware), interrupts.machine_software],
    [interrupt_code(InterruptCause.SupervisorTimer), interrupts.supervisor_timer],
    [interrupt_code(InterruptCause.MachineTimer), interrupts.machine_timer],
    [interrupt_code(InterruptCause.SupervisorExternal), interrupts.supervisor_external],
    [interrupt_code(InterruptCause.MachineExternal), interrupts.machine_external]
  ])

/* Builds an interrupt cause image with the top interrupt bit and architectural cause number. */
fun interrupt_cause_bits(cause :: InterruptCause,
                         width :: PosInt) :~ Bits(width):
  bits((1 bits.(<<) (width - 1)) bits.or interrupt_code(cause), width)

/* Selects enabled M/S interrupts by trap destination first, then architectural cause priority.
 * Each destination retains its own global privilege gate; counter overflow is last within it.
 */
fun resolve_riscv_interrupt(xlen :: XLen,
                            pending :: Bits(xlen.width),
                            enabled :: Bits(xlen.width),
                            delegated :: Bits(xlen.width),
                            mstatus :: Bits(xlen.width),
                            privilege :: PrivilegeMode) :~ RiscvInterruptDecision(xlen):
  def width = xlen.width
  def machine_globally_enabled = (privilege =/= PrivilegeMode.Machine) ||| csr_flag(mstatus, MstatusMIE)
  def supervisor_globally_enabled = (privilege === PrivilegeMode.User) ||| ((privilege === PrivilegeMode.Supervisor) & csr_flag(mstatus, MstatusSIE))
  def supported = bits(interrupt_mask(InterruptCauses ++ [InterruptCause.LocalCounterOverflow]), width)
  def active = pending & enabled & supported
  /* Applies cause priority within one already-partitioned trap destination. */
  fun select_destination(candidates :: Bits(width), globally_enabled :: Bool, target :: RiscvTrapTarget) :~ RiscvInterruptDecision(xlen):
    def cause = priority_mux(~default: interrupt_cause_bits(InterruptCause.LocalCounterOverflow, width)):
      candidates[interrupt_code(InterruptCause.MachineExternal)].into(Bool): interrupt_cause_bits(InterruptCause.MachineExternal, width)
      candidates[interrupt_code(InterruptCause.MachineSoftware)].into(Bool): interrupt_cause_bits(InterruptCause.MachineSoftware, width)
      candidates[interrupt_code(InterruptCause.MachineTimer)].into(Bool): interrupt_cause_bits(InterruptCause.MachineTimer, width)
      candidates[interrupt_code(InterruptCause.SupervisorExternal)].into(Bool): interrupt_cause_bits(InterruptCause.SupervisorExternal, width)
      candidates[interrupt_code(InterruptCause.SupervisorSoftware)].into(Bool): interrupt_cause_bits(InterruptCause.SupervisorSoftware, width)
      candidates[interrupt_code(InterruptCause.SupervisorTimer)].into(Bool): interrupt_cause_bits(InterruptCause.SupervisorTimer, width)
    RiscvInterruptDecision(xlen):
      valid: candidates.or_reduce() & globally_enabled
      cause: cause
      target: target
  def machine = select_destination(active & !delegated, machine_globally_enabled, RiscvTrapTarget.Machine)
  def supervisor = select_destination(active & delegated, supervisor_globally_enabled, RiscvTrapTarget.Supervisor)
  mux(machine.valid ||| !supervisor.valid, machine, supervisor)

/* Selects M, HS, and VS delivery for baseline H with GEILEN=0.
 * Virtual pending/enables use their M/H positions;
 * only delivery to VS renumbers causes. No guest controller or AIA state. */
fun resolve_riscv_hypervisor_interrupt(
  pending :: Bits(64), enabled :: Bits(64), mideleg :: Bits(64), hideleg :: Bits(64),
  mstatus :: Bits(64), vsstatus :: Bits(64), context :: RiscvExecutionContext()
) :~ RiscvInterruptDecision(XLen.X64):
  def effective_host_privilege = mux(context.virtualized, PrivilegeMode.User, context.privilege)
  def machine = resolve_riscv_interrupt(XLen.X64, pending & !mideleg, enabled, bits(0, 64), mstatus, effective_host_privilege)
  def overflow_mask = bits(interrupt_mask([InterruptCause.LocalCounterOverflow]), 64)
  def supervisor = resolve_riscv_interrupt(XLen.X64, pending & mideleg & !overflow_mask, enabled, mideleg, mstatus, effective_host_privilege)
  def overflow = resolve_riscv_interrupt(XLen.X64, pending & mideleg & overflow_mask, enabled, mideleg, mstatus, effective_host_privilege)
  def hs_enabled = context.virtualized ||| (context.privilege === PrivilegeMode.User) ||| ((context.privilege === PrivilegeMode.Supervisor) & csr_flag(mstatus, MstatusSIE))
  def vs_enabled = context.virtualized & ((context.privilege === PrivilegeMode.User) ||| csr_flag(vsstatus, MstatusSIE))
  def virtual_mask = bits(interrupt_mask(VirtualSupervisorInterruptCauses), 64)
  def active = pending & enabled & mideleg & virtual_mask
  /* Selects virtual external/software/timer candidates for HS or VS and renumbers causes only for VS delivery. */
  fun virtual_candidate(delegated :: Boolean) :~ RiscvInterruptDecision(XLen.X64):
    def candidates = active & (if delegated | hideleg | !hideleg)
    def external = candidates[interrupt_code(InterruptCause.VirtualSupervisorExternal)].into(Bool)
    def software = candidates[interrupt_code(InterruptCause.VirtualSupervisorSoftware)].into(Bool)
    def cause = priority_mux(~default: interrupt_cause_bits(if delegated | InterruptCause.SupervisorTimer | InterruptCause.VirtualSupervisorTimer, 64)):
      external: interrupt_cause_bits(if delegated | InterruptCause.SupervisorExternal | InterruptCause.VirtualSupervisorExternal, 64)
      software: interrupt_cause_bits(if delegated | InterruptCause.SupervisorSoftware | InterruptCause.VirtualSupervisorSoftware, 64)
    RiscvInterruptDecision(XLen.X64):
      valid: candidates.or_reduce() & (if delegated | vs_enabled | hs_enabled)
      cause: cause
      target: if delegated | RiscvTrapTarget.VirtualSupervisor | RiscvTrapTarget.Supervisor
  def hs_virtual = virtual_candidate(#false)
  def vs_virtual = virtual_candidate(#true)
  priority_mux(~default: vs_virtual):
    machine.valid: machine
    supervisor.valid: supervisor
    hs_virtual.valid: hs_virtual
    overflow.valid: overflow

export:
  resolve_riscv_hypervisor_interrupt
  RiscvInterrupts
  RiscvInterruptDecision
  riscv_interrupt_pending
  interrupt_cause_bits
  resolve_riscv_interrupt
