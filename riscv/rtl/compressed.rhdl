#lang rhodium
// Materializes descriptor-driven compressed-instruction profiles as combinational hardware.

import:
  "../isa/c.rhm" open
  "../isa/fp-profile.rhm" open
  "../isa/xlen.rhm" open
  "../model/expansion.rhm" open
  "../model/encoding.rhm".InstructionEncoding
  "../model/formats.rhm" open
  "instruction-fields.rhdl" open
  "instruction-pattern.rhdl" open
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/decode.rhdl") open

bundle RiscvCompressedExpansion():
  valid: Bool
  instruction: Bits(32)

fun compressed_selector_cases(instructions :: NonemptyList.of(CompressedInstructionSpec)):
  def operation_width = index_width(instructions.length())
  def mutable cases = []
  for (instruction in instructions,
       index in 0..instructions.length()):
    for (encoding in instruction.encodings):
      for (term in compressed_instruction_patterns(instruction, encoding).terms):
        cases := cases ++ [DecodeCase(term, as_pattern(bits(index, operation_width)))]
  cases

fun constraint_zero_pattern(constraint :: ExpansionConstraint):
  def mutable care = 0
  cond
  | constraint is_a NonzeroFieldConstraint:
      care := constraint.field.mask()
  | constraint is_a NonzeroImmediateConstraint:
      for (field in constraint.immediate.source_fields()):
        care := care bits.or field.mask()
  | ~else:
      error(~who: #'constraint_zero_pattern,
            "unknown instruction-expansion legality constraint")
  Pattern(~value: bits(0, 16), ~care: bits(care, 16))

fun compressed_instruction_patterns(instruction :: CompressedInstructionSpec,
                                    encoding :: InstructionEncoding):
  def mutable accepted = as_pattern_set(encoding_pattern(encoding))
  for (constraint in instruction.constraints):
    accepted := accepted.subtract(constraint_zero_pattern(constraint))
  accepted

fun expansion_source_bits(source :: ExpansionValueSource,
                          width :: PosInt,
                          compressed :: Bits(16)) :~ Bits(width):
  cond
  | source is_a ConstantExpansionValue:
      bits(source.value, width)
  | source is_a FieldExpansionValue:
      def field_value = instruction_field(source.field, compressed.zext(32))
      def extended = if source.field.width == width | field_value | field_value.zext(width)
      extended + bits(source.addend, width)
  | ~else:
      error(~who: #'expansion_source_bits,
            "unknown instruction-expansion value source")

fun scatter_immediate_bits(layout :: ImmediateLayout,
                           value :: Bits(layout.width)) :~ Bits(32):
  def mutable result = bits(0, 32)
  for (piece in layout.pieces):
    def fragment = value[piece.output_low..(piece.output_high + 1)]
    def extended = if fragment.type.width == 32 | fragment | fragment.zext(32)
    result := result ||| (extended << piece.source.low)
  result

fun materialize_expansion(expansion :: InstructionExpansion,
                          compressed :: Bits(16)) :~ Bits(32):
  def mutable instruction = bits(expansion.target.encoding.value, 32)
  for (binding in expansion.bindings):
    def source = expansion_source_bits(binding.source, binding.target.width, compressed)
    instruction := instruction ||| (source.zext(32) << binding.target.low)
  if expansion.immediate is_a ImmediateLayout
  | block:
      def target_immediate :: ImmediateLayout = expansion.target.immediate
      def immediate = instruction_immediate(expansion.immediate,
                                            compressed.zext(32),
                                            target_immediate.width)
      instruction ||| scatter_immediate_bits(target_immediate, immediate)
  | if expansion.immediate is_a Nat
    | instruction ||| scatter_immediate_bits(expansion.target.immediate,
                                             bits(expansion.immediate,
                                                  expansion.target.immediate.width))
    | instruction

circuit RiscvCompressedExpander(xlen :: XLen,
                                floating_point :: FloatingPointProfile = DefaultFloatingPointProfile,
                                compressed_extensions :: List.of(CompressedExtension) = CCompressedExtensions,
                                ~supported_instructions: supported_instruction_names :: List.of(String)):
  input compressed: Bits(16)
  output expansion: RiscvCompressedExpansion()

  def instructions = compressed_extensions_instructions(xlen, floating_point, compressed_extensions, supported_instruction_names)
  def operation_width = index_width(instructions.length())
  def decode = ValidDecodeGen(compressed_selector_cases(instructions))
  def decoded :: DecodeResult(Bits(operation_width)) = decode(compressed)
  def expansion_cases = for List (instruction in instructions,
                                  index in 0..instructions.length()):
    [index, materialize_expansion(instruction.expansion, compressed)]
  expansion <== RiscvCompressedExpansion():
    valid: decoded.valid
    instruction: mux_lookup(decoded.value, ~default: bits(0, 32), expansion_cases)

export:
  RiscvCompressedExpansion
  compressed_instruction_patterns
  compressed_selector_cases
  RiscvCompressedExpander
