#lang rhodium
/* Defines typed CSR values and a descriptor-derived CSR bank authoring layer. */
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/meta open
  "../model/fields.rhm".BitField
  "../isa/csr.rhm" open

/* Names inactive, overwrite, bit-set, and bit-clear CSR instruction operations. */
hardware_enum RiscvCsrOperation:
  None
  Write
  Set
  Clear

/* Detects architectural CSR writes, suppressing set/clear writes with a zero source specifier. */
fun riscv_csr_write_requested(operation :: RiscvCsrOperation,
                              source_specifier :: Bits(5)) :~ Bool:
  (operation === RiscvCsrOperation.Write) ||| (
    operation.is_one_of(RiscvCsrOperation.Set, RiscvCsrOperation.Clear) & source_specifier.or_reduce()
  )

/* Pairs recognized/read hardware with a selector-bound writer callback; architectural access and WARL policy remain caller-owned. */
class CsrBank(recognized :: Hardware.packable,
              read_value :: Hardware.packable,
              writer :: Function.of_arity(1)):
  /* Invokes the bank's writer with the replacement value under the caller's write guard. */
  method write(value :: Hardware.packable):
    writer(value)

/* Materializes one architectural CSR address as a 12-bit literal. */
fun csr_bits(id :: CsrId) :~ Bits(12):
  bits(csr_address(id), 12)

/* Requires the descriptor field to fit the hardware value and returns its packed width. */
fun checked_csr_field_width(value :: Bits,
                            field :: BitField,
                            who :: Symbol):
  def width = value.type.packed_width()
  unless field.high < width
  | error(~who: who, "CSR field must fit the packed value")
  width

/* Extracts a descriptor-selected CSR slice after checking width containment. */
fun csr_field(value :: Bits,
              field :: BitField) :~ Bits(field.width):
  checked_csr_field_width(value, field, #'csr_field)
  value[field.low..(field.high + 1)]

/* Extracts a one-bit CSR field as Bool, rejecting wider flag descriptors. */
fun csr_flag(value :: Bits,
             field :: BitField) :~ Bool:
  unless field.width == 1
  | error(~who: #'csr_flag, "CSR flag must be a one-bit field")
  csr_field(value, field).into(Bool)

/* Places a field-width value into a zero-filled CSR image of the selected width. */
fun csr_field_value(field :: BitField,
                    value :: Bits(field.width),
                    width :: PosInt) :~ Bits(width):
  unless field.high < width
  | error(~who: #'csr_field_value, "CSR field must fit the result width")
  value.zext(width) << field.low

/* Replaces one CSR slice while preserving every bit outside its mask. */
fun csr_field_replace(original :: Bits,
                      field :: BitField,
                      replacement :: Bits(field.width)) :~ Bits(original.type.packed_width()):
  def width = checked_csr_field_width(original, field, #'csr_field_replace)
  def mask = bits(field.mask(), width)
  (original & !mask) ||| csr_field_value(field, replacement, width)

/* Replaces a one-bit CSR field using a Bool value. */
fun csr_flag_replace(original :: Bits,
                     field :: BitField,
                     enabled :: Bool) :~ Bits(original.type.packed_width()):
  unless field.width == 1
  | error(~who: #'csr_flag_replace, "CSR flag must be a one-bit field")
  csr_field_replace(original, field, mux(enabled, bits(1, 1), bits(0, 1)))

/* Preserves only the selected architectural CSR fields, clearing all other bits. */
fun csr_keep_fields(value :: Bits,
                    fields :: List.of(BitField)) :~ Bits(value.type.packed_width()):
  def width = value.type.packed_width()
  for (field in fields):
    unless field.high < width
    | error(~who: #'csr_keep_fields, "CSR field must fit the packed value")
  value & bits(csr_fields_mask(fields), width)

/* Constructs an XLEN-positioned summary-dirty bit from the supplied dirty condition. */
fun mstatus_sd_value(width :: PosInt,
                     dirty :: Bool) :~ Bits(width):
  mux(dirty, bits(1 bits.(<<) (width - 1), width), bits(0, width))

/* Validates unique CSR identifiers and builds the recognized/read mux while retaining the supplied writer. */
fun build_csr_bank(selector :: Bits(12),
                   default_value :: Hardware.packable,
                   entries :: NonemptyList,
                   writer :: Function.of_arity(1)):
  def ids:
    for List (entry in entries):
      unless entry is_a List && entry.length() == 2 && entry[0] is_a CsrId
      | error(~who: #'csr_bank, "CSR entries must use CsrId identifiers")
      entry[0]
  for (left in 0..ids.length()):
    for (right in (left + 1)..ids.length()):
      if ids[left] == ids[right]
      | error(~who: #'csr_bank, "CSR identifiers must be unique")
      | #void
  CsrBank(
    selector.is_one_of(ids.map(csr_bits)),
    mux_lookup(
      selector,
      ~default: default_value,
      entries.map(fun (entry): [csr_address(entry[0]), entry[1]])
    ),
    writer
  )

/* Builds one CSR read mux and selector-directed write callback from storage,
 * read-only, grouped-alias, and explicit read/write clauses; the caller owns write authorization.
 */
expr.macro 'csr_bank($selector, ~default: $default_value): $clause; ...':
  def mutable read_entries = []
  def mutable write_clauses = []
  for (item in [clause, ...]):
    match item
    | 'storage $(id :: expr_meta.Parsed): $(place :: expr_meta.Parsed)':
        read_entries := read_entries ++ ['[[$id, $place]]']
        write_clauses := write_clauses ++ [
          'case csr_address($id):
             $place <== csr_bank_replacement'
        ]
    | 'read $(id :: expr_meta.Parsed): $(read_value :: expr_meta.Parsed)':
        read_entries := read_entries ++ ['[[$id, $read_value]]']
    | 'read_all $(ids :: expr_meta.Parsed): $(read_value :: expr_meta.Parsed)':
        read_entries := read_entries ++ ['($ids).map(fun (id :: CsrId): [id, $read_value])']
    | 'csr $(id :: expr_meta.Parsed):
         read: $(read_value :: expr_meta.Parsed)
         write $(replacement :: Identifier): $body; ...':
        read_entries := read_entries ++ ['[[$id, $read_value]]']
        write_clauses := write_clauses ++ [
          'case csr_address($id):
             def $replacement :: Hardware.packable = csr_bank_replacement
             $body
             ...'
        ]
    | ~else:
        syntax_meta.error(
          "expected storage, read, read_all, or read/write CSR entry",
          item
        )
  if read_entries.length() == 0
  | syntax_meta.error("csr_bank requires at least one CSR entry", '$selector')
  | #void
  def mutable combined_entries = '[]'
  for (entries in read_entries):
    combined_entries := '$combined_entries ++ $entries'
  def mutable writer_body = '#void'
  if write_clauses.length() > 0
  | block:
      let [write_clause, ...] = write_clauses
      writer_body := 'switch $selector:
                        $write_clause
                        ...'
  | #void
  'build_csr_bank(
     $selector,
     $default_value,
     $combined_entries,
     fun (csr_bank_replacement :: Hardware.packable): $writer_body
   )'

export:
  RiscvCsrOperation
  riscv_csr_write_requested
  CsrBank
  csr_bits
  csr_field
  csr_flag
  csr_field_value
  csr_field_replace
  csr_flag_replace
  csr_keep_fields
  mstatus_sd_value
  csr_bank
