#lang rhodium
// Defines typed CSR values and a descriptor-derived CSR bank authoring layer.

import:
  rhombus/meta open
  "../isa/csr.rhm" open

class CsrBank(recognized :: Hardware.packable,
              read_value :: Hardware.packable,
              writer :: Function.of_arity(1)):
  method write(value :: Hardware.packable):
    writer(value)

fun csr_bits(id :: CsrId) :~ Bits(12):
  bits(csr_address(id), 12)

fun build_csr_bank(selector :: Bits(12),
                   default_value :: Hardware.packable,
                   entries :: NonemptyList,
                   writer :: Function.of_arity(1)):
  def ids:
    for List (entry in entries):
      unless entry is_a List && entry.length() == 2 && entry[0] is_a CsrId
      | error(~who: #'csr_bank, "CSR entries must use CsrId identifiers")
      entry[0]
  for (left in 0..ids.length()):
    for (right in (left + 1)..ids.length()):
      if ids[left] == ids[right]
      | error(~who: #'csr_bank, "CSR identifiers must be unique")
      | #void
  CsrBank(
    selector.is_one_of(ids.map(csr_bits)),
    mux_lookup(
      selector,
      ~default: default_value,
      entries.map(fun (entry): [csr_address(entry[0]), entry[1]])
    ),
    writer
  )

expr.macro 'csr_bank($selector, ~default: $default_value): $clause; ...':
  def mutable read_entries = []
  def mutable write_clauses = []
  for (item in [clause, ...]):
    match item
    | 'storage $(id :: expr_meta.Parsed): $(place :: expr_meta.Parsed)':
        read_entries := read_entries ++ ['[[$id, $place]]']
        write_clauses := write_clauses ++ [
          'case csr_address($id):
             $place <== csr_bank_replacement'
        ]
    | 'read $(id :: expr_meta.Parsed): $(read_value :: expr_meta.Parsed)':
        read_entries := read_entries ++ ['[[$id, $read_value]]']
    | 'read_all $(ids :: expr_meta.Parsed): $(read_value :: expr_meta.Parsed)':
        read_entries := read_entries ++ ['($ids).map(fun (id :: CsrId): [id, $read_value])']
    | 'csr $(id :: expr_meta.Parsed):
         read: $(read_value :: expr_meta.Parsed)
         write $(replacement :: Identifier): $body; ...':
        read_entries := read_entries ++ ['[[$id, $read_value]]']
        write_clauses := write_clauses ++ [
          'case csr_address($id):
             def $replacement :: Hardware.packable = csr_bank_replacement
             $body
             ...'
        ]
    | ~else:
        syntax_meta.error(
          "expected storage, read, read_all, or read/write CSR entry",
          item
        )
  if read_entries.length() == 0
  | syntax_meta.error("csr_bank requires at least one CSR entry", '$selector')
  | #void
  def mutable combined_entries = '[]'
  for (entries in read_entries):
    combined_entries := '$combined_entries ++ $entries'
  def mutable writer_body = '#void'
  if write_clauses.length() > 0
  | block:
      let [write_clause, ...] = write_clauses
      writer_body := 'switch $selector:
                        $write_clause
                        ...'
  | #void
  'build_csr_bank(
     $selector,
     $default_value,
     $combined_entries,
     fun (csr_bank_replacement :: Hardware.packable): $writer_body
   )'

export:
  CsrBank
  csr_bits
  csr_bank
