#lang rhodium
/* Materializes profile-selected ELEN=32/64 vtype legality and vset AVL selection without owning architectural state. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/vector.rhm" open
  "../isa/xlen.rhm" open
  lib("rhodium/std/bits.rhdl") open

/* Carries normalized vtype, vill, decoded SEW/LMUL, and the profile-dependent maximum element count. */
bundle RiscvVectorType(xlen :: XLen, vlen :: VectorLength):
  value: Bits(xlen.width)
  vill: Bool
  sew: Bits(2)
  lmul: Bits(3)
  vlmax: Bits(index_width(vlen + 1))

/* Carries proposed vtype and AVL with explicit maximum-VL and preserve-VL request modes. */
bundle RiscvVectorConfigRequest(xlen :: XLen):
  vtype: Bits(xlen.width)
  avl: Bits(xlen.width)
  maximum: Bool
  keep_vl: Bool

/* Carries the next vtype/VL and the illegal preserve-VL transition flag. */
bundle RiscvVectorConfiguration(xlen :: XLen, vlen :: VectorLength):
  vtype: Bits(xlen.width)
  vl: Bits(index_width(vlen + 1))
  illegal: Bool

/* Describes architectural vector CSRs without allocating their core-owned storage. */
bundle RiscvVectorState(xlen :: XLen):
  vl: Bits(xlen.width)
  vtype: Bits(xlen.width)
  vstart: Bits(xlen.width)
  vxrm: Bits(2)
  vxsat: Bool

/* Decodes legal profile-selected SEW/LMUL combinations, normalizing illegal vtype to vill and zero VLMAX. */
fun vector_type(xlen :: XLen, vlen :: VectorLength, value :: Bits(xlen.width), ~elen: elen :: VectorSEW = VectorSEW.E64) :~ RiscvVectorType(xlen, vlen):
  def count_width = index_width(vlen + 1)
  def cases = for List (encoding in 0..64):
    def config = vector_vtype_config(vlen, encoding, ~elen: elen)
    [encoding, Bits(count_width)(if config | config.vlmax | 0)]

  def maximum = mux_lookup(value[0..6], ~default: Bits(count_width)(0), cases)
  def illegal = value[8..xlen.width].any() ||| !maximum.any()
  RiscvVectorType(xlen, vlen):
    value: mux(illegal, Bits(xlen.width)(1 << (xlen.width - 1)), value)
    vill: illegal
    sew: value[3..5]
    lmul: value[0..3]
    vlmax: mux(illegal, Bits(count_width)(0), maximum)

/* Selects deterministic min(AVL,VLMAX) or requested maximum/preserved VL and diagnoses incompatible preserve-VL transitions. */
fun vector_configure(xlen :: XLen, vlen :: VectorLength, request :: RiscvVectorConfigRequest(xlen), old_type :: Bits(xlen.width), old_vl :: Bits(index_width(vlen + 1)), ~elen: elen :: VectorSEW = VectorSEW.E64) :~ RiscvVectorConfiguration(xlen, vlen):
  def previous = vector_type(xlen, vlen, old_type, ~elen: elen)
  def next_type = vector_type(xlen, vlen, request.vtype, ~elen: elen)
  def maximum = next_type.vlmax.zext(xlen.width)
  def avl = mux(request.keep_vl, old_vl.zext(xlen.width), request.avl)
  def selected = mux(request.maximum ||| (avl > maximum), maximum, avl)
  RiscvVectorConfiguration(xlen, vlen):
    vtype: next_type.value
    vl: mux(next_type.vill, Bits(index_width(vlen + 1))(0), selected[0..index_width(vlen + 1)])
    illegal: request.keep_vl & (previous.vill ||| next_type.vill ||| (previous.vlmax =/= next_type.vlmax))

export:
  RiscvVectorType
  RiscvVectorConfigRequest
  RiscvVectorConfiguration
  RiscvVectorState
  vector_type
  vector_configure
