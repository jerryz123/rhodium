#lang rhodium
// Defines Sv39/Svnapot mapping geometry and demand, management, and prefetch permissions.
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/sv39.rhm" open
  "svpbmt.rhdl".PageMemoryType
  lib("rhodium/std/bits.rhdl") open

hardware_enum Sv39Access:
  Fetch
  Load
  Store
  CacheManagement

hardware_enum Sv39PageSize:
  Page4KiB
  Page64KiB
  Page2MiB
  Page1GiB

bundle Sv39Pte():
  napot: Bool
  pbmt: PageMemoryType
  reserved: Bits(7)
  ppn: Bits(44)
  rsw: Bits(2)
  dirty: Bool
  accessed: Bool
  global_mapping: Bool
  user: Bool
  execute: Bool
  write: Bool
  read: Bool
  valid: Bool

bundle Sv39Translation():
  physical_address: Bits(56)
  read: Bool
  write: Bool
  execute: Bool
  user: Bool
  global_mapping: Bool

fun sv39_canonical(address :: Bits(64)) :~ Bool:
  address[39..64] === mux(address[38].into(Bool), !bits(0, 25), bits(0, 25))

fun sv39_vpn(address :: Bits(64), level :: Bits(2)) :~ Bits(9):
  mux_lookup(level, ~default: address[30..39]):
    0: address[12..21]
    1: address[21..30]

fun sv39_leaf(pte :: Sv39Pte()) :~ Bool:
  pte.read ||| pte.execute

fun sv39_pte_structurally_valid(pte :: Sv39Pte(), ~level: level :: Bits(2) = bits(0, 2), ~svnapot: svnapot :: Boolean = #false, ~pbmte: pbmte :: Bool = Bool(#false)) :~ Bool:
  def pbmt_valid = (pte.pbmt === PageMemoryType.PMA) ||| (pbmte & sv39_leaf(pte) & (pte.pbmt =/= PageMemoryType.Reserved))
  def napot_valid = !pte.napot ||| (Bool(svnapot) & sv39_leaf(pte) & (level === bits(0, 2)) & (pte.ppn[0..4] === bits(8, 4)))
  pte.valid & !(pte.write & !pte.read) & napot_valid & !pte.reserved.or_reduce() & pbmt_valid

fun sv39_superpage_aligned(pte :: Sv39Pte(), level :: Bits(2)) :~ Bool:
  mux_lookup(level, ~default: !pte.ppn[0..18].or_reduce()):
    0: Bool(#true)
    1: !pte.ppn[0..9].or_reduce()

// Only structurally valid, aligned leaves reach mapping construction.
fun sv39_page_size(pte :: Sv39Pte(), level :: Bits(2)) :~ Sv39PageSize:
  mux_lookup(level, ~default: Sv39PageSize.Page1GiB):
    0: mux(pte.napot, Sv39PageSize.Page64KiB, Sv39PageSize.Page4KiB)
    1: Sv39PageSize.Page2MiB

fun sv39_base_ppn(ppn :: Bits(44), page_size :: Sv39PageSize) :~ Bits(44):
  mux_lookup(page_size, ~default: ppn):
    Sv39PageSize.Page64KiB: ppn[4..44] ++ bits(0, 4)
    Sv39PageSize.Page2MiB: ppn[9..44] ++ bits(0, 9)
    Sv39PageSize.Page1GiB: ppn[18..44] ++ bits(0, 18)

fun sv39_same_page(left :: Bits, right :: Bits(left.type.packed_width()), page_size :: Sv39PageSize) :~ Bool:
  def width = left.type.packed_width()
  mux_lookup(page_size, ~default: left[12..width] === right[12..width]):
    Sv39PageSize.Page64KiB: left[16..width] === right[16..width]
    Sv39PageSize.Page2MiB: left[21..width] === right[21..width]
    Sv39PageSize.Page1GiB: left[30..width] === right[30..width]

fun sv39_physical_address(virtual_address :: Bits(64), base_ppn :: Bits(44), page_size :: Sv39PageSize) :~ Bits(56):
  mux_lookup(page_size, ~default: base_ppn ++ virtual_address[0..12]):
    Sv39PageSize.Page64KiB: base_ppn[4..44] ++ virtual_address[0..16]
    Sv39PageSize.Page2MiB: base_ppn[9..44] ++ virtual_address[0..21]
    Sv39PageSize.Page1GiB: base_ppn[18..44] ++ virtual_address[0..30]

fun sv39_permission_valid(pte :: Sv39Pte(), access :: Sv39Access,
                          user_mode :: Bool, supervisor_mode :: Bool,
                          sum :: Bool, mxr :: Bool) :~ Bool:
  def privilege_valid = mux(
    user_mode,
    pte.user,
    !pte.user ||| (supervisor_mode & sum & (access =/= Sv39Access.Fetch))
  )
  // Management checks load-or-store access and A, but never checks or sets D.
  // PTE structural validity remains the caller's separate leaf check.
  def access_valid = mux_lookup(access, ~default: pte.write & pte.dirty):
    Sv39Access.Fetch: pte.execute
    Sv39Access.Load: pte.read ||| (mxr & pte.execute)
    Sv39Access.CacheManagement: pte.read ||| pte.write ||| (mxr & pte.execute)
  privilege_valid & access_valid & pte.accessed

// Prefetch permission is the union of fetch, load, and store permission, but
// the architectural hint neither checks nor updates the PTE A/D bits.
fun sv39_prefetch_permission_valid(pte :: Sv39Pte(),
                                   user_mode :: Bool, supervisor_mode :: Bool,
                                   sum :: Bool, mxr :: Bool) :~ Bool:
  def user_page = pte.user
  def fetch_privilege_valid = mux(user_mode, user_page, !user_page)
  def data_privilege_valid = mux(user_mode, user_page, !user_page ||| (supervisor_mode & sum))
  def fetch_valid = fetch_privilege_valid & pte.execute
  def load_valid = data_privilege_valid & (pte.read ||| (mxr & pte.execute))
  def store_valid = data_privilege_valid & pte.write
  fetch_valid ||| load_valid ||| store_valid

export:
  PageMemoryType
  Sv39Access
  Sv39PageSize
  Sv39Pte
  Sv39Translation
  sv39_canonical
  sv39_vpn
  sv39_leaf
  sv39_pte_structurally_valid
  sv39_superpage_aligned
  sv39_page_size
  sv39_base_ppn
  sv39_same_page
  sv39_physical_address
  sv39_permission_valid
  sv39_prefetch_permission_valid
