#lang rhodium
/* Materializes synchronous exception causes, selection, and delegation. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/trap.rhm" open
  "../isa/xlen.rhm" open
  "privilege.rhdl" open

/* Carries a synchronous exception before interrupt arbitration and CSR encoding. */
bundle RiscvExceptionDecision(xlen :: XLen):
  valid: Bool
  cause: ExceptionCause
  value: Bits(xlen.width)
  target: RiscvTrapTarget

/* Carries the architectural cause image after exception/interrupt arbitration. */
bundle RiscvTrapDecision(xlen :: XLen):
  valid: Bool
  cause: Bits(xlen.width)
  value: Bits(xlen.width)
  target: RiscvTrapTarget

/* Encodes a data access fault, prioritizing guest-page over page faults.
   The caller qualifies these flags and retains fault validity, address, and retirement order. */
fun data_fault_cause(store :: Bool,
                     ~page_fault: page_fault :: Bool,
                     ~guest_page_fault: guest_page_fault :: Bool) :~ ExceptionCause:
  def access = mux(store, ExceptionCause.StoreAccessFault, ExceptionCause.LoadAccessFault)
  def page = mux(store, ExceptionCause.StorePageFault, ExceptionCause.LoadPageFault)
  def guest = mux(store, ExceptionCause.StoreGuestPageFault, ExceptionCause.LoadGuestPageFault)
  priority_mux(~default: access):
    guest_page_fault: guest
    page_fault: page

/* Prioritizes explicit exceptions over generated exceptions and applies supported medeleg routing below Machine mode. */
fun resolve_riscv_trap(xlen :: XLen,
                       explicit_valid :: Bool,
                       explicit_cause :: ExceptionCause,
                       explicit_value :: Bits(xlen.width),
                       generated_valid :: Bool,
                       generated_cause :: ExceptionCause,
                       generated_value :: Bits(xlen.width),
                       privilege :: PrivilegeMode,
                       medeleg :: Bits(xlen.width)) :~ RiscvExceptionDecision(xlen):
  def valid = explicit_valid ||| generated_valid
  def cause = mux(explicit_valid, explicit_cause, generated_cause)
  def delegated = mux_lookup(
    cause,
    ~default: Bool(#false),
    DelegatableExceptionCauses.map(
      fun (candidate):
        def code = exception_code(candidate)
        [candidate, medeleg[code].into(Bool)]
    )
  )

  RiscvExceptionDecision(xlen):
    valid: valid
    cause: cause
    value: mux(explicit_valid, explicit_value, generated_value)
    target: mux(valid & (privilege =/= PrivilegeMode.Machine) & delegated, RiscvTrapTarget.Supervisor, RiscvTrapTarget.Machine)

export:
  ExceptionCause
  RiscvExceptionDecision
  RiscvTrapDecision
  data_fault_cause
  resolve_riscv_trap
