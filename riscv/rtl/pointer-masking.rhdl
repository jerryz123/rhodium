#lang rhodium
/* Resolves host/guest Ssnpm controls and explicit-address masking without changing low address bits. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/csr.rhm" open
  "../isa/xlen.rhm" open
  "csr.rhdl" open
  "privilege.rhdl" open
  "hypervisor.rhdl".RiscvGuestMemoryAccess
  "hypervisor.rhdl".guest_data_context

/* Uses architectural disabled, seven-bit, and sixteen-bit pointer-mask encodings. */
hardware_enum PointerMaskMode(~width: 2):
  Disabled = 0
  Bits7 = 2
  Bits16 = 3

/* Pairs the effective mask mode with whether reconstruction uses virtual sign extension. */
bundle PointerMaskControl():
  mode: PointerMaskMode
  virtual_address: Bool

/* Normalizes reserved two-bit mask encodings to Disabled. */
fun pointer_mask_mode_bits(value :: Bits(2)) :~ PointerMaskMode:
  def mode = value.into(PointerMaskMode)
  mux(enum_valid(mode), mode, PointerMaskMode.Disabled)

/* Extracts the RV64 xenvcfg mask mode; RV32 always disables pointer masking. */
fun pointer_mask_mode(xlen :: XLen, envcfg :: Bits(xlen.width)) :~ PointerMaskMode:
  if xlen == XLen.X32
  | PointerMaskMode.Disabled
  | pointer_mask_mode_bits(csr_field(envcfg, EnvcfgPMM))

/* Returns only the normalized HUPMM field, clearing it when the feature is disabled. */
fun pointer_mask_hstatus_fields(value :: Bits(64), ~enabled: enabled :: Boolean) :~ Bits(64):
  if enabled
  | csr_field_value(HstatusHUPMM, pointer_mask_mode_bits(csr_field(value, HstatusHUPMM)).as_bits(), 64)
  | Bits(64)(0)

/* Returns only the normalized PMM field for enabled RV64 specialization. */
fun pointer_mask_envcfg_fields(xlen :: XLen, value :: Bits(xlen.width), ~enabled: enabled :: Boolean) :~ Bits(xlen.width):
  if xlen == XLen.X32 || !enabled
  | Bits(xlen.width)(0)
  | csr_field_value(EnvcfgPMM, pointer_mask_mode(xlen, value).into(Bits(2)), xlen.width)

/* Resolves effective user-access masking and virtual/physical reconstruction, bypassing disabled profiles and MXR. */
fun user_pointer_mask_control(xlen :: XLen, privilege :: PrivilegeMode, mstatus :: Bits(xlen.width), satp :: Bits(xlen.width), senvcfg :: Bits(xlen.width), ~enabled: enabled :: Boolean) :~ PointerMaskControl():
  if xlen == XLen.X32 || !enabled
  | PointerMaskControl():
      mode: PointerMaskMode.Disabled
      virtual_address: Bool(#false)
  | block:
      def effective = effective_data_privilege(xlen, privilege, mstatus)
      PointerMaskControl():
        mode: mux((effective === PrivilegeMode.User) & !csr_flag(mstatus, MstatusMXR), pointer_mask_mode(xlen, senvcfg), PointerMaskMode.Disabled)
        virtual_address: (effective =/= PrivilegeMode.Machine) & csr_field(satp, Satp64Mode).any()

/* Shared senvcfg controls U/VU. HUPMM is only the U-mode HLV/HSV override;
 * VS accesses use henvcfg. HLVX and either effective MXR bypass masking. */
fun hypervisor_pointer_mask_control(context :: RiscvExecutionContext(), mstatus :: Bits(64), satp :: Bits(64), senvcfg :: Bits(64), hstatus :: Bits(64), vsstatus :: Bits(64), vsatp :: Bits(64), henvcfg :: Bits(64), access :: RiscvGuestMemoryAccess, ~enabled: enabled :: Boolean) :~ PointerMaskControl():
  def explicit_guest = access =/= RiscvGuestMemoryAccess.Normal
  def normal = effective_data_context(XLen.X64, context.privilege, mstatus, ~virtualized: context.virtualized)
  def data = guest_data_context(normal, access, hstatus)
  def user_mode = mux(explicit_guest & (context.privilege === PrivilegeMode.User), pointer_mask_mode_bits(csr_field(hstatus, HstatusHUPMM)), pointer_mask_mode(XLen.X64, senvcfg))
  def mode = mux(data.privilege === PrivilegeMode.User, user_mode, mux(data.virtualized & (data.privilege === PrivilegeMode.Supervisor), pointer_mask_mode(XLen.X64, henvcfg), PointerMaskMode.Disabled))
  def mxr = csr_flag(mstatus, MstatusMXR) ||| (data.virtualized & csr_flag(vsstatus, MstatusMXR))
  PointerMaskControl():
    mode: mux(Bool(enabled) & !mxr & (access =/= RiscvGuestMemoryAccess.GuestExecuteRead), mode, PointerMaskMode.Disabled)
    virtual_address: (data.privilege =/= PrivilegeMode.Machine) & csr_field(mux(data.virtualized, vsatp, satp), Satp64Mode).any()

/* Selects the precomputed host or explicit-guest control for a data access.
   HLVX keeps the guest address interpretation and disables masking. */
fun select_pointer_mask(normal :: PointerMaskControl(), guest :: PointerMaskControl(), access :: RiscvGuestMemoryAccess) :~ PointerMaskControl():
  def selected :: PointerMaskControl() = mux(access === RiscvGuestMemoryAccess.Normal, normal, guest)
  selected.updated(~mode: mux(access === RiscvGuestMemoryAccess.GuestExecuteRead, PointerMaskMode.Disabled, selected.mode))

/* Reconstructs the masked upper RV64 address bits by sign- or zero-extension while preserving low bits; RV32 is unchanged. */
fun apply_pointer_mask(xlen :: XLen, address :: Bits(xlen.width), control :: PointerMaskControl()) :~ Bits(xlen.width):
  if xlen == XLen.X32
  | address
  | block:
      def sign7 = control.virtual_address & address[56].into(Bool)
      def sign16 = control.virtual_address & address[47].into(Bool)
      def upper = mux_lookup(control.mode, ~default: address[48..64], [
        [PointerMaskMode.Bits7, mux(sign7, Bits(7)(0x7f), Bits(7)(0)) ++ address[48..57]],
        [PointerMaskMode.Bits16, mux(sign16, Bits(16)(0xffff), Bits(16)(0))]
      ])

      upper ++ address[0..48]

export:
  PointerMaskMode
  PointerMaskControl
  pointer_mask_mode
  pointer_mask_envcfg_fields
  user_pointer_mask_control
  hypervisor_pointer_mask_control
  pointer_mask_hstatus_fields
  select_pointer_mask
  apply_pointer_mask
