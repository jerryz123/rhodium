#lang rhodium
/* Defines transport-independent RISC-V physical-memory regions and hardware access lookup. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/interconnect.rhdl") open

/* Stores reusable host permissions and memory semantics, including independent instruction-only caching. */
class RiscvPhysicalMemoryAttributes(readable :: Boolean,
                                    writable :: Boolean,
                                    executable :: Boolean,
                                    cacheable :: Boolean,
                                    atomic :: Boolean,
                                    device :: Boolean,
                                    read_idempotent :: Boolean,
                                    cache_block_zero :: Boolean,
                                    instruction_cacheable :: Boolean):
  implements StableCircuitParam

  /* Rejects cacheable device memory and requires read-only executable idempotent nondevice semantics for instruction-only caching. */
  constructor (readable :: Boolean,
               writable :: Boolean,
               executable :: Boolean,
               cacheable :: Boolean,
               atomic :: Boolean,
               device :: Boolean,
               read_idempotent :: Boolean,
               ~cache_block_zero: cache_block_zero :: Boolean = #false,
               ~instruction_cacheable: instruction_cacheable :: Boolean = cacheable):
    if cacheable && device
    | error(~who: #'RiscvPhysicalMemoryAttributes,
            "cacheable physical memory cannot use device-memory semantics")
    | #void

    unless (!instruction_cacheable) || cacheable || (readable && executable && read_idempotent && (!writable) && (!atomic) && (!device))
    | error(~who: #'RiscvPhysicalMemoryAttributes,
            "instruction-only caching requires read-only executable idempotent non-device memory")

    super(readable, writable, executable, cacheable, atomic, device, read_idempotent, cache_block_zero, instruction_cacheable)

/* Pairs a protocol-neutral masked address set with stable physical-memory attributes. */
class RiscvPhysicalMemoryRegion(address_set :: AddressSet,
                                attributes :: RiscvPhysicalMemoryAttributes):
  implements StableCircuitParam

/* Carries mapping validity and resolved permission, idempotence, device, and cacheability flags. */
bundle RiscvPhysicalMemoryLookup():
  mapped: Bool
  readable: Bool
  writable: Bool
  executable: Bool
  cacheable: Bool
  atomic: Bool
  device: Bool
  read_idempotent: Bool
  cache_block_zero: Bool
  instruction_cacheable: Bool

/* Stores a validated nonoverlapping physical-region map and elaborates hardware attribute lookup. */
class RiscvPhysicalMemoryMap(address_width :: PosInt,
                             regions :: NonemptyList.of(RiscvPhysicalMemoryRegion)):
  implements StableCircuitParam

  /* Requires every address set to fit the map width and rejects overlapping regions. */
  constructor (address_width :: PosInt,
               regions :: NonemptyList.of(RiscvPhysicalMemoryRegion)):
    for (region in regions):
      unless region.address_set.fits_unsigned_width(address_width)
      | error(~who: #'RiscvPhysicalMemoryMap,
              "physical-memory region must fit the address width")

    for (left_index in 0..regions.length()):
      for (right_index in (left_index + 1)..regions.length()):
        if regions[left_index].address_set.overlaps(regions[right_index].address_set)
        | error(~who: #'RiscvPhysicalMemoryMap,
                "physical-memory regions must not overlap")
        | #void

    super(address_width, regions)

  /* Checks both supplied address endpoints against one region, rejecting high-bit truncation and clearing all flags when unmapped. */
  method lookup(raw_address :: Bits,
                raw_last_address :: Bits = raw_address) :~ RiscvPhysicalMemoryLookup():
    def raw_width = raw_address.type.packed_width()
    def raw_last_width = raw_last_address.type.packed_width()
    def address:
      cond
      | raw_width < address_width: raw_address.zext(address_width)
      | raw_width == address_width: raw_address
      | ~else: raw_address[0..address_width]

    def last_address:
      cond
      | raw_last_width < address_width: raw_last_address.zext(address_width)
      | raw_last_width == address_width: raw_last_address
      | ~else: raw_last_address[0..address_width]

    def fits:
      if raw_width <= address_width
      | Bool(#true)
      | !raw_address[address_width..raw_width].any()

    def last_fits:
      if raw_last_width <= address_width
      | Bool(#true)
      | !raw_last_address[address_width..raw_last_width].any()

    /* Region classification is parallel: construction rejects overlapping maps.
       Share endpoint matches and reject truncated addresses for every attribute. */

    def region_matches = vec(for List (region in regions): region.address_set.matches(address) & region.address_set.matches(last_address))
    def range_fits = fits & last_fits

    /* Reduces the matching region's selected host attribute, or false when unmapped. */
    fun permitted(attribute :: Function) :~ Bool:
      range_fits & vec(for List (index in 0..regions.length()): region_matches[index] & Bool(attribute(regions[index].attributes))).any()

    RiscvPhysicalMemoryLookup():
      mapped: range_fits & region_matches.any()
      readable: permitted(fun (attributes :: RiscvPhysicalMemoryAttributes): attributes.readable)
      writable: permitted(fun (attributes :: RiscvPhysicalMemoryAttributes): attributes.writable)
      executable: permitted(fun (attributes :: RiscvPhysicalMemoryAttributes): attributes.executable)
      cacheable: permitted(fun (attributes :: RiscvPhysicalMemoryAttributes): attributes.cacheable)
      atomic: permitted(fun (attributes :: RiscvPhysicalMemoryAttributes): attributes.atomic)
      device: permitted(fun (attributes :: RiscvPhysicalMemoryAttributes): attributes.device)
      read_idempotent: permitted(fun (attributes :: RiscvPhysicalMemoryAttributes): attributes.read_idempotent)
      cache_block_zero: permitted(fun (attributes :: RiscvPhysicalMemoryAttributes): attributes.cache_block_zero)
      instruction_cacheable: permitted(fun (attributes :: RiscvPhysicalMemoryAttributes): attributes.instruction_cacheable)

export:
  RiscvPhysicalMemoryAttributes
  RiscvPhysicalMemoryRegion
  RiscvPhysicalMemoryLookup
  RiscvPhysicalMemoryMap
