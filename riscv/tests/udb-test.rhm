#lang rhombus
// Checks deterministic UDB YAML serialization and duplicate-key rejection.
// SPDX-License-Identifier: Apache-2.0

import:
  "../udb.rhm" open
  "../udb-profile.rhm".riscv_udb_extensions
  "../isa/hart.rhm" open
  "../isa/profile.rhm" open
  "../isa/xlen.rhm".XLen

def config = UdbConfiguration(
  "test-core",
  "Test core configuration",
  [UdbExtension("I", "2.1"), UdbExtension("Sm", "1.12.0")],
  [UdbParameter("MXLEN", UdbNaturalValue(64)),
   UdbParameter("MISA_CSR_IMPLEMENTED", UdbBooleanValue(#true)),
   UdbParameter("M_MODE_ENDIANNESS", UdbStringValue("little")),
   UdbParameter("MTVEC_MODES", UdbNaturalListValue([0])),
   UdbParameter("HPM_COUNTER_EN", UdbBooleanListValue([#false, #false]))]
)

check:
  config.to_yaml() ~is String.join(
    ["# Generated UDB architecture configuration; do not edit.",
     "# yaml-language-server: $schema=https://raw.githubusercontent.com/riscv/riscv-unified-db/main/spec/schemas/config_schema.json",
     "---",
     "$schema: config_schema.json#",
     "kind: architecture configuration",
     "type: fully configured",
     "name: \"test-core\"",
     "description: \"Test core configuration\"",
     "implemented_extensions:",
     "  - { name: \"I\", version: \"= 2.1\" }",
     "  - { name: \"Sm\", version: \"= 1.12.0\" }",
     "params:",
     "  MXLEN: 64",
     "  MISA_CSR_IMPLEMENTED: true",
     "  M_MODE_ENDIANNESS: \"little\"",
     "  MTVEC_MODES: [0]",
     "  HPM_COUNTER_EN: [false, false]",
     ""],
    "\n"
  )

check:
  UdbConfiguration(
    "duplicate-extension",
    "Invalid duplicate extension",
    [UdbExtension("I", "2.1"), UdbExtension("I", "2.1")],
    [UdbParameter("MXLEN", UdbNaturalValue(64))]
  ) ~throws "extension names must be unique"
  UdbConfiguration(
    "duplicate-parameter",
    "Invalid duplicate parameter",
    [UdbExtension("I", "2.1")],
    [UdbParameter("MXLEN", UdbNaturalValue(64)),
     UdbParameter("MXLEN", UdbNaturalValue(32))]
  ) ~throws "parameter names must be unique"

def cache = RiscvCacheDescription(64, 16, 1024)
for (xlen in [XLen.X32, XLen.X64]):
  def hart = RiscvHartDescription(
    RiscvIsaProfile(xlen, ["i", "m", "a", "b", "f", "c"], [MisaExtension.I, MisaExtension.M, MisaExtension.A, MisaExtension.B, MisaExtension.F, MisaExtension.C, MisaExtension.S, MisaExtension.U]),
    if xlen == XLen.X32 | RiscvMmuType.Bare | RiscvMmuType.Sv39,
    cache, cache
  )
  def extensions = riscv_udb_extensions(hart)
  def names = extensions.map(fun (extension): extension.name)
  check:
    names.contains("Zmmul") ~is #true
    names.contains("Zaamo") ~is #true
    names.contains("Zalrsc") ~is #true
    names.contains("Zba") ~is #true
    names.contains("Zbb") ~is #true
    names.contains("Zbs") ~is #true
    names.contains("Zca") ~is #true
    names.contains("Zcf") ~is (xlen == XLen.X32)
    names.contains("Sv39") ~is (xlen == XLen.X64)
    // Sv39 does not choose the implementation's A/D policy.
    names.contains("Svade") ~is #false
    riscv_udb_extensions(hart, ~additional: [UdbExtension("Svade", "1.0.0")]) ~is extensions ++ [UdbExtension("Svade", "1.0.0")]
