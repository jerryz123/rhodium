#lang rhombus
// Checks the complete RV32I catalog and its relationship to RV64I.
// SPDX-License-Identifier: Apache-2.0

import:
  "../model/main.rhm" open
  "../isa/integer-common.rhm" as common
  "../isa/rv32i.rhm" open
  "../isa/rv64i.rhm" as rv64

def expected_names = [
  "LUI", "AUIPC", "JAL", "JALR",
  "BEQ", "BNE", "BLT", "BGE", "BLTU", "BGEU",
  "LB", "LH", "LW", "LBU", "LHU",
  "SB", "SH", "SW",
  "ADDI", "SLTI", "SLTIU", "XORI", "ORI", "ANDI",
  "SLLI", "SRLI", "SRAI",
  "ADD", "SUB", "SLL", "SLT", "SLTU", "XOR", "SRL", "SRA", "OR", "AND",
  "FENCE", "ECALL", "EBREAK"
]

check:
  RV32I.revision ~is "RV32I 2.1"
  RV32I.instructions.length() ~is 40
  RV32I.instructions.map(fun (instruction): instruction.name) ~is expected_names
  rv32i_instruction("ADD") === ADD ~is #true
  RV32I.matching(0x003100B3) === ADD ~is #true
  RV32I.matching(0x403100B3) === SUB ~is #true
  RV32I.matching(0xFFF10093) === ADDI ~is #true
  RV32I.matching(0x01F11093) === SLLI ~is #true
  RV32I.matching(0x41F15093) === SRAI ~is #true
  RV32I.matching(0x00208063) === BEQ ~is #true
  RV32I.matching(0x00000073) === ECALL ~is #true
  RV32I.matching(0x00100073) === EBREAK ~is #true

  SLLI.encoding.value ~is 0x00001013
  SLLI.encoding.care ~is 0xFE00707F
  SRAI.encoding.value ~is 0x40005013
  SRAI.encoding.care ~is 0xFE00707F
  SLLI.immediate === Shift32Immediate ~is #true

  RV32I.matching(0x02011093) ~is #false
  rv64.RV64I.matching(0x02011093) === rv64.SLLI ~is #true
  RV32I.matching(0x00813083) ~is #false
  RV32I.matching(0x00313423) ~is #false
  RV32I.matching(0x0000001B) ~is #false

  (for all (instruction in common.RVIntegerCommonInstructions):
     RV32I.find(instruction.name) === instruction && rv64.RV64I.find(instruction.name) === instruction) ~is #true
  SLLI === rv64.SLLI ~is #false
  SRLI === rv64.SRLI ~is #false
  SRAI === rv64.SRAI ~is #false

check:
  rv32i_instruction("MISSING") ~throws "unknown instruction"
