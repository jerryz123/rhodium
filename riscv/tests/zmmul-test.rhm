#lang rhombus
// Checks the RV32 and RV64 Zmmul catalogs and representative encodings.
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/rv64i.rhm" as rv64i
  "../isa/zmmul.rhm" open

check:
  RV32Zmmul.revision ~is "RV32 Zmmul 1.0"
  RV64Zmmul.revision ~is "RV64 Zmmul 1.0"
  RV32Zmmul.instructions.map(fun (instruction): instruction.name) ~is [
    "MUL", "MULH", "MULHSU", "MULHU"
  ]
  RV64Zmmul.instructions.map(fun (instruction): instruction.name) ~is [
    "MUL", "MULH", "MULHSU", "MULHU", "MULW"
  ]
  RV32Zmmul.matching(0x023100B3) === MUL ~is #true
  RV32Zmmul.matching(0x023110B3) === MULH ~is #true
  RV32Zmmul.matching(0x023120B3) === MULHSU ~is #true
  RV32Zmmul.matching(0x023130B3) === MULHU ~is #true
  RV32Zmmul.matching(0x023100BB) ~is #false
  RV64Zmmul.matching(0x023100BB) === MULW ~is #true
  rv32zmmul_instruction("MUL") === MUL ~is #true
  rv64zmmul_instruction("MULW") === MULW ~is #true
  MUL.encoding.value ~is 0x02000033
  MUL.encoding.care ~is 0xFE00707F
  MULW.encoding.value ~is 0x0200003B
  MULW.encoding.care ~is 0xFE00707F
  MUL.operands.map(fun (operand): operand.name) ~is ["rd", "rs1", "rs2"]
  MUL.immediate ~is #false
  rv64i.RV64I.matching(0x023100B3) ~is #false
