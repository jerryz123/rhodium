#lang rhombus
// Checks Sv39 architectural constants, canonical addresses, and fence encoding.
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/sv39.rhm" open
  "../isa/privileged.rhm" open

check:
  Sv39Mode ~is 8
  Sv39Levels ~is 3
  Sv39PageBytes ~is 4096
  sv39_canonical_address(0x0000003fffffffff) ~is #true
  sv39_canonical_address(0xffffffc000000000) ~is #true
  sv39_canonical_address(0x0000004000000000) ~is #false
  SFENCE_VMA.matches(0x12000073) ~is #true
  SFENCE_VMA.matches(0x12008073) ~is #true
  PrivilegedInstructions.contains(SFENCE_VMA) ~is #true
