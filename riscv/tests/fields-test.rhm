#lang rhombus
// Checks named instruction fields and their fixed-value constraints.
// SPDX-License-Identifier: Apache-2.0

import:
  "../model/fields.rhm" open

def field = BitField("example", 11, 7)
def constraint = field.constrain(0b10101)

check:
  width_mask(5) ~is 0b11111
  field.width ~is 5
  field.mask() ~is 0x00000F80
  field.extract(0x00000A80) ~is 0b10101
  constraint.field === field ~is #true
  constraint.value ~is 0b10101
  constraint.mask ~is 0x00000F80
  constraint.value_bits ~is 0x00000A80

check:
  width_mask(0) ~throws "PosInt"
  BitField("", 3, 0) ~throws "NonemptyString"
  BitField("bad", 2, 3) ~throws "high >= low"
  field.constrain(32) ~throws "must fit"
  field.extract(-1) ~throws "Nat"
