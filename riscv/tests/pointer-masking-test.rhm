#lang rhombus
// Checks the architectural PMM field and the hardware enum's public encodings.
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/csr.rhm".EnvcfgPMM
  "../rtl/pointer-masking.rhdl".PointerMaskMode

check:
  EnvcfgPMM.low ~is 32
  EnvcfgPMM.width ~is 2
  EnvcfgPMM.mask() ~is 0x300000000
  PointerMaskMode.Disabled.packed_value() ~is 0
  PointerMaskMode.Bits7.packed_value() ~is 2
  PointerMaskMode.Bits16.packed_value() ~is 3
