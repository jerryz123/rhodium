#lang rhombus
// Checks the ratified RV32/RV64 Zicond catalogs and instruction encodings.
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/zicond.rhm" open

check:
  ZicondInstructions.length() ~is 2
  RV32Zicond.instructions === ZicondInstructions ~is #true
  RV64Zicond.instructions === ZicondInstructions ~is #true
  CZERO_EQZ.encoding.value ~is 0x0E005033
  CZERO_EQZ.encoding.care ~is 0xFE00707F
  CZERO_NEZ.encoding.value ~is 0x0E007033
  CZERO_NEZ.encoding.care ~is 0xFE00707F
  CZERO_EQZ.operands.map(fun (operand): operand.name) ~is ["rd", "rs1", "rs2"]
  CZERO_NEZ.operands.map(fun (operand): operand.name) ~is ["rd", "rs1", "rs2"]
  RV32Zicond.matching(0x0E20D0B3) === CZERO_EQZ ~is #true
  RV64Zicond.matching(0x0E20F0B3) === CZERO_NEZ ~is #true
  RV64Zicond.matching(0x00000013) ~is #false
