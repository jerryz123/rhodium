#lang rhombus
// Checks Zicbop encodings, operands, and signed 32-byte-granular offsets.

import:
  "../isa/integer-common.rhm".ORI
  "../isa/zicbop.rhm" open
  "../model/formats.rhm" open

check:
  Zicbop.revision ~is "Zicbop 1.0.0"
  Zicbop.instructions.map(fun (instruction): instruction.name) ~is [
    "PREFETCH.I", "PREFETCH.R", "PREFETCH.W"
  ]
  ZicbopInstructions.map(fun (instruction): instruction.encoding.value) ~is [
    0x00006013, 0x00106013, 0x00306013
  ]
  (for all (instruction in ZicbopInstructions):
     instruction.encoding.care == 0x01F07FFF) ~is #true
  (for all (instruction in ZicbopInstructions):
     instruction.operands.map(fun (operand): operand.name) == ["rs1"]) ~is #true
  (for all (instruction in ZicbopInstructions):
     instruction.immediate === PrefetchImmediate) ~is #true
  PrefetchFormat.variable_mask ~is 0xFE0F8000
  PREFETCH_I.encoding.overlaps(ORI.encoding) ~is #true

  PREFETCH_R.encode([rs1.constrain(5)], ~immediate: 96) ~is 0x0612E013
  PREFETCH_W.encode([rs1.constrain(7)], ~immediate: -32) ~is 0xFE33E013
  PrefetchImmediate.decode(0x0612E013) ~is 0x060
  PrefetchImmediate.decode(0xFE33E013) ~is 0xFE0
  Zicbop.matching(0x0612E013) === PREFETCH_R ~is #true
  Zicbop.matching(0xFE33E013) === PREFETCH_W ~is #true
  Zicbop.matching(0x00206013) ~is #false

  PREFETCH_I.encode([rs1.constrain(1)], ~immediate: 1) ~throws "implicit-zero"
