#lang rhombus
// Checks host-side construction and validation of RISC-V physical-memory maps.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/std/interconnect.rhdl".AddressSet
  "../rtl/pma.rhdl" open

def normal = RiscvPhysicalMemoryAttributes(#true, #true, #true, #true, #true, #false, #true, ~cache_block_zero: #true)
def device = RiscvPhysicalMemoryAttributes(#true, #true, #false, #false, #false, #true, #false)
def rom = RiscvPhysicalMemoryAttributes(#true, #false, #true, #false, #false, #false, #true, ~instruction_cacheable: #true)
def physical_map = RiscvPhysicalMemoryMap(
  16,
  [RiscvPhysicalMemoryRegion(AddressSet(0x0000, 0x7fff), normal),
   RiscvPhysicalMemoryRegion(AddressSet(0x8000, 0x7fff), device)]
)

check:
  normal.instruction_cacheable ~is #true
  device.instruction_cacheable ~is #false
  rom.instruction_cacheable ~is #true
  rom.cacheable ~is #false
  RiscvPhysicalMemoryAttributes(#true, #true, #true, #false, #false, #false, #true, ~instruction_cacheable: #true) ~throws "instruction-only caching requires"
  RiscvPhysicalMemoryAttributes(#true, #false, #true, #false, #false, #true, #true, ~instruction_cacheable: #true) ~throws "instruction-only caching requires"
  RiscvPhysicalMemoryAttributes(#true, #false, #true, #false, #false, #false, #false, ~instruction_cacheable: #true) ~throws "instruction-only caching requires"
  normal.cache_block_zero ~is #true
  device.cache_block_zero ~is #false
  physical_map.address_width ~is 16
  physical_map.regions.length() ~is 2
  physical_map.regions[0].attributes.cacheable ~is #true
  physical_map.regions[1].attributes.cacheable ~is #false
  physical_map.regions[0].attributes.device ~is #false
  physical_map.regions[0].attributes.read_idempotent ~is #true
  physical_map.regions[1].attributes.device ~is #true
  physical_map.regions[1].attributes.read_idempotent ~is #false
  RiscvPhysicalMemoryAttributes(#true, #false, #true, #true, #false, #true, #true) ~throws "cannot use device-memory semantics"
  RiscvPhysicalMemoryMap(
    12,
    [RiscvPhysicalMemoryRegion(AddressSet(0x1000, 0x0fff), normal)]
  ) ~throws "must fit the address width"
  RiscvPhysicalMemoryMap(
    16,
    [RiscvPhysicalMemoryRegion(AddressSet(0x0000, 0x1fff), normal),
     RiscvPhysicalMemoryRegion(AddressSet(0x1000, 0x0fff), device)]
  ) ~throws "must not overlap"
