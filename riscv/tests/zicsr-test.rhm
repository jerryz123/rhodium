#lang rhombus
// Checks Zicsr and privileged-system instruction catalogs and encodings.
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/zicsr.rhm" open
  "../isa/privileged.rhm" open

check:
  Zicsr.instructions.map(fun (instruction): instruction.name) ~is [
    "CSRRW", "CSRRS", "CSRRC", "CSRRWI", "CSRRSI", "CSRRCI"
  ]
  Zicsr.matching(0x300110f3) === CSRRW ~is #true
  Zicsr.matching(0x300120f3) === CSRRS ~is #true
  Zicsr.matching(0x300130f3) === CSRRC ~is #true
  Zicsr.matching(0x300150f3) === CSRRWI ~is #true
  Zicsr.matching(0x300160f3) === CSRRSI ~is #true
  Zicsr.matching(0x300170f3) === CSRRCI ~is #true
  CSRRW.encoding.value ~is 0x00001073
  CSRRW.encoding.care ~is 0x0000707f
  CSRRW.operands.map(fun (operand): operand.name) ~is ["rd", "rs1"]
  CSRRWI.operands.map(fun (operand): operand.name) ~is ["rd"]
  MRET.encoding.value ~is 0x30200073
  MRET.encoding.care ~is 0xffffffff
  SRET.encoding.value ~is 0x10200073
  SRET.encoding.care ~is 0xffffffff
  WFI.encoding.value ~is 0x10500073
  WFI.encoding.care ~is 0xffffffff
  PrivilegedInstructions.contains(WFI) ~is #true
