#lang rhombus
// Checks synchronous exception cause identifiers, codes, and generated masks.
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/trap.rhm" open

check:
  ExceptionCause.IllegalInstruction is_a ExceptionCause ~is #true
  exception_code(ExceptionCause.InstructionAddressMisaligned) ~is 0
  exception_code(ExceptionCause.InstructionAccessFault) ~is 1
  exception_code(ExceptionCause.IllegalInstruction) ~is 2
  exception_code(ExceptionCause.EnvironmentCallFromMachine) ~is 11
  exception_code(ExceptionCause.StorePageFault) ~is 15
  exception_code(ExceptionCause.LoadAccessFault) ~is 5
  exception_code(ExceptionCause.StoreAccessFault) ~is 7
  exception_mask([
    ExceptionCause.IllegalInstruction,
    ExceptionCause.Breakpoint,
    ExceptionCause.EnvironmentCallFromUser
  ]) ~is 0x10c
