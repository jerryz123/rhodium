#lang rhombus
// Checks Zfa catalogs, encodings, and register-operand metadata.
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/zfa.rhm" open
  "../model/main.rhm" open

check:
  ZfaRevision ~is "Zfa 1.0"
  ZfaSingleInstructions.length() ~is 7
  ZfaDoubleInstructions.length() ~is 8
  ZfaHalfInstructions.length() ~is 7
  RV32ZfaDoubleMoveInstructions.length() ~is 2
  FLI_S.encoding.value ~is 0xf0100053
  FLI_S.encoding.care ~is 0xfff0707f
  FMINM_S.encoding.value ~is 0x28002053
  FROUND_S.encoding.value ~is 0x40400053
  FLEQ_S.encoding.value ~is 0xa0004053
  FLI_D.encoding.value ~is 0xf2100053
  FCVTMOD_W_D.encoding.value ~is 0xc2801053
  FLI_H.encoding.value ~is 0xf4100053
  FMVH_X_D.encoding.value ~is 0xe2100053
  FMVP_D_X.encoding.value ~is 0xb2000053
  FLI_S.operands.map(fun (operand): operand.name) ~is ["frd"]
  FLI_S.encoding_fields.map(fun (field): field.name) ~is ["rd", "rs1"]
  FROUND_D.operands.map(fun (operand): operand.name) ~is ["frd", "frs1"]
  FCVTMOD_W_D.operands.map(fun (operand): operand.bank) ~is [RegisterBank.Integer, RegisterBank.FloatingPoint]
  FMVP_D_X.operands.map(fun (operand): operand.bank) ~is [RegisterBank.FloatingPoint, RegisterBank.Integer, RegisterBank.Integer]
  ZfaF.matching(0xf01280d3) === FLI_S ~is #true
  ZfaD.matching(0xc28110d3) === FCVTMOD_W_D ~is #true
