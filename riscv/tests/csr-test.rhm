#lang rhombus
// Checks the closed architectural CSR identifier catalog and address mapping.
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/csr.rhm" open

check:
  CsrId.Mstatus is_a CsrId ~is #true
  CsrIds.length() ~is 196
  CsrIds.map(csr_address) ~is [
    0x001, 0x002, 0x003,
    0x008, 0x009, 0x00a, 0x00f, 0xc20, 0xc21, 0xc22,
    0x100, 0x104, 0x105, 0x106, 0x10a, 0x140, 0x141,
    0x142, 0x143, 0x144, 0x180,
    0xc00, 0xc01, 0xc02, 0xc80, 0xc81, 0xc82,
    0x300, 0x301, 0x302,
    0x303, 0x304, 0x305, 0x306, 0x30a, 0x310, 0x31a, 0x340, 0x341,
    0x342, 0x343, 0x344, 0xb00, 0xb02, 0xb80, 0xb82,
    0xf11, 0xf12, 0xf13, 0xf14, 0xf15
  ] ++ (for List (index in 3..32): 0xc00 + index) ++ (
    for List (index in 3..32): 0xc80 + index
  ) ++ (for List (index in 3..32): 0xb00 + index) ++ (
    for List (index in 3..32): 0xb80 + index
  ) ++ (for List (index in 3..32): 0x320 + index)
  csr_address(CsrId.Fflags) ~is 0x001
  csr_address(CsrId.Frm) ~is 0x002
  csr_address(CsrId.Fcsr) ~is 0x003
  csr_address(CsrId.Sstatus) ~is 0x100
  csr_address(CsrId.Satp) ~is 0x180
  csr_address(CsrId.Time) ~is 0xc01
  csr_address(CsrId.Instret) ~is 0xc02
  csr_address(CsrId.Mcycle) ~is 0xb00
  csr_address(CsrId.Minstret) ~is 0xb02
  csr_address(CsrId.Mstatus) ~is 0x300
  csr_address(CsrId.Mepc) ~is 0x341
  csr_address(CsrId.Mhartid) ~is 0xf14
  csr_address(CsrId.Mconfigptr) ~is 0xf15
  csr_address(CsrId.Mstatush) ~is 0x310
  csr_address(CsrId.Menvcfgh) ~is 0x31a

for (family in [HpmCounterIds, HpmCounterHighIds, MachineHpmCounterIds, MachineHpmCounterHighIds, MachineHpmEventIds]):
  check:
    family.length() ~is 29
  for (id in family):
    check:
      id is_a CsrId ~is #true
      CsrIds.filter(~keep: fun (candidate): csr_address(candidate) == csr_address(id)).length() ~is 1
