#lang rhombus
// Checks the closed architectural CSR identifier catalog and address mapping.
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/csr.rhm" open

check:
  CsrId.Mstatus is_a CsrId ~is #true
  CsrIds.length() ~is 247
  CsrIds.map(csr_address) ~is [
    0x001, 0x002, 0x003,
    0x008, 0x009, 0x00a, 0x00f, 0xc20, 0xc21, 0xc22,
    0x100, 0x104, 0x105, 0x14d, 0x15d, 0x106, 0x10a, 0x140, 0x141,
    0x142, 0x143, 0x144, 0x180,
    0xc00, 0xc01, 0xc02, 0xc80, 0xc81, 0xc82,
    0x300, 0x301, 0x302,
    0x303, 0x304, 0x305, 0x306, 0x30a, 0x310, 0x31a, 0x340, 0x341,
    0x342, 0x343, 0x344, 0xb00, 0xb02, 0xb80, 0xb82,
    0xf11, 0xf12, 0xf13, 0xf14, 0xf15
  ] ++ (for List (index in 3..32): 0xc00 + index) ++ (
    for List (index in 3..32): 0xc80 + index
  ) ++ (for List (index in 3..32): 0xb00 + index) ++ (
    for List (index in 3..32): 0xb80 + index
  ) ++ (for List (index in 3..32): 0x320 + index) ++ [
    0x200, 0x204, 0x205, 0x24d, 0x25d, 0x240, 0x241, 0x242, 0x243, 0x244, 0x280,
    0x600, 0x602, 0x603, 0x604, 0x605, 0x606, 0x607, 0x60a, 0x615,
    0x61a, 0x643, 0x644, 0x645, 0x64a, 0x680, 0xe12, 0x34a, 0x34b
  ] ++ [
    0x30c, 0x30d, 0x30e, 0x30f, 0x31c, 0x31d, 0x31e, 0x31f,
    0x60c, 0x60d, 0x60e, 0x60f, 0x61c, 0x61d, 0x61e, 0x61f,
    0x10c, 0x10d, 0x10e, 0x10f
  ]
  csr_address(CsrId.Fflags) ~is 0x001
  csr_address(CsrId.Frm) ~is 0x002
  csr_address(CsrId.Fcsr) ~is 0x003
  csr_address(CsrId.Sstatus) ~is 0x100
  csr_address(CsrId.Satp) ~is 0x180
  csr_address(CsrId.Time) ~is 0xc01
  csr_address(CsrId.Instret) ~is 0xc02
  csr_address(CsrId.Mcycle) ~is 0xb00
  csr_address(CsrId.Minstret) ~is 0xb02
  csr_address(CsrId.Mstatus) ~is 0x300
  csr_address(CsrId.Mepc) ~is 0x341
  csr_address(CsrId.Mhartid) ~is 0xf14
  csr_address(CsrId.Mconfigptr) ~is 0xf15
  csr_address(CsrId.Mstatush) ~is 0x310
  csr_address(CsrId.Menvcfgh) ~is 0x31a
  csr_address(CsrId.Stimecmp) ~is 0x14d
  csr_address(CsrId.Stimecmph) ~is 0x15d
  csr_address(CsrId.Vstimecmp) ~is 0x24d
  csr_address(CsrId.Vstimecmph) ~is 0x25d
  EnvcfgSTCE.mask() ~is 0x8000000000000000
  EnvcfghSTCE.mask() ~is 0x80000000
  StateenSE.mask() ~is 0x8000000000000000
  StateenENVCFG.mask() ~is 0x4000000000000000
  StateEnableCsrIds.length() ~is 20
  FcsrFlags.low ~is 0
  FcsrFlags.width ~is 5
  FcsrRoundingMode.low ~is 5
  MstatusMPP.low ~is 11
  MstatusMPP.width ~is 2
  MstatusSXL.mask() ~is 0xc00000000
  MenvcfgPBMTE.mask() ~is 0x4000000000000000
  csr_fields_mask([MstatusSIE, MstatusMIE, MstatusUPIE, MstatusSPIE, MstatusMPIE, MstatusSPP, MstatusMPP, MstatusMPRV, MstatusSUM, MstatusMXR, MstatusTVM, MstatusTW, MstatusTSR]) ~is 0x7e19ba
  csr_fields_mask([MstatusSIE, MstatusUPIE, MstatusSPIE, MstatusSPP, MstatusSUM, MstatusMXR]) ~is 0xc0132
  csr_fields_mask([CounterenCY, CounterenTM, CounterenIR]) ~is 0x7
  Satp64Mode.mask() ~is 0xf000000000000000
  Satp64ASID.mask() ~is 0x0ffff00000000000
  Satp64PPN.mask() ~is 0x00000fffffffffff

for (family in [HpmCounterIds, HpmCounterHighIds, MachineHpmCounterIds, MachineHpmCounterHighIds, MachineHpmEventIds]):
  check:
    family.length() ~is 29
  for (id in family):
    check:
      id is_a CsrId ~is #true
      CsrIds.filter(~keep: fun (candidate): csr_address(candidate) == csr_address(id)).length() ~is 1
