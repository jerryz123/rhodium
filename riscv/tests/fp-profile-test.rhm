#lang rhombus
// Checks host floating-point profiles and their implied extension support.
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/fp-profile.rhm" open

def f_zfhmin_supported = check_half_precision_profile(FloatingPointProfile.F, HalfPrecisionProfile.Zfhmin)
def d_zfh_supported = check_half_precision_profile(FloatingPointProfile.D, HalfPrecisionProfile.Zfh)

check:
  DefaultFloatingPointProfile == FloatingPointProfile.None ~is #true
  floating_point_supports_f(FloatingPointProfile.None) ~is #false
  floating_point_supports_d(FloatingPointProfile.None) ~is #false
  floating_point_supports_f(FloatingPointProfile.F) ~is #true
  floating_point_supports_d(FloatingPointProfile.F) ~is #false
  floating_point_supports_f(FloatingPointProfile.D) ~is #true
  floating_point_supports_d(FloatingPointProfile.D) ~is #true
  floating_point_register_width(FloatingPointProfile.F) ~is 32
  floating_point_register_width(FloatingPointProfile.D) ~is 64
  floating_point_register_width(FloatingPointProfile.None) ~throws "no floating-point register file"
  DefaultHalfPrecisionProfile == HalfPrecisionProfile.None ~is #true
  half_precision_supports_zfhmin(HalfPrecisionProfile.None) ~is #false
  half_precision_supports_zfhmin(HalfPrecisionProfile.Zfhmin) ~is #true
  half_precision_supports_zfhmin(HalfPrecisionProfile.Zfh) ~is #true
  half_precision_supports_zfh(HalfPrecisionProfile.Zfhmin) ~is #false
  half_precision_supports_zfh(HalfPrecisionProfile.Zfh) ~is #true
  check_half_precision_profile(FloatingPointProfile.None, HalfPrecisionProfile.Zfhmin) ~throws "require a base F or D"
