#lang rhombus
// Checks the RV32D and RV64D catalogs and representative encodings.
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/d.rhm" open
  "../model/main.rhm" open

check:
  RV32D.revision ~is "RV32 D 2.2"
  RV64D.revision ~is "RV64 D 2.2"
  RV32D.instructions.length() ~is 26
  RV64D.instructions.length() ~is 32
  FADD_D.encoding.value ~is 0x02000053
  FADD_D.encoding.care ~is 0xFE00007F
  FMADD_D.encoding.value ~is 0x02000043
  FMADD_D.encoding.care ~is 0x0600007F
  FCVT_S_D.encoding.value ~is 0x40100053
  FCVT_S_D.encoding.care ~is 0xFFF0007F
  FMV_X_D.encoding.value ~is 0xE2000053
  FMV_X_D.encoding.care ~is 0xFFF0707F
  FSD.operands.map(fun (operand): operand.name) ~is ["rs1", "frs2"]
  FCVT_D_S.operands.map(fun (operand): operand.name) ~is ["frd", "frs1"]
  RV32D.matching(0x023100C3) === FMADD_D ~is #true
  RV64D.matching(0xE2010053) === FMV_X_D ~is #true
  rv64d_instruction("FCVT.D.LU") === FCVT_D_LU ~is #true
