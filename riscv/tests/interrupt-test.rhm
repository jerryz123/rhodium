#lang rhombus
// Checks standard interrupt cause identifiers and architectural cause codes.
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/interrupt.rhm" open

check:
  InterruptCause.MachineTimer is_a InterruptCause ~is #true
  interrupt_code(InterruptCause.SupervisorSoftware) ~is 1
  interrupt_code(InterruptCause.MachineSoftware) ~is 3
  interrupt_code(InterruptCause.SupervisorTimer) ~is 5
  interrupt_code(InterruptCause.MachineTimer) ~is 7
  interrupt_code(InterruptCause.SupervisorExternal) ~is 9
  interrupt_code(InterruptCause.MachineExternal) ~is 11
