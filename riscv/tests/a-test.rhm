#lang rhombus
// Checks the RV32A and RV64A catalogs, formats, and representative encodings.
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/a.rhm" open

check:
  RV32A.revision ~is "RV32 A 2.1"
  RV64A.revision ~is "RV64 A 2.1"
  RV32A.instructions.length() ~is 11
  RV64A.instructions.length() ~is 22
  RV32A.matching(0x100120AF) === LR_W ~is #true
  RV32A.matching(0x183120AF) === SC_W ~is #true
  RV32A.matching(0x063120AF) === AMOADD_W ~is #true
  RV32A.matching(0xE03120AF) === AMOMAXU_W ~is #true
  RV32A.matching(0x100130AF) ~is #false
  RV64A.matching(0x100130AF) === LR_D ~is #true
  RV64A.matching(0xE03130AF) === AMOMAXU_D ~is #true
  LR_W.encoding.value ~is 0x1000202F
  LR_W.encoding.care ~is 0xF9F0707F
  AMOADD_W.encoding.value ~is 0x0000202F
  AMOADD_W.encoding.care ~is 0xF800707F
  LR_W.operands.map(fun (operand): operand.name) ~is ["rd", "rs1"]
  AMOADD_W.operands.map(fun (operand): operand.name) ~is ["rd", "rs1", "rs2"]
  LR_W.encoding_fields.map(fun (field): field.name) ~is ["rd", "rs1", "aq", "rl"]
  AMOADD_W.encoding_fields.map(fun (field): field.name) ~is ["rd", "rs1", "rs2", "aq", "rl"]
  rv32a_instruction("AMOSWAP.W") === AMOSWAP_W ~is #true
  rv64a_instruction("AMOADD.D") === AMOADD_D ~is #true
