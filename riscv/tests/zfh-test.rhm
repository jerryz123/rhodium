#lang rhombus
// Checks the Zfhmin and Zfh instruction catalogs and their architectural boundaries.
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/zfhmin.rhm" as zfhmin
  "../isa/zfh.rhm" as zfh

check:
  zfhmin.ZfhminInstructions.length() ~is 6
  zfhmin.ZfhminDInstructions.length() ~is 2
  zfh.ZfhInstructions.length() ~is 28
  zfh.RV32ZfhInstructions.length() ~is 28
  zfh.RV64ZfhInstructions.length() ~is 32
  zfhmin.FLH.encoding.matches(0x00001007) ~is #true
  zfhmin.FSH.encoding.matches(0x00001027) ~is #true
  zfhmin.FMV_X_H.encoding.matches(0xe4000053) ~is #true
  zfhmin.FCVT_S_H.encoding.matches(0x40200053) ~is #true
  zfh.FADD_H.encoding.matches(0x04000053) ~is #true
  zfh.FDIV_H.encoding.matches(0x1c000053) ~is #true
  zfh.FCLASS_H.encoding.matches(0xe4001053) ~is #true
