#lang rhombus
// Checks compressed-instruction catalogs, XLEN distinctions, and pure expansion semantics.

import:
  "../isa/c.rhm" open
  "../isa/zca.rhm" open
  "../isa/zcf.rhm" open
  "../isa/zcd.rhm" open
  "../isa/zcmop.rhm" open
  "../isa/fp-profile.rhm" open
  "../isa/xlen.rhm" open
def addi = RV32Zca.matching(0x0085)
def lui_hint = RV64Zca.matching(0x6005)
fun expansions_match_targets(catalog :: CompressedInstructionCatalog):
  for all (word in 0..0x10000):
    def instruction = catalog.matching(word)
    if instruction
    | instruction.expansion.target.matches(instruction.expand(word))
    | #true

check:
  compressed_extensions_enabled(NoCompressedExtensions) ~is #false
  compressed_extensions_enabled(ZcaCompressedExtensions) ~is #true
  compressed_extensions_enabled(CCompressedExtensions) ~is #true
  compressed_extensions_report_misa_c(XLen.X64, FloatingPointProfile.None, NoCompressedExtensions) ~is #false
  compressed_extensions_report_misa_c(XLen.X64, FloatingPointProfile.None, ZcaCompressedExtensions) ~is #true
  compressed_extensions_report_misa_c(XLen.X64, FloatingPointProfile.F, ZcaCompressedExtensions) ~is #false
  compressed_extensions_report_misa_c(XLen.X64, FloatingPointProfile.D, ZcaCompressedExtensions) ~is #false
  compressed_extensions_report_misa_c(XLen.X64, FloatingPointProfile.D, CCompressedExtensions) ~is #true
  compressed_extensions(CompressedExtension.Zcb) ~throws "Zcb requires Zca or C"
  compressed_extensions(CompressedExtension.Zcmop) ~throws "Zcmop requires Zca or C"
  compressed_extensions(CompressedExtension.Zca, CompressedExtension.Zca) ~throws "duplicate compressed extension"
  compressed_extensions(CompressedExtension.C, CompressedExtension.Zca) ~throws "C already supplies"
  compressed_extensions_instructions(XLen.X64, FloatingPointProfile.None, ZcaCompressedExtensions, []) ~throws "downstream decoder"
  zca_instructions(XLen.X32).map(fun (instruction): instruction.name).contains("C.FLW") ~is #false
  c_instructions(XLen.X32, FloatingPointProfile.F).map(fun (instruction): instruction.name).contains("C.FLW") ~is #true
  c_instructions(XLen.X32, FloatingPointProfile.D).map(fun (instruction): instruction.name).contains("C.FLD") ~is #true
  c_instructions(XLen.X64, FloatingPointProfile.F).map(fun (instruction): instruction.name).contains("C.FLW") ~is #false
  c_instructions(XLen.X64, FloatingPointProfile.D).map(fun (instruction): instruction.name).contains("C.FLD") ~is #true
  RV64Zca.find("C.ADDIW").name ~is "C.ADDIW"
  addi.name ~is "C.ADDI"
  addi.expand(0x0085) ~is 0x00108093
  lui_hint.name ~is "C.LUI"
  lui_hint.expand(0x6005) ~is 0x00001037
  RV64Zca.matching(0x0000) ~is #false
  RV64Zca.matching(0x6081) ~is #false
  Zcmop.matching(0x6081).name ~is "C.MOP.1"
  Zcmop.matching(0x6781).name ~is "C.MOP.15"
  Zcmop.matching(0x6101) ~is #false
  RV64Zca.matching(0x6101) ~is #false
  RV64Zca.matching(0x2005) ~is #false
  RV64Zca.matching(0x2085).name ~is "C.ADDIW"
  RV32Zca.matching(0x2085).name ~is "C.JAL"
  RV64Zca.matching(0x9002).name ~is "C.EBREAK"
  RV32Zcf.matching(0x6000).name ~is "C.FLW"
  RV32Zcd.matching(0x2000).name ~is "C.FLD"
  RV64Zcd.matching(0x2000).name ~is "C.FLD"
  expansions_match_targets(RV32Zca) ~is #true
  expansions_match_targets(RV64Zca) ~is #true
  expansions_match_targets(RV32Zcf) ~is #true
  expansions_match_targets(RV32Zcd) ~is #true
  expansions_match_targets(RV64Zcd) ~is #true
