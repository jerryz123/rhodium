#lang rhombus
// Checks the RV32F and RV64F catalogs and representative encodings.
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/f.rhm" open
  "../model/main.rhm" open

check:
  RV32F.revision ~is "RV32 F 2.2"
  RV64F.revision ~is "RV64 F 2.2"
  RV32F.instructions.length() ~is 26
  RV64F.instructions.length() ~is 30
  FADD_S.encoding.value ~is 0x00000053
  FADD_S.encoding.care ~is 0xFE00007F
  FMADD_S.encoding.value ~is 0x00000043
  FMADD_S.encoding.care ~is 0x0600007F
  FCLASS_S.encoding.value ~is 0xE0001053
  FCLASS_S.encoding.care ~is 0xFFF0707F
  FLW.operands.map(fun (operand): operand.name) ~is ["frd", "rs1"]
  FADD_S.operands.map(fun (operand): operand.name) ~is ["frd", "frs1", "frs2"]
  FMADD_S.operands.map(fun (operand): operand.name) ~is ["frd", "frs1", "frs2", "frs3"]
  FMADD_S.encoding_fields.map(fun (field): field.name) ~is ["rd", "rs1", "rs2", "rs3", "rm"]
  FMV_X_W.operands.map(fun (operand): operand.bank) ~is [RegisterBank.Integer, RegisterBank.FloatingPoint]
  RV32F.matching(0x003100C3) === FMADD_S ~is #true
  RV32F.matching(0x003170C3) === FMADD_S ~is #true
  RV64F.matching(0xC0208053) === FCVT_L_S ~is #true
  rv32f_instruction("FSGNJX.S") === FSGNJX_S ~is #true
