#lang rhombus
// Checks the standard RV32B/RV64B catalogs and representative Zba, Zbb, and Zbs encodings.
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/b.rhm" open
  "../isa/zba.rhm" as zba
  "../isa/zbb.rhm" as zbb
  "../isa/zbs.rhm" as zbs

check:
  RV32B.instructions.length() ~is 29
  RV64B.instructions.length() ~is 40
  zba.RV32Zba.instructions.length() ~is 3
  zba.RV64Zba.instructions.length() ~is 8
  zbb.RV32Zbb.instructions.length() ~is 18
  zbb.RV64Zbb.instructions.length() ~is 24
  zbs.RV32Zbs.instructions.length() ~is 8
  zbs.RV64Zbs.instructions.length() ~is 8
  zba.SH1ADD.encoding.value ~is 0x20002033
  zba.ADD_UW.encoding.value ~is 0x0800003B
  zba.SLLI_UW.encoding.value ~is 0x0800101B
  zbb.ANDN.encoding.value ~is 0x40007033
  zbb.CLZ.encoding.value ~is 0x60001013
  zbb.REV8.encoding.value ~is 0x6B805013
  zbb.ZEXT_H.encoding.value ~is 0x0800403B
  zbs.BCLRI.encoding.value ~is 0x48001013
  zbs.BEXTI.encoding.value ~is 0x48005013
  zbs.BINVI.encoding.value ~is 0x68001013
  zbs.BSETI.encoding.value ~is 0x28001013
  RV32B.matching(0x60011093) === zbb.CLZ ~is #true
  RV64B.matching(0x6B815093) === zbb.REV8 ~is #true
  RV64B.matching(0x28011093) === zbs.BSETI ~is #true
  RV64B.matching(0x00000013) ~is #false
