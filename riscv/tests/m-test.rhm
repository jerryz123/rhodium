#lang rhombus
// Checks complete RV32M and RV64M catalogs and divide/remainder encodings.
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/rv64i.rhm" as rv64i
  "../isa/m.rhm" open

check:
  RV32M.revision ~is "RV32 M 2.0"
  RV64M.revision ~is "RV64 M 2.0"
  RV32M.instructions.map(fun (instruction): instruction.name) ~is [
    "MUL", "MULH", "MULHSU", "MULHU", "DIV", "DIVU", "REM", "REMU"
  ]
  RV64M.instructions.map(fun (instruction): instruction.name) ~is [
    "MUL", "MULH", "MULHSU", "MULHU", "MULW",
    "DIV", "DIVU", "REM", "REMU", "DIVW", "DIVUW", "REMW", "REMUW"
  ]
  RV32M.matching(0x023140B3) === DIV ~is #true
  RV32M.matching(0x023150B3) === DIVU ~is #true
  RV32M.matching(0x023160B3) === REM ~is #true
  RV32M.matching(0x023170B3) === REMU ~is #true
  RV32M.matching(0x023140BB) ~is #false
  RV64M.matching(0x023140BB) === DIVW ~is #true
  RV64M.matching(0x023150BB) === DIVUW ~is #true
  RV64M.matching(0x023160BB) === REMW ~is #true
  RV64M.matching(0x023170BB) === REMUW ~is #true
  rv32m_instruction("DIV") === DIV ~is #true
  rv64m_instruction("REMUW") === REMUW ~is #true
  DIV.encoding.value ~is 0x02004033
  DIV.encoding.care ~is 0xFE00707F
  DIVW.encoding.value ~is 0x0200403B
  DIVW.encoding.care ~is 0xFE00707F
  DIV.operands.map(fun (operand): operand.name) ~is ["rd", "rs1", "rs2"]
  DIV.immediate ~is #false
  rv64i.RV64I.matching(0x023140B3) ~is #false
