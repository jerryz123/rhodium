#lang rhombus
// Checks the Zifencei catalog and its architecturally ignored encoding fields.
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/zifencei.rhm" open

check:
  Zifencei.revision ~is "Zifencei 2.0"
  Zifencei.instructions.map(fun (instruction): instruction.name) ~is ["FENCE.I"]
  Zifencei.matching(0x0000100f) === FENCE_I ~is #true
  // funct12, rs1, and rd are reserved for future use but ignored by implementations.
  Zifencei.matching(0xffff9f8f) === FENCE_I ~is #true
  Zifencei.matching(0x0000000f) ~is #false
