#lang rhombus
// Checks independent RVV opcode words, operand formats, CSR IDs, and all vtype encodings.
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/v.rhm" open
  "../isa/vector.rhm" open
  "../isa/csr.rhm" open
  "../model/main.rhm" as model

check:
  VCPOP_M.encode([model.rd.constrain(1), vs2.constrain(2), vm.constrain(1)]) ~is 0x422820d7
  VFIRST_M.encode([model.rd.constrain(1), vs2.constrain(2), vm.constrain(0)]) ~is 0x4028a0d7
  VMSBF_M.encode([vd.constrain(1), vs2.constrain(2), vm.constrain(1)]) ~is 0x5220a0d7
  VMSIF_M.encode([vd.constrain(1), vs2.constrain(2), vm.constrain(1)]) ~is 0x5221a0d7
  VMSOF_M.encode([vd.constrain(1), vs2.constrain(2), vm.constrain(1)]) ~is 0x522120d7
  VIOTA_M.encode([vd.constrain(1), vs2.constrain(2), vm.constrain(1)]) ~is 0x522820d7
  VID_V.encode([vd.constrain(1), vm.constrain(1)]) ~is 0x5208a0d7
  VectorMaskScalarFormat.operands.map(fun (operand): operand.bank) ~is [model.RegisterBank.Integer, model.RegisterBank.Vector]
  VectorIndexFormat.operands.map(fun (operand): operand.name) ~is ["vd"]
  VectorInitial.matching(0x5218a0d7) ~is #false
  VMV_X_S.encode([model.rd.constrain(1), vs2.constrain(2)]) ~is 0x422020d7
  VMV_S_X.encode([vd.constrain(1), model.rs1.constrain(3)]) ~is 0x4201e0d7
  VectorReadScalarFormat.operands.map(fun (operand): operand.bank) ~is [model.RegisterBank.Integer, model.RegisterBank.Vector]
  VectorInitial.matching(0x402020d7) ~is #false
  VectorInitial.matching(0x4220a0d7) ~is #false
  VectorInitial.matching(0x4221e0d7) ~is #false
  VMERGE_VVM.encode([vd.constrain(1), vs2.constrain(2), vs1.constrain(3)]) ~is 0x5c2180d7
  VMERGE_VXM.encode([vd.constrain(1), vs2.constrain(2), model.rs1.constrain(3)]) ~is 0x5c21c0d7
  VMERGE_VIM.encode([vd.constrain(1), vs2.constrain(2)], ~immediate: -1) ~is 0x5c2fb0d7
  VMV_V_V.encode([vd.constrain(1), vs1.constrain(3)]) ~is 0x5e0180d7
  VMV_V_X.encode([vd.constrain(1), model.rs1.constrain(3)]) ~is 0x5e01c0d7
  VMV_V_I.encode([vd.constrain(1)], ~immediate: -1) ~is 0x5e0fb0d7
  VectorInitial.matching(0x5e2180d7) ~is #false
  VectorMoveVFormat.operands.map(fun (operand): operand.name) ~is ["vd", "vs1"]
  VectorMoveXFormat.operands.map(fun (operand): operand.bank) ~is [model.RegisterBank.Vector, model.RegisterBank.Integer]
  VMUL_VV.encode([vd.constrain(1), vs2.constrain(2), vs1.constrain(3), vm.constrain(1)]) ~is 0x9621a0d7
  VMULHSU_VX.encode([vd.constrain(1), vs2.constrain(2), model.rs1.constrain(3), vm.constrain(0)]) ~is 0x9821e0d7
  VDIV_VV.encode([vd.constrain(1), vs2.constrain(2), vs1.constrain(3), vm.constrain(1)]) ~is 0x8621a0d7
  VREMU_VX.encode([vd.constrain(1), vs2.constrain(2), model.rs1.constrain(3), vm.constrain(1)]) ~is 0x8a21e0d7
  VFADD_VV.encode([vd.constrain(1), vs2.constrain(2), vs1.constrain(3), vm.constrain(1)]) ~is 0x022190d7
  VFSUB_VV.encode([vd.constrain(1), vs2.constrain(2), vs1.constrain(3), vm.constrain(1)]) ~is 0x0a2190d7
  VFMUL_VV.encode([vd.constrain(1), vs2.constrain(2), vs1.constrain(3), vm.constrain(1)]) ~is 0x922190d7
  VSETVLI.encode([model.rd.constrain(1), model.rs1.constrain(2), vtype11.constrain(0xd0)]) ~is 0x0d0170d7
  VSETIVLI.encode([model.rd.constrain(1), avl5.constrain(7), vtype10.constrain(0xd0)]) ~is 0xcd03f0d7
  VSETVL.encode([model.rd.constrain(1), model.rs1.constrain(2), model.rs2.constrain(3)]) ~is 0x803170d7
  VADD_VV.encode([vd.constrain(1), vs2.constrain(2), vs1.constrain(3), vm.constrain(1)]) ~is 0x022180d7
  VSUB_VX.encode([vd.constrain(1), vs2.constrain(2), model.rs1.constrain(3), vm.constrain(0)]) ~is 0x0821c0d7
  VADD_VI.encode([vd.constrain(1), vs2.constrain(2), vm.constrain(1)], ~immediate: -1) ~is 0x022fb0d7
  VSLL_VI.encode([vd.constrain(1), vs2.constrain(2), vm.constrain(1)], ~immediate: 31) ~is 0x962fb0d7
  VSLL_VI.encode([vd.constrain(1), vs2.constrain(2), vm.constrain(1)], ~immediate: -1) ~throws ""
  VLE8_V.encode([vd.constrain(1), model.rs1.constrain(2), vm.constrain(1)]) ~is 0x02010087
  VLE16_V.encode([vd.constrain(1), model.rs1.constrain(2), vm.constrain(1)]) ~is 0x02015087
  VSE64_V.encode([vs3.constrain(3), model.rs1.constrain(2), vm.constrain(0)]) ~is 0x000171a7
  VectorLoadFormat.operands.map(fun (operand): operand.bank) ~is [model.RegisterBank.Vector, model.RegisterBank.Integer]
  VectorStoreFormat.operands.map(fun (operand): operand.role) ~is ["source", "source"]
  VectorVVFormat.operands.map(fun (operand): operand.bank) ~is [model.RegisterBank.Vector, model.RegisterBank.Vector, model.RegisterBank.Vector]
  [CsrId.Vstart, CsrId.Vxsat, CsrId.Vxrm, CsrId.Vcsr, CsrId.Vl, CsrId.Vtype, CsrId.Vlenb].map(csr_address) ~is [8, 9, 10, 15, 0xc20, 0xc21, 0xc22]

for (instruction in VectorIntegerReductionInstructions, index in 0..8):
  check:
    instruction.encode([vd.constrain(1), vs2.constrain(2), vs1.constrain(3), vm.constrain(1)]) ~is (0x0221a0d7 bits.or (index bits.(<<) 26))
for (instruction in VectorMaskLogicInstructions, index in 0..8):
  check:
    instruction.encode([vd.constrain(1), vs2.constrain(2), vs1.constrain(3)]) ~is (0x6221a0d7 bits.or (index bits.(<<) 26))
    VectorInitial.matching(instruction.encoding.value bits.xor (1 bits.(<<) 25)) ~is #false

for (vlen in [128, 256, 512, 65536]):
  for (encoding in 0..512):
    def sew = bits.field(encoding, 3, 6)
    def lm = bits.field(encoding, 0, 3)
    def exponent = if lm >= 4 | lm - 8 | lm
    def legal = encoding < 256 && sew <= 3 && lm != 4 && sew <= exponent + 3
    def decoded = vector_vtype_config(vlen, encoding)
    check:
      (decoded != #false) ~is legal
    when decoded
    | check:
        decoded.vlmax ~is vlen * (2 ** exponent) / (8 * (2 ** sew))
        vector_sew_encoding(decoded.sew) ~is sew
        vector_lmul_encoding(decoded.lmul) ~is lm
for (instruction in VectorInitialInstructions):
  check:
    VectorInitial.matching(instruction.encoding.value) === instruction ~is #true
