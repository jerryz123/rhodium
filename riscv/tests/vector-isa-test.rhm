  VNCLIP_WI.encode([vd.constrain(1), vs2.constrain(2), vm.constrain(1)], ~immediate: 31) ~is 0xbe2fb0d7
  VSMUL_VV.encode([vd.constrain(1), vs2.constrain(2), vs1.constrain(3), vm.constrain(1)]) ~is 0x9e2180d7
  VSMUL_VX.encode([vd.constrain(1), vs2.constrain(2), model.rs1.constrain(3), vm.constrain(1)]) ~is 0x9e21c0d7
  VMACC_VV.encode([vd.constrain(1), vs2.constrain(2), vs1.constrain(3), vm.constrain(1)]) ~is 0xb621a0d7
  VMACC_VX.encode([vd.constrain(1), vs2.constrain(2), model.rs1.constrain(3), vm.constrain(1)]) ~is 0xb621e0d7
  VNMSAC_VV.encode([vd.constrain(1), vs2.constrain(2), vs1.constrain(3), vm.constrain(1)]) ~is 0xbe21a0d7
  VNMSAC_VX.encode([vd.constrain(1), vs2.constrain(2), model.rs1.constrain(3), vm.constrain(1)]) ~is 0xbe21e0d7
  VMADD_VV.encode([vd.constrain(1), vs2.constrain(2), vs1.constrain(3), vm.constrain(1)]) ~is 0xa621a0d7
  VMADD_VX.encode([vd.constrain(1), vs2.constrain(2), model.rs1.constrain(3), vm.constrain(1)]) ~is 0xa621e0d7
  VNMSUB_VV.encode([vd.constrain(1), vs2.constrain(2), vs1.constrain(3), vm.constrain(1)]) ~is 0xae21a0d7
  VNMSUB_VX.encode([vd.constrain(1), vs2.constrain(2), model.rs1.constrain(3), vm.constrain(1)]) ~is 0xae21e0d7
  VWMULU_VV.encode([vd.constrain(1), vs2.constrain(2), vs1.constrain(3), vm.constrain(1)]) ~is 0xe221a0d7
  VWMULU_VX.encode([vd.constrain(1), vs2.constrain(2), model.rs1.constrain(3), vm.constrain(1)]) ~is 0xe221e0d7
  VWMULSU_VV.encode([vd.constrain(1), vs2.constrain(2), vs1.constrain(3), vm.constrain(1)]) ~is 0xea21a0d7
  VWMULSU_VX.encode([vd.constrain(1), vs2.constrain(2), model.rs1.constrain(3), vm.constrain(1)]) ~is 0xea21e0d7
  VWMUL_VV.encode([vd.constrain(1), vs2.constrain(2), vs1.constrain(3), vm.constrain(1)]) ~is 0xee21a0d7
  VWMUL_VX.encode([vd.constrain(1), vs2.constrain(2), model.rs1.constrain(3), vm.constrain(1)]) ~is 0xee21e0d7
  VWMACCU_VV.encode([vd.constrain(1), vs2.constrain(2), vs1.constrain(3), vm.constrain(1)]) ~is 0xf221a0d7
  VWMACCU_VX.encode([vd.constrain(1), vs2.constrain(2), model.rs1.constrain(3), vm.constrain(1)]) ~is 0xf221e0d7
  VWMACC_VV.encode([vd.constrain(1), vs2.constrain(2), vs1.constrain(3), vm.constrain(1)]) ~is 0xf621a0d7
  VWMACC_VX.encode([vd.constrain(1), vs2.constrain(2), model.rs1.constrain(3), vm.constrain(1)]) ~is 0xf621e0d7
  VWMACCSU_VV.encode([vd.constrain(1), vs2.constrain(2), vs1.constrain(3), vm.constrain(1)]) ~is 0xfe21a0d7
  VWMACCSU_VX.encode([vd.constrain(1), vs2.constrain(2), model.rs1.constrain(3), vm.constrain(1)]) ~is 0xfe21e0d7
  VWMACCUS_VX.encode([vd.constrain(1), vs2.constrain(2), model.rs1.constrain(3), vm.constrain(1)]) ~is 0xfa21e0d7
  VADD_VI.encode([vd.constrain(1), vs2.constrain(2), vm.constrain(1)], ~immediate: -1) ~is 0x022fb0d7
  VSLL_VI.encode([vd.constrain(1), vs2.constrain(2), vm.constrain(1)], ~immediate: 31) ~is 0x962fb0d7
  VSLL_VI.encode([vd.constrain(1), vs2.constrain(2), vm.constrain(1)], ~immediate: -1) ~throws ""
  VNSRL_WI.encode([vd.constrain(1), vs2.constrain(2), vm.constrain(1)], ~immediate: 32) ~throws ""
  VSSRL_VI.encode([vd.constrain(1), vs2.constrain(2), vm.constrain(1)], ~immediate: 32) ~throws ""
  VNCLIP_WI.encode([vd.constrain(1), vs2.constrain(2), vm.constrain(1)], ~immediate: 32) ~throws ""
  VLE8_V.encode([vd.constrain(1), model.rs1.constrain(2), vm.constrain(1)]) ~is 0x02010087
  VLE16_V.encode([vd.constrain(1), model.rs1.constrain(2), vm.constrain(1)]) ~is 0x02015087
  VSE64_V.encode([vs3.constrain(3), model.rs1.constrain(2), vm.constrain(0)]) ~is 0x000171a7
  VectorLoadFormat.operands.map(fun (operand): operand.bank) ~is [model.RegisterBank.Vector, model.RegisterBank.Integer]
  VectorStoreFormat.operands.map(fun (operand): operand.role) ~is ["source", "source"]
  VectorVVFormat.operands.map(fun (operand): operand.bank) ~is [model.RegisterBank.Vector, model.RegisterBank.Vector, model.RegisterBank.Vector]
  [CsrId.Vstart, CsrId.Vxsat, CsrId.Vxrm, CsrId.Vcsr, CsrId.Vl, CsrId.Vtype, CsrId.Vlenb].map(csr_address) ~is [8, 9, 10, 15, 0xc20, 0xc21, 0xc22]

for (instruction in VectorIntegerReductionInstructions, index in 0..8):
  check:
    instruction.encode([vd.constrain(1), vs2.constrain(2), vs1.constrain(3), vm.constrain(1)]) ~is (0x0221a0d7 bits.or (index bits.(<<) 26))
for (instruction in VectorMaskLogicInstructions, index in 0..8):
  check:
    instruction.encode([vd.constrain(1), vs2.constrain(2), vs1.constrain(3)]) ~is (0x6221a0d7 bits.or (index bits.(<<) 26))
    VectorInitial.matching(instruction.encoding.value bits.xor (1 bits.(<<) 25)) ~is #false

for (vlen in [128, 256, 512, 65536]):
  for (encoding in 0..512):
    def sew = bits.field(encoding, 3, 6)
    def lm = bits.field(encoding, 0, 3)
    def exponent = if lm >= 4 | lm - 8 | lm
    def legal = encoding < 256 && sew <= 3 && lm != 4 && sew <= exponent + 3
    def decoded = vector_vtype_config(vlen, encoding)
    check:
      (decoded != #false) ~is legal
    when decoded
    | check:
        decoded.vlmax ~is vlen * (2 ** exponent) / (8 * (2 ** sew))
        vector_sew_encoding(decoded.sew) ~is sew
        vector_lmul_encoding(decoded.lmul) ~is lm
for (instruction in VectorInitialInstructions):
  check:
    VectorInitial.matching(instruction.encoding.value) === instruction ~is #true
