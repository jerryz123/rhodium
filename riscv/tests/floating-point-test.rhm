#lang rhombus
// Checks reusable RISC-V floating-point policy helpers, including Zfa constants.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../hardfloat/main.rhdl" open
  "../rtl/floating-point.rhdl" open

def half = riscv_float_immediate_values(FloatFormat.F16)
def single = riscv_float_immediate_values(FloatFormat.F32)
def double = riscv_float_immediate_values(FloatFormat.F64)

check:
  half.length() ~is 32
  single.length() ~is 32
  double.length() ~is 32
  half[0] ~is 0xbc00
  single[0] ~is 0xbf800000
  double[0] ~is 0xbff0000000000000
  half[1] ~is 0x0400
  single[1] ~is 0x00800000
  double[1] ~is 0x0010000000000000
  half[2] ~is 0x0100
  half[3] ~is 0x0200
  half[29] ~is 0x7c00
  single[29] ~is 0x47800000
  double[29] ~is 0x40f0000000000000
  half[30] ~is 0x7c00
  single[30] ~is 0x7f800000
  double[30] ~is 0x7ff0000000000000
  half[31] ~is 0x7e00
  single[31] ~is 0x7fc00000
  double[31] ~is 0x7ff8000000000000
