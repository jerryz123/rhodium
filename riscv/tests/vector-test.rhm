#lang rhombus
// Checks architectural vector profiles, fractional groups, bit positions, and data overlap.
// SPDX-License-Identifier: Apache-2.0

import:
  "../isa/vector.rhm" open
  "../isa/vector-profile.rhm" open

def zvfhmin = vector_extensions(VectorExtension.Zvfhmin)
def zvfh = vector_extensions(VectorExtension.Zvfh)
def zvbb = vector_extensions(VectorExtension.Zvbb)

check:
  vector_profile_isa_extensions(VectorProfile.Zve32x, 64) ~is ["zve32x", "zvl32b", "zvl64b"]
  vector_profile_isa_extensions(VectorProfile.V, 64) ~throws "VLEN"
  vector_profile_isa_extensions(VectorProfile.V, 128, zvfhmin).contains("zvfhmin") ~is #true
  vector_profile_isa_extensions(VectorProfile.Zve32f, 128, zvfhmin).contains("zvfhmin") ~is #true
  vector_profile_isa_extensions(VectorProfile.V, 128).contains("zvfhmin") ~is #false
  validate_vector_extensions(VectorProfile.Zve32x, zvfhmin) ~throws ""
  validate_vector_extensions(VectorProfile.None, zvfhmin) ~throws ""
  vector_extensions(VectorExtension.Zvfhmin, VectorExtension.Zvfhmin) ~throws ""
  vector_profile_isa_extensions(VectorProfile.V, 128, zvfh).contains("zvfh") ~is #true
  vector_profile_isa_extensions(VectorProfile.V, 128, zvfh).contains("zvfhmin") ~is #false
  vector_extensions_support_zvfhmin(zvfh) ~is #true
  vector_extensions_support_zvfh(zvfh) ~is #true
  validate_vector_extensions(VectorProfile.Zve32x, zvfh) ~throws ""
  vector_profile_isa_extensions(VectorProfile.V, 128).contains("zvl32b") ~is #true
  vector_profile_isa_extensions(VectorProfile.V, 128).contains("zvl64b") ~is #true
  vector_profile_isa_extensions(VectorProfile.V, 128).contains("zvl128b") ~is #true
  vector_profile_isa_extensions(VectorProfile.V, 128).contains("zvl256b") ~is #false
  vector_profile_isa_extensions(VectorProfile.V, 256).contains("zvl256b") ~is #true
  vector_profile_isa_extensions(VectorProfile.V, 128, zvbb).contains("zvkb") ~is #true
  vector_profile_isa_extensions(VectorProfile.V, 128, zvbb).contains("zvbb") ~is #true
  vector_profile_isa_extensions(VectorProfile.Zve32x, 128, zvbb).contains("zvbb") ~is #true
  vector_extensions_support_zvbb(zvbb) ~is #true
  validate_vector_extensions(VectorProfile.None, zvbb) ~throws ""

for (vlen in [64, 128, 256, 512, 1024, 65536]):
  for (sew in VectorElementWidths):
    for (lmul in VectorRegisterGroups):
      when vector_element_bits(sew) <= 64 * vector_lmul(lmul)
      | block:
          def config = VectorConfig(vlen, sew, lmul)
          check:
            config.vlmax * config.element_bits ~is vlen * vector_lmul(lmul)
            config.select_vl(0) ~is 0
            config.select_vl(config.vlmax + 7) ~is config.vlmax
            config.select_vl(config.vlmax div 2) ~is config.vlmax div 2
            config.active(0, config.vlmax, 0, #true) ~is #true
            config.active(config.vlmax, config.vlmax, 0, #true) ~is #false
            config.active(0, config.vlmax, 1, #true) ~is #false
            config.active(0, config.vlmax, 0, #false) ~is #false
          for (base in 0..32):
            check: config.legal_group(base) ~is (base mod config.registers == 0 && base + config.registers <= 32)
            when config.legal_group(base)
            | block:
                for (element in [0, config.vlmax - 1]):
                  check:
                    config.bit_offset(base, element) ~is base * vlen + element * config.element_bits

def narrow = VectorConfig(256, VectorSEW.E8, VectorLMUL.M1)
def wide = narrow.with_eew(VectorSEW.E16)
check:
  wide.vlmax ~is narrow.vlmax
  wide.lmul ~is VectorLMUL.M2
  vector_data_overlap_legal(narrow, 3, wide, 2) ~is #true
  vector_data_overlap_legal(narrow, 2, wide, 2) ~is #false
  vector_data_overlap_legal(wide, 2, narrow, 2) ~is #true
  vector_data_overlap_legal(wide, 2, narrow, 3) ~is #false
  vector_data_overlap_legal(narrow, 2, narrow, 2) ~is #true
  vector_data_overlap_legal(narrow, 2, wide, 4) ~is #true
  vector_data_overlap_legal(VectorConfig(256, VectorSEW.E8, VectorLMUL.MF2), 2, VectorConfig(256, VectorSEW.E16, VectorLMUL.M1), 2) ~is #false
  VectorConfig(192, VectorSEW.E8, VectorLMUL.M1) ~throws ""
  VectorConfig(128, VectorSEW.E64, VectorLMUL.MF2) ~throws ""
  wide.bit_offset(1, 0) ~throws ""
  narrow.bit_offset(31, narrow.vlmax) ~throws ""
  narrow.active(0, narrow.vlmax + 1, 0, #true) ~throws ""
  VectorConfig(128, VectorSEW.E8, VectorLMUL.M8).with_eew(VectorSEW.E16) ~throws ""
