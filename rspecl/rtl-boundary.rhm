#lang rhombus/and_meta
/* Detaches scalar and interface-member samples from an elaborated circuit for RSPECL. */
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/meta open
  lib("rhodium/core/ir.rhm").Module
  lib("rhodium/core/types.rhm") as hw
  lib("rhodium/frontend/kernel.rhm").CircuitIdentity
  lib("rhodium/frontend/kernel.rhm").checked_circuit_parameters
  lib("rhodium/frontend/foundation.rhm").Bool
  lib("rhodium/frontend/layers/interface.rhm") as iface
  lib("rhodium/formal/port-types.rhm") open
  lib("rhodium/formal/spec.rhm").input_ref
  lib("rhodium/formal/spec.rhm").SpecExpr
  lib("rhodium/formal/fifo-view.rhm").make_fifo_view

export declared_ports interface_prefixes Endpoint
export bind_fifo_view
export bind_grouped_fifo_view
export ready_valid_events

/* Flat logical field schemas and lexical views, with no RTL drivers or implementation state. */
class Boundary(ports :: SampledPorts, endpoints :: Map, arrays :: Map, parameters :: Map):
  /* A non-scalar argument is not part of the model and is only diagnosed if referenced. */
  method parameter(name :: String):
    unless parameters.has_key(name) | error("not an integer or Boolean RTL parameter: " ++ name)
    parameters[name]

/* A lexical group retains its elaborated name; cycle expressions can read only its inputs. */
class Group(name :: String, inputs :: Map)

/* Read an input member without accidentally exposing the group's metadata as a port. */
fun group_input(group :: Group, key :: String): group.inputs[key]

annot.macro 'Endpoint':
  annot_meta.pack_predicate('fun (v): v is_a Group', '(($(statinfo_meta.dot_provider_key), endpoint_dot))')
dot.macro 'endpoint_dot $left $dot $right':
  'group_input($left, $(right.to_source_string()))'

/* Resolve group array indices once for both lexical references and netlist cuts. */
fun group_prefixes(top :: Module):
  def prefixes = MutableMap{}
  for (array in iface.module_interface_array_groups(top)):
    for (g in array.groups, i in 0..array.groups.length()):
      prefixes[g.name] := array.name ++ "[" ++ to_string(i) ++ "]"
  prefixes.snapshot()

/* Map each physical directional record to its public interface or indexed lane name. */
fun interface_prefixes(top :: Module):
  def prefixes = group_prefixes(top)
  def physical = MutableMap{}
  for (g in iface.module_interface_groups(top)):
    for (b in g.bindings): physical[b.port_name] := prefixes.get(g.name, g.name)
  physical.snapshot()

/* Split directional records using their real group bindings, not a physical-port naming convention. */
fun declared_ports(top :: Module, family :: CircuitIdentity, synchronous :: Boolean):
  def parameters = checked_circuit_parameters(top, family)
  def ins = MutableMap{}
  def outs = MutableMap{}
  def endpoints = MutableMap{}
  def arrays = MutableMap{}
  def covered = MutableSet{}
  def prefixes = group_prefixes(top)
  def array_groups = iface.module_interface_array_groups(top)
  for (g in iface.module_interface_groups(top)):
    def prefix = prefixes.get(g.name, g.name)
    def members = MutableMap{}
    for (b in g.bindings):
      def input = b.direction.from_role != g.role
      def p = if input | top.find_input(b.port_name) | top.find_output(b.port_name)
      unless p && hw.type_equal(p.type, b.direction.type) && !(b.port_name in covered)
      | error("invalid interface binding: " ++ b.port_name)
      covered.add(b.port_name)
      for (f in b.direction.type.fields):
        def key = prefix ++ "." ++ f.name
        def sort = sampled_type(f.type, Bool)
        if input
        | block:
            ins[key] := sort
            members[f.name] := input_ref(key, sort)
        | outs[key] := sort
    endpoints[prefix] := Group(prefix, members.snapshot())
  for (a in array_groups):
    arrays[a.name] := a.groups.map(fun (g): endpoints[prefixes[g.name]])
  for (p in top.inputs ++ top.outputs):
    unless p.name in covered
    | cond
      | hw.clock_type(p.type):
          unless synchronous && p.name == "clock" && p.direction == "input"
          | error("unsupported clock on sampled boundary: " ++ p.name)
      | p.direction == "input": ins[p.name] := sampled_type(p.type, Bool)
      | ~else: outs[p.name] := sampled_type(p.type, Bool)
  Boundary(SampledPorts(ins.snapshot(), outs.snapshot()), endpoints.snapshot(), arrays.snapshot(), parameters)

/* Require the named RTL family before handing its actual scalar ports to the transaction binder. */
fun bind_fifo_view(top :: Module, family :: CircuitIdentity, synchronous :: Boolean, names :: List.of(String)):
  checked_circuit_parameters(top, family)
  unless synchronous | error("expected a synchronous FIFO")
  let [rst, iv, ir, iw, ov, or_pin, ow] = names
  make_fifo_view(top, rst, [[iv, ir, iw]], [ov, or_pin, ow], Bool)

/* Resolve a single ingress or a two-lane ingress array and one egress from declared groups. */
fun bind_grouped_fifo_view(top :: Module, family :: CircuitIdentity, synchronous :: Boolean,
                           reset :: String, incoming :: String, outgoing :: String):
  def bound = declared_ports(top, family, synchronous)
  unless synchronous && (bound.endpoints.has_key(incoming) || bound.arrays.has_key(incoming))
         && bound.endpoints.has_key(outgoing)
  | error("expected two declared synchronous FIFO interface groups")
  def lanes = if bound.arrays.has_key(incoming) | bound.arrays[incoming] | bound.endpoints[incoming]
  grouped_view(top, reset, lanes, bound.endpoints[outgoing])

/* Bind the actual member roles before a sampler is used for either replay or certification. */
fun grouped_view(top :: Module, reset :: String, incoming :: Group || List.of(Group), outgoing :: Group):
  /* Project the valid/ready/payload roles of a declared group, including its physical array index. */
  fun members(group :: Group): [group.name ++ ".valid", group.name ++ ".ready", group.name ++ ".bits"]
  def lanes = if incoming is_a Group | [incoming] | incoming
  when incoming is_a List && lanes.length() != 2 | error("expected two FIFO ingress lanes")
  make_fifo_view(top, reset, lanes.map(members), members(outgoing), Bool, interface_prefixes(top))

/* An ordinary function over lexical endpoints. Its result binds one checked sampler for both
   cycle events and passive replay; it neither chooses a winner nor supplies proof evidence. */
fun ready_valid_events(reset :: SpecExpr, incoming :: Group || List.of(Group), outgoing :: Group):
  unless reset.op == "input" | error("expected a sampled reset input")
  fun (top :: Module): grouped_view(top, reset.datum, incoming, outgoing)
