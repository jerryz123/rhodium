#lang rhombus/and_meta
/* Detaches scalar and interface-member samples from an elaborated circuit for RSPECL. */
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/meta open
  lib("rhodium/core/ir.rhm").Module
  lib("rhodium/core/types.rhm") as hw
  lib("rhodium/frontend/kernel.rhm").CircuitIdentity
  lib("rhodium/frontend/kernel.rhm").checked_circuit_parameters
  lib("rhodium/frontend/foundation.rhm").Bool
  lib("rhodium/frontend/layers/interface.rhm") as iface
  lib("rhodium/formal/port-types.rhm") open
  lib("rhodium/formal/spec.rhm") open
  lib("rhodium/formal/fifo-view.rhm").make_fifo_view

export declared_ports interface_prefixes Endpoint
export ready_valid_events bind_event_source
export transaction_view check_transaction_ports transaction_parts transaction_batch_model Presence Payload
export attach_refinement refinement_parts
export combine_transactions
export:
  only_space annot: TransactionView
  rename: ScalarPins as rv_pins

/* Flat logical field schemas and lexical views, with no RTL drivers or implementation state. */
class Boundary(ports :: SampledPorts, endpoints :: Map, arrays :: Map, parameters :: Map):
  /* A non-scalar argument is not part of the model and is only diagnosed if referenced. */
  method parameter(name :: String):
    unless parameters.has_key(name) | error("not an integer or Boolean RTL parameter: " ++ name)
    parameters[name]

/* A lexical group retains its elaborated name; cycle expressions can read only its inputs. */
class Group(name :: String, inputs :: Map)

/* Explicit (valid, ready, payload) roles for three physical scalar ports, resolved at binding. */
class ScalarPins(valid :: String, ready :: String, payload :: String)

annot.macro 'ReadyValidEndpoint': 'Group || ScalarPins'

/* Read an input member without accidentally exposing the group's metadata as a port. */
fun group_input(group :: Group, key :: String): group.inputs[key]

annot.macro 'Endpoint':
  annot_meta.pack_predicate('fun (v): v is_a Group', '(($(statinfo_meta.dot_provider_key), endpoint_dot))')
dot.macro 'endpoint_dot $left $dot $right':
  'group_input($left, $(right.to_source_string()))'

/* Resolve group array indices once for both lexical references and netlist cuts. */
fun group_prefixes(top :: Module):
  def prefixes = MutableMap{}
  for (array in iface.module_interface_array_groups(top)):
    for (g in array.groups, i in 0..array.groups.length()):
      prefixes[g.name] := array.name ++ "[" ++ to_string(i) ++ "]"
  prefixes.snapshot()

/* Map each physical directional record to its public interface or indexed lane name. */
fun interface_prefixes(top :: Module):
  def prefixes = group_prefixes(top)
  def physical = MutableMap{}
  for (g in iface.module_interface_groups(top)):
    for (b in g.bindings): physical[b.port_name] := prefixes.get(g.name, g.name)
  physical.snapshot()

/* Split directional records using their real group bindings, not a physical-port naming convention. */
fun declared_ports(top :: Module, family :: CircuitIdentity, synchronous :: Boolean):
  def parameters = checked_circuit_parameters(top, family)
  def ins = MutableMap{}
  def outs = MutableMap{}
  def endpoints = MutableMap{}
  def arrays = MutableMap{}
  def covered = MutableSet{}
  def prefixes = group_prefixes(top)
  def array_groups = iface.module_interface_array_groups(top)
  for (g in iface.module_interface_groups(top)):
    def prefix = prefixes.get(g.name, g.name)
    def members = MutableMap{}
    for (b in g.bindings):
      def input = b.direction.from_role != g.role
      def p = if input | top.find_input(b.port_name) | top.find_output(b.port_name)
      unless p && hw.type_equal(p.type, b.direction.type) && !(b.port_name in covered)
      | error("invalid interface binding: " ++ b.port_name)
      covered.add(b.port_name)
      for (f in b.direction.type.fields):
        def key = prefix ++ "." ++ f.name
        def sort = sampled_type(f.type, Bool)
        if input
        | block:
            ins[key] := sort
            members[f.name] := input_ref(key, sort)
        | outs[key] := sort
    endpoints[prefix] := Group(prefix, members.snapshot())
  for (a in array_groups):
    arrays[a.name] := a.groups.map(fun (g): endpoints[prefixes[g.name]])
  for (p in top.inputs ++ top.outputs):
    unless p.name in covered
    | cond
      | hw.clock_type(p.type):
          unless synchronous && p.name == "clock" && p.direction == "input"
          | error("unsupported clock on sampled boundary: " ++ p.name)
      | p.direction == "input": ins[p.name] := sampled_type(p.type, Bool)
      | ~else: outs[p.name] := sampled_type(p.type, Bool)
  Boundary(SampledPorts(ins.snapshot(), outs.snapshot()), endpoints.snapshot(), arrays.snapshot(), parameters)

/* Keep group provenance; explicit descriptors may name only real scalar pins, not flattened aliases. */
fun endpoint_members(top :: Module, endpoint :: ReadyValidEndpoint):
  match endpoint
  | Group(name, _): [name ++ ".valid", name ++ ".ready", name ++ ".bits"]
  | ScalarPins(v, r, w):
      def names = [v, r, w]
      for (name in names):
        def port = top.find_input(name) || top.find_output(name)
        unless port && !hw.record_type(port.type) && !hw.vector_type(port.type)
        | error("expected a physical scalar port: " ++ name)
      names

/* An ordinary function over lexical endpoints. Its result binds one checked sampler for both
   cycle events and passive replay; it neither chooses a winner nor supplies proof evidence. */
fun ready_valid_events(reset :: SpecExpr, incoming :: ReadyValidEndpoint || List.of(ReadyValidEndpoint),
                       outgoing :: ReadyValidEndpoint):
  unless reset.op == "input" | error("expected a sampled reset input")
  def lanes = if incoming is_a List | incoming | [incoming]
  when incoming is_a List && lanes.length() != 2 | error("expected two FIFO ingress lanes")
  fun (top :: Module):
    make_fifo_view(top, reset.datum, lanes.map(fun (lane): endpoint_members(top, lane)),
                   endpoint_members(top, outgoing), Bool, interface_prefixes(top))

/* An ordinary helper may close over a view. Do not let it substitute a different elaborated top. */
fun bind_event_source(source :: Function.of_arity(1), top :: Module):
  def view = source(top)
  unless view.top === top | error("event view does not match the elaborated top")
  view

/* Bind a Boolean batch field to event presence, regardless of the event's payload. */
class Presence(event :: String)

/* Bind an event value to a batch field; its care must equal the named presence field on every edge. */
class Payload(event :: String, gate :: String)

/* Compile a total, dense monitor input record from sparse sampler events. Absent data is padding,
   not a transfer. Keep the original events so their own definedness is also checked. */
fun project_batch(sampler :: LeafModel, schema :: Map, bindings :: Map):
  unless sampler.state.length() == 0 && sampler.assumptions.length() == 0 && sampler.outputs.length() == 0
  | error("expected an unconditional stateless event sampler")
  unless schema.keys().sort() == bindings.keys().sort() | error("bind every monitor batch field or none")
  /* Resolve names when constructing the projection, even if the event never fires. */
  fun event(name :: String) :: Observed:
    unless sampler.events.has_key(name) | error("unknown sampled event: " ++ name)
    sampler.events[name]
  def outputs = for Map ((name, source) in bindings):
    def expr:
      match source
      | Presence(e): event(e).care
      | Payload(e, gate):
          unless bindings.has_key(gate) && bindings[gate] is_a Presence
          | error("payload requires a batch presence field: " ++ gate)
          def care = event(bindings[gate].event).care
          def field = event(e)
          def sort = field.value.type
          def padding:
            cond
            | sort is_a SpecBool: #false
            | sort is_a SpecBits: 0
            | ~else: []
          def paired = choose_if(care, field.care, bool_not(field.care))
          guard_sample(paired, choose_if(care, field.value, literal(sort, padding)), name)
    unless spec_type_equal(schema[name], expr.type) | error("batch field type mismatch: " ++ name)
    values(name, Observed(expr))
  make_spec(sampler.inputs, {}, {}, outputs, sampler.events, {})

/* An unproved view retains the canonical projection alongside its sampler and independent history monitor. */
class TransactionView(sampler :: LeafModel, monitor :: LeafModel, cycle_names :: List.of(String), inputs :: Map,
                      outputs :: Map, bindings :: Map, hints :: maybe(PairList) = #false):
  field batch = if bindings.length() > 0 | project_batch(sampler, monitor.inputs, bindings) | #false

/* Attach data, never a proof callback. The relation model can mention only child and register state;
   pin-dependent checks and coverage live in a different model that cannot constrain induction. */
fun attach_refinement(view :: TransactionView, sites :: PairList, cuts :: Map, relation :: LeafModel, checks :: LeafModel):
  unless view.batch && !view.hints | error("refinement requires one bound transaction monitor")
  unless view.monitor.outputs.has_key("allowed") | error("monitor requires an allowed verdict")
  unless relation.outputs.keys().sort() == view.monitor.state.keys().sort()
  | error("relate every monitor state field exactly once")
  for ((k, f) in relation.outputs):
    unless spec_type_equal(f.value.type, view.monitor.state[k]) | error("relation type mismatch: " ++ k)
  for ((k, t) in relation.inputs):
    when k.starts_with("history.")
    | block:
        let [_, site, field] = k.split(".")
        def cut = cuts[site]
        unless cut is_a TransactionView && cut.monitor.state.has_key(field) && spec_type_equal(t, cut.monitor.state[field])
        | error("unknown or mistyped child monitor state: " ++ field)
  for (table in [view.monitor.outputs, relation.events, checks.outputs, checks.events]):
    for ((name, f) in table):
      unless f.value.type is_a SpecBool | error("expected Boolean refinement predicate: " ++ name)
  TransactionView(view.sampler, view.monitor, view.cycle_names, view.inputs, view.outputs, view.bindings,
                  PairList[sites, cuts, spec_snapshot(relation), spec_snapshot(checks)])

/* Read only the checked hint schemas and expressions; this is not reusable evidence. */
fun refinement_parts(view :: TransactionView):
  view.hints || error("transaction view has no refinement block")

/* Conjoin public behaviors on one flat event vocabulary, without carrying either one's implementation
   hints. Shared pin and event definitions must agree; histories and named guarantees have one owner. */
fun combine_transactions(left :: TransactionView, right :: TransactionView):
  for (v in [left, right]):
    unless v.batch && v.monitor.assumptions.length() == 0 && v.monitor.events.length() == 0
    | error("expected an unconditional, bound public monitor")
  /* Never silently choose between conflicting event definitions or variable owners. */
  fun compatible(a :: Map, b :: Map, agrees :: Function.of_arity(2)):
    for ((name, x) in a):
      when b.has_key(name) && !agrees(x, b[name]) | error("conflicting public field: " ++ name)
  /* Reject overlapping names when no merge is meaningful. */
  fun disjoint(a :: Map, b :: Map): compatible(a, b, fun (x, y): #false)
  disjoint(left.inputs, right.outputs)
  disjoint(left.outputs, right.inputs)
  compatible(left.inputs, right.inputs, spec_type_equal)
  compatible(left.outputs, right.outputs, spec_type_equal)
  def a = left.monitor
  def b = right.monitor
  disjoint(a.state, b.state)
  compatible(a.inputs, b.inputs, spec_type_equal)
  def ao = a.outputs.remove("allowed")
  def bo = b.outputs.remove("allowed")
  disjoint(ao, bo)
  def equal = fun (x, y): x == y
  compatible(spec_snapshot(left.sampler)["events"], spec_snapshot(right.sampler)["events"], equal)
  compatible(spec_snapshot(left.batch)["outputs"], spec_snapshot(right.batch)["outputs"], equal)
  /* A hidden verdict cannot authorize the other monitor's update. */
  fun accepts(m :: LeafModel):
    def v = m.outputs["allowed"]
    bool_and(v.care, v.value)
  def allowed = bool_and(accepts(a), accepts(b))
  def state = a.state ++ b.state
  def updates = for Map ((name, rhs) in a.updates ++ b.updates):
    values(name, choose_if(allowed, rhs, state_ref(name, state[name])))
  def model = make_spec(a.inputs ++ b.inputs, state, a.initial ++ b.initial,
                        ao ++ bo ++ {"allowed": Observed(allowed)}, {}, updates)
  def inputs = left.inputs ++ right.inputs
  def outputs = left.outputs ++ right.outputs
  def sampler = make_spec(inputs ++ outputs, {}, {}, {}, left.sampler.events ++ right.sampler.events, {})
  def names = left.cycle_names ++ right.cycle_names.filter(~keep: fun (n): !(n in left.cycle_names))
  TransactionView(sampler, model, names, inputs, outputs, left.bindings ++ right.bindings)

/* Return the executable pin-to-batch model. Applying the same bindings to a candidate sampler
   is useful for differential checking; neither operation issues or alters proof evidence. */
fun transaction_batch_model(view :: TransactionView, candidate :: maybe(LeafModel) = #false):
  unless view.batch | error("transaction view has no batch bindings")
  if candidate | project_batch(candidate, view.monitor.inputs, view.bindings) | view.batch

/* Collect just the physical pins used by an ordinary event helper. Repeated reads share a direction and sort. */
fun transaction_view(monitor :: LeafModel, cycle_names :: List.of(String), build :: Function.of_arity(2),
                     ~bindings: bindings :: Map = {}):
  def ins = MutableMap{}
  def outs = MutableMap{}
  /* Record a directional reference for validation against the elaborated signature. */
  fun reader(own :: MutableMap, other :: MutableMap):
    fun (name :: String, sort :: SpecBool || SpecBits):
      when other.has_key(name) || (own.has_key(name) && !spec_type_equal(own[name], sort))
      | error("inconsistent transaction pin: " ++ name)
      own[name] := sort
      input_ref(name, sort)
  def events = build(reader(ins, outs), reader(outs, ins))
  def pins = ins.snapshot() ++ outs.snapshot()
  def sampler = make_spec(pins, {}, {}, {}, events, {})
  def published = for Set (name in cycle_names):
    unless events.has_key(name) | error("unknown published transaction event: " ++ name)
    name
  unless published.length() == cycle_names.length() | error("duplicate published transaction event")
  TransactionView(sampler, monitor, cycle_names, ins.snapshot(), outs.snapshot(), bindings)

/* Binding a cycle model cannot silently reverse an input and an output of identical width. */
fun check_transaction_ports(view :: TransactionView, ports :: SampledPorts):
  for (used in [view.inputs, view.outputs], actual in [ports.inputs, ports.outputs]):
    for ((name, sort) in used):
      unless actual.has_key(name) && spec_type_equal(actual[name], sort)
      | error("transaction pin direction or type mismatch: " ++ name)
  view

/* Expose the two executable models and directional pin lists, not evidence of implementation correctness. */
fun transaction_parts(view :: TransactionView):
  values(view.sampler, view.monitor, PairList[& view.inputs.keys()], PairList[& view.outputs.keys()])
