#lang rspecl
/* Checks one independently retired copy per recipient, without prescribing ready timing. */
// SPDX-License-Identifier: Apache-2.0

import lib("rhodium/formal/spec.rhm").Observed
import "delivery.rspl".DeliveryLanes
export broadcast_monitor broadcast_events broadcast_contract BroadcastLanes

/* Extend the raw delivery events with the buffered contract's history and batch keys. */
class BroadcastLanes(private count :: Nat):
  extends DeliveryLanes
  /* Size the history families from the very same ports bound by the delivery sampler. */
  constructor (ports :: List.of(Endpoint)):
    super(ports)(ports.length())
  private field suffix = if count == 2 | ["l", "r"] | for List (i in 0..count): to_string(i)
  field owed = history_family(suffix.map(fun (s): "owed_" ++ s))
  field pop = suffix.map(fun (s): "pop_" ++ s)
  field out = suffix.map(fun (s): "out_" ++ s)

/* Turn the caller's handshakes into reset epochs. Do not read
   transfer pins on reset, when even valid and ready can be outside the cycle contract. */
fun broadcast_events(transfers :: Function.of_arity(2)):
  fun (read :: Function, output :: Function):
    def rst = read("reset", Bool)
    def active = for Map ((name, event) in transfers(read, output)):
      values(name, Observed(event.value, !rst && event.care))
    active ++ {"reset": Observed(const(Bool, #true), rst)}

/* Each branch has room for one outstanding word. Check retirements against the
   old copies before installing a simultaneous replacement for every recipient. */
fun broadcast_monitor(lanes :: BroadcastLanes, width :: PosInt, transfers :: Function.of_arity(2)):
  def word = Bits(width)
  def vacant = const(Seq(word, 1), [])
  monitor:
    sample broadcast_events(transfers)
    publish [reset, accepted] ++ lanes.delivery
    batch rst = present(reset)
    batch take = present(accepted)
    batch incoming: word = payload(accepted) when take
    state owed[lanes.owed]: Seq(word, 1) initially []
    let replacement = append(vacant, incoming)
    def mutable any_transfer = take
    for (i in 0..lanes.delivery.length()):
      batch pop(lanes.pop[i]) = present(lanes.delivery[i])
      batch out(lanes.out[i]): word = payload(lanes.delivery[i]) when pop
      any_transfer := any_transfer || pop
      guarantee (lanes.names[i] ++ "-delivery") = !empty(owed[i]) && bits_equal(out, front(owed[i])) when pop
      guarantee (lanes.names[i] ++ "-space") = empty(owed[i]) || pop when take
      next owed[i] = select(rst, vacant, select(take, replacement, select(pop, vacant, owed[i])))
    guarantee "quiet-reset" = !any_transfer when rst

/* Bind the same contract to an implementation's actual ready/valid groups.
   The proof driver chooses the implementation; consumers need only this declaration. */
fun bind_broadcast(ports :: Map, sample :: Function.of_arity(1)):
  def ingress :: Endpoint = ports["ingress"]
  def lanes = BroadcastLanes(ports["egress"])
  broadcast_monitor(lanes, ingress.bits.type.width, sample(lanes.transfers(ingress)))

def broadcast_contract = shared_contract(bind_broadcast)
