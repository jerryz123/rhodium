#lang rhombus/and_meta
/* Exposes lexical Rhombus and model-building operations as the solver-independent #lang rspecl. */
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus
  rhombus/meta open
  lib("rhodium/formal/spec-dsl.rhm") open
  lib("rhodium/formal/spec.rhm") as ir
  lib("rhodium/formal/port-types.rhm").check_output_types
  lib("rhodium/formal/port-types.rhm").SampledPorts
  "rtl-boundary.rhm" as boundary

export:
  all_from(rhombus)
  all_from(lib("rhodium/formal/spec-dsl.rhm")):
    except operand
  spec
  extend_leaf_transactions
  rename: monitor_view as monitor
  rename: boundary.combine_transactions as combine_transactions
  rename: boundary.shared_contract as shared_contract
  only_space annot:
    rename: boundary.Endpoint as Endpoint
  rename: boundary.ready_valid_events as ready_valid_events
  rename: boundary.rv_transfers as rv_transfers
  rename: boundary.event_family as event_family
  rename: boundary.history_family as history_family
  rename: boundary.rv_pins as rv_pins
  rename: boundary.transaction_view as transaction_view

/* Add stateless guarantees to a proved leaf's transaction interface. The extension is specialized
   on its cycle signature; the runner must prove the combined monitor from the same RTL leaf. */
fun extend_leaf_transactions(spec :: Function, extension :: Function.of_arity(1)):
  def views = WeakMutableMap.by(===){}
  /* Binding a public cut needs only the leaf's cycle signature and public monitor, not its RTL hints. */
  fun specialize(top :~ matching(_), cycle :: ir.LeafModel, base :: boundary.TransactionView):
    unless views.has_key(top)
    | block:
        def extra :: boundary.TransactionView:
          if extension is_a Function.of_arity(1, ~transaction_view)
          | extension(top, ~transaction_view: #true)
          | extension(cycle.inputs)
        unless extra.monitor.state.length() == 0 && extra.cycle_names.length() == 0
        | error("a transaction extension must preserve the leaf's cycle events and history")
        def outputs = for Map ((pin, field :: ir.Observed) in cycle.outputs): values(pin, field.value.type)
        views[top] := boundary.check_transaction_ports(boundary.combine_transactions(base, extra), SampledPorts(cycle.inputs, outputs))
    views[top]
  fun (top, ~transaction_view: tx :: Boolean = #false, ~proof_plan: plan :: Boolean = #false):
    cond
    | plan:
        let PairList["leaf", root, cycle, base, projection, hints] = spec(top, ~proof_plan: #true)
        PairList["leaf", root, cycle, specialize(top, cycle, base), projection, hints]
    | tx:
        if views.has_key(top) | views[top] | specialize(top, spec(top), spec(top, ~transaction_view: #true))
    | ~else: spec(top)

meta:
  import lib("racket/base.rkt").#{syntax-local-context} as expansion_context

/* A module declaration publishes its constructor. An interactive declaration has no module exports. */
decl.macro 'spec for $prefix ... . $(name :: Identifier): $line; ...':
  def build = 'define_spec $prefix ... . $name: $line; ...'
  if expansion_context() == #'module
  | '«$build; export $name»'
  | build

/* In a definition body the same constructor is local, including when it shadows a module spec. */
defn.macro 'spec for $prefix ... . $(name :: Identifier): $line; ...':
  'define_spec $prefix ... . $name: $line; ...'

/* Both contexts obtain the constructor name and lexical boundary from the RTL declaration. */
defn.macro 'define_spec $prefix ... . $(name :: Identifier): $line; ...':
  '$prefix ... . $(name) . describe_boundary declared_spec $name: $line; ...'

meta:
  /* Only external declaration names are strings; expression identifiers remain lexical syntax. */
  fun field_name(stx :: Syntax):
    match stx
    | '$(a :: Identifier)': to_string(a.unwrap())
    | '$(a :: Identifier) . $(b :: Identifier)': field_name(a) ++ "." ++ field_name(b)
    | '$(a :: Identifier)[$i] . $(b :: Identifier)':
        unless i.unwrap() is_a Nat | syntax_meta.error("expected a literal nonnegative lane index", i)
        field_name(a) ++ "[" ++ to_string(i.unwrap()) ++ "]." ++ field_name(b)
    | ~else: syntax_meta.error("expected a spec field name", stx)

  /* Emit the immutable schema or view expected by the existing model constructor. */
  fun map_expr(entries :: ReadableMap):
    let [key, ...] = entries.keys()
    let [value, ...] = [entries[key], ...]
    'Map{$key: $value, ...}'

  /* In a publish list a bare name refers to the sampler, even when a local has the same name. */
  fun published_name(entry :: Syntax):
    match entry
    | '$(id :: Identifier)': '$(field_name(id))'
    | ~else: entry

  /* Split the optional care clause without inspecting either Rhombus expression. */
  fun observation(rhs :: Syntax):
    match rhs
    | '$v ... when $c ...': 'ir.Observed(operand($v ...), operand($c ...))'
    | ~else: 'ir.Observed(operand($rhs))'

  /* Inside an elaboration loop, only the array index is an expression; member names remain lexical. */
  fun iterated_path(path :: Syntax):
    match path
    | '$(a :: Identifier)[$i ...] . $(b :: Identifier)':
        'indexed_pin($(field_name(a)), ($i ...), $(field_name(b)))'
    | ~else: '$(field_name(path))'

  /* Collect repeated declarations alongside static ones without allowing a later lane to overwrite a field. */
  fun iterated_fields(label :: String, emit :: Function):
    def table = Syntax.make_temp_id(label)
    def mutable used = #false
    /* Allocate the collector only when this loop actually declares this kind of field. */
    fun put(key :: Syntax, value :: Syntax):
      unless used
      | block:
          emit('def $table = MutableMap{}')
          used := #true
      'add_field($table, $key, $value)'
    /* Keep the existing static expansion for declarations that generate no fields. */
    fun finish(fixed :: ReadableMap):
      if used | 'merge_fields($(map_expr(fixed)), $table)' | map_expr(fixed)
    values(put, finish)

  /* Preserve Rhombus iteration, local bindings and evaluation order; rewrite only declaration lines. */
  fun elaboration_loop(loop :: Syntax, translate :: Function):
    match loop
    | 'for ($(args :: Group), ...): $line; ...':
        let [lowered, ...] = for List (entry in [line, ...]):
          match entry
          | 'for ($(inner :: Group), ...): $body; ...': elaboration_loop(entry, translate)
          | ~else: translate(entry)
        'for ($args, ...): $lowered; ...'

  /* A family is an elaboration-time list of ordinary named state references, not a new IR sort. */
  fun state_families(emit :: Function):
    def values(add_state, states) = iterated_fields("states", emit)
    def values(add_initial, initial) = iterated_fields("initial", emit)
    def values(add_update, updates) = iterated_fields("updates", emit)
    /* Capture the sort and initial value once before allocating the named cells. */
    fun declare(id :: Syntax, names :: Syntax, sort :: Syntax, start :: Syntax):
      'def $id:
         def type = $sort
         def seed = $start
         for List (ref in ($names :: List)):
           def key = boundary.history_key(ref)
           $(add_state('key', 'type'))
           $(add_initial('key', 'seed'))
           ir.state_ref(key, type)'
    /* Use the selected cell's checked state key, not a new generated input. */
    fun update(ref :: Syntax, rhs :: Syntax):
      add_update('state_key($ref)', 'operand($rhs)')
    values(declare, update, states, initial, updates)

/* Only references to declared state can name a simultaneous next-state assignment. */
fun state_key(ref :: SpecExpr):
  unless ref.op == "state" | error("next requires a declared state field")
  ref.datum

/* Construct an indexed port key for subsequent checking against the actual RTL signature. */
fun indexed_pin(group :: String, index :: Nat, member :: String):
  group ++ "[" ++ to_string(index) ++ "]." ++ member

/* Install one generated field under a unique name, including across loop iterations. */
fun add_field(table :: MutableMap, key :: String, value :~ matching(_)):
  when key == "" || table.has_key(key) | error("empty or duplicate spec declaration: " ++ key)
  table[key] := value

/* Static and iterated declarations share the same checked namespace. */
fun merge_fields(fixed :: Map, generated :: MutableMap):
  for (key in generated.keys()):
    when fixed.has_key(key) | error("duplicate spec declaration: " ++ key)
  fixed ++ generated.snapshot()

meta:
  /* Share lexical state, initial constants and simultaneous next clauses between cycle and monitor bodies. */
  fun model_body():
    def states = MutableMap{}
    def initial = MutableMap{}
    def updates = MutableMap{}
    def mutable body = []
    /* Capture a declaration's value at its lexical site, not after later shadowing. */
    fun record(table :: MutableMap, key :: String, rhs :: Syntax, site :: Syntax):
      when table.has_key(key) | syntax_meta.error("duplicate spec declaration: " ++ key, site)
      def id = Syntax.make_temp_id(key)
      body := body ++ ['def $id = $rhs']
      table[key] := id
      id
    /* An optional lexical alias exposes the typed initial constant without implying reset. */
    fun state_clause(n :: Syntax, t :: Syntax, v :: Syntax, alias_id :: maybe(Syntax), site :: Syntax):
      def key = field_name(n)
      def type = record(states, key, t, site)
      def start = record(initial, key, v, site)
      body := body ++ ['def $n = ir.state_ref($key, $type)']
      when alias_id | body := body ++ ['def $alias_id = ir.literal($type, $start)']
    /* Leave ordinary Rhombus definitions and helper calls in their original lexical order. */
    fun model_clause(clause :: Syntax):
      match clause
      | 'state $(n :: Identifier): $t ... initially $v ... as $(id :: Identifier)':
          state_clause(n, '$t ...', '($v ...)', id, clause)
      | 'state $(n :: Identifier): $t ... initially $v ...':
          state_clause(n, '$t ...', '($v ...)', #false, clause)
      | 'next $(n :: Identifier) = $v ...':
          def key = field_name(n)
          unless states.has_key(key) | syntax_meta.error("next requires a declared state: " ++ key, n)
          record(updates, key, 'operand($v ...)', clause)
      | ~else: body := body ++ [clause]
    values(states, initial, updates, record, model_clause, fun (): body)

/* A monitor verdict is observable, not an assumption. Reject the entire batch before any update is evaluated. */
fun monitor_model(inputs :: Map, states :: Map, initial :: Map, guarantees :: Map, updates :: Map):
  when guarantees.length() == 0 || guarantees.has_key("allowed")
  | error("expected nonempty guarantees; allowed is reserved for the combined verdict")
  for (key in inputs.keys()):
    when states.has_key(key) | error("batch and state share a name: " ++ key)
  def mutable allowed = operand(#true)
  for (name in guarantees.keys().sort()):
    allowed := ir.bool_and(allowed, guarantees[name])
  def outputs = for Map ((name, predicate) in guarantees):
    values(name, ir.Observed(predicate))
  def guarded = for Map ((name, rhs) in updates):
    values(name, ir.choose_if(allowed, rhs, ir.state_ref(name, states[name])))
  ir.make_spec(inputs, states, initial, outputs ++ {"allowed": ir.Observed(allowed)}, {}, guarded)

/* A partial event decoder has two products: a total candidate batch, and a stateless
   guarantee for each domain predicate on the same pins. Never admit a child by assuming it. */
fun check_event_domains(view :: boundary.TransactionView, sampler :: ir.LeafModel, ports :: SampledPorts):
  if sampler.assumptions.length() == 0
  | view
  | block:
      def predicates = for Map ((label, p) in sampler.assumptions):
        values("@domain/" ++ label, ir.Observed(const(Bool, #true), p))
      def flags = for Map (key in predicates.keys()): values(key, Bool)
      def goals = for Map (key in predicates.keys()): values(key, ir.input_ref(key, Bool))
      def bindings = for Map (key in predicates.keys()): values(key, boundary.Presence(key))
      def checks = ir.make_spec(sampler.inputs, {}, {}, {}, predicates, {})
      def domain = boundary.transaction_view(monitor_model(flags, {}, {}, goals, {}), [],
                                             boundary.event_reader(checks, ports), ~bindings: bindings)
      boundary.combine_transactions(view, domain)

/* Compile the fixed batch vocabulary in declaration scope, independently of the cycle model's RTL pins. */
expr.macro 'monitor_view: $line; ...':
  def values(states, initial, updates, record, model_clause, declarations) = model_body()
  def inputs = MutableMap{}
  def bindings = MutableMap{}
  def guarantees = MutableMap{}
  def attachment = MutableMap{}
  def values(add_input, all_inputs) = iterated_fields("batch", model_clause)
  def values(add_binding, all_bindings) = iterated_fields("bindings", model_clause)
  def values(add_goal, all_goals) = iterated_fields("guarantees", model_clause)
  def values(declare_family, update, all_states, all_initial, all_updates) = state_families(model_clause)
  def mutable loop_goals = #false
  /* Give generated batch fields stable external names while keeping their expression bindings lexical. */
  fun monitor_line(line :: Syntax):
    match line
    | 'next $(id :: Identifier)[$i ...] = $rhs ...': update('$id[$i ...]', '($rhs ...)')
    | 'batch $(id :: Identifier)($key ...) = present($event ...)':
        def k = Syntax.make_temp_id("batch_key")
        'def $id:
           def $k = ($key ...)
           $(add_input(k, 'Bool'))
           $(add_binding(k, 'boundary.Presence(boundary.event_key($event ...))'))
           ir.input_ref($k, Bool)'
    | 'batch $(id :: Identifier)($key ...): $sort ... = payload($event ...) when $(gate :: Identifier)':
        def k = Syntax.make_temp_id("batch_key")
        def t = Syntax.make_temp_id("batch_sort")
        'def $id:
           def $k = ($key ...)
           def $t = ($sort ...)
           $(add_input(k, t))
           $(add_binding(k, 'boundary.Payload(boundary.event_key($event ...), $(gate) . datum)'))
           ir.input_ref($k, $t)'
    | 'guarantee ($label ...) = $rhs ...':
        loop_goals := #true
        def predicate:
          match '($rhs ...)':
          | '($v ... when $c ...)': 'select(($c ...), ($v ...), #true)'
          | ~else: 'operand($rhs ...)'
        add_goal('($label ...)', predicate)
    | ~else: line
  /* A batch field is one pre-edge input to the monitor, not a pin read or a history update. */
  fun batch(n :: Syntax, type :: Syntax, site :: Syntax):
    def key = field_name(n)
    def sort = record(inputs, key, type, site)
    model_clause('def $n = ir.input_ref($key, $sort)')
  for (clause in [line, ...]):
    match clause
    | 'state $(id :: Identifier)[$names ...]: $t ... initially $v ...':
        model_clause(declare_family(id, '($names ...)', '($t ...)', '($v ...)'))
    | 'for ($(args :: Group), ...): $items; ...': model_clause(elaboration_loop(clause, monitor_line))
    | 'batch $(n :: Identifier) = present($(e :: Identifier))':
        batch(n, 'Bool', clause)
        bindings[field_name(n)] := 'boundary.Presence($(field_name(e)))'
    | 'batch $(n :: Identifier): $t ... = payload($(e :: Identifier)) when $(gate :: Identifier)':
        batch(n, '($t ...)', clause)
        bindings[field_name(n)] := 'boundary.Payload($(field_name(e)), $(field_name(gate)))'
    | 'batch ($(n :: Identifier), ...): $t ...':
        for (id in [n, ...]): batch(id, '($t ...)', clause)
    | 'batch $(n :: Identifier): $t ...': batch(n, '($t ...)', clause)
    | 'guarantee $label = $rhs ...':
        def key = label.unwrap()
        unless key is_a String && key != "" | syntax_meta.error("expected a nonempty guarantee string", label)
        when key == "allowed" | syntax_meta.error("allowed is the combined monitor verdict", label)
        // A disabled guarantee passes. Its body need not be defined on that sample.
        def predicate:
          match '($rhs ...)':
          | '($v ... when $c ...)': 'select(($c ...), ($v ...), #true)'
          | ~else: 'operand($rhs ...)'
        record(guarantees, key, predicate, clause)
    | 'sample $s ...': record(attachment, "sample", '($s ...)', clause)
    | 'publish [$(entry :: Group), ...] ++ $family ...':
        let [key, ...] = [entry, ...].map(published_name)
        record(attachment, "publish", '[$key, ...] ++ ($family ...)', clause)
    | 'publish [$(entry :: Group), ...]':
        let [key, ...] = [entry, ...].map(published_name)
        record(attachment, "publish", '[$key, ...]', clause)
    | 'publish $names ...': record(attachment, "publish", '($names ...)', clause)
    | 'assume $rest ...': syntax_meta.error("a monitor judges batches with guarantees, not assumptions", clause)
    | ~else: model_clause(clause)
  unless attachment.has_key("sample") && attachment.has_key("publish") && (guarantees.length() > 0 || loop_goals)
  | syntax_meta.error("monitor requires sample, publish, and at least one guarantee", [line, ...][0])
  for (key in inputs.keys()):
    when states.has_key(key) | syntax_meta.error("batch and state share a name: " ++ key, [line, ...][0])
  let [decl, ...] = declarations()
  'block:
     $decl
     ...
     boundary.transaction_view(monitor_model($(all_inputs(inputs)), $(all_states(states)), $(all_initial(initial)),
                                             $(all_goals(guarantees)), $(all_updates(updates))),
                               ($(attachment["publish"])).map(boundary.event_key), $(attachment["sample"]), ~bindings: $(all_bindings(bindings)))'

/* Lower implementation-state hints and separate pin-dependent obligations to ordinary spec IR. */
expr.macro 'refined_view($view, $parent, $defer): $line; ...':
  def values(_, _, _, record, emit, declarations) = model_body()
  def sources = MutableMap{}
  def pins = MutableMap{}
  def relations = MutableMap{}
  def invariants = MutableMap{}
  def checks = MutableMap{}
  def covers = MutableMap{}
  def cuts = MutableMap{}
  def mutable forwarded = []
  def mutable static_sites = []
  def mutable family_sites = #false
  def values(add_source, all_sources) = iterated_fields("sources", emit)
  def values(add_relation, all_relations) = iterated_fields("relations", emit)
  def values(add_invariant, all_invariants) = iterated_fields("invariants", emit)
  def values(add_cut, all_cuts) = iterated_fields("children", emit)
  /* Read named histories and local registers at the checked cut, not from a child's RTL. */
  fun projected(line :: Syntax):
    match line
    | 'history $(id :: Identifier) from $(site :: Identifier)[$field ...]: $t ...':
        unless cuts.has_key(field_name(site)) | syntax_meta.error("history must name the declared child", site)
        projected('history $id from ($(field_name(site)), $field ...): $t ...')
    | 'history $(id :: Identifier) from ($site ..., $field ...): $t ...':
        'def $id:
           def key = "history." ++ ($site ...) ++ "." ++ boundary.history_key($field ...)
           def sort = ($t ...)
           $(add_source('key', 'sort'))
           ir.input_ref(key, sort)'
    | 'local $(id :: Identifier)($key ...): $t ...':
        'def $id:
           def field = "local." ++ ($key ...)
           def sort = ($t ...)
           $(add_source('field', 'sort'))
           ir.input_ref(field, sort)'
    | 'relate ($key ...) = $rhs ...': add_relation('boundary.history_key($key ...)', observation('$rhs ...'))
    | 'invariant ($key ...) = $rhs ...': add_invariant('($key ...)', 'ir.Observed(operand($rhs ...))')
    | ~else: line
  /* Namespace IR references by provenance; author expressions use ordinary lexical bindings. */
  fun source(n :: Syntax, sort :: Syntax, prefix :: String, table :: MutableMap, clause :: Syntax):
    def key = prefix ++ "." ++ field_name(n)
    def t = record(table, key, sort, clause)
    emit('def $n = ir.input_ref($key, $t)')
  for (clause in [line, ...]):
    match clause
    | 'for ($(args :: Group), ...): $items; ...': emit(elaboration_loop(clause, projected))
    | 'children ($keys ...): $s ...':
        family_sites := #true
        def site = Syntax.make_temp_id("site")
        emit('for ($site in ($keys ...)): $(add_cut(site, 'boundary.child_transaction($parent, $site, ($s ...), ~defer: $defer)'))')
    | 'child $(child :: Identifier): $spec ...':
        def site = field_name(child)
        record(cuts, site, 'boundary.child_transaction($parent, $site, ($spec ...), ~defer: $defer)', clause)
        static_sites := static_sites ++ [site]
    | 'forward_batch $(child :: Identifier)':
        def site = field_name(child)
        unless cuts.has_key(site) | syntax_meta.error("forward_batch must name a declared child", child)
        when site in forwarded | syntax_meta.error("duplicate forwarded batch", child)
        forwarded := forwarded ++ [site]
    | 'history $(n :: Identifier) from $(child :: Identifier) . $(field :: Identifier): $t ...':
        unless cuts.has_key(field_name(child)) | syntax_meta.error("history must name the declared child", child)
        def k = "history." ++ field_name(child) ++ "." ++ field_name(field)
        def t = record(sources, k, '($t ...)', clause)
        emit('def $n = ir.input_ref($k, $t)')
    | 'history $(n :: Identifier) from $(child :: Identifier)[$field ...]: $t ...':
        emit(projected(clause))
    | 'local ($(n :: Identifier), ...): $t ...':
        for (id in [n, ...]): source(id, '($t ...)', "local", sources, clause)
    | 'required ($(n :: Identifier), ...): $t ...':
        for (id in [n, ...]): source(id, '($t ...)', "required", sources, clause)
    | 'input ($(n :: Identifier), ...): $t ...':
        for (id in [n, ...]): source(id, '($t ...)', "input", pins, clause)
    | 'input $(n :: Identifier) from $path ...: $t ...':
        def k = "input." ++ field_name('$path ...')
        def t = record(pins, k, '($t ...)', clause)
        emit('def $n = ir.input_ref($k, $t)')
    | 'output ($(n :: Identifier), ...): $t ...':
        for (id in [n, ...]): source(id, '($t ...)', "output", pins, clause)
    | 'output $(n :: Identifier) from $path ...: $t ...':
        def k = "output." ++ field_name('$path ...')
        def t = record(pins, k, '($t ...)', clause)
        emit('def $n = ir.input_ref($k, $t)')
    | 'batch $(n :: Identifier) from $(key :: Identifier): $t ...':
        def k = "batch." ++ field_name(key)
        def t = record(pins, k, '($t ...)', clause)
        emit('def $n = ir.input_ref($k, $t)')
    | 'relate $(n :: Identifier) = $rhs ...':
        record(relations, field_name(n), observation('$rhs ...'), clause)
    | 'invariant $(n :: Identifier) = $rhs ...':
        record(invariants, field_name(n), 'ir.Observed(operand($rhs ...))', clause)
    | 'check $(n :: Identifier) = $rhs ...':
        record(checks, field_name(n), 'ir.Observed(operand($rhs ...))', clause)
    | 'cover $(n :: Identifier) = $rhs ...':
        record(covers, field_name(n), 'ir.Observed(operand($rhs ...))', clause)
    | 'state $rest ...': syntax_meta.error("refinement reads state; declare state in the monitor", clause)
    | 'next $rest ...': syntax_meta.error("refinement has no state updates", clause)
    | 'assume $rest ...': syntax_meta.error("refinement predicates must be proved", clause)
    | ~else: emit(clause)
  let [site, ...] = static_sites
  let [forward_site, ...] = forwarded
  let [decl, ...] = declarations()
  'block:
     $decl
     ...
     def state_inputs = $(all_sources(sources))
     def rel = ir.make_spec(state_inputs, {}, {}, $(all_relations(relations)), $(all_invariants(invariants)), {})
     def edge = ir.make_spec(state_inputs ++ $(map_expr(pins)), {}, {}, $(map_expr(checks)), $(map_expr(covers)), {})
     def bindings = $(all_cuts(cuts))
     boundary.attach_refinement($view, $(if family_sites | 'PairList[& bindings.keys().sort()]' | 'PairList[$site, ...]'), bindings, rel, edge, PairList[$forward_site, ...])'

/* Compile a private abstraction at the cycle declaration's lexical site, not in the public monitor. */
expr.macro 'cycle_relation($cycle): $line; ...':
  def values(_, _, _, record, emit, declarations) = model_body()
  def relations = MutableMap{}
  def invariants = MutableMap{}
  def values(add_relation, all_relations) = iterated_fields("relations", emit)
  /* Project each named public field using the old cycle history. */
  fun project(line :: Syntax):
    match line
    | 'relate ($key ...) = $rhs ...': add_relation('boundary.history_key($key ...)', observation('$rhs ...'))
    | ~else: line
  for (clause in [line, ...]):
    match clause
    | 'for ($(args :: Group), ...): $items; ...': emit(elaboration_loop(clause, project))
    | 'relate $(n :: Identifier) = $rhs ...': record(relations, field_name(n), observation('$rhs ...'), clause)
    | 'invariant $(n :: Identifier) = $rhs ...':
        record(invariants, field_name(n), 'ir.Observed(operand($rhs ...))', clause)
    | 'state $rest ...': syntax_meta.error("declare projected state in the cycle model", clause)
    | 'next $rest ...': syntax_meta.error("a cycle projection has no updates", clause)
    | 'assume $rest ...': syntax_meta.error("cycle projection invariants must be proved", clause)
    | ~else: emit(clause)
  let [decl, ...] = declarations()
  'block:
     $decl
     ...
     ir.cycle_state_projection($cycle, $(all_relations(relations)), $(map_expr(invariants)))'

/* Read a parameter at its lexical use site so unused non-scalar arguments need no model value. */
defn.macro 'bind_parameter $id($bound, $key)':
  '«
     expr.macro '$id': '$(bound) . parameter($key)'
   »'

/* Separate register-only state projections from output care and transfers on physical pins. */
expr.macro 'rtl_relation($cycle, $ports, $sync): $line; ...':
  def values(_, _, _, record, emit, declarations) = model_body()
  def regs = MutableMap{}
  def pins = MutableMap{}
  def states = MutableMap{}
  def checks = MutableMap{}
  def cares = MutableMap{}
  def transfers = MutableMap{}
  def values(add_transfer, all_transfers) = iterated_fields("events", emit)
  def values(add_care, all_cares) = iterated_fields("cares", emit)
  def values(add_relation, all_relations) = iterated_fields("relations", emit)
  def pin_reads = Syntax.make_temp_id("pin_reads")
  def mutable reads = #false
  /* Repeated reads of the same physical pin are harmless; each read must resolve on this boundary. */
  fun physical_line(line :: Syntax):
    match line
    | 'event ($key ...) = $rhs ...': add_transfer('boundary.event_key($key ...)', observation('$rhs ...'))
    | 'relate ($key ...) = $rhs ...': add_relation('boundary.history_key($key ...)', 'ir.Observed(operand($rhs ...))')
    | 'pin $(id :: Identifier) from $path ...':
        unless reads
        | block:
            emit('def $pin_reads = MutableMap{}')
            reads := #true
        def key = iterated_path('$path ...')
        'def $id = boundary.read_physical($pin_reads, $ports, $key)'
    | 'care $path ... = $rhs ...':
        add_care(iterated_path('$path ...'), 'ir.Observed(operand($rhs ...))')
    | ~else: line
  for (line in [line, ...]):
    match line
    | 'for ($(args :: Group), ...): $items; ...': emit(elaboration_loop(line, physical_line))
    | 'register $(n :: Identifier): $t ...':
        def key = field_name(n)
        def sort = record(regs, key, '($t ...)', line)
        emit('def $n = ir.input_ref($key, $sort)')
    | 'pin $(n :: Identifier) from $path ...':
        def key = field_name('$path ...')
        def sort = record(pins, key, '($(ports) . inputs ++ $(ports) . outputs)[$key]', line)
        emit('def $n = ir.input_ref($key, $sort)')
    | 'relate $(n :: Identifier) = $rhs ...':
        record(states, field_name(n), 'ir.Observed(operand($rhs ...))', line)
    | 'invariant $(n :: Identifier) = $rhs ...':
        record(checks, field_name(n), 'ir.Observed(operand($rhs ...))', line)
    | 'care $path ... = $rhs ...':
        record(cares, field_name('$path ...'), 'ir.Observed(operand($rhs ...))', line)
    | 'event $(n :: Identifier) = $rhs ...':
        record(transfers, field_name(n), observation('$rhs ...'), line)
    | ~else: emit(line)
  let [decl, ...] = declarations()
  'block:
     $decl
     ...
     def rel = ir.make_spec($(map_expr(regs)), {}, {}, $(all_relations(states)), $(map_expr(checks)), {})
     def physical = ir.make_spec($(ports) . inputs ++ $(map_expr(pins)) ++ $(if reads | '$(pin_reads) . snapshot()' | 'Map{}'), {}, {},
                                 $(all_cares(cares)), $(all_transfers(transfers)), {})
     boundary.checked_leaf_hints($cycle, rel, physical, $sync)'

/* Build named events in lexical order using the actual boundary's pin reader. */
expr.macro 'physical_sampler($access): $line; ...':
  def values(_, _, _, record, emit, declarations) = model_body()
  def events = MutableMap{}
  def values(add_event, all_events) = iterated_fields("physical events", emit)
  def mutable generated = #false
  /* Preserve loop bindings and reject collisions even between a family and a static event. */
  fun physical_line(clause :: Syntax):
    match clause
    | 'event ($key ...) = $rhs ...':
        generated := #true
        add_event('boundary.event_key($key ...)', observation('$rhs ...'))
    | 'state $rest ...': syntax_meta.error("physical event samplers are stateless", clause)
    | 'next $rest ...': syntax_meta.error("physical event samplers are stateless", clause)
    | ~else: clause
  for (clause in [line, ...]):
    match clause
    | 'event $(id :: Identifier) = $rhs ...':
        record(events, field_name(id), observation('$rhs ...'), clause)
    | 'for ($(args :: Group), ...): $items; ...': emit(elaboration_loop(clause, physical_line))
    | ~else: emit(physical_line(clause))
  when events.length() == 0 && !generated | syntax_meta.error("physical sampler requires a named event", access)
  let [decl, ...] = declarations()
  'fun (read):
     bind_physical_accessor $access(read)
     $decl
     ...
     def sampled = $(all_events(events))
     when sampled.length() == 0 | error("physical sampler requires a named event")
     sampled'

meta:
  /* Resolve the member path, not an in-scope cycle expression with the same spelling. */
  fun physical_access(read :: Syntax, path :: Syntax):
    '$read($(iterated_path(path)))'

/* Introduce the sampler-local pin reader without adding a global reserved expression form. */
defn.macro 'bind_physical_accessor $access($read)':
  '«
     expr.macro '$access($('$')path $('...'))':
       physical_access('$read', '$('$')path $('...')')
   »'

/* Compile a circuit-bound body to typed IR; evaluate each clause at its original lexical site. */
defn.macro 'declared_spec $name($family, $sync) ($pin, ...) ($cfg, ...) ($ep, ...) ($arr, ...): $line; ...':
  let [pin_key, ...] = [pin.to_source_string(), ...]
  let [key, ...] = [cfg.to_source_string(), ...]
  let [ep_key, ...] = [ep.to_source_string(), ...]
  let [arr_key, ...] = [arr.to_source_string(), ...]
  def outputs = MutableMap{}
  def events = MutableMap{}
  def assumptions = MutableMap{}
  def mutable ignored = []
  def mutable event_source = #false
  def mutable bound_events = #false
  def mutable dimension = #false
  def mutable detached_default = #false
  def mutable transaction = #false
  def mutable refinement = #false
  def mutable forward_args = #false
  def mutable adjacent_source = #false
  def mutable premise_source = #false
  def mutable requirement = #false
  def suppliers = MutableMap{}
  def mutable projection = #false
  def mutable rtl_hint = #false
  def child_specs = MutableMap{}
  def values(states, initial, updates, record, model_clause, declarations) = model_body()
  def values(add_event, all_events) = iterated_fields("events", model_clause)
  def values(add_child, all_children) = iterated_fields("proof children", model_clause)
  def mutable child_family = #false
  def values(add_output, all_outputs) = iterated_fields("observations", model_clause)
  def values(declare_family, update, all_states, all_initial, all_updates) = state_families(model_clause)
  def mutable has_family = #false
  def mutable iterates_observations = #false
  /* Both named source forms share direction checks, event domains and specialization caching. */
  fun named_reader(reader :: Syntax, view :: Syntax, clause :: Syntax):
    when event_source | syntax_meta.error("duplicate sampled event source", clause)
    bound_events := Syntax.make_temp_id("sampled_ports")
    event_source := bound_events
    model_clause('def $bound_events = $view')
    model_clause('def $reader = boundary.event_reader($(bound_events) . sampler with (assumptions = {}), bound.ports)')
  /* Ordinary expressions stay local; either emitted events or outputs require full cycle checking. */
  fun cycle_line(line :: Syntax):
    match line
    | 'event ($key ...) = $rhs ...':
        iterates_observations := #true
        add_event('boundary.event_key($key ...)', observation('$rhs ...'))
    | 'next $(id :: Identifier)[$i ...] = $rhs ...': update('$id[$i ...]', '($rhs ...)')
    | 'observe $path ... = $rhs ...':
        iterates_observations := #true
        add_output(iterated_path('$path ...'), observation('$rhs ...'))
    | ~else: line
  def clauses = [line, ...]
  /* Distinguish a cycle spec from a monitor-only cut, independent of clause order. */
  fun has_head(entry :: Syntax, names :: Set):
    match entry
    | '$(head :: Identifier) $rest ...': field_name(head) in names
    | ~else: #false
  /* An observation inside a loop makes this a cycle model even without a static output clause. */
  fun cycle_clause(entry :: Syntax):
    match entry
    | 'for ($(args :: Group), ...): $items; ...': [items, ...].find(cycle_clause)
    | ~else: has_head(entry, {"state", "observe", "output"})
  def has_cycle = clauses.find(cycle_clause)
  for (clause in clauses):
    match clause
    | 'state $(id :: Identifier)[$names ...]: $t ... initially $v ...':
        has_family := #true
        model_clause(declare_family(id, '($names ...)', '($t ...)', '($v ...)'))
    | 'for ($(args :: Group), ...): $items; ...': model_clause(elaboration_loop(clause, cycle_line))
    | 'specialize $(id :: Identifier) = $rhs ... ~default: $v ...':
        when dimension | syntax_meta.error("duplicate monitor specialization", clause)
        dimension := id
        detached_default := '($v ...)'
        model_clause('def $id :: PosInt = ($rhs ...)')
        model_clause('def attached = dimension_view($id)')
    | 'input $n ...: $t': syntax_meta.error("inputs come from the RTL declaration", clause)
    | 'ignore $n ...': ignored := ignored ++ [field_name('$n ...')]
    | 'observe $n ... = $v ...': record(outputs, field_name('$n ...'), observation('$v ...'), clause)
    | 'output $n ... = $v ...': record(outputs, field_name('$n ...'), observation('$v ...'), clause)
    | 'event $n ... = $v ...': record(events, field_name('$n ...'), observation('$v ...'), clause)
    | 'events $(reader :: Identifier) from $(access :: Identifier): $entry; ...':
        named_reader(reader, 'bound.pin_events(physical_sampler($access): $entry; ...)', clause)
    | 'events $(reader :: Identifier) = $rhs ...':
        named_reader(reader, 'boundary.bind_event_source(($rhs ...), top)', clause)
    | 'events $rhs ...':
        when event_source | syntax_meta.error("duplicate sampled event source", clause)
        event_source := Syntax.make_temp_id("event_source")
        model_clause('def $event_source = $rhs ...')
    | 'monitor: $entry; ...':
        when transaction | syntax_meta.error("duplicate transaction view", clause)
        transaction := 'monitor_view: $entry; ...'
    | 'requires $v ...':
        when requirement | syntax_meta.error("duplicate temporal requirement", clause)
        requirement := Syntax.make_temp_id("input_requirement")
        model_clause('def $requirement = boundary.check_transaction_ports(($v ...), bound.ports)')
    | 'rtl_refinement: $entry; ...':
        when rtl_hint | syntax_meta.error("duplicate RTL refinement", clause)
        rtl_hint := Syntax.make_temp_id("rtl_relation")
        model_clause('fun $rtl_hint(cycle :: ir.LeafModel):
                        rtl_relation(cycle, bound.ports, $sync): $entry; ...')
    | 'refinement: $entry; ...':
        when refinement | syntax_meta.error("duplicate refinement block", clause)
        refinement := [entry, ...]
        for (item in refinement):
          match item
          | 'forward $(n :: Identifier): $s ...':
              unless refinement.length() == 1
              | syntax_meta.error("exact forwarding must be the only refinement clause", item)
              forward_args := [field_name(n), '($s ...)']
          | 'adjacent_samples from $s ...':
              unless refinement.length() == 1
              | syntax_meta.error("adjacent_samples must be the only refinement clause", item)
              adjacent_source := '($s ...)'
          | 'supply $(sink :: Identifier) from $(source :: Identifier)':
              def sink_name = field_name(sink)
              when suppliers.has_key(sink_name) | syntax_meta.error("duplicate supplier for " ++ sink_name, item)
              suppliers[sink_name] := field_name(source)
          | 'supply $rest ...': syntax_meta.error("expected supply <consumer> from <supplier>", item)
          | 'under $s ...':
              when premise_source | syntax_meta.error("duplicate input contract source", item)
              premise_source := '(($s ...) :: Function)'
          | 'child $(n :: Identifier): $s ...':
              def site = field_name(n)
              child_specs[site] := 'PairList[boundary.child_definition(top, $site), ($s ...)]'
          | 'children ($keys ...): $s ...':
              child_family := #true
              def site = Syntax.make_temp_id("site")
              model_clause('for ($site in ($keys ...)):
                              $(add_child(site, 'PairList[boundary.child_definition(top, $site), ($s ...)]'))')
          | ~else: #void
        for ((sink, source) in suppliers):
          unless child_specs.has_key(sink) && child_specs.has_key(source) && sink != source
          | syntax_meta.error("supply requires two distinct declared children", clause)
        refinement := refinement.filter(~keep: fun (item): !has_head(item, {"supply", "under"}))
        def cut_forms = {"child", "children", "history", "local", "input", "output", "batch", "check", "cover"}
        when has_cycle && !forward_args && !adjacent_source && !refinement.find(fun (c): has_head(c, cut_forms))
        | block:
            projection := Syntax.make_temp_id("cycle_projection")
            // Capture the lexical environment here. Later bindings cannot change the relation.
            model_clause('fun $projection(cycle :: ir.LeafModel):
                            cycle_relation(cycle): $entry; ...')
    | 'transactions $rhs ...':
        when transaction | syntax_meta.error("duplicate transaction view", clause)
        transaction := '($rhs ...)'
    | 'assume $(n :: Identifier) = $v ...': record(assumptions, field_name(n), 'operand($v ...)', clause)
    | ~else: model_clause(clause)

  let [decl, ...] = declarations()
  def specialized = transaction && bound_events
  when dimension && (!transaction || event_source)
  | syntax_meta.error("specialize needs a monitor without a bound event reader", name)
  when transaction && event_source && !bound_events
  | syntax_meta.error("name the sampled event reader when declaring a transaction monitor", name)
  when forward_args && (!transaction || rtl_hint)
  | syntax_meta.error("exact forwarding requires a transaction monitor and no RTL leaf refinement", name)
  when adjacent_source && (!transaction || has_cycle || rtl_hint || requirement)
  | syntax_meta.error("adjacent_samples requires an unconditional monitor and a separate RTL cycle proof", name)
  when requirement && (!transaction || !refinement || rtl_hint || projection
                        || child_specs.length() > 0 || child_family)
  | syntax_meta.error("requires needs a local monitor refinement or exact forwarding", name)
  when suppliers.length() > 0 && (!transaction || rtl_hint)
  | syntax_meta.error("supply requires a parent transaction refinement", name)
  when rtl_hint && !(transaction && has_cycle && (projection || !sync.unwrap()))
  | syntax_meta.error("expected a cycle spec and transaction view; clocked RTL also needs a transaction projection", name)
  when bound_events && !transaction
  | syntax_meta.error("a named event reader needs a transaction view", name)
  when projection && !transaction && !event_source | syntax_meta.error("cycle refinement requires a transaction view", name)
  when specialized
  | transaction := 'check_event_domains($transaction, $(bound_events) . sampler, bound.ports)'
  when refinement && !forward_args && !adjacent_source && !projection
  | block:
      unless transaction | syntax_meta.error("refinement requires a transaction view", name)
      let [entry, ...] = refinement
      // A dimension-keyed monitor can be shared by different parents; bind its child
      // occurrences against the actual parent's RTL when the refinement is checked.
      transaction := 'refined_view($transaction, $(if specialized | 'top' | '#false'), $(if dimension | '#true' | '#false')): $entry; ...'
  let [skip, ...] = ignored
  def args:
    cond
    | specialized:
        if projection
        | '(top, ~event_view: view_only :: Boolean = #false, ~transaction_view: tx_only :: Boolean = #false, ~cycle_derivation: derive :: Boolean = #false, ~proof_plan: plan :: Boolean = #false)'
        | '(top, ~event_view: view_only :: Boolean = #false, ~transaction_view: tx_only :: Boolean = #false, ~proof_plan: plan :: Boolean = #false)'
    | projection && event_source: '(top, ~event_view: view_only :: Boolean = #false, ~cycle_derivation: derive :: Boolean = #false)'
    | event_source: '(top, ~event_view: view_only :: Boolean = #false)'
    | ~else: '(top)'
  def tx_args:
    if projection
    | '(top = #false, ~transaction_view: tx_only :: Boolean = #false, ~cycle_derivation: derive :: Boolean = #false, ~proof_plan: plan :: Boolean = #false)'
    | '(top = #false, ~transaction_view: tx_only :: Boolean = #false, ~proof_plan: plan :: Boolean = #false)'
  def need = requirement || '#false'
  def domain = premise_source || (if assumptions.length() > 0 | name | '#false')
  def parent_plan:
    cond
    | forward_args:
        let [site, spec] = forward_args
        // A bare view requests unconditional forwarding. With pin assumptions the
        // checker also needs the bound declaration to extract the parent's premises.
        def contract = if assumptions.length() > 0 | name | 'view'
        'PairList["forward", $contract, $site, $spec, $need]'
    | adjacent_source: 'PairList["adjacent", view, $adjacent_source]'
    | ~else: 'PairList["parent", view, $(all_children(child_specs)), $need, $(map_expr(suppliers)), $domain]'
  def leaf_plan:
    if rtl_hint
    | 'PairList["leaf", top.name, checked, view, $(if projection | '$projection(checked)' | 'Map{}'), $rtl_hint(checked)]'
    | 'error("cycle spec has no RTL refinement")'
  def cycle_plan = if forward_args || requirement || child_specs.length() > 0 || child_family | parent_plan | leaf_plan
  /* Return the same public view for consumers. Only a proof request also builds the private relation. */
  fun result_expr(normal :: Syntax):
    if projection | 'if derive | values(view, $projection(checked)) | $normal' | normal
  def build = 'ir.make_spec(bound.ports.inputs, $(all_states(states)), $(all_initial(initial)),
                            cycle_outputs, cycle_events, $(all_updates(updates)), ~assumptions: $(map_expr(assumptions)))'
  // A passive declaration has no cycle clauses to validate. Even one such clause keeps
  // the full-model path, so requesting a view cannot hide an incomplete cycle spec.
  def no_cycle_clauses = !has_family && !iterates_observations && ignored.length() == 0
                         && ![states, outputs, events, assumptions, updates].find(fun (table): table.length() != 0)
  def passive = event_source && no_cycle_clauses
  def monitor_only = transaction && no_cycle_clauses
  when premise_source && !(monitor_only && (child_specs.length() > 0 || child_family) && !event_source && !rtl_hint)
  | syntax_meta.error("under requires a monitor-only child refinement with no local cycle clauses or assumptions", name)
  def finish:
    cond
    | specialized && passive: '«
         cond
         | plan || tx_only:
             def view = specialized_view(top, fun (): boundary.check_transaction_ports($transaction, bound.ports))
             if plan | $parent_plan | view
         | view_only: $bound_events
         | ~else: error("passive-only spec: request a transaction or event view")
       »'
    | specialized: '«
         def view = specialized_view(top, fun (): boundary.check_transaction_ports($transaction, bound.ports))
         def cycle_sampler = view.sampler with (assumptions = $(bound_events) . sampler . assumptions)
         def cycle_events = ir.include_sampled_events(cycle_sampler, cycle_outputs, $(all_events(events)), ~only: view.cycle_names)
         def checked = check_output_types($build, bound.ports.outputs, [$skip, ...])
         cond
         | plan: $cycle_plan
         | ~else: $(result_expr('cond | tx_only: view | view_only: $bound_events | ~else: checked'))
       »'
    | monitor_only: '«
         unless plan || tx_only | error("monitor-only spec: request ~transaction_view: #true")
         def view = boundary.check_transaction_ports(attached, bound.ports)
         if plan | $parent_plan | view
       »'
    | transaction: '«
         def view = boundary.check_transaction_ports(attached, bound.ports)
         def cycle_events = ir.include_sampled_events(view.sampler, cycle_outputs, $(all_events(events)), ~only: view.cycle_names)
         def checked = check_output_types($build, bound.ports.outputs, [$skip, ...])
         if plan | $cycle_plan | $(result_expr('if tx_only | view | checked'))
       »'
    | passive:
        '«
           unless view_only | error("passive-only spec: request ~event_view: #true")
           boundary.bind_event_source($event_source, top)
         »'
    | event_source: '«
         def view = boundary.bind_event_source($event_source, top)
         def cycle_events = ir.include_sampled_events(view.sampler, cycle_outputs, $(all_events(events)))
         def checked = check_output_types($build, bound.ports.outputs, [$skip, ...])
         $(result_expr('if view_only | view | checked'))
       »'
    | ~else: '«
         def cycle_events = $(all_events(events))
         check_output_types($build, bound.ports.outputs, [$skip, ...])
       »'
  def cycle_body = '«
     def bound = boundary.declared_ports(top, $family, $sync)
     def $pin = ir.input_ref($pin_key, bound.ports.inputs[$pin_key])
     ...
     bind_parameter $cfg(bound, $key)
     ...
     def $ep :: boundary.Endpoint = bound.endpoints[$ep_key]
     ...
     def $arr :: List.of(boundary.Endpoint) = bound.arrays[$arr_key]
     ...
     $decl
     ...
     def cycle_outputs = $(all_outputs(outputs))
     $finish
   »'
  cond
  | specialized: '«
       def views = WeakMutableMap.by(===){}
       fun specialized_view(top, build):
         unless views.has_key(top) | views[top] := build()
         views[top]
       fun $name $args: $cycle_body
     »'
  | dimension: '«
       def views = MutableMap{}
       fun dimension_view($dimension :: PosInt):
         unless views.has_key($dimension)
         | block:
             def view :: boundary.TransactionView = $transaction
             views[$dimension] := view
         views[$dimension]
       fun $name $tx_args:
         cond
         | top: $cycle_body
         | tx_only: dimension_view($detached_default)
         | ~else: error("cycle execution requires an elaborated RTL specialization")
     »'
  | transaction:
     '«
       def attached :: boundary.TransactionView = $transaction
       fun $name $tx_args:
         cond
         | top: $cycle_body
         | tx_only: attached
         | ~else: error("cycle execution requires an elaborated RTL specialization")
     »'
  | ~else: 'fun $name $args: $cycle_body'
