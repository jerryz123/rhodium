#lang rhombus/and_meta
/* Exposes lexical Rhombus and model-building operations as the solver-independent #lang rspecl. */
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus
  rhombus/meta open
  lib("rhodium/formal/spec-dsl.rhm") open
  lib("rhodium/formal/spec.rhm") as ir
  lib("rhodium/formal/port-types.rhm").check_output_types
  "rtl-boundary.rhm" as boundary

export:
  all_from(rhombus)
  all_from(lib("rhodium/formal/spec-dsl.rhm")):
    except operand
  spec
  rename: boundary.ready_valid_events as ready_valid_events
  rename: boundary.rv_pins as rv_pins
  rename: boundary.transaction_view as transaction_view

meta:
  import lib("racket/base.rkt").#{syntax-local-context} as expansion_context

/* A module declaration publishes its constructor. An interactive declaration has no module exports. */
decl.macro 'spec for $prefix ... . $(name :: Identifier): $line; ...':
  def build = 'define_spec $prefix ... . $name: $line; ...'
  if expansion_context() == #'module
  | '«$build; export $name»'
  | build

/* In a definition body the same constructor is local, including when it shadows a module spec. */
defn.macro 'spec for $prefix ... . $(name :: Identifier): $line; ...':
  'define_spec $prefix ... . $name: $line; ...'

/* Both contexts obtain the constructor name and lexical boundary from the RTL declaration. */
defn.macro 'define_spec $prefix ... . $(name :: Identifier): $line; ...':
  '$prefix ... . $(name) . describe_boundary declared_spec $name: $line; ...'

meta:
  /* Only external declaration names are strings; expression identifiers remain lexical syntax. */
  fun field_name(stx :: Syntax):
    match stx
    | '$(a :: Identifier)': to_string(a.unwrap())
    | '$(a :: Identifier) . $(b :: Identifier)': field_name(a) ++ "." ++ field_name(b)
    | '$(a :: Identifier)[$i] . $(b :: Identifier)':
        unless i.unwrap() is_a Nat | syntax_meta.error("expected a literal nonnegative lane index", i)
        field_name(a) ++ "[" ++ to_string(i.unwrap()) ++ "]." ++ field_name(b)
    | ~else: syntax_meta.error("expected a spec field name", stx)

  /* Emit the immutable schema or view expected by the existing model constructor. */
  fun map_expr(entries :: ReadableMap):
    let [key, ...] = entries.keys()
    let [value, ...] = [entries[key], ...]
    'Map{$key: $value, ...}'

  /* Split the optional care clause without inspecting either Rhombus expression. */
  fun observation(rhs :: Syntax):
    match rhs
    | '$v ... when $c ...': 'ir.Observed(operand($v ...), operand($c ...))'
    | ~else: 'ir.Observed(operand($rhs))'

  /* Share lexical state, initial constants and simultaneous next clauses between cycle and monitor bodies. */
  fun model_body():
    def states = MutableMap{}
    def initial = MutableMap{}
    def updates = MutableMap{}
    def mutable body = []
    /* Capture a declaration's value at its lexical site, not after later shadowing. */
    fun record(table :: MutableMap, key :: String, rhs :: Syntax, site :: Syntax):
      when table.has_key(key) | syntax_meta.error("duplicate spec declaration: " ++ key, site)
      def id = Syntax.make_temp_id(key)
      body := body ++ ['def $id = $rhs']
      table[key] := id
      id
    /* An optional lexical alias exposes the typed initial constant without implying reset. */
    fun state_clause(n :: Syntax, t :: Syntax, v :: Syntax, alias_id :: maybe(Syntax), site :: Syntax):
      def key = field_name(n)
      def type = record(states, key, t, site)
      def start = record(initial, key, v, site)
      body := body ++ ['def $n = ir.state_ref($key, $type)']
      when alias_id | body := body ++ ['def $alias_id = ir.literal($type, $start)']
    /* Leave ordinary Rhombus definitions and helper calls in their original lexical order. */
    fun model_clause(clause :: Syntax):
      match clause
      | 'state $(n :: Identifier): $t ... initially $v ... as $(id :: Identifier)':
          state_clause(n, '$t ...', '($v ...)', id, clause)
      | 'state $(n :: Identifier): $t ... initially $v ...':
          state_clause(n, '$t ...', '($v ...)', #false, clause)
      | 'next $(n :: Identifier) = $v ...':
          def key = field_name(n)
          unless states.has_key(key) | syntax_meta.error("next requires a declared state: " ++ key, n)
          record(updates, key, 'operand($v ...)', clause)
      | ~else: body := body ++ [clause]
    values(states, initial, updates, record, model_clause, fun (): body)

/* A monitor verdict is observable, not an assumption. Reject the entire batch before any update is evaluated. */
fun monitor_model(inputs :: Map, states :: Map, initial :: Map, guarantees :: Map, updates :: Map):
  def mutable allowed = operand(#true)
  for (name in guarantees.keys().sort()):
    allowed := ir.bool_and(allowed, guarantees[name])
  def outputs = for Map ((name, predicate) in guarantees):
    values(name, ir.Observed(predicate))
  def guarded = for Map ((name, rhs) in updates):
    values(name, ir.choose_if(allowed, rhs, ir.state_ref(name, states[name])))
  ir.make_spec(inputs, states, initial, outputs ++ {"allowed": ir.Observed(allowed)}, {}, guarded)

/* Compile the fixed batch vocabulary in declaration scope, independently of the cycle model's RTL pins. */
expr.macro 'monitor_view: $line; ...':
  def values(states, initial, updates, record, model_clause, declarations) = model_body()
  def inputs = MutableMap{}
  def guarantees = MutableMap{}
  def attachment = MutableMap{}
  /* A batch field is one pre-edge input to the monitor, not a pin read or a history update. */
  fun batch(n :: Syntax, type :: Syntax, site :: Syntax):
    def key = field_name(n)
    def sort = record(inputs, key, type, site)
    model_clause('def $n = ir.input_ref($key, $sort)')
  for (clause in [line, ...]):
    match clause
    | 'batch ($(n :: Identifier), ...): $t ...':
        for (id in [n, ...]): batch(id, '($t ...)', clause)
    | 'batch $(n :: Identifier): $t ...': batch(n, '($t ...)', clause)
    | 'guarantee $label = $rhs ...':
        def key = label.unwrap()
        unless key is_a String && key != "" | syntax_meta.error("expected a nonempty guarantee string", label)
        when key == "allowed" | syntax_meta.error("allowed is the combined monitor verdict", label)
        record(guarantees, key, 'operand($rhs ...)', clause)
    | 'sample $s ...': record(attachment, "sample", '($s ...)', clause)
    | 'publish $names ...': record(attachment, "publish", '($names ...)', clause)
    | 'assume $rest ...': syntax_meta.error("a monitor judges batches with guarantees, not assumptions", clause)
    | ~else: model_clause(clause)
  unless attachment.has_key("sample") && attachment.has_key("publish") && guarantees.length() > 0
  | syntax_meta.error("monitor requires sample, publish, and at least one guarantee", [line, ...][0])
  for (key in inputs.keys()):
    when states.has_key(key) | syntax_meta.error("batch and state share a name: " ++ key, [line, ...][0])
  let [decl, ...] = declarations()
  'block:
     $decl
     ...
     boundary.transaction_view(monitor_model($(map_expr(inputs)), $(map_expr(states)), $(map_expr(initial)),
                                             $(map_expr(guarantees)), $(map_expr(updates))),
                               $(attachment["publish"]), $(attachment["sample"]))'

/* Read a parameter at its lexical use site so unused non-scalar arguments need no model value. */
defn.macro 'bind_parameter $id($bound, $key)':
  '«
     expr.macro '$id': '$(bound) . parameter($key)'
   »'

/* Compile a circuit-bound body to typed IR; evaluate each clause at its original lexical site. */
defn.macro 'declared_spec $name($family, $sync) ($pin, ...) ($cfg, ...) ($ep, ...) ($arr, ...): $line; ...':
  let [pin_key, ...] = [pin.to_source_string(), ...]
  let [key, ...] = [cfg.to_source_string(), ...]
  let [ep_key, ...] = [ep.to_source_string(), ...]
  let [arr_key, ...] = [arr.to_source_string(), ...]
  def outputs = MutableMap{}
  def events = MutableMap{}
  def assumptions = MutableMap{}
  def mutable ignored = []
  def mutable event_source = #false
  def mutable transaction = #false
  def values(states, initial, updates, record, model_clause, declarations) = model_body()
  for (clause in [line, ...]):
    match clause
    | 'input $n ...: $t': syntax_meta.error("inputs come from the RTL declaration", clause)
    | 'ignore $n ...': ignored := ignored ++ [field_name('$n ...')]
    | 'observe $n ... = $v ...': record(outputs, field_name('$n ...'), observation('$v ...'), clause)
    | 'output $n ... = $v ...': record(outputs, field_name('$n ...'), observation('$v ...'), clause)
    | 'event $n ... = $v ...': record(events, field_name('$n ...'), observation('$v ...'), clause)
    | 'events $rhs ...':
        when event_source | syntax_meta.error("duplicate sampled event source", clause)
        event_source := Syntax.make_temp_id("event_source")
        model_clause('def $event_source = $rhs ...')
    | 'monitor: $entry; ...':
        when transaction | syntax_meta.error("duplicate transaction view", clause)
        transaction := 'monitor_view: $entry; ...'
    | 'transactions $rhs ...':
        when transaction | syntax_meta.error("duplicate transaction view", clause)
        transaction := '($rhs ...)'
    | 'assume $(n :: Identifier) = $v ...': record(assumptions, field_name(n), 'operand($v ...)', clause)
    | ~else: model_clause(clause)

  let [decl, ...] = declarations()
  let [skip, ...] = ignored
  when transaction && event_source | syntax_meta.error("choose one sampled event source", name)
  def args = if event_source | '(top, ~event_view: view_only :: Boolean = #false)' | '(top)'
  def build = 'ir.make_spec(bound.ports.inputs, $(map_expr(states)), $(map_expr(initial)),
                            cycle_outputs, cycle_events, $(map_expr(updates)), ~assumptions: $(map_expr(assumptions)))'
  // A passive declaration has no cycle clauses to validate. Even one such clause keeps
  // the full-model path, so requesting a view cannot hide an incomplete cycle spec.
  def passive = event_source && ignored.length() == 0
                && ![states, outputs, events, assumptions, updates].find(fun (table): table.length() != 0)
  def finish:
    cond
    | transaction: '«
         def view = boundary.check_transaction_ports(attached, bound.ports)
         def cycle_events = ir.include_sampled_events(view.sampler, cycle_outputs, $(map_expr(events)), ~only: view.cycle_names)
         def checked = check_output_types($build, bound.ports.outputs, [$skip, ...])
         if tx_only | view | checked
       »'
    | passive:
        '«
           unless view_only | error("passive-only spec: request ~event_view: #true")
           boundary.bind_event_source($event_source, top)
         »'
    | event_source: '«
         def view = boundary.bind_event_source($event_source, top)
         def cycle_events = ir.include_sampled_events(view.sampler, cycle_outputs, $(map_expr(events)))
         def checked = check_output_types($build, bound.ports.outputs, [$skip, ...])
         if view_only | view | checked
       »'
    | ~else: '«
         def cycle_events = $(map_expr(events))
         check_output_types($build, bound.ports.outputs, [$skip, ...])
       »'
  def cycle_body = '«
     def bound = boundary.declared_ports(top, $family, $sync)
     def $pin = ir.input_ref($pin_key, bound.ports.inputs[$pin_key])
     ...
     bind_parameter $cfg(bound, $key)
     ...
     def $ep :: boundary.Endpoint = bound.endpoints[$ep_key]
     ...
     def $arr :: List.of(boundary.Endpoint) = bound.arrays[$arr_key]
     ...
     $decl
     ...
     def cycle_outputs = $(map_expr(outputs))
     $finish
   »'
  if transaction
  | '«
       def attached :: boundary.TransactionView = $transaction
       fun $name(top = #false, ~transaction_view: tx_only :: Boolean = #false):
         cond
         | top: $cycle_body
         | tx_only: attached
         | ~else: error("cycle execution requires an elaborated RTL specialization")
     »'
  | 'fun $name $args: $cycle_body'
