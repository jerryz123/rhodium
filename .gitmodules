# Pins external repositories used by Rhodium tests and downstream prototypes.
# SPDX-License-Identifier: Apache-2.0

[submodule "vlsi/double_wide_openframe"]
	path = vlsi/double_wide_openframe
	url = https://github.com/chipfoundry/double_wide_openframe.git
[submodule "riscv/riscv-isa-tests"]
	path = riscv/riscv-isa-tests
	url = https://github.com/riscv-software-src/riscv-tests.git
[submodule "riscv/riscv-arch-test"]
	path = riscv/riscv-arch-test
	url = https://github.com/riscv/riscv-arch-test.git
	branch = act4
[submodule "sims/program-test/coremark"]
	path = sims/program-test/coremark
	url = https://github.com/eembc/coremark.git
[submodule "sims/program-test/embench-iot"]
	path = sims/program-test/embench-iot
	url = https://github.com/embench/embench-iot.git
[submodule "riscv/riscv-isa-sim"]
	path = riscv/riscv-isa-sim
	url = https://github.com/riscv-software-src/riscv-isa-sim.git
