#lang rhodium
// Defines low-level CHI checks and explicit whole-endpoint monitor functions.

import:
  lib("rhodium/std/credited.rhdl").check_credited
  lib("chi/params.rhdl").CHIFlitParams
  lib("chi/flits.rhdl") open
  lib("chi/protocol.rhdl") open
  lib("chi/link.rhdl") open
  lib("chi/fabric.rhdl").CHIHomeParams
  lib("chi/transaction.rhdl") open
  lib("chi/coherent-transaction.rhdl") open

fun chi_opcode_supported(opcode :: Hardware,
                         capabilities :: List.of(HardwareLiteral)):
  opcode.is_one_of(capabilities)

// Checks one direction's four-state activation sequence against prior state.
fun monitor_chi_activation(request :: Bool,
                           ack :: Bool,
                           previous_request :: Bool,
                           previous_ack :: Bool,
                           label_prefix :: String):
  def request_rise = request & !previous_request
  def request_fall = !request & previous_request
  def ack_rise = ack & !previous_ack
  def ack_fall = !ack & previous_ack

  assert(!request_rise ||| !previous_ack,
         label_prefix ++ "_request_after_ack_low")
  assert(!ack_rise ||| request,
         label_prefix ++ "_ack_after_request")
  assert(!request_fall ||| previous_ack,
         label_prefix ++ "_request_drop_after_ack")
  assert(!ack_fall ||| !request,
         label_prefix ++ "_ack_drop_after_request")

fun monitor_chi_transport(credit_limit :: PosInt,
                          valid :: Bool,
                          credit :: Bool,
                          credit_balance :: Bits(index_width(credit_limit + 1)),
                          request :: Bool,
                          ack :: Bool,
                          previous_request :: Bool,
                          lcrd_return :: Bool,
                          label_prefix :: String):
  check_credited(valid, credit, credit_limit, credit_balance)
  def stopped = !request & !ack
  def credit_active = ack & (request ||| previous_request)

  assert(!valid ||| ack, label_prefix ++ "_flit_active")
  assert(!credit ||| credit_active, label_prefix ++ "_credit_active")
  when stopped:
    assert(!or_reduce(credit_balance), label_prefix ++ "_credits_returned")
  when (valid & lcrd_return):
    assert(!request & ack, label_prefix ++ "_lcrd_during_deactivate")

fun monitor_chi_identity(node_id_width :: PosInt,
                         valid :: Bool,
                         identity_value :: Bits(node_id_width),
                         lcrd_return :: Bool,
                         node_id :: Nat,
                         label_prefix :: String):
  when (valid & !lcrd_return):
    assert(identity_value === bits(node_id, node_id_width),
           label_prefix)

fun monitor_chi_req(p :: CHIFlitParams,
                    credit_limit :: PosInt,
                    valid :: Bool,
                    opcode :: CHIReqOpcode,
                    txn_id :: Bits(12),
                    identity_value :: Bits(p.node_id_width),
                    size_or_num_req :: Bits(6),
                    multi_req :: Bool,
                    credit :: Bool,
                    credit_balance :: Bits(index_width(credit_limit + 1)),
                    request :: Bool,
                    ack :: Bool,
                    previous_request :: Bool,
                    capabilities :: List.of(CHIReqOpcode),
                    node_id :: Nat,
                    identity_label :: String,
                    label_prefix :: String):
  def lcrd_return = opcode === CHIReqOpcode.ReqLCrdReturn
  monitor_chi_transport(credit_limit,
                        valid,
                        credit,
                        credit_balance,
                        request,
                        ack,
                        previous_request,
                        lcrd_return,
                        label_prefix)
  monitor_chi_identity(p.node_id_width,
                       valid,
                       identity_value,
                       lcrd_return,
                       node_id,
                       label_prefix ++ identity_label)
  when valid:
    assert(enum_valid(opcode), label_prefix ++ "_opcode_valid")
    assert(lcrd_return ||| chi_opcode_supported(opcode,
                                                capabilities),
           label_prefix ++ "_opcode_supported")
    when lcrd_return:
      assert(txn_id === bits(0, 12),
             label_prefix ++ "_lcrd_txn_id_zero")
    when (!lcrd_return & !multi_req):
      assert(!or_reduce(size_or_num_req[3..6]),
             label_prefix ++ "_size_reserved_zero")
      assert(chi_size_valid(size_or_num_req[0..3].into(CHITransferSize)),
             label_prefix ++ "_size_valid")

fun monitor_chi_rsp(p :: CHIFlitParams,
                    credit_limit :: PosInt,
                    valid :: Bool,
                    opcode :: CHIRspOpcode,
                    txn_id :: Bits(12),
                    identity_value :: Bits(p.node_id_width),
                    credit :: Bool,
                    credit_balance :: Bits(index_width(credit_limit + 1)),
                    request :: Bool,
                    ack :: Bool,
                    previous_request :: Bool,
                    capabilities :: List.of(CHIRspOpcode),
                    node_id :: Nat,
                    identity_label :: String,
                    label_prefix :: String):
  def lcrd_return = opcode === CHIRspOpcode.RespLCrdReturn
  monitor_chi_transport(credit_limit,
                        valid,
                        credit,
                        credit_balance,
                        request,
                        ack,
                        previous_request,
                        lcrd_return,
                        label_prefix)
  monitor_chi_identity(p.node_id_width,
                       valid,
                       identity_value,
                       lcrd_return,
                       node_id,
                       label_prefix ++ identity_label)
  when valid:
    assert(enum_valid(opcode), label_prefix ++ "_opcode_valid")
    assert(lcrd_return ||| chi_opcode_supported(opcode,
                                                capabilities),
           label_prefix ++ "_opcode_supported")
    when lcrd_return:
      assert(txn_id === bits(0, 12),
             label_prefix ++ "_lcrd_txn_id_zero")

fun monitor_chi_snp(credit_limit :: PosInt,
                    valid :: Bool,
                    opcode :: CHISnpOpcode,
                    txn_id :: Bits(12),
                    credit :: Bool,
                    credit_balance :: Bits(index_width(credit_limit + 1)),
                    request :: Bool,
                    ack :: Bool,
                    previous_request :: Bool,
                    capabilities :: List.of(CHISnpOpcode),
                    label_prefix :: String):
  def lcrd_return = opcode === CHISnpOpcode.SnpLCrdReturn
  monitor_chi_transport(credit_limit,
                        valid,
                        credit,
                        credit_balance,
                        request,
                        ack,
                        previous_request,
                        lcrd_return,
                        label_prefix)
  when valid:
    assert(enum_valid(opcode), label_prefix ++ "_opcode_valid")
    assert(lcrd_return ||| chi_opcode_supported(opcode,
                                                capabilities),
           label_prefix ++ "_opcode_supported")
    when lcrd_return:
      assert(txn_id === bits(0, 12),
             label_prefix ++ "_lcrd_txn_id_zero")

fun monitor_chi_dat(p :: CHIFlitParams,
                    credit_limit :: PosInt,
                    valid :: Bool,
                    opcode :: CHIDatOpcode,
                    txn_id :: Bits(12),
                    identity_value :: Bits(p.node_id_width),
                    data_id :: Bits(2),
                    credit :: Bool,
                    credit_balance :: Bits(index_width(credit_limit + 1)),
                    request :: Bool,
                    ack :: Bool,
                    previous_request :: Bool,
                    capabilities :: List.of(CHIDatOpcode),
                    node_id :: Nat,
                    identity_label :: String,
                    label_prefix :: String):
  def lcrd_return = opcode === CHIDatOpcode.DataLCrdReturn
  monitor_chi_transport(credit_limit,
                        valid,
                        credit,
                        credit_balance,
                        request,
                        ack,
                        previous_request,
                        lcrd_return,
                        label_prefix)
  monitor_chi_identity(p.node_id_width,
                       valid,
                       identity_value,
                       lcrd_return,
                       node_id,
                       label_prefix ++ identity_label)
  when valid:
    assert(enum_valid(opcode), label_prefix ++ "_opcode_valid")
    assert(lcrd_return ||| chi_opcode_supported(opcode,
                                                capabilities),
           label_prefix ++ "_opcode_supported")
    when lcrd_return:
      assert(txn_id === bits(0, 12),
             label_prefix ++ "_lcrd_txn_id_zero")
    when (!lcrd_return):
      assert(chi_data_id_valid(data_id, p),
             label_prefix ++ "_data_id_valid")

fun node_emitted_capabilities(endpoint :: CHIEndpointParams):
  if endpoint is_a CHINodeParams | endpoint.emits | endpoint.supports

fun node_received_capabilities(endpoint :: CHIEndpointParams):
  if endpoint is_a CHINodeParams | endpoint.supports | endpoint.emits

// Applies the RN-F/RN-D checks to one explicitly selected endpoint.
fun monitor_chi_rn(link :: CHIRNLinkParams,
                   endpoint :: CHIEndpointParams,
                   port :: Endpoint.of(CHIRNLink(link, endpoint)),
                   ~label_prefix: label_prefix :: String = "chi",
                   ~transaction_checks: transaction_checks :: Boolean = #true):
  def observed :: Observation = port.observe()
  def emitted = node_emitted_capabilities(endpoint)
  def received = node_received_capabilities(endpoint)
  reg rn_tx_previous_request(~init: Bool(#false))
  reg rn_tx_previous_ack(~init: Bool(#false))
  reg rn_rx_previous_request(~init: Bool(#false))
  reg rn_rx_previous_ack(~init: Bool(#false))
  reg rn_tx_req_credit_balance(~init: bits(0, index_width(link.tx_req_credits + 1)))
  reg rn_tx_rsp_credit_balance(~init: bits(0, index_width(link.tx_rsp_credits + 1)))
  reg rn_tx_dat_credit_balance(~init: bits(0, index_width(link.tx_dat_credits + 1)))
  reg rn_rx_rsp_credit_balance(~init: bits(0, index_width(link.rx_rsp_credits + 1)))
  reg rn_rx_dat_credit_balance(~init: bits(0, index_width(link.rx_dat_credits + 1)))
  reg rn_rx_snp_credit_balance(~init: bits(0, index_width(link.rx_snp_credits + 1)))
  monitor_chi_cache_maintenance(link.flit, observed.tx_req.valid, observed.tx_req.bits, label_prefix)
  monitor_chi_activation(observed.tx_link_active_request,
                         observed.tx_link_active_ack,
                         rn_tx_previous_request,
                         rn_tx_previous_ack,
                         label_prefix ++ "_tx_link")
  monitor_chi_activation(observed.rx_link_active_request,
                         observed.rx_link_active_ack,
                         rn_rx_previous_request,
                         rn_rx_previous_ack,
                         label_prefix ++ "_rx_link")
  monitor_chi_req(link.flit, link.tx_req_credits,
                  observed.tx_req.valid, observed.tx_req.bits.opcode,
                  observed.tx_req.bits.txn_id, observed.tx_req.bits.src_id,
                  observed.tx_req.bits.size_or_num_req, observed.tx_req.bits.multi_req,
                  observed.tx_req.credit,
                  rn_tx_req_credit_balance,
                  observed.tx_link_active_request, observed.tx_link_active_ack,
                  rn_tx_previous_request, emitted.req,
                  endpoint.node_id, "_source_id", label_prefix ++ "_tx_req")
  monitor_chi_rsp(link.flit, link.tx_rsp_credits,
                  observed.tx_rsp.valid, observed.tx_rsp.bits.opcode,
                  observed.tx_rsp.bits.txn_id, observed.tx_rsp.bits.src_id,
                  observed.tx_rsp.credit,
                  rn_tx_rsp_credit_balance,
                  observed.tx_link_active_request, observed.tx_link_active_ack,
                  rn_tx_previous_request, emitted.rsp,
                  endpoint.node_id, "_source_id", label_prefix ++ "_tx_rsp")
  monitor_chi_dat(link.flit, link.tx_dat_credits,
                  observed.tx_dat.valid, observed.tx_dat.bits.opcode,
                  observed.tx_dat.bits.txn_id, observed.tx_dat.bits.src_id,
                  observed.tx_dat.bits.data_id, observed.tx_dat.credit,
                  rn_tx_dat_credit_balance,
                  observed.tx_link_active_request, observed.tx_link_active_ack,
                  rn_tx_previous_request, emitted.dat,
                  endpoint.node_id, "_source_id", label_prefix ++ "_tx_dat")
  monitor_chi_rsp(link.flit, link.rx_rsp_credits,
                  observed.rx_rsp.valid, observed.rx_rsp.bits.opcode,
                  observed.rx_rsp.bits.txn_id, observed.rx_rsp.bits.tgt_id,
                  observed.rx_rsp.credit,
                  rn_rx_rsp_credit_balance,
                  observed.rx_link_active_request, observed.rx_link_active_ack,
                  rn_rx_previous_request, received.rsp,
                  endpoint.node_id, "_target_id", label_prefix ++ "_rx_rsp")
  monitor_chi_dat(link.flit, link.rx_dat_credits,
                  observed.rx_dat.valid, observed.rx_dat.bits.opcode,
                  observed.rx_dat.bits.txn_id, observed.rx_dat.bits.tgt_id,
                  observed.rx_dat.bits.data_id, observed.rx_dat.credit,
                  rn_rx_dat_credit_balance,
                  observed.rx_link_active_request, observed.rx_link_active_ack,
                  rn_rx_previous_request, received.dat,
                  endpoint.node_id, "_target_id", label_prefix ++ "_rx_dat")
  monitor_chi_snp(link.rx_snp_credits,
                  observed.rx_snp.valid, observed.rx_snp.bits.opcode,
                  observed.rx_snp.bits.txn_id, observed.rx_snp.credit,
                  rn_rx_snp_credit_balance,
                  observed.rx_link_active_request, observed.rx_link_active_ack,
                  rn_rx_previous_request, received.snp,
                  label_prefix ++ "_rx_snp")
  if transaction_checks && endpoint.kind == CHINodeKind.RNF && (
    chi_initial_coherent_requester_capabilities(emitted, received)
  )
  | coherent_requester_transaction_monitor(link.flit,
                                           endpoint.max_outstanding,
                                           label_prefix ++ "_coherent",
                                           observed.tx_req.valid,
                                           observed.tx_req.bits,
                                           observed.tx_rsp.valid,
                                           observed.tx_rsp.bits,
                                           observed.tx_dat.valid,
                                           observed.tx_dat.bits,
                                           observed.rx_dat.valid,
                                           observed.rx_dat.bits,
                                           observed.rx_snp.valid,
                                           observed.rx_snp.bits)
  | #void
  rn_tx_previous_request <== observed.tx_link_active_request
  rn_tx_previous_ack <== observed.tx_link_active_ack
  rn_rx_previous_request <== observed.rx_link_active_request
  rn_rx_previous_ack <== observed.rx_link_active_ack

// Applies the RN-I link and eligible transaction checks to one explicitly
// selected endpoint.
fun monitor_chi_rni(link :: CHIRNILinkParams,
                    endpoint :: CHIEndpointParams,
                    port :: Endpoint.of(CHIRNILink(link, endpoint)),
                    ~label_prefix: label_prefix :: String = "chi",
                    ~transaction_checks: transaction_checks :: Boolean = #true):
  def observed :: Observation = port.observe()
  def emitted = node_emitted_capabilities(endpoint)
  def received = node_received_capabilities(endpoint)
  reg rni_tx_previous_request(~init: Bool(#false))
  reg rni_tx_previous_ack(~init: Bool(#false))
  reg rni_rx_previous_request(~init: Bool(#false))
  reg rni_rx_previous_ack(~init: Bool(#false))
  reg rni_tx_req_credit_balance(~init: bits(0, index_width(link.tx_req_credits + 1)))
  reg rni_tx_rsp_credit_balance(~init: bits(0, index_width(link.tx_rsp_credits + 1)))
  reg rni_tx_dat_credit_balance(~init: bits(0, index_width(link.tx_dat_credits + 1)))
  reg rni_rx_rsp_credit_balance(~init: bits(0, index_width(link.rx_rsp_credits + 1)))
  reg rni_rx_dat_credit_balance(~init: bits(0, index_width(link.rx_dat_credits + 1)))
  monitor_chi_cache_maintenance(link.flit, observed.tx_req.valid, observed.tx_req.bits, label_prefix)
  monitor_chi_activation(observed.tx_link_active_request,
                         observed.tx_link_active_ack,
                         rni_tx_previous_request,
                         rni_tx_previous_ack,
                         label_prefix ++ "_tx_link")
  monitor_chi_activation(observed.rx_link_active_request,
                         observed.rx_link_active_ack,
                         rni_rx_previous_request,
                         rni_rx_previous_ack,
                         label_prefix ++ "_rx_link")
  monitor_chi_req(link.flit, link.tx_req_credits,
                  observed.tx_req.valid, observed.tx_req.bits.opcode,
                  observed.tx_req.bits.txn_id, observed.tx_req.bits.src_id,
                  observed.tx_req.bits.size_or_num_req, observed.tx_req.bits.multi_req,
                  observed.tx_req.credit,
                  rni_tx_req_credit_balance,
                  observed.tx_link_active_request, observed.tx_link_active_ack,
                  rni_tx_previous_request, emitted.req,
                  endpoint.node_id, "_source_id", label_prefix ++ "_tx_req")
  monitor_chi_rsp(link.flit, link.tx_rsp_credits,
                  observed.tx_rsp.valid, observed.tx_rsp.bits.opcode,
                  observed.tx_rsp.bits.txn_id, observed.tx_rsp.bits.src_id,
                  observed.tx_rsp.credit,
                  rni_tx_rsp_credit_balance,
                  observed.tx_link_active_request, observed.tx_link_active_ack,
                  rni_tx_previous_request, emitted.rsp,
                  endpoint.node_id, "_source_id", label_prefix ++ "_tx_rsp")
  monitor_chi_dat(link.flit, link.tx_dat_credits,
                  observed.tx_dat.valid, observed.tx_dat.bits.opcode,
                  observed.tx_dat.bits.txn_id, observed.tx_dat.bits.src_id,
                  observed.tx_dat.bits.data_id, observed.tx_dat.credit,
                  rni_tx_dat_credit_balance,
                  observed.tx_link_active_request, observed.tx_link_active_ack,
                  rni_tx_previous_request, emitted.dat,
                  endpoint.node_id, "_source_id", label_prefix ++ "_tx_dat")
  monitor_chi_rsp(link.flit, link.rx_rsp_credits,
                  observed.rx_rsp.valid, observed.rx_rsp.bits.opcode,
                  observed.rx_rsp.bits.txn_id, observed.rx_rsp.bits.tgt_id,
                  observed.rx_rsp.credit,
                  rni_rx_rsp_credit_balance,
                  observed.rx_link_active_request, observed.rx_link_active_ack,
                  rni_rx_previous_request, received.rsp,
                  endpoint.node_id, "_target_id", label_prefix ++ "_rx_rsp")
  monitor_chi_dat(link.flit, link.rx_dat_credits,
                  observed.rx_dat.valid, observed.rx_dat.bits.opcode,
                  observed.rx_dat.bits.txn_id, observed.rx_dat.bits.tgt_id,
                  observed.rx_dat.bits.data_id, observed.rx_dat.credit,
                  rni_rx_dat_credit_balance,
                  observed.rx_link_active_request, observed.rx_link_active_ack,
                  rni_rx_previous_request, received.dat,
                  endpoint.node_id, "_target_id", label_prefix ++ "_rx_dat")
  if transaction_checks && chi_initial_requester_capabilities(emitted, received)
  | requester_transaction_monitor(link.flit,
                                  endpoint.max_outstanding,
                                  label_prefix ++ "_transaction",
                                  observed.tx_req.valid,
                                  observed.tx_req.bits,
                                  observed.rx_rsp.valid,
                                  observed.rx_rsp.bits,
                                  observed.tx_dat.valid,
                                  observed.tx_dat.bits,
                                  observed.rx_dat.valid,
                                  observed.rx_dat.bits)
  | #void
  rni_tx_previous_request <== observed.tx_link_active_request
  rni_tx_previous_ack <== observed.tx_link_active_ack
  rni_rx_previous_request <== observed.rx_link_active_request
  rni_rx_previous_ack <== observed.rx_link_active_ack

// Applies the SN-F/SN-I link and eligible transaction checks to one explicitly
// selected endpoint.
fun monitor_chi_sn(link :: CHISNLinkParams,
                   endpoint :: CHIEndpointParams,
                   port :: Endpoint.of(CHISNLink(link, endpoint)),
                   ~label_prefix: label_prefix :: String = "chi",
                   ~transaction_checks: transaction_checks :: Boolean = #true):
  def observed :: Observation = port.observe()
  def emitted = node_emitted_capabilities(endpoint)
  def received = node_received_capabilities(endpoint)
  reg sn_tx_previous_request(~init: Bool(#false))
  reg sn_tx_previous_ack(~init: Bool(#false))
  reg sn_rx_previous_request(~init: Bool(#false))
  reg sn_rx_previous_ack(~init: Bool(#false))
  reg sn_tx_rsp_credit_balance(~init: bits(0, index_width(link.tx_rsp_credits + 1)))
  reg sn_tx_dat_credit_balance(~init: bits(0, index_width(link.tx_dat_credits + 1)))
  reg sn_rx_req_credit_balance(~init: bits(0, index_width(link.rx_req_credits + 1)))
  reg sn_rx_dat_credit_balance(~init: bits(0, index_width(link.rx_dat_credits + 1)))
  monitor_chi_activation(observed.tx_link_active_request,
                         observed.tx_link_active_ack,
                         sn_tx_previous_request,
                         sn_tx_previous_ack,
                         label_prefix ++ "_tx_link")
  monitor_chi_activation(observed.rx_link_active_request,
                         observed.rx_link_active_ack,
                         sn_rx_previous_request,
                         sn_rx_previous_ack,
                         label_prefix ++ "_rx_link")
  monitor_chi_rsp(link.flit, link.tx_rsp_credits,
                  observed.tx_rsp.valid, observed.tx_rsp.bits.opcode,
                  observed.tx_rsp.bits.txn_id, observed.tx_rsp.bits.src_id,
                  observed.tx_rsp.credit,
                  sn_tx_rsp_credit_balance,
                  observed.tx_link_active_request, observed.tx_link_active_ack,
                  sn_tx_previous_request, emitted.rsp,
                  endpoint.node_id, "_source_id", label_prefix ++ "_tx_rsp")
  monitor_chi_dat(link.flit, link.tx_dat_credits,
                  observed.tx_dat.valid, observed.tx_dat.bits.opcode,
                  observed.tx_dat.bits.txn_id, observed.tx_dat.bits.src_id,
                  observed.tx_dat.bits.data_id, observed.tx_dat.credit,
                  sn_tx_dat_credit_balance,
                  observed.tx_link_active_request, observed.tx_link_active_ack,
                  sn_tx_previous_request, emitted.dat,
                  endpoint.node_id, "_source_id", label_prefix ++ "_tx_dat")
  monitor_chi_req(link.flit, link.rx_req_credits,
                  observed.rx_req.valid, observed.rx_req.bits.opcode,
                  observed.rx_req.bits.txn_id, observed.rx_req.bits.tgt_id,
                  observed.rx_req.bits.size_or_num_req, observed.rx_req.bits.multi_req,
                  observed.rx_req.credit,
                  sn_rx_req_credit_balance,
                  observed.rx_link_active_request, observed.rx_link_active_ack,
                  sn_rx_previous_request, received.req,
                  endpoint.node_id, "_target_id", label_prefix ++ "_rx_req")
  monitor_chi_dat(link.flit, link.rx_dat_credits,
                  observed.rx_dat.valid, observed.rx_dat.bits.opcode,
                  observed.rx_dat.bits.txn_id, observed.rx_dat.bits.tgt_id,
                  observed.rx_dat.bits.data_id, observed.rx_dat.credit,
                  sn_rx_dat_credit_balance,
                  observed.rx_link_active_request, observed.rx_link_active_ack,
                  sn_rx_previous_request, received.dat,
                  endpoint.node_id, "_target_id", label_prefix ++ "_rx_dat")
  if transaction_checks && chi_initial_subordinate_capabilities(emitted, received)
  | subordinate_transaction_monitor(link.flit,
                                    endpoint.max_outstanding,
                                    label_prefix ++ "_transaction",
                                    observed.rx_req.valid,
                                    observed.rx_req.bits,
                                    observed.tx_rsp.valid,
                                    observed.tx_rsp.bits,
                                    observed.rx_dat.valid,
                                    observed.rx_dat.bits,
                                    observed.tx_dat.valid,
                                    observed.tx_dat.bits)
  | #void
  sn_tx_previous_request <== observed.tx_link_active_request
  sn_tx_previous_ack <== observed.tx_link_active_ack
  sn_rx_previous_request <== observed.rx_link_active_request
  sn_rx_previous_ack <== observed.rx_link_active_ack

// Monitors the ready-valid transaction transfers where an HN-I translates
// one transaction leg into the other, independently of physical CHI links.
fun monitor_chi_hni(home :: CHIHomeParams,
                    flit :: CHIFlitParams,
                    upstream_requests :: Endpoint,
                    upstream_request_data :: Endpoint,
                    upstream_responses :: Endpoint,
                    upstream_response_data :: Endpoint,
                    downstream_requests :: Endpoint,
                    downstream_request_data :: Endpoint,
                    downstream_responses :: Endpoint,
                    downstream_response_data :: Endpoint):
  def upstream_request :: Observation = upstream_requests.observe()
  def upstream_write_data :: Observation = upstream_request_data.observe()
  def upstream_response :: Observation = upstream_responses.observe()
  def upstream_read_data :: Observation = upstream_response_data.observe()
  def downstream_request :: Observation = downstream_requests.observe()
  def downstream_write_data :: Observation = downstream_request_data.observe()
  def downstream_response :: Observation = downstream_responses.observe()
  def downstream_read_data :: Observation = downstream_response_data.observe()
  def upstream_request_opcode :: CHIReqOpcode = upstream_request.bits.opcode
  def downstream_request_opcode :: CHIReqOpcode = downstream_request.bits.opcode
  def upstream_request_event = upstream_request.valid & upstream_request.ready & (
    upstream_request_opcode.supports_initial_transaction()
  )
  def downstream_request_event = downstream_request.valid & downstream_request.ready & (
    downstream_request_opcode.supports_initial_transaction()
  )
  def downstream_response_event = downstream_response.valid & downstream_response.ready & (
    downstream_response.bits.opcode.is_one_of(CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp)
  )
  def upstream_response_event = upstream_response.valid & upstream_response.ready & (
    upstream_response.bits.opcode.is_one_of(CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp)
  )
  def upstream_write_data_event = upstream_write_data.valid & upstream_write_data.ready & (
    upstream_write_data.bits.opcode === CHIDatOpcode.NonCopyBackWriteData
  )
  def downstream_write_data_event = downstream_write_data.valid & downstream_write_data.ready & (
    downstream_write_data.bits.opcode === CHIDatOpcode.NonCopyBackWriteData
  )
  def downstream_read_data_event = downstream_read_data.valid & downstream_read_data.ready & (
    downstream_read_data.bits.opcode === CHIDatOpcode.CompData
  )
  def upstream_read_data_event = upstream_read_data.valid & upstream_read_data.ready & (
    upstream_read_data.bits.opcode === CHIDatOpcode.CompData
  )
  home_transaction_monitor(flit,
                           home.node_id,
                           home.max_outstanding,
                           "chi_hni_transaction",
                           upstream_request_event,
                           upstream_request.bits,
                           downstream_request_event,
                           downstream_request.bits,
                           downstream_response_event,
                           downstream_response.bits,
                           upstream_response_event,
                           upstream_response.bits,
                           upstream_write_data_event,
                           upstream_write_data.bits,
                           downstream_write_data_event,
                           downstream_write_data.bits,
                           downstream_read_data_event,
                           downstream_read_data.bits,
                           upstream_read_data_event,
                           upstream_read_data.bits)

export:
  monitor_chi_activation
  monitor_chi_req
  monitor_chi_rsp
  monitor_chi_snp
  monitor_chi_dat
  monitor_chi_rn
  monitor_chi_rni
  monitor_chi_sn
  monitor_chi_hni
