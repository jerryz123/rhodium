#lang rhombus
// Checks host-side initial transaction capability classification and limits.

import:
  "../main.rhdl" as chi
  "../transactions/transaction.rhdl" as transaction
  "transaction-fixture.rhdl" as fixture

check:
  fixture.transaction_rni_node.max_outstanding ~is 2
  fixture.transaction_sn_node.max_outstanding ~is 2
  transaction.chi_initial_requester_capabilities(
    fixture.transaction_rni_node.emits,
    fixture.transaction_rni_node.supports
  ) ~is #true
  transaction.chi_initial_subordinate_capabilities(
    fixture.transaction_sn_node.emits,
    fixture.transaction_sn_node.supports
  ) ~is #true
  chi.chi_initial_coherent_requester_capabilities(
    fixture.transaction_rnf_node.emits,
    fixture.transaction_rnf_node.supports
  ) ~is #true
  transaction.chi_initial_requester_capabilities(
    chi.CHIChannelCapabilities(~req: [chi.CHIReqOpcode.ReadShared]),
    fixture.transaction_rni_node.supports
  ) ~is #false
  chi.chi_initial_coherent_requester_capabilities(
    fixture.transaction_rnf_node.emits,
    chi.CHIChannelCapabilities(
      ~snp: [chi.CHISnpOpcode.SnpShared],
      ~dat: [chi.CHIDatOpcode.CompData]
    )
  ) ~is #false
  chi.CHINodeParams(
    "zero-outstanding",
    4,
    chi.CHINodeKind.RNI,
    ~emits: chi.CHIChannelCapabilities(),
    ~supports: chi.CHIChannelCapabilities(),
    ~max_outstanding: 0
  ) ~throws "Int.in(1 ..= 1024)"
