#lang rhodium
// Elaborates a small inclusive HN-F with two caching peers and partial dirty data.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/interconnect.rhdl").StripedAddressLayout
  lib("chi/main.rhdl") open
  "coherent-home-fixture.rhdl" as base

def inclusive_home_addressing = StripedAddressLayout(
  0x04000000,
  64,
  4
)
def inclusive_home_base_config = CHIHNFConfig(
  base.coherent_home_config.flit,
  for List (endpoint in base.coherent_home_config.requester_endpoints):
    CHIICNPortParams(endpoint.name, endpoint.node_id, endpoint.kind,
                     ~emits: endpoint.emits,
                     ~supports: CHIChannelCapabilities(
                       ~req: endpoint.supports.req ++ (if endpoint.kind == CHINodeKind.RNI | [CHIReqOpcode.WriteNoSnpPtl] | (if endpoint.supports.req.contains(CHIReqOpcode.ReadUnique) | [] | [CHIReqOpcode.ReadUnique])),
                       ~rsp: endpoint.supports.rsp,
                       ~snp: endpoint.supports.snp,
                       ~dat: endpoint.supports.dat ++ (if endpoint.kind == CHINodeKind.RNI | [] | (if endpoint.supports.dat.contains(CHIDatOpcode.SnpRespData) | [CHIDatOpcode.SnpRespDataPtl] | [CHIDatOpcode.SnpRespData, CHIDatOpcode.SnpRespDataPtl]))
                     ),
                     ~max_outstanding: endpoint.max_outstanding),
  inclusive_home_addressing.global_mask,
  base.coherent_home_config.service_requests
)
def inclusive_home_config = CHIInclusiveHNFConfig(
  inclusive_home_base_config,
  inclusive_home_addressing,
  ~sets: 2,
  ~ways: 2
)
def inclusive_home_elaboration = elaborate_with_top(CHIInclusiveHNF(inclusive_home_config))
def inclusive_home_design = inclusive_home_elaboration.design

export:
  inclusive_home_addressing
  inclusive_home_base_config
  inclusive_home_config
  inclusive_home_design
  inclusive_home_elaboration
