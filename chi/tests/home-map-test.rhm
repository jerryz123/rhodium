#lang rhombus
// Checks CHI Home map host lookup and miss behavior.

import:
  "../main.rhdl" as chi

def flit = chi.CHIFlitParams()
def home0 = chi.CHIHomeParams("home-0", 5, chi.CHINodeKind.HNF, ~max_outstanding: 2)
def home1 = chi.CHIHomeParams("home-1", 6, chi.CHINodeKind.HNF, ~max_outstanding: 2)
def home_map = chi.CHIHomeMap(
  flit,
  [chi.CHIHomeMapEntry(chi.AddressSet(0x0000, 0x0fff), home0),
   chi.CHIHomeMapEntry(chi.AddressSet(0x1000, 0x0fff), home1)]
)

check:
  home_map.entry(0x0004).home === home0 ~is #true
  home_map.entry(0x1ffc).home === home1 ~is #true
  home_map.entry(0x2000) ~is #false
