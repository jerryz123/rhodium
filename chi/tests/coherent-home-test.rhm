#lang rhombus
// Checks mixed-requester HN-F host parameters and invalid configurations.

import:
  "../main.rhdl" as chi
  "coherent-home-fixture.rhdl" as fixture

check:
  fixture.coherent_home_params.home.kind ~is chi.CHINodeKind.HNF
  fixture.coherent_home_params.requester_endpoints.length() ~is 3
  fixture.coherent_home_params.snoop_endpoints.length() ~is 2
  fixture.coherent_home_params.subordinate_endpoint.kind ~is chi.CHINodeKind.SNF
  fixture.coherent_home_params.subordinate_endpoint ~is fixture.memory_service.endpoint
  chi.CHIHNFParams(
    fixture.coherent_home_params.home,
    fixture.coherent_home_config,
    chi.CHISubordinateServiceParams(
      fixture.memory_service.endpoint,
      [chi.AddressSet(0x80000000, 63)],
      fixture.memory_service.requests
    )
  ) ~throws "match the HN-F structural configuration"
  chi.CHIHNFParams(
    chi.CHIHomeParams("bad-capacity", 5, chi.CHINodeKind.HNF,
                      ~max_outstanding: 2),
    fixture.coherent_home_config,
    fixture.memory_service
  ) ~throws "exactly one outstanding transaction"

  chi.CHIHNFConfig(fixture.coherent_home_flit,
                   [fixture.htif_endpoint],
                   fixture.memory_service.address_sets[0].mask,
                   fixture.memory_service.requests) ~throws "at least one RN-F requester"

  // A supported maintenance endpoint requires complete line coverage and a
  // backing service capable of accepting complete dirty snoop packets.
  chi.CHIHNFConfig(fixture.coherent_home_flit,
                   fixture.coherent_home_config.requester_endpoints,
                   31,
                   fixture.memory_service.requests) ~throws "complete cache-line"
  chi.CHIHNFConfig(fixture.coherent_home_flit,
                   fixture.coherent_home_config.requester_endpoints,
                   fixture.coherent_home_config.service_mask,
                   [chi.CHIRequestSupport(chi.CHIReqOpcode.ReadNoSnp, chi.TransferSizes(1, 64))]) ~throws "backing writes"
