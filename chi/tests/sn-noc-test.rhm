#lang rhombus
// Checks the two-subordinate CHI NoC compilation and adapter elaboration.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  "sn-noc-fixture.rhdl" as fixture

def fixture_sn_noc_design = compile_program(fixture.sn_noc_program, rtl_target).report.design

check:
  fixture.sn_noc_connections.length() ~is 2
  fixture.sn_noc_compilations.snp ~is #false
  fixture.sn_noc_compilations.req.routes.length() ~is 2
  fixture.sn_noc_compilations.rsp.routes.length() ~is 2
  fixture.sn_noc_compilations.dat.routes.length() ~is 4
  fixture.sn_noc_adapters.req.ejection(
    fixture.sn_noc_first.req.terminal
  ).target_index != fixture.sn_noc_adapters.req.ejection(
    fixture.sn_noc_second.req.terminal
  ).target_index ~is #true
  fixture.sn_noc_adapters.rsp.injection(
    fixture.sn_noc_first.rsp_response.terminal
  ).input_index != fixture.sn_noc_adapters.rsp.injection(
    fixture.sn_noc_second.rsp_response.terminal
  ).input_index ~is #true
  fixture.sn_noc_compilations.req.routes.map(
    fun (route): route.destination.node_id
  ) ~is [9, 10]
  fixture_sn_noc_design.modules.map(fun (module): module.name).contains(
    "CHISNNoCFixture"
  ) ~is #true
  fixture_sn_noc_design.modules.map(fun (module): module.name).contains(
    "CHIReqNoCInjector"
  ) ~is #true
  fixture_sn_noc_design.modules.map(fun (module): module.name).contains(
    "CHIReqNoCEjector"
  ) ~is #true
