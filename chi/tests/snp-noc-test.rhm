#lang rhombus
// Checks SNP-plane compilation and ready-valid adapter elaboration.
// SPDX-License-Identifier: Apache-2.0

import:
  "snp-noc-fixture.rhdl" as fixture

check:
  fixture.snp_noc_compilation.injections.length() ~is 1
  fixture.snp_noc_compilation.ejections.length() ~is 2
  fixture.snp_noc_compilation.routes.length() ~is 2
  fixture.snp_noc_adapter.injections.length() ~is 1
  fixture.snp_noc_adapter.ejections.length() ~is 2
  fixture.snp_noc_adapter.injection(
    fixture.snp_noc_home.snp.terminal
  ).input_index ~is 0
  fixture.snp_noc_adapter.ejection(
    fixture.snp_noc_first.snp.terminal
  ).target_index ~is 0
  fixture.snp_noc_adapter.ejection(
    fixture.snp_noc_second.snp.terminal
  ).target_index ~is 1
  fixture.snp_noc_design.modules.map(fun (module): module.name).contains(
    "CHISnpNoCInjector"
  ) ~is #true
  fixture.snp_noc_design.modules.map(fun (module): module.name).contains(
    "CHISnpNoCEjector"
  ) ~is #true
