#lang rhombus
// Checks declarative CHI response profiles and invalid rule sets.

import:
  lib("chi/main.rhdl") open
  lib("rhodium/core/main.rhm") as core
  "response-profile-fixture.rhdl" as fixture

def write_profile = response_profile("test_write"):
  retryable
  milestone dbid
  milestone completion
  response [CHIRspOpcode.DBIDResp, CHIRspOpcode.DBIDRespOrd]:
    completes [dbid]
  response [CHIRspOpcode.Comp]:
    completes [completion]
  response [CHIRspOpcode.CompDBIDResp]:
    completes [dbid, completion]

check:
  fixture.invalid_effects_design(core.Bits(1)) ~throws "Bits"
  fixture.invalid_effects_design(core.VectorType(2, core.Bits(1))) ~throws "Bits"
  write_profile.effect_width ~is 2
  write_profile.full_effect_mask ~is 3
  write_profile.milestone_index("dbid") ~is 0
  write_profile.milestone_index("completion") ~is 1
  write_profile.milestone_mask("dbid") ~is 1
  write_profile.rule_effect_mask(CHIResponseRule([CHIRspOpcode.CompDBIDResp], ["dbid", "completion"])) ~is 3
  write_profile.rule_effect_mask(CHIResponseRule([CHIRspOpcode.DBIDResp], ["dbid", "dbid"])) ~is 1
  write_profile.milestone_index("missing") ~throws "no such milestone"
  CHIResponseProfile("bad", [""], [], ~retryable: #true) ~throws "NonemptyString"
  CHIResponseRule([CHIRspOpcode.Comp], [""]) ~throws "NonemptyString"
  CHIResponseProfile("retry_only", [], [], ~retryable: #true).effect_width ~is 1
  CHIResponseProfile("retry_only", [], [], ~retryable: #true).full_effect_mask ~is 0
  write_profile.progress_opcodes ~is [
    CHIRspOpcode.DBIDResp,
    CHIRspOpcode.DBIDRespOrd,
    CHIRspOpcode.Comp,
    CHIRspOpcode.CompDBIDResp
  ]
  write_profile.response_opcodes ~is [
    CHIRspOpcode.RetryAck,
    CHIRspOpcode.PCrdGrant,
    CHIRspOpcode.DBIDResp,
    CHIRspOpcode.DBIDRespOrd,
    CHIRspOpcode.Comp,
    CHIRspOpcode.CompDBIDResp
  ]
  chi_response_profile_opcodes([write_profile, write_profile]) ~is write_profile.response_opcodes
  CHIResponseProfile("empty", [], []) ~throws "at least one response"
  CHIResponseProfile(
    "duplicate_milestone",
    ["done", "done"],
    [],
    ~retryable: #true
  ) ~throws "milestone names must be unique"
  CHIResponseProfile(
    "missing_milestone",
    ["done"],
    [CHIResponseRule([CHIRspOpcode.Comp], ["other"])]
  ) ~throws "undeclared milestone"
  CHIResponseProfile(
    "reserved_opcode",
    ["done"],
    [CHIResponseRule([CHIRspOpcode.RetryAck], ["done"])]
  ) ~throws "dedicated clauses"
  CHIResponseProfile(
    "duplicate_opcode",
    ["first", "second"],
    [
      CHIResponseRule([CHIRspOpcode.Comp], ["first"]),
      CHIResponseRule([CHIRspOpcode.Comp], ["second"])
    ]
  ) ~throws "unique across rules"
