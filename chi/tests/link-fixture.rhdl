#lang rhodium
// Provides legal and monitored RN-I, RN-F, and SN-F link fixtures.

import:
  lib("chi/main.rhdl") open

def flit = CHIFlitParams()

def rni_node = CHINodeParams(
  "requester",
  3,
  CHINodeKind.RNI,
  ~emits: CHIChannelCapabilities(
    ~req: [CHIReqOpcode.ReadNoSnp],
    ~rsp: [CHIRspOpcode.CompAck],
    ~dat: [CHIDatOpcode.NonCopyBackWriteData]
  ),
  ~supports: CHIChannelCapabilities(
    ~rsp: [CHIRspOpcode.Comp, CHIRspOpcode.DBIDResp],
    ~dat: [CHIDatOpcode.CompData]
  ),
  ~max_outstanding: 4
)
def rni_icn = CHIICNPortParams(
  "requester-port",
  3,
  CHINodeKind.RNI,
  ~emits: CHIChannelCapabilities(
    ~rsp: [CHIRspOpcode.Comp, CHIRspOpcode.DBIDResp],
    ~dat: [CHIDatOpcode.CompData]
  ),
  ~supports: CHIChannelCapabilities(
    ~req: [CHIReqOpcode.ReadNoSnp, CHIReqOpcode.WriteNoSnpFull],
    ~rsp: [CHIRspOpcode.CompAck],
    ~dat: [CHIDatOpcode.NonCopyBackWriteData]
  ),
  ~max_outstanding: 4
)
def rni_link = CHIRNILinkParams(flit, ~tx_req_credits: 4, ~rx_dat_credits: 3)

def rnf_node = CHINodeParams(
  "cache",
  5,
  CHINodeKind.RNF,
  ~emits: CHIChannelCapabilities(
    ~req: [CHIReqOpcode.ReadShared],
    ~rsp: [CHIRspOpcode.CompAck,
           CHIRspOpcode.SnpResp,
           CHIRspOpcode.SnpRespFwded],
    ~dat: [CHIDatOpcode.SnpRespData,
           CHIDatOpcode.SnpRespDataPtl,
           CHIDatOpcode.SnpRespDataFwded,
           CHIDatOpcode.CompData]
  ),
  ~supports: CHIChannelCapabilities(
    ~snp: chi_rnf_snoop_opcodes,
    ~dat: [CHIDatOpcode.CompData]
  ),
  ~max_outstanding: 8
)
def rnf_icn = CHIICNPortParams(
  "cache-port",
  5,
  CHINodeKind.RNF,
  ~emits: rnf_node.supports,
  ~supports: rnf_node.emits,
  ~max_outstanding: 8
)
def rnf_link = CHIRNLinkParams(flit, ~rx_snp_credits: 4)

def sn_node = CHINodeParams(
  "memory",
  9,
  CHINodeKind.SNF,
  ~emits: CHIChannelCapabilities(
    ~rsp: [CHIRspOpcode.Comp, CHIRspOpcode.DBIDResp],
    ~dat: [CHIDatOpcode.CompData]
  ),
  ~supports: CHIChannelCapabilities(
    ~req: [CHIReqOpcode.ReadNoSnp, CHIReqOpcode.WriteNoSnpFull],
    ~dat: [CHIDatOpcode.NonCopyBackWriteData]
  ),
  ~max_outstanding: 4
)
def sn_icn = CHIICNPortParams(
  "memory-port",
  9,
  CHINodeKind.SNF,
  ~emits: CHIChannelCapabilities(
    ~req: [CHIReqOpcode.ReadNoSnp],
    ~dat: [CHIDatOpcode.NonCopyBackWriteData]
  ),
  ~supports: CHIChannelCapabilities(
    ~rsp: [CHIRspOpcode.Comp, CHIRspOpcode.DBIDResp, CHIRspOpcode.RetryAck],
    ~dat: [CHIDatOpcode.CompData]
  ),
  ~max_outstanding: 4
)
def sn_link = CHISNLinkParams(flit, ~rx_req_credits: 4, ~tx_dat_credits: 3)

circuit CHIRNILinkAdapter(node_link :: CHIRNILinkParams,
                          node :: CHINodeParams,
                          icn_link :: CHIRNILinkParams,
                          icn :: CHIICNPortParams):
  interface ingress(CHIRNILink(node_link, node), ~role: icn)
  interface egress(CHIRNILink(icn_link, icn), ~role: node)
  egress <=> ingress

circuit CHIRNLinkAdapter(node_link :: CHIRNLinkParams,
                         node :: CHINodeParams,
                         icn_link :: CHIRNLinkParams,
                         icn :: CHIICNPortParams):
  interface ingress(CHIRNLink(node_link, node), ~role: icn)
  interface egress(CHIRNLink(icn_link, icn), ~role: node)
  egress <=> ingress

circuit CHISNLinkAdapter(node_link :: CHISNLinkParams,
                         node :: CHINodeParams,
                         icn_link :: CHISNLinkParams,
                         icn :: CHIICNPortParams):
  interface ingress(CHISNLink(node_link, node), ~role: icn)
  interface egress(CHISNLink(icn_link, icn), ~role: node)
  egress <=> ingress

sync_circuit MonitoredCHIRNI(~transaction_checks: transaction_checks :: Boolean = #false):
  input tx_link_active_request: Bool
  input rx_link_active_ack: Bool
  input tx_req_valid: Bool
  input tx_req_bits: CHIReqFlit(flit)
  input tx_rsp_valid: Bool
  input tx_rsp_bits: CHIRspFlit(flit)
  input tx_dat_valid: Bool
  input tx_dat_bits: CHIDatFlit(flit)
  input rx_rsp_credit: Bool
  input rx_dat_credit: Bool
  interface port(CHIRNILink(rni_link, rni_node), ~role: node)

  port.tx_link_active_request <== tx_link_active_request
  port.rx_link_active_ack <== rx_link_active_ack
  port.tx_req.valid <== tx_req_valid
  port.tx_req.bits <== tx_req_bits
  port.tx_rsp.valid <== tx_rsp_valid
  port.tx_rsp.bits <== tx_rsp_bits
  port.tx_dat.valid <== tx_dat_valid
  port.tx_dat.bits <== tx_dat_bits
  port.rx_rsp.credit <== rx_rsp_credit
  port.rx_dat.credit <== rx_dat_credit
  monitor_chi_rni(rni_link, rni_node, port, ~transaction_checks: transaction_checks)

sync_circuit MonitoredCHIRN():
  input tx_link_active_request: Bool
  input rx_link_active_ack: Bool
  input tx_req_valid: Bool
  input tx_req_bits: CHIReqFlit(flit)
  input tx_rsp_valid: Bool
  input tx_rsp_bits: CHIRspFlit(flit)
  input tx_dat_valid: Bool
  input tx_dat_bits: CHIDatFlit(flit)
  input rx_rsp_credit: Bool
  input rx_dat_credit: Bool
  input rx_snp_credit: Bool
  interface port(CHIRNLink(rnf_link, rnf_node), ~role: node)

  port.tx_link_active_request <== tx_link_active_request
  port.rx_link_active_ack <== rx_link_active_ack
  port.tx_req.valid <== tx_req_valid
  port.tx_req.bits <== tx_req_bits
  port.tx_rsp.valid <== tx_rsp_valid
  port.tx_rsp.bits <== tx_rsp_bits
  port.tx_dat.valid <== tx_dat_valid
  port.tx_dat.bits <== tx_dat_bits
  port.rx_rsp.credit <== rx_rsp_credit
  port.rx_dat.credit <== rx_dat_credit
  port.rx_snp.credit <== rx_snp_credit
  monitor_chi_rn(rnf_link, rnf_node, port)

sync_circuit MonitoredCHISN():
  input tx_link_active_request: Bool
  input rx_link_active_ack: Bool
  input tx_rsp_valid: Bool
  input tx_rsp_bits: CHIRspFlit(flit)
  input tx_dat_valid: Bool
  input tx_dat_bits: CHIDatFlit(flit)
  input rx_req_credit: Bool
  input rx_dat_credit: Bool
  interface port(CHISNLink(sn_link, sn_node), ~role: node)

  port.tx_link_active_request <== tx_link_active_request
  port.rx_link_active_ack <== rx_link_active_ack
  port.tx_rsp.valid <== tx_rsp_valid
  port.tx_rsp.bits <== tx_rsp_bits
  port.tx_dat.valid <== tx_dat_valid
  port.tx_dat.bits <== tx_dat_bits
  port.rx_req.credit <== rx_req_credit
  port.rx_dat.credit <== rx_dat_credit
  monitor_chi_sn(sn_link, sn_node, port)

def rni_design = elaborate(CHIRNILinkAdapter(rni_link, rni_node, rni_link, rni_icn))
def rnf_design = elaborate(CHIRNLinkAdapter(rnf_link, rnf_node, rnf_link, rnf_icn))
def sn_design = elaborate(CHISNLinkAdapter(sn_link, sn_node, sn_link, sn_icn))
def monitored_rni_design = elaborate(MonitoredCHIRNI())
def monitored_rnf_design = elaborate(MonitoredCHIRN())
def monitored_sn_design = elaborate(MonitoredCHISN())

fun link_monitor_design(transaction_checks :: Boolean):
  elaborate(MonitoredCHIRNI(~transaction_checks: transaction_checks))

export:
  link_monitor_design
  flit
  rni_node
  rni_icn
  rni_link
  rnf_node
  rnf_icn
  rnf_link
  sn_node
  sn_icn
  sn_link
  CHIRNILinkAdapter
  CHIRNLinkAdapter
  CHISNLinkAdapter
  MonitoredCHIRNI
  MonitoredCHIRN
  MonitoredCHISN
  rni_design
  rnf_design
  sn_design
  monitored_rni_design
  monitored_rnf_design
  monitored_sn_design
