#lang rhodium
// Rejects a CHI connection whose node and ICN port disagree on outstanding capacity.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("chi/main.rhdl") open
  "../link-fixture.rhdl" as fixture

def icn = CHIICNPortParams(
  "requester-port",
  fixture.rni_node.node_id,
  CHINodeKind.RNI,
  ~emits: fixture.rni_icn.emits,
  ~supports: fixture.rni_icn.supports,
  ~max_outstanding: fixture.rni_node.max_outstanding + 1
)
def design = elaborate(
  fixture.CHIRNILinkAdapter(fixture.rni_link,
                            fixture.rni_node,
                            fixture.rni_link,
                            icn)
)
