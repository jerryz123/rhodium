import:
  lib("chi/main.rhdl") open
  "../link-fixture.rhdl" as fixture

def flit = CHIFlitParams()
def node_link = CHIRNILinkParams(flit, ~tx_req_credits: 2)
def icn_link = CHIRNILinkParams(flit, ~tx_req_credits: 3)
def design = elaborate(
  fixture.CHIRNILinkAdapter(node_link,
                            fixture.rni_node,
                            icn_link,
                            fixture.rni_icn)
)
