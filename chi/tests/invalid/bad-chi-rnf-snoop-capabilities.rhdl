#lang rhodium
// Rejects an RN-F endpoint that omits mandatory ordinary snoop opcodes.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("chi/main.rhdl") open

def node = CHINodeParams(
  "incomplete-cache",
  5,
  CHINodeKind.RNF,
  ~emits: CHIChannelCapabilities(),
  ~supports: CHIChannelCapabilities(~snp: [CHISnpOpcode.SnpShared]),
  ~max_outstanding: 1
)
