#lang rhodium
// Rejects a CHI connection whose node and ICN port disagree on the NodeID.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("chi/main.rhdl") open
  "../link-fixture.rhdl" as fixture

def icn = CHIICNPortParams(
  "wrong-port",
  4,
  CHINodeKind.RNI,
  ~emits: fixture.rni_icn.emits,
  ~supports: fixture.rni_icn.supports,
  ~max_outstanding: fixture.rni_icn.max_outstanding
)
def design = elaborate(
  fixture.CHIRNILinkAdapter(fixture.rni_link,
                            fixture.rni_node,
                            fixture.rni_link,
                            icn)
)
