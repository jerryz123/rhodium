#lang rhodium
// Rejects an RN-I request opcode that its connected ICN port does not accept.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("chi/main.rhdl") open
  "../link-fixture.rhdl" as fixture

def node = CHINodeParams(
  "requester",
  3,
  CHINodeKind.RNI,
  ~emits: CHIChannelCapabilities(~req: [CHIReqOpcode.ReadNoSnp]),
  ~supports: CHIChannelCapabilities(),
  ~max_outstanding: 1
)
def icn = CHIICNPortParams(
  "requester-port",
  3,
  CHINodeKind.RNI,
  ~emits: CHIChannelCapabilities(),
  ~supports: CHIChannelCapabilities(),
  ~max_outstanding: 1
)
def link = CHIRNILinkParams(CHIFlitParams())
def design = elaborate(fixture.CHIRNILinkAdapter(link, node, link, icn))
