#lang rhodium
// Rejects different CHI feature selections even when the RN-I wire shape is identical.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("chi/main.rhdl") open
  "../link-fixture.rhdl" as fixture

def node_link = CHIRNILinkParams(CHIFlitParams(
  ~mecid_width: 16,
  ~stream_id_width: 16,
  ~sec_sid_width: 1
))
def icn_link = CHIRNILinkParams(CHIFlitParams(
  ~stream_id_width: 16,
  ~sec_sid_width: 1
))
def design = elaborate(
  fixture.CHIRNILinkAdapter(node_link,
                            fixture.rni_node,
                            icn_link,
                            fixture.rni_icn)
)
