import:
  "../../../rhodium/backend/circt.rhm" open
  "../../../rhodium/core/types.rhm".Bits
  "../../../rhodium/frontend/kernel.rhm" as embedded
  "../../../chi/transactions/read-once.rhdl" open
  "../../../chi/protocol/params.rhdl".CHIFlitParams

def design = embedded.run_elaboration(
  fun (): CHIReadOnce(CHIFlitParams(~poison: #true), Bits(8))
)
print(emit_circt(design))
