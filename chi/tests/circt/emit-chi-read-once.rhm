#lang rhombus
// Defines the reusable complete-line CHI ReadOnce requester.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../rhodium/core/types.rhm".Bits
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../chi/transactions/read-once.rhdl" open
  "../../../chi/protocol/params.rhdl".CHIFlitParams

def program = elaborate(CHIReadOnce(CHIFlitParams(~poison: #true), Bits(8))
)
export program
