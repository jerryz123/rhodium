#lang rhombus
// Defines a program for the declarative retryable CHI transaction controller.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("chi/main.rhdl") open

def profile = response_profile("retryable_transaction_fixture"):
  retryable
  milestone dbid
  milestone completion
  response [CHIRspOpcode.DBIDResp, CHIRspOpcode.DBIDRespOrd]:
    completes [dbid]
  response [CHIRspOpcode.Comp]:
    completes [completion]
  response [CHIRspOpcode.CompDBIDResp]:
    completes [dbid, completion]

def program = elaborate(CHIRetryableTransactionControl(CHIFlitParams(), profile)
)

export program
