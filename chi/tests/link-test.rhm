#lang rhombus
// Checks CHI endpoint contracts and structural link equality, including every credit-field mismatch.

import:
  "../main.rhdl" as chi
  "link-fixture.rhdl" as fixture

def rni = chi.CHIRNILink(fixture.rni_link, fixture.rni_node)
def rnf = chi.CHIRNLink(fixture.rnf_link, fixture.rnf_node)
def sn = chi.CHISNLink(fixture.sn_link, fixture.sn_node)
def tx_req = rni.members.find(fun (member): member.name == "tx_req")
def rx_rsp = rni.members.find(fun (member): member.name == "rx_rsp")

check:
  chi.CHIChannelCapabilities().is_dvm_snoop_only() ~is #true
  chi.CHIChannelCapabilities(~snp: [chi.CHISnpOpcode.SnpDVMOp]).is_dvm_snoop_only() ~is #true
  chi.CHIChannelCapabilities(~snp: [chi.CHISnpOpcode.SnpDVMOp, chi.CHISnpOpcode.SnpShared]).is_dvm_snoop_only() ~is #false

// Construct each side independently: equality must include the nested flit
// parameters and every credit field, not object identity or selected fields.
fun rnf_with_mismatch(changed :: Int):
  chi.CHIRNLinkParams(
    chi.CHIFlitParams(~data_width: if changed == 0 | 256 | 128),
    ~tx_req_credits: if changed == 1 | 3 | 2,
    ~tx_rsp_credits: if changed == 2 | 3 | 2,
    ~tx_dat_credits: if changed == 3 | 3 | 2,
    ~rx_rsp_credits: if changed == 4 | 3 | 2,
    ~rx_dat_credits: if changed == 5 | 3 | 2,
    ~rx_snp_credits: if changed == 6 | 3 | 2
  )

fun rni_with_mismatch(changed :: Int):
  chi.CHIRNILinkParams(
    chi.CHIFlitParams(~data_width: if changed == 0 | 256 | 128),
    ~tx_req_credits: if changed == 1 | 3 | 2,
    ~tx_rsp_credits: if changed == 2 | 3 | 2,
    ~tx_dat_credits: if changed == 3 | 3 | 2,
    ~rx_rsp_credits: if changed == 4 | 3 | 2,
    ~rx_dat_credits: if changed == 5 | 3 | 2
  )

fun sn_with_mismatch(changed :: Int):
  chi.CHISNLinkParams(
    chi.CHIFlitParams(~data_width: if changed == 0 | 256 | 128),
    ~tx_rsp_credits: if changed == 1 | 3 | 2,
    ~tx_dat_credits: if changed == 2 | 3 | 2,
    ~rx_req_credits: if changed == 3 | 3 | 2,
    ~rx_dat_credits: if changed == 4 | 3 | 2
  )

for (entry in [[rnf, fixture.rnf_node, 7, rnf_with_mismatch],
               [rni, fixture.rni_node, 6, rni_with_mismatch],
               [sn, fixture.sn_node, 5, sn_with_mismatch]]):
  def compatible = entry[0].connection_compatibility.predicate
  def node = entry[1]
  def construct = entry[3]
  def baseline = construct(-1)
  check:
    baseline == construct(-1) ~is #true
    compatible([baseline, node], [construct(-1), node.icn_peer()]) ~is #true
  for (changed in 0..entry[2]):
    def different = construct(changed)
    check:
      baseline == different ~is #false
      compatible([baseline, node], [different, node.icn_peer()]) ~is #false
      compatible([different, node], [baseline, node.icn_peer()]) ~is #false

for (node in [fixture.rni_node, fixture.rnf_node, fixture.sn_node]):
  def peer = node.icn_peer()
  check:
    peer.name ~is node.name ++ "-icn"
    peer.node_id ~is node.node_id
    peer.kind ~is node.kind
    peer.emits ~is node.supports
    peer.supports ~is node.emits
    peer.max_outstanding ~is node.max_outstanding
    peer ~is node.icn_peer()
for (entry in [[rni, fixture.rni_link, fixture.rni_node],
               [rnf, fixture.rnf_link, fixture.rnf_node],
               [sn, fixture.sn_link, fixture.sn_node]]):
  def interface = entry[0]
  def link = entry[1]
  def node = entry[2]
  def wrong_node = chi.CHINodeParams(node.name, node.node_id + 1, node.kind,
                                     ~emits: node.emits, ~supports: node.supports,
                                     ~max_outstanding: node.max_outstanding)
  check:
    interface.connection_compatibility.predicate([link, node], [link, node.icn_peer()]) ~is #true
    interface.connection_compatibility.predicate([link, node], [link, wrong_node.icn_peer()]) ~is #false
check:
  fixture.rni_node.kind ~is chi.CHINodeKind.RNI
  fixture.rni_node.node_id ~is 3
  fixture.rni_node.emits.req.map(fun (opcode): opcode.packed_value()) ~is [0x04]
  fixture.rni_node.emits.req.contains(chi.CHIReqOpcode.ReadNoSnp) ~is #true
  fixture.rni_icn.supports.req.map(fun (opcode): opcode.packed_value()) ~is [0x04, 0x1d]
  fixture.rni_link.tx_req_credits ~is 4
  fixture.rni_link.rx_dat_credits ~is 3
  fixture.flit == chi.CHIFlitParams() ~is #true
  chi.CHINodeParams(
    "negative-node-id",
    -1,
    chi.CHINodeKind.RNI,
    ~emits: chi.CHIChannelCapabilities(),
    ~supports: chi.CHIChannelCapabilities(),
    ~max_outstanding: 1
  ) ~throws "Nat"
  chi.CHIRNILinkParams(fixture.flit, ~tx_req_credits: 0) ~throws "PosInt"
  chi.CHINodeParams(
    "string-kind",
    3,
    "RN-I",
    ~emits: chi.CHIChannelCapabilities(),
    ~supports: chi.CHIChannelCapabilities(),
    ~max_outstanding: 1
  ) ~throws "CHINodeKind"
  chi.CHINodeParams(
    "dvm-requester",
    6,
    chi.CHINodeKind.RND,
    ~emits: chi.CHIChannelCapabilities(),
    ~supports: chi.CHIChannelCapabilities(~snp: [chi.CHISnpOpcode.SnpShared]),
    ~max_outstanding: 1
  ) ~throws "channel capabilities are not valid"
  chi.CHINodeParams(
    "incomplete-rnf",
    7,
    chi.CHINodeKind.RNF,
    ~emits: chi.CHIChannelCapabilities(),
    ~supports: chi.CHIChannelCapabilities(~snp: [chi.CHISnpOpcode.SnpShared]),
    ~max_outstanding: 1
  ) ~throws "channel capabilities are not valid"
  chi.CHINodeParams(
    "too-many-outstanding",
    3,
    chi.CHINodeKind.RNI,
    ~emits: chi.CHIChannelCapabilities(),
    ~supports: chi.CHIChannelCapabilities(),
    ~max_outstanding: 1025
  ) ~throws "Int.in(1 ..= 1024)"
  rni.roles ~is ["node", "icn"]
  rni.provider_role ~is "node"
  rni.members.map(fun (member): member.name) ~is [
    "tx_link_active_request",
    "rx_link_active_ack",
    "tx_req",
    "tx_rsp",
    "tx_dat",
    "tx_link_active_ack",
    "rx_link_active_request",
    "rx_rsp",
    "rx_dat"
  ]
  tx_req.from_role ~is "node"
  rx_rsp.from_role ~is "icn"
  tx_req.type.name ~is "Credited"
  tx_req.type.specialization_arguments[1] ~is 4
  tx_req.type.members.map(fun (member): member.name) ~is ["valid", "bits", "credit"]
  rnf.members.map(fun (member): member.name).contains("rx_snp") ~is #true
  rnf.members.find(fun (member): member.name == "rx_snp").type.specialization_arguments[1] ~is 4
  sn.members.map(fun (member): member.name) ~is [
    "tx_link_active_request",
    "rx_link_active_ack",
    "tx_rsp",
    "tx_dat",
    "tx_link_active_ack",
    "rx_link_active_request",
    "rx_req",
    "rx_dat"
  ]
  sn.members.find(fun (member): member.name == "rx_req").from_role ~is "icn"
