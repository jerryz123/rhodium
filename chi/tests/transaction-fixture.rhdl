#lang rhodium
// Provides monitored initial RN-I, RN-F, and SN-F transaction fixtures.

import:
  lib("chi/main.rhdl") open

def transaction_flit = CHIFlitParams()

def transaction_rni_node = CHINodeParams(
  "transaction-requester",
  3,
  CHINodeKind.RNI,
  ~emits: CHIChannelCapabilities(
    ~req: [CHIReqOpcode.ReadNoSnp,
           CHIReqOpcode.WriteNoSnpFull,
           CHIReqOpcode.WriteNoSnpPtl],
    ~dat: [CHIDatOpcode.NonCopyBackWriteData]
  ),
  ~supports: CHIChannelCapabilities(
    ~rsp: [CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp],
    ~dat: [CHIDatOpcode.CompData]
  ),
  ~max_outstanding: 2
)
def transaction_rni_link = CHIRNILinkParams(
  transaction_flit,
  ~tx_req_credits: 2,
  ~tx_rsp_credits: 1,
  ~tx_dat_credits: 1,
  ~rx_rsp_credits: 2,
  ~rx_dat_credits: 1
)

def transaction_sn_node = CHINodeParams(
  "transaction-memory",
  9,
  CHINodeKind.SNF,
  ~emits: CHIChannelCapabilities(
    ~rsp: [CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp],
    ~dat: [CHIDatOpcode.CompData]
  ),
  ~supports: CHIChannelCapabilities(
    ~req: [CHIReqOpcode.ReadNoSnp,
           CHIReqOpcode.WriteNoSnpFull,
           CHIReqOpcode.WriteNoSnpPtl],
    ~dat: [CHIDatOpcode.NonCopyBackWriteData]
  ),
  ~max_outstanding: 2
)
def transaction_sn_link = CHISNLinkParams(
  transaction_flit,
  ~tx_rsp_credits: 2,
  ~tx_dat_credits: 1,
  ~rx_req_credits: 2,
  ~rx_dat_credits: 1
)

def transaction_rnf_node = CHINodeParams(
  "transaction-coherent-requester",
  5,
  CHINodeKind.RNF,
  ~emits: CHIChannelCapabilities(
    ~req: [CHIReqOpcode.ReadShared, CHIReqOpcode.WriteBackFull],
    ~rsp: [CHIRspOpcode.CompAck,
           CHIRspOpcode.SnpResp,
           CHIRspOpcode.SnpRespFwded],
    ~dat: [CHIDatOpcode.SnpRespData,
           CHIDatOpcode.SnpRespDataPtl,
           CHIDatOpcode.SnpRespDataFwded,
           CHIDatOpcode.CopyBackWriteData,
           CHIDatOpcode.CompData]
  ),
  ~supports: CHIChannelCapabilities(
    ~rsp: [CHIRspOpcode.CompDBIDResp],
    ~snp: chi_rnf_snoop_opcodes,
    ~dat: [CHIDatOpcode.CompData]
  ),
  ~max_outstanding: 2
)
def transaction_rnf_link = CHIRNLinkParams(transaction_flit)

sync_circuit MonitoredInitialCHIRNI():
  input tx_link_active_request: Bool
  input rx_link_active_ack: Bool
  input tx_req_valid: Bool
  input tx_req_bits: CHIReqFlit(transaction_flit)
  input tx_dat_valid: Bool
  input tx_dat_bits: CHIDatFlit(transaction_flit)
  input rx_rsp_credit: Bool
  input rx_dat_credit: Bool
  interface port(CHIRNILink(transaction_rni_link, transaction_rni_node), ~role: node)

  port.tx_link_active_request <== tx_link_active_request
  port.rx_link_active_ack <== rx_link_active_ack
  port.tx_req.valid <== tx_req_valid
  port.tx_req.bits <== tx_req_bits
  port.tx_rsp.valid <== Bool(#false)
  port.tx_rsp.bits <== literal(CHIRspFlit(transaction_flit), 0)
  port.tx_dat.valid <== tx_dat_valid
  port.tx_dat.bits <== tx_dat_bits
  port.rx_rsp.credit <== rx_rsp_credit
  port.rx_dat.credit <== rx_dat_credit
  monitor_chi_rni(transaction_rni_link, transaction_rni_node, port)

  // The same transfers exercise the transport-independent attachment.
  def mirror :: Handle = interface_link(CHIRNIChannels(transaction_flit), "mirror")
  mirror.right.req.valid <== port.tx_req.valid
  mirror.right.req.bits <== port.tx_req.bits
  mirror.left.req.ready <== Bool(#true)
  mirror.right.rsp.requester.valid <== port.tx_rsp.valid
  mirror.right.rsp.requester.bits <== port.tx_rsp.bits
  mirror.left.rsp.requester.ready <== Bool(#true)
  mirror.right.dat.request.valid <== port.tx_dat.valid
  mirror.right.dat.request.bits <== port.tx_dat.bits
  mirror.left.dat.request.ready <== Bool(#true)
  mirror.left.rsp.response.valid <== port.rx_rsp.valid
  mirror.left.rsp.response.bits <== port.rx_rsp.bits
  mirror.right.rsp.response.ready <== Bool(#true)
  mirror.left.dat.response.valid <== port.rx_dat.valid
  mirror.left.dat.response.bits <== port.rx_dat.bits
  mirror.right.dat.response.ready <== Bool(#true)
  monitor_chi_rni_channels(transaction_flit, transaction_rni_node, mirror.left, ~label_prefix: "ready")

sync_circuit MonitoredInitialCHISN():
  input tx_link_active_request: Bool
  input rx_link_active_ack: Bool
  input tx_rsp_valid: Bool
  input tx_rsp_bits: CHIRspFlit(transaction_flit)
  input tx_dat_valid: Bool
  input tx_dat_bits: CHIDatFlit(transaction_flit)
  input rx_req_credit: Bool
  input rx_dat_credit: Bool
  interface port(CHISNLink(transaction_sn_link, transaction_sn_node), ~role: node)

  port.tx_link_active_request <== tx_link_active_request
  port.rx_link_active_ack <== rx_link_active_ack
  port.tx_rsp.valid <== tx_rsp_valid
  port.tx_rsp.bits <== tx_rsp_bits
  port.tx_dat.valid <== tx_dat_valid
  port.tx_dat.bits <== tx_dat_bits
  port.rx_req.credit <== rx_req_credit
  port.rx_dat.credit <== rx_dat_credit
  monitor_chi_sn(transaction_sn_link, transaction_sn_node, port)

  // The same transfers exercise the transport-independent attachment.
  def mirror :: Handle = interface_link(CHISNChannels(transaction_flit), "mirror")
  mirror.left.req.valid <== port.rx_req.valid
  mirror.left.req.bits <== port.rx_req.bits
  mirror.right.req.ready <== Bool(#true)
  mirror.left.dat.request.valid <== port.rx_dat.valid
  mirror.left.dat.request.bits <== port.rx_dat.bits
  mirror.right.dat.request.ready <== Bool(#true)
  mirror.right.rsp.valid <== port.tx_rsp.valid
  mirror.right.rsp.bits <== port.tx_rsp.bits
  mirror.left.rsp.ready <== Bool(#true)
  mirror.right.dat.response.valid <== port.tx_dat.valid
  mirror.right.dat.response.bits <== port.tx_dat.bits
  mirror.left.dat.response.ready <== Bool(#true)
  monitor_chi_sn_channels(transaction_flit, transaction_sn_node, mirror.left, ~label_prefix: "ready")

sync_circuit MonitoredInitialCHIRNF():
  input tx_link_active_request: Bool
  input rx_link_active_ack: Bool
  input tx_req_valid: Bool
  input tx_req_bits: CHIReqFlit(transaction_flit)
  input tx_rsp_valid: Bool
  input tx_rsp_bits: CHIRspFlit(transaction_flit)
  input tx_dat_valid: Bool
  input tx_dat_bits: CHIDatFlit(transaction_flit)
  input rx_rsp_credit: Bool
  input rx_dat_credit: Bool
  input rx_snp_credit: Bool
  interface port(CHIRNLink(transaction_rnf_link, transaction_rnf_node), ~role: node)

  port.tx_link_active_request <== tx_link_active_request
  port.rx_link_active_ack <== rx_link_active_ack
  port.tx_req.valid <== tx_req_valid
  port.tx_req.bits <== tx_req_bits
  port.tx_rsp.valid <== tx_rsp_valid
  port.tx_rsp.bits <== tx_rsp_bits
  port.tx_dat.valid <== tx_dat_valid
  port.tx_dat.bits <== tx_dat_bits
  port.rx_rsp.credit <== rx_rsp_credit
  port.rx_dat.credit <== rx_dat_credit
  port.rx_snp.credit <== rx_snp_credit
  monitor_chi_rn(transaction_rnf_link, transaction_rnf_node, port)

  // The same transfers exercise the transport-independent attachment.
  def mirror :: Handle = interface_link(CHIRNChannels(transaction_flit), "mirror")
  mirror.right.requests.valid <== port.tx_req.valid
  mirror.right.requests.bits <== port.tx_req.bits
  mirror.left.requests.ready <== Bool(#true)
  mirror.right.requester_responses.valid <== port.tx_rsp.valid
  mirror.right.requester_responses.bits <== port.tx_rsp.bits
  mirror.left.requester_responses.ready <== Bool(#true)
  mirror.right.request_data.valid <== port.tx_dat.valid
  mirror.right.request_data.bits <== port.tx_dat.bits
  mirror.left.request_data.ready <== Bool(#true)
  mirror.left.responses.valid <== port.rx_rsp.valid
  mirror.left.responses.bits <== port.rx_rsp.bits
  mirror.right.responses.ready <== Bool(#true)
  mirror.left.response_data.valid <== port.rx_dat.valid
  mirror.left.response_data.bits <== port.rx_dat.bits
  mirror.right.response_data.ready <== Bool(#true)
  mirror.left.snoops.valid <== port.rx_snp.valid
  mirror.left.snoops.bits <== port.rx_snp.bits
  mirror.right.snoops.ready <== Bool(#true)
  monitor_chi_rn_channels(transaction_flit, transaction_rnf_node, mirror.left, ~label_prefix: "ready")

def transaction_rni_design = elaborate(MonitoredInitialCHIRNI())
def transaction_sn_design = elaborate(MonitoredInitialCHISN())
def transaction_rnf_design = elaborate(MonitoredInitialCHIRNF())

export:
  transaction_flit
  transaction_rni_node
  transaction_rni_link
  transaction_sn_node
  transaction_sn_link
  transaction_rnf_node
  transaction_rnf_link
  MonitoredInitialCHIRNI
  MonitoredInitialCHISN
  MonitoredInitialCHIRNF
  transaction_rni_design
  transaction_sn_design
  transaction_rnf_design
