#lang rhombus
// Checks CHI fabric services, executable Home selection, and subordinate metadata.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus.bits.(<<) as <<
  "../main.rhdl" as chi

def flit = chi.CHIFlitParams()
def read_support = chi.CHIRequestSupport(
  chi.CHIReqOpcode.ReadNoSnp,
  chi.TransferSizes(1, 64)
)
def write_support = chi.CHIRequestSupport(
  chi.CHIReqOpcode.WriteNoSnpFull,
  chi.TransferSizes(4, 32)
)
def requester = chi.CHIICNPortParams(
  "requester-port",
  3,
  chi.CHINodeKind.RNI,
  ~emits: chi.CHIChannelCapabilities(),
  ~supports: chi.CHIChannelCapabilities(
    ~req: [chi.CHIReqOpcode.ReadNoSnp, chi.CHIReqOpcode.WriteNoSnpFull]
  ),
  ~max_outstanding: 4
)
def memory = chi.CHIICNPortParams(
  "memory-port",
  9,
  chi.CHINodeKind.SNI,
  ~emits: chi.CHIChannelCapabilities(
    ~req: [chi.CHIReqOpcode.ReadNoSnp, chi.CHIReqOpcode.WriteNoSnpFull]
  ),
  ~supports: chi.CHIChannelCapabilities(),
  ~max_outstanding: 4
)
def requester_port = chi.CHIFabricPortParams(
  requester,
  chi.CHIRNILinkParams(flit)
)
def memory_port = chi.CHIFabricPortParams(memory, chi.CHISNLinkParams(flit))
def memory_service = chi.CHISubordinateServiceParams(
  memory,
  [chi.AddressSet(0x80000000, 0x0fffffff)],
  [read_support, write_support]
)
def home = chi.CHIHomeParams(
  "io-home",
  5,
  chi.CHINodeKind.HNI,
  ~max_outstanding: 4
)
def home_service = chi.CHIHomeServiceParams(
  home,
  [chi.AddressSet(0x80000000, 0x0fffffff)],
  [read_support, write_support]
)
def fabric = chi.CHIFabricParams(
  flit,
  [requester_port, memory_port],
  [home],
  [home_service],
  [memory_service]
)

check:
  memory_service.supports(chi.CHIReqOpcode.ReadNoSnp, 16) ~is #true
  memory_service.supports(chi.CHIReqOpcode.WriteNoSnpFull, 2) ~is #false
  memory_service.supports(chi.CHIReqOpcode.WriteNoSnpPtl, 4) ~is #false
  home_service.supports(chi.CHIReqOpcode.ReadNoSnp, 16) ~is #true
  fabric.flit === flit ~is #true
  fabric.ports ~is [requester_port, memory_port]
  fabric.homes ~is [home]
  fabric.home_services ~is [home_service]
  fabric.subordinate_services ~is [memory_service]
  fabric.home_map.entries.length() ~is 1
  fabric.home_map.entries[0].address_set ~is chi.AddressSet(0x80000000, 0x0fffffff)
  fabric.home_map.entries[0].home === home ~is #true
  fabric.home_map.entry(0x81234567).target_node_id ~is 5
  fabric.home_map.entry(0x70000000) ~is #false
  fabric.subordinate_map.services ~is [memory_service]
  fabric.subordinate_map.entries.length() ~is 1
  fabric.subordinate_map.entry(0x81234567).target_node_id ~is 9
  fabric.subordinate_map.entry(0x70000000) ~is #false

  chi.CHIRequestSupport("ReadNoSnp", chi.TransferSizes(1, 8)) ~throws "CHIReqOpcode"
  chi.CHIHomeParams("bad-home", 4, chi.CHINodeKind.RNI, ~max_outstanding: 1) ~throws "HN-F or HN-I"
  chi.CHISubordinateServiceParams(
    requester,
    [chi.AddressSet(0, 0xfff)],
    [read_support]
  ) ~throws "SN-F or SN-I"
  chi.CHISubordinateServiceParams(
    memory,
    [chi.AddressSet(0, 0xfff)],
    [chi.CHIRequestSupport(chi.CHIReqOpcode.WriteNoSnpPtl, chi.TransferSizes(1, 8))]
  ) ~throws "emitted by its ICN port"
  chi.CHISubordinateServiceParams(
    memory,
    [chi.AddressSet(0, 0xfff)],
    [read_support, read_support]
  ) ~throws "duplicate opcodes"
  chi.CHIHomeServiceParams(
    home,
    [chi.AddressSet(0, 0xfff)],
    [read_support, read_support]
  ) ~throws "duplicate opcodes"
  chi.CHIHomeMap(
    flit,
    [chi.CHIHomeMapEntry(chi.AddressSet(0x80000000, 0x0fffffff), home),
     chi.CHIHomeMapEntry(chi.AddressSet(0x88000000, 0x07ffffff), home)]
  ) ~throws "must not overlap"
  chi.CHIHomeMap(
    flit,
    [chi.CHIHomeMapEntry(chi.AddressSet(1 << 44, 0xfff), home)]
  ) ~throws "fit the request address width"
  chi.CHIHomeMap(
    flit,
    [chi.CHIHomeMapEntry(
       chi.AddressSet(0, 0xfff),
       chi.CHIHomeParams("wide-home", 128, chi.CHINodeKind.HNI, ~max_outstanding: 1)
     )]
  ) ~throws "fit the physical NodeID width"
  chi.CHISubordinateServiceParams(
    memory,
    [chi.AddressSet(0, 0xfff)],
    [chi.CHIRequestSupport(chi.CHIReqOpcode.ReadNoSnp, chi.TransferSizes(1, 128))]
  ) ~throws "fit the CHI Size field"
  chi.CHIFabricPortParams(memory, "link") ~throws "CHILinkParams"
  chi.CHIFabricPortParams(memory, chi.CHIRNILinkParams(flit)) ~throws "match the ICN port node kind"
  chi.CHIFabricParams(
    flit,
    [requester_port,
     chi.CHIFabricPortParams(
       chi.CHIICNPortParams(
         "duplicate-id",
         3,
         chi.CHINodeKind.RNI,
         ~emits: chi.CHIChannelCapabilities(),
         ~supports: chi.CHIChannelCapabilities(),
         ~max_outstanding: 1
       ),
       chi.CHIRNILinkParams(flit)
     )],
    [home],
    [home_service],
    [memory_service]
  ) ~throws "NodeIDs must be unique"
  chi.CHIFabricParams(
    flit,
    [requester_port, memory_port],
    [chi.CHIHomeParams("duplicate-home", 3, chi.CHINodeKind.HNI, ~max_outstanding: 1)],
    [home_service],
    [memory_service]
  ) ~throws "NodeIDs must be unique"
  chi.CHIFabricParams(
    flit,
    [requester_port,
     chi.CHIFabricPortParams(
       chi.CHIICNPortParams(
         "wide-id",
         128,
         chi.CHINodeKind.RNI,
         ~emits: chi.CHIChannelCapabilities(),
         ~supports: chi.CHIChannelCapabilities(),
         ~max_outstanding: 1
       ),
       chi.CHIRNILinkParams(flit)
     ),
     memory_port],
    [home],
    [home_service],
    [memory_service]
  ) ~throws "fit the physical NodeID width"
  chi.CHIFabricParams(
    flit,
    [requester_port,
     chi.CHIFabricPortParams(memory,
                             chi.CHISNLinkParams(chi.CHIFlitParams(~data_width: 256)))],
    [home],
    [home_service],
    [memory_service]
  ) ~throws "physical flit parameters"
  chi.CHIFabricParams(
    flit,
    [requester_port],
    [home],
    [home_service],
    [memory_service]
  ) ~throws "must be a fabric port"
  chi.CHIFabricParams(
    flit,
    [requester_port, memory_port],
    [home],
    [home_service],
    [chi.CHISubordinateServiceParams(
       memory,
       [chi.AddressSet(1 << 44, 0xfff)],
       [read_support]
     )]
  ) ~throws "fit the request address width"
