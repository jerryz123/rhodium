#lang rhombus
// Checks that CHI endpoint adapters resolve through uniform router-family slots.
// SPDX-License-Identifier: Apache-2.0

import:
  "family-noc-fixture.rhdl" as fixture
  lib("chi/main.rhdl").compile_chi_channel_family_adapter_plan
  lib("noc/plan/main.rhm").RouterFamilyPhysicalPlan
  lib("rhodium/core/main.rhm").verify_design

def local_ejection = fixture.family_noc_local_adapters.ejection(
  fixture.family_noc_target.terminal
)
def family_ejection = fixture.family_noc_family_adapters.ejection(
  fixture.family_noc_target.terminal
)
def top = fixture.family_noc_design.modules.find(
  fun (module_def): module_def.name == "CHIFamilyNoCFixture"
)
def router = fixture.family_noc_design.modules.find(
  fun (module_def): module_def.name == "SimpleRouterFamily"
)
def router_instances = top.operations.filter(
  ~keep: fun (operation): operation.opcode == "rtl.instance" && (
    operation.attribute("module") === router
  )
)
def physical = RouterFamilyPhysicalPlan(fixture.family_noc_router_family)

check:
  fixture.family_noc_router_family.egress_count ~is 1
  fixture.family_noc_router_family.ejection_count ~is 1
  local_ejection.target_index ~is 0
  family_ejection.target_index ~is 1
  fixture.family_noc_family_adapters.injection(
    fixture.family_noc_source.terminal
  ).input_index ~is 0
  compile_chi_channel_family_adapter_plan(
    fixture.family_noc_compilation,
    fixture.other_router_family,
    fixture.family_noc_flit
  ) ~throws "router family must derive from the CHI channel network plan"
  physical.matches(fixture.family_noc_router_family) ~is #true
  physical.matches(fixture.other_router_family) ~is #false
  physical.require_match(fixture.other_router_family) ~throws (
    "router family does not match the canonical physical-link manifest"
  )

check:
  fixture.family_noc_source_middle.source_target_indices ~is [0]
  fixture.family_noc_source_middle.destination_input_indices ~is [1]
  fixture.family_noc_middle_target.source_target_indices ~is [0]
  fixture.family_noc_middle_target.destination_input_indices ~is [1]
  top != #false ~is #true
  router != #false ~is #true
  router_instances.map(fun (instance): instance.attribute("name")) ~is [
    "source", "middle", "target"
  ]
  fixture.family_noc_design.modules.filter(
    ~keep: fun (module_def): module_def.name.starts_with("SimpleRouterFamily")
  ).length() ~is 1
  verify_design(fixture.family_noc_design) ~is #void
