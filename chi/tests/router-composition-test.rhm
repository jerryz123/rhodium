#lang rhombus
// Checks shared and split no-SNP CHI router compositions and rejects unsupported attachments.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  "router-composition-fixture.rhdl" as fixture
  lib("chi/main.rhdl") as chi
  lib("rhodium/core/main.rhm").verify_design

def fixture_shared_design = compile_program(fixture.shared_program, rtl_target).report.design

check:
  fixture.shared_compilations.snp ~is #false
  fixture.shared_router_configs.snp ~is #false
  fixture.shared_router_params.attachment.rni_locals.length() ~is 1
  fixture.shared_router_params.attachment.hni_requester_locals.length() ~is 1
  fixture.shared_router_params.attachment.hn_subordinate_locals.length() ~is 1
  fixture.shared_router_params.attachment.sn_locals.length() ~is 2
  fixture_shared_design.modules.map(fun (module_def): module_def.name).contains("CHIHNI") ~is #true
  fixture_shared_design.modules.map(fun (module_def): module_def.name).contains("CHIRouter") ~is #true
  verify_design(fixture_shared_design) ~is #void

check:
  fixture.requester_compilations.snp ~is #false
  fixture.subordinate_compilations.snp ~is #false
  fixture.requester_compilations.req.network.network_plan === (
    fixture.subordinate_compilations.req.network.network_plan
  ) ~is #false
  fixture.split_design.modules.map(fun (module_def): module_def.name).contains("CHIHNI") ~is #true
  verify_design(fixture.split_design) ~is #void

check:
  chi.compile_chi_router_attachment_plan(
    fixture.shared_router_configs,
    fixture.shared_adapters,
    chi.CHIRouterAttachments(~rnf_sites: [[fixture.shared_rni]])
  ) ~throws "RN-F and HN-F requester attachments require a SNP plane"
