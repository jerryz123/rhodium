#lang rhombus
// Checks striped CHI service selection, dense address projection, and validation.

import:
  "../main.rhdl" as chi

def flit = chi.CHIFlitParams()
def ram_config = chi.CHIRamConfig(flit, 0x2000, ~max_outstanding: 2)
def ram_params = chi.CHIRamParams("projector-ram", 9, ram_config)
def fragmenter_config = chi.CHITransferFragmenterConfig(flit, ~max_transfer_bytes: 64)
def fragmenter_params = chi.CHITransferFragmenterParams(fragmenter_config, ram_params.service)
def config = chi.CHIAddressProjectorConfig(flit, 0x2000, 64, 4)
def params = chi.CHIAddressProjectorParams(
  config,
  fragmenter_params.upstream_service,
  0x80000000,
  2
)

check:
  config.total_bytes ~is 0x8000
  config.bank_mask ~is 0x00c0
  config.global_mask ~is 0x7f3f
  config.address_set(0x80000000, 0) ~is chi.AddressSet(0x80000000, 0x7f3f)
  config.address_set(0x80000000, 1) ~is chi.AddressSet(0x80000040, 0x7f3f)
  config.address_set(0x80000000, 2) ~is chi.AddressSet(0x80000080, 0x7f3f)
  config.address_set(0x80000000, 3) ~is chi.AddressSet(0x800000c0, 0x7f3f)

  params.upstream_service.address_sets ~is [chi.AddressSet(0x80000080, 0x7f3f)]
  params.local_address_set ~is chi.AddressSet(0, 0x1fff)
  params.project(0x80000080) ~is 0
  params.project(0x800000bf) ~is 0x3f
  params.project(0x80000180) ~is 0x40
  params.project(0x80007fbf) ~is 0x1fff
  params.project(0x80000040) ~throws "outside this bank's global stripe"

  chi.CHIAddressProjectorConfig(flit, 0x2000, 64, 1).address_set(0x80000000, 0) ~is (
    chi.AddressSet(0x80000000, 0x1fff)
  )
  chi.CHIAddressProjectorConfig(flit, 0x2000, 0x4000, 4) ~throws "must not exceed"
  config.address_set(0x80000040, 0) ~throws "aligned to the total"
  config.address_set(0x80000000, 4) ~throws "less than the bank count"
