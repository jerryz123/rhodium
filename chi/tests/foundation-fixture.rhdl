#lang rhodium
// Exercises CHI flits, protocol classifiers, service-size matching, and Home/subordinate address decoding.

import:
  lib("chi/main.rhdl") open

def params = CHIFlitParams()
def full_params = CHIFlitParams(
  ~node_id_width: 16,
  ~request_address_width: 52,
  ~data_width: 512,
  ~mpam_width: 15,
  ~req_rsvdc_width: 32,
  ~dat_rsvdc_width: 32,
  ~data_check: #true,
  ~poison: #true,
  ~pbha_width: 4,
  ~mecid_width: 16,
  ~stream_id_width: 16,
  ~sec_sid_width: 1
)

circuit CHIFlitShapeFixture(p :: CHIFlitParams):
  input req: CHIReqFlit(p)
  input rsp: CHIRspFlit(p)
  input snp: CHISnpFlit(p)
  input dat: CHIDatFlit(p)
  output req_out: CHIReqFlit(p)
  output rsp_out: CHIRspFlit(p)
  output snp_out: CHISnpFlit(p)
  output dat_out: CHIDatFlit(p)

  req_out <== req
  rsp_out <== rsp
  snp_out <== snp
  dat_out <== dat

circuit CHIFoundationFixture():
  input map_address: Bits(params.request_address_width)
  output home_lookup: CHIHomeLookup(params.node_id_width)
  output subordinate_lookup: CHISubordinateLookup(params.node_id_width)
  output single_home_lookup: CHIHomeLookup(params.node_id_width)
  output single_subordinate_lookup: CHISubordinateLookup(params.node_id_width)
  def supports = [CHIRequestSupport(CHIReqOpcode.ReadNoSnp, TransferSizes(1, 64))]
  def regions = [AddressSet(0x1000, 0xff), AddressSet(0x2000, 0x3f), AddressSet(0x2080, 0x3f)]
  def homes:
    for List (index in 0..3):
      CHIHomeParams("decode-home-" ++ to_string(index), index * 3, CHINodeKind.HNI, ~max_outstanding: 1)
  def home_map = CHIHomeMap(params, for List (region in regions, home in homes): CHIHomeMapEntry(region, home))
  def services:
    for List (region in regions, index in 0..3):
      CHISubordinateServiceParams(
        CHIICNPortParams("decode-sn-" ++ to_string(index), index * 3, CHINodeKind.SNI,
                         ~emits: CHIChannelCapabilities(~req: [CHIReqOpcode.ReadNoSnp]),
                         ~supports: CHIChannelCapabilities(~dat: [CHIDatOpcode.CompData]),
                         ~max_outstanding: 1),
        [region], supports)
  def subordinate_map = CHISubordinateMap(params, services)
  home_lookup <== home_map.lookup(map_address)
  subordinate_lookup <== subordinate_map.lookup(map_address)
  single_home_lookup <== CHIHomeMap(params, [CHIHomeMapEntry(regions[0], homes[0])]).lookup(map_address)
  single_subordinate_lookup <== CHISubordinateMap(params, [services[0]]).lookup(map_address)
  input req: CHIReqFlit(params)
  input rsp: CHIRspFlit(params)
  input snp: CHISnpFlit(params)
  input dat: CHIDatFlit(params)
  input req_opcode: CHIReqOpcode
  input rsp_opcode: CHIRspOpcode
  input snp_opcode: CHISnpOpcode
  input dat_opcode: CHIDatOpcode
  input size: CHITransferSize
  input data_id: Bits(2)
  output req_out: CHIReqFlit(params)
  output rsp_out: CHIRspFlit(params)
  output snp_out: CHISnpFlit(params)
  output dat_out: CHIDatFlit(params)
  output req_opcode_valid: Bool
  output rsp_opcode_valid: Bool
  output snp_opcode_valid: Bool
  output dat_opcode_valid: Bool
  output req_atomic: Bool
  output req_read_no_snp: Bool
  output req_write_no_snp: Bool
  output rsp_allocates_dbid: Bool
  output dat_write_data: Bool
  output dat_response_data: Bool
  output req_size: CHITransferSize
  output req_num_req: Bits(6)
  output size_valid: Bool
  output data_beats_minus_one: Bits(2)
  output data_id_valid: Bool
  output match_byte: Bool
  output match_line: Bool
  output match_middle: Bool
  output match_large: Bool

  req_out <== req
  rsp_out <== rsp
  snp_out <== snp
  dat_out <== dat
  req_opcode_valid <== enum_valid(req_opcode)
  rsp_opcode_valid <== enum_valid(rsp_opcode)
  snp_opcode_valid <== enum_valid(snp_opcode)
  dat_opcode_valid <== enum_valid(dat_opcode)
  req_atomic <== req_opcode.is_atomic()
  req_read_no_snp <== req_opcode.is_read_no_snp()
  req_write_no_snp <== req_opcode.is_write_no_snp()
  rsp_allocates_dbid <== rsp_opcode.allocates_dbid()
  dat_write_data <== dat_opcode.is_write_data()
  dat_response_data <== dat_opcode.is_response_data()
  req_size <== chi_req_size(params, req)
  req_num_req <== chi_req_num_req(params, req)
  size_valid <== chi_size_valid(size)
  data_beats_minus_one <== chi_data_beats_minus_one(size, params)
  data_id_valid <== chi_data_id_valid(data_id, params)
  match_byte <== CHIRequestSupport(CHIReqOpcode.ReadNoSnp, TransferSizes(1, 1)).matches(req_opcode, size)
  match_line <== CHIRequestSupport(CHIReqOpcode.ReadNoSnp, TransferSizes(1, 64)).matches(req_opcode, size)
  match_middle <== CHIRequestSupport(CHIReqOpcode.ReadNoSnp, TransferSizes(4, 16)).matches(req_opcode, size)
  match_large <== CHIRequestSupport(CHIReqOpcode.ReadNoSnp, TransferSizes(32, 64)).matches(req_opcode, size)

def design = elaborate(CHIFoundationFixture())
def full_design = elaborate(CHIFlitShapeFixture(full_params))

export:
  params
  full_params
  CHITransferSize
  CHIFlitShapeFixture
  CHIFoundationFixture
  design
  full_design
