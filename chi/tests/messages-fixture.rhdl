#lang rhodium
// Exercises stateless CHI responses and Home transforms across DAT widths and optional metadata.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("chi/protocol/params.rhdl").CHIFlitParams
  lib("chi/protocol/flits.rhdl") open
  lib("chi/protocol/messages.rhdl") open
  lib("chi/protocol/protocol.rhdl") open

def w128 = CHIFlitParams(~node_id_width: 16, ~request_address_width: 52, ~data_width: 128)
def o128 = CHIFlitParams(~node_id_width: 16, ~request_address_width: 52, ~data_width: 128, ~dat_rsvdc_width: 32, ~data_check: #true, ~poison: #true)
def h128 = CHIFlitParams(~node_id_width: 16, ~request_address_width: 52, ~data_width: 128, ~req_rsvdc_width: 32, ~mpam_width: 15, ~pbha_width: 4, ~mecid_width: 16, ~stream_id_width: 16, ~sec_sid_width: 1, ~dat_rsvdc_width: 32, ~data_check: #true, ~poison: #true)
def w256 = CHIFlitParams(~node_id_width: 16, ~request_address_width: 52, ~data_width: 256)
def o256 = CHIFlitParams(~node_id_width: 16, ~request_address_width: 52, ~data_width: 256, ~dat_rsvdc_width: 32, ~data_check: #true, ~poison: #true)
def h256 = CHIFlitParams(~node_id_width: 16, ~request_address_width: 52, ~data_width: 256, ~req_rsvdc_width: 32, ~mpam_width: 15, ~pbha_width: 4, ~mecid_width: 16, ~stream_id_width: 16, ~sec_sid_width: 1, ~dat_rsvdc_width: 32, ~data_check: #true, ~poison: #true)
def w512 = CHIFlitParams(~node_id_width: 16, ~request_address_width: 52, ~data_width: 512)
def o512 = CHIFlitParams(~node_id_width: 16, ~request_address_width: 52, ~data_width: 512, ~dat_rsvdc_width: 32, ~data_check: #true, ~poison: #true)
def h512 = CHIFlitParams(~node_id_width: 16, ~request_address_width: 52, ~data_width: 512, ~req_rsvdc_width: 32, ~mpam_width: 15, ~pbha_width: 4, ~mecid_width: 16, ~stream_id_width: 16, ~sec_sid_width: 1, ~dat_rsvdc_width: 32, ~data_check: #true, ~poison: #true)

circuit CHIMessageFixture():
  input home_request_bits: Bits(512)
  input home_data_bits: Bits(1024)
  input request: CHIReqFlit(w128)
  input node_id: Bits(16)
  input dbid: Bits(5)
  input data_id: Bits(2)
  input data: Bits(512)
  input other_request: CHIReqFlit(w128)
  input other_node_id: Bits(16)
  input other_dbid: Bits(5)
  input other_data_id: Bits(2)
  input other_data: Bits(128)
  output dbid_response: CHIRspFlit(w128)
  output write_response: CHIRspFlit(w128)
  output home_response: CHIRspFlit(w128)
  output read_w128: CHIDatFlit(w128)
  output read_o128: CHIDatFlit(o128)
  output read_w256: CHIDatFlit(w256)
  output read_o256: CHIDatFlit(o256)
  output read_w512: CHIDatFlit(w512)
  output read_o512: CHIDatFlit(o512)
  output other_dbid_response: CHIRspFlit(w128)
  output other_write_response: CHIRspFlit(w128)
  output other_read_response: CHIDatFlit(w128)

  dbid_response <== chi_sn_dbid_response(w128, node_id, request, dbid)
  write_response <== chi_sn_write_completion(w128, node_id, request, dbid)
  home_response <== chi_hnf_response(w128, node_id, request, CHIRspOpcode.Comp, ~error: other_data[0..2].into(CHIRespErr))
  other_dbid_response <== chi_sn_dbid_response(w128, other_node_id, other_request, other_dbid)
  other_write_response <== chi_sn_write_completion(w128, other_node_id, other_request, other_dbid)
  other_read_response <== chi_sn_read_completion(w128, other_node_id, other_request, other_data_id, other_data)
  read_w128 <== chi_sn_read_completion(w128, node_id, request.into(CHIReqFlit(w128)), data_id, data[0..128])
  read_o128 <== chi_sn_read_completion(o128, node_id, request.into(CHIReqFlit(o128)), data_id, data[0..128])
  read_w256 <== chi_sn_read_completion(w256, node_id, request.into(CHIReqFlit(w256)), data_id, data[0..256])
  read_o256 <== chi_sn_read_completion(o256, node_id, request.into(CHIReqFlit(o256)), data_id, data[0..256])
  read_w512 <== chi_sn_read_completion(w512, node_id, request.into(CHIReqFlit(w512)), data_id, data[0..512])
  read_o512 <== chi_sn_read_completion(o512, node_id, request.into(CHIReqFlit(o512)), data_id, data[0..512])

  output snoop_w128: CHISnpFlit(w128)
  output intervention_w128: CHIReqFlit(w128)
  output original_req_w128: CHIReqFlit(w128)
  output original_dat_w128: CHIDatFlit(w128)
  output downstream_w128: CHIReqFlit(w128)
  output write_w128: CHIDatFlit(w128)
  output upstream_w128: CHIDatFlit(w128)
  output requester_write_w128: CHIDatFlit(w128)
  def req_w128 :: CHIReqFlit(w128) = home_request_bits[0..CHIReqFlit(w128).packed_width()].into(CHIReqFlit(w128))
  def dat_w128 :: CHIDatFlit(w128) = home_data_bits[0..CHIDatFlit(w128).packed_width()].into(CHIDatFlit(w128))
  snoop_w128 <== chi_home_snoop(w128, node_id, req_w128, other_request.address, CHISnpOpcode.SnpUnique, other_request.txn_id)
  intervention_w128 <== chi_home_snoop_write_request(w128, node_id, other_node_id, req_w128, dat_w128, other_request.txn_id, other_request.mem_attr.early_write_acknowledge)
  original_req_w128 <== req_w128
  original_dat_w128 <== dat_w128
  downstream_w128 <== chi_home_downstream_request(w128, node_id, other_node_id, req_w128, other_request.address, other_request.size_or_num_req, other_request.opcode, other_request.txn_id, other_request.mem_attr.early_write_acknowledge)
  write_w128 <== chi_hnf_snoop_write_data(w128, node_id, other_node_id, other_request.txn_id, dat_w128)
  upstream_w128 <== chi_home_upstream_read_data(w128, node_id, req_w128, other_data[0..3], dat_w128)
  requester_write_w128 <== chi_rn_write_data(w128, node_id, other_node_id, other_request.txn_id, dat_w128.data, dat_w128.byte_enable,
                                             ~data_id: dat_w128.data_id, ~ccid: dat_w128.ccid, ~dbid_or_mecid: dat_w128.dbid_or_mecid)
  output snoop_h128: CHISnpFlit(h128)
  output intervention_h128: CHIReqFlit(h128)
  output original_req_h128: CHIReqFlit(h128)
  output original_dat_h128: CHIDatFlit(h128)
  output downstream_h128: CHIReqFlit(h128)
  output write_h128: CHIDatFlit(h128)
  output upstream_h128: CHIDatFlit(h128)
  output requester_write_h128: CHIDatFlit(h128)
  def req_h128 :: CHIReqFlit(h128) = home_request_bits[0..CHIReqFlit(h128).packed_width()].into(CHIReqFlit(h128))
  def dat_h128 :: CHIDatFlit(h128) = home_data_bits[0..CHIDatFlit(h128).packed_width()].into(CHIDatFlit(h128))
  snoop_h128 <== chi_home_snoop(h128, node_id, req_h128, other_request.address, CHISnpOpcode.SnpUnique, other_request.txn_id)
  intervention_h128 <== chi_home_snoop_write_request(h128, node_id, other_node_id, req_h128, dat_h128, other_request.txn_id, other_request.mem_attr.early_write_acknowledge)
  original_req_h128 <== req_h128
  original_dat_h128 <== dat_h128
  downstream_h128 <== chi_home_downstream_request(h128, node_id, other_node_id, req_h128, other_request.address, other_request.size_or_num_req, other_request.opcode, other_request.txn_id, other_request.mem_attr.early_write_acknowledge)
  write_h128 <== chi_hnf_snoop_write_data(h128, node_id, other_node_id, other_request.txn_id, dat_h128)
  upstream_h128 <== chi_home_upstream_read_data(h128, node_id, req_h128, other_data[0..3], dat_h128)
  requester_write_h128 <== chi_rn_write_data(h128, node_id, other_node_id, other_request.txn_id, dat_h128.data, dat_h128.byte_enable,
                                             ~data_id: dat_h128.data_id, ~ccid: dat_h128.ccid, ~dbid_or_mecid: dat_h128.dbid_or_mecid)
  output snoop_w256: CHISnpFlit(w256)
  output intervention_w256: CHIReqFlit(w256)
  output original_req_w256: CHIReqFlit(w256)
  output original_dat_w256: CHIDatFlit(w256)
  output downstream_w256: CHIReqFlit(w256)
  output write_w256: CHIDatFlit(w256)
  output upstream_w256: CHIDatFlit(w256)
  output requester_write_w256: CHIDatFlit(w256)
  def req_w256 :: CHIReqFlit(w256) = home_request_bits[0..CHIReqFlit(w256).packed_width()].into(CHIReqFlit(w256))
  def dat_w256 :: CHIDatFlit(w256) = home_data_bits[0..CHIDatFlit(w256).packed_width()].into(CHIDatFlit(w256))
  snoop_w256 <== chi_home_snoop(w256, node_id, req_w256, other_request.address, CHISnpOpcode.SnpUnique, other_request.txn_id)
  intervention_w256 <== chi_home_snoop_write_request(w256, node_id, other_node_id, req_w256, dat_w256, other_request.txn_id, other_request.mem_attr.early_write_acknowledge)
  original_req_w256 <== req_w256
  original_dat_w256 <== dat_w256
  downstream_w256 <== chi_home_downstream_request(w256, node_id, other_node_id, req_w256, other_request.address, other_request.size_or_num_req, other_request.opcode, other_request.txn_id, other_request.mem_attr.early_write_acknowledge)
  write_w256 <== chi_hnf_snoop_write_data(w256, node_id, other_node_id, other_request.txn_id, dat_w256)
  upstream_w256 <== chi_home_upstream_read_data(w256, node_id, req_w256, other_data[0..3], dat_w256)
  requester_write_w256 <== chi_rn_write_data(w256, node_id, other_node_id, other_request.txn_id, dat_w256.data, dat_w256.byte_enable,
                                             ~data_id: dat_w256.data_id, ~ccid: dat_w256.ccid, ~dbid_or_mecid: dat_w256.dbid_or_mecid)
  output snoop_h256: CHISnpFlit(h256)
  output intervention_h256: CHIReqFlit(h256)
  output original_req_h256: CHIReqFlit(h256)
  output original_dat_h256: CHIDatFlit(h256)
  output downstream_h256: CHIReqFlit(h256)
  output write_h256: CHIDatFlit(h256)
  output upstream_h256: CHIDatFlit(h256)
  output requester_write_h256: CHIDatFlit(h256)
  def req_h256 :: CHIReqFlit(h256) = home_request_bits[0..CHIReqFlit(h256).packed_width()].into(CHIReqFlit(h256))
  def dat_h256 :: CHIDatFlit(h256) = home_data_bits[0..CHIDatFlit(h256).packed_width()].into(CHIDatFlit(h256))
  snoop_h256 <== chi_home_snoop(h256, node_id, req_h256, other_request.address, CHISnpOpcode.SnpUnique, other_request.txn_id)
  intervention_h256 <== chi_home_snoop_write_request(h256, node_id, other_node_id, req_h256, dat_h256, other_request.txn_id, other_request.mem_attr.early_write_acknowledge)
  original_req_h256 <== req_h256
  original_dat_h256 <== dat_h256
  downstream_h256 <== chi_home_downstream_request(h256, node_id, other_node_id, req_h256, other_request.address, other_request.size_or_num_req, other_request.opcode, other_request.txn_id, other_request.mem_attr.early_write_acknowledge)
  write_h256 <== chi_hnf_snoop_write_data(h256, node_id, other_node_id, other_request.txn_id, dat_h256)
  upstream_h256 <== chi_home_upstream_read_data(h256, node_id, req_h256, other_data[0..3], dat_h256)
  requester_write_h256 <== chi_rn_write_data(h256, node_id, other_node_id, other_request.txn_id, dat_h256.data, dat_h256.byte_enable,
                                             ~data_id: dat_h256.data_id, ~ccid: dat_h256.ccid, ~dbid_or_mecid: dat_h256.dbid_or_mecid)
  output snoop_w512: CHISnpFlit(w512)
  output intervention_w512: CHIReqFlit(w512)
  output original_req_w512: CHIReqFlit(w512)
  output original_dat_w512: CHIDatFlit(w512)
  output downstream_w512: CHIReqFlit(w512)
  output write_w512: CHIDatFlit(w512)
  output upstream_w512: CHIDatFlit(w512)
  output requester_write_w512: CHIDatFlit(w512)
  def req_w512 :: CHIReqFlit(w512) = home_request_bits[0..CHIReqFlit(w512).packed_width()].into(CHIReqFlit(w512))
  def dat_w512 :: CHIDatFlit(w512) = home_data_bits[0..CHIDatFlit(w512).packed_width()].into(CHIDatFlit(w512))
  snoop_w512 <== chi_home_snoop(w512, node_id, req_w512, other_request.address, CHISnpOpcode.SnpUnique, other_request.txn_id)
  intervention_w512 <== chi_home_snoop_write_request(w512, node_id, other_node_id, req_w512, dat_w512, other_request.txn_id, other_request.mem_attr.early_write_acknowledge)
  original_req_w512 <== req_w512
  original_dat_w512 <== dat_w512
  downstream_w512 <== chi_home_downstream_request(w512, node_id, other_node_id, req_w512, other_request.address, other_request.size_or_num_req, other_request.opcode, other_request.txn_id, other_request.mem_attr.early_write_acknowledge)
  write_w512 <== chi_hnf_snoop_write_data(w512, node_id, other_node_id, other_request.txn_id, dat_w512)
  upstream_w512 <== chi_home_upstream_read_data(w512, node_id, req_w512, other_data[0..3], dat_w512)
  requester_write_w512 <== chi_rn_write_data(w512, node_id, other_node_id, other_request.txn_id, dat_w512.data, dat_w512.byte_enable,
                                             ~data_id: dat_w512.data_id, ~ccid: dat_w512.ccid, ~dbid_or_mecid: dat_w512.dbid_or_mecid)
  output snoop_h512: CHISnpFlit(h512)
  output intervention_h512: CHIReqFlit(h512)
  output original_req_h512: CHIReqFlit(h512)
  output original_dat_h512: CHIDatFlit(h512)
  output downstream_h512: CHIReqFlit(h512)
  output write_h512: CHIDatFlit(h512)
  output upstream_h512: CHIDatFlit(h512)
  output requester_write_h512: CHIDatFlit(h512)
  def req_h512 :: CHIReqFlit(h512) = home_request_bits[0..CHIReqFlit(h512).packed_width()].into(CHIReqFlit(h512))
  def dat_h512 :: CHIDatFlit(h512) = home_data_bits[0..CHIDatFlit(h512).packed_width()].into(CHIDatFlit(h512))
  snoop_h512 <== chi_home_snoop(h512, node_id, req_h512, other_request.address, CHISnpOpcode.SnpUnique, other_request.txn_id)
  intervention_h512 <== chi_home_snoop_write_request(h512, node_id, other_node_id, req_h512, dat_h512, other_request.txn_id, other_request.mem_attr.early_write_acknowledge)
  original_req_h512 <== req_h512
  original_dat_h512 <== dat_h512
  downstream_h512 <== chi_home_downstream_request(h512, node_id, other_node_id, req_h512, other_request.address, other_request.size_or_num_req, other_request.opcode, other_request.txn_id, other_request.mem_attr.early_write_acknowledge)
  write_h512 <== chi_hnf_snoop_write_data(h512, node_id, other_node_id, other_request.txn_id, dat_h512)
  upstream_h512 <== chi_home_upstream_read_data(h512, node_id, req_h512, other_data[0..3], dat_h512)
  requester_write_h512 <== chi_rn_write_data(h512, node_id, other_node_id, other_request.txn_id, dat_h512.data, dat_h512.byte_enable,
                                             ~data_id: dat_h512.data_id, ~ccid: dat_h512.ccid, ~dbid_or_mecid: dat_h512.dbid_or_mecid)

  output hni_req_w128: CHIReqFlit(w128)
  output hni_rsp_w128: CHIRspFlit(w128)
  output hni_write_w128: CHIDatFlit(w128)
  output hni_read_w128: CHIDatFlit(w128)
  output original_rsp_w128: CHIRspFlit(w128)
  def rsp_w128 :: CHIRspFlit(w128) = home_request_bits[0..CHIRspFlit(w128).packed_width()].into(CHIRspFlit(w128))
  original_rsp_w128 <== rsp_w128
  hni_req_w128 <== chi_hni_downstream_request(w128, req_w128, 37, other_node_id, dbid)
  hni_rsp_w128 <== chi_hni_upstream_response(w128, rsp_w128, other_request.txn_id, other_node_id, other_request.qos, 37, dbid)
  hni_write_w128 <== chi_hni_downstream_write_data(w128, dat_w128, other_data_id, other_request.qos, node_id, other_node_id, other_request.txn_id)
  hni_read_w128 <== chi_hni_upstream_read_data(w128, dat_w128, other_request.txn_id, other_node_id, other_request.qos, 37)
