#lang rhodium
// Exercises stateless subordinate messages at every data width with optional DAT fields on and off.

import:
  lib("chi/params.rhdl").CHIFlitParams
  lib("chi/flits.rhdl") open
  lib("chi/messages.rhdl") open

def w128 = CHIFlitParams(~node_id_width: 16, ~request_address_width: 52, ~data_width: 128)
def o128 = CHIFlitParams(~node_id_width: 16, ~request_address_width: 52, ~data_width: 128, ~dat_rsvdc_width: 32, ~data_check: #true, ~poison: #true)
def w256 = CHIFlitParams(~node_id_width: 16, ~request_address_width: 52, ~data_width: 256)
def o256 = CHIFlitParams(~node_id_width: 16, ~request_address_width: 52, ~data_width: 256, ~dat_rsvdc_width: 32, ~data_check: #true, ~poison: #true)
def w512 = CHIFlitParams(~node_id_width: 16, ~request_address_width: 52, ~data_width: 512)
def o512 = CHIFlitParams(~node_id_width: 16, ~request_address_width: 52, ~data_width: 512, ~dat_rsvdc_width: 32, ~data_check: #true, ~poison: #true)

circuit CHIReadMessageFixture(p :: CHIFlitParams):
  input request: CHIReqFlit(p)
  input node_id: Bits(16)
  input data_id: Bits(2)
  input data: Bits(p.data_width)
  output result: CHIDatFlit(p)
  result <== chi_sn_read_completion(p, node_id, request, data_id, data)

circuit CHIMessageFixture():
  input request: CHIReqFlit(w128)
  input node_id: Bits(16)
  input dbid: Bits(5)
  input data_id: Bits(2)
  input data: Bits(512)
  output dbid_response: CHIRspFlit(w128)
  output write_response: CHIRspFlit(w128)
  output read_w128: CHIDatFlit(w128)
  output read_o128: CHIDatFlit(o128)
  output read_w256: CHIDatFlit(w256)
  output read_o256: CHIDatFlit(o256)
  output read_w512: CHIDatFlit(w512)
  output read_o512: CHIDatFlit(o512)

  dbid_response <== chi_sn_dbid_response(w128, node_id, request, dbid)
  write_response <== chi_sn_write_completion(w128, node_id, request, dbid)
  inst w128_builder(CHIReadMessageFixture(w128))
  w128_builder.request <== request
  w128_builder.node_id <== node_id
  w128_builder.data_id <== data_id
  w128_builder.data <== data[0..128]
  read_w128 <== w128_builder.result
  inst o128_builder(CHIReadMessageFixture(o128))
  o128_builder.request <== request
  o128_builder.node_id <== node_id
  o128_builder.data_id <== data_id
  o128_builder.data <== data[0..128]
  read_o128 <== o128_builder.result
  inst w256_builder(CHIReadMessageFixture(w256))
  w256_builder.request <== request
  w256_builder.node_id <== node_id
  w256_builder.data_id <== data_id
  w256_builder.data <== data[0..256]
  read_w256 <== w256_builder.result
  inst o256_builder(CHIReadMessageFixture(o256))
  o256_builder.request <== request
  o256_builder.node_id <== node_id
  o256_builder.data_id <== data_id
  o256_builder.data <== data[0..256]
  read_o256 <== o256_builder.result
  inst w512_builder(CHIReadMessageFixture(w512))
  w512_builder.request <== request
  w512_builder.node_id <== node_id
  w512_builder.data_id <== data_id
  w512_builder.data <== data[0..512]
  read_w512 <== w512_builder.result
  inst o512_builder(CHIReadMessageFixture(o512))
  o512_builder.request <== request
  o512_builder.node_id <== node_id
  o512_builder.data_id <== data_id
  o512_builder.data <== data[0..512]
  read_o512 <== o512_builder.result

def design = elaborate(CHIMessageFixture())

export:
  design
