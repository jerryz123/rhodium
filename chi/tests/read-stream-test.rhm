#lang rhombus
// Checks the public CHI line-read stream adapter and its TxnID range validation.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/rtl.rhm").rtl_target
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../chi/main.rhdl" as chi
  "../../chi/transactions/read-stream.rhdl" as read_stream

def p = chi.CHIFlitParams()
def direct_compiled = compile_program(elaborate(read_stream.CHIReadStream(p, 3, 16)), rtl_target)
def facade_compiled = compile_program(elaborate(chi.CHIReadStream(p, 3, 16)), rtl_target)

check:
  direct_compiled.has_errors ~is #false
  facade_compiled.has_errors ~is #false
  chi.CHIReadStream === read_stream.CHIReadStream ~is #true
  chi.CHIReadStreamCommand === read_stream.CHIReadStreamCommand ~is #true
  chi.CHIReadStreamLine === read_stream.CHIReadStreamLine ~is #true
  elaborate(read_stream.CHIReadStream(p, 3, 4094)) ~throws "transaction-ID range must fit the 12-bit CHI field"
