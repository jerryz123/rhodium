#lang rhombus
// Checks CHI transfer-fragmenter service widening and composed elaboration.
// SPDX-License-Identifier: Apache-2.0

import:
  "../main.rhdl" as chi
  "transfer-fragmenter-fixture.rhdl" as fixture

def modules = fixture.fragmenter_design.modules.map(fun (module): module.name)

check:
  fixture.fragmenter_params.downstream_service.supports(
    chi.CHIReqOpcode.ReadNoSnp,
    16
  ) ~is #true
  fixture.fragmenter_params.downstream_service.supports(
    chi.CHIReqOpcode.ReadNoSnp,
    64
  ) ~is #false
  fixture.fragmenter_params.upstream_service.supports(
    chi.CHIReqOpcode.ReadNoSnp,
    64
  ) ~is #true
  fixture.fragmenter_params.upstream_service.supports(
    chi.CHIReqOpcode.WriteNoSnpFull,
    64
  ) ~is #true
  fixture.fragmenter_params.upstream_service.supports(
    chi.CHIReqOpcode.WriteNoSnpPtl,
    64
  ) ~is #true
  modules.contains("CHITransferFragmenter") ~is #true
  modules.contains("CHIRam") ~is #true

  chi.CHITransferFragmenterConfig(fixture.fragmenter_flit,
                                  ~max_transfer_bytes: 8) ~throws "one DAT beat through 64 bytes"
