#lang rhombus
// Checks the public widths of default and fully populated CHI flits.

import:
  "../main.rhdl" as chi

def params = chi.CHIFlitParams()
def full_params = chi.CHIFlitParams(
  ~node_id_width: 16,
  ~request_address_width: 52,
  ~data_width: 512,
  ~mpam_width: 15,
  ~req_rsvdc_width: 32,
  ~dat_rsvdc_width: 32,
  ~data_check: #true,
  ~poison: #true,
  ~pbha_width: 4,
  ~mecid_width: 16,
  ~stream_id_width: 16,
  ~sec_sid_width: 1
)

check:
  chi.CHIReqFlit(params).packed_width() ~is 137
  chi.CHIRspFlit(params).packed_width() ~is 71
  chi.CHISnpFlit(params).packed_width() ~is 94
  chi.CHIDatFlit(params).packed_width() ~is 240
  chi.CHIReqOpcode.packed_width() ~is 7
  chi.CHIRspOpcode.packed_width() ~is 5
  chi.CHISnpOpcode.packed_width() ~is 5
  chi.CHIDatOpcode.packed_width() ~is 4
  chi.CHITransferSize.packed_width() ~is 3
  chi.CHIReqFlit(full_params).packed_width() ~is 240
  chi.CHIRspFlit(full_params).packed_width() ~is 89
  chi.CHISnpFlit(full_params).packed_width() ~is 151
  chi.CHIDatFlit(full_params).packed_width() ~is 818
