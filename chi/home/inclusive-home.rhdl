#lang rhodium
// Owns a parameterized nonblocking inclusive LLC with shared lookup and response resources.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/plru.rhdl") open
  lib("rhodium/std/read-write.rhdl").ReadWriteRequest
  lib("rhodium/std/ready-valid.rhdl") open
  lib("rhodium/std/sync-ram.rhdl").SyncRam1RW
  lib("flow/circular-priority.rhdl") open
  lib("flow/queue.rhdl").Queue
  lib("chi/protocol/params.rhdl") open
  lib("chi/protocol/flits.rhdl") open
  lib("chi/protocol/protocol.rhdl") open
  lib("chi/protocol/coherence.rhdl") open
  lib("chi/protocol/channels.rhdl") open
  lib("chi/home/home-common.rhdl") open
  lib("chi/home/home-comp-ack.rhdl").CHIHomeCompAckTable
  lib("chi/home/inclusive-victim-writeback.rhdl") open
  lib("chi/protocol/messages.rhdl") open
  lib("rhodium/std/interconnect.rhdl").StripedAddressLayout
  lib("chi/transactions/data-checks.rhdl").monitor_chi_copyback_data

class CHIInclusiveHNFConfig(home :: CHIHNFConfig,
                            addressing :: StripedAddressLayout,
                            sets :: Pow2Int,
                            ways :: PosInt,
                            comp_ack_entries :: Int.in(1 ..= 4096),
                            victim_writeback_entries :: PosInt):
  implements StableCircuitParam

  property flit: home.flit
  property set_width :: PosInt: alignment_bits(sets)
  property way_width :: PosInt: index_width(ways)
  property line_count :: PosInt: sets * ways
  property capacity_bytes :: PosInt: line_count * 64
  property transaction_slots :: Int.in(1 ..= 64): home.transaction_slots

  constructor (home :: CHIHNFConfig,
               addressing :: StripedAddressLayout,
               ~sets: sets :: Pow2Int,
               ~ways: ways :: PosInt,
               ~comp_ack_entries: comp_ack_entries :: Int.in(1 ..= 4096) = 4,
               ~victim_writeback_entries: victim_writeback_entries :: PosInt = 1):
    unless sets >= 2
    | error(~who: #'CHIInclusiveHNFConfig,
            "set count must be a power of two of at least two")
    unless addressing.fits_unsigned_width(home.flit.request_address_width)
    | error(~who: #'CHIInclusiveHNFConfig,
            "cache addressing must fit the Home's address width")
    unless addressing.global_mask == home.service_mask
    | error(~who: #'CHIInclusiveHNFConfig,
            "cache addressing must describe the Home's service mask")
    unless addressing.stripe_bytes >= 64
    | error(~who: #'CHIInclusiveHNFConfig,
            "cache addressing stripes must contain a complete cache line")
    unless sets * ways * 64 <= addressing.local_bytes
    | error(~who: #'CHIInclusiveHNFConfig,
            "cache capacity exceeds the dense local address range")
    unless home.transaction_slots * home.snoop_endpoints.length() <= 4096
    | error(~who: #'CHIInclusiveHNFConfig,
            "Home slots and RN-F targets exceed the 12-bit snoop transaction-ID space")
    unless home.transaction_slots + victim_writeback_entries <= 1024
    | error(~who: #'CHIInclusiveHNFConfig,
            "Home slots and victim writebacks exceed 1024 outstanding subordinate transactions")
    def line_reads = home.service_requests.filter(
      ~keep: fun (support): support.opcode == CHIReqOpcode.ReadNoSnp && support.sizes.max_bytes >= 64
    )
    def line_writes = home.service_requests.filter(
      ~keep: fun (support): support.opcode == CHIReqOpcode.WriteNoSnpFull && support.sizes.max_bytes >= 64
    )
    unless line_reads.length() > 0 && line_writes.length() > 0
    | error(~who: #'CHIInclusiveHNFConfig,
            "inclusive HN-F subordinate must support 64-byte reads and full writes")
    super(home, addressing, sets, ways, comp_ack_entries, victim_writeback_entries)

hardware_enum CHIInclusiveHNFPhase(~width: 5):
  Idle = 0
  SendRequesterDBID = 1
  ReceiveRequesterData = 2
  IssueLookup = 3
  AwaitLookup = 4
  SendSnoop = 5
  AwaitSnoop = 6
  AfterSnoops = 7
  SendFillRequest = 8
  ReceiveFillData = 9
  SendCachedData = 10
  MergeRequesterData = 11
  SendRequesterCompletion = 12
  SendVictimWriteRequest = 13
  AwaitVictimDBID = 14
  SendVictimData = 15
  AwaitVictimCompletion = 16
  FinishMaintenance = 17
  FinishCopyBack = 18
  EnqueueVictimWriteback = 19
  AwaitVictimWriteback = 20
  InstallFill = 21

// Gives the shared ingress scheduler one explicit slot-targeted event surface.
hardware_enum CHIInclusiveHNFInputEventKind(~width: 3):
  RequesterData = 0
  RequesterResponse = 1
  SubordinateResponse = 2
  FillData = 3
  VictimWritebackCompletion = 4

bundle CHIInclusiveHNFInputEvent(slot_width :: PosInt):
  valid: Bool
  kind: CHIInclusiveHNFInputEventKind
  slot: Bits(slot_width)

fun chi_inclusive_cached_data(p :: CHIFlitParams,
                              home_node_id :: Bits(p.node_id_width),
                              request :: CHIReqFlit(p),
                              coherent :: Bool,
                              acknowledgement_dbid :: Bits(12),
                              data_id :: Bits(2),
                              data :: Bits(p.data_width)) :~ CHIDatFlit(p):
  def coherent_response = CHICoherentResponse():
    pass_dirty: Bool(#false)
    state: mux(request.opcode === CHIReqOpcode.ReadUnique,
               CHIResponseState.Unique,
               CHIResponseState.SharedClean)
  chi_sn_read_completion(p, home_node_id, request, data_id, data).updated(
    ~dbid_or_mecid: acknowledgement_dbid.zext(16),
    ~trace_tag: request.trace_tag,
    ~resp: mux(coherent, coherent_response.as_bits(), bits(0, 3))
  )

sync_circuit CHIInclusiveHNF(config :: CHIInclusiveHNFConfig):
  def home_config = config.home
  def p = config.flit
  def sets = config.sets
  def ways = config.ways
  def slots = config.transaction_slots
  def slot_width = index_width(slots)
  def set_width = config.set_width
  def way_width = config.way_width
  def offset_width = 6
  def line_address_width = p.request_address_width - offset_width
  def line_packets = 64 / p.data_bytes
  def packet_index_width = index_width(line_packets)
  def comp_ack_entries = config.comp_ack_entries
  def comp_ack_slot_width = index_width(comp_ack_entries)
  def victim_writeback_entries = config.victim_writeback_entries
  def Line = Vec(line_packets, Bits(p.data_width))
  def residents = home_config.snoop_endpoints
  def resident_count = residents.length()
  def resident_width = index_width(resident_count)
  def empty_slots = vec(for List (_index in 0..slots): Bool(#false))
  def empty_data_ids = vec(for List (_index in 0..slots): bits(0, 4))
  def empty_snoop_targets = vec(
    for List (_slot in 0..slots): vec(for List (_resident in 0..resident_count): Bool(#false))
  )
  def empty_snoop_data_ids = vec(
    for List (_slot in 0..slots): vec(for List (_resident in 0..resident_count): bits(0, 4))
  )

  input identity: CHIHNFIdentity(p)
  interface port(CHIHNChannels(p), ~role: home)
  def requester = port.requester
  def subordinate = port.subordinate
  def home_id = identity.home_node_id
  def subordinate_id = identity.subordinate_node_id

  // Two-entry non-pipelined ingress buffers break the dependency from
  // autonomous output readiness back to the external producer while retaining
  // full-rate back-to-back flits.
  inst requester_data_buffer(Queue(CHIDatFlit(p), 2))
  inst requester_response_buffer(Queue(CHIRspFlit(p), 2))
  inst subordinate_response_buffer(Queue(CHIRspFlit(p), 2))
  inst fill_buffer(Queue(CHIDatFlit(p), 2))
  requester.requester_responses <=> requester_response_buffer.ingress
  subordinate.rsp <=> subordinate_response_buffer.ingress
  subordinate.dat.response <=> fill_buffer.ingress
  def requester_data = requester_data_buffer.egress
  def requester_response = requester_response_buffer.egress
  def subordinate_response = subordinate_response_buffer.egress
  def fill_response = fill_buffer.egress

  fun cache_set(address :: Bits(p.request_address_width)):
    config.addressing.project_offset(address - identity.service_base)[offset_width..(offset_width + set_width)]
  fun line_address(address :: Bits(p.request_address_width)):
    address[offset_width..p.request_address_width]
  fun slot_txn_id(slot :: Bits(slot_width)):
    slot.zext(12)
  fun snoop_txn_id(slot :: Bits(slot_width), target :: Bits(resident_width)):
    slot_txn_id(slot) + vec(
      for List (index in 0..resident_count): bits(index * slots, 12)
    )[target]
  fun next_slot_priority(slot :: Bits(slot_width)):
    mux(slot === bits(slots - 1, slot_width),
        bits(0, slot_width),
        slot + bits(1, slot_width))

  reg occupied(~init: empty_slots)
  reg phases(~init: vec(for List (_index in 0..slots): CHIInclusiveHNFPhase.Idle))
  reg requests(Vec(slots, CHIReqFlit(p)))
  reg comp_ack_slots(Vec(slots, Bits(comp_ack_slot_width)))
  reg pending_grant_sets(Vec(comp_ack_entries, Bits(set_width)))
  reg pending_grants(~init: vec(for List (_index in 0..comp_ack_entries): Bool(#false)))
  reg requester_allocates(~init: empty_slots)
  reg requester_write_data(Vec(slots, Vec(line_packets, CHIDatFlit(p))))
  reg requester_write_line_valids(~init: vec(for List (_index in 0..slots): bits(0, line_packets)))
  reg received_requester_data_ids(~init: empty_data_ids)
  reg selected_sets(Vec(slots, Bits(set_width)))
  reg selected_ways(Vec(slots, Bits(way_width)))
  reg line_buffers(Vec(slots, Line))
  reg victim_addresses(Vec(slots, Bits(p.request_address_width)))
  reg snoop_victims(~init: empty_slots)
  reg pending_snoop_targets(~init: empty_snoop_targets)
  reg outstanding_snoop_targets(~init: empty_snoop_targets)
  reg received_snoop_data_ids(~init: empty_snoop_data_ids)
  reg snoop_retains_copies(~init: empty_snoop_targets)
  reg received_fill_data_ids(~init: empty_data_ids)
  reg remaining_response_data_ids(~init: empty_data_ids)
  reg subordinate_dbids(~init: vec(for List (_index in 0..slots): bits(0, 12)))
  reg victim_data_beats(~init: vec(for List (_index in 0..slots): bits(0, 2)))
  reg maintenance_hits(~init: empty_slots)
  reg maintenance_dirty(~init: empty_slots)
  reg completion_errors(~init: vec(for List (_index in 0..slots): CHIRespErr.OK))
  reg copyback_states(~init: vec(for List (_index in 0..slots): bits(0, 3)))
  reg victim_writebacks_pending(~init: empty_slots)

  reg valid_lines(~init: vec(for List (_set in 0..sets): bits(0, ways).as_vec(Bool)))
  reg dirty_lines(~init: vec(for List (_set in 0..sets): bits(0, ways).as_vec(Bool)))
  reg resident_lines(~init: vec(
    for List (_set in 0..sets): vec(for List (_way in 0..ways): bits(0, resident_count))
  ))
  reg may_write_lines(~init: vec(
    for List (_set in 0..sets): vec(for List (_way in 0..ways): bits(0, resident_count))
  ))
  reg replacement_state(~init: vec(for List (_set in 0..sets): plru_initial_state(ways)))
  inst tags(SyncRam1RW(sets, Bits(line_address_width), ways))
  inst lines(SyncRam1RW(sets, Bits(512), ways))
  reg lookup_owner(Bits(slot_width))
  reg lookup_next_priority(~init: bits(0, slot_width))
  reg advance_locked(~init: Bool(#false))
  reg advance_owner(Bits(slot_width))
  reg advance_next_priority(~init: bits(0, slot_width))
  reg response_data_locked(~init: Bool(#false))
  reg response_data_owner(Bits(slot_width))
  reg response_data_next_priority(~init: bits(0, slot_width))

  inst comp_acks(CHIHomeCompAckTable(p, comp_ack_entries))
  comp_acks.home_node_id <== home_id
  inst victim_writebacks(CHIInclusiveVictimWritebackBuffer(p,
                                                           victim_writeback_entries,
                                                           slots))
  victim_writebacks.home_node_id <== home_id
  victim_writebacks.subordinate_node_id <== subordinate_id

  reg subordinate_request_locked(~init: Bool(#false))
  reg subordinate_request_writeback_owner(~init: Bool(#false))
  reg subordinate_request_prefers_writeback(~init: Bool(#true))
  reg subordinate_data_locked(~init: Bool(#false))
  reg subordinate_data_writeback_owner(~init: Bool(#false))
  reg subordinate_data_prefers_writeback(~init: Bool(#true))

  def incoming_request = requester.requests.bits
  def incoming_set = cache_set(incoming_request.address)
  def incoming_requester_data_txn = requester.request_data.bits.txn_id
  def incoming_requester_data_is_snoop = requester.request_data.bits.opcode.is_one_of(
    CHIDatOpcode.SnpRespData,
    CHIDatOpcode.SnpRespDataPtl
  )
  def incoming_requester_data_snoop_target_matches = vec(
    for List (index in 0..resident_count):
      block:
        def range_base = index * slots
        (requester.request_data.bits.src_id === bits(residents[index].node_id, p.node_id_width)) & (
          (incoming_requester_data_txn - bits(range_base, 12)) < bits(slots, 12)
        )
  )
  def incoming_requester_data_snoop_target_valid = incoming_requester_data_snoop_target_matches.or_reduce()
  def incoming_requester_data_snoop_target = priority_encoder(incoming_requester_data_snoop_target_matches)
  def incoming_requester_data_snoop_slots = vec(
    for List (index in 0..resident_count):
      (incoming_requester_data_txn - bits(index * slots, 12))[0..slot_width]
  )
  def incoming_requester_data_direct_slot_valid = incoming_requester_data_txn < bits(slots, 12)
  def incoming_requester_data_slot_valid = mux(incoming_requester_data_is_snoop,
                                               incoming_requester_data_snoop_target_valid,
                                               incoming_requester_data_direct_slot_valid)
  def incoming_requester_data_slot = mux(
    incoming_requester_data_is_snoop,
    incoming_requester_data_snoop_slots[incoming_requester_data_snoop_target],
    mux(incoming_requester_data_direct_slot_valid,
        incoming_requester_data_txn[0..slot_width],
        bits(0, slot_width))
  )
  def incoming_requester_data_phase_valid = phases[incoming_requester_data_slot].is_one_of(
    CHIInclusiveHNFPhase.ReceiveRequesterData,
    CHIInclusiveHNFPhase.SendSnoop,
    CHIInclusiveHNFPhase.AwaitSnoop
  )
  def incoming_requester_data_eligible = incoming_requester_data_slot_valid & (
    occupied[incoming_requester_data_slot]
  ) & incoming_requester_data_phase_valid
  requester_data_buffer.ingress.valid <== requester.request_data.valid & incoming_requester_data_eligible
  requester_data_buffer.ingress.bits <== requester.request_data.bits
  requester.request_data.ready <== requester_data_buffer.ingress.ready & incoming_requester_data_eligible
  when (requester.request_data.valid):
    assert(incoming_requester_data_slot_valid, "chi_inclusive_hnf_requester_data_slot_in_range")
    assert(occupied[incoming_requester_data_slot], "chi_inclusive_hnf_requester_data_slot_occupied")
    assert(incoming_requester_data_phase_valid, "chi_inclusive_hnf_requester_data_phase")
  def free_slots = vec(for List (index in 0..slots): !occupied[index])
  def allocation_available = free_slots.or_reduce()
  def allocation_slot = priority_encoder(free_slots)
  def set_conflict = or_reduce(
    for List (index in 0..slots):
      occupied[index] & (cache_set(requests[index].address) === incoming_set)
  ) ||| or_reduce(
    for List (index in 0..comp_ack_entries):
      pending_grants[index] & (pending_grant_sets[index] === incoming_set)
  )
  def incoming_comp_ack_available = !incoming_request.exp_comp_ack ||| comp_acks.available
  requester.requests.ready <== allocation_available & !set_conflict & incoming_comp_ack_available
  def request_fire = requester.requests.fire()
  comp_acks.reserve.valid <== request_fire & incoming_request.exp_comp_ack
  comp_acks.reserve.bits <== incoming_request.src_id

  when (requester.requests.valid & requester.requests.ready):
    assert(chi_hnf_source_known(p, home_config, incoming_request),
           "chi_inclusive_hnf_request_source_known")
    assert(incoming_request.tgt_id === home_id,
           "chi_inclusive_hnf_request_targets_home")
    assert(chi_hnf_request_supported(p, home_config, incoming_request),
           "chi_inclusive_hnf_request_opcode_supported")
    assert(chi_hnf_service_supported(p, incoming_request, home_config, identity.service_base),
           "chi_inclusive_hnf_request_service_supported")

  def lookup_response_valid = tags.port.response.valid
  when lookup_response_valid:
    assert(lines.port.response.valid, "chi_inclusive_hnf_lookup_storage_ready")

  def requester_data_txn = requester_data.bits.txn_id
  def requester_data_is_snoop = requester_data.bits.opcode.is_one_of(
    CHIDatOpcode.SnpRespData,
    CHIDatOpcode.SnpRespDataPtl
  )
  def requester_data_snoop_target_matches = vec(
    for List (index in 0..resident_count):
      block:
        def range_base = index * slots
        (requester_data.bits.src_id === bits(residents[index].node_id, p.node_id_width)) & (
          (requester_data_txn - bits(range_base, 12)) < bits(slots, 12)
        )
  )
  def requester_data_snoop_target_valid = requester_data_snoop_target_matches.or_reduce()
  def requester_data_snoop_target = priority_encoder(requester_data_snoop_target_matches)
  def requester_data_snoop_slots = vec(
    for List (index in 0..resident_count):
      (requester_data_txn - bits(index * slots, 12))[0..slot_width]
  )
  def requester_data_direct_slot_valid = requester_data_txn < bits(slots, 12)
  def requester_data_slot_valid = mux(requester_data_is_snoop,
                                      requester_data_snoop_target_valid,
                                      requester_data_direct_slot_valid)
  def requester_data_slot = mux(
    requester_data_is_snoop,
    requester_data_snoop_slots[requester_data_snoop_target],
    mux(requester_data_direct_slot_valid,
        requester_data_txn[0..slot_width],
        bits(0, slot_width))
  )
  def requester_response_flit = requester_response.bits
  def incoming_comp_ack = requester_response_flit.opcode === CHIRspOpcode.CompAck
  def requester_response_target_matches = vec(
    for List (index in 0..resident_count):
      block:
        def range_base = index * slots
        (requester_response_flit.src_id === bits(residents[index].node_id, p.node_id_width)) & (
          (requester_response_flit.txn_id - bits(range_base, 12)) < bits(slots, 12)
        )
  )
  def requester_response_target_valid = requester_response_target_matches.or_reduce()
  def requester_response_target = priority_encoder(requester_response_target_matches)
  def requester_response_slots = vec(
    for List (index in 0..resident_count):
      (requester_response_flit.txn_id - bits(index * slots, 12))[0..slot_width]
  )
  def requester_response_slot_valid = requester_response_target_valid
  def requester_response_slot = mux(requester_response_slot_valid,
                                    requester_response_slots[requester_response_target],
                                    bits(0, slot_width))
  def subordinate_response_slot_valid = subordinate_response.bits.txn_id < bits(slots, 12)
  def subordinate_response_is_writeback = (subordinate_response.bits.txn_id >= bits(slots, 12)) & (
    subordinate_response.bits.txn_id < bits(slots + victim_writeback_entries, 12)
  )
  def subordinate_response_slot = mux(subordinate_response_slot_valid,
                                      subordinate_response.bits.txn_id[0..slot_width],
                                      bits(0, slot_width))
  def fill_slot_valid = fill_response.bits.txn_id < bits(slots, 12)
  def fill_slot = mux(fill_slot_valid,
                      fill_response.bits.txn_id[0..slot_width],
                      bits(0, slot_width))
  def writeback_completion_slot = victim_writebacks.completion.bits.parent_slot
  def writeback_completion_phase = phases[writeback_completion_slot]
  def writeback_completion_error = victim_writebacks.completion.bits.error
  def writeback_completion_eligible = (writeback_completion_error === CHIRespErr.OK) ||| (
    writeback_completion_phase =/= CHIInclusiveHNFPhase.ReceiveFillData
  )

  victim_writebacks.response.valid <== subordinate_response.valid & subordinate_response_is_writeback
  victim_writebacks.response.bits <== subordinate_response.bits

  def requester_data_pending = requester_data.valid
  def requester_response_pending = requester_response.valid & !incoming_comp_ack
  def subordinate_response_pending = subordinate_response.valid & !subordinate_response_is_writeback
  def fill_pending = fill_response.valid
  def writeback_completion_pending = victim_writebacks.completion.valid & writeback_completion_eligible
  def input_pending = requester_data_pending ||| requester_response_pending ||| (
    subordinate_response_pending
  ) ||| fill_pending ||| writeback_completion_pending
  def input_event = CHIInclusiveHNFInputEvent(slot_width):
    valid: input_pending
    kind: (
      priority_mux(~default: CHIInclusiveHNFInputEventKind.VictimWritebackCompletion):
        requester_data_pending: CHIInclusiveHNFInputEventKind.RequesterData
        requester_response_pending: CHIInclusiveHNFInputEventKind.RequesterResponse
        subordinate_response_pending: CHIInclusiveHNFInputEventKind.SubordinateResponse
        fill_pending: CHIInclusiveHNFInputEventKind.FillData
    )
    slot: (
      priority_mux(~default: writeback_completion_slot):
        requester_data_pending: requester_data_slot
        requester_response_pending: requester_response_slot
        subordinate_response_pending: subordinate_response_slot
        fill_pending: fill_slot
    )

  fun autonomous_phase(value :: CHIInclusiveHNFPhase):
    value.is_one_of(CHIInclusiveHNFPhase.SendRequesterDBID,
                    CHIInclusiveHNFPhase.SendSnoop,
                    CHIInclusiveHNFPhase.AfterSnoops,
                    CHIInclusiveHNFPhase.SendFillRequest,
                    CHIInclusiveHNFPhase.MergeRequesterData,
                    CHIInclusiveHNFPhase.SendRequesterCompletion,
                    CHIInclusiveHNFPhase.SendVictimWriteRequest,
                    CHIInclusiveHNFPhase.SendVictimData,
                    CHIInclusiveHNFPhase.EnqueueVictimWriteback,
                    CHIInclusiveHNFPhase.InstallFill,
                    CHIInclusiveHNFPhase.FinishMaintenance,
                    CHIInclusiveHNFPhase.FinishCopyBack)
  def autonomous_slots = vec(
    for List (index in 0..slots): occupied[index] & autonomous_phase(phases[index])
  )
  def lookup_issue_slots = vec(
    for List (index in 0..slots): occupied[index] & (phases[index] === CHIInclusiveHNFPhase.IssueLookup)
  )
  def lookup_choice :: CircularPriorityChoice(slots, slot_width) = circular_priority_onehot(
    lookup_issue_slots,
    lookup_next_priority
  )
  def lookup_issue_slot = lookup_choice.index
  def response_data_slots = vec(
    for List (index in 0..slots): occupied[index] & (phases[index] === CHIInclusiveHNFPhase.SendCachedData)
  )
  def locked_response_data_slots = vec(
    for List (index in 0..slots): response_data_slots[index] & (
      response_data_owner === bits(index, slot_width)
    )
  )
  def selectable_response_data_slots = mux(response_data_locked,
                                           locked_response_data_slots,
                                           response_data_slots)
  def response_data_choice :: CircularPriorityChoice(slots, slot_width) = circular_priority_onehot(
    selectable_response_data_slots,
    response_data_next_priority
  )
  def response_data_available = response_data_choice.valid
  def response_data_slot = response_data_choice.index
  def locked_advance_slots = vec(
    for List (index in 0..slots): autonomous_slots[index] & (advance_owner === bits(index, slot_width))
  )
  def advance_slots = mux(advance_locked,
                          locked_advance_slots,
                          autonomous_slots)
  def advance_choice :: CircularPriorityChoice(slots, slot_width) = circular_priority_onehot(
    advance_slots,
    advance_next_priority
  )
  def advance_available = advance_choice.valid
  def advance_slot = advance_choice.index
  def advance_phase = phases[advance_slot]
  def advance_pending_targets = pending_snoop_targets[advance_slot]
  def advance_request_candidate = advance_phase.is_one_of(
    CHIInclusiveHNFPhase.SendFillRequest,
    CHIInclusiveHNFPhase.SendVictimWriteRequest
  )
  def advance_data_candidate = advance_phase === CHIInclusiveHNFPhase.SendVictimData
  def locked_request_prefers_writeback = mux(subordinate_request_locked,
                                             subordinate_request_writeback_owner,
                                             victim_writebacks.request.valid & subordinate_request_prefers_writeback)
  def locked_data_prefers_writeback = mux(subordinate_data_locked,
                                          subordinate_data_writeback_owner,
                                          victim_writebacks.data.valid & subordinate_data_prefers_writeback)
  def locked_advance_stalled = advance_locked & (
    (advance_phase.is_one_of(CHIInclusiveHNFPhase.SendRequesterDBID,
                             CHIInclusiveHNFPhase.SendRequesterCompletion) & !requester.responses.ready) ||| (
      (advance_phase === CHIInclusiveHNFPhase.SendSnoop) & advance_pending_targets.or_reduce() & !requester.snoops.ready
    ) ||| (
      (advance_phase === CHIInclusiveHNFPhase.EnqueueVictimWriteback) & !victim_writebacks.enqueue.ready
    ) ||| (advance_request_candidate & (!subordinate.req.ready ||| locked_request_prefers_writeback)) ||| (
      advance_data_candidate & (!subordinate.dat.request.ready ||| locked_data_prefers_writeback)
    )
  )
  def work_from_input = !lookup_response_valid & input_event.valid & (
    !advance_available ||| locked_advance_stalled
  )
  def work_from_advance = (!lookup_response_valid ||| advance_locked) & !work_from_input & advance_available
  def work_valid = work_from_input ||| work_from_advance
  def work_slot = mux(work_from_input, input_event.slot, advance_slot)
  def advance_presented = (!lookup_response_valid ||| advance_locked) & advance_available

  def phase = phases[work_slot]
  def request = requests[work_slot]
  def selected_set = selected_sets[work_slot]
  def selected_way = selected_ways[work_slot]
  def selected_line = line_buffers[work_slot]
  def victim_address = victim_addresses[work_slot]
  def snoop_victim = snoop_victims[work_slot]
  def received_requester_ids = received_requester_data_ids[work_slot]
  def received_snoop_ids = received_snoop_data_ids[work_slot][requester_data_snoop_target]
  def received_fill_ids = received_fill_data_ids[work_slot]
  def completion_error = completion_errors[work_slot]
  def copyback_state = copyback_states[work_slot]
  def copyback = request.opcode === CHIReqOpcode.WriteBackFull
  def copyback_dirty = copyback_state[2].into(Bool)
  def maintenance = chi_cache_maintenance(request.opcode)
  def maintenance_discard = request.opcode === CHIReqOpcode.MakeInvalid
  def request_write = chi_hnf_subordinate_opcode(request.opcode).is_initial_write()
  def request_installs_miss = (request.opcode =/= CHIReqOpcode.ReadOnce) ||| request.mem_attr.allocate
  def selected_dirty = dirty_lines[selected_set][selected_way]
  def advance_request = requests[advance_slot]
  def advance_selected_line = line_buffers[advance_slot]
  def advance_victim_address = victim_addresses[advance_slot]
  def advance_snoop_victim = snoop_victims[advance_slot]
  def advance_completion_error = completion_errors[advance_slot]
  def advance_copyback = advance_request.opcode === CHIReqOpcode.WriteBackFull
  def advance_maintenance = chi_cache_maintenance(advance_request.opcode)

  fun selected_input(kind :: CHIInclusiveHNFInputEventKind):
    work_from_input & (input_event.kind === kind)
  def selected_requester_data = selected_input(CHIInclusiveHNFInputEventKind.RequesterData)
  def selected_requester_response = selected_input(CHIInclusiveHNFInputEventKind.RequesterResponse)
  def selected_subordinate_response = selected_input(CHIInclusiveHNFInputEventKind.SubordinateResponse)
  def selected_fill = selected_input(CHIInclusiveHNFInputEventKind.FillData)
  def selected_writeback_completion = selected_input(CHIInclusiveHNFInputEventKind.VictimWritebackCompletion)

  requester_data.ready <== selected_requester_data
  requester_response.ready <== mux(
    incoming_comp_ack,
    comp_acks.acknowledgement.ready,
    selected_requester_response
  )
  subordinate_response.ready <== mux(subordinate_response_is_writeback,
                                     victim_writebacks.response.ready,
                                     selected_subordinate_response)
  fill_response.ready <== selected_fill
  victim_writebacks.completion.ready <== selected_writeback_completion
  comp_acks.acknowledgement.valid <== requester_response.valid & incoming_comp_ack
  comp_acks.acknowledgement.bits <== requester_response_flit
  def comp_ack_fire = comp_acks.acknowledgement.fire()
  def completed_comp_ack_slot = requester_response_flit.txn_id[0..comp_ack_slot_width]

  def requester_data_fire = requester_data.fire()
  def requester_response_fire = requester_response.fire() & !incoming_comp_ack
  def subordinate_response_fire = subordinate_response.fire()
  def slot_subordinate_response_fire = subordinate_response_fire & !subordinate_response_is_writeback
  def fill_data_fire = fill_response.fire()
  def writeback_completion_fire = victim_writebacks.completion.fire()

  when (requester_response.valid & !incoming_comp_ack):
    assert(requester_response_slot_valid, "chi_inclusive_hnf_requester_response_slot_in_range")
    assert(occupied[requester_response_slot], "chi_inclusive_hnf_requester_response_slot_occupied")
    assert(phases[requester_response_slot].is_one_of(CHIInclusiveHNFPhase.SendSnoop,
                                                     CHIInclusiveHNFPhase.AwaitSnoop),
           "chi_inclusive_hnf_requester_response_phase")
  when (subordinate_response.valid & !subordinate_response_is_writeback):
    assert(subordinate_response_slot_valid, "chi_inclusive_hnf_subordinate_response_slot_in_range")
    assert(occupied[subordinate_response_slot], "chi_inclusive_hnf_subordinate_response_slot_occupied")
    assert(phases[subordinate_response_slot].is_one_of(CHIInclusiveHNFPhase.AwaitVictimDBID,
                                                       CHIInclusiveHNFPhase.AwaitVictimCompletion),
           "chi_inclusive_hnf_subordinate_response_phase")
  when (fill_response.valid):
    assert(fill_slot_valid, "chi_inclusive_hnf_fill_slot_in_range")
    assert(occupied[fill_slot], "chi_inclusive_hnf_fill_slot_occupied")
    assert(phases[fill_slot] === CHIInclusiveHNFPhase.ReceiveFillData,
           "chi_inclusive_hnf_fill_phase")
  when (victim_writebacks.completion.valid):
    assert(occupied[writeback_completion_slot],
           "chi_inclusive_hnf_victim_writeback_parent_occupied")
    assert(victim_writebacks_pending[writeback_completion_slot],
           "chi_inclusive_hnf_victim_writeback_parent_pending")

  def send_requester_dbid = advance_presented & (advance_phase === CHIInclusiveHNFPhase.SendRequesterDBID)
  def send_requester_completion = advance_presented & (advance_phase === CHIInclusiveHNFPhase.SendRequesterCompletion)
  requester.responses.valid <== send_requester_dbid ||| send_requester_completion
  requester.responses.bits <== chi_hnf_response(
    p,
    home_id,
    advance_request,
    mux(send_requester_dbid,
        mux(advance_copyback, CHIRspOpcode.CompDBIDResp, CHIRspOpcode.DBIDResp),
        CHIRspOpcode.Comp),
    ~dbid: mux(send_requester_dbid, slot_txn_id(advance_slot), bits(0, 12)),
    ~error: advance_completion_error
  )
  def requester_output_response_fire = requester.responses.fire()

  def receiving_requester_data = phase === CHIInclusiveHNFPhase.ReceiveRequesterData
  def awaiting_snoop = phase.is_one_of(CHIInclusiveHNFPhase.SendSnoop,
                                       CHIInclusiveHNFPhase.AwaitSnoop)
  def requester_write_data_fire = requester_data_fire & receiving_requester_data
  def snoop_data_fire = requester_data_fire & awaiting_snoop
  def requester_data_id_mask = one_hot(requester_data.bits.data_id).as_bits()
  def expected_requester_data_ids = chi_transfer_data_ids(request.address, chi_req_size(p, request), p)
  def next_requester_data_ids = received_requester_ids ||| requester_data_id_mask
  def final_requester_data = next_requester_data_ids === expected_requester_data_ids
  def requester_write_line_packet = chi_transfer_beat(requester_data.bits.data_id, p)[0..packet_index_width]
  def requester_write_line_data_mask = vec(
    for List (packet in 0..line_packets): requester_write_line_packet === bits(packet, packet_index_width)
  ).as_bits()
  when requester_write_data_fire:
    assert(requester_data.bits.opcode === mux(copyback, CHIDatOpcode.CopyBackWriteData, CHIDatOpcode.NonCopyBackWriteData),
           "chi_inclusive_hnf_requester_write_opcode")
    assert(requester_data.bits.src_id === request.src_id,
           "chi_inclusive_hnf_requester_write_source")
    assert(requester_data.bits.tgt_id === home_id,
           "chi_inclusive_hnf_requester_write_target")
    assert(requester_data.bits.txn_id === slot_txn_id(work_slot),
           "chi_inclusive_hnf_requester_write_dbid")
    assert((expected_requester_data_ids & requester_data_id_mask).or_reduce(),
           "chi_inclusive_hnf_requester_write_data_id_expected")
    assert(!(received_requester_ids & requester_data_id_mask).or_reduce(),
           "chi_inclusive_hnf_requester_write_data_id_unique")
    when copyback:
      monitor_chi_copyback_data(p, requester_data.bits, "chi_inclusive_hnf_copyback")
      assert(!received_requester_ids.or_reduce() ||| (requester_data.bits.resp === copyback_state),
             "chi_inclusive_hnf_copyback_state_consistent")

  def snoop_data_id_mask = one_hot(requester_data.bits.data_id).as_bits()
  def next_snoop_data_ids = received_snoop_ids ||| snoop_data_id_mask
  def expected_snoop_data_ids = chi_transfer_data_ids(bits(0, p.request_address_width), CHITransferSize.Bytes64, p)
  def final_snoop_data = next_snoop_data_ids === expected_snoop_data_ids
  def snoop_opcode = mux(snoop_victim, CHISnpOpcode.SnpCleanInvalid, chi_home_snoop_opcode(request.opcode))
  def advance_snoop_opcode = mux(advance_snoop_victim,
                                 CHISnpOpcode.SnpCleanInvalid,
                                 chi_home_snoop_opcode(advance_request.opcode))
  def outstanding_targets = outstanding_snoop_targets[work_slot]
  def snoop_data_target_outstanding = outstanding_targets[requester_data_snoop_target]
  def requester_response_target_outstanding = outstanding_targets[requester_response_target]
  def other_snoop_data_received = or_reduce(
    for List (index in 0..resident_count):
      (requester_data_snoop_target =/= bits(index, resident_width)) & (
        received_snoop_data_ids[work_slot][index].or_reduce()
      )
  )
  when snoop_data_fire:
    assert(chi_snoop_response_state_valid(snoop_opcode, requester_data.bits.resp.into(CHICoherentResponse())),
           "chi_inclusive_hnf_snoop_data_state")
    assert(!maintenance_discard, "chi_inclusive_hnf_discard_has_no_data")
    assert(requester_data.bits.txn_id === snoop_txn_id(work_slot, requester_data_snoop_target),
           "chi_inclusive_hnf_snoop_data_txn")
    assert(snoop_data_target_outstanding,
           "chi_inclusive_hnf_snoop_data_outstanding")
    assert((expected_snoop_data_ids & snoop_data_id_mask).or_reduce(),
           "chi_inclusive_hnf_snoop_data_id_expected")
    assert(requester_data.bits.opcode.is_one_of(CHIDatOpcode.SnpRespData,
                                                CHIDatOpcode.SnpRespDataPtl),
           "chi_inclusive_hnf_snoop_data_opcode")
    assert(requester_data.bits.tgt_id === home_id,
           "chi_inclusive_hnf_snoop_data_target")
    assert(requester_data.bits.resp.into(CHICoherentResponse()).pass_dirty,
           "chi_inclusive_hnf_snoop_data_dirty")
    assert(!other_snoop_data_received,
           "chi_inclusive_hnf_snoop_data_single_dirty_responder")
    assert(!(received_snoop_ids & snoop_data_id_mask).or_reduce(),
           "chi_inclusive_hnf_snoop_data_id_unique")

  def pending_targets = pending_snoop_targets[work_slot]
  def snoops_remaining = advance_pending_targets.or_reduce()
  def next_snoop_index = priority_encoder(advance_pending_targets)
  def next_snoop_node = vec(
    for List (endpoint in residents): bits(endpoint.node_id, p.node_id_width)
  )[next_snoop_index]
  def next_snoop_txn_id = snoop_txn_id(advance_slot, next_snoop_index)
  def send_snoop = advance_presented & (advance_phase === CHIInclusiveHNFPhase.SendSnoop)
  def snoop_address = mux(advance_snoop_victim,
                          advance_victim_address,
                          advance_request.address)
  requester.snoops.valid <== send_snoop & snoops_remaining
  requester.snoops.bits <== CHISnoopDispatch(p):
    target_id: next_snoop_node
    flit: chi_hnf_snoop(p, home_id, advance_request,
                        ~address: snoop_address,
                        ~opcode: advance_snoop_opcode,
                        ~txn_id: next_snoop_txn_id)
  def snoop_fire = requester.snoops.fire()
  def pending_targets_after_issue = advance_pending_targets.updated(next_snoop_index, Bool(#false))
  def outstanding_targets_after_issue = outstanding_targets.updated(next_snoop_index, Bool(#true))
  def outstanding_targets_after_response = outstanding_targets.updated(requester_response_target, Bool(#false))
  def outstanding_targets_after_data = outstanding_targets.updated(requester_data_snoop_target, Bool(#false))
  def phase_after_response = mux(pending_targets.or_reduce(),
                                 CHIInclusiveHNFPhase.SendSnoop,
                                 mux(outstanding_targets_after_response.or_reduce(),
                                     CHIInclusiveHNFPhase.AwaitSnoop,
                                     CHIInclusiveHNFPhase.AfterSnoops))
  def phase_after_data = mux(pending_targets.or_reduce(),
                             CHIInclusiveHNFPhase.SendSnoop,
                             mux(outstanding_targets_after_data.or_reduce(),
                                 CHIInclusiveHNFPhase.AwaitSnoop,
                                 CHIInclusiveHNFPhase.AfterSnoops))

  when requester_response_fire:
    assert(chi_snoop_response_state_valid(snoop_opcode, requester_response_flit.resp.into(CHICoherentResponse())),
           "chi_inclusive_hnf_snoop_response_state")
    assert(requester_response_flit.tgt_id === home_id,
           "chi_inclusive_hnf_snoop_response_target")
    assert(requester_response_flit.txn_id === snoop_txn_id(work_slot, requester_response_target),
           "chi_inclusive_hnf_snoop_response_txn")
    assert(requester_response_flit.opcode === CHIRspOpcode.SnpResp,
           "chi_inclusive_hnf_snoop_response_opcode")
    assert(requester_response_target_outstanding,
           "chi_inclusive_hnf_snoop_response_outstanding")
    assert(!received_snoop_data_ids[work_slot][requester_response_target].or_reduce(),
           "chi_inclusive_hnf_snoop_response_without_data")
    assert(!requester_response_flit.resp.into(CHICoherentResponse()).pass_dirty,
           "chi_inclusive_hnf_snoop_response_clean")

  def enqueue_victim_writeback = advance_presented & (
    advance_phase === CHIInclusiveHNFPhase.EnqueueVictimWriteback
  )
  victim_writebacks.enqueue.valid <== enqueue_victim_writeback
  victim_writebacks.enqueue.bits <== CHIInclusiveVictimWriteback(p, slot_width):
    parent_slot: advance_slot
    request: advance_request
    address: advance_victim_address
    line: advance_selected_line.as_bits()
  def victim_writeback_enqueue_fire = victim_writebacks.enqueue.fire()

  def send_fill_request = advance_presented & (advance_phase === CHIInclusiveHNFPhase.SendFillRequest)
  def send_victim_write_request = advance_presented & (advance_phase === CHIInclusiveHNFPhase.SendVictimWriteRequest)
  def slot_subordinate_request_valid = send_fill_request ||| send_victim_write_request
  def slot_subordinate_request_bits = chi_hnf_downstream_request(
    p,
    home_id,
    subordinate_id,
    advance_request,
    ~address: mux(send_victim_write_request & !advance_maintenance,
                  advance_victim_address,
                  advance_request.address.align_down(64)),
    ~size: bits(6, 6),
    ~opcode: mux(send_victim_write_request,
                 CHIReqOpcode.WriteNoSnpFull,
                 CHIReqOpcode.ReadNoSnp),
    ~txn_id: slot_txn_id(advance_slot)
  )
  def unlocked_subordinate_request_writeback = victim_writebacks.request.valid & (
    !slot_subordinate_request_valid ||| subordinate_request_prefers_writeback
  )
  def selected_subordinate_request_writeback = mux(subordinate_request_locked,
                                                   subordinate_request_writeback_owner,
                                                   unlocked_subordinate_request_writeback)
  subordinate.req.valid <== mux(selected_subordinate_request_writeback,
                                victim_writebacks.request.valid,
                                slot_subordinate_request_valid)
  subordinate.req.bits <== mux(selected_subordinate_request_writeback,
                               victim_writebacks.request.bits,
                               slot_subordinate_request_bits)
  victim_writebacks.request.ready <== subordinate.req.ready & selected_subordinate_request_writeback
  def slot_subordinate_request_ready = subordinate.req.ready & !selected_subordinate_request_writeback
  def subordinate_request_fire = slot_subordinate_request_valid & slot_subordinate_request_ready
  def subordinate_request_output_fire = subordinate.req.fire()
  when (subordinate.req.valid & !subordinate.req.ready):
    subordinate_request_locked <== Bool(#true)
    subordinate_request_writeback_owner <== selected_subordinate_request_writeback
  elsewhen subordinate_request_output_fire:
    subordinate_request_locked <== Bool(#false)
    subordinate_request_prefers_writeback <== !selected_subordinate_request_writeback

  def await_victim_dbid = phase === CHIInclusiveHNFPhase.AwaitVictimDBID
  def await_victim_completion = phase === CHIInclusiveHNFPhase.AwaitVictimCompletion
  when slot_subordinate_response_fire:
    assert(subordinate_response.bits.src_id === subordinate_id,
           "chi_inclusive_hnf_write_response_source")
    assert(subordinate_response.bits.tgt_id === home_id,
           "chi_inclusive_hnf_write_response_target")
    assert(subordinate_response.bits.txn_id === slot_txn_id(work_slot),
           "chi_inclusive_hnf_write_response_txn")
    assert(subordinate_response.bits.opcode === mux(await_victim_dbid,
                                                    CHIRspOpcode.DBIDResp,
                                                    CHIRspOpcode.Comp),
           "chi_inclusive_hnf_write_response_opcode")

  def send_victim_data = advance_presented & (advance_phase === CHIInclusiveHNFPhase.SendVictimData)
  def victim_data_beat = victim_data_beats[advance_slot]
  def victim_data_id = chi_transfer_data_id(victim_data_beat, p)
  def slot_subordinate_data_bits = chi_inclusive_victim_data(
    p,
    home_id,
    subordinate_id,
    advance_request,
    subordinate_dbids[advance_slot],
    victim_data_id,
    advance_selected_line[victim_data_beat[0..packet_index_width]]
  )
  def final_victim_data = victim_data_beat === chi_data_beats_minus_one(CHITransferSize.Bytes64, p)
  def unlocked_subordinate_data_writeback = victim_writebacks.data.valid & (
    !send_victim_data ||| subordinate_data_prefers_writeback
  )
  def selected_subordinate_data_writeback = mux(subordinate_data_locked,
                                                subordinate_data_writeback_owner,
                                                unlocked_subordinate_data_writeback)
  subordinate.dat.request.valid <== mux(selected_subordinate_data_writeback,
                                        victim_writebacks.data.valid,
                                        send_victim_data)
  subordinate.dat.request.bits <== mux(selected_subordinate_data_writeback,
                                       victim_writebacks.data.bits,
                                       slot_subordinate_data_bits)
  victim_writebacks.data.ready <== subordinate.dat.request.ready & selected_subordinate_data_writeback
  def slot_subordinate_data_ready = subordinate.dat.request.ready & !selected_subordinate_data_writeback
  def subordinate_data_fire = send_victim_data & slot_subordinate_data_ready
  def subordinate_data_output_fire = subordinate.dat.request.fire()
  def selected_subordinate_data_final = mux(
    selected_subordinate_data_writeback,
    victim_writebacks.data.bits.data_id === chi_transfer_data_id(
      chi_data_beats_minus_one(CHITransferSize.Bytes64, p),
      p
    ),
    final_victim_data
  )
  when (subordinate.dat.request.valid & !subordinate.dat.request.ready):
    subordinate_data_locked <== Bool(#true)
    subordinate_data_writeback_owner <== selected_subordinate_data_writeback
  elsewhen (subordinate_data_output_fire & selected_subordinate_data_final):
    subordinate_data_locked <== Bool(#false)
    subordinate_data_prefers_writeback <== !selected_subordinate_data_writeback
  elsewhen subordinate_data_output_fire:
    subordinate_data_locked <== Bool(#true)
    subordinate_data_writeback_owner <== selected_subordinate_data_writeback

  def fill_data_id_mask = one_hot(fill_response.bits.data_id).as_bits()
  def next_fill_data_ids = received_fill_ids ||| fill_data_id_mask
  def expected_fill_data_ids = chi_transfer_data_ids(bits(0, p.request_address_width), CHITransferSize.Bytes64, p)
  def final_fill_data = next_fill_data_ids === expected_fill_data_ids
  when fill_data_fire:
    assert(fill_response.bits.opcode === CHIDatOpcode.CompData,
           "chi_inclusive_hnf_fill_data_opcode")
    assert(fill_response.bits.src_id === subordinate_id,
           "chi_inclusive_hnf_fill_data_source")
    assert(fill_response.bits.tgt_id === home_id,
           "chi_inclusive_hnf_fill_data_target")
    assert(fill_response.bits.txn_id === slot_txn_id(work_slot),
           "chi_inclusive_hnf_fill_data_txn")
    assert(!(received_fill_ids & fill_data_id_mask).or_reduce(),
           "chi_inclusive_hnf_fill_data_id_unique")

  def request_response_data_ids = chi_transfer_data_ids(request.address, chi_req_size(p, request), p)
  def response_request = requests[response_data_slot]
  def response_comp_ack_slot = comp_ack_slots[response_data_slot]
  def response_selected_set = selected_sets[response_data_slot]
  def response_selected_way = selected_ways[response_data_slot]
  def response_selected_line = line_buffers[response_data_slot]
  def response_completion_error = completion_errors[response_data_slot]
  def response_remaining_ids = remaining_response_data_ids[response_data_slot]
  def selected_response_data_id = priority_encoder(response_remaining_ids.as_vec(Bool))
  def final_response_data = response_remaining_ids === one_hot(selected_response_data_id).as_bits()
  def response_line_packet = chi_transfer_beat(selected_response_data_id, p)[0..packet_index_width]
  requester.response_data.valid <== response_data_available
  def cached_response = chi_inclusive_cached_data(
    p,
    home_id,
    response_request,
    requester_allocates[response_data_slot],
    mux(response_request.exp_comp_ack, response_comp_ack_slot.zext(12), bits(0, 12)),
    selected_response_data_id,
    response_selected_line[response_line_packet]
  )
  requester.response_data.bits <== cached_response.updated(
    ~resp_err: response_completion_error,
    ~resp: mux(response_completion_error === CHIRespErr.OK, cached_response.resp, bits(0, 3))
  )
  def cached_data_fire = requester.response_data.fire()
  comp_acks.publish.valid <== cached_data_fire & final_response_data & response_request.exp_comp_ack
  comp_acks.publish.bits <== response_comp_ack_slot

  def requester_write_valids = requester_write_line_valids[work_slot].as_vec(Bool)
  def merged_line = vec(
    for List (packet in 0..line_packets):
      block:
        def packet_data = requester_write_data[work_slot][packet]
        def merged_packet = selected_line[packet].masked_merge(packet_data.data,
                                                               packet_data.byte_enable.expand_mask(8))
        mux(requester_write_valids[packet], merged_packet, selected_line[packet])
  )
  def snoop_line_packet = chi_transfer_beat(requester_data.bits.data_id, p)[0..packet_index_width]
  def merged_snoop_packet = selected_line[snoop_line_packet].masked_merge(
    requester_data.bits.data,
    requester_data.bits.byte_enable.expand_mask(8)
  )
  def fill_line_packet = chi_transfer_beat(fill_response.bits.data_id, p)[0..packet_index_width]
  def final_fill_line = selected_line.updated(fill_line_packet, fill_response.bits.data)
  def fill_successful = (completion_error === CHIRespErr.OK) & (
    fill_response.bits.resp_err === CHIRespErr.OK
  )
  def victim_write_successful = (completion_error === CHIRespErr.OK) & (
    subordinate_response.bits.resp_err === CHIRespErr.OK
  )

  def after_snoops = work_from_advance & (phase === CHIInclusiveHNFPhase.AfterSnoops)
  def merge_requester_data = work_from_advance & (phase === CHIInclusiveHNFPhase.MergeRequesterData)
  def finish_copyback = work_from_advance & (phase === CHIInclusiveHNFPhase.FinishCopyBack)
  def finish_maintenance = work_from_advance & (phase === CHIInclusiveHNFPhase.FinishMaintenance)
  def install_buffered_fill = work_from_advance & (phase === CHIInclusiveHNFPhase.InstallFill)
  def restore_victim = writeback_completion_fire & (
    writeback_completion_error =/= CHIRespErr.OK
  )
  def write_line_after_snoops = after_snoops & ((!snoop_victim & (!maintenance ||| (
    maintenance_hits[work_slot] & !maintenance_discard
  ))) ||| (snoop_victim & (completion_error =/= CHIRespErr.OK)))
  def write_direct_fill = fill_data_fire & final_fill_data & fill_successful & request_installs_miss & (
    !victim_writebacks_pending[work_slot]
  )
  def write_filled_line = write_direct_fill ||| install_buffered_fill
  def write_merged_line = merge_requester_data ||| (finish_copyback & copyback_dirty)
  def write_line = write_line_after_snoops ||| write_filled_line ||| write_merged_line ||| restore_victim
  def selected_way_mask = vec(
    for List (way in 0..ways): selected_way === bits(way, way_width)
  ).into(Mask(ways))
  def line_write_data = mux(restore_victim,
                            victim_writebacks.completion.bits.line.as_vec(Bits(p.data_width)),
                            mux(write_filled_line,
                                mux(install_buffered_fill, selected_line, final_fill_line),
                                mux(write_merged_line, merged_line, selected_line)))
  def issue_lookup = lookup_choice.valid & !write_line
  def lookup_issue_request = requests[lookup_issue_slot]
  def lookup_issue_set = cache_set(lookup_issue_request.address)
  def lookup_issue_line_address = line_address(lookup_issue_request.address)
  def fill_line_address = line_address(request.address)

  def slot_shared_output_valid = requester.responses.valid ||| requester.snoops.valid ||| (
    slot_subordinate_request_valid
  ) ||| send_victim_data ||| victim_writebacks.enqueue.valid
  def slot_shared_output_fire = requester.responses.fire() ||| requester.snoops.fire() ||| (
    subordinate_request_fire
  ) ||| subordinate_data_fire ||| victim_writeback_enqueue_fire
  def advance_stalled = advance_presented & slot_shared_output_valid & !slot_shared_output_fire
  when advance_stalled:
    advance_locked <== Bool(#true)
    advance_owner <== advance_slot
  elsewhen (advance_locked & work_from_advance):
    advance_locked <== Bool(#false)
  when (work_from_advance & (!slot_shared_output_valid ||| slot_shared_output_fire)):
    advance_next_priority <== next_slot_priority(work_slot)

  def response_data_stalled = requester.response_data.valid & !requester.response_data.ready
  when response_data_stalled:
    response_data_locked <== Bool(#true)
    response_data_owner <== response_data_slot
  elsewhen (response_data_locked & cached_data_fire):
    response_data_locked <== Bool(#false)
  when cached_data_fire:
    response_data_next_priority <== next_slot_priority(response_data_slot)

  tags.port.request.valid <== issue_lookup ||| write_filled_line
  tags.port.request.bits <== ReadWriteRequest(set_width, Bits(line_address_width), ways):
    address: mux(issue_lookup, lookup_issue_set, selected_set)
    write: write_filled_line
    data: vec(for List (_way in 0..ways): fill_line_address)
    mask: mux(write_filled_line, selected_way_mask, Mask(ways)(0))
  lines.port.request.valid <== issue_lookup ||| write_line
  lines.port.request.bits <== ReadWriteRequest(set_width, Bits(512), ways):
    address: mux(issue_lookup, lookup_issue_set, selected_set)
    write: write_line
    data: vec(for List (_way in 0..ways): line_write_data.as_bits())
    mask: mux(write_line, selected_way_mask, Mask(ways)(0))
  when issue_lookup:
    lookup_owner <== lookup_issue_slot
    lookup_next_priority <== next_slot_priority(lookup_issue_slot)

  def lookup_request = requests[lookup_owner]
  def lookup_set = cache_set(lookup_request.address)
  def lookup_line_address = line_address(lookup_request.address)
  def lookup_valids = valid_lines[lookup_set]
  def lookup_matches = vec(
    for List (way in 0..ways):
      lookup_valids[way] & (tags.port.response.bits[way] === lookup_line_address)
  )
  def lookup_selection = priority_encoder_oh(lookup_matches)
  def allocation_way = plru_replacement_way(ways, lookup_valids, replacement_state[lookup_set])
  def lookup_way = mux(lookup_selection.valid, lookup_selection.index, allocation_way)
  def lookup_victim_valid = lookup_valids[allocation_way]
  def lookup_victim_address = concat(tags.port.response.bits[allocation_way], bits(0, offset_width))
  def lookup_copyback = lookup_request.opcode === CHIReqOpcode.WriteBackFull
  def lookup_maintenance = chi_cache_maintenance(lookup_request.opcode)
  def lookup_maintenance_discard = lookup_request.opcode === CHIReqOpcode.MakeInvalid
  def lookup_request_write = chi_hnf_subordinate_opcode(lookup_request.opcode).is_initial_write()
  def lookup_installs_miss = (lookup_request.opcode =/= CHIReqOpcode.ReadOnce) ||| lookup_request.mem_attr.allocate
  def lookup_snoop_victim = !lookup_selection.valid & !lookup_maintenance & lookup_installs_miss
  def lookup_enters_snoop_path = lookup_selection.valid ||| lookup_maintenance ||| (
    lookup_victim_valid & lookup_installs_miss
  )
  def lookup_snoop_targets = vec(
    for List (index in 0..resident_count):
      block:
        def endpoint = residents[index]
        def resident = valid_lines[lookup_set][lookup_way] & resident_lines[lookup_set][lookup_way].as_vec(Bool)[index]
        def read_needs_writer = lookup_request.opcode.is_one_of(CHIReqOpcode.ReadClean, CHIReqOpcode.ReadOnce)
        def read_target = chi_request_snoops_caches(lookup_request.opcode) & (lookup_request.src_id =/= bits(endpoint.node_id, p.node_id_width)) & (!read_needs_writer ||| may_write_lines[lookup_set][lookup_way].as_vec(Bool)[index])
        resident & mux(
          lookup_maintenance,
          lookup_selection.valid & ((lookup_request.src_id =/= bits(endpoint.node_id, p.node_id_width)) ||| lookup_request.excl_snoop_me_cah),
          mux(lookup_selection.valid,
              read_target,
              lookup_installs_miss))
  )
  def lookup_has_snoop_targets = lookup_snoop_targets.or_reduce()
  def zero_snoop_lookup = lookup_response_valid & !lookup_copyback & lookup_enters_snoop_path & !lookup_has_snoop_targets
  def zero_snoop_clean_victim = zero_snoop_lookup & lookup_snoop_victim & !dirty_lines[lookup_set][lookup_way]
  for (left in 0..ways):
    for (right in (left + 1)..ways):
      when lookup_response_valid:
        assert(!(lookup_matches[left] & lookup_matches[right]),
               "chi_inclusive_hnf_hit_unique")

  for (index in 0..slots):
    def index_tag = bits(index, slot_width)
    def allocate_index = request_fire & (allocation_slot === index_tag)
    def lookup_index = lookup_response_valid & (lookup_owner === index_tag)
    def lookup_issue_index = issue_lookup & (lookup_issue_slot === index_tag)
    def response_data_index = cached_data_fire & (response_data_slot === index_tag)
    def work_index = work_valid & (work_slot === index_tag)
    def slot_incoming_write = chi_hnf_subordinate_opcode(incoming_request.opcode).is_initial_write()

    when allocate_index:
      occupied[index] <== Bool(#true)
      phases[index] <== mux(slot_incoming_write,
                            CHIInclusiveHNFPhase.SendRequesterDBID,
                            CHIInclusiveHNFPhase.IssueLookup)
      requests[index] <== incoming_request
      comp_ack_slots[index] <== comp_acks.allocation_slot
      requester_allocates[index] <== chi_request_allocates_coherent(incoming_request.opcode)
      received_requester_data_ids[index] <== bits(0, 4)
      requester_write_line_valids[index] <== bits(0, line_packets)
      completion_errors[index] <== CHIRespErr.OK
      victim_writebacks_pending[index] <== Bool(#false)
    elsewhen lookup_index:
      selected_sets[index] <== lookup_set
      selected_ways[index] <== lookup_way
      line_buffers[index] <== lines.port.response.bits[lookup_way].as_vec(Bits(p.data_width))
      victim_addresses[index] <== lookup_victim_address
      snoop_victims[index] <== lookup_snoop_victim
      maintenance_hits[index] <== lookup_selection.valid
      maintenance_dirty[index] <== lookup_selection.valid & dirty_lines[lookup_set][lookup_way]
      pending_snoop_targets[index] <== mux(lookup_copyback,
                                           vec(for List (_resident in 0..resident_count): Bool(#false)),
                                           lookup_snoop_targets)
      outstanding_snoop_targets[index] <== vec(
        for List (_resident in 0..resident_count): Bool(#false)
      )
      received_snoop_data_ids[index] <== vec(
        for List (_resident in 0..resident_count): bits(0, 4)
      )
      snoop_retains_copies[index] <== vec(
        for List (_resident in 0..resident_count): Bool(#false)
      )
      when lookup_copyback:
        assert(!copyback_states[index][2].into(Bool) ||| lookup_selection.valid,
               "chi_inclusive_hnf_dirty_copyback_has_entry")
        phases[index] <== CHIInclusiveHNFPhase.FinishCopyBack
      elsewhen (!lookup_enters_snoop_path):
        phases[index] <== CHIInclusiveHNFPhase.SendFillRequest
      elsewhen lookup_has_snoop_targets:
        phases[index] <== CHIInclusiveHNFPhase.SendSnoop
      otherwise:
        victim_data_beats[index] <== bits(0, 2)
        remaining_response_data_ids[index] <== chi_transfer_data_ids(
          lookup_request.address,
          chi_req_size(p, lookup_request),
          p
        )
        when lookup_maintenance:
          phases[index] <== mux(dirty_lines[lookup_set][lookup_way] & !lookup_maintenance_discard,
                                CHIInclusiveHNFPhase.SendVictimWriteRequest,
                                CHIInclusiveHNFPhase.FinishMaintenance)
        elsewhen lookup_snoop_victim:
          phases[index] <== mux(dirty_lines[lookup_set][lookup_way],
                                CHIInclusiveHNFPhase.EnqueueVictimWriteback,
                                CHIInclusiveHNFPhase.SendFillRequest)
        otherwise:
          phases[index] <== mux(lookup_request_write,
                                CHIInclusiveHNFPhase.MergeRequesterData,
                                CHIInclusiveHNFPhase.SendCachedData)
    elsewhen response_data_index:
      remaining_response_data_ids[index] <== response_remaining_ids & !one_hot(
        selected_response_data_id
      ).as_bits()
      when final_response_data:
        occupied[index] <== Bool(#false)
        phases[index] <== CHIInclusiveHNFPhase.Idle
    elsewhen work_index:
      when (requester_output_response_fire & send_requester_dbid):
        phases[index] <== CHIInclusiveHNFPhase.ReceiveRequesterData
      elsewhen requester_write_data_fire:
        copyback_states[index] <== requester_data.bits.resp
        requester_write_data[index] <== requester_write_data[index].updated(
          requester_write_line_packet,
          requester_data.bits
        )
        requester_write_line_valids[index] <== requester_write_line_valids[index] ||| requester_write_line_data_mask
        received_requester_data_ids[index] <== next_requester_data_ids
        phases[index] <== mux(final_requester_data,
                              CHIInclusiveHNFPhase.IssueLookup,
                              CHIInclusiveHNFPhase.ReceiveRequesterData)
      elsewhen (send_snoop & !snoops_remaining):
        phases[index] <== mux(outstanding_targets.or_reduce(),
                              CHIInclusiveHNFPhase.AwaitSnoop,
                              CHIInclusiveHNFPhase.AfterSnoops)
      elsewhen snoop_fire:
        pending_snoop_targets[index] <== pending_targets_after_issue
        outstanding_snoop_targets[index] <== outstanding_targets_after_issue
        phases[index] <== mux(pending_targets_after_issue.or_reduce(),
                              CHIInclusiveHNFPhase.SendSnoop,
                              CHIInclusiveHNFPhase.AwaitSnoop)
      elsewhen requester_response_fire:
        outstanding_snoop_targets[index] <== outstanding_targets_after_response
        phases[index] <== phase_after_response
      elsewhen snoop_data_fire:
        snoop_retains_copies[index] <== snoop_retains_copies[index].updated(
          requester_data_snoop_target,
          snoop_retains_copies[index][requester_data_snoop_target] ||| (
            requester_data.bits.resp.into(CHICoherentResponse()).state =/= CHIResponseState.Invalid
          ) ||| (requester_data.bits.resp_err =/= CHIRespErr.OK)
        )
        line_buffers[index] <== selected_line.updated(snoop_line_packet, merged_snoop_packet)
        maintenance_dirty[index] <== Bool(#true)
        received_snoop_data_ids[index] <== received_snoop_data_ids[index].updated(
          requester_data_snoop_target,
          next_snoop_data_ids
        )
        when final_snoop_data:
          outstanding_snoop_targets[index] <== outstanding_targets_after_data
        phases[index] <== mux(final_snoop_data,
                              phase_after_data,
                              phase)
      elsewhen writeback_completion_fire:
        victim_writebacks_pending[index] <== Bool(#false)
        when (writeback_completion_error =/= CHIRespErr.OK):
          remaining_response_data_ids[index] <== request_response_data_ids
          phases[index] <== mux(request_write,
                                CHIInclusiveHNFPhase.SendRequesterCompletion,
                                CHIInclusiveHNFPhase.SendCachedData)
        elsewhen (phase === CHIInclusiveHNFPhase.AwaitVictimWriteback):
          phases[index] <== mux(completion_error === CHIRespErr.OK,
                                CHIInclusiveHNFPhase.InstallFill,
                                mux(request_write,
                                    CHIInclusiveHNFPhase.SendRequesterCompletion,
                                    CHIInclusiveHNFPhase.SendCachedData))
      elsewhen after_snoops:
        victim_data_beats[index] <== bits(0, 2)
        when (completion_error =/= CHIRespErr.OK):
          remaining_response_data_ids[index] <== request_response_data_ids
          phases[index] <== mux(maintenance ||| request_write,
                                CHIInclusiveHNFPhase.SendRequesterCompletion,
                                CHIInclusiveHNFPhase.SendCachedData)
        elsewhen maintenance:
          phases[index] <== mux(maintenance_dirty[index] & !maintenance_discard,
                                CHIInclusiveHNFPhase.SendVictimWriteRequest,
                                CHIInclusiveHNFPhase.FinishMaintenance)
        elsewhen snoop_victim:
          phases[index] <== mux(selected_dirty,
                                CHIInclusiveHNFPhase.EnqueueVictimWriteback,
                                CHIInclusiveHNFPhase.SendFillRequest)
        otherwise:
          phases[index] <== mux(request_write,
                                CHIInclusiveHNFPhase.MergeRequesterData,
                                CHIInclusiveHNFPhase.SendCachedData)
          remaining_response_data_ids[index] <== request_response_data_ids
      elsewhen victim_writeback_enqueue_fire:
        victim_writebacks_pending[index] <== Bool(#true)
        phases[index] <== CHIInclusiveHNFPhase.SendFillRequest
      elsewhen subordinate_request_fire:
        when send_victim_write_request:
          phases[index] <== CHIInclusiveHNFPhase.AwaitVictimDBID
        otherwise:
          received_fill_data_ids[index] <== bits(0, 4)
          phases[index] <== CHIInclusiveHNFPhase.ReceiveFillData
      elsewhen (slot_subordinate_response_fire & await_victim_dbid):
        subordinate_dbids[index] <== subordinate_response.bits.dbid_or_group_id
        phases[index] <== CHIInclusiveHNFPhase.SendVictimData
      elsewhen subordinate_data_fire:
        victim_data_beats[index] <== mux(final_victim_data,
                                         victim_data_beat,
                                         victim_data_beat + bits(1, 2))
        phases[index] <== mux(final_victim_data,
                              CHIInclusiveHNFPhase.AwaitVictimCompletion,
                              CHIInclusiveHNFPhase.SendVictimData)
      elsewhen (slot_subordinate_response_fire & await_victim_completion):
        remaining_response_data_ids[index] <== request_response_data_ids
        phases[index] <== mux(
          maintenance,
          CHIInclusiveHNFPhase.FinishMaintenance,
          mux(victim_write_successful,
              CHIInclusiveHNFPhase.SendFillRequest,
              mux(request_write,
                  CHIInclusiveHNFPhase.SendRequesterCompletion,
                  CHIInclusiveHNFPhase.SendCachedData)))
      elsewhen finish_maintenance:
        phases[index] <== CHIInclusiveHNFPhase.SendRequesterCompletion
      elsewhen fill_data_fire:
        line_buffers[index] <== final_fill_line
        received_fill_data_ids[index] <== next_fill_data_ids
        when final_fill_data:
          remaining_response_data_ids[index] <== request_response_data_ids
          phases[index] <== mux(
            victim_writebacks_pending[index],
            CHIInclusiveHNFPhase.AwaitVictimWriteback,
            mux(fill_successful,
                mux(request_write,
                    CHIInclusiveHNFPhase.MergeRequesterData,
                    CHIInclusiveHNFPhase.SendCachedData),
                mux(request_write,
                    CHIInclusiveHNFPhase.SendRequesterCompletion,
                    CHIInclusiveHNFPhase.SendCachedData))
          )
      elsewhen install_buffered_fill:
        phases[index] <== mux(request_write,
                              CHIInclusiveHNFPhase.MergeRequesterData,
                              CHIInclusiveHNFPhase.SendCachedData)
      elsewhen merge_requester_data:
        line_buffers[index] <== merged_line
        phases[index] <== CHIInclusiveHNFPhase.SendRequesterCompletion
      elsewhen (requester_output_response_fire & send_requester_completion):
        occupied[index] <== Bool(#false)
        phases[index] <== CHIInclusiveHNFPhase.Idle
      elsewhen finish_copyback:
        occupied[index] <== Bool(#false)
        phases[index] <== CHIInclusiveHNFPhase.Idle

      when (fill_data_fire & (fill_response.bits.resp_err =/= CHIRespErr.OK)):
        completion_errors[index] <== fill_response.bits.resp_err
      elsewhen (slot_subordinate_response_fire & (subordinate_response.bits.resp_err =/= CHIRespErr.OK)):
        completion_errors[index] <== subordinate_response.bits.resp_err
      elsewhen (writeback_completion_fire & (writeback_completion_error =/= CHIRespErr.OK)):
        completion_errors[index] <== writeback_completion_error
      elsewhen (snoop_data_fire & (requester_data.bits.resp_err =/= CHIRespErr.OK)):
        completion_errors[index] <== requester_data.bits.resp_err
      elsewhen (requester_response_fire & (requester_response_flit.resp_err =/= CHIRespErr.OK)):
        completion_errors[index] <== requester_response_flit.resp_err

    elsewhen lookup_issue_index:
      phases[index] <== CHIInclusiveHNFPhase.AwaitLookup

  def retire_backed_victim = (fill_data_fire & final_fill_data & request_installs_miss & (
    snoop_victim & !victim_writebacks_pending[work_slot] & !fill_successful
  )) ||| (writeback_completion_fire & (writeback_completion_error === CHIRespErr.OK) & (
    phase === CHIInclusiveHNFPhase.AwaitVictimWriteback
  ) & (completion_error =/= CHIRespErr.OK))
  def invalidate_entry = (after_snoops & snoop_victim & !selected_dirty & (
    completion_error === CHIRespErr.OK
  )) ||| retire_backed_victim ||| (
    finish_maintenance & maintenance_hits[work_slot] & (completion_error === CHIRespErr.OK) & (
      request.opcode =/= CHIReqOpcode.CleanShared
    )
  )
  when zero_snoop_clean_victim:
    valid_lines <== valid_lines.updated(
      lookup_set,
      valid_lines[lookup_set].updated(lookup_way, Bool(#false))
    )
  elsewhen (after_snoops & snoop_victim & !selected_dirty & (completion_error === CHIRespErr.OK)):
    valid_lines <== valid_lines.updated(
      selected_set,
      valid_lines[selected_set].updated(selected_way, Bool(#false))
    )
  elsewhen retire_backed_victim:
    valid_lines <== valid_lines.updated(
      selected_set,
      valid_lines[selected_set].updated(selected_way, Bool(#false))
    )
  elsewhen finish_maintenance:
    when (maintenance_hits[work_slot] & (completion_error === CHIRespErr.OK) & (
      request.opcode =/= CHIReqOpcode.CleanShared
    )):
      valid_lines <== valid_lines.updated(
        selected_set,
        valid_lines[selected_set].updated(selected_way, Bool(#false))
      )
  elsewhen write_filled_line:
    valid_lines <== valid_lines.updated(
      selected_set,
      valid_lines[selected_set].updated(selected_way, Bool(#true))
    )

  when snoop_data_fire:
    when (!maintenance ||| maintenance_hits[work_slot]):
      dirty_lines <== dirty_lines.updated(
        selected_set,
        dirty_lines[selected_set].updated(selected_way, Bool(#true))
      )
  elsewhen retire_backed_victim:
    dirty_lines <== dirty_lines.updated(
      selected_set,
      dirty_lines[selected_set].updated(selected_way, Bool(#false))
    )
  elsewhen finish_maintenance:
    when (maintenance_hits[work_slot] & (completion_error === CHIRespErr.OK)):
      dirty_lines <== dirty_lines.updated(
        selected_set,
        dirty_lines[selected_set].updated(selected_way, Bool(#false))
      )
  elsewhen write_filled_line:
    dirty_lines <== dirty_lines.updated(
      selected_set,
      dirty_lines[selected_set].updated(selected_way, Bool(#false))
    )
  elsewhen merge_requester_data:
    dirty_lines <== dirty_lines.updated(
      selected_set,
      dirty_lines[selected_set].updated(selected_way, Bool(#true))
    )
  elsewhen (finish_copyback & copyback_dirty):
    dirty_lines <== dirty_lines.updated(
      selected_set,
      dirty_lines[selected_set].updated(selected_way, Bool(#true))
    )

  when (lookup_response_valid & lookup_selection.valid & !lookup_maintenance & !lookup_copyback):
    replacement_state <== replacement_state.updated(
      lookup_set,
      plru_touch(ways, replacement_state[lookup_set], lookup_selection.index)
    )
  elsewhen write_filled_line:
    replacement_state <== replacement_state.updated(
      selected_set,
      plru_touch(ways, replacement_state[selected_set], selected_way)
    )

  def responder_index = mux(requester_response_fire,
                            requester_response_target,
                            requester_data_snoop_target)
  def responder_mask = vec(
    for List (index in 0..resident_count): responder_index === bits(index, resident_width)
  ).as_bits()
  def work_requester_mask = vec(
    for List (endpoint in residents): request.src_id === bits(endpoint.node_id, p.node_id_width)
  ).as_bits()
  def response_requester_mask = vec(
    for List (endpoint in residents): response_request.src_id === bits(endpoint.node_id, p.node_id_width)
  ).as_bits()
  def absent_control = requester_response_fire & (
    requester_response_flit.resp_err === CHIRespErr.OK
  ) & (requester_response_flit.resp.into(CHICoherentResponse()).state === CHIResponseState.Invalid)
  def absent_data = snoop_data_fire & final_snoop_data & (
    !snoop_retains_copies[work_slot][requester_data_snoop_target]
  ) & (
    requester_data.bits.resp_err === CHIRespErr.OK
  ) & (requester_data.bits.resp.into(CHICoherentResponse()).state === CHIResponseState.Invalid)
  // A successful SharedClean response removes silent write permission, but
  // does not prove that the responder has evicted its copy.
  def shared_control = requester_response_fire & (requester_response_flit.resp_err === CHIRespErr.OK) & (
    requester_response_flit.resp.into(CHICoherentResponse()).state === CHIResponseState.SharedClean
  )
  def shared_data = snoop_data_fire & final_snoop_data & (completion_error === CHIRespErr.OK) & (
    requester_data.bits.resp_err === CHIRespErr.OK
  ) & (requester_data.bits.resp.into(CHICoherentResponse()).state === CHIResponseState.SharedClean)
  def directory_line_valid = valid_lines[selected_set][selected_way] & (
    !maintenance ||| maintenance_hits[work_slot]
  )
  def grant_copy = cached_data_fire & final_response_data & (
    response_completion_error === CHIRespErr.OK
  ) & response_request.opcode.is_one_of(CHIReqOpcode.ReadClean, CHIReqOpcode.ReadUnique)
  def grant_write_permission = grant_copy & (response_request.opcode === CHIReqOpcode.ReadUnique)
  // Final DAT transfers the transaction slot, but its new resident cannot be
  // probed or replaced until the requester has received the complete line.
  def pending_grant_publish = grant_copy & response_request.exp_comp_ack
  def pending_grants_after_ack = mux(
    comp_ack_fire,
    pending_grants.updated(completed_comp_ack_slot, Bool(#false)),
    pending_grants
  )
  when (pending_grant_publish ||| comp_ack_fire):
    pending_grants <== mux(
      pending_grant_publish,
      pending_grants_after_ack.updated(response_comp_ack_slot, Bool(#true)),
      pending_grants_after_ack
    )
  when pending_grant_publish:
    pending_grant_sets <== pending_grant_sets.updated(response_comp_ack_slot, response_selected_set)
  def clear_resident_entry = write_filled_line ||| invalidate_entry
  def remove_responder = directory_line_valid & (absent_control ||| absent_data)
  def release_copyback_resident = finish_copyback & maintenance_hits[work_slot]
  def resident_work_update = zero_snoop_clean_victim ||| clear_resident_entry ||| remove_responder ||| (
    release_copyback_resident
  )
  def writer_work_update = resident_work_update ||| (directory_line_valid & (shared_control ||| shared_data))
  def resident_work_set = mux(zero_snoop_clean_victim, lookup_set, selected_set)
  def resident_lines_after_work = mux(
    zero_snoop_clean_victim,
    resident_lines.updated(
      lookup_set,
      resident_lines[lookup_set].updated(lookup_way, bits(0, resident_count))
    ),
    mux(
      clear_resident_entry,
      resident_lines.updated(
        selected_set,
        resident_lines[selected_set].updated(selected_way, bits(0, resident_count))
      ),
      mux(
        remove_responder,
        resident_lines.updated(
          selected_set,
          resident_lines[selected_set].updated(
            selected_way,
            resident_lines[selected_set][selected_way] & !responder_mask
          )
        ),
        mux(
          release_copyback_resident,
          resident_lines.updated(
            selected_set,
            resident_lines[selected_set].updated(
              selected_way,
              resident_lines[selected_set][selected_way] & !work_requester_mask
            )
          ),
          resident_lines
        )
      )
    )
  )
  def resident_lines_after_grant = resident_lines_after_work.updated(
    response_selected_set,
    resident_lines_after_work[response_selected_set].updated(
      response_selected_way,
      resident_lines_after_work[response_selected_set][response_selected_way] ||| response_requester_mask
    )
  )
  def writer_work_way = mux(zero_snoop_clean_victim, lookup_way, selected_way)
  def writer_mask = may_write_lines[resident_work_set][writer_work_way]
  def writer_after_work = mux(
    zero_snoop_clean_victim ||| clear_resident_entry,
    bits(0, resident_count),
    mux(remove_responder ||| shared_control ||| shared_data,
        writer_mask & !responder_mask,
        writer_mask & !work_requester_mask)
  )
  def may_write_lines_after_work = may_write_lines.updated(
    resident_work_set,
    may_write_lines[resident_work_set].updated(writer_work_way, writer_after_work)
  )
  def may_write_lines_after_grant = may_write_lines_after_work.updated(
    response_selected_set,
    may_write_lines_after_work[response_selected_set].updated(
      response_selected_way,
      may_write_lines_after_work[response_selected_set][response_selected_way] ||| response_requester_mask
    )
  )
  when grant_copy:
    assert(valid_lines[response_selected_set][response_selected_way],
           "chi_inclusive_hnf_grant_has_directory_entry")
  when (grant_copy & writer_work_update):
    assert(response_selected_set =/= resident_work_set,
           "chi_inclusive_hnf_parallel_directory_sets_distinct")
  when writer_work_update:
    assert((writer_after_work & !resident_lines_after_work[resident_work_set][writer_work_way]) === bits(0, resident_count),
           "chi_inclusive_hnf_writer_is_resident")
  def granted_writer_without_residency = may_write_lines_after_grant[response_selected_set][response_selected_way] & !resident_lines_after_grant[response_selected_set][response_selected_way]
  when grant_write_permission:
    assert(granted_writer_without_residency === bits(0, resident_count),
           "chi_inclusive_hnf_granted_writer_is_resident")
  when (resident_work_update ||| grant_copy):
    resident_lines <== mux(grant_copy, resident_lines_after_grant, resident_lines_after_work)
  when (writer_work_update ||| grant_write_permission):
    may_write_lines <== mux(grant_write_permission, may_write_lines_after_grant, may_write_lines_after_work)

  def trace_contract:
    if slots == 1
    | block:
        def release_request = finish_copyback ||| (
          requester_output_response_fire & send_requester_completion
        ) ||| (cached_data_fire & final_response_data)
        describe_interface_retained_storage(request_fire,
                                            release_request,
                                            occupied[0],
                                            ~name: "request")
        describe_interface_contract(requester.requests,
                                    Array(requester.responses, requester.response_data),
                                    "request-outputs",
                                    ~trace_model: interface_trace_retained(~name: "request", ~outputs: 2))
        #void
    | #void
  trace_contract

export:
  CHIInclusiveHNFConfig
  // Compatibility-only implementation state, not CHI protocol vocabulary.
  CHIInclusiveHNFPhase
  CHIInclusiveHNF
