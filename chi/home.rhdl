#lang rhodium
// Implements the initial non-coherent CHI HN-I transaction engine.

import:
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open
  lib("rhodium/std/interconnect.rhdl").address_sets_match
  lib("rhodium/std/scoreboard.rhdl").Scoreboard
  lib("chi/params.rhdl").CHIFlitParams
  lib("chi/flits.rhdl") open
  lib("chi/protocol.rhdl") open
  lib("chi/transaction.rhdl") open
  lib("chi/link.rhdl") open
  lib("chi/channels.rhdl").CHIHNIChannels
  lib("chi/fabric.rhdl") open
  lib("chi/monitor.rhdl") open

// Describes the protocol and endpoint contract without requiring either side
// to be realized as a physical CHI link.
class CHIHNIParams(home :: CHIHomeParams,
                   requester_endpoints :: NonemptyList.of(CHIHomeRequesterParams),
                   subordinate_map :: CHISubordinateMap):
  implements StableCircuitParam

  property flit: subordinate_map.flit

fun checked_chi_hni_params(params :: CHIHNIParams):
  unless params.home.kind == CHINodeKind.HNI
  | error(~who: #'CHIHNI, "home kind must be HN-I")
  for (endpoint in params.requester_endpoints):
    unless [CHINodeKind.RNI, CHINodeKind.RNF].contains(endpoint.kind)
    | error(~who: #'CHIHNI,
            "requester endpoints must describe RN-I or RN-F Home traffic")
  unless bits.length(params.home.node_id) <= params.flit.node_id_width
  | error(~who: #'CHIHNI,
          "Home NodeID must fit the physical NodeID width")
  for (left_index in 0..params.requester_endpoints.length()):
    for (right_index in (left_index + 1)..params.requester_endpoints.length()):
      if params.requester_endpoints[left_index].node_id == params.requester_endpoints[right_index].node_id
      | error(~who: #'CHIHNI, "requester NodeIDs must be unique")
      | #void
  for (endpoint in params.requester_endpoints):
    unless bits.length(endpoint.node_id) <= params.flit.node_id_width
    | error(~who: #'CHIHNI,
            "requester NodeIDs must fit the physical NodeID width")
    if endpoint.node_id == params.home.node_id
    | error(~who: #'CHIHNI,
            "requester and Home NodeIDs must be distinct")
    | #void
    unless chi_initial_requester_capabilities(endpoint.supports, endpoint.emits)
    | error(~who: #'CHIHNI,
            "requester endpoints must use the initial non-coherent capabilities")
  for (service in params.subordinate_map.services):
    def subordinate_endpoint = service.endpoint
    unless subordinate_endpoint.kind == CHINodeKind.SNI
    | error(~who: #'CHIHNI,
            "subordinate endpoints must describe SN-Is")
    if subordinate_endpoint.node_id == params.home.node_id
    | error(~who: #'CHIHNI,
            "subordinate and Home NodeIDs must be distinct")
    | #void
    for (requester_endpoint in params.requester_endpoints):
      if subordinate_endpoint.node_id == requester_endpoint.node_id
      | error(~who: #'CHIHNI,
              "requester and subordinate NodeIDs must be distinct")
      | #void
    unless chi_initial_subordinate_capabilities(subordinate_endpoint.supports,
                                                subordinate_endpoint.emits)
    | error(~who: #'CHIHNI,
            "subordinate endpoints must use the initial non-coherent capabilities")
  // Individual services may implement different address-local capabilities,
  // but the service union must cover everything advertised to each requester.
  for (requester_endpoint in params.requester_endpoints):
    for (opcode in requester_endpoint.supports.req):
      unless for any (service in params.subordinate_map.services):
               for any (request in service.requests): request.opcode == opcode
      | error(~who: #'CHIHNI,
              "requester opcode must be supported by at least one subordinate service")
  params

fun chi_hni_subordinate_supported(p :: CHIFlitParams,
                                  request :: CHIReqFlit(p),
                                  services :: NonemptyList.of(CHISubordinateServiceParams)):
  def size = request.size_or_num_req[0..3]
  or_reduce(vec(
    for List (service in services):
      address_sets_match(request.address, service.address_sets) & or_reduce(vec(
        for List (support in service.requests):
          (request.opcode === support.opcode) & (
            size >= bits(alignment_bits(support.sizes.min_bytes), 3)
          ) & (size <= bits(alignment_bits(support.sizes.max_bytes), 3))
      ))
  ))

// Translates the initial HN-I transaction profile over ready-valid channels so
// the NoC can own transport independently of transaction semantics.
sync_circuit CHIHNI(params :: CHIHNIParams):
  def checked = checked_chi_hni_params(params)
  def p :: CHIFlitParams = checked.flit
  def home = checked.home
  def subordinate_map = checked.subordinate_map
  def limit = home.max_outstanding
  def slot_width = index_width(limit)

  interface port(CHIHNIChannels(p), ~role: home)
  def requester = port.requester
  def subordinate = port.subordinate

  inst occupancy(Scoreboard(limit))
  inst read_pending(Scoreboard(limit))
  inst write_await_dbid(Scoreboard(limit))
  inst write_await_data(Scoreboard(limit))
  inst write_await_comp(Scoreboard(limit))
  def occupied = occupancy.busy.into(Vec(limit, Bool))
  def reads = read_pending.busy.into(Vec(limit, Bool))
  def writes_waiting_dbid = write_await_dbid.busy.into(Vec(limit, Bool))
  def writes_waiting_data = write_await_data.busy.into(Vec(limit, Bool))
  def writes_waiting_comp = write_await_comp.busy.into(Vec(limit, Bool))
  reg received_write_data_ids(~init: vec(for List (_index in 0..limit): bits(0, 4)))
  reg received_read_data_ids(~init: vec(for List (_index in 0..limit): bits(0, 4)))
  mem requests(limit, CHIReqFlit(p))
  mem subordinate_ids(limit, Bits(p.node_id_width))
  mem subordinate_dbids(limit, Bits(12))

  def free_slots = vec(for List (index in 0..limit): !occupied[index])
  def allocation_available = free_slots.or_reduce()
  def allocation_slot = priority_encoder(free_slots)
  def upstream_request = requester.req.bits
  def upstream_request_opcode :: CHIReqOpcode = upstream_request.opcode
  def request_ordinary = upstream_request.opcode =/= CHIReqOpcode.ReqLCrdReturn
  def request_supported = upstream_request_opcode.supports_initial_transaction()
  def subordinate_lookup :: CHISubordinateLookup(p.node_id_width) = (
    subordinate_map.lookup(upstream_request.address)
  )
  def request_service_supported = chi_hni_subordinate_supported(
    p,
    upstream_request,
    subordinate_map.services
  )
  def request_routable = subordinate_lookup.valid & request_service_supported
  def request_accepted = request_ordinary & request_supported & request_routable
  (
    requester.req
      |> filter_flow(_request => request_accepted)
      |> gate_flow(allocation_available)
      |> map_flow(request => chi_hni_downstream_request(
          p,
          request,
          home.node_id,
          subordinate_lookup.node_id,
          allocation_slot
        ))
  ) |> subordinate.req
  def allocate = subordinate.req.fire()
  def allocate_write = allocate & upstream_request_opcode.is_initial_write()
  def allocate_read = allocate & !upstream_request_opcode.is_initial_write()

  when (requester.req.valid & request_ordinary):
    assert(request_supported, "chi_hni_request_opcode_supported")
    assert(upstream_request.tgt_id === bits(home.node_id, p.node_id_width),
           "chi_hni_request_targets_home")
    assert(subordinate_lookup.valid, "chi_hni_request_address_mapped")
    assert(request_service_supported,
           "chi_hni_request_service_supported")

  occupancy.set.valid <== allocate
  occupancy.set.bits <== allocation_slot
  read_pending.set.valid <== allocate_read
  read_pending.set.bits <== allocation_slot
  write_await_dbid.set.valid <== allocate_write
  write_await_dbid.set.bits <== allocation_slot
  requests.write(allocation_slot, upstream_request, ~enable: allocate)
  subordinate_ids.write(allocation_slot, subordinate_lookup.node_id, ~enable: allocate)

  def downstream_response = subordinate.rsp.bits
  def response_ordinary = downstream_response.opcode =/= CHIRspOpcode.RespLCrdReturn
  def response_dbid = downstream_response.opcode === CHIRspOpcode.DBIDResp
  def response_comp = downstream_response.opcode === CHIRspOpcode.Comp
  def response_slot = downstream_response.txn_id[0..slot_width]
  def response_slot_valid = downstream_response.txn_id < bits(limit, 12)
  def response_request = requests[response_slot]
  def response_subordinate_id = subordinate_ids[response_slot]
  def response_phase_match = (
    (response_dbid & writes_waiting_dbid[response_slot]) ||| (
      response_comp & writes_waiting_comp[response_slot]
    )
  )
  def response_identity_match = (
    downstream_response.src_id === response_subordinate_id
  ) & (downstream_response.tgt_id === bits(home.node_id, p.node_id_width))
  def response_match = response_slot_valid & response_phase_match & response_identity_match
  (
    subordinate.rsp
      |> filter_flow(_response => response_ordinary & response_match)
      |> map_flow(response => chi_hni_upstream_response(
          p,
          response,
          response_request.txn_id,
          response_request.src_id,
          response_request.qos,
          home.node_id,
          response_slot
        ))
  ) |> requester.rsp.response
  def response_transfer = requester.rsp.response.fire()
  def dbid_transfer = response_transfer & response_dbid
  def write_completion = response_transfer & response_comp

  when (subordinate.rsp.valid & response_ordinary):
    assert(response_slot_valid & response_phase_match,
           "chi_hni_response_has_transaction")
    when (response_slot_valid & response_phase_match):
      assert(downstream_response.src_id === response_subordinate_id,
             "chi_hni_response_source_subordinate")
      assert(downstream_response.tgt_id === bits(home.node_id, p.node_id_width),
             "chi_hni_response_targets_home")

  write_await_dbid.clear.valid <== dbid_transfer
  write_await_dbid.clear.bits <== response_slot
  write_await_data.set.valid <== dbid_transfer
  write_await_data.set.bits <== response_slot
  subordinate_dbids.write(response_slot,
                          downstream_response.dbid_or_group_id,
                          ~enable: dbid_transfer)

  def upstream_write_data = requester.dat.request.bits
  def write_data_ordinary = upstream_write_data.opcode =/= CHIDatOpcode.DataLCrdReturn
  def write_data_slot = upstream_write_data.txn_id[0..slot_width]
  def write_data_slot_valid = upstream_write_data.txn_id < bits(limit, 12)
  def write_data_request = requests[write_data_slot]
  def write_data_id = one_hot(upstream_write_data.data_id).as_bits()
  def write_data_expected_ids = chi_transfer_data_ids(write_data_request.address, chi_req_size(p, write_data_request), p)
  def write_data_received_ids = received_write_data_ids[write_data_slot]
  def next_write_data_ids = write_data_received_ids ||| write_data_id
  def final_write_data = next_write_data_ids === write_data_expected_ids
  def write_data_match = write_data_slot_valid & writes_waiting_data[write_data_slot] & (
    upstream_write_data.src_id === write_data_request.src_id
  ) & or_reduce(write_data_expected_ids & write_data_id) & (
    !or_reduce(write_data_received_ids & write_data_id)
  )
  (
    requester.dat.request
      |> filter_flow(_data => write_data_ordinary & write_data_match)
      |> map_flow(data => chi_hni_downstream_write_data(
          p,
          data,
          data.data_id,
          write_data_request.qos,
          bits(home.node_id, p.node_id_width),
          subordinate_ids[write_data_slot],
          subordinate_dbids[write_data_slot]
        ))
  ) |> subordinate.dat.request
  def write_data_transfer = subordinate.dat.request.fire()

  when (requester.dat.request.valid & write_data_ordinary):
    assert(write_data_match, "chi_hni_write_data_has_dbid")

  write_await_data.clear.valid <== write_data_transfer & final_write_data
  write_await_data.clear.bits <== write_data_slot
  write_await_comp.set.valid <== write_data_transfer & final_write_data
  write_await_comp.set.bits <== write_data_slot
  write_await_comp.clear.valid <== write_completion
  write_await_comp.clear.bits <== response_slot

  def downstream_read_data = subordinate.dat.response.bits
  def read_data_ordinary = downstream_read_data.opcode =/= CHIDatOpcode.DataLCrdReturn
  def read_data_slot = downstream_read_data.txn_id[0..slot_width]
  def read_data_slot_valid = downstream_read_data.txn_id < bits(limit, 12)
  def read_data_request = requests[read_data_slot]
  def read_data_id = one_hot(downstream_read_data.data_id).as_bits()
  def read_data_expected_ids = chi_transfer_data_ids(read_data_request.address, chi_req_size(p, read_data_request), p)
  def read_data_received_ids = received_read_data_ids[read_data_slot]
  def next_read_data_ids = read_data_received_ids ||| read_data_id
  def final_read_data = next_read_data_ids === read_data_expected_ids
  def read_data_subordinate_id = subordinate_ids[read_data_slot]
  def read_data_phase_match = reads[read_data_slot]
  def read_data_identity_match = (
    downstream_read_data.src_id === read_data_subordinate_id
  ) & (downstream_read_data.tgt_id === bits(home.node_id, p.node_id_width))
  def read_data_match = read_data_slot_valid & read_data_phase_match & read_data_identity_match & (
    or_reduce(read_data_expected_ids & read_data_id)
  ) & !or_reduce(read_data_received_ids & read_data_id)
  def write_completion_now = write_completion
  (
    subordinate.dat.response
      |> filter_flow(_data => read_data_ordinary & read_data_match)
      |> gate_flow(!write_completion_now)
      |> map_flow(data => chi_hni_upstream_read_data(
          p,
          data,
          read_data_request.return_txn_id_or_stash_lpid,
          read_data_request.return_nid_or_stash_nid_or_data_target,
          read_data_request.qos,
          home.node_id
        ))
  ) |> requester.dat.response
  def read_completion = requester.dat.response.fire()

  when (subordinate.dat.response.valid & read_data_ordinary):
    assert(read_data_slot_valid & read_data_phase_match,
           "chi_hni_read_data_has_transaction")
    when (read_data_slot_valid & read_data_phase_match):
      assert(downstream_read_data.src_id === read_data_subordinate_id,
             "chi_hni_read_data_source_subordinate")
      assert(downstream_read_data.tgt_id === bits(home.node_id, p.node_id_width),
             "chi_hni_read_data_targets_home")

  read_pending.clear.valid <== read_completion & final_read_data
  read_pending.clear.bits <== read_data_slot
  occupancy.clear.valid <== write_completion ||| (read_completion & final_read_data)
  occupancy.clear.bits <== mux(write_completion,
                               response_slot,
                               read_data_slot)

  def next_received_write_data_ids = vec(
    for List (index in 0..limit):
      block:
        def index_bits = bits(index, slot_width)
        def allocate_here = allocate_write & (allocation_slot === index_bits)
        def data_here = write_data_transfer & (write_data_slot === index_bits)
        mux(allocate_here,
            bits(0, 4),
            mux(data_here, next_write_data_ids, received_write_data_ids[index]))
  )
  when (allocate_write ||| write_data_transfer):
    received_write_data_ids <== next_received_write_data_ids

  def next_received_read_data_ids = vec(
    for List (index in 0..limit):
      block:
        def index_bits = bits(index, slot_width)
        def allocate_here = allocate_read & (allocation_slot === index_bits)
        def data_here = read_completion & (read_data_slot === index_bits)
        mux(allocate_here,
            bits(0, 4),
            mux(data_here, next_read_data_ids, received_read_data_ids[index]))
  )
  when (allocate_read ||| read_completion):
    received_read_data_ids <== next_received_read_data_ids

  requester.rsp.requester.ready <== Bool(#true)

  monitor_chi_hni(home,
                  p,
                  requester.req,
                  requester.dat.request,
                  requester.rsp.response,
                  requester.dat.response,
                  subordinate.req,
                  subordinate.dat.request,
                  subordinate.rsp,
                  subordinate.dat.response)

export:
  CHIHNIParams
  CHIHNI
