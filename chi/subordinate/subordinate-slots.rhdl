#lang rhodium
/* Tracks bounded subordinate transactions and associates write data with DBIDs. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open
  "trace.rhdl".ram_data_event
  lib("rhodium/std/scoreboard.rhdl").Scoreboard
  lib("chi/protocol/params.rhdl").CHIFlitParams
  lib("chi/protocol/flits.rhdl") open
  lib("chi/protocol/protocol.rhdl") open

/* Describe a request awaiting allocation of a read or write transaction slot. */
bundle CHISNTransactionAllocation(p :: CHIFlitParams):
  write: Bool
  request: CHIReqFlit(p)

/* Carry the retained request and direction with its allocated slot identity. */
bundle CHISNAllocatedTransaction(p :: CHIFlitParams, slot_width :: PosInt):
  slot: Bits(slot_width)
  write: Bool
  request: CHIReqFlit(p)

/* Associate an incoming write packet with its retained request, slot, and final-packet status. */
bundle CHISNMatchedWrite(p :: CHIFlitParams, slot_width :: PosInt):
  slot: Bits(slot_width)
  request: CHIReqFlit(p)
  data: CHIDatFlit(p)
  last: Bool

/*
 * Track outstanding requests, match write packets by DBID, and release read and write slots
 * independently.
 */
sync_circuit CHISNTransactionSlots(p :: CHIFlitParams, limit :: PosInt, ~trace: trace :: maybe(String) = #false):
  def slot_width = index_width(limit)

  // Allocation and matched DAT can wait for acceptance. The DBID and two
  // completion notifications report transfers that already occurred and cannot stall.
  interface allocation(Decoupled(CHISNTransactionAllocation(p)), ~role: consumer)
  interface allocated(Decoupled(CHISNAllocatedTransaction(p, slot_width)), ~role: producer)
  interface dbid_sent(Valid(Bits(slot_width)), ~role: consumer)
  interface write_data(Decoupled(CHIDatFlit(p)), ~role: consumer)
  interface matched_write(Decoupled(CHISNMatchedWrite(p, slot_width)), ~role: producer)
  interface read_completed(Valid(Bits(slot_width)), ~role: consumer)
  interface write_completed(Valid(Bits(slot_width)), ~role: consumer)

  inst awaiting_write_data(Scoreboard(limit))
  reg occupancy(~init: Mask(limit)(0))
  def occupied = occupancy.into(Vec(limit, Bool))
  def awaiting_write_data_slots = awaiting_write_data.busy.into(Vec(limit, Bool))
  reg received_write_data_ids(~init: vec(for List (_index in 0..limit): Mask(4)(0)))
  mem write_requests(limit, CHIReqFlit(p))

  def free_slots = vec(for List (index in 0..limit): !occupied[index])
  def allocation_available = free_slots.any()
  def selected_allocation_slot = priority_encoder(free_slots)
  (
    allocation
      |> gate_flow(allocation_available)
      |> map_flow(input => CHISNAllocatedTransaction(p, slot_width)):
          slot: selected_allocation_slot
          write: input.write
          request: input.request
  ) |> allocated

  def incoming_data = write_data.bits
  def ordinary_data = incoming_data.opcode =/= CHIDatOpcode.DataLCrdReturn
  def data_slot = incoming_data.txn_id[0..slot_width]
  def data_slot_valid = incoming_data.txn_id < Bits(12)(limit)
  def selected_request = write_requests[data_slot]
  def receipt = CHIDataReceipt():
    expected_ids: chi_transfer_data_ids(selected_request.address, selected_request.size(), p)
    received_ids: received_write_data_ids[data_slot]

  def next_receipt = receipt.record(incoming_data.data_id)
  def final_data = next_receipt.complete()
  def data_match = data_slot_valid & occupied[data_slot] & (
    awaiting_write_data_slots[data_slot]
  ) & (incoming_data.src_id === selected_request.src_id) & receipt.pending(incoming_data.data_id)

  // The lookup and the incoming flit form one offer. A DBID owns the saved
  // request from its RSP handshake until its last matched DAT transfers.
  wire lookup_ready: Bool
  def lookup = inject_interface(Decoupled(CHIReqFlit(p)), ~valid: Bool(#true), ~bits: selected_request, ~ready: lookup_ready)
  def slots = 0..limit
  def selected = for List (i in slots): data_slot === Bits(slot_width)(i)
  def owns_data = ordinary_data & data_match
  def Array(unowned, owned) = write_data |> demux_flow(2, _flit => owns_data)
  /* Carry the matched context through the checkpoint to backend admission. */
  fun packet(data :: CHIDatFlit(p), request :: CHIReqFlit(p)) :~ CHISNMatchedWrite(p, slot_width):
    CHISNMatchedWrite(p, slot_width):
      slot: data_slot
      request: request
      data: data
      last: final_data
  def matched = Array(owned, lookup) |> zip_flow(data, request): packet(data, request)
  def bypass = unowned |> map_flow(data => packet(data, selected_request))
  def grants = vec([!owns_data, owns_data]).into(MaybeOneHot(2))
  def associated = grant_merge(grants, Array(bypass, matched))
  def observed = if trace
  | associated |> ram_data_event(p, trace ++ ".rxdat", fun (beat :: CHISNMatchedWrite(p, slot_width)): beat.data)
  | associated
  def packets = observed |> filter_flow(_packet => owns_data)
  packets |> eject_interface(~valid: matched_write.valid, ~bits: matched_write.bits, ~ready: matched_write.ready)

  describe_interface_retained_bank(
    for List (i in slots): dbid_sent.valid & (dbid_sent.bits === Bits(slot_width)(i)),
    for List (i in slots): matched_write.fire() & matched_write.bits.last & selected[i],
    for List (i in slots): awaiting_write_data_slots[i],
    ~grants: [for List (i in slots): ordinary_data & data_match & selected[i]],
    ~name: "dbid"
  )
  describe_interface_contract(dbid_sent, lookup, "dbid-lookup", ~trace_model: interface_trace_retained_bank(~name: "dbid"))

  // Each receipt mask describes one independent window. Earlier DATs enter
  // on acceptance; only the final packet uses all saved receipts and itself.
  // These views describe the slot-indexed receipt lookup without a payload mux.
  def arrivals = observe_transfer(packets) |> fork_valid(limit)
  def histories = for Array (i in slots):
    def name = "write-receipts-" ++ to_string(i)
    def live = awaiting_write_data_slots[i]
    def count = mux(live, popcount(received_write_data_ids[i].as_bits()), Bits(3)(0))
    def fire = arrivals[i].valid & selected[i]
    def history = inject_interface(Valid(Bool), ~valid: fire, ~bits: final_data)
    describe_interface_window_storage(
      4, fire & !final_data, mux(fire & final_data, count, Bits(3)(0)), count, Bool(#false),
      for List (j in 0..4): final_data & (Bits(3)(j) < count),
      ~live: Bool(#true), ~name: name
    )
    describe_interface_contract(arrivals[i], history, name, ~trace_model: interface_trace_window(~name: name))
    history
  describe_interface_selection(selected, ~name: "write-slot")
  describe_interface_contract(histories, matched_write, "write-slot", ~trace_model: interface_trace_selection(~name: "write-slot"))

  when (write_data.valid & ordinary_data):
    assert(data_match,
           "chi_sn_transaction_slot_write_data_has_transaction")

  def allocate = allocated.fire()
  def accept_write_data = matched_write.fire()

  def allocation_mask = Mask(limit).from_index(allocated.bits.slot, ~valid: allocate)
  def read_completion_mask = Mask(limit).from_index(read_completed.bits, ~valid: read_completed.valid)
  def write_completion_mask = Mask(limit).from_index(write_completed.bits, ~valid: write_completed.valid)
  def completion_mask = read_completion_mask ||| write_completion_mask
  when (read_completed.valid):
    assert(any(occupancy & read_completion_mask),
           "chi_sn_read_completion_slot_occupied")

  when (write_completed.valid):
    assert(any(occupancy & write_completion_mask),
           "chi_sn_write_completion_slot_occupied")

  when (read_completed.valid & write_completed.valid):
    assert(read_completed.bits =/= write_completed.bits,
           "chi_sn_simultaneous_completions_distinct")

  when (allocate ||| read_completed.valid ||| write_completed.valid):
    occupancy <== (occupancy ||| allocation_mask) & !completion_mask

  awaiting_write_data.set <=> dbid_sent
  awaiting_write_data.clear.valid <== accept_write_data & matched_write.bits.last
  awaiting_write_data.clear.bits <== data_slot

  // Allocation selects a currently free slot; accepted DAT selects an occupied
  // slot. These independent writes cannot collide, even on simultaneous events.
  when (allocate & allocated.bits.write):
    received_write_data_ids[allocated.bits.slot] <== Mask(4)(0)

  when accept_write_data:
    received_write_data_ids[data_slot] <== next_receipt.received_ids

  write_requests.write(allocated.bits.slot,
                       allocated.bits.request,
                       ~enable: allocate & allocated.bits.write)

  for (index in 0..limit):
    when (awaiting_write_data_slots[index]):
      assert(occupied[index], "chi_sn_transaction_slot_write_is_occupied")

export:
  CHISNTransactionAllocation
  CHISNAllocatedTransaction
  CHISNMatchedWrite
  CHISNTransactionSlots
