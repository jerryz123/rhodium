#lang rhodium
// Projects one or more cache-line-striped CHI banks into dense local addresses.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("support/annotations.rhm") open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl").map_flow
  lib("rhodium/std/interconnect.rhdl") open
  lib("chi/protocol/params.rhdl").CHIFlitParams
  lib("chi/protocol/channels.rhdl").CHISNChannels
  lib("chi/protocol/fabric.rhdl") open

// Compatibility configuration: CHI width validation wraps protocol-neutral geometry.
class CHIAddressProjectorConfig(flit :: CHIFlitParams,
                                layout :: StripedAddressLayout):
  implements StableCircuitParam

  property local_bytes: layout.local_bytes
  property stripe_bytes: layout.stripe_bytes
  property bank_count: layout.bank_count
  property total_bytes: layout.total_bytes
  property bank_mask: layout.bank_mask
  property global_mask: layout.global_mask

  constructor (flit :: CHIFlitParams, local_bytes :: Pow2Int, stripe_bytes :: Pow2Int, bank_count :: Pow2Int):
    def layout = StripedAddressLayout(local_bytes, stripe_bytes, bank_count)
    unless layout.fits_unsigned_width(flit.request_address_width)
    | error(~who: #'CHIAddressProjectorConfig, "striped memory size must fit the request address width")
    super(flit, layout)

  method address_set(global_base :: Nat, bank_index :: Nat):
    layout.address_set(global_base, bank_index)

class CHIAddressProjectorParams(config :: CHIAddressProjectorConfig,
                                downstream_service :: CHISubordinateServiceParams,
                                global_base :: Nat,
                                bank_index :: Nat):

  property flit: config.flit
  property global_address_set: config.address_set(global_base, bank_index)
  property local_address_set: downstream_service.address_sets[0]
  property upstream_service:
    CHISubordinateServiceParams(
      downstream_service.endpoint,
      [global_address_set],
      downstream_service.requests
    )

  constructor (config :: CHIAddressProjectorConfig,
               downstream_service :: CHISubordinateServiceParams,
               global_base :: Nat,
               bank_index :: Nat):
    config.address_set(global_base, bank_index)
    unless downstream_service.address_sets.length() == 1 && (
      downstream_service.address_sets[0].mask == (config.local_bytes - 1)
    )
    | error(~who: #'CHIAddressProjectorParams,
            "downstream service must be one dense local memory region")
    for (request in downstream_service.requests):
      unless request.sizes.max_bytes <= config.stripe_bytes
      | error(~who: #'CHIAddressProjectorParams,
              "request size must not exceed the address stripe size")
    super(config, downstream_service, global_base, bank_index)

  method project(address :: Nat):
    config.layout.project(address, global_base, bank_index, ~local_base: local_address_set.base)

bundle CHIAddressProjectorIdentity(p :: CHIFlitParams):
  global_service_base: Bits(p.request_address_width)
  local_base: Bits(p.request_address_width)

fun chi_projected_address(config :: CHIAddressProjectorConfig,
                          identity :: CHIAddressProjectorIdentity(config.flit),
                          address :: Bits(config.flit.request_address_width))
  :~ Bits(config.flit.request_address_width):
  identity.local_base + config.layout.project_offset(address - identity.global_service_base)

circuit CHIAddressProjector(config :: CHIAddressProjectorConfig):
  def p = config.flit
  input identity: CHIAddressProjectorIdentity(p)
  interface upstream(CHISNChannels(p), ~role: node)
  interface downstream(CHISNChannels(p), ~role: icn)

  (
    upstream.req |> map_flow(request):
      request.updated(~address: chi_projected_address(config, identity, request.address))
  ) <=> downstream.req
  upstream.rsp <=> downstream.rsp
  upstream.dat <=> downstream.dat

export:
  CHIAddressProjectorConfig
  CHIAddressProjectorParams
  CHIAddressProjectorIdentity
  chi_projected_address
  CHIAddressProjector
