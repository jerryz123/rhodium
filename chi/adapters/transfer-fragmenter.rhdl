#lang rhodium
// Fragments large CHI reads and writes into serialized single-beat transactions.

import:
  lib("support/annotations.rhm") open
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/ready-valid.rhdl") open
  lib("flow/gate.rhdl").gate_flow
  lib("chi/protocol/params.rhdl").CHIFlitParams
  lib("chi/protocol/flits.rhdl") open
  lib("chi/protocol/protocol.rhdl") open
  lib("chi/protocol/channels.rhdl").CHISNChannels
  lib("chi/protocol/fabric.rhdl") open

class CHITransferFragmenterConfig(flit :: CHIFlitParams,
                                  max_transfer_bytes :: Pow2Int):
  implements StableCircuitParam

  method upstream_requests(downstream_requests :: NonemptyList.of(CHIRequestSupport)):
    downstream_requests.map(
      fun (support):
        CHIRequestSupport(
          support.opcode,
          if [CHIReqOpcode.ReadNoSnp,
              CHIReqOpcode.WriteNoSnpFull,
              CHIReqOpcode.WriteNoSnpPtl].contains(support.opcode)
          | TransferSizes(support.sizes.min_bytes, max_transfer_bytes)
          | support.sizes
        )
    )

  constructor (flit :: CHIFlitParams,
               ~max_transfer_bytes: max_transfer_bytes :: Pow2Int):
    unless max_transfer_bytes >= flit.data_bytes && max_transfer_bytes <= 64
    | error(~who: #'CHITransferFragmenterConfig,
            "maximum transfer size must be from one DAT beat through 64 bytes")
    super(flit, max_transfer_bytes)

class CHITransferFragmenterParams(config :: CHITransferFragmenterConfig,
                                  downstream_service :: CHISubordinateServiceParams):

  property flit: config.flit
  property max_transfer_bytes: config.max_transfer_bytes

  property upstream_service:
    CHISubordinateServiceParams(
      downstream_service.endpoint,
      downstream_service.address_sets,
      config.upstream_requests(downstream_service.requests)
    )

  constructor (config :: CHITransferFragmenterConfig,
               downstream_service :: CHISubordinateServiceParams):
    for (opcode in [CHIReqOpcode.ReadNoSnp,
                    CHIReqOpcode.WriteNoSnpFull,
                    CHIReqOpcode.WriteNoSnpPtl]):
      def advertised = downstream_service.requests.filter(
        ~keep: fun (support): support.opcode == opcode
      ).length() > 0
      if advertised && !downstream_service.supports(opcode, config.flit.data_bytes)
      | error(~who: #'CHITransferFragmenterParams,
              "fragmented operations must support one physical DAT beat")
      | #void
    super(config, downstream_service)

hardware_enum CHITransferFragmenterPhase(~width: 4):
  Idle = 0
  SendRequest = 1
  AwaitReadData = 2
  AwaitWriteDBID = 3
  ReceiveWriteData = 4
  SendWriteData = 5
  AwaitWriteCompletion = 6

fun chi_fragmented_request(p :: CHIFlitParams,
                           request :: CHIReqFlit(p),
                           child_index :: Bits(2),
                           last_child :: Bits(2)) :~ CHIReqFlit(p):
  def child_offset = (child_index ++ bits(0, alignment_bits(p.data_bytes))).zext(p.request_address_width)
  request.updated(
    ~address: request.address + child_offset,
    ~size_or_num_req: mux(last_child =/= bits(0, 2), bits(alignment_bits(p.data_bytes), 6), request.size_or_num_req)
  )

fun chi_fragmented_write_data(p :: CHIFlitParams,
                              data :: CHIDatFlit(p),
                              dbid :: Bits(12)) :~ CHIDatFlit(p):
  data.updated(~replicate: Bool(#false), ~num_dat: bits(0, 2), ~txn_id: dbid)

fun chi_fragmented_write_completion(p :: CHIFlitParams,
                                    response :: CHIRspFlit(p),
                                    parent_dbid :: Bits(12)) :~ CHIRspFlit(p):
  response.updated(~dbid_or_group_id: parent_dbid)

sync_circuit CHITransferFragmenter(config :: CHITransferFragmenterConfig):
  def p = config.flit
  interface upstream(CHISNChannels(p), ~role: node)
  interface downstream(CHISNChannels(p), ~role: icn)

  reg phase(~init: CHITransferFragmenterPhase.Idle)
  reg request(CHIReqFlit(p))
  reg child_index(~init: bits(0, 2))
  reg last_child(~init: bits(0, 2))
  reg parent_dbid(~init: bits(0, 12))
  reg child_dbid(~init: bits(0, 12))
  reg write_data(Vec(4, CHIDatFlit(p)))
  reg received_write_data_ids(~init: bits(0, 4))

  def idle = phase === CHITransferFragmenterPhase.Idle
  def incoming_request = upstream.req.bits
  def incoming_opcode :: CHIReqOpcode = incoming_request.opcode
  def incoming_size = chi_req_size(p, incoming_request)
  def incoming_last_child = chi_data_beats_minus_one(incoming_size, p)
  def incoming_write = incoming_opcode.is_initial_write()
  def incoming_address_aligned = is_aligned_log2(incoming_request.address, incoming_size.as_bits(), ~max_log2: 6)
  upstream.req.ready <== idle
  def upstream_request_fire = upstream.req.fire()
  when (upstream.req.valid & idle):
    assert(incoming_opcode.is_one_of(CHIReqOpcode.ReadNoSnp,
                                     CHIReqOpcode.WriteNoSnpFull,
                                     CHIReqOpcode.WriteNoSnpPtl),
           "chi_transfer_fragmenter_request_opcode_supported")
    assert(chi_size_valid(incoming_size) & (
             incoming_size.as_bits() <= bits(alignment_bits(config.max_transfer_bytes), 3)
           ),
           "chi_transfer_fragmenter_request_size_supported")
    assert(incoming_address_aligned,
           "chi_transfer_fragmenter_request_address_aligned")

  def send_request = phase === CHITransferFragmenterPhase.SendRequest
  downstream.req.valid <== send_request
  downstream.req.bits <== chi_fragmented_request(p, request, child_index, last_child)
  def downstream_request_fire = downstream.req.fire()

  def await_write_dbid = phase === CHITransferFragmenterPhase.AwaitWriteDBID
  def await_write_completion = phase === CHITransferFragmenterPhase.AwaitWriteCompletion
  def final_child = child_index === last_child
  def relay_write_dbid = await_write_dbid & (child_index === bits(0, 2))
  def relay_write_completion = await_write_completion & final_child
  def relay_write_response = relay_write_dbid ||| relay_write_completion
  upstream.rsp.valid <== relay_write_response & downstream.rsp.valid
  upstream.rsp.bits <== mux(
    relay_write_completion,
    chi_fragmented_write_completion(p, downstream.rsp.bits, parent_dbid),
    downstream.rsp.bits
  )
  downstream.rsp.ready <== mux(relay_write_response,
                               upstream.rsp.ready,
                               await_write_dbid ||| await_write_completion)
  def downstream_response_fire = downstream.rsp.fire()

  def receive_write_data = phase === CHITransferFragmenterPhase.ReceiveWriteData
  def incoming_write_data_id = one_hot(upstream.dat.request.bits.data_id).as_bits()
  def expected_write_data_ids = chi_transfer_data_ids(request.address, chi_req_size(p, request), p)
  def next_received_write_data_ids = received_write_data_ids ||| incoming_write_data_id
  def final_parent_write_data = next_received_write_data_ids === expected_write_data_ids
  upstream.dat.request.ready <== receive_write_data
  def parent_write_data_fire = upstream.dat.request.fire()
  when (upstream.dat.request.valid & receive_write_data):
    assert(upstream.dat.request.bits.txn_id === parent_dbid,
           "chi_transfer_fragmenter_write_data_dbid")
    assert(or_reduce(expected_write_data_ids & incoming_write_data_id),
           "chi_transfer_fragmenter_write_data_id_expected")
    assert(!or_reduce(received_write_data_ids & incoming_write_data_id),
           "chi_transfer_fragmenter_write_data_id_unique")

  def send_write_data = phase === CHITransferFragmenterPhase.SendWriteData
  def child_write_data_id = chi_line_data_id(request.address, p) + chi_transfer_data_id(child_index, p)
  downstream.dat.request.valid <== send_write_data
  downstream.dat.request.bits <== chi_fragmented_write_data(
    p,
    write_data[child_write_data_id],
    child_dbid
  )
  def child_write_data_fire = downstream.dat.request.fire()

  def await_read_data = phase === CHITransferFragmenterPhase.AwaitReadData
  downstream.dat.response |> gate_flow(await_read_data) |> upstream.dat.response
  def read_data_fire = downstream.dat.response.fire()

  when upstream_request_fire:
    request <== incoming_request
    child_index <== bits(0, 2)
    last_child <== incoming_last_child
    received_write_data_ids <== bits(0, 4)
    phase <== CHITransferFragmenterPhase.SendRequest
  elsewhen downstream_request_fire:
    phase <== mux(request.opcode === CHIReqOpcode.ReadNoSnp, CHITransferFragmenterPhase.AwaitReadData, CHITransferFragmenterPhase.AwaitWriteDBID)
  elsewhen (downstream_response_fire & await_write_dbid):
    child_dbid <== downstream.rsp.bits.dbid_or_group_id
    parent_dbid <== mux(child_index === bits(0, 2), downstream.rsp.bits.dbid_or_group_id, parent_dbid)
    when (child_index === bits(0, 2)):
      phase <== CHITransferFragmenterPhase.ReceiveWriteData
    otherwise:
      phase <== CHITransferFragmenterPhase.SendWriteData
  elsewhen parent_write_data_fire:
    write_data <== write_data.updated(upstream.dat.request.bits.data_id, upstream.dat.request.bits)
    received_write_data_ids <== next_received_write_data_ids
    when final_parent_write_data:
      phase <== CHITransferFragmenterPhase.SendWriteData
  elsewhen child_write_data_fire:
    phase <== CHITransferFragmenterPhase.AwaitWriteCompletion
  elsewhen (downstream_response_fire & await_write_completion):
    when final_child:
      phase <== CHITransferFragmenterPhase.Idle
    otherwise:
      child_index <== child_index + bits(1, 2)
      phase <== CHITransferFragmenterPhase.SendRequest
  elsewhen read_data_fire:
    when final_child:
      phase <== CHITransferFragmenterPhase.Idle
    otherwise:
      child_index <== child_index + bits(1, 2)
      phase <== CHITransferFragmenterPhase.SendRequest

export:
  CHITransferFragmenterConfig
  CHITransferFragmenterParams
  CHITransferFragmenter
