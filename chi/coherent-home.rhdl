#lang rhodium
// Implements a serialized HN-F manager with dirty RN-F intervention support.

import:
  lib("rhodium/std/bits.rhdl") open
  lib("flow/main.rhdl") open
  lib("chi/params.rhdl") open
  lib("chi/flits.rhdl") open
  lib("chi/protocol.rhdl") open
  lib("chi/messages.rhdl") open
  lib("chi/coherence.rhdl") open
  lib("chi/transaction.rhdl").chi_hni_downstream_write_data
  lib("chi/channels.rhdl") open
  lib("chi/home-common.rhdl") open

hardware_enum CHIHNFPhase(~width: 4):
  Idle = 0
  SendRequesterDBID = 1
  ReceiveWriteData = 2
  SendSnoop = 3
  AwaitSnoop = 4
  SendSubordinateRequest = 5
  AwaitSubordinateDBID = 6
  SendSubordinateData = 7
  AwaitSubordinateCompletion = 8
  SendRequesterCompletion = 9
  ForwardReadData = 10
  AwaitCompAck = 11
  SendSnoopWriteRequest = 12
  AwaitSnoopWriteDBID = 13
  SendSnoopWriteData = 14
  AwaitSnoopWriteCompletion = 15

sync_circuit CHIHNF(config :: CHIHNFConfig):
  def checked = config
  def p = checked.flit
  def snoop_count :: PosInt = checked.snoop_endpoints.length()
  def snoop_node_ids = vec(
    for List (endpoint in checked.snoop_endpoints):
      bits(endpoint.node_id, p.node_id_width)
  )
  def empty_snoops = vec(
    for List (_index in 0..snoop_count): Bool(#false)
  )

  input identity: CHIHNFIdentity(p)
  interface port(CHIHNChannels(p), ~role: home)
  def requester = port.requester
  def subordinate = port.subordinate
  def home_id = identity.home_node_id
  def subordinate_id = identity.subordinate_node_id

  reg phase(~init: CHIHNFPhase.Idle)
  reg request(CHIReqFlit(p))
  reg requester_is_rnf(~init: Bool(#false))
  reg write_data(Vec(4, CHIDatFlit(p)))
  reg snoop_data(CHIDatFlit(p))
  reg subordinate_dbid(~init: bits(0, 12))
  reg pending_snoops(~init: empty_snoops)
  reg expected_snoop_node(~init: bits(0, p.node_id_width))
  reg received_data_ids(~init: bits(0, 4))
  reg received_snoop_data_ids(~init: bits(0, 4))
  reg completion_error(~init: CHIRespErr.OK)
  def maintenance = chi_cache_maintenance(request.opcode)

  def idle = phase === CHIHNFPhase.Idle
  def incoming_request = requester.requests.bits
  def incoming_subordinate_opcode = chi_hnf_subordinate_opcode(incoming_request.opcode)
  def incoming_write = incoming_subordinate_opcode.is_initial_write()
  def incoming_coherent = chi_hnf_source_is_rnf(p, checked, incoming_request)
  requester.requests.ready <== idle
  def request_fire = requester.requests.fire()
  when (requester.requests.valid & idle):
    assert(chi_hnf_source_known(p, checked, incoming_request),
           "chi_hnf_request_source_known")
    assert(incoming_request.tgt_id === home_id,
           "chi_hnf_request_targets_home")
    assert(chi_hnf_request_supported(p, checked, incoming_request),
           "chi_hnf_request_opcode_supported")
    assert(chi_hnf_service_supported(p,
                                     incoming_request,
                                     checked,
                                     identity.service_base),
           "chi_hnf_request_service_supported")

  def send_requester_dbid = phase === CHIHNFPhase.SendRequesterDBID
  def send_requester_completion = phase === CHIHNFPhase.SendRequesterCompletion
  requester.responses.valid <== send_requester_dbid ||| send_requester_completion
  requester.responses.bits <== chi_hnf_response(
    p,
    home_id,
    request,
    mux(send_requester_dbid, CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp),
    ~error: completion_error
  )
  def requester_response_fire = requester.responses.fire()

  def receiving_write_data = phase === CHIHNFPhase.ReceiveWriteData
  def receiving_snoop_data = phase === CHIHNFPhase.AwaitSnoop
  requester.request_data.ready <== receiving_write_data ||| receiving_snoop_data
  def requester_data_fire = requester.request_data.fire()
  def write_data_fire = requester_data_fire & receiving_write_data
  def snoop_data_fire = requester_data_fire & receiving_snoop_data
  def incoming_write_data_id = one_hot(requester.request_data.bits.data_id).as_bits()
  def expected_write_data_ids = chi_transfer_data_ids(request.address, chi_req_size(p, request), p)
  def next_write_data_ids = received_data_ids ||| incoming_write_data_id
  def final_write_data = next_write_data_ids === expected_write_data_ids
  // A multi-packet snoop response keeps valid asserted while the Home writes
  // each accepted packet downstream. Validate a packet when this phase accepts
  // it; valid is allowed to remain asserted while ready is low between packets.
  when requester_data_fire:
    assert(receiving_write_data ||| receiving_snoop_data,
           "chi_hnf_requester_data_expected")
    assert(requester.request_data.bits.opcode === mux(
             receiving_write_data,
             CHIDatOpcode.NonCopyBackWriteData,
             CHIDatOpcode.SnpRespData
           ),
           "chi_hnf_requester_data_opcode")
    assert(requester.request_data.bits.src_id === mux(
             receiving_write_data,
             request.src_id,
             expected_snoop_node
           ),
           "chi_hnf_requester_data_source")
    assert(requester.request_data.bits.tgt_id === home_id,
           "chi_hnf_requester_data_targets_home")
    assert(requester.request_data.bits.txn_id === bits(0, 12),
           "chi_hnf_requester_data_txn")
  when write_data_fire:
    assert(or_reduce(expected_write_data_ids & incoming_write_data_id),
           "chi_hnf_write_data_id_expected")
    assert(!or_reduce(received_data_ids & incoming_write_data_id),
           "chi_hnf_write_data_id_unique")
  def snoop_data_id = one_hot(requester.request_data.bits.data_id).as_bits()
  def next_snoop_data_ids = received_snoop_data_ids ||| snoop_data_id
  def expected_snoop_data_ids = chi_transfer_data_ids(
    request.address,
    CHITransferSize.Bytes64,
    p
  )
  when snoop_data_fire:
    when maintenance:
      assert(requester.request_data.bits.byte_enable === !bits(0, p.data_bytes), "chi_hnf_maintenance_full_dirty_packet")
    assert(request.opcode =/= CHIReqOpcode.MakeInvalid, "chi_hnf_discard_has_no_data")
    assert(or_reduce(expected_snoop_data_ids & snoop_data_id), "chi_hnf_snoop_data_id_expected")
    assert(chi_snoop_response_state_valid(chi_home_snoop_opcode(request.opcode), requester.request_data.bits.resp.into(CHICoherentResponse())), "chi_hnf_snoop_data_state")
    assert(!or_reduce(received_snoop_data_ids & snoop_data_id),
           "chi_hnf_snoop_data_id_unique")
    assert(requester.request_data.bits.resp.into(CHICoherentResponse()).pass_dirty,
           "chi_hnf_snoop_data_passes_dirty")

  def snoops_remaining = pending_snoops.or_reduce()
  def next_snoop_index = priority_encoder(pending_snoops)
  def next_snoop_node = snoop_node_ids[next_snoop_index]
  requester.snoops.valid <== (phase === CHIHNFPhase.SendSnoop) & snoops_remaining
  requester.snoops.bits <== CHISnoopDispatch(p):
    target_id: next_snoop_node
    flit: chi_hnf_snoop(p, home_id, request)
  def snoop_fire = requester.snoops.fire()

  def awaiting_snoop = phase === CHIHNFPhase.AwaitSnoop
  def awaiting_comp_ack = phase === CHIHNFPhase.AwaitCompAck
  requester.requester_responses.ready <== awaiting_snoop ||| awaiting_comp_ack
  def incoming_requester_response = requester.requester_responses.bits
  def requester_control_fire = requester.requester_responses.fire()
  when (requester.requester_responses.valid):
    assert(awaiting_snoop ||| awaiting_comp_ack,
           "chi_hnf_requester_response_expected")
    assert(incoming_requester_response.tgt_id === home_id,
           "chi_hnf_requester_response_targets_home")
    when awaiting_snoop:
      assert(incoming_requester_response.opcode === CHIRspOpcode.SnpResp,
             "chi_hnf_snoop_response_opcode")
      assert(incoming_requester_response.src_id === expected_snoop_node,
             "chi_hnf_snoop_response_source")
      assert(incoming_requester_response.txn_id === bits(0, 12),
             "chi_hnf_snoop_response_txn")
      def snoop_response = incoming_requester_response.resp.into(CHICoherentResponse())
      assert(chi_snoop_response_state_valid(chi_home_snoop_opcode(request.opcode), snoop_response), "chi_hnf_snoop_response_state")
      assert(!snoop_response.pass_dirty,
             "chi_hnf_snoop_response_clean")
    when awaiting_comp_ack:
      assert(incoming_requester_response.opcode === CHIRspOpcode.CompAck,
             "chi_hnf_comp_ack_opcode")
      assert(incoming_requester_response.src_id === request.src_id,
             "chi_hnf_comp_ack_source")
      assert(incoming_requester_response.txn_id === bits(0, 12),
             "chi_hnf_comp_ack_txn")

  def send_subordinate_request = phase === CHIHNFPhase.SendSubordinateRequest
  def send_snoop_write_request = phase === CHIHNFPhase.SendSnoopWriteRequest
  subordinate.req.valid <== send_subordinate_request ||| send_snoop_write_request
  subordinate.req.bits <== mux(
    send_snoop_write_request,
    chi_hnf_snoop_write_request(p, home_id, subordinate_id, request, snoop_data),
    chi_hnf_downstream_request(p, home_id, subordinate_id, request)
  )
  def subordinate_request_fire = subordinate.req.fire()

  def awaiting_subordinate_dbid = phase === CHIHNFPhase.AwaitSubordinateDBID
  def awaiting_subordinate_completion = phase === CHIHNFPhase.AwaitSubordinateCompletion
  def awaiting_snoop_write_dbid = phase === CHIHNFPhase.AwaitSnoopWriteDBID
  def awaiting_snoop_write_completion = phase === CHIHNFPhase.AwaitSnoopWriteCompletion
  def awaiting_any_subordinate_dbid = awaiting_subordinate_dbid ||| awaiting_snoop_write_dbid
  def awaiting_any_subordinate_completion = awaiting_subordinate_completion ||| awaiting_snoop_write_completion
  subordinate.rsp.ready <== awaiting_any_subordinate_dbid ||| awaiting_any_subordinate_completion
  def incoming_subordinate_response = subordinate.rsp.bits
  def subordinate_response_fire = subordinate.rsp.fire()
  when (subordinate.rsp.valid):
    assert(awaiting_any_subordinate_dbid ||| awaiting_any_subordinate_completion,
           "chi_hnf_subordinate_response_expected")
    assert(incoming_subordinate_response.src_id === subordinate_id,
           "chi_hnf_subordinate_response_source")
    assert(incoming_subordinate_response.tgt_id === home_id,
           "chi_hnf_subordinate_response_targets_home")
    assert(incoming_subordinate_response.txn_id === bits(0, 12),
           "chi_hnf_subordinate_response_txn")
    assert(incoming_subordinate_response.opcode === mux(
             awaiting_any_subordinate_dbid,
             CHIRspOpcode.DBIDResp,
             CHIRspOpcode.Comp
           ),
           "chi_hnf_subordinate_response_opcode")

  def send_subordinate_data = phase === CHIHNFPhase.SendSubordinateData
  def send_snoop_write_data = phase === CHIHNFPhase.SendSnoopWriteData
  def selected_write_data_id = priority_encoder(received_data_ids.as_vec(Bool))
  def sent_write_data_id = one_hot(selected_write_data_id).as_bits()
  def remaining_write_data_ids = received_data_ids & !sent_write_data_id
  subordinate.dat.request.valid <== send_subordinate_data ||| send_snoop_write_data
  subordinate.dat.request.bits <== mux(
    send_snoop_write_data,
    chi_hnf_snoop_write_data(p, home_id, subordinate_id, subordinate_dbid, snoop_data),
    chi_hni_downstream_write_data(
      p,
      write_data[selected_write_data_id],
      selected_write_data_id,
      request.qos,
      home_id,
      subordinate_id,
      subordinate_dbid
    )
  )
  def subordinate_data_fire = subordinate.dat.request.fire()

  def forwarding_read = phase === CHIHNFPhase.ForwardReadData
  (
    subordinate.dat.response
      |> gate_flow(forwarding_read)
      |> map_flow(data => chi_hnf_upstream_read_data(
          p,
          home_id,
          request,
          requester_is_rnf,
          data
        ))
  ) |> requester.response_data
  def read_data_fire = subordinate.dat.response.fire()
  def read_data_id = one_hot(subordinate.dat.response.bits.data_id).as_bits()
  def next_received_data_ids = received_data_ids ||| read_data_id
  def expected_data_ids = chi_transfer_data_ids(request.address, chi_req_size(p, request), p)
  def final_read_data = next_received_data_ids === expected_data_ids
  when (subordinate.dat.response.valid & forwarding_read):
    assert(subordinate.dat.response.bits.opcode === CHIDatOpcode.CompData,
           "chi_hnf_read_data_opcode")
    assert(subordinate.dat.response.bits.src_id === subordinate_id,
           "chi_hnf_read_data_source")
    assert(subordinate.dat.response.bits.tgt_id === home_id,
           "chi_hnf_read_data_targets_home")
    assert(subordinate.dat.response.bits.txn_id === bits(0, 12),
           "chi_hnf_read_data_txn")
    assert(!or_reduce(received_data_ids & read_data_id),
           "chi_hnf_read_data_id_unique")

  when request_fire:
    request <== incoming_request
    requester_is_rnf <== chi_hnf_source_is_rnf(p, checked, incoming_request)
    pending_snoops <== vec(
      for List (endpoint in checked.snoop_endpoints):
        (incoming_coherent ||| chi_cache_maintenance(incoming_request.opcode)) & (
          (incoming_request.src_id =/= bits(endpoint.node_id, p.node_id_width)) ||| (
            chi_cache_maintenance(incoming_request.opcode) & incoming_request.excl_snoop_me_cah
          )
        )
    )
    received_data_ids <== bits(0, 4)
    received_snoop_data_ids <== bits(0, 4)
    phase <== mux(incoming_write,
                  CHIHNFPhase.SendRequesterDBID,
                  mux(incoming_coherent ||| chi_cache_maintenance(incoming_request.opcode),
                      CHIHNFPhase.SendSnoop,
                      CHIHNFPhase.SendSubordinateRequest))
  elsewhen (requester_response_fire & send_requester_dbid):
    phase <== CHIHNFPhase.ReceiveWriteData
  elsewhen write_data_fire:
    write_data <== write_data.updated(requester.request_data.bits.data_id,
                                      requester.request_data.bits)
    received_data_ids <== next_write_data_ids
    when final_write_data:
      phase <== CHIHNFPhase.SendSnoop
  elsewhen ((phase === CHIHNFPhase.SendSnoop) & !snoops_remaining):
    phase <== mux(maintenance, CHIHNFPhase.SendRequesterCompletion, CHIHNFPhase.SendSubordinateRequest)
  elsewhen snoop_fire:
    pending_snoops <== pending_snoops.updated(next_snoop_index, Bool(#false))
    expected_snoop_node <== next_snoop_node
    received_snoop_data_ids <== bits(0, 4)
    phase <== CHIHNFPhase.AwaitSnoop
  elsewhen (requester_control_fire & awaiting_snoop):
    phase <== CHIHNFPhase.SendSnoop
  elsewhen snoop_data_fire:
    snoop_data <== requester.request_data.bits
    received_snoop_data_ids <== next_snoop_data_ids
    phase <== CHIHNFPhase.SendSnoopWriteRequest
  elsewhen subordinate_request_fire:
    phase <== mux(send_snoop_write_request,
                  CHIHNFPhase.AwaitSnoopWriteDBID,
                  mux(chi_hnf_subordinate_opcode(request.opcode).is_initial_write(),
                      CHIHNFPhase.AwaitSubordinateDBID,
                      CHIHNFPhase.ForwardReadData))
  elsewhen (subordinate_response_fire & awaiting_any_subordinate_dbid):
    subordinate_dbid <== incoming_subordinate_response.dbid_or_group_id
    phase <== mux(awaiting_snoop_write_dbid,
                  CHIHNFPhase.SendSnoopWriteData,
                  CHIHNFPhase.SendSubordinateData)
  elsewhen subordinate_data_fire:
    when send_snoop_write_data:
      phase <== CHIHNFPhase.AwaitSnoopWriteCompletion
    otherwise:
      received_data_ids <== remaining_write_data_ids
      when (!remaining_write_data_ids.or_reduce()):
        phase <== CHIHNFPhase.AwaitSubordinateCompletion
  elsewhen (subordinate_response_fire & awaiting_any_subordinate_completion):
    phase <== mux(awaiting_snoop_write_completion,
                  mux(received_snoop_data_ids === expected_snoop_data_ids,
                      CHIHNFPhase.SendSnoop,
                      CHIHNFPhase.AwaitSnoop),
                  CHIHNFPhase.SendRequesterCompletion)
  elsewhen (requester_response_fire & send_requester_completion):
    phase <== CHIHNFPhase.Idle
  elsewhen read_data_fire:
    received_data_ids <== next_received_data_ids
    when final_read_data:
      phase <== mux(request.exp_comp_ack,
                    CHIHNFPhase.AwaitCompAck,
                    CHIHNFPhase.Idle)
  elsewhen (requester_control_fire & awaiting_comp_ack):
    phase <== CHIHNFPhase.Idle

  when request_fire:
    completion_error <== CHIRespErr.OK
  elsewhen maintenance:
    when (subordinate_response_fire & (incoming_subordinate_response.resp_err =/= CHIRespErr.OK)):
      completion_error <== incoming_subordinate_response.resp_err
    elsewhen (snoop_data_fire & (requester.request_data.bits.resp_err =/= CHIRespErr.OK)):
      completion_error <== requester.request_data.bits.resp_err
    elsewhen (requester_control_fire & awaiting_snoop & (incoming_requester_response.resp_err =/= CHIRespErr.OK)):
      completion_error <== incoming_requester_response.resp_err

export:
  CHIHNFConfig
  CHIHNFParams
  CHIHNFIdentity
  chi_hnf_subordinate_opcode
  chi_hnf_source_known
  chi_hnf_source_is_rnf
  chi_hnf_request_supported
  chi_hnf_service_supported
  chi_hnf_response
  chi_hnf_snoop
  chi_hnf_downstream_request
  CHIHNF
