#lang rhodium
// Defines reusable ready-valid CHI Request, Home, and Subordinate Node contracts.

import:
  lib("rhodium/std/ready-valid.rhdl").Decoupled
  lib("chi/protocol/params.rhdl").CHIFlitParams
  lib("chi/protocol/flits.rhdl") open

interface CHIRNRspChannels(p :: CHIFlitParams):
  role node
  role icn
  provider node

  node -> icn:
    requester: Decoupled(CHIRspFlit(p))

  icn -> node:
    response: Decoupled(CHIRspFlit(p))

interface CHIDatChannels(p :: CHIFlitParams):
  role requester
  role responder
  provider requester

  requester -> responder:
    request: Decoupled(CHIDatFlit(p))

  responder -> requester:
    response: Decoupled(CHIDatFlit(p))

// RN-I recursively groups its independent REQ, RSP, and DAT flows without
// forcing the coherent RN SNP channel onto a non-snooping requester.
interface CHIRNIChannels(p :: CHIFlitParams):
  role icn
  role node
  provider node

  node -> icn:
    req: Decoupled(CHIReqFlit(p))
    rsp: CHIRNRspChannels(p)
    dat: CHIDatChannels(p)

// RN-F and RN-D share the full requester shape. These physical RSP and DAT
// flows may carry both ordinary requester traffic and snoop responses, so they
// remain explicit alongside the ICN-to-node SNP flow.
interface CHIRNChannels(p :: CHIFlitParams):
  role icn
  role node
  provider node

  node -> icn:
    requests: Decoupled(CHIReqFlit(p))
    requester_responses: Decoupled(CHIRspFlit(p))
    request_data: Decoupled(CHIDatFlit(p))

  icn -> node:
    responses: Decoupled(CHIRspFlit(p))
    response_data: Decoupled(CHIDatFlit(p))
    snoops: Decoupled(CHISnpFlit(p))

// SN-F and SN-I share this channel shape; their kind and capabilities remain
// static endpoint metadata rather than changing the ready-valid wires.
interface CHISNChannels(p :: CHIFlitParams):
  role icn
  role node
  provider node

  node -> icn:
    rsp: Decoupled(CHIRspFlit(p))

  icn -> node:
    req: Decoupled(CHIReqFlit(p))
    dat: CHIDatChannels(p)

// SNP has no physical TgtID field because a CHI link identifies its receiver.
// An HN connected to an internal multi-node fabric therefore carries the
// selected requester beside the exact SNP flit until endpoint ejection.
bundle CHISnoopDispatch(p :: CHIFlitParams):
  target_id: Bits(p.node_id_width)
  flit: CHISnpFlit(p)

interface CHIHNRequesterChannels(p :: CHIFlitParams):
  role home
  role fabric
  provider home

  fabric -> home:
    requests: Decoupled(CHIReqFlit(p))
    requester_responses: Decoupled(CHIRspFlit(p))
    request_data: Decoupled(CHIDatFlit(p))

  home -> fabric:
    responses: Decoupled(CHIRspFlit(p))
    response_data: Decoupled(CHIDatFlit(p))
    snoops: Decoupled(CHISnoopDispatch(p))

// HN-I connects one recursively grouped non-snooping requester side to one
// subordinate side.
interface CHIHNIChannels(p :: CHIFlitParams):
  role home
  role fabric
  provider home

  home -> fabric:
    requester: CHIRNIChannels(p)
    subordinate: CHISNChannels(p)

// A snoop-capable Home aggregates requester traffic by NodeID and dispatches
// SNP to a selected RN-F while retaining the common subordinate shape.
interface CHIHNChannels(p :: CHIFlitParams):
  role home
  role fabric
  provider home

  home -> fabric:
    requester: CHIHNRequesterChannels(p)
    subordinate: CHISNChannels(p)

export:
  CHIRNRspChannels
  CHIDatChannels
  CHIRNIChannels
  CHIRNChannels
  CHISNChannels
  CHISnoopDispatch
  CHIHNRequesterChannels
  CHIHNIChannels
  CHIHNChannels
