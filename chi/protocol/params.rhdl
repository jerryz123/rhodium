#lang rhodium
// Defines the validated AMBA CHI physical flit parameterization.

import:
  rhombus/meta open

annot.macro 'CHINodeIDWidth':
  'Int.in(7 ..= 16)'

annot.macro 'CHIRequestAddressWidth':
  'Int.in(44 ..= 52)'

fun chi_data_width(value :: Nat): [128, 256, 512].contains(value)
annot.macro 'CHIDataWidth':
  'Nat && satisfying(chi_data_width)'

fun chi_mpam_width(value :: Nat): [0, 12, 15].contains(value)
annot.macro 'CHIMPAMWidth':
  'Nat && satisfying(chi_mpam_width)'

fun chi_reserved_width(value :: Nat): [0, 4, 8, 12, 16, 24, 32].contains(value)
annot.macro 'CHIReservedWidth':
  'Nat && satisfying(chi_reserved_width)'

fun chi_pbha_width(value :: Nat): [0, 4].contains(value)
annot.macro 'CHIPBHAWidth':
  'Nat && satisfying(chi_pbha_width)'

fun chi_mecid_width(value :: Nat): [0, 16].contains(value)
annot.macro 'CHIMECIDWidth':
  'Nat && satisfying(chi_mecid_width)'

fun chi_stream_id_width(value :: Nat): [0, 16].contains(value)
annot.macro 'CHIStreamIDWidth':
  'Nat && satisfying(chi_stream_id_width)'

fun chi_sec_sid_width(value :: Nat, stream_id_width :: CHIStreamIDWidth):
  (stream_id_width == 0 && value == 0) || (stream_id_width == 16 && value == 1)

annot.macro 'CHISecSIDWidth($stream_id_width)':
  'Nat && satisfying(fun (value): chi_sec_sid_width(value, $stream_id_width))'

class CHIFlitParams(~node_id_width: node_id_width :: CHINodeIDWidth = 7,
                    ~request_address_width: request_address_width :: CHIRequestAddressWidth = 44,
                    ~data_width: data_width :: CHIDataWidth = 128,
                    ~mpam_width: mpam_width :: CHIMPAMWidth = 0,
                    ~req_rsvdc_width: req_rsvdc_width :: CHIReservedWidth = 0,
                    ~dat_rsvdc_width: dat_rsvdc_width :: CHIReservedWidth = 0,
                    ~data_check: data_check :: Boolean = #false,
                    ~poison: poison :: Boolean = #false,
                    ~pbha_width: pbha_width :: CHIPBHAWidth = 0,
                    ~mecid_width: mecid_width :: CHIMECIDWidth = 0,
                    ~stream_id_width: stream_id_width :: CHIStreamIDWidth = 0,
                    ~sec_sid_width: sec_sid_width :: CHISecSIDWidth(stream_id_width) = 0):
  implements StableCircuitParam

  property data_bytes: data_width / 8
  property byte_enable_width: data_width / 8
  property tag_width: data_width / 32
  property tag_update_width: data_width / 128
  property data_check_width: if data_check | data_width / 8 | 0
  property poison_width: if poison | data_width / 64 | 0
  property snoop_address_width: request_address_width - 3
  property request_security_width:
    if mecid_width > stream_id_width | mecid_width | stream_id_width

export:
  CHIFlitParams
