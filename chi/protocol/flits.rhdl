#lang rhodium
// Defines the exact AMBA CHI opcodes and parameterized protocol flit layouts.

import:
  lib("chi/protocol/params.rhdl") open

// Closed non-opcode fields use nominal types so authoring mistakes are caught
// without changing their specified packed encodings.
hardware_enum CHITagOp(~width: 2):
  Invalid = 0
  Transfer = 1
  Update = 2
  MatchOrFetch = 3

hardware_enum CHIOrder(~width: 2):
  NoOrder = 0
  RequestAccepted = 1
  RequestOrder = 2
  EndpointOrder = 3

hardware_enum CHIPAS(~width: 3):
  Secure = 0
  NonSecure = 1
  Root = 2
  Realm = 3
  SystemAgent = 4
  NonSecureProtected = 5

hardware_enum CHIRespErr(~width: 2):
  OK = 0
  EXOK = 1
  DERR = 2
  NDERR = 3

hardware_enum CHITransferSize(~width: 3):
  Bytes1 = 0
  Bytes2 = 1
  Bytes4 = 2
  Bytes8 = 3
  Bytes16 = 4
  Bytes32 = 5
  Bytes64 = 6

// MemAttr[3:0] is Allocate, Cacheable, Device, Early Write Acknowledge.
bundle CHIMemAttr():
  allocate: Bool
  cacheable: Bool
  device: Bool
  early_write_acknowledge: Bool

// Opcode encodings are from Issue H Tables B13.12 through B13.16.
hardware_enum CHIReqOpcode(~width: 7):
  ReqLCrdReturn = 0x00
  ReadShared = 0x01
  ReadClean = 0x02
  ReadOnce = 0x03
  ReadNoSnp = 0x04
  PCrdReturn = 0x05
  ReadUnique = 0x07
  CleanShared = 0x08
  CleanInvalid = 0x09
  MakeInvalid = 0x0a
  CleanUnique = 0x0b
  MakeUnique = 0x0c
  Evict = 0x0d
  CleanInvalidStorage = 0x0e
  ReadNoSnpSep = 0x11
  CleanSharedPersistSep = 0x13
  DVMOp = 0x14
  WriteEvictFull = 0x15
  WriteCleanFull = 0x17
  WriteUniquePtl = 0x18
  WriteUniqueFull = 0x19
  WriteBackPtl = 0x1a
  WriteBackFull = 0x1b
  WriteNoSnpPtl = 0x1c
  WriteNoSnpFull = 0x1d
  WriteUniqueFullStash = 0x20
  WriteUniquePtlStash = 0x21
  StashOnceShared = 0x22
  StashOnceUnique = 0x23
  ReadOnceCleanInvalid = 0x24
  ReadOnceMakeInvalid = 0x25
  ReadNotSharedDirty = 0x26
  CleanSharedPersist = 0x27
  AtomicStoreAdd = 0x28
  AtomicStoreClr = 0x29
  AtomicStoreEor = 0x2a
  AtomicStoreSet = 0x2b
  AtomicStoreSMax = 0x2c
  AtomicStoreSMin = 0x2d
  AtomicStoreUMax = 0x2e
  AtomicStoreUMin = 0x2f
  AtomicLoadAdd = 0x30
  AtomicLoadClr = 0x31
  AtomicLoadEor = 0x32
  AtomicLoadSet = 0x33
  AtomicLoadSMax = 0x34
  AtomicLoadSMin = 0x35
  AtomicLoadUMax = 0x36
  AtomicLoadUMin = 0x37
  AtomicSwap = 0x38
  AtomicCompare = 0x39
  PrefetchTgt = 0x3a
  MakeReadUnique = 0x41
  WriteEvictOrEvict = 0x42
  WriteUniqueZero = 0x43
  WriteNoSnpZero = 0x44
  StashOnceSepShared = 0x47
  StashOnceSepUnique = 0x48
  ReadPreferUnique = 0x4c
  CleanInvalidPoPA = 0x4d
  WriteNoSnpDef = 0x4e
  WriteNoSnpFullCleanSh = 0x50
  WriteNoSnpFullCleanInv = 0x51
  WriteNoSnpFullCleanShPerSep = 0x52
  WriteUniqueFullCleanSh = 0x54
  WriteUniqueFullCleanShPerSep = 0x56
  WriteUniqueFullCleanInvStrg = 0x57
  WriteBackFullCleanSh = 0x58
  WriteBackFullCleanInv = 0x59
  WriteBackFullCleanShPerSep = 0x5a
  WriteBackFullCleanInvStrg = 0x5b
  WriteCleanFullCleanSh = 0x5c
  WriteCleanFullCleanShPerSep = 0x5e
  WriteNoSnpPtlCleanSh = 0x60
  WriteNoSnpPtlCleanInv = 0x61
  WriteNoSnpPtlCleanShPerSep = 0x62
  WriteUniquePtlCleanSh = 0x64
  WriteUniquePtlCleanShPerSep = 0x66
  WriteNoSnpPtlCleanInvPoPA = 0x70
  WriteNoSnpFullCleanInvPoPA = 0x71
  WriteNoSnpFullCleanInvStrg = 0x72
  WriteBackFullCleanInvPoPA = 0x79

  method is_atomic_store(opcode) :: Bool:
    opcode.is_one_of(CHIReqOpcode.AtomicStoreAdd,
                     CHIReqOpcode.AtomicStoreClr,
                     CHIReqOpcode.AtomicStoreEor,
                     CHIReqOpcode.AtomicStoreSet,
                     CHIReqOpcode.AtomicStoreSMax,
                     CHIReqOpcode.AtomicStoreSMin,
                     CHIReqOpcode.AtomicStoreUMax,
                     CHIReqOpcode.AtomicStoreUMin)

  method is_atomic_load(opcode) :: Bool:
    opcode.is_one_of(CHIReqOpcode.AtomicLoadAdd,
                     CHIReqOpcode.AtomicLoadClr,
                     CHIReqOpcode.AtomicLoadEor,
                     CHIReqOpcode.AtomicLoadSet,
                     CHIReqOpcode.AtomicLoadSMax,
                     CHIReqOpcode.AtomicLoadSMin,
                     CHIReqOpcode.AtomicLoadUMax,
                     CHIReqOpcode.AtomicLoadUMin)

  method is_atomic(opcode) :: Bool:
    opcode.is_atomic_store() ||| opcode.is_atomic_load() ||| opcode.is_one_of(
      CHIReqOpcode.AtomicSwap,
      CHIReqOpcode.AtomicCompare
    )

  method is_read_no_snp(opcode) :: Bool:
    opcode.is_one_of(CHIReqOpcode.ReadNoSnp, CHIReqOpcode.ReadNoSnpSep)

  method is_write_no_snp(opcode) :: Bool:
    opcode.is_one_of(CHIReqOpcode.WriteNoSnpPtl,
                     CHIReqOpcode.WriteNoSnpFull,
                     CHIReqOpcode.WriteNoSnpZero,
                     CHIReqOpcode.WriteNoSnpDef,
                     CHIReqOpcode.WriteNoSnpFullCleanSh,
                     CHIReqOpcode.WriteNoSnpFullCleanInv,
                     CHIReqOpcode.WriteNoSnpFullCleanShPerSep,
                     CHIReqOpcode.WriteNoSnpPtlCleanSh,
                     CHIReqOpcode.WriteNoSnpPtlCleanInv,
                     CHIReqOpcode.WriteNoSnpPtlCleanShPerSep,
                     CHIReqOpcode.WriteNoSnpPtlCleanInvPoPA,
                     CHIReqOpcode.WriteNoSnpFullCleanInvPoPA,
                     CHIReqOpcode.WriteNoSnpFullCleanInvStrg)

  method supports_initial_transaction(opcode) :: Bool:
    opcode.is_one_of(CHIReqOpcode.ReadNoSnp,
                     CHIReqOpcode.WriteNoSnpFull,
                     CHIReqOpcode.WriteNoSnpPtl)

  method is_initial_write(opcode) :: Bool:
    opcode.is_one_of(CHIReqOpcode.WriteNoSnpFull,
                     CHIReqOpcode.WriteNoSnpPtl)

hardware_enum CHIRspOpcode(~width: 5):
  RespLCrdReturn = 0x00
  SnpResp = 0x01
  CompAck = 0x02
  RetryAck = 0x03
  Comp = 0x04
  CompDBIDResp = 0x05
  DBIDResp = 0x06
  PCrdGrant = 0x07
  ReadReceipt = 0x08
  SnpRespFwded = 0x09
  TagMatch = 0x0a
  RespSepData = 0x0b
  Persist = 0x0c
  CompPersist = 0x0d
  DBIDRespOrd = 0x0e
  StashDone = 0x10
  CompStashDone = 0x11
  CompCMO = 0x14

  method allocates_dbid(opcode) :: Bool:
    opcode.is_one_of(CHIRspOpcode.CompDBIDResp,
                     CHIRspOpcode.DBIDResp,
                     CHIRspOpcode.DBIDRespOrd)

  method is_snoop_response(opcode) :: Bool:
    opcode.is_one_of(CHIRspOpcode.SnpResp, CHIRspOpcode.SnpRespFwded)

hardware_enum CHISnpOpcode(~width: 5):
  SnpLCrdReturn = 0x00
  SnpShared = 0x01
  SnpClean = 0x02
  SnpOnce = 0x03
  SnpNotSharedDirty = 0x04
  SnpUniqueStash = 0x05
  SnpMakeInvalidStash = 0x06
  SnpUnique = 0x07
  SnpCleanShared = 0x08
  SnpCleanInvalid = 0x09
  SnpMakeInvalid = 0x0a
  SnpStashUnique = 0x0b
  SnpStashShared = 0x0c
  SnpDVMOp = 0x0d
  SnpQuery = 0x10
  SnpSharedFwd = 0x11
  SnpCleanFwd = 0x12
  SnpOnceFwd = 0x13
  SnpNotSharedDirtyFwd = 0x14
  SnpPreferUnique = 0x15
  SnpPreferUniqueFwd = 0x16
  SnpUniqueFwd = 0x17

  method is_forward(opcode) :: Bool:
    opcode.is_one_of(CHISnpOpcode.SnpSharedFwd,
                     CHISnpOpcode.SnpCleanFwd,
                     CHISnpOpcode.SnpOnceFwd,
                     CHISnpOpcode.SnpNotSharedDirtyFwd,
                     CHISnpOpcode.SnpPreferUniqueFwd,
                     CHISnpOpcode.SnpUniqueFwd)

  method is_stash(opcode) :: Bool:
    opcode.is_one_of(CHISnpOpcode.SnpUniqueStash,
                     CHISnpOpcode.SnpMakeInvalidStash,
                     CHISnpOpcode.SnpStashUnique,
                     CHISnpOpcode.SnpStashShared)

  method is_dvm(opcode) :: Bool:
    opcode === CHISnpOpcode.SnpDVMOp

hardware_enum CHIDatOpcode(~width: 4):
  DataLCrdReturn = 0x0
  SnpRespData = 0x1
  CopyBackWriteData = 0x2
  NonCopyBackWriteData = 0x3
  CompData = 0x4
  SnpRespDataPtl = 0x5
  SnpRespDataFwded = 0x6
  WriteDataCancel = 0x7
  DataSepResp = 0xb
  NonCopyBackWriteDataCompAck = 0xc

  method is_write_data(opcode) :: Bool:
    opcode.is_one_of(CHIDatOpcode.CopyBackWriteData,
                     CHIDatOpcode.NonCopyBackWriteData,
                     CHIDatOpcode.WriteDataCancel,
                     CHIDatOpcode.NonCopyBackWriteDataCompAck)

  method is_response_data(opcode) :: Bool:
    opcode.is_one_of(CHIDatOpcode.SnpRespData,
                     CHIDatOpcode.CompData,
                     CHIDatOpcode.SnpRespDataPtl,
                     CHIDatOpcode.SnpRespDataFwded,
                     CHIDatOpcode.DataSepResp)

  method is_snoop_response(opcode) :: Bool:
    opcode.is_one_of(CHIDatOpcode.SnpRespData,
                     CHIDatOpcode.SnpRespDataPtl,
                     CHIDatOpcode.SnpRespDataFwded)

// Record fields are listed from the most-significant field to the
// least-significant field so QoS occupies bits [3:0], as required by B13.9.
bundle CHIReqFlit(p :: CHIFlitParams):
  if p.req_rsvdc_width > 0:
    rsvdc: Bits(p.req_rsvdc_width)
  if p.sec_sid_width > 0:
    sec_sid1: Bits(p.sec_sid_width)
  if p.request_security_width > 0:
    mecid_or_stream_id: Bits(p.request_security_width)
  if p.pbha_width > 0:
    pbha: Bits(p.pbha_width)
  if p.mpam_width > 0:
    mpam: Bits(p.mpam_width)
  trace_tag: Bool
  tag_op: CHITagOp
  exp_comp_ack: Bool
  excl_snoop_me_cah: Bool
  group_id_or_lpid: Bits(8)
  snp_attr_or_do_dwt: Bool
  mem_attr: CHIMemAttr()
  pcrd_type: Bits(4)
  order: CHIOrder
  allow_retry: Bool
  likely_shared: Bool
  pas: CHIPAS
  address: Bits(p.request_address_width)
  size_or_num_req: Bits(6)
  multi_req: Bool
  opcode: CHIReqOpcode
  return_txn_id_or_stash_lpid: Bits(12)
  stash_nid_valid_endian_deep_prefetch_tgt_hint: Bool
  return_nid_or_stash_nid_or_data_target: Bits(p.node_id_width)
  txn_id: Bits(12)
  src_id: Bits(p.node_id_width)
  tgt_id: Bits(p.node_id_width)
  qos: Bits(4)

bundle CHIRspFlit(p :: CHIFlitParams):
  cache_line_id: Bits(6)
  trace_tag: Bool
  tag_op: CHITagOp
  pcrd_type: Bits(4)
  dbid_or_group_id: Bits(12)
  c_busy: Bits(3)
  fwd_state_or_data_pull: Bits(3)
  resp: Bits(3)
  resp_err: CHIRespErr
  opcode: CHIRspOpcode
  txn_id: Bits(12)
  src_id: Bits(p.node_id_width)
  tgt_id: Bits(p.node_id_width)
  qos: Bits(4)

bundle CHISnpFlit(p :: CHIFlitParams):
  if p.mecid_width > 0:
    mecid: Bits(p.mecid_width)
  if p.mpam_width > 0:
    mpam: Bits(p.mpam_width)
  trace_tag: Bool
  ret_to_src: Bool
  do_not_go_to_sd: Bool
  pas: CHIPAS
  address: Bits(p.snoop_address_width)
  opcode: CHISnpOpcode
  fwd_txn_id_or_stash_lpid_or_vmid_ext: Bits(12)
  fwd_nid_or_pbha: Bits(p.node_id_width)
  txn_id: Bits(12)
  src_id: Bits(p.node_id_width)
  qos: Bits(4)

bundle CHIDatFlit(p :: CHIFlitParams):
  if p.poison_width > 0:
    poison: Bits(p.poison_width)
  if p.data_check_width > 0:
    data_check: Bits(p.data_check_width)
  data: Bits(p.data_width)
  byte_enable: Bits(p.byte_enable_width)
  if p.dat_rsvdc_width > 0:
    rsvdc: Bits(p.dat_rsvdc_width)
  replicate: Bool
  num_dat: Bits(2)
  cah: Bool
  trace_tag: Bool
  tag_update: Bits(p.tag_update_width)
  tag: Bits(p.tag_width)
  tag_op: CHITagOp
  cache_line_id: Bits(6)
  data_id: Bits(2)
  ccid: Bits(2)
  dbid_or_mecid: Bits(16)
  c_busy: Bits(3)
  data_pull: Bool
  data_source_or_fwd_state: Bits(8)
  resp: Bits(3)
  resp_err: CHIRespErr
  opcode: CHIDatOpcode
  home_nid_or_pbha_or_mismatched_mecid: Bits(p.node_id_width)
  txn_id: Bits(12)
  src_id: Bits(p.node_id_width)
  tgt_id: Bits(p.node_id_width)
  qos: Bits(4)

export:
  CHITagOp
  CHIOrder
  CHIPAS
  CHIRespErr
  CHITransferSize
  CHIMemAttr
  CHIReqOpcode
  CHIRspOpcode
  CHISnpOpcode
  CHIDatOpcode
  CHIReqFlit
  CHIRspFlit
  CHISnpFlit
  CHIDatFlit
