#lang rhodium
// Defines CHI fabric ports, services, and executable Home and subordinate address selection.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/meta open
  lib("support/annotations.rhm").NonemptyString
  lib("rhodium/std/bits.rhdl").alignment_bits
  lib("rhodium/std/interconnect.rhdl") open
  lib("chi/protocol/params.rhdl") open
  lib("chi/protocol/flits.rhdl") open
  lib("chi/protocol/link.rhdl") open

// Transfer sizes are service metadata, not a property of the physical link.
class CHIRequestSupport(opcode :: CHIReqOpcode, sizes :: TransferSizes):
  // Hardware matching uses the encoded Size, unlike host service supports(bytes).
  method matches(request_opcode :: CHIReqOpcode, size :: CHITransferSize) :~ Bool:
    (request_opcode === opcode) & (
      size.as_bits() >= bits(alignment_bits(sizes.min_bytes), 3)
    ) & (size.as_bits() <= bits(alignment_bits(sizes.max_bytes), 3))

fun require_unique_request_support(requests :: List.of(CHIRequestSupport),
                                   who :: Symbol):
  for (left_index in 0..requests.length()):
    for (right_index in (left_index + 1)..requests.length()):
      if requests[left_index].opcode == requests[right_index].opcode
      | error(~who: who, "request support must not contain duplicate opcodes")
      | #void

fun require_request_support(requests :: List.of(CHIRequestSupport),
                            who :: Symbol):
  require_unique_request_support(requests, who)
  for (request in requests):
    unless request.sizes.max_bytes <= 64
    | error(~who: who,
            "request support size must fit the CHI Size field")

class CHISubordinateServiceParams(endpoint :: CHIICNPortParams,
                                  address_sets :: NonemptyList.of(AddressSet),
                                  requests :: NonemptyList.of(CHIRequestSupport)):
  constructor (endpoint :: CHIICNPortParams,
               address_sets :: NonemptyList.of(AddressSet),
               requests :: NonemptyList.of(CHIRequestSupport)):
    unless CHINodeKind.is_subordinate(endpoint.kind)
    | error(~who: #'CHISubordinateServiceParams,
            "service endpoint must have an SN-F or SN-I node kind")
    require_request_support(requests, #'CHISubordinateServiceParams)
    for (request in requests):
      unless endpoint.emits.req.contains(request.opcode)
      | error(~who: #'CHISubordinateServiceParams,
              "service request opcode must be emitted by its ICN port")
    super(endpoint, address_sets, requests)

  method supports(opcode :: CHIReqOpcode, bytes :: PosInt):
    for any (request in requests):
      request.opcode == opcode && request.sizes.contains(bytes)

annot.macro 'CHILinkParams':
  'CHIRNLinkParams || CHIRNILinkParams || CHISNLinkParams'

fun chi_link_matches_node_kind(link :: CHILinkParams, kind :: CHINodeKind):
  cond
  | [CHINodeKind.RNF, CHINodeKind.RND].contains(kind): link is_a CHIRNLinkParams
  | kind == CHINodeKind.RNI: link is_a CHIRNILinkParams
  | CHINodeKind.is_subordinate(kind): link is_a CHISNLinkParams
  | ~else: #false

class CHIFabricPortParams(endpoint :: CHIICNPortParams,
                          link :: CHILinkParams):
  constructor (endpoint :: CHIICNPortParams, link :: CHILinkParams):
    unless chi_link_matches_node_kind(link, endpoint.kind)
    | error(~who: #'CHIFabricPortParams,
            "link parameter type must match the ICN port node kind")
    super(endpoint, link)

class CHIHomeParams(name :: NonemptyString,
                    node_id :: Nat,
                    kind :: CHINodeKind,
                    max_outstanding :: Int.in(1 ..= 1024)):
  implements StableCircuitParam

  constructor (name :: NonemptyString,
               node_id :: Nat,
               kind :: CHINodeKind,
               ~max_outstanding: max_outstanding :: Int.in(1 ..= 1024)):
    unless CHINodeKind.is_home(kind)
    | error(~who: #'CHIHomeParams,
            "home kind must be HN-F or HN-I")
    super(name, node_id, kind, max_outstanding)

class CHIHomeServiceParams(home :: CHIHomeParams,
                           address_sets :: NonemptyList.of(AddressSet),
                           requests :: NonemptyList.of(CHIRequestSupport)):
  constructor (home :: CHIHomeParams,
               address_sets :: NonemptyList.of(AddressSet),
               requests :: NonemptyList.of(CHIRequestSupport)):
    require_request_support(requests, #'CHIHomeServiceParams)
    super(home, address_sets, requests)

  method supports(opcode :: CHIReqOpcode, bytes :: PosInt):
    for any (request in requests):
      request.opcode == opcode && request.sizes.contains(bytes)

class CHIHomeMapEntry(address_set :: AddressSet,
                      home :: CHIHomeParams):
  implements StableCircuitParam

  property target_node_id: home.node_id

fun require_disjoint_sam(sam :: List, who :: Symbol):
  for (left_index in 0..sam.length()):
    for (right_index in (left_index + 1)..sam.length()):
      if sam[left_index].address_set.overlaps(sam[right_index].address_set)
      | error(~who: who, "System Address Map entries must not overlap")
      | #void

class CHISubordinateMapEntry(address_set :: AddressSet,
                             service :: CHISubordinateServiceParams):
  implements StableCircuitParam

  property endpoint: service.endpoint
  property target_node_id: service.endpoint.node_id

// Shared decode mechanism; callers retain their nominal result and service contracts.
// Map construction has already checked disjointness and NodeID/address widths.
fun chi_map_lookup(address :: Bits, address_sets :: NonemptyList.of(AddressSet), node_ids :: NonemptyList.of(Nat), node_id_width :: PosInt):
  def matches = vec(for List (address_set in address_sets): address_set.matches(address))
  def selection = matches.as_bits().into(MaybeOneHot(address_sets.length()))
  def node_id = selection.mux(for List (target in node_ids): bits(target, node_id_width), ~default: bits(0, node_id_width))
  [selection.valid, node_id]

bundle CHISubordinateLookup(node_id_width :: PosInt):
  valid: Bool
  node_id: Bits(node_id_width)

class CHISubordinateMap(flit :: CHIFlitParams,
                        services :: NonemptyList.of(CHISubordinateServiceParams),
                        entries :: NonemptyList.of(CHISubordinateMapEntry)):
  implements StableCircuitParam

  constructor (flit :: CHIFlitParams,
               services :: NonemptyList.of(CHISubordinateServiceParams)):
    for (left_index in 0..services.length()):
      for (right_index in (left_index + 1)..services.length()):
        if services[left_index].endpoint.node_id == services[right_index].endpoint.node_id && (
          services[left_index].endpoint != services[right_index].endpoint
        )
        | error(~who: #'CHISubordinateMap,
                "distinct subordinate endpoints must have unique NodeIDs")
        | #void
    def mutable entries = []
    for (service in services):
      unless bits.length(service.endpoint.node_id) <= flit.node_id_width
      | error(~who: #'CHISubordinateMap,
              "Subordinate map NodeID must fit the physical NodeID width")
      for (address_set in service.address_sets):
        unless address_set.fits_unsigned_width(flit.request_address_width)
        | error(~who: #'CHISubordinateMap,
                "Subordinate map entry must fit the request address width")
        entries := entries ++ [CHISubordinateMapEntry(address_set, service)]
    require_disjoint_sam(entries, #'CHISubordinateMap)
    super(flit, services, entries)

  method entry(address :: Nat):
    entries.find(fun (entry): entry.address_set.contains(address))

  method lookup(address :: Bits(flit.request_address_width))
    :~ CHISubordinateLookup(flit.node_id_width):
    def [valid, node_id] = chi_map_lookup(address, entries.map(fun (entry): entry.address_set), entries.map(fun (entry): entry.target_node_id), flit.node_id_width)
    CHISubordinateLookup(flit.node_id_width):
      valid: valid
      node_id: node_id

bundle CHIHomeLookup(node_id_width :: PosInt):
  valid: Bool
  node_id: Bits(node_id_width)

class CHIHomeMap(flit :: CHIFlitParams,
                 entries :: NonemptyList.of(CHIHomeMapEntry)):
  implements StableCircuitParam

  constructor (flit :: CHIFlitParams,
               entries :: NonemptyList.of(CHIHomeMapEntry)):
    for (entry in entries):
      unless entry.address_set.fits_unsigned_width(flit.request_address_width)
      | error(~who: #'CHIHomeMap,
              "Home map entry must fit the request address width")
      unless bits.length(entry.target_node_id) <= flit.node_id_width
      | error(~who: #'CHIHomeMap,
              "Home map NodeID must fit the physical NodeID width")
    require_disjoint_sam(entries, #'CHIHomeMap)
    super(flit, entries)

  method entry(address :: Nat):
    entries.find(fun (entry): entry.address_set.contains(address))

  method lookup(address :: Bits(flit.request_address_width))
    :~ CHIHomeLookup(flit.node_id_width):
    def [valid, node_id] = chi_map_lookup(address, entries.map(fun (entry): entry.address_set), entries.map(fun (entry): entry.target_node_id), flit.node_id_width)
    CHIHomeLookup(flit.node_id_width):
      valid: valid
      node_id: node_id

fun chi_home_map_from_services(flit :: CHIFlitParams,
                               services :: NonemptyList.of(CHIHomeServiceParams))
  :: CHIHomeMap:
  def mutable entries = []
  for (service in services):
    for (address_set in service.address_sets):
      entries := entries ++ [CHIHomeMapEntry(address_set, service.home)]
  CHIHomeMap(flit, entries)

fun require_unique_node_ids(ports :: List.of(CHIFabricPortParams),
                            homes :: List.of(CHIHomeParams),
                            who :: Symbol):
  def node_ids = ports.map(fun (port): port.endpoint.node_id) ++ (
    homes.map(fun (home): home.node_id)
  )
  for (left_index in 0..node_ids.length()):
    for (right_index in (left_index + 1)..node_ids.length()):
      if node_ids[left_index] == node_ids[right_index]
      | error(~who: who, "fabric NodeIDs must be unique")
      | #void

class CHIFabricParams(flit :: CHIFlitParams,
                      ports :: NonemptyList.of(CHIFabricPortParams),
                      homes :: NonemptyList.of(CHIHomeParams),
                      home_services :: NonemptyList.of(CHIHomeServiceParams),
                      subordinate_services :: NonemptyList.of(CHISubordinateServiceParams),
                      home_map :: CHIHomeMap,
                      subordinate_map :: CHISubordinateMap):
  constructor (flit :: CHIFlitParams,
               ports :: NonemptyList.of(CHIFabricPortParams),
               homes :: NonemptyList.of(CHIHomeParams),
               home_services :: NonemptyList.of(CHIHomeServiceParams),
               subordinate_services :: NonemptyList.of(CHISubordinateServiceParams)):
    require_unique_node_ids(ports, homes, #'CHIFabricParams)
    for (port in ports):
      unless port.link.flit == flit
      | error(~who: #'CHIFabricParams,
              "fabric ports must use the fabric physical flit parameters")
      unless bits.length(port.endpoint.node_id) <= flit.node_id_width
      | error(~who: #'CHIFabricParams,
              "fabric NodeID must fit the physical NodeID width")
    for (home in homes):
      unless bits.length(home.node_id) <= flit.node_id_width
      | error(~who: #'CHIFabricParams,
              "fabric NodeID must fit the physical NodeID width")
    for (service in home_services):
      unless homes.contains(service.home)
      | error(~who: #'CHIFabricParams,
              "home service must reference a fabric Home Node")
    def home_map = chi_home_map_from_services(flit, home_services)
    def subordinate_map = CHISubordinateMap(flit, subordinate_services)
    for (service in subordinate_services):
      unless for any (port in ports):
               port.endpoint == service.endpoint
      | error(~who: #'CHIFabricParams,
              "subordinate service endpoint must be a fabric port")
    super(flit,
          ports,
          homes,
          home_services,
          subordinate_services,
          home_map,
          subordinate_map)

export:
  AddressSet
  TransferSizes
  CHIRequestSupport
  CHISubordinateServiceParams
  CHIFabricPortParams
  CHIHomeParams
  CHIHomeServiceParams
  CHISubordinateMapEntry
  CHISubordinateMap
  CHISubordinateLookup
  CHIHomeMapEntry
  CHIHomeMap
  CHIHomeLookup
  chi_home_map_from_services
  CHIFabricParams
