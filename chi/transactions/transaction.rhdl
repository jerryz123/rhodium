#lang rhodium
// Defines bounded stateful monitoring for the initial non-coherent CHI transaction subset.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/bits.rhdl") open
  lib("chi/protocol/params.rhdl").CHIFlitParams
  lib("chi/protocol/flits.rhdl") open
  lib("chi/protocol/protocol.rhdl") open
  lib("chi/protocol/link.rhdl") open
  lib("chi/protocol/messages.rhdl") open
  "data-checks.rhdl" open

hardware_enum CHIInitialTransactionPhase(~width: 3):
  Free = 0
  ReadPending = 1
  WriteAwaitDBID = 2
  WriteAwaitData = 3
  WriteAwaitComp = 4

bundle CHIRequesterTransaction(p :: CHIFlitParams):
  phase: CHIInitialTransactionPhase
  txn_id: Bits(12)
  completer_id: Bits(p.node_id_width)
  dbid: Bits(12)
  expected_data_ids: Bits(4)
  received_data_ids: Bits(4)

bundle CHISubordinateTransaction(p :: CHIFlitParams):
  phase: CHIInitialTransactionPhase
  txn_id: Bits(12)
  requester_id: Bits(p.node_id_width)
  return_txn_id: Bits(12)
  return_node_id: Bits(p.node_id_width)
  dbid: Bits(12)
  expected_data_ids: Bits(4)
  received_data_ids: Bits(4)

bundle CHIHomeTransaction(p :: CHIFlitParams):
  phase: CHIInitialTransactionPhase
  requester_id: Bits(p.node_id_width)
  requester_txn_id: Bits(12)
  requester_return_txn_id: Bits(12)
  requester_data_target: Bits(p.node_id_width)
  requester_qos: Bits(4)
  subordinate_id: Bits(p.node_id_width)
  subordinate_dbid: Bits(12)
  expected_data_ids: Bits(4)
  received_data_ids: Bits(4)

fun chi_initial_single_flit_size(size :: CHITransferSize,
                                 p :: CHIFlitParams):
  size.as_bits() <= bits(alignment_bits(p.data_bytes), 3)

fun chi_initial_request_fields(p :: CHIFlitParams, request :: CHIReqFlit(p), label_prefix :: String):
  assert(!request.multi_req, label_prefix ++ "_single_request")
  assert(chi_size_valid(chi_req_size(p, request)), label_prefix ++ "_size_valid")
  assert(request.order === CHIOrder.NoOrder, label_prefix ++ "_order_none")
  assert(request.pcrd_type === bits(0, 4), label_prefix ++ "_pcrd_type_zero")
  assert(!request.exp_comp_ack, label_prefix ++ "_no_comp_ack")
  assert(request.tag_op === CHITagOp.Invalid, label_prefix ++ "_tag_op_invalid")

fun chi_initial_data_fields(p :: CHIFlitParams, data :: CHIDatFlit(p), label_prefix :: String):
  assert(chi_data_id_valid(data.data_id, p), label_prefix ++ "_data_id_valid")
  monitor_chi_unelided_data(p, data, label_prefix)

fun requester_transaction_monitor(p :: CHIFlitParams,
                                  limit :: PosInt,
                                  label_prefix :: String,
                                  tx_req_valid :: Bool,
                                  req :: CHIReqFlit(p),
                                  rx_rsp_valid :: Bool,
                                  rsp :: CHIRspFlit(p),
                                  tx_dat_valid :: Bool,
                                  tx_dat :: CHIDatFlit(p),
                                  rx_dat_valid :: Bool,
                                  rx_dat :: CHIDatFlit(p)):
  def empty = literal(CHIRequesterTransaction(p), 0)
  def initial = vec(for List (_index in 0..limit): empty)
  reg entries(~init: initial)
  def req_opcode = req.opcode

  def req_event = tx_req_valid & (req.opcode =/= CHIReqOpcode.ReqLCrdReturn)
  def rsp_event = rx_rsp_valid & (rsp.opcode =/= CHIRspOpcode.RespLCrdReturn)
  def tx_dat_event = tx_dat_valid & (tx_dat.opcode =/= CHIDatOpcode.DataLCrdReturn)
  def rx_dat_event = rx_dat_valid & (rx_dat.opcode =/= CHIDatOpcode.DataLCrdReturn)
  def free_entries = vec(
    for List (index in 0..limit):
      entries[index].phase === CHIInitialTransactionPhase.Free
  )
  def allocation_available = free_entries.or_reduce()
  def allocation_index = priority_encoder(free_entries)
  def duplicate_txn = or_reduce(
    for List (index in 0..limit):
      (entries[index].phase =/= CHIInitialTransactionPhase.Free) & (
        entries[index].txn_id === req.txn_id
      )
  )
  def outgoing_data_id = one_hot(tx_dat.data_id).as_bits()
  def incoming_data_id = one_hot(rx_dat.data_id).as_bits()
  def write_data_matches = vec(
    for List (index in 0..limit):
      (entries[index].phase === CHIInitialTransactionPhase.WriteAwaitData) & (
        entries[index].dbid === tx_dat.txn_id
      ) & (entries[index].completer_id === tx_dat.tgt_id)
  )
  def dbid_match = or_reduce(
    for List (index in 0..limit):
      write_data_matches[index] & or_reduce(
        entries[index].expected_data_ids & outgoing_data_id
      ) & !or_reduce(entries[index].received_data_ids & outgoing_data_id)
  )
  def dbid_response_matches = vec(
    for List (index in 0..limit):
      (entries[index].phase === CHIInitialTransactionPhase.WriteAwaitDBID) & (
        entries[index].txn_id === rsp.txn_id
      )
  )
  def write_completion_matches = vec(
    for List (index in 0..limit):
      (entries[index].phase === CHIInitialTransactionPhase.WriteAwaitComp) & (
        entries[index].txn_id === rsp.txn_id
      ) & (entries[index].completer_id === rsp.src_id) & (
        entries[index].dbid === rsp.dbid_or_group_id
      )
  )
  def read_completion_matches = vec(
    for List (index in 0..limit):
      (entries[index].phase === CHIInitialTransactionPhase.ReadPending) & (
        entries[index].txn_id === rx_dat.txn_id
      ) & or_reduce(entries[index].expected_data_ids & incoming_data_id) & (
        !or_reduce(entries[index].received_data_ids & incoming_data_id)
      )
  )

  when req_event:
    assert(req_opcode.supports_initial_transaction(),
           label_prefix ++ "_request_opcode_supported")
    chi_initial_request_fields(p, req, label_prefix ++ "_request")
    assert(!duplicate_txn, label_prefix ++ "_txn_id_unique")
    assert(allocation_available, label_prefix ++ "_within_outstanding_limit")
  when rsp_event:
    assert(rsp.opcode.is_one_of(CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp),
           label_prefix ++ "_response_opcode_supported")
    when (rsp.opcode === CHIRspOpcode.DBIDResp):
      assert(dbid_response_matches.or_reduce(), label_prefix ++ "_dbid_response_has_write")
      assert(rsp.resp === bits(0, 3), label_prefix ++ "_dbid_response_resp_zero")
      assert(rsp.resp_err === CHIRespErr.OK,
             label_prefix ++ "_dbid_response_ok")
      def duplicate_dbid = or_reduce(
        for List (index in 0..limit):
          entries[index].phase.is_one_of(CHIInitialTransactionPhase.WriteAwaitData,
                                         CHIInitialTransactionPhase.WriteAwaitComp) & (
            entries[index].completer_id === rsp.src_id
          ) & (entries[index].dbid === rsp.dbid_or_group_id)
      )
      assert(!duplicate_dbid, label_prefix ++ "_dbid_unique")
    when (rsp.opcode === CHIRspOpcode.Comp):
      assert(write_completion_matches.or_reduce(), label_prefix ++ "_completion_has_write_data")
      assert(rsp.resp === bits(0, 3), label_prefix ++ "_completion_resp_zero")
      assert(rsp.resp_err === CHIRespErr.OK,
             label_prefix ++ "_completion_ok")
  when tx_dat_event:
    assert(tx_dat.opcode === CHIDatOpcode.NonCopyBackWriteData,
           label_prefix ++ "_write_data_opcode_supported")
    assert(dbid_match, label_prefix ++ "_write_data_has_dbid")
    chi_initial_data_fields(p, tx_dat, label_prefix ++ "_write_data")
  when rx_dat_event:
    assert(rx_dat.opcode === CHIDatOpcode.CompData,
           label_prefix ++ "_read_data_opcode_supported")
    assert(read_completion_matches.or_reduce(), label_prefix ++ "_read_data_has_request")
    assert(rx_dat.resp === bits(0, 3), label_prefix ++ "_read_data_resp_zero")
    assert(rx_dat.resp_err === CHIRespErr.OK,
           label_prefix ++ "_read_data_ok")
    chi_initial_data_fields(p, rx_dat, label_prefix ++ "_read_data")

  def allocated_phase = mux(req_opcode.is_initial_write(),
                            CHIInitialTransactionPhase.WriteAwaitDBID,
                            CHIInitialTransactionPhase.ReadPending)
  def allocated:
    CHIRequesterTransaction(p):
      phase: allocated_phase
      txn_id: req.txn_id
      completer_id: req.tgt_id
      dbid: bits(0, 12)
      expected_data_ids: chi_transfer_data_ids(req.address, chi_req_size(p, req), p)
      received_data_ids: bits(0, 4)
  def allocate = req_event & req_opcode.supports_initial_transaction() & (
    !duplicate_txn & allocation_available
  )
  def next_entries = vec(
    for List (index in 0..limit):
      block:
        def entry = entries[index]
        def dbid_response_here = rsp_event & (rsp.opcode === CHIRspOpcode.DBIDResp) & dbid_response_matches[index]
        def write_data_here = tx_dat_event & (tx_dat.opcode === CHIDatOpcode.NonCopyBackWriteData) & write_data_matches[index]
        def write_completion_here = rsp_event & (rsp.opcode === CHIRspOpcode.Comp) & write_completion_matches[index]
        def read_completion_here = rx_dat_event & (rx_dat.opcode === CHIDatOpcode.CompData) & read_completion_matches[index]
        def next_write_data_ids = entry.received_data_ids ||| outgoing_data_id
        def next_read_data_ids = entry.received_data_ids ||| incoming_data_id
        def after_dbid = entry.updated(
          ~phase: CHIInitialTransactionPhase.WriteAwaitData,
          ~completer_id: rsp.src_id,
          ~dbid: rsp.dbid_or_group_id
        )
        def after_write_data = entry.updated(
          ~phase: mux(next_write_data_ids === entry.expected_data_ids, CHIInitialTransactionPhase.WriteAwaitComp, CHIInitialTransactionPhase.WriteAwaitData),
          ~received_data_ids: next_write_data_ids
        )
        def after_read_data = entry.updated(
          ~phase: CHIInitialTransactionPhase.ReadPending,
          ~received_data_ids: next_read_data_ids
        )
        def progressed = mux(dbid_response_here,
                             after_dbid,
                             mux(write_data_here,
                                 after_write_data,
                                 mux(write_completion_here,
                                     empty,
                                     mux(read_completion_here,
                                         mux(next_read_data_ids === entry.expected_data_ids,
                                             empty,
                                             after_read_data),
                                         entry))))
        def allocate_here = allocate & (allocation_index === bits(index, index_width(limit)))
        mux(allocate_here, allocated, progressed)
  )
  entries <== next_entries

fun subordinate_transaction_monitor(p :: CHIFlitParams,
                                    limit :: PosInt,
                                    label_prefix :: String,
                                    rx_req_valid :: Bool,
                                    req :: CHIReqFlit(p),
                                    tx_rsp_valid :: Bool,
                                    rsp :: CHIRspFlit(p),
                                    rx_dat_valid :: Bool,
                                    rx_dat :: CHIDatFlit(p),
                                    tx_dat_valid :: Bool,
                                    tx_dat :: CHIDatFlit(p)):
  def empty = literal(CHISubordinateTransaction(p), 0)
  def initial = vec(for List (_index in 0..limit): empty)
  reg entries(~init: initial)
  def req_opcode = req.opcode

  def req_event = rx_req_valid & (req.opcode =/= CHIReqOpcode.ReqLCrdReturn)
  def rsp_event = tx_rsp_valid & (rsp.opcode =/= CHIRspOpcode.RespLCrdReturn)
  def rx_dat_event = rx_dat_valid & (rx_dat.opcode =/= CHIDatOpcode.DataLCrdReturn)
  def tx_dat_event = tx_dat_valid & (tx_dat.opcode =/= CHIDatOpcode.DataLCrdReturn)
  def free_entries = vec(
    for List (index in 0..limit):
      entries[index].phase === CHIInitialTransactionPhase.Free
  )
  def allocation_available = free_entries.or_reduce()
  def allocation_index = priority_encoder(free_entries)
  def duplicate_txn = or_reduce(
    for List (index in 0..limit):
      (entries[index].phase =/= CHIInitialTransactionPhase.Free) & (
        entries[index].requester_id === req.src_id
      ) & (entries[index].txn_id === req.txn_id)
  )
  def incoming_write_data_id = one_hot(rx_dat.data_id).as_bits()
  def outgoing_read_data_id = one_hot(tx_dat.data_id).as_bits()
  def dbid_response_matches = vec(
    for List (index in 0..limit):
      (entries[index].phase === CHIInitialTransactionPhase.WriteAwaitDBID) & (
        entries[index].txn_id === rsp.txn_id
      ) & (entries[index].requester_id === rsp.tgt_id)
  )
  def write_data_matches = vec(
    for List (index in 0..limit):
      (entries[index].phase === CHIInitialTransactionPhase.WriteAwaitData) & (
        entries[index].dbid === rx_dat.txn_id
      ) & (entries[index].requester_id === rx_dat.src_id) & or_reduce(
        entries[index].expected_data_ids & incoming_write_data_id
      ) & !or_reduce(entries[index].received_data_ids & incoming_write_data_id)
  )
  def write_completion_matches = vec(
    for List (index in 0..limit):
      (entries[index].phase === CHIInitialTransactionPhase.WriteAwaitComp) & (
        entries[index].txn_id === rsp.txn_id
      ) & (entries[index].requester_id === rsp.tgt_id) & (
        entries[index].dbid === rsp.dbid_or_group_id
      )
  )
  def read_completion_matches = vec(
    for List (index in 0..limit):
      (entries[index].phase === CHIInitialTransactionPhase.ReadPending) & (
        entries[index].return_txn_id === tx_dat.txn_id
      ) & (entries[index].return_node_id === tx_dat.tgt_id) & or_reduce(
        entries[index].expected_data_ids & outgoing_read_data_id
      ) & !or_reduce(entries[index].received_data_ids & outgoing_read_data_id)
  )

  when req_event:
    assert(req_opcode.supports_initial_transaction(),
           label_prefix ++ "_request_opcode_supported")
    chi_initial_request_fields(p, req, label_prefix ++ "_request")
    when (req_opcode.is_initial_write()):
      assert(!req.snp_attr_or_do_dwt, label_prefix ++ "_no_direct_write_transfer")
    assert(!duplicate_txn, label_prefix ++ "_txn_id_unique")
    assert(allocation_available, label_prefix ++ "_within_outstanding_limit")
  when rsp_event:
    assert(rsp.opcode.is_one_of(CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp),
           label_prefix ++ "_response_opcode_supported")
    when (rsp.opcode === CHIRspOpcode.DBIDResp):
      assert(dbid_response_matches.or_reduce(), label_prefix ++ "_dbid_response_has_write")
      assert(rsp.resp === bits(0, 3), label_prefix ++ "_dbid_response_resp_zero")
      assert(rsp.resp_err === CHIRespErr.OK,
             label_prefix ++ "_dbid_response_ok")
      def duplicate_dbid = or_reduce(
        for List (index in 0..limit):
          entries[index].phase.is_one_of(CHIInitialTransactionPhase.WriteAwaitData,
                                         CHIInitialTransactionPhase.WriteAwaitComp) & (
            entries[index].requester_id === rsp.tgt_id
          ) & (entries[index].dbid === rsp.dbid_or_group_id)
      )
      assert(!duplicate_dbid, label_prefix ++ "_dbid_unique")
    when (rsp.opcode === CHIRspOpcode.Comp):
      assert(write_completion_matches.or_reduce(), label_prefix ++ "_completion_has_write_data")
      assert(rsp.resp === bits(0, 3), label_prefix ++ "_completion_resp_zero")
      assert(rsp.resp_err === CHIRespErr.OK,
             label_prefix ++ "_completion_ok")
  when rx_dat_event:
    assert(rx_dat.opcode === CHIDatOpcode.NonCopyBackWriteData,
           label_prefix ++ "_write_data_opcode_supported")
    assert(write_data_matches.or_reduce(), label_prefix ++ "_write_data_has_dbid")
    chi_initial_data_fields(p, rx_dat, label_prefix ++ "_write_data")
  when tx_dat_event:
    assert(tx_dat.opcode === CHIDatOpcode.CompData,
           label_prefix ++ "_read_data_opcode_supported")
    assert(read_completion_matches.or_reduce(), label_prefix ++ "_read_data_has_request")
    assert(tx_dat.resp === bits(0, 3), label_prefix ++ "_read_data_resp_zero")
    assert(tx_dat.resp_err === CHIRespErr.OK,
           label_prefix ++ "_read_data_ok")
    chi_initial_data_fields(p, tx_dat, label_prefix ++ "_read_data")

  def allocated_phase = mux(req_opcode.is_initial_write(),
                            CHIInitialTransactionPhase.WriteAwaitDBID,
                            CHIInitialTransactionPhase.ReadPending)
  def allocated:
    CHISubordinateTransaction(p):
      phase: allocated_phase
      txn_id: req.txn_id
      requester_id: req.src_id
      return_txn_id: req.return_txn_id_or_stash_lpid
      return_node_id: req.return_nid_or_stash_nid_or_data_target
      dbid: bits(0, 12)
      expected_data_ids: chi_transfer_data_ids(req.address, chi_req_size(p, req), p)
      received_data_ids: bits(0, 4)
  def allocate = req_event & req_opcode.supports_initial_transaction() & (
    !duplicate_txn & allocation_available
  )
  def next_entries = vec(
    for List (index in 0..limit):
      block:
        def entry = entries[index]
        def dbid_response_here = rsp_event & (rsp.opcode === CHIRspOpcode.DBIDResp) & dbid_response_matches[index]
        def write_data_here = rx_dat_event & (rx_dat.opcode === CHIDatOpcode.NonCopyBackWriteData) & write_data_matches[index]
        def write_completion_here = rsp_event & (rsp.opcode === CHIRspOpcode.Comp) & write_completion_matches[index]
        def read_completion_here = tx_dat_event & (tx_dat.opcode === CHIDatOpcode.CompData) & read_completion_matches[index]
        def next_write_data_ids = entry.received_data_ids ||| incoming_write_data_id
        def next_read_data_ids = entry.received_data_ids ||| outgoing_read_data_id
        def after_dbid = entry.updated(
          ~phase: CHIInitialTransactionPhase.WriteAwaitData,
          ~dbid: rsp.dbid_or_group_id
        )
        def after_write_data = entry.updated(
          ~phase: mux(next_write_data_ids === entry.expected_data_ids, CHIInitialTransactionPhase.WriteAwaitComp, CHIInitialTransactionPhase.WriteAwaitData),
          ~received_data_ids: next_write_data_ids
        )
        def after_read_data = entry.updated(
          ~phase: CHIInitialTransactionPhase.ReadPending,
          ~received_data_ids: next_read_data_ids
        )
        def progressed = mux(dbid_response_here,
                             after_dbid,
                             mux(write_data_here,
                                 after_write_data,
                                 mux(write_completion_here,
                                     empty,
                                     mux(read_completion_here,
                                         mux(next_read_data_ids === entry.expected_data_ids,
                                             empty,
                                             after_read_data),
                                         entry))))
        def allocate_here = allocate & (allocation_index === bits(index, index_width(limit)))
        mux(allocate_here, allocated, progressed)
  )
  entries <== next_entries

// Verifies the one-for-one ID and payload translation performed by an initial
// HN-I between already-buffered ready-valid flows on its RN and SN sides.
fun home_transaction_monitor(p :: CHIFlitParams,
                             home_node_id :: Nat,
                             limit :: PosInt,
                             label_prefix :: String,
                             upstream_request_event :: Bool,
                             upstream_request :: CHIReqFlit(p),
                             downstream_request_event :: Bool,
                             downstream_request :: CHIReqFlit(p),
                             downstream_response_event :: Bool,
                             downstream_response :: CHIRspFlit(p),
                             upstream_response_event :: Bool,
                             upstream_response :: CHIRspFlit(p),
                             upstream_write_data_event :: Bool,
                             upstream_write_data :: CHIDatFlit(p),
                             downstream_write_data_event :: Bool,
                             downstream_write_data :: CHIDatFlit(p),
                             downstream_read_data_event :: Bool,
                             downstream_read_data :: CHIDatFlit(p),
                             upstream_read_data_event :: Bool,
                             upstream_read_data :: CHIDatFlit(p)):
  def empty = literal(CHIHomeTransaction(p), 0)
  def initial = vec(for List (_index in 0..limit): empty)
  reg entries(~init: initial)
  def upstream_request_opcode = upstream_request.opcode
  def slot_width = index_width(limit)
  def request_slot = downstream_request.txn_id[0..slot_width]
  def response_slot = downstream_response.txn_id[0..slot_width]
  def write_data_slot = upstream_write_data.txn_id[0..slot_width]
  def read_data_slot = downstream_read_data.txn_id[0..slot_width]
  def request_slot_valid = downstream_request.txn_id < bits(limit, 12)
  def response_slot_valid = downstream_response.txn_id < bits(limit, 12)
  def write_data_slot_valid = upstream_write_data.txn_id < bits(limit, 12)
  def read_data_slot_valid = downstream_read_data.txn_id < bits(limit, 12)
  def response_entry = entries[response_slot]
  def write_data_entry = entries[write_data_slot]
  def read_data_entry = entries[read_data_slot]
  def write_data_id = one_hot(upstream_write_data.data_id).as_bits()
  def read_data_id = one_hot(downstream_read_data.data_id).as_bits()
  def duplicate_request = or_reduce(
    for List (index in 0..limit):
      (entries[index].phase =/= CHIInitialTransactionPhase.Free) & (
        entries[index].requester_id === upstream_request.src_id
      ) & (entries[index].requester_txn_id === upstream_request.txn_id)
  )
  def response_dbid = downstream_response.opcode === CHIRspOpcode.DBIDResp
  def response_comp = downstream_response.opcode === CHIRspOpcode.Comp

  assert(upstream_request_event === downstream_request_event,
         label_prefix ++ "_request_transfer_paired")
  when (upstream_request_event & downstream_request_event):
    assert(request_slot_valid, label_prefix ++ "_request_slot_in_range")
    assert(entries[request_slot].phase === CHIInitialTransactionPhase.Free,
           label_prefix ++ "_request_slot_free")
    assert(!duplicate_request, label_prefix ++ "_request_txn_id_unique")
    chi_initial_request_fields(p, upstream_request, label_prefix ++ "_request")
    when (upstream_request_opcode.is_initial_write()):
      assert(!upstream_request.snp_attr_or_do_dwt,
             label_prefix ++ "_request_no_direct_write_transfer")
    assert(downstream_request.opcode === upstream_request.opcode,
           label_prefix ++ "_request_opcode_preserved")
    assert(downstream_request.address === upstream_request.address,
           label_prefix ++ "_request_address_preserved")
    assert(downstream_request.size_or_num_req === upstream_request.size_or_num_req,
           label_prefix ++ "_request_size_preserved")
    assert(downstream_request.src_id === bits(home_node_id, p.node_id_width),
           label_prefix ++ "_request_source_home")
    assert(downstream_request.return_nid_or_stash_nid_or_data_target === bits(home_node_id, p.node_id_width),
           label_prefix ++ "_request_return_home")
    assert(downstream_request.return_txn_id_or_stash_lpid === request_slot.zext(12),
           label_prefix ++ "_request_return_slot")
    assert(downstream_request.qos === upstream_request.qos,
           label_prefix ++ "_request_qos_preserved")

  assert(downstream_response_event === upstream_response_event,
         label_prefix ++ "_response_transfer_paired")
  when downstream_response_event:
    assert(response_slot_valid, label_prefix ++ "_response_slot_in_range")
    when response_slot_valid:
      assert(downstream_response.src_id === response_entry.subordinate_id,
             label_prefix ++ "_response_source_subordinate")
      assert(downstream_response.tgt_id === bits(home_node_id, p.node_id_width),
             label_prefix ++ "_response_targets_home")
  when (downstream_response_event & upstream_response_event):
    assert(downstream_response.opcode.is_one_of(CHIRspOpcode.DBIDResp,
                                                CHIRspOpcode.Comp),
           label_prefix ++ "_response_opcode")
    assert(downstream_response.resp === bits(0, 3),
           label_prefix ++ "_response_resp_zero")
    assert(downstream_response.resp_err === CHIRespErr.OK,
           label_prefix ++ "_response_ok")
    when response_dbid:
      assert(response_entry.phase === CHIInitialTransactionPhase.WriteAwaitDBID,
             label_prefix ++ "_dbid_has_write")
    when response_comp:
      assert(response_entry.phase === CHIInitialTransactionPhase.WriteAwaitComp,
             label_prefix ++ "_comp_has_write_data")
    assert(upstream_response.opcode === downstream_response.opcode,
           label_prefix ++ "_response_opcode_preserved")
    assert(upstream_response.txn_id === response_entry.requester_txn_id,
           label_prefix ++ "_response_txn_restored")
    assert(upstream_response.src_id === bits(home_node_id, p.node_id_width),
           label_prefix ++ "_response_source_home")
    assert(upstream_response.tgt_id === response_entry.requester_id,
           label_prefix ++ "_response_target_requester")
    assert(upstream_response.dbid_or_group_id === response_slot.zext(12),
           label_prefix ++ "_response_home_dbid")
    assert(upstream_response.qos === response_entry.requester_qos,
           label_prefix ++ "_response_qos_restored")

  assert(upstream_write_data_event === downstream_write_data_event,
         label_prefix ++ "_write_data_transfer_paired")
  when (upstream_write_data_event & downstream_write_data_event):
    assert(write_data_slot_valid, label_prefix ++ "_write_data_slot_in_range")
    assert(write_data_entry.phase === CHIInitialTransactionPhase.WriteAwaitData,
           label_prefix ++ "_write_data_has_dbid")
    assert(or_reduce(write_data_entry.expected_data_ids & write_data_id) & (
             !or_reduce(write_data_entry.received_data_ids & write_data_id)
           ), label_prefix ++ "_write_data_id_expected")
    chi_initial_data_fields(p, upstream_write_data, label_prefix ++ "_write_data")
    assert(downstream_write_data.opcode === upstream_write_data.opcode,
           label_prefix ++ "_write_data_opcode_preserved")
    assert(downstream_write_data.data === upstream_write_data.data,
           label_prefix ++ "_write_data_payload_preserved")
    assert(downstream_write_data.byte_enable === upstream_write_data.byte_enable,
           label_prefix ++ "_write_data_mask_preserved")
    assert(downstream_write_data.txn_id === write_data_entry.subordinate_dbid,
           label_prefix ++ "_write_data_dbid_translated")
    assert(downstream_write_data.src_id === bits(home_node_id, p.node_id_width),
           label_prefix ++ "_write_data_source_home")
    assert(downstream_write_data.tgt_id === write_data_entry.subordinate_id,
           label_prefix ++ "_write_data_target_subordinate")
    assert(downstream_write_data.qos === write_data_entry.requester_qos,
           label_prefix ++ "_write_data_qos_restored")

  assert(downstream_read_data_event === upstream_read_data_event,
         label_prefix ++ "_read_data_transfer_paired")
  when downstream_read_data_event:
    assert(read_data_slot_valid, label_prefix ++ "_read_data_slot_in_range")
    when read_data_slot_valid:
      assert(downstream_read_data.src_id === read_data_entry.subordinate_id,
             label_prefix ++ "_read_data_source_subordinate")
      assert(downstream_read_data.tgt_id === bits(home_node_id, p.node_id_width),
             label_prefix ++ "_read_data_targets_home")
  when (downstream_read_data_event & upstream_read_data_event):
    assert(read_data_entry.phase === CHIInitialTransactionPhase.ReadPending,
           label_prefix ++ "_read_data_has_request")
    assert(or_reduce(read_data_entry.expected_data_ids & read_data_id) & (
             !or_reduce(read_data_entry.received_data_ids & read_data_id)
           ), label_prefix ++ "_read_data_id_expected")
    assert(downstream_read_data.resp === bits(0, 3),
           label_prefix ++ "_read_data_resp_zero")
    assert(downstream_read_data.resp_err === CHIRespErr.OK,
           label_prefix ++ "_read_data_ok")
    chi_initial_data_fields(p, downstream_read_data, label_prefix ++ "_read_data")
    assert(upstream_read_data.opcode === downstream_read_data.opcode,
           label_prefix ++ "_read_data_opcode_preserved")
    assert(upstream_read_data.data === downstream_read_data.data,
           label_prefix ++ "_read_data_payload_preserved")
    assert(upstream_read_data.byte_enable === downstream_read_data.byte_enable,
           label_prefix ++ "_read_data_mask_preserved")
    assert(upstream_read_data.txn_id === read_data_entry.requester_return_txn_id,
           label_prefix ++ "_read_data_txn_restored")
    assert(upstream_read_data.src_id === bits(home_node_id, p.node_id_width),
           label_prefix ++ "_read_data_source_home")
    assert(upstream_read_data.tgt_id === read_data_entry.requester_data_target,
           label_prefix ++ "_read_data_target_requester")
    assert(upstream_read_data.qos === read_data_entry.requester_qos,
           label_prefix ++ "_read_data_qos_restored")

  def request_pair = upstream_request_event & downstream_request_event & request_slot_valid
  def response_pair = downstream_response_event & upstream_response_event & response_slot_valid & (
    downstream_response.src_id === response_entry.subordinate_id
  ) & (downstream_response.tgt_id === bits(home_node_id, p.node_id_width))
  def write_data_pair = upstream_write_data_event & downstream_write_data_event & write_data_slot_valid & (
    downstream_write_data.tgt_id === write_data_entry.subordinate_id
  )
  def read_data_pair = downstream_read_data_event & upstream_read_data_event & read_data_slot_valid & (
    downstream_read_data.src_id === read_data_entry.subordinate_id
  ) & (downstream_read_data.tgt_id === bits(home_node_id, p.node_id_width))
  def next_entries = vec(
    for List (index in 0..limit):
      block:
        def entry = entries[index]
        def index_bits = bits(index, slot_width)
        def allocate_here = request_pair & (request_slot === index_bits)
        def dbid_here = response_pair & response_dbid & (response_slot === index_bits)
        def write_data_here = write_data_pair & (write_data_slot === index_bits)
        def write_comp_here = response_pair & response_comp & (response_slot === index_bits)
        def read_data_here = read_data_pair & (read_data_slot === index_bits)
        def allocated:
          CHIHomeTransaction(p):
            phase: mux(upstream_request_opcode.is_initial_write(),
                       CHIInitialTransactionPhase.WriteAwaitDBID,
                       CHIInitialTransactionPhase.ReadPending)
            requester_id: upstream_request.src_id
            requester_txn_id: upstream_request.txn_id
            requester_return_txn_id: upstream_request.return_txn_id_or_stash_lpid
            requester_data_target: upstream_request.return_nid_or_stash_nid_or_data_target
            requester_qos: upstream_request.qos
            subordinate_id: downstream_request.tgt_id
            subordinate_dbid: bits(0, 12)
            expected_data_ids: chi_transfer_data_ids(upstream_request.address, chi_req_size(p, upstream_request), p)
            received_data_ids: bits(0, 4)
        def after_dbid = entry.updated(
          ~phase: CHIInitialTransactionPhase.WriteAwaitData,
          ~subordinate_dbid: downstream_response.dbid_or_group_id
        )
        def next_write_data_ids = entry.received_data_ids ||| write_data_id
        def next_read_data_ids = entry.received_data_ids ||| read_data_id
        def after_write_data = entry.updated(
          ~phase: mux(next_write_data_ids === entry.expected_data_ids, CHIInitialTransactionPhase.WriteAwaitComp, CHIInitialTransactionPhase.WriteAwaitData),
          ~received_data_ids: next_write_data_ids
        )
        def after_read_data = entry.updated(
          ~phase: CHIInitialTransactionPhase.ReadPending,
          ~received_data_ids: next_read_data_ids
        )
        def progressed = mux(dbid_here,
                             after_dbid,
                             mux(write_data_here,
                                 after_write_data,
                                 mux(write_comp_here,
                                     empty,
                                     mux(read_data_here,
                                         mux(next_read_data_ids === entry.expected_data_ids,
                                             empty,
                                             after_read_data),
                                         entry))))
        mux(allocate_here, allocated, progressed)
  )
  entries <== next_entries

export:
  chi_initial_single_flit_size
  chi_hni_downstream_request
  chi_hni_upstream_response
  chi_hni_downstream_write_data
  chi_hni_upstream_read_data
  chi_initial_requester_capabilities
  chi_initial_subordinate_capabilities
  requester_transaction_monitor
  subordinate_transaction_monitor
  home_transaction_monitor
