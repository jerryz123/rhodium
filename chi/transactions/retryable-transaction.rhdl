#lang rhodium
// Defines declarative CHI response profiles and retryable transaction control.

import:
  rhombus/meta open
  lib("support/annotations.rhm").NonemptyString
  lib("rhodium/std/ready-valid.rhdl") open
  lib("chi/protocol/params.rhdl").CHIFlitParams
  lib("chi/protocol/flits.rhdl") open

class CHIResponseRule(opcodes :: NonemptyList.of(CHIRspOpcode),
                      milestones :: NonemptyList.of(String)):
  implements StableCircuitParam

class CHIResponseProfile(name :: NonemptyString,
                         milestones :: List.of(String),
                         rules :: List.of(CHIResponseRule),
                         retryable :: Boolean):
  implements StableCircuitParam

  property effect_width:
    if milestones.length() == 0 | 1 | milestones.length()

  property full_effect_mask:
    (1 << milestones.length()) - 1

  property progress_opcodes:
    block:
      def mutable result = []
      for (rule in rules):
        result := result ++ rule.opcodes
      result

  property response_opcodes:
    if retryable
    | [CHIRspOpcode.RetryAck, CHIRspOpcode.PCrdGrant] ++ progress_opcodes
    | progress_opcodes

  constructor (name :: NonemptyString,
               milestones :: List.of(String),
               rules :: List.of(CHIResponseRule),
               ~retryable: retryable :: Boolean = #false):
    for (milestone in milestones):
      unless milestone.length() > 0
      | error(~who: #'response_profile,
              "milestone names must not be empty")
    for (left in 0..milestones.length()):
      for (right in (left + 1)..milestones.length()):
        if milestones[left] == milestones[right]
        | error(~who: #'response_profile,
                "milestone names must be unique")
        | #void
    def mutable seen_opcodes = []
    for (rule in rules):
      for (milestone in rule.milestones):
        unless milestones.contains(milestone)
        | error(~who: #'response_profile,
                "response rule names an undeclared milestone")
      for (opcode in rule.opcodes):
        unless ![
          CHIRspOpcode.RespLCrdReturn,
          CHIRspOpcode.RetryAck,
          CHIRspOpcode.PCrdGrant
        ].contains(opcode)
        | error(~who: #'response_profile,
                "link credit and retry opcodes use their dedicated clauses")
        unless !seen_opcodes.contains(opcode)
        | error(~who: #'response_profile,
                "response opcodes must be unique across rules")
        seen_opcodes := seen_opcodes ++ [opcode]
    unless retryable || rules.length() > 0
    | error(~who: #'response_profile,
            "a response profile must accept at least one response")
    super(name, milestones, rules, retryable)

  method milestone_index(milestone :: String) :: Nat:
    def mutable result = #false
    for (candidate in milestones, index in 0..milestones.length()):
      if candidate == milestone
      | result := index
      | #void
    unless result is_a Nat
    | error(~who: #'CHIResponseProfile.milestone_index,
            "profile has no such milestone")
    result

  method milestone_mask(milestone :: String) :: Nat:
    1 << milestone_index(milestone)

  method rule_effect_mask(rule :: CHIResponseRule) :: Nat:
    def mutable result = 0
    for (milestone in rule.milestones):
      result := result bits.or milestone_mask(milestone)
    result

expr.macro 'response_profile($name): $clause; ...':
  def mutable retryable = #false
  def mutable milestones = []
  def mutable rules = []
  for (item in [clause, ...]):
    match item
    | 'retryable':
        when retryable
        | syntax_meta.error("response profile repeats retryable", item)
        retryable := #true
    | 'milestone $(milestone :: Identifier)':
        def milestone_name = milestone.to_source_string()
        milestones := milestones ++ [milestone_name]
    | 'response [$(opcode :: expr_meta.Parsed), ...]:
         completes [$(milestone :: Identifier), ...]':
        let [opcode_entry, ...] = [opcode, ...]
        let [milestone_name, ...] = [milestone.to_source_string(), ...]
        rules := rules ++ [
          'CHIResponseRule([$opcode_entry, ...], [$milestone_name, ...])'
        ]
    | ~else:
        syntax_meta.error(
          "expected retryable, milestone, or response profile clause",
          item
        )
  let [milestone_name, ...] = milestones
  def rule_list:
    if rules.length() == 0
    | '[]'
    | block:
        let [rule, ...] = rules
        '[$rule, ...]'
  'CHIResponseProfile(
     $name,
     [$milestone_name, ...],
     $rule_list,
     ~retryable: $retryable
   )'

fun chi_response_profile_opcodes(
    profiles :: NonemptyList.of(CHIResponseProfile)
) :: List.of(CHIRspOpcode):
  def mutable result = []
  for (profile in profiles):
    for (opcode in profile.response_opcodes):
      if result.contains(opcode)
      | #void
      | result := result ++ [opcode]
  result

fun chi_response_effects(profile :: CHIResponseProfile,
                         opcode :: CHIRspOpcode)
  :~ Bits(profile.effect_width):
  def mutable cases = []
  for (rule in profile.rules):
    for (rule_opcode in rule.opcodes):
      cases := cases ++ [
        [rule_opcode,
         bits(profile.rule_effect_mask(rule), profile.effect_width)]
      ]
  if cases.length() == 0
  | bits(0, profile.effect_width)
  | mux_lookup(opcode, ~default: bits(0, profile.effect_width), cases)

fun chi_response_milestone(profile :: CHIResponseProfile,
                           effects :: Bits(profile.effect_width),
                           milestone :: String) :~ Bool:
  effects[profile.milestone_index(milestone)].into(Bool)

bundle CHIRequestAttempt():
  allow_retry: Bool
  pcrd_type: Bits(4)

bundle CHIResponseEvent(p :: CHIFlitParams, effect_width :: PosInt):
  flit: CHIRspFlit(p)
  effects: Bits(effect_width)
  retry_ack: Bool
  protocol_credit: Bool

sync_circuit CHIRetryableTransactionControl(p :: CHIFlitParams, profile :: CHIResponseProfile):
  input start: Bool
  input finish: Bool
  input external_progress: Bool
  interface attempt(Decoupled(CHIRequestAttempt()), ~role: producer)
  interface response(Decoupled(CHIRspFlit(p)), ~role: consumer)
  interface event(Valid(CHIResponseEvent(p, profile.effect_width)), ~role: producer)
  output active: Bool
  output attempt_outstanding: Bool
  output received: Bits(profile.effect_width)

  reg active_state(~init: Bool(#false))
  reg attempt_sent(~init: Bool(#false))
  reg received_state(~init: bits(0, profile.effect_width))
  reg irreversible_progress(~init: Bool(#false))
  reg retry_received(~init: Bool(#false))
  reg retry_credit_received(~init: Bool(#false))
  reg retry_credit_type(~init: bits(0, 4))
  reg granted_credit_type(~init: bits(0, 4))

  active <== active_state
  attempt_outstanding <== attempt_sent
  received <== received_state

  def retry_ready = retry_received & retry_credit_received
  def attempt_available = if profile.retryable | !retry_received ||| retry_ready | Bool(#true)
  attempt.valid <== active_state & !attempt_sent & attempt_available
  attempt.bits <== CHIRequestAttempt():
    allow_retry: Bool(profile.retryable) & !retry_received
    pcrd_type: mux(retry_received, retry_credit_type, bits(0, 4))
  def attempt_fire = attempt.fire()

  def incoming_response = response.bits
  def response_ordinary = incoming_response.opcode =/= CHIRspOpcode.RespLCrdReturn
  def response_retry = incoming_response.opcode === CHIRspOpcode.RetryAck
  def response_protocol_credit = incoming_response.opcode === CHIRspOpcode.PCrdGrant
  def response_effects = chi_response_effects(profile, incoming_response.opcode)
  def response_progress = response_effects.or_reduce()
  def progress_expected = active_state & attempt_sent & response_progress & !or_reduce(
    response_effects & received_state
  )
  def retry_expected:
    if profile.retryable
    | active_state & response_retry & attempt_sent & !irreversible_progress
    | Bool(#false)
  def protocol_credit_expected:
    if profile.retryable
    | active_state & response_protocol_credit & (attempt_sent ||| retry_received)
    | Bool(#false)
  def response_expected = progress_expected ||| retry_expected ||| protocol_credit_expected
  response.ready <== !response_ordinary ||| response_expected
  def response_fire = response.fire() & response_ordinary
  def retry_fire = response_fire & response_retry
  def protocol_credit_fire = response_fire & response_protocol_credit
  def progress_fire = response_fire & response_progress

  event.valid <== response_fire
  event.bits <== CHIResponseEvent(p, profile.effect_width):
    flit: incoming_response
    effects: response_effects
    retry_ack: response_retry
    protocol_credit: response_protocol_credit

  when (response.valid & response_ordinary):
    assert(response_expected, profile.name ++ "_response_expected")
  when (retry_received & retry_credit_received):
    assert(retry_credit_type === granted_credit_type,
           profile.name ++ "_retry_credit_type_matches")

  when start:
    active_state <== Bool(#true)
  elsewhen finish:
    active_state <== Bool(#false)

  when (start ||| retry_fire ||| finish):
    attempt_sent <== Bool(#false)
  elsewhen attempt_fire:
    attempt_sent <== Bool(#true)

  when (start ||| finish):
    received_state <== bits(0, profile.effect_width)
  elsewhen progress_fire:
    received_state <== received_state ||| response_effects

  when (start ||| finish):
    irreversible_progress <== Bool(#false)
  elsewhen (progress_fire ||| external_progress):
    irreversible_progress <== Bool(#true)

  when (start ||| (attempt_fire & retry_received) ||| finish):
    retry_received <== Bool(#false)
    retry_credit_received <== Bool(#false)
    retry_credit_type <== bits(0, 4)
    granted_credit_type <== bits(0, 4)
  elsewhen retry_fire:
    retry_received <== Bool(#true)
    retry_credit_type <== incoming_response.pcrd_type
  elsewhen protocol_credit_fire:
    retry_credit_received <== Bool(#true)
    granted_credit_type <== incoming_response.pcrd_type

export:
  CHIResponseRule
  CHIResponseProfile
  response_profile
  chi_response_profile_opcodes
  chi_response_effects
  chi_response_milestone
  CHIRequestAttempt
  CHIResponseEvent
  CHIRetryableTransactionControl
