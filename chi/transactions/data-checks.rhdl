#lang rhodium
/* Checks unelided packets and full-copyback state/masks without owning receipt state. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("chi/protocol/params.rhdl").CHIFlitParams
  lib("chi/protocol/flits.rhdl").CHIDatFlit
  lib("chi/protocol/flits.rhdl").CHIDatOpcode
  lib("chi/protocol/flits.rhdl").CHIRespErr

/*
 * Assert the delivered full-copyback state and mask rules, including zero data for Invalid
 * copies.
 */
fun monitor_chi_copyback_data(p :: CHIFlitParams, data :: CHIDatFlit(p), label_prefix :: String):
  monitor_chi_unelided_data(p, data, label_prefix)
  assert(data.opcode === CHIDatOpcode.CopyBackWriteData, label_prefix ++ "_opcode")
  assert(data.resp_err === CHIRespErr.OK, label_prefix ++ "_data_ok")
  assert((data.resp === Bits(3)(0)) ||| (data.resp === Bits(3)(1)) ||| (data.resp === Bits(3)(2)) ||| (data.resp === Bits(3)(6)) ||| (data.resp === Bits(3)(7)), label_prefix ++ "_state")
  def invalid = data.resp === Bits(3)(0)
  assert(data.byte_enable === mux(invalid, Bits(p.byte_enable_width)(0), !Bits(p.byte_enable_width)(0)), label_prefix ++ "_byte_enable")
  assert(!invalid ||| (data.data === Bits(p.data_width)(0)), label_prefix ++ "_invalid_zero_data")

/* Assert that a DAT packet is neither replicated nor part of an elided packet encoding. */
fun monitor_chi_unelided_data(p :: CHIFlitParams, data :: CHIDatFlit(p), label_prefix :: String):
  assert(data.num_dat === Bits(2)(0), label_prefix ++ "_num_dat_zero")
  assert(!data.replicate, label_prefix ++ "_not_replicated")

export:
  monitor_chi_unelided_data
  monitor_chi_copyback_data
