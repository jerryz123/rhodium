#lang rhombus
/* Compiles logical CHI connections into independent, validated NoC channel plans. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../../support/annotations.rhm" open
  "../../noc/analysis/escape-validation.rhm".EscapeValidationRequest
  "../../noc/authoring/main.rhm" open
  "../../noc/model/main.rhm".RouteClass
  "../../noc/plan/main.rhm" open

export:
  CHIInjectionSite
  CHIEjectionSite
  CHIRNSite
  CHIRNICNSite
  CHISNICNSite
  CHISNSite
  CHIChannelRouteSpec
  CHIConnection
  CHIRNIConnection
  CHIRNFConnection
  CHISNConnection
  CHIChannelRouting
  CHICompiledRoute
  CHIChannelCompilation
  CHIChannelCompilations
  uniform_chi_routing
  compile_chi_channel
  compile_chi_connections

/*
 * Associates one CHI NodeID with one symbolic terminal and its physical
 * router attachment. This is the single source of endpoint facts throughout
 * CHI-to-NoC compilation.
 */
class CHIInjectionSite(node_id :: Nat,
                       terminal :: InjectionRef,
                       router :: NodeRef):
  /* Project this CHI source into the generic NoC injection-terminal description. */
  method terminal_spec(): InjectionTerminalSpec(terminal, router)

/* Associate a destination NodeID with its symbolic terminal and physical router placement. */
class CHIEjectionSite(node_id :: Nat,
                      terminal :: EjectionRef,
                      router :: NodeRef):
  /* Project this CHI destination into the generic NoC ejection-terminal description. */
  method terminal_spec(): EjectionTerminalSpec(terminal, router)

/* Extend an endpoint name with channel suffixes and construct its injection identity. */
fun injection_site(path :: NamePath,
                   suffixes :: NonemptyList.of(NonemptyString),
                   node_id :: Nat,
                   router :: NodeRef) :: CHIInjectionSite:
  def mutable terminal_path = path
  for (suffix in suffixes):
    terminal_path := terminal_path.child(suffix)
  CHIInjectionSite(node_id, InjectionRef(terminal_path), router)

/* Extend an endpoint name with channel suffixes and construct its ejection identity. */
fun ejection_site(path :: NamePath,
                  suffixes :: NonemptyList.of(NonemptyString),
                  node_id :: Nat,
                  router :: NodeRef) :: CHIEjectionSite:
  def mutable terminal_path = path
  for (suffix in suffixes):
    terminal_path := terminal_path.child(suffix)
  CHIEjectionSite(node_id, EjectionRef(terminal_path), router)

/* Group the requester-side terminal identities for requests, responses, snoops, and data. */
class CHIRNSite(path :: NamePath,
                node_id :: Nat,
                router :: NodeRef,
                req :: CHIInjectionSite,
                rsp_requester :: CHIInjectionSite,
                rsp_response :: CHIEjectionSite,
                snp :: CHIEjectionSite,
                dat_request :: CHIInjectionSite,
                dat_response :: CHIEjectionSite):
  /* Create consistently named requester terminals at one NodeID and router. */
  constructor (path :: NamePath, node_id :: Nat, router :: NodeRef):
    super(path,
          node_id,
          router,
          injection_site(path, ["req"], node_id, router),
          injection_site(path, ["rsp", "requester"], node_id, router),
          ejection_site(path, ["rsp", "response"], node_id, router),
          ejection_site(path, ["snp"], node_id, router),
          injection_site(path, ["dat", "request"], node_id, router),
          ejection_site(path, ["dat", "response"], node_id, router))

/* Group the Home's requester-facing terminal identities with reversed requester directions. */
class CHIRNICNSite(path :: NamePath,
                   node_id :: Nat,
                   router :: NodeRef,
                   req :: CHIEjectionSite,
                   rsp_requester :: CHIEjectionSite,
                   rsp_response :: CHIInjectionSite,
                   snp :: CHIInjectionSite,
                   dat_request :: CHIEjectionSite,
                   dat_response :: CHIInjectionSite):
  /* Create the aggregate Home requester-side terminals at one NodeID and router. */
  constructor (path :: NamePath, node_id :: Nat, router :: NodeRef):
    super(path,
          node_id,
          router,
          ejection_site(path, ["req"], node_id, router),
          ejection_site(path, ["rsp", "requester"], node_id, router),
          injection_site(path, ["rsp", "response"], node_id, router),
          injection_site(path, ["snp"], node_id, router),
          ejection_site(path, ["dat", "request"], node_id, router),
          injection_site(path, ["dat", "response"], node_id, router))

/* Group the Home's subordinate-facing REQ, RSP, and DAT terminal identities. */
class CHISNICNSite(path :: NamePath,
                   node_id :: Nat,
                   router :: NodeRef,
                   req :: CHIInjectionSite,
                   rsp_response :: CHIEjectionSite,
                   dat_request :: CHIInjectionSite,
                   dat_response :: CHIEjectionSite):
  /* Create the Home subordinate-side source and sink terminals without a SNP path. */
  constructor (path :: NamePath, node_id :: Nat, router :: NodeRef):
    super(path,
          node_id,
          router,
          injection_site(path, ["req"], node_id, router),
          ejection_site(path, ["rsp", "response"], node_id, router),
          injection_site(path, ["dat", "request"], node_id, router),
          ejection_site(path, ["dat", "response"], node_id, router))

/* Group a subordinate device's REQ, RSP, and DAT terminal identities. */
class CHISNSite(path :: NamePath,
                node_id :: Nat,
                router :: NodeRef,
                req :: CHIEjectionSite,
                rsp_response :: CHIInjectionSite,
                dat_request :: CHIEjectionSite,
                dat_response :: CHIInjectionSite):
  /* Create subordinate device terminals with directions complementary to the Home side. */
  constructor (path :: NamePath, node_id :: Nat, router :: NodeRef):
    super(path,
          node_id,
          router,
          ejection_site(path, ["req"], node_id, router),
          injection_site(path, ["rsp", "response"], node_id, router),
          ejection_site(path, ["dat", "request"], node_id, router),
          injection_site(path, ["dat", "response"], node_id, router))

/*
 * Describes one permitted protocol-channel path before generic route lowering.
 */
class CHIChannelRouteSpec(ref :: RouteClassRef,
                          source :: CHIInjectionSite,
                          destination :: CHIEjectionSite):
  /* Derive a stable symbolic route-class name from the source and destination paths. */
  constructor (source :: CHIInjectionSite,
               destination :: CHIEjectionSite):
    super(RouteClassRef(source.terminal.path.segments ++ (
                          ["to"] ++ destination.terminal.path.segments
                        )),
          source,
          destination)

/* Define the channel routes contributed by one logical CHI connection. */
interface CHIConnection:
  /* Describe permitted request paths for this connection. */
  method req_routes() :: NonemptyList.of(CHIChannelRouteSpec)
  /* Describe permitted response paths for this connection. */
  method rsp_routes() :: NonemptyList.of(CHIChannelRouteSpec)
  /* Describe snoop paths, allowing an empty list for non-snooping connections. */
  method snp_routes() :: List.of(CHIChannelRouteSpec)
  /* Describe permitted data paths for this connection. */
  method dat_routes() :: NonemptyList.of(CHIChannelRouteSpec)

/* Describe request, response, and data routes between a non-snooping requester and its Home. */
class CHIRNIConnection(node :: CHIRNSite, icn :: CHIRNICNSite):
  implements CHIConnection

  /* Route requester requests to the Home. */
  override method req_routes():
    [CHIChannelRouteSpec(node.req, icn.req)]

  /* Route requester responses to the Home and Home responses back to the requester. */
  override method rsp_routes():
    [CHIChannelRouteSpec(node.rsp_requester, icn.rsp_requester),
     CHIChannelRouteSpec(icn.rsp_response, node.rsp_response)]

  /* Contribute no snoop routes for this non-snooping connection. */
  override method snp_routes(): []

  /* Route requester data to the Home and Home data back to the requester. */
  override method dat_routes():
    [CHIChannelRouteSpec(node.dat_request, icn.dat_request),
     CHIChannelRouteSpec(icn.dat_response, node.dat_response)]

/*
 * Adds the independently routed SNP path required by a fully coherent RN-F.
 */
class CHIRNFConnection(node :: CHIRNSite, icn :: CHIRNICNSite):
  implements CHIConnection

  /* Route requester requests to the Home. */
  override method req_routes():
    [CHIChannelRouteSpec(node.req, icn.req)]

  /* Route requester responses to the Home and Home responses back to the requester. */
  override method rsp_routes():
    [CHIChannelRouteSpec(node.rsp_requester, icn.rsp_requester),
     CHIChannelRouteSpec(icn.rsp_response, node.rsp_response)]

  /* Route Home snoops to the fully coherent requester. */
  override method snp_routes():
    [CHIChannelRouteSpec(icn.snp, node.snp)]

  /* Route requester data to the Home and Home data back to the requester. */
  override method dat_routes():
    [CHIChannelRouteSpec(node.dat_request, icn.dat_request),
     CHIChannelRouteSpec(icn.dat_response, node.dat_response)]

/* Describe request, response, and data routes between a Home and subordinate device. */
class CHISNConnection(icn :: CHISNICNSite, node :: CHISNSite):
  implements CHIConnection

  /* Route Home requests to the subordinate device. */
  override method req_routes():
    [CHIChannelRouteSpec(icn.req, node.req)]

  /* Route subordinate responses back to the Home. */
  override method rsp_routes():
    [CHIChannelRouteSpec(node.rsp_response, icn.rsp_response)]

  /* Contribute no snoop routes for this non-snooping connection. */
  override method snp_routes(): []

  /* Route write data to the subordinate and read data back to the Home. */
  override method dat_routes():
    [CHIChannelRouteSpec(icn.dat_request, node.dat_request),
     CHIChannelRouteSpec(node.dat_response, icn.dat_response)]

/* Select independent generic routing policies for each CHI channel. */
class CHIChannelRouting(req :: RoutingPolicy,
                        rsp :: RoutingPolicy,
                        snp :: RoutingPolicy,
                        dat :: RoutingPolicy)

/*
 * Records the route key derived from generic validation for one CHI path.
 */
class CHICompiledRoute(source :: CHIInjectionSite,
                       destination :: CHIEjectionSite,
                       route_class :: RouteClass,
                       route_key :: Nat):
  opaque
  internal _CHICompiledRoute
  /* Restrict construction to the validated channel compiler. */
  constructor ~none

/*
 * Is the complete pure result for one independently routed CHI channel.
 */
class CHIChannelCompilation(network :: NetworkCompilation,
                            injections :: NonemptyList.of(CHIInjectionSite),
                            ejections :: NonemptyList.of(CHIEjectionSite),
                            routes :: NonemptyList.of(CHICompiledRoute)):
  opaque
  internal _CHIChannelCompilation
  /* Restrict construction to the validated channel compiler. */
  constructor ~none

  /* Resolve an injection identity or reject a terminal absent from this channel. */
  method injection(ref :: InjectionRef) :: CHIInjectionSite:
    def found = injections.find(
      fun (site): injection_ref_equal(site.terminal, ref)
    )
    unless found
    | error(~who: #'CHIChannelCompilation,
            "CHI channel has no injection terminal")
    found

  /* Resolve an ejection identity or reject a terminal absent from this channel. */
  method ejection(ref :: EjectionRef) :: CHIEjectionSite:
    def found = ejections.find(
      fun (site): ejection_ref_equal(site.terminal, ref)
    )
    unless found
    | error(~who: #'CHIChannelCompilation,
            "CHI channel has no ejection terminal")
    found

  /* Return the generic compiled injection-port layout for a terminal. */
  method injection_port(ref :: InjectionRef) :: NetworkInjectionPort:
    network.injection_port(ref)

  /* Return the generic compiled ejection-port layout for a terminal. */
  method ejection_port(ref :: EjectionRef) :: NetworkEjectionPort:
    network.ejection_port(ref)

  /* Return the validated routes originating at an existing injection terminal. */
  method routes_from(ref :: InjectionRef) :: List.of(CHICompiledRoute):
    injection(ref)
    routes.filter(
      ~keep: fun (route): injection_ref_equal(route.source.terminal, ref)
    )

  /* Resolve the unique route for an injection terminal and target NodeID. */
  method route(source :: InjectionRef,
               target_node_id :: Nat) :: CHICompiledRoute:
    def found = routes.find(
      fun (candidate):
        injection_ref_equal(candidate.source.terminal, source) && (
          candidate.destination.node_id == target_node_id
        )
    )
    unless found
    | error(~who: #'CHIChannelCompilation,
            "CHI channel has no route for the injection and target NodeID")
    found

/*
 * Group the independently compiled CHI planes, omitting SNP when no connection contributes
 * snoops.
 */
class CHIChannelCompilations(req :: CHIChannelCompilation,
                             rsp :: CHIChannelCompilation,
                             snp :: maybe(CHIChannelCompilation),
                             dat :: CHIChannelCompilation)

/* Use one generic routing policy for every CHI channel. */
fun uniform_chi_routing(policy :: RoutingPolicy) :: CHIChannelRouting:
  CHIChannelRouting(policy, policy, policy, policy)

/* Concatenate the channel routes selected from each logical connection. */
fun collect_connection_routes(connections :: List.of(CHIConnection),
                              select :: Function.of_arity(1)):
  def mutable routes = []
  for (connection in connections):
    routes := routes ++ select(connection)
  routes

/*
 * Deduplicate and sort injection terminals while rejecting inconsistent NodeID or router
 * assignments.
 */
fun collect_injection_sites(routes :: NonemptyList.of(CHIChannelRouteSpec)):
  def mutable sites = []
  for (route in routes):
    def existing = sites.find(
      fun (site): injection_ref_equal(site.terminal, route.source.terminal)
    )
    when existing && (
      existing.node_id != route.source.node_id || (
        !node_ref_equal(existing.router, route.source.router)
      )
    )
    | error(~who: #'compile_chi_channel,
            "one CHI injection terminal must identify one NodeID and router")
    unless existing
    | sites := sites ++ [route.source]
  sites.sort(
    fun (left, right): injection_ref_less(left.terminal, right.terminal)
  )

/*
 * Deduplicate and sort ejection terminals while rejecting inconsistent NodeID or router
 * assignments.
 */
fun collect_ejection_sites(routes :: NonemptyList.of(CHIChannelRouteSpec)):
  def mutable sites = []
  for (route in routes):
    def existing = sites.find(
      fun (site): ejection_ref_equal(site.terminal, route.destination.terminal)
    )
    when existing && (
      existing.node_id != route.destination.node_id || (
        !node_ref_equal(existing.router, route.destination.router)
      )
    )
    | error(~who: #'compile_chi_channel,
            "one CHI ejection terminal must identify one NodeID and router")
    unless existing
    | sites := sites ++ [route.destination]
  sites.sort(
    fun (left, right): ejection_ref_less(left.terminal, right.terminal)
  )

/* Resolve the CHI source corresponding to a validated generic injection reference. */
fun require_injection_site(sites :: NonemptyList.of(CHIInjectionSite),
                           ref :: InjectionRef):
  def found = sites.find(
    fun (site): injection_ref_equal(site.terminal, ref)
  )
  unless found
  | error(~who: #'compile_chi_channel,
          "validated route has no CHI injection site")
  found

/* Resolve the CHI destination corresponding to a validated generic ejection reference. */
fun require_ejection_site(sites :: NonemptyList.of(CHIEjectionSite),
                          ref :: EjectionRef):
  def found = sites.find(
    fun (site): ejection_ref_equal(site.terminal, ref)
  )
  unless found
  | error(~who: #'compile_chi_channel,
          "validated route has no CHI ejection site")
  found

/* Compare the source terminal and destination NodeID used by hardware route lookup. */
fun same_compiled_route(left :: CHICompiledRoute,
                        right :: CHICompiledRoute):
  injection_ref_equal(left.source.terminal, right.source.terminal) && (
    left.destination.node_id == right.destination.node_id
  )

/* Reject multiple route classes for one injection terminal and target NodeID. */
fun require_unambiguous_routes(routes :: NonemptyList.of(CHICompiledRoute)):
  for (route in routes):
    when routes.filter(
      ~keep: fun (candidate): same_compiled_route(candidate, route)
    ).length() > 1
    | error(~who: #'compile_chi_channel,
            "each CHI injection and target NodeID must select one route class")

/*
 * Validate and lower one channel through the generic NoC compiler, retaining CHI endpoint
 * identities.
 */
fun compile_chi_channel(topology :: TopologySpec,
                        route_specs :: NonemptyList.of(CHIChannelRouteSpec),
                        routing_policy :: RoutingPolicy,
                        ~escape: escape_request :: maybe(EscapeValidationRequest) = #false)
  :: CHIChannelCompilation:
  def injections = collect_injection_sites(route_specs)
  def ejections = collect_ejection_sites(route_specs)
  def terminals = TerminalPlacement(
    injections.map(fun (site): site.terminal_spec()),
    ejections.map(fun (site): site.terminal_spec())
  )
  def routes = route_specs.map(
    fun (route):
      RouteClassSpec(route.ref,
                     route.source.terminal,
                     route.destination.terminal)
  )
  def network = compile_network(topology,
                                terminals,
                                routes,
                                routing_policy,
                                ~escape: escape_request)
  def compiled_routes = network.validated_routing.route_classes.map(
    fun (route_class):
      def route_ref = network.lowered_routes.route_ref(route_class.id)
      def source = require_injection_site(
        injections,
        network.lowered_routes.source_ref(route_ref)
      )
      def destination = require_ejection_site(
        ejections,
        network.lowered_routes.destination_ref(route_ref)
      )
      def source_plan = network.network_plan.router_plan(
        route_class.source.router
      )
      _CHICompiledRoute(source,
                        destination,
                        route_class,
                        source_plan.route_key(route_class))
  )
  require_unambiguous_routes(compiled_routes)
  _CHIChannelCompilation(network, injections, ejections, compiled_routes)

/* Compile each logical connection's REQ, RSP, and DAT routes and create SNP only when needed. */
fun compile_chi_connections(topology :: TopologySpec,
                            connections :: NonemptyList.of(CHIConnection),
                            routing :: CHIChannelRouting)
  :: CHIChannelCompilations:
  def snp_routes = collect_connection_routes(
    connections,
    fun (connection): connection.snp_routes()
  )
  CHIChannelCompilations(
    compile_chi_channel(
      topology,
      collect_connection_routes(connections,
                                fun (connection): connection.req_routes()),
      routing.req
    ),
    compile_chi_channel(
      topology,
      collect_connection_routes(connections,
                                fun (connection): connection.rsp_routes()),
      routing.rsp
    ),
    if snp_routes.length() == 0
    | #false
    | compile_chi_channel(topology, snp_routes, routing.snp),
    compile_chi_channel(
      topology,
      collect_connection_routes(connections,
                                fun (connection): connection.dat_routes()),
      routing.dat
    )
  )
