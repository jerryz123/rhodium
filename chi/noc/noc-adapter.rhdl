  assert(!ingress.valid ||| (expected.valid & (ingress.bits.payload.tgt_id === expected.node_id)),
         "chi_dat_noc_family_ejection_target")

// Keeps typed circuit factories separate from fixed-site flow metadata bookkeeping.
fun chi_noc_transform(make_module :: Function.of_arity(0),
                      kind :: String,
                      properties :: Map):
  fun (source) :~ InterfaceTransformResult(source, Endpoint):
    flow_protocol_type(source)
    inst stage(make_module())
    finish_interface_transform(source, describe_interface_transform(InterfaceHandle(stage.ingress, stage.egress), kind, properties, stage))

// Family stages have an explicit site input and intentionally omit fixed NodeID metadata.
fun chi_noc_family_transform(make_module :: Function.of_arity(0),
                             site_key :: Bits,
                             kind :: String):
  fun (source) :~ InterfaceTransformResult(source, Endpoint):
    flow_protocol_type(source)
    inst stage(make_module())
    stage.site_key <== site_key
    finish_interface_transform(source, describe_interface_transform(InterfaceHandle(stage.ingress, stage.egress), kind, {}, stage))

fun chi_req_noc_inject(config :: CHINoCInjectionConfig):
  chi_noc_transform(fun (): CHIReqNoCInjector(config), "chi-req-noc-inject", {"node-id": config.site.node_id})

fun chi_req_noc_eject(config :: CHINoCEjectionConfig):
  chi_noc_transform(fun (): CHIReqNoCEjector(config), "chi-req-noc-eject", {"node-id": config.site.node_id})

fun chi_rsp_noc_inject(config :: CHINoCInjectionConfig):
  chi_noc_transform(fun (): CHIRspNoCInjector(config), "chi-rsp-noc-inject", {"node-id": config.site.node_id})

fun chi_rsp_noc_eject(config :: CHINoCEjectionConfig):
