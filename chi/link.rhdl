#lang rhodium
// Defines CHI node roles, capabilities, credited links, and connection legality.

import:
  rhombus/meta open
  lib("support/annotations.rhm") open
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/credited.rhdl") open
  lib("chi/params.rhdl") open
  lib("chi/flits.rhdl") open
  lib("chi/coherence.rhdl").chi_rnf_snoop_opcodes

enum CHINodeKind
| RNF
| RND
| RNI
| HNF
| HNI
| SNF
| SNI

fun CHINodeKind.is_subordinate(kind :: CHINodeKind):
  [CHINodeKind.SNF, CHINodeKind.SNI].contains(kind)

fun CHINodeKind.is_home(kind :: CHINodeKind):
  [CHINodeKind.HNF, CHINodeKind.HNI].contains(kind)

class CHIChannelCapabilities(~req: req :: List.of(CHIReqOpcode) = [],
                             ~rsp: rsp :: List.of(CHIRspOpcode) = [],
                             ~snp: snp :: List.of(CHISnpOpcode) = [],
                             ~dat: dat :: List.of(CHIDatOpcode) = []):

  method contains_all(contained :: CHIChannelCapabilities):
    for all (pair in [[req, contained.req],
                      [rsp, contained.rsp],
                      [snp, contained.snp],
                      [dat, contained.dat]]):
      for all (opcode in pair[1]):
        pair[0].contains(opcode)

  method uses_only(~req: req :: Boolean,
                   ~rsp: rsp :: Boolean,
                   ~snp: snp :: Boolean,
                   ~dat: dat :: Boolean):
    for all (condition in [(req || this.req.length() == 0),
                           (rsp || this.rsp.length() == 0),
                           (snp || this.snp.length() == 0),
                           (dat || this.dat.length() == 0)]):
      condition

  method is_dvm_snoop_only():
    def dvm_opcode :: HardwareLiteral = CHISnpOpcode.SnpDVMOp
    for all (opcode in snp):
      def opcode_literal :: HardwareLiteral = opcode
      opcode_literal.packed_value() == dvm_opcode.packed_value()

fun validate_endpoint_capabilities(kind :: CHINodeKind,
                                   emits :: CHIChannelCapabilities,
                                   supports :: CHIChannelCapabilities,
                                   side :: String,
                                   who :: Symbol):
  def legal:
    cond
    | side == "node" && [CHINodeKind.RNF, CHINodeKind.RND].contains(kind):
        for all (condition in [
          emits.uses_only(~req: #true, ~rsp: #true, ~snp: #false, ~dat: #true),
          supports.uses_only(~req: #false, ~rsp: #true, ~snp: #true, ~dat: #true),
          (kind != CHINodeKind.RND || supports.is_dvm_snoop_only()),
          (kind != CHINodeKind.RNF || supports.contains_all(
            CHIChannelCapabilities(~snp: chi_rnf_snoop_opcodes)
          ))
        ]):
          condition
    | side == "icn" && [CHINodeKind.RNF, CHINodeKind.RND].contains(kind):
        for all (condition in [
          emits.uses_only(~req: #false, ~rsp: #true, ~snp: #true, ~dat: #true),
          supports.uses_only(~req: #true, ~rsp: #true, ~snp: #false, ~dat: #true),
          (kind != CHINodeKind.RND || emits.is_dvm_snoop_only()),
          (kind != CHINodeKind.RNF || emits.contains_all(
            CHIChannelCapabilities(~snp: chi_rnf_snoop_opcodes)
          ))
        ]):
          condition
    | side == "node" && kind == CHINodeKind.RNI:
        for all (condition in [
          emits.uses_only(~req: #true, ~rsp: #true, ~snp: #false, ~dat: #true),
          supports.uses_only(~req: #false, ~rsp: #true, ~snp: #false, ~dat: #true)
        ]):
          condition
    | side == "icn" && kind == CHINodeKind.RNI:
        for all (condition in [
          emits.uses_only(~req: #false, ~rsp: #true, ~snp: #false, ~dat: #true),
          supports.uses_only(~req: #true, ~rsp: #true, ~snp: #false, ~dat: #true)
        ]):
          condition
    | side == "node" && CHINodeKind.is_subordinate(kind):
        for all (condition in [
          emits.uses_only(~req: #false, ~rsp: #true, ~snp: #false, ~dat: #true),
          supports.uses_only(~req: #true, ~rsp: #false, ~snp: #false, ~dat: #true)
        ]):
          condition
    | side == "icn" && CHINodeKind.is_subordinate(kind):
        for all (condition in [
          emits.uses_only(~req: #true, ~rsp: #false, ~snp: #false, ~dat: #true),
          supports.uses_only(~req: #false, ~rsp: #true, ~snp: #false, ~dat: #true)
        ]):
          condition
    | ~else: #false
  unless legal
  | error(~who: who,
          "channel capabilities are not valid for the " ++ to_string(kind) ++ " " ++ side ++ " role")

class CHINodeParams(name :: NonemptyString, node_id :: Nat, kind :: CHINodeKind,
                    emits :: CHIChannelCapabilities, supports :: CHIChannelCapabilities,
                    max_outstanding :: Int.in(1 ..= 1024)):
  implements StableCircuitParam

  constructor (name :: NonemptyString,
               node_id :: Nat,
               kind :: CHINodeKind,
               ~emits: emits :: CHIChannelCapabilities,
               ~supports: supports :: CHIChannelCapabilities,
               ~max_outstanding: max_outstanding :: Int.in(1 ..= 1024)):
    validate_endpoint_capabilities(kind, emits, supports, "node", #'CHINodeParams)
    super(name, node_id, kind, emits, supports, max_outstanding)

class CHIICNPortParams(name :: NonemptyString, node_id :: Nat, kind :: CHINodeKind,
                       emits :: CHIChannelCapabilities, supports :: CHIChannelCapabilities,
                       max_outstanding :: Int.in(1 ..= 1024)):
  implements StableCircuitParam

  constructor (name :: NonemptyString,
               node_id :: Nat,
               kind :: CHINodeKind,
               ~emits: emits :: CHIChannelCapabilities,
               ~supports: supports :: CHIChannelCapabilities,
               ~max_outstanding: max_outstanding :: Int.in(1 ..= 1024)):
    validate_endpoint_capabilities(kind, emits, supports, "icn", #'CHIICNPortParams)
    super(name, node_id, kind, emits, supports, max_outstanding)

// A Home sees only the traffic negotiated for its address space. The parent
// remains the complete ICN endpoint, including an RN-F's mandatory snoop plane.
class CHIRequesterHomeParams(endpoint :: CHIICNPortParams,
                             emits :: CHIChannelCapabilities,
                             supports :: CHIChannelCapabilities):
  implements StableCircuitParam

  property name: endpoint.name
  property node_id: endpoint.node_id
  property kind: endpoint.kind
  property max_outstanding: endpoint.max_outstanding

  constructor (endpoint :: CHIICNPortParams,
               ~emits: emits :: CHIChannelCapabilities,
               ~supports: supports :: CHIChannelCapabilities):
    unless [CHINodeKind.RNI, CHINodeKind.RNF].contains(endpoint.kind)
    | error(~who: #'CHIRequesterHomeParams, "Home traffic must describe a requester")
    unless endpoint.emits.contains_all(emits) && endpoint.supports.contains_all(supports)
    | error(~who: #'CHIRequesterHomeParams, "Home traffic must be a subset of endpoint capabilities")
    super(endpoint, emits, supports)

annot.macro 'CHIHomeRequesterParams':
  'CHIICNPortParams || CHIRequesterHomeParams'

class CHIRNLinkParams(flit :: CHIFlitParams,
                      ~tx_req_credits: tx_req_credits :: PosInt = 2,
                      ~tx_rsp_credits: tx_rsp_credits :: PosInt = 2,
                      ~tx_dat_credits: tx_dat_credits :: PosInt = 2,
                      ~rx_rsp_credits: rx_rsp_credits :: PosInt = 2,
                      ~rx_dat_credits: rx_dat_credits :: PosInt = 2,
                      ~rx_snp_credits: rx_snp_credits :: PosInt = 2):
  implements StableCircuitParam

class CHIRNILinkParams(flit :: CHIFlitParams,
                       ~tx_req_credits: tx_req_credits :: PosInt = 2,
                       ~tx_rsp_credits: tx_rsp_credits :: PosInt = 2,
                       ~tx_dat_credits: tx_dat_credits :: PosInt = 2,
                       ~rx_rsp_credits: rx_rsp_credits :: PosInt = 2,
                       ~rx_dat_credits: rx_dat_credits :: PosInt = 2):
  implements StableCircuitParam

class CHISNLinkParams(flit :: CHIFlitParams,
                      ~tx_rsp_credits: tx_rsp_credits :: PosInt = 2,
                      ~tx_dat_credits: tx_dat_credits :: PosInt = 2,
                      ~rx_req_credits: rx_req_credits :: PosInt = 2,
                      ~rx_dat_credits: rx_dat_credits :: PosInt = 2):
  implements StableCircuitParam

annot.macro 'CHIEndpointParams':
  'CHINodeParams || CHIICNPortParams'

fun endpoint_pair_legal(node :: CHINodeParams,
                        icn :: CHIICNPortParams,
                        flit :: CHIFlitParams,
                        kinds :: List.of(CHINodeKind)):
  node is_a CHINodeParams && icn is_a CHIICNPortParams && for all (condition in [
    kinds.contains(node.kind),
    node.kind == icn.kind,
    node.node_id == icn.node_id,
    node.max_outstanding == icn.max_outstanding,
    bits.length(node.node_id) <= flit.node_id_width,
    icn.supports.contains_all(node.emits),
    node.supports.contains_all(icn.emits)
  ]):
    condition

fun rn_connection_legal(provided :: List, required :: List):
  if provided.length() == 2 && required.length() == 2 && provided[0] is_a CHIRNLinkParams && required[0] is_a CHIRNLinkParams
  | block:
      def node_link = provided[0]
      def icn_link = required[0]
      for all (condition in [
        node_link.flit == icn_link.flit,
        endpoint_pair_legal(provided[1], required[1], node_link.flit, [CHINodeKind.RNF, CHINodeKind.RND]),
        for all (pair in [[node_link.tx_req_credits, icn_link.tx_req_credits],
                          [node_link.tx_rsp_credits, icn_link.tx_rsp_credits],
                          [node_link.tx_dat_credits, icn_link.tx_dat_credits],
                          [node_link.rx_rsp_credits, icn_link.rx_rsp_credits],
                          [node_link.rx_dat_credits, icn_link.rx_dat_credits],
                          [node_link.rx_snp_credits, icn_link.rx_snp_credits]]):
          pair[0] == pair[1]
      ]):
        condition
  | #false

fun rni_connection_legal(provided :: List, required :: List):
  if provided.length() == 2 && required.length() == 2 && provided[0] is_a CHIRNILinkParams && required[0] is_a CHIRNILinkParams
  | block:
      def node_link = provided[0]
      def icn_link = required[0]
      for all (condition in [
        node_link.flit == icn_link.flit,
        endpoint_pair_legal(provided[1], required[1], node_link.flit, [CHINodeKind.RNI]),
        for all (pair in [[node_link.tx_req_credits, icn_link.tx_req_credits],
                          [node_link.tx_rsp_credits, icn_link.tx_rsp_credits],
                          [node_link.tx_dat_credits, icn_link.tx_dat_credits],
                          [node_link.rx_rsp_credits, icn_link.rx_rsp_credits],
                          [node_link.rx_dat_credits, icn_link.rx_dat_credits]]):
          pair[0] == pair[1]
      ]):
        condition
  | #false

fun sn_connection_legal(provided :: List, required :: List):
  if provided.length() == 2 && required.length() == 2 && provided[0] is_a CHISNLinkParams && required[0] is_a CHISNLinkParams
  | block:
      def node_link = provided[0]
      def icn_link = required[0]
      for all (condition in [
        node_link.flit == icn_link.flit,
        endpoint_pair_legal(provided[1], required[1], node_link.flit, [CHINodeKind.SNF, CHINodeKind.SNI]),
        for all (pair in [[node_link.tx_rsp_credits, icn_link.tx_rsp_credits],
                          [node_link.tx_dat_credits, icn_link.tx_dat_credits],
                          [node_link.rx_req_credits, icn_link.rx_req_credits],
                          [node_link.rx_dat_credits, icn_link.rx_dat_credits]]):
          pair[0] == pair[1]
      ]):
        condition
  | #false

fun checked_rn_endpoint(endpoint :: CHINodeParams || CHIICNPortParams)
  :: Boolean:
  unless [CHINodeKind.RNF, CHINodeKind.RND].contains(endpoint.kind)
  | error(~who: #'CHIRNLink, "endpoint kind must be RN-F or RN-D")
  #true

fun checked_rni_endpoint(endpoint :: CHINodeParams || CHIICNPortParams)
  :: Boolean:
  unless endpoint.kind == CHINodeKind.RNI
  | error(~who: #'CHIRNILink, "endpoint kind must be RN-I")
  #true

fun checked_sn_endpoint(endpoint :: CHINodeParams || CHIICNPortParams)
  :: Boolean:
  unless CHINodeKind.is_subordinate(endpoint.kind)
  | error(~who: #'CHISNLink, "endpoint kind must be SN-F or SN-I")
  #true

interface CHIRNLink(link :: CHIRNLinkParams,
                    endpoint :: satisfying(checked_rn_endpoint)):
  role node
  role icn
  provider node
  connection_compatible node (provided, required):
    rn_connection_legal(provided, required)

  node -> icn:
    tx_link_active_request: Bool
    rx_link_active_ack: Bool
    tx_req: Credited(CHIReqFlit(link.flit), link.tx_req_credits)
    tx_rsp: Credited(CHIRspFlit(link.flit), link.tx_rsp_credits)
    tx_dat: Credited(CHIDatFlit(link.flit), link.tx_dat_credits)

  icn -> node:
    tx_link_active_ack: Bool
    rx_link_active_request: Bool
    rx_rsp: Credited(CHIRspFlit(link.flit), link.rx_rsp_credits)
    rx_dat: Credited(CHIDatFlit(link.flit), link.rx_dat_credits)
    rx_snp: Credited(CHISnpFlit(link.flit), link.rx_snp_credits)

interface CHIRNILink(link :: CHIRNILinkParams,
                     endpoint :: satisfying(checked_rni_endpoint)):
  role node
  role icn
  provider node
  connection_compatible node (provided, required):
    rni_connection_legal(provided, required)

  node -> icn:
    tx_link_active_request: Bool
    rx_link_active_ack: Bool
    tx_req: Credited(CHIReqFlit(link.flit), link.tx_req_credits)
    tx_rsp: Credited(CHIRspFlit(link.flit), link.tx_rsp_credits)
    tx_dat: Credited(CHIDatFlit(link.flit), link.tx_dat_credits)

  icn -> node:
    tx_link_active_ack: Bool
    rx_link_active_request: Bool
    rx_rsp: Credited(CHIRspFlit(link.flit), link.rx_rsp_credits)
    rx_dat: Credited(CHIDatFlit(link.flit), link.rx_dat_credits)

interface CHISNLink(link :: CHISNLinkParams,
                    endpoint :: satisfying(checked_sn_endpoint)):
  role node
  role icn
  provider node
  connection_compatible node (provided, required):
    sn_connection_legal(provided, required)

  node -> icn:
    tx_link_active_request: Bool
    rx_link_active_ack: Bool
    tx_rsp: Credited(CHIRspFlit(link.flit), link.tx_rsp_credits)
    tx_dat: Credited(CHIDatFlit(link.flit), link.tx_dat_credits)

  icn -> node:
    tx_link_active_ack: Bool
    rx_link_active_request: Bool
    rx_req: Credited(CHIReqFlit(link.flit), link.rx_req_credits)
    rx_dat: Credited(CHIDatFlit(link.flit), link.rx_dat_credits)


export:
  CHINodeKind
  CHIEndpointParams
  CHIChannelCapabilities
  CHINodeParams
  CHIICNPortParams
  CHIRequesterHomeParams
  CHIHomeRequesterParams
  CHIRNLinkParams
  CHIRNILinkParams
  CHISNLinkParams
  CHIRNLink
  CHIRNILink
  CHISNLink
