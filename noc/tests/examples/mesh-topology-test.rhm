#lang rhombus
// Checks that a concrete topology instance depends only on public authoring and standard APIs.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../examples/mesh-topology.rhm" open

check:
  example_mesh.spec.nodes.length() ~is 4
  example_mesh.spec.links.length() ~is 8
  example_topology.topology.virtual_channels().length() ~is 24
