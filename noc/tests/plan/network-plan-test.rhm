#lang rhombus
// Checks deterministic whole-network port and VC wiring projected from validated routing.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../model/main.rhm" open
  "../../plan/main.rhm" open

def n0 = NodeId(0)
def n1 = NodeId(1)
def n2 = NodeId(2)
def n3 = NodeId(3)
def first = PhysicalLink(LinkId(0), n0, n1, 2)
def second = PhysicalLink(LinkId(1), n1, n2, 2)
def topology = Topology([n3, n2, n0, n1], [second, first])
def transit_route = RouteClass(RouteClassId(0), n0, n2)
def local_route = RouteClass(RouteClassId(1), n1, n1)

fun on_link(vc, link):
  link_id_equal(vc.link_id, link.id)

fun allows(route_class, origin, candidate):
  cond
  | route_class === local_route: #false
  | origin is_a Injection:
      on_link(candidate, first)
  | origin is_a HeldVC:
      on_link(origin.vc, first) && on_link(candidate, second) && (
        origin.vc.index == candidate.index
      )
  | ~else: #false

def routing = compile_routing(
  RoutingProblem(
    topology,
    [local_route, transit_route],
    RoutingRelation(allows)
  )
)
def network = NetworkPlan(routing)

check:
  network.validated_routing === routing ~is #true
  network.router_plans.map(fun (router): router.node.describe()) ~is [
    "n0", "n1", "n2", "n3"
  ]
  network.router_plans.map(fun (router): router.injection_terminals.length()) ~is [
    1, 1, 0, 0
  ]
  network.router_plans.map(fun (router): router.ejection_terminals.length()) ~is [
    0, 1, 1, 0
  ]
  network.describe() ~is "network plan: routers=4, injections=2, ejections=2, vcs=4"

check:
  network.injection_ports.map(fun (port): port.describe()) ~is [
    "inject i0@n0 -> router[0].input[0]",
    "inject i1@n1 -> router[1].input[0]"
  ]
  network.ejection_ports.map(fun (port): port.describe()) ~is [
    "eject e1@n1 <- router[1].target[2]",
    "eject e2@n2 <- router[2].target[0]"
  ]
  network.injection_port(InjectionId(1)) === network.injection_ports[1] ~is #true
  network.ejection_port(EjectionId(2)) === network.ejection_ports[1] ~is #true

check:
  network.vc_connections.map(fun (connection): connection.describe()) ~is [
    "l0.vc0: router[0].target[0] -> router[1].input[1]",
    "l0.vc1: router[0].target[1] -> router[1].input[2]",
    "l1.vc0: router[1].target[0] -> router[2].input[0]",
    "l1.vc1: router[1].target[1] -> router[2].input[1]"
  ]
  network.link_connections.map(fun (connection): connection.describe()) ~is [
    "l0: router[0].targets[0, 1] -> router[1].inputs[1, 2]",
    "l1: router[1].targets[0, 1] -> router[2].inputs[0, 1]"
  ]
  network.link_connection(first.id).source_target_indices ~is [0, 1]
  network.link_connection(first.id).destination_input_indices ~is [1, 2]
  network.vc_connection(VCId(first.id, 1)) === (
    network.vc_connections[1]
  ) ~is #true
  network.router_plan(n2) === network.router_plans[2] ~is #true

check:
  NetworkPlan("not validated") ~throws "ValidatedRouting"
  network.router_plan("n0") ~throws "NodeId"
  network.router_plan(NodeId(99)) ~throws "unknown network-plan node"
  network.injection_port(InjectionId(2)) ~throws "unknown external injection terminal"
  network.ejection_port(EjectionId(0)) ~throws "unknown external ejection terminal"
  network.vc_connection("vc") ~throws "VCId"
  network.vc_connection(VCId(LinkId(99), 0)) ~throws "unknown network-plan VC"
  network.link_connection(LinkId(99)) ~throws "unknown network-plan link"

// A linkless one-router network is a generalized crossbar: every terminal is
// independently indexed even when all terminal attachments share one router.
def crossbar_node = NodeId(10)
def crossbar_injections = for List (index in 0..3):
  InjectionTerminal(InjectionId(index), crossbar_node)
def crossbar_ejections = for List (index in 0..3):
  EjectionTerminal(EjectionId(index), crossbar_node)
def mutable crossbar_routes = []
for (source in crossbar_injections):
  for (destination in crossbar_ejections):
    crossbar_routes := crossbar_routes ++ [
      RouteClass(RouteClassId(crossbar_routes.length()), source, destination)
    ]
def crossbar_routing = compile_routing(
  RoutingProblem(
    Topology([crossbar_node], []),
    crossbar_routes,
    RoutingRelation(fun (_route, _origin, _candidate): #false)
  )
)
def crossbar_network = NetworkPlan(crossbar_routing)
def crossbar_router = crossbar_network.router_plan(crossbar_node)

check:
  crossbar_routing.dependency_graph.vertices ~is []
  crossbar_router.origins.map(fun (origin): origin.describe()) ~is [
    "inject(i0@n10)", "inject(i1@n10)", "inject(i2@n10)"
  ]
  crossbar_router.targets.map(fun (target): target.describe()) ~is [
    "e0@n10", "e1@n10", "e2@n10"
  ]
  crossbar_router.rows.map(fun (row): row.target_mask) ~is [
    0b001, 0b010, 0b100,
    0b001, 0b010, 0b100,
    0b001, 0b010, 0b100
  ]
  crossbar_network.injection_ports.map(fun (port): port.input_index) ~is [0, 1, 2]
  crossbar_network.ejection_ports.map(fun (port): port.target_index) ~is [0, 1, 2]
  crossbar_network.vc_connections ~is []
  crossbar_network.link_connections ~is []
