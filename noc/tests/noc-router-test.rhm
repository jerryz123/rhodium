#lang rhombus
// Checks compiled simple-router configuration, structure, and proof boundaries.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../../rhodium/frontend/kernel.rhm" as embedded
  "../../noc/rtl/main.rhdl" open
  "../../noc/model/main.rhm" open
  "../../noc/analysis/main.rhm" open
  "../../noc/plan/main.rhm" open
  "../../examples/noc/noc-router.rhdl" as fixture

def middle = fixture.middle_config
def destination = fixture.destination_config
def buffered_middle = compile_simple_router(fixture.middle_plan, ~input_buffer_depth: 3)
def top = fixture.design.modules.find(
  fun (module_def): module_def.name == "SimpleRouterFixture"
)
def router_modules = fixture.design.modules.filter(
  ~keep: fun (module_def): module_def.name.starts_with("SimpleRouter") && (
    module_def.name != "SimpleRouterFixture"
  )
)
def allocator_design = embedded.run_elaboration(
  fun (): RouterAllocator(2, 2)
)
def escape_n0 = NodeId(10)
def escape_n1 = NodeId(11)
def adaptive_loop = PhysicalLink(LinkId(10), escape_n0, escape_n0, 1)
def escape_link = PhysicalLink(LinkId(11), escape_n0, escape_n1, 1)
def escape_topology = Topology(
  [escape_n0, escape_n1],
  [adaptive_loop, escape_link]
)
def escape_route = RouteClass(RouteClassId(10), escape_n0, escape_n1)
fun escape_allows(_route_class, origin, candidate):
  cond
  | origin is_a Injection:
      link_id_equal(candidate.link_id, adaptive_loop.id) || link_id_equal(candidate.link_id, escape_link.id)
  | origin is_a HeldVC && link_id_equal(origin.vc.link_id, adaptive_loop.id):
      link_id_equal(candidate.link_id, adaptive_loop.id) || link_id_equal(candidate.link_id, escape_link.id)
  | ~else: #false
def escape_routing = compile_routing(
  RoutingProblem(
    escape_topology,
    [escape_route],
    RoutingRelation(escape_allows)
  ),
  ~escape: EscapeValidationRequest(
    escape_topology,
    [VCId(escape_link.id, 0)]
  )
)
unless escape_routing is_a ValidatedRouting
| error(~who: #'noc_router_test,
        "small adaptive routing must pass escape validation")
def escape_plan = RouterPlan(
  escape_routing,
  escape_n0
)
def escape_config = compile_simple_router(escape_plan)
def escape_wormhole_config = compile_wormhole_router(escape_plan)

fun assertion_labels(module_def):
  module_def.operations.filter(
    ~keep: fun (operation): operation.opcode == "verif.assert"
  ).map(fun (operation): operation.attribute("label"))

check:
  middle.router_plan === fixture.middle_plan ~is #true
  middle.route_decoder.router_plan === fixture.middle_plan ~is #true
  middle.input_count ~is 2
  middle.target_count ~is 2
  middle.input_buffer_depth ~is 1
  buffered_middle.input_buffer_depth ~is 3
  middle.router_plan.target_bit(VCId(fixture.second.id, 1)) ~is 1

check:
  destination.router_plan === fixture.destination_plan ~is #true
  destination.input_count ~is 2
  destination.target_count ~is 1
  destination.input_buffer_depth ~is 1

check:
  compile_simple_router("not a plan") ~throws "RouterPlan"
  compile_simple_router(fixture.middle_plan, ~input_buffer_depth: 0) ~throws "PosInt"
  escape_config.router_plan === escape_plan ~is #true
  escape_wormhole_config.router_plan === escape_plan ~is #true
  escape_plan.rows.find(
    fun (row): row.target_mask != row.fallback_mask
  ) != #false ~is #true
  (for all (row in escape_plan.rows):
     row.fallback_mask != 0 && (
       (row.fallback_mask bits.and row.target_mask) == row.fallback_mask
     )) ~is #true

check:
  top != #false ~is #true
  top.inputs.map(fun (port): port.name) ~is [
    "clock", "reset",
    "middle_ingress_0_in", "middle_ingress_1_in",
    "middle_egress_0_in", "middle_egress_1_in",
    "destination_ingress_0_in", "destination_ingress_1_in",
    "destination_egress_0_in"
  ]
  top.outputs.map(fun (port): port.name) ~is [
    "middle_ingress_0_out", "middle_ingress_1_out",
    "middle_egress_0_out", "middle_egress_1_out",
    "destination_ingress_0_out", "destination_ingress_1_out",
    "destination_egress_0_out"
  ]
  router_modules.length() ~is 2
  router_modules.map(
    fun (module_def):
      module_def.operations.filter(
        ~keep: fun (operation): operation.opcode.starts_with("rtl.register")
      ).length()
  ) ~is [0, 0]
  router_modules.map(
    fun (module_def):
      module_def.operations.filter(
        ~keep: fun (operation): operation.opcode == "rtl.instance"
      ).length()
  ) ~is [4, 4]
  router_modules.map(assertion_labels) ~is [
    ["simple_router_ingress_valid_route_0",
     "simple_router_ingress_valid_route_1"],
    ["simple_router_ingress_valid_route_0",
     "simple_router_ingress_valid_route_1"]
  ]
  verify_design(allocator_design) ~is #void
  verify_design(fixture.design) ~is #void
