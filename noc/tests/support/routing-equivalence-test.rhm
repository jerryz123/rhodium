#lang rhombus
// Checks semantic snapshots for cycle witnesses and escape-certified routing results.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../model/main.rhm" open
  "../../analysis/main.rhm" open
  "routing-equivalence.rhm" open

fun candidate_uses(candidate_vc, link):
  link_id_equal(candidate_vc.link_id, link.id)

fun origin_holds(origin, link, index = 0):
  origin is_a HeldVC && vc_id_equal(origin.vc, VCId(link.id, index))

// Each route is individually acyclic, but their dependency union is A -> B -> A.
def cycle_x = NodeId(0)
def cycle_y = NodeId(1)
def cycle_z = NodeId(2)
def cycle_w = NodeId(3)
def cycle_a = PhysicalLink(LinkId(0), cycle_x, cycle_y, 1)
def cycle_b = PhysicalLink(LinkId(1), cycle_y, cycle_x, 1)
def cycle_c = PhysicalLink(LinkId(2), cycle_x, cycle_z, 1)
def cycle_d = PhysicalLink(LinkId(3), cycle_y, cycle_w, 1)
def cycle_topology = Topology(
  [cycle_x, cycle_y, cycle_z, cycle_w],
  [cycle_a, cycle_b, cycle_c, cycle_d]
)
def cycle_route0 = RouteClass(RouteClassId(0), cycle_x, cycle_z)
def cycle_route1 = RouteClass(RouteClassId(1), cycle_y, cycle_w)

fun cycle_allows(route_class, origin, candidate_vc):
  cond
  | route_class === cycle_route0:
      cond
      | origin is_a Injection: candidate_uses(candidate_vc, cycle_a)
      | origin_holds(origin, cycle_a): candidate_uses(candidate_vc, cycle_b)
      | origin_holds(origin, cycle_b): candidate_uses(candidate_vc, cycle_c)
      | ~else: #false
  | route_class === cycle_route1:
      cond
      | origin is_a Injection: candidate_uses(candidate_vc, cycle_b)
      | origin_holds(origin, cycle_b): candidate_uses(candidate_vc, cycle_a)
      | origin_holds(origin, cycle_a): candidate_uses(candidate_vc, cycle_d)
      | ~else: #false
  | ~else: #false

def cycle_semantics = snapshot_routing(
  RoutingProblem(
    cycle_topology,
    [cycle_route0, cycle_route1],
    RoutingRelation(cycle_allows)
  )
)

check:
  cycle_semantics.result_kind ~is "dependency-cycle"
  cycle_semantics.proof[0] ~is "cycle"
  cycle_semantics.proof.length() ~is 3
  cycle_semantics.route_table_rows ~is []
  cycle_semantics.assumptions ~is "none"
  cycle_semantics.validator_version ~is "none"

// A cyclic adaptive choice remains in the full relation while the second VC
// on each link forms a closed, acyclic escape subnetwork.
def escape_n0 = NodeId(0)
def escape_n1 = NodeId(1)
def escape_n2 = NodeId(2)
def escape_first = PhysicalLink(LinkId(0), escape_n0, escape_n1, 2)
def escape_second = PhysicalLink(LinkId(1), escape_n1, escape_n2, 2)
def escape_back = PhysicalLink(LinkId(2), escape_n1, escape_n0, 2)
def escape_topology = Topology(
  [escape_n0, escape_n1, escape_n2],
  [escape_first, escape_second, escape_back]
)
def escape_route = RouteClass(
  RouteClassId(0),
  escape_n0,
  escape_n2
)

fun candidate_is(candidate_vc, link, index):
  vc_id_equal(candidate_vc, VCId(link.id, index))

fun escape_allows(_route_class, origin, candidate_vc):
  cond
  | origin is_a Injection:
      candidate_is(candidate_vc, escape_first, 0) || candidate_is(
        candidate_vc,
        escape_first,
        1
      )
  | origin_holds(origin, escape_first, 0):
      candidate_is(candidate_vc, escape_second, 0) || candidate_is(
        candidate_vc,
        escape_second,
        1
      )
  | origin_holds(origin, escape_first, 1):
      candidate_is(candidate_vc, escape_second, 1)
  | ~else: #false

def escape_request = EscapeValidationRequest(
  escape_topology,
  [VCId(escape_first.id, 1),
   VCId(escape_second.id, 1),
   VCId(escape_back.id, 1)]
)
def escape_semantics = snapshot_routing(
  RoutingProblem(
    escape_topology,
    [escape_route],
    RoutingRelation(escape_allows)
  ),
  ~escape: escape_request
)

check:
  escape_semantics.result_kind ~is "validated-escape"
  escape_semantics.proof[0] ~is "escape"
  escape_semantics.proof.find(
    fun (row): row == "escape-vcs=[l0.vc1, l1.vc1, l2.vc1]"
  ) != #false ~is #true
  escape_semantics.route_table_rows.length() ~is 5
  escape_semantics.validator_version ~is "vc-escape-subnetwork/v1"
  escape_semantics.assumptions.contains(
    "reachable escape VC dependency subgraph is acyclic"
  ) ~is #true
