#lang rhombus
// Checks inspectable routing-policy composition, symbolic lowering, and invalid references.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../model/main.rhm" open
  "../../analysis/main.rhm" open
  "../../plan/main.rhm" open
  "../../authoring/main.rhm" open

def source = NodeRef("source")
def middle = NodeRef("middle")
def alternate = NodeRef("alternate")
def destination = NodeRef("destination")

def source_middle = LinkRef(["source", "middle"])
def source_alternate = LinkRef(["source", "alternate"])
def middle_destination = LinkRef(["middle", "destination"])
def alternate_destination = LinkRef(["alternate", "destination"])

def escape = VCGroup("escape", 1)
def adaptive = VCGroup("adaptive", 1)
def topology_spec = TopologySpec(
  [destination, alternate, middle, source],
  [directed_link(source_middle,
                 source,
                 middle,
                 [escape, adaptive]),
   directed_link(source_alternate,
                 source,
                 alternate,
                 [escape]),
   directed_link(middle_destination,
                 middle,
                 destination,
                 [escape, adaptive]),
   directed_link(alternate_destination,
                 alternate,
                 destination,
                 [escape])]
)
def lowered_topology = lower_topology(with_router_terminals(topology_spec))

def selected_ref = RouteClassRef(["traffic", "selected"])
def other_ref = RouteClassRef(["traffic", "other"])
def selected_spec = RouteClassSpec(selected_ref, source, destination)
def other_spec = RouteClassSpec(other_ref, source, middle)
def lowered_routes = lower_route_classes(
  lowered_topology,
  [selected_spec, other_spec]
)

def injection_branch = policy_intersection(
  [injection_policy,
   select_candidate_links([source_middle]),
   restrict_vc_groups(["adaptive"])]
)
def forwarding_branch = policy_intersection(
  [forwarding_policy, restrict_vc_groups(["escape"])]
)
def selected_policy = policy_intersection(
  [match_route_classes([selected_ref]),
   policy_union([forwarding_branch, injection_branch])]
)
def relation = lower_routing_policy(lowered_routes, selected_policy)
def selected = lowered_routes.route_class(selected_ref)
def other = lowered_routes.route_class(other_ref)

def source_id = lowered_topology.node_id(source)
def source_middle_adaptive = lowered_topology.vc_id(
  VCRef(source_middle, "adaptive", 0)
)
def source_middle_escape = lowered_topology.vc_id(
  VCRef(source_middle, "escape", 0)
)
def source_alternate_escape = lowered_topology.vc_id(
  VCRef(source_alternate, "escape", 0)
)
def middle_destination_adaptive = lowered_topology.vc_id(
  VCRef(middle_destination, "adaptive", 0)
)
def middle_destination_escape = lowered_topology.vc_id(
  VCRef(middle_destination, "escape", 0)
)

check:
  allow_all.describe() ~is "allow-all"
  deny_all.describe() ~is "deny-all"
  match_route_classes([selected_ref]).describe() ~is "route-class(traffic/selected)"
  select_candidate_links([source_middle]).describe() ~is "candidate-link(source/middle)"
  restrict_vc_groups(["escape", "adaptive"]).describe() ~is "candidate-vc-group(adaptive, escape)"
  policy_union([injection_policy, forwarding_policy]).describe() ~is policy_union([forwarding_policy, injection_policy]).describe()
  selected_policy is_a RoutingPolicy ~is #true
  selected_policy is_a IntersectionPolicy ~is #true

check:
  relation.allow(
    selected,
    Injection(source_id),
    source_middle_adaptive
  ) ~is #true
  relation.allow(
    selected,
    Injection(source_id),
    source_middle_escape
  ) ~is #false
  relation.allow(
    selected,
    Injection(source_id),
    source_alternate_escape
  ) ~is #false
  relation.allow(
    selected,
    HeldVC(source_middle_adaptive),
    middle_destination_escape
  ) ~is #true
  relation.allow(
    selected,
    HeldVC(source_middle_escape),
    middle_destination_adaptive
  ) ~is #false
  relation.allow(
    other,
    Injection(source_id),
    source_middle_adaptive
  ) ~is #false

def problem = RoutingProblem(
  lowered_topology.topology,
  lowered_routes.route_classes,
  relation
)
def materialized = materialize_routing(problem)

check:
  materialized.allowed_candidates(
    selected,
    Injection(source_id)
  ).map(fun (vc): vc.describe()) ~is [source_middle_adaptive.describe()]
  materialized.allowed_candidates(
    selected,
    HeldVC(source_middle_adaptive)
  ).map(fun (vc): vc.describe()) ~is [middle_destination_escape.describe()]
  materialized.allowed_candidates(
    other,
    Injection(source_id)
  ) ~is []

// Policy lowering feeds the existing validation and route-table path without
// another policy evaluator or table generator.
def selected_only_routes = lower_route_classes(
  lowered_topology,
  [selected_spec]
)
def validated = compile_routing(
  RoutingProblem(
    lowered_topology.topology,
    selected_only_routes.route_classes,
    lower_routing_policy(selected_only_routes, selected_policy)
  )
)
def validated_selected = selected_only_routes.route_class(selected_ref)

check:
  validated is_a ValidatedRouting ~is #true
  validated.route_row(
    validated_selected,
    Injection(source_id)
  ).allowed_vcs.map(
    fun (vc): vc.describe()
  ) ~is [source_middle_adaptive.describe()]

def mutable observed_context = #false
def observed_policy = custom_policy(
  "observe-symbolic-context",
  fun (context):
    observed_context := context
    context.candidate_vc.group == "adaptive"
)
def observed_relation = lower_routing_policy(lowered_routes, observed_policy)

check:
  observed_relation.allow(
    selected,
    Injection(source_id),
    source_middle_adaptive
  ) ~is #true
  observed_context.route_class.ref.describe() ~is "traffic/selected"
  observed_context.origin.describe() ~is "inject(source @ source)"
  observed_context.current_node.describe() ~is "source"
  observed_context.candidate_link().describe() ~is "source/middle"
  observed_context.candidate_vc.describe() ~is "source/middle/adaptive[0]"

def direct_context = RoutingContext(
  selected_spec,
  RoutingForwarding(VCRef(source_middle, "adaptive", 0)),
  middle,
  VCRef(middle_destination, "escape", 0)
)
def traced_evaluation = policy_union(
    [routing_phase("forward-rule", forwarding_policy),
     routing_phase("inject-rule", injection_policy)]
  ).evaluate(direct_context)

check:
  forwarding_policy.evaluate(direct_context).allowed ~is #true
  injection_policy.evaluate(direct_context).allowed ~is #false
  traced_evaluation.allowed ~is #true
  traced_evaluation.rule_names ~is ["forward-rule"]
  direct_context.describe() ~is "traffic/selected forward(source/middle/adaptive[0]) at middle -> middle/destination/escape[0]"

check:
  RoutingInjection("source") ~throws "InjectionRef"
  RoutingForwarding("vc") ~throws "VCRef"
  RoutingContext("route", RoutingInjection(source), source,
                 VCRef(source_middle, "escape", 0)) ~throws "RouteClassSpec"
  RoutingContext(selected_spec, "injection", source,
                 VCRef(source_middle, "escape", 0)) ~throws "RoutingOrigin"
  RoutingContext(selected_spec, RoutingInjection(source), middle,
                 VCRef(source_middle, "escape", 0)) ~throws "must equal the current node"
  match_route_classes([]) ~throws "NonemptyList.of(RouteClassRef)"
  match_route_classes(["selected"]) ~throws "NonemptyList.of(RouteClassRef)"
  select_candidate_links([]) ~throws "NonemptyList.of(LinkRef)"
  select_candidate_links(["source-middle"]) ~throws "NonemptyList.of(LinkRef)"
  restrict_vc_groups([]) ~throws "NonemptyList.of(NonemptyString)"
  restrict_vc_groups(["bad/group"]) ~throws "names without '/'"
  policy_union([]) ~throws "NonemptyList.of(RoutingPolicy)"
  policy_intersection(["not a policy"]) ~throws "NonemptyList.of(RoutingPolicy)"
  custom_policy("", fun (_): #true) ~throws "NonemptyString"
  custom_policy("bad arity", fun (_, _): #true) ~throws "Function.of_arity(1)"
  custom_policy("non-boolean", fun (_): "yes").evaluate(
    direct_context
  ).allowed ~throws "must return a Boolean"
  lower_routing_policy("not lowered routes", allow_all) ~throws "LoweredRouteClasses"
  lower_routing_policy(lowered_routes, "not a policy") ~throws "RoutingPolicy"
  lower_routing_policy(
    lowered_routes,
    match_route_classes([RouteClassRef("unknown")])
  ) ~throws "unknown route class unknown"
  lower_routing_policy(
    lowered_routes,
    select_candidate_links([LinkRef("unknown")])
  ) ~throws "unknown link unknown"
  lower_routing_policy(
    lowered_routes,
    restrict_vc_groups(["unknown"])
  ) ~throws "unknown VC group unknown"
  relation.allow(
    RouteClass(RouteClassId(99), source_id, source_id),
    Injection(source_id),
    source_middle_adaptive
  ) ~throws "does not belong"
