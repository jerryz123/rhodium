#lang rhombus
// Checks symbolic route-class validation, deterministic lowering, provenance, and model integration.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../model/main.rhm" open
  "../../authoring/main.rhm" open

def source = NodeRef("source")
def middle = NodeRef("middle")
def destination = NodeRef("destination")
def topology_spec = TopologySpec(
  [middle, destination, source],
  [directed_link(LinkRef("source-to-middle"),
                 source,
                 middle,
                 [VCGroup("escape", 1)]),
   directed_link(LinkRef("middle-to-destination"),
                 middle,
                 destination,
                 [VCGroup("escape", 1)])]
)
def lowered_topology = lower_topology(with_router_terminals(topology_spec))

def local_ref = RouteClassRef(["traffic", "local"])
def remote_ref = RouteClassRef(["traffic", "remote"])
def local_spec = RouteClassSpec(
  local_ref,
  source,
  source
)
def remote_spec = RouteClassSpec(
  remote_ref,
  source,
  destination
)

// Supply declarations out of canonical route-name order.
def lowered_routes = lower_route_classes(
  lowered_topology,
  [remote_spec, local_spec]
)
def reversed_routes = lower_route_classes(
  lowered_topology,
  [local_spec, remote_spec]
)

check:
  lowered_routes.specs.map(
    fun (spec): spec.ref.describe()
  ) ~is ["traffic/local", "traffic/remote"]
  lowered_routes.route_classes.map(
    fun (route_class): route_class.id.value
  ) ~is [0, 1]
  lowered_routes.route_class(local_ref).source.router.value ~is lowered_topology.node_id(source).value
  lowered_routes.route_class(local_ref).destination.router.value ~is lowered_topology.node_id(source).value
  lowered_routes.route_class(remote_ref).source.router.value ~is lowered_topology.node_id(source).value
  lowered_routes.route_class(remote_ref).destination.router.value ~is lowered_topology.node_id(destination).value
  lowered_routes.route_ref(RouteClassId(0)).describe() ~is "traffic/local"
  lowered_routes.route_ref(RouteClassId(1)).describe() ~is "traffic/remote"
  lowered_routes.source_ref(remote_ref).describe() ~is "source"
  lowered_routes.destination_ref(remote_ref).describe() ~is "destination"
  lowered_routes.route_classes.map(
    fun (route_class): route_class.describe()
  ) ~is reversed_routes.route_classes.map(
    fun (route_class): route_class.describe()
  )

def relation = RoutingRelation(
  fun (_, _, _): #true
)
def problem = RoutingProblem(
  lowered_topology.topology,
  lowered_routes.route_classes,
  relation
)

check:
  problem.route_classes.length() ~is 2
  problem.candidates(
    lowered_routes.route_class(remote_ref),
    Injection(lowered_topology.node_id(source))
  ).map(fun (vc): vc.describe()) ~is ["l1.vc0"]
  problem.candidates(
    lowered_routes.route_class(local_ref),
    Injection(lowered_topology.node_id(source))
  ) ~is []

check:
  RouteClassRef([]) ~throws "NonemptyList.of(NonemptyString)"
  RouteClassSpec("remote", source, destination) ~throws "RouteClassRef"
  RouteClassSpec(remote_ref, "source", destination) ~throws "InjectionRef"
  lower_route_classes("not a topology", [remote_spec]) ~throws "LoweredTopology"
  lower_route_classes(lowered_topology, []) ~throws "NonemptyList.of(RouteClassSpec)"
  lower_route_classes(lowered_topology, ["not a spec"]) ~throws "NonemptyList.of(RouteClassSpec)"
  lower_route_classes(
    lowered_topology,
    [remote_spec,
     RouteClassSpec(RouteClassRef(["traffic", "remote"]),
                    middle,
                    destination)]
  ) ~throws "duplicate route class traffic/remote"
  lower_route_classes(
    lowered_topology,
    [RouteClassSpec(RouteClassRef("unknown-source"),
                    NodeRef("unknown"),
                    destination)]
  ) ~throws "unknown source unknown"
  lower_route_classes(
    lowered_topology,
    [RouteClassSpec(RouteClassRef("unknown-destination"),
                    source,
                    NodeRef("unknown"))]
  ) ~throws "unknown destination unknown"
  lowered_routes.route_class("remote") ~throws "RouteClassRef"
  lowered_routes.route_class(RouteClassRef("unknown")) ~throws "unknown route class unknown"
  lowered_routes.route_ref("r0") ~throws "RouteClassId"
  lowered_routes.route_ref(RouteClassId(99)) ~throws "unknown route class r99"
