#lang rhombus
// Intentionally reuses a link name across directed and bidirectional declarations.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../language/main.rhm" open

def bad = topology:
  vc_group escape: 1
  node a
  node b
  directed forward:
    a -> b
    vcs [escape]
  bidirectional (forward, reverse):
    a <-> b
    vcs [escape]
