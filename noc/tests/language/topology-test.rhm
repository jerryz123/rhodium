#lang rhombus
// Checks embedded topology declarations against equivalent ordinary authoring values.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../authoring/main.rhm" open
  "../../language/main.rhm" open

def escape_count = 1

def authored = topology:
  vc_group adaptive: 2
  vc_group escape: escape_count
  node source
  node upper
  node lower
  node destination
  injection source_in at source
  injection source_debug at source
  ejection source_loop at source
  ejection destination_out at destination
  directed source_upper:
    source -> upper
    vcs [adaptive, escape]
  directed source_lower:
    source -> lower
    vcs [adaptive, escape]
  bidirectional (upper_destination, destination_upper):
    upper <-> destination
    vcs [adaptive, escape]
  directed lower_destination:
    lower -> destination
    vcs [adaptive, escape]

def groups = [VCGroup("adaptive", 2), VCGroup("escape", escape_count)]
def builder = TopologySpec(
  [NodeRef("source"),
   NodeRef("upper"),
   NodeRef("lower"),
   NodeRef("destination")],
  [TopologyLink(LinkRef("source_upper"), NodeRef("source"), NodeRef("upper"), groups),
   TopologyLink(LinkRef("source_lower"), NodeRef("source"), NodeRef("lower"), groups),
   TopologyLink(LinkRef("upper_destination"), NodeRef("upper"), NodeRef("destination"), groups),
   TopologyLink(LinkRef("destination_upper"), NodeRef("destination"), NodeRef("upper"), groups),
   TopologyLink(LinkRef("lower_destination"), NodeRef("lower"), NodeRef("destination"), groups)],
  ~injections: [
    InjectionTerminalSpec(InjectionRef("source_in"), NodeRef("source")),
    InjectionTerminalSpec(InjectionRef("source_debug"), NodeRef("source"))
  ],
  ~ejections: [
    EjectionTerminalSpec(EjectionRef("source_loop"), NodeRef("source")),
    EjectionTerminalSpec(EjectionRef("destination_out"), NodeRef("destination"))
  ]
)

def authored_lowered = lower_topology(authored)
def builder_lowered = lower_topology(builder)

check:
  authored is_a TopologySpec ~is #true
  authored.describe() ~is builder.describe()
  authored_lowered.topology.describe() ~is builder_lowered.topology.describe()
  authored_lowered.node_bindings.map(fun (binding): binding.ref.describe()) ~is builder_lowered.node_bindings.map(fun (binding): binding.ref.describe())
  authored_lowered.injection_bindings.map(fun (binding): binding.spec.describe()) ~is builder_lowered.injection_bindings.map(fun (binding): binding.spec.describe())
  authored_lowered.ejection_bindings.map(fun (binding): binding.spec.describe()) ~is builder_lowered.ejection_bindings.map(fun (binding): binding.spec.describe())
  authored_lowered.link_bindings.map(fun (binding): binding.ref.describe()) ~is builder_lowered.link_bindings.map(fun (binding): binding.ref.describe())
  authored_lowered.vc_bindings.map(fun (binding): binding.ref.describe()) ~is builder_lowered.vc_bindings.map(fun (binding): binding.ref.describe())

check:
  authored.node("source").describe() ~is "source"
  authored.node(NamePath(["destination"])).describe() ~is "destination"
  authored.node(NodeRef("upper")).describe() ~is "upper"
  authored.link("source_upper").describe() ~is builder.link(LinkRef("source_upper")).describe()
  authored.node("unknown") ~throws "unknown node unknown"
  authored.link("unknown") ~throws "unknown link unknown"
  authored.injection("source_in").describe() ~is "source_in"
  authored.ejection("destination_out").describe() ~is "destination_out"

// Declaration order affects neither symbolic normalization nor numeric IDs.
def reordered = topology:
  directed lower_destination:
    lower -> destination
    vcs [escape, adaptive]
  node destination
  bidirectional (upper_destination, destination_upper):
    upper <-> destination
    vcs [escape, adaptive]
  node lower
  vc_group escape: escape_count
  node source
  directed source_lower:
    source -> lower
    vcs [escape, adaptive]
  vc_group adaptive: 2
  directed source_upper:
    source -> upper
    vcs [escape, adaptive]
  node upper
  ejection destination_out at destination
  ejection source_loop at source
  injection source_in at source
  injection source_debug at source

check:
  reordered.describe() ~is authored.describe()
  lower_topology(reordered).topology.describe() ~is authored_lowered.topology.describe()

// The syntax result remains an ordinary specification accepted by generic
// prefixing and composition with independently authored fragments.
def prefixed_authored = prefix_topology("cluster", authored)
def prefixed_builder = prefix_topology("cluster", builder)
def tail = TopologySpec(
  [NodeRef("tail")],
  []
)
def composed_authored = compose_topologies(
  [prefixed_authored, prefix_topology("extra", tail)]
)
def composed_builder = compose_topologies(
  [prefixed_builder, prefix_topology("extra", tail)]
)

check:
  prefixed_authored.describe() ~is prefixed_builder.describe()
  composed_authored.describe() ~is composed_builder.describe()

fun invalid_count_topology():
  topology:
    vc_group broken: 0
    node only

check:
  invalid_count_topology() ~throws "PosInt"
