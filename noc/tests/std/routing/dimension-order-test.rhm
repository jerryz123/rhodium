#lang rhombus
// Checks mesh dimension-order policies, validation, prefixing, and raw-relation equivalence.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../model/main.rhm" open
  "../../../analysis/main.rhm" open
  "../../../authoring/main.rhm" open
  "../../../plan/main.rhm" open
  "../../../std/topology/main.rhm" open
  "../../../std/traffic/main.rhm" open
  "../../../std/routing/main.rhm" open

def mesh = rectangular_mesh(
  3,
  3,
  [VCGroup("escape", 1), VCGroup("adaptive", 2)]
)
def lowered_topology = lower_topology(with_router_terminals(mesh.spec))
def source = mesh.node_at(0, 0)
def destination = mesh.node_at(2, 2)
def route_ref = RouteClassRef("diagonal")
def route_spec = RouteClassSpec(route_ref, source, destination)
def lowered_routes = lower_route_classes(lowered_topology, [route_spec])
def route_class = lowered_routes.route_class(route_ref)

def xy_escape = xy_dimension_order(mesh, ~vc_groups: ["escape"])
def yx_escape = yx_dimension_order(mesh, ~vc_groups: ["escape"])
def xy_all_groups = xy_dimension_order(mesh)
def xy_relation = lower_routing_policy(lowered_routes, xy_escape)
def yx_relation = lower_routing_policy(lowered_routes, yx_escape)
def xy_all_relation = lower_routing_policy(lowered_routes, xy_all_groups)

def east_00 = mesh.outgoing_link(mesh.node_at(0, 0), mesh_east)
def north_00 = mesh.outgoing_link(mesh.node_at(0, 0), mesh_north)
def east_10 = mesh.outgoing_link(mesh.node_at(1, 0), mesh_east)
def north_10 = mesh.outgoing_link(mesh.node_at(1, 0), mesh_north)
def north_20 = mesh.outgoing_link(mesh.node_at(2, 0), mesh_north)

fun vc_id(link, group, index = 0):
  lowered_topology.vc_id(VCRef(link, group, index))

def source_id = lowered_topology.node_id(source)
def east_00_escape = vc_id(east_00, "escape")
def east_00_adaptive = vc_id(east_00, "adaptive")
def north_00_escape = vc_id(north_00, "escape")
def east_10_escape = vc_id(east_10, "escape")
def north_10_escape = vc_id(north_10, "escape")
def north_20_escape = vc_id(north_20, "escape")

check:
  mesh.vc_groups.map(fun (group): group.name) ~is ["adaptive", "escape"]
  xy_escape is_a RoutingPolicy ~is #true
  xy_escape is_a DimensionOrderPolicy ~is #true
  xy_escape.dimensions ~is ["x", "y"]
  xy_escape.vc_groups ~is ["escape"]
  xy_escape.describe() ~is "dimension-order(x,y; vc-groups=escape)"
  yx_escape.describe() ~is "dimension-order(y,x; vc-groups=escape)"
  xy_all_groups.describe() ~is "dimension-order(x,y; vc-groups=all)"

// XY consumes the complete x displacement before allowing a y link.
check:
  xy_relation.allow(
    route_class,
    Injection(source_id),
    east_00_escape
  ) ~is #true
  xy_relation.allow(
    route_class,
    Injection(source_id),
    north_00_escape
  ) ~is #false
  xy_relation.allow(
    route_class,
    Injection(source_id),
    east_00_adaptive
  ) ~is #false
  xy_all_relation.allow(
    route_class,
    Injection(source_id),
    east_00_adaptive
  ) ~is #true
  xy_relation.allow(
    route_class,
    HeldVC(east_00_escape),
    east_10_escape
  ) ~is #true
  xy_relation.allow(
    route_class,
    HeldVC(east_00_escape),
    north_10_escape
  ) ~is #false
  xy_relation.allow(
    route_class,
    HeldVC(east_10_escape),
    north_20_escape
  ) ~is #true

// YX makes the opposite first-dimension choice for the same route.
check:
  yx_relation.allow(
    route_class,
    Injection(source_id),
    north_00_escape
  ) ~is #true
  yx_relation.allow(
    route_class,
    Injection(source_id),
    east_00_escape
  ) ~is #false

// Exercise every ordered nonlocal route through validation and route-table
// generation, then compare it with an independently written raw callback.
def small_mesh = rectangular_mesh(
  2,
  2,
  [VCGroup("escape", 1), VCGroup("adaptive", 1)]
)
def small_topology = lower_topology(with_router_terminals(small_mesh.spec))
def small_routes = lower_route_classes(
  small_topology,
  all_pairs(small_topology.spec)
)
def small_policy = xy_dimension_order(
  small_mesh,
  ~vc_groups: ["escape"]
)
def policy_problem = RoutingProblem(
  small_topology.topology,
  small_routes.route_classes,
  lower_routing_policy(small_routes, small_policy)
)
def policy_materialized = materialize_routing(policy_problem)
def policy_validated = compile_routing(policy_problem)
def yx_validated = compile_routing(
  RoutingProblem(
    small_topology.topology,
    small_routes.route_classes,
    lower_routing_policy(
      small_routes,
      yx_dimension_order(small_mesh, ~vc_groups: ["escape"])
    )
  )
)

fun raw_origin_node(origin):
  if origin is_a Injection
  | origin.terminal.router
  | small_topology.topology.find_vc_link(origin.vc).destination

fun raw_xy_allows(route_class, origin, candidate_vc):
  def current = small_mesh.coordinate_of(
    small_topology.node_ref(raw_origin_node(origin))
  )
  def destination = small_mesh.coordinate_of(
    small_topology.node_ref(route_class.destination.router)
  )
  def candidate = small_topology.vc_ref(candidate_vc)
  def required_direction:
    cond
    | current.x < destination.x: mesh_east
    | current.x > destination.x: mesh_west
    | current.y < destination.y: mesh_north
    | current.y > destination.y: mesh_south
    | ~else: #false
  required_direction != #false && candidate.group == "escape" && mesh_direction_equal(
    required_direction,
    small_mesh.direction_of(candidate.link)
  )

def raw_problem = RoutingProblem(
  small_topology.topology,
  small_routes.route_classes,
  RoutingRelation(raw_xy_allows)
)
def raw_materialized = materialize_routing(raw_problem)
def raw_validated = compile_routing(raw_problem)

check:
  policy_validated is_a ValidatedRouting ~is #true
  yx_validated is_a ValidatedRouting ~is #true
  raw_validated is_a ValidatedRouting ~is #true
  policy_validated.route_classes.length() ~is 12
  policy_materialized.describe() ~is raw_materialized.describe()
  policy_validated.route_table.describe() ~is raw_validated.route_table.describe()

def reordered_routes = lower_route_classes(
  small_topology,
  all_pairs(small_topology.spec).reverse()
)
def reordered_materialized = materialize_routing(
  RoutingProblem(
    small_topology.topology,
    reordered_routes.route_classes,
    lower_routing_policy(reordered_routes, small_policy)
  )
)

check:
  reordered_materialized.describe() ~is policy_materialized.describe()

// Prefixing changes semantic names but preserves normalized routing decisions.
def prefixed_mesh = small_mesh.prefix("cluster")
def prefixed_topology = lower_topology(with_router_terminals(prefixed_mesh.spec))
def prefixed_routes = lower_route_classes(
  prefixed_topology,
  all_pairs(prefixed_topology.spec)
)
def prefixed_problem = RoutingProblem(
  prefixed_topology.topology,
  prefixed_routes.route_classes,
  lower_routing_policy(
    prefixed_routes,
    xy_dimension_order(prefixed_mesh, ~vc_groups: ["escape"])
  )
)
def prefixed_validated = compile_routing(prefixed_problem)

check:
  prefixed_mesh.vc_groups.map(fun (group): group.name) ~is ["adaptive", "escape"]
  prefixed_validated is_a ValidatedRouting ~is #true
  prefixed_validated.materialized.describe() ~is policy_validated.materialized.describe()
  prefixed_validated.route_table.describe() ~is policy_validated.route_table.describe()

def valid_candidate = VCRef(east_00, "escape", 0)
def valid_origin = RoutingInjection(source)

check:
  dimension_order("not a mesh", ["x", "y"]) ~throws "RectangularMesh"
  dimension_order(mesh, "xy") ~throws "List.of(String)"
  dimension_order(mesh, ["x"]) ~throws "must be ['x', 'y'] or ['y', 'x']"
  dimension_order(mesh, ["x", "x"]) ~throws "must be ['x', 'y'] or ['y', 'x']"
  dimension_order(mesh, ["x", "z"]) ~throws "must be ['x', 'y'] or ['y', 'x']"
  dimension_order(mesh, ["x", "y"], ~vc_groups: []) ~throws "nonempty List"
  dimension_order(mesh, ["x", "y"], ~vc_groups: ["bad/group"]) ~throws "names without '/'"
  dimension_order(mesh, ["x", "y"], ~vc_groups: ["escape", "escape"]) ~throws "duplicate"
  dimension_order(mesh, ["x", "y"], ~vc_groups: ["unknown"]) ~throws "mesh has no VC group unknown"
  xy_escape.evaluate(
    RoutingContext(route_spec,
                   RoutingForwarding(valid_candidate),
                   NodeRef("unknown"),
                   valid_candidate)
  ).allowed ~throws "node is not in mesh unknown"
  xy_escape.evaluate(
    RoutingContext(RouteClassSpec(RouteClassRef("foreign-destination"),
                                  source,
                                  NodeRef("unknown")),
                   valid_origin,
                   source,
                   valid_candidate)
  ).allowed ~throws "node is not in mesh unknown"
  xy_escape.evaluate(
    RoutingContext(route_spec,
                   valid_origin,
                   source,
                   VCRef(LinkRef("unknown"), "escape", 0))
  ).allowed ~throws "link is not in mesh unknown"
