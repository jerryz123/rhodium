#lang rhombus
// Checks standard all-pairs traffic generation, naming, lowering, and topology independence.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../../model/main.rhm" open
  "../../../authoring/main.rhm" open
  "../../../std/topology/main.rhm" open
  "../../../std/traffic/main.rhm" open

def a = NodeRef("a")
def b = NodeRef("b")
def c = NodeRef(["group", "c"])
def explicit_topology = with_router_terminals(TopologySpec([c, b, a], []))
def nonlocal_pairs = all_pairs(explicit_topology)
def pairs_with_local = all_pairs(
  explicit_topology,
  ~include_local: #true
)

check:
  nonlocal_pairs.length() ~is 6
  pairs_with_local.length() ~is 9
  nonlocal_pairs.map(fun (spec): spec.ref.describe()) ~is [
    "all-pairs/from/terminal=a/to/terminal=b",
    "all-pairs/from/terminal=a/to/terminal=group/terminal=c",
    "all-pairs/from/terminal=b/to/terminal=a",
    "all-pairs/from/terminal=b/to/terminal=group/terminal=c",
    "all-pairs/from/terminal=group/terminal=c/to/terminal=a",
    "all-pairs/from/terminal=group/terminal=c/to/terminal=b"
  ]
  nonlocal_pairs[0].source.describe() ~is "a"
  nonlocal_pairs[0].destination.describe() ~is "b"
  pairs_with_local.filter(
    ~keep: fun (spec): spec.source.describe() == spec.destination.describe()
  ).length() ~is 3

def lowered_topology = lower_topology(explicit_topology)
def lowered_pairs = lower_route_classes(lowered_topology, nonlocal_pairs)

check:
  lowered_pairs.route_classes.length() ~is 6
  lowered_pairs.route_ref(RouteClassId(0)).describe() ~is nonlocal_pairs[0].ref.describe()
  lowered_pairs.route_class(nonlocal_pairs[0].ref).source.router.value ~is lowered_topology.node_id(a).value
  lowered_pairs.route_class(nonlocal_pairs[0].ref).destination.router.value ~is lowered_topology.node_id(b).value

def singleton = with_router_terminals(TopologySpec([NodeRef("only")], []))

check:
  all_pairs(singleton) ~is []
  all_pairs(singleton, ~include_local: #true).length() ~is 1
  all_pairs(
    singleton,
    ~include_local: #true,
    ~prefix: ["traffic", "local"]
  )[0].ref.describe() ~is "traffic/local/from/terminal=only/to/terminal=only"
  all_pairs_route_ref(
    InjectionRef(a.path),
    EjectionRef(b.path),
    ~prefix: RouteClassRef(["traffic", "explicit"])
  ).describe() ~is "traffic/explicit/from/terminal=a/to/terminal=b"

// Endpoint-segment markers keep hierarchical route names unambiguous.
def ambiguous_left = all_pairs_route_ref(
  InjectionRef(["a", "to", "b"]),
  EjectionRef("c")
)
def ambiguous_right = all_pairs_route_ref(
  InjectionRef("a"),
  EjectionRef(["b", "to", "c"])
)

check:
  ambiguous_left.describe() ~is "all-pairs/from/terminal=a/terminal=to/terminal=b/to/terminal=c"
  ambiguous_right.describe() ~is "all-pairs/from/terminal=a/to/terminal=b/terminal=to/terminal=c"
  ambiguous_left.describe() == ambiguous_right.describe() ~is #false

// A standard mesh and an explicit topology with the same symbolic nodes
// produce identical traffic definitions; links are irrelevant to all-pairs.
def mesh = rectangular_mesh(2, 1, [VCGroup("escape", 1)])
def explicit_mesh_nodes = TopologySpec(
  [NodeRef("router[1,0]"), NodeRef("router[0,0]")],
  []
)

check:
  all_pairs(with_router_terminals(mesh.spec)).map(
    fun (spec): spec.describe()
  ) ~is all_pairs(with_router_terminals(explicit_mesh_nodes)).map(
    fun (spec): spec.describe()
  )

check:
  all_pairs("not a topology") ~throws "TopologySpec"
  all_pairs(explicit_topology, ~include_local: "yes") ~throws "Boolean"
  all_pairs(singleton, ~prefix: "") ~throws "NonemptyList.of(NonemptyString)"
  all_pairs_route_ref("a", EjectionRef(b.path)) ~throws "InjectionRef"
