#lang rhombus
// Checks successful traversal and deterministic rejection of invalid reachable routing branches.
// SPDX-License-Identifier: Apache-2.0

import:
  "../model/main.rhm" open
  "../analysis/main.rhm" open

def n0 = NodeId(0)
def n1 = NodeId(1)
def n2 = NodeId(2)
def n3 = NodeId(3)
def n4 = NodeId(4)

def l0 = PhysicalLink(LinkId(0), n0, n1, 1)
def l1 = PhysicalLink(LinkId(1), n1, n2, 1)
def l2 = PhysicalLink(LinkId(2), n0, n2, 1)
def l3 = PhysicalLink(LinkId(3), n3, n4, 1)
def l4 = PhysicalLink(LinkId(4), n4, n3, 1)
def topology = Topology([n4, n2, n0, n3, n1], [l4, l2, l0, l3, l1])

def route0 = RouteClass(RouteClassId(0), n0, n2)
def mutable callback_count = 0
def materialized = materialize_routing(
  RoutingProblem(
    topology,
    [route0],
    RoutingRelation(
      fun (_, _, _):
        callback_count := callback_count + 1
        #true
    )
  )
)
def calls_after_materialization = callback_count
def reachable = analyze_reachability(materialized)
def route0_reachable = reachable.for_route(route0)

check:
  callback_count ~is calls_after_materialization
  route0_reachable.reachable_vcs.map(fun (vc): vc.describe()) ~is ["l0.vc0", "l2.vc0", "l1.vc0"]
  route0_reachable.reachable_decisions.map(
    fun (decision): decision.describe()
  ) ~is ["r0 inject(i0@n0) -> l0.vc0: allow",
         "r0 inject(i0@n0) -> l2.vc0: allow",
         "r0 hold(l0.vc0) -> l1.vc0: allow"]
  route0_reachable.reaches_vc(VCId(LinkId(1), 0)) ~is #true
  route0_reachable.reaches_vc(VCId(LinkId(3), 0)) ~is #false
  reachable.reachable_decisions().length() ~is 3
  reachable.describe() ~is "r0: [l0.vc0, l2.vc0, l1.vc0]"
  reachable.reachable_decisions()[0] === materialized.decision(
    route0,
    Injection(n0),
    VCId(LinkId(0), 0)
  ) ~is #true

// A source equal to its destination ejects without acquiring a VC.
def local_route = RouteClass(RouteClassId(1), n0, n0)
def local_reachable = analyze_reachability(
  materialize_routing(
    RoutingProblem(
      topology,
      [local_route],
      RoutingRelation(fun (_, _, _): #true)
    )
  )
).for_route(local_route)

check:
  local_reachable.reachable_vcs ~is []
  local_reachable.reachable_decisions ~is []

// The direct branch reaches n2, but the branch through l0 is a reachable dead end.
def branching_dead_end = materialize_routing(
  RoutingProblem(
    topology,
    [route0],
    RoutingRelation(
      fun (_, origin, _): origin is_a Injection
    )
  )
)

check:
  analyze_reachability(branching_dead_end) ~throws "reachable dead end for route class r0 at hold(l0.vc0)"

// This route cycles forever through n0 and n1 without reaching n2 or dead-ending.
def cycle_l0 = PhysicalLink(LinkId(10), n0, n1, 1)
def cycle_l1 = PhysicalLink(LinkId(11), n1, n0, 1)
def cycle_topology = Topology([n0, n1, n2], [cycle_l1, cycle_l0])
def cycle_route = RouteClass(RouteClassId(2), n0, n2)
def unreachable_cycle = materialize_routing(
  RoutingProblem(
    cycle_topology,
    [cycle_route],
    RoutingRelation(fun (_, _, _): #true)
  )
)

check:
  analyze_reachability(unreachable_cycle) ~throws "destination e2@n2 is unreachable for route class r2 from i0@n0"

// A route with no legal first acquisition is reported at its injection origin.
def injection_dead_end_route = RouteClass(RouteClassId(3), n2, n0)
def injection_dead_end = materialize_routing(
  RoutingProblem(
    topology,
    [injection_dead_end_route],
    RoutingRelation(fun (_, _, _): #true)
  )
)

check:
  analyze_reachability(injection_dead_end) ~throws "at inject(i2@n2)"
  analyze_reachability("not materialized") ~throws "MaterializedRouting"
  reachable.for_route(RouteClass(RouteClassId(0), n0, n2)) ~throws "does not belong"
