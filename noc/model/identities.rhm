#lang rhombus
// Defines nominal and deterministically ordered identities for pure NoC graph objects.
// SPDX-License-Identifier: Apache-2.0

export:
  NodeId
  InjectionId
  EjectionId
  LinkId
  VCId
  RouteClassId
  node_id_equal
  injection_id_equal
  ejection_id_equal
  link_id_equal
  vc_id_equal
  route_class_id_equal
  node_id_less
  injection_id_less
  ejection_id_less
  link_id_less
  vc_id_less
  route_class_id_less

class NodeId(value :: Nat):

  method describe():
    "n" ++ to_string(value)

class InjectionId(value :: Nat):

  method describe():
    "i" ++ to_string(value)

class EjectionId(value :: Nat):

  method describe():
    "e" ++ to_string(value)

class LinkId(value :: Nat):

  method describe():
    "l" ++ to_string(value)

class VCId(link_id :: LinkId, index :: Nat):

  method describe():
    link_id.describe() ++ ".vc" ++ to_string(index)

class RouteClassId(value :: Nat):

  method describe():
    "r" ++ to_string(value)

fun node_id_equal(left :: NodeId, right :: NodeId):
  left.value == right.value

fun injection_id_equal(left :: InjectionId, right :: InjectionId):
  left.value == right.value

fun ejection_id_equal(left :: EjectionId, right :: EjectionId):
  left.value == right.value

fun link_id_equal(left :: LinkId, right :: LinkId):
  left.value == right.value

fun vc_id_equal(left :: VCId, right :: VCId):
  link_id_equal(left.link_id, right.link_id) && left.index == right.index

fun route_class_id_equal(left :: RouteClassId, right :: RouteClassId):
  left.value == right.value

fun node_id_less(left :: NodeId, right :: NodeId):
  left.value < right.value

fun injection_id_less(left :: InjectionId, right :: InjectionId):
  left.value < right.value

fun ejection_id_less(left :: EjectionId, right :: EjectionId):
  left.value < right.value

fun link_id_less(left :: LinkId, right :: LinkId):
  left.value < right.value

fun vc_id_less(left :: VCId, right :: VCId):
  if link_id_equal(left.link_id, right.link_id)
  | left.index < right.index
  | link_id_less(left.link_id, right.link_id)

fun route_class_id_less(left :: RouteClassId, right :: RouteClassId):
  left.value < right.value
