#lang rhombus
/* Defines finite route classes, routing origins, and topology-derived candidate queries. */
// SPDX-License-Identifier: Apache-2.0

import:
  "identities.rhm" open
  "topology.rhm" open

export:
  InjectionTerminal
  EjectionTerminal
  RouteClass
  Injection
  HeldVC
  RoutingRelation
  RoutingProblem
  injection_origin
  held_vc_origin

/* Associates an injection identity with its router attachment. */
class InjectionTerminal(id :: InjectionId, router :: NodeId):

  /* Formats an injection identity and its router attachment. */
  method describe():
    id.describe() ++ "@" ++ router.describe()

/* Associates an ejection identity with its router attachment. */
class EjectionTerminal(id :: EjectionId, router :: NodeId):

  /* Formats an ejection identity and its router attachment. */
  method describe():
    id.describe() ++ "@" ++ router.describe()

/* Names one source/destination terminal pair within a routing problem. */
class RouteClass(id :: RouteClassId,
                 source :: InjectionTerminal,
                 destination :: EjectionTerminal):
  /* Accepts explicit terminals or derives same-index terminal identities from routers. */
  constructor (id :: RouteClassId,
               source :: NodeId || InjectionTerminal,
               destination :: NodeId || EjectionTerminal):
    def source_terminal:
      if source is_a NodeId
      | InjectionTerminal(InjectionId(source.value), source)
      | source
    def destination_terminal:
      if destination is_a NodeId
      | EjectionTerminal(EjectionId(destination.value), destination)
      | destination
    super(id, source_terminal, destination_terminal)

  /* Formats the route identity and its source/destination attachments. */
  method describe():
    String.append(id.describe(), ": ", source.describe(), " -> ",
                  destination.describe())

/* Represents a packet before it acquires its first network VC. */
class Injection(terminal :: InjectionTerminal):
  /* Accepts an explicit terminal or derives one from a router identity. */
  constructor (terminal :: NodeId || InjectionTerminal):
    super(
      if terminal is_a NodeId
      | InjectionTerminal(InjectionId(terminal.value), terminal)
      | terminal
    )

  /* Formats the terminal at which the packet enters the network. */
  method describe():
    "inject(" ++ terminal.describe() ++ ")"

/* Represents a packet holding a VC at that link's destination router. */
class HeldVC(vc :: VCId):
  /* Formats the resource currently held by the packet. */
  method describe():
    "hold(" ++ vc.describe() ++ ")"

/* Distinguishes injection state from a held-VC routing origin. */
fun injection_origin(value :: Injection || HeldVC):
  value is_a Injection

/* Distinguishes a held network resource from injection state. */
fun held_vc_origin(value :: Injection || HeldVC):
  value is_a HeldVC

/* Detects repeated numeric route-class identities. */
fun duplicate_route_class_id(route_classes :: List.of(RouteClass),
                             id :: RouteClassId):
  route_classes.filter(
    ~keep: fun (candidate): route_class_id_equal(candidate.id, id)
  ).length() > 1

/* Detects an injection identity attached to different routers. */
fun conflicting_injection(route_classes :: List.of(RouteClass),
                          terminal :: InjectionTerminal):
  route_classes.find(
    fun (candidate):
      injection_id_equal(candidate.source.id, terminal.id) && (
        !node_id_equal(candidate.source.router, terminal.router)
      )
  ) != #false

/* Detects an ejection identity attached to different routers. */
fun conflicting_ejection(route_classes :: List.of(RouteClass),
                         terminal :: EjectionTerminal):
  route_classes.find(
    fun (candidate):
      ejection_id_equal(candidate.destination.id, terminal.id) && (
        !node_id_equal(candidate.destination.router, terminal.router)
      )
  ) != #false

/* Deduplicates source terminals and orders them by injection identity. */
fun unique_injections(route_classes :: List.of(RouteClass)):
  def mutable terminals = []
  for (route_class in route_classes):
    unless terminals.find(
      fun (terminal): injection_id_equal(terminal.id, route_class.source.id)
    )
    | terminals := terminals ++ [route_class.source]
  terminals.sort(fun (left, right): injection_id_less(left.id, right.id))

/* Deduplicates destination terminals and orders them by ejection identity. */
fun unique_ejections(route_classes :: List.of(RouteClass)):
  def mutable terminals = []
  for (route_class in route_classes):
    unless terminals.find(
      fun (terminal): ejection_id_equal(terminal.id, route_class.destination.id)
    )
    | terminals := terminals ++ [route_class.destination]
  terminals.sort(fun (left, right): ejection_id_less(left.id, right.id))

/* Wraps the user predicate over a route, origin, and candidate VC. */
class RoutingRelation(allows :: Function.of_arity(3)):

  /* Invokes the user predicate; finite evaluation and Boolean checking belong to materialization. */
  method allow(route_class :: RouteClass,
               origin :: Injection || HeldVC,
               candidate_vc :: VCId):
    allows(route_class, origin, candidate_vc)

/* Binds a topology, ordered route classes, terminals, and an unevaluated relation. */
class RoutingProblem(topology :: Topology,
                     route_classes :: NonemptyList.of(RouteClass),
                     relation :: RoutingRelation,
                     injection_terminals :: List.of(InjectionTerminal),
                     ejection_terminals :: List.of(EjectionTerminal)):
  /* Validates route identities and terminal attachments before sorting and deduplicating them. */
  constructor (topology :: Topology,
               route_classes :: NonemptyList.of(RouteClass),
               relation :: RoutingRelation):
    for (route_class in route_classes):
      when duplicate_route_class_id(route_classes, route_class.id)
      | error(~who: #'RoutingProblem,
              "duplicate route class " ++ route_class.id.describe())
      unless topology.contains_node(route_class.source.router)
      | error(~who: #'RoutingProblem,
              String.append("route class ", route_class.id.describe(),
                            " has source terminal on unknown router ",
                            route_class.source.describe()))
      unless topology.contains_node(route_class.destination.router)
      | error(~who: #'RoutingProblem,
              String.append("route class ", route_class.id.describe(),
                            " has destination terminal on unknown router ",
                            route_class.destination.describe()))
      when conflicting_injection(route_classes, route_class.source)
      | error(~who: #'RoutingProblem,
              String.append(
                "injection terminal has conflicting router attachment ",
                route_class.source.id.describe()
              ))
      when conflicting_ejection(route_classes, route_class.destination)
      | error(~who: #'RoutingProblem,
              String.append(
                "ejection terminal has conflicting router attachment ",
                route_class.destination.id.describe()
              ))
    def ordered_routes = route_classes.sort(
      fun (left, right): route_class_id_less(left.id, right.id)
    )
    super(topology,
          ordered_routes,
          relation,
          unique_injections(ordered_routes),
          unique_ejections(ordered_routes))

  /* Checks exact route-object membership, not merely a matching numeric identity. */
  method contains_route_class(route_class :: RouteClass):
    route_classes.find(
      fun (candidate): candidate === route_class
    ) != #false

  /* Looks up an ordered route class by numeric identity or reports an error. */
  method find_route_class(id :: RouteClassId):
    def found = route_classes.find(
      fun (route_class): route_class_id_equal(route_class.id, id)
    )
    unless found
    | error(~who: #'find_route_class,
            "unknown route class " ++ id.describe())
    found

  /* Resolves an injection attachment or the destination of a held VC's link. */
  method origin_node(origin :: Injection || HeldVC):
    cond
    | origin is_a Injection:
        unless topology.contains_node(origin.terminal.router)
        | error(~who: #'origin_node,
                String.append(
                  "injection references a terminal on an unknown router ",
                  origin.terminal.describe()
                ))
        origin.terminal.router
    | origin is_a HeldVC:
        topology.find_vc_link(origin.vc).destination

  /* Checks whether an owned route has reached its destination router. */
  method at_destination(route_class :: RouteClass, origin :: Injection || HeldVC):
    unless contains_route_class(route_class)
    | error(~who: #'at_destination,
            "route class does not belong to this routing problem")
    node_id_equal(origin_node(origin), route_class.destination.router)

  /* Enumerates physically legal outgoing VCs; destination arrival ejects without a policy query. */
  method candidates(route_class :: RouteClass, origin :: Injection || HeldVC):
    unless contains_route_class(route_class)
    | error(~who: #'candidates,
            "route class does not belong to this routing problem")
    when origin is_a Injection && !injection_id_equal(
      origin.terminal.id,
      route_class.source.id
    )
    | error(~who: #'candidates,
            String.append("route class ", route_class.id.describe(),
                          " cannot inject at ", origin.terminal.describe()))
    def node = origin_node(origin)
    if node_id_equal(node, route_class.destination.router)
    | []
    | topology.outgoing_vcs(node)
