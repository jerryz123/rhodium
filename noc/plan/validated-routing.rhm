#lang rhombus
// Builds deterministic route tables and the opaque artifact gated by all NoC validation passes.
// SPDX-License-Identifier: Apache-2.0

import:
  "../model/main.rhm" open
  "../analysis/main.rhm" open

export:
  RouteTableRow
  RouteTable
  ValidationAssumptions
  EscapeCertificate
  ValidatedRouting
  compile_routing

def acyclic_validator_version = "vc-dependency-acyclic/v1"
def escape_validator_version = "vc-escape-subnetwork/v1"

fun origin_equal(left :: Injection || HeldVC, right :: Injection || HeldVC):
  cond
  | left is_a Injection && right is_a Injection:
      injection_id_equal(left.terminal.id, right.terminal.id)
  | left is_a HeldVC && right is_a HeldVC:
      vc_id_equal(left.vc, right.vc)
  | ~else: #false

fun origin_node(materialized :: MaterializedRouting,
                origin :: Injection || HeldVC):
  cond
  | origin is_a Injection: origin.terminal.router
  | origin is_a HeldVC:
      materialized.topology.find_vc_link(origin.vc).destination

class RouteTableRow(route_class :: RouteClass,
                    origin :: Injection || HeldVC,
                    router_node :: NodeId,
                    allowed_vcs :: List.of(VCId),
                    ejection_terminal :: False || EjectionTerminal):
  opaque
  internal _RouteTableRow
  constructor ~none

  method allows(vc :: VCId):
    allowed_vcs.find(
      fun (candidate): vc_id_equal(candidate, vc)
    ) != #false

  method describe():
    def action:
      if ejection_terminal
      | "eject " ++ ejection_terminal.describe()
      | block:
          def vc_names = allowed_vcs.map(fun (vc): vc.describe())
          "[" ++ String.join(vc_names, ", ") ++ "]"
    String.append(route_class.id.describe(), " ", origin.describe(), " @ ",
                  router_node.describe(), ": ", action)

class RouteTable(topology :: Topology,
                 route_classes :: NonemptyList.of(RouteClass),
                 rows :: List.of(RouteTableRow)):
  opaque
  internal _RouteTable
  constructor ~none

  method contains_route_class(route_class :: RouteClass):
    route_classes.find(
      fun (candidate): candidate === route_class
    ) != #false

  method row(route_class :: RouteClass, origin :: Injection || HeldVC):
    unless contains_route_class(route_class)
    | error(~who: #'RouteTable,
            "route class does not belong to this route table")
    def found = rows.find(
      fun (candidate):
        candidate.route_class === route_class && origin_equal(candidate.origin, origin)
    )
    unless found
    | error(~who: #'RouteTable,
            String.append("unknown route-table row for ",
                          route_class.id.describe(), " ", origin.describe()))
    found

  method rows_at(node :: NodeId):
    unless topology.contains_node(node)
    | error(~who: #'RouteTable, "unknown route-table node")
    rows.filter(
      ~keep: fun (row): node_id_equal(row.router_node, node)
    )

  method allowed_candidates(route_class :: RouteClass,
                            origin :: Injection || HeldVC):
    row(route_class, origin).allowed_vcs

  method describe():
    String.join(rows.map(fun (row): row.describe()), "\n")

class ValidationAssumptions(resource_model :: String,
                            deadlock_criterion :: String,
                            injection_holds_vc :: Boolean,
                            ejection_acquires_vc :: Boolean,
                            persistent_escape_request :: Boolean,
                            eventual_escape_grant :: Boolean):
  opaque
  internal _ValidationAssumptions
  constructor ~none

  method describe():
    String.append(resource_model, "; ", deadlock_criterion,
                  "; injection-holds-vc=", to_string(injection_holds_vc),
                  "; ejection-acquires-vc=", to_string(ejection_acquires_vc),
                  "; persistent-escape-request=",
                  to_string(persistent_escape_request),
                  "; eventual-escape-grant=",
                  to_string(eventual_escape_grant))

def initial_assumptions = _ValidationAssumptions(
  "virtual-channel hold-and-request",
  "reachable VC dependency union is acyclic",
  #false,
  #false,
  #false,
  #false
)

def escape_assumptions = _ValidationAssumptions(
  "virtual-channel hold-and-request",
  "reachable escape VC dependency subgraph is acyclic",
  #false,
  #false,
  #true,
  #true
)

class EscapeCertificate(request :: EscapeValidationRequest,
                        reachability :: EscapeReachabilityEvidence,
                        closure :: EscapeClosureEvidence,
                        dependency_graph :: VCDependencyGraph,
                        acyclic_certificate :: AcyclicCertificate,
                        assumptions :: ValidationAssumptions,
                        validator_version :: String):
  opaque
  internal _EscapeCertificate
  constructor ~none

  method rank(vc :: VCId):
    acyclic_certificate.rank(vc)

  method describe():
    String.append("escape certificate ", validator_version, ": vcs=",
                  to_string(request.escape_vcs.length()),
                  ", reachable-vcs=",
                  to_string(dependency_graph.vertices.length()))

class ValidatedRouting(topology :: Topology,
                       route_classes :: NonemptyList.of(RouteClass),
                       injection_terminals :: List.of(InjectionTerminal),
                       ejection_terminals :: List.of(EjectionTerminal),
                       materialized :: MaterializedRouting,
                       reachable :: ReachableRouting,
                       dependency_graph :: VCDependencyGraph,
                       certificate :: AcyclicCertificate || EscapeCertificate,
                       route_table :: RouteTable,
                       assumptions :: ValidationAssumptions,
                       validator_version :: String):
  opaque
  internal _ValidatedRouting
  constructor ~none

  method route_row(route_class :: RouteClass, origin :: Injection || HeldVC):
    route_table.row(route_class, origin)

  method describe():
    String.append("validated routing ", validator_version,
                  ": routes=", to_string(route_classes.length()),
                  ", vcs=", to_string(dependency_graph.vertices.length()),
                  ", rows=", to_string(route_table.rows.length()))

fun make_row(materialized :: MaterializedRouting,
             route_class :: RouteClass,
             origin :: Injection || HeldVC):
  def node = origin_node(materialized, origin)
  def ejection_terminal:
    if node_id_equal(node, route_class.destination.router)
    | route_class.destination
    | #false
  def allowed_vcs = materialized.allowed_candidates(route_class, origin)
  when ejection_terminal && allowed_vcs.length() > 0
  | error(~who: #'compile_routing,
          "internal error: destination row has output VCs")
  _RouteTableRow(route_class,
                 origin,
                 node,
                 allowed_vcs,
                 ejection_terminal)

fun build_route_table(materialized :: MaterializedRouting,
                      reachable :: ReachableRouting):
  def mutable rows = []
  for (route in reachable.routes):
    def route_class = route.route_class
    rows := rows ++ [make_row(
      materialized,
      route_class,
      Injection(route_class.source)
    )]
    for (vc in route.reachable_vcs.sort(vc_id_less)):
      rows := rows ++ [make_row(
        materialized,
        route_class,
        HeldVC(vc)
      )]
  _RouteTable(materialized.topology, materialized.route_classes, rows)

fun finish_validated_routing(materialized :: MaterializedRouting,
                             reachable :: ReachableRouting,
                             dependency_graph :: VCDependencyGraph,
                             certificate :: AcyclicCertificate || EscapeCertificate,
                             assumptions :: ValidationAssumptions,
                             version :: String):
  def route_table = build_route_table(materialized, reachable)
  _ValidatedRouting(
    materialized.topology,
    materialized.route_classes,
    materialized.injection_terminals,
    materialized.ejection_terminals,
    materialized,
    reachable,
    dependency_graph,
    certificate,
    route_table,
    assumptions,
    version
  )

fun compile_routing(problem :: RoutingProblem,
                    ~escape: escape_request :~ False || EscapeValidationRequest = #false):
  unless !escape_request || escape_request is_a EscapeValidationRequest
  | error(~who: #'compile_routing,
          "~escape must be an EscapeValidationRequest or #false")
  when escape_request && !(escape_request.topology === problem.topology)
  | error(~who: #'compile_routing,
          "escape validation request belongs to a different topology")
  def materialized = materialize_routing(problem)
  def reachable = analyze_reachability(materialized)
  def dependency_graph = build_dependency_graph(reachable)
  if !escape_request
  | block:
      def proof = check_dependency_acyclicity(dependency_graph)
      if proof is_a DependencyCycle
      | proof
      | finish_validated_routing(
          materialized,
          reachable,
          dependency_graph,
          proof,
          initial_assumptions,
          acyclic_validator_version
        )
  | block:
      def evidence = validate_escape_subnetwork(
        materialized,
        reachable,
        dependency_graph,
        escape_request
      )
      if evidence is_a EscapeValidationEvidence
      | block:
          def certificate = _EscapeCertificate(
            evidence.request,
            evidence.reachability,
            evidence.closure,
            evidence.dependency_graph,
            evidence.acyclic_certificate,
            escape_assumptions,
            escape_validator_version
          )
          finish_validated_routing(
            materialized,
            reachable,
            dependency_graph,
            certificate,
            escape_assumptions,
            escape_validator_version
          )
      | evidence
