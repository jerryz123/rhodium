#lang rhombus
// Projects one validated network into deterministic router-local route encodings.

import:
  rhombus.bits.(<<) as <<
  "../model/main.rhm" open
  "validated-routing.rhm" open

export:
  RouterPlanRow
  RouterPlan

fun origin_equal(left :: Injection || HeldVC, right :: Injection || HeldVC):
  cond
  | left is_a Injection && right is_a Injection:
      injection_id_equal(left.terminal.id, right.terminal.id)
  | left is_a HeldVC && right is_a HeldVC:
      vc_id_equal(left.vc, right.vc)
  | ~else: #false

fun list_index(items :: List, predicate :: Function.of_arity(1)):
  def mutable found = #false
  for (item in items, index in 0..items.length()):
    when predicate(item)
    | found := index
  found

fun incoming_vcs(topology :: Topology, node :: NodeId):
  def mutable vcs = []
  for (link in topology.incoming_links(node)):
    vcs := vcs ++ link.virtual_channels()
  vcs

fun injection_terminals_at(validated_routing :: ValidatedRouting,
                           node :: NodeId):
  validated_routing.injection_terminals.filter(
    ~keep: fun (terminal): node_id_equal(terminal.router, node)
  )

fun ejection_terminals_at(validated_routing :: ValidatedRouting,
                          node :: NodeId):
  validated_routing.ejection_terminals.filter(
    ~keep: fun (terminal): node_id_equal(terminal.router, node)
  )

fun require_route_key(route_classes :: List.of(RouteClass),
                      route_class :: RouteClass):
  def found = list_index(
    route_classes,
    fun (candidate): candidate === route_class
  )
  unless found
  | error(~who: #'RouterPlan,
          "route class does not belong to this router plan")
  found

fun require_origin_key(origins :: List.of(Injection || HeldVC),
                       origin :~ Injection || HeldVC):
  unless origin is_a Injection || origin is_a HeldVC
  | error(~who: #'RouterPlan,
          "router-plan origin must be an Injection or HeldVC")
  def found = list_index(
    origins,
    fun (candidate): origin_equal(candidate, origin)
  )
  unless found
  | error(~who: #'RouterPlan, "origin does not belong to this router plan")
  found

fun target_equal(left :: VCId || EjectionTerminal,
                 right :~ VCId || EjectionTerminal):
  cond
  | left is_a VCId && right is_a VCId: vc_id_equal(left, right)
  | left is_a EjectionTerminal && right is_a EjectionTerminal:
      ejection_id_equal(left.id, right.id)
  | ~else: #false

fun require_target_bit(targets :: List.of(VCId || EjectionTerminal),
                       target :~ VCId || EjectionTerminal):
  def found = list_index(
    targets,
    fun (candidate): target_equal(candidate, target)
  )
  unless found
  | error(~who: #'RouterPlan, "target does not belong to this router plan")
  found

class RouterPlanRow(route_row :: RouteTableRow,
                    route_key :: Nat,
                    origin_key :: Nat,
                    target_mask :: Nat,
                    fallback_mask :: Nat):
  opaque
  internal _RouterPlanRow
  constructor ~none

  method describe():
    String.append(route_row.describe(), "; route-key=", to_string(route_key),
                  "; origin-key=", to_string(origin_key),
                  "; target-mask=", to_string(target_mask),
                  "; fallback-mask=", to_string(fallback_mask))

fun fallback_vc(validated_routing :: ValidatedRouting, vc :: VCId):
  if validated_routing.certificate is_a EscapeCertificate
  | validated_routing.certificate.request.contains(vc)
  | #true

fun make_plan_row(validated_routing :: ValidatedRouting,
                  route_classes :: List.of(RouteClass),
                  origins :: List.of(Injection || HeldVC),
                  targets :: List.of(VCId || EjectionTerminal),
                  route_row :: RouteTableRow):
  def route_key = require_route_key(route_classes, route_row.route_class)
  def origin_key = require_origin_key(origins, route_row.origin)
  def mutable target_mask = 0
  def mutable fallback_mask = 0
  for (vc in route_row.allowed_vcs):
    def bit = require_target_bit(targets, vc)
    target_mask := target_mask bits.or (1 << bit)
    when fallback_vc(validated_routing, vc)
    | fallback_mask := fallback_mask bits.or (1 << bit)
  when route_row.ejection_terminal
  | def bit = require_target_bit(targets, route_row.ejection_terminal)
    target_mask := target_mask bits.or (1 << bit)
    // Ejection releases the held network resource and is always a safe
    // fallback even though terminals are not vertices in the escape graph.
    fallback_mask := fallback_mask bits.or (1 << bit)
  _RouterPlanRow(route_row,
                 route_key,
                 origin_key,
                 target_mask,
                 fallback_mask)

class RouterPlan(validated_routing :: ValidatedRouting,
                 node :: NodeId,
                 route_classes :: NonemptyList.of(RouteClass),
                 injection_terminals :: List.of(InjectionTerminal),
                 ejection_terminals :: List.of(EjectionTerminal),
                 origins :: List.of(Injection || HeldVC),
                 output_vcs :: List.of(VCId),
                 targets :: List.of(VCId || EjectionTerminal),
                 rows :: List.of(RouterPlanRow)):
  constructor (validated_routing :: ValidatedRouting, node :: NodeId):
    unless validated_routing.topology.contains_node(node)
    | error(~who: #'RouterPlan, "router node does not belong to the topology")
    def route_classes = validated_routing.route_classes
    def injection_terminals = injection_terminals_at(validated_routing, node)
    def ejection_terminals = ejection_terminals_at(validated_routing, node)
    def held_origins = incoming_vcs(
      validated_routing.topology,
      node
    ).map(fun (vc): HeldVC(vc))
    def origins = injection_terminals.map(
      fun (terminal): Injection(terminal)
    ) ++ held_origins
    def output_vcs = validated_routing.topology.outgoing_vcs(node)
    def targets = output_vcs ++ ejection_terminals
    def rows = validated_routing.route_table.rows_at(node).map(
      fun (route_row):
        make_plan_row(validated_routing,
                      route_classes,
                      origins,
                      targets,
                      route_row)
    )
    super(validated_routing,
          node,
          route_classes,
          injection_terminals,
          ejection_terminals,
          origins,
          output_vcs,
          targets,
          rows)

  method route_key(route_class :: RouteClass):
    require_route_key(route_classes, route_class)

  method origin_key(origin :~ Injection || HeldVC):
    require_origin_key(origins, origin)

  method target_bit(target :~ VCId || EjectionTerminal):
    require_target_bit(targets, target)

  method row(route_class :: RouteClass, origin :: Injection || HeldVC):
    def encoded_route = route_key(route_class)
    def encoded_origin = origin_key(origin)
    def found = rows.find(
      fun (candidate):
        candidate.route_key == encoded_route && (
          candidate.origin_key == encoded_origin
        )
    )
    unless found
    | error(~who: #'RouterPlan, "unknown local route row")
    found

  method describe():
    String.append("router plan ", node.describe(),
                  ": routes=", to_string(route_classes.length()),
                  ", inputs=", to_string(origins.length()),
                  ", targets=", to_string(targets.length()),
                  ", rows=", to_string(rows.length()))
