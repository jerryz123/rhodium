#lang rhombus
/* Projects normalized routing failures through authoring provenance without re-evaluating
   policies. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../model/main.rhm" open
  "../analysis/main.rhm" open
  "../authoring/main.rhm" open
  "validated-routing.rhm" open

export:
  AuthoredCycleCause
  AuthoredCycleEdge
  AuthoredDependencyCycle
  AuthoredRoutingFailure
  AuthoredRoutingCompilation
  compile_authored_routing

/* Compares normalized origin kind and terminal or VC identity. */
fun origin_equal(left :: Injection || HeldVC, right :: Injection || HeldVC):
  cond
  | left is_a Injection && right is_a Injection:
      injection_id_equal(left.terminal.id, right.terminal.id)
  | left is_a HeldVC && right is_a HeldVC:
      vc_id_equal(left.vc, right.vc)
  | ~else: #false

/* Matches recorded authored evidence to the exact materialized query. */
fun evidence_matches(evidence :: LoweredRoutingDecision,
                     decision :: MaterializedDecision):
  evidence.route_class === decision.route_class && origin_equal(
    evidence.origin,
    decision.origin
  ) && vc_id_equal(evidence.candidate_vc, decision.candidate_vc)

/* Resolves recorded query provenance and checks agreement without reevaluating the policy. */
fun find_evidence(lowering :: RoutingPolicyLowering,
                  decision :: MaterializedDecision):
  def found = lowering.decisions.find(
    fun (evidence): evidence_matches(evidence, decision)
  )
  unless found
  | error(~who: #'compile_authored_routing,
          "materialized decision has no authored provenance")
  unless found.allowed == decision.allowed
  | error(~who: #'compile_authored_routing,
          "authored provenance disagrees with its materialized decision")
  found

/* Uses matched rule names when present, otherwise the recorded policy's description. */
fun evidence_rule_names(lowering :: RoutingPolicyLowering,
                        evidence :: LoweredRoutingDecision):
  if evidence.rule_names.length() > 0
  | evidence.rule_names
  | [lowering.policy.describe()]

/* Describes one normalized cycle contribution using authored route, origin, VC, and rule names. */
class AuthoredCycleCause(route_class :: RouteClassRef,
                         origin :: RoutingOrigin,
                         candidate_vc :: VCRef,
                         rule_names :: List.of(String)):
  /* Formats the symbolic query and its contributing rules. */
  method describe():
    String.append(
      "route ", route_class.describe(),
      "; ", origin.describe(),
      " -> ", candidate_vc.describe(),
      "; rules=[", String.join(rule_names, ", "), "]"
    )

/* Pairs a symbolic held/requested VC edge with all authored causes. */
class AuthoredCycleEdge(source_vc :: VCRef,
                        target_vc :: VCRef,
                        causes :: List.of(AuthoredCycleCause)):
  /* Formats the dependency edge followed by its authored causes. */
  method describe():
    def cause_rows = causes.map(
      fun (cause): "    " ++ cause.describe()
    )
    String.append(
      "  ", source_vc.describe(), " -> ", target_vc.describe(),
      "\n", String.join(cause_rows, "\n")
    )

/* Retains the normalized cycle and its symbolic, provenance-preserving projection. */
class AuthoredDependencyCycle(normalized_cycle :: DependencyCycle,
                              edges :: List.of(AuthoredCycleEdge)):
  /* Lists the authored dependency-cycle edges and their causes. */
  method describe():
    "authored VC dependency cycle:\n" ++ String.join(
      edges.map(fun (edge): edge.describe()),
      "\n"
    )

/* Describes an escape closure, entry, or progress failure in symbolic authoring terms. */
class AuthoredRoutingFailure(kind :: String,
                             route_class :: RouteClassRef,
                             origin :: RoutingOrigin,
                             candidate_vc :: maybe(VCRef),
                             rule_names :: List.of(String)):
  /* Formats the failure kind, origin, and optional candidate/rule details. */
  method describe():
    def candidate:
      if !candidate_vc
      | ""
      | " -> " ++ candidate_vc.describe()
    def rules:
      if rule_names.length() == 0
      | ""
      | "; rules=[" ++ String.join(rule_names, ", ") ++ "]"
    String.append(kind, " for route ", route_class.describe(),
                  " at ", origin.describe(), candidate, rules)

/* Retains the normalized result, recorded policy evaluations, and optional authored diagnostic. */
class AuthoredRoutingCompilation(
      result :: ValidatedRouting || DependencyCycle || EscapeClosureViolation || MissingEscapeEntry || MissingEscapeRoute,
      lowering :: RoutingPolicyLowering,
      diagnostic :: maybe(AuthoredDependencyCycle || AuthoredRoutingFailure)):
  /* Returns the evaluations recorded during the original materialization pass. */
  method decision_provenance(): lowering.decisions

/* Recovers an authored injection or forwarding origin through topology provenance. */
fun symbolic_origin(lowered_topology :: LoweredTopology,
                    origin :: Injection || HeldVC):
  cond
  | origin is_a Injection:
      RoutingInjection(
        lowered_topology.injection_ref(origin.terminal.id),
        lowered_topology.node_ref(origin.terminal.router)
      )
  | origin is_a HeldVC:
      RoutingForwarding(lowered_topology.vc_ref(origin.vc))

/* Projects one materialized dependency contribution through its recorded symbolic evaluation. */
fun cycle_cause(lowering :: RoutingPolicyLowering,
                decision :: MaterializedDecision):
  def evidence = find_evidence(lowering, decision)
  AuthoredCycleCause(
    evidence.context.route_class.ref,
    evidence.context.origin,
    evidence.context.candidate_vc,
    evidence_rule_names(lowering, evidence)
  )

/* Replaces normalized cycle endpoints with symbolic references while retaining the original
   witness. */
fun authored_cycle(lowering :: RoutingPolicyLowering,
                   cycle :: DependencyCycle):
  def lowered_topology = lowering.lowered_routes.lowered_topology
  def edges = for List (edge in cycle.edges):
    AuthoredCycleEdge(
      lowered_topology.vc_ref(edge.source_vc),
      lowered_topology.vc_ref(edge.target_vc),
      edge.decisions.map(fun (decision): cycle_cause(lowering, decision))
    )
  AuthoredDependencyCycle(cycle, edges)

/* Projects escape validation failures using stored query evidence or normalized-origin provenance. */
fun authored_failure(lowering :: RoutingPolicyLowering,
                     result :: ValidatedRouting || EscapeClosureViolation || MissingEscapeEntry || MissingEscapeRoute):
  def lowered_routes = lowering.lowered_routes
  def lowered_topology = lowered_routes.lowered_topology
  cond
  | result is_a EscapeClosureViolation:
      def evidence = find_evidence(lowering, result.decision)
      AuthoredRoutingFailure(
        "escape closure violation",
        evidence.context.route_class.ref,
        evidence.context.origin,
        evidence.context.candidate_vc,
        evidence_rule_names(lowering, evidence)
      )
  | result is_a MissingEscapeEntry:
      AuthoredRoutingFailure(
        "missing viable escape entry",
        lowered_routes.route_ref(result.route_class.id),
        symbolic_origin(lowered_topology, result.origin),
        #false,
        []
      )
  | result is_a MissingEscapeRoute:
      AuthoredRoutingFailure(
        "missing escape-only route",
        lowered_routes.route_ref(result.route_class.id),
        symbolic_origin(lowered_topology, result.origin),
        #false,
        []
      )
  | ~else: #false

/* Recovers the snapshot from a validated result or dependency-cycle witness. */
fun materialized_result(result :: ValidatedRouting || DependencyCycle || EscapeClosureViolation || MissingEscapeEntry || MissingEscapeRoute):
  cond
  | result is_a ValidatedRouting: result.materialized
  | result is_a DependencyCycle: result.graph.reachable.materialized
  | ~else: #false

/* Compiles once with recorded evaluations and translates failures without querying the policy
   again. */
fun compile_authored_routing(lowered_routes :: LoweredRouteClasses,
                             policy :: RoutingPolicy,
                             ~escape: escape_request :: maybe(EscapeValidationRequest) = #false):
  def lowering = lower_routing_policy_with_evidence(lowered_routes, policy)
  def result = compile_routing(
    RoutingProblem(
      lowered_routes.lowered_topology.topology,
      lowered_routes.route_classes,
      lowering.relation()
    ),
    ~escape: escape_request
  )
  def materialized = materialized_result(result)
  when materialized && lowering.decisions.length() != materialized.decisions.length()
  | error(~who: #'compile_authored_routing,
          "authored provenance does not cover every materialized decision")
  def diagnostic:
    if result is_a DependencyCycle
    | authored_cycle(lowering, result)
    | authored_failure(lowering, result)
  AuthoredRoutingCompilation(result, lowering, diagnostic)
