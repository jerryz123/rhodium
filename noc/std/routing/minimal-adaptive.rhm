#lang rhombus
// Defines topology-independent minimal-adaptive routing over precomputed hop distances.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../model/main.rhm" open
  "../../analysis/main.rhm" open
  "../../authoring/main.rhm" open

export:
  MinimalAdaptivePolicy
  minimal_adaptive

fun duplicate_name(names :: List.of(String), name :: String):
  names.filter(~keep: fun (candidate): candidate == name).length() > 1

fun topology_has_vc_group(spec :: TopologySpec, name :: String):
  spec.links.find(
    fun (link):
      link.vc_groups.find(fun (group): group.name == name) != #false
  ) != #false

fun validate_vc_groups(lowered_topology :: LoweredTopology,
                       vc_groups :: NonemptyList.of(String)):
  for (name in vc_groups):
    unless name.length() > 0 && !name.contains("/")
    | error(~who: #'minimal_adaptive,
            "minimal-adaptive VC groups must contain names without '/'")
    when duplicate_name(vc_groups, name)
    | error(~who: #'minimal_adaptive,
            "duplicate minimal-adaptive VC group " ++ name)
    unless topology_has_vc_group(lowered_topology.spec, name)
    | error(~who: #'minimal_adaptive,
            "topology has no VC group " ++ name)

class MinimalAdaptivePolicy(lowered_topology :: LoweredTopology,
                            distances :: HopDistances,
                            vc_groups :: NonemptyList.of(String)):
  implements RoutingPolicy
  constructor (lowered_topology :: LoweredTopology,
               distances :: HopDistances,
               vc_groups :: NonemptyList.of(String)):
    unless distances.topology === lowered_topology.topology
    | error(~who: #'minimal_adaptive,
            "hop distances must belong to the lowered topology")
    validate_vc_groups(lowered_topology, vc_groups)
    super(lowered_topology,
          distances,
          vc_groups.sort(fun (left, right): left < right))

  override method allows(context :: RoutingContext):
    def current_node = lowered_topology.node_id(context.current_node)
    def destination = lowered_topology.node_id(
      context.destination_router
    )
    def candidate_link_id = lowered_topology.link_id(
      context.candidate_link()
    )
    def candidate_link = lowered_topology.topology.find_link(
      candidate_link_id
    )
    def group_allowed = vc_groups.find(
      fun (name): name == context.candidate_vc.group
    ) != #false
    node_id_equal(candidate_link.source, current_node) && group_allowed && distances.link_is_minimal(
      candidate_link_id,
      destination
    )

  override method evaluate(context :: RoutingContext):
    RoutingPolicyEvaluation(allows(context), [])

  override method describe():
    "minimal-adaptive(vc-groups=" ++ String.join(vc_groups, ",") ++ ")"

fun minimal_adaptive(lowered_topology :: LoweredTopology,
                     distances :: HopDistances,
                     vc_groups :: NonemptyList.of(String)):
  MinimalAdaptivePolicy(lowered_topology, distances, vc_groups)
