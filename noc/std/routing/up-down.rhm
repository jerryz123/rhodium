#lang rhombus
// Synthesizes deterministic up*/down* routing for connected bidirectional topologies.

import:
  "../../model/main.rhm" open
  "../../authoring/main.rhm" open

export:
  UpDownNodeOrder
  UpDownViableState
  UpDownPolicy
  up_down

def up_phase = "up"
def down_phase = "down"

fun contains_name(names :: List.of(String), name :: String):
  names.contains(name)

fun duplicate_name(names :: List.of(String), name :: String):
  names.filter(~keep: fun (candidate): candidate == name).length() > 1

fun contains_node_ref(nodes :: List.of(NodeRef), node :: NodeRef):
  nodes.find(fun (candidate): node_ref_equal(candidate, node)) != #false

fun reverse_link_exists(topology :: Topology, link :: PhysicalLink):
  topology.links.find(
    fun (candidate):
      node_id_equal(candidate.source, link.destination) && node_id_equal(
        candidate.destination,
        link.source
      )
  ) != #false

fun validate_vc_groups(lowered_topology :: LoweredTopology,
                       vc_groups :: NonemptyList.of(String)):
  for (name in vc_groups):
    unless name.length() > 0 && !name.contains("/")
    | error(~who: #'up_down,
            "up/down VC groups must contain names without '/'")
    when duplicate_name(vc_groups, name)
    | error(~who: #'up_down,
            "duplicate up/down VC group " ++ name)
    unless lowered_topology.spec.links.find(
      fun (link): link.vc_groups.find(fun (group): group.name == name)
    )
    | error(~who: #'up_down,
            "topology has no up/down VC group " ++ name)
    for (link in lowered_topology.spec.links):
      unless link.vc_groups.find(fun (group): group.name == name)
      | error(~who: #'up_down,
              String.append("link ", link.ref.describe(),
                            " has no up/down VC group ", name))

fun validate_suitable_topology(lowered_topology :: LoweredTopology):
  for (link in lowered_topology.topology.links):
    when node_id_equal(link.source, link.destination)
    | error(~who: #'up_down,
            String.append(
              "up/down routing does not support self-loop link ",
              lowered_topology.link_ref(link.id).describe()
            ))
    unless reverse_link_exists(lowered_topology.topology, link)
    | error(~who: #'up_down,
            String.append(
              "up/down routing requires a reverse link for ",
              lowered_topology.link_ref(link.id).describe()
            ))

class UpDownNodeOrder(node :: NodeRef,
                      depth :: Nat,
                      rank :: Nat,
                      parent :: False || NodeRef):
  method describe():
    String.append(node.describe(), ": depth=", to_string(depth),
                  ", rank=", to_string(rank), ", parent=",
                  (if parent | parent.describe() | "root"))

fun find_node_order(orders :: List.of(UpDownNodeOrder), node :: NodeRef):
  orders.find(fun (order): node_ref_equal(order.node, node))

fun unique_sorted_neighbors(lowered_topology :: LoweredTopology,
                            node :: NodeRef):
  def node_id = lowered_topology.node_id(node)
  def mutable neighbors = []
  for (link in lowered_topology.topology.outgoing_links(node_id)):
    def neighbor = lowered_topology.node_ref(link.destination)
    unless contains_node_ref(neighbors, neighbor)
    | neighbors := neighbors ++ [neighbor]
  neighbors.sort(node_ref_less)

fun build_node_orders(lowered_topology :: LoweredTopology, root :: NodeRef):
  def mutable pending = [root]
  def mutable orders = [UpDownNodeOrder(root, 0, 0, #false)]
  while pending.length() > 0:
    def node = pending[0]
    pending := pending.drop(1)
    def order = find_node_order(orders, node)
    for (neighbor in unique_sorted_neighbors(lowered_topology, node)):
      unless find_node_order(orders, neighbor)
      | orders := orders ++ [
          UpDownNodeOrder(neighbor, order.depth + 1, orders.length(), node)
        ]
        pending := pending ++ [neighbor]
  unless orders.length() == lowered_topology.spec.nodes.length()
  | def missing = lowered_topology.spec.nodes.find(
      fun (node): !find_node_order(orders, node)
    )
    error(~who: #'up_down,
          "up/down root cannot reach disconnected node " ++ missing.describe())
  orders

fun link_direction(lowered_topology :: LoweredTopology,
                   orders :: List.of(UpDownNodeOrder),
                   link_ref :: LinkRef):
  def link = lowered_topology.topology.find_link(
    lowered_topology.link_id(link_ref)
  )
  def source = lowered_topology.node_ref(link.source)
  def destination = lowered_topology.node_ref(link.destination)
  def source_rank = find_node_order(orders, source).rank
  def destination_rank = find_node_order(orders, destination).rank
  if destination_rank < source_rank | up_phase | down_phase

fun next_phase(direction :: String):
  if direction == down_phase | down_phase | up_phase

fun turn_allowed(phase :: String, direction :: String):
  phase == up_phase || direction == down_phase

class UpDownViableState(node :: NodeRef,
                        destination :: NodeRef,
                        phase :: String):
  method describe():
    String.append(node.describe(), " -> ", destination.describe(),
                  " [", phase, "]")

fun viable_state_exists(states :: List.of(UpDownViableState),
                        node :: NodeRef,
                        destination :: NodeRef,
                        phase :: String):
  states.find(
    fun (state):
      node_ref_equal(state.node, node) && node_ref_equal(
        state.destination,
        destination
      ) && state.phase == phase
  ) != #false

fun outgoing_specs(spec :: TopologySpec, node :: NodeRef):
  spec.links.filter(~keep: fun (link): node_ref_equal(link.source, node))

fun state_has_progress(lowered_topology :: LoweredTopology,
                       orders :: List.of(UpDownNodeOrder),
                       states :: List.of(UpDownViableState),
                       node :: NodeRef,
                       destination :: NodeRef,
                       phase :: String):
  outgoing_specs(lowered_topology.spec, node).find(
    fun (link):
      def direction = link_direction(lowered_topology, orders, link.ref)
      turn_allowed(phase, direction) && viable_state_exists(
        states,
        link.destination,
        destination,
        next_phase(direction)
      )
  ) != #false

fun build_viable_states(lowered_topology :: LoweredTopology,
                        orders :: List.of(UpDownNodeOrder)):
  def mutable states = []
  for (destination in lowered_topology.spec.nodes):
    states := states ++ [
      UpDownViableState(destination, destination, up_phase),
      UpDownViableState(destination, destination, down_phase)
    ]
    def mutable changed = #true
    while changed:
      changed := #false
      for (node in lowered_topology.spec.nodes):
        for (phase in [up_phase, down_phase]):
          unless viable_state_exists(states, node, destination, phase)
          | when state_has_progress(
              lowered_topology,
              orders,
              states,
              node,
              destination,
              phase
            )
            | states := states ++ [
                UpDownViableState(node, destination, phase)
              ]
              changed := #true
  states

class UpDownPolicy(lowered_topology :: LoweredTopology,
                   root :: NodeRef,
                   vc_groups :: NonemptyList.of(String),
                   node_orders :: List.of(UpDownNodeOrder),
                   viable_states :: List.of(UpDownViableState)):
  implements RoutingPolicy
  constructor (lowered_topology :: LoweredTopology,
               root :: NodeRef,
               vc_groups :: NonemptyList.of(String)):
    unless contains_node_ref(lowered_topology.spec.nodes, root)
    | error(~who: #'up_down,
            "up/down root is not in topology: " ++ root.describe())
    validate_vc_groups(lowered_topology, vc_groups)
    validate_suitable_topology(lowered_topology)
    def sorted_groups = vc_groups.sort(fun (left, right): left < right)
    def orders = build_node_orders(lowered_topology, root)
    def states = build_viable_states(lowered_topology, orders)
    super(lowered_topology, root, sorted_groups, orders, states)

  method node_order(node :: NodeRef):
    def found = find_node_order(node_orders, node)
    unless found
    | error(~who: #'node_order,
            "node is not in up/down topology: " ++ node.describe())
    found

  method direction_of(link :: LinkRef):
    link_direction(lowered_topology, node_orders, link)

  method viable(node :: NodeRef,
                destination :: NodeRef,
                phase :: String = up_phase):
    unless phase == up_phase || phase == down_phase
    | error(~who: #'viable,
            "up/down phase must be 'up' or 'down'")
    node_order(node)
    node_order(destination)
    viable_state_exists(viable_states, node, destination, phase)

  method initial_phase(context :: RoutingContext):
    cond
    | context.origin is_a RoutingInjection: up_phase
    | context.origin is_a RoutingForwarding:
        if contains_name(vc_groups, context.origin.vc.group)
        | next_phase(direction_of(context.origin.vc.link))
        | up_phase
    | ~else: up_phase

  override method allows(context :: RoutingContext):
    def candidate_group_allowed = contains_name(
      vc_groups,
      context.candidate_vc.group
    )
    def candidate_link = lowered_topology.spec.find_link(
      context.candidate_link()
    )
    def direction = direction_of(candidate_link.ref)
    def phase = initial_phase(context)
    candidate_group_allowed && node_ref_equal(
      candidate_link.source,
      context.current_node
    ) && turn_allowed(phase, direction) && viable(
      candidate_link.destination,
      context.destination_router,
      next_phase(direction)
    )

  override method evaluate(context :: RoutingContext):
    RoutingPolicyEvaluation(allows(context), [])

  override method describe():
    String.append("up-down(root=", root.describe(),
                  "; vc-groups=", String.join(vc_groups, ","), ")")

fun up_down(lowered_topology :: LoweredTopology,
            root :: NodeRef,
            vc_groups :: NonemptyList.of(String)):
  UpDownPolicy(lowered_topology, root, vc_groups)
