#lang rhombus
// Defines reusable ordered source/destination route classes for any authored topology.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../authoring/main.rhm" open

export:
  all_pairs_route_ref
  all_pairs

fun route_prefix_path(value :: NamePath || RouteClassRef || String || List.of(String)):
  if value is_a NamePath
  | value
  | if value is_a RouteClassRef
    | value.path
    | RouteClassRef(value).path

fun encoded_terminal_path(terminal :: InjectionRef || EjectionRef):
  terminal.path.segments.map(fun (segment): "terminal=" ++ segment)

fun all_pairs_route_ref(source :: InjectionRef,
                        destination :: EjectionRef,
                        ~prefix: prefix :: NamePath || RouteClassRef || String || List.of(String) = "all-pairs"):
  def prefix_path = route_prefix_path(prefix)
  def from_path = prefix_path.segments ++ ["from"]
  def source_path = from_path ++ encoded_terminal_path(source)
  def to_path = source_path ++ ["to"]
  RouteClassRef(
    NamePath(to_path ++ encoded_terminal_path(destination))
  )

fun all_pairs(topology :: TopologySpec,
              ~include_local: include_local :: Boolean = #false,
              ~prefix: prefix :: NamePath || RouteClassRef || String || List.of(String) = "all-pairs"):
  // Resolve the prefix even for an empty result so invalid names fail eagerly.
  def prefix_path = route_prefix_path(prefix)
  def mutable specs = []
  for (source in topology.injections):
    for (destination in topology.ejections):
      when include_local || !node_ref_equal(source.router, destination.router)
      | specs := specs ++ [
          RouteClassSpec(
            all_pairs_route_ref(source.ref,
                                destination.ref,
                                ~prefix: prefix_path),
            source.ref,
            destination.ref
          )
        ]
  specs.sort(
    fun (left, right): route_class_ref_less(left.ref, right.ref)
  )
