#lang rhombus
/* Projects reachable held-VC transitions into a deterministic dependency graph with provenance. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../model/main.rhm" open
  "materialize.rhm" open
  "reachability.rhm" open

export:
  VCDependencyEdge
  VCDependencyGraph
  build_dependency_graph

/* Appends a VC only when its normalized identity is not already present. */
fun append_unique_vc(vcs :: List.of(VCId), vc :: VCId):
  if vcs.find(fun (candidate): vc_id_equal(candidate, vc))
  | vcs
  | vcs ++ [vc]

/* Tests VC membership by normalized identity. */
fun contains_vc(vcs :: List.of(VCId), vc :: VCId):
  vcs.find(fun (candidate): vc_id_equal(candidate, vc)) != #false

/* Retains a held-to-requested VC edge and all reachable decisions contributing to it. */
class VCDependencyEdge(source_vc :: VCId,
                       target_vc :: VCId,
                       decisions :: NonemptyList.of(MaterializedDecision)):
  opaque
  internal _VCDependencyEdge
  /* Keeps dependency-edge construction within the graph projection module. */
  constructor ~none

  /* Deduplicates contributing route objects in provenance order. */
  method route_classes():
    def mutable route_classes = []
    for (decision in decisions):
      unless route_classes.find(
        fun (route_class): route_class === decision.route_class
      )
      | route_classes := route_classes ++ [decision.route_class]
    route_classes

  /* Formats both resources and the routes contributing this dependency. */
  method describe():
    def route_names = route_classes().map(
      fun (route_class): route_class.id.describe()
    )
    String.append(source_vc.describe(), " -> ", target_vc.describe(), " [",
                  String.join(route_names, ", "), "]")

/* Matches a dependency by its source and target VC identities. */
fun edge_matches(edge :: VCDependencyEdge, source_vc :: VCId, target_vc :: VCId):
  vc_id_equal(edge.source_vc, source_vc) && vc_id_equal(edge.target_vc, target_vc)

/* Orders edges by source VC, then target VC. */
fun edge_less(left :: VCDependencyEdge, right :: VCDependencyEdge):
  if vc_id_equal(left.source_vc, right.source_vc)
  | vc_id_less(left.target_vc, right.target_vc)
  | vc_id_less(left.source_vc, right.source_vc)

/* Stores a deterministic resource graph linked to its original reachability evidence. */
class VCDependencyGraph(reachable :: ReachableRouting,
                        vertices :: List.of(VCId),
                        edges :: List.of(VCDependencyEdge)):
  opaque
  internal _VCDependencyGraph
  /* Restricts graph construction to certified reachability projection in this module. */
  constructor ~none

  /* Tests whether a VC belongs to this dependency graph. */
  method contains_vertex(vc :: VCId):
    vertices.find(
      fun (candidate): vc_id_equal(candidate, vc)
    ) != #false

  /* Reports attempts to query a VC absent from the graph. */
  private method require_vertex(vc :: VCId):
    unless contains_vertex(vc)
    | error(~who: #'VCDependencyGraph,
            "VC is not a dependency-graph vertex: " ++ vc.describe())

  /* Resolves a directed dependency after validating both resource vertices. */
  method find_edge(source_vc :: VCId, target_vc :: VCId):
    require_vertex(source_vc)
    require_vertex(target_vc)
    def found = edges.find(
      fun (edge): edge_matches(edge, source_vc, target_vc)
    )
    unless found
    | error(~who: #'VCDependencyGraph,
            String.append("unknown dependency edge ", source_vc.describe(),
                          " -> ", target_vc.describe()))
    found

  /* Returns dependencies requesting another resource while holding the selected VC. */
  method outgoing_edges(vc :: VCId):
    require_vertex(vc)
    edges.filter(
      ~keep: fun (edge): vc_id_equal(edge.source_vc, vc)
    )

  /* Returns dependencies whose requested resource is the selected VC. */
  method incoming_edges(vc :: VCId):
    require_vertex(vc)
    edges.filter(
      ~keep: fun (edge): vc_id_equal(edge.target_vc, vc)
    )

  /* Builds an induced graph over unique known vertices while preserving provenance. */
  method project(selected_vertices :: List.of(VCId)):
    for (vc in selected_vertices):
      unless contains_vertex(vc)
      | error(~who: #'project,
              "projection VC is not a dependency-graph vertex: " ++ vc.describe())
      when selected_vertices.filter(
        ~keep: fun (candidate): vc_id_equal(candidate, vc)
      ).length() > 1
      | error(~who: #'project,
              "duplicate dependency-graph projection VC " ++ vc.describe())
    def sorted_vertices = selected_vertices.sort(vc_id_less)
    def projected_edges = edges.filter(
      ~keep: fun (edge): contains_vc(sorted_vertices, edge.source_vc) && contains_vc(
        sorted_vertices,
        edge.target_vc
      )
    )
    _VCDependencyGraph(reachable, sorted_vertices, projected_edges)

  /* Lists dependencies in stable source/target order. */
  method describe():
    String.join(edges.map(fun (edge): edge.describe()), "\n")

/* Merges a repeated resource edge while retaining every contributing materialized decision. */
fun add_dependency(edges :: List.of(VCDependencyEdge),
                   decision :: MaterializedDecision):
  def source_vc = decision.origin.vc
  def target_vc = decision.candidate_vc
  def existing = edges.find(
    fun (edge): edge_matches(edge, source_vc, target_vc)
  )
  if existing
  | edges.map(
      fun (edge):
        if edge === existing
        | _VCDependencyEdge(source_vc, target_vc,
                            existing.decisions ++ [decision])
        | edge
    )
  | edges ++ [_VCDependencyEdge(source_vc, target_vc, [decision])]

/* Projects reachable held-VC acquisitions; injection and ejection add no held-resource edges. */
fun build_dependency_graph(reachable :: ReachableRouting):
  def mutable vertices = []
  def mutable edges = []
  for (route in reachable.routes):
    for (vc in route.reachable_vcs):
      vertices := append_unique_vc(vertices, vc)
    for (decision in route.reachable_decisions):
      // Injection acquires the first VC while holding no VC resource.
      when decision.origin is_a HeldVC
      | edges := add_dependency(edges, decision)
  _VCDependencyGraph(
    reachable,
    vertices.sort(vc_id_less),
    edges.sort(edge_less)
  )
