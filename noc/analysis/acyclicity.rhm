#lang rhombus
/* Proves VC dependency acyclicity with stable ranks or returns a provenance-carrying cycle. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../model/main.rhm" open
  "dependency-graph.rhm" open

export:
  AcyclicCertificate
  DependencyCycle
  check_dependency_acyclicity

/* Tests VC membership by normalized identity. */
fun contains_vc(vcs :: List.of(VCId), vc :: VCId):
  vcs.find(fun (candidate): vc_id_equal(candidate, vc)) != #false

/* Finds the first matching VC position, returning false when absent. */
fun vc_index(vcs :: List.of(VCId), vc :: VCId):
  def mutable found = #false
  for (index in 0..vcs.length()):
    when !found && vc_id_equal(vcs[index], vc)
    | found := index
  found

/* Retains a stable topological resource order under the VC hold-and-request model. */
class AcyclicCertificate(graph :: VCDependencyGraph,
                         ordered_vcs :: List.of(VCId)):
  opaque
  internal _AcyclicCertificate
  /* Restricts certificate construction to this module's acyclicity check. */
  constructor ~none

  /* Returns a VC's certified topological position or reports a missing resource. */
  method rank(vc :: VCId):
    def found = vc_index(ordered_vcs, vc)
    when !found
    | error(~who: #'AcyclicCertificate,
            "VC has no certified rank: " ++ vc.describe())
    found

  /* Compares two certified resource ranks. */
  method before(left :: VCId, right :: VCId):
    rank(left) < rank(right)

  /* Lists the deterministic rank assigned to each resource. */
  method describe():
    def rows = for List (index in 0..ordered_vcs.length()):
      String.append(to_string(index), ": ", ordered_vcs[index].describe())
    String.join(rows, "\n")

/* Carries a closed dependency witness with original edge provenance. */
class DependencyCycle(graph :: VCDependencyGraph,
                      edges :: List.of(VCDependencyEdge)):
  opaque
  internal _DependencyCycle
  /* Keeps cycle-witness construction inside the deterministic graph search. */
  constructor ~none

  /* Returns the closed vertex sequence, including the repeated starting resource. */
  method vertices():
    if edges.length() == 0
    | []
    | [edges[0].source_vc] ++ edges.map(fun (edge): edge.target_vc)

  /* Collects all materialized decisions supporting the witness edges. */
  method decisions():
    def mutable provenance = []
    for (edge in edges):
      provenance := provenance ++ edge.decisions
    provenance

  /* Deduplicates the exact route objects implicated by the witness. */
  method route_classes():
    def mutable route_classes = []
    for (decision in decisions()):
      unless route_classes.find(
        fun (route_class): route_class === decision.route_class
      )
      | route_classes := route_classes ++ [decision.route_class]
    route_classes

  /* Formats the cycle edges and their route provenance. */
  method describe():
    def rows = edges.map(
      fun (edge): "  " ++ edge.describe()
    )
    String.append("VC dependency cycle:\n", String.join(rows, "\n"))

/* Tests whether a vertex still depends on an unremoved source resource. */
fun has_remaining_predecessor(graph :: VCDependencyGraph,
                              remaining :: List.of(VCId),
                              vc :: VCId):
  graph.incoming_edges(vc).find(
    fun (edge): contains_vc(remaining, edge.source_vc)
  ) != #false

/* Removes the first zero-predecessor vertex repeatedly, returning false on a cycle. */
fun stable_topological_order(graph :: VCDependencyGraph):
  def mutable remaining = graph.vertices
  def mutable ordered = []
  def mutable stuck = #false
  while remaining.length() > 0 && !stuck:
    def next = remaining.find(
      fun (vc): !has_remaining_predecessor(graph, remaining, vc)
    )
    if next
    | ordered := ordered ++ [next]
      remaining := remaining.filter(
        ~keep: fun (vc): !vc_id_equal(vc, next)
      )
    | stuck := #true
  if stuck | #false | ordered

/* Searches vertices and outgoing edges in stable order for one closed dependency witness. */
fun find_cycle(graph :: VCDependencyGraph):
  def mutable finished = []

  /* Tracks an active DFS path and turns a back edge into a provenance-preserving cycle. */
  fun visit(vc :: VCId,
            active_vertices :: List.of(VCId),
            active_edges :: List.of(VCDependencyEdge)):
    def current_vertices = active_vertices ++ [vc]
    def mutable cycle = #false
    for (edge in graph.outgoing_edges(vc)):
      unless cycle
      | block:
          def target_index = vc_index(current_vertices, edge.target_vc)
          if target_index
          | cycle := _DependencyCycle(
              graph,
              active_edges.drop(target_index) ++ [edge]
            )
          | unless contains_vc(finished, edge.target_vc)
            | cycle := visit(
                edge.target_vc,
                current_vertices,
                active_edges ++ [edge]
              )
    unless cycle
    | finished := finished ++ [vc]
    cycle

  def mutable cycle = #false
  for (vc in graph.vertices):
    unless cycle || contains_vc(finished, vc)
    | cycle := visit(vc, [], [])
  cycle

/* Returns a topological certificate or a cycle; this does not prove fairness or RTL correctness. */
fun check_dependency_acyclicity(graph :: VCDependencyGraph):
  def order = stable_topological_order(graph)
  if order
  | _AcyclicCertificate(graph, order)
  | block:
      def cycle = find_cycle(graph)
      unless cycle
      | error(~who: #'check_dependency_acyclicity,
              "internal error: cyclic graph has no cycle witness")
      cycle
