#lang rhombus
// Validates escape-subnetwork closure, entry, progress, and dependency acyclicity.
// SPDX-License-Identifier: Apache-2.0

import:
  "../model/main.rhm" open
  "materialize.rhm" open
  "reachability.rhm" open
  "dependency-graph.rhm" open
  "acyclicity.rhm" open

export:
  EscapeValidationRequest
  EscapeEntryEvidence
  EscapeRouteEvidence
  EscapeReachabilityEvidence
  EscapeClosureEvidence
  EscapeValidationEvidence
  EscapeClosureViolation
  MissingEscapeEntry
  MissingEscapeRoute
  validate_escape_subnetwork

fun contains_vc(vcs :: List.of(VCId), vc :: VCId):
  vcs.find(fun (candidate): vc_id_equal(candidate, vc)) != #false

fun duplicate_vc(vcs :: List.of(VCId), vc :: VCId):
  vcs.filter(~keep: fun (candidate): vc_id_equal(candidate, vc)).length() > 1

class EscapeValidationRequest(topology :: Topology,
                              escape_vcs :: NonemptyList.of(VCId)):
  constructor (topology :: Topology,
               escape_vcs :: NonemptyList.of(VCId)):
    for (vc in escape_vcs):
      unless topology.contains_vc(vc)
      | error(~who: #'EscapeValidationRequest,
              "escape VC does not belong to topology: " ++ vc.describe())
      when duplicate_vc(escape_vcs, vc)
      | error(~who: #'EscapeValidationRequest,
              "duplicate escape VC " ++ vc.describe())
    super(topology, escape_vcs.sort(vc_id_less))

  method contains(vc :: VCId):
    contains_vc(escape_vcs, vc)

  method describe():
    "escape-vcs=[" ++ String.join(
      escape_vcs.map(fun (vc): vc.describe()),
      ", "
    ) ++ "]"

class EscapeEntryEvidence(origin :: Injection || HeldVC,
                          decisions :: NonemptyList.of(MaterializedDecision)):
  opaque
  internal _EscapeEntryEvidence
  constructor ~none

  method describe():
    origin.describe() ++ " -> [" ++ String.join(
      decisions.map(fun (decision): decision.candidate_vc.describe()),
      ", "
    ) ++ "]"

class EscapeRouteEvidence(route_class :: RouteClass,
                          reachable_escape_vcs :: List.of(VCId),
                          viable_escape_vcs :: List.of(VCId),
                          escape_decisions :: List.of(MaterializedDecision),
                          entries :: List.of(EscapeEntryEvidence)):
  opaque
  internal _EscapeRouteEvidence
  constructor ~none

  method describe():
    String.append(route_class.id.describe(), ": escape-vcs=",
                  to_string(reachable_escape_vcs.length()),
                  ", entries=", to_string(entries.length()))

class EscapeReachabilityEvidence(reachable :: ReachableRouting,
                                 routes :: List.of(EscapeRouteEvidence)):
  opaque
  internal _EscapeReachabilityEvidence
  constructor ~none

  method for_route(route_class :: RouteClass):
    unless reachable.materialized.contains_route_class(route_class)
    | error(~who: #'EscapeReachabilityEvidence,
            "route class does not belong to this escape evidence")
    def found = routes.find(
      fun (route): route.route_class === route_class
    )
    unless found
    | error(~who: #'EscapeReachabilityEvidence,
            "route class has no escape reachability evidence")
    found

  method describe():
    String.join(routes.map(fun (route): route.describe()), "\n")

class EscapeClosureEvidence(decisions :: List.of(MaterializedDecision)):
  opaque
  internal _EscapeClosureEvidence
  constructor ~none

  method describe():
    "closed escape transitions=" ++ to_string(decisions.length())

class EscapeValidationEvidence(request :: EscapeValidationRequest,
                               reachability :: EscapeReachabilityEvidence,
                               closure :: EscapeClosureEvidence,
                               dependency_graph :: VCDependencyGraph,
                               acyclic_certificate :: AcyclicCertificate):
  opaque
  internal _EscapeValidationEvidence
  constructor ~none

class EscapeClosureViolation(route_class :: RouteClass,
                             decision :: MaterializedDecision):
  opaque
  internal _EscapeClosureViolation
  constructor ~none

  method describe():
    String.append("escape closure violation for route class ",
                  route_class.id.describe(), ": ",
                  decision.origin.describe(), " -> ",
                  decision.candidate_vc.describe(),
                  " leaves the escape VC set")

class MissingEscapeEntry(route_class :: RouteClass,
                         origin :: Injection || HeldVC):
  opaque
  internal _MissingEscapeEntry
  constructor ~none

  method describe():
    String.append("missing viable escape entry for route class ",
                  route_class.id.describe(), " at ", origin.describe())

class MissingEscapeRoute(route_class :: RouteClass,
                         origin :: Injection || HeldVC):
  opaque
  internal _MissingEscapeRoute
  constructor ~none

  method describe():
    String.append("missing escape-only route for route class ",
                  route_class.id.describe(), " at ", origin.describe(),
                  "; destination is ",
                  route_class.destination.describe())

fun origin_at_destination(materialized :: MaterializedRouting,
                          route_class :: RouteClass,
                          origin :: Injection || HeldVC):
  cond
  | origin is_a Injection:
      node_id_equal(origin.terminal.router, route_class.destination.router)
  | origin is_a HeldVC:
      node_id_equal(
        materialized.topology.find_vc_link(origin.vc).destination,
        route_class.destination.router
      )

fun allowed_decisions(materialized :: MaterializedRouting,
                      route_class :: RouteClass,
                      origin :: Injection || HeldVC):
  materialized.decisions_for(route_class, origin).filter(
    ~keep: fun (decision): decision.allowed
  )

fun escape_decisions(materialized :: MaterializedRouting,
                     request :: EscapeValidationRequest,
                     route_class :: RouteClass,
                     origin :: Injection || HeldVC):
  allowed_decisions(materialized, route_class, origin).filter(
    ~keep: fun (decision): request.contains(decision.candidate_vc)
  )

fun reachable_escape_vcs(route :: RouteReachability,
                         request :: EscapeValidationRequest):
  route.reachable_vcs.filter(
    ~keep: fun (vc): request.contains(vc)
  ).sort(vc_id_less)

fun find_closure_violation(materialized :: MaterializedRouting,
                           reachable :: ReachableRouting,
                           request :: EscapeValidationRequest):
  def mutable violation = #false
  def mutable closed_decisions = []
  for (route in reachable.routes):
    for (vc in reachable_escape_vcs(route, request)):
      unless violation
      | for (decision in allowed_decisions(
          materialized,
          route.route_class,
          HeldVC(vc)
        )):
          if request.contains(decision.candidate_vc)
          | closed_decisions := closed_decisions ++ [decision]
          | unless violation
            | violation := _EscapeClosureViolation(
                route.route_class,
                decision
              )
  if violation
  | violation
  | _EscapeClosureEvidence(closed_decisions)

fun viable_escape_vcs(materialized :: MaterializedRouting,
                      route_class :: RouteClass,
                      escape_vcs :: List.of(VCId),
                      request :: EscapeValidationRequest):
  def mutable viable = escape_vcs.filter(
    ~keep: fun (vc): origin_at_destination(materialized, route_class, HeldVC(vc))
  )
  def mutable changed = #true
  while changed:
    changed := #false
    for (vc in escape_vcs):
      unless contains_vc(viable, vc)
      | def has_progress = escape_decisions(
          materialized,
          request,
          route_class,
          HeldVC(vc)
        ).find(
          fun (decision): contains_vc(viable, decision.candidate_vc)
        ) != #false
        when has_progress
        | viable := viable ++ [vc]
          changed := #true
  viable.sort(vc_id_less)

fun analyze_escape_route(materialized :: MaterializedRouting,
                         reachable_route :: RouteReachability,
                         request :: EscapeValidationRequest):
  def route_class = reachable_route.route_class
  def route_escape_vcs = reachable_escape_vcs(reachable_route, request)
  def viable = viable_escape_vcs(
    materialized,
    route_class,
    route_escape_vcs,
    request
  )
  def missing_route = route_escape_vcs.find(
    fun (vc): !contains_vc(viable, vc)
  )
  if missing_route
  | _MissingEscapeRoute(route_class, HeldVC(missing_route))
  | block:
      def mutable origins = [Injection(route_class.source)]
      for (vc in reachable_route.reachable_vcs.sort(vc_id_less)):
        unless request.contains(vc)
        | origins := origins ++ [HeldVC(vc)]
      def mutable entries = []
      def mutable missing_entry = #false
      for (origin in origins):
        unless missing_entry || origin_at_destination(
          materialized,
          route_class,
          origin
        )
        | def decisions = escape_decisions(
            materialized,
            request,
            route_class,
            origin
          ).filter(
            ~keep: fun (decision): contains_vc(viable, decision.candidate_vc)
          )
          if decisions.length() == 0
          | missing_entry := _MissingEscapeEntry(route_class, origin)
          | entries := entries ++ [_EscapeEntryEvidence(origin, decisions)]
      if missing_entry
      | missing_entry
      | block:
          def mutable decisions = []
          for (vc in route_escape_vcs):
            decisions := decisions ++ escape_decisions(
              materialized,
              request,
              route_class,
              HeldVC(vc)
            )
          _EscapeRouteEvidence(
            route_class,
            route_escape_vcs,
            viable,
            decisions,
            entries
          )

fun validate_escape_subnetwork(materialized :: MaterializedRouting,
                               reachable :: ReachableRouting,
                               dependency_graph :: VCDependencyGraph,
                               request :: EscapeValidationRequest):
  unless reachable.materialized === materialized
  | error(~who: #'validate_escape_subnetwork,
          "escape validation requires reachability for the materialized routing")
  unless dependency_graph.reachable === reachable
  | error(~who: #'validate_escape_subnetwork,
          "escape validation requires the reachable dependency graph")
  unless request.topology === materialized.topology
  | error(~who: #'validate_escape_subnetwork,
          "escape validation request belongs to a different topology")

  def closure = find_closure_violation(materialized, reachable, request)
  if closure is_a EscapeClosureViolation
  | closure
  | block:
      def mutable route_evidence = []
      def mutable failure = #false
      for (route in reachable.routes):
        unless failure
        | def result = analyze_escape_route(materialized, route, request)
          if result is_a EscapeRouteEvidence
          | route_evidence := route_evidence ++ [result]
          | failure := result
      if failure
      | failure
      | block:
          def escape_vertices = dependency_graph.vertices.filter(
            ~keep: fun (vc): request.contains(vc)
          )
          def escape_graph = dependency_graph.project(escape_vertices)
          def proof = check_dependency_acyclicity(escape_graph)
          if proof is_a DependencyCycle
          | proof
          | _EscapeValidationEvidence(
              request,
              _EscapeReachabilityEvidence(reachable, route_evidence),
              closure,
              escape_graph,
              proof
            )
