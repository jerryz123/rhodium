#lang rhombus
// Defines immutable symbolic topology specifications before numeric model identities are assigned.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../support/annotations.rhm" open
  "names.rhm" open

export:
  InjectionTerminalSpec
  EjectionTerminalSpec
  TopologyLink
  TopologySpec

class InjectionTerminalSpec(ref :: InjectionRef, router :: NodeRef):

  method describe():
    "inject " ++ ref.describe() ++ " @ " ++ router.describe()

class EjectionTerminalSpec(ref :: EjectionRef, router :: NodeRef):

  method describe():
    "eject " ++ ref.describe() ++ " @ " ++ router.describe()

fun contains_node_ref(nodes :: List.of(NodeRef), ref :: NodeRef):
  nodes.find(fun (candidate): node_ref_equal(candidate, ref)) != #false

fun duplicate_node_ref(nodes :: List.of(NodeRef), ref :: NodeRef):
  nodes.filter(~keep: fun (candidate): node_ref_equal(candidate, ref)).length() > 1

fun duplicate_injection_ref(terminals :: List.of(InjectionTerminalSpec),
                            ref :: InjectionRef):
  terminals.filter(
    ~keep: fun (candidate): injection_ref_equal(candidate.ref, ref)
  ).length() > 1

fun duplicate_ejection_ref(terminals :: List.of(EjectionTerminalSpec),
                           ref :: EjectionRef):
  terminals.filter(
    ~keep: fun (candidate): ejection_ref_equal(candidate.ref, ref)
  ).length() > 1

fun duplicate_vc_group(groups :: List.of(VCGroup), name :: String):
  groups.filter(~keep: fun (candidate): candidate.name == name).length() > 1

class TopologyLink(ref :: LinkRef,
                   source :: NodeRef,
                   destination :: NodeRef,
                   vc_groups :: NonemptyList.of(VCGroup)):
  constructor (ref :: LinkRef,
               source :: NodeRef,
               destination :: NodeRef,
               vc_groups :: NonemptyList.of(VCGroup)):
    for (group in vc_groups):
      when duplicate_vc_group(vc_groups, group.name)
      | error(~who: #'TopologyLink,
              String.append("duplicate VC group ", group.name,
                            " on link ", ref.describe()))
    super(ref,
          source,
          destination,
          vc_groups.sort(vc_group_less))

  method vc_count():
    def mutable count = 0
    for (group in vc_groups):
      count := count + group.count
    count

  method virtual_channels():
    def mutable vcs = []
    for (group in vc_groups):
      for (index in 0..group.count):
        vcs := vcs ++ [VCRef(ref, group.name, index)]
    vcs

  method find_vc_group(name :: String):
    def found = vc_groups.find(fun (group): group.name == name)
    unless found
    | error(~who: #'find_vc_group,
            String.append("link ", ref.describe(),
                          " has no VC group ", name))
    found

  method describe():
    String.append(ref.describe(), ": ", source.describe(), " -> ",
                  destination.describe(), " (",
                  String.join(vc_groups.map(fun (group): group.describe()), ", "),
                  ")")

fun duplicate_link_ref(links :: List.of(TopologyLink), ref :: LinkRef):
  links.filter(~keep: fun (candidate): link_ref_equal(candidate.ref, ref)).length() > 1

class TopologySpec(nodes :: NonemptyList.of(NodeRef),
                   links :: List.of(TopologyLink),
                   injections :: List.of(InjectionTerminalSpec),
                   ejections :: List.of(EjectionTerminalSpec)):
  constructor (nodes :: NonemptyList.of(NodeRef),
               links :: List.of(TopologyLink),
               ~injections: injections :: List.of(InjectionTerminalSpec) = [],
               ~ejections: ejections :: List.of(EjectionTerminalSpec) = []):
    for (node in nodes):
      when duplicate_node_ref(nodes, node)
      | error(~who: #'TopologySpec,
              "duplicate topology node " ++ node.describe())
    for (link in links):
      when duplicate_link_ref(links, link.ref)
      | error(~who: #'TopologySpec,
              "duplicate topology link " ++ link.ref.describe())
      unless contains_node_ref(nodes, link.source)
      | error(~who: #'TopologySpec,
              String.append("link ", link.ref.describe(),
                            " has unknown source ", link.source.describe()))
      unless contains_node_ref(nodes, link.destination)
      | error(~who: #'TopologySpec,
              String.append("link ", link.ref.describe(),
                            " has unknown destination ",
                            link.destination.describe()))
    for (terminal in injections):
      when duplicate_injection_ref(injections, terminal.ref)
      | error(~who: #'TopologySpec,
              "duplicate injection terminal " ++ terminal.ref.describe())
      unless contains_node_ref(nodes, terminal.router)
      | error(~who: #'TopologySpec,
              String.append("injection terminal ", terminal.ref.describe(),
                            " has unknown router ",
                            terminal.router.describe()))
    for (terminal in ejections):
      when duplicate_ejection_ref(ejections, terminal.ref)
      | error(~who: #'TopologySpec,
              "duplicate ejection terminal " ++ terminal.ref.describe())
      unless contains_node_ref(nodes, terminal.router)
      | error(~who: #'TopologySpec,
              String.append("ejection terminal ", terminal.ref.describe(),
                            " has unknown router ",
                            terminal.router.describe()))
    super(nodes.sort(node_ref_less),
          links.sort(fun (left, right): link_ref_less(left.ref, right.ref)),
          injections.sort(
            fun (left, right): injection_ref_less(left.ref, right.ref)
          ),
          ejections.sort(
            fun (left, right): ejection_ref_less(left.ref, right.ref)
          ))

  method find_node(ref :: NodeRef):
    def found = nodes.find(fun (node): node_ref_equal(node, ref))
    unless found
    | error(~who: #'find_node, "unknown node " ++ ref.describe())
    found

  // These name-oriented lookups are useful to ordinary builder clients and
  // keep embedded syntax from needing to leak macro-generated bindings.
  method node(path :: NamePath || NodeRef || NonemptyString || NonemptyList.of(NonemptyString)):
    find_node(if path is_a NodeRef | path | NodeRef(path))

  method find_link(ref :: LinkRef):
    def found = links.find(fun (link): link_ref_equal(link.ref, ref))
    unless found
    | error(~who: #'find_link, "unknown link " ++ ref.describe())
    found

  method link(path :: NamePath || LinkRef || NonemptyString || NonemptyList.of(NonemptyString)):
    def ref = if path is_a LinkRef | path | LinkRef(path)
    find_link(ref)
    ref

  method find_injection(ref :: InjectionRef):
    def found = injections.find(
      fun (terminal): injection_ref_equal(terminal.ref, ref)
    )
    unless found
    | error(~who: #'find_injection,
            "unknown injection terminal " ++ ref.describe())
    found

  method injection(path :: NamePath || InjectionRef || NonemptyString || NonemptyList.of(NonemptyString)):
    def ref = if path is_a InjectionRef | path | InjectionRef(path)
    find_injection(ref)
    ref

  method find_ejection(ref :: EjectionRef):
    def found = ejections.find(
      fun (terminal): ejection_ref_equal(terminal.ref, ref)
    )
    unless found
    | error(~who: #'find_ejection,
            "unknown ejection terminal " ++ ref.describe())
    found

  method ejection(path :: NamePath || EjectionRef || NonemptyString || NonemptyList.of(NonemptyString)):
    def ref = if path is_a EjectionRef | path | EjectionRef(path)
    find_ejection(ref)
    ref

  method describe():
    String.join(
      injections.map(fun (terminal): terminal.describe()) ++ (
        ejections.map(fun (terminal): terminal.describe())
      ) ++ links.map(fun (link): link.describe()),
      "\n"
    )
