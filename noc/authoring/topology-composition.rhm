#lang rhombus
// Provides topology-independent naming, composition, and directed-link helpers.
// SPDX-License-Identifier: Apache-2.0

import:
  "names.rhm" open
  "topology-spec.rhm" open

export:
  prefix_node_ref
  prefix_link_ref
  prefix_injection_ref
  prefix_ejection_ref
  with_router_terminals
  prefix_topology
  compose_topologies
  directed_link
  bidirectional_link

fun require_prefix(who :: Symbol,
                   value :: NamePath || String || List.of(String)):
  if value is_a NamePath
  | value
  | block:
      try:
        NamePath(value)
        ~catch _exn:
          error(~who: who,
                "topology prefix must be a nonempty String or List of Strings")

fun prefixed_path(prefix :: NamePath, path :: NamePath):
  NamePath(prefix.segments ++ path.segments)

fun prefix_node_ref(prefix :: NamePath || String || List.of(String),
                    ref :: NodeRef):
  def prefix_path = require_prefix(#'prefix_node_ref, prefix)
  NodeRef(prefixed_path(prefix_path, ref.path))

fun prefix_link_ref(prefix :: NamePath || String || List.of(String),
                    ref :: LinkRef):
  def prefix_path = require_prefix(#'prefix_link_ref, prefix)
  LinkRef(prefixed_path(prefix_path, ref.path))

fun prefix_injection_ref(prefix :: NamePath || String || List.of(String),
                         ref :: InjectionRef):
  def prefix_path = require_prefix(#'prefix_injection_ref, prefix)
  InjectionRef(prefixed_path(prefix_path, ref.path))

fun prefix_ejection_ref(prefix :: NamePath || String || List.of(String),
                        ref :: EjectionRef):
  def prefix_path = require_prefix(#'prefix_ejection_ref, prefix)
  EjectionRef(prefixed_path(prefix_path, ref.path))

fun prefix_topology(prefix :: NamePath || String || List.of(String),
                    spec :: TopologySpec):
  def prefix_path = require_prefix(#'prefix_topology, prefix)
  def nodes = spec.nodes.map(
    fun (node): prefix_node_ref(prefix_path, node)
  )
  def links = spec.links.map(
    fun (link):
      TopologyLink(
        prefix_link_ref(prefix_path, link.ref),
        prefix_node_ref(prefix_path, link.source),
        prefix_node_ref(prefix_path, link.destination),
        link.vc_groups
      )
  )
  def injections = spec.injections.map(
    fun (terminal):
      InjectionTerminalSpec(
        prefix_injection_ref(prefix_path, terminal.ref),
        prefix_node_ref(prefix_path, terminal.router)
      )
  )
  def ejections = spec.ejections.map(
    fun (terminal):
      EjectionTerminalSpec(
        prefix_ejection_ref(prefix_path, terminal.ref),
        prefix_node_ref(prefix_path, terminal.router)
      )
  )
  TopologySpec(nodes, links, ~injections: injections, ~ejections: ejections)

// Applies the common one-injection/one-ejection-per-router attachment policy
// without baking terminals into reusable topology-family definitions.
fun with_router_terminals(spec :: TopologySpec):
  when spec.injections.length() > 0 || spec.ejections.length() > 0
  | error(~who: #'with_router_terminals,
          "topology already contains terminal attachments")
  TopologySpec(
    spec.nodes,
    spec.links,
    ~injections: spec.nodes.map(
      fun (node): InjectionTerminalSpec(InjectionRef(node.path), node)
    ),
    ~ejections: spec.nodes.map(
      fun (node): EjectionTerminalSpec(EjectionRef(node.path), node)
    )
  )

fun compose_topologies(specs :: NonemptyList.of(TopologySpec),
                       ~links: extra_links :: List.of(TopologyLink) = []):
  def mutable nodes = []
  def mutable links = []
  def mutable injections = []
  def mutable ejections = []
  for (spec in specs):
    nodes := nodes ++ spec.nodes
    links := links ++ spec.links
    injections := injections ++ spec.injections
    ejections := ejections ++ spec.ejections
  TopologySpec(nodes,
               links ++ extra_links,
               ~injections: injections,
               ~ejections: ejections)

fun directed_link(ref :: LinkRef,
                  source :: NodeRef,
                  destination :: NodeRef,
                  vc_groups :: NonemptyList.of(VCGroup)):
  TopologyLink(ref, source, destination, vc_groups)

fun bidirectional_link(forward_ref :: LinkRef,
                       reverse_ref :: LinkRef,
                       source :: NodeRef,
                       destination :: NodeRef,
                       vc_groups :: NonemptyList.of(VCGroup)):
  [directed_link(forward_ref, source, destination, vc_groups),
   directed_link(reverse_ref, destination, source, vc_groups)]
