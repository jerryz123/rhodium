#lang rhombus
/* Defines symbolic route classes independently of normalized model identities. */
// SPDX-License-Identifier: Apache-2.0

import:
  "names.rhm" open

export:
  RouteClassSpec

/* Declares a symbolic route between independently named injection and ejection terminals. */
class RouteClassSpec(ref :: RouteClassRef,
                     source :: InjectionRef,
                     destination :: EjectionRef):
  /* Accepts terminal references or converts router references to same-path terminal names. */
  constructor (ref :: RouteClassRef,
               source :: NodeRef || InjectionRef,
               destination :: NodeRef || EjectionRef):
    super(
      ref,
      if source is_a NodeRef | InjectionRef(source.path) | source,
      if destination is_a NodeRef | EjectionRef(destination.path) | destination
    )

  /* Formats the route name and source/destination terminal names. */
  method describe():
    String.append(ref.describe(), ": ", source.describe(), " -> ",
                  destination.describe())
