#lang rhombus
// Defines an asymmetric fork-merge network used to exercise uniform router families.
// SPDX-License-Identifier: Apache-2.0

import:
  "../model/main.rhm" open
  "../plan/main.rhm" open

export:
  source_a
  source_b
  hub
  destination
  link_a_hub
  link_b_hub
  link_hub_destination
  route_a
  route_b
  route_local
  routing
  network_plan
  router_family_plan

def source_a = NodeId(0)
def source_b = NodeId(1)
def hub = NodeId(2)
def destination = NodeId(3)
def link_a_hub = PhysicalLink(LinkId(0), source_a, hub, 1)
def link_b_hub = PhysicalLink(LinkId(1), source_b, hub, 1)
def link_hub_destination = PhysicalLink(LinkId(2), hub, destination, 1)
def topology = Topology(
  [destination, hub, source_b, source_a],
  [link_hub_destination, link_b_hub, link_a_hub]
)
def route_a = RouteClass(RouteClassId(0), source_a, destination)
def route_b = RouteClass(RouteClassId(1), source_b, destination)
def route_local = RouteClass(RouteClassId(2), hub, hub)

fun on_link(vc :: VCId, link :: PhysicalLink):
  link_id_equal(vc.link_id, link.id)

fun allows(route_class :: RouteClass,
           origin :: Injection || HeldVC,
           candidate :: VCId):
  cond
  | route_class === route_local: #false
  | origin is_a Injection:
      cond
      | route_class === route_a: on_link(candidate, link_a_hub)
      | route_class === route_b: on_link(candidate, link_b_hub)
      | ~else: #false
  | origin is_a HeldVC:
      (on_link(origin.vc, link_a_hub) || on_link(origin.vc, link_b_hub)) && (
        on_link(candidate, link_hub_destination)
      )

def routing = compile_routing(
  RoutingProblem(
    topology,
    [route_local, route_b, route_a],
    RoutingRelation(allows)
  )
)
def network_plan = NetworkPlan(routing)
def router_family_plan = RouterFamilyPlan(network_plan)
