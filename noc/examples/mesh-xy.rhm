#lang rhombus
// Validates escape-VC XY routing for the reusable concrete mesh and traffic examples.
// SPDX-License-Identifier: Apache-2.0

import:
  "../model/main.rhm" open
  "../authoring/main.rhm" open
  "../plan/main.rhm" open
  "../std/routing/main.rhm" open
  "mesh-topology.rhm" open
  "mesh-traffic.rhm" open

export:
  example_xy_policy
  example_xy_problem
  example_xy_routing

def example_xy_policy = xy_dimension_order(
  example_mesh,
  ~vc_groups: ["escape"]
)
def example_xy_problem = RoutingProblem(
  example_topology.topology,
  example_lowered_traffic.route_classes,
  lower_routing_policy(example_lowered_traffic, example_xy_policy)
)
def example_xy_routing = compile_routing(example_xy_problem)
