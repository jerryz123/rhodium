#lang rhombus
// Applies a reusable traffic definition to the concrete example mesh instance.
// SPDX-License-Identifier: Apache-2.0

import:
  "../authoring/main.rhm" open
  "../std/traffic/main.rhm" open
  "mesh-topology.rhm" open

export:
  example_traffic
  example_lowered_traffic

def example_traffic = all_pairs(example_topology.spec)
def example_lowered_traffic = lower_route_classes(
  example_topology,
  example_traffic
)
