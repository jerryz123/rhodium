#lang rhombus
// Instantiates a concrete mesh separately from reusable topology definitions.
// SPDX-License-Identifier: Apache-2.0

import:
  "../authoring/main.rhm" open
  "../std/topology/main.rhm" open
  "../std/traffic/main.rhm" open

export:
  example_mesh
  example_topology

def example_mesh = rectangular_mesh(
  2,
  2,
  [VCGroup("adaptive", 2), VCGroup("escape", 1)]
)

def example_topology = lower_topology(with_router_terminals(example_mesh.spec))
