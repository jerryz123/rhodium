#lang rhombus
// Contrasts adaptive-cycle rejection with explicit escape-certified mesh routing.
// SPDX-License-Identifier: Apache-2.0

import:
  "../model/main.rhm" open
  "../analysis/main.rhm" open
  "../authoring/main.rhm" open
  "../plan/main.rhm" open
  "../std/topology/main.rhm" open
  "../std/traffic/main.rhm" open
  "../std/routing/main.rhm" open

export:
  adaptive_escape_mesh
  adaptive_escape_topology
  adaptive_escape_traffic
  adaptive_escape_routes
  adaptive_escape_policy
  adaptive_escape_problem
  adaptive_escape_materialized
  adaptive_escape_reachable
  adaptive_escape_dependency_graph
  adaptive_escape_proof
  adaptive_escape_compile_result
  adaptive_escape_request
  adaptive_escape_routing
  escape_only_problem
  escape_only_routing

def adaptive_escape_mesh = rectangular_mesh(
  2,
  2,
  [VCGroup("adaptive", 1), VCGroup("escape", 1)]
)
def adaptive_escape_topology = lower_topology(
  with_router_terminals(adaptive_escape_mesh.spec)
)
def adaptive_escape_traffic = all_pairs(adaptive_escape_topology.spec)
def adaptive_escape_routes = lower_route_classes(
  adaptive_escape_topology,
  adaptive_escape_traffic
)
def adaptive_escape_policy = adaptive_minimal_escape(adaptive_escape_mesh)
def adaptive_escape_problem = RoutingProblem(
  adaptive_escape_topology.topology,
  adaptive_escape_routes.route_classes,
  lower_routing_policy(adaptive_escape_routes, adaptive_escape_policy)
)
def adaptive_escape_materialized = materialize_routing(
  adaptive_escape_problem
)
def adaptive_escape_reachable = analyze_reachability(
  adaptive_escape_materialized
)
def adaptive_escape_dependency_graph = build_dependency_graph(
  adaptive_escape_reachable
)
def adaptive_escape_proof = check_dependency_acyclicity(
  adaptive_escape_dependency_graph
)
def adaptive_escape_compile_result = compile_routing(
  adaptive_escape_problem
)
def adaptive_escape_request = EscapeValidationRequest(
  adaptive_escape_topology.topology,
  adaptive_escape_topology.vc_ids_in_groups(["escape"])
)
def adaptive_escape_routing = compile_routing(
  adaptive_escape_problem,
  ~escape: adaptive_escape_request
)

def escape_only_problem = RoutingProblem(
  adaptive_escape_topology.topology,
  adaptive_escape_routes.route_classes,
  lower_routing_policy(
    adaptive_escape_routes,
    xy_dimension_order(
      adaptive_escape_mesh,
      ~vc_groups: ["escape"]
    )
  )
)
def escape_only_routing = compile_routing(escape_only_problem)
