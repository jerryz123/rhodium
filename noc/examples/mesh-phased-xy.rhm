#lang rhombus
// Builds and validates a user-authored XY policy with phases encoded by VC groups.
// SPDX-License-Identifier: Apache-2.0

import:
  "../model/main.rhm" open
  "../authoring/main.rhm" open
  "../plan/main.rhm" open
  "../std/topology/main.rhm" open
  "../std/traffic/main.rhm" open

export:
  phased_mesh
  phased_topology
  phased_traffic
  phased_routes
  phased_xy_policy
  phased_problem
  phased_routing

def x_phase_group = "x-phase"
def y_phase_group = "y-phase"
def phased_mesh = rectangular_mesh(
  2,
  2,
  [VCGroup(x_phase_group, 1), VCGroup(y_phase_group, 1)]
)
def phased_topology = lower_topology(with_router_terminals(phased_mesh.spec))
def phased_traffic = all_pairs(phased_topology.spec)
def phased_routes = lower_route_classes(phased_topology, phased_traffic)

fun required_axis_direction(axis :: String,
                            current :: MeshCoordinate,
                            destination :: MeshCoordinate):
  cond
  | axis == "x" && current.x < destination.x: mesh_east
  | axis == "x" && current.x > destination.x: mesh_west
  | axis == "y" && current.y < destination.y: mesh_north
  | axis == "y" && current.y > destination.y: mesh_south
  | ~else: #false

fun axis_step_policy(axis :: String):
  custom_policy(
    axis ++ "-step",
    fun (context):
      def current = phased_mesh.coordinate_of(context.current_node)
      def destination = phased_mesh.coordinate_of(
        context.destination_router
      )
      def x_aligned = current.x == destination.x
      def required = required_axis_direction(axis, current, destination)
      required != #false && (axis == "x" || x_aligned) && mesh_direction_equal(
        required,
        phased_mesh.direction_of(context.candidate_link())
      )
  )

def before_y_origin = policy_union(
  [injection_policy, match_current_vc_groups([x_phase_group])]
)
def x_phase = routing_phase(
  "x",
  policy_intersection(
    [before_y_origin,
     axis_step_policy("x"),
     restrict_vc_groups([x_phase_group])]
  )
)
def enter_y_phase = routing_phase(
  "enter-y",
  policy_intersection(
    [before_y_origin,
     axis_step_policy("y"),
     restrict_vc_groups([y_phase_group])]
  )
)
def y_phase = routing_phase(
  "y",
  policy_intersection(
    [match_current_vc_groups([y_phase_group]),
     axis_step_policy("y"),
     restrict_vc_groups([y_phase_group])]
  )
)
def phased_xy_policy = policy_union([x_phase, enter_y_phase, y_phase])
def phased_problem = RoutingProblem(
  phased_topology.topology,
  phased_routes.route_classes,
  lower_routing_policy(phased_routes, phased_xy_policy)
)
def phased_routing = compile_routing(phased_problem)
