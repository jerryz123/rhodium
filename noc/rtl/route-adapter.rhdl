#lang rhodium
// Implements protocol-neutral ready-valid attachment and removal of NoC route metadata.

import:
  lib("flow/main.rhdl") open
  "router.rhdl".RoutedBeat

export:
  RoutedFlowInjector
  RoutedFlowEjector

circuit RoutedFlowInjector(Input :: DataType,
                           Payload :: DataType,
                           route_width :: PosInt):
  input route_valid: Bool
  input route_key: Bits(route_width)
  input payload: Payload
  interface ingress(Decoupled(Input), ~role: consumer)
  interface egress(Decoupled(RoutedBeat(Payload, route_width)), ~role: producer)

  (
    ingress |> gate_flow(route_valid) |> map_flow(_input):
      RoutedBeat(Payload, route_width):
        route_key: route_key
        payload: payload
  ) |> egress

circuit RoutedFlowEjector(Payload :: DataType, route_width :: PosInt):
  interface ingress(Decoupled(RoutedBeat(Payload, route_width)), ~role: consumer)
  interface egress(Decoupled(Payload), ~role: producer)

  ingress |> map_flow(routed => routed.payload) |> egress
