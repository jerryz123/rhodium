#lang rhodium
/* Lowers validated router and router-family plans into combinational route lookups. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/decode.rhdl") open
  "../plan/router-plan.rhm" open
  "../plan/router-family-plan.rhm" open

export:
  RouteLookupKey
  SiteRouteLookupKey
  RouteDecision
  RouteDecoder
  RouterFamilyRouteDecoder
  compile_route_decoder
  compile_router_family_route_decoder
  RouteComputer

/* Names the global route key and router-local origin key consumed by typed decoding. */
bundle RouteLookupKey(route_width :: PosInt, origin_width :: PosInt):
  route_key: Bits(route_width)
  origin_key: Bits(origin_width)

/* Adds a spatial site selector intended to be tied to a constant at each family occurrence. */
bundle SiteRouteLookupKey(site_width, route_width, origin_width):
  site_key: Bits(site_width)
  route_key: Bits(route_width)
  origin_key: Bits(origin_width)

/* Carries legal targets, the certified fallback subset, and validity as named hardware fields. */
bundle RouteDecision(mask_width :: PosInt):
  target_mask: Mask(mask_width)
  fallback_mask: Mask(mask_width)
  valid: Bool

/* Owns a plan-derived typed decoder; lookup exposes Hardware.packable while DecodeGen retains
   exact types. */
class RouteDecoder(router_plan :: RouterPlan,
                   route_width :: PosInt,
                   origin_width :: PosInt,
                   mask_width :: PosInt,
                   decoder :: DecodeGen):
  implements StableCircuitParam
  opaque
  internal _RouteDecoder
  /* Restricts decoder construction to the validated-plan compiler in this module. */
  constructor ~none

  /* Builds a typed route/origin selector and reuses the compiled combinational decoder. */
  method lookup(route_key :: Bits(route_width),
                origin_key :: Bits(origin_width))
    :: Hardware.packable:
    decoder(
      RouteLookupKey(route_width, origin_width):
        route_key: route_key
        origin_key: origin_key
    )

/* Owns one uniform site/route/origin decoder derived entirely from validated family rows. */
class RouterFamilyRouteDecoder(router_family_plan :: RouterFamilyPlan,
                               site_width :: PosInt,
                               route_width :: PosInt,
                               origin_width :: PosInt,
                               mask_width :: PosInt,
                               decoder :: DecodeGen):
  implements StableCircuitParam
  opaque
  internal _RouterFamilyRouteDecoder
  /* Restricts family decoder construction to the validated-plan compiler. */
  constructor ~none

  /* Looks up named decision fields using the occurrence's site key and local input origin. */
  method lookup(site_key :: Bits(site_width),
                route_key :: Bits(route_width),
                origin_key :: Bits(origin_width))
    :: Hardware.packable:
    decoder(
      SiteRouteLookupKey(site_width, route_width, origin_width):
        site_key: site_key
        route_key: route_key
        origin_key: origin_key
    )

/* Compiles certified local rows with a zero-mask invalid default, without re-running routing
   analysis. */
fun compile_route_decoder(router_plan :: RouterPlan) :: RouteDecoder:
  unless router_plan.rows.length() > 0
  | error(~who: #'compile_route_decoder,
          "route decoding requires at least one local route row")
  def route_width = index_width(router_plan.route_classes.length())
  def origin_width = index_width(router_plan.origins.length())
  def target_count = router_plan.targets.length()
  // Rhodium has no zero-width Bits value. A plan with no local target retains a
  // padding bit so invalid lookups still have a representable result type.
  def mask_width = if target_count > 0 | target_count | 1
  def cases = router_plan.rows.map(
    fun (entry):
      DecodeCase(
        (pattern(RouteLookupKey(route_width, origin_width)):
           route_key: bits(entry.route_key, route_width)
           origin_key: bits(entry.origin_key, origin_width)),
        (pattern(RouteDecision(mask_width)):
           target_mask: Mask(mask_width)(entry.target_mask)
           fallback_mask: Mask(mask_width)(entry.fallback_mask)
           valid: Bool(#true))
      )
  )
  // Compile the generic relation once. Hardware lookups reuse the typed table;
  // its eventual physical form remains a backend decision.
  def decoder = DecodeGen(
    cases,
    ~default: (pattern(RouteDecision(mask_width)):
                 target_mask: Mask(mask_width)(0)
                 fallback_mask: Mask(mask_width)(0)
                 valid: Bool(#false))
  )
  _RouteDecoder(router_plan,
                route_width,
                origin_width,
                mask_width,
                decoder)

/* Compiles certified family rows into a shared typed table with static site selection. */
fun compile_router_family_route_decoder(
      router_family_plan :: RouterFamilyPlan) :: RouterFamilyRouteDecoder:
  unless router_family_plan.rows.length() > 0
  | error(~who: #'compile_router_family_route_decoder,
          "route decoding requires at least one router-family route row")
  def site_width = index_width(router_family_plan.members.length())
  def route_width = index_width(
    router_family_plan.network_plan.validated_routing.route_classes.length()
  )
  def origin_width = index_width(router_family_plan.input_count)
  def mask_width = if router_family_plan.target_count > 0 | router_family_plan.target_count | 1
  def cases = router_family_plan.rows.map(
    fun (entry):
      DecodeCase(
        (pattern(SiteRouteLookupKey(site_width, route_width, origin_width)):
           site_key: bits(entry.site_key, site_width)
           route_key: bits(entry.route_key, route_width)
           origin_key: bits(entry.origin_key, origin_width)),
        (pattern(RouteDecision(mask_width)):
           target_mask: Mask(mask_width)(entry.target_mask)
           fallback_mask: Mask(mask_width)(entry.fallback_mask)
           valid: Bool(#true))
      )
  )
  def decoder = DecodeGen(
    cases,
    ~default: (pattern(RouteDecision(mask_width)):
                 target_mask: Mask(mask_width)(0)
                 fallback_mask: Mask(mask_width)(0)
                 valid: Bool(#false))
  )
  _RouterFamilyRouteDecoder(router_family_plan,
                            site_width,
                            route_width,
                            origin_width,
                            mask_width,
                            decoder)

/* Exposes a plan-derived combinational decision's target mask, fallback subset, and validity. */
circuit RouteComputer(route_decoder :: RouteDecoder):
  input route_key: Bits(route_decoder.route_width)
  input origin_key: Bits(route_decoder.origin_width)
  output target_mask: Mask(route_decoder.mask_width)
  output fallback_mask: Mask(route_decoder.mask_width)
  output valid: Bool

  def decision = route_decoder.lookup(route_key, origin_key)
  target_mask <== decision.target_mask
  fallback_mask <== decision.fallback_mask
  valid <== decision.valid
