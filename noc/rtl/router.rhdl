#lang rhodium
// Implements the simple buffered NoC router driven by a validated router plan.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/ready-valid.rhdl") open
  lib("flow/queue.rhdl") open
  lib("flow/crossbar.rhdl") open
  "allocator.rhdl" open
  "route-computer.rhdl" open
  "../model/identities.rhm".NodeId
  "../plan/router-plan.rhm" open
  "../plan/router-family-plan.rhm" open

export:
  RoutedBeat
  SimpleRouterTarget
  SimpleRouterConfig
  SimpleRouterFamilyConfig
  compile_simple_router
  compile_simple_router_family
  bind_simple_router_family_site
  bind_router_plane
  close_router_local_ports
  SimpleRouter
  SimpleRouterFamily

// Carries NoC route metadata alongside an otherwise opaque payload. A simple
// router transports this as one complete packet; a packetized router may wrap
// it in a standard flit format.
bundle RoutedBeat(T :: DataType, route_width :: PosInt):
  route_key: Bits(route_width)
  payload: T

// Couples one routed output with the allocator-availability indication owned
// by its downstream attachment.
interface SimpleRouterTarget(T :: DataType):
  role router
  role downstream
  provider router

  router -> downstream:
    egress: Decoupled(T)

  downstream -> router:
    available: Bool

// Fixes all widths and local port meanings before circuit elaboration.
class SimpleRouterConfig(router_plan :: RouterPlan,
                         route_decoder :: RouteDecoder,
                         input_count :: PosInt,
                         target_count :: PosInt,
                         input_buffer_depth :: PosInt):
  implements StableCircuitParam
  opaque
  internal _SimpleRouterConfig
  constructor ~none

// Gives every member of one network the same physical shape and one shared
// route decoder. Each instance ties its site key to an integration constant.
class SimpleRouterFamilyConfig(router_family_plan :: RouterFamilyPlan,
                               route_decoder :: RouterFamilyRouteDecoder,
                               input_count :: PosInt,
                               target_count :: PosInt,
                               input_buffer_depth :: PosInt):
  implements StableCircuitParam
  opaque
  internal _SimpleRouterFamilyConfig
  constructor ~none

// Freezes the router's validated hardware shape.
fun compile_simple_router(
      router_plan :: RouterPlan,
      ~input_buffer_depth: input_buffer_depth :: PosInt = 1) :: SimpleRouterConfig:
  def route_decoder = compile_route_decoder(router_plan)
  def input_count = router_plan.origins.length()
  def target_count = router_plan.targets.length()
  unless target_count > 0
  | error(~who: #'compile_simple_router,
          "router plan must have an outgoing VC or an ejection target")
  _SimpleRouterConfig(router_plan,
                      route_decoder,
                      input_count,
                      target_count,
                      input_buffer_depth)

fun compile_simple_router_family(
      router_family_plan :: RouterFamilyPlan,
      ~input_buffer_depth: input_buffer_depth :: PosInt = 1) :: SimpleRouterFamilyConfig:
  def route_decoder = compile_router_family_route_decoder(router_family_plan)
  unless router_family_plan.target_count > 0
  | error(~who: #'compile_simple_router_family,
          "router family must have an outgoing VC or an ejection target")
  _SimpleRouterFamilyConfig(router_family_plan,
                            route_decoder,
                            router_family_plan.input_count,
                            router_family_plan.target_count,
                            input_buffer_depth)

// Selects one family member and closes only the uniform padding slots around
// its router occurrence; endpoint and physical-link slots remain integration-owned.
fun bind_simple_router_family_site(T :: DataType,
                                   config :: SimpleRouterFamilyConfig,
                                   node :: NodeId,
                                   ~site_key: site_key :: Bits(config.route_decoder.site_width),
                                   ~ingress: ingress :: Array,
                                   ~targets: targets :: Array):
  def site = config.router_family_plan.site(node)
  def Beat = RoutedBeat(T, config.route_decoder.route_width)
  site_key <== bits(site.site_key, config.route_decoder.site_width)
  for (input_index in site.unused_input_indices):
    def input :: Endpoint = ingress[input_index]
    input.valid <== Bool(#false)
    input.bits <== dont_care(Beat)
  for (target_index in site.unused_target_indices):
    def target :: Endpoint = targets[target_index]
    target.available <== Bool(#false)
    target.egress.ready <== Bool(#false)

// Binds one family's physical-link slots without owning router hierarchy.
fun bind_router_plane(config :: SimpleRouterFamilyConfig,
                      ~router_site_key: router_site_key :: Bits(config.route_decoder.site_width),
                      ~site_key: site_key :: Bits(config.route_decoder.site_width),
                      ~ingress: ingress :: Array,
                      ~targets: targets :: Array,
                      ~incoming: incoming :: Array,
                      ~outgoing: outgoing :: Array):
  def family = config.router_family_plan
  router_site_key <== site_key
  for (index in 0..family.ingress_count):
    def incoming_link :: Endpoint = incoming[index]
    incoming_link <=> ingress[family.injection_count + index]
  for (index in 0..family.egress_count):
    def outgoing_link :: Endpoint = outgoing[index]
    def target :: Endpoint = targets[index]
    target.egress <=> outgoing_link
    target.available <== target.egress.ready

// Closes unconnected local slots; connected target indices are absolute array indices.
fun close_router_local_ports(T :: DataType,
                             config :: SimpleRouterFamilyConfig,
                             ingress :: Array,
                             targets :: Array,
                             connected_inputs :: List.of(Nat),
                             connected_targets :: List.of(Nat)):
  def family = config.router_family_plan
  def Beat = RoutedBeat(T, config.route_decoder.route_width)
  for (index in 0..family.injection_count):
    unless connected_inputs.contains(index)
    | block:
        def input :: Endpoint = ingress[index]
        input.valid <== Bool(#false)
        input.bits <== dont_care(Beat)
  for (offset in 0..family.ejection_count):
    def index = family.egress_count + offset
    unless connected_targets.contains(index)
    | block:
        def target :: Endpoint = targets[index]
        target.available <== Bool(#false)
        target.egress.ready <== Bool(#false)

// Checks the route metadata contract on each external ingress offer. The
// physical ingress index supplies the origin key that is intentionally absent
// from the transported beat.
fun monitor_router_ingress(inputs :: Array,
                           route_decoder :: RouteDecoder):
  for (input_index in 0..inputs.length()):
    def input :: Endpoint = inputs[input_index]
    def decision = route_decoder.lookup(
      input.bits.route_key,
      bits(input_index, route_decoder.origin_width)
    )
    assert(!input.valid ||| decision.valid,
           String.append("simple_router_ingress_valid_route_",
                         to_string(input_index)))

fun monitor_router_family_ingress(
      inputs :: Array,
      route_decoder :: RouterFamilyRouteDecoder,
      site_key :: Bits(route_decoder.site_width)):
  for (input_index in 0..inputs.length()):
    def input :: Endpoint = inputs[input_index]
    def decision = route_decoder.lookup(
      site_key,
      input.bits.route_key,
      bits(input_index, route_decoder.origin_width)
    )
    assert(!input.valid ||| decision.valid,
           String.append("simple_router_family_ingress_valid_route_",
                         to_string(input_index)))

// Each local origin owns one standard queue of the configured depth. A transfer releases that
// origin and acquires exactly the selected outgoing VC at the neighboring
// router, matching the validated one-beat resource model.
sync_circuit SimpleRouter(T :: DataType, config :: SimpleRouterConfig):
  def Beat = RoutedBeat(T, config.route_decoder.route_width)
  interface ingress[config.input_count](Decoupled(Beat), ~role: consumer)
  interface target[config.target_count](SimpleRouterTarget(Beat), ~role: router)
  monitor_router_ingress(ingress, config.route_decoder)

  // Compose the ingress array with one ordinary queue per local origin.
  // Leaving pipe and flow disabled preserves the original registered timing.
  def input_buffers = ingress |> parallel_handles(
    for Array (_ in 0..config.input_count): Beat |> queue(config.input_buffer_depth)
  )

  def route_decisions = vec(
    for List (input_index in 0..config.input_count):
      def input_buffer :: Endpoint = input_buffers[input_index]
      config.route_decoder.lookup(
        input_buffer.bits.route_key,
        bits(input_index, config.route_decoder.origin_width)
      )
  )

  def requests = vec(
    for List (input_index in 0..config.input_count):
      def input_buffer :: Endpoint = input_buffers[input_index]
      def row = vec(
        for List (target_index in 0..config.target_count):
          def candidate = route_decisions[input_index].target_mask.as_bits()[target_index].into(Bool)
          input_buffer.valid & route_decisions[input_index].valid & candidate
      )
      row
  )

  def fallback_requests = vec(
    for List (input_index in 0..config.input_count):
      def input_buffer :: Endpoint = input_buffers[input_index]
      vec(
        for List (target_index in 0..config.target_count):
          def fallback = route_decisions[input_index].fallback_mask.as_bits()[target_index].into(Bool)
          input_buffer.valid & route_decisions[input_index].valid & fallback
      )
  )
  inst allocator(RouterAllocator(config.input_count, config.target_count))
  allocator.requests <== requests
  allocator.fallback_requests <== fallback_requests
  allocator.target_available <== vec(for List (target_index in 0..config.target_count): target[target_index].available)
  def traversal = input_buffers |> grant_crossbar(config.target_count, ~grants: allocator.grants)
  for (target_index in 0..config.target_count): traversal[target_index] <=> target[target_index].egress
  allocator.accepts <== vec(for List (target_index in 0..config.target_count): target[target_index].egress.valid & target[target_index].egress.ready)

// Implements one member of a router family. The site key changes only which
// prevalidated row is selected; it never changes the routing proof or policy.
sync_circuit SimpleRouterFamily(T :: DataType,
                                config :: SimpleRouterFamilyConfig):
  def Beat = RoutedBeat(T, config.route_decoder.route_width)
  input site_key: Bits(config.route_decoder.site_width)
  interface ingress[config.input_count](Decoupled(Beat), ~role: consumer)
  interface target[config.target_count](SimpleRouterTarget(Beat), ~role: router)
  monitor_router_family_ingress(ingress, config.route_decoder, site_key)

  def input_buffers = ingress |> parallel_handles(
    for Array (_ in 0..config.input_count): Beat |> queue(config.input_buffer_depth)
  )

  def route_decisions = vec(
    for List (input_index in 0..config.input_count):
      def input_buffer :: Endpoint = input_buffers[input_index]
      config.route_decoder.lookup(
        site_key,
        input_buffer.bits.route_key,
        bits(input_index, config.route_decoder.origin_width)
      )
  )

  def requests = vec(
    for List (input_index in 0..config.input_count):
      def input_buffer :: Endpoint = input_buffers[input_index]
      def row = vec(
        for List (target_index in 0..config.target_count):
          def candidate = route_decisions[input_index].target_mask.as_bits()[target_index].into(Bool)
          input_buffer.valid & route_decisions[input_index].valid & candidate
      )
      row
  )

  def fallback_requests = vec(
    for List (input_index in 0..config.input_count):
      def input_buffer :: Endpoint = input_buffers[input_index]
      vec(
        for List (target_index in 0..config.target_count):
          def fallback = route_decisions[input_index].fallback_mask.as_bits()[target_index].into(Bool)
          input_buffer.valid & route_decisions[input_index].valid & fallback
      )
  )
  inst allocator(RouterAllocator(config.input_count, config.target_count))
  allocator.requests <== requests
  allocator.fallback_requests <== fallback_requests
  allocator.target_available <== vec(for List (target_index in 0..config.target_count): target[target_index].available)
  def traversal = input_buffers |> grant_crossbar(config.target_count, ~grants: allocator.grants)
  for (target_index in 0..config.target_count): traversal[target_index] <=> target[target_index].egress
  allocator.accepts <== vec(for List (target_index in 0..config.target_count): target[target_index].egress.valid & target[target_index].egress.ready)
