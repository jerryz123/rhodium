#lang rhodium
// Exercises generic physical-link binding and unused-local closure on two asymmetric router sites.

import:
  "../../examples/router-family.rhm" as fixture
  "../main.rhdl" open
  lib("rhodium/std/ready-valid.rhdl") open

def family_plan = fixture.router_family_plan
def config = compile_simple_router_family(family_plan)
def Beat = RoutedBeat(Bits(8), config.route_decoder.route_width)

sync_circuit RouterFamilyFixture():
  interface source_ingress[config.input_count](Decoupled(Beat), ~role: consumer)
  interface source_egress[config.target_count](Decoupled(Beat), ~role: producer)
  interface hub_ingress[config.input_count](Decoupled(Beat), ~role: consumer)
  interface hub_egress[config.target_count](Decoupled(Beat), ~role: producer)

  def SharedRouterModule = SimpleRouterFamily(Bits(8), config)
  inst source(SharedRouterModule)
  inst hub(SharedRouterModule)
  def source_incoming = for Array (index in 0..family_plan.ingress_count): source_ingress[family_plan.injection_count + index]
  def source_outgoing = for Array (index in 0..family_plan.egress_count): source_egress[index]
  def hub_incoming = for Array (index in 0..family_plan.ingress_count): hub_ingress[family_plan.injection_count + index]
  def hub_outgoing = for Array (index in 0..family_plan.egress_count): hub_egress[index]
  bind_router_plane(config, ~router_site_key: source.site_key,
                    ~site_key: bits(family_plan.site_key(fixture.source_a), config.route_decoder.site_width),
                    ~ingress: source.ingress, ~targets: source.target,
                    ~incoming: source_incoming, ~outgoing: source_outgoing)
  bind_router_plane(config, ~router_site_key: hub.site_key,
                    ~site_key: bits(family_plan.site_key(fixture.hub), config.route_decoder.site_width),
                    ~ingress: hub.ingress, ~targets: hub.target,
                    ~incoming: hub_incoming, ~outgoing: hub_outgoing)
  source.ingress[0] <=> source_ingress[0]
  hub.ingress[0] <=> hub_ingress[0]
  close_router_local_ports(Bits(8), config, source.ingress, source.target, [0], [])
  close_router_local_ports(Bits(8), config, hub.ingress, hub.target, [0], [family_plan.egress_count])
  source_egress[family_plan.egress_count].valid <== Bool(#false)
  source_egress[family_plan.egress_count].bits <== dont_care(Beat)
  hub_egress[family_plan.egress_count] <=> hub.target[family_plan.egress_count].egress
  hub.target[family_plan.egress_count].available <== hub.target[family_plan.egress_count].egress.ready

def design = elaborate(RouterFamilyFixture())

export:
  family_plan
  config
  design
