#lang rhombus
/* Separately times program elaboration and RTL preparation of the existing TiledSoC design. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  rhombus/cmdline open
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../socs/tiled-soc/main.rhdl" as tiled_rv5stage_soc
  lib("racket/base.rkt") as rkt

def arguments = current_command_line()
unless arguments.length() == 0
| error(~who: #'bench_tiled_rv5stage_soc_elaboration,
        "this benchmark takes no arguments")

for (repetition in 0..6):
  def start = rkt.#{current-inexact-milliseconds}()
  def program = elaborate(tiled_rv5stage_soc.TiledSoC())
  def after_elaboration = rkt.#{current-inexact-milliseconds}()
  def design = compile_program(program, rtl_target).report.design
  def after_preparation = rkt.#{current-inexact-milliseconds}()
  println("tiled-rv5stage-soc repetition=" ++ to_string(repetition) ++ " elaboration_ms=" ++ to_string(after_elaboration - start) ++ " preparation_ms=" ++ to_string(after_preparation - after_elaboration) ++ " modules=" ++ to_string(design.modules.length()))
