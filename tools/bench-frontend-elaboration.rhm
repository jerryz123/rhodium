#lang rhombus
/* Separately times program elaboration and RTL preparation for generated vector wiring. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  rhombus/cmdline open
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../rhodium/frontend/tests/collection-elaboration-benchmark.rhdl" as benchmark
  lib("racket/base.rkt") as rkt

def arguments = current_command_line()
unless arguments.length() >= 1
| error(~who: #'bench_frontend_elaboration,
        "expected one or more circuit sizes")

/* Measure source construction and concrete preparation separately for one size. */
fun run_once(size :: PosInt, repetition :: Nat):
  def start = rkt.#{current-inexact-milliseconds}()
  def program = elaborate(benchmark.CollectionElaboration(size))
  def after_elaboration = rkt.#{current-inexact-milliseconds}()
  def design = compile_program(program, rtl_target).report.design
  def after_preparation = rkt.#{current-inexact-milliseconds}()
  println("size=" ++ to_string(size) ++ " repetition=" ++ to_string(repetition) ++ " elaboration_ms=" ++ to_string(after_elaboration - start) ++ " preparation_ms=" ++ to_string(after_preparation - after_elaboration) ++ " modules=" ++ to_string(design.modules.length()))

for (size_text in arguments):
  def size = rkt.#{string->number}(size_text)
  unless size is_a PosInt
  | error(~who: #'bench_frontend_elaboration,
          "circuit sizes must be positive integers")
  for (repetition in 0..6):
    run_once(size, repetition)
