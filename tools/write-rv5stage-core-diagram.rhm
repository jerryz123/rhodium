#lang rhombus
// Writes the generated RV5Stage core logical diagram to a requested directory.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/cmdline open
  "../examples/rv5stage/core-diagram.rhdl" as example

def arguments = current_command_line()
unless arguments.length() == 1
| error(~who: #'write_rv5stage_core_diagram,
        "expected one output-directory argument")

def output_directory = arguments[0]
def json_path = Path.add(output_directory, "rv5stage-core.json")
def dot_path = Path.add(output_directory, "rv5stage-core.dot")

filesystem.write_string(json_path, example.json, ~exists: #'truncate)
filesystem.write_string(dot_path, example.dot, ~exists: #'truncate)
println("wrote " ++ json_path.string())
println("wrote " ++ dot_path.string())
