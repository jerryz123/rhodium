#lang rhombus
/* Writes the simulator-specific OpenSBI device tree with an HTIF reset endpoint. */
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/cmdline open
  "../../devicetree/main.rhm" open
  "../../socs/platform/description.rhm".RiscvSoCDescription
  "../program-test/targets.rhm" open
  "../../socs/configs/selection.rhm".parse_isa_preset

/* Adds the simulator's HTIF reset endpoint to the selected SoC's architectural device tree. */
fun opensbi_device_tree(description :: RiscvSoCDescription):
  def base = description.to_device_tree()
  def root = base.root
  DeviceTree(
    DeviceTreeNode(
      root.name,
      root.properties,
      root.children ++ [
        DeviceTreeNode(
          "htif",
          [DeviceTreeProperty("compatible", DeviceTreeString("ucb,htif0"))]
        )
      ]
    ),
    base.reservations,
    ~boot_cpuid: base.boot_cpuid
  )

/* Writes a selected platform DTB with the simulator's HTIF reset endpoint. */
fun write_opensbi_device_tree(description :: RiscvSoCDescription, output :: String):
  filesystem.write_bytes(output, opensbi_device_tree(description).to_dtb(), ~exists: #'truncate)

def arguments = current_command_line()
cond
| arguments.length() > 0 && arguments[0] == "--batch":
    unless arguments.length() >= 3 && arguments.length() mod 2 == 1
    | error(~who: #'write_opensbi_device_tree, "expected --batch followed by config/output pairs")
    for (pair in 0..((arguments.length() - 1) div 2)):
      def index = 1 + 2 * pair
      write_opensbi_device_tree(simulator_soc_description(arguments[index]), arguments[index + 1])
| arguments.length() == 2:
    write_opensbi_device_tree(simulator_soc_description(arguments[0]), arguments[1])
| arguments.length() == 4:
    write_opensbi_device_tree(simulator_shape_description(arguments[0], arguments[1], ~isa: parse_isa_preset(arguments[2])), arguments[3])
| ~else:
    error(~who: #'write_opensbi_device_tree, "expected config and output, shape/core/ISA and output, or --batch followed by config/output pairs")
