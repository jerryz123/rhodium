#lang rhombus
// Writes the simulator-specific OpenSBI device tree with an HTIF reset endpoint.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/cmdline open
  "../../devicetree/main.rhm" open
  "../../socs/platform/description.rhm".RiscvSoCDescription
  "../program-test/targets.rhm" open
  "../../socs/products/selection.rhm".parse_isa_preset

fun opensbi_device_tree(description :: RiscvSoCDescription):
  def base = description.to_device_tree()
  def root = base.root
  DeviceTree(
    DeviceTreeNode(
      root.name,
      root.properties,
      root.children ++ [
        DeviceTreeNode(
          "htif",
          [DeviceTreeProperty("compatible", DeviceTreeString("ucb,htif0"))]
        )
      ]
    ),
    base.reservations,
    ~boot_cpuid: base.boot_cpuid
  )

def arguments = current_command_line()
unless arguments.length() == 2 || arguments.length() == 4
| error(~who: #'write_opensbi_device_tree, "expected a shape-core-isa product key and output file, or shape, core, ISA, and output file")
def description = if arguments.length() == 4
| simulator_shape_description(arguments[0], arguments[1], ~isa: parse_isa_preset(arguments[2]))
| simulator_soc_description(arguments[0])
filesystem.write_bytes(
  arguments[arguments.length() - 1],
  opensbi_device_tree(description).to_dtb(),
  ~exists: #'truncate
)
