Date: Sat, 19 Sep 2026 11:04:02 -0700
Subject: [PATCH 4/4] Enable canonical vector suite expansion

---
 generators/testgen/src/testgen/io/testplans.py | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/generators/testgen/src/testgen/io/testplans.py b/generators/testgen/src/testgen/io/testplans.py
index 8b65b4251c8a3dfd046627883fc7522f3d29d949..b9b6023f434ae53f7b942131021d002d2a028e60 100644
--- a/generators/testgen/src/testgen/io/testplans.py
+++ b/generators/testgen/src/testgen/io/testplans.py
@@ -28,10 +28,6 @@ def get_extensions(testplan_dir: Path) -> list[str]:
 def expand_vector_extension(extension: str) -> list[str]:
     """Expands a vector extension by adding SEW suffixes."""
 
-    if not extension.startswith(("Vx", "Vls")):
-        # Only Vx and Vls are supported for now
-        return []
-
     if extension in ["Vx", "Vls", "Zvbb", "Zvkb"]:
         return [extension + effew for effew in ["8", "16", "32", "64"]]
     elif extension in ["ExceptionsVf", "Vf"]:
