+def _register(test_data: TestData, name: str, values: list[int], sew: int) -> str:
+    label = f"custom_{name}_{test_data.test_count:04d}"
+    test_data.register_vector_data(label, sew, elements=values)
+    return label
+
+
+def _emit(
+    instr_name: str,
+    instr_type: str,
+    coverpoint: str,
+    test_data: TestData,
+    description: str,
+    *,
+    vd_values: list[int],
+    vs2_values: list[int],
+    vs1_values: list[int] | None = None,
+) -> TestChunk:
+    assert test_data.config.sew is not None
+    sew = test_data.config.sew
+    fixed: dict[str, object] = {
+        "vd": 0,
+        "vs2": 4,
+        "vd_val_pointer": _register(test_data, "vd", vd_values, sew),
+        "vs2_val_pointer": _register(test_data, "vs2", vs2_values, sew),
+        "vl": 4,
+        "egs": 4,
+    }
+    no_overlap = {("vd", "vs2")}
+    if vs1_values is not None:
+        fixed.update(vs1=8, vs1_val_pointer=_register(test_data, "vs1", vs1_values, sew))
+        no_overlap.update({("vd", "vs1"), ("vs1", "vs2")})
+    params = generate_random_vector_params(
+        test_data,
+        instr_name,
+        instr_type,
+        lmul=4,
+        additional_no_overlap=no_overlap,
+        suite="base",
+        **fixed,
+    )
+    suffix = f"{test_data.test_count:04d}"
+    chunk = format_single_testcase(instr_name, instr_type, test_data, params, description, suffix, coverpoint)
+    return_testcase_registers(test_data, params)
+    return chunk
+
