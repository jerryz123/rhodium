+@add_coverpoint_generator("cp_custom_act3_crypto")
+def make_act3(instr_name: str, instr_type: str, coverpoint: str, test_data: TestData) -> list[TestChunk]:
+    chunks = []
+    for index, (vd_offset, vs2_offset) in enumerate(ACT3_TEST_OFFSETS):
+        chunks.append(_emit(
+            instr_name,
+            instr_type,
+            coverpoint,
+            test_data,
+            f"ACT3 vector crypto test {index}",
+            vd_values=ACT3_TEST_DATA[vd_offset:vd_offset + 4],
+            vs2_values=ACT3_TEST_DATA[vs2_offset:vs2_offset + 4],
+        ))
+    return chunks
+
+
+@add_coverpoint_generator("cp_custom_nist_sha")
+def make_nist_sha(instr_name: str, instr_type: str, coverpoint: str, test_data: TestData) -> list[TestChunk]:
+    assert test_data.config.sew is not None
+    sew = test_data.config.sew
+    schedule = MESSAGE_SCHEDULE_256 if sew == 32 else MESSAGE_SCHEDULE_512
+    rounds = HASH_ROUND_VALUES_256 if sew == 32 else HASH_ROUND_VALUES_512
+    constants = K_256 if sew == 32 else K_512
+    if instr_name.startswith("vsha2ms"):
+        return [_emit(
+            instr_name,
+            instr_type,
+            coverpoint,
+            test_data,
+            "NIST SHA message schedule example",
+            vd_values=schedule[0:4],
+            vs2_values=[schedule[4], schedule[9], schedule[10], schedule[11]],
+            vs1_values=schedule[12:16],
+        )]
+    chunks = []
+    for index, values in enumerate(rounds):
+        a, b, c, d, e, f, g, h = values
+        chunks.append(_emit(
+            instr_name,
+            instr_type,
+            coverpoint,
+            test_data,
+            f"NIST SHA round example {index}",
+            vd_values=[c, d, g, h],
+            vs2_values=[a, b, e, f],
+            vs1_values=[(schedule[offset] + constants[offset]) & ((1 << sew) - 1)
+                        for offset in range(index, index + 4)],
+        ))
+    return chunks
+
+
+def _get_128_bits(value: str, index: int) -> int:
+    return (int(value, 16) >> (index * 128)) & ((1 << 128) - 1)
+
+
+def _gcm_data(row: dict[str, str]) -> dict[str, int]:
+    associated = row["A"]
+    ciphertext = row["C"]
+    padded_ciphertext = ciphertext + "0" * ((32 if len(ciphertext) <= 32 else 128) - len(ciphertext))
+    data: dict[str, int] = {}
+    if row["X1"]:
+        if len(padded_ciphertext) == 32:
+            data.update(X1=int(row["X1"], 16), C1=int(row["C"], 16))
+        elif not associated:
+            for index in range(1, 5):
+                data[f"X{index}"] = int(row[f"X{index}"], 16)
+                data[f"C{index}"] = _get_128_bits(row["C"], index - 1)
+        else:
+            padded_associated = associated + "0" * (64 - len(associated))
+            for index in range(1, 3):
+                data[f"A{index}"] = _get_128_bits(padded_associated, index - 1)
+            for index in range(1, 5):
+                data[f"C{index}"] = _get_128_bits(row["C"], index - 1)
+            for index in range(1, 7):
+                data[f"X{index}"] = int(row[f"X{index}"], 16)
+    data["H"] = int(row["H"], 16)
+    data["AorC"] = int(row["len(A)||len(C)"], 16)
+    return data
+
+
+def _words(value: int) -> list[int]:
+    return [(value >> (32 * index)) & 0xFFFFFFFF for index in range(4)]
+
+
+@add_coverpoint_generator("cp_custom_nist_gcm")
+def make_nist_gcm(instr_name: str, instr_type: str, coverpoint: str, test_data: TestData) -> list[TestChunk]:
+    path = Path(__file__).with_name("data") / "gcm_test_vectors_wide.csv"
+    chunks = []
+    with path.open() as source:
+        rows = DictReader(line for line in source if not line.startswith("#"))
+        for case, row in enumerate(rows):
+            data = _gcm_data(row)
+            accumulator = 0
+            step = 0
+            for field in ("A1", "A2", "C1", "C2", "C3", "C4", "AorC"):
+                if field not in data:
+                    continue
+                operand = data[field]
+                vd_value = accumulator if instr_name.startswith("vghsh") else accumulator ^ operand
+                chunks.append(_emit(
+                    instr_name,
+                    instr_type,
+                    coverpoint,
+                    test_data,
+                    f"NIST GCM example {case} {field}",
+                    vd_values=_words(vd_value),
+                    vs2_values=_words(data["H"]),
+                    vs1_values=_words(operand) if instr_name.startswith("vghsh") else None,
+                ))
+                step += 1
+                if f"X{step}" in data:
+                    accumulator = data[f"X{step}"]
+    return chunks
