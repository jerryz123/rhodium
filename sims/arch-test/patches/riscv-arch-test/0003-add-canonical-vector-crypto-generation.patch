+# Formats vector-crypto element-group instructions through the generic vector formatters.
+# SPDX-License-Identifier: Apache-2.0
+
+from testgen.data.params import InstructionParams
+from testgen.data.state import TestData
+from testgen.formatters.registry import InstructionTypeConfig, VectorTypeConfig, add_instruction_formatter
+from testgen.formatters.types.vv_type import format_vv_like_type
+from testgen.formatters.types.vvi_type import format_vvi_like_type
+from testgen.formatters.types.vvv_type import format_vvv_like_type
+
+
+vv_egs_config = InstructionTypeConfig(required_params={"vd", "vs2"}, vector_data=VectorTypeConfig(maskable=False))
+vvv_egs_config = InstructionTypeConfig(
+    required_params={"vd", "vs1", "vs2"}, vector_data=VectorTypeConfig(maskable=False)
+)
+vvi_egs_config = InstructionTypeConfig(
+    required_params={"vd", "vs2", "immval"},
+    imm_bits=4,
+    imm_signed=False,
+    vector_data=VectorTypeConfig(maskable=False),
+)
+
+
+def _set_egs(params: InstructionParams, egs: int) -> None:
+    params.egs = egs
+    if isinstance(params.vl, int) and params.vl < egs:
+        params.vl = egs
+
+
+@add_instruction_formatter("VV_EGS4", vv_egs_config)
+def format_vv_egs4(
+    instr: str, test_data: TestData, params: InstructionParams
+) -> tuple[list[str], list[str], list[str]]:
+    _set_egs(params, 4)
+    return format_vv_like_type(instr, test_data, params, "VV_EGS4", preload_vs2=True)
+
+
+@add_instruction_formatter("VVV_EGS4", vvv_egs_config)
+def format_vvv_egs4(
+    instr: str, test_data: TestData, params: InstructionParams
+) -> tuple[list[str], list[str], list[str]]:
+    _set_egs(params, 4)
+    return format_vvv_like_type(instr, test_data, params, "VVV_EGS4", enable_vs2_preload=True)
+
+
+@add_instruction_formatter("VVI_EGS4", vvi_egs_config)
+def format_vvi_egs4(
+    instr: str, test_data: TestData, params: InstructionParams
+) -> tuple[list[str], list[str], list[str]]:
+    _set_egs(params, 4)
+    return format_vvi_like_type(instr, test_data, params, "VVI_EGS4", enable_vs2_preload=True)
+
+
+@add_instruction_formatter("VVV_EGS8", vvv_egs_config)
+def format_vvv_egs8(
+    instr: str, test_data: TestData, params: InstructionParams
+) -> tuple[list[str], list[str], list[str]]:
+    _set_egs(params, 8)
+    return format_vvv_like_type(instr, test_data, params, "VVV_EGS8", enable_vs2_preload=True)
+
+
+@add_instruction_formatter("VVI_EGS8", vvi_egs_config)
+def format_vvi_egs8(
+    instr: str, test_data: TestData, params: InstructionParams
+) -> tuple[list[str], list[str], list[str]]:
+    _set_egs(params, 8)
+    return format_vvi_like_type(instr, test_data, params, "VVI_EGS8", enable_vs2_preload=True)
