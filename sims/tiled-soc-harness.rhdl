#lang rhodium
// Wraps a selected tiled SoC with FESVR, external memory, and a serial-pin PTY UART.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("chi/subordinate/memory-controller.rhdl") open
  lib("chi/subordinate/dpi-memory.rhdl").CHIDPIMemory
  lib("socs/tiled-soc/main.rhdl") as tiled
  lib("socs/products/tiled-rv5stage.rhdl").default_tiled_soc_config
  lib("socs/tiled-soc/compile.rhdl") as compiler
  lib("devices/uart/uart-dpi.rhdl").UartDPI
  "fesvr/direct-memory-htif.rhdl".FesvrRequester

sync_circuit SoCHarness(soc_config :: tiled.TiledSoCConfig = default_tiled_soc_config,
                        uart_oversample_divisor :: Int.in(1 ..= 0xffff) = 1):
  def implementation = compiler.compile_tiled_soc(soc_config)
  output exit: Bits(32)

  inst requester(FesvrRequester(soc_config.hart.description.xlen, implementation.flit, implementation.host.node, implementation.home_map, implementation.hart_config.physical_map, implementation.host_services, soc_config.boot.boot_address_register))
  inst soc(tiled.TiledSoC(soc_config, implementation))
  inst memory(CHIDPIMemory(CHIRamConfig(implementation.flit, soc_config.memory.size_bytes, ~max_outstanding: implementation.memory.node.max_outstanding, ~max_transfer_bytes: 64), 0))
  inst uart(UartDPI(0, uart_oversample_divisor))

  requester.port <=> soc.host.memory
  soc.memory <=> memory.port
  exit <== requester.exit
  memory.identity <== CHIRamIdentity(implementation.flit):
    node_id: bits(implementation.memory.node.node_id, implementation.flit.node_id_width)
    base_address: bits(soc_config.memory.base, implementation.flit.request_address_width)
  uart.uart_tx <== soc.uart.tx
  soc.uart.rx <== uart.uart_rx

def design = elaborate(SoCHarness())

export:
  SoCHarness
  design
