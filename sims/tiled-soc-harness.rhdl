#lang rhodium
// Wraps bootable TiledSoC with FESVR while passing its synthesizable UART pins through.

import:
  lib("riscv/isa/xlen.rhm").XLen
  lib("socs/tiled-soc/main.rhdl") as tiled
  lib("socs/tiled-soc/compile.rhdl") as compiler
  lib("socs/peripherals.rhdl").SoCUartInterface
  "fesvr/direct-memory-htif.rhdl".FesvrRequester

sync_circuit SoCHarness(soc_config :: tiled.TiledSoCConfig = tiled.default_tiled_soc_config):
  def implementation = compiler.compile_tiled_soc(soc_config)
  output exit: Bits(32)
  interface uart(SoCUartInterface(), ~role: soc)

  inst requester(FesvrRequester(XLen.X64, implementation.flit, implementation.host.node, implementation.home_map))
  inst soc(tiled.TiledSoC(soc_config))

  requester.port <=> soc.host.memory
  def boot_entry_matches = requester.start.bits === bits(soc_config.boot.payload_address, 64)
  soc.host.release.valid <== requester.start.valid & boot_entry_matches
  requester.start.ready <== soc.host.release.ready & boot_entry_matches
  uart <=> soc.uart
  exit <== requester.exit

  when (requester.start.valid):
    assert(boot_entry_matches, "fesvr_entry_matches_boot_payload")

def design = elaborate(SoCHarness())

export:
  SoCHarness
  design
