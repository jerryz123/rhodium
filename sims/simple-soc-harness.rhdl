#lang rhodium
// Wraps bootable SimpleSoC with FESVR, simulation memory, and pass-through UART pins.

import:
  lib("riscv/isa/xlen.rhm").XLen
  lib("chi/main.rhdl") as chi
  lib("socs/simple-soc.rhdl") as simple
  lib("socs/peripherals.rhdl").SoCUartInterface
  "fesvr/direct-memory-htif.rhdl".FesvrRequester
  lib("flow/event.rhdl") open

sync_circuit SoCHarness(params :: simple.SimpleSoCParams = simple.simple_soc_params):
  output exit: Bits(32)
  interface uart(SoCUartInterface(), ~role: soc)

  def fabric_params = params.fabric
  inst requester(FesvrRequester(XLen.X64, fabric_params.flit, fabric_params.host_node, fabric_params.home_map, fabric_params.rv5stage_config.physical_map, fabric_params.host_services, fabric_params.boot.boot_address_register))
  inst soc(simple.SimpleSoC(params))
  inst memory(chi.CHIDPIMemory(chi.CHIRamConfig(fabric_params.flit, fabric_params.memory_bytes, ~max_outstanding: fabric_params.memory_port.max_outstanding, ~max_transfer_bytes: 64)))

  requester.port <=> soc.host.memory
  uart <=> soc.uart
  soc.memory.req |> trace_event("memory-request", ~payload: #true, ~root: #true) |> trace_event("memory-accept", ~payload: #true, ~terminal: #true) |> memory.port.req
  memory.port.rsp |> trace_event("memory-response", ~payload: #true, ~root: #true) |> trace_event("soc-response", ~payload: #true, ~terminal: #true) |> soc.memory.rsp
  soc.memory.dat <=> memory.port.dat
  memory.identity <== chi.CHIRamIdentity(fabric_params.flit):
    node_id: bits(fabric_params.memory_port.node_id, fabric_params.flit.node_id_width)
    base_address: bits(fabric_params.memory_base, fabric_params.flit.request_address_width)
  exit <== requester.exit

def elaboration = elaborate_with_top(SoCHarness())
def design = elaboration.design
def trace_clock_frequency_hz = simple.simple_soc_params.clocks.clock_frequency_hz

export:
  SoCHarness
  design
  elaboration
  trace_clock_frequency_hz
