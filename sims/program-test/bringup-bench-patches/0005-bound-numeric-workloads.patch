diff --git a/idct-alg/idct-alg.c b/idct-alg/idct-alg.c
--- a/idct-alg/idct-alg.c
+++ b/idct-alg/idct-alg.c
@@ -1,6 +1,9 @@
+/* Computes a bounded four-by-four IDCT sample in an eight-by-eight buffer. */
+/* SPDX-License-Identifier: Apache-2.0 */
 #include "libmin.h"
 
 #define N 8
+#define IDCT_SAMPLES 4
 #define PI 3.14159265358979323846
 
 double C(int u) {
@@ -8,11 +11,11 @@
 }
 
 void idct_2d(double input[N][N], double output[N][N]) {
-    for (int x = 0; x < N; x++) {
-        for (int y = 0; y < N; y++) {
+    for (int x = 0; x < IDCT_SAMPLES; x++) {
+        for (int y = 0; y < IDCT_SAMPLES; y++) {
             double sum = 0.0;
-            for (int u = 0; u < N; u++) {
-                for (int v = 0; v < N; v++) {
+            for (int u = 0; u < IDCT_SAMPLES; u++) {
+                for (int v = 0; v < IDCT_SAMPLES; v++) {
                     sum += C(u) * C(v) * input[u][v] *
                         libmin_cos(((2 * x + 1) * u * PI) / (2 * N)) *
                         libmin_cos(((2 * y + 1) * v * PI) / (2 * N));
