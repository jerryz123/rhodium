#lang rhombus
// Projects concrete SoC capabilities, compiler options, and RAM bounds for target programs.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/cmdline open
  "../../socs/single-core-rv5stage-soc.rhdl" as single_core
  "../../socs/mini-rv5stage-soc.rhdl" as mini_rv5stage
  "../../socs/tiled-rv5stage-soc/main.rhdl" as tiled_rv5stage
  "../../riscv/gnu-toolchain.rhm".gnu_isa_target
  "../../socs/description.rhm".RiscvSoCDescription

def arguments = current_command_line()
unless arguments.length() == 2
| error(~who: #'write_program_target, "expected a SoC name and output file")
def name = arguments[0]
def description :: RiscvSoCDescription = match name
| "single-core-rv5stage-soc": single_core.single_core_rv5stage_soc_params.description
| "mini-rv5stage-soc": mini_rv5stage.mini_rv5stage_soc_params.description
| "tiled-rv5stage-soc": tiled_rv5stage.default_tiled_rv5stage_soc_config.description
| ~else: error(~who: #'write_program_target, "expected single-core-rv5stage-soc, mini-rv5stage-soc, or tiled-rv5stage-soc")
def compiler_target = gnu_isa_target(
  description.core_profile.xlen,
  description.core_profile.isa_profile.isa_extensions
)

// ISA extension names are canonical identifiers from the core profile.
def extensions = String.join(description.core_profile.isa_profile.isa_extensions.map(fun (extension :: String): "\"" ++ extension ++ "\""), ",")
def region_strings = for List (region in description.memory_regions):
  "{\"base\":" ++ to_string(region.base) ++ ",\"size\":" ++ to_string(region.size_bytes) ++ "}"
def regions = String.join(region_strings, ",")
filesystem.write_string(arguments[1],
                        "{\"soc\":\"" ++ name ++ "\",\"xlen\":" ++ to_string(description.core_profile.xlen.width) ++ ",\"extensions\":[" ++ extensions ++ "],\"march\":\"" ++ compiler_target.march ++ "\",\"mabi\":\"" ++ compiler_target.mabi ++ "\",\"clock_frequency_hz\":" ++ to_string(description.clocks.clock_frequency_hz) ++ ",\"ram\":[" ++ regions ++ "]}\n",
                        ~exists: #'truncate)
