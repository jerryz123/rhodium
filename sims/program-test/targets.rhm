#lang rhombus
// Resolves simulator SoC names to their canonical architectural descriptions.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../socs/single-core-rv5stage-soc.rhdl" as single_core
  "../../socs/mini-rv5stage-soc.rhdl" as mini_rv5stage
  "../../socs/tiled-rv5stage-soc/main.rhdl" as tiled_rv5stage
  "../../socs/description.rhm".RiscvSoCDescription

def SimulatorSoCNames = ["single-core-rv5stage-soc", "mini-rv5stage-soc", "tiled-rv5stage-soc"]

fun simulator_soc_description(name :: String) :: RiscvSoCDescription:
  match name
  | "single-core-rv5stage-soc": single_core.single_core_rv5stage_soc_params.description
  | "mini-rv5stage-soc": mini_rv5stage.mini_rv5stage_soc_params.description
  | "tiled-rv5stage-soc": tiled_rv5stage.default_tiled_rv5stage_soc_config.description
  | ~else:
      error(~who: #'simulator_soc_description,
            "unknown simulator SoC " ++ name ++ "; expected one of " ++ String.join(SimulatorSoCNames, ", "))

export:
  SimulatorSoCNames
  simulator_soc_description
