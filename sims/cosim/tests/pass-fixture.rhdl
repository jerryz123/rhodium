#lang rhodium
// SPDX-License-Identifier: Apache-2.0
import:
  lib("flow/main.rhdl") open
  "../../../cores/riscv/cosim-source.rhm" open

dpi_import procedure cosim_test_sample(instance: Bits(64), value: Bits(8))
dpi_import procedure cosim_test_functional(value: Bits(8))

sync_circuit TestObserver(instance :: Nat):
  input value: Bits(8)
  input accepted: Bool
  input component_value: Bits(8)
  cosim_test_sample.call(bits(instance, 64), value ^ component_value, ~enable: accepted)

fun recipe(_types :: Map, _parameters :: Map, instance :: Nat):
  elaborate_with_top(TestObserver(instance))

sync_circuit ObservedComponent():
  input value: Bits(8)
  describe_cosim_signals({"value": value})

sync_circuit ObservedLane(wrong_domain :: Boolean = #false, unsupported :: Boolean = #false):
  interface source(Decoupled(Bits(8)), ~role: consumer)
  interface sink(Decoupled(Bits(8)), ~role: producer)
  source |> trace_event("accepted", ~payload: #true) |> pipe(1) |> trace_event("completed") |> sink
  cosim_test_functional.call(source.bits, ~enable: source.fire())
  def component:
    if wrong_domain
    | inst child(ObservedComponent(), ~reset_when: source.valid)
      child.value <== source.bits
      child
    | inst child(ObservedComponent())
      child.value <== source.bits
      child
  describe_cosim_hart(recipe, {"value": source.bits, "accepted": source.fire()}, {"component": component}, ~unsupported: if unsupported | "unsupported test profile" | #false)

sync_circuit ObservedTop():
  interface source[2](Decoupled(Bits(8)), ~role: consumer)
  interface sink[2](Decoupled(Bits(8)), ~role: producer)
  inst left(ObservedLane())
  inst right(ObservedLane())
  source[0] |> left.source
  left.sink |> sink[0]
  source[1] |> right.source
  right.sink |> sink[1]

export:
  make_fixture
  make_wrong_domain_fixture
  make_unsupported_fixture
fun make_fixture(): elaborate_program(ObservedTop())
fun make_wrong_domain_fixture(): elaborate_program(ObservedLane(#true))
fun make_unsupported_fixture(): elaborate_program(ObservedLane(#false, #true))
