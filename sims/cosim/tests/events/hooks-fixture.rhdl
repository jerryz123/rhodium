#lang rhodium
/* Exercises architectural hook transport, delayed completion, and disabled hooks. */
// SPDX-License-Identifier: Apache-2.0
import:
  lib("sims/cosim/events/hooks.rhdl") open
  lib("riscv/rtl/privilege.rhdl").PrivilegeMode

/* Emit a fixed semantic transcript from explicit cycle inputs. */
circuit CosimHookSource(enabled :: Boolean):
  input clock: Clock
  input step: Bits(4)
  def hart = CosimHart(clock, Bits(64)(0), enabled)
  def zero = Bits(64)(0)
  def id0 = CosimInstructionId():
    epoch: zero
    order: zero
  def id1 = CosimInstructionId():
    epoch: zero
    order: Bits(64)(1)
  def id2 = CosimInstructionId():
    epoch: zero
    order: Bits(64)(2)
  def id3 = CosimInstructionId():
    epoch: zero
    order: Bits(64)(3)
  def instruction = CosimInstruction():
    pc: Bits(64)(0x80000000)
    encoding: Bits(32)(0x13)
    encoding_valid_bytes: Bits(3)(4)
    instruction_bytes: Bits(3)(4)
    privilege: PrivilegeMode.Machine
    virtualized: Bool(#false)
    producers: mux(step === Bits(4)(0), Bits(64)(1), zero)
  def retirement = CosimRetirement():
    next_pc: Bits(64)(0x80000004)
    privilege: PrivilegeMode.Machine
    virtualized: Bool(#false)
  def trap = CosimTrap():
    cause: Bits(64)(13)
    epc: Bits(64)(0x80000000)
    tval: Bits(64)(0x2000)
    target_pc: Bits(64)(0x100)
    privilege: PrivilegeMode.Supervisor
    virtualized: Bool(#true)
    guest_valid: Bool(#true)
    htval: Bits(64)(0x800)
    htinst: Bits(64)(0x3000)
  def register_write = CosimRegisterWrite():
    bank: CosimRegisterBank.Vector
    register_index: Bits(5)(7)
    bit_offset: Bits(16)(128)
    mask: !zero
    value: Bits(64)(0x8000000000000042)
  def csr = CosimCsrUpdate():
    address: Bits(12)(1)
    operation: CosimCsrOperation.SetBits
    mask: Bits(64)(31)
    value: Bits(64)(16)
  def memory = CosimMemoryEffect():
    access_id: Bits(64)(7)
    fragment_offset: Bits(64)(3)
    kind: CosimAccessKind.Load
    virtual_address: Bits(64)(0x2000)
    physical_valid: Bool(#true)
    physical_address: Bits(64)(0x80001000)
    byte_mask: Bits(8)(0xff)
    read_valid: Bool(#true)
    write_valid: Bool(#false)
    read_data: Bits(64)(0x8000000000000042)
    write_data: zero
    result: CosimAccessResult.Success
  def effect0 = CosimEffectId():
    producer: Bits(6)(0)
    index: zero
  def effect1 = CosimEffectId():
    producer: Bits(6)(0)
    index: Bits(64)(1)
  def effect2 = CosimEffectId():
    producer: Bits(6)(0)
    index: Bits(64)(2)
  hart.instruction(step === Bits(4)(0), id0, instruction)
  hart.instruction(step === Bits(4)(1), id1, instruction)
  hart.retire(step === Bits(4)(1), id1, retirement)
  hart.reg_write(step === Bits(4)(1), id0, effect0, register_write)
  hart.csr_update(step === Bits(4)(1), id0, effect1, csr)
  hart.memory(step === Bits(4)(1), id0, effect2, memory)
  hart.seal(step === Bits(4)(1), id0, Bits(6)(0), Bits(64)(3))
  hart.retire(step === Bits(4)(2), id0, retirement)
  hart.instruction(step === Bits(4)(3), id2, instruction)
  hart.exception(step === Bits(4)(3), id2, trap)
  hart.interrupt(step === Bits(4)(4), id3, trap, zero)

/* Disabled hooks receive identical inputs and must emit no duplicate callbacks. */
circuit CosimHooksFixture():
  input clock: Clock
  input step: Bits(4)
  inst active(CosimHookSource(#true))
  inst disabled(CosimHookSource(#false))
  active.clock <== clock
  active.step <== step
  disabled.clock <== clock
  disabled.step <== step

export:
  CosimHooksFixture
