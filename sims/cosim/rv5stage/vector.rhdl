#lang rhodium
/* Adapts RV5Stage physical memory provenance to the shared passive vector observer. */
// SPDX-License-Identifier: Apache-2.0
import:
  "../../../cores/cache/protocol.rhdl" open
  "../../../cores/rv5stage/profile.rhm".RV5StageConfig
  "../events/transport.rhdl".capture_lane
  "../../../cores/rv5stage/memory-context.rhdl" open
  "../vector/capture.rhdl" open

/* Normalizes RV5Stage memory provenance for the shared vector observer. */
fun rv5stage_cosim_vector(profile :: RV5StageConfig, types :: Map, mmu :: Map, instance :: Bits(64), active :: Bool):
  def slots = profile.vector_completion_slots
  cosim_vector(profile.xlen, profile.vector_length, slots, types, mmu, instance, active)
  if types.has_key("mmu_request")
  | block:
      def request :: PhysicalMemoryReq(profile.xlen, RV5StageMemoryContext(slots)) = mmu["mmu_request"]
      def vector_request = request.context.writeback.is(RV5StageMemoryWriteback(slots).Vector).into(Bool)
      def tag = request.context.writeback.view(RV5StageMemoryWriteback(slots).Vector).payload
      rhodium_vector_translation.call(
        instance, capture_lane(tag), capture_lane(mmu["mmu_request_address"]),
        ~enable: active & mmu["mmu_request_valid"] & vector_request
      )
  | #void

  if types.has_key("mmu_fragment_completed")
  | block:
      def request :: PhysicalMemoryReq(profile.xlen, RV5StageMemoryContext(slots)) = mmu["mmu_fragment_request"]
      def response :: PhysicalMemoryResp(profile.xlen, RV5StageMemoryContext(slots)) = mmu["mmu_fragment_response"]
      def vector_request = request.context.writeback.is(RV5StageMemoryWriteback(slots).Vector).into(Bool)
      def tag = request.context.writeback.view(RV5StageMemoryWriteback(slots).Vector).payload
      rhodium_vector_fragment_start.call(instance, capture_lane(mmu["mmu_fragment_address"]), ~enable: active & mmu["mmu_fragment_valid"])
      rhodium_vector_fragment.call(
        instance, capture_lane(tag), capture_lane(request.address), capture_lane(request.byte_mask),
        capture_lane(response.data), capture_lane(request.data),
        ~enable: active & mmu["mmu_fragment_completed"] & !response.access_fault & vector_request
      )
  | #void

export rv5stage_cosim_vector
