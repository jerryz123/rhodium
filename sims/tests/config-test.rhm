#lang rhombus
// Checks config identities and core-independent ACT platform projection.
// SPDX-License-Identifier: Apache-2.0

import:
  "../test-configs.rhm".TestConfigs
  lib("socs/configs/selection.rhm") open
  lib("socs/configs/resolve.rhm").resolve_soc_config
  lib("socs/configs/metadata.rhm") open
  lib("socs/harts/rv5stage.rhdl").rv5stage_hart
  lib("socs/harts/spike.rhdl").spike_hart
  lib("socs/single-core-soc/main.rhdl").single_core_soc_config
  lib("cores/rv5stage/profile.rhm").RV5StageConfig
  lib("cores/spike/profile.rhm").SpikeConfig
  lib("socs/platform/description.rhm") open
  lib("rhodium/std/interconnect.rhdl").AddressSet
  lib("riscv/isa/hart.rhm").RiscvMmuType
  "../arch-test/platform.rhm".ActPlatform

def names = TestConfigs.map(fun (config :: SoCSelection): config.key)
check:
  names ~is [
    "mini-rv5stage-rv32int",
    "mini-spike-rv32int",
    "mini-rv5stage-rv32max",
    "mini-spike-rv32max",
    "mini-rv5stage-rva23",
    "mini-spike-rva23",
    "simple-rv5stage-rv32int",
    "simple-spike-rv32int",
    "simple-rv5stage-rv32max",
    "simple-spike-rv32max",
    "simple-rv5stage-rv64max",
    "simple-spike-rv64max",
    "simple-rv5stage-rv64imacb",
    "simple-spike-rv64imacb",
    "simple-rv5stage-rv64imafdcb",
    "simple-spike-rv64imafdcb",
    "simple-rv5stage-rva23",
    "simple-spike-rva23",
    "tiled-rv5stage-rva23",
    "tiled-spike-rva23"
  ]
for (config in TestConfigs):
  def resolved = resolve_soc_config(config)
  def metadata = config_metadata(resolved)
  check:
    named_soc_selection(config.key) ~is config
    names.filter(~keep: fun (name): name == config.key).length() ~is 1
    metadata["config"] ~is config.key
    metadata_fingerprint(metadata).length() ~is 64
    metadata_fingerprint(config_metadata(resolve_soc_config(config))) ~is metadata_fingerprint(metadata)
    metadata_json(metadata).contains("#<procedure") ~is #false
    metadata_json(metadata).contains("#<function") ~is #false
    metadata["csr_warl"]["pmm_unsupported_write"] ~is "disabled"
    metadata["csr_warl"]["medeleg_mask"] ~is (if config.core == CoreKind.RV5Stage | 0xcb3fe | (if resolved.hart.description.mmu_type == RiscvMmuType.Bare | 0x803fe | 0x8b3fe)) bits.or (if config.isa == IsaPreset.RVA23 | 0xf00400 | 0)
    metadata["csr_warl"]["hedeleg_mask"] ~is (if config.isa == IsaPreset.RVA23 | (if config.core == CoreKind.RV5Stage | 0xcb1fe | 0xcb1ff) | 0)
  when config.core == CoreKind.Spike
  | block:
      def profile :: SpikeConfig = resolved.hart.profile
      check: profile.max_retired_instructions_per_cycle ~is 64

// Implementation changes must invalidate artifacts even when the ISA stays identical.
def hardware = resolve_soc_config(named_soc_selection("simple-rv5stage-rva23"))
def profile :: RV5StageConfig = hardware.hart.profile
def deeper = single_core_soc_config(rv5stage_hart(profile with (data_cache_service_queue_depth = 8)))
def larger = single_core_soc_config(hardware.hart, ~llc_sets: 128)
check:
  metadata_fingerprint(config_metadata(hardware, deeper)) == metadata_fingerprint(config_metadata(hardware)) ~is #false
  metadata_fingerprint(config_metadata(hardware, larger)) == metadata_fingerprint(config_metadata(hardware)) ~is #false

def model = resolve_soc_config(named_soc_selection("simple-spike-rva23"))
def slower = single_core_soc_config(spike_hart(SpikeConfig(model.hart.description, ~max_retired_instructions_per_cycle: 2, ~pmp_regions: 0)))
check:
  metadata_fingerprint(config_metadata(model, slower)) == metadata_fingerprint(config_metadata(model)) ~is #false

for (isa in [IsaPreset.RV32Int, IsaPreset.RV32Max, IsaPreset.RVA23]):
  def platforms = for List (core in [CoreKind.RV5Stage, CoreKind.Spike]):
    def config = resolve_soc_config(SoCSelection(SoCShape.Simple, core, isa))
    def platform = ActPlatform(config.description)
    check:
      platform.ram.base ~is 0x80000000
      platform.ram.size_bytes ~is 0x40000000
      platform.test_base ~is config.description.boot.payload_address
      platform.access_fault_address ~is 0
      platform.access_fault_bytes ~is 4096
    platform.to_json("same-platform")
  check: platforms[0] ~is platforms[1]

// Relocation and a second RAM window must follow the description, not a config table.
def base = resolve_soc_config(named_soc_selection("simple-spike-rv32max")).description
def relocated = base with (
  memory_regions = [SoCAddressRegion(AddressSet(0, 0xfff)), SoCAddressRegion(AddressSet(0x90000000, 0xfffff))],
  boot = RiscvBootLayout(
    ~rom: base.boot.rom, ~reset_address: base.boot.reset_address,
    ~payload_address: 0x90001000, ~address_register: base.boot.address_register
  )
)
def relocated_platform = ActPlatform(relocated)
check:
  relocated_platform.ram.base ~is 0x90000000
  relocated_platform.ram.size_bytes ~is 0x100000
  relocated_platform.test_base ~is 0x90001000
  relocated_platform.access_fault_address >= 0x1000 ~is #true
  relocated_platform.access_fault_address < base.boot.rom.base ~is #true
