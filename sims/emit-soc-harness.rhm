#lang rhombus
// Dynamically loads one selected SoC harness and emits its CIRCT input.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/cmdline open
  rhombus/private/dynamic_require open

def arguments = current_command_line()
unless arguments.length() == 1
| error(~who: #'emit_soc_harness,
        "expected exactly one harness module path")

def emit_circt = dynamic_require("rhodium/backend/circt.rhm", #'emit_circt)
def design = dynamic_require(arguments[0], #'design)
print(emit_circt(design))
