#lang rhombus
/* Compiles an explicitly selected SoC harness through CIRCT or direct SV, with optional CIRCT tracing. */
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/cmdline open
  rhombus/private/dynamic_require open
  "../rhodium/core/ir.rhm".DesignElaboration
  "../rhodium/lowering/program.rhm".ElaboratedProgram
  "../rhodium/compile/program.rhm".compile_program
  "../rhodium/event/instrument.rhm".EventInstrumentedElaboration
  "../rhodium/frontend/foundation.rhm".elaborate_with_top
  "../socs/products/selection.rhm" open
  "../socs/products/resolve.rhm" open
  "../socs/products/metadata.rhm" open

def arguments = current_command_line()
def backend_option = arguments.length() > 0 && arguments[0] == "--backend"
when backend_option && arguments.length() < 2
| error(~who: #'emit_soc_harness, "--backend requires circt or verilog")
def backend = if backend_option | arguments[1] | "circt"
unless backend in ["circt", "verilog"] | error(~who: #'emit_soc_harness, "backend must be circt or verilog")
def remaining = if backend_option | arguments.drop(2) | arguments
def tracing = remaining.length() == 4 && remaining[0] == "--trace"
unless remaining.length() == 1 || remaining.length() == 3 || tracing
| error(~who: #'emit_soc_harness, "expected [--backend circt|verilog] followed by shape core ISA, a fixture path, or --trace shape core ISA")
when tracing && backend != "circt" | error(~who: #'emit_soc_harness, "tracing currently requires the CIRCT backend")
def selectors = if tracing | remaining.drop(1) | remaining
def product = if selectors.length() == 1
| #false
| resolve_soc_product(SoCSelection(parse_soc_shape(selectors[0]), parse_core_kind(selectors[1]), parse_isa_preset(selectors[2])))
when tracing && (product.selection.core != CoreKind.RV5Stage || ![SoCShape.Simple, SoCShape.Tiled].contains(product.selection.shape))
| error(~who: #'emit_soc_harness, "tracing supports simple or tiled RV5Stage only")

def resolved_config = if product | product.configuration() | #false

/* Build the selected harness from the same resolved configuration used for attestation.
   Preserve an explicit top so compilation never infers scope from module inventory order. */
fun selected_elaboration(product :: ResolvedSoCProduct):
  def config = resolved_config
  match product.selection.shape
  | SoCShape.Simple:
      def harness = dynamic_require("sims/single-core-soc-harness.rhdl", #'SoCHarness)
      def soc = dynamic_require("socs/single-core-soc/main.rhdl", #'SingleCoreSoC)
      elaborate_with_top(harness(config.params, soc(config)))
  | SoCShape.Mini:
      def harness = dynamic_require("sims/mini-soc-harness.rhdl", #'SoCHarness)
      elaborate_with_top(harness(config))
  | SoCShape.Tiled:
      def harness = dynamic_require("sims/tiled-soc-harness.rhdl", #'SoCHarness)
      elaborate_with_top(harness(config))

/* Instrument the selected hierarchy with partial event coverage while retaining gaps. */
fun traced_elaboration(elaboration :: DesignElaboration):
  def instrument = dynamic_require("rhodium/event/main.rhm", #'instrument_events)
  def config = dynamic_require("rhodium/event/main.rhm", #'EventInstrumentationConfig)
  instrument(elaboration, config(~partial: #true))

/* Serialize the descriptor paired with this exact instrumented elaboration. */
fun trace_manifest(traced :: EventInstrumentedElaboration):
  def convert = dynamic_require("rhodium/event/main.rhm", #'event_manifest_to_cpp)
  convert(traced.manifest)

def elaboration = if product | selected_elaboration(product) | #false
def traced = if tracing | traced_elaboration(elaboration) | #false
def event_manifest_cpp = if tracing | trace_manifest(traced) | ""
def trace_clock_frequency_hz = if tracing | product.description.clocks.clock_frequency_hz | 0
def ordinary_design = if product | elaboration.design | dynamic_require(selectors[0], #'design)
def design = if tracing | traced.instrumented.design | ordinary_design
def top = cond
| tracing: traced.instrumented.top
| product: elaboration.top
| ~else: design.find_module_named("SoCHarness")
unless top | error(~who: #'emit_soc_harness, "fixture must supply the SoCHarness top")
// Load only the selected backend. Both receive the same explicit top and
// preserve the product's configuration and harness identity comments.
def target = if backend == "verilog"
| dynamic_require("rhodium/backend/verilog-target.rhm", #'verilog_target)
| dynamic_require("rhodium/backend/circt-target.rhm", #'circt_target)
def compiled = compile_program(ElaboratedProgram(design, top), target)
when product
| block:
    println("// rhodium-configuration-sha256: " ++ metadata_fingerprint(product_metadata(product, resolved_config)))
    println("// rhodium-rtl-backend: " ++ backend)
    println("// rhodium-harness-variant: " ++ (if tracing | "trace" | "normal"))
print(compiled.artifacts[0].content)

export:
  event_manifest_cpp
  trace_clock_frequency_hz
