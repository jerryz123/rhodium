#lang rhodium
// Wraps bootable MiniSoC with FESVR while passing its synthesizable UART pins through.

import:
  lib("riscv/isa/xlen.rhm").XLen
  lib("socs/mini-soc.rhdl") as mini
  lib("socs/peripherals.rhdl").SoCUartInterface
  "fesvr/direct-memory-htif.rhdl".FesvrRequester

sync_circuit SoCHarness():
  output exit: Bits(32)
  interface uart(SoCUartInterface(), ~role: soc)

  inst requester(FesvrRequester(XLen.X64, mini.mini_soc_flit, mini.mini_soc_host_node, mini.mini_soc_home_map))
  inst soc(mini.MiniSoC())

  requester.port <=> soc.host.memory
  def boot_entry_matches = requester.start.bits === bits(mini.mini_soc_fabric_params.boot.payload_address, 64)
  soc.host.release.valid <== requester.start.valid & boot_entry_matches
  requester.start.ready <== soc.host.release.ready & boot_entry_matches
  uart <=> soc.uart
  exit <== requester.exit

  when (requester.start.valid):
    assert(boot_entry_matches, "fesvr_entry_matches_boot_payload")

def design = elaborate(SoCHarness())

export:
  SoCHarness
  design
