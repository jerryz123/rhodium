#lang rhodium
// Wraps bootable MiniSoC with FESVR while passing its synthesizable UART pins through.

import:
  lib("riscv/isa/xlen.rhm").XLen
  lib("socs/mini-soc.rhdl") as mini
  lib("socs/peripherals.rhdl").SoCUartInterface
  "fesvr/direct-memory-htif.rhdl".FesvrRequester

sync_circuit SoCHarness():
  output exit: Bits(32)
  interface uart(SoCUartInterface(), ~role: soc)

  inst requester(FesvrRequester(XLen.X64, mini.mini_soc_flit, mini.mini_soc_host_node, mini.mini_soc_home_map, mini.mini_soc_fabric_params.rv5stage_config.physical_map, mini.mini_soc_fabric_params.host_services, mini.mini_soc_fabric_params.boot.boot_address_register))
  inst soc(mini.MiniSoC())

  requester.port <=> soc.host.memory
  soc.host.release.valid <== requester.start.valid
  requester.start.ready <== soc.host.release.ready
  uart <=> soc.uart
  exit <== requester.exit

def design = elaborate(SoCHarness())

export:
  SoCHarness
  design
