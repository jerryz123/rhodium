#lang rhodium
// Bridges software-owned FESVR loading and boot publication through generic CHI memory transactions.

import:
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/ready-valid.rhdl") open
  lib("chi/protocol/params.rhdl").CHIFlitParams
  lib("chi/protocol/flits.rhdl") open
  lib("chi/protocol/protocol.rhdl").chi_line_data_id
  lib("chi/protocol/coherence.rhdl") open
  lib("chi/protocol/link.rhdl") open
  lib("chi/protocol/channels.rhdl").CHIRNChannels
  lib("chi/protocol/fabric.rhdl") open
  lib("chi/protocol/messages.rhdl").chi_rn_write_data
  lib("riscv/isa/xlen.rhm") open
  lib("riscv/rtl/pma.rhdl") open

dpi_import function rhodium_htif_tick(
  reset: Bool,
  target_xlen: Bits(8),
  boot_address_register: Bits(64),
  request_ready: Bool,
  response_valid: Bool,
  response_data: Bits(64),
  response_status: Bits(8)
) -> (
  out request_valid: Bool,
  out request_write: Bool,
  out request_address: Bits(64),
  out request_data: Bits(64),
  out request_length: Bits(8),
  out response_ready: Bool,
  return exit: Bits(32)
)

// Keeps the generated DPI signature flat and stable for the C++ boundary.
// Rhodium designs should normally instantiate FesvrRequester below.
sync_circuit DirectMemoryHTIF(xlen :: XLen, boot_address_register :: Nat):
  unless boot_address_register mod 8 == 0 && boot_address_register < (1 << 64)
  | error(~who: #'DirectMemoryHTIF, "boot-address register must be an aligned 64-bit address")
  input(request_ready, response_valid): Bool
  input response_data: Bits(64)
  output(request_valid, request_write, response_ready): Bool
  output request_address: Bits(64)
  input response_status: Bits(8)
  output request_data: Bits(64)
  output request_length: Bits(8)
  output exit: Bits(32)

  dpi_reg (htif_request_valid,
           htif_request_write,
           htif_request_address,
           htif_request_data,
           htif_request_length,
           htif_response_ready,
           htif_exit) = rhodium_htif_tick(
    reset_active().into(Bool),
    bits(xlen.width, 8),
    bits(boot_address_register, 64),
    request_ready,
    response_valid,
    response_data,
    response_status
  )

  request_valid <== htif_request_valid
  request_write <== htif_request_write
  request_address <== htif_request_address
  request_data <== htif_request_data
  request_length <== htif_request_length
  response_ready <== htif_response_ready
  exit <== htif_exit

def design = elaborate(DirectMemoryHTIF(XLen.X64, 0x3000))

hardware_enum FesvrCHIState:
  Idle
  Request
  Response
  ReadPending
  WriteAwaitDBID
  WriteData
  WriteAwaitComp

fun checked_fesvr_chi_requester(p :: CHIFlitParams,
                                node :: CHINodeParams,
                                home_map :: CHIHomeMap):
  unless node.kind == CHINodeKind.RNF
  | error(~who: #'FesvrRequester, "node must be an RN-F")
  unless node.max_outstanding == 1
  | error(~who: #'FesvrRequester,
          "node must allow exactly one outstanding transaction")
  unless home_map.flit == p
  | error(~who: #'FesvrRequester,
          "Home map must use FESVR's CHI flit parameters")
  for (entry in home_map.entries):
    if entry.target_node_id == node.node_id
    | error(~who: #'FesvrRequester,
            "Requester and Home NodeIDs must be distinct")
    | #void
  p

fun fesvr_chi_request(p :: CHIFlitParams,
                      address :: Bits(p.request_address_width),
                      write :: Bool,
                      size :: Bits(3),
                      cacheable :: Bool,
                      device :: Bool,
                      node_id :: Nat,
                      home_node_id :: Bits(p.node_id_width)):
  // Preserve FESVR's inactive-field defaults and its cacheability/opcode policy.
  def inactive :: CHIReqFlit(p) = literal(CHIReqFlit(p), 0)
  def attributes = CHIMemAttr():
    allocate: Bool(#false)
    cacheable: cacheable
    device: device
    early_write_acknowledge: Bool(#false)
  inactive.updated(
    ~tag_op: CHITagOp.Invalid,
    ~snp_attr_or_do_dwt: cacheable,
    ~mem_attr: attributes,
    ~order: CHIOrder.NoOrder,
    ~pas: CHIPAS.Secure,
    ~address: address,
    ~size_or_num_req: size.zext(6),
    ~opcode: mux(cacheable, mux(write, CHIReqOpcode.WriteUniquePtl, CHIReqOpcode.ReadClean), mux(write, CHIReqOpcode.WriteNoSnpPtl, CHIReqOpcode.ReadNoSnp)),
    ~return_nid_or_stash_nid_or_data_target: bits(node_id, p.node_id_width),
    ~src_id: bits(node_id, p.node_id_width),
    ~tgt_id: home_node_id
  )

fun fesvr_chi_snoop_response(p :: CHIFlitParams,
                             node_id :: Nat,
                             snoop :: CHISnpFlit(p)) :~ CHIRspFlit(p):
  def response = CHICoherentResponse():
    pass_dirty: Bool(#false)
    state: CHIResponseState.Invalid
  CHIRspFlit(p):
    cache_line_id: bits(0, 6)
    trace_tag: snoop.trace_tag
    tag_op: CHITagOp.Invalid
    pcrd_type: bits(0, 4)
    dbid_or_group_id: bits(0, 12)
    c_busy: bits(0, 3)
    fwd_state_or_data_pull: bits(0, 3)
    resp: response.as_bits()
    resp_err: CHIRespErr.OK
    opcode: CHIRspOpcode.SnpResp
    txn_id: snoop.txn_id
    src_id: bits(node_id, p.node_id_width)
    tgt_id: snoop.src_id
    qos: snoop.qos

// FESVR never retains a cache line, but its RN-F endpoint still participates
// in broadcast snooping and the paired DVM protocol.
sync_circuit FesvrSnoopResponder(p :: CHIFlitParams, node_id :: Nat):
  interface snoops(Decoupled(CHISnpFlit(p)), ~role: consumer)
  interface responses(Decoupled(CHIRspFlit(p)), ~role: producer)

  reg active(~init: Bool(#false))
  reg request(CHISnpFlit(p))
  reg dvm_first_pending(~init: Bool(#false))
  reg dvm_source_id(~init: bits(0, p.node_id_width))
  reg dvm_txn_id(~init: bits(0, 12))

  def incoming = snoops.bits
  def ordinary = incoming.opcode =/= CHISnpOpcode.SnpLCrdReturn
  def incoming_dvm = incoming.opcode === CHISnpOpcode.SnpDVMOp
  def can_start = !active & (!dvm_first_pending ||| incoming_dvm)
  snoops.ready <== !ordinary ||| can_start
  def snoop_fire = snoops.fire() & ordinary
  def dvm_first_fire = snoop_fire & incoming_dvm & !dvm_first_pending
  def dvm_second_fire = snoop_fire & incoming_dvm & dvm_first_pending
  def response_start = snoop_fire & (!incoming_dvm ||| dvm_first_pending)

  responses.valid <== active
  responses.bits <== fesvr_chi_snoop_response(p, node_id, request)
  def response_fire = responses.fire()

  when dvm_second_fire:
    assert(incoming.src_id === dvm_source_id, "fesvr_snoop_dvm_source_consistent")
    assert(incoming.txn_id === dvm_txn_id, "fesvr_snoop_dvm_txn_consistent")

  when response_start:
    active <== Bool(#true)
    request <== incoming
  elsewhen response_fire:
    active <== Bool(#false)

  when dvm_first_fire:
    dvm_first_pending <== Bool(#true)
    dvm_source_id <== incoming.src_id
    dvm_txn_id <== incoming.txn_id
  elsewhen dvm_second_fire:
    dvm_first_pending <== Bool(#false)

fun fesvr_chi_write_data(p :: CHIFlitParams,
                         address :: Bits(p.request_address_width),
                         data :: Bits(64),
                         size :: Bits(3),
                         cacheable :: Bool,
                         dbid :: Bits(12),
                         node_id :: Nat,
                         home_node_id :: Bits(p.node_id_width)):
  def lane = address[0..alignment_bits(p.data_bytes)]
  def placed_data = data.zext(p.data_width) << (lane.zext(alignment_bits(p.data_width)) << 3)
  def byte_enable = transfer_byte_mask(address, size, p.data_bytes)
  chi_rn_write_data(p, bits(node_id, p.node_id_width), home_node_id, dbid, placed_data, byte_enable.into(Bits(p.data_bytes)),
                    ~data_id: mux(cacheable, chi_line_data_id(address, p), bits(0, 2)),
                    ~ccid: bits(0, 2),
                    ~dbid_or_mecid: bits(0, 16))

// The complete chunk is validated before issuing any CHI traffic. Only normal
// cacheable RAM can be fragmented; side-effecting MMIO retains its exact width.
bundle FesvrMemoryRequest():
  write: Bool
  address: Bits(64)
  data: Bits(64)
  length: Bits(8)

hardware_enum FesvrMemoryStatus(~width: 8):
  Success = 0
  AccessFault = 1
  SlaveError = 2
  ProtocolError = 3

bundle FesvrMemoryResponse():
  data: Bits(64)
  status: FesvrMemoryStatus

fun fesvr_service_support(services :: NonemptyList.of(CHIHomeServiceParams),
                          address :: Bits,
                          last_address :: Bits,
                          home_id :: Bits,
                          write :: Bool,
                          cacheable :: Bool,
                          size :: Bits(3)):
  def opcode = mux(cacheable, mux(write, CHIReqOpcode.WriteUniquePtl, CHIReqOpcode.ReadClean), mux(write, CHIReqOpcode.WriteNoSnpPtl, CHIReqOpcode.ReadNoSnp))
  def matches = for List (service in services):
    def sizes = for List (support in service.requests):
      (opcode === support.opcode) & (size >= bits(alignment_bits(support.sizes.min_bytes), 3)) & (size <= bits(alignment_bits(support.sizes.max_bytes), 3))
    def regions = for List (region in service.address_sets):
      region.matches(address) & region.matches(last_address)
    (home_id === bits(service.home.node_id, home_id.type.packed_width())) & or_reduce(vec(regions)) & or_reduce(vec(sizes))
  or_reduce(vec(matches))

sync_circuit FesvrCHIAccess(flit :: CHIFlitParams,
                            node :: CHINodeParams,
                            home_map :: CHIHomeMap,
                            physical_map :: RiscvPhysicalMemoryMap,
                            services :: NonemptyList.of(CHIHomeServiceParams)):
  def p = checked_fesvr_chi_requester(flit, node, home_map)
  unless physical_map.address_width == p.request_address_width
  | error(~who: #'FesvrCHIAccess, "physical map must use the CHI address width")
  interface requests(Decoupled(FesvrMemoryRequest()), ~role: consumer)
  interface responses(Decoupled(FesvrMemoryResponse()), ~role: producer)
  interface port(CHIRNChannels(p), ~role: node)
  inst snoop(FesvrSnoopResponder(p, node.node_id))
  port.snoops |> snoop.snoops
  snoop.responses |> port.requester_responses

  reg state(~init: FesvrCHIState.Idle)
  reg address(Bits(p.request_address_width))
  reg data(Bits(64))
  reg write(Bool)
  reg cacheable(Bool)
  reg device(Bool)
  reg remaining(Bits(4))
  reg offset(~init: bits(0, 4))
  reg transfer_size(Bits(3))
  reg home_id(Bits(p.node_id_width))
  reg write_dbid(Bits(12))
  reg result(~init: bits(0, 64))
  reg status(~init: FesvrMemoryStatus.Success)

  def incoming = requests.bits
  def first = physical_map.lookup(incoming.address)
  def last = incoming.address + incoming.length.zext(64) - bits(1, 64)
  def legal_length = (incoming.length >= bits(1, 8)) & (incoming.length <= bits(8, 8))
  def byte_checks = for List (index in 0..8):
    def byte_address = incoming.address + bits(index, 64)
    def attributes = physical_map.lookup(byte_address)
    (bits(index, 8) >= incoming.length) ||| ((byte_address >= incoming.address) & attributes.mapped & (attributes.cacheable === first.cacheable) & mux(incoming.write, attributes.writable, attributes.readable))
  def legal_bytes = and_reduce(vec(byte_checks))
  def exact_size = mux_lookup(incoming.length, ~default: bits(0, 3), [[2, bits(1, 3)], [4, bits(2, 3)], [8, bits(3, 3)]])
  def aligned = (incoming.address[0..3] & (incoming.length - bits(1, 8))[0..3]) === bits(0, 3)
  def exact = incoming.length.is_one_of(bits(1, 8), bits(2, 8), bits(4, 8), bits(8, 8)) & aligned
  def incoming_home = home_map.lookup(incoming.address[0..p.request_address_width])
  def mmio_supported = exact & incoming_home.valid & fesvr_service_support(services, incoming.address[0..p.request_address_width], last[0..p.request_address_width], incoming_home.node_id, incoming.write, first.cacheable, exact_size)
  def command_supported = legal_length & legal_bytes & (first.cacheable ||| mmio_supported)
  requests.ready <== state === FesvrCHIState.Idle
  responses.valid <== state === FesvrCHIState.Response
  responses.bits <== FesvrMemoryResponse():
    data: result
    status: status

  def current_home = home_map.lookup(address)
  def mutable next_size = bits(0, 3)
  def mutable fragment_supported = Bool(#false)
  for (size in 0..4):
    def bytes = 1 << size
    def candidate_last = address + bits(bytes - 1, p.request_address_width)
    def candidate_aligned = (address & bits(bytes - 1, p.request_address_width)) === bits(0, p.request_address_width)
    def supported = (remaining >= bits(bytes, 4)) & candidate_aligned & current_home.valid & fesvr_service_support(services, address, candidate_last, current_home.node_id, write, cacheable, bits(size, 3))
    next_size := mux(supported, bits(size, 3), next_size)
    fragment_supported := fragment_supported ||| supported
  def request_pending = state === FesvrCHIState.Request
  port.requests.valid <== request_pending & fragment_supported
  port.requests.bits <== fesvr_chi_request(p, address, write, next_size, cacheable, device, node.node_id, current_home.node_id)
  def request_fire = port.requests.fire()
  def transfer_bytes = bits(1, 4) << transfer_size
  def data_shift = offset.zext(7) << 3
  port.request_data.valid <== state === FesvrCHIState.WriteData
  port.request_data.bits <== fesvr_chi_write_data(p, address, data >> data_shift, transfer_size, cacheable, write_dbid, node.node_id, home_id)

  def read_pending = state === FesvrCHIState.ReadPending
  def dbid_pending = state === FesvrCHIState.WriteAwaitDBID
  def comp_pending = state === FesvrCHIState.WriteAwaitComp
  def response = port.responses.bits
  def read_data = port.response_data.bits
  def rsp_credit = response.opcode === CHIRspOpcode.RespLCrdReturn
  def dat_credit = read_data.opcode === CHIDatOpcode.DataLCrdReturn
  def active = !state.is_one_of(FesvrCHIState.Idle, FesvrCHIState.Response)
  port.responses.ready <== rsp_credit ||| active
  port.response_data.ready <== dat_credit ||| active
  def rsp_fire = port.responses.fire() & !rsp_credit
  def dat_fire = port.response_data.fire() & !dat_credit
  def rsp_correct = (dbid_pending & (response.opcode === CHIRspOpcode.DBIDResp) ||| comp_pending & (response.opcode === CHIRspOpcode.Comp)) & (response.src_id === home_id) & (response.tgt_id === bits(node.node_id, p.node_id_width)) & (response.txn_id === bits(0, 12))
  def dat_correct = (cacheable ||| (read_data.src_id === home_id)) & read_pending & (read_data.opcode === CHIDatOpcode.CompData) & (read_data.home_nid_or_pbha_or_mismatched_mecid === home_id) & (read_data.tgt_id === bits(node.node_id, p.node_id_width)) & (read_data.txn_id === bits(0, 12)) & (read_data.data_id === mux(cacheable, chi_line_data_id(address, p), bits(0, 2)))
  def protocol_error = (rsp_fire & !rsp_correct) ||| (dat_fire & !dat_correct)
  def slave_error = (rsp_fire & (response.resp_err =/= CHIRespErr.OK)) ||| (dat_fire & (read_data.resp_err =/= CHIRespErr.OK))
  def read_shift = address[0..alignment_bits(p.data_bytes)].zext(alignment_bits(p.data_width)) << 3
  def read_value = (read_data.data >> read_shift)[0..64]
  def read_mask = mux_lookup(transfer_size, ~default: bits(0xffffffffffffffff, 64), [[0, bits(0xff, 64)], [1, bits(0xffff, 64)], [2, bits(0xffffffff, 64)]])
  def completed = dat_fire ||| (rsp_fire & comp_pending)

  when (requests.fire()):
    address <== incoming.address[0..p.request_address_width]
    data <== incoming.data
    write <== incoming.write
    cacheable <== first.cacheable
    device <== first.device
    remaining <== incoming.length[0..4]
    offset <== bits(0, 4)
    result <== bits(0, 64)
    status <== mux(command_supported, FesvrMemoryStatus.Success, FesvrMemoryStatus.AccessFault)
    state <== mux(command_supported, FesvrCHIState.Request, FesvrCHIState.Response)
  elsewhen (protocol_error ||| slave_error):
    status <== mux(protocol_error, FesvrMemoryStatus.ProtocolError, FesvrMemoryStatus.SlaveError)
    state <== FesvrCHIState.Response
  elsewhen (request_pending & !fragment_supported):
    status <== FesvrMemoryStatus.AccessFault
    state <== FesvrCHIState.Response
  elsewhen request_fire:
    home_id <== current_home.node_id
    transfer_size <== next_size
    state <== mux(write, FesvrCHIState.WriteAwaitDBID, FesvrCHIState.ReadPending)
  elsewhen (rsp_fire & dbid_pending):
    write_dbid <== response.dbid_or_group_id
    state <== FesvrCHIState.WriteData
  elsewhen (port.request_data.fire()):
    state <== FesvrCHIState.WriteAwaitComp
  elsewhen completed:
    when read_pending:
      result <== result ||| ((read_value & read_mask) << data_shift)
    address <== address + transfer_bytes.zext(p.request_address_width)
    offset <== offset + transfer_bytes
    remaining <== remaining - transfer_bytes
    state <== mux(remaining === transfer_bytes, FesvrCHIState.Response, FesvrCHIState.Request)
  elsewhen (responses.fire()):
    state <== FesvrCHIState.Idle

sync_circuit FesvrRequester(xlen :: XLen,
                            flit :: CHIFlitParams,
                            node :: CHINodeParams,
                            home_map :: CHIHomeMap,
                            physical_map :: RiscvPhysicalMemoryMap,
                            services :: NonemptyList.of(CHIHomeServiceParams),
                            boot_address_register :: Nat):
  interface port(CHIRNChannels(flit), ~role: node)
  output exit: Bits(32)
  inst raw(DirectMemoryHTIF(xlen, boot_address_register))
  inst access(FesvrCHIAccess(flit, node, home_map, physical_map, services))
  access.port <=> port
  access.requests.valid <== raw.request_valid
  access.requests.bits <== FesvrMemoryRequest():
    write: raw.request_write
    address: raw.request_address
    data: raw.request_data
    length: raw.request_length
  raw.request_ready <== access.requests.ready
  raw.response_valid <== access.responses.valid
  raw.response_data <== access.responses.bits.data
  raw.response_status <== access.responses.bits.status.as_bits()
  access.responses.ready <== raw.response_ready
  exit <== raw.exit

export:
  DirectMemoryHTIF
  FesvrCHIState
  FesvrSnoopResponder
  FesvrMemoryRequest
  FesvrMemoryResponse
  FesvrMemoryStatus
  FesvrCHIAccess
  FesvrRequester
  design
