+extern void litmus_baremetal_barrier_init(void *, int);
+extern void litmus_baremetal_barrier_wait(void *);
+
+typedef struct {
+  volatile int c,sense;
+  int n ;
+} sense_t;
+
+static void barrier_init (sense_t *p,int n) {
+  p->n = p->c = n;
+  p->sense = 0;
+  litmus_baremetal_barrier_init(p,n);
+}
+
+/* C coding, play it safe with mbar's */
+
+inline static void mbar_loc(void) {
+  asm __volatile__ ("fence rw,rw" ::: "memory");
+}
+
+__attribute__ ((noinline)) static void barrier_wait(sense_t *p) {
+  litmus_baremetal_barrier_wait(p);
 }
