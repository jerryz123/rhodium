From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Copy precomputed movement and integer input tiles
Purpose: Keep deterministic input construction off the target.
SPDX-License-Identifier: Apache-2.0 AND MIT

diff --git a/test/buffers.h b/test/buffers.h
--- a/test/buffers.h
+++ b/test/buffers.h
@@ -1,41 +1,10 @@
-/* Initializes data-movement sources with vectorizable integer patterns and allocates write-only outputs. */
+/* Copies typed constant tiles into complete source allocations, including padding. */
 /* SPDX-License-Identifier: Apache-2.0 */
 #pragma once
+#include "skl-test-driver.h"
 
-#include "skl-test-driver.h"
-#include <stdint.h>
-
-/* Each element depends only on its index and case ID, not on earlier elements.
- * Unsigned shifts/XORs vary all bits without a per-element RNG or division.
- * Chunked 32-bit induction avoids wasting RV64 vector lanes on 64-bit indices. */
-#define RHODIUM_SKL_DEFINE_FILL(TYPE)                                           \
-    static inline void rhodium_skl_fill_##TYPE(TYPE *data, size_t len,           \
-                                                unsigned int case_id)          \
-    {                                                                          \
-        uint32_t seed = UINT32_C(0x9e3779b9) * ((uint32_t)case_id + 1);          \
-        uint32_t offset = 0;                                                   \
-        while (len) {                                                          \
-            uint32_t count = len > UINT32_MAX ? UINT32_MAX : (uint32_t)len;     \
-            for (uint32_t i = 0; i < count; ++i) {                              \
-                uint32_t value = (offset + i) ^ seed;                           \
-                value ^= value << 7;                                           \
-                value ^= value >> 9;                                           \
-                value ^= value << 8;                                           \
-                data[i] = (TYPE)value;                                          \
-            }                                                                  \
-            data += count;                                                     \
-            len -= count;                                                      \
-            offset += count;                                                   \
-        }                                                                      \
-    }
-
-RHODIUM_SKL_DEFINE_FILL(uint8_t)
-RHODIUM_SKL_DEFINE_FILL(uint16_t)
-RHODIUM_SKL_DEFINE_FILL(uint32_t)
-#undef RHODIUM_SKL_DEFINE_FILL
-
-static inline void *rhodium_skl_allocate(skl_test_t *test, size_t region,
-                                        size_t bytes)
+/* Keep each allocation and free in the original memory region. */
+static inline void *rhodium_skl_allocate(skl_test_t *test, size_t region, size_t bytes)
 {
     void *data = skl_test_driver_alloc(region, bytes);
     if (bytes && !data)
@@ -43,18 +12,73 @@
     return data;
 }
 
-/* These macros accept side-effect-free test and upstream buffer expressions.
- * Fill the complete source span, including readable padding. Destinations must
- * be write-only kernel operands; allocating them must not initialize padding. */
-#define RHODIUM_SKL_DESTINATION(TEST, TYPE, BUF)                                 \
-    do {                                                                       \
-        (BUF)->data = rhodium_skl_allocate((TEST), (BUF)->region,                \
-                                           (BUF)->len * sizeof(TYPE));          \
+/* Rotate the read-only tile per case and stream, then copy without element math. */
+static inline void rhodium_skl_copy(skl_test_t *test, void *data, size_t len,
+                                    const void *tile, size_t element_size)
+{
+    static unsigned int stream;
+    size_t offset = ((unsigned int)test->id * 131u + stream++ * 317u) % 1024;
+    while (len) {
+        size_t count = len < 1024 - offset ? len : 1024 - offset;
+        memcpy(data, (const unsigned char *)tile + offset * element_size,
+               count * element_size);
+        data = (unsigned char *)data + count * element_size;
+        len -= count;
+        offset = 0;
+    }
+}
+
+#define RHODIUM_SKL_VALUE(v) ((uint8_t)(v))
+static const uint8_t rhodium_skl_uint8_t[] = {
+#include "input-values.inc"
+};
+#undef RHODIUM_SKL_VALUE
+#define RHODIUM_SKL_VALUE(v) ((uint16_t)(v))
+static const uint16_t rhodium_skl_uint16_t[] = {
+#include "input-values.inc"
+};
+#undef RHODIUM_SKL_VALUE
+#define RHODIUM_SKL_VALUE(v) ((uint32_t)(v))
+static const uint32_t rhodium_skl_uint32_t[] = {
+#include "input-values.inc"
+};
+#undef RHODIUM_SKL_VALUE
+#define RHODIUM_SKL_VALUE(v) ((int8_t)((int32_t)((v) % 256) - 128))
+static const int8_t rhodium_skl_int8_t[] = {
+#include "input-values.inc"
+};
+#undef RHODIUM_SKL_VALUE
+#define RHODIUM_SKL_VALUE(v) ((int32_t)((v) % 256) - 128)
+static const int32_t rhodium_skl_int32_t[] = {
+#include "input-values.inc"
+};
+#undef RHODIUM_SKL_VALUE
+
+/* Only audited write-only operands may bypass initialization. */
+#define RHODIUM_SKL_DESTINATION(TEST, TYPE, BUF)                              \
+    do {                                                                    \
+        (BUF)->data = rhodium_skl_allocate((TEST), (BUF)->region,             \
+                                           (BUF)->len * sizeof(TYPE));       \
     } while (0)
 
-#define RHODIUM_SKL_SOURCE(TEST, TYPE, BUF)                                      \
-    do {                                                                       \
-        RHODIUM_SKL_DESTINATION(TEST, TYPE, BUF);                                \
-        if ((BUF)->data)                                                        \
-            rhodium_skl_fill_##TYPE((BUF)->data, (BUF)->len, (TEST)->id);         \
+/* Copy the complete readable span, not merely the logical matrix elements. */
+#define RHODIUM_SKL_SOURCE(TEST, TYPE, BUF)                                   \
+    do {                                                                    \
+        RHODIUM_SKL_DESTINATION(TEST, TYPE, BUF);                             \
+        if ((BUF)->data)                                                     \
+            rhodium_skl_copy((TEST), (BUF)->data, (BUF)->len,                 \
+                              rhodium_skl_##TYPE, sizeof(TYPE));             \
     } while (0)
+
+/* Preserve explicit/static/sequential inputs; random integer domains are pinned.
+ * Fail closed if an upstream update changes one instead of clamping samples. */
+#define RHODIUM_SKL_INTEGER_SOURCE(TEST, TYPE, BUF)                           \
+    do {                                                                    \
+        if ((BUF)->mode != SKL_TEST_RANDOM) {                                \
+            SKL_TEST_BUF_CREATE(TEST, TYPE, BUF);                            \
+        } else if ((BUF)->min != -128 || (BUF)->max != 127) {                 \
+            (TEST)->status.init_status = SKL_TEST_FAIL;                      \
+        } else {                                                            \
+            RHODIUM_SKL_SOURCE(TEST, TYPE, BUF);                             \
+        }                                                                   \
+    } while (0)
