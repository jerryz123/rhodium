From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Generate SKL inputs efficiently and omit write-only output fills
Purpose: Move the qualified deterministic input helpers and audited destination allocations into SKL.
SPDX-License-Identifier: Apache-2.0 AND MIT

Apply only to the pinned SKL build-local copy; retain upstream notices.

diff --git a/test/buffers.h b/test/buffers.h
new file mode 100644
--- /dev/null
+++ b/test/buffers.h
@@ -0,0 +1,60 @@
+/* Initializes data-movement sources with vectorizable integer patterns and allocates write-only outputs. */
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+
+#include "skl-test-driver.h"
+#include <stdint.h>
+
+/* Each element depends only on its index and case ID, not on earlier elements.
+ * Unsigned shifts/XORs vary all bits without a per-element RNG or division.
+ * Chunked 32-bit induction avoids wasting RV64 vector lanes on 64-bit indices. */
+#define RHODIUM_SKL_DEFINE_FILL(TYPE)                                           \
+    static inline void rhodium_skl_fill_##TYPE(TYPE *data, size_t len,           \
+                                                unsigned int case_id)          \
+    {                                                                          \
+        uint32_t seed = UINT32_C(0x9e3779b9) * ((uint32_t)case_id + 1);          \
+        uint32_t offset = 0;                                                   \
+        while (len) {                                                          \
+            uint32_t count = len > UINT32_MAX ? UINT32_MAX : (uint32_t)len;     \
+            for (uint32_t i = 0; i < count; ++i) {                              \
+                uint32_t value = (offset + i) ^ seed;                           \
+                value ^= value << 7;                                           \
+                value ^= value >> 9;                                           \
+                value ^= value << 8;                                           \
+                data[i] = (TYPE)value;                                          \
+            }                                                                  \
+            data += count;                                                     \
+            len -= count;                                                      \
+            offset += count;                                                   \
+        }                                                                      \
+    }
+
+RHODIUM_SKL_DEFINE_FILL(uint8_t)
+RHODIUM_SKL_DEFINE_FILL(uint16_t)
+RHODIUM_SKL_DEFINE_FILL(uint32_t)
+#undef RHODIUM_SKL_DEFINE_FILL
+
+static inline void *rhodium_skl_allocate(skl_test_t *test, size_t region,
+                                        size_t bytes)
+{
+    void *data = skl_test_driver_alloc(region, bytes);
+    if (bytes && !data)
+        test->status.init_status = SKL_TEST_FAIL;
+    return data;
+}
+
+/* These macros accept side-effect-free test and upstream buffer expressions.
+ * Fill the complete source span, including readable padding. Destinations must
+ * be write-only kernel operands; allocating them must not initialize padding. */
+#define RHODIUM_SKL_DESTINATION(TEST, TYPE, BUF)                                 \
+    do {                                                                       \
+        (BUF)->data = rhodium_skl_allocate((TEST), (BUF)->region,                \
+                                           (BUF)->len * sizeof(TYPE));          \
+    } while (0)
+
+#define RHODIUM_SKL_SOURCE(TEST, TYPE, BUF)                                      \
+    do {                                                                       \
+        RHODIUM_SKL_DESTINATION(TEST, TYPE, BUF);                                \
+        if ((BUF)->data)                                                        \
+            rhodium_skl_fill_##TYPE((BUF)->data, (BUF)->len, (TEST)->id);         \
+    } while (0)
