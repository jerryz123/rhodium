diff --git a/test/fp-buffers.h b/test/fp-buffers.h
new file mode 100644
--- /dev/null
+++ b/test/fp-buffers.h
@@ -0,0 +1,100 @@
+/* Generates domain-bounded SKL floating-point inputs without scalar RNG or BF16 arithmetic helpers. */
+/* SPDX-License-Identifier: Apache-2.0 */
+#pragma once
+
+#include <stdint.h>
+#include <string.h>
+
+/* GCC has no BF16 vector mode on RVA23. An alias-permitted integer view lets
+ * its vectorizer store encodings without requiring native BF16 instructions. */
+typedef uint16_t rhodium_skl_bf16_storage __attribute__((may_alias));
+
+/* Each sample is independent; the per-fill stream distinguishes equal-domain
+ * operands without depending on allocation addresses or a serial RNG loop. */
+static inline float rhodium_skl_fraction(uint32_t index, uint32_t seed)
+{
+    uint32_t value = index + seed;
+    value = (value ^ (value >> 16)) * UINT32_C(0x7feb352d);
+    value = (value ^ (value >> 15)) * UINT32_C(0x846ca68b);
+    value ^= value >> 16;
+    return (float)(value >> 8) * 0x1p-24f;
+}
+
+/* BF16 is storage, not an ISA requirement. Bit copies avoid compiler-generated
+ * software conversions; narrowing uses round-to-nearest, ties-to-even and
+ * preserves infinities while quieting NaNs rather than rounding them to infinity. */
+static inline float rhodium_skl_decode_bf16(__bf16 value)
+{
+    uint16_t narrow;
+    uint32_t wide;
+    float result;
+    memcpy(&narrow, &value, sizeof(narrow));
+    wide = (uint32_t)narrow << 16;
+    memcpy(&result, &wide, sizeof(result));
+    return result;
+}
+
+static inline uint16_t rhodium_skl_encode_bf16(float value)
+{
+    uint32_t wide;
+    memcpy(&wide, &value, sizeof(wide));
+    uint32_t nan_mask = -(uint32_t)((wide & UINT32_C(0x7fffffff)) > UINT32_C(0x7f800000));
+    uint32_t rounded = (wide + UINT32_C(0x7fff) + ((wide >> 16) & 1)) >> 16;
+    return (uint16_t)((rounded & ~nan_mask) | (((wide >> 16) | UINT32_C(0x40)) & nan_mask));
+}
+
+/* Keep random versus sequential versus static selection in upstream's buffer
+ * dispatcher. Compute FP16/BF16 interpolation in FP32, narrowing only the final
+ * value. Clamp rounding at the original typed bounds. Chunked 32-bit induction
+ * permits vectorization without imposing a new buffer-length limit. */
+#define RHODIUM_SKL_FP_GENERATORS(TYPE, WORK, STORAGE, DECODE, ENCODE)           \
+    static inline void skl_test_buf_random_##TYPE(                            \
+        skl_test_t *test, TYPE *data, size_t len, TYPE min, TYPE max)           \
+    {                                                                         \
+        static uint32_t stream;                                               \
+        uint32_t seed = UINT32_C(0x9e3779b9) * (++stream + test->id);          \
+        uint32_t offset = 0;                                                   \
+        WORK low = DECODE(min), high = DECODE(max);                            \
+        while (len) {                                                         \
+            uint32_t count = len > UINT32_MAX ? UINT32_MAX : (uint32_t)len;    \
+            STORAGE *storage = (STORAGE *)(void *)data;                       \
+            for (uint32_t i = 0; i < count; ++i) {                             \
+                WORK value = low + (high - low) *                             \
+                    (WORK)rhodium_skl_fraction(offset + i, seed);             \
+                value = value < low ? low : value;                            \
+                value = value > high ? high : value;                          \
+                storage[i] = ENCODE(value);                                   \
+            }                                                                 \
+            data += count;                                                    \
+            len -= count;                                                     \
+            offset += count;                                                  \
+        }                                                                     \
+    }                                                                         \
+    static inline void skl_test_buf_seq_##TYPE(                               \
+        skl_test_t *test, TYPE *data, size_t len, TYPE min, TYPE max)           \
+    {                                                                         \
+        (void)test;                                                           \
+        WORK low = DECODE(min), high = DECODE(max);                            \
+        WORK step = len ? (high - low) / (WORK)len : 0;                        \
+        size_t offset = 0;                                                     \
+        while (len) {                                                         \
+            uint32_t count = len > UINT32_MAX ? UINT32_MAX : (uint32_t)len;    \
+            STORAGE *storage = (STORAGE *)(void *)data;                       \
+            WORK base = (WORK)offset;                                         \
+            for (uint32_t i = 0; i < count; ++i) {                             \
+                WORK value = low + step * (base + (WORK)i);                   \
+                value = value < low ? low : value;                            \
+                value = value > high ? high : value;                          \
+                storage[i] = ENCODE(value);                                   \
+            }                                                                 \
+            data += count;                                                    \
+            len -= count;                                                     \
+            offset += count;                                                  \
+        }                                                                     \
+    }
+
+RHODIUM_SKL_FP_GENERATORS(_Float16, float, _Float16, (float), (_Float16))
+RHODIUM_SKL_FP_GENERATORS(float, float, float, (float), (float))
+RHODIUM_SKL_FP_GENERATORS(double, double, double, (double), (double))
+RHODIUM_SKL_FP_GENERATORS(__bf16, float, rhodium_skl_bf16_storage, rhodium_skl_decode_bf16, rhodium_skl_encode_bf16)
+#undef RHODIUM_SKL_FP_GENERATORS
