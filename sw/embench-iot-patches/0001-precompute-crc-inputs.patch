From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Precompute the exact CRC32 input bytes
Purpose: Keep deterministic input construction off the target.
SPDX-License-Identifier: Apache-2.0 AND GPL-3.0-or-later

diff --git a/src/crc32/crc_32.c b/src/crc32/crc_32.c
--- a/src/crc32/crc_32.c
+++ b/src/crc32/crc_32.c
@@ -17,6 +17,7 @@
 /* CRC - 32 BIT ANSI X3.66 CRC checksum files */
 
 #include "support.h"
+#include "crc-input.h"
 
 /* This scale factor will be changed to equalise the runtime of the
    benchmarks. */
@@ -153,11 +154,15 @@
   int i;
   register DWORD oldcrc32;
 
+  /* Prevent compile-time evaluation of the checksum workload. */
+  const unsigned char *input = crc_input;
+  __asm__ volatile ("" : "+r" (input) : : "memory");
+
   oldcrc32 = 0xFFFFFFFF;
 
   for (i = 0; i < 1024; ++i)
     {
-      oldcrc32 = UPDC32 (rand_beebs (), oldcrc32);
+      oldcrc32 = UPDC32 (input[i], oldcrc32);
     }
 
   return ~oldcrc32;
@@ -196,7 +201,6 @@
   for (unsigned int lsf_cnt = 0; lsf_cnt < lsf; lsf_cnt++)
     for (unsigned int gsf_cnt = 0; gsf_cnt < gsf; gsf_cnt++)
       {
-	srand_beebs (0);
 	r = crc32pseudo ();
       }
 
diff --git a/src/crc32/crc-input.h b/src/crc32/crc-input.h
new file mode 100644
--- /dev/null
