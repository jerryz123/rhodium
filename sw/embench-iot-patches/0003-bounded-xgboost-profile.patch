+		  uint8_t predicted = predict(X_test[functional_samples[i]]);
+		  uint8_t label = Y_test[functional_samples[i]];
 		  if (predicted == label)
                     correct++;
 		}
@@ -53,9 +54,9 @@
 {
 }

