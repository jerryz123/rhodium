From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jerry Zhao <jerryz123@berkeley.edu>
Subject: [PATCH] Honor per-counter inhibit capability in Sm tests
Purpose: Keeps generic Sm coverage from assuming optional counter-inhibit bits.
SPDX-License-Identifier: Apache-2.0

The generic CSR access and walk tests must not compare WARL inhibit bits
against Sail's fixed bit-0/bit-2 implementation. The dedicated cycle and
retirement tests still check those bits when COUNTINHIBIT_EN advertises them.
Other supported bits, including Sscofpmf's HPM3 bit, retain their dedicated
coverage.

diff --git a/generators/testgen/src/testgen/priv/extensions/Sm.py b/generators/testgen/src/testgen/priv/extensions/Sm.py
--- a/generators/testgen/src/testgen/priv/extensions/Sm.py
+++ b/generators/testgen/src/testgen/priv/extensions/Sm.py
@@ -620,6 +620,6 @@ def _generate_mcsr_tests(test_data: TestData, test_chunks: list) -> None:
         ("mtval", None),  # only accessed here; walked in cp_mtval_* instead
         ("mip", 0xFFFF),  # limit to standard interrupt bits
-        # TODO: remove mcountinhibit mask when Sail gets parameters for writable bits
-        ("mcountinhibit", 0b111),
+        # Inhibit-bit writability is implementation-specific; cp_inhibit checks advertised bits.
+        ("mcountinhibit", 0),
         ("mhpmevent3", 0),  # mask all bits because they are WARL and can all be ROZ
         ("mhpmevent4", 0),  # mask all bits because they are WARL and can all be ROZ
@@ -1322,6 +1322,7 @@ def _generate_mcsr_cntr_tests(test_data: TestData) -> list[str]:

     r1, r2 = test_data.int_regs.get_registers(2)
     lines.append("#ifdef UDB_MCOUNTINHIBIT_IMPLEMENTED")
+    lines.append("#ifdef UDB_COUNTINHIBIT_EN_0")

     ######################################
     coverpoint = "cp_inhibit_mcycle"
@@ -1344,6 +1345,8 @@ def _generate_mcsr_cntr_tests(test_data: TestData) -> list[str]:
             write_sigupd(r2, test_data),
         ]
     )
+    lines.append("#endif")
+    lines.append("#ifdef UDB_COUNTINHIBIT_EN_2")
     ######################################
     coverpoint = "cp_inhibit_minstret"
     ######################################
@@ -1366,6 +1369,7 @@ def _generate_mcsr_cntr_tests(test_data: TestData) -> list[str]:
         ]
     )
     lines.append("#endif")
+    lines.append("#endif")

     ######################################
     coverpoint = "cp_mtime_write"
