+# Selects canonical parameter generation and edge sets for vector floating-point coverpoints.
+# SPDX-License-Identifier: Apache-2.0
+
+from typing import Any
+
+from testgen.data.edges import FLOAT_EDGES
+from testgen.data.params import InstructionParams
+from testgen.data.state import TestData
+from testgen.instructions.vector import get_base_lmul
+from testgen.instructions.vector_params import generate_random_vector_params
+
+
+def vector_fp_edges(test_data: TestData, *, wide: bool = False) -> tuple[int, ...]:
+    """Return floating-point edges matching the vector element width."""
+    assert test_data.config.sew is not None
+    sew = test_data.config.sew * (2 if wide else 1)
+    return {16: FLOAT_EDGES.half, 32: FLOAT_EDGES.single, 64: FLOAT_EDGES.double}[sew]
+
+
+def generate_vector_fp_params(
+    test_data: TestData, instr_name: str, instr_type: str, **fixed_params: Any
+) -> InstructionParams:
+    """Generate vector parameters for a floating-point coverpoint."""
+    assert test_data.config.sew is not None
+    lmul = get_base_lmul(instr_name, instr_type, test_data.config.sew)
+    return generate_random_vector_params(test_data, instr_name, instr_type, lmul=lmul, **fixed_params)
diff --git a/generators/testgen/src/testgen/formatters/types/fp_vector_type.py b/generators/testgen/src/testgen/formatters/types/fp_vector_type.py
new file mode 100644
index 0000000000000000000000000000000000000000..105f6055d59d24ba4159ffe0a37ed015e7d0e288
--- /dev/null
+++ b/generators/testgen/src/testgen/formatters/types/fp_vector_type.py
@@ -0,0 +1,278 @@
+# Formats vector floating-point instructions with the canonical vector helpers.
+# SPDX-License-Identifier: Apache-2.0
+
+from collections.abc import Callable
+
+from testgen.asm.helpers import load_float_reg, write_sigupd
+from testgen.asm.vector_helpers import (
+    VectorLoad,
+    handle_parameter_exclusions,
+    load_test_vtype,
+    load_vec_regs,
+    prep_mask_v,
+    write_sigupd_v,
+    write_sigupd_v_len,
+)
+from testgen.data.params import InstructionParams
+from testgen.data.state import TestData
+from testgen.formatters.registry import InstructionTypeConfig, VectorTypeConfig, add_instruction_formatter
+from testgen.formatters.types.mask_prod_type import format_mask_producing_type
+from testgen.formatters.types.vv_type import format_vv_like_type
+from testgen.formatters.types.vvsr_type import format_vvsr_like_type
+from testgen.formatters.types.vvv_type import format_vvv_like_type
+from testgen.instructions.vector import parse_vector_instruction_info
+
+
+def _fp_load_type(sew: int) -> str:
+    try:
+        return {16: "half", 32: "single", 64: "double"}[sew]
+    except KeyError as exc:
+        raise ValueError(f"unsupported vector floating-point SEW {sew}") from exc
+
+
+def _with_fp_state(
+    formatter: Callable[[], tuple[list[str], list[str], list[str]]],
+    test_data: TestData,
+    params: InstructionParams,
+) -> tuple[list[str], list[str], list[str]]:
+    setup, test, check = formatter()
+    setup.insert(1 if setup and setup[0].startswith("#if") else 0, "fsflagsi 0b00000 # clear all fflags")
+    if params.frm is not None:
+        frm = params.csr_frm_val if params.frm == "dyn" else {"rne": 0, "rtz": 1, "rdn": 2, "rup": 3, "rmm": 4}[params.frm]
+        assert frm is not None
+        setup.append(f"fsrmi {frm}")
+        check.insert(-1 if check and check[-1] == "#endif" else len(check), "fsrmi 0x0")
+    check.insert(-1 if check and check[-1] == "#endif" else len(check), write_sigupd(None, test_data, "fflags"))
+    return setup, test, check
+
+
+def _vector_float_config(
+    required: set[str],
+    *,
+    overlap: set[tuple[str, str]] | None = None,
+    masked: set[tuple[str, str]] | None = None,
+    mask_regs: set[str] | None = None,
+    scalar_regs: set[str] | None = None,
+    widened: set[str] | None = None,
+) -> InstructionTypeConfig:
+    return InstructionTypeConfig(
+        required_params=required,
+        vector_data=VectorTypeConfig(
+            overlap_constraints=overlap or set(),
+            masked_constraints=masked,
+            mask_regs=mask_regs or set(),
+            scalar_regs=scalar_regs or set(),
+            widened_regs=widened or set(),
+        ),
+    )
+
+
+fvv_config = _vector_float_config({"vd", "vs2"})
+fvvv_config = _vector_float_config({"vd", "vs1", "vs2"})
+fvvv_acc_config = _vector_float_config({"vd", "vs1", "vs2"})
+fwvv_config = _vector_float_config(
+    {"vd", "vs1", "vs2"}, overlap={("vd_bottom", "vs1"), ("vd_bottom", "vs2")}, widened={"vd"}
+)
+fwvv_acc_config = _vector_float_config(
+    {"vd", "vs1", "vs2"}, overlap={("vd", "vs1"), ("vd", "vs2")}, widened={"vd"}
+)
+fwwvm_config = _vector_float_config(
+    {"vd", "vs1", "vs2"}, overlap={("vd_bottom", "vs1"), ("vs1", "vs2")}, widened={"vd", "vs2"}
+)
+fvvf_config = _vector_float_config({"vd", "vs2", "fs1"})
+fvvf_acc_config = _vector_float_config({"vd", "vs2", "fs1"})
+fwvf_config = _vector_float_config(
+    {"vd", "vs2", "fs1"}, overlap={("vd_bottom", "vs2")}, widened={"vd"}
+)
+fwvf_acc_config = _vector_float_config({"vd", "vs2", "fs1"}, overlap={("vd", "vs2")}, widened={"vd"})
+fwwfm_config = _vector_float_config(
+    {"vd", "vs2", "fs1"}, overlap={("vd_bottom", "vs2")}, widened={"vd", "vs2"}
+)
+fvvfm_config = _vector_float_config(
+    {"vd", "vs2", "fs1", "maskval"}, overlap={("vd", "v0"), ("vs2", "v0")}
+)
+fmvv_config = _vector_float_config(
+    {"vd", "vs1", "vs2"}, mask_regs={"vd"}, masked={("vs1", "v0"), ("vs2", "v0")}
+)
+fmvf_config = _vector_float_config(
+    {"vd", "vs2", "fs1"}, mask_regs={"vd"}, masked={("vs2", "v0")}
+)
+fvsr_config = _vector_float_config({"vd", "vs1", "vs2"}, scalar_regs={"vd", "vs1"})
+fwvsr_config = _vector_float_config(
+    {"vd", "vs1", "vs2"}, overlap={("vs2", "vs1")}, scalar_regs={"vd", "vs1"}, widened={"vd", "vs1"}
+)
+ffv_config = _vector_float_config({"fd", "vs2"}, scalar_regs={"vs2"})
+fvf_config = _vector_float_config({"vd", "fs1"}, scalar_regs={"vd"})
+
+
+@add_instruction_formatter("FVV", fvv_config)
+def format_fvv(instr: str, test_data: TestData, params: InstructionParams) -> tuple[list[str], list[str], list[str]]:
+    info = parse_vector_instruction_info(instr, "FVV")
+    return _with_fp_state(lambda: format_vv_like_type(instr, test_data, params, "FVV", widen=info.widened_regs), test_data, params)
+
+
+def _format_vector_vector(
+    instr: str,
+    instr_type: str,
+    test_data: TestData,
+    params: InstructionParams,
+    *,
+    accumulator_order: bool = False,
+) -> tuple[list[str], list[str], list[str]]:
+    info = parse_vector_instruction_info(instr, instr_type)
+    setup, test, check = format_vvv_like_type(instr, test_data, params, instr_type, widen=info.widened_regs)
+    if accumulator_order:
+        mask = ", v0.t" if params.maskval else ""
+        test = [f"{instr} v{params.vd}, v{params.vs1}, v{params.vs2}{mask}"]
+    return _with_fp_state(lambda: (setup, test, check), test_data, params)
+
+
+@add_instruction_formatter("FVVV", fvvv_config)
+def format_fvvv(instr: str, test_data: TestData, params: InstructionParams) -> tuple[list[str], list[str], list[str]]:
+    return _format_vector_vector(instr, "FVVV", test_data, params)
+
+
+@add_instruction_formatter("FVVV_ACC", fvvv_acc_config)
+def format_fvvv_acc(instr: str, test_data: TestData, params: InstructionParams) -> tuple[list[str], list[str], list[str]]:
+    return _format_vector_vector(instr, "FVVV_ACC", test_data, params, accumulator_order=True)
+
+
+@add_instruction_formatter("FWVV", fwvv_config)
+def format_fwvv(instr: str, test_data: TestData, params: InstructionParams) -> tuple[list[str], list[str], list[str]]:
+    return _format_vector_vector(instr, "FWVV", test_data, params)
+
+
+@add_instruction_formatter("FWVV_ACC", fwvv_acc_config)
+def format_fwvv_acc(instr: str, test_data: TestData, params: InstructionParams) -> tuple[list[str], list[str], list[str]]:
+    return _format_vector_vector(instr, "FWVV_ACC", test_data, params, accumulator_order=True)
+
+
+@add_instruction_formatter("FWWVM", fwwvm_config)
+def format_fwwvm(instr: str, test_data: TestData, params: InstructionParams) -> tuple[list[str], list[str], list[str]]:
+    return _format_vector_vector(instr, "FWWVM", test_data, params)
+
+
+def _format_vector_scalar(
+    instr: str,
+    instr_type: str,
+    test_data: TestData,
+    params: InstructionParams,
+    *,
+    accumulator_order: bool = False,
+    merge_mask: bool = False,
+) -> tuple[list[str], list[str], list[str]]:
+    assert params.fs1 is not None and params.fs1val is not None and params.sew is not None
+    info = parse_vector_instruction_info(instr, instr_type)
+    setup, _test, check = format_vv_like_type(instr, test_data, params, instr_type, widen=info.widened_regs)
+    setup.insert(0, load_float_reg("fs1", params.fs1, params.fs1val, test_data, _fp_load_type(params.sew)))
+    mask = ", v0" if merge_mask else (", v0.t" if params.maskval else "")
+    operands = f"v{params.vd}, f{params.fs1}, v{params.vs2}" if accumulator_order else f"v{params.vd}, v{params.vs2}, f{params.fs1}"
+    return _with_fp_state(lambda: (setup, [f"{instr} {operands}{mask}"], check), test_data, params)
+
+
+@add_instruction_formatter("FVVF", fvvf_config)
+def format_fvvf(instr: str, test_data: TestData, params: InstructionParams) -> tuple[list[str], list[str], list[str]]:
+    return _format_vector_scalar(instr, "FVVF", test_data, params)
+
+
+@add_instruction_formatter("FVVF_ACC", fvvf_acc_config)
+def format_fvvf_acc(instr: str, test_data: TestData, params: InstructionParams) -> tuple[list[str], list[str], list[str]]:
+    return _format_vector_scalar(instr, "FVVF_ACC", test_data, params, accumulator_order=True)
+
+
+@add_instruction_formatter("FWVF", fwvf_config)
+def format_fwvf(instr: str, test_data: TestData, params: InstructionParams) -> tuple[list[str], list[str], list[str]]:
+    return _format_vector_scalar(instr, "FWVF", test_data, params)
+
+
+@add_instruction_formatter("FWVF_ACC", fwvf_acc_config)
+def format_fwvf_acc(instr: str, test_data: TestData, params: InstructionParams) -> tuple[list[str], list[str], list[str]]:
+    return _format_vector_scalar(instr, "FWVF_ACC", test_data, params, accumulator_order=True)
+
+
+@add_instruction_formatter("FWWFM", fwwfm_config)
+def format_fwwfm(instr: str, test_data: TestData, params: InstructionParams) -> tuple[list[str], list[str], list[str]]:
+    return _format_vector_scalar(instr, "FWWFM", test_data, params)
+
+
+@add_instruction_formatter("FVVFM", fvvfm_config)
+def format_fvvfm(instr: str, test_data: TestData, params: InstructionParams) -> tuple[list[str], list[str], list[str]]:
+    assert params.maskval is not None
+    return _format_vector_scalar(instr, "FVVFM", test_data, params, merge_mask=True)
+
+
+@add_instruction_formatter("FMVV", fmvv_config)
+def format_fmvv(instr: str, test_data: TestData, params: InstructionParams) -> tuple[list[str], list[str], list[str]]:
+    return _with_fp_state(
+        lambda: format_mask_producing_type(instr, test_data, params, "FMVV", {"vd", "vs1", "vs2"}, {"vd"}),
+        test_data,
+        params,
+    )
+
+
+@add_instruction_formatter("FMVF", fmvf_config)
+def format_fmvf(instr: str, test_data: TestData, params: InstructionParams) -> tuple[list[str], list[str], list[str]]:
+    assert params.fs1 is not None and params.fs1val is not None and params.sew is not None
+    setup, test, check = format_mask_producing_type(instr, test_data, params, "FMVF", {"vd", "vs2", "fs1"}, {"vd"})
+    setup.insert(0, load_float_reg("fs1", params.fs1, params.fs1val, test_data, _fp_load_type(params.sew)))
+    return _with_fp_state(lambda: (setup, test, check), test_data, params)
+
+
+def _format_reduction(
+    instr: str, instr_type: str, test_data: TestData, params: InstructionParams
+) -> tuple[list[str], list[str], list[str]]:
+    info = parse_vector_instruction_info(instr, instr_type)
+    return _with_fp_state(
+        lambda: format_vvsr_like_type(instr, test_data, params, instr_type, widen=info.widened_regs), test_data, params
+    )
+
+
+@add_instruction_formatter("FVVSR", fvsr_config)
+def format_fvvsr(instr: str, test_data: TestData, params: InstructionParams) -> tuple[list[str], list[str], list[str]]:
+    return _format_reduction(instr, "FVVSR", test_data, params)
+
+
+@add_instruction_formatter("FWVWSR", fwvsr_config)
+def format_fwvwsr(instr: str, test_data: TestData, params: InstructionParams) -> tuple[list[str], list[str], list[str]]:
+    return _format_reduction(instr, "FWVWSR", test_data, params)
+
+
+@add_instruction_formatter("FFV", ffv_config)
+def format_ffv(instr: str, test_data: TestData, params: InstructionParams) -> tuple[list[str], list[str], list[str]]:
+    assert params.fd is not None and params.vs2 is not None and params.sew is not None and params.lmul is not None
+    assert params.vs2_val_pointer is not None and test_data.test_chunk is not None
+    test_data.test_chunk.vector_labels.append((params.vs2_val_pointer, *test_data.vector_labels[params.vs2_val_pointer]))
+    setup, random_vl_reg = load_vec_regs([VectorLoad("vs2", vl=1, lmul=1)], params, test_data)
+    setup.append(load_test_vtype(params, random_vl_reg))
+    if random_vl_reg.startswith("x"):
+        test_data.int_regs.return_register(int(random_vl_reg[1:]))
+    check = [write_sigupd(params.fd, test_data, "float")]
+    handle_parameter_exclusions(params.lmul, setup, check)
+    return _with_fp_state(lambda: (setup, [f"{instr} f{params.fd}, v{params.vs2}"], check), test_data, params)
+
+
+@add_instruction_formatter("FVF", fvf_config)
+def format_fvf(instr: str, test_data: TestData, params: InstructionParams) -> tuple[list[str], list[str], list[str]]:
+    assert params.vd is not None and params.fs1 is not None and params.fs1val is not None
+    assert params.sew is not None and params.lmul is not None and test_data.test_chunk is not None
+    assert params.vd_val_pointer is not None
+    test_data.test_chunk.vector_labels.append((params.vd_val_pointer, *test_data.vector_labels[params.vd_val_pointer]))
+    setup = [load_float_reg("fs1", params.fs1, params.fs1val, test_data, _fp_load_type(params.sew))]
+    check: list[str]
+    if instr == "vfmv.s.f":
+        load, random_vl_reg = load_vec_regs([VectorLoad("vd", vl=1, lmul=1)], params, test_data)
+        setup.extend(load)
+        setup.append(load_test_vtype(params, random_vl_reg))
+        check = write_sigupd_v(test_data, params)
+    else:
+        load, random_vl_reg = load_vec_regs([VectorLoad("vd", vl=params.vl)], params, test_data)
+        setup.extend(load)
+        setup.append(load_test_vtype(params, random_vl_reg))
+        if params.vector_suite == "length":
+            check = write_sigupd_v_len(test_data, params, params.lmul)
+        else:
+            check = write_sigupd_v(test_data, params)
+    if random_vl_reg.startswith("x"):
+        test_data.int_regs.return_register(int(random_vl_reg[1:]))
+    handle_parameter_exclusions(params.lmul, setup, check)
+    return _with_fp_state(lambda: (setup, [f"{instr} v{params.vd}, f{params.fs1}"], check), test_data, params)
