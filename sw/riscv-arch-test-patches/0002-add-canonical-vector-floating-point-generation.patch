+# Generates vector-versus-scalar floating-point edge cross products.
+# SPDX-License-Identifier: Apache-2.0
+
+from testgen.coverpoints.registry import add_coverpoint_generator
+from testgen.coverpoints.vector.fp_helpers import vector_fp_edges
+from testgen.data.state import TestData, return_testcase_registers
+from testgen.data.test_chunk import TestChunk
+from testgen.formatters import format_single_testcase
+from testgen.instructions.vector_params import generate_random_vector_params
+
+
+@add_coverpoint_generator("cr_vs2_fs1_edges")
+def make_vs2_fs1_edges(
+    instr_name: str, instr_type: str, coverpoint: str, test_data: TestData
+) -> list[TestChunk]:
+    """Cross every architectural FP edge in vs2 with every edge in fs1."""
+    assert test_data.config.sew is not None
+    vs2_wide = coverpoint.endswith("_wf")
+    vs2_edges = vector_fp_edges(test_data, wide=vs2_wide)
+    fs1_edges = vector_fp_edges(test_data)
+    vs2_sew = test_data.config.sew * (2 if vs2_wide else 1)
+    chunks = []
+    for vs2_index, vs2_value in enumerate(vs2_edges):
+        label = f"vs2_fs1_edge_{vs2_index}_{'wide' if vs2_wide else 'same'}"
+        test_data.register_vector_data(label, vs2_sew, elements=[vs2_value])
+        for fs1_index, fs1_value in enumerate(fs1_edges):
+            params = generate_random_vector_params(
+                test_data, instr_name, instr_type, lmul=1, vs2_val_pointer=label, fs1val=fs1_value
+            )
+            desc = f"{coverpoint} (vs2 edge {vs2_index}, fs1 edge {fs1_index})"
+            tc = format_single_testcase(
+                instr_name, instr_type, test_data, params, desc, f"b{vs2_index}_{fs1_index}", coverpoint
+            )
+            chunks.append(tc)
+            return_testcase_registers(test_data, params)
+    return chunks
diff --git a/generators/testgen/src/testgen/coverpoints/vector/fp_custom.py b/generators/testgen/src/testgen/coverpoints/vector/fp_custom.py
new file mode 100644
index 0000000000000000000000000000000000000000..53dd9c625a1e110349c023fa860e48d6019087f6
--- /dev/null
+++ b/generators/testgen/src/testgen/coverpoints/vector/fp_custom.py
@@ -0,0 +1,254 @@
+# Generates directed vector floating-point cases that are not expressible as generic edge crosses.
+# SPDX-License-Identifier: Apache-2.0
+
+from collections.abc import Iterable
+
+from testgen.coverpoints.registry import add_coverpoint_generator
+from testgen.data.params import PresetMask
+from testgen.data.state import TestData, return_testcase_registers
+from testgen.data.test_chunk import TestChunk
+from testgen.formatters import format_single_testcase
+from testgen.formatters.registry import get_instruction_type_config
+from testgen.instructions.vector_params import generate_random_vector_params
+
+
+FP = {
+    16: {"zero": 0x0000, "one": 0x3C00, "three": 0x4200, "qnan": 0x7E00, "snan": 0x7D00,
+         "max": 0x7BFF, "neg_max": 0xFBFF, "tiny": 0x0001, "min_norm": 0x0400, "inf": 0x7C00},
+    32: {"zero": 0x00000000, "one": 0x3F800000, "three": 0x40400000, "qnan": 0x7FC00000,
+         "snan": 0x7FA00000, "max": 0x7F7FFFFF, "neg_max": 0xFF7FFFFF, "tiny": 0x00000001,
+         "min_norm": 0x00800000, "inf": 0x7F800000},
+    64: {"zero": 0x0000000000000000, "one": 0x3FF0000000000000, "three": 0x4008000000000000,
+         "qnan": 0x7FF8000000000000, "snan": 0x7FF0000000000001, "max": 0x7FEFFFFFFFFFFFFF,
+         "neg_max": 0xFFEFFFFFFFFFFFFF, "tiny": 0x0000000000000001, "min_norm": 0x0010000000000000,
+         "inf": 0x7FF0000000000000},
+}
+
+
+def _emit(
+    instr_name: str,
+    instr_type: str,
+    coverpoint: str,
+    test_data: TestData,
+    desc: str,
+    *,
+    lmul: float = 1,
+    vl: int = 1,
+    vs2: Iterable[int] | None = None,
+    vs2_sew: int | None = None,
+    vs1: Iterable[int] | None = None,
+    vs1_sew: int | None = None,
+    fs1val: int | None = None,
+    frm: str | None = None,
+    vd: int | None = None,
+    vs2_reg: int | None = None,
+    maskval: PresetMask | None = None,
+    pre_test: list[str] | None = None,
+) -> TestChunk:
+    assert test_data.config.sew is not None
+    sew = test_data.config.sew
+    fixed: dict[str, object] = {"vl": vl}
+    suffix = f"{test_data.test_count:04d}"
+    if vs2 is not None:
+        label = f"custom_{coverpoint}_{suffix}_vs2"
+        test_data.register_vector_data(label, vs2_sew or sew, elements=list(vs2))
+        fixed["vs2_val_pointer"] = label
+    if vs1 is not None:
+        label = f"custom_{coverpoint}_{suffix}_vs1"
+        test_data.register_vector_data(label, vs1_sew or sew, elements=list(vs1))
+        fixed["vs1_val_pointer"] = label
+    if fs1val is not None:
+        fixed["fs1val"] = fs1val
+    if frm is not None:
+        fixed["frm"] = frm
+    if vd is not None:
+        test_data.vec_regs.allocate_operand("vd", vd, 1)
+        fixed["vd"] = vd
+    if vs2_reg is not None:
+        test_data.vec_regs.allocate_operand("vs2", vs2_reg, 1)
+        fixed["vs2"] = vs2_reg
+    if maskval is not None:
+        fixed["maskval"] = maskval
+    params = generate_random_vector_params(
+        test_data,
+        instr_name,
+        instr_type,
+        lmul=lmul,
+        masked=maskval is not None,
+        suite="base",
+        **fixed,
+    )
+    tc = format_single_testcase(instr_name, instr_type, test_data, params, desc, suffix, coverpoint)
+    if pre_test:
+        tc.code[-1:-1] = pre_test
+    return_testcase_registers(test_data, params)
+    return tc
+
+
+@add_coverpoint_generator("cp_custom_vfp_NaN_input")
+def make_nan_inputs(instr_name: str, instr_type: str, coverpoint: str, test_data: TestData) -> list[TestChunk]:
+    assert test_data.config.sew is not None
+    values = FP[test_data.config.sew]
+    return [
+        _emit(instr_name, instr_type, coverpoint, test_data, f"{coverpoint} ({name})", vs2=[values[name]])
+        for name in ("snan", "qnan")
+    ]
+
+
+@add_coverpoint_generator("cp_custom_vfclass_onehot")
+def make_vfclass(instr_name: str, instr_type: str, coverpoint: str, test_data: TestData) -> list[TestChunk]:
+    assert test_data.config.sew is not None
+    values = {
+        16: [0xFC00, 0xBC00, 0x8001, 0x8000, 0x0000, 0x0001, 0x3C00, 0x7C00, 0x7D01, 0x7E00],
+        32: [0xFF800000, 0xBF800000, 0x80000001, 0x80000000, 0x00000000, 0x00000001,
+             0x3F800000, 0x7F800000, 0x7F800001, 0x7FC00000],
+        64: [0xFFF0000000000000, 0xBFF0000000000000, 0x8000000000000001, 0x8000000000000000,
+             0x0000000000000000, 0x0000000000000001, 0x3FF0000000000000, 0x7FF0000000000000,
+             0x7FF0000000000001, 0x7FF8000000000000],
+    }[test_data.config.sew]
+    return [
+        _emit(instr_name, instr_type, coverpoint, test_data, f"{coverpoint} (class {index})", vs2=[value])
+        for index, value in enumerate(values)
+    ]
+
+
+@add_coverpoint_generator("cp_custom_vfncvt_rup_overflow")
+@add_coverpoint_generator("cp_custom_vfncvt_rod_overflow")
+def make_narrow_overflow(instr_name: str, instr_type: str, coverpoint: str, test_data: TestData) -> list[TestChunk]:
+    if test_data.config.sew != 32:
+        return []
+    values = [0x47F0000000000000, 0xC7F0000000000000]
+    frm = "rup" if coverpoint.endswith("rup_overflow") else None
+    return [
+        _emit(instr_name, instr_type, coverpoint, test_data, f"{coverpoint} ({index})", vs2=[value], vs2_sew=64, frm=frm)
+        for index, value in enumerate(values)
+    ]
+
+
+ALL_LMULS = (0.125, 0.25, 0.5, 1, 2, 4, 8)
+
+
+@add_coverpoint_generator("cp_custom_fmv_sf_vd_all_lmul")
+def make_fmv_sf(instr_name: str, instr_type: str, coverpoint: str, test_data: TestData) -> list[TestChunk]:
+    assert test_data.config.sew is not None
+    minimum = test_data.config.sew / 64
+    chunks = []
+    for lmul in (value for value in ALL_LMULS if value >= minimum):
+        for vd in (range(32) if lmul == 1 else (0,)):
+            chunks.append(_emit(instr_name, instr_type, coverpoint, test_data, f"{coverpoint} (vd={vd}, lmul={lmul})", lmul=lmul, vd=vd))
+    return chunks
+
+
+@add_coverpoint_generator("cp_custom_fmv_fs_vs2_all_lmul")
+def make_fmv_fs(instr_name: str, instr_type: str, coverpoint: str, test_data: TestData) -> list[TestChunk]:
+    assert test_data.config.sew is not None
+    minimum = test_data.config.sew / 64
+    chunks = []
+    for lmul in (value for value in ALL_LMULS if value >= minimum):
+        for vs2 in (range(32) if lmul == 1 else (0,)):
+            chunks.append(_emit(instr_name, instr_type, coverpoint, test_data, f"{coverpoint} (vs2={vs2}, lmul={lmul})", lmul=lmul, vs2_reg=vs2))
+    return chunks
+
+
+def _estimate_value(sew: int, index: int, *, sqrt: bool) -> int:
+    if sqrt:
+        exp_lsb, mantissa = (index >> 6) & 1, index & 0x3F
+        exp_bits, fraction_bits = {16: (5, 10), 32: (8, 23), 64: (11, 52)}[sew]
+        exponent = (1 << (exp_bits - 1)) | exp_lsb
+        return (exponent << fraction_bits) | (mantissa << (fraction_bits - 6))
+    exp_bits, fraction_bits = {16: (5, 10), 32: (8, 23), 64: (11, 52)}[sew]
+    return (1 << (exp_bits - 1) << fraction_bits) | (index << (fraction_bits - 7))
+
+
+@add_coverpoint_generator("cp_custom_FpRecSqrtEst_edges")
+@add_coverpoint_generator("cp_custom_FpRecipEst_edges")
+def make_estimate_edges(instr_name: str, instr_type: str, coverpoint: str, test_data: TestData) -> list[TestChunk]:
+    assert test_data.config.sew is not None
+    sqrt = "Sqrt" in coverpoint
+    return [
+        _emit(instr_name, instr_type, coverpoint, test_data, f"{coverpoint} ({index})",
+              vs2=[_estimate_value(test_data.config.sew, index, sqrt=sqrt)])
+        for index in range(128)
+    ]
+
+
+@add_coverpoint_generator("cp_custom_FpRecSqrtEst_flag_edges")
+@add_coverpoint_generator("cp_custom_FpRecipEst_flag_edges")
+def make_estimate_flag_edges(
+    instr_name: str, instr_type: str, coverpoint: str, test_data: TestData
+) -> list[TestChunk]:
+    assert test_data.config.sew is not None
+    sew = test_data.config.sew
+    values = FP[sew]
+    ordered = [values["zero"], 1 << (sew - 1), values["tiny"], values["min_norm"], values["one"],
+               values["max"], values["inf"], values["qnan"], values["snan"]]
+    return [
+        _emit(instr_name, instr_type, coverpoint, test_data, f"{coverpoint} ({index})", vs2=[value])
+        for index, value in enumerate(ordered)
+    ]
+
+
+@add_coverpoint_generator("cp_custom_vfredosum_ordered_sum")
+def make_ordered_sum(instr_name: str, instr_type: str, coverpoint: str, test_data: TestData) -> list[TestChunk]:
+    assert test_data.config.sew is not None
+    values = FP[test_data.config.sew]
+    return [_emit(instr_name, instr_type, coverpoint, test_data, coverpoint, lmul=2, vl=2,
+                  vs1=[values["max"]], vs2=[values["neg_max"], values["one"]])]
+
+
+@add_coverpoint_generator("cp_custom_vfredosum_NAN_vl0")
+def make_nan_vl0(instr_name: str, instr_type: str, coverpoint: str, test_data: TestData) -> list[TestChunk]:
+    assert test_data.config.sew is not None
+    vs1_sew = test_data.config.sew * (2 if instr_name.startswith("vfw") else 1)
+    if vs1_sew not in FP:
+        return []
+    return [_emit(instr_name, instr_type, coverpoint, test_data, coverpoint, vl=0,
+                  vs1=[FP[vs1_sew]["qnan"]], vs1_sew=vs1_sew)]
+
+
+@add_coverpoint_generator("cp_custom_vfp_state")
+def make_fp_state(instr_name: str, instr_type: str, coverpoint: str, test_data: TestData) -> list[TestChunk]:
+    pre_test = ["li x6, 0x6000", "csrrc x0, mstatus, x6", "li x6, 0x4000", "csrrs x0, mstatus, x6"]
+    return [_emit(instr_name, instr_type, coverpoint, test_data, coverpoint, pre_test=pre_test)]
+
+
+FLAG_VALUES = {
+    "nv": "snan",
+    "dz": "zero",
+    "of": "max",
+    "uf": "min_norm",
+    "nx": "three",
+}
+
+
+@add_coverpoint_generator("cp_custom_vfp_flags_inactive_not_set")
+def make_inactive_flags(instr_name: str, instr_type: str, coverpoint: str, test_data: TestData) -> list[TestChunk]:
+    if instr_name != "vfrsqrt7.v":
+        return []
+    assert test_data.config.sew is not None
+    return [_emit(instr_name, instr_type, coverpoint, test_data, coverpoint,
+                  vs2=[FP[test_data.config.sew]["zero"]], maskval=PresetMask.ZEROS)]
+
+
+@add_coverpoint_generator("cp_custom_vfp_flags")
+def make_fp_flags(instr_name: str, instr_type: str, coverpoint: str, test_data: TestData) -> list[TestChunk]:
+    assert test_data.config.sew is not None
+    if instr_name in {"vfmerge.vfm", "vfmv.v.f", "vfmv.f.s", "vfmv.s.f", "vfclass.v"}:
+        return []
+    values = FP[test_data.config.sew]
+    flags = [flag for flag in FLAG_VALUES if flag in coverpoint.removeprefix("cp_custom_vfp_flags_").split("_")]
+    if not flags:
+        flags = ["nv"]
+    config = get_instruction_type_config(instr_type)
+    required = config.required_params or set()
+    chunks = []
+    for flag in flags:
+        key = FLAG_VALUES[flag]
+        value = values[key]
+        fixed: dict[str, object] = {"vs2": [value]}
+        if "vs1" in required:
+            fixed["vs1"] = [values["zero"] if flag == "dz" else value]
+        if "fs1" in required:
+            fixed["fs1val"] = values["zero"] if flag == "dz" else value
+        chunks.append(_emit(instr_name, instr_type, coverpoint, test_data, f"{coverpoint} ({flag})", **fixed))
+    return chunks
