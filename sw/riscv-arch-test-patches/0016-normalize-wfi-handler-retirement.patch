From: Jerry Zhao <jerryz123@berkeley.edu>
Subject: [PATCH] Exclude variable handler retirement from WFI counter tests
Purpose: Keeps WFI retirement checks independent of interrupt-service polling latency.
SPDX-License-Identifier: Apache-2.0

A timer clear reaches mip eventually. The standard interrupt handler may
therefore retire more polling instructions on the DUT than in Sail, even
when both retirement counters are correct.

Opt the M/U counter suites into a measured standard M-handler interval.
Subtract the completed handler body along with full outer loop trips,
retaining an exact check of WFI and fixed entry/exit retirement. No counter
inhibition CSR, fixed interrupt latency, or counter reset is required.

diff --git a/generators/testgen/src/testgen/priv/extensions/ZicntrCommon.py b/generators/testgen/src/testgen/priv/extensions/ZicntrCommon.py
--- a/generators/testgen/src/testgen/priv/extensions/ZicntrCommon.py
+++ b/generators/testgen/src/testgen/priv/extensions/ZicntrCommon.py
@@ -203,7 +203,7 @@


 def _instret_wait_case(test_data: TestData, covergroup: str, name: str, mode: Mode, wait: str) -> list[str]:
-    """Delta around a wait instruction (wfi) that a timer interrupt ends."""
+    """Delta around WFI, excluding variable timer-handler work and full loop trips."""
     csr = "instret" if mode == "U" else "minstret"
     r_before, r_after, r_diff = test_data.int_regs.get_registers(3)
     r_count, r_addr = test_data.int_regs.get_registers(2)
@@ -236,6 +236,12 @@
         f"csrr x{r_after}, {csr}",
         f"sub x{r_after}, x{r_after}, x{r_diff}  # remove the timing-dependent part",
         f"sub x{r_diff}, x{r_after}, x{r_before}",
+        # The timer handler may poll for MTIP deassertion for a different number
+        # of instructions on each implementation. Subtract its measured body;
+        # entry/exit overhead and the WFI path still have exact reference counts.
+        f"LA(x{r_addr}, rvtest_mtrap_instret)",
+        f"LREG x{r_after}, 0(x{r_addr})",
+        f"sub x{r_diff}, x{r_diff}, x{r_after}",
         write_sigupd(r_diff, test_data),
         *(["csrci mstatus, 8  # MIE = 0"] if mode == "M" else []),
         f"RVTEST_CLR_MTIME_INT_{mode}",
diff --git a/generators/testgen/src/testgen/priv/extensions/ZicntrSm.py b/generators/testgen/src/testgen/priv/extensions/ZicntrSm.py
--- a/generators/testgen/src/testgen/priv/extensions/ZicntrSm.py
+++ b/generators/testgen/src/testgen/priv/extensions/ZicntrSm.py
@@ -28,7 +28,7 @@
         "Zicntr",
     ],
     march_extensions=["Zicntr", "Zihpm", "Zawrs"],
-    extra_defines=["#define BOOT_TO_MMODE"],
+    extra_defines=["#define BOOT_TO_MMODE", "#define RVTEST_MEASURE_M_TRAP_INSTRET"],
 )
 def make_zicntrsm(test_data: TestData) -> list[TestChunk]:
     """Generate tests for ZicntrSm coverpoints: the M-mode halves of the Zicntr counter-enable tests."""
diff --git a/generators/testgen/src/testgen/priv/extensions/ZicntrU.py b/generators/testgen/src/testgen/priv/extensions/ZicntrU.py
--- a/generators/testgen/src/testgen/priv/extensions/ZicntrU.py
+++ b/generators/testgen/src/testgen/priv/extensions/ZicntrU.py
@@ -26,6 +26,7 @@
     "ZicntrU",
     required_extensions=["U", "Zicntr"],
     march_extensions=["Zicntr", "Zihpm", "Zawrs"],
+    extra_defines=["#define RVTEST_MEASURE_M_TRAP_INSTRET"],
 )
 def make_zicntru(test_data: TestData) -> list[TestChunk]:
     """Generate tests for ZicntrU coverpoints"""
diff --git a/tests/env/rvtest_setup.h b/tests/env/rvtest_setup.h
--- a/tests/env/rvtest_setup.h
+++ b/tests/env/rvtest_setup.h
@@ -918,6 +918,14 @@
   .global rvtest_trap_count
   rvtest_trap_count:
     .dword 0
+
+  #ifdef RVTEST_MEASURE_M_TRAP_INSTRET
+    // The standard M handler replaces its entry snapshot with its retired
+    // body length before returning. Counter wait tests consume the last trap.
+    .global rvtest_mtrap_instret
+    rvtest_mtrap_instret:
+      .dword 0
+  #endif

   .p2align 4

diff --git a/tests/env/rvtest_trap_handler.h b/tests/env/rvtest_trap_handler.h
--- a/tests/env/rvtest_trap_handler.h
+++ b/tests/env/rvtest_trap_handler.h
@@ -1308,6 +1308,15 @@
         SREG    T2, trap_sv_off+2*REGWIDTH(sp)  // save T2 (x7)
         SREG    T1, trap_sv_off+1*REGWIDTH(sp)  // save T1 (x6)
         csrr    T5, CSR_XCAUSE                  // T5 = xcause
+
+  .ifc \__MODE__ , M
+    #ifdef RVTEST_MEASURE_M_TRAP_INSTRET
+        // All temporaries are saved; sample before dispatch and timer polling.
+        csrr    T1, minstret
+        LA(T2, rvtest_mtrap_instret)
+        SREG    T1, 0(T2)
+    #endif
+  .endif

   // Route M-mode illegal instructions to the invisible trap handler. Keep this
   // sequence the same size when emulation is disabled. The Sail signature build
@@ -2373,6 +2382,17 @@
 //==============================================================================

  resto_\__MODE__\()rtn:
+  .ifc \__MODE__ , M
+    #ifdef RVTEST_MEASURE_M_TRAP_INSTRET
+        // No nested M traps are permitted by the standard handler. Subtraction
+        // is modulo XLEN, matching the low counter read used by RV32 tests.
+        csrr    T1, minstret
+        LA(T2, rvtest_mtrap_instret)
+        LREG    T3, 0(T2)
+        sub     T1, T1, T3
+        SREG    T1, 0(T2)
+    #endif
+  .endif
         LREG    T1, trap_sv_off+1*REGWIDTH(sp)    // restore T1 (x6)
         LREG    T2, trap_sv_off+2*REGWIDTH(sp)    // restore T2 (x7)
         LREG    T3, trap_sv_off+3*REGWIDTH(sp)    // restore T3 (x8)
