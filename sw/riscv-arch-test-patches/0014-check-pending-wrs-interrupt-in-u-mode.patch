From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jerry Zhao <jerryz123@berkeley.edu>
Subject: [PATCH] Check pending WRS interrupts in U mode
Purpose: Lets U-mode Zawrs resume tests finish when a masked timer interrupt becomes pending.
SPDX-License-Identifier: Apache-2.0

WRS instructions may complete early even when an interrupt is masked. The
resume generator repeats them until a trap is taken or the pending timer bit
appears, but only M- and S-mode cases check the latter. A U-mode case with
interrupts masked can therefore loop forever after the timer has fired.
Read the selected timer's pending CSR through the existing T-SBI helper, as
the U-mode test cannot access mip or sip directly.

diff --git a/generators/testgen/src/testgen/priv/extensions/ZawrsCommon.py b/generators/testgen/src/testgen/priv/extensions/ZawrsCommon.py
--- a/generators/testgen/src/testgen/priv/extensions/ZawrsCommon.py
+++ b/generators/testgen/src/testgen/priv/extensions/ZawrsCommon.py
@@ -194,6 +194,20 @@ def wrs_resume_helper(
                                 "#endif",
                             ]
                         )
+                    if priv == "U" and (mie_val == 0 or sie_val == 0):
+                        lines.extend(
+                            [
+                                "# U mode reads the selected timer's pending bit through T-SBI",
+                                "#ifdef SSTC_SUPPORTED",
+                                s_csr(priv, f"csrr x{r_temp}, sip"),
+                                f"andi x{r_temp}, x{r_temp}, 0x20  # Extract sip.STIP",
+                                "#else",
+                                m_csr(priv, f"csrr x{r_temp}, mip"),
+                                f"andi x{r_temp}, x{r_temp}, 0x80  # Extract mip.MTIP",
+                                "#endif",
+                                f"bnez x{r_temp}, 2f              # Interrupt pending -> done",
+                            ]
+                        )
                     lines.extend(
                         [
                             "j 1b",
