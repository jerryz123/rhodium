Subject: [PATCH] Inhibit counting while preloading an RV32 HPM counter

Purpose: Makes overflow setup independent of events between split counter writes.
SPDX-License-Identifier: Apache-2.0

A cycle event can wrap the low word before the high-word write, leaving the
counter far from a 64-bit overflow. Save the selector's high word, inhibit
M/S/U counting across both writes, then restore its original filters and OF.
This uses Sscofpmf's mandatory filters, not optional mcountinhibit controls.
The extra scratch register is already free at all three callers.

diff --git a/generators/testgen/src/testgen/priv/extensions/SscofpmfCommon.py b/generators/testgen/src/testgen/priv/extensions/SscofpmfCommon.py
--- a/generators/testgen/src/testgen/priv/extensions/SscofpmfCommon.py
+++ b/generators/testgen/src/testgen/priv/extensions/SscofpmfCommon.py
@@ -153,8 +153,14 @@
-def write_counter_all_ones(r_temp: int, priv_mode: str) -> list[str]:
+def write_counter_all_ones(r_temp: int, r_save: int, priv_mode: str) -> list[str]:
     return [
+        "#if __riscv_xlen == 32",
+        tsbi_call_or_direct(f"csrr x{r_save}, RVTEST_CSR_MHPMEVENTH", priv_mode),
+        f"LI(x{r_temp}, 0x70000000)   # inhibit M/S/U counting during split writes",
+        tsbi_call_or_direct(f"csrs RVTEST_CSR_MHPMEVENTH, x{r_temp}", priv_mode),
+        "#endif",
         f"LI(x{r_temp}, -1)",
         tsbi_call_or_direct(f"csrw RVTEST_CSR_MHPMCOUNTER, x{r_temp}   # all 1s -> next count overflows", priv_mode),
         "#if __riscv_xlen == 32",
         tsbi_call_or_direct(f"csrw RVTEST_CSR_MHPMCOUNTERH, x{r_temp}   # high half must also be all 1s", priv_mode),
+        tsbi_call_or_direct(f"csrw RVTEST_CSR_MHPMEVENTH, x{r_save}   # restore filters and OF", priv_mode),
         "#endif",
     ]
@@ -163,8 +169,8 @@
 def prime_counter_overflow(r_val: int, r_hval: int, r_temp: int, r_addr: int, priv_mode: str) -> list[str]:
     """Overflow the counter in the mode under test, which sets OF and raises LCOFIP."""
     return [
         *write_event_pattern(r_val, r_hval, HIGHER_MODE_PATTERN[priv_mode], priv_mode),
-        *write_counter_all_ones(r_temp, priv_mode),
+        *write_counter_all_ones(r_temp, r_hval, priv_mode),
         f"LA(x{r_addr}, scratch)",
         f"RVMODEL_MHPMEVENT_CODE(x{r_addr}, x{r_val})",
     ]
@@ -373,7 +379,7 @@
             [
                 *write_event_pattern(r_val, r_hval, inhibit_pattern, priv_mode),
-                *write_counter_all_ones(r_temp, priv_mode),
+                *write_counter_all_ones(r_temp, r_hval, priv_mode),
                 tsbi_call_or_direct(f"csrr x{r_preset}, RVTEST_CSR_MHPMCOUNTER   # preset as read back", priv_mode),
                 "",
                 f"LA(x{r_addr}, scratch)",
                 "# One counted event is enough to wrap the all-1s counter and set OF",
@@ -412,7 +418,7 @@
             tsbi_call_or_direct(f"csrw RVTEST_CSR_MHPMEVENT, x{r_val}", priv_mode),
             "#endif",
-            *write_counter_all_ones(r_temp, priv_mode),
+            *write_counter_all_ones(r_temp, r_hval, priv_mode),
             tsbi_call_or_direct(f"csrr x{r_preset}, RVTEST_CSR_MHPMCOUNTER   # preset as read back", priv_mode),
             *clear_lcofip(r_temp, priv_mode),
             "",
             f"LA(x{r_addr}, scratch)",
