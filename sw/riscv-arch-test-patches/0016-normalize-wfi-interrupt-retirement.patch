From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jerry Zhao <jerryz123@berkeley.edu>
Subject: [PATCH] Exclude variable timer-handler retirement from WFI counter checks
Purpose: Checks WFI retirement independently of interrupt-handler timing.
SPDX-License-Identifier: Apache-2.0

The WFI-taken counter tests subtract their main polling-loop tally but
also count the timer handler. Its interrupt-clear polling and other paths
can retire different numbers of instructions on a conforming DUT and the
reference model. Measure that body in counter-test-only instrumentation
and subtract it too. Keep the fixed entry/exit overhead, WFI retirement,
and the ordinary trap signature checks in the reference comparison.

Keep MTIE disabled until the counter baseline has been read, including
for U-mode where mstatus.MIE does not mask machine interrupts. Do not
change platform interrupt latency, core counters, or test selection.

diff --git a/generators/testgen/src/testgen/priv/extensions/Sm.py b/generators/testgen/src/testgen/priv/extensions/Sm.py
index ebb18749..ea1ea670 100644
--- a/generators/testgen/src/testgen/priv/extensions/Sm.py
+++ b/generators/testgen/src/testgen/priv/extensions/Sm.py
@@ -1712,7 +1712,7 @@ _ZICNTR_CG = "Sm_Zicntr_cg"
     "Sm",
     required_extensions=["Sm", "Zicntr"],
     march_extensions=["Zicntr", "Zihpm", "Zawrs"],
-    extra_defines=["#define BOOT_TO_MMODE"],
+    extra_defines=["#define BOOT_TO_MMODE", "#define RVTEST_COUNT_MTIME_INSTRET"],
 )
 def make_zicntrsm(test_data: TestData) -> list[TestChunk]:
     """Generate Sm_Zicntr tests: the M-mode halves of the Zicntr counter-enable tests."""
diff --git a/generators/testgen/src/testgen/priv/extensions/U.py b/generators/testgen/src/testgen/priv/extensions/U.py
index 7c754760..f005f71d 100644
--- a/generators/testgen/src/testgen/priv/extensions/U.py
+++ b/generators/testgen/src/testgen/priv/extensions/U.py
@@ -109,6 +109,7 @@ _ZICNTR_CG = "U_Zicntr_cg"
     "U",
     required_extensions=["U", "Zicntr"],
     march_extensions=["Zicntr", "Zihpm", "Zawrs"],
+    extra_defines=["#define RVTEST_COUNT_MTIME_INSTRET"],
 )
 def make_zicntru(test_data: TestData) -> list[TestChunk]:
     """Generate U_Zicntr tests"""
diff --git a/generators/testgen/src/testgen/priv/extensions/ZicntrCommon.py b/generators/testgen/src/testgen/priv/extensions/ZicntrCommon.py
index 163c3551..68dcc61e 100644
--- a/generators/testgen/src/testgen/priv/extensions/ZicntrCommon.py
+++ b/generators/testgen/src/testgen/priv/extensions/ZicntrCommon.py
@@ -203,7 +203,7 @@ def _instret_case(


 def _instret_wait_case(test_data: TestData, covergroup: str, name: str, mode: Mode, wait: str) -> list[str]:
-    """Delta around a wait instruction (wfi) that a timer interrupt ends."""
+    """Check wait retirement, excluding loop trips and the variable timer-handler body."""
     csr = "instret" if mode == "U" else "minstret"
     r_before, r_after, r_diff = test_data.int_regs.get_registers(3)
     r_count, r_addr = test_data.int_regs.get_registers(2)
@@ -218,16 +218,19 @@ def _instret_wait_case(test_data: TestData, covergroup: str, name: str, mode: Mo
     lines = [
         tsbi_call_or_direct("csrw mie, zero", mode),
         *(["csrci mstatus, MSTATUS_MIE"] if mode == "M" else []),
-        f"LI(x{r_after}, 0x80)",
-        tsbi_call_or_direct(f"csrw mie, x{r_after}  # MTIE only", mode),
         f"RVTEST_SET_MTIME_INT_SOON_{mode}",
+        f"LA(x{r_addr}, rvtest_mtime_instret_delta)",
+        f"SREG zero, 0(x{r_addr})  # no timer handler has run yet",
         # Read the trap count after the T-SBI ecalls above, so only the timer interrupt can change it from here
         f"LA(x{r_addr}, rvtest_trap_count)",
         f"LREG x{r_count}, 0(x{r_addr})  # trap count before waiting",
         f"LI(x{r_diff}, 0)  # tally of instructions retired by the loop",
-        *(["csrsi mstatus, 8  # MIE = 1"] if mode == "M" else []),
+        f"LI(x{r_after}, 0x80)",
         test_data.add_testcase(f"{csr}_{name}", f"cp_instret_{name}", covergroup),
         f"csrr x{r_before}, {csr}",
+        # Keep MTIE clear until the baseline, including in U-mode where MIE does not mask M interrupts.
+        tsbi_call_or_direct(f"csrw mie, x{r_after}  # MTIE only", mode),
+        *(["csrsi mstatus, 8  # MIE = 1"] if mode == "M" else []),
         "1:",
         *trip,
         f"addi x{r_diff}, x{r_diff}, {insns_per_trip}  # tally this trip",
@@ -235,6 +238,9 @@ def _instret_wait_case(test_data: TestData, covergroup: str, name: str, mode: Mo
         "2:",
         f"csrr x{r_after}, {csr}",
         f"sub x{r_after}, x{r_after}, x{r_diff}  # remove the timing-dependent part",
+        f"LA(x{r_addr}, rvtest_mtime_instret_delta)",
+        f"LREG x{r_count}, 0(x{r_addr})",
+        f"sub x{r_after}, x{r_after}, x{r_count}  # remove measured handler-body retirement",
         f"sub x{r_diff}, x{r_after}, x{r_before}",
         write_sigupd(r_diff, test_data),
         *(["csrci mstatus, 8  # MIE = 0"] if mode == "M" else []),
diff --git a/tests/env/rvtest_setup.h b/tests/env/rvtest_setup.h
index d775ddf9..04923ff5 100644
--- a/tests/env/rvtest_setup.h
+++ b/tests/env/rvtest_setup.h
@@ -1018,6 +1018,12 @@
   rvtest_trap_count:
     .dword 0

+  #ifdef RVTEST_COUNT_MTIME_INSTRET
+  // Counter tests remove this measured handler-body delta, not a fixed interrupt latency.
+  rvtest_mtime_instret_delta:
+    .dword 0
+  #endif
+
   .p2align 4

   // Create separate save areas for each priv mode trap handler
diff --git a/tests/env/rvtest_trap_handler.h b/tests/env/rvtest_trap_handler.h
index ed90fc4e..c9c7c0aa 100644
--- a/tests/env/rvtest_trap_handler.h
+++ b/tests/env/rvtest_trap_handler.h
@@ -1322,6 +1322,18 @@ common_\__MODE__\()entry:                       // common entry for all traps in
         SREG    T1, trap_sv_off+1*REGWIDTH(sp)  // save T1 (x6)
         csrr    T5, CSR_XCAUSE                  // T5 = xcause

+  #ifdef RVTEST_COUNT_MTIME_INSTRET
+  .ifc \__MODE__, M
+        // Only counter tests opt in. Slot 3 is unused by CLR_INT_ENTER/RETURN.
+        // M interrupts are masked throughout the handler, so this sample cannot nest.
+        LI(     T1, (1 << (UDB_MXLEN-1)) | IRQ_M_TIMER)
+        bne     T5, T1, 1f
+        csrr    T1, CSR_MINSTRET
+        SREG    T1, int_clr_sv_off+3*REGWIDTH(sp)
+      1:
+  .endif
+  #endif
+
   // Route M-mode illegal instructions to the invisible trap handler. Keep this
   // sequence the same size when emulation is disabled. The Sail signature build
   // disables emulation, and a size change would move later trap-handler labels.
@@ -2607,6 +2619,19 @@ dispatch_\__MODE__\()spcl_excpt_handler:
 //==============================================================================

  resto_\__MODE__\()rtn:
+  #ifdef RVTEST_COUNT_MTIME_INSTRET
+  .ifc \__MODE__, M
+        csrr    T2, CSR_MCAUSE
+        LI(     T3, (1 << (UDB_MXLEN-1)) | IRQ_M_TIMER)
+        bne     T2, T3, 1f
+        csrr    T1, CSR_MINSTRET
+        LREG    T2, int_clr_sv_off+3*REGWIDTH(sp)
+        sub     T1, T1, T2
+        LA(     T2, rvtest_mtime_instret_delta)
+        SREG    T1, 0(T2)
+      1:
+  .endif
+  #endif
         LREG    T1, trap_sv_off+1*REGWIDTH(sp)    // restore T1 (x6)
         LREG    T2, trap_sv_off+2*REGWIDTH(sp)    // restore T2 (x7)
         LREG    T3, trap_sv_off+3*REGWIDTH(sp)    // restore T3 (x8)
