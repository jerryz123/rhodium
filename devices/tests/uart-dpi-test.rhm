#lang rhombus
// Checks the PTY UART model's externally consumed DPI ABI and parameter bounds.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open
  "../uart-dpi.rhdl" as uart_dpi
  "uart-dpi-fixture.rhdl" as fixture

def design = fixture.design
def top = design.modules.find(fun (module_def): module_def.name == "UartDPI")
def uart_import = design.dpi_imports.find(
  fun (dpi): dpi.name == "uart_pty_tick"
)
def uart_register = top.operations.find(
  fun (operation): operation.opcode == "sim.dpi_register"
)

check:
  top.inputs.map(fun (port): port.name) ~is ["clock", "reset", "uart_tx"]
  top.outputs.map(fun (port): port.name) ~is ["uart_rx"]
  uart_import.input_names ~is [
    "model_id",
    "reset",
    "uart_to_pty_valid",
    "uart_to_pty_byte",
    "uart_to_pty_framing_error",
    "pty_to_uart_ready"
  ]
  uart_import.results.map(fun (result): result.name) ~is [
    "pty_to_uart_valid", "pty_to_uart_byte", "status"
  ]
  uart_register.results.length() ~is 3
  uart_dpi.UartDPI(-1, 1) ~throws "Int.in"
  uart_dpi.UartDPI(0x100000000, 1) ~throws "Int.in"
  uart_dpi.UartDPI(0, 0) ~throws "Int.in"
  uart_dpi.UartDPI(0, 0x10000) ~throws "Int.in"
