#lang rhombus
// Defines a program for the FIFO-equipped CHI UART behavioral fixture.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../chi/main.rhdl" as chi
  "../../../devices/uart/uart16550.rhdl" as uart

def program = elaborate(uart.Uart16550(uart.Uart16550Config(chi.CHIFlitParams(), 16))
)
export program
