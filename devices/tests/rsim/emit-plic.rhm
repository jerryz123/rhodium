import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../chi/main.rhdl" as chi
  "../../../devices/interrupt/plic.rhdl" as plic

def program = elaborate(plic.Plic(plic.PlicConfig(chi.CHIFlitParams(), 3, 2, 3))
)
export program
