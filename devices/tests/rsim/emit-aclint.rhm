#lang rhombus
// Defines a program for the two-hart ACLINT behavioral fixture.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../chi/main.rhdl" as chi
  "../../../devices/interrupt/aclint.rhdl" as aclint

def program = elaborate(aclint.Aclint(aclint.AclintConfig(chi.CHIFlitParams(), 2)))
export program
