#lang rhombus
// Defines the standalone boot-address register for CHI transaction simulation.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../chi/main.rhdl" as chi
  "../../../devices/boot/boot-address.rhdl" as boot

def program = elaborate(boot.CHIBootAddressRegister(boot.BootAddressConfig(chi.CHIFlitParams(), 0x1234567880000000))
)
export program
