#lang rhodium
// Elaborates the default multihart RISC-V image in a standalone CHI BootROM.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  lib("devices/boot/bootrom.rhdl") open
  lib("chi/protocol/params.rhdl").CHIFlitParams

def flit = CHIFlitParams()
def layout = CHIBootROMLayout(flit, ~window_bytes: 64)
def config = CHIBootROMConfig(layout)
def params = CHIBootROMParams("test-bootrom", 12, layout)
def design = compile_program(elaborate(CHIBootROM(config)), rtl_target).report.design

export:
  flit
  layout
  config
  params
  design
