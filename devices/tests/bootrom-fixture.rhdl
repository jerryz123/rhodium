#lang rhodium
// Elaborates the default multihart RISC-V image in a standalone CHI BootROM.

import:
  lib("devices/bootrom.rhdl") open
  lib("chi/params.rhdl").CHIFlitParams

def flit = CHIFlitParams()
def layout = CHIBootROMLayout(flit, ~window_bytes: 64)
def config = CHIBootROMConfig(layout)
def params = CHIBootROMParams("test-bootrom", 12, layout)
def design = elaborate(CHIBootROM(config))

export:
  flit
  layout
  config
  params
  design
