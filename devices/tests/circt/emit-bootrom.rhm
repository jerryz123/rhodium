#lang rhombus
// Defines a program for the standalone multihart-aware CHI BootROM fixture.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  "../../../chi/main.rhdl" as chi
  "../../../devices/boot/bootrom.rhdl" as bootrom

def program = elaborate(bootrom.CHIBootROM(
    bootrom.CHIBootROMConfig(
      bootrom.CHIBootROMLayout(chi.CHIFlitParams(), ~window_bytes: 64)
    )
  )
)
export program
