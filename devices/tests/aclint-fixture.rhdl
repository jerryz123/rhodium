#lang rhodium
// Elaborates a two-hart ACLINT fixture for host and backend verification.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/compile/rtl.rhm").rtl_target
  lib("devices/interrupt/aclint.rhdl") open
  lib("chi/protocol/params.rhdl").CHIFlitParams

def flit = CHIFlitParams()
def config = AclintConfig(flit, 2)
def params = AclintParams("test-aclint", 9, config)
def design = compile_program(elaborate(Aclint(config)), rtl_target).report.design

export:
  flit
  config
  params
  design
