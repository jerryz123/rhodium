#lang rhodium
// Elaborates a two-hart ACLINT fixture for host and backend verification.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("devices/aclint.rhdl") open
  lib("chi/protocol/params.rhdl").CHIFlitParams

def flit = CHIFlitParams()
def config = AclintConfig(flit, 2)
def params = AclintParams("test-aclint", 9, config, 0x02000000)
def design = elaborate(Aclint(config))

export:
  flit
  config
  params
  design
