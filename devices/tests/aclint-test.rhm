#lang rhombus
// Checks ACLINT host configuration, CHI service metadata, and parameter rejection.

import:
  "../../rhodium/std/interconnect.rhdl".AddressSet
  "../../chi/protocol/params.rhdl".CHIFlitParams
  "../../chi/protocol/flits.rhdl".CHIReqOpcode
  "../../chi/protocol/link.rhdl".CHINodeKind
  "../aclint.rhdl" as aclint

def flit = CHIFlitParams()
def config = aclint.AclintConfig(flit, 2)
def params = aclint.AclintParams("test-aclint", 9, config, 0x02000000)

check:
  config.hart_count ~is 2
  config.data_bytes ~is 16
  params.node.kind ~is CHINodeKind.SNI
  params.service.address_sets[0] ~is AddressSet(0x02000000, 0xffff)
  params.service.supports(CHIReqOpcode.ReadNoSnp, 8) ~is #true
  params.service.supports(CHIReqOpcode.WriteNoSnpPtl, 8) ~is #true
  params.service.supports(CHIReqOpcode.ReadNoSnp, 16) ~is #false
