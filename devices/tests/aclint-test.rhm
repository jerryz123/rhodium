#lang rhombus
// Checks ACLINT host configuration, CHI service metadata, and parameter rejection.

import:
  "../../chi/main.rhdl" as chi
  "../aclint.rhdl" as aclint

def flit = chi.CHIFlitParams()
def config = aclint.AclintConfig(flit, 2)
def params = aclint.AclintParams("test-aclint", 9, config, 0x02000000)

check:
  config.hart_count ~is 2
  config.data_bytes ~is 16
  params.node.kind ~is chi.CHINodeKind.SNI
  params.service.address_sets[0] ~is chi.AddressSet(0x02000000, 0xffff)
  params.service.supports(chi.CHIReqOpcode.ReadNoSnp, 8) ~is #true
  params.service.supports(chi.CHIReqOpcode.WriteNoSnpPtl, 8) ~is #true
  params.service.supports(chi.CHIReqOpcode.ReadNoSnp, 16) ~is #false
