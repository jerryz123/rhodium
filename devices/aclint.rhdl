#lang rhodium
// Implements a CHI SN-I ACLINT with MTIMER/MSWI state and sparse time updates.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("support/annotations.rhm").NonemptyString
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/interconnect.rhdl") open
  lib("rhodium/std/ready-valid.rhdl") open
  lib("chi/protocol/params.rhdl").CHIFlitParams
  lib("chi/protocol/flits.rhdl") open
  lib("chi/protocol/link.rhdl") open
  lib("chi/protocol/channels.rhdl").CHISNChannels
  lib("chi/protocol/fabric.rhdl") open
  lib("chi/subordinate/single-beat-subordinate.rhdl").CHISingleBeatSubordinate

def AclintAddressWidth = 16
def AclintWindowBytes = 0x10000
def AclintMswiOffset = 0x0000
def AclintMtimecmpOffset = 0x4000
def AclintMtimeOffset = 0xbff8
def AclintMaximumHarts = 4095

class AclintConfig(flit :: CHIFlitParams,
                   hart_count :: Int.in(1 ..= AclintMaximumHarts)):
  implements StableCircuitParam

  property data_bytes: flit.data_bytes
  property transfers: TransferSizes(1, 8)
  property requests:
    [CHIRequestSupport(CHIReqOpcode.ReadNoSnp, transfers),
     CHIRequestSupport(CHIReqOpcode.WriteNoSnpFull, transfers),
     CHIRequestSupport(CHIReqOpcode.WriteNoSnpPtl, transfers)]

class AclintParams(name :: NonemptyString,
                   node_id :: Nat,
                   config :: AclintConfig,
                   base_address :: Nat):

  property node:
    CHINodeParams(
      name,
      node_id,
      CHINodeKind.SNI,
      ~emits: CHIChannelCapabilities(
        ~rsp: [CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp],
        ~dat: [CHIDatOpcode.CompData]
      ),
      ~supports: CHIChannelCapabilities(
        ~req: [CHIReqOpcode.ReadNoSnp,
               CHIReqOpcode.WriteNoSnpFull,
               CHIReqOpcode.WriteNoSnpPtl],
        ~dat: [CHIDatOpcode.NonCopyBackWriteData]
      ),
      ~max_outstanding: 1
    )
  property icn_port: node.icn_peer()
  property service:
    CHISubordinateServiceParams(
      icn_port,
      [AddressSet(base_address, AclintWindowBytes - 1)],
      config.requests
    )

  constructor (name :: NonemptyString,
               node_id :: Nat,
               config :: AclintConfig,
               base_address :: Nat):
    unless base_address mod AclintWindowBytes == 0
    | error(~who: #'AclintParams,
            "base address must be aligned to the ACLINT window size")
    unless bits.length((base_address + AclintWindowBytes) - 1) <= config.flit.request_address_width
    | error(~who: #'AclintParams,
            "ACLINT window must fit in the CHI request address width")
    unless bits.length(node_id) <= config.flit.node_id_width
    | error(~who: #'AclintParams,
            "NodeID must fit in the physical NodeID width")
    super(name, node_id, config, base_address)

bundle AclintIdentity(p :: CHIFlitParams):
  node_id: Bits(p.node_id_width)
  base_address: Bits(p.request_address_width)

sync_circuit Aclint(config :: AclintConfig):
  def p = config.flit
  def hart_count = config.hart_count
  def data_bytes = p.data_bytes
  def lane_width = alignment_bits(data_bytes)
  def hart_index_width = index_width(hart_count)
  def initial_mtimecmp = vec(
    for List (_index in 0..hart_count): !bits(0, 64)
  )

  input identity: AclintIdentity(p)
  input tick: Bool
  interface port(CHISNChannels(p), ~role: node)
  interface time_update(Valid(Bits(64)), ~role: producer)
  output time_counter: Bits(64)
  output machine_software: Vec(hart_count, Bool)
  output machine_timer: Vec(hart_count, Bool)

  inst transaction(CHISingleBeatSubordinate(p, "aclint"))
  port <=> transaction.port
  transaction.node_id <== identity.node_id
  def request = transaction.request
  reg mtime(~init: bits(0, 64))
  reg mtimecmp(Vec(hart_count, Bits(64)), ~init: initial_mtimecmp)
  reg msip(Vec(hart_count, Bool), ~init: vec(
    for List (_index in 0..hart_count): Bool(#false)
  ))

  def incoming = port.req.bits
  def incoming_opcode :: CHIReqOpcode = incoming.opcode
  def incoming_write = incoming_opcode.is_initial_write()
  def incoming_relative_full :: Bits(p.request_address_width) = incoming.address - identity.base_address
  def incoming_in_window = (incoming.address >= identity.base_address) & !incoming_relative_full[AclintAddressWidth..p.request_address_width].or_reduce()
  def incoming_supported = incoming_opcode.supports_initial_transaction() & incoming_in_window & (
    incoming.size_or_num_req[0..3] <= bits(3, 3)
  ) & (
    incoming.tgt_id === identity.node_id
  )
  transaction.request_supported <== incoming_supported
  def request_fire = transaction.request_fire
  def incoming_relative :: Bits(AclintAddressWidth) = incoming_relative_full[0..AclintAddressWidth]
  def request_relative_full :: Bits(p.request_address_width) = request.address - identity.base_address
  def request_relative :: Bits(AclintAddressWidth) = request_relative_full[0..AclintAddressWidth]
  def active_address :: Bits(AclintAddressWidth) = mux(request_fire & !incoming_write,
                                                       incoming_relative,
                                                       request_relative)

  def bus_lane = active_address[0..lane_width]
  def mswi_raw_index :: Bits(12) = active_address[2..14]
  def mswi_index :: Bits(hart_index_width) = active_address[2..(2 + hart_index_width)]
  def mtimecmp_relative :: Bits(AclintAddressWidth) = active_address - bits(AclintMtimecmpOffset, AclintAddressWidth)
  def mtimecmp_index :: Bits(hart_index_width) = mtimecmp_relative[3..(3 + hart_index_width)]
  def mswi_access = (active_address < bits(AclintMtimecmpOffset, AclintAddressWidth)) & (
    mswi_raw_index < bits(hart_count, 12)
  )
  def mtimecmp_access = (active_address >= bits(AclintMtimecmpOffset, AclintAddressWidth)) & (
    active_address < bits(AclintMtimecmpOffset + (hart_count * 8), AclintAddressWidth)
  )
  def mtime_access = (active_address >= bits(AclintMtimeOffset, AclintAddressWidth)) & (
    active_address < bits(AclintMtimeOffset + 8, AclintAddressWidth)
  )
  def timer_register_offset:
    if lane_width == 3 | active_address[0..3] | active_address[0..3].zext(lane_width)
  def register_offset = mux(mswi_access,
                            active_address[0..2].zext(lane_width),
                            timer_register_offset)
  def register_lane = bus_lane - register_offset
  def register_shift = (register_lane ++ bits(0, 3))
  def register_data :: Bits(p.data_width) = port.dat.request.bits.data >> register_shift
  def register_mask :: Bits(data_bytes) = port.dat.request.bits.byte_enable >> register_lane
  def write_value = register_data[0..64]
  def write_mask = register_mask[0..8].expand_mask(8)
  def selected_value = mux(
    mswi_access,
    msip[mswi_index].as_bits().zext(64),
    mux(mtimecmp_access, mtimecmp[mtimecmp_index], mux(mtime_access, mtime, bits(0, 64)))
  )
  def widened_selected_value:
    if data_bytes == 8 | selected_value | selected_value.zext(p.data_width)
  def register_read_data = widened_selected_value << register_shift

  transaction.write_supported <== Bool(#true)
  transaction.write_ready <== Bool(#true)
  def write_data_fire = transaction.write_data_fire
  // The update stream carries the state that becomes visible after this edge,
  // allowing sparse consumers to capture the new timer value without polling.
  def mtime_write = write_data_fire & mtime_access
  def written_mtime = mtime.masked_merge(write_value, write_mask)
  def incremented_mtime = mtime + bits(1, 64)

  transaction.read_data <== register_read_data

  when mtime_write:
    mtime <== written_mtime
  elsewhen tick:
    mtime <== incremented_mtime
  when (write_data_fire & mtimecmp_access):
    mtimecmp[mtimecmp_index] <== mtimecmp[mtimecmp_index].masked_merge(write_value, write_mask)
  when (write_data_fire & mswi_access & register_mask[0].into(Bool)):
    msip[mswi_index] <== register_data[0].into(Bool)

  time_counter <== mtime
  time_update.valid <== mtime_write ||| tick
  time_update.bits <== mux(mtime_write, written_mtime, incremented_mtime)
  machine_software <== msip
  machine_timer <== vec(
    for List (index in 0..hart_count): mtime >= mtimecmp[index]
  )


export:
  AclintAddressWidth
  AclintWindowBytes
  AclintMswiOffset
  AclintMtimecmpOffset
  AclintMtimeOffset
  AclintMaximumHarts
  AclintConfig
  AclintParams
  AclintIdentity
  Aclint
