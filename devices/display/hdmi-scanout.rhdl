#lang rhodium
/* Buffers framebuffer rows in synchronous SRAM and emits fixed-cadence RGB video. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/ready-valid.rhdl") open
  lib("rhodium/std/sync-ram.rhdl").SyncRam1RW
  lib("chi/protocol/flits.rhdl").CHIRespErr
  lib("chi/protocol/channels.rhdl").CHIRNIChannels
  "hdmi.rhdl" open

/* Carries RGB888 and raster sync/data-enable signals aligned with pixel_valid. */
bundle HDMIVideo():
  rgb: Bits(24)
  hsync: Bool
  vsync: Bool
  data_enable: Bool

/* Buffers complete rows in rotating single-port SRAM banks and aligns pixels with read latency.
   Timing advances only on pixel_enable. A missing row or bad line blacks the rest of
   the frame; restart requires the source to discard the old frame before supplying new lines. */
sync_circuit HDMIPixelScanout(mode :: HDMIFixedFramebufferMode, ~rows: rows :: Int.in(2 ..) = 2):
  def t = mode.timing
  def bank_width = index_width(rows)
  def word_width = index_width(mode.fetch_lines_per_row)
  def x_width = index_width(t.horizontal_total)
  def y_width = index_width(t.vertical_total)
  input enable: Bool
  input pixel_enable: Bool
  interface line(Irrevocable(HDMIFrameReaderLine()), ~role: consumer)
  output restart: Bool
  output pixel_valid: Bool
  output video: HDMIVideo()
  output underflow: Bool
  output fetch_failed: Bool

  reg x(~init: Bits(x_width)(0))
  reg y(~init: Bits(y_width)(t.vertical_active))

  /* Frame validity and row ownership outlive individual pixel enables. */

  reg armed(~init: Bool(#false))
  reg dropped(~init: Bool(#true))
  reg starvation(~init: Bool(#false))
  reg failure(~init: Bool(#false))
  reg full(Vec(rows, Bool), ~init: vec(for List (_ in 0..rows): Bool(#false)))
  reg fill_bank(~init: Bits(bank_width)(0))
  reg read_bank(~init: Bits(bank_width)(0))
  reg fill_word(~init: Bits(word_width)(0))
  reg fill_row(~init: Bits(index_width(t.vertical_active))(0))
  reg frame_filled(~init: Bool(#false))

  /* These controls retain the bank, lane, and video timing of one SRAM read. */

  reg sample_bank(~init: Bits(bank_width)(0))
  reg sample_lane(~init: Bits(4)(0))
  reg sample_show(~init: Bool(#false))
  reg sample_valid(~init: Bool(#false))
  reg sample_de(~init: Bool(#false))
  reg sample_hs(~init: Bool(!t.horizontal_sync_positive))
  reg sample_vs(~init: Bool(!t.vertical_sync_positive))


  /* Admission and raster events
     Accepted lines fill free banks; only visible pixels consume a full bank.
     Restart discards the old frame before another line can be accepted. */

  def active_pixel = (x < Bits(x_width)(t.horizontal_active)) & (y < Bits(y_width)(t.vertical_active))
  def row_last = x === Bits(x_width)(t.horizontal_active - 1)
  def line_last = x === Bits(x_width)(t.horizontal_total - 1)
  restart <== enable & pixel_enable & (x === Bits(x_width)(0)) & (y === Bits(y_width)(t.vertical_active))
  def missing = enable & armed & !dropped & pixel_enable & active_pixel & !full[read_bank]
  line.ready <== enable & armed & !restart & (dropped ||| (!frame_filled & !full[fill_bank]))
  def accepts = line.fire()
  def bad_line = accepts & ((line.bits.error =/= CHIRespErr.OK) ||| line.bits.poisoned)
  def writes = accepts & !dropped
  def reads = enable & armed & !dropped & !bad_line & pixel_enable & active_pixel & full[read_bank]
  def releases = reads & row_last
  def last_word = fill_word === Bits(word_width)(mode.fetch_lines_per_row - 1)
  def last_row = fill_row === Bits(index_width(t.vertical_active))(t.vertical_active - 1)

  when writes:
    assert(line.bits.row_end === last_word, "hdmi_scanout_row_marker")
    assert(line.bits.frame_end === (last_word & last_row), "hdmi_scanout_frame_marker")


  /* Synchronous row banks
     The last fill word transfers ownership to scanout. Releasing the last
     pixel frees the bank after its read edge; reads and writes never overlap. */

  def bank_words = for List (bank in 0..rows):
    inst storage(SyncRam1RW(mode.fetch_lines_per_row, Bits(512), 1))
    def writing = writes & (fill_bank === Bits(bank_width)(bank))
    def reading = reads & (read_bank === Bits(bank_width)(bank))
    storage.port.request.valid <== writing ||| reading
    storage.port.request.bits.write <== writing
    storage.port.request.bits.address <== mux(writing, fill_word, x[4..(4 + word_width)])
    storage.port.request.bits.data <== vec([line.bits.data])
    storage.port.request.bits.mask <== Bits(1)(1).into(Mask(1))
    when (restart ||| !enable):
      full[bank] <== Bool(#false)
    elsewhen (releases & (read_bank === Bits(bank_width)(bank))):
      full[bank] <== Bool(#false)
    elsewhen (writing & last_word):
      full[bank] <== Bool(#true)

    when (writing):
      assert(!reading, "hdmi_scanout_bank_ownership")

    storage.port.response.bits[0]


  /* Raster advance
     Pixel-enable gaps hold both coordinates, independently of CHI filling. */

  when pixel_enable:
    x <== wrap_increment(x, t.horizontal_total)
    when line_last:
      y <== wrap_increment(y, t.vertical_total)


  /* Frame recovery and sticky status
     Disable clears errors; vertical-blank restart rearms pixels. A missing
     row or bad accepted line blacks the remainder of the current frame. */

  when (!enable):
    armed <== Bool(#false)
    dropped <== Bool(#true)
    starvation <== Bool(#false)
    failure <== Bool(#false)
  elsewhen restart:
    armed <== Bool(#true)
    dropped <== Bool(#false)
  elsewhen (missing ||| bad_line):
    dropped <== Bool(#true)
    starvation <== starvation ||| missing
    failure <== failure ||| bad_line


  /* Fill and scan cursors
     Restart wins over both paths. Otherwise fill and release can advance
     independently on the same edge, without borrowing bank capacity early. */

  when restart:
    fill_bank <== Bits(bank_width)(0)
    read_bank <== Bits(bank_width)(0)
    fill_word <== Bits(word_width)(0)
    fill_row <== Bits(index_width(t.vertical_active))(0)
    frame_filled <== Bool(#false)
  otherwise:
    when writes:
      fill_word <== wrap_increment(fill_word, mode.fetch_lines_per_row)
      when last_word:
        fill_bank <== wrap_increment(fill_bank, rows)
        fill_row <== fill_row + Bits(index_width(t.vertical_active))(1)
        frame_filled <== last_row

    when releases:
      read_bank <== wrap_increment(read_bank, rows)


  /* Pixel return alignment
     SRAM data and registered bank/lane/timing describe the same launch edge.
     Unmatched bank encodings select zero. */

  def horizontal_sync_start = t.horizontal_active + t.horizontal_front_porch
  def horizontal_sync_end = horizontal_sync_start + t.horizontal_sync
  def vertical_sync_start = t.vertical_active + t.vertical_front_porch
  def vertical_sync_end = vertical_sync_start + t.vertical_sync
  def horizontal_sync_active = (x >= Bits(x_width)(horizontal_sync_start)) & (x < Bits(x_width)(horizontal_sync_end))
  def vertical_sync_active = (y >= Bits(y_width)(vertical_sync_start)) & (y < Bits(y_width)(vertical_sync_end))
  sample_valid <== pixel_enable
  when pixel_enable:
    sample_bank <== read_bank
    sample_lane <== x[0..4]
    sample_show <== reads
    sample_de <== active_pixel
    sample_hs <== horizontal_sync_active === Bool(t.horizontal_sync_positive)
    sample_vs <== vertical_sync_active === Bool(t.vertical_sync_positive)

  def returned = mux_lookup(sample_bank, ~default: Bits(512)(0), for List (bank in 0..rows): [bank, bank_words[bank]])
  def pixel = returned.as_vec(Bits(32))[sample_lane]
  video <== HDMIVideo():
    rgb: mux(sample_show, pixel[0..24], Bits(24)(0))
    hsync: sample_hs
    vsync: sample_vs
    data_enable: sample_de

  pixel_valid <== sample_valid
  underflow <== starvation
  fetch_failed <== failure

/* Restarts the CHI frame reader at enabled vertical blanking and feeds the row-buffered scanout.
   The command is sampled at restart; old CHI responses drain without becoming new-frame
   pixels, while scanout failure status remains sticky until disable or reset. */
sync_circuit HDMIScanout(config :: HDMIFrameReaderConfig, ~rows: rows :: Int.in(2 ..) = 2):
  input identity: HDMIFrameReaderIdentity(config.flit)
  input framebuffer: HDMIFrameReaderCommand(config.flit)
  input enable: Bool
  input pixel_enable: Bool
  interface chi(CHIRNIChannels(config.flit), ~role: node)
  output pixel_valid: Bool
  output video: HDMIVideo()
  output underflow: Bool
  output fetch_failed: Bool
  inst reader(HDMIFrameReader(config))
  inst scanout(HDMIPixelScanout(config.mode, ~rows: rows))
  reader.identity <== identity
  reader.chi <=> chi
  reader.command.valid <== scanout.restart
  reader.command.bits <== framebuffer
  reader.line <=> scanout.line
  scanout.enable <== enable
  scanout.pixel_enable <== pixel_enable
  pixel_valid <== scanout.pixel_valid
  video <== scanout.video
  underflow <== scanout.underflow
  fetch_failed <== scanout.fetch_failed

export:
  HDMIVideo
  HDMIPixelScanout
  HDMIScanout
