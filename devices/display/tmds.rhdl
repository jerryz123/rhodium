#lang rhodium
/* Encodes DVI-compatible video into parallel TMDS symbols with per-channel disparity. */
// SPDX-License-Identifier: Apache-2.0

/* Carries parallel ten-bit blue, green, and red TMDS lane symbols for external serialization. */
bundle TMDSSymbols():
  blue: Bits(10)
  green: Bits(10)
  red: Bits(10)

/* Encodes one accepted byte using DVI 1.0 section 3.2.2 transition minimization and disparity.
   Valid advances registered symbols; blanking emits control and resets disparity, while
   invalid cycles hold both. Symbol bit zero is serialized first (section 3.2.3). */
sync_circuit TMDSChannelEncoder():
  input valid: Bool
  input data: Bits(8)
  input data_enable: Bool
  input control: Bits(2)
  output symbol_valid: Bool
  output symbol: Bits(10)

  reg disparity(~init: SInt(6)(0))
  reg encoded(~init: Bits(10)(0b1101010100))
  reg encoded_valid(~init: Bool(#false))


  /* Transition minimization.
     The ordered XOR/XNOR recurrence determines each bit from its predecessor. */

  def ones = popcount(data)
  def input_bits = data.as_vec(Bool)
  def use_xnor = (ones > Bits(4)(4)) ||| ((ones === Bits(4)(4)) & !input_bits[0])
  def mutable previous :: Bool = input_bits[0]
  def mutable transitions = [previous]
  for (index in 1..8):
    previous := previous ^ input_bits[index] ^ use_xnor
    transitions := transitions ++ [previous]

  def minimized :: Bits(8) = vec(transitions).as_bits()
  def xor_mode = !use_xnor


  /* Active-symbol disparity control.
     The retained balance chooses inversion; flag bits contribute +2, zero, or -2. */

  def minimized_count :: Bits(4) = popcount(minimized)
  def minimized_ones = minimized_count.zext(6).into(SInt(6))
  def balance = minimized_ones + minimized_ones - SInt(6)(8)
  def neutral = (disparity === SInt(6)(0)) ||| (balance === SInt(6)(0))
  def same_sign = ((disparity > SInt(6)(0)) & (balance > SInt(6)(0))) ||| ((disparity < SInt(6)(0)) & (balance < SInt(6)(0)))
  def invert = mux(neutral, !xor_mode, same_sign)
  def payload = mux(invert, !minimized, minimized)
  def active_symbol = invert ++ xor_mode ++ payload
  def positive_flags = invert & xor_mode
  def negative_flags = !invert & !xor_mode
  def flag_balance = priority_mux(~default: SInt(6)(0)):
    positive_flags: SInt(6)(2)
    negative_flags: SInt(6)(-2)

  def next_disparity = disparity + mux(invert, -balance, balance) + flag_balance


  /* Blanking control symbols.
     HS/VS select a fixed symbol instead of the active pixel's minimized payload. */

  def control_symbol = mux_lookup(control, ~default: Bits(10)(0b1101010100)):
    0: Bits(10)(0b1101010100)
    1: Bits(10)(0b0010101011)
    2: Bits(10)(0b0101010100)
    3: Bits(10)(0b1010101011)


  /* Registered output and running disparity.
     Invalid cycles hold both; accepted blanking resets disparity for the next active byte. */

  encoded_valid <== valid
  when valid:
    encoded <== mux(data_enable, active_symbol, control_symbol)
    disparity <== mux(data_enable, next_disparity, SInt(6)(0))

  symbol_valid <== encoded_valid
  symbol <== encoded

/* Registers three independently balanced TMDS lanes from one RGB888 video sample.
   Blanking places HS/VS on blue and control 00 on green/red; adds one clock of latency. */
sync_circuit TMDSVideoEncoder():
  input pixel_valid: Bool
  input rgb: Bits(24)
  input hsync: Bool
  input vsync: Bool
  input data_enable: Bool
  output symbol_valid: Bool
  output symbols: TMDSSymbols()

  inst blue(TMDSChannelEncoder())
  inst green(TMDSChannelEncoder())
  inst red(TMDSChannelEncoder())
  blue.valid <== pixel_valid
  green.valid <== pixel_valid
  red.valid <== pixel_valid
  blue.data <== rgb[0..8]
  green.data <== rgb[8..16]
  red.data <== rgb[16..24]
  blue.data_enable <== data_enable
  green.data_enable <== data_enable
  red.data_enable <== data_enable
  blue.control <== vsync ++ hsync
  green.control <== Bits(2)(0)
  red.control <== Bits(2)(0)
  symbols <== TMDSSymbols():
    blue: blue.symbol
    green: green.symbol
    red: red.symbol

  symbol_valid <== blue.symbol_valid

export:
  TMDSSymbols
  TMDSChannelEncoder
  TMDSVideoEncoder
