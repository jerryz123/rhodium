#lang rhodium
/* Implements a configurable SiFive-compatible level-sensitive PLIC as a CHI SN-I device. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("support/annotations.rhm").NonemptyString
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/interconnect.rhdl") open
  lib("rhodium/std/ready-valid.rhdl") open
  lib("rhodium/std/reduction.rhdl").tree_reduce
  lib("chi/protocol/params.rhdl").CHIFlitParams
  lib("chi/protocol/flits.rhdl") open
  lib("chi/protocol/link.rhdl") open
  lib("chi/protocol/channels.rhdl").CHISNChannels
  lib("chi/protocol/fabric.rhdl") open
  lib("chi/subordinate/single-beat-subordinate.rhdl").CHISingleBeatSubordinate

def PlicAddressWidth = 26
def PlicWindowBytes = 0x04000000
def PlicPriorityOffset = 0x000000
def PlicPendingOffset = 0x001000
def PlicEnableOffset = 0x002000
def PlicEnableContextBytes = 0x80
def PlicContextOffset = 0x200000
def PlicContextBytes = 0x1000
def PlicMaximumSources = 1023
def PlicMaximumContexts = 15872

/* Selects source/context counts, WARL priority width, and CHI wire format. */
class PlicConfig(flit :: CHIFlitParams,
                 source_count :: Int.in(1 ..= PlicMaximumSources),
                 context_count :: Int.in(1 ..= PlicMaximumContexts),
                 priority_width :: Int.in(1 ..= 31)):
  implements StableCircuitParam

  /* Returns the physical CHI DAT byte-lane count. */
  property data_bytes: flit.data_bytes
  /* Advertises only four-byte register accesses. */
  property transfers: TransferSizes(4, 4)
  /* Advertises reads and full or partial noncopyback writes. */
  property requests:
    [CHIRequestSupport(CHIReqOpcode.ReadNoSnp, transfers),
     CHIRequestSupport(CHIReqOpcode.WriteNoSnpFull, transfers),
     CHIRequestSupport(CHIReqOpcode.WriteNoSnpPtl, transfers)]

/* Describes a PLIC occurrence's identity and aligned 64-MiB register window. */
class PlicParams(name :: NonemptyString,
                 node_id :: Nat,
                 config :: PlicConfig,
                 base_address :: Nat):

  /* Advertises one outstanding SN-I register transaction and its completion channels. */
  property node:
    CHINodeParams(
      name,
      node_id,
      CHINodeKind.SNI,
      ~emits: CHIChannelCapabilities(
        ~rsp: [CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp],
        ~dat: [CHIDatOpcode.CompData]
      ),
      ~supports: CHIChannelCapabilities(
        ~req: [CHIReqOpcode.ReadNoSnp,
               CHIReqOpcode.WriteNoSnpFull,
               CHIReqOpcode.WriteNoSnpPtl],
        ~dat: [CHIDatOpcode.NonCopyBackWriteData]
      ),
      ~max_outstanding: 1
    )
  /* Derives the fabric-facing counterpart of the PLIC node. */
  property icn_port: node.icn_peer()
  /* Maps the PLIC window to its four-byte register service. */
  property service:
    CHISubordinateServiceParams(
      icn_port,
      [AddressSet(base_address, PlicWindowBytes - 1)],
      config.requests
    )

  /* Checks service-window alignment, address-width fit, and physical NodeID fit. */
  constructor (name :: NonemptyString,
               node_id :: Nat,
               config :: PlicConfig,
               base_address :: Nat):
    unless base_address mod PlicWindowBytes == 0
    | error(~who: #'PlicParams,
            "base address must be aligned to the PLIC window size")
    unless bits.length((base_address + PlicWindowBytes) - 1) <= config.flit.request_address_width
    | error(~who: #'PlicParams,
            "PLIC window must fit in the CHI request address width")
    unless bits.length(node_id) <= config.flit.node_id_width
    | error(~who: #'PlicParams,
            "NodeID must fit in the physical NodeID width")
    super(name, node_id, config, base_address)

/* Carries the occurrence's NodeID and register-window base. */
bundle PlicIdentity(p :: CHIFlitParams):
  node_id: Bits(p.node_id_width)
  base_address: Bits(p.request_address_width)

/* Carries eligibility, priority, and architectural source ID through winner reduction. */
bundle PlicCandidate(priority_width :: PosInt, source_id_width :: PosInt):
  valid: Bool
  priority: Bits(priority_width)
  source_id: Bits(source_id_width)

/* Tracks global pending/busy gateways and per-context enables and thresholds.
   Claims clear pending at REQ acceptance without consulting threshold; valid enabled
   completions release gateways at DAT acceptance, allowing a still-high level to re-pend. */
sync_circuit Plic(config :: PlicConfig):
  def p = config.flit
  def source_count = config.source_count
  def context_count = config.context_count
  def priority_width = config.priority_width
  def source_index_width = index_width(source_count)
  def source_id_width = index_width(source_count + 1)
  def context_index_width = index_width(context_count)
  def data_bytes = p.data_bytes
  def lane_width = alignment_bits(data_bytes)
  def initial_priorities = vec(for List (_source in 0..source_count): Bits(priority_width)(0))
  def initial_enables = vec(for List (_context in 0..context_count): Mask(source_count)(0))
  def initial_thresholds = vec(for List (_context in 0..context_count): Bits(priority_width)(0))

  input identity: PlicIdentity(p)
  input sources: Vec(source_count, Bool)
  interface port(CHISNChannels(p), ~role: node)
  output context_interrupts: Vec(context_count, Bool)


  /* CHI owner and architectural interrupt state.
     Pending bits and gateway-busy bits have distinct claim/completion lifetimes. */

  inst transaction(CHISingleBeatSubordinate(p, "plic"))
  port <=> transaction.port
  transaction.node_id <== identity.node_id
  def request = transaction.request
  reg priorities(Vec(source_count, Bits(priority_width)), ~init: initial_priorities)
  reg pending(Mask(source_count), ~init: Mask(source_count)(0))
  reg gateway_busy(Mask(source_count), ~init: Mask(source_count)(0))
  reg enables(Vec(context_count, Mask(source_count)), ~init: initial_enables)
  reg thresholds(Vec(context_count, Bits(priority_width)), ~init: initial_thresholds)


  /* Request validation and register-region decode.
     Reads select the incoming REQ; writes retain that address until DAT acceptance. */

  def incoming = port.req.bits
  def incoming_opcode :: CHIReqOpcode = incoming.opcode
  def incoming_write = incoming_opcode.is_initial_write()
  def incoming_relative_full :: Bits(p.request_address_width) = incoming.address - identity.base_address
  def incoming_in_window = (incoming.address >= identity.base_address) & !incoming_relative_full[PlicAddressWidth..p.request_address_width].or_reduce()
  def incoming_opcode_supported = incoming_opcode.is_one_of(CHIReqOpcode.ReadNoSnp, CHIReqOpcode.WriteNoSnpFull, CHIReqOpcode.WriteNoSnpPtl)
  def incoming_word_access = (incoming.size_or_num_req === Bits(6)(2)) & incoming.address.is_aligned(4)
  def incoming_targets_device = incoming.tgt_id === identity.node_id
  def incoming_supported = incoming_opcode_supported & incoming_in_window & incoming_word_access & incoming_targets_device
  transaction.request_supported <== incoming_supported
  def request_fire = transaction.request_fire
  def accepted_read = request_fire & !incoming_write
  def incoming_relative :: Bits(PlicAddressWidth) = incoming_relative_full[0..PlicAddressWidth]
  def request_relative_full :: Bits(p.request_address_width) = request.address - identity.base_address
  def request_relative :: Bits(PlicAddressWidth) = request_relative_full[0..PlicAddressWidth]
  def active_address :: Bits(PlicAddressWidth) = mux(accepted_read, incoming_relative, request_relative)

  def priority_source_id :: Bits(10) = active_address[2..12]
  def priority_index :: Bits(source_index_width) = (
    priority_source_id - Bits(10)(1)
  )[0..source_index_width]
  def priority_access = (active_address < Bits(PlicAddressWidth)(PlicPendingOffset)) & (
    priority_source_id > Bits(10)(0)
  ) & (priority_source_id <= Bits(10)(source_count))
  def pending_relative = active_address - Bits(PlicAddressWidth)(PlicPendingOffset)
  def pending_word :: Bits(5) = pending_relative[2..7]
  def pending_access = (active_address >= Bits(PlicAddressWidth)(PlicPendingOffset)) & (
    active_address < Bits(PlicAddressWidth)(PlicPendingOffset + 0x80)
  )
  def enable_relative = active_address - Bits(PlicAddressWidth)(PlicEnableOffset)
  def enable_context_raw :: Bits(14) = enable_relative[7..21]
  def enable_context :: Bits(context_index_width) = enable_context_raw[0..context_index_width]
  def enable_word :: Bits(5) = enable_relative[2..7]
  def enable_access = (active_address >= Bits(PlicAddressWidth)(PlicEnableOffset)) & (
    active_address < Bits(PlicAddressWidth)(PlicContextOffset)
  ) & (enable_context_raw < Bits(14)(context_count))
  def context_relative = active_address - Bits(PlicAddressWidth)(PlicContextOffset)
  def context_raw :: Bits(14) = context_relative[12..26]
  def active_context :: Bits(context_index_width) = context_raw[0..context_index_width]
  def context_register_offset :: Bits(12) = context_relative[0..12]
  def context_access = (active_address >= Bits(PlicAddressWidth)(PlicContextOffset)) & (
    context_raw < Bits(14)(context_count)
  )
  def threshold_access = context_access & (context_register_offset === Bits(12)(0))
  def claim_access = context_access & (context_register_offset === Bits(12)(4))


  /* Per-context winner reduction and interrupt delivery.
     Threshold gates interrupt delivery, never claim eligibility. */

  /* Chooses an eligible candidate by higher priority, then lower source ID. */
  fun prefer_candidate(left :: PlicCandidate(priority_width, source_id_width),
                       right :: PlicCandidate(priority_width, source_id_width)):
    def higher_priority = right.priority > left.priority
    def lower_id_tie = (right.priority === left.priority) & (right.source_id < left.source_id)
    def right_wins = right.valid & (!left.valid ||| higher_priority ||| lower_id_tie)
    mux(right_wins, right, left)

  def pending_bits = pending.as_bits()
  def winners = vec(
    for List (context in 0..context_count):
      def context_enables :: Mask(source_count) = enables[context]
      tree_reduce(
        for List (source in 0..source_count):
          def priority = priorities[source]
          PlicCandidate(priority_width, source_id_width):
            valid: pending[source] & context_enables[source] & (
              priority =/= Bits(priority_width)(0)
            )
            priority: priority
            source_id: Bits(source_id_width)(source + 1),
        prefer_candidate
      )
  )
  def selected_winner = winners[active_context]
  context_interrupts <== vec(for List (context in 0..context_count): winners[context].valid & (winners[context].priority > thresholds[context]))


  /* Read snapshots and physical byte lanes.
     Source zero stays reserved in software-visible pending and enable words. */

  def pending_word_value = (
    (pending_bits.zext(source_count + 32) << 1) >> (pending_word ++ Bits(5)(0))
  )[0..32]
  def selected_enable_bits = enables[enable_context].as_bits()
  def enable_word_value = (
    (selected_enable_bits.zext(source_count + 32) << 1) >> (enable_word ++ Bits(5)(0))
  )[0..32]
  def priority_value = priorities[priority_index].zext(32)
  def threshold_value = thresholds[active_context].zext(32)
  def claim_value = mux(selected_winner.valid, selected_winner.source_id.zext(32), Bits(32)(0))
  def selected_value = priority_mux(~default: Bits(32)(0)):
    priority_access: priority_value
    pending_access: pending_word_value
    enable_access: enable_word_value
    threshold_access: threshold_value
    claim_access: claim_value

  def register_lane = active_address[0..lane_width]
  def register_shift = register_lane ++ Bits(3)(0)
  def register_data :: Bits(p.data_width) = port.dat.request.bits.data >> register_shift
  def register_mask :: Bits(data_bytes) = port.dat.request.bits.byte_enable >> register_lane
  def write_value = register_data[0..32]
  def register_read_data = selected_value.zext(p.data_width) << register_shift

  def incoming_data = port.dat.request.bits
  def ordinary_data = incoming_data.opcode =/= CHIDatOpcode.DataLCrdReturn
  def write_mask_supported = register_mask === Bits(data_bytes)(0xf)
  // The full-register mask rule is assertion-only, not a write-admission gate.
  transaction.write_supported <== Bool(#true)
  transaction.write_ready <== Bool(#true)
  def write_data_fire = transaction.write_data_fire


  /* Claim and completion events.
     Claims snapshot the old winner and clear pending at REQ acceptance;
     enabled, in-range completions release gateways at DAT acceptance. */

  def claim_fire = accepted_read & claim_access
  def completion_source_id = write_value
  def completion_source_index :: Bits(source_index_width) = (
    completion_source_id - Bits(32)(1)
  )[0..source_index_width]
  def completion_source_valid = (completion_source_id > Bits(32)(0)) & (
    completion_source_id <= Bits(32)(source_count)
  )
  def active_enables :: Mask(source_count) = enables[active_context]
  def completion_enabled = active_enables[completion_source_index]
  def completion_fire = write_data_fire & claim_access & completion_source_valid & completion_enabled


  /* Independent pending and gateway updates.
     Claim does not release a gateway; a still-high completed source can re-pend on a later edge. */

  def forwarded_sources = vec(for List (source in 0..source_count): !gateway_busy[source] & sources[source])
  def next_pending = vec(
    for List (source in 0..source_count):
      def forwarded = forwarded_sources[source]
      def claimed = claim_fire & selected_winner.valid & (
        selected_winner.source_id === Bits(source_id_width)(source + 1)
      )
      (pending[source] ||| forwarded) & !claimed
  ).into(Mask(source_count))
  // Claim leaves the gateway busy. Completion frees it; a still-high source
  // can forward again on a later edge, independently of the claim context.
  def next_gateway_busy = vec(
    for List (source in 0..source_count):
      def forwarded = forwarded_sources[source]
      def completed = completion_fire & (completion_source_id === Bits(32)(source + 1))
      (gateway_busy[source] ||| forwarded) & !completed
  ).into(Mask(source_count))
  def next_enable = vec(
    for List (source in 0..source_count):
      def source_id = source + 1
      mux(enable_word === Bits(5)(source_id div 32),
          write_value[source_id mod 32].into(Bool),
          selected_enable_bits[source].into(Bool))
  ).into(Mask(source_count))


  /* Architectural state commit and assertion-only byte-mask checks. */

  transaction.read_data <== register_read_data

  pending <== next_pending
  gateway_busy <== next_gateway_busy
  when (write_data_fire & priority_access):
    priorities[priority_index] <== write_value[0..priority_width]
  when (write_data_fire & enable_access):
    enables[enable_context] <== next_enable
  when (write_data_fire & threshold_access):
    thresholds[active_context] <== write_value[0..priority_width]

  when (port.dat.request.valid & ordinary_data):
    assert(write_mask_supported, "plic_write_mask_supported")

export:
  PlicAddressWidth
  PlicWindowBytes
  PlicPriorityOffset
  PlicPendingOffset
  PlicEnableOffset
  PlicEnableContextBytes
  PlicContextOffset
  PlicContextBytes
  PlicMaximumSources
  PlicMaximumContexts
  PlicConfig
  PlicParams
  PlicIdentity
  PlicCandidate
  Plic
