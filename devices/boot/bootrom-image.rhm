#lang rhombus
// Builds validated immutable BootROM images and the default multihart RISC-V reset program.
// SPDX-License-Identifier: Apache-2.0

import:
  "../interrupt/aclint-layout.rhm".AclintBase
  rhombus.bits.(<<) as <<
  rhombus.bits.(>>) as >>
  lib("riscv/model/main.rhm") open
  lib("riscv/isa/integer-common.rhm") open
  lib("riscv/isa/rv64i.rhm").LD
  lib("riscv/isa/rv32i.rhm").SLLI
  lib("riscv/isa/privileged.rhm").WFI
  lib("riscv/isa/zicsr.rhm") open

def RiscvBootROMResetAddress = 0x00010000
def RiscvBootROMPayloadAddress = 0x80000000
def RiscvMhHartIdCSR = 0xf14
def RiscvMstatusCSR = 0x300
def RiscvMieCSR = 0x304
def RiscvMachineSoftwareInterruptMask = 1 << 3

class BootROMImage(bytes :: NonemptyList.of(Nat)):
  constructor (bytes :: NonemptyList.of(Nat)):
    for (byte in bytes):
      unless byte < 0x100
      | error(~who: #'BootROMImage, "image elements must be bytes")
    super(bytes)

  property size_bytes :: PosInt:
    bytes.length()

  method padded_bytes(window_bytes :: PosInt):
    unless size_bytes <= window_bytes
    | error(~who: #'padded_bytes, "image must fit in the BootROM window")
    bytes ++ for List (_index in size_bytes..window_bytes): 0

fun instruction_words_to_bytes(words :: NonemptyList.of(Nat)):
  def mutable bytes = []
  for (word in words):
    for (byte_index in 0..4):
      bytes := bytes ++ [bits.field(word, byte_index * 8, (byte_index + 1) * 8)]
  bytes

// The generated reset program is equivalent to this simple assembly:
//
//   // Immediate mode:
//   csrr  a0, mhartid
//   bnez  a0, park
//   auipc a1, device_tree_upper
//   addi  a1, a1, device_tree_lower
//   auipc t0, payload_upper
//   jalr  zero, payload_lower(t0)
//   // Indirect mode instead lets every hart sleep on its own ACLINT MSIP:
//   csrr  a0, mhartid
//   li    t2, MIP_MSIP
//   csrc  mstatus, t2
//   csrs  mie, t2
//   ... compute t0 = AclintBase + 4 * mhartid
//   ... compute t3 = boot_address_register
// wait:
//   wfi
//   li    t4, 1
//   slli  t4, t4, 31
//   blt   t4, zero, rv32            // bit 31 is the sign bit only on RV32
//   ld    t1, 0(t3)
//   j     loaded
// rv32:
//   lw    t1, 0(t3)
// loaded:
//   beqz  t1, wait                  // tolerate spurious WFI wakeups
//   sw    zero, 0(t0)
//   csrc  mie, t2
//   ... compute a1 = device_tree_address
//   jalr  zero, 0(t1)
// park:
//   wfi
//   j     park
fun riscv_bootrom_image(reset_address :: Nat = RiscvBootROMResetAddress,
                        payload_address :: Nat = RiscvBootROMPayloadAddress,
                        ~device_tree_address: device_tree_address :: Nat = 0,
                        ~boot_address_register: boot_address_register :: maybe(Nat) = #false):
  unless reset_address mod 4 == 0
  | error(~who: #'riscv_bootrom_image, "reset address must be four-byte aligned")
  unless !boot_address_register || boot_address_register mod 8 == 0
  | error(~who: #'riscv_bootrom_image, "boot-address register must be eight-byte aligned")
  unless payload_address mod 4 == 0
  | error(~who: #'riscv_bootrom_image, "payload address must be four-byte aligned")
  unless device_tree_address mod 8 == 0
  | error(~who: #'riscv_bootrom_image, "device-tree address must be eight-byte aligned")

  fun pc_relative_immediates(instruction_address :: Nat,
                             target_address :: Nat,
                             target_name :: String):
    def delta = target_address - instruction_address
    def upper = (delta + 0x800) >> 12
    unless upper >= -(1 << 19) && upper < (1 << 19)
    | error(~who: #'riscv_bootrom_image,
            target_name ++ " is outside the AUIPC PC-relative range")
    [upper << 12, delta - (upper << 12)]

  def mutable words = [CSRRS.encode([
    rd.constrain(10),
    rs1.constrain(0),
    immediate12.constrain(RiscvMhHartIdCSR)
  ])]

  if !boot_address_register
  | // The immediate image keeps the traditional hart-zero-only trampoline.
    words := words ++ [BNE.encode([rs1.constrain(10), rs2.constrain(0)], ~immediate: 20)]
    def device_tree_immediates = pc_relative_immediates(reset_address + 8, device_tree_address, "device tree")
    words := words ++ [AUIPC.encode([rd.constrain(11)], ~immediate: device_tree_immediates[0]),
                       ADDI.encode([rd.constrain(11), rs1.constrain(11)], ~immediate: device_tree_immediates[1])]
    def payload_immediates = pc_relative_immediates(reset_address + (words.length() * 4), payload_address, "payload")
    words := words ++ [AUIPC.encode([rd.constrain(5)], ~immediate: payload_immediates[0]),
                       JALR.encode([rd.constrain(0), rs1.constrain(5)], ~immediate: payload_immediates[1]),
                       WFI.encode([]),
                       JAL.encode([rd.constrain(0)], ~immediate: -4)]
  | block:
      // Clear global interrupt delivery before enabling MSIP as a WFI wake
      // source. The pending interrupt wakes the core without entering a trap.
      words := words ++ [
        ADDI.encode([rd.constrain(7), rs1.constrain(0)], ~immediate: RiscvMachineSoftwareInterruptMask),
        CSRRC.encode([rd.constrain(0), rs1.constrain(7), immediate12.constrain(RiscvMstatusCSR)]),
        CSRRS.encode([rd.constrain(0), rs1.constrain(7), immediate12.constrain(RiscvMieCSR)])
      ]
      def interrupt_immediates = pc_relative_immediates(
        reset_address + (words.length() * 4),
        AclintBase,
        "software-interrupt base"
      )
      words := words ++ [
        AUIPC.encode([rd.constrain(5)], ~immediate: interrupt_immediates[0]),
        ADDI.encode([rd.constrain(5), rs1.constrain(5)], ~immediate: interrupt_immediates[1]),
        ADD.encode([rd.constrain(28), rs1.constrain(10), rs2.constrain(10)]),
        ADD.encode([rd.constrain(28), rs1.constrain(28), rs2.constrain(28)]),
        ADD.encode([rd.constrain(5), rs1.constrain(5), rs2.constrain(28)])
      ]
      def boot_immediates = pc_relative_immediates(
        reset_address + (words.length() * 4),
        boot_address_register,
        "boot-address register"
      )
      words := words ++ [AUIPC.encode([rd.constrain(28)], ~immediate: boot_immediates[0])]
      def wait_index = words.length()
      // The RV32 shift encoding is also valid on RV64. Select the load at
      // runtime without requiring misa or taking an illegal-instruction trap.
      words := words ++ [
        WFI.encode([]),
        ADDI.encode([rd.constrain(29), rs1.constrain(0)], ~immediate: 1),
        SLLI.encode([rd.constrain(29), rs1.constrain(29)], ~immediate: 31),
        BLT.encode([rs1.constrain(29), rs2.constrain(0)], ~immediate: 12),
        LD.encode([rd.constrain(6), rs1.constrain(28)], ~immediate: boot_immediates[1]),
        JAL.encode([rd.constrain(0)], ~immediate: 8),
        LW.encode([rd.constrain(6), rs1.constrain(28)], ~immediate: boot_immediates[1]),
        BEQ.encode([rs1.constrain(6), rs2.constrain(0)], ~immediate: (wait_index - (words.length() + 7)) * 4),
        SW.encode([rs1.constrain(5), rs2.constrain(0)], ~immediate: 0),
        CSRRC.encode([rd.constrain(0), rs1.constrain(7), immediate12.constrain(RiscvMieCSR)])
      ]
      def device_tree_immediates = pc_relative_immediates(
        reset_address + (words.length() * 4),
        device_tree_address,
        "device tree"
      )
      words := words ++ [
        AUIPC.encode([rd.constrain(11)], ~immediate: device_tree_immediates[0]),
        ADDI.encode([rd.constrain(11), rs1.constrain(11)], ~immediate: device_tree_immediates[1]),
        JALR.encode([rd.constrain(0), rs1.constrain(6)], ~immediate: 0)
      ]
  BootROMImage(instruction_words_to_bytes(words))

def DefaultRiscvBootROMImage = riscv_bootrom_image()

export:
  RiscvBootROMResetAddress
  RiscvBootROMPayloadAddress
  RiscvMhHartIdCSR
  BootROMImage
  riscv_bootrom_image
  DefaultRiscvBootROMImage
