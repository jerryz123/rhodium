#lang rhombus
// Builds validated immutable BootROM images and the default multihart RISC-V reset program.

import:
  rhombus.bits.(<<) as <<
  rhombus.bits.(>>) as >>
  lib("riscv/model/main.rhm") open
  lib("riscv/isa/integer-common.rhm") open
  lib("riscv/isa/rv64i.rhm").LD
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/privileged.rhm").WFI
  lib("riscv/isa/zicsr.rhm").CSRRS

def RiscvBootROMResetAddress = 0x00010000
def RiscvBootROMPayloadAddress = 0x80000000
def RiscvMhHartIdCSR = 0xf14

class BootROMImage(bytes :: NonemptyList.of(Nat)):
  constructor (bytes :: NonemptyList.of(Nat)):
    for (byte in bytes):
      unless byte < 0x100
      | error(~who: #'BootROMImage, "image elements must be bytes")
    super(bytes)

  property size_bytes :: PosInt:
    bytes.length()

  method padded_bytes(window_bytes :: PosInt):
    unless size_bytes <= window_bytes
    | error(~who: #'padded_bytes, "image must fit in the BootROM window")
    bytes ++ for List (_index in size_bytes..window_bytes): 0

fun instruction_words_to_bytes(words :: NonemptyList.of(Nat)):
  def mutable bytes = []
  for (word in words):
    for (byte_index in 0..4):
      bytes := bytes ++ [bits.field(word, byte_index * 8, (byte_index + 1) * 8)]
  bytes

// The generated reset program is equivalent to this simple assembly:
//
//   csrr  a0, mhartid
//   bnez  a0, park
//   auipc a1, device_tree_upper
//   addi  a1, a1, device_tree_lower
//   // Immediate mode:
//   auipc t0, payload_upper
//   jalr  zero, payload_lower(t0)
//   // Indirect mode replaces those two instructions with:
//   auipc t0, boot_address_register_upper
//   ld    t0, boot_address_register_lower(t0)  // lw for RV32
//   jalr  zero, 0(t0)
// park:
//   wfi
//   j     park
fun riscv_bootrom_image(reset_address :: Nat = RiscvBootROMResetAddress,
                        payload_address :: Nat = RiscvBootROMPayloadAddress,
                        ~device_tree_address: device_tree_address :: Nat = 0,
                        ~boot_address_register: boot_address_register :: False || Nat = #false,
                        ~xlen: xlen :: XLen = XLen.X64):
  unless reset_address mod 4 == 0
  | error(~who: #'riscv_bootrom_image, "reset address must be four-byte aligned")
  unless boot_address_register == #false || boot_address_register mod 8 == 0
  | error(~who: #'riscv_bootrom_image, "boot-address register must be eight-byte aligned")
  unless payload_address mod 4 == 0
  | error(~who: #'riscv_bootrom_image, "payload address must be four-byte aligned")
  unless device_tree_address mod 8 == 0
  | error(~who: #'riscv_bootrom_image, "device-tree address must be eight-byte aligned")

  fun pc_relative_immediates(instruction_address :: Nat,
                             target_address :: Nat,
                             target_name :: String):
    def delta = target_address - instruction_address
    def upper = (delta + 0x800) >> 12
    unless upper >= -(1 << 19) && upper < (1 << 19)
    | error(~who: #'riscv_bootrom_image,
            target_name ++ " is outside the AUIPC PC-relative range")
    [upper << 12, delta - (upper << 12)]

  // a0 receives mhartid. Nonzero harts branch over the primary-hart
  // trampoline and remain in the WFI loop at the end of the image.
  def mutable words = [
    CSRRS.encode([
      rd.constrain(10),
      rs1.constrain(0),
      immediate12.constrain(RiscvMhHartIdCSR)
    ]),
    BNE.encode([
      rs1.constrain(10),
      rs2.constrain(0)
    ], ~immediate: (if boot_address_register == #false | 20 | 24))
  ]

  def device_tree_immediates = pc_relative_immediates(
    reset_address + 8,
    device_tree_address,
    "device tree"
  )
  words := words ++ [AUIPC.encode([rd.constrain(11)], ~immediate: device_tree_immediates[0]),
                     ADDI.encode([
                       rd.constrain(11),
                       rs1.constrain(11)
                     ], ~immediate: device_tree_immediates[1])]

  def payload_immediates = pc_relative_immediates(
    reset_address + (words.length() * 4),
    (if boot_address_register == #false | payload_address | boot_address_register),
    (if boot_address_register == #false | "payload" | "boot-address register")
  )
  words := words ++ [AUIPC.encode([rd.constrain(5)], ~immediate: payload_immediates[0])]
  if boot_address_register == #false
  | words := words ++ [JALR.encode([rd.constrain(0), rs1.constrain(5)], ~immediate: payload_immediates[1])]
  | def load = (if xlen == XLen.X32 | LW | LD)
    words := words ++ [load.encode([rd.constrain(5), rs1.constrain(5)], ~immediate: payload_immediates[1]),
                       JALR.encode([rd.constrain(0), rs1.constrain(5)], ~immediate: 0)]

  words := words ++ [WFI.encode([]), JAL.encode([rd.constrain(0)], ~immediate: -4)]
  BootROMImage(instruction_words_to_bytes(words))

def DefaultRiscvBootROMImage = riscv_bootrom_image()

export:
  RiscvBootROMResetAddress
  RiscvBootROMPayloadAddress
  RiscvMhHartIdCSR
  BootROMImage
  riscv_bootrom_image
  DefaultRiscvBootROMImage
