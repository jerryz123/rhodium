#lang rhodium
/* Implements reusable fixed-format 8-N-1 UART transmit and receive engines. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/ready-valid.rhdl") open
  lib("rhodium/std/cdc.rhdl").SyncLevel

def UartOversampleCount = 16

/* Accepts one byte while idle and serializes start, eight LSB-first data bits, and stop.
   Each bit occupies sixteen oversample ticks; bytes are backpressured while active. */
sync_circuit Uart8N1Transmitter():
  input oversample_tick: Bool
  interface bytes(Decoupled(Bits(8)), ~role: consumer)
  output tx: Bits(1)
  output busy: Bool

  reg active(~init: Bool(#false))
  reg data(Bits(8))
  reg phase(~init: Bits(4)(0))
  reg subtick(~init: Bits(4)(0))


  /* Byte admission and serial output.
     Idle and stop drive high; an accepted byte supplies eight LSB-first data phases. */

  bytes.ready <== !active
  def accept = bytes.fire()
  def data_index = phase - Bits(4)(1)
  def serial_bit = priority_mux(~default: Bool(#true)):
    !active: Bool(#true)
    phase === Bits(4)(0): Bool(#false)
    (phase >= Bits(4)(1)) & (phase <= Bits(4)(8)): (data >> data_index)[0].into(Bool)

  tx <== serial_bit.as_bits()
  busy <== active


  /* Oversample timing and frame progress.
     Acceptance initializes all frame state; active cycles advance independent counters. */

  def phase_boundary = subtick === Bits(4)(UartOversampleCount - 1)
  def bit_complete = active & oversample_tick & phase_boundary
  def stop_complete = bit_complete & (phase === Bits(4)(9))
  when accept:
    active <== Bool(#true)
    data <== bytes.bits
    phase <== Bits(4)(0)
    subtick <== Bits(4)(0)
  otherwise:
    data <== data
    when stop_complete:
      active <== Bool(#false)
    when (bit_complete & (phase =/= Bits(4)(9))):
      phase <== phase + Bits(4)(1)
    when (active & oversample_tick):
      subtick <== mux(phase_boundary, Bits(4)(0), subtick + Bits(4)(1))

/* Separates idle/start validation, bit capture, stop checking, and recovery from a low stop. */
hardware_enum UartReceiverState:
  Idle
  Start
  Data
  Stop
  WaitIdle

/* Synchronizes RX, validates the start midpoint, and samples eight LSB-first data bits.
   Emits an unbackpressured byte and framing-error indication at stop sampling;
   a bad stop waits for idle high before another frame. */
sync_circuit Uart8N1Receiver():
  input oversample_tick: Bool
  input rx: Bits(1)
  interface received(Valid(Bits(8)), ~role: producer)
  output framing_error: Bool
  output busy: Bool

  inst synchronizer(SyncLevel())
  synchronizer.level <== rx
  def serial_bit = synchronizer.synchronized.into(Bool)

  reg state(~init: UartReceiverState.Idle)
  reg data(Bits(8))
  reg bit_index(~init: Bits(3)(0))
  reg subtick(~init: Bits(4)(0))

  def midpoint = subtick === Bits(4)((UartOversampleCount / 2) - 1)
  def boundary = subtick === Bits(4)(UartOversampleCount - 1)
  def complete = (state === UartReceiverState.Stop) & oversample_tick & boundary
  def data_mask = Bits(8)(1) << bit_index

  received.valid <== complete
  received.bits <== data
  framing_error <== complete & !serial_bit
  busy <== state =/= UartReceiverState.Idle

  def detect_start = (state === UartReceiverState.Idle) & !serial_bit
  def validate_start = (state === UartReceiverState.Start) & oversample_tick & midpoint
  def sample_data = (state === UartReceiverState.Data) & oversample_tick & boundary
  def sample_stop = (state === UartReceiverState.Stop) & oversample_tick & boundary
  def wait_for_idle = state === UartReceiverState.WaitIdle
  def timing_active = (state === UartReceiverState.Start) ||| (
    state === UartReceiverState.Data
  ) ||| (state === UartReceiverState.Stop)

  when detect_start:
    state <== UartReceiverState.Start
  elsewhen (validate_start & serial_bit):
    state <== UartReceiverState.Idle
  elsewhen (validate_start & !serial_bit):
    state <== UartReceiverState.Data
  elsewhen (sample_data & (bit_index === Bits(3)(7))):
    state <== UartReceiverState.Stop
  elsewhen (sample_stop & serial_bit):
    state <== UartReceiverState.Idle
  elsewhen (sample_stop & !serial_bit):
    state <== UartReceiverState.WaitIdle
  elsewhen (wait_for_idle & serial_bit):
    state <== UartReceiverState.Idle

  when detect_start:
    subtick <== Bits(4)(0)
  elsewhen (oversample_tick & timing_active):
    subtick <== mux(
      validate_start ||| sample_data ||| sample_stop,
      Bits(4)(0),
      subtick + Bits(4)(1)
    )

  when (validate_start & !serial_bit):
    bit_index <== Bits(3)(0)
  elsewhen (sample_data & (bit_index =/= Bits(3)(7))):
    bit_index <== bit_index + Bits(3)(1)

  when sample_data:
    data <== mux(serial_bit, data ||| data_mask, data & !data_mask)

export:
  UartOversampleCount
  Uart8N1Transmitter
  UartReceiverState
  Uart8N1Receiver
