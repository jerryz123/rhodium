#lang rhodium
// Implements a configurable immutable CHI SN-I BootROM with native cache-line reads.

import:
  lib("support/annotations.rhm").NonemptyString
  lib("rhodium/std/bits.rhdl") open
  lib("rhodium/std/ready-valid.rhdl").fire
  lib("chi/main.rhdl") open
  "bootrom-image.rhm" open

def CHIBootROMDefaultWindowBytes = 0x2000
def CHIBootROMMaximumTransferBytes = 64

class CHIBootROMLayout(flit :: CHIFlitParams,
                       window_bytes :: Pow2Int):
  implements StableCircuitParam

  property transfers: TransferSizes(1, CHIBootROMMaximumTransferBytes)
  property requests:
    [CHIRequestSupport(CHIReqOpcode.ReadNoSnp, transfers)]

  constructor (flit :: CHIFlitParams,
               ~window_bytes: window_bytes :: Pow2Int = CHIBootROMDefaultWindowBytes):
    unless window_bytes >= CHIBootROMMaximumTransferBytes
    | error(~who: #'CHIBootROMLayout,
            "window must contain at least one maximum-size transfer")
    super(flit, window_bytes)

class CHIBootROMConfig(layout :: CHIBootROMLayout,
                       image :: BootROMImage):
  implements StableCircuitParam

  property flit: layout.flit
  property window_bytes: layout.window_bytes

  constructor (layout :: CHIBootROMLayout,
               ~image: image :: BootROMImage = DefaultRiscvBootROMImage):
    unless image.size_bytes <= layout.window_bytes
    | error(~who: #'CHIBootROMConfig, "image must fit in the BootROM window")
    super(layout, image)

class CHIBootROMParams(name :: NonemptyString,
                       node_id :: Nat,
                       layout :: CHIBootROMLayout,
                       base_address :: Nat):

  property node:
    CHINodeParams(
      name,
      node_id,
      CHINodeKind.SNI,
      ~emits: CHIChannelCapabilities(~dat: [CHIDatOpcode.CompData]),
      ~supports: CHIChannelCapabilities(~req: [CHIReqOpcode.ReadNoSnp]),
      ~max_outstanding: 1
    )
  property icn_port: node.icn_peer()
  property service:
    CHISubordinateServiceParams(
      icn_port,
      [AddressSet(base_address, layout.window_bytes - 1)],
      layout.requests
    )

  constructor (name :: NonemptyString,
               node_id :: Nat,
               layout :: CHIBootROMLayout,
               ~base_address: base_address :: Nat = RiscvBootROMResetAddress):
    unless base_address mod layout.window_bytes == 0
    | error(~who: #'CHIBootROMParams,
            "base address must be aligned to the BootROM window")
    unless bits.length((base_address + layout.window_bytes) - 1) <= layout.flit.request_address_width
    | error(~who: #'CHIBootROMParams,
            "BootROM window must fit in the CHI request address width")
    unless bits.length(node_id) <= layout.flit.node_id_width
    | error(~who: #'CHIBootROMParams,
            "NodeID must fit in the physical NodeID width")
    super(name, node_id, layout, base_address)

bundle CHIBootROMIdentity(p :: CHIFlitParams):
  node_id: Bits(p.node_id_width)
  base_address: Bits(p.request_address_width)

sync_circuit CHIBootROM(config :: CHIBootROMConfig):
  def p = config.flit
  def window_bytes = config.window_bytes
  def window_address_width = alignment_bits(window_bytes)
  def image_bytes = config.image.padded_bytes(window_bytes)
  def contents = vec(image_bytes.map(fun (byte): bits(byte, 8)))

  input identity: CHIBootROMIdentity(p)
  interface port(CHISNChannels(p), ~role: node)

  reg active(~init: Bool(#false))
  reg request(CHIReqFlit(p))
  reg pending_data_ids(~init: bits(0, 4))

  def incoming = port.req.bits
  def incoming_opcode :: CHIReqOpcode = incoming.opcode
  def ordinary_request = incoming_opcode =/= CHIReqOpcode.ReqLCrdReturn
  def incoming_size = chi_req_size(p, incoming)
  def incoming_transfer_bytes = bits(1, p.request_address_width) << incoming_size.as_bits()
  def window_end = identity.base_address + bits(window_bytes, p.request_address_width)
  def transfer_end = incoming.address + incoming_transfer_bytes
  def incoming_address_supported = (incoming.address >= identity.base_address) & (
    transfer_end >= incoming.address
  ) & (transfer_end <= window_end)
  def incoming_alignment_cases = for List (encoded_size in 0..7):
    [encoded_size, incoming.address.is_aligned(1 << encoded_size)]
  def incoming_supported = (incoming_opcode === CHIReqOpcode.ReadNoSnp) & (
    incoming.size_or_num_req[3..6] === bits(0, 3)
  ) & chi_size_valid(incoming_size) & (
    incoming_size.as_bits() <= bits(alignment_bits(CHIBootROMMaximumTransferBytes), 3)
  ) & mux_lookup(
    incoming_size.as_bits(),
    ~default: Bool(#false),
    incoming_alignment_cases
  ) & incoming_address_supported & (incoming.tgt_id === identity.node_id)

  port.req.ready <== !ordinary_request ||| (!active & incoming_supported)
  def request_fire = port.req.fire() & ordinary_request

  def selected_data_id = priority_encoder(pending_data_ids.as_vec(Bool))
  def selected_data_id_mask = one_hot(selected_data_id).as_bits()
  def final_data = pending_data_ids === selected_data_id_mask
  def beat_address = chi_data_address(request.address, selected_data_id, p)
  def relative_beat_address :: Bits(p.request_address_width) = beat_address - identity.base_address
  def relative_index = relative_beat_address[0..window_address_width]
  def response_bytes = vec(
    for List (lane in 0..p.data_bytes):
      contents[relative_index + bits(lane, window_address_width)]
  )

  port.rsp.valid <== Bool(#false)
  port.rsp.bits <== literal(CHIRspFlit(p), 0)
  port.dat.response.valid <== active
  port.dat.response.bits <== chi_sn_read_completion(p,
                                                    identity.node_id,
                                                    request,
                                                    selected_data_id,
                                                    response_bytes.as_bits())
  def response_fire = port.dat.response.fire()

  def incoming_data_opcode :: CHIDatOpcode = port.dat.request.bits.opcode
  def ordinary_data = incoming_data_opcode =/= CHIDatOpcode.DataLCrdReturn
  port.dat.request.ready <== !ordinary_data

  when request_fire:
    active <== Bool(#true)
    request <== incoming
    pending_data_ids <== chi_transfer_data_ids(incoming.address, incoming_size, p)
  elsewhen response_fire:
    active <== !final_data
    pending_data_ids <== pending_data_ids & !selected_data_id_mask

  when (port.req.valid & ordinary_request):
    assert(incoming_supported, "chi_bootrom_request_supported")
  when (port.dat.request.valid & ordinary_data):
    assert(Bool(#false), "chi_bootrom_write_data_unsupported")

export:
  CHIBootROMDefaultWindowBytes
  CHIBootROMMaximumTransferBytes
  CHIBootROMLayout
  CHIBootROMConfig
  CHIBootROMParams
  CHIBootROMIdentity
  CHIBootROM
