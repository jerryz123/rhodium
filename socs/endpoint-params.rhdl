#lang rhodium
// Defines shared CHI endpoint descriptions for SoC hosts and their ICN peers.

import:
  lib("chi/main.rhdl") open

fun requester_icn_endpoint(node :: CHINodeParams) :: CHIICNPortParams:
  CHIICNPortParams(
    node.name ++ "-icn",
    node.node_id,
    node.kind,
    ~emits: node.supports,
    ~supports: node.emits,
    ~max_outstanding: node.max_outstanding
  )

fun soc_host_node(node_id :: Nat) :: CHINodeParams:
  CHINodeParams(
    "host",
    node_id,
    CHINodeKind.RNF,
    ~emits: CHIChannelCapabilities(
      ~req: [CHIReqOpcode.ReadClean, CHIReqOpcode.WriteUniquePtl, CHIReqOpcode.ReadNoSnp, CHIReqOpcode.WriteNoSnpPtl],
      ~rsp: [CHIRspOpcode.SnpResp],
      ~dat: [CHIDatOpcode.NonCopyBackWriteData]
    ),
    ~supports: CHIChannelCapabilities(
      ~rsp: [CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp],
      ~snp: chi_rnf_snoop_opcodes,
      ~dat: [CHIDatOpcode.CompData]
    ),
    ~max_outstanding: 1
  )

// Project complete host identity into the traffic accepted by each Home.
fun soc_host_home_port(node :: CHINodeParams, ~coherent: coherent :: Boolean):
  CHIRequesterHomeParams(
    requester_icn_endpoint(node),
    ~emits: CHIChannelCapabilities(
      ~rsp: [CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp],
      ~snp: (if coherent | chi_rnf_snoop_opcodes | []),
      ~dat: [CHIDatOpcode.CompData]),
    ~supports: CHIChannelCapabilities(
      ~req: (if coherent | [CHIReqOpcode.ReadClean, CHIReqOpcode.WriteUniquePtl] | [CHIReqOpcode.ReadNoSnp, CHIReqOpcode.WriteNoSnpPtl]),
      ~rsp: (if coherent | [CHIRspOpcode.SnpResp] | []),
      ~dat: [CHIDatOpcode.NonCopyBackWriteData]))

fun soc_host_memory_service(home :: CHIHomeParams,
                            address_sets :: NonemptyList.of(AddressSet),
                            requests :: NonemptyList.of(CHIRequestSupport)):
  CHIHomeServiceParams(
    home, address_sets,
    for List (request in requests.filter(~keep: fun (request): [CHIReqOpcode.ReadNoSnp, CHIReqOpcode.WriteNoSnpPtl].contains(request.opcode))):
      CHIRequestSupport((if request.opcode == CHIReqOpcode.ReadNoSnp | CHIReqOpcode.ReadClean | CHIReqOpcode.WriteUniquePtl), request.sizes))

export:
  soc_host_home_port
  soc_host_memory_service
  requester_icn_endpoint
  soc_host_node
