#lang rhombus
// Defines the default RV5Stage profiles and physical-address width shared by concrete SoCs and host generators.

import:
  "../cores/rv5stage/profile.rhm" open
  "../riscv/isa/c.rhm" open
  "../riscv/isa/fp-profile.rhm" open
  "../riscv/isa/xlen.rhm".XLen

def DefaultRhodiumSoCRequestAddressWidth = 44

def simple_soc_core_profile = RVCoreProfile(
  ~xlen: XLen.X64,
  ~extensions: RV5StageExtensions(
    ~floating_point: FloatingPointProfile.D,
    ~zicbop: #true,
    ~zicboz: #true,
    ~zawrs: #true, ~zihintpause: #true, ~zihintntl: #true,
    ~compressed: compressed_extensions(CompressedExtension.C, CompressedExtension.Zcmop)
  ),
  ~mmu_mode: RV5StageMmuMode.Sv39
)

def mini_soc_core_profile = RVCoreProfile(
  ~xlen: XLen.X64,
  ~extensions: RV5StageExtensions(~zicbop: #true, ~zicboz: #true, ~zawrs: #true, ~zihintpause: #true, ~zihintntl: #true),
  ~mmu_mode: RV5StageMmuMode.Sv39,
  ~cache_geometry: RV5StageCacheGeometry(
    ~instruction: RV5StageCacheConfig(32, 1),
    ~data: RV5StageCacheConfig(32, 1)
  )
)

def tiled_soc_core_profile = RVCoreProfile(
  ~xlen: XLen.X64,
  ~extensions: RV5StageExtensions(~zicbop: #true, ~zicboz: #true, ~zawrs: #true, ~zihintpause: #true, ~zihintntl: #true, ~compressed: compressed_extensions(CompressedExtension.C, CompressedExtension.Zcmop)),
  ~mmu_mode: RV5StageMmuMode.Sv39
)

export:
  DefaultRhodiumSoCRequestAddressWidth
  simple_soc_core_profile
  mini_soc_core_profile
  tiled_soc_core_profile
