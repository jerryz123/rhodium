#lang rhombus
// Defines the default RV5Stage profiles and physical-address width shared by concrete SoCs and host generators.
// SPDX-License-Identifier: Apache-2.0

import:
  "../cores/rv5stage/profile.rhm" open
  "../riscv/isa/c.rhm" open
  "../riscv/isa/fp-profile.rhm" open
  "../riscv/isa/vector-profile.rhm" open
  "../riscv/isa/xlen.rhm".XLen

def DefaultRhodiumSoCRequestAddressWidth = 44

def single_core_rv5stage_soc_core_profile = RV5StageConfig(
  ~xlen: XLen.X64,
  ~extensions: RV5StageExtensions(
    ~floating_point: FloatingPointProfile.D,
    ~half_precision: HalfPrecisionProfile.Zfh,
    ~zfa: #true,
    ~ziccif: #true, ~ziccamoa: #true, ~ziccrse: #true,
    ~zicbop: #true, ~zicbom: #true,
    ~zicboz: #true,
    ~ssnpm: #true, ~supm: #true,
    ~zawrs: #true, ~zihintpause: #true, ~zihintntl: #true,
    ~compressed: compressed_extensions(CompressedExtension.C, CompressedExtension.Zcb, CompressedExtension.Zcmop)
  ),
  ~mmu_mode: RV5StageMmuMode.Sv39,
  ~data_cache_service_queue_depth: 4,
  ~multiplier: RV5StageMultiplierKind.Pipelined,
  ~vector: VectorProfile.V,
  ~vector_extensions: vector_extensions(VectorExtension.Zvfh, VectorExtension.Zvbb),
  ~vector_length: 128,
  ~cache_geometry: RV5StageCacheGeometry(
    ~instruction: RV5StageCacheConfig(64, 4),
    ~data: RV5StageCacheConfig(64, 4)
  )
)

def mini_rv5stage_soc_core_profile = RV5StageConfig(
  ~xlen: XLen.X64,
  ~extensions: RV5StageExtensions(~ziccif: #true, ~ziccamoa: #true, ~ziccrse: #true, ~zicbop: #true, ~zicboz: #true, ~zawrs: #true, ~zihintpause: #true, ~zihintntl: #true),
  ~mmu_mode: RV5StageMmuMode.Sv39,
  ~data_cache_service_queue_depth: 1,
  ~multiplier: RV5StageMultiplierKind.Iterative,
  ~cache_geometry: RV5StageCacheGeometry(
    ~instruction: RV5StageCacheConfig(32, 1),
    ~data: RV5StageCacheConfig(32, 1)
  )
)

def tiled_rv5stage_soc_core_profile = RV5StageConfig(
  ~xlen: XLen.X64,
  ~extensions: RV5StageExtensions(~ziccif: #true, ~ziccamoa: #true, ~ziccrse: #true, ~zicbop: #true, ~zicboz: #true, ~zawrs: #true, ~zihintpause: #true, ~zihintntl: #true, ~compressed: compressed_extensions(CompressedExtension.C, CompressedExtension.Zcmop)),
  ~mmu_mode: RV5StageMmuMode.Sv39,
  ~data_cache_service_queue_depth: 4,
  ~multiplier: RV5StageMultiplierKind.Pipelined
)

export:
  DefaultRhodiumSoCRequestAddressWidth
  single_core_rv5stage_soc_core_profile
  mini_rv5stage_soc_core_profile
  tiled_rv5stage_soc_core_profile
