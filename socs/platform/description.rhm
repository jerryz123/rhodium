#lang rhombus
/* Defines immutable RISC-V SoC descriptions and their native device-tree projection. */
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus.bits.(<<) as <<
  lib("support/annotations.rhm").NonemptyString
  lib("devicetree/main.rhm") open
  lib("rhodium/frontend/foundation.rhm").StableCircuitParam
  lib("rhodium/std/interconnect.rhdl").AddressSet
  lib("riscv/isa/hart.rhm") open
  lib("riscv/isa/interrupt.rhm") open

/* Describes positive SoC-clock and architectural timebase frequencies with an integral hardware divider ratio. */
class SoCClockConfig(clock_frequency_hz :: PosInt,
                     timebase_frequency_hz :: PosInt):
  implements StableCircuitParam

  /* Rejects timebases above the input clock or requiring a nonintegral number of clock cycles. */
  constructor (~clock_frequency_hz: clock_frequency_hz :: PosInt,
               ~timebase_frequency_hz: timebase_frequency_hz :: PosInt):
    unless timebase_frequency_hz <= clock_frequency_hz
    | error(~who: #'SoCClockConfig,
            "timebase frequency must not exceed the SoC clock frequency")
    unless clock_frequency_hz mod timebase_frequency_hz == 0
    | error(~who: #'SoCClockConfig,
            "SoC clock frequency must be an integer multiple of the timebase frequency")
    super(clock_frequency_hz, timebase_frequency_hz)

  property timebase_period_cycles :: PosInt:
    clock_frequency_hz / timebase_frequency_hz

/* Retains the originating AddressSet while restricting architectural memory and device windows to contiguous regions. */
class SoCAddressRegion(address_set :: AddressSet):
  implements StableCircuitParam

  /* Rejects sparse address masks that cannot be described as one base-and-size architectural region. */
  constructor (address_set :: AddressSet):
    unless (address_set.mask bits.and (address_set.mask + 1)) == 0
    | error(~who: #'SoCAddressRegion,
            "architectural address regions must be contiguous")
    super(address_set)

  property base :: Nat: address_set.base
  property size_bytes :: PosInt: address_set.mask + 1

  /* Tests membership in the original address set. */
  method contains(address :: Nat) :: Boolean:
    address_set.contains(address)

  /* Tests intersection with another architectural region using their underlying address sets. */
  method overlaps(other :: SoCAddressRegion) :: Boolean:
    address_set.overlaps(other.address_set)

  /* Encodes the region's base and byte size as two big-endian 64-bit device-tree values. */
  method to_device_tree_cells():
    DeviceTreeCells([
      DeviceTreeU64(base),
      DeviceTreeU64(size_bytes)
    ])

/* Describes the BootROM region, reset vector, payload address, and optional host-published entry-register window. */
class RiscvBootLayout(rom :: SoCAddressRegion,
                      reset_address :: Nat,
                      payload_address :: Nat,
                      address_register :: maybe(SoCAddressRegion)):
  implements StableCircuitParam

  /* Requires the reset vector to lie inside the supplied ROM region. */
  constructor (~rom: rom :: SoCAddressRegion,
               ~reset_address: reset_address :: Nat,
               ~payload_address: payload_address :: Nat,
               ~address_register: address_register :: maybe(SoCAddressRegion) = #false):
    unless rom.contains(reset_address)
    | error(~who: #'RiscvBootLayout,
            "reset address must lie in the BootROM region")
    super(rom, reset_address, payload_address, address_register)

/* Associates the CLINT-compatible local interrupt and timer device with its architectural MMIO region. */
class RiscvAclintDescription(region :: SoCAddressRegion):
  implements StableCircuitParam

/* Identifies a PLIC interrupt by its controller's address region and nonzero source ID. */
class RiscvPlicInterrupt(controller :: SoCAddressRegion,
                         source_id :: PosInt):
  implements StableCircuitParam

/* Associates the UART register region with its PLIC source binding. */
class RiscvUartDescription(region :: SoCAddressRegion,
                           interrupt :: RiscvPlicInterrupt):
  implements StableCircuitParam

/* Names one implemented nonzero interrupt source; IDs may be sparse. */
class RiscvPlicSource(source_id :: PosInt,
                      name :: NonemptyString):
  implements StableCircuitParam

/* Identifies one hart's machine- or supervisor-external interrupt context. */
class RiscvPlicContext(hart :: Nat,
                       interrupt :: InterruptCause):
  implements StableCircuitParam

  /* Rejects causes other than machine-external or supervisor-external interrupts. */
  constructor (hart :: Nat,
               interrupt :: InterruptCause):
    unless interrupt == InterruptCause.MachineExternal || interrupt == InterruptCause.SupervisorExternal
    | error(~who: #'RiscvPlicContext,
            "PLIC contexts must target machine or supervisor external interrupts")
    super(hart, interrupt)

/* Describes the controller window, priority width, implemented sources, and ordered MMIO contexts. */
class RiscvPlicDescription(region :: SoCAddressRegion,
                           priority_width :: PosInt,
                           sources :: NonemptyList.of(RiscvPlicSource),
                           contexts :: NonemptyList.of(RiscvPlicContext)):
  implements StableCircuitParam

  /* Rejects duplicate source IDs and duplicate hart/cause pairs without changing context order. */
  constructor (region :: SoCAddressRegion,
               priority_width :: PosInt,
               sources :: NonemptyList.of(RiscvPlicSource),
               contexts :: NonemptyList.of(RiscvPlicContext)):
    for (source in sources):
      unless sources.filter(
        ~keep: fun (candidate): candidate.source_id == source.source_id
      ).length() == 1
      | error(~who: #'RiscvPlicDescription,
              "PLIC source IDs must be unique")
    for (context in contexts):
      unless contexts.filter(
        ~keep: fun (candidate): candidate.hart == context.hart && candidate.interrupt == context.interrupt
      ).length() == 1
      | error(~who: #'RiscvPlicDescription,
              "PLIC hart and interrupt context pairs must be unique")
    super(region, priority_width, sources, contexts)

  // IDs may be sparse; ndev describes the implemented ID range, not its usage.
  property source_count :: PosInt:
    def mutable count = 0
    for (source in sources):
      when source.source_id > count
      | count := source.source_id
    count

def RiscvMachineSoftwareInterrupt = 3
def RiscvMachineTimerInterrupt = 7

/* Formats an address as the lowercase hexadecimal suffix used in device-tree unit names. */
fun unit_address(address :: Nat) :: String:
  String.from_int(address, ~radix: 16)

/* Creates a deterministic label for a hart's local interrupt controller. */
fun cpu_interrupt_label(hart :: Nat):
  DeviceTreeLabel("cpu_intc_" ++ String.from_int(hart))

/* Creates a deterministic PLIC label from the controller's architectural base address. */
fun plic_interrupt_label(region :: SoCAddressRegion):
  DeviceTreeLabel("plic_" ++ unit_address(region.base))

/* Maps the supported translation mode to its device-tree binding string. */
fun mmu_type(mode :: RiscvMmuType):
  match mode
  | RiscvMmuType.Bare: "riscv,none"
  | RiscvMmuType.Sv39: "riscv,sv39"

/* Projects one hart's ISA, translation, cache geometry, clock, optional CBO size, and local interrupt controller into a CPU node. */
fun cpu_node(hart :: Nat,
             description :: RiscvHartDescription,
             clocks :: SoCClockConfig):
  def instruction_cache = description.instruction_cache
  def data_cache = description.data_cache
  def mutable cache_block_properties = []
  when description.isa_profile.isa_extensions.contains("zicboz")
  | block:
      unless description.cbo_block_bytes is_a PosInt
      | error(~who: #'cpu_node,
              "Zicboz requires a CBO block size")
      cache_block_properties := [DeviceTreeProperty("riscv,cboz-block-size", DeviceTreeU32(description.cbo_block_bytes))]
  DeviceTreeNode(
    "cpu@" ++ unit_address(hart),
    [DeviceTreeProperty("device_type", DeviceTreeString("cpu")),
     DeviceTreeProperty("reg", DeviceTreeU32(hart)),
     DeviceTreeProperty("status", DeviceTreeString("okay")),
     DeviceTreeProperty("compatible", DeviceTreeString("riscv")),
     DeviceTreeProperty("clock-frequency", DeviceTreeU32(clocks.clock_frequency_hz)),
     DeviceTreeProperty("riscv,isa-base", DeviceTreeString(description.isa_profile.isa_base)),
     DeviceTreeProperty("riscv,isa-extensions", DeviceTreeStringList(description.isa_profile.isa_extensions)),
     DeviceTreeProperty("mmu-type", DeviceTreeString(mmu_type(description.mmu_type))),
     DeviceTreeProperty("i-cache-block-size", DeviceTreeU32(instruction_cache.block_bytes)),
     DeviceTreeProperty("i-cache-sets", DeviceTreeU32(instruction_cache.sets)),
     DeviceTreeProperty("i-cache-size", DeviceTreeU32(instruction_cache.size_bytes)),
     DeviceTreeProperty("d-cache-block-size", DeviceTreeU32(data_cache.block_bytes)),
     DeviceTreeProperty("d-cache-sets", DeviceTreeU32(data_cache.sets)),
     DeviceTreeProperty("d-cache-size", DeviceTreeU32(data_cache.size_bytes))] ++ cache_block_properties,
    [DeviceTreeNode(
       "interrupt-controller",
       [DeviceTreeProperty("#interrupt-cells", DeviceTreeU32(1)),
        DeviceTreeProperty("interrupt-controller", DeviceTreeEmpty()),
        DeviceTreeProperty("compatible", DeviceTreeString("riscv,cpu-intc"))],
       [],
       ~label: cpu_interrupt_label(hart))]
  )

/* Builds the CPU container with the shared timebase frequency and one child per described hart. */
fun cpus_node(harts :: NonemptyList.of(Nat),
              description :: RiscvHartDescription,
              clocks :: SoCClockConfig):
  DeviceTreeNode(
    "cpus",
    [DeviceTreeProperty("#address-cells", DeviceTreeU32(1)),
     DeviceTreeProperty("#size-cells", DeviceTreeU32(0)),
     DeviceTreeProperty("timebase-frequency", DeviceTreeU32(clocks.timebase_frequency_hz))],
    for List (hart in harts): cpu_node(hart, description, clocks)
  )

/* Describes a contiguous architectural RAM region, independently of internal LLC ownership stripes. */
fun memory_node(region :: SoCAddressRegion):
  DeviceTreeNode(
    "memory@" ++ unit_address(region.base),
    [DeviceTreeProperty("device_type", DeviceTreeString("memory")),
     DeviceTreeProperty("reg", region.to_device_tree_cells())]
  )

/* Builds the CLINT-compatible device node and ordered software/timer interrupt references for each hart. */
fun aclint_node(aclint :: RiscvAclintDescription,
                harts :: NonemptyList.of(Nat)):
  def mutable interrupts = []
  for (hart in harts):
    def interrupt_controller = cpu_interrupt_label(hart)
    interrupts := interrupts ++ [
      DeviceTreePhandle(interrupt_controller),
      DeviceTreeU32(RiscvMachineSoftwareInterrupt),
      DeviceTreePhandle(interrupt_controller),
      DeviceTreeU32(RiscvMachineTimerInterrupt)
    ]
  DeviceTreeNode(
    "clint@" ++ unit_address(aclint.region.base),
    [DeviceTreeProperty("compatible", DeviceTreeString("riscv,clint0")),
     DeviceTreeProperty("reg", aclint.region.to_device_tree_cells()),
     DeviceTreeProperty("interrupts-extended", DeviceTreeCells(interrupts))]
  )

/* Builds the PLIC binding with its highest source ID and context-ordered hart interrupt references. */
fun plic_node(plic :: RiscvPlicDescription):
  def mutable interrupts = []
  // List position is the MMIO context index; never sort by hart or privilege.
  for (context in plic.contexts):
    interrupts := interrupts ++ [
      DeviceTreePhandle(cpu_interrupt_label(context.hart)),
      DeviceTreeU32(interrupt_code(context.interrupt))
    ]
  DeviceTreeNode(
    "interrupt-controller@" ++ unit_address(plic.region.base),
    [DeviceTreeProperty("compatible", DeviceTreeString("sifive,plic-1.0.0")),
     DeviceTreeProperty("reg", plic.region.to_device_tree_cells()),
     DeviceTreeProperty("#address-cells", DeviceTreeU32(0)),
     DeviceTreeProperty("#interrupt-cells", DeviceTreeU32(1)),
     DeviceTreeProperty("interrupt-controller", DeviceTreeEmpty()),
     DeviceTreeProperty("riscv,ndev", DeviceTreeU32(plic.source_count)),
     DeviceTreeProperty("interrupts-extended", DeviceTreeCells(interrupts))],
    [],
    ~label: plic_interrupt_label(plic.region)
  )

/* Builds the enabled byte-register ns16550a-compatible UART node with clock and PLIC interrupt binding. */
fun uart_node(uart :: RiscvUartDescription,
              clocks :: SoCClockConfig):
  DeviceTreeNode(
    "serial@" ++ unit_address(uart.region.base),
    [DeviceTreeProperty("compatible", DeviceTreeString("ns16550a")),
     DeviceTreeProperty("reg", uart.region.to_device_tree_cells()),
     DeviceTreeProperty("clock-frequency", DeviceTreeU32(clocks.clock_frequency_hz)),
     DeviceTreeProperty("reg-shift", DeviceTreeU32(0)),
     DeviceTreeProperty("reg-io-width", DeviceTreeU32(1)),
     DeviceTreeProperty("interrupt-parent", DeviceTreePhandle(plic_interrupt_label(uart.interrupt.controller))),
     DeviceTreeProperty("interrupts", DeviceTreeU32(uart.interrupt.source_id)),
     DeviceTreeProperty("status", DeviceTreeString("okay"))]
  )

/* Builds the identity-mapped peripheral bus with ACLINT and any described PLIC and UART devices. */
fun soc_node(harts :: NonemptyList.of(Nat),
             clocks :: SoCClockConfig,
             aclint :: RiscvAclintDescription,
             plic :: maybe(RiscvPlicDescription),
             uart :: maybe(RiscvUartDescription)):
  def mutable children = [aclint_node(aclint, harts)]
  when plic is_a RiscvPlicDescription
  | children := children ++ [plic_node(plic)]
  when uart is_a RiscvUartDescription
  | children := children ++ [uart_node(uart, clocks)]
  DeviceTreeNode(
    "soc",
    [DeviceTreeProperty("#address-cells", DeviceTreeU32(2)),
     DeviceTreeProperty("#size-cells", DeviceTreeU32(2)),
     DeviceTreeProperty("compatible", DeviceTreeString("simple-bus")),
     DeviceTreeProperty("ranges", DeviceTreeEmpty())],
    children
  )

/* Rejects duplicate compatibility strings using the caller's diagnostic identity. */
fun require_unique_strings(strings :: NonemptyList.of(NonemptyString), who :: Symbol):
  for (value in strings):
    unless strings.filter(~keep: fun (candidate): candidate == value).length() == 1
    | error(~who: who, "compatible strings must be unique")

/* Rejects duplicate hart IDs and IDs outside the selected hart's XLEN range. */
fun require_unique_harts(harts :: NonemptyList.of(Nat), description :: RiscvHartDescription):
  for (hart in harts):
    unless hart < (1 << description.xlen.width)
    | error(~who: #'RiscvSoCDescription, "hart ID must fit XLEN")
    unless harts.filter(~keep: fun (candidate): candidate == hart).length() == 1
    | error(~who: #'RiscvSoCDescription, "hart IDs must be unique")

/* Rejects any overlap between the architectural RAM, ROM, and device windows. */
fun require_disjoint_regions(regions :: NonemptyList.of(SoCAddressRegion)):
  for (left_index in 0..regions.length()):
    for (right_index in (left_index + 1)..regions.length()):
      when regions[left_index].overlaps(regions[right_index])
      | error(~who: #'RiscvSoCDescription,
              "architectural address regions must not overlap")

/* Collects one immutable software-visible system description shared by device-tree and boot-image generation. */
class RiscvSoCDescription(model :: NonemptyString,
                          compatible :: NonemptyList.of(NonemptyString),
                          harts :: NonemptyList.of(Nat),
                          hart :: RiscvHartDescription,
                          clocks :: SoCClockConfig,
                          memory_regions :: NonemptyList.of(SoCAddressRegion),
                          boot :: RiscvBootLayout,
                          aclint :: RiscvAclintDescription,
                          plic :: maybe(RiscvPlicDescription),
                          uart :: maybe(RiscvUartDescription)):
  implements StableCircuitParam

  /* Validates hart and compatibility identities, payload placement, device-map disjointness, and PLIC context/UART references. */
  constructor (~model: model :: NonemptyString,
               ~compatible: compatible :: NonemptyList.of(NonemptyString),
               ~harts: harts :: NonemptyList.of(Nat),
               ~hart: hart :: RiscvHartDescription,
               ~clocks: clocks :: SoCClockConfig,
               ~memory_regions: memory_regions :: NonemptyList.of(SoCAddressRegion),
               ~boot: boot :: RiscvBootLayout,
               ~aclint: aclint :: RiscvAclintDescription,
               ~plic: plic :: maybe(RiscvPlicDescription) = #false,
               ~uart: uart :: maybe(RiscvUartDescription) = #false):
    require_unique_strings(compatible, #'RiscvSoCDescription)
    require_unique_harts(harts, hart)
    unless for any (region in memory_regions): region.contains(boot.payload_address)
    | error(~who: #'RiscvSoCDescription,
            "boot payload address must lie in architectural memory")
    def mutable regions = memory_regions ++ [boot.rom, aclint.region]
    when boot.address_register is_a SoCAddressRegion
    | regions := regions ++ [boot.address_register]
    when plic is_a RiscvPlicDescription
    | for (context in plic.contexts):
        unless for any (hart in harts): hart == context.hart
        | error(~who: #'RiscvSoCDescription,
                "PLIC contexts must reference described harts")
      regions := regions ++ [plic.region]
    when uart is_a RiscvUartDescription
    | unless plic is_a RiscvPlicDescription
      | error(~who: #'RiscvSoCDescription, "UART interrupt requires a described PLIC")
      unless uart.interrupt.controller.address_set == plic.region.address_set
      | error(~who: #'RiscvSoCDescription, "UART interrupt must reference the described PLIC region")
      unless for any (source in plic.sources): source.source_id == uart.interrupt.source_id
      | error(~who: #'RiscvSoCDescription, "UART interrupt must reference a described PLIC source")
      regions := regions ++ [uart.region]
    require_disjoint_regions(regions)
    super(model,
          compatible,
          harts,
          hart,
          clocks,
          memory_regions,
          boot,
          aclint,
          plic,
          uart)

  /* Rebuilds description variants through the same whole-system constructor checks. */
  reconstructor (model, compatible, harts, hart, clocks,
                 memory_regions, boot, aclint, plic, uart):
    RiscvSoCDescription(
      ~model: model,
      ~compatible: compatible,
      ~harts: harts,
      ~hart: hart,
      ~clocks: clocks,
      ~memory_regions: memory_regions,
      ~boot: boot,
      ~aclint: aclint,
      ~plic: plic,
      ~uart: uart
    )

  /* Builds the root, CPUs, architectural RAM, and peripheral nodes with deterministic labels and the first hart as the boot CPU. */
  method to_device_tree():
    DeviceTree(
      DeviceTreeNode(
        "",
        [DeviceTreeProperty("model", DeviceTreeString(model)),
         DeviceTreeProperty("compatible", DeviceTreeStringList(compatible)),
         DeviceTreeProperty("#address-cells", DeviceTreeU32(2)),
         DeviceTreeProperty("#size-cells", DeviceTreeU32(2))],
        [cpus_node(harts, hart, clocks)] ++ (
          for List (region in memory_regions): memory_node(region)
        ) ++ [soc_node(harts, clocks, aclint, plic, uart)]
      ),
      ~boot_cpuid: harts[0]
    )

export:
  SoCClockConfig
  SoCAddressRegion
  RiscvBootLayout
  RiscvAclintDescription
  RiscvPlicSource
  RiscvPlicContext
  RiscvPlicDescription
  RiscvPlicInterrupt
  RiscvUartDescription
  RiscvSoCDescription
