#lang rhodium
// Composes an independent single-core SoC with an inclusive LLC and external CHI memory.

import:
  lib("support/annotations.rhm") open
  lib("rhodium/std/bits.rhdl") open
  lib("chi/main.rhdl") open
  lib("cores/rv5stage/profile.rhm") open
  lib("riscv/isa/xlen.rhm").XLen
  "single-core-system.rhdl" open
  "endpoint-params.rhdl" open
  "host-interface.rhdl".SoCHostInterface
  "boot.rhdl" open
  "description.rhm" open
  "peripherals.rhdl" open
  "core-profiles.rhm" open

def simple_soc_flit = CHIFlitParams(~request_address_width: DefaultRhodiumSoCRequestAddressWidth)
def simple_soc_home = CHIHomeParams("simple-home", 5, CHINodeKind.HNF, ~max_outstanding: 1)
def simple_soc_device_home = CHIHomeParams("simple-device-home", 6, CHINodeKind.HNI, ~max_outstanding: 1)
def simple_soc_memory_base = 0x80000000
def simple_soc_memory_bytes = 0x40000000
def simple_soc_clocks = SoCClockConfig(
  ~clock_frequency_hz: 100000000,
  ~timebase_frequency_hz: 100000000
)
def simple_soc_host_node = soc_host_node(1)
def simple_soc_host_port = simple_soc_host_node.icn_peer()
def simple_soc_memory_transfers = TransferSizes(1, 64)
def simple_soc_memory_node = CHINodeParams(
  "simple-memory", 9, CHINodeKind.SNF,
  ~emits: CHIChannelCapabilities(
    ~rsp: [CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp],
    ~dat: [CHIDatOpcode.CompData]
  ),
  ~supports: CHIChannelCapabilities(
    ~req: [CHIReqOpcode.ReadNoSnp, CHIReqOpcode.WriteNoSnpFull, CHIReqOpcode.WriteNoSnpPtl],
    ~dat: [CHIDatOpcode.NonCopyBackWriteData]
  ),
  ~max_outstanding: 2
)
def simple_soc_memory_service = CHISubordinateServiceParams(
  simple_soc_memory_node.icn_peer(),
  [AddressSet(simple_soc_memory_base, simple_soc_memory_bytes - 1)],
  [CHIRequestSupport(CHIReqOpcode.ReadNoSnp, simple_soc_memory_transfers),
   CHIRequestSupport(CHIReqOpcode.WriteNoSnpFull, simple_soc_memory_transfers),
   CHIRequestSupport(CHIReqOpcode.WriteNoSnpPtl, simple_soc_memory_transfers)]
)

// Couples the external-memory fabric contract with the inclusive LLC geometry
// selected by the complete SimpleSoC composition.
class SimpleSoCParams(fabric :: SingleCoreSystemParams,
                      core_profile :: RVCoreProfile,
                      clocks :: SoCClockConfig,
                      llc_sets :: Pow2Int,
                      llc_ways :: PosInt):
  implements StableCircuitParam

  property llc_config:
    CHIInclusiveHNFConfig(fabric.home_config,
                          CHIAddressProjectorConfig(fabric.flit,
                                                    fabric.memory_bytes,
                                                    64,
                                                    1),
                          ~sets: llc_sets,
                          ~ways: llc_ways)
  property description:
    fabric.description("Rhodium SimpleSoC",
                       ["rhodium,simple-soc"],
                       core_profile,
                       clocks)

  constructor (fabric :: SingleCoreSystemParams,
               ~core_profile: core_profile :: RVCoreProfile = simple_soc_core_profile,
               ~clocks: clocks :: SoCClockConfig = simple_soc_clocks,
               ~llc_sets: llc_sets :: Pow2Int,
               ~llc_ways: llc_ways :: PosInt):
    unless core_profile.xlen == XLen.X64
    | error(~who: #'SimpleSoCParams, "SimpleSoC requires an RV64 core profile")
    super(fabric, core_profile, clocks, llc_sets, llc_ways)

def simple_soc_params = SimpleSoCParams(
  SingleCoreSystemParams(
    simple_soc_flit, simple_soc_memory_base, simple_soc_memory_bytes,
    simple_soc_memory_service, simple_soc_home, simple_soc_host_node,
    SoCPlatformParams(simple_soc_flit, 1, simple_soc_device_home,
                      riscv_soc_boot_config(~payload_address: simple_soc_memory_base),
                      12, 10, 13, 11, 14)
  ),
  ~llc_sets: 64,
  ~llc_ways: 4
)
def simple_soc_rv5stage_config = simple_soc_params.fabric.rv5stage_config
def simple_soc_home_map :: CHIHomeMap = simple_soc_params.fabric.home_map
def simple_soc_rv5stage_params = simple_soc_params.fabric.rv5stage_params
def simple_soc_instruction_port = simple_soc_params.fabric.instruction_port
def simple_soc_data_port = simple_soc_params.fabric.data_port
def simple_soc_uncached_port = simple_soc_params.fabric.uncached_port
def simple_soc_memory_requests = simple_soc_params.fabric.memory_requests
def simple_soc_memory_port = simple_soc_params.fabric.memory_port
def simple_soc_home_config = simple_soc_params.fabric.home_config
def simple_soc_home_params = simple_soc_params.fabric.home_params
def simple_soc_device_home_params = simple_soc_params.fabric.device_home_params
def simple_soc_platform = simple_soc_params.fabric.platform
def simple_soc_bootrom_config = simple_soc_platform.bootrom.rom_config(simple_soc_params.description)
def simple_soc_bootrom_params = simple_soc_platform.bootrom.rom_params
def simple_soc_aclint_config = simple_soc_platform.aclint_config
def simple_soc_aclint_params = simple_soc_platform.aclint
def simple_soc_plic_config = simple_soc_platform.plic_config
def simple_soc_plic_params = simple_soc_platform.plic
def simple_soc_uart_config = simple_soc_platform.uart_config
def simple_soc_uart_params = simple_soc_platform.uart

def simple_soc_topology = simple_soc_params.fabric.topology
def simple_soc_router = simple_soc_params.fabric.router
def simple_soc_host_site = simple_soc_params.fabric.host_site
def simple_soc_instruction_site = simple_soc_params.fabric.instruction_site
def simple_soc_data_site = simple_soc_params.fabric.data_site
def simple_soc_uncached_site = simple_soc_params.fabric.uncached_site
def simple_soc_home_requester_site = simple_soc_params.fabric.home_requester_site
def simple_soc_device_home_requester_site = simple_soc_params.fabric.device_home_requester_site
def simple_soc_device_home_subordinate_site = simple_soc_params.fabric.device_home_subordinate_site
def simple_soc_boot_address_site = simple_soc_params.fabric.boot_address_site
def simple_soc_bootrom_site = simple_soc_params.fabric.bootrom_site
def simple_soc_aclint_site = simple_soc_params.fabric.aclint_site
def simple_soc_plic_site = simple_soc_params.fabric.plic_site
def simple_soc_uart_site = simple_soc_params.fabric.uart_site
def simple_soc_connections = simple_soc_params.fabric.connections
def simple_soc_compilations = simple_soc_params.fabric.compilations
def simple_soc_adapter_plans = simple_soc_params.fabric.adapter_plans
def simple_soc_snp_compilation = simple_soc_params.fabric.snp_compilation
def simple_soc_req_router_config = simple_soc_params.fabric.req_router_config
def simple_soc_rsp_router_config = simple_soc_params.fabric.rsp_router_config
def simple_soc_snp_router_config = simple_soc_params.fabric.snp_router_config
def simple_soc_dat_router_config = simple_soc_params.fabric.dat_router_config

// Exposes the fabric's line-capable subordinate channels while leaving storage
// and response timing to the external SN-F implementation.
sync_circuit SimpleSoC(params :: SimpleSoCParams = simple_soc_params):
  def fabric_params = params.fabric
  interface host(SoCHostInterface(fabric_params.flit), ~role: soc)
  interface memory(CHISNChannels(fabric_params.flit), ~role: icn)
  interface uart(SoCUartInterface(), ~role: soc)

  def HomeModule = CHIInclusiveHNF(params.llc_config)
  populate_single_core(fabric_params, params.description, host, memory, uart, ~home: HomeModule)

def design = elaborate(SimpleSoC())

