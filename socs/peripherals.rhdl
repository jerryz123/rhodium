#lang rhodium
// Defines shared BootROM, ACLINT, UART, PMA, and HN-I platform contracts for SoCs.

import:
  lib("chi/main.rhdl") open
  lib("cores/rv5stage/chi.rhdl").RV5StageCHIRegion
  lib("riscv/rtl/pma.rhdl") open
  lib("devices/aclint.rhdl") open
  lib("devices/uart16550.rhdl") open
  "boot.rhdl" open
  "description.rhm" open

def SoCAclintBase = 0x02000000
def SoCUartBase = 0x10000000
def SoCUartFifoDepth = 16
def soc_device_attributes = RiscvPhysicalMemoryAttributes(#true, #true, #false, #false, #false, #true, #false)

fun soc_peripheral_regions(home :: CHIHomeParams):
  [RV5StageCHIRegion(
     RiscvPhysicalMemoryRegion(
       AddressSet(SoCAclintBase, AclintWindowBytes - 1),
       soc_device_attributes
     ),
     home
   ),
   RV5StageCHIRegion(
     RiscvPhysicalMemoryRegion(
       AddressSet(SoCUartBase, Uart16550WindowBytes - 1),
       soc_device_attributes
     ),
     home
   )]

interface SoCUartInterface():
  role pins
  role soc
  provider soc

  pins -> soc:
    rx: Bits(1)

  soc -> pins:
    tx: Bits(1)
    interrupt: Bool

// Keeps every SoC's uncached PMA entries and HN-I subordinate map derived from
// the same BootROM, ACLINT, and UART descriptions.
class SoCPlatformParams(flit :: CHIFlitParams,
                        hart_count :: PosInt,
                        home :: CHIHomeParams,
                        boot :: SoCBootConfig,
                        bootrom_node_id :: Nat,
                        aclint_node_id :: Nat,
                        uart_node_id :: Nat,
                        uart_fifo_depth :: Int.in(1 ..= Uart16550MaximumFifoDepth) = SoCUartFifoDepth):
  implements StableCircuitParam

  property bootrom:
    SoCBootROMParams(flit, home, bootrom_node_id, boot)
  property aclint_config: AclintConfig(flit, hart_count)
  property aclint:
    AclintParams("soc-aclint", aclint_node_id, aclint_config, SoCAclintBase)
  property uart_config: Uart16550Config(flit, uart_fifo_depth)
  property uart:
    Uart16550Params("soc-uart", uart_node_id, uart_config, SoCUartBase)
  property boot_description:
    RiscvBootLayout(
      ~rom: SoCAddressRegion(bootrom.rom_params.service.address_sets[0]),
      ~reset_address: boot.reset_address,
      ~payload_address: boot.payload_address
    )
  property aclint_description:
    RiscvAclintDescription(SoCAddressRegion(aclint.service.address_sets[0]))
  property uart_description:
    RiscvUartDescription(SoCAddressRegion(uart.service.address_sets[0]))
  property subordinate_map:
    CHISubordinateMap(flit, [bootrom.rom_params.service, aclint.service, uart.service])
  property regions: [bootrom.region] ++ soc_peripheral_regions(home)

  method home_params(requester_endpoints :: NonemptyList.of(CHIICNPortParams)):
    CHIHNIParams(home, requester_endpoints, subordinate_map)

export:
  SoCAclintBase
  SoCUartBase
  SoCUartFifoDepth
  soc_device_attributes
  soc_peripheral_regions
  SoCUartInterface
  SoCPlatformParams
