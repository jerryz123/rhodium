#lang rhodium
// Defines shared boot devices, ACLINT, PLIC, UART, PMA, and HN-I platform contracts for SoCs.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/interconnect.rhdl").AddressSet
  lib("chi/protocol/params.rhdl").CHIFlitParams
  lib("chi/protocol/link.rhdl").CHIHomeRequesterParams
  lib("chi/protocol/fabric.rhdl") open
  lib("chi/home/home.rhdl").CHIHNIParams
  lib("cores/rv5stage/chi/foundation.rhdl").RV5StageCHIRegion
  lib("riscv/rtl/pma.rhdl") open
  lib("devices/boot-address.rhdl") open
  lib("devices/aclint.rhdl") open
  lib("devices/plic.rhdl") open
  lib("devices/uart16550.rhdl") open
  lib("riscv/isa/interrupt.rhm").InterruptCause
  "boot.rhdl" open
  "description.rhm" open

def SoCAclintBase = 0x02000000
def SoCPlicBase = 0x0c000000
def SoCPlicPriorityWidth = 3
def SoCPlicUartSource = 1
def SoCUartBase = 0x10000000
def SoCUartFifoDepth = 16
def soc_boot_address_attributes = RiscvPhysicalMemoryAttributes(#true, #true, #false, #false, #false, #true, #true)
def soc_device_attributes = RiscvPhysicalMemoryAttributes(#true, #true, #false, #false, #false, #true, #false)

fun soc_plic_contexts(hart_count :: PosInt):
  def mutable contexts = []
  for (hart in 0..hart_count):
    contexts := contexts ++ [
      RiscvPlicContext(hart, InterruptCause.MachineExternal),
      RiscvPlicContext(hart, InterruptCause.SupervisorExternal)
    ]
  contexts

fun soc_peripheral_regions(home :: CHIHomeParams):
  [RV5StageCHIRegion(
     RiscvPhysicalMemoryRegion(
       AddressSet(SoCAclintBase, AclintWindowBytes - 1),
       soc_device_attributes
     ),
     home
   ),
   RV5StageCHIRegion(
     RiscvPhysicalMemoryRegion(
       AddressSet(SoCPlicBase, PlicWindowBytes - 1),
       soc_device_attributes
     ),
     home
   ),
   RV5StageCHIRegion(
     RiscvPhysicalMemoryRegion(
       AddressSet(SoCUartBase, Uart16550WindowBytes - 1),
       soc_device_attributes
     ),
     home
   )]

interface SoCUartInterface():
  role pins
  role soc
  provider soc

  pins -> soc:
    rx: Bits(1)

  soc -> pins:
    tx: Bits(1)
    interrupt: Bool

// Keeps every SoC's uncached PMA entries and HN-I subordinate map derived from
// the same boot-register, BootROM, ACLINT, PLIC, and UART descriptions.
class SoCPlatformParams(flit :: CHIFlitParams,
                        hart_count :: PosInt,
                        home :: CHIHomeParams,
                        boot :: SoCBootConfig,
                        bootrom_node_id :: Nat,
                        aclint_node_id :: Nat,
                        plic_node_id :: Nat,
                        uart_node_id :: Nat,
                        boot_address_node_id :: Nat,
                        uart_fifo_depth :: Int.in(1 ..= Uart16550MaximumFifoDepth) = SoCUartFifoDepth):
  implements StableCircuitParam

  property bootrom:
    SoCBootROMParams(flit, home, bootrom_node_id, boot)
  property boot_address_config: BootAddressConfig(flit, 0)
  property boot_address:
    BootAddressParams("soc-boot-address", boot_address_node_id, boot_address_config, boot.boot_address_register)
  property aclint_config: AclintConfig(flit, hart_count)
  property aclint:
    AclintParams("soc-aclint", aclint_node_id, aclint_config, SoCAclintBase)
  property plic_config: PlicConfig(flit, SoCPlicUartSource, hart_count * 2, SoCPlicPriorityWidth)
  property plic:
    PlicParams("soc-plic", plic_node_id, plic_config, SoCPlicBase)
  property uart_config: Uart16550Config(flit, uart_fifo_depth)
  property uart:
    Uart16550Params("soc-uart", uart_node_id, uart_config, SoCUartBase)
  property boot_description:
    RiscvBootLayout(
      ~rom: SoCAddressRegion(bootrom.rom_params.service.address_sets[0]),
      ~reset_address: boot.reset_address,
      ~payload_address: boot.payload_address,
      ~address_register: SoCAddressRegion(boot_address.service.address_sets[0])
    )
  property aclint_description:
    RiscvAclintDescription(SoCAddressRegion(aclint.service.address_sets[0]))
  property plic_description:
    RiscvPlicDescription(
      SoCAddressRegion(plic.service.address_sets[0]),
      SoCPlicPriorityWidth,
      [RiscvPlicSource(SoCPlicUartSource, "uart")],
      soc_plic_contexts(hart_count)
    )
  property uart_description:
    RiscvUartDescription(
      SoCAddressRegion(uart.service.address_sets[0]),
      RiscvPlicInterrupt(SoCAddressRegion(plic.service.address_sets[0]), SoCPlicUartSource)
    )
  property subordinate_map:
    CHISubordinateMap(flit, [bootrom.rom_params.service, boot_address.service, aclint.service, plic.service, uart.service])
  property regions:
    [bootrom.region,
     RV5StageCHIRegion(RiscvPhysicalMemoryRegion(boot_address.service.address_sets[0], soc_boot_address_attributes), home)] ++ soc_peripheral_regions(home)

  property host_services:
    subordinate_map.services.map(fun (service): CHIHomeServiceParams(home, service.address_sets, service.requests))

  method home_params(requester_endpoints :: NonemptyList.of(CHIHomeRequesterParams)):
    CHIHNIParams(home, requester_endpoints, subordinate_map)

export:
  SoCAclintBase
  SoCPlicBase
  SoCPlicPriorityWidth
  SoCPlicUartSource
  SoCUartBase
  SoCUartFifoDepth
  soc_device_attributes
  soc_boot_address_attributes
  soc_peripheral_regions
  soc_plic_contexts
  SoCUartInterface
  SoCPlatformParams
