#lang rhombus
/* Projects explicit shape-core-ISA config keys through the shared configuration resolver. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../../support/annotations.rhm".NonemptyString
  "../../riscv/udb.rhm".UdbConfiguration
  "selection.rhm" open
  "resolve.rhm".resolve_soc_config

/* Resolves a complete shape-core-ISA catalog key and returns its implementation-owned UDB configuration. */
fun riscv_udb_configuration(configuration_name :: NonemptyString) :: UdbConfiguration:
  def config = resolve_soc_config(named_soc_selection(configuration_name))
  config.udb()

export:
  riscv_udb_configuration
