#lang rhombus
/* Resolves typed configs once for hardware composition, architectural descriptions, and UDB projection. */
// SPDX-License-Identifier: Apache-2.0

import:
  "selection.rhm" open
  "core-profiles.rhm".rv5stage_soc_profile
  "spike-core-profile.rhm".spike_soc_profile
  "../harts/implementation.rhdl".RiscvHartImplementation
  "../harts/rv5stage.rhdl".rv5stage_hart
  "../harts/spike.rhdl".spike_hart
  "../mini-soc/main.rhdl" as mini
  "../single-core-soc/main.rhdl" as simple
  "../tiled-soc/main.rhdl" as tiled
  "../platform/description.rhm".RiscvSoCDescription
  "../platform/fabric-profiles.rhm".rhodium_soc_flit
  lib("cores/rv5stage/profile.rhm").RV5StageConfig
  lib("cores/spike/profile.rhm").SpikeConfig
  lib("cores/rv5stage/udb.rhm").rv5stage_udb_configuration
  lib("cores/spike/udb.rhm").spike_udb_configuration
  lib("riscv/udb.rhm").UdbConfiguration

/* Resolves one typed selection into a hart binding shared by hardware configuration, architecture, and UDB projection. */
class ResolvedSoCConfig(selection :: SoCSelection, hart :: RiscvHartImplementation):
  /* Applies the selected core's profile factory to the explicit architecture and, for RV5Stage, shape-specific implementation policy. */
  constructor (selection :: SoCSelection):
    def hart = match selection.core
    | CoreKind.RV5Stage: rv5stage_hart(rv5stage_soc_profile(selection.shape, selection.isa))
    | CoreKind.Spike: spike_hart(spike_soc_profile(selection.isa))
    super(selection, hart)

  property key :: String: selection.key

  /* Constructs the selected Mini, Single, or Tiled shape with this resolved hart binding. */
  method configuration() :: mini.MiniSoCConfig || simple.SingleCoreSoCConfig || tiled.TiledSoCConfig:
    match selection.shape
    | SoCShape.Mini: mini.mini_soc_config(hart)
    | SoCShape.Simple: simple.single_core_soc_config(hart)
    | SoCShape.Tiled: tiled.tiled_soc_config(hart)

  property description :: RiscvSoCDescription: configuration().description

  /* Projects the selected implementation into UDB, retaining its physical-address and pointer-masking policy. */
  method udb(~name: name :: String = "rhodium-" ++ key) :: UdbConfiguration:
    match selection.core
    | CoreKind.RV5Stage:
        def profile :: RV5StageConfig = hart.profile
        def physical_address_width = math.min(profile.xlen.width, rhodium_soc_flit.request_address_width)
        rv5stage_udb_configuration(profile, name, "Rhodium " ++ key, physical_address_width)
    | CoreKind.Spike:
        def profile :: SpikeConfig = hart.profile
        spike_udb_configuration(profile, name, "Rhodium " ++ key)

/* Creates the common resolved config used by hardware and architecture-facing consumers. */
fun resolve_soc_config(selection :: SoCSelection) :: ResolvedSoCConfig:
  ResolvedSoCConfig(selection)

export:
  ResolvedSoCConfig
  resolve_soc_config
