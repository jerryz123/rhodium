#lang rhombus
/* Projects explicit config architectures into the Spike execution configuration. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/spike/profile.rhm").SpikeConfig
  lib("riscv/isa/hart.rhm") open
  lib("riscv/isa/vector-profile.rhm").vector_profile_enabled
  lib("riscv/isa/vector-profile.rhm").vector_profile_elen_bits
  "selection.rhm" open
  "isa-profiles.rhm".soc_architecture

/* Builds a PMP-disabled Spike profile with the preset's exact ISA, MMU, and optional vector geometry plus shared cache descriptions. */
fun spike_soc_profile(preset :: IsaPreset) :: SpikeConfig:
  def architecture = soc_architecture(preset)
  SpikeConfig(
    RiscvHartDescription(architecture.isa, architecture.mmu,
                         RiscvCacheDescription(64, 64, 16384), RiscvCacheDescription(64, 64, 16384),
                         ~cbo_block_bytes: 64,
                         ~vector: if vector_profile_enabled(architecture.vector) | RiscvVectorDescription(architecture.vector_length, vector_profile_elen_bits(architecture.vector)) | #false),
    ~pmp_regions: 0
  )

def single_core_spike_soc_core_profile = spike_soc_profile(IsaPreset.RVA23)
def single_core_spike_soc_hart_description = single_core_spike_soc_core_profile.hart_description

export:
  spike_soc_profile
  single_core_spike_soc_hart_description
  single_core_spike_soc_core_profile
