#lang rhombus
/* Adapts the existing shape/core call boundary to the typed config resolver. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../harts/implementation.rhdl".RiscvHartImplementation
  "selection.rhm" open
  "resolve.rhm".resolve_soc_config

/* Parses shape and core names and returns their resolved hart binding for an explicitly supplied typed ISA preset. */
fun soc_hart(shape :: String, core :: String, ~isa: isa :: IsaPreset) :: RiscvHartImplementation:
  def selection = SoCSelection(parse_soc_shape(shape), parse_core_kind(core), isa)
  resolve_soc_config(selection).hart

export:
  soc_hart
