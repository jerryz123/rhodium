#lang rhodium
/* Composes the explicit Spike RVA23 config with the shared single-core platform. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("support/annotations.rhm") open
  lib("rhodium/std/bits.rhdl") open
  lib("cores/spike/profile.rhm").SpikeConfig
  lib("cores/spike/chi/foundation.rhdl").spike_chi_params
  "../one-hart/system.rhdl" open
  "../single-core-soc/main.rhdl" as generic
  "../harts/spike.rhdl".spike_hart
  "spike-core-profile.rhm" open

/* Builds the named Spike config's shared external-memory parameters with its selected execution profile and LLC geometry. */
fun make_single_core_spike_soc_params(
  core_profile :: SpikeConfig = single_core_spike_soc_core_profile,
  ~llc_sets: llc_sets :: Pow2Int = 512,
  ~llc_ways: llc_ways :: PosInt = 8
) :~ SingleCoreSoCParams:
  make_single_core_soc_params(
    core_profile,
    core_profile.hart_description,
    64,
    spike_chi_params,
    "Rhodium Single-Core Spike SoC",
    ["rhodium,single-core-spike-soc"],
    ~llc_sets: llc_sets,
    ~llc_ways: llc_ways
  )

def single_core_spike_soc_params = make_single_core_spike_soc_params()

/* Binds the supplied Spike execution profile to the shared single-core composition, retaining its simulation-only processor. */
fun SingleCoreSpikeSoC(params :: SingleCoreSoCParams = single_core_spike_soc_params):
  def core_profile :: SpikeConfig = params.core_profile
  generic.SingleCoreSoC(generic.SingleCoreSoCConfig(spike_hart(core_profile), params))

export:
  single_core_spike_soc_core_profile
  make_single_core_spike_soc_params
  single_core_spike_soc_params
  SingleCoreSpikeSoC
