#lang rhombus
/* Applies Mini/Simple cache resources to RV2Wide's exact scalar and RV32/RV64 vector presets. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/rv2wide/profile.rhm") open
  lib("cores/cache/config.rhm").CacheConfig
  lib("riscv/isa/fp-profile.rhm") open
  lib("riscv/isa/c.rhm") open
  "selection.rhm" open
  "isa-profiles.rhm".soc_architecture

/* Rejects unsupported shapes or architectures rather than silently selecting a weaker hart. */
fun rv2wide_soc_profile(shape :: SoCShape, preset :: IsaPreset) :: RV2WideConfig:
  unless [SoCShape.Mini, SoCShape.Simple].contains(shape)
  | error(~who: #'rv2wide_soc_profile, "RV2Wide supports Mini/Simple shapes")
  def cache = if shape == SoCShape.Mini | CacheConfig(32, 1) | CacheConfig(64, 4)
  def architecture = soc_architecture(preset)
  def has = architecture.has
  def compressed = CCompressedExtensions ++ (if has("zcb") | [CompressedExtension.Zcb] | []) ++ (if has("zcmop") | [CompressedExtension.Zcmop] | [])
  def profile = RV2WideConfig(
    ~xlen: architecture.isa.xlen, ~mmu_type: architecture.mmu,
    ~instruction_cache: cache, ~data_cache: cache,
    ~floating_point: if has("d") | FloatingPointProfile.D | (if has("f") | FloatingPointProfile.F | FloatingPointProfile.None),
    ~half_precision: if has("zfh") | HalfPrecisionProfile.Zfh | HalfPrecisionProfile.None,
    ~zfa: has("zfa"),
    ~compressed: compressed,
    ~ziccif: has("ziccif"), ~ziccamoa: has("ziccamoa"), ~ziccrse: has("ziccrse"),
    ~zicbop: has("zicbop"), ~zicbom: has("zicbom"), ~zicboz: has("zicboz"),
    ~zawrs: has("zawrs"), ~zihintpause: has("zihintpause"), ~zihintntl: has("zihintntl"),
    ~sscofpmf: has("sscofpmf"),
    ~sstc: has("sstc"), ~svnapot: has("svnapot"), ~svpbmt: has("svpbmt"), ~svinval: has("svinval"),
    ~ssnpm: has("ssnpm"), ~supm: has("supm"), ~smstateen: has("smstateen"),
    ~hypervisor: has("h"),
    ~vector: architecture.vector, ~vector_extensions: architecture.vector_extensions,
    ~vector_length: architecture.vector_length
  )
  unless profile.isa_profile == architecture.isa
  | error(~who: #'rv2wide_soc_profile, "RV2Wide cannot implement the exact requested architecture")
  profile

export:
  rv2wide_soc_profile
