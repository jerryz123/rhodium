#lang rhombus
/* Serializes the resolved architectural, implementation, and platform configuration shared by config artifacts. */
// SPDX-License-Identifier: Apache-2.0

import:
  "resolve.rhm".ResolvedSoCConfig
  "metadata-json.rkt" open
  "../one-hart/system.rhdl".SingleCoreSystemParams
  "../mini-soc/main.rhdl".MiniSoCConfig
  "../single-core-soc/main.rhdl".SingleCoreSoCConfig
  "../tiled-soc/main.rhdl".TiledSoCConfig
  "selection.rhm".CoreKind
  lib("cores/rv5stage/csr.rhdl").rv5stage_csr_config
  lib("cores/spike/udb.rhm").spike_csr_warl_policy

/*
 * Snapshots public fabric parameters in expression notation and replaces factory closures with
 * resolved CHI attachments. Architectural projections expose private values such as XLEN;
 * source-revision attestation binds executable changes.
 */
fun fabric_metadata(fabric :: SingleCoreSystemParams) :: Map:
  {
    "flit": repr(fabric.flit),
    "memory_base": fabric.memory_base,
    "memory_bytes": fabric.memory_bytes,
    "memory_service": repr(fabric.memory_service),
    "home": repr(fabric.home),
    "host_node": repr(fabric.host_node),
    "platform": repr(fabric.platform),
    "cache_line_bytes": fabric.cache_line_bytes,
    "instruction_node_id": fabric.instruction_node_id,
    "data_node_id": fabric.data_node_id,
    "uncached_node_id": fabric.uncached_node_id,
    "hart_attachment": repr(fabric.hart_params)
  }

/* Builds the versioned metadata envelope from the selected implementation, shape configuration, architectural description, DTS, and UDB. */
fun config_metadata(resolved :: ResolvedSoCConfig,
                    config :: MiniSoCConfig || SingleCoreSoCConfig || TiledSoCConfig = resolved.configuration()) :: Map:
  def csr_warl = match resolved.selection.core
  | CoreKind.RV5Stage: rv5stage_csr_config(config.hart.profile).warl_policy()
  | CoreKind.Spike: spike_csr_warl_policy(config.hart.profile)
  def platform = cond
  | config is_a MiniSoCConfig:
      {"ram": repr(config.ram), "clocks": repr(config.clocks),
       "boot": repr(config.boot), "fabric": fabric_metadata(config.fabric)}
  | config is_a SingleCoreSoCConfig:
      {"fabric": fabric_metadata(config.params.fabric), "clocks": repr(config.params.clocks),
       "model": config.params.model, "compatible": config.params.compatible,
       "llc_sets": config.params.llc_sets, "llc_ways": config.params.llc_ways}
  | ~else:
      {"layout": repr(config.layout), "node_ids": repr(config.node_ids),
       "memory": repr(config.memory), "llc": repr(config.llc),
       "clocks": repr(config.clocks), "flit": repr(config.flit), "boot": repr(config.boot)}
  {
    "schema": 1,
    "config": resolved.key,
    "architecture": repr(config.hart.description),
    "xlen": config.hart.description.xlen.width,
    "implementation": repr(config.hart.profile),
    "csr_warl": csr_warl,
    "hart_binding": {"name": config.hart.name, "key": config.hart.key, "cache_line_bytes": config.hart.cache_line_bytes},
    "platform": platform,
    "description": repr(config.description),
    "device_tree": config.description.to_device_tree().to_dts(),
    "udb": resolved.udb().to_yaml()
  }

export:
  config_metadata
  metadata_json
  metadata_fingerprint
