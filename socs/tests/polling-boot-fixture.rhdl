#lang rhodium
// Composes the generated platform polling ROM and a complete core for CHI boot execution tests.

import:
  lib("chi/protocol/channels.rhdl") open
  lib("cores/rv5stage/rv5stage.rhdl").RV5Stage
  lib("cores/rv5stage/profile.rhm").RVCoreProfile
  lib("cores/rv5stage/chi/foundation.rhdl").RV5StageCHIIdentity
  lib("cores/rv5stage/chi/foundation.rhdl").RV5StageCHIConfig
  lib("cores/rv5stage/chi/foundation.rhdl").RV5StageCHIRegion
  lib("cores/rv5stage/interrupt.rhdl").RV5StageInterrupts
  lib("cores/rv5stage/tests/params.rhdl").test_rv5stage_uncached_config
  lib("devices/bootrom-image.rhm").riscv_bootrom_image
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/rtl/pma.rhdl") open

sync_circuit RV5StagePollingBoot():
  def config = RV5StageCHIConfig(
    test_rv5stage_uncached_config.flit,
    for List (region in test_rv5stage_uncached_config.regions):
      if region.physical.attributes.executable && (!region.physical.attributes.cacheable)
      | RV5StageCHIRegion(RiscvPhysicalMemoryRegion(region.physical.address_set, RiscvPhysicalMemoryAttributes(#true, #false, #true, #false, #false, #false, #true, ~instruction_cacheable: #true)), region.home)
      | region
  )
  def p = config.flit
  def image = riscv_bootrom_image(0xc000, 0xc100, ~device_tree_address: 0xc180, ~boot_address_register: 0x8000)
  input hart_id: Bits(64)
  interface imem(CHIRNIChannels(p), ~role: node)
  interface dmem(CHIRNChannels(p), ~role: node)
  interface umem(CHIRNIChannels(p), ~role: node)
  output boot_words: Vec(image.size_bytes / 4, Bits(32))
  def words = for List (index in 0..(image.size_bytes / 4)):
    bits(image.bytes[index * 4] + (image.bytes[index * 4 + 1] << 8) + (image.bytes[index * 4 + 2] << 16) + (image.bytes[index * 4 + 3] << 24), 32)
  boot_words <== vec(words)
  inst core(RV5Stage(RVCoreProfile(~xlen: XLen.X64), ~chi: config, ~reset_address: 0xc000))
  core.hart_id <== hart_id
  core.interrupts <== RV5StageInterrupts():
    supervisor_software: Bool(#false)
    machine_software: Bool(#false)
    supervisor_timer: Bool(#false)
    machine_timer: Bool(#false)
    supervisor_external: Bool(#false)
    machine_external: Bool(#false)
  core.time_counter <== bits(0, 64)
  core.chi_identity <== RV5StageCHIIdentity(p):
    instruction_node_id: bits(2, p.node_id_width)
    data_node_id: bits(3, p.node_id_width)
    uncached_node_id: bits(5, p.node_id_width)
  imem <=> core.imem
  dmem <=> core.dmem
  umem <=> core.umem

export:
  RV5StagePollingBoot
