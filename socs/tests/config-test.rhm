#lang rhombus
// Checks architectural presets, shape-specific resources, and shared hardware/software/UDB config projections.
// SPDX-License-Identifier: Apache-2.0

import:
  "../configs/selection.rhm" open
  "../configs/isa-profiles.rhm" open
  "../configs/resolve.rhm" open
  "../configs/core-profiles.rhm" open
  "../configs/spike-core-profile.rhm" open
  "../configs/rv2wide-core-profile.rhm" open
  "../configs/udb.rhm".riscv_udb_configuration
  "../mini-soc/main.rhdl".MiniSoCConfig
  "../platform/boot.rhdl".riscv_soc_boot_config
  "../../sims/program-test/targets.rhm" open
  lib("cores/rv5stage/profile.rhm") open
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/profile.rhm").MisaExtension
  lib("riscv/isa/hart.rhm").RiscvMmuType
  lib("riscv/isa/vector-profile.rhm").VectorProfile
  lib("riscv/gnu-toolchain.rhm").gnu_isa_target

def rv32 = soc_architecture(IsaPreset.RV32Int)
// A third hart binding retains the exact lean architecture and shape-owned resources.
for (selection in [SoCSelection(SoCShape.Mini, CoreKind.RV2Wide, IsaPreset.RV64IMACB), SoCSelection(SoCShape.Simple, CoreKind.RV2Wide, IsaPreset.RV64IMACB), SoCSelection(SoCShape.Mini, CoreKind.RV2Wide, IsaPreset.RV64IMAFDCB), SoCSelection(SoCShape.Simple, CoreKind.RV2Wide, IsaPreset.RV64IMAFDCB)]):
  def shape = selection.shape
  def isa = selection.isa
  def resolved = resolve_soc_config(selection)
  def expected = soc_architecture(isa)
  def cache_sets = if shape == SoCShape.Mini | 32 | 64
  def cache_ways = if shape == SoCShape.Mini | 1 | 4
  check:
    named_soc_selection(selection.key) ~is selection
    resolved.description.hart.isa_profile ~is expected.isa
    resolved.description.hart.mmu_type ~is expected.mmu
    resolved.description.hart.vector ~is #false
    resolved.description.hart.instruction_cache.sets ~is cache_sets
    resolved.description.hart.data_cache.ways ~is cache_ways
    resolved.description.to_device_tree().to_dtb().length() > 0 ~is #true
    resolved.udb().to_yaml().contains("  MXLEN: 64") ~is #true
    resolved.udb().to_yaml().contains("  MUTABLE_MISA_C: false") ~is #true
    simulator_soc_description(selection.key) ~is resolved.description
    gnu_isa_target(expected.isa.xlen, expected.isa.isa_extensions).mabi ~is (if isa == IsaPreset.RV64IMACB | "lp64" | "lp64d")
check:
  rv2wide_soc_profile(SoCShape.Mini, IsaPreset.RVA23) ~throws "supports Mini/Simple"
  rv2wide_soc_profile(SoCShape.Tiled, IsaPreset.RV64IMACB) ~throws "supports Mini/Simple"

def rv32_compiler = gnu_isa_target(rv32.isa.xlen, rv32.isa.isa_extensions)
check:
  rv32.isa.xlen ~is XLen.X32
  rv32.mmu ~is RiscvMmuType.Bare
  rv32.vector ~is VectorProfile.Zve32x
  rv32.vector_length ~is 64
  rv32_compiler.mabi ~is "ilp32"
  rv32_compiler.march.starts_with("rv32imacb_") ~is #true
  rv32.isa.misa_extension_bits ~is 0x141107
for (extension in ["zcb", "zcmop", "zicbom", "zicbop", "zicboz", "zawrs", "zihintpause", "zihintntl", "ziccrse", "zve32x", "zvbb", "zvkb", "zvkt", "zvl64b"]):
  check: rv32.has(extension) ~is #true
for (extension in ["f", "d", "v", "zfh", "zfa", "zve32f", "zvfh", "ssnpm", "supm"]):
  check: rv32.has(extension) ~is #false

for (shape in [SoCShape.Mini, SoCShape.Simple, SoCShape.Tiled]):
  def selection = SoCSelection(shape, CoreKind.RV5Stage, IsaPreset.RVA23)
  def config = resolve_soc_config(selection)
  def profile :: RV5StageConfig = config.hart.profile
  def architecture = soc_architecture(selection.isa)
  def description = config.description
  def udb = config.udb()
  check:
    named_soc_selection(selection.key) ~is selection
    profile.isa_profile ~is architecture.isa
    profile.vector_length ~is architecture.vector_length
    config.configuration().hart.description ~is description.hart
    description.hart.isa_profile ~is architecture.isa
    simulator_soc_description(config.key) ~is description
    simulator_shape_description(soc_shape_name(shape), "rv5stage", ~isa: IsaPreset.RVA23) ~is description
    riscv_udb_configuration(config.key) ~is udb
    udb.name ~is "rhodium-" ++ config.key
    udb.to_yaml().contains("  VLEN: 128") ~is #true
    udb.to_yaml().contains("  MXLEN: 64") ~is #true
    udb.to_yaml().contains("  SUPPORTED_PMLEN_SSNPM: [0, 7, 16]") ~is #true
    gnu_isa_target(description.hart.xlen, description.hart.isa_profile.isa_extensions).mabi ~is "lp64d"
    profile.multiplier ~is (if shape == SoCShape.Mini | RV5StageMultiplierKind.Iterative | RV5StageMultiplierKind.Pipelined)
    profile.data_cache_service_queue_depth ~is (if shape == SoCShape.Mini | 1 | 4)

check:
  single_core_rv5stage_soc_core_profile.cache_geometry.instruction.sets ~is 64
  single_core_rv5stage_soc_core_profile.cache_geometry.instruction.ways ~is 4
  mini_rv5stage_soc_core_profile.cache_geometry.instruction.sets ~is 32
  mini_rv5stage_soc_core_profile.cache_geometry.instruction.ways ~is 1
  tiled_rv5stage_soc_core_profile.cache_geometry.instruction.ways ~is 1
  mini_rv5stage_soc_core_profile.isa_profile ~is soc_architecture(IsaPreset.RVA23).isa
  single_core_spike_soc_core_profile.hart_description.isa_profile ~is soc_architecture(IsaPreset.RVA23).isa
  parse_soc_shape("simple") ~is SoCShape.Simple
  parse_core_kind("spike") ~is CoreKind.Spike
  parse_isa_preset("rv32int") ~is IsaPreset.RV32Int
  parse_isa_preset("rv32max") ~is IsaPreset.RV32Max
  parse_isa_preset("rv64max") ~is IsaPreset.RV64Max
  parse_isa_preset("rv64imacb") ~is IsaPreset.RV64IMACB
  parse_isa_preset("rv64imafdcb") ~is IsaPreset.RV64IMAFDCB
  parse_isa_preset("rva23") ~is IsaPreset.RVA23
  parse_isa_preset("typo") ~throws "unsupported ISA preset"

def spike_config = resolve_soc_config(SoCSelection(SoCShape.Mini, CoreKind.Spike, IsaPreset.RVA23))
check:
  spike_config.description.hart.isa_profile ~is soc_architecture(IsaPreset.RVA23).isa
  spike_config.description.hart.vector.vlen ~is 128
  spike_config.description.hart.vector.elen ~is 64
  single_core_spike_soc_core_profile.isa_string.length() > 64 ~is #true
  single_core_spike_soc_core_profile.isa_bytes > 0 ~is #true
  spike_config.description ~is simulator_soc_description("mini-spike-rva23")
  spike_config.udb().to_yaml().contains("  VLEN: 128") ~is #true
  riscv_udb_configuration("simple-spike-rva23").to_yaml().contains("  CACHE_BLOCK_SIZE: 64") ~is #true

// Both hart implementations project the same RV32 architecture and platform geometry.
def rv32_config = resolve_soc_config(SoCSelection(SoCShape.Mini, CoreKind.Spike, IsaPreset.RV32Int))
def rv32_mini :: MiniSoCConfig = rv32_config.configuration()
def rv32_description = rv32_config.description
def rv32_rtl = resolve_soc_config(SoCSelection(SoCShape.Mini, CoreKind.RV5Stage, IsaPreset.RV32Int))
check:
  rv32_rtl.description.hart.isa_profile ~is rv32.isa
  rv32_rtl.description.hart.vector.vlen ~is 64
  rv32_rtl.description.hart.vector.elen ~is 32
  rv32_description.hart.isa_profile ~is rv32.isa
  rv32_description.hart.vector.vlen ~is 64
  rv32_description.hart.vector.elen ~is 32
  rv32_description.hart.mmu_type ~is RiscvMmuType.Bare
  rv32_mini.boot.program.bytes ~is riscv_soc_boot_config().program.bytes
  rv32_mini.boot.image_for(rv32_description).size_bytes <= rv32_mini.boot.window_bytes ~is #true
  rv32_description.memory_regions[0].base ~is 0x80000000
  rv32_description.memory_regions[0].size_bytes ~is 0x10000
  rv32_description.to_device_tree().to_dts().contains("rv32i") ~is #true
  rv32_description ~is simulator_soc_description("mini-spike-rv32int")
  riscv_soc_boot_config().image_for(rv32_description).bytes ~is rv32_mini.boot.image_for(rv32_description).bytes
  riscv_soc_boot_config(~payload_address: 0x100000000).image_for(rv32_description) ~throws "XLEN"

// Simple keeps its full external memory and fabric widths with either RV32 hart.
for (core in [CoreKind.RV5Stage, CoreKind.Spike]):
  def selection = SoCSelection(SoCShape.Simple, core, IsaPreset.RV32Int)
  def resolved = resolve_soc_config(selection)
  def config = resolved.configuration()
  def description = config.description
  check:
    description.hart.isa_profile ~is rv32.isa
    description.hart.vector.vlen ~is 64
    description.hart.vector.elen ~is 32
    description.hart.mmu_type ~is RiscvMmuType.Bare
    description.memory_regions[0].base ~is 0x80000000
    description.memory_regions[0].size_bytes ~is 0x40000000
    description.memory_regions[0].contains(0xbfffffff) ~is #true
    config.params.fabric.flit.request_address_width ~is 44
    config.params.fabric.boot.program.bytes ~is riscv_soc_boot_config().program.bytes
    config.params.fabric.boot.image_for(description).size_bytes <= config.params.fabric.boot.window_bytes ~is #true
    simulator_soc_description(selection.key) ~is description
    description.to_device_tree().to_dts().contains("rv32i") ~is #true

// The FP preset adds F/Zve32f to the shared integer architecture on either core.
def rv32max = soc_architecture(IsaPreset.RV32Max)
def rv32max_compiler = gnu_isa_target(rv32max.isa.xlen, rv32max.isa.isa_extensions)
check:
  rv32max.vector ~is VectorProfile.Zve32f
  rv32max.vector_length ~is 64
  rv32max_compiler.march.starts_with("rv32imafcb_") ~is #true
  rv32max_compiler.mabi ~is "ilp32f"
  rv32max.isa.misa_extension_bits ~is 0x141127
  rv32max.isa.isa_extensions.filter(~keep: fun (name): name != "f" && name != "zve32f") ~is rv32.isa.isa_extensions
for (shape in [SoCShape.Mini, SoCShape.Simple]):
  for (core in [CoreKind.RV5Stage, CoreKind.Spike]):
    def config = resolve_soc_config(SoCSelection(shape, core, IsaPreset.RV32Max))
    check:
      config.description.hart.isa_profile ~is rv32max.isa
      config.description.hart.vector.elen ~is 32
      config.description.hart.vector.vlen ~is 64
      config.description.hart.mmu_type ~is RiscvMmuType.Bare
      config.udb().to_yaml().contains("{ name: \"Zcf\",") ~is #true

// RV64Max preserves RVA23's vector/supervisor contract without H or its dependent guarantees.
def rva23 = soc_architecture(IsaPreset.RVA23)
def rv64max = soc_architecture(IsaPreset.RV64Max)
check:
  rv64max.isa.xlen ~is XLen.X64
  rv64max.mmu ~is RiscvMmuType.Sv39
  rv64max.vector ~is VectorProfile.V
  rv64max.vector_length ~is 128
  rv64max.vector_extensions ~is rva23.vector_extensions
  rv64max.isa.isa_extensions ~is rva23.isa.isa_extensions.filter(~keep: fun (name): name != "h" && !name.starts_with("sh"))
  rv64max.isa.misa_extensions ~is rva23.isa.misa_extensions.filter(~keep: fun (extension): extension != MisaExtension.H)
  gnu_isa_target(rv64max.isa.xlen, rv64max.isa.isa_extensions).mabi ~is "lp64d"
for (shape in [SoCShape.Mini, SoCShape.Simple, SoCShape.Tiled]):
  for (core in [CoreKind.RV5Stage, CoreKind.Spike]):
    def selection = SoCSelection(shape, core, IsaPreset.RV64Max)
    def config = resolve_soc_config(selection)
    def max_udb = config.udb()
    def rva23_udb = resolve_soc_config(SoCSelection(shape, core, IsaPreset.RVA23)).udb()
    check:
      named_soc_selection(selection.key) ~is selection
      config.description.hart.isa_profile ~is rv64max.isa
      config.description.hart.vector.vlen ~is 128
      config.description.hart.vector.elen ~is 64
      config.description.hart.mmu_type ~is RiscvMmuType.Sv39
      max_udb.extensions ~is rva23_udb.extensions.filter(~keep: fun (extension): extension.name != "H" && !extension.name.starts_with("Sh"))
      max_udb.to_yaml().contains("  VLEN: 128") ~is #true
      max_udb.to_yaml().contains("  VSSTATUS_VS_EXISTS: false") ~is #true

// Lean scalar presets share Sv39 and fixed core guarantees, with only F/D distinguishing them.
def scalar_integer = soc_architecture(IsaPreset.RV64IMACB)
def scalar_fp = soc_architecture(IsaPreset.RV64IMAFDCB)
check:
  scalar_integer.isa.isa_extensions ~is ["i", "m", "a", "c", "b", "za64rs", "zba", "zbb", "zbs", "zic64b", "zicclsm", "zicntr", "zicond", "zicsr", "zifencei", "zihpm", "zimop", "zkt", "ssccptr", "sstvecd", "sstvala", "sscounterenw", "ssu64xl"]
  scalar_fp.isa.isa_extensions.filter(~keep: fun (name): name != "f" && name != "d") ~is scalar_integer.isa.isa_extensions
for ([preset, abi, prefix, misa] in [[IsaPreset.RV64IMACB, "lp64", "rv64imacb_", 0x141107], [IsaPreset.RV64IMAFDCB, "lp64d", "rv64imafdcb_", 0x14112f]]):
  def architecture = soc_architecture(preset)
  def compiler = gnu_isa_target(architecture.isa.xlen, architecture.isa.isa_extensions)
  check:
    architecture.vector ~is VectorProfile.None
    architecture.vector_extensions ~is []
    architecture.isa.misa_extension_bits ~is misa
    compiler.mabi ~is abi
    compiler.march.starts_with(prefix) ~is #true
  for (shape in [SoCShape.Mini, SoCShape.Simple, SoCShape.Tiled]):
    for (core in [CoreKind.RV5Stage, CoreKind.Spike]):
      def selection = SoCSelection(shape, core, preset)
      def config = resolve_soc_config(selection)
      def udb = config.udb()
      check:
        named_soc_selection(selection.key) ~is selection
        config.description.hart.isa_profile ~is architecture.isa
        config.description.hart.vector ~is #false
        config.description.hart.mmu_type ~is RiscvMmuType.Sv39
        udb.to_yaml().contains("  VLEN:") ~is #false
        (for any (entry in udb.extensions): entry.name == "Sv39") ~is #true
        (for any (entry in udb.extensions): entry.name == "D") ~is (preset == IsaPreset.RV64IMAFDCB)
