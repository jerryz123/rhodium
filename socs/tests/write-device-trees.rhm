#lang rhombus
// Writes DTB fixtures for enabled RV5Stage and requested Spike platform descriptions, without enabling Spike execution.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/cmdline open
  "../products/single-core-rv5stage-soc.rhdl" as single_core
  "../products/single-core-spike-soc.rhdl" as spike
  "../products/mini-rv5stage-soc.rhdl" as mini_rv5stage
  "../products/tiled-rv5stage.rhdl" as tiled_rv5stage
  "../mini-soc/main.rhdl" as mini
  "../tiled-soc/main.rhdl" as tiled
  "../harts/spike.rhdl".spike_hart

def arguments = current_command_line()
unless arguments.length() == 1
| error(~who: #'write_device_trees, "expected one output-directory argument")

def output_directory = arguments[0]
def trees = [
  ["single-core-rv5stage-soc", single_core.single_core_rv5stage_soc_params.description.to_device_tree()],
  ["single-core-spike-soc", spike.single_core_spike_soc_params.description.to_device_tree()],
  ["mini-rv5stage-soc", mini_rv5stage.mini_rv5stage_soc_params.description.to_device_tree()],
  ["tiled-rv5stage-soc", tiled_rv5stage.default_tiled_soc_config.description.to_device_tree()],
  ["mini-spike-soc", mini.mini_soc_config(spike_hart(spike.single_core_spike_soc_core_profile)).description.to_device_tree()],
  ["tiled-spike-soc", tiled.tiled_soc_config(spike_hart(spike.single_core_spike_soc_core_profile)).description.to_device_tree()]
]

for (entry in trees):
  def name = entry[0]
  def tree = entry[1]
  filesystem.write_bytes(Path.add(output_directory, name ++ ".dtb"), tree.to_dtb(), ~exists: #'truncate)
  filesystem.write_string(Path.add(output_directory, name ++ ".dts"), tree.to_dts(), ~exists: #'truncate)
