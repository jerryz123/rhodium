#lang rhombus
// Writes DTB interoperability fixtures for every RVA23 shape and hart implementation.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/cmdline open
  "../configs/selection.rhm" open
  "../configs/resolve.rhm".resolve_soc_config

def arguments = current_command_line()
unless arguments.length() == 1
| error(~who: #'write_device_trees, "expected one output-directory argument")

def output_directory = arguments[0]
for (shape in [SoCShape.Mini, SoCShape.Simple, SoCShape.Tiled4Core, SoCShape.Tiled8Core]):
  for (core in [CoreKind.RV5Stage, CoreKind.RV2Wide, CoreKind.Spike]):
    def config = resolve_soc_config(SoCSelection(shape, core, IsaPreset.RVA23))
    def name = soc_shape_name(shape) ++ "-" ++ core_kind_name(core) ++ "-soc"
    def tree = config.description.to_device_tree()
    filesystem.write_bytes(Path.add(output_directory, name ++ ".dtb"), tree.to_dtb(), ~exists: #'truncate)
    filesystem.write_string(Path.add(output_directory, name ++ ".dts"), tree.to_dts(), ~exists: #'truncate)
