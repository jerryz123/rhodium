#lang rhodium
// Provides two-hart distribution and time-sweep integration fixtures for behavioral testing.

import:
  lib("noc/authoring/main.rhm").VCGroup
  lib("noc/std/topology/main.rhm").rectangular_mesh
  lib("flow/main.rhdl") open
  "../tiled-soc/distribution.rhdl" open
  "../tiled-soc/time.rhdl" open

def DistributionHartCount = 2
def distribution_mesh = rectangular_mesh(2, 2, [VCGroup("transport", 1)])
def distribution_plan = compile_tiled_distribution(
  distribution_mesh,
  distribution_mesh.node_at(0, 1),
  distribution_mesh.node_at(1, 1),
  [distribution_mesh.node_at(0, 0), distribution_mesh.node_at(1, 0)]
)

sync_circuit TiledDistributionFixture():
  interface time_ingress(Irrevocable(TiledTimeBeat(DistributionHartCount)), ~role: consumer)
  interface interrupt_ingress(Irrevocable(IndexedState(TiledHartInterrupts(), DistributionHartCount)), ~role: consumer)
  interface external_interrupt_ingress(Irrevocable(IndexedState(TiledExternalInterrupts(), DistributionHartCount)), ~role: consumer)
  interface time_egress[DistributionHartCount](Decoupled(FramedFixedFlit(Bits(TiledTimeChunkWidth))), ~role: producer)
  interface interrupt_egress[DistributionHartCount](Decoupled(TiledHartInterrupts()), ~role: producer)
  interface external_interrupt_egress[DistributionHartCount](Decoupled(TiledExternalInterrupts()), ~role: producer)

  inst network(TiledDistributionNetwork(distribution_plan))
  time_ingress <=> network.time_ingress
  interrupt_ingress <=> network.interrupt_ingress
  external_interrupt_ingress <=> network.external_interrupt_ingress
  network.time_egress <=> time_egress
  network.interrupt_egress <=> interrupt_egress
  network.external_interrupt_egress <=> external_interrupt_egress

def distribution_design = elaborate(TiledDistributionFixture())

sync_circuit TiledTimeFixture():
  interface update(Valid(Bits(64)), ~role: consumer)
  input accepting: Vec(2, Bool)
  output hart_time: Vec(2, Bits(64))
  output offered: TiledTimeBeat(2)
  output offer_valid: Bool
  output transferred: Bool

  inst sweeper(TiledTimeSweeper(2))
  update |> sweeper.update
  offered <== sweeper.egress.bits
  offer_valid <== sweeper.egress.valid
  def lanes = sweeper.egress |> demux_flow(2, beat => beat.hart)
  for (index in 0..2):
    inst receiver(TiledTimeReceiver())
    lanes[index] |> gate_flow(accepting[index]) |> map_flow(beat => beat.flit) |> receiver.ingress
    hart_time[index] <== receiver.value
  transferred <== sweeper.egress.fire()

def time_design = elaborate(TiledTimeFixture())

export:
  DistributionHartCount
  distribution_mesh
  distribution_plan
  TiledDistributionFixture
  distribution_design
  time_design
