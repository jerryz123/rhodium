#lang rhombus
// Checks shared system parameter derivation with independent addresses, widths, and NodeIDs.
// SPDX-License-Identifier: Apache-2.0

import:
  "../single-core-system.rhdl" open
  "../endpoint-params.rhdl" open
  "../../rhodium/std/interconnect.rhdl" open
  "../../chi/protocol/params.rhdl".CHIFlitParams
  "../../chi/protocol/flits.rhdl" open
  "../../chi/protocol/link.rhdl" open
  "../../chi/protocol/fabric.rhdl" open
  "../peripherals.rhdl" open
  "../boot.rhdl" open

def p = CHIFlitParams(~data_width: 256)
def transfers = TransferSizes(1, 64)
def memory = CHIICNPortParams(
  "external-memory", 19, CHINodeKind.SNF,
  ~emits: CHIChannelCapabilities(
    ~req: [CHIReqOpcode.ReadNoSnp, CHIReqOpcode.WriteNoSnpFull, CHIReqOpcode.WriteNoSnpPtl],
    ~dat: [CHIDatOpcode.NonCopyBackWriteData]
  ),
  ~supports: CHIChannelCapabilities(
    ~rsp: [CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp],
    ~dat: [CHIDatOpcode.CompData]
  ),
  ~max_outstanding: 2
)
def service = CHISubordinateServiceParams(
  memory, [AddressSet(0x40000000, 0x1ffff)],
  [CHIRequestSupport(CHIReqOpcode.ReadNoSnp, transfers),
   CHIRequestSupport(CHIReqOpcode.WriteNoSnpFull, transfers),
   CHIRequestSupport(CHIReqOpcode.WriteNoSnpPtl, transfers)]
)

fun system_params(base :: Nat = 0x40000000, instruction_id :: Nat = 12, payload :: Nat = 0x40000000, register_base :: Nat = SoCBootAddressBase) :: SingleCoreSystemParams:
  SingleCoreSystemParams(
    p, base, 0x20000, service,
    CHIHomeParams("memory-home", 15, CHINodeKind.HNF, ~max_outstanding: 1),
    soc_host_node(11),
    SoCPlatformParams(p, 1,
                      CHIHomeParams("device-home", 16, CHINodeKind.HNI, ~max_outstanding: 1),
                      riscv_soc_boot_config(~payload_address: payload, ~boot_address_register: register_base), 21, 20, 23, 22, 24),
    ~instruction_node_id: instruction_id, ~data_node_id: 13, ~uncached_node_id: 14
  )

def params = system_params()
def relocated = system_params(0x40000000, 12, 0x40002000, 0x3000)
check:
  relocated.platform.boot_address.base_address ~is 0x3000
  relocated.platform.boot_address_config.reset_value ~is 0
  relocated.home_map.entry(0x3000).home.node_id ~is 16
  relocated.home_map.entry(0x1000) ~is #false
  relocated.boot.program.size_bytes ~is 40
  riscv_soc_boot_config(~boot_address_register: 0x1008) ~throws "page aligned"
  system_params(0x40000000, 12, 0x40000000, 0x40000000).rv5stage_config ~throws "overlap"
  params.device_home_params.requester_endpoints[1].kind ~is CHINodeKind.RNF
  params.device_home_params.requester_endpoints[1].supports.req ~is [CHIReqOpcode.ReadNoSnp, CHIReqOpcode.WriteNoSnpPtl]
  params.device_home_params.requester_endpoints[1].emits.snp ~is []
  params.device_home_params.requester_endpoints[2].node_id ~is 12
  params.device_home_params.requester_endpoints[2].supports.req ~is [CHIReqOpcode.ReadNoSnp]
  params.device_home_params.requester_endpoints[2].supports.rsp ~is []
  params.home_config.requester_endpoints[1].supports.req ~is [CHIReqOpcode.ReadOnce]
  params.home_config.requester_endpoints[0].supports.req ~is [CHIReqOpcode.ReadClean, CHIReqOpcode.WriteUniquePtl]
  params.host_services.length() ~is 6
  params.boot_address_site.node_id ~is 24
  params.device_home_params.subordinate_map.entry(SoCBootAddressBase).target_node_id ~is 24
  params.flit.data_width ~is 256
  params.memory_port.node_id ~is 19
  params.home_map.entry(0x40000000).home.node_id ~is 15
  params.home_map.entry(0x4001ffff).home.node_id ~is 15
  params.home_map.entry(0x40020000) ~is #false
  params.home_map.entry(SoCAclintBase).home.node_id ~is 16
  params.rv5stage_config.flit.data_width ~is 256
  params.home_params.subordinate_endpoint.node_id ~is 19
  params.device_home_params.home.node_id ~is 16
  params.instruction_site.node_id ~is 12
  params.data_site.node_id ~is 13
  params.uncached_site.node_id ~is 14
  params.device_home_params.subordinate_map.entry(SoCAclintBase).target_node_id ~is 20
  params.compilations.req.routes.map(fun (route): [route.source.node_id, route.destination.node_id]) ~is (
    [[16, 20], [16, 24], [16, 21], [16, 23], [16, 22], [11, 16], [11, 15], [13, 15], [12, 16], [12, 15], [14, 16]]
  )
  system_params(0x50000000).memory_region ~throws "memory service must cover"
  system_params(0x40000000, 12, 0x50000000).memory_region ~throws "payload address"
  system_params(0x40000000, 11).home_config ~throws "requester NodeIDs must be unique"
