#lang rhodium
// Elaborates default and compact author-facing TiledSoC configurations.

import:
  "../tiled-soc/main.rhdl" open

def tiled_soc_design = elaborate(TiledSoC())

def compact_layout = tile_grid:
  row [llc(2)]
  row [host, device_home]
  row [aclint, uart]
  row [rv5stage, transit]
def compact_config = TiledSoCConfig(
  ~layout: compact_layout,
  ~node_ids: TiledNodeIds(
    ~rv5stage_coherent_base: 0,
    ~rv5stage_uncached_base: 2,
    ~host: 3,
    ~llc_home_base: 4,
    ~device_home: 6,
    ~backing_memory_base: 7,
    ~bootrom_subordinate: 11,
    ~aclint_subordinate: 9,
    ~uart_subordinate: 10
  ),
  ~memory: StripedMemory(
    ~base: 0x80000000,
    ~bank_bytes: 0x1000,
    ~stripe_bytes: 64
  ),
  ~llc: LLCGeometry(
    ~sets: 8,
    ~ways: 2
  ),
  ~timebase_period_cycles: 8
)
def compact_tiled_soc_design = elaborate(TiledSoC(compact_config))

export:
  tiled_soc_design
  compact_config
  compact_tiled_soc_design
