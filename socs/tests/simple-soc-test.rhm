#lang rhombus
// Checks bootable SimpleSoC host configuration, address maps, and routing plans.

import:
  "../../chi/main.rhdl" as chi
  "../../socs/simple-soc.rhdl" as soc

def snp_adapters :: chi.CHIChannelAdapterPlan = soc.simple_soc_adapter_plans.snp
def compact_soc_params = soc.SimpleSoCParams(
  soc.simple_soc_params.fabric,
  ~llc_sets: 16,
  ~llc_ways: 2
)
def description = soc.simple_soc_params.description
check:
  soc.simple_soc_core_profile.extensions.zicbop ~is #true
  soc.simple_soc_topology.injections ~is []
  soc.simple_soc_topology.ejections ~is []
  soc.simple_soc_home_map.entry(0x1000).home === soc.simple_soc_device_home ~is #true
  soc.simple_soc_home_map.entry(0x2000) ~is #false
  soc.simple_soc_device_home_params.subordinate_map.entry(0x1000).target_node_id ~is 14
  description.boot.address_register.address_set ~is soc.simple_soc_platform.boot_address.service.address_sets[0]
  soc.simple_soc_platform.boot_address_config.reset_value ~is soc.simple_soc_params.fabric.boot.payload_address
  soc.simple_soc_home_map.entry(0x80000000).home === soc.simple_soc_home ~is #true
  soc.simple_soc_home_map.entry(0xbfffffff).home === soc.simple_soc_home ~is #true
  soc.simple_soc_home_map.entry(0xc0000000) ~is #false
  soc.simple_soc_home_map.entry(0x00010000).home === soc.simple_soc_device_home ~is #true
  soc.simple_soc_home_map.entry(0x00011fff).home === soc.simple_soc_device_home ~is #true
  soc.simple_soc_home_map.entry(0x00012000) ~is #false
  soc.simple_soc_home_map.entry(0x02000000).home === soc.simple_soc_device_home ~is #true
  soc.simple_soc_home_map.entry(0x02010000) ~is #false
  soc.simple_soc_home_map.entry(0x0c000000).home === soc.simple_soc_device_home ~is #true
  soc.simple_soc_home_map.entry(0x10000000 - 1).home === soc.simple_soc_device_home ~is #true
  soc.simple_soc_home_map.entry(0x10000000).home === soc.simple_soc_device_home ~is #true
  soc.simple_soc_home_map.entry(0x10000008) ~is #false
  soc.simple_soc_device_home_params.subordinate_map.entry(0x00010000).target_node_id ~is 12
  soc.simple_soc_device_home_params.subordinate_map.entry(0x02000000).target_node_id ~is 10
  soc.simple_soc_device_home_params.subordinate_map.entry(0x0c000000).target_node_id ~is 13
  soc.simple_soc_device_home_params.subordinate_map.entry(0x10000000).target_node_id ~is 11
  soc.simple_soc_host_node.kind ~is chi.CHINodeKind.RNF
  soc.simple_soc_host_node.emits.req ~is (
    [chi.CHIReqOpcode.ReadClean, chi.CHIReqOpcode.WriteUniquePtl, chi.CHIReqOpcode.ReadNoSnp, chi.CHIReqOpcode.WriteNoSnpPtl]
  )
  soc.simple_soc_host_node.supports.snp ~is chi.chi_rnf_snoop_opcodes
  soc.simple_soc_memory_node.kind ~is chi.CHINodeKind.SNF
  soc.simple_soc_memory_node.node_id ~is 9
  soc.simple_soc_params.llc_config.sets ~is 64
  soc.simple_soc_params.llc_config.ways ~is 4
  soc.simple_soc_params.llc_config.capacity_bytes ~is 16384
  description.model ~is "Rhodium SimpleSoC"
  description.compatible ~is ["rhodium,simple-soc"]
  description.harts ~is [0]
  description.core_profile === soc.simple_soc_params.core_profile ~is #true
  description.clocks === soc.simple_soc_params.clocks ~is #true
  description.memory_regions[0].address_set ~is soc.simple_soc_memory_service.address_sets[0]
  description.boot.rom.address_set ~is soc.simple_soc_platform.bootrom.rom_params.service.address_sets[0]
  description.boot.rom.size_bytes ~is 0x2000
  soc.simple_soc_bootrom_config.image.bytes.drop(soc.simple_soc_params.fabric.boot.device_tree_offset) ~is (
    description.to_device_tree().to_dtb().to_list()
  )
  description.aclint.region.address_set ~is soc.simple_soc_aclint_params.service.address_sets[0]
  description.plic.region.address_set ~is soc.simple_soc_plic_params.service.address_sets[0]
  description.plic.priority_width ~is 3
  description.plic.sources[0].source_id ~is 1
  description.plic.contexts.length() ~is 2
  description.uart.region.address_set ~is soc.simple_soc_uart_params.service.address_sets[0]
  compact_soc_params.llc_config.sets ~is 16
  compact_soc_params.llc_config.ways ~is 2
  compact_soc_params.llc_config.capacity_bytes ~is 2048
  soc.simple_soc_memory_service.endpoint === soc.simple_soc_memory_port ~is #true
  soc.simple_soc_memory_service.supports(chi.CHIReqOpcode.ReadNoSnp, 16) ~is #true
  soc.simple_soc_memory_service.supports(chi.CHIReqOpcode.ReadNoSnp, 64) ~is #true
  soc.simple_soc_memory_service.supports(chi.CHIReqOpcode.WriteNoSnpFull, 64) ~is #true
  soc.simple_soc_compilations.req.network.validated_routing.dependency_graph.vertices ~is []
  soc.simple_soc_compilations.rsp.network.validated_routing.dependency_graph.vertices ~is []
  soc.simple_soc_snp_compilation.network.validated_routing.dependency_graph.vertices ~is []
  soc.simple_soc_compilations.dat.network.validated_routing.dependency_graph.vertices ~is []
  soc.simple_soc_compilations.req.routes.map(
    fun (route):
      [route.source.node_id,
       route.destination.node_id,
       route.route_key]
  ) ~is [[6, 10, 0], [6, 14, 1], [6, 12, 2], [6, 13, 3], [6, 11, 4], [1, 6, 5], [1, 5, 6], [3, 5, 7], [2, 5, 8], [4, 6, 9]]
  soc.simple_soc_req_router_config.input_count ~is 5
  soc.simple_soc_req_router_config.target_count ~is 7
  soc.simple_soc_rsp_router_config.input_count ~is 11
  soc.simple_soc_rsp_router_config.target_count ~is 7
  soc.simple_soc_snp_router_config.input_count ~is 1
  soc.simple_soc_snp_router_config.target_count ~is 3
  soc.simple_soc_dat_router_config.input_count ~is 12
  soc.simple_soc_dat_router_config.target_count ~is 12
  soc.simple_soc_adapter_plans.req.injections.length() ~is 5
  soc.simple_soc_adapter_plans.rsp.injections.length() ~is 11
  snp_adapters.injections.length() ~is 1
  snp_adapters.ejections.length() ~is 3
  soc.simple_soc_adapter_plans.dat.injections.length() ~is 12
  soc.simple_soc_host_site.req.terminal.describe() ~is "requesters/host/req"
  soc.simple_soc_host_site.snp.terminal.describe() ~is "requesters/host/snp"
  soc.simple_soc_instruction_site.snp.terminal.describe() ~is "requesters/rv5stage-l1i/snp"
  soc.simple_soc_data_site.snp.terminal.describe() ~is "requesters/rv5stage-l1d/snp"
  soc.simple_soc_uncached_site.req.terminal.describe() ~is "requesters/rv5stage-uncached/req"
  soc.simple_soc_home_requester_site.req.terminal.describe() ~is "home/requesters/req"
  soc.simple_soc_device_home_requester_site.req.terminal.describe() ~is "device-home/requesters/req"
  soc.simple_soc_device_home_subordinate_site.req.terminal.describe() ~is "device-home/subordinate/req"
  soc.simple_soc_bootrom_site.req.terminal.describe() ~is "devices/bootrom/req"
  soc.simple_soc_plic_site.req.terminal.describe() ~is "devices/plic/req"
  soc.simple_soc_uart_site.req.terminal.describe() ~is "devices/uart/req"
