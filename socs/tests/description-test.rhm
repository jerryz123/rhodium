#lang rhombus
// Checks generic RISC-V SoC descriptions and their architectural invariants.

import:
  "../description.rhm" open
  "../../cores/rv5stage/profile.rhm" open
  "../../devicetree/main.rhm".DeviceTreeLabel
  "../../rhodium/std/interconnect.rhdl".AddressSet
  "../../riscv/isa/xlen.rhm".XLen

def profile = RVCoreProfile(
  ~xlen: XLen.X64,
  ~mmu_mode: RV5StageMmuMode.Sv39
)
def clocks = SoCClockConfig(
  ~clock_frequency_hz: 100000000,
  ~timebase_frequency_hz: 1000000
)
def memory = SoCAddressRegion(AddressSet(0x80000000, 0x3fffffff))
def rom = SoCAddressRegion(AddressSet(0x00010000, 0xfff))
def aclint = RiscvAclintDescription(
  SoCAddressRegion(AddressSet(0x02000000, 0xffff))
)
def uart = RiscvUartDescription(
  SoCAddressRegion(AddressSet(0x10000000, 0x7))
)
def boot = RiscvBootLayout(
  ~rom: rom,
  ~reset_address: 0x00010000,
  ~payload_address: 0x80000000
)
def description = RiscvSoCDescription(
  ~model: "Rhodium test SoC",
  ~compatible: ["rhodium,test-soc", "riscv"],
  ~harts: [0, 1],
  ~core_profile: profile,
  ~clocks: clocks,
  ~memory_regions: [memory],
  ~boot: boot,
  ~aclint: aclint,
  ~uart: uart
)
def no_uart_description = RiscvSoCDescription(
  ~model: "Rhodium UART-free SoC",
  ~compatible: ["rhodium,uart-free-soc"],
  ~harts: [0],
  ~core_profile: profile,
  ~clocks: clocks,
  ~memory_regions: [memory],
  ~boot: boot,
  ~aclint: aclint
)
def tree = description.to_device_tree()
def dts = tree.to_dts()
def dtb = tree.to_dtb()

fun be32(bytes, offset):
  (bytes[offset] * 0x1000000) + (bytes[offset + 1] * 0x10000) + (bytes[offset + 2] * 0x100) + bytes[offset + 3]

check:
  clocks.timebase_period_cycles ~is 100
  memory.base ~is 0x80000000
  memory.size_bytes ~is 0x40000000
  description.harts ~is [0, 1]
  description.uart === uart ~is #true
  tree.boot_cpuid ~is 0
  tree.phandle_for(DeviceTreeLabel("cpu_intc_0")) ~is 1
  tree.phandle_for(DeviceTreeLabel("cpu_intc_1")) ~is 2
  dtb is_a ImmutableBytes ~is #true
  be32(dtb, 0) ~is 0xd00dfeed
  dts.contains("model = \"Rhodium test SoC\";") ~is #true
  dts.contains("riscv,isa-base = \"rv64i\";") ~is #true
  dts.contains("riscv,isa-extensions = \"i\", \"m\", \"a\"") ~is #true
  dts.contains("mmu-type = \"riscv,sv39\";") ~is #true
  dts.contains("reg = <0x0 0x80000000 0x0 0x40000000>;") ~is #true
  dts.contains("interrupts-extended = <&cpu_intc_0 0x3 &cpu_intc_0 0x7 &cpu_intc_1 0x3 &cpu_intc_1 0x7>;") ~is #true
  dts.contains("serial@10000000 {") ~is #true
  dts.contains("status = \"disabled\";") ~is #true

check:
  SoCClockConfig(
    ~clock_frequency_hz: 100000000,
    ~timebase_frequency_hz: 3000000
  ) ~throws "integer multiple"
  SoCAddressRegion(AddressSet(0x80000000, 0x2fff)) ~throws "contiguous"
  RiscvBootLayout(
    ~rom: rom,
    ~reset_address: 0x20000,
    ~payload_address: 0x80000000
  ) ~throws "reset address"
  RiscvSoCDescription(
    ~model: "duplicate harts",
    ~compatible: ["rhodium,test-soc"],
    ~harts: [0, 0],
    ~core_profile: profile,
    ~clocks: clocks,
    ~memory_regions: [memory],
    ~boot: boot,
    ~aclint: aclint
  ) ~throws "hart IDs"
  RiscvSoCDescription(
    ~model: "missing payload",
    ~compatible: ["rhodium,test-soc"],
    ~harts: [0],
    ~core_profile: profile,
    ~clocks: clocks,
    ~memory_regions: [SoCAddressRegion(AddressSet(0x90000000, 0xffff))],
    ~boot: boot,
    ~aclint: aclint
  ) ~throws "boot payload"
  RiscvSoCDescription(
    ~model: "overlap",
    ~compatible: ["rhodium,test-soc"],
    ~harts: [0],
    ~core_profile: profile,
    ~clocks: clocks,
    ~memory_regions: [SoCAddressRegion(AddressSet(0x02000000, 0xffff))],
    ~boot: RiscvBootLayout(
      ~rom: rom,
      ~reset_address: 0x00010000,
      ~payload_address: 0x02000000
    ),
    ~aclint: aclint
  ) ~throws "must not overlap"
  no_uart_description.uart ~is #false
  no_uart_description.to_device_tree().to_dts().contains("serial@") ~is #false
  RiscvSoCDescription(
    ~model: "out-of-range DT hart",
    ~compatible: ["rhodium,test-soc"],
    ~harts: [0x100000000],
    ~core_profile: profile,
    ~clocks: clocks,
    ~memory_regions: [memory],
    ~boot: boot,
    ~aclint: aclint
  ).to_device_tree() ~throws "32-bit"
