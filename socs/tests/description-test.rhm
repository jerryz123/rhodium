#lang rhombus
// Checks generic RISC-V SoC descriptions and their architectural invariants.
// SPDX-License-Identifier: Apache-2.0

import:
  "../description.rhm" open
  "../../cores/rv5stage/profile.rhm" open
  "../../devicetree/main.rhm".DeviceTreeLabel
  "../../rhodium/std/interconnect.rhdl".AddressSet
  "../../riscv/isa/interrupt.rhm".InterruptCause
  "../../riscv/isa/xlen.rhm".XLen

def profile = RVCoreProfile(
  ~xlen: XLen.X64,
  ~extensions: RV5StageExtensions(~zicboz: #true, ~zawrs: #true, ~zihintpause: #true),
  ~mmu_mode: RV5StageMmuMode.Sv39
)
def clocks = SoCClockConfig(
  ~clock_frequency_hz: 100000000,
  ~timebase_frequency_hz: 1000000
)
def memory = SoCAddressRegion(AddressSet(0x80000000, 0x3fffffff))
def rom = SoCAddressRegion(AddressSet(0x00010000, 0xfff))
def aclint = RiscvAclintDescription(
  SoCAddressRegion(AddressSet(0x02000000, 0xffff))
)
def plic = RiscvPlicDescription(
  SoCAddressRegion(AddressSet(0x0c000000, 0x03ffffff)),
  3,
  [RiscvPlicSource(1, "uart")],
  [RiscvPlicContext(0, InterruptCause.MachineExternal),
   RiscvPlicContext(0, InterruptCause.SupervisorExternal),
   RiscvPlicContext(1, InterruptCause.MachineExternal),
   RiscvPlicContext(1, InterruptCause.SupervisorExternal)]
)
def uart = RiscvUartDescription(
  SoCAddressRegion(AddressSet(0x10000000, 0x7)),
  RiscvPlicInterrupt(plic.region, 1)
)
def boot = RiscvBootLayout(
  ~rom: rom,
  ~reset_address: 0x00010000,
  ~payload_address: 0x80000000
)
def description = RiscvSoCDescription(
  ~model: "Rhodium test SoC",
  ~compatible: ["rhodium,test-soc", "riscv"],
  ~harts: [0, 1],
  ~core_profile: profile,
  ~clocks: clocks,
  ~memory_regions: [memory],
  ~boot: boot,
  ~aclint: aclint,
  ~plic: plic,
  ~uart: uart
)
def no_uart_description = RiscvSoCDescription(
  ~model: "Rhodium UART-free SoC",
  ~compatible: ["rhodium,uart-free-soc"],
  ~harts: [0],
  ~core_profile: profile,
  ~clocks: clocks,
  ~memory_regions: [memory],
  ~boot: boot,
  ~aclint: aclint
)
def tree = description.to_device_tree()
def dts = tree.to_dts()
def dtb = tree.to_dtb()

fun with_interrupts(controller, serial):
  RiscvSoCDescription(
    ~model: description.model,
    ~compatible: description.compatible,
    ~harts: description.harts,
    ~core_profile: profile,
    ~clocks: clocks,
    ~memory_regions: [memory],
    ~boot: boot,
    ~aclint: aclint,
    ~plic: controller,
    ~uart: serial
  )

def relocated_plic = RiscvPlicDescription(
  SoCAddressRegion(AddressSet(0x04000000, 0x03ffffff)),
  3,
  [RiscvPlicSource(7, "uart"), RiscvPlicSource(2, "other")],
  [RiscvPlicContext(1, InterruptCause.SupervisorExternal),
   RiscvPlicContext(0, InterruptCause.MachineExternal)]
)
def relocated_tree = with_interrupts(
  relocated_plic,
  RiscvUartDescription(uart.region, RiscvPlicInterrupt(relocated_plic.region, 7))
).to_device_tree()
def relocated_dts = relocated_tree.to_dts()

fun be32(bytes, offset):
  (bytes[offset] * 0x1000000) + (bytes[offset + 1] * 0x10000) + (bytes[offset + 2] * 0x100) + bytes[offset + 3]

check:
  clocks.timebase_period_cycles ~is 100
  memory.base ~is 0x80000000
  memory.size_bytes ~is 0x40000000
  description.harts ~is [0, 1]
  description.plic === plic ~is #true
  description.plic.sources[0].source_id ~is 1
  description.plic.contexts.map(fun (context): context.hart) ~is [0, 0, 1, 1]
  description.plic.contexts.map(fun (context): context.interrupt) ~is (
    [InterruptCause.MachineExternal, InterruptCause.SupervisorExternal,
     InterruptCause.MachineExternal, InterruptCause.SupervisorExternal]
  )
  description.uart === uart ~is #true
  tree.boot_cpuid ~is 0
  tree.phandle_for(DeviceTreeLabel("cpu_intc_0")) ~is 1
  tree.phandle_for(DeviceTreeLabel("cpu_intc_1")) ~is 2
  tree.phandle_for(DeviceTreeLabel("plic_c000000")) ~is 3
  dtb is_a ImmutableBytes ~is #true
  be32(dtb, 0) ~is 0xd00dfeed
  dts.contains("model = \"Rhodium test SoC\";") ~is #true
  dts.contains("riscv,isa-base = \"rv64i\";") ~is #true
  dts.contains("riscv,isa-extensions = \"i\", \"m\", \"a\"") ~is #true
  dts.contains("\"zawrs\"") ~is #true
  dts.contains("\"zihintpause\"") ~is #true
  dts.contains("mmu-type = \"riscv,sv39\";") ~is #true
  dts.contains("riscv,cboz-block-size = <0x40>;") ~is #true
  dts.contains("reg = <0x0 0x80000000 0x0 0x40000000>;") ~is #true
  dts.contains("interrupts-extended = <&cpu_intc_0 0x3 &cpu_intc_0 0x7 &cpu_intc_1 0x3 &cpu_intc_1 0x7>;") ~is #true
  dts.contains("serial@10000000 {") ~is #true
  dts.contains("compatible = \"sifive,plic-1.0.0\";") ~is #true
  dts.contains("riscv,ndev = <0x1>;") ~is #true
  dts.contains("interrupts-extended = <&cpu_intc_0 0xb &cpu_intc_0 0x9 &cpu_intc_1 0xb &cpu_intc_1 0x9>;") ~is #true
  dts.contains("interrupt-parent = <&plic_c000000>;") ~is #true
  dts.contains("interrupts = <0x1>;") ~is #true
  uart.interrupt.controller.address_set ~is plic.region.address_set
  uart.interrupt.source_id ~is 1
  relocated_plic.source_count ~is 7
  relocated_dts.contains("riscv,ndev = <0x7>;") ~is #true
  relocated_dts.contains("interrupts = <0x7>;") ~is #true
  relocated_dts.contains("interrupt-parent = <&plic_4000000>;") ~is #true
  relocated_dts.contains("interrupts-extended = <&cpu_intc_1 0x9 &cpu_intc_0 0xb>;") ~is #true
  relocated_tree.phandle_for(DeviceTreeLabel("plic_4000000")) ~is 3
  relocated_tree.to_dtb() is_a ImmutableBytes ~is #true
  with_interrupts(plic, #false).to_device_tree().to_dts().contains("riscv,ndev = <0x1>;") ~is #true
  with_interrupts(#false, uart) ~throws "requires a described PLIC"
  with_interrupts(relocated_plic, uart) ~throws "described PLIC region"
  with_interrupts(plic, RiscvUartDescription(uart.region, RiscvPlicInterrupt(plic.region, 2))) ~throws "described PLIC source"
  with_interrupts(relocated_plic, RiscvUartDescription(uart.region, RiscvPlicInterrupt(relocated_plic.region, 3))) ~throws "described PLIC source"
  RiscvPlicInterrupt(plic.region, 0) ~throws "PosInt"

check:
  SoCClockConfig(
    ~clock_frequency_hz: 100000000,
    ~timebase_frequency_hz: 3000000
  ) ~throws "integer multiple"
  SoCAddressRegion(AddressSet(0x80000000, 0x2fff)) ~throws "contiguous"
  RiscvBootLayout(
    ~rom: rom,
    ~reset_address: 0x20000,
    ~payload_address: 0x80000000
  ) ~throws "reset address"
  RiscvSoCDescription(
    ~model: "duplicate harts",
    ~compatible: ["rhodium,test-soc"],
    ~harts: [0, 0],
    ~core_profile: profile,
    ~clocks: clocks,
    ~memory_regions: [memory],
    ~boot: boot,
    ~aclint: aclint
  ) ~throws "hart IDs"
  RiscvSoCDescription(
    ~model: "missing payload",
    ~compatible: ["rhodium,test-soc"],
    ~harts: [0],
    ~core_profile: profile,
    ~clocks: clocks,
    ~memory_regions: [SoCAddressRegion(AddressSet(0x90000000, 0xffff))],
    ~boot: boot,
    ~aclint: aclint
  ) ~throws "boot payload"
  RiscvSoCDescription(
    ~model: "overlap",
    ~compatible: ["rhodium,test-soc"],
    ~harts: [0],
    ~core_profile: profile,
    ~clocks: clocks,
    ~memory_regions: [SoCAddressRegion(AddressSet(0x02000000, 0xffff))],
    ~boot: RiscvBootLayout(
      ~rom: rom,
      ~reset_address: 0x00010000,
      ~payload_address: 0x02000000
    ),
    ~aclint: aclint
  ) ~throws "must not overlap"
  RiscvPlicDescription(
    SoCAddressRegion(AddressSet(0x0c000000, 0x03ffffff)),
    3,
    [RiscvPlicSource(1, "uart"), RiscvPlicSource(1, "duplicate")],
    [RiscvPlicContext(0, InterruptCause.MachineExternal)]
  ) ~throws "source IDs"
  RiscvPlicDescription(
    SoCAddressRegion(AddressSet(0x0c000000, 0x03ffffff)),
    3,
    [RiscvPlicSource(1, "uart")],
    [RiscvPlicContext(0, InterruptCause.MachineExternal),
     RiscvPlicContext(0, InterruptCause.MachineExternal)]
  ) ~throws "context pairs"
  RiscvPlicContext(0, InterruptCause.MachineTimer) ~throws "external interrupts"
  RiscvSoCDescription(
    ~model: "unknown PLIC hart",
    ~compatible: ["rhodium,test-soc"],
    ~harts: [0],
    ~core_profile: profile,
    ~clocks: clocks,
    ~memory_regions: [memory],
    ~boot: boot,
    ~aclint: aclint,
    ~plic: RiscvPlicDescription(
      SoCAddressRegion(AddressSet(0x0c000000, 0x03ffffff)),
      3,
      [RiscvPlicSource(1, "uart")],
      [RiscvPlicContext(1, InterruptCause.MachineExternal)]
    )
  ) ~throws "described harts"
  no_uart_description.uart ~is #false
  no_uart_description.to_device_tree().to_dts().contains("serial@") ~is #false
  RiscvSoCDescription(
    ~model: "out-of-range DT hart",
    ~compatible: ["rhodium,test-soc"],
    ~harts: [0x100000000],
    ~core_profile: profile,
    ~clocks: clocks,
    ~memory_regions: [memory],
    ~boot: boot,
    ~aclint: aclint
  ).to_device_tree() ~throws "32-bit"
