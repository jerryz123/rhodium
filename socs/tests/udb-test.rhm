#lang rhombus
// Checks the core-neutral catalog of concrete RISC-V UDB configurations.
// SPDX-License-Identifier: Apache-2.0

import:
  "../products/udb.rhm" open
  "../products/core-profiles.rhm" open
  "../products/spike-core-profile.rhm".single_core_spike_soc_core_profile
  "../platform/fabric-profiles.rhm" open
  "../../riscv/gnu-toolchain.rhm".gnu_isa_target

def single_core_gnu_target = gnu_isa_target(
  single_core_rv5stage_soc_core_profile.xlen,
  single_core_rv5stage_soc_core_profile.isa_profile.isa_extensions
)

for (profile in [single_core_rv5stage_soc_core_profile, mini_rv5stage_soc_core_profile, tiled_rv5stage_soc_core_profile]):
  check:
    profile.isa_profile.isa_extensions.contains("ziccif") ~is #true
    profile.isa_profile.isa_extensions.contains("ziccamoa") ~is #true
    profile.extensions.ziccrse ~is #true
    profile.isa_profile.isa_extensions.contains("ziccrse") ~is #true
    profile.isa_profile.isa_extensions.contains("zic64b") ~is #true
    profile.isa_profile.isa_extensions.contains("za64rs") ~is #true
    profile.isa_profile.isa_extensions.contains("zkt") ~is #true
    profile.extensions.zawrs ~is #true
    profile.extensions.zihintpause ~is #true
    profile.extensions.zihintntl ~is #true
    profile.isa_profile.isa_extensions.contains("zihintntl") ~is #true
    profile.isa_profile.isa_extensions.contains("zihintpause") ~is #true
    profile.isa_profile.isa_extensions.contains("zawrs") ~is #true

for (name in ["simple-rv5stage-rva23", "mini-rv5stage-rva23", "tiled-rv5stage-rva23"]):
  check:
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Ziccif\", version: \"= 1.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Ziccamoa\", version: \"= 1.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Ziccrse\", version: \"= 1.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Zic64b\", version: \"= 1.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Za64rs\", version: \"= 1.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Zkt\", version: \"= 1.0.1\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Zihintntl\", version: \"= 1.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Zihintpause\", version: \"= 2.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Zawrs\", version: \"= 1.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("  ZAWRS_NTO_IS_NOP: false") ~is #true

for (profile in [single_core_rv5stage_soc_core_profile, mini_rv5stage_soc_core_profile, tiled_rv5stage_soc_core_profile]):
  check:
    profile.isa_profile.isa_extensions.contains("zcmop") ~is #true

for (name in ["simple-rv5stage-rva23", "mini-rv5stage-rva23", "tiled-rv5stage-rva23"]):
  check:
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Zcmop\", version: \"= 1.0.0\" }") ~is #true

for (name in ["simple-rv5stage-rva23", "mini-rv5stage-rva23", "tiled-rv5stage-rva23"]):
  for (extension in ["Zcb", "Zfa", "Zicbom", "Ssnpm", "Supm"]):
    check:
      riscv_udb_configuration(name).to_yaml().contains("{ name: \"" ++ extension ++ "\", version: \"= 1.0.0\" }") ~is #true

for (name in ["simple-rv5stage-rva23", "mini-rv5stage-rva23", "tiled-rv5stage-rva23"]):
  check:
    riscv_udb_configuration(name).to_yaml().contains("  PHYS_ADDR_WIDTH: " ++ String.from_int(rhodium_soc_flit.request_address_width)) ~is #true

check:
  single_core_gnu_target.march.contains("zicbom") ~is #true
  riscv_udb_configuration("simple-rv5stage-rva23").to_yaml().contains("  PMLEN: 7") ~is #true
  riscv_udb_configuration("tiled-rv5stage-rva23").to_yaml().contains("  PMLEN: 7") ~is #true
  riscv_udb_configuration("mini-rv5stage-rva23").to_yaml().contains("  PMLEN: 7") ~is #true
  riscv_udb_configuration("simple-rv5stage-rva23").to_yaml().contains("{ name: \"Zvfh\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("tiled-rv5stage-rva23").to_yaml().contains("{ name: \"Zvfh\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("simple-rv5stage-rva23").to_yaml().contains("{ name: \"Zvbb\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("tiled-rv5stage-rva23").to_yaml().contains("{ name: \"Zvbb\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("simple-rv5stage-rva23").to_yaml().contains("{ name: \"Zvkb\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("tiled-rv5stage-rva23").to_yaml().contains("{ name: \"Zvkb\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("simple-rv5stage-rva23").to_yaml().contains("{ name: \"Zvkt\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("tiled-rv5stage-rva23").to_yaml().contains("{ name: \"Zvkt\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("simple-rv5stage-rva23").to_yaml().contains("{ name: \"Zvl32b\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("simple-rv5stage-rva23").to_yaml().contains("{ name: \"Zvl64b\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("mini-rv5stage-rva23").to_yaml().contains("{ name: \"Zvkt\",") ~is #true
  riscv_udb_configuration("mini-rv5stage-rva23").to_yaml().contains("{ name: \"Zvfh\",") ~is #true
  tiled_rv5stage_soc_core_profile.isa_profile.isa_extensions ~is single_core_rv5stage_soc_core_profile.isa_profile.isa_extensions
  tiled_rv5stage_soc_core_profile.isa_profile.misa_extensions ~is single_core_rv5stage_soc_core_profile.isa_profile.misa_extensions
  riscv_udb_configuration("simple-rv5stage-rva23").name ~is "rhodium-simple-rv5stage-rva23"
  riscv_udb_configuration("mini-rv5stage-rva23").name ~is "rhodium-mini-rv5stage-rva23"
  riscv_udb_configuration("tiled-rv5stage-rva23").name ~is "rhodium-tiled-rv5stage-rva23"
  single_core_spike_soc_core_profile.hart_description.isa_profile.isa_extensions.contains("zihpm") ~is #true
  single_core_spike_soc_core_profile.pmp_regions ~is 16
  riscv_udb_configuration("unknown") ~throws "expected an explicit shape-core-isa product key"
