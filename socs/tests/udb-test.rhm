#lang rhombus
// Checks the core-neutral catalog of concrete RISC-V UDB configurations.
// SPDX-License-Identifier: Apache-2.0

import:
  "../udb.rhm" open
  "../core-profiles.rhm" open

for (profile in [single_core_rv5stage_soc_core_profile, mini_rv5stage_soc_core_profile, tiled_rv5stage_soc_core_profile]):
  check:
    profile.isa_profile.isa_extensions.contains("ziccif") ~is #true
    profile.isa_profile.isa_extensions.contains("ziccamoa") ~is #true
    profile.extensions.ziccrse ~is #true
    profile.isa_profile.isa_extensions.contains("ziccrse") ~is #true
    profile.isa_profile.isa_extensions.contains("zic64b") ~is #true
    profile.isa_profile.isa_extensions.contains("za64rs") ~is #true
    profile.isa_profile.isa_extensions.contains("zkt") ~is #true
    profile.extensions.zawrs ~is #true
    profile.extensions.zihintpause ~is #true
    profile.extensions.zihintntl ~is #true
    profile.isa_profile.isa_extensions.contains("zihintntl") ~is #true
    profile.isa_profile.isa_extensions.contains("zihintpause") ~is #true
    profile.isa_profile.isa_extensions.contains("zawrs") ~is #true

for (name in RiscvUdbConfigurationNames):
  check:
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Ziccif\", version: \"= 1.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Ziccamoa\", version: \"= 1.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Ziccrse\", version: \"= 1.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Zic64b\", version: \"= 1.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Za64rs\", version: \"= 1.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Zkt\", version: \"= 1.0.1\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Zihintntl\", version: \"= 1.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Zihintpause\", version: \"= 2.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Zawrs\", version: \"= 1.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("  ZAWRS_NTO_IS_NOP: false") ~is #true

for (profile in [single_core_rv5stage_soc_core_profile, tiled_rv5stage_soc_core_profile]):
  check:
    profile.isa_profile.isa_extensions.contains("zcmop") ~is #true

for (name in ["single-core-rv5stage-soc", "tiled-rv5stage-soc"]):
  check:
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Zcmop\", version: \"= 1.0.0\" }") ~is #true

check:
  riscv_udb_configuration("single-core-rv5stage-soc").to_yaml().contains("{ name: \"Zvfh\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("single-core-rv5stage-soc").to_yaml().contains("{ name: \"Zvbb\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("single-core-rv5stage-soc").to_yaml().contains("{ name: \"Zvkb\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("single-core-rv5stage-soc").to_yaml().contains("{ name: \"Zvkt\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("single-core-rv5stage-soc").to_yaml().contains("{ name: \"Zvl32b\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("single-core-rv5stage-soc").to_yaml().contains("{ name: \"Zvl64b\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("mini-rv5stage-soc").to_yaml().contains("{ name: \"Zvkt\",") ~is #false
  riscv_udb_configuration("tiled-rv5stage-soc").to_yaml().contains("{ name: \"Zvkt\",") ~is #false
  riscv_udb_configuration("mini-rv5stage-soc").to_yaml().contains("{ name: \"Zvfhmin\",") ~is #false
  riscv_udb_configuration("tiled-rv5stage-soc").to_yaml().contains("{ name: \"Zvfhmin\",") ~is #false
  RiscvUdbConfigurationNames ~is ["single-core-rv5stage-soc", "mini-rv5stage-soc", "tiled-rv5stage-soc"]
  riscv_udb_configuration("single-core-rv5stage-soc").name ~is "rhodium-single-core-rv5stage-soc-rv64"
  riscv_udb_configuration("mini-rv5stage-soc").name ~is "rhodium-mini-rv5stage-soc-rv64"
  riscv_udb_configuration("tiled-rv5stage-soc").name ~is "rhodium-tiled-rv5stage-soc-rv64"
  riscv_udb_configuration("unknown") ~throws "expected one of single-core-rv5stage-soc, mini-rv5stage-soc, tiled-rv5stage-soc"
