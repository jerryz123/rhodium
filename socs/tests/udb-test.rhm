#lang rhombus
// Checks concrete UDB configurations against independent mandatory RVA23 architectural requirements.
// SPDX-License-Identifier: Apache-2.0

import:
  "../products/udb.rhm" open
  "../products/core-profiles.rhm" open
  "../products/spike-core-profile.rhm".single_core_spike_soc_core_profile
  "../platform/fabric-profiles.rhm" open
  "../../riscv/gnu-toolchain.rhm".gnu_isa_target
  "../../riscv/udb.rhm".UdbExtension
  "../products/selection.rhm" open
  "../products/resolve.rhm".resolve_soc_product

// Ratified RVA23 1.0, including its architectural implication closure.
// Keep this oracle independent of the product extension lists/projections.
// Ss1p13 is represented by UDB's S/Sm versions, not an invented extension name.
// https://docs.riscv.org/reference/rva23/v1.0/rva23-profiles.html
def Rva23MandatoryUdb = [
  ["I", "2.1"], ["M", "2.0"], ["A", "2.1"], ["F", "2.2"], ["D", "2.2"], ["C", "2.0"],
  ["S", "1.13"], ["Sm", "1.13"], ["Zicntr", "2.0"], ["Zicsr", "2.0"],
  ["Zifencei", "2.0"], ["Zihintpause", "2.0"], ["Zihpm", "2.0"]
] ++ [
  "B", "H", "U", "V", "Sha", "Shcounterenw", "Shgatpa", "Shtvala", "Shvsatpa", "Shvstvala", "Shvstvecd",
  "Ssccptr", "Sscofpmf", "Sscounterenw", "Ssnpm", "Ssstateen", "Sstc", "Sstvala", "Sstvecd", "Ssu64xl", "Supm",
  "Sv39", "Svade", "Svbare", "Svinval", "Svnapot", "Svpbmt",
  "Za128rs", "Za64rs", "Zaamo", "Zalrsc", "Zawrs", "Zba", "Zbb", "Zbs", "Zca", "Zcb", "Zcd", "Zcmop",
  "Zfa", "Zfhmin", "Zic64b", "Zicbom", "Zicbop", "Zicboz", "Ziccamoa", "Ziccif", "Zicclsm", "Ziccrse",
  "Zicond", "Zihintntl", "Zimop", "Zkt", "Zmmul", "Zvbb", "Zve32f", "Zve32x", "Zve64d", "Zve64f", "Zve64x",
  "Zvfhmin", "Zvkb", "Zvkt", "Zvl128b", "Zvl32b", "Zvl64b"
].map(fun (name): [name, "1.0"])

fun missing_rva23_extensions(extensions :: List.of(UdbExtension)) :: List.of(String):
  fun absent(requirement):
    def present = for any (entry in extensions):
      entry.name == requirement[0] && (entry.version == requirement[1] || entry.version.starts_with(requirement[1] ++ "."))
    !present
  def missing = Rva23MandatoryUdb.filter(~keep: absent)
  missing.map(fun (requirement): requirement[0])

for (core in ["rv5stage", "spike"]):
  for (isa in ["rv32int", "rv32max"]):
    def rv32 = riscv_udb_configuration("simple-" ++ core ++ "-" ++ isa)
    def yaml = rv32.to_yaml()
    for (parameter in ["MXLEN: 32", "VLEN: 64", "ELEN: 32", "VECTOR_LS_INDEX_MAX_EEW: \"32\""]):
      check: yaml.contains("  " ++ parameter) ~is #true
    check: yaml.contains("  PHYS_ADDR_WIDTH: 32") ~is #true
    check: yaml.contains("  NUM_PMP_ENTRIES: 0") ~is #true
    check: yaml.contains("{ name: \"Sscofpmf\", version: \"= 1.0.0\" }") ~is #true
    check: yaml.contains("  HPM_COUNTER_EN: [false, false, false, true, false") ~is #true
    for (name in ["S", "Sm"]):
      check: yaml.contains("{ name: \"" ++ name ++ "\", version: \"= 1.13.0\" }") ~is #true
    for (name in ["F", "Zcf", "Zve32f"]):
      check: (for any (entry in rv32.extensions): entry.name == name) ~is (isa == "rv32max")
    for (name in ["D", "V", "Zfh", "Zfa", "Zvfh", "H", "Sha", "Smstateen", "Ssstateen", "Sstc", "Svinval", "Svpbmt", "Svnapot"]):
      check: (for any (entry in rv32.extensions): entry.name == name) ~is #false

for (core in ["rv5stage", "spike"]):
  for (shape in ["mini", "simple", "tiled"]):
    def product = resolve_soc_product(named_soc_selection(shape ++ "-" ++ core ++ "-rva23"))
    def configuration = product.udb()
    def hart = product.description.hart
    check: missing_rva23_extensions(configuration.extensions) ~is []
    // Dropping any mandatory declaration must fail the gate, even if the
    // remaining generated configuration is internally consistent.
    for (requirement in Rva23MandatoryUdb):
      def remaining = configuration.extensions.filter(~keep: fun (entry): entry.name != requirement[0])
      check: missing_rva23_extensions(remaining) ~is [requirement[0]]
    def old_supervisor = configuration.extensions.map(fun (entry): if entry.name == "S" | UdbExtension("S", "1.12.0") | entry)
    check: missing_rva23_extensions(old_supervisor) ~is ["S"]
    // Properties must also reach architectural/device-tree capabilities, not
    // exist solely as assertions in the ACT projection.
    for (name in ["ssccptr", "sstvecd", "sstvala", "sscounterenw", "ssu64xl"]):
      check: hart.isa_profile.isa_extensions.contains(name) ~is #true
      check: gnu_isa_target(hart.xlen, hart.isa_profile.isa_extensions).march.contains(name) ~is #false
    for (parameter in ["MXLEN: 64", "UXLEN: [64]", "SXLEN: [64]", "CACHE_BLOCK_SIZE: 64",
                       "VLEN: 128", "ELEN: 64", "MISALIGNED_LDST: true", "VECTOR_LS_MISALIGNED_LEGAL: true",
                       "SATP_MODE_BARE: true", "STVAL_WIDTH: 64", "U_MODE_ENDIANNESS: \"little\"", "S_MODE_ENDIANNESS: \"little\"",
                       "NON_STANDARD_EXTENSION_IMPLEMENTED: false", "WFI_FINITE: false", "WFI_U_MODE: false", "HPM_COUNTER3_WIDTH: 64"]):
      check: configuration.to_yaml().contains("  " ++ parameter) ~is #true
    for (interrupt in ["MEI", "MSI", "MTI", "SEI", "SSI", "STI", "VSEI", "VSSI", "VSTI"]):
      check: configuration.to_yaml().contains("  " ++ interrupt ++ "_INTR_IMPL: true") ~is #true
    check: configuration.to_yaml().contains("  STVEC_MODES: [0") ~is #true
    check: configuration.to_yaml().contains("  SUPPORTED_PMLEN_SSNPM: [0, 7, 16]") ~is #true
    for (name in ["H", "Sha", "Smstateen", "Ssstateen", "Shcounterenw", "Shvstvala", "Shtvala", "Shvstvecd", "Shvsatpa", "Shgatpa", "Sstc", "Svinval", "Svpbmt", "Svnapot"]):
      check: (for any (entry in configuration.extensions): entry.name == name) ~is #true
    check: configuration.to_yaml().contains("  VSSTATUS_VS_EXISTS: true") ~is #true
    check: configuration.to_yaml().contains("{ name: \"Sscofpmf\", version: \"= 1.0.0\" }") ~is #true
    check: configuration.to_yaml().contains("  HCOUNTENABLE_EN: [true, true, true, true, false") ~is #true
    for (name in ["S", "Sm"]):
      check: configuration.to_yaml().contains("{ name: \"" ++ name ++ "\", version: \"= 1.13.0\" }") ~is #true

def single_core_gnu_target = gnu_isa_target(
  single_core_rv5stage_soc_core_profile.xlen,
  single_core_rv5stage_soc_core_profile.isa_profile.isa_extensions
)

for (profile in [single_core_rv5stage_soc_core_profile, mini_rv5stage_soc_core_profile, tiled_rv5stage_soc_core_profile]):
  check:
    profile.isa_profile.isa_extensions.contains("ziccif") ~is #true
    profile.isa_profile.isa_extensions.contains("zicclsm") ~is #true
    profile.isa_profile.isa_extensions.contains("ziccamoa") ~is #true
    profile.extensions.ziccrse ~is #true
    profile.extensions.svpbmt ~is #true
    profile.extensions.svnapot ~is #true
    profile.isa_profile.isa_extensions.contains("ziccrse") ~is #true
    profile.isa_profile.isa_extensions.contains("zic64b") ~is #true
    profile.isa_profile.isa_extensions.contains("za64rs") ~is #true
    profile.isa_profile.isa_extensions.contains("zkt") ~is #true
    profile.extensions.zawrs ~is #true
    profile.extensions.zihintpause ~is #true
    profile.extensions.zihintntl ~is #true
    profile.isa_profile.isa_extensions.contains("zihintntl") ~is #true
    profile.isa_profile.isa_extensions.contains("zihintpause") ~is #true
    profile.isa_profile.isa_extensions.contains("zawrs") ~is #true

for (name in ["simple-rv5stage-rva23", "mini-rv5stage-rva23", "tiled-rv5stage-rva23"]):
  check:
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Ziccif\", version: \"= 1.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Zicclsm\", version: \"= 1.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Ziccamoa\", version: \"= 1.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Ziccrse\", version: \"= 1.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Zic64b\", version: \"= 1.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Za64rs\", version: \"= 1.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Zkt\", version: \"= 1.0.1\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Zihintntl\", version: \"= 1.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Zihintpause\", version: \"= 2.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Zawrs\", version: \"= 1.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("  ZAWRS_NTO_IS_NOP: false") ~is #true

for (profile in [single_core_rv5stage_soc_core_profile, mini_rv5stage_soc_core_profile, tiled_rv5stage_soc_core_profile]):
  check:
    profile.isa_profile.isa_extensions.contains("zcmop") ~is #true

for (name in ["simple-rv5stage-rva23", "mini-rv5stage-rva23", "tiled-rv5stage-rva23"]):
  check:
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Zcmop\", version: \"= 1.0.0\" }") ~is #true

for (name in ["simple-rv5stage-rva23", "mini-rv5stage-rva23", "tiled-rv5stage-rva23"]):
  for (extension in ["Zcb", "Zfa", "Zicbom", "Ssnpm", "Supm"]):
    check:
      riscv_udb_configuration(name).to_yaml().contains("{ name: \"" ++ extension ++ "\", version: \"= 1.0.0\" }") ~is #true

for (name in ["simple-rv5stage-rva23", "mini-rv5stage-rva23", "tiled-rv5stage-rva23"]):
  check:
    riscv_udb_configuration(name).to_yaml().contains("  PHYS_ADDR_WIDTH: " ++ String.from_int(rhodium_soc_flit.request_address_width)) ~is #true

check:
  single_core_gnu_target.march.contains("zicbom") ~is #true
  single_core_gnu_target.march.contains("svpbmt") ~is #false
  single_core_gnu_target.march.contains("svnapot") ~is #false
  riscv_udb_configuration("simple-rv5stage-rva23").to_yaml().contains("  SUPPORTED_PMLEN_SSNPM: [0, 7, 16]") ~is #true
  riscv_udb_configuration("tiled-rv5stage-rva23").to_yaml().contains("  SUPPORTED_PMLEN_SSNPM: [0, 7, 16]") ~is #true
  riscv_udb_configuration("mini-rv5stage-rva23").to_yaml().contains("  SUPPORTED_PMLEN_SSNPM: [0, 7, 16]") ~is #true
  riscv_udb_configuration("simple-rv5stage-rva23").to_yaml().contains("{ name: \"Zvfh\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("tiled-rv5stage-rva23").to_yaml().contains("{ name: \"Zvfh\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("simple-rv5stage-rva23").to_yaml().contains("{ name: \"Zvbb\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("tiled-rv5stage-rva23").to_yaml().contains("{ name: \"Zvbb\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("simple-rv5stage-rva23").to_yaml().contains("{ name: \"Zvkb\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("tiled-rv5stage-rva23").to_yaml().contains("{ name: \"Zvkb\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("simple-rv5stage-rva23").to_yaml().contains("{ name: \"Zvkt\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("tiled-rv5stage-rva23").to_yaml().contains("{ name: \"Zvkt\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("simple-rv5stage-rva23").to_yaml().contains("{ name: \"Zvl32b\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("simple-rv5stage-rva23").to_yaml().contains("{ name: \"Zvl64b\", version: \"= 1.0.0\" }") ~is #true
  riscv_udb_configuration("mini-rv5stage-rva23").to_yaml().contains("{ name: \"Zvkt\",") ~is #true
  riscv_udb_configuration("mini-rv5stage-rva23").to_yaml().contains("{ name: \"Zvfh\",") ~is #true
  tiled_rv5stage_soc_core_profile.isa_profile.isa_extensions ~is single_core_rv5stage_soc_core_profile.isa_profile.isa_extensions
  tiled_rv5stage_soc_core_profile.isa_profile.misa_extensions ~is single_core_rv5stage_soc_core_profile.isa_profile.misa_extensions
  riscv_udb_configuration("simple-rv5stage-rva23").name ~is "rhodium-simple-rv5stage-rva23"
  riscv_udb_configuration("mini-rv5stage-rva23").name ~is "rhodium-mini-rv5stage-rva23"
  riscv_udb_configuration("tiled-rv5stage-rva23").name ~is "rhodium-tiled-rv5stage-rva23"
  single_core_spike_soc_core_profile.hart_description.isa_profile.isa_extensions.contains("zihpm") ~is #true
  single_core_spike_soc_core_profile.pmp_regions ~is 0
  riscv_udb_configuration("unknown") ~throws "expected an explicit shape-core-isa product key"
