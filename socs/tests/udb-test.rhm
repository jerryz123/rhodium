#lang rhombus
// Checks the core-neutral catalog of concrete RISC-V UDB configurations.

import:
  "../udb.rhm" open
  "../core-profiles.rhm" open

for (profile in [simple_soc_core_profile, mini_soc_core_profile, tiled_soc_core_profile]):
  check:
    profile.extensions.zawrs ~is #true
    profile.isa_extensions.contains("zawrs") ~is #true

for (name in RiscvUdbConfigurationNames):
  check:
    riscv_udb_configuration(name).to_yaml().contains("{ name: \"Zawrs\", version: \"= 1.0.0\" }") ~is #true
    riscv_udb_configuration(name).to_yaml().contains("  ZAWRS_NTO_IS_NOP: false") ~is #true

check:
  RiscvUdbConfigurationNames ~is ["simple-soc", "mini-soc", "tiled-soc"]
  riscv_udb_configuration("simple-soc").name ~is "rhodium-rv5stage-simple-rv64"
  riscv_udb_configuration("mini-soc").name ~is "rhodium-rv5stage-mini-rv64"
  riscv_udb_configuration("tiled-soc").name ~is "rhodium-rv5stage-tiled-rv64"
  riscv_udb_configuration("unknown") ~throws "expected one of simple-soc, mini-soc, tiled-soc"
