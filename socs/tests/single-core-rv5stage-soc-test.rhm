#lang rhombus
// Checks bootable SingleCoreRV5StageSoC host configuration, address maps, and routing plans.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../cores/rv5stage/profile.rhm".RV5StageMultiplierKind
  "../../chi/protocol/flits.rhdl".CHIReqOpcode
  "../../chi/protocol/coherence.rhdl".chi_rnf_snoop_opcodes
  "../../chi/protocol/link.rhdl".CHINodeKind
  "../../chi/noc/noc-adapter.rhdl".CHIChannelAdapterPlan
  "../../riscv/isa/fp-profile.rhm".HalfPrecisionProfile
  "../../socs/products/single-core-rv5stage-soc.rhdl" as soc

def params = soc.single_core_rv5stage_soc_params
def fabric = params.fabric
def platform = fabric.platform
def snp_adapters :: CHIChannelAdapterPlan = fabric.adapter_plans.snp
def compact_soc_params = soc.single_core_rv5stage_soc_params with (
  llc_sets = 16,
  llc_ways = 2
)
def description = soc.single_core_rv5stage_soc_params.description
for (cache in [description.hart.instruction_cache,
               description.hart.data_cache]):
  check:
    cache.sets ~is 64
    cache.ways ~is 4
    cache.size_bytes ~is 16384
check:
  soc.single_core_rv5stage_soc_core_profile.multiplier ~is RV5StageMultiplierKind.Pipelined
  soc.single_core_rv5stage_soc_core_profile.data_cache_service_queue_depth ~is 4
  soc.single_core_rv5stage_soc_core_profile.extensions.zicbop ~is #true
  soc.single_core_rv5stage_soc_core_profile.extensions.zicbom ~is #true
  soc.single_core_rv5stage_soc_core_profile.extensions.zfa ~is #true
  soc.single_core_rv5stage_soc_core_profile.extensions.ssnpm ~is #true
  soc.single_core_rv5stage_soc_core_profile.extensions.supm ~is #true
  soc.single_core_rv5stage_soc_core_profile.isa_profile.isa_extensions.contains("zcb") ~is #true
  soc.single_core_rv5stage_soc_core_profile.isa_profile.isa_extensions.contains("zvfh") ~is #true
  soc.single_core_rv5stage_soc_core_profile.isa_profile.isa_extensions.contains("zvbb") ~is #true
  soc.single_core_rv5stage_soc_core_profile.isa_profile.isa_extensions.contains("zvkb") ~is #true
  soc.single_core_rv5stage_soc_core_profile.isa_profile.isa_extensions.contains("zvkt") ~is #true
  soc.single_core_rv5stage_soc_core_profile.extensions.half_precision ~is HalfPrecisionProfile.Zfh
  fabric.topology.injections ~is []
  fabric.topology.ejections ~is []
  fabric.home_map.entry(0x1000).home === fabric.device_home ~is #true
  fabric.home_map.entry(0x2000) ~is #false
  fabric.device_home_params.subordinate_map.entry(0x1000).target_node_id ~is 14
  description.boot.address_register.address_set ~is platform.boot_address.service.address_sets[0]
  platform.boot_address_config.reset_value ~is 0
  fabric.home_map.entry(0x80000000).home === fabric.home ~is #true
  fabric.home_map.entry(0xbfffffff).home === fabric.home ~is #true
  fabric.home_map.entry(0xc0000000) ~is #false
  fabric.home_map.entry(0x00010000).home === fabric.device_home ~is #true
  fabric.home_map.entry(0x00011fff).home === fabric.device_home ~is #true
  fabric.home_map.entry(0x00012000) ~is #false
  fabric.home_map.entry(0x02000000).home === fabric.device_home ~is #true
  fabric.home_map.entry(0x02010000) ~is #false
  fabric.home_map.entry(0x0c000000).home === fabric.device_home ~is #true
  fabric.home_map.entry(0x10000000 - 1).home === fabric.device_home ~is #true
  fabric.home_map.entry(0x10000000).home === fabric.device_home ~is #true
  fabric.home_map.entry(0x10000008) ~is #false
  fabric.device_home_params.subordinate_map.entry(0x00010000).target_node_id ~is 12
  fabric.device_home_params.subordinate_map.entry(0x02000000).target_node_id ~is 10
  fabric.device_home_params.subordinate_map.entry(0x0c000000).target_node_id ~is 13
  fabric.device_home_params.subordinate_map.entry(0x10000000).target_node_id ~is 11
  fabric.host_node.kind ~is CHINodeKind.RNF
  fabric.host_node.emits.req ~is (
    [CHIReqOpcode.ReadClean, CHIReqOpcode.WriteUniquePtl, CHIReqOpcode.ReadNoSnp, CHIReqOpcode.WriteNoSnpPtl]
  )
  fabric.host_node.supports.snp ~is chi_rnf_snoop_opcodes
  fabric.memory_port.kind ~is CHINodeKind.SNF
  fabric.memory_port.node_id ~is 9
  soc.single_core_rv5stage_soc_params.llc_config.sets ~is 64
  soc.single_core_rv5stage_soc_params.llc_config.ways ~is 4
  soc.single_core_rv5stage_soc_params.llc_config.transaction_slots ~is 2
  fabric.home.max_outstanding ~is 2
  soc.single_core_rv5stage_soc_params.llc_config.capacity_bytes ~is 16384
  description.model ~is "Rhodium Single-Core RV5Stage SoC"
  description.compatible ~is ["rhodium,single-core-rv5stage-soc"]
  description.harts ~is [0]
  description.hart.isa_profile.isa_extensions ~is soc.single_core_rv5stage_soc_params.core_profile.isa_profile.isa_extensions
  description.clocks === soc.single_core_rv5stage_soc_params.clocks ~is #true
  description.memory_regions[0].address_set ~is fabric.memory_service.address_sets[0]
  description.boot.rom.address_set ~is platform.bootrom.rom_params.service.address_sets[0]
  description.boot.rom.size_bytes ~is 0x2000
  platform.bootrom.rom_config(description).image.bytes.drop(fabric.boot.device_tree_offset) ~is (
    description.to_device_tree().to_dtb().to_list()
  )
  description.aclint.region.address_set ~is platform.aclint.service.address_sets[0]
  description.plic.region.address_set ~is platform.plic.service.address_sets[0]
  description.plic.priority_width ~is 3
  description.plic.sources[0].source_id ~is 1
  description.plic.contexts.length() ~is 2
  description.uart.region.address_set ~is platform.uart.service.address_sets[0]
  description.uart.interrupt.controller.address_set ~is description.plic.region.address_set
  description.uart.interrupt.source_id ~is description.plic.sources[0].source_id
  compact_soc_params.llc_config.sets ~is 16
  compact_soc_params.llc_config.ways ~is 2
  compact_soc_params.llc_config.transaction_slots ~is 2
  compact_soc_params.llc_config.capacity_bytes ~is 2048
  fabric.memory_service.endpoint === fabric.memory_port ~is #true
  fabric.memory_service.supports(CHIReqOpcode.ReadNoSnp, 16) ~is #true
  fabric.memory_service.supports(CHIReqOpcode.ReadNoSnp, 64) ~is #true
  fabric.memory_service.supports(CHIReqOpcode.WriteNoSnpFull, 64) ~is #true
  fabric.compilations.req.network.validated_routing.dependency_graph.vertices ~is []
  fabric.compilations.rsp.network.validated_routing.dependency_graph.vertices ~is []
  fabric.snp_compilation.network.validated_routing.dependency_graph.vertices ~is []
  fabric.compilations.dat.network.validated_routing.dependency_graph.vertices ~is []
  fabric.compilations.req.routes.map(
    fun (route):
      [route.source.node_id,
       route.destination.node_id,
       route.route_key]
  ) ~is [[6, 10, 0], [6, 14, 1], [6, 12, 2], [6, 13, 3], [6, 11, 4], [3, 5, 5], [2, 6, 6], [2, 5, 7], [4, 6, 8], [1, 6, 9], [1, 5, 10]]
  fabric.req_router_config.input_count ~is 5
  fabric.req_router_config.target_count ~is 7
  fabric.rsp_router_config.input_count ~is 11
  fabric.rsp_router_config.target_count ~is 7
  fabric.snp_router_config.input_count ~is 1
  fabric.snp_router_config.target_count ~is 2
  fabric.dat_router_config.input_count ~is 12
  fabric.dat_router_config.target_count ~is 12
  fabric.adapter_plans.req.injections.length() ~is 5
  fabric.adapter_plans.rsp.injections.length() ~is 11
  snp_adapters.injections.length() ~is 1
  snp_adapters.ejections.length() ~is 2
  fabric.adapter_plans.dat.injections.length() ~is 12
  fabric.host_site.req.terminal.describe() ~is "requesters/host/req"
  fabric.host_site.snp.terminal.describe() ~is "requesters/host/snp"
  fabric.instruction_site.req.terminal.describe() ~is "requesters/hart-instruction/req"
  fabric.data_site.snp.terminal.describe() ~is "requesters/hart-data/snp"
  fabric.uncached_site.req.terminal.describe() ~is "requesters/hart-uncached/req"
  fabric.home_requester_site.req.terminal.describe() ~is "home/requesters/req"
  fabric.device_home_requester_site.req.terminal.describe() ~is "device-home/requesters/req"
  fabric.device_home_subordinate_site.req.terminal.describe() ~is "device-home/subordinate/req"
  fabric.bootrom_site.req.terminal.describe() ~is "devices/bootrom/req"
  fabric.plic_site.req.terminal.describe() ~is "devices/plic/req"
  fabric.uart_site.req.terminal.describe() ~is "devices/uart/req"
