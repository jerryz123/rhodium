#lang rhodium
// Defines indirect SoC BootROM configuration, PMA metadata, and multihart release distribution.

import:
  lib("support/annotations.rhm") open
  lib("rhodium/std/bits.rhdl") open
  lib("flow/broadcast.rhdl").CtrlBroadcast
  lib("rhodium/std/ready-valid.rhdl") open
  lib("chi/main.rhdl") open
  lib("cores/rv5stage/chi/foundation.rhdl").RV5StageCHIRegion
  lib("riscv/rtl/pma.rhdl") open
  lib("riscv/isa/xlen.rhm").XLen
  lib("devices/bootrom-image.rhm") open
  lib("devices/bootrom.rhdl") open
  lib("devices/boot-address.rhdl").BootAddressWindowBytes
  "description.rhm".RiscvSoCDescription

def SoCBootAddressBase = 0x1000

def SoCBootROMWindowBytes = CHIBootROMDefaultWindowBytes
def SoCBootROMDeviceTreeOffset = 0x100

class SoCBootConfig(reset_address :: Nat,
                    payload_address :: Nat,
                    window_bytes :: Pow2Int,
                    device_tree_offset :: Nat,
                    program :: BootROMImage,
                    boot_address_register :: Nat):
  implements StableCircuitParam

  property device_tree_address :: Nat:
    reset_address + device_tree_offset

  method image_for(description :: RiscvSoCDescription):
    unless description.boot.reset_address == reset_address && (
      description.boot.payload_address == payload_address
    ) && description.boot.rom.base == reset_address && (
      description.boot.rom.size_bytes == window_bytes
    )
    | error(~who: #'image_for,
            "SoC description boot layout must match the BootROM configuration")
    unless description.boot.address_register == #false || description.boot.address_register.base == boot_address_register
    | error(~who: #'image_for, "SoC description boot-address register must match the BootROM configuration")
    def device_tree_bytes = description.to_device_tree().to_dtb().to_list()
    def image = BootROMImage(
      program.bytes ++ (
        for List (_index in program.size_bytes..device_tree_offset): 0
      ) ++ device_tree_bytes
    )
    unless image.size_bytes <= window_bytes
    | error(~who: #'image_for, "generated device tree must fit in the BootROM window")
    image

  constructor (~reset_address: reset_address :: Nat,
               ~payload_address: payload_address :: Nat,
               ~window_bytes: window_bytes :: Pow2Int,
               ~device_tree_offset: device_tree_offset :: Nat,
               ~program: program :: BootROMImage,
               ~boot_address_register: boot_address_register :: Nat = SoCBootAddressBase):
    unless reset_address mod window_bytes == 0
    | error(~who: #'SoCBootConfig,
            "reset address must be aligned to the BootROM window")
    unless device_tree_offset mod 8 == 0
    | error(~who: #'SoCBootConfig, "device-tree offset must be eight-byte aligned")
    unless program.size_bytes <= device_tree_offset
    | error(~who: #'SoCBootConfig,
            "reset program must fit before the embedded device tree")
    unless device_tree_offset < window_bytes
    | error(~who: #'SoCBootConfig, "device-tree offset must lie in the BootROM window")
    unless boot_address_register mod BootAddressWindowBytes == 0
    | error(~who: #'SoCBootConfig, "boot-address register must be page aligned")
    unless payload_address < (1 << 64)
    | error(~who: #'SoCBootConfig, "default payload address must fit in 64 bits")
    super(reset_address, payload_address, window_bytes, device_tree_offset, program, boot_address_register)

fun riscv_soc_boot_config(~reset_address: reset_address :: Nat = RiscvBootROMResetAddress,
                          ~payload_address: payload_address :: Nat = RiscvBootROMPayloadAddress,
                          ~window_bytes: window_bytes :: Pow2Int = SoCBootROMWindowBytes,
                          ~device_tree_offset: device_tree_offset :: Nat = SoCBootROMDeviceTreeOffset,
                          ~boot_address_register: boot_address_register :: Nat = SoCBootAddressBase,
                          ~xlen: xlen :: XLen = XLen.X64):
  SoCBootConfig(
    ~reset_address: reset_address,
    ~payload_address: payload_address,
    ~boot_address_register: boot_address_register,
    ~window_bytes: window_bytes,
    ~device_tree_offset: device_tree_offset,
    ~program: riscv_bootrom_image(
      reset_address,
      payload_address,
      ~device_tree_address: reset_address + device_tree_offset,
      ~boot_address_register: boot_address_register,
      ~xlen: xlen
    )
  )

def DefaultSoCBootConfig = riscv_soc_boot_config()
def soc_bootrom_attributes = RiscvPhysicalMemoryAttributes(#true, #false, #true, #false, #false, #false, #true)

class SoCBootROMParams(flit :: CHIFlitParams,
                       home :: CHIHomeParams,
                       node_id :: Nat,
                       boot :: SoCBootConfig):
  implements StableCircuitParam

  property rom_layout:
    CHIBootROMLayout(flit, ~window_bytes: boot.window_bytes)
  method rom_config(description :: RiscvSoCDescription):
    CHIBootROMConfig(rom_layout, ~image: boot.image_for(description))
  property rom_params:
    CHIBootROMParams("soc-bootrom",
                     node_id,
                     rom_layout,
                     ~base_address: boot.reset_address)
  property region:
    RV5StageCHIRegion(
      RiscvPhysicalMemoryRegion(
        AddressSet(boot.reset_address, boot.window_bytes - 1),
        soc_bootrom_attributes
      ),
      home
    )

sync_circuit SoCBootDistributor(hart_count :: PosInt):
  interface release(IrrevocableCtrl(), ~role: consumer)
  interface hart_release[hart_count](IrrevocableCtrl(), ~role: producer)

  inst broadcast(CtrlBroadcast(hart_count))
  reg released(~init: Bool(#false))

  broadcast.ingress.valid <== release.valid & !released
  release.ready <== broadcast.ingress.ready & !released
  hart_release <=> broadcast.egress

  when (release.fire()):
    released <== Bool(#true)
  when (release.valid):
    assert(!released, "soc_boot_release_once")

export:
  SoCBootAddressBase
  SoCBootROMWindowBytes
  SoCBootROMDeviceTreeOffset
  SoCBootConfig
  riscv_soc_boot_config
  DefaultSoCBootConfig
  soc_bootrom_attributes
  SoCBootROMParams
  SoCBootDistributor
