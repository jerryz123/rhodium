#lang rhombus
// Catalogs generated UDB configurations for concrete RISC-V SoC and core combinations.
// SPDX-License-Identifier: Apache-2.0

import:
  "../support/annotations.rhm".NonemptyString
  "../riscv/udb.rhm".UdbConfiguration
  "../cores/rv5stage/udb.rhm".rv5stage_udb_configuration
  "core-profiles.rhm" open

def RiscvUdbConfigurationNames = ["single-core-rv5stage-soc", "mini-rv5stage-soc", "tiled-rv5stage-soc"]

fun riscv_udb_configuration(configuration_name :: NonemptyString) :: UdbConfiguration:
  match configuration_name
  | "single-core-rv5stage-soc":
      rv5stage_udb_configuration(
        single_core_rv5stage_soc_core_profile,
        "rhodium-single-core-rv5stage-soc-rv64",
        "RV5Stage configuration instantiated by Rhodium Single-Core RV5Stage SoC",
        DefaultRhodiumSoCRequestAddressWidth
      )
  | "mini-rv5stage-soc":
      rv5stage_udb_configuration(
        mini_rv5stage_soc_core_profile,
        "rhodium-mini-rv5stage-soc-rv64",
        "RV5Stage configuration instantiated by Rhodium Mini RV5Stage SoC",
        DefaultRhodiumSoCRequestAddressWidth
      )
  | "tiled-rv5stage-soc":
      rv5stage_udb_configuration(
        tiled_rv5stage_soc_core_profile,
        "rhodium-tiled-rv5stage-soc-rv64",
        "RV5Stage configuration instantiated by Rhodium Tiled RV5Stage SoC",
        DefaultRhodiumSoCRequestAddressWidth
      )
  | ~else:
      error(~who: #'riscv_udb_configuration,
            "unknown RISC-V UDB configuration " ++ configuration_name ++ "; expected one of " ++ String.join(RiscvUdbConfigurationNames, ", "))

export:
  RiscvUdbConfigurationNames
  riscv_udb_configuration
