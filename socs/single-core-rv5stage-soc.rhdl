  "core-profiles.rhm" open

def single_core_rv5stage_soc_flit = CHIFlitParams(~request_address_width: DefaultRhodiumSoCRequestAddressWidth)
def single_core_rv5stage_soc_home = CHIHomeParams("simple-home", 5, CHINodeKind.HNF, ~max_outstanding: 2)
def single_core_rv5stage_soc_device_home = CHIHomeParams("simple-device-home", 6, CHINodeKind.HNI, ~max_outstanding: 1)
def single_core_rv5stage_soc_memory_base = 0x80000000
def single_core_rv5stage_soc_memory_bytes = 0x40000000
def single_core_rv5stage_soc_clocks = SoCClockConfig(
  ~clock_frequency_hz: 100000000,
  ~timebase_frequency_hz: 100000000
)
def single_core_rv5stage_soc_host_node = soc_host_node(1)
def single_core_rv5stage_soc_host_port = single_core_rv5stage_soc_host_node.icn_peer()
def single_core_rv5stage_soc_memory_transfers = TransferSizes(1, 64)
def single_core_rv5stage_soc_memory_node = CHINodeParams(
  "simple-memory", 9, CHINodeKind.SNF,
  ~emits: CHIChannelCapabilities(
    ~rsp: [CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp],
    ~dat: [CHIDatOpcode.CompData]
  ),
  ~supports: CHIChannelCapabilities(
    ~req: [CHIReqOpcode.ReadNoSnp, CHIReqOpcode.WriteNoSnpFull, CHIReqOpcode.WriteNoSnpPtl],
    ~dat: [CHIDatOpcode.NonCopyBackWriteData]
  ),
  ~max_outstanding: 2
)
def single_core_rv5stage_soc_memory_service = CHISubordinateServiceParams(
  single_core_rv5stage_soc_memory_node.icn_peer(),
  [AddressSet(single_core_rv5stage_soc_memory_base, single_core_rv5stage_soc_memory_bytes - 1)],
  [CHIRequestSupport(CHIReqOpcode.ReadNoSnp, single_core_rv5stage_soc_memory_transfers),
   CHIRequestSupport(CHIReqOpcode.WriteNoSnpFull, single_core_rv5stage_soc_memory_transfers),
   CHIRequestSupport(CHIReqOpcode.WriteNoSnpPtl, single_core_rv5stage_soc_memory_transfers)]
)

// Couples the external-memory fabric contract with the inclusive LLC geometry
// selected by the complete SingleCoreRV5StageSoC composition.
class SingleCoreRV5StageSoCParams(fabric :: SingleCoreSystemParams,
                                  core_profile :: RV5StageConfig,
                                  clocks :: SoCClockConfig,
                                  llc_sets :: Pow2Int,
                                  llc_ways :: PosInt):
  implements StableCircuitParam

  property llc_config:
    CHIInclusiveHNFConfig(fabric.home_config,
                          StripedAddressLayout(fabric.memory_bytes, 64, 1),
                          ~sets: llc_sets,
                          ~ways: llc_ways)
  property description:
    fabric.description("Rhodium Single-Core RV5Stage SoC",
                       ["rhodium,single-core-rv5stage-soc"],
                       core_profile,
                       clocks)

  constructor (fabric :: SingleCoreSystemParams,
               ~core_profile: core_profile :: RV5StageConfig = single_core_rv5stage_soc_core_profile,
               ~clocks: clocks :: SoCClockConfig = single_core_rv5stage_soc_clocks,
               ~llc_sets: llc_sets :: Pow2Int,
               ~llc_ways: llc_ways :: PosInt):
    unless core_profile.xlen == XLen.X64
    | error(~who: #'SingleCoreRV5StageSoCParams, "SingleCoreRV5StageSoC requires an RV64 core profile")
    super(fabric, core_profile, clocks, llc_sets, llc_ways)

  reconstructor (fabric, core_profile, clocks, llc_sets, llc_ways):
    SingleCoreRV5StageSoCParams(
      fabric,
      ~core_profile: core_profile,
      ~clocks: clocks,
      ~llc_sets: llc_sets,
      ~llc_ways: llc_ways
    )

def single_core_rv5stage_soc_params = SingleCoreRV5StageSoCParams(
  SingleCoreSystemParams(
    single_core_rv5stage_soc_flit, single_core_rv5stage_soc_memory_base, single_core_rv5stage_soc_memory_bytes,
    single_core_rv5stage_soc_memory_service, single_core_rv5stage_soc_home, single_core_rv5stage_soc_host_node,
    SoCPlatformParams(single_core_rv5stage_soc_flit, 1, single_core_rv5stage_soc_device_home,
                      riscv_soc_boot_config(~payload_address: single_core_rv5stage_soc_memory_base),
                      12, 10, 13, 11, 14)
  ),
  ~llc_sets: 64,
  ~llc_ways: 4
)
