#lang rhombus
/* Authors implementation-independent scalar, vector, and hypervisor ISA presets. */
// SPDX-License-Identifier: Apache-2.0

import:
  "selection.rhm".IsaPreset
  lib("riscv/isa/profile.rhm") open
  lib("riscv/isa/hart.rhm").RiscvMmuType
  lib("riscv/isa/xlen.rhm").XLen
  lib("riscv/isa/vector-profile.rhm") open

/* Collects implementation-independent ISA, translation, and vector geometry for one authored architectural preset. */
class SoCArchitecture(isa :: RiscvIsaProfile,
                      mmu :: RiscvMmuType,
                      vector :: VectorProfile,
                      vector_extensions :: List.of(VectorExtension),
                      vector_length :: PosInt):
  /* Tests whether the preset advertises the supplied ISA extension name. */
  method has(extension :: String) :: Boolean: isa.isa_extensions.contains(extension)

def IntegerSystemExtensions = ["zicntr", "zicond", "zicsr", "zifencei", "zihpm", "zimop", "zkt"]
def IntegerHintExtensions = ["zawrs", "zihintpause", "zihintntl"]
def IntegerMisa = [MisaExtension.A, MisaExtension.B, MisaExtension.I, MisaExtension.M, MisaExtension.S, MisaExtension.U]
def SupervisorExtensions = ["ssccptr", "sstvecd", "sstvala", "sscounterenw", "ssu64xl"]

/* Authors the RV32, lean scalar RV64, maximal RV64, or RVA23 architecture independently of a named processor's implementation policy. */
fun soc_architecture(preset :: IsaPreset) :: SoCArchitecture:
  match preset
  | IsaPreset.RV32Int || IsaPreset.RV32Max:
      def fp = preset == IsaPreset.RV32Max
      def vector = if fp | VectorProfile.Zve32f | VectorProfile.Zve32x
      def extensions = vector_extensions(VectorExtension.Zvbb)
      def scalar = ["i", "m", "a"] ++ (if fp | ["f"] | []) ++ ["c", "b", "za64rs", "zba", "zbb", "zbs", "zcb", "zcmop", "zic64b", "zicbop", "zicboz", "zicbom", "ziccamoa", "ziccif", "zicclsm", "ziccrse"]
      def names = scalar ++ IntegerHintExtensions ++ IntegerSystemExtensions ++ ["sscofpmf"] ++ vector_profile_isa_extensions(vector, 64, extensions) ++ ["zvkt"]
      SoCArchitecture(
        RiscvIsaProfile(XLen.X32, names, IntegerMisa ++ (if fp | [MisaExtension.F] | []) ++ [MisaExtension.C]),
        RiscvMmuType.Bare, vector, extensions, 64
      )
  | IsaPreset.RV64IMACB || IsaPreset.RV64IMAFDCB:
      def fp = preset == IsaPreset.RV64IMAFDCB
      def scalar = ["i", "m", "a"] ++ (if fp | ["f", "d"] | []) ++ ["c", "b", "za64rs", "zba", "zbb", "zbs", "zic64b", "zicclsm"]
      SoCArchitecture(
        RiscvIsaProfile(XLen.X64, scalar ++ IntegerSystemExtensions ++ SupervisorExtensions, IntegerMisa ++ (if fp | [MisaExtension.F, MisaExtension.D] | []) ++ [MisaExtension.C]),
        RiscvMmuType.Sv39, VectorProfile.None, NoVectorExtensions, 128
      )
  | IsaPreset.RV64Max || IsaPreset.RVA23:
      // Mandatory RVA23U64/S64 declarations are checked independently in the
      // product/UDB tests; behavioral validation remains implementation-owned.
      def hypervisor = preset == IsaPreset.RVA23
      def extensions = vector_extensions(VectorExtension.Zvfh, VectorExtension.Zvbb)
      def scalar = ["i", "m", "a", "f", "d", "c", "b"] ++ (if hypervisor | ["h"] | []) ++ ["za64rs", "zba", "zbb", "zbs", "zcb", "zcmop", "zfa", "zfh", "zic64b", "zicbop", "zicboz", "zicbom", "ziccamoa", "ziccif", "zicclsm", "ziccrse", "ssnpm", "supm"]
      def privileged = ["sstc", "svinval", "svpbmt", "svnapot", "smstateen", "ssstateen"] ++ (if hypervisor | ["shcounterenw", "shvstvala", "shtvala", "shvstvecd", "shvsatpa", "shgatpa", "sha"] | [])
      def names = scalar ++ IntegerHintExtensions ++ IntegerSystemExtensions ++ privileged ++ ["sscofpmf"] ++ SupervisorExtensions ++ vector_profile_isa_extensions(VectorProfile.V, 128, extensions) ++ ["zvkt"]
      SoCArchitecture(
        RiscvIsaProfile(XLen.X64, names, IntegerMisa ++ [MisaExtension.F, MisaExtension.D, MisaExtension.C, MisaExtension.V] ++ (if hypervisor | [MisaExtension.H] | [])),
        RiscvMmuType.Sv39, VectorProfile.V, extensions, 128
      )

export:
  SoCArchitecture
  soc_architecture
