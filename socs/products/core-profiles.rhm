#lang rhombus
// Applies shape-owned RV5Stage implementation policy to explicit architectural presets.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/rv5stage/profile.rhm") open
  lib("riscv/isa/c.rhm") open
  lib("riscv/isa/fp-profile.rhm") open
  lib("riscv/isa/hart.rhm").RiscvMmuType
  "selection.rhm" open
  "isa-profiles.rhm" open

fun rv5stage_product_profile(shape :: SoCShape, preset :: IsaPreset) :: RV5StageConfig:
  def architecture = soc_architecture(preset)
  def has = fun (name :: String): architecture.has(name)
  def compressed = cond
  | has("zcb"): compressed_extensions(CompressedExtension.C, CompressedExtension.Zcb, CompressedExtension.Zcmop)
  | has("c"): compressed_extensions(CompressedExtension.C)
  | ~else: []
  def cache = match shape
  | SoCShape.Mini: RV5StageCacheGeometry(~instruction: RV5StageCacheConfig(32, 1), ~data: RV5StageCacheConfig(32, 1))
  | SoCShape.Simple: RV5StageCacheGeometry(~instruction: RV5StageCacheConfig(64, 4), ~data: RV5StageCacheConfig(64, 4))
  | SoCShape.Tiled: RV5StageCacheGeometry()
  def profile = RV5StageConfig(
    ~xlen: architecture.isa.xlen,
    ~extensions: RV5StageExtensions(
      ~floating_point: cond | has("d"): FloatingPointProfile.D | has("f"): FloatingPointProfile.F | ~else: FloatingPointProfile.None,
      ~half_precision: if has("zfh") | HalfPrecisionProfile.Zfh | HalfPrecisionProfile.None,
      ~zfa: has("zfa"),
      ~ziccif: has("ziccif"), ~ziccamoa: has("ziccamoa"), ~ziccrse: has("ziccrse"),
      ~zicbop: has("zicbop"), ~zicbom: has("zicbom"), ~zicboz: has("zicboz"),
      ~ssnpm: has("ssnpm"), ~supm: has("supm"),
      ~zawrs: has("zawrs"), ~zihintpause: has("zihintpause"), ~zihintntl: has("zihintntl"),
      ~compressed: compressed
    ),
    ~mmu_mode: if architecture.mmu == RiscvMmuType.Bare | RV5StageMmuMode.Bare | RV5StageMmuMode.Sv39,
    ~cache_geometry: cache,
    ~data_cache_service_queue_depth: if shape == SoCShape.Mini | 1 | 4,
    ~multiplier: if shape == SoCShape.Mini | RV5StageMultiplierKind.Iterative | RV5StageMultiplierKind.Pipelined,
    ~vector: architecture.vector,
    ~vector_extensions: architecture.vector_extensions,
    ~vector_length: architecture.vector_length
  )
  unless profile.isa_profile == architecture.isa
  | error(~who: #'rv5stage_product_profile, "RV5Stage cannot implement the exact requested architecture: " ++ isa_preset_name(preset))
  profile

def single_core_rv5stage_soc_core_profile = rv5stage_product_profile(SoCShape.Simple, IsaPreset.RVA23)
def mini_rv5stage_soc_core_profile = rv5stage_product_profile(SoCShape.Mini, IsaPreset.RVA23)
def tiled_rv5stage_soc_core_profile = rv5stage_product_profile(SoCShape.Tiled, IsaPreset.RVA23)

export:
  rv5stage_product_profile
  single_core_rv5stage_soc_core_profile
  mini_rv5stage_soc_core_profile
  tiled_rv5stage_soc_core_profile
