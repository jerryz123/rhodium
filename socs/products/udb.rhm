#lang rhombus
// Projects explicit shape-core-ISA product keys through the shared configuration resolver.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../support/annotations.rhm".NonemptyString
  "../../riscv/udb.rhm".UdbConfiguration
  "selection.rhm" open
  "resolve.rhm".resolve_soc_product

fun riscv_udb_configuration(configuration_name :: NonemptyString) :: UdbConfiguration:
  def product = resolve_soc_product(named_soc_selection(configuration_name))
  product.udb()

export:
  riscv_udb_configuration
