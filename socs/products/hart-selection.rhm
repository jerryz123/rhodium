#lang rhombus
// Adapts the existing shape/core call boundary to the typed product resolver.
// SPDX-License-Identifier: Apache-2.0

import:
  "../harts/implementation.rhdl".RiscvHartImplementation
  "selection.rhm" open
  "resolve.rhm".resolve_soc_product

fun soc_hart(shape :: String, core :: String, ~isa: isa :: IsaPreset) :: RiscvHartImplementation:
  def selection = SoCSelection(parse_soc_shape(shape), parse_core_kind(core), isa)
  resolve_soc_product(selection).hart

export:
  soc_hart
