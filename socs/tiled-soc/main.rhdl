#lang rhodium
/* Exposes the author-facing bootable TiledSoC configuration and structural circuit. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("chi/noc/noc-router.rhdl") open
  lib("chi/protocol/channels.rhdl").CHISNChannels
  lib("chi/home/home-common.rhdl").CHIHNFIdentity
  lib("rhodium/std/counter.rhdl").Counter
  lib("cores/chi-hart.rhdl").RiscvHartCHIIdentity
  lib("devices/boot/bootrom.rhdl") open
  lib("devices/boot/boot-address.rhdl") open
  lib("devices/interrupt/aclint.rhdl").AclintIdentity
  lib("devices/interrupt/plic.rhdl").PlicIdentity
  lib("devices/uart/uart16550.rhdl").Uart16550Identity
  "layout.rhm" open
  "compile.rhdl" open
  "distribution.rhdl" open
  "time.rhdl" open
  "tiles/main.rhdl" open
  "../platform/host-interface.rhdl".SoCHostInterface
  "../platform/peripherals.rhdl".SoCUartInterface
  "../platform/description.rhm".SoCClockConfig
  "../harts/implementation.rhdl".RiscvHartImplementation
  "../platform/fabric-profiles.rhm".rhodium_soc_flit

def default_tiled_soc_layout = tile_grid:
  row [llc(4), memory]
  row [host, device_home, aclint, plic, uart]
  row [hart(4), transit]
  row [hart(4), transit]

def tiled_soc_clocks = SoCClockConfig(
  ~clock_frequency_hz: 100000000,
  ~timebase_frequency_hz: 1000000
)

/* Builds the default eight-hart, four-slice mesh with one 1-GiB external RAM channel and the shared platform devices. */
fun tiled_soc_config(hart :: RiscvHartImplementation) :: TiledSoCConfig:
  TiledSoCConfig(
    ~layout: default_tiled_soc_layout,
    ~node_ids: TiledNodeIds(
      ~hart_coherent_base: 0,
      ~hart_uncached_base: 16,
      ~host: 24,
      ~llc_home_base: 32,
      ~device_home: 36,
      ~memory: 48,
      ~bootrom_subordinate: 54,
      ~aclint_subordinate: 52,
      ~plic_subordinate: 55,
      ~uart_subordinate: 53,
      ~boot_address_subordinate: 56
    ),
    ~memory: StripedMemory(
      ~base: 0x80000000,
      ~size_bytes: 0x40000000,
      ~stripe_bytes: 64
    ),
    ~llc: LLCGeometry(
      ~sets: 16,
      ~ways: 4
    ),
    ~hart: hart,
    ~clocks: tiled_soc_clocks,
    ~flit: rhodium_soc_flit
  )

/*
 * Instantiates the selected tiles and boot devices, applies their runtime identities, connects
 * the CHI physical links, and routes time and interrupts through the separate overlay.
 */
sync_circuit TiledSoC(config :: TiledSoCConfig,
                      implementation :: TiledSoCImplementation = compile_tiled_soc(config)):
  unless implementation.config == config
  | error(~who: #'TiledSoC, "compiled topology must belong to the selected SoC configuration")

  def p = implementation.flit
  def site_width = implementation.router_configs.req.route_decoder.site_width
  interface host(SoCHostInterface(p), ~role: soc)
  interface memory(CHISNChannels(p), ~role: icn)
  interface uart(SoCUartInterface(), ~role: soc)

  def harts = for InstanceArray (entry in implementation.harts):
    inst hart(HartTile(entry.tile_params, ~reset_address: config.boot.reset_address))

  def llcs = for InstanceArray (entry in implementation.llcs):
    inst llc(LLCTile(entry.tile_params))

  def transits = for InstanceArray (entry in implementation.transits):
    inst transit(TransitTile(entry.tile_params))

  inst host_tile(HostTile(implementation.host.tile_params))
  inst memory_tile(MemoryTile(implementation.memory.router_params))
  inst device_home(DeviceHomeTile(implementation.device_home.tile_params))
  inst bootrom(CHIBootROM(implementation.platform.bootrom.rom_config(config.description)))
  inst boot_address(CHIBootAddressRegister(implementation.platform.boot_address_config))
  inst aclint(AclintTile(implementation.aclint.tile_params))
  inst plic(PlicTile(implementation.plic.tile_params))
  inst uart_device(UartTile(implementation.uart.tile_params))
  def hart_count = implementation.harts.length()
  inst distribution(TiledDistributionNetwork(implementation.distribution))
  // Platform time advances at the configured architectural timebase; each
  // resulting snapshot and each interrupt change cross the narrow platform NoC.
  inst timebase(Counter(config.clocks.timebase_period_cycles))

  for (index in 0..implementation.harts.length()):
    def entry = implementation.harts[index]
    harts[index].identity <== HartTileIdentity(p, site_width):
      site_key: Bits(site_width)(implementation.site_key(entry.placement.router))
      hart_id: Bits(64)(index)
      chi: (RiscvHartCHIIdentity(p):
              instruction_node_id: Bits(p.node_id_width)(entry.chi.hart.instruction_node_id)
              data_node_id: Bits(p.node_id_width)(entry.chi.hart.data_node_id)
              uncached_node_id: Bits(p.node_id_width)(entry.chi.hart.uncached_node_id))

    distribution.interrupt_egress[index] <=> harts[index].interrupt_update
    distribution.external_interrupt_egress[index] <=> harts[index].external_interrupt_update
    distribution.time_egress[index] <=> harts[index].time_beat

  for (index in 0..implementation.llcs.length()):
    def entry = implementation.llcs[index]
    llcs[index].identity <== LLCTileIdentity(p, site_width):
      site_key: Bits(site_width)(implementation.site_key(entry.placement.router))
      home: (CHIHNFIdentity(p):
               home_node_id: Bits(p.node_id_width)(entry.home_params.home.node_id)
               subordinate_node_id: Bits(p.node_id_width)(entry.home_params.subordinate_endpoint.node_id)
               service_base: Bits(p.request_address_width)(entry.address_set.base))

  for (index in 0..implementation.transits.length()):
    def entry = implementation.transits[index]
    transits[index].site_key <== Bits(site_width)(implementation.site_key(entry.placement.router))

  host_tile.site_key <== Bits(site_width)(implementation.site_key(implementation.host.placement.router))
  host.memory <=> host_tile.host
  memory_tile.site_key <== Bits(site_width)(implementation.site_key(implementation.memory.placement.router))
  memory <=> memory_tile.memory
  device_home.site_key <== Bits(site_width)(implementation.site_key(implementation.device_home.placement.router))
  bootrom.identity <== CHIBootROMIdentity(p):
    node_id: Bits(p.node_id_width)(implementation.bootrom.device.node_id)
    base_address: Bits(p.request_address_width)(implementation.bootrom.device.base_address)

  bootrom.port <=> device_home.subordinate[0]
  boot_address.identity <== BootAddressIdentity(p):
    node_id: Bits(p.node_id_width)(implementation.platform.boot_address.node_id)
    base_address: Bits(p.request_address_width)(implementation.platform.boot_address.base_address)

  boot_address.port <=> device_home.subordinate[1]
  aclint.identity <== AclintTileIdentity(p, site_width):
    site_key: Bits(site_width)(implementation.site_key(implementation.aclint.placement.router))
    aclint: (AclintIdentity(p):
               node_id: Bits(p.node_id_width)(implementation.aclint.device.node.node_id))

  timebase.enable <== Bool(#true)
  aclint.tick <== timebase.wrap
  aclint.time_beat <=> distribution.time_ingress
  aclint.interrupt_update <=> distribution.interrupt_ingress
  plic.identity <== PlicTileIdentity(p, site_width):
    site_key: Bits(site_width)(implementation.site_key(implementation.plic.placement.router))
    plic: (PlicIdentity(p):
             node_id: Bits(p.node_id_width)(implementation.plic.device.node.node_id)
             base_address: Bits(p.request_address_width)(implementation.plic.device.base_address))

  plic.sources <== vec([uart_device.uart.interrupt])
  plic.external_interrupt_update <=> distribution.external_interrupt_ingress
  uart_device.identity <== UartTileIdentity(p, site_width):
    site_key: Bits(site_width)(implementation.site_key(implementation.uart.placement.router))
    uart: (Uart16550Identity(p):
             node_id: Bits(p.node_id_width)(implementation.uart.device.node.node_id)
             base_address: Bits(p.request_address_width)(implementation.uart.device.base_address))

  uart <=> uart_device.uart

  def tiles = (
    for List (index in 0..implementation.harts.length()):
      CHIRouterEndpoints(implementation.site_key(implementation.harts[index].placement.router),
                         harts[index].incoming_links,
                         harts[index].outgoing_links)
  ) ++ (
    for List (index in 0..implementation.transits.length()):
      CHIRouterEndpoints(implementation.site_key(implementation.transits[index].placement.router),
                         transits[index].incoming_links,
                         transits[index].outgoing_links)
  ) ++ [
    CHIRouterEndpoints(implementation.site_key(implementation.memory.placement.router),
                       memory_tile.incoming_links,
                       memory_tile.outgoing_links),
    CHIRouterEndpoints(implementation.site_key(implementation.host.placement.router),
                       host_tile.incoming_links,
                       host_tile.outgoing_links),
    CHIRouterEndpoints(implementation.site_key(implementation.device_home.placement.router),
                       device_home.incoming_links,
                       device_home.outgoing_links),
    CHIRouterEndpoints(implementation.site_key(implementation.aclint.placement.router),
                       aclint.incoming_links,
                       aclint.outgoing_links),
    CHIRouterEndpoints(implementation.site_key(implementation.plic.placement.router),
                       plic.incoming_links,
                       plic.outgoing_links),
    CHIRouterEndpoints(implementation.site_key(implementation.uart.placement.router),
                       uart_device.incoming_links,
                       uart_device.outgoing_links)
  ] ++ (
    for List (index in 0..implementation.llcs.length()):
      CHIRouterEndpoints(implementation.site_key(implementation.llcs[index].placement.router),
                         llcs[index].incoming_links,
                         llcs[index].outgoing_links)
  )

  connect_chi_router_family(implementation.physical_plan, tiles)

export:
  HartTileSpec
  LLCTileSpec
  MemoryTileSpec
  HostTileSpec
  DeviceHomeTileSpec
  AclintTileSpec
  PlicTileSpec
  UartTileSpec
  TransitTileSpec
  TiledTileSpec
  TiledTileCell
  TileGrid
  TiledNodeIds
  StripedMemory
  LLCGeometry
  TiledSoCConfig
  hart_tile
  llc_tile
  memory_tile
  host_tile
  device_home_tile
  aclint_tile
  plic_tile
  uart_tile
  transit_tile
  repeat_tiled_tile
  tile_grid
  default_tiled_soc_layout
  tiled_soc_clocks
  tiled_soc_config
  TiledSoC
