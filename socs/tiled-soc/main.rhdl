#lang rhodium
// Exposes the author-facing bootable TiledSoC configuration and structural circuit.

import:
  lib("chi/main.rhdl") open
  lib("rhodium/std/counter.rhdl").Counter
  lib("cores/rv5stage/chi/foundation.rhdl").RV5StageCHIIdentity
  lib("devices/bootrom.rhdl") open
  lib("devices/boot-address.rhdl") open
  lib("devices/aclint.rhdl").AclintIdentity
  lib("devices/plic.rhdl").PlicIdentity
  lib("devices/uart16550.rhdl").Uart16550Identity
  "layout.rhm" open
  "compile.rhdl".compile_tiled_soc
  "distribution.rhdl" open
  "time.rhdl" open
  "tiles/main.rhdl" open
  "../host-interface.rhdl".SoCHostInterface
  "../peripherals.rhdl".SoCUartInterface
  "../boot.rhdl".SoCBootDistributor
  "../description.rhm".SoCClockConfig
  "../core-profiles.rhm" open

def default_tiled_soc_layout = tile_grid:
  row [llc(4), transit]
  row [host, device_home, aclint, plic, uart]
  row [rv5stage(4), transit]
  row [rv5stage(4), transit]

def tiled_soc_clocks = SoCClockConfig(
  ~clock_frequency_hz: 100000000,
  ~timebase_frequency_hz: 1000000
)

def default_tiled_soc_config = TiledSoCConfig(
  ~layout: default_tiled_soc_layout,
  ~node_ids: TiledNodeIds(
    ~rv5stage_coherent_base: 0,
    ~rv5stage_uncached_base: 16,
    ~host: 24,
    ~llc_home_base: 32,
    ~device_home: 36,
    ~backing_memory_base: 48,
    ~bootrom_subordinate: 54,
    ~aclint_subordinate: 52,
    ~plic_subordinate: 55,
    ~uart_subordinate: 53,
    ~boot_address_subordinate: 56
  ),
  ~memory: StripedMemory(
    ~base: 0x80000000,
    ~bank_bytes: 0x2000,
    ~stripe_bytes: 64
  ),
  ~llc: LLCGeometry(
    ~sets: 16,
    ~ways: 4
  ),
  ~core_profile: tiled_soc_core_profile,
  ~clocks: tiled_soc_clocks,
  ~flit: CHIFlitParams(~request_address_width: DefaultRhodiumSoCRequestAddressWidth)
)

sync_circuit TiledSoC(config :: TiledSoCConfig = default_tiled_soc_config):
  def implementation = compile_tiled_soc(config)
  def p = implementation.flit
  def site_width = implementation.router_configs.req.route_decoder.site_width
  interface host(SoCHostInterface(p), ~role: soc)
  interface uart(SoCUartInterface(), ~role: soc)

  def rv5stages = for InstanceArray (entry in implementation.rv5stages):
    inst rv5stage(RV5StageTile(entry.tile_params, ~reset_address: config.boot.reset_address))
  def llcs = for InstanceArray (entry in implementation.llcs):
    inst llc(LLCTile(entry.tile_params))
  def transits = for InstanceArray (entry in implementation.transits):
    inst transit(TransitTile(entry.tile_params))
  inst host_tile(HostTile(implementation.host.tile_params))
  inst device_home(DeviceHomeTile(implementation.device_home.tile_params))
  inst bootrom(CHIBootROM(implementation.platform.bootrom.rom_config(config.description)))
  inst boot_address(CHIBootAddressRegister(implementation.platform.boot_address_config))
  inst boot(SoCBootDistributor(implementation.rv5stages.length()))
  inst aclint(AclintTile(implementation.aclint.tile_params))
  inst plic(PlicTile(implementation.plic.tile_params))
  inst uart_device(UartTile(implementation.uart.tile_params))
  def hart_count = implementation.rv5stages.length()
  inst distribution(TiledDistributionNetwork(implementation.distribution))
  // Platform time advances at the configured architectural timebase; each
  // resulting snapshot and each interrupt change cross the narrow platform NoC.
  inst timebase(Counter(config.clocks.timebase_period_cycles))

  for (index in 0..implementation.rv5stages.length()):
    def entry = implementation.rv5stages[index]
    rv5stages[index].identity <== RV5StageTileIdentity(p, site_width):
      site_key: bits(implementation.site_key(entry.placement.router), site_width)
      hart_id: bits(index, 64)
      chi: (RV5StageCHIIdentity(p):
              instruction_node_id: bits(entry.chi.instruction_node_id, p.node_id_width)
              data_node_id: bits(entry.chi.data_node_id, p.node_id_width)
              uncached_node_id: bits(entry.chi.uncached_node_id, p.node_id_width))
    distribution.interrupt_egress[index] <=> rv5stages[index].interrupt_update
    distribution.external_interrupt_egress[index] <=> rv5stages[index].external_interrupt_update
    distribution.time_egress[index] <=> rv5stages[index].time_beat
  host.release |> boot.release
  for (index in 0..implementation.rv5stages.length()):
    boot.hart_release[index] |> rv5stages[index].release

  for (index in 0..implementation.llcs.length()):
    def entry = implementation.llcs[index]
    llcs[index].identity <== LLCTileIdentity(p, site_width):
      site_key: bits(implementation.site_key(entry.placement.router), site_width)
      home: (CHIHNFIdentity(p):
               home_node_id: bits(entry.home_params.home.node_id, p.node_id_width)
               subordinate_node_id: bits(entry.home_params.subordinate_endpoint.node_id, p.node_id_width)
               service_base: bits(entry.projector_params.global_address_set.base, p.request_address_width))
      projector: (CHIAddressProjectorIdentity(p):
                    global_service_base: bits(entry.projector_params.global_address_set.base, p.request_address_width)
                    local_base: bits(entry.projector_params.local_address_set.base, p.request_address_width))
      ram: (CHIRamIdentity(p):
              node_id: bits(entry.ram_params.node_id, p.node_id_width)
              base_address: bits(entry.ram_params.base_address, p.request_address_width))

  for (index in 0..implementation.transits.length()):
    def entry = implementation.transits[index]
    transits[index].site_key <== bits(implementation.site_key(entry.placement.router), site_width)
  host_tile.site_key <== bits(implementation.site_key(implementation.host.placement.router), site_width)
  host.memory <=> host_tile.host
  device_home.site_key <== bits(implementation.site_key(implementation.device_home.placement.router), site_width)
  bootrom.identity <== CHIBootROMIdentity(p):
    node_id: bits(implementation.bootrom.device.node_id, p.node_id_width)
    base_address: bits(implementation.bootrom.device.base_address, p.request_address_width)
  bootrom.port <=> device_home.subordinate[0]
  boot_address.identity <== BootAddressIdentity(p):
    node_id: bits(implementation.platform.boot_address.node_id, p.node_id_width)
    base_address: bits(implementation.platform.boot_address.base_address, p.request_address_width)
  boot_address.port <=> device_home.subordinate[1]
  aclint.identity <== AclintTileIdentity(p, site_width):
    site_key: bits(implementation.site_key(implementation.aclint.placement.router), site_width)
    aclint: (AclintIdentity(p):
               node_id: bits(implementation.aclint.device.node.node_id, p.node_id_width)
               base_address: bits(implementation.aclint.device.base_address, p.request_address_width))
  timebase.enable <== Bool(#true)
  aclint.tick <== timebase.wrap
  aclint.time_beat <=> distribution.time_ingress
  aclint.interrupt_update <=> distribution.interrupt_ingress
  plic.identity <== PlicTileIdentity(p, site_width):
    site_key: bits(implementation.site_key(implementation.plic.placement.router), site_width)
    plic: (PlicIdentity(p):
             node_id: bits(implementation.plic.device.node.node_id, p.node_id_width)
             base_address: bits(implementation.plic.device.base_address, p.request_address_width))
  plic.sources <== vec([uart_device.uart.interrupt])
  plic.external_interrupt_update <=> distribution.external_interrupt_ingress
  uart_device.identity <== UartTileIdentity(p, site_width):
    site_key: bits(implementation.site_key(implementation.uart.placement.router), site_width)
    uart: (Uart16550Identity(p):
             node_id: bits(implementation.uart.device.node.node_id, p.node_id_width)
             base_address: bits(implementation.uart.device.base_address, p.request_address_width))
  uart <=> uart_device.uart

  def tiles = (
    for List (index in 0..implementation.rv5stages.length()):
      CHIRouterEndpoints(implementation.site_key(implementation.rv5stages[index].placement.router),
                         rv5stages[index].incoming_links,
                         rv5stages[index].outgoing_links)
  ) ++ (
    for List (index in 0..implementation.transits.length()):
      CHIRouterEndpoints(implementation.site_key(implementation.transits[index].placement.router),
                         transits[index].incoming_links,
                         transits[index].outgoing_links)
  ) ++ [
    CHIRouterEndpoints(implementation.site_key(implementation.host.placement.router),
                       host_tile.incoming_links,
                       host_tile.outgoing_links),
    CHIRouterEndpoints(implementation.site_key(implementation.device_home.placement.router),
                       device_home.incoming_links,
                       device_home.outgoing_links),
    CHIRouterEndpoints(implementation.site_key(implementation.aclint.placement.router),
                       aclint.incoming_links,
                       aclint.outgoing_links),
    CHIRouterEndpoints(implementation.site_key(implementation.plic.placement.router),
                       plic.incoming_links,
                       plic.outgoing_links),
    CHIRouterEndpoints(implementation.site_key(implementation.uart.placement.router),
                       uart_device.incoming_links,
                       uart_device.outgoing_links)
  ] ++ (
    for List (index in 0..implementation.llcs.length()):
      CHIRouterEndpoints(implementation.site_key(implementation.llcs[index].placement.router),
                         llcs[index].incoming_links,
                         llcs[index].outgoing_links)
  )
  connect_chi_router_family(implementation.physical_plan, tiles)

export:
  RV5StageTileSpec
  LLCTileSpec
  HostTileSpec
  DeviceHomeTileSpec
  AclintTileSpec
  PlicTileSpec
  UartTileSpec
  TransitTileSpec
  TiledTileSpec
  TiledTileCell
  TileGrid
  TiledNodeIds
  StripedMemory
  LLCGeometry
  TiledSoCConfig
  rv5stage_tile
  llc_tile
  host_tile
  device_home_tile
  aclint_tile
  plic_tile
  uart_tile
  transit_tile
  repeat_tiled_tile
  tile_grid
  default_tiled_soc_layout
  tiled_soc_core_profile
  tiled_soc_clocks
  default_tiled_soc_config
  TiledSoC
