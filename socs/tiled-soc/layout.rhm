class RV5StageTileSpec()
class LLCTileSpec()
class MemoryTileSpec()
class HostTileSpec()
class DeviceHomeTileSpec()
class AclintTileSpec()
class PlicTileSpec()
class UartTileSpec()
class TransitTileSpec()

annot.macro 'TiledTileSpec':
  'RV5StageTileSpec || LLCTileSpec || MemoryTileSpec || HostTileSpec || DeviceHomeTileSpec || AclintTileSpec || PlicTileSpec || UartTileSpec || TransitTileSpec'

def rv5stage_tile = RV5StageTileSpec()
def llc_tile = LLCTileSpec()
def memory_tile = MemoryTileSpec()
def host_tile = HostTileSpec()
def device_home_tile = DeviceHomeTileSpec()
def aclint_tile = AclintTileSpec()
def plic_tile = PlicTileSpec()
def uart_tile = UartTileSpec()
def transit_tile = TransitTileSpec()

fun repeat_tiled_tile(tile :: TiledTileSpec,
                      count :: PosInt) :: NonemptyList.of(TiledTileSpec):
  for List (_index in 0..count): tile

class TiledTileCell(tile :: TiledTileSpec,
                    coordinate :: MeshCoordinate)

fun tiled_tile_cells(rows :: NonemptyList.of(NonemptyList),
                     width :: PosInt,
                     height :: PosInt) :: NonemptyList.of(TiledTileCell):
  def mutable cells = []
  for (y in 0..height):
    for (x in 0..width):
      def source_row = height - y - 1
      cells := cells ++ [TiledTileCell(rows[source_row][x], MeshCoordinate(x, y))]
  cells

class TileGrid(rows :: NonemptyList.of(NonemptyList)):
  property width :: PosInt: rows[0].length()
  property height :: PosInt: rows.length()
  property cells :: NonemptyList.of(TiledTileCell):
    tiled_tile_cells(rows, width, height)
  property rv5stages:
    cells.filter(~keep: fun (cell): cell.tile is_a RV5StageTileSpec)
  property llcs:
    cells.filter(~keep: fun (cell): cell.tile is_a LLCTileSpec)
  property memories:
    cells.filter(~keep: fun (cell): cell.tile is_a MemoryTileSpec)
  property hosts:
    cells.filter(~keep: fun (cell): cell.tile is_a HostTileSpec)
  property device_homes:
    cells.filter(~keep: fun (cell): cell.tile is_a DeviceHomeTileSpec)
  property aclints:
    cells.filter(~keep: fun (cell): cell.tile is_a AclintTileSpec)
  property plics:
    cells.filter(~keep: fun (cell): cell.tile is_a PlicTileSpec)
  property uarts:
    cells.filter(~keep: fun (cell): cell.tile is_a UartTileSpec)
  property transits:
    cells.filter(~keep: fun (cell): cell.tile is_a TransitTileSpec)

  constructor (rows :: NonemptyList.of(NonemptyList)):
    def width = rows[0].length()
    for (row in rows):
      unless row.length() == width
      | error(~who: #'TileGrid, "tile-grid rows must have equal width")
      for (tile in row):
        unless tile is_a TiledTileSpec
        | error(~who: #'TileGrid, "tile-grid cells must contain tile specifications")
    def cells = tiled_tile_cells(rows, width, rows.length())
    def rv5stage_count = cells.filter(~keep: fun (cell): cell.tile is_a RV5StageTileSpec).length()
    def llc_count = cells.filter(~keep: fun (cell): cell.tile is_a LLCTileSpec).length()
    def host_count = cells.filter(~keep: fun (cell): cell.tile is_a HostTileSpec).length()
    def device_home_count = cells.filter(~keep: fun (cell): cell.tile is_a DeviceHomeTileSpec).length()
    def aclint_count = cells.filter(~keep: fun (cell): cell.tile is_a AclintTileSpec).length()
    def plic_count = cells.filter(~keep: fun (cell): cell.tile is_a PlicTileSpec).length()
    def uart_count = cells.filter(~keep: fun (cell): cell.tile is_a UartTileSpec).length()
    unless rv5stage_count > 0
    | error(~who: #'TileGrid, "tile grid requires at least one RV5Stage tile")
    unless llc_count > 0
    | error(~who: #'TileGrid, "tile grid requires at least one LLC tile")
    unless host_count == 1
    | error(~who: #'TileGrid, "tile grid requires exactly one host tile")
    unless device_home_count == 1
    | error(~who: #'TileGrid, "tile grid requires exactly one device Home tile")
    unless aclint_count == 1
    | error(~who: #'TileGrid, "tile grid requires exactly one ACLINT tile")
    unless plic_count == 1
    | error(~who: #'TileGrid, "tile grid requires exactly one PLIC tile")
    unless uart_count == 1
    | error(~who: #'TileGrid, "tile grid requires exactly one UART tile")
    unless cells.filter(~keep: fun (cell): cell.tile is_a MemoryTileSpec).length() == 1
    | error(~who: #'TileGrid, "tile grid requires exactly one memory-channel tile")
    super(rows)

  method tile_at(x :: Nat, y :: Nat) :: TiledTileSpec:
    unless x < width && y < height
    | error(~who: #'TileGrid, "tile coordinate is outside the grid")
    rows[height - y - 1][x]

class TiledNodeIds(rv5stage_coherent_base :: Nat,
                   rv5stage_uncached_base :: Nat,
                   host :: Nat,
                   llc_home_base :: Nat,
                   device_home :: Nat,
                   memory :: Nat,
                   bootrom_subordinate :: Nat,
                   aclint_subordinate :: Nat,
                   plic_subordinate :: Nat,
                   uart_subordinate :: Nat,
                   boot_address_subordinate :: Nat):
  constructor (~rv5stage_coherent_base: rv5stage_coherent_base :: Nat,
               ~rv5stage_uncached_base: rv5stage_uncached_base :: Nat,
               ~host: host :: Nat,
               ~llc_home_base: llc_home_base :: Nat,
               ~device_home: device_home :: Nat,
               ~memory: memory :: Nat,
               ~bootrom_subordinate: bootrom_subordinate :: Nat,
               ~aclint_subordinate: aclint_subordinate :: Nat,
               ~plic_subordinate: plic_subordinate :: Nat,
               ~uart_subordinate: uart_subordinate :: Nat,
               ~boot_address_subordinate: boot_address_subordinate :: Nat):
    super(rv5stage_coherent_base,
          rv5stage_uncached_base,
          host,
          llc_home_base,
          device_home,
          memory,
          bootrom_subordinate,
          aclint_subordinate,
          plic_subordinate,
          uart_subordinate,
          boot_address_subordinate)

class StripedMemory(base :: Nat,
                    size_bytes :: Pow2Int,
                    stripe_bytes :: Pow2Int):
  constructor (~base: base :: Nat,
               ~size_bytes: size_bytes :: Pow2Int,
               ~stripe_bytes: stripe_bytes :: Pow2Int):
    super(base, size_bytes, stripe_bytes)

fun tiled_power_of_two(value :: PosInt) :: Boolean:
  value == 1 || (value mod 2 == 0 && tiled_power_of_two(value / 2))

class LLCGeometry(sets :: PosInt,
                  ways :: PosInt):
  property capacity_bytes :: PosInt: sets * ways * 64

  constructor (~sets: sets :: PosInt,
               ~ways: ways :: PosInt):
    unless sets >= 2 && tiled_power_of_two(sets)
    | error(~who: #'LLCGeometry,
            "LLC set count must be a power of two of at least two")
    super(sets, ways)

class TiledSoCConfig(layout :: TileGrid,
                     node_ids :: TiledNodeIds,
                     memory :: StripedMemory,
                     llc :: LLCGeometry,
                     core_profile :: RVCoreProfile,
                     clocks :: SoCClockConfig,
                     flit :: CHIFlitParams,
                     boot :: SoCBootConfig):
  implements StableCircuitParam

  property hart_count: layout.rv5stages.length()
  property memory_bytes: memory.size_bytes
  property device_home:
    CHIHomeParams("tiled-device-home",
                  node_ids.device_home,
                  CHINodeKind.HNI,
                  ~max_outstanding: 1)
  method platform_for(home :: CHIHomeParams):
    SoCPlatformParams(flit,
                      hart_count,
                      home,
                      boot,
                      node_ids.bootrom_subordinate,
                      node_ids.aclint_subordinate,
                      node_ids.plic_subordinate,
                      node_ids.uart_subordinate,
                      node_ids.boot_address_subordinate)
  property platform: platform_for(device_home)
  property description:
    RiscvSoCDescription(
      ~model: "Rhodium TiledSoC",
      ~compatible: ["rhodium,tiled-soc"],
      ~harts: for List (index in 0..hart_count): index,
      ~core_profile: core_profile,
      ~clocks: clocks,
      ~memory_regions: [SoCAddressRegion(AddressSet(memory.base, memory_bytes - 1))],
      ~boot: platform.boot_description,
      ~aclint: platform.aclint_description,
      ~plic: platform.plic_description,
      ~uart: platform.uart_description
    )

  constructor (~layout: layout :: TileGrid,
               ~node_ids: node_ids :: TiledNodeIds,
               ~memory: memory :: StripedMemory,
               ~llc: llc :: LLCGeometry,
               ~core_profile: core_profile :: RVCoreProfile,
               ~clocks: clocks :: SoCClockConfig,
               ~flit: flit :: CHIFlitParams = CHIFlitParams(),
               ~boot: boot :: SoCBootConfig = riscv_soc_boot_config(~payload_address: memory.base)):
    unless memory.stripe_bytes >= 64
    | error(~who: #'TiledSoCConfig,
            "striped-memory stripes must contain a complete LLC line")
    unless tiled_power_of_two(layout.llcs.length())
    | error(~who: #'TiledSoCConfig,
            "LLC count must be a power of two for striped memory")
    unless memory.size_bytes >= memory.stripe_bytes * layout.llcs.length()
    | error(~who: #'TiledSoCConfig, "memory must contain at least one stripe per LLC")
    unless llc.capacity_bytes <= memory.size_bytes / layout.llcs.length()
    | error(~who: #'TiledSoCConfig, "each LLC must fit within its share of memory")
    unless core_profile.xlen.width == 64
    | error(~who: #'TiledSoCConfig, "TiledSoC requires an RV64 core profile")
    AddressSet(memory.base, memory.size_bytes - 1)
    super(layout, node_ids, memory, llc, core_profile, clocks, flit, boot)

meta:
  fun tile_run(entry :: Syntax):
    match entry
    | 'rv5stage': '[rv5stage_tile]'
    | 'rv5stage($count)': 'repeat_tiled_tile(rv5stage_tile, $count)'
    | 'llc': '[llc_tile]'
    | 'llc($count)': 'repeat_tiled_tile(llc_tile, $count)'
    | 'memory': '[memory_tile]'
    | 'host': '[host_tile]'
    | 'host($count)': 'repeat_tiled_tile(host_tile, $count)'
    | 'device_home': '[device_home_tile]'
    | 'device_home($count)': 'repeat_tiled_tile(device_home_tile, $count)'
    | 'aclint': '[aclint_tile]'
    | 'aclint($count)': 'repeat_tiled_tile(aclint_tile, $count)'
    | 'plic': '[plic_tile]'
    | 'plic($count)': 'repeat_tiled_tile(plic_tile, $count)'
    | 'uart': '[uart_tile]'
    | 'uart($count)': 'repeat_tiled_tile(uart_tile, $count)'
    | 'transit': '[transit_tile]'
    | 'transit($count)': 'repeat_tiled_tile(transit_tile, $count)'
    | ~else:
        syntax_meta.error(
          "expected rv5stage, llc, memory, host, device_home, aclint, plic, uart, or transit tile",
          entry
        )

  fun append_runs(runs :: NonemptyList.of(Syntax)):
    if runs.length() == 1
    | runs[0]
    | block:
        def first = runs[0]
        def rest = append_runs(runs.drop(1))
        '$first ++ $rest'

  fun tile_row(clause :: Syntax):
    match clause
    | 'row [$entry, ...]':
        def entries = [entry, ...]
        when entries.length() == 0
        | syntax_meta.error("tile-grid rows must not be empty", clause)
        append_runs(entries.map(tile_run))
    | ~else:
        syntax_meta.error("expected tile-grid row declaration", clause)

expr.macro 'tile_grid:
              $clause
              ...':
  ~op_stx self
  def clauses = [clause, ...]
  when clauses.length() == 0
  | syntax_meta.error("tile grid requires at least one row", self)
  def rows = clauses.map(tile_row)
  let [row, ...] = rows
  'TileGrid([$row, ...])'
