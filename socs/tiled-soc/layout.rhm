#lang rhombus/and_meta
// Defines the author-facing TiledSoC layout, NodeIDs, boot policy, and immutable configuration.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/meta open
  "../../noc/std/topology/rectangular-mesh.rhm".MeshCoordinate
  "../../chi/protocol/params.rhdl".CHIFlitParams
  "../../chi/protocol/fabric.rhdl".CHIHomeParams
  "../../chi/protocol/link.rhdl".CHINodeKind
  "../../rhodium/std/bits.rhdl".Pow2Int
  "../../rhodium/std/interconnect.rhdl".AddressSet
  "../../rhodium/frontend/foundation.rhm".StableCircuitParam
  "../../cores/rv5stage/profile.rhm".RVCoreProfile
  "../boot.rhdl" open
  "../description.rhm" open
  "../peripherals.rhdl".SoCPlatformParams

export:
  RV5StageTileSpec
  LLCTileSpec
  MemoryTileSpec
  HostTileSpec
  DeviceHomeTileSpec
  AclintTileSpec
  PlicTileSpec
  UartTileSpec
  TransitTileSpec
  TiledTileSpec
  TiledTileCell
  TileGrid
  TiledNodeIds
  StripedMemory
  LLCGeometry
  TiledSoCConfig
  rv5stage_tile
  llc_tile
  memory_tile
  host_tile
  device_home_tile
  aclint_tile
  plic_tile
  uart_tile
  transit_tile
