#lang rhodium
// Privately compiles one TiledSoC configuration into boot, placement, fabric, and tile parameters.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("chi/protocol/params.rhdl").CHIFlitParams
  lib("chi/protocol/flits.rhdl").CHIReqOpcode
  lib("chi/protocol/flits.rhdl").CHIRspOpcode
  lib("chi/protocol/flits.rhdl").CHIDatOpcode
  lib("chi/protocol/link.rhdl") open
  lib("chi/noc/noc-authoring.rhm") open
  lib("chi/noc/noc-adapter.rhdl") open
  lib("chi/noc/noc-router.rhdl") open
  lib("chi/protocol/fabric.rhdl") open
  lib("rhodium/std/interconnect.rhdl").StripedAddressLayout
  lib("chi/home/home.rhdl").CHIHNIParams
  lib("chi/home/home-common.rhdl") open
  lib("chi/home/inclusive-home.rhdl").CHIInclusiveHNFConfig
  lib("noc/authoring/main.rhm") open
  lib("noc/plan/main.rhm") open
  lib("noc/std/topology/main.rhm") open
  lib("noc/std/routing/main.rhm") open
  lib("noc/rtl/router.rhdl") open
  lib("cores/riscv/chi-hart.rhdl") open
  lib("riscv/rtl/pma.rhdl") open
  lib("devices/boot/bootrom.rhdl").CHIBootROMParams
  lib("devices/interrupt/aclint.rhdl").AclintParams
  lib("devices/interrupt/plic.rhdl").PlicParams
  lib("devices/uart/uart16550.rhdl").Uart16550Params
  "../platform/boot.rhdl" open
  "../platform/peripherals.rhdl" open
  "../platform/endpoint-params.rhdl" open
  "tiles/main.rhdl" open
  "layout.rhm" open
  "distribution.rhdl" open
  "compiled.rhdl" open

fun require_tiled_node_id_width(node_ids :: NonemptyList.of(Nat),
                                flit :: CHIFlitParams):
  for (node_id in node_ids):
    unless bits.length(node_id) <= flit.node_id_width
    | error(~who: #'compile_tiled_soc, "TiledSoC NodeID does not fit the CHI flit")

fun require_unique_tiled_node_ids(node_ids :: NonemptyList.of(Nat)):
  for (node_id in node_ids):
    if node_ids.filter(
      ~keep: fun (candidate): candidate == node_id
    ).length() > 1
    | error(~who: #'compile_tiled_soc, "TiledSoC NodeIDs must be unique")
    | #void

fun compile_tiled_soc(config :: TiledSoCConfig) :: TiledSoCImplementation:
  def flit = config.flit
  def layout = config.layout
  def ids = config.node_ids
  def memory = config.memory
  def mesh = rectangular_mesh(layout.width,
                              layout.height,
                              [VCGroup("transport", 1)])

  def hart_placements:
    for List (cell in layout.harts,
              index in 0..layout.harts.length()):
      def coordinate = cell.coordinate
      def router = mesh.node_at(coordinate.x, coordinate.y)
      def path = NamePath(["hart", to_string(index)])
      def instruction_node_id = ids.hart_coherent_base + (index * 2)
      def data_node_id = instruction_node_id + 1
      def uncached_node_id = ids.hart_uncached_base + index
      TiledHartPlacement(
        index,
        coordinate,
        router,
        instruction_node_id,
        data_node_id,
        uncached_node_id,
        CHIRNSite(path.child("l1i"), instruction_node_id, router),
        CHIRNSite(path.child("l1d"), data_node_id, router),
        CHIRNSite(path.child("uncached"), uncached_node_id, router)
      )

  def llc_placements:
    for List (cell in layout.llcs,
              index in 0..layout.llcs.length()):
      def coordinate = cell.coordinate
      def router = mesh.node_at(coordinate.x, coordinate.y)
      def home_node_id = ids.llc_home_base + index
      TiledLLCPlacement(
        index,
        coordinate,
        router,
        home_node_id,
        index,
        CHIRNICNSite(NamePath(["llc", to_string(index), "home"]), home_node_id, router),
        CHISNICNSite(NamePath(["llc", to_string(index), "subordinate"]), home_node_id, router)
      )

  def memory_cell = layout.memories[0]
  def memory_router = mesh.node_at(memory_cell.coordinate.x, memory_cell.coordinate.y)
  def memory_placement = TiledMemoryPlacement(memory_cell.coordinate, memory_router, CHISNSite(NamePath(["memory"]), ids.memory, memory_router))

  def host_cell = layout.hosts[0]
  def host_router = mesh.node_at(host_cell.coordinate.x, host_cell.coordinate.y)
  def host_placement = TiledHostPlacement(
    host_cell.coordinate,
    host_router,
    ids.host,
    CHIRNSite(NamePath(["host"]), ids.host, host_router)
  )

  def device_home_cell = layout.device_homes[0]
  def device_home_router = mesh.node_at(device_home_cell.coordinate.x,
                                        device_home_cell.coordinate.y)
  def device_home_placement = TiledDeviceHomePlacement(
    device_home_cell.coordinate,
    device_home_router,
    ids.device_home,
    CHIRNICNSite(NamePath(["device-home", "requester"]),
                 ids.device_home,
                 device_home_router),
    CHISNICNSite(NamePath(["device-home", "subordinate"]),
                 ids.device_home,
                 device_home_router)
  )

  def bootrom_placement = TiledBootROMPlacement(
    device_home_cell.coordinate,
    device_home_router,
    ids.bootrom_subordinate,
    CHISNSite(NamePath(["devices", "bootrom"]), ids.bootrom_subordinate, device_home_router)
  )

  def boot_address_site = CHISNSite(NamePath(["devices", "boot-address"]), ids.boot_address_subordinate, device_home_router)

  def aclint_cell = layout.aclints[0]
  def aclint_router = mesh.node_at(aclint_cell.coordinate.x, aclint_cell.coordinate.y)
  def aclint_placement = TiledAclintPlacement(
    aclint_cell.coordinate,
    aclint_router,
    ids.aclint_subordinate,
    CHISNSite(NamePath(["devices", "aclint"]), ids.aclint_subordinate, aclint_router)
  )

  def plic_cell = layout.plics[0]
  def plic_router = mesh.node_at(plic_cell.coordinate.x, plic_cell.coordinate.y)
  def plic_placement = TiledPlicPlacement(
    plic_cell.coordinate,
    plic_router,
    ids.plic_subordinate,
    CHISNSite(NamePath(["devices", "plic"]), ids.plic_subordinate, plic_router)
  )

  def uart_cell = layout.uarts[0]
  def uart_router = mesh.node_at(uart_cell.coordinate.x, uart_cell.coordinate.y)
  def uart_placement = TiledUartPlacement(
    uart_cell.coordinate,
    uart_router,
    ids.uart_subordinate,
    CHISNSite(NamePath(["devices", "uart"]), ids.uart_subordinate, uart_router)
  )

  def transit_placements:
    for List (cell in layout.transits,
              index in 0..layout.transits.length()):
      TiledTransitPlacement(
        index,
        cell.coordinate,
        mesh.node_at(cell.coordinate.x, cell.coordinate.y)
      )

  def mutable rnf_sites = [host_placement.site]
  for (placement in hart_placements):
    rnf_sites := rnf_sites ++ [placement.data_site]
  def uncached_sites = hart_placements.map(fun (placement): placement.uncached_site)

  def mutable connections = []
  for (requester in rnf_sites):
    for (llc_placement in llc_placements):
      connections := connections ++ [CHIRNFConnection(requester, llc_placement.home_site)]
  for (placement in llc_placements):
    connections := connections ++ [CHISNConnection(placement.subordinate_site, memory_placement.site)]
  for (placement in hart_placements):
    connections := connections ++ [CHIRNIConnection(placement.instruction_site, device_home_placement.requester_site)]
    for (llc_placement in llc_placements):
      connections := connections ++ [CHIRNIConnection(placement.instruction_site, llc_placement.home_site)]
  for (requester in [host_placement.site] ++ uncached_sites):
    connections := connections ++ [CHIRNIConnection(requester, device_home_placement.requester_site)]
  connections := connections ++ [
    CHISNConnection(device_home_placement.subordinate_site, bootrom_placement.site),
    CHISNConnection(device_home_placement.subordinate_site, boot_address_site),
    CHISNConnection(device_home_placement.subordinate_site, aclint_placement.site),
    CHISNConnection(device_home_placement.subordinate_site, plic_placement.site),
    CHISNConnection(device_home_placement.subordinate_site, uart_placement.site)
  ]

  def routing = uniform_chi_routing(
    xy_dimension_order(mesh, ~vc_groups: ["transport"])
  )
  def compilations = compile_chi_connections(mesh.spec, connections, routing)
  def families = TiledChannelFamilyPlans(
    RouterFamilyPlan(compilations.req.network.network_plan),
    RouterFamilyPlan(compilations.rsp.network.network_plan),
    RouterFamilyPlan(compilations.snp.network.network_plan),
    RouterFamilyPlan(compilations.dat.network.network_plan)
  )
  def physical_plan = RouterFamilyPhysicalPlan(families.req)
  physical_plan.require_match(families.rsp)
  physical_plan.require_match(families.snp)
  physical_plan.require_match(families.dat)
  def distribution = compile_tiled_distribution(
    mesh,
    aclint_placement.router,
    plic_placement.router,
    hart_placements.map(fun (placement): placement.router)
  )

  def node_ids = hart_placements.map(
    fun (placement): placement.instruction_node_id
  ) ++ hart_placements.map(
    fun (placement): placement.data_node_id
  ) ++ hart_placements.map(
    fun (placement): placement.uncached_node_id
  ) ++ llc_placements.map(
    fun (placement): placement.home_node_id
  ) ++ [ids.memory, host_placement.node_id,
        device_home_placement.node_id,
        bootrom_placement.node_id,
        ids.boot_address_subordinate,
        aclint_placement.node_id,
        plic_placement.node_id,
        uart_placement.node_id]
  require_unique_tiled_node_ids(node_ids)
  require_tiled_node_id_width(node_ids, flit)

  def host_node = soc_host_node(host_placement.node_id)
  def host_port = host_node.icn_peer()

  def address_layout = StripedAddressLayout(
    memory.size_bytes / llc_placements.length(),
    memory.stripe_bytes,
    llc_placements.length()
  )

  def homes:
    for List (placement in llc_placements):
      CHIHomeParams("tiled-home-" ++ to_string(placement.index),
                    placement.home_node_id,
                    CHINodeKind.HNF,
                    ~max_outstanding: config.llc.transaction_slots)
  def device_home = config.device_home
  def platform = config.platform_for(device_home)

  def memory_attributes = RiscvPhysicalMemoryAttributes(#true, #true, #true, #true, #true, #false, #true, ~cache_block_zero: #true)
  def hart_config = RiscvHartCHIConfig(
    flit,
    config.hart.cache_line_bytes,
    (for List (placement in llc_placements,
               home in homes):
       RiscvHartCHIRegion(
         RiscvPhysicalMemoryRegion(
           address_layout.address_set(memory.base, placement.slice_index),
           memory_attributes
         ),
         home
       )) ++ platform.regions
  )
  unless for any (placement in llc_placements):
    address_layout.address_set(memory.base, placement.slice_index).contains(config.boot.payload_address)
  | error(~who: #'compile_tiled_soc, "BootROM payload address must lie in normal memory")

  def hart_chi_params:
    for List (placement in hart_placements):
      config.hart.chi_params(hart_config,
                             placement.instruction_node_id,
                             placement.data_node_id,
                             placement.uncached_node_id)
  def mutable requester_ports = [soc_host_home_port(host_node, ~coherent: #true)]
  for (params in hart_chi_params):
    requester_ports := requester_ports ++ [
      params.instruction_home_port(~coherent: #true),
      params.data_node.icn_peer()
    ]
  def uncached_ports = hart_chi_params.map(
    fun (params): params.uncached_node.icn_peer()
  )

  def instruction_device_ports = hart_chi_params.map(fun (params): params.instruction_home_port(~coherent: #false))
  def device_home_params = platform.home_params(uncached_ports ++ [soc_host_home_port(host_node, ~coherent: #false)] ++ instruction_device_ports)

  def memory_node = CHINodeParams(
    "tiled-memory", ids.memory, CHINodeKind.SNF,
    ~emits: CHIChannelCapabilities(~rsp: [CHIRspOpcode.DBIDResp, CHIRspOpcode.Comp], ~dat: [CHIDatOpcode.CompData]),
    ~supports: CHIChannelCapabilities(~req: [CHIReqOpcode.ReadNoSnp, CHIReqOpcode.WriteNoSnpFull, CHIReqOpcode.WriteNoSnpPtl], ~dat: [CHIDatOpcode.NonCopyBackWriteData]),
    ~max_outstanding: 4)
  def memory_service = CHISubordinateServiceParams(
    memory_node.icn_peer(),
    [AddressSet(memory.base, memory.size_bytes - 1)],
    for List (opcode in [CHIReqOpcode.ReadNoSnp, CHIReqOpcode.WriteNoSnpFull, CHIReqOpcode.WriteNoSnpPtl]):
      CHIRequestSupport(opcode, TransferSizes(1, 64)))

  def hnf_config = CHIHNFConfig(
    flit,
    requester_ports,
    address_layout.global_mask,
    memory_service.requests,
    ~transaction_slots: config.llc.transaction_slots
  )
  def hnf_params:
    for List (home in homes, placement in llc_placements):
      CHIHNFParams(home, hnf_config, CHISubordinateServiceParams(memory_service.endpoint, [address_layout.address_set(memory.base, placement.slice_index)], memory_service.requests))
  def llc_config = CHIInclusiveHNFConfig(
    hnf_config,
    address_layout,
    ~sets: config.llc.sets,
    ~ways: config.llc.ways
  )

  def adapter_plans = CHIChannelAdapterPlans(
    compile_chi_channel_family_adapter_plan(compilations.req,
                                            families.req,
                                            flit),
    compile_chi_channel_family_adapter_plan(compilations.rsp,
                                            families.rsp,
                                            flit),
    compile_chi_channel_family_adapter_plan(compilations.snp,
                                            families.snp,
                                            flit),
    compile_chi_channel_family_adapter_plan(compilations.dat,
                                            families.dat,
                                            flit)
  )
  def router_configs = CHIRouterFamilyConfigs(
    compile_simple_router_family(families.req),
    compile_simple_router_family(families.rsp),
    compile_simple_router_family(families.snp),
    compile_simple_router_family(families.dat),
    physical_plan
  )

  def hart_router_params = CHIRouterParams(
    flit,
    router_configs,
    compile_chi_router_attachment_plan(
      router_configs,
      adapter_plans,
      CHIRouterAttachments(
        ~rnf_sites: (for List (placement in hart_placements):
                      [placement.data_site]),
        ~rni_sites: (for List (placement in hart_placements):
                      [placement.instruction_site, placement.uncached_site])
      )
    )
  )
  def llc_router_params = CHIRouterParams(
    flit,
    router_configs,
    compile_chi_router_attachment_plan(
      router_configs,
      adapter_plans,
      CHIRouterAttachments(
        ~hnf_requester_sites: (for List (placement in llc_placements):
                                [placement.home_site]),
        ~hn_subordinate_sites: (for List (placement in llc_placements):
                                 [placement.subordinate_site])
      )
    )
  )
  def memory_router_params = CHIRouterParams(flit, router_configs, compile_chi_router_attachment_plan(router_configs, adapter_plans, CHIRouterAttachments(~sn_sites: [[memory_placement.site]])))
  def device_home_router_params = CHIRouterParams(
    flit,
    router_configs,
    compile_chi_router_attachment_plan(
      router_configs,
      adapter_plans,
      CHIRouterAttachments(
        ~hni_requester_sites: [[device_home_placement.requester_site]],
        ~hn_subordinate_sites: [[device_home_placement.subordinate_site]],
        ~sn_sites: [[bootrom_placement.site, boot_address_site]]
      )
    )
  )
  def aclint_router_params = CHIRouterParams(
    flit,
    router_configs,
    compile_chi_router_attachment_plan(
      router_configs,
      adapter_plans,
      CHIRouterAttachments(~sn_sites: [[aclint_placement.site]])
    )
  )
  def plic_router_params = CHIRouterParams(
    flit,
    router_configs,
    compile_chi_router_attachment_plan(
      router_configs,
      adapter_plans,
      CHIRouterAttachments(~sn_sites: [[plic_placement.site]])
    )
  )
  def uart_router_params = CHIRouterParams(
    flit,
    router_configs,
    compile_chi_router_attachment_plan(
      router_configs,
      adapter_plans,
      CHIRouterAttachments(~sn_sites: [[uart_placement.site]])
    )
  )
  def host_router_params = CHIRouterParams(
    flit,
    router_configs,
    compile_chi_router_attachment_plan(
      router_configs,
      adapter_plans,
      CHIRouterAttachments(~rnf_sites: [[host_placement.site]])
    )
  )
  def transit_router_params = CHIRouterParams(
    flit,
    router_configs,
    compile_chi_router_attachment_plan(
      router_configs,
      adapter_plans,
      CHIRouterAttachments()
    )
  )

  def hart_tile_params = HartTileParams(hart_config,
                                        hart_router_params,
                                        hart_placements.length(),
                                        config.hart)
  def llc_tile_params = LLCTileParams(llc_config,
                                      llc_router_params)
  def device_home_tile_params = DeviceHomeTileParams(device_home_params, device_home_router_params)
  def aclint_tile_params = AclintTileParams(platform.aclint_config, aclint_router_params)
  def plic_tile_params = PlicTileParams(platform.plic_config,
                                        plic_router_params,
                                        hart_placements.length())
  def uart_tile_params = UartTileParams(platform.uart_config, uart_router_params)
  def host_tile_params = HostTileParams(host_router_params)
  def transit_tile_params = TransitTileParams(transit_router_params)

  def harts:
    for List (placement in hart_placements,
              params in hart_chi_params):
      HartTileInstance(placement, params, hart_tile_params)
  def llcs:
    for List (placement in llc_placements,
              home in hnf_params):
      LLCTileInstance(placement,
                      home,
                      llc_config,
                      address_layout.address_set(memory.base, placement.slice_index),
                      llc_tile_params)
  def memory_instance = MemoryTileInstance(memory_placement, memory_node, memory_service, memory_router_params)
  def host = HostTileInstance(host_placement, host_node, host_port, host_tile_params)
  def device_home_instance = DeviceHomeTileInstance(device_home_placement, device_home, device_home_params, device_home_tile_params)
  def bootrom = BootROMInstance(bootrom_placement, platform.bootrom.rom_params)
  def aclint = AclintTileInstance(aclint_placement, platform.aclint, aclint_tile_params)
  def plic = PlicTileInstance(plic_placement, platform.plic, plic_tile_params)
  def uart = UartTileInstance(uart_placement, platform.uart, uart_tile_params)
  def transits:
    for List (placement in transit_placements):
      TransitTileInstance(placement, transit_tile_params)

  TiledSoCImplementation(
    config,
    mesh,
    connections,
    compilations,
    families,
    physical_plan,
    distribution,
    node_ids,
    flit,
    hart_config.home_map,
    hart_config,
    address_layout,
    hnf_config,
    llc_config,
    platform,
    router_configs,
    harts,
    llcs,
    memory_instance,
    host,
    device_home_instance,
    bootrom,
    aclint,
    plic,
    uart,
    transits
  )

export:
  TiledHartPlacement
  TiledHostPlacement
  TiledLLCPlacement
  TiledMemoryPlacement
  TiledDeviceHomePlacement
  TiledBootROMPlacement
  TiledAclintPlacement
  TiledPlicPlacement
  TiledUartPlacement
  TiledTransitPlacement
  TiledChannelFamilyPlans
  HartTileInstance
  LLCTileInstance
  MemoryTileInstance
  HostTileInstance
  DeviceHomeTileInstance
  BootROMInstance
  AclintTileInstance
  PlicTileInstance
  UartTileInstance
  TransitTileInstance
  TiledSoCImplementation
  compile_tiled_soc
