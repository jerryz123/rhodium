#lang rhodium
// Attaches one shared ACLINT SN-I to its dedicated CHI service-row router.

import:
  lib("chi/main.rhdl") open
  lib("devices/aclint.rhdl") open
  lib("flow/main.rhdl") open
  "../distribution.rhdl" open
  "../time.rhdl" open

class AclintTileParams(aclint :: AclintConfig,
                       router :: CHIRouterParams):
  implements StableCircuitParam

bundle AclintTileIdentity(p :: CHIFlitParams, site_width :: PosInt):
  site_key: Bits(site_width)
  aclint: AclintIdentity(p)

sync_circuit AclintTile(params :: AclintTileParams):
  def router_params = params.router
  def p = params.aclint.flit
  def site_width = router_params.routers.req.route_decoder.site_width
  def Link = chi_noc_link_type(router_params)

  input identity: AclintTileIdentity(p, site_width)
  input tick: Bool
  interface time_beat(Irrevocable(TiledTimeBeat(params.aclint.hart_count)), ~role: producer)
  interface interrupt_update(Irrevocable(IndexedState(TiledHartInterrupts(), params.aclint.hart_count)), ~role: producer)
  interface incoming_links[router_params.routers.physical.ingress_count](Link, ~role: destination)
  interface outgoing_links[router_params.routers.physical.egress_count](Link, ~role: source)

  inst aclint(Aclint(params.aclint))
  inst time_sweeper(TiledTimeSweeper(params.aclint.hart_count))
  inst interrupt_source(StateChangeSource(TiledHartInterrupts(), params.aclint.hart_count, NoTiledHartInterrupts))
  inst router(CHIRouter(router_params))

  aclint.identity <== identity.aclint
  aclint.tick <== tick
  router.site_key <== identity.site_key
  aclint.port <=> router.sn_local[0]
  aclint.time_update <=> time_sweeper.update
  time_sweeper.egress <=> time_beat
  interrupt_source.current <== vec(
    for List (index in 0..params.aclint.hart_count):
      TiledHartInterrupts():
        machine_software: aclint.machine_software[index]
        machine_timer: aclint.machine_timer[index]
  )
  interrupt_source.egress <=> interrupt_update
  router.incoming_links <=> incoming_links
  router.outgoing_links <=> outgoing_links

export:
  AclintTileParams
  AclintTileIdentity
  AclintTile
