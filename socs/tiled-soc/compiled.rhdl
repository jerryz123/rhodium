#lang rhodium
// Defines the private compiled placement and tile-parameter model for TiledSoC.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("chi/protocol/params.rhdl").CHIFlitParams
  lib("chi/protocol/flits.rhdl").CHIReqOpcode
  lib("chi/protocol/flits.rhdl").CHIRspOpcode
  lib("chi/protocol/flits.rhdl").CHIDatOpcode
  lib("chi/protocol/link.rhdl") open
  lib("chi/noc/noc-authoring.rhm") open
  lib("chi/noc/noc-adapter.rhdl") open
  lib("chi/noc/noc-router.rhdl") open
  lib("chi/protocol/fabric.rhdl") open
  lib("rhodium/std/interconnect.rhdl").StripedAddressLayout
  lib("chi/home/home.rhdl").CHIHNIParams
  lib("chi/home/home-common.rhdl") open
  lib("chi/home/inclusive-home.rhdl").CHIInclusiveHNFConfig
  lib("noc/authoring/main.rhm") open
  lib("noc/plan/main.rhm") open
  lib("noc/std/topology/main.rhm") open
  lib("noc/std/routing/main.rhm") open
  lib("noc/rtl/router.rhdl") open
  lib("cores/riscv/chi-hart.rhdl") open
  lib("riscv/rtl/pma.rhdl") open
  lib("devices/boot/bootrom.rhdl").CHIBootROMParams
  lib("devices/interrupt/aclint.rhdl").AclintParams
  lib("devices/interrupt/plic.rhdl").PlicParams
  lib("devices/uart/uart16550.rhdl").Uart16550Params
  "../platform/boot.rhdl" open
  "../platform/peripherals.rhdl" open
  "../platform/endpoint-params.rhdl" open
  "tiles/main.rhdl" open
  "layout.rhm" open
  "distribution.rhdl" open

class TiledHartPlacement(index :: Nat,
                         coordinate :: MeshCoordinate,
                         router :: NodeRef,
                         instruction_node_id :: Nat,
                         data_node_id :: Nat,
                         uncached_node_id :: Nat,
                         instruction_site :: CHIRNSite,
                         data_site :: CHIRNSite,
                         uncached_site :: CHIRNSite)

class TiledHostPlacement(coordinate :: MeshCoordinate,
                         router :: NodeRef,
                         node_id :: Nat,
                         site :: CHIRNSite)

class TiledLLCPlacement(index :: Nat,
                        coordinate :: MeshCoordinate,
                        router :: NodeRef,
                        home_node_id :: Nat,
                        slice_index :: Nat,
                        home_site :: CHIRNICNSite,
                        subordinate_site :: CHISNICNSite)

class TiledMemoryPlacement(coordinate :: MeshCoordinate,
                           router :: NodeRef,
                           site :: CHISNSite)

class TiledDeviceHomePlacement(coordinate :: MeshCoordinate,
                               router :: NodeRef,
                               node_id :: Nat,
                               requester_site :: CHIRNICNSite,
                               subordinate_site :: CHISNICNSite)

class TiledBootROMPlacement(coordinate :: MeshCoordinate,
                            router :: NodeRef,
                            node_id :: Nat,
                            site :: CHISNSite)

class TiledAclintPlacement(coordinate :: MeshCoordinate,
                           router :: NodeRef,
                           node_id :: Nat,
                           site :: CHISNSite)

class TiledPlicPlacement(coordinate :: MeshCoordinate,
                         router :: NodeRef,
                         node_id :: Nat,
                         site :: CHISNSite)

class TiledUartPlacement(coordinate :: MeshCoordinate,
                         router :: NodeRef,
                         node_id :: Nat,
                         site :: CHISNSite)

class TiledTransitPlacement(index :: Nat,
                            coordinate :: MeshCoordinate,
                            router :: NodeRef)

class TiledChannelFamilyPlans(req :: RouterFamilyPlan,
                              rsp :: RouterFamilyPlan,
                              snp :: RouterFamilyPlan,
                              dat :: RouterFamilyPlan)

class HartTileInstance(placement :: TiledHartPlacement,
                       chi :: RiscvHartCHIAttachment,
                       tile_params :: HartTileParams)

class LLCTileInstance(placement :: TiledLLCPlacement,
                      home_params :: CHIHNFParams,
                      llc_config :: CHIInclusiveHNFConfig,
                      address_set :: AddressSet,
                      tile_params :: LLCTileParams)

class MemoryTileInstance(placement :: TiledMemoryPlacement,
                         node :: CHINodeParams,
                         service :: CHISubordinateServiceParams,
                         router_params :: CHIRouterParams)

class HostTileInstance(placement :: TiledHostPlacement,
                       node :: CHINodeParams,
                       port :: CHIICNPortParams,
                       tile_params :: HostTileParams)

class DeviceHomeTileInstance(placement :: TiledDeviceHomePlacement,
                             home :: CHIHomeParams,
                             home_params :: CHIHNIParams,
                             tile_params :: DeviceHomeTileParams)

class BootROMInstance(placement :: TiledBootROMPlacement,
                      device :: CHIBootROMParams)

class AclintTileInstance(placement :: TiledAclintPlacement,
                         device :: AclintParams,
                         tile_params :: AclintTileParams)

class PlicTileInstance(placement :: TiledPlicPlacement,
                       device :: PlicParams,
                       tile_params :: PlicTileParams)

class UartTileInstance(placement :: TiledUartPlacement,
                       device :: Uart16550Params,
                       tile_params :: UartTileParams)

class TransitTileInstance(placement :: TiledTransitPlacement,
                          tile_params :: TransitTileParams)

class TiledSoCImplementation(config :: TiledSoCConfig,
                             mesh :: RectangularMesh,
                             connections :: NonemptyList.of(CHIConnection),
                             compilations :: CHIChannelCompilations,
                             families :: TiledChannelFamilyPlans,
                             physical_plan :: RouterFamilyPhysicalPlan,
                             distribution :: TiledDistributionPlan,
                             node_ids :: NonemptyList.of(Nat),
                             flit :: CHIFlitParams,
                             home_map :: CHIHomeMap,
                             hart_config :: RiscvHartCHIConfig,
                             address_layout :: StripedAddressLayout,
                             hnf_config :: CHIHNFConfig,
                             llc_config :: CHIInclusiveHNFConfig,
                             platform :: SoCPlatformParams,
                             router_configs :: CHIRouterFamilyConfigs,
                             harts :: NonemptyList.of(HartTileInstance),
                             llcs :: NonemptyList.of(LLCTileInstance),
                             memory :: MemoryTileInstance,
                             host :: HostTileInstance,
                             device_home :: DeviceHomeTileInstance,
                             bootrom :: BootROMInstance,
                             aclint :: AclintTileInstance,
                             plic :: PlicTileInstance,
                             uart :: UartTileInstance,
                             transits :: List.of(TransitTileInstance)):
  implements StableCircuitParam

  property host_services:
    (for List (entry in home_map.entries.filter(~keep: fun (entry): entry.home.kind == CHINodeKind.HNF)):
       soc_host_memory_service(entry.home, [entry.address_set], memory.service.requests)) ++ platform.host_services
  property width :: PosInt: config.layout.width
  property height :: PosInt: config.layout.height
  property snp_compilation :: CHIChannelCompilation: compilations.snp

  method site_key(router :: NodeRef) :: Nat:
    physical_plan.site_key(compilations.req.network.router_id(router))

export:
  TiledHartPlacement
  TiledHostPlacement
  TiledLLCPlacement
  TiledMemoryPlacement
  TiledDeviceHomePlacement
  TiledBootROMPlacement
  TiledAclintPlacement
  TiledPlicPlacement
  TiledUartPlacement
  TiledTransitPlacement
  TiledChannelFamilyPlans
  HartTileInstance
  LLCTileInstance
  MemoryTileInstance
  HostTileInstance
  DeviceHomeTileInstance
  BootROMInstance
  AclintTileInstance
  PlicTileInstance
  UartTileInstance
  TransitTileInstance
  TiledSoCImplementation
