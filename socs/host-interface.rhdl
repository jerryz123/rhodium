#lang rhodium
// Defines the shared coherent RAM and non-snooping MMIO host boundary.

import:
  lib("chi/main.rhdl").CHIFlitParams
  lib("chi/main.rhdl").CHIRNChannels

interface SoCHostInterface(p :: CHIFlitParams):
  role host
  role soc
  provider host

  soc -> host:
    memory: CHIRNChannels(p)

export:
  SoCHostInterface
