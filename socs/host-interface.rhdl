#lang rhodium
// Defines the common coherent loader-memory and boot-release boundary exposed by SoCs.

import:
  lib("rhodium/std/ready-valid.rhdl").IrrevocableCtrl
  lib("chi/main.rhdl").CHIFlitParams
  lib("chi/main.rhdl").CHIRNChannels

interface SoCHostInterface(p :: CHIFlitParams):
  role host
  role soc
  provider host

  soc -> host:
    memory: CHIRNChannels(p)

  host -> soc:
    release: IrrevocableCtrl()

export:
  SoCHostInterface
