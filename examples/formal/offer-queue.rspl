#lang rspecl
/* Separates replaceable updates from committed FIFO words at an observable admission boundary. */
// SPDX-License-Identifier: Apache-2.0

import "offer-queue.rhdl" as rtl
import "offer-register.rspl".OfferRegister
import "shift-queue.rspl".ShiftQueue
import lib("rhodium/formal/spec.rhm").Observed

/* Read only parent pins. The transferred word is checked at retirement, not copied from the handoff. */
fun samples(read :: Function, output :: Function, w :: PosInt):
  def rst = read("reset", Bool)
  def flag = const(Bool, #true)
  {"reset": Observed(flag, rst),
   "install": Observed(read("update.bits", Bits(w)), !rst && read("update.valid", Bool)),
   "ready": Observed(flag, !rst && output("handoff_ready", Bool)),
   "retire": Observed(output("egress.bits", Bits(w)), !rst && output("egress.valid", Bool) && read("egress.ready", Bool))}

spec for rtl.OfferQueue:
  specialize w = update.bits.type.width ~default: 2
  monitor:
    sample fun (read, output): samples(read, output, w)
    publish []
    batch rst = present(reset)
    batch install = present(install)
    batch incoming: Bits(w) = payload(install) when install
    batch ready = present(ready)
    batch retire = present(retire)
    batch outgoing: Bits(w) = payload(retire) when retire
    // An update is still replaceable in pending. Only after the FIFO accepts it is that word owed to the output.
    state pending: Seq(Bits(w), 1) initially [] as vacant
    state committed: Seq(Bits(w), 1) initially []

    let handoff = ready && !empty(pending)
    guarantee "reset-quiets-events" = !(install || ready || retire) when rst
    guarantee "retire-committed-head" = !empty(committed) && bits_equal(outgoing, front(committed)) when retire
    guarantee "space-for-handoff" = !full(committed) || retire when handoff
    // On a handoff plus a new update, the old pending word enters the FIFO and the new word stays pending.
    let rest = select(retire, tail(committed), committed)
    next committed = select(rst, vacant, select(handoff, append(rest, front(pending)), rest))
    next pending = select(rst, vacant, select(install, append(vacant, incoming), select(handoff, vacant, pending)))

  refinement:
    child offer: OfferRegister
    child fifo: ShiftQueue
    history latest from offer.slot: Seq(Bits(w), 1)
    history accepted from fifo.q: Seq(Bits(w), 1)
    relate pending = latest
    relate committed = accepted
    batch installing from install: Bool
    batch replacement from incoming: Bits(w)
    batch admitting from ready: Bool
    // Ask for a reachable edge with different old and new words, so a mix-up between them would be observable.
    cover distinct_replacement = installing && admitting && !empty(latest) && !bits_equal(replacement, front(latest))
