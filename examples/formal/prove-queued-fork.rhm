#lang rhombus
/* Certifies a buffered fork's broadcast transactions from previously proved fork and queue contracts. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("rspecl/runner.rkt") as proof
  "queued-fork.rhdl" as rtl
  "queued-fork.rspl" as spec
  "atomic-fork.rspl".AtomicFork
  "shift-queue.rspl".ShiftQueue

module main:
  for (shape in [[1, 1], [2, 2], [3, 8]]):
    def [n, width] = shape
    def top = elaborate(rtl.QueuedFork(n, width)).top
    def fork = proof.prove_design(proof.child_definition(top, "fork"), AtomicFork)
    def queue = proof.prove_design(proof.child_definition(top, rtl.queue_site(0)), ShiftQueue)
    def queues = for Map (i in 0..n): values(rtl.queue_site(i), queue)
    def seal = proof.prove_design(top, spec.QueuedFork, ~children: queues ++ {"fork": fork})
    println("Proved independent QueuedFork deliveries at " ++ to_string(shape))
