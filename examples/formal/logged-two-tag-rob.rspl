#lang rspecl
/* Specifies ordered grants, completions, retirements and last-record readback on the public pins. */
// SPDX-License-Identifier: Apache-2.0

import "logged-two-tag-rob.rhdl" as rtl
import "two-tag-rob.rspl" as specs
import "ordered-retirement.rspl" open
import lib("rhodium/formal/spec.rhm").Observed

/* Sample a retirement on handshake, and the pre-edge record whenever it is valid. */
fun recorder_events(input :: Function.of_arity(2), output :: Function.of_arity(2), w :: PosInt):
  def recorded = output("has_commit", Bool)
  def readback = {"record": Observed(output("last_tag", Bool), recorded),
                  "record_data": Observed(output("last_payload", Bits(w)), recorded)}
  retirement_events(input, output, w) ++ readback

/* Logical bits may be tag A (false); event presence, not payload truth, signals capture. */
fun same(x :: SpecExpr, y :: SpecExpr): select(x, y, !y)

/* Add last-record readback to the same retirement handshake as the ordering behavior. */
fun last_record(w :: PosInt):
  monitor:
    sample fun (read, output): recorder_events(read, output, w)
    publish []
    batch reset = present(reset)
    batch retire = present(retired)
    batch retire_tag: Bool = payload(retired) when retire
    batch retire_data: Bits(w) = payload(retired_value) when retire
    batch valid = present(record)
    batch last_tag: Bool = payload(record) when valid
    batch last_payload: Bits(w) = payload(record_data) when valid

    state occupied: Bool initially #false
    state tag: Bool initially #false
    state data: Bits(w) initially 0
    guarantee "reset-quiets-retirement" = !retire when reset
    guarantee "record-valid" = same(valid, occupied) when !reset
    guarantee "record-value" = same(last_tag, tag) && bits_equal(last_payload, data) when !reset && valid
    // Reset invalidates the record. An offered retirement with ready low leaves the last captured tag and data alone.
    next occupied = !reset && (occupied || retire)
    next tag = select(retire, retire_tag, tag)
    next data = select(retire, retire_data, data)

spec for rtl.LoggedTwoTagROB:
  specialize w = result_a.type.width ~default: 2
  transactions combine_transactions(ordered_retirement(w), last_record(w))

  refinement:
    child rob: specs.TwoTagROB
    // Check that the public retirement events match the child's. The separate record check still has to prove what was saved.
    forward_batch rob
    local (occupied): Bool
    local (tag): Bits(1)
    local (payload): Bits(w)
    relate occupied = occupied
    relate tag = bits_equal(tag, const(Bits(1), 1)) when occupied
    relate data = payload when occupied

    // Use the child's abstract pre-edge history, never its RTL register banks.
    history pending from rob.order: Seq(Bool, 2)
    history a_done from rob.done_a: Bool
    history b_done from rob.done_b: Bool
    history a_data from rob.saved_a: Bits(w)
    history b_data from rob.saved_b: Bits(w)
    history a_gen from rob.gen_a: Bool
    history b_gen from rob.gen_b: Bool
    let live = !empty(pending)
    let head = select(live, front(pending), #false)
    let two = full(pending)
    let last = select(two, front(tail(pending)), #false)
    let has_a = (live && !head) || (two && !last)
    let has_b = (live && head) || (two && last)
    relate order = pending
    relate gen_a = a_gen when has_a
    relate gen_b = b_gen when has_b
    relate done_a = a_done when has_a
    relate done_b = b_done when has_b
    relate saved_a = a_data when has_a && a_done
    relate saved_b = b_data when has_b && b_done
    batch taking from retire: Bool
    batch who from retire_tag: Bool
    cover capture_a = taking && !who
    cover capture_b = taking && who
    input ready from retire.ready: Bool
    output offered from retire.valid: Bool
    // Look for stalls both before the first recorded retirement and after it, when there is a record to preserve.
    cover first_stall = offered && !ready && !occupied
    cover holding_stall = offered && !ready && occupied
