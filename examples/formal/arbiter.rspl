#lang rspecl
/* Models fixed-priority arbitration over all elaborated Decoupled inputs. */
// SPDX-License-Identifier: Apache-2.0

import lib("rhodium/frontend/layers/memory.rhm").index_width
import lib("flow/arbiter.rhdl") as rtl
import lib("rhodium/formal/spec.rhm").Observed

/* Keep the original public grant names for the two-lane interface. */
fun request_name(i :: Nat): cond | i == 0: "a" | i == 1: "b" | ~else: "request" ++ to_string(i)

/* Distinguish actual grant pins from corresponding requests in the public event batch. */
fun grant_name(i :: Nat): cond | i == 0: "ga" | i == 1: "gb" | ~else: "grant" ++ to_string(i)

/* Sample requests and physical grants separately: the monitor must detect a duplicate grant. */
fun grant_events(read :: Function, output :: Function, count :: PosInt = 2):
  fun flag(pin :: SpecExpr): Observed(const(Bool, #true), pin)
  def events = MutableMap{"ready": flag(read("egress.ready", Bool))}
  for (i in 0..count):
    def path = "ingress[" ++ to_string(i) ++ "]."
    events[request_name(i)] := flag(read(path ++ "valid", Bool))
    events[grant_name(i)] := flag(output(path ++ "ready", Bool))
  events.snapshot()
export grant_events

spec for rtl.Arbiter:
  specialize count = ingress.length() ~default: 2
  def mutable valid = const(Bool, #false)
  def mutable data = ingress[0].bits
  def index = Bits(index_width(count))
  def mutable winner = const(index, 0)
  for (i in 0..count):
    def lane = ingress[i]
    def first = !valid && lane.valid
    def take = egress.ready && first
    observe ingress[i].ready = take
    event ("in" ++ to_string(i)) = lane.bits when take
    data := select(first, lane.bits, data)
    winner := select(first, const(index, i), winner)
    valid := valid || lane.valid
  observe egress.valid = valid
  observe egress.bits = data when valid
  observe chosen = winner when valid
  event out = data when egress.ready && valid

  monitor:
    sample fun (read, output): grant_events(read, output, count)
    publish []
    batch ready = present(ready)
    def mutable requested = const(Bool, #false)
    def mutable granted = const(Bool, #false)
    def mutable exclusive = const(Bool, #true)
    for (i in 0..count):
      batch req(request_name(i)) = present(request_name(i))
      batch grant(grant_name(i)) = present(grant_name(i))
      def label = cond | i == 0: "first-grant" | i == 1: "second-grant" | ~else: "grant-" ++ to_string(i)
      guarantee (label) = bool_equal(grant, ready && !requested && req)
      exclusive := exclusive && !(granted && grant)
      granted := granted || grant
      requested := requested || req
    guarantee "exclusive" = exclusive

  rtl_refinement:
    pin offered from egress.valid
    pin word from egress.bits
    for (i in 0..count):
      pin grant from ingress[i].ready
      care ingress[i].ready = #true
      event ("in" ++ to_string(i)) = ingress[i].bits when ingress[i].valid && grant
    care egress.valid = #true
    care egress.bits = offered
    care chosen = offered
    event out = word when offered && egress.ready

/* The output carries precisely the input word transferred on the winning lane. */
def transfer_contract:
  spec for rtl.Arbiter:
    let word = ingress[0].bits.type
    def names = for List (i in 0..n): "lane" ++ to_string(i)
    def lanes = for Map (name in names, port in ingress): values(name, port)
    events transfers = rv_transfers(lanes ++ {"sent": egress})
    monitor:
      sample transfers
      publish []
      batch send = present(sent)
      batch sent_word: word = payload(sent) when send
      def mutable admitted = const(Bool, #false)
      for (name in names, i in 0..n):
        batch take("take" ++ to_string(i)) = present(name)
        batch incoming(request_name(i) ++ "_word"): word = payload(name) when take
        def label = cond | i == 0: "forward-lane-zero" | i == 1: "forward-lane-one" | ~else: "forward-" ++ name
        guarantee (label) = bits_equal(incoming, sent_word) when take
        admitted := admitted || take
      guarantee "conserve-transfer" = bool_equal(send, admitted)
  Arbiter

def arbitrated_transfers = extend_leaf_transactions(Arbiter, transfer_contract)
export arbitrated_transfers
