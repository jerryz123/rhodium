#lang rspecl
/* Models two Decoupled offers with combinational priority for lane zero. */
// SPDX-License-Identifier: Apache-2.0

import lib("flow/arbiter.rhdl") as rtl
import lib("rhodium/formal/spec.rhm").Observed

/* Sample the two grant pins independently; neither requests nor a decoded winner imply a grant. */
fun grant_events(read :: Function.of_arity(2), output :: Function.of_arity(2)):
  /* Encode a sampled Boolean pin as event presence, including when its peer is asserted. */
  fun flag(pin :: SpecExpr): Observed(const(Bool, #true), pin)
  {"a": flag(read("ingress[0].valid", Bool)), "b": flag(read("ingress[1].valid", Bool)),
   "ready": flag(read("egress.ready", Bool)),
   "ga": flag(output("ingress[0].ready", Bool)), "gb": flag(output("ingress[1].ready", Bool))}
export grant_events

/* Select the lowest valid lane anew each sample; no request locks a stalled grant. */
spec for rtl.Arbiter:
  unless n == 2 | error("Arbiter contract requires two lanes")
  let first = ingress[0]
  let second = ingress[1]
  let valid = first.valid || second.valid
  let data = select(first.valid, first.bits, second.bits)
  let r0 = egress.ready && first.valid
  let r1 = egress.ready && (!first.valid && second.valid)
  observe ingress[0].ready = r0
  observe ingress[1].ready = r1
  observe egress.valid = valid
  observe egress.bits = data when valid
  observe chosen = select(first.valid, const(Bits(1), 0), const(Bits(1), 1)) when valid
  event in0 = first.bits when r0
  event in1 = second.bits when r1
  event out = data when egress.ready && valid
  monitor:
    sample grant_events
    publish []
    // A request and a grant are different observations: both requests may be high, but both grants must never be high.
    batch a = present(a)
    batch b = present(b)
    batch ready = present(ready)
    batch ga = present(ga)
    batch gb = present(gb)
    guarantee "exclusive" = !(ga && gb)
    guarantee "first-grant" = bool_equal(ga, ready && a)
    guarantee "second-grant" = bool_equal(gb, ready && !a && b)

  rtl_refinement:
    pin g0 from ingress[0].ready
    pin g1 from ingress[1].ready
    pin offered from egress.valid
    pin word from egress.bits
    care ingress[0].ready = #true
    care ingress[1].ready = #true
    care egress.valid = #true
    care egress.bits = offered
    care chosen = offered
    event in0 = first.bits when first.valid && g0
    event in1 = second.bits when second.valid && g1
    event out = word when offered && egress.ready

/* Grants describe admission; add conservation and payload equality only on physical handshakes. */
def transfer_contract:
  spec for rtl.Arbiter:
    let word = ingress[0].bits.type
    events transfers = rv_transfers({"lane0": ingress[0], "lane1": ingress[1], "sent": egress})
    monitor:
      sample transfers
      publish []
      batch take0 = present(lane0)
      batch take1 = present(lane1)
      batch send = present(sent)
      batch a_word: word = payload(lane0) when take0
      batch b_word: word = payload(lane1) when take1
      batch sent_word: word = payload(sent) when send
      // A handshake on either input must coincide with one on the output, carrying that same lane's word.
      guarantee "conserve-transfer" = bool_equal(send, take0 || take1)
      guarantee "forward-lane-zero" = bits_equal(a_word, sent_word) when take0
      guarantee "forward-lane-one" = bits_equal(b_word, sent_word) when take1
  Arbiter

def arbitrated_transfers = extend_leaf_transactions(Arbiter, transfer_contract)
export arbitrated_transfers
