#lang rhombus
/* Proves the same ordered FIFO spec for equal depths and both orientations of unequal depths. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("rspecl/runner.rkt") as proof
  "queue-pair.rspl".QueuePair
  "queue-pair-series.rhdl" as rtl
  "queue-pair-series.rspl" as spec

module main:
  for ([front, back, width] in [[1, 1, 1], [1, 2, 2], [2, 1, 8]]):
    def top = elaborate(rtl.QueuePairSeries(front, back, width)).top
    def children = for Map (site in ["front", "back"]):
      values(site, proof.prove_design(proof.child_definition(top, site), QueuePair))
    def seal = proof.prove_design(top, spec.QueuePairSeries, ~children: children)
    println("Proved QueuePairSeries(" ++ to_string(front) ++ ", " ++ to_string(back)
              ++ "): ordered FIFO contract, capacity " ++ to_string(2 * (front + back)))
