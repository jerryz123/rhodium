#lang rspecl
/* Proves broadcast deliveries using only the fork's joint transfer and independent queue histories. */
// SPDX-License-Identifier: Apache-2.0

import "queued-fork.rhdl" as rtl
import "atomic-fork.rspl".AtomicFork
import "shift-queue.rspl".ShiftQueue
import lib("rspecl/broadcast.rspl") open

spec for rtl.QueuedFork:
  let lanes = BroadcastLanes(egress)
  events transfers = lanes.transfers(ingress)
  let sites = for List (i in 0..n): rtl.queue_site(i)
  transactions broadcast_monitor(lanes, width, transfers)
  refinement:
    child fork: AtomicFork
    children (sites): ShiftQueue
    // A recipient owns the outstanding copy in its own queue, not a sibling's copy.
    for (site in sites, i in 0..n):
      history copy from (site, "q"): Seq(ingress.bits.type, 1)
      relate (lanes.owed[i]) = copy
