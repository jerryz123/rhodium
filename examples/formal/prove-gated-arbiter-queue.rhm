#lang rhombus
/* Proves that registered admission preserves the child FIFO's public transfers at three depths. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("rspecl/runner.rkt").prove_design
  "gated-arbiter-queue.rhdl" as rtl
  "gated-arbiter-queue.rspl" as spec

module main:
  for ([depth, lanes, width] in [[1, 2, 2], [2, 2, 2], [3, 2, 2], [1, 1, 1], [2, 3, 8]]):
    def top = elaborate(rtl.GatedArbiterQueue(width, ~depth: depth, ~lanes: lanes)).top
    def seal = prove_design(top, spec.GatedArbiterQueue)
    println("Proved GatedArbiterQueue transfer preservation and FIFO ordering, depth " ++ to_string(depth) ++ " at " ++ to_string([lanes, width]))
