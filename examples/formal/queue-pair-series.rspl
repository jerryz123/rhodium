#lang rspecl
/* Proves FIFO ordering from child contracts sized by the series' elaborated depths. */
// SPDX-License-Identifier: Apache-2.0

import "queue-pair-series.rhdl" as rtl
import lib("rspecl/fifo.rspl") open

spec for rtl.QueuePairSeries:
  // Each QueuePair contains two queues of its declared depth.
  def front_capacity = 2 * front_depth
  def back_capacity = 2 * back_depth
  def handshakes = ready_valid_events(reset, rv_pins("offer", "ready", "data"), rv_pins("valid", "consume", "head"))
  events transfers = handshakes
  // Only the two outer handshakes count here. Moving a word between the pairs neither adds nor removes a word.
  transactions fifo_monitor(front_capacity + back_capacity, data.type.width, transfers)
  refinement:
    child front: fifo_contract(front_capacity, data.type.width, handshakes)
    child back: fifo_contract(back_capacity, data.type.width, handshakes)
    // Words already downstream leave first, regardless of the relative sizes.
    history upstream from front.q: Seq(data.type, front_capacity)
    history downstream from back.q: Seq(data.type, back_capacity)
    relate q = seq_concat(downstream, upstream)
