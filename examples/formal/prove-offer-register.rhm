#lang rhombus
/* Proves the two-bit library OfferRegister delivers its old word and retains a simultaneous replacement. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("rhodium/frontend/foundation.rhm").Bits
  lib("flow/offer-register.rhdl") as rtl
  "offer-register.rspl" as spec
  lib("rspecl/runner.rkt").prove_design

module main:
  def seal = prove_design(elaborate(rtl.OfferRegister(Bits(2))).top, spec.OfferRegister)
  println("Proved OfferRegister(Bits(2)): a transfer delivers the old word and a simultaneous update retains the new word")
