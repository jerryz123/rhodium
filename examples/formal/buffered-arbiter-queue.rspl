#lang rspecl
/* Relates external FIFO transfers to the ordered histories of an ArbiterQueue and its output buffer. */
// SPDX-License-Identifier: Apache-2.0

import "buffered-arbiter-queue.rhdl" as rtl
import "arbiter-queue.rspl".ArbiterQueue
import "shift-queue.rspl".ShiftQueue
import lib("rspecl/fifo.rspl").fifo_monitor

spec for rtl.BufferedArbiterQueue:
  let word = ingress[0].bits.type
  events transfers = ready_valid_events(reset, ingress, egress)
  // The front can hold depth words and the tail can hold one more. This bound does not promise when ready rises.
  transactions fifo_monitor(depth + 1, word.width, transfers)
  refinement:
    child front: ArbiterQueue
    child tail_fifo: ShiftQueue
    // A word in the tail crossed the internal handoff earlier, so it comes before every word still in front.
    history waiting from front.q: Seq(word, depth)
    history oldest from tail_fifo.q: Seq(word, 1)
    relate q = seq_concat(oldest, waiting)
