#lang rspecl
/* Describes a non-bypassing FIFO as a bounded sequence with cycle observations and transfer events. */
// SPDX-License-Identifier: Apache-2.0

import lib("flow/shift-queue.rhdl") as rtl
import lib("rspecl/fifo.rspl").fifo_monitor

/* Occupied bit i qualifies payload word i; stale words do not enter the abstraction. */
fun live_slots(flags :: SpecExpr, words :: SpecExpr, depth :: PosInt, width :: PosInt):
  def vacant = const(Seq(Bits(width), 1), [])
  def mutable compact = const(Bool, #true)
  def mutable previous = const(Bool, #true)
  def slots = for List (i in 0..depth):
    def live = bits_equal(bits_slice(flags, i, 1), const(Bits(1), 1))
    compact := compact && (!live || previous)
    previous := live
    select(live, append(vacant, bits_slice(words, i * width, width)), vacant)
  def mutable contents = slots[0]
  for (slot in slots.drop(1)): contents := seq_concat(contents, slot)
  values(contents, compact)

/* Build a fixed-depth reference model; reset begins an empty epoch and hides ordinary offers. */
spec for rtl.ShiftQueue:
  when pipe || flow || flushable | error("ShiftQueue contract requires pipe, flow, and flushable disabled")
  ignore count
  ignore mask
  state q: Seq(ingress.bits.type, depth) initially [] as cleared

  let ready = !full(q)
  let valid = !empty(q)
  let push = ready && ingress.valid
  let pop = valid && egress.ready
  observe ingress.ready = ready when !reset
  observe egress.valid = valid when !reset
  observe egress.bits = front(q) when !reset && valid
  events transfers = ready_valid_events(reset, ingress, egress)
  transactions fifo_monitor(depth, ingress.bits.type.width, transfers)

  let rest = select(pop, tail(q), q)
  next q = select(reset, cleared, select(push, append(rest, ingress.bits), rest))

  refinement:
    relate q = q

  rtl_refinement:
    register occupied: Bits(depth)
    register payload: Bits(depth * ingress.bits.type.width)
    def values(contents, compact) = live_slots(occupied, payload, depth, ingress.bits.type.width)
    invariant occupied_prefix = compact
    relate q = contents
    pin rst from reset
    pin offered from egress.valid
    care ingress.ready = !rst
    care egress.valid = !rst
    care egress.bits = !rst && offered
