#lang rspecl
/* Describes a non-bypassing FIFO as a bounded sequence with cycle observations and transfer events. */
// SPDX-License-Identifier: Apache-2.0

import lib("flow/shift-queue.rhdl") as rtl

/* Build a fixed-depth reference model; reset begins an empty epoch and hides ordinary offers. */
spec for rtl.ShiftQueue:
  when pipe || flow || flushable | error("ShiftQueue contract requires pipe, flow, and flushable disabled")
  ignore count
  ignore mask
  state q: Seq(ingress.bits.type, depth) initially [] as cleared

  let ready = !full(q)
  let valid = !empty(q)
  let push = ready && ingress.valid
  let pop = valid && egress.ready
  observe ingress.ready = ready when !reset
  observe egress.valid = valid when !reset
  observe egress.bits = front(q) when !reset && valid
  events ready_valid_events(reset, ingress, egress)

  let rest = select(pop, tail(q), q)
  next q = select(reset, cleared, select(push, append(rest, ingress.bits), rest))

  refinement:
    relate q = q
