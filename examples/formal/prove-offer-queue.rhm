#lang rhombus
/* Proves FIFO order after handoff from the OfferRegister and ShiftQueue transaction contracts. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("rspecl/runner.rkt").prove_design
  "offer-queue.rhdl" as rtl
  "offer-queue.rspl" as spec

module main:
  for (width in [1, 2, 8]):
    def seal = prove_design(elaborate(rtl.OfferQueue(width)).top, spec.OfferQueue)
    println("Proved OfferQueue: handoffs commit the old offer in FIFO order; simultaneous updates remain replaceable" ++ " (width " ++ to_string(width) ++ ")")
