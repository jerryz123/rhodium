#lang rspecl
/* Specifies simultaneous, full-word transfer on every output of a combinational fork. */
// SPDX-License-Identifier: Apache-2.0

import lib("flow/atomic-fork.rhdl") as rtl

/* An empty set of peers is ready: a one-output fork simply forwards valid. */
fun all_ready_except(lanes :: List.of(Endpoint), excluded :: maybe(Nat)):
  def mutable ready = const(Bool, #true)
  for (lane in lanes, i in 0..lanes.length()):
    unless i == excluded | ready := ready && lane.ready
  ready

spec for rtl.AtomicFork:
  observe ingress.ready = all_ready_except(egress, #false)
  for (i in 0..n):
    def offered = ingress.valid && all_ready_except(egress, i)
    observe egress[i].valid = offered
    observe egress[i].bits = ingress.bits when offered

  // Preserve the public left/right event names of the original two-output contract.
  def names = if n == 2 | ["left", "right"] | for List (i in 0..n): "lane" ++ to_string(i)
  def endpoints = for Map (name in names, lane in egress): values(name, lane)
  events transfers = rv_transfers({"accepted": ingress} ++ endpoints)
  monitor:
    sample transfers
    publish ["accepted"] ++ names
    batch take = present(accepted)
    batch incoming: ingress.bits.type = payload(accepted) when take
    // Each handshake is sampled separately. Agreement is a guarantee, not an assumption.
    def mutable together = const(Bool, #true)
    for (name in names):
      batch sent("send_" ++ name) = present(name)
      batch word(name ++ "_word"): ingress.bits.type = payload(name) when sent
      together := together && bool_equal(take, sent)
      guarantee (name ++ "-payload") = bits_equal(incoming, word) when take && sent
    guarantee "atomic-transfer" = together

  rtl_refinement:
    care ingress.ready = #true
    for (i in 0..n):
      pin offered from egress[i].valid
      care egress[i].valid = #true
      care egress[i].bits = offered
