#lang rhodium
/* Builds a two-recipient broadcast from an atomic fork and independent one-word queues. */
// SPDX-License-Identifier: Apache-2.0

import lib("flow/main.rhdl") open

/* Both queues must accept an ingress word together, but either output may drain first. */
sync_circuit QueuedFork():
  interface ingress(Decoupled(Bits(2)), ~role: consumer)
  interface egress[2](Irrevocable(Bits(2)), ~role: producer)

  inst fork(AtomicFork(Bits(2), 2))
  inst left(ShiftQueue(Bits(2), 1))
  inst right(ShiftQueue(Bits(2), 1))
  ingress |> fork.ingress
  fork.egress[0] |> left.ingress
  fork.egress[1] |> right.ingress
  left.egress |> egress[0]
  right.egress |> egress[1]

export QueuedFork
