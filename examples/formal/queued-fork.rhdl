#lang rhodium
/* Builds a broadcast from an atomic fork and independent one-word queues. */
// SPDX-License-Identifier: Apache-2.0

import lib("flow/main.rhdl") open

/* RHDL gives repeated queue instances these occurrence names in elaboration order. */
fun queue_site(i :: NonnegInt):
  if i == 0 | "queue" | "queue_" ++ to_string(i)

/* Admission is atomic; each recipient drains its one-word queue independently. */
sync_circuit QueuedFork(n :: PosInt = 2, width :: PosInt = 2):
  interface ingress(Decoupled(Bits(width)), ~role: consumer)
  interface egress[n](Irrevocable(Bits(width)), ~role: producer)
  inst fork(AtomicFork(Bits(width), n))
  ingress |> fork.ingress
  for (i in 0..n):
    inst queue(ShiftQueue(Bits(width), 1))
    fork.egress[i] |> queue.ingress
    queue.egress |> egress[i]

export QueuedFork queue_site
