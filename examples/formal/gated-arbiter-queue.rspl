#lang rspecl
/* Models registered admission and proves that the gate forwards the queue's complete transfer batch. */
// SPDX-License-Identifier: Apache-2.0

import "gated-arbiter-queue.rhdl" as rtl
import "arbiter-queue.rspl".ArbiterQueue
import lib("rspecl/fifo.rspl").fifo_monitor

/* Record accepted external words, oldest first. A full queue cannot accept on its retirement edge. */
spec for rtl.GatedArbiterQueue:
  state admitting: Bool initially #false
  state pending: Seq(ingress[0].bits.type, depth) initially [] as cleared

  let room = admitting && !full(pending)
  def mutable push = const(Bool, #false)
  def mutable winner = ingress[0].bits
  for (i in 0..ingress.length()):
    def grant = room && !push && ingress[i].valid
    observe ingress[i].ready = grant when !reset
    winner := select(grant, ingress[i].bits, winner)
    push := push || grant
  let valid = !empty(pending)
  let pop = valid && egress.ready

  observe egress.valid = valid when !reset
  observe egress.bits = front(pending) when !reset && valid
  events transfers = ready_valid_events(reset, ingress, egress)
  transactions fifo_monitor(depth, ingress[0].bits.type.width, transfers)

  let retained = select(pop, tail(pending), pending)
  // This edge samples enable for the next cycle; it does not open the gate for the current offers.
  next admitting = !reset && enable
  next pending = select(reset, cleared, select(push, append(retained, winner), retained))

  refinement:
    // To reuse the child's ordering promise, the proof must show that parent and child see the same transfers.
    forward queue: ArbiterQueue
