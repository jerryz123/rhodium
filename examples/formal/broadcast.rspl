#lang rspecl
/* Specifies Flow Broadcast's independent offers and relates its shared storage to two public delivery histories. */
// SPDX-License-Identifier: Apache-2.0

import lib("flow/broadcast.rhdl") as rtl
import lib("rspecl/broadcast.rspl").broadcast_monitor

spec for rtl.Broadcast:
  unless n == 2 && ingress.bits.type.width == 2 | error("Broadcast contract requires two outputs and two-bit words")
  state left_slot: Seq(ingress.bits.type, 1) initially [] as vacant
  state right_slot: Seq(ingress.bits.type, 1) initially []
  let left_live = !empty(left_slot)
  let right_live = !empty(right_slot)
  // This implementation can replace the word exactly when all remaining recipients will drain.
  let room = (!left_live || egress[0].ready) && (!right_live || egress[1].ready)
  let accept = room && ingress.valid
  observe ingress.ready = room when !reset
  observe egress[0].valid = left_live when !reset
  observe egress[1].valid = right_live when !reset
  observe egress[0].bits = front(left_slot) when !reset && left_live
  observe egress[1].bits = front(right_slot) when !reset && right_live
  let arrival = append(vacant, ingress.bits)
  next left_slot = select(reset, vacant, select(accept, arrival, select(egress[0].ready, vacant, left_slot)))
  next right_slot = select(reset, vacant, select(accept, arrival, select(egress[1].ready, vacant, right_slot)))

  events transfers = rv_transfers(~accepted: ingress, ~left: egress[0], ~right: egress[1])
  transactions broadcast_monitor(ingress.bits.type.width, transfers)
  refinement:
    relate owed_l = left_slot
    relate owed_r = right_slot

  rtl_refinement:
    register pending: Bits(2)
    register payload: Bits(2)
    // A pending bit owns a copy of the shared payload; a cleared bit owes nothing, regardless of stale data.
    def vacant = const(Seq(Bits(2), 1), [])
    def copy = append(vacant, payload)
    relate left_slot = select(bits_equal(bits_slice(pending, 0, 1), const(Bits(1), 1)), copy, vacant)
    relate right_slot = select(bits_equal(bits_slice(pending, 1, 1), const(Bits(1), 1)), copy, vacant)
    pin rst from reset
    pin l from egress[0].valid
    pin r from egress[1].valid
    care ingress.ready = !rst
    care egress[0].valid = !rst
    care egress[1].valid = !rst
    care egress[0].bits = !rst && l
    care egress[1].bits = !rst && r
