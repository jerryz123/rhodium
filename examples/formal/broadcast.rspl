#lang rspecl
/* Relates Broadcast's shared payload and pending mask to one delivery history per output. */
// SPDX-License-Identifier: Apache-2.0

import lib("flow/broadcast.rhdl") as rtl
import lib("rspecl/broadcast.rspl") open

spec for rtl.Broadcast:
  def word = ingress.bits.type
  def lanes = BroadcastLanes(egress)
  def slots = history_family(lanes.names.map(fun (name): name ++ "_slot"))
  state slot[slots]: Seq(word, 1) initially []
  def vacant = const(Seq(word, 1), [])
  // This RTL can replace a word exactly when all remaining recipients can take it.
  def mutable room = const(Bool, #true)
  for (i in 0..n): room := room && (empty(slot[i]) || egress[i].ready)
  let accept = room && ingress.valid
  observe ingress.ready = room when !reset
  let arrival = append(vacant, ingress.bits)
  for (i in 0..n):
    let live = !empty(slot[i])
    observe egress[i].valid = live when !reset
    observe egress[i].bits = front(slot[i]) when !reset && live
    next slot[i] = select(reset, vacant, select(accept, arrival, select(egress[i].ready, vacant, slot[i])))

  events transfers = lanes.transfers(ingress)
  transactions broadcast_monitor(lanes, word.width, transfers)
  refinement:
    for (i in 0..n): relate (lanes.owed[i]) = slot[i]

  rtl_refinement:
    register pending: Bits(n)
    register payload: word
    // A pending bit owns a copy of the shared payload; a cleared bit owes nothing, regardless of stale data.
    def copy = append(vacant, payload)
    pin rst from reset
    care ingress.ready = !rst
    for (i in 0..n):
      relate (slots[i]) = select(bits_equal(bits_slice(pending, i, 1), const(Bits(1), 1)), copy, vacant)
      pin offered from egress[i].valid
      care egress[i].valid = !rst
      care egress[i].bits = !rst && offered
