#lang rhombus
/* Certifies the same AtomicFork spec at three concrete fanout and payload configurations. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("rhodium/frontend/foundation.rhm").Bits
  lib("flow/atomic-fork.rhdl") as rtl
  lib("rspecl/runner.rkt").prove_design
  "atomic-fork.rspl" as spec

module main:
  for ([count, width] in [[1, 1], [2, 2], [3, 8]]):
    def seal = prove_design(elaborate(rtl.AtomicFork(Bits(width), count)).top, spec.AtomicFork)
    println("Proved AtomicFork: " ++ to_string(count) ++ " output(s), " ++ to_string(width) ++ "-bit words")
