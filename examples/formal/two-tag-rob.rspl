#lang rspecl
/* Specifies TwoTagROB cycle behavior, public pin events, and the oldest-first completion history those events must obey. */
// SPDX-License-Identifier: Apache-2.0

import "two-tag-rob.rhdl" as rtl
import lib("rhodium/formal/spec.rhm") as ir

/* Decode one joint pre-edge sample. Only the four issued/retired fields belong to the
   cycle API; the monitor also needs reset and the two independent completion pulses. */
fun rob_events(input :: Function.of_arity(2), output :: Function.of_arity(2)):
  def word = Bits(2)
  def rst = input("reset", Bool)
  def grant_b = output("grant_b", Bool)
  def grant = !rst && (output("grant_a", Bool) || grant_b)
  def retire = !rst && output("retire.valid", Bool) && input("retire.ready", Bool)
  def base = {"reset": ir.Observed(const(Bool, #true), rst),
              "issued": ir.Observed(grant_b, grant), "issued_gen": ir.Observed(output("issue_gen", Bool), grant),
              "retired": ir.Observed(output("retire.bits", Bool), retire),
              "retired_value": ir.Observed(output("retire_result", word), retire)}
  /* Each lane's generation and data are sampled together, before any issue or retirement update. */
  fun lane(suffix :: String):
    def present = !rst && input("complete_" ++ suffix, Bool)
    {"echo_" ++ suffix: ir.Observed(input("complete_gen_" ++ suffix, Bool), present),
     "data_" ++ suffix: ir.Observed(input("result_" ++ suffix, word), present)}
  base ++ lane("a") ++ lane("b")

/* False denotes A; true denotes B. Membership comes from the live issue history,
   not a copy of the implementation's busy bits. */
spec for rtl.TwoTagROB:
  monitor:
    sample rob_events
    publish ["issued", "issued_gen", "retired", "retired_value"]
    batch reset = present(reset)
    batch grant = present(issued)
    batch grant_tag: Bool = payload(issued) when grant
    batch grant_gen: Bool = payload(issued_gen) when grant
    batch complete_a = present(echo_a)
    batch echo_a: Bool = payload(echo_a) when complete_a
    batch data_a: Bits(2) = payload(data_a) when complete_a
    batch complete_b = present(echo_b)
    batch echo_b: Bool = payload(echo_b) when complete_b
    batch data_b: Bits(2) = payload(data_b) when complete_b
    batch retire = present(retired)
    batch retire_tag: Bool = payload(retired) when retire
    batch retire_data: Bits(2) = payload(retired_value) when retire

    state order: Seq(Bool, 2) initially [] as cleared
    state gen_a: Bool initially #false
    state done_a: Bool initially #false
    state saved_a: Bits(2) initially 0
    state gen_b: Bool initially #false
    state done_b: Bool initially #false
    state saved_b: Bits(2) initially 0

    /* Compare logical tags or generations without casting them to packed words. */
    fun same(x :: SpecExpr, y :: SpecExpr): select(x, y, !y)
    let live = !empty(order)
    let two = full(order)
    let head = select(live, front(order), #false)
    let second = select(two, front(tail(order)), #false)
    /* Membership is pre-edge: retiring a tag does not make it grantable on the same edge. */
    fun contains(tag :: SpecExpr): (live && same(tag, head)) || (two && same(tag, second))

    guarantee "epoch" = !reset || !(grant || retire || complete_a || complete_b)
    guarantee "history" = reset || !two || !same(head, second)
    guarantee "fresh-grant" = !grant || (!contains(grant_tag) && (!two || retire))
    guarantee "oldest-tag" = !retire || (live && same(retire_tag, head))
    guarantee "completed-before-retirement" = !retire || select(head, done_b, done_a)
    guarantee "retired-payload" = !retire || bits_equal(retire_data, select(head, saved_b, saved_a))

    let rest = select(retire, tail(order), order)
    next order = select(reset, cleared, select(grant, append(rest, grant_tag), rest))

    /* Only the first matching response for an already live allocation writes its result. */
    fun captures(tag :: Boolean, done :: SpecExpr, pulse :: SpecExpr, echo :: SpecExpr, gen :: SpecExpr):
      contains(const(Bool, tag)) && !done && pulse && same(echo, gen)
    let capture_a = captures(#false, done_a, complete_a, echo_a, gen_a)
    let capture_b = captures(#true, done_b, complete_b, echo_b, gen_b)
    let allocate_a = grant && !grant_tag
    let allocate_b = grant && grant_tag
    next gen_a = select(allocate_a, grant_gen, gen_a)
    next gen_b = select(allocate_b, grant_gen, gen_b)
    next done_a = !allocate_a && (done_a || capture_a)
    next done_b = !allocate_b && (done_b || capture_b)
    next saved_a = select(capture_a, data_a, saved_a)
    next saved_b = select(capture_b, data_b, saved_b)

  // Private induction hints, not statements that a consumer may assume about this RTL.
  refinement:
    fifo tags from order: Seq(Bool, 2)
    local (busy_a, busy_b, gen_a, gen_b, done_a, done_b): Bool
    local (saved_a, saved_b): Bits(2)
    let live = !empty(tags)
    let two = full(tags)
    let head = select(live, front(tags), #false)
    let last = select(two, front(tail(tags)), #false)
    invariant unique = !two || select(head, !last, last)
    let has_a = (live && !head) || (two && !last)
    let has_b = (live && head) || (two && last)
    invariant owns_a = select(busy_a, has_a, !has_a)
    invariant owns_b = select(busy_b, has_b, !has_b)
    invariant completed_live = (!done_a || busy_a) && (!done_b || busy_b)
    relate order = tags
    relate gen_a = gen_a when busy_a
    relate gen_b = gen_b when busy_b
    relate done_a = done_a when busy_a
    relate done_b = done_b when busy_b
    relate saved_a = saved_a when done_a
    relate saved_b = saved_b when done_b

    input (reset, issue_a, issue_b): Bool
    input ready from retire.ready: Bool
    output (grant_a, grant_b): Bool
    batch retiring from retire: Bool
    batch retired_tag from retire_tag: Bool
    check grants = reset || (!(grant_a && grant_b) && (!grant_a || issue_a) && (!grant_b || issue_b))
    cover retire_a0 = retiring && !retired_tag && !gen_a
    cover retire_a1 = retiring && !retired_tag && gen_a
    cover retire_b0 = retiring && retired_tag && !gen_b
    cover retire_b1 = retiring && retired_tag && gen_b
    cover younger_only = two && !head && !done_a && done_b && ready && !retiring

  state history: Seq(Bool, 2) initially [] as cleared
  state finished_a: Bool initially #false
  state finished_b: Bool initially #false

  // The spec counts issues modulo two. While a tag is live its issued bit is the opposite of its next bit.
  state next_gen_a: Bool initially #false
  state next_gen_b: Bool initially #false
  state value_a: Bits(2) initially 0 as unused
  state value_b: Bits(2) initially 0

  let live = !empty(history)
  let two = full(history)
  let head_b = select(live, front(history), #false)
  let last_b = select(two, front(tail(history)), #false)
  let has_a = (live && !head_b) || (two && !last_b)
  let has_b = (live && head_b) || (two && last_b)
  let a = issue_a && !has_a && !two
  let b = issue_b && !has_b && !two && !a
  let available = live && select(head_b, finished_b, finished_a)
  let pop = available && retire.ready

  /* Compare the returned bit with the previous issue, not the next allocation. */
  fun echoed_live(next_bit :: SpecExpr, echo :: SpecExpr): select(next_bit, !echo, echo)
  let response_a = complete_a && echoed_live(next_gen_a, complete_gen_a)
  let response_b = complete_b && echoed_live(next_gen_b, complete_gen_b)
  let issued_bit = select(b, next_gen_b, next_gen_a)
  observe issue_gen = issued_bit when !reset && (a || b)
  observe grant_a = a when !reset
  observe grant_b = b when !reset
  observe retire.valid = available when !reset
  observe retire.bits = head_b when !reset && available
  let result = select(head_b, value_b, value_a)
  observe retire_result = result when !reset && available

  let retained = select(pop, tail(history), history)
  next history = select(reset, cleared, select(a || b, append(retained, b), retained))
  next next_gen_a = !reset && select(a, !next_gen_a, next_gen_a)
  next next_gen_b = !reset && select(b, !next_gen_b, next_gen_b)
  next finished_a = !reset && has_a && !(pop && !head_b) && (finished_a || response_a)
  next finished_b = !reset && has_b && !(pop && head_b) && (finished_b || response_b)
  // Canonicalize inactive spec values; the RTL banks need not hold zero there.
  next value_a = select(reset || !has_a || (pop && !head_b), unused,
                        select(!finished_a && response_a, result_a, value_a))
  next value_b = select(reset || !has_b || (pop && head_b), unused,
                        select(!finished_b && response_b, result_b, value_b))
