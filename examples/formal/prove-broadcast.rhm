#lang rhombus
/* Proves independent broadcast deliveries at three concrete output counts and word widths. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("rhodium/frontend/foundation.rhm").Bits
  lib("flow/broadcast.rhdl") as rtl
  lib("rspecl/runner.rkt").prove_design
  "broadcast.rspl" as spec

module main:
  for ([count, width] in [[1, 1], [2, 2], [3, 8]]):
    def seal = prove_design(elaborate(rtl.Broadcast(Bits(width), count)).top, spec.Broadcast)
    println("Proved Broadcast: " ++ to_string(count) ++ " recipient(s), " ++ to_string(width) ++ "-bit words")
