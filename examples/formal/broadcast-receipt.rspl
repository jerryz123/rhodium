#lang rspecl
/* Checks the receipt pulse against the deliveries still owed before each edge. */
// SPDX-License-Identifier: Apache-2.0

import "broadcast-receipt.rhdl" as rtl
import lib("rspecl/broadcast.rspl") open
import lib("rhodium/formal/spec.rhm").Observed

/* Sample the real receipt even during reset: masking it would hide a spurious pulse. */
fun receipt_samples(transfers :: Function.of_arity(2)):
  def deliveries = broadcast_events(transfers)
  fun (read :: Function, output :: Function):
    deliveries(read, output) ++ {"pulse": Observed(const(Bool, #true), output("receipt", Bool))}

spec for rtl.BroadcastReceipt:
  events transfers = broadcast_transfers(ingress, egress)
  let lanes = broadcast_lanes(egress.length())
  monitor:
    sample receipt_samples(transfers)
    publish ["reset", "accepted", "pulse"] ++ lanes.map(fun (lane): lane.event)
    batch rst = present(reset)
    batch take = present(accepted)
    batch pulse = present(pulse)
    state owed[lanes.map(fun (lane): lane.event ++ "_due")]: Bool initially #false
    def mutable live = const(Bool, #false)
    def mutable finished = const(Bool, #true)
    for (lane in lanes, i in 0..lanes.length()):
      batch pop("pop_" ++ lane.suffix) = present(lane.event)
      live := live || owed[i]
      finished := finished && (!owed[i] || pop)
      next owed[i] = !rst && (take || (owed[i] && !pop))
    guarantee "last-delivery" = bool_equal(pulse, !rst && live && finished)
  refinement:
    child fanout: broadcast_contract
    // Each physical bookkeeping bit describes one public child history.
    for (lane in lanes, i in 0..lanes.length()):
      history pending from ("fanout", lane.history): Seq(ingress.bits.type, 1)
      local bit("due_" ++ to_string(i)): Bool
      relate (lane.event ++ "_due") = !empty(pending)
      invariant (lane.event ++ "_matches") = bool_equal(bit, !empty(pending))
