#lang rhombus
/* Proves the clockless fixed-priority Arbiter and derives its public grant contract from RTL. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("rhodium/frontend/foundation.rhm").Bits
  lib("flow/arbiter.rhdl") as rtl
  lib("rspecl/runner.rkt").prove_design
  "arbiter.rspl" as spec

module main:
  for ([lanes, width] in [[1, 1], [2, 2], [3, 8]]):
    def top = elaborate(rtl.Arbiter(Bits(width), lanes)).top
    def grants = prove_design(top, spec.arbitrated_transfers)
    println("Proved priority, exclusive grants and payload at " ++ to_string([lanes, width]))
