#lang rhombus
/* Proves full-word and one-bit capture contracts under the same gate input premise. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/foundation.rhm").elaborate
  lib("rspecl/runner.rkt").prove_design
  "gated-capture.rhdl" as rtl
  "gated-capture.rspl" as spec

module main:
  def top = elaborate(rtl.GatedCapture()).top
  def seal = prove_design(top, spec.GatedCapture)
  println("Proved GatedCapture from the selector contract: off-reset captures require exclusive grants")
  def bit_seal = prove_design(top, spec.zero_gate)
  println("Proved one-bit GatedCapture readback under capture_exclusive")
