#lang rhombus
// Proves that standard and explicitly composed adders are behaviorally equivalent.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/formal/main.rhm" open
  "../lop/adder-standard.rhdl" as standard
  "../lop/adder-composed.rhdl" as composed

def result = check_equivalent(standard.design, composed.design)

check:
  result.equivalent() ~is #true

print(result.describe())

export:
  result
