#lang rhodium
/* Records the last completed retirement handshake of a two-tag reorder buffer. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("flow/main.rhdl") open
  "two-tag-rob.rhdl".TwoTagROB

/* Forward the ROB interface unchanged; has_commit qualifies the saved tag and payload. */
sync_circuit LoggedTwoTagROB(width :: PosInt = 2):
  input (issue_a, issue_b, complete_a, complete_b): Bool
  input (complete_gen_a, complete_gen_b): Bool
  input (result_a, result_b): Bits(width)
  output (grant_a, grant_b, issue_gen): Bool
  output retire_result: Bits(width)
  interface retire(Irrevocable(Bool), ~role: producer)
  output (has_commit, last_tag): Bool
  output last_payload: Bits(width)

  inst rob(TwoTagROB(width))
  rob.issue_a <== issue_a
  rob.issue_b <== issue_b
  rob.complete_a <== complete_a
  rob.complete_b <== complete_b
  rob.complete_gen_a <== complete_gen_a
  rob.complete_gen_b <== complete_gen_b
  rob.result_a <== result_a
  rob.result_b <== result_b
  grant_a <== rob.grant_a
  grant_b <== rob.grant_b
  issue_gen <== rob.issue_gen
  rob.retire |> retire
  retire_result <== rob.retire_result

  reg occupied(~init: Bool(#false))
  reg tag(Bits(1))
  reg payload(Bits(width))
  def capture = rob.retire.fire() & !reset_active().into(Bool)
  when capture:
    occupied <== Bool(#true)
    tag <== rob.retire.bits.as_bits()
    payload <== rob.retire_result
  has_commit <== occupied
  last_tag <== tag.into(Bool)
  last_payload <== payload

export LoggedTwoTagROB
