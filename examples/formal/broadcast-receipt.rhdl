#lang rhodium
/* Adds a same-edge last-delivery receipt to either two-recipient broadcast implementation. */
// SPDX-License-Identifier: Apache-2.0

import lib("flow/main.rhdl") open
import "queued-fork.rhdl".QueuedFork

/* A single unmatched delivery flips split on; its peer's later delivery flips it off.
   The ingress may accept a replacement on that second edge without delaying the receipt. */
sync_circuit BroadcastReceipt(~queued: queued :: Boolean = #false):
  interface ingress(Decoupled(Bits(2)), ~role: consumer)
  interface egress[2](Irrevocable(Bits(2)), ~role: producer)
  output receipt: Bool
  inst fanout(if queued | QueuedFork() | Broadcast(Bits(2), 2))
  ingress |> fanout.ingress
  for (i in 0..2): fanout.egress[i] |> egress[i]

  reg split(~init: Bool(#false))
  def l = egress[0].fire()
  def r = egress[1].fire()
  def delivering = l ||| r
  def complete = split ||| (l & r)
  when delivering: split <== !complete
  receipt <== !reset_active().into(Bool) & delivering & complete

export BroadcastReceipt
