#lang rhodium
/* Adds a same-edge last-delivery receipt to either broadcast implementation. */
// SPDX-License-Identifier: Apache-2.0

import lib("rhodium/frontend/support/clocking.rhm").ambient_reset_register
import lib("flow/main.rhdl") open
import "queued-fork.rhdl".QueuedFork

/* Pulse when every outstanding copy of the old word transfers, even on a replacement edge. */
sync_circuit BroadcastReceipt(n :: PosInt = 2, width :: PosInt = 2, ~queued: queued :: Boolean = #false):
  interface ingress(Decoupled(Bits(width)), ~role: consumer)
  interface egress[n](Irrevocable(Bits(width)), ~role: producer)
  output receipt: Bool
  inst fanout(if queued | QueuedFork(n, width) | Broadcast(Bits(width), n))
  ingress |> fanout.ingress
  def mutable any_due = Bool(#false)
  def mutable all_done = Bool(#true)
  for (i in 0..n):
    fanout.egress[i] |> egress[i]
    def due = ambient_reset_register("due_" ++ to_string(i), Bool, Bool(#false))
    def delivered = egress[i].fire()
    due <== ingress.fire() ||| (due & !delivered)
    any_due := any_due ||| due
    all_done := all_done & (!due ||| delivered)
  receipt <== !reset_active().into(Bool) & any_due & all_done

export BroadcastReceipt
