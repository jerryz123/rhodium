#lang rhodium
// Demonstrates a finite non-coherent CHI RAM with native cache-line transfers.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("chi/main.rhdl") open

def ram_flit = CHIFlitParams()
def ram_config = CHIRamConfig(ram_flit, 64, ~max_outstanding: 2, ~max_transfer_bytes: 64)
def ram_params = CHIRamParams(
  "test-chi-ram",
  9,
  ram_config,
  ~base_address: 0x80000000
)
def ram_design = elaborate(CHIRam(ram_config))

export:
  ram_flit
  ram_config
  ram_params
  ram_design
