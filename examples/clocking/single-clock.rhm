#lang rhombus
/* Shows one top-level timing contract certifying data sampled throughout a sync_circuit. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/core/main.rhm") open
  lib("rhodium/analysis/clocking.rhm") open
  lib("rhodium/compile/program.rhm").compile_program
  lib("rhodium/lowering/program.rhm").ElaboratedProgram
  "../rtl/reset-shift-register.rhdl" as shift_register

/* Select a named top-level sink from the hierarchy-aware temporal summary. */
fun local_sink(summary :: DesignTemporalSummary, name :: String):
  summary.sinks.find(
    fun (sink): sink.instance_path.length() == 0 && sink.operation.attribute("name", #false) == name
  )

/* Find the next-state classification for one aggregate leaf path of a selected sink. */
fun next_classification(sink :: TemporalSink,
                        path :: List.of(String || Nat)):
  sink.inputs.find(
    fun (input): input.name == "next" && input.path == path
  ).classification

def system = shift_register.design
def top = system.modules.find(
  fun (module_def): module_def.name == "ResetShiftRegister"
)
/* Build timing assumptions from the target-owned top so no source IR enters the report. */
fun environment(prepared_top :: Module):
  def clock = prepared_top.find_input("clock").value
  def data_in = prepared_top.find_input("data_in").value
  def shift = prepared_top.find_input("shift").value
  TemporalEnvironment(
    [TopInputContract(data_in, [], SynchronousInputTiming(clock)),
     TopInputContract(shift, [], SynchronousInputTiming(clock))]
  )
def compiled = compile_program(ElaboratedProgram(system, top), clocking_target(~environment: environment))
def summary = compiled.report.summary
def report = compiled.artifacts[0].content

check:
  next_classification(local_sink(summary, "stages"), [0]) is_a SameClock ~is #true
  next_classification(local_sink(summary, "stages"), [1]) is_a SameClock ~is #true
  report.contains("input data_in: synchronous %clock") ~is #true
  report.contains("input shift: synchronous %clock") ~is #true
  // Reset timing remains unknown until the later RDC environment slice.
  report.contains("reset: unknown_input <- input reset") ~is #true

print(report ++ "\n")

export:
  environment
  summary
  report
