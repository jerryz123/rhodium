#lang rhombus
/* Produces clock-use and hierarchy-aware temporal reports for a sync design. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/analysis/clocking.rhm" open
  "../../rhodium/compile/program.rhm".compile_program
  "../rtl/sync-counter.rhdl" as counter

def compiled = compile_program(counter.program, clocking_target())
def child = compiled.report.design.modules.find(fun (module_def): module_def.name == "Counter")
def clocking = compiled.report.clocks.find(fun (summary): summary.module_def === child)
def temporal = compiled.report.summary
def report = compiled.artifacts[0].content

check:
  clocking is_a SingleClock ~is #true
  clocking.clock === child.find_input("clock").value ~is #true
  report.contains("sink counter.state rtl.register_reset") ~is #true

print(report)

export:
  clocking
  temporal
  report
