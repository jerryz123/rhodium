#lang rhombus
// Produces clock-use and hierarchy-aware temporal reports for a sync design.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/analysis/clocking.rhm" open
  "../rtl/sync-counter.rhdl" as counter

def top = counter.design.modules.find(
  fun (module_def): module_def.name == "CounterTop"
)
def child = counter.design.modules.find(
  fun (module_def): module_def.name == "Counter"
)
def clocking = summarize_module_clocking(
  child,
  child.find_input("reset").value
)
def temporal = summarize_module_temporal(top)
def report = dump_temporal_report(temporal)

check:
  clocking is_a SingleClock ~is #true
  clocking.clock === child.find_input("clock").value ~is #true
  report.contains("sink counter.state rtl.register_reset") ~is #true

print(report)

export:
  clocking
  temporal
  report
