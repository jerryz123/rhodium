#lang rhodium
// Demonstrates descriptor-generated RISC-V fields and immediate extraction.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("riscv/model/fields.rhm") open
  lib("riscv/model/formats.rhm") open
  lib("riscv/rtl/instruction-fields.rhdl") open

circuit InstructionFieldsFixture():
  input instruction: Bits(32)
  output rd_value: Bits(5)
  output rs1_value: Bits(5)
  output rs2_value: Bits(5)
  output i_value: Bits(64)
  output s_value: Bits(64)
  output b_value: Bits(64)
  output u_value: Bits(64)
  output j_value: Bits(64)
  output shift_value: Bits(64)
  rd_value <== instruction_field(rd, instruction)
  rs1_value <== instruction_field(rs1, instruction)
  rs2_value <== instruction_field(rs2, instruction)
  i_value <== instruction_immediate(IImmediate, instruction, 64)
  s_value <== instruction_immediate(SImmediate, instruction, 64)
  b_value <== instruction_immediate(BImmediate, instruction, 64)
  u_value <== instruction_immediate(UImmediate, instruction, 64)
  j_value <== instruction_immediate(JImmediate, instruction, 64)
  shift_value <== instruction_immediate(Shift64Immediate, instruction, 64)

def design = elaborate(InstructionFieldsFixture())

def verilog_reference = @str|<<{
module InstructionFieldsFixture(
  input  [31:0] instruction,
  output [4:0]  rd_value,
                rs1_value,
                rs2_value,
  output [63:0] i_value,
                s_value,
                b_value,
                u_value,
                j_value,
                shift_value
);

  wire [51:0] _GEN = {52{instruction[31]}};
  assign rd_value = instruction[11:7];
  assign rs1_value = instruction[19:15];
  assign rs2_value = instruction[24:20];
  assign i_value = {_GEN, instruction[31:20]};
  assign s_value = {_GEN, instruction[31:25], instruction[11:7]};
  assign b_value = {_GEN, instruction[7], instruction[30:25], instruction[11:8], 1'h0};
  assign u_value = {{32{instruction[31]}}, instruction[31:12], 12'h0};
  assign j_value =
    {{44{instruction[31]}},
     instruction[19:12],
     instruction[20],
     instruction[30:21],
     1'h0};
  assign shift_value = {58'h0, instruction[25:20]};
endmodule
}>>|

export:
  InstructionFieldsFixture
  design
  verilog_reference
