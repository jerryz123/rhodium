#lang rhodium
/* Builds the reference adder with the standard binding and operator layers. */
// SPDX-License-Identifier: Apache-2.0


/* Adds the two width-sized operands with fixed-width wraparound. */
circuit Adder(width :: PosInt):
  input(a, b): Bits(width)
  output sum: Bits(width)
  sum <== a + b

def program = elaborate(Adder(8))

def verilog_reference = @str|<<{
module Adder(
  input  [7:0] a,
               b,
  output [7:0] sum
);

  assign sum = a + b;
endmodule
}>>|

export:
  Adder
  program
  verilog_reference
