#lang rhombus
// Demonstrates backend-independent inspection of an elaborated Rhodium design.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/core/main.rhm") open
  "adder-standard.rhdl" as adder

fun operation_count(design :: Design, opcode :: String):
  design.walk().filter(
    ~keep: fun (operation): operation.opcode == opcode
  ).length()

fun summarize_design(design :: Design):
  [["modules", design.modules.length()],
   ["operations", design.walk().length()],
   ["additions", operation_count(design, "rtl.add")]]

print(summarize_design(adder.design))

export:
  operation_count
  summarize_design
