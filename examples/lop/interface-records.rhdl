#lang rhodium/base
// Builds a ready-valid adapter from explicit directional record ports.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/types.rhm" open
  "../../rhodium/frontend/layers/bool.rhm".Bool

fun Forward(T :: DataType):
  RecordType([RecordField("valid", Bool), RecordField("bits", T)])

def Backward = RecordType([RecordField("ready", Bool)])

circuit ReadyValidAdapter(width :: PosInt):
  input ingress_in: Forward(Bits(width))
  output ingress_out: Backward
  output egress_out: Forward(Bits(width))
  input egress_in: Backward

  egress_out <== ingress_in
  ingress_out <== egress_in

def design = elaborate(ReadyValidAdapter(8))

def verilog_reference = @str|<<{
module ReadyValidAdapter(
  input  struct packed {logic valid; logic [7:0] bits; } ingress_in,
  input  struct packed {logic ready; }                   egress_in,
  output struct packed {logic ready; }                   ingress_out,
  output struct packed {logic valid; logic [7:0] bits; } egress_out
);

  assign ingress_out = egress_in;
  assign egress_out = ingress_in;
endmodule
}>>|

export:
  Forward
  Backward
  ReadyValidAdapter
  design
  verilog_reference
