#lang rhombus
// Builds the reference adder by explicitly importing and using the public core Builder API.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/main.rhm" open

def design = Design()
def builder = Builder(design)
def adder = builder.module("Adder")
def a = builder.input(adder, "a", Bits(8))
def b = builder.input(adder, "b", Bits(8))
def sum = builder.output(adder, "sum", Bits(8))
def result = builder.add(adder, a, b)
builder.drive(sum, result)
def finished_adder = builder.finish(adder)
verify_design(design)

def verilog_reference = @str|<<{
module Adder(
  input  [7:0] a,
               b,
  output [7:0] sum
);

  assign sum = a + b;
endmodule
}>>|

export:
  design
  verilog_reference
