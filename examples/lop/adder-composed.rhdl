#lang rhodium/base
/* Builds the reference adder by composing the minimal language with combinational syntax. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/layers/comb.rhm") open

/* Adds the two width-sized operands with fixed-width wraparound. */
circuit Adder(width :: PosInt):
  input(a, b): Bits(width)
  output sum: Bits(width)
  sum <== a + b

def program = elaborate(Adder(8))

def verilog_reference = @str|<<{
module Adder(
  input  [7:0] a,
               b,
  output [7:0] sum
);

  assign sum = a + b;
endmodule
}>>|

export:
  Adder
  program
  verilog_reference
