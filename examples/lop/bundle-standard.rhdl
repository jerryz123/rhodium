#lang rhodium
// Builds the record-valued swap through the concise bundle layer.
// SPDX-License-Identifier: Apache-2.0

bundle Pair(T :: DataType):
  left: T
  right: T

circuit BundleSwap(width :: PosInt):
  input source: Pair(Bits(width))
  output result: Pair(Bits(width))

  result.left <== source.right
  result.right <== source.left

def design = elaborate(BundleSwap(8))

def verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhodium_types
`define _TYPESCOPE_rhodium_types
  typedef struct packed {logic [7:0] left; logic [7:0] right; } Pair;
`endif // _TYPESCOPE_rhodium_types
module BundleSwap(
  input  Pair source,
  output Pair result
);

  assign result = '{left: source.right, right: source.left};
endmodule
}>>|

export:
  Pair
  BundleSwap
  design
  verilog_reference
