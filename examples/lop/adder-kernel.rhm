#lang rhombus
/* Builds the reference adder by explicitly importing the context-based elaboration kernel. */
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/types.rhm" open
  "../../rhodium/frontend/kernel.rhm" open

def adder_identity = new_circuit_identity("Adder")

/* Adds the two width-sized operands with fixed-width wraparound. */
fun Adder(width :: PosInt):
  /* Creates the ports and operations in the active kernel construction context. */
  fun implementation():
    def a = input("a", Bits(width))
    def b = input("b", Bits(width))
    def sum = output("sum", Bits(width))
    def result = hw_add(a, b)
    connect(sum, result)
  build_circuit(adder_identity, "Adder", [width], implementation)

def program = run_elaboration(fun (): Adder(8))

def verilog_reference = @str|<<{
module Adder(
  input  [7:0] a,
               b,
  output [7:0] sum
);

  assign sum = a + b;
endmodule
}>>|

export:
  Adder
  program
  verilog_reference
