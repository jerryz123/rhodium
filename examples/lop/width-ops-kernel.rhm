#lang rhombus
// Builds the width-operations showcase through explicit elaboration-kernel calls.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../rhodium/core/types.rhm" open
  "../../rhodium/frontend/kernel.rhm" open

def width_ops_identity = new_circuit_identity("WidthOps8")

fun WidthOps8():
  fun implementation():
    def a = input("a", Bits(8))
    def b = input("b", Bits(4))
    def joined = output("joined", Bits(12))
    def middle = output("middle", Bits(4))
    def narrowed = output("narrowed", Bits(4))
    def widened = output("widened", Bits(12))

    connect(joined, concat([a, b]))
    connect(middle, extract(a, 5, 2))
    connect(widened, zext(a, 12))
    connect(narrowed, trunc(a, 4))
  build_circuit(width_ops_identity, "WidthOps8", [], implementation)

def design = run_elaboration(fun (): WidthOps8())

def verilog_reference = @str|<<{
module WidthOps8(
  input  [7:0]  a,
  input  [3:0]  b,
  output [11:0] joined,
  output [3:0]  middle,
                narrowed,
  output [11:0] widened
);

  assign joined = {a, b};
  assign middle = a[5:2];
  assign narrowed = a[3:0];
  assign widened = {4'h0, a};
endmodule
}>>|

export:
  WidthOps8
  design
  verilog_reference
