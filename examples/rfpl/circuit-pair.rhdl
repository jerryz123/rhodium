#lang rhodium
// Defines the ordinary logical circuit hierarchy annotated by the RFPL example.
// SPDX-License-Identifier: Apache-2.0

circuit Adder(width :: PosInt):
  input(a, b): Bits(width)
  output sum: Bits(width)
  sum <== a + b

circuit AdderShell(bit_width :: PosInt):
  input(a, b): Bits(bit_width)
  output sum: Bits(bit_width)

  inst wrapped(Adder(bit_width))
  wrapped.a <== a
  wrapped.b <== b
  sum <== wrapped.sum

circuit CrossedWires(bit_width :: PosInt):
  input(a, b): Bits(bit_width)
  output(a_out, b_out): Bits(bit_width)
  a_out <== b
  b_out <== a

circuit AdderPair(bit_width :: PosInt):
  input(a, b): Bits(bit_width)
  output(sum0, sum1): Bits(bit_width)

  def shell = AdderShell(bit_width)
  def crossed_wires = CrossedWires(bit_width)
  inst left(shell)
  inst right(shell)
  inst crossed(crossed_wires)
  left.a <== a
  left.b <== b
  crossed.a <== a
  crossed.b <== b
  right.a <== crossed.a_out
  right.b <== crossed.b_out
  sum0 <== left.sum
  sum1 <== right.sum

def logical = elaborate_with_top(AdderPair(8))
def design = logical.design

// This normalized reference is generated by CIRCT's ExportVerilog pipeline.
def verilog_reference = @str|<<{
module AdderPair(
  input  [7:0] a,
               b,
  output [7:0] sum0,
               sum1
);

  wire [7:0] _crossed_a_out;
  wire [7:0] _crossed_b_out;
  AdderShell left (
    .a   (a),
    .b   (b),
    .sum (sum0)
  );
  AdderShell right (
    .a   (_crossed_a_out),
    .b   (_crossed_b_out),
    .sum (sum1)
  );
  CrossedWires crossed (
    .a     (a),
    .b     (b),
    .a_out (_crossed_a_out),
    .b_out (_crossed_b_out)
  );
endmodule

module AdderShell(
  input  [7:0] a,
               b,
  output [7:0] sum
);

  Adder wrapped (
    .a   (a),
    .b   (b),
    .sum (sum)
  );
endmodule

module Adder(
  input  [7:0] a,
               b,
  output [7:0] sum
);

  assign sum = a + b;
endmodule

module CrossedWires(
  input  [7:0] a,
               b,
  output [7:0] a_out,
               b_out
);

  assign a_out = b;
  assign b_out = a;
endmodule
}>>|

export:
  Adder
  AdderShell
  CrossedWires
  AdderPair
  logical
  design
  verilog_reference
