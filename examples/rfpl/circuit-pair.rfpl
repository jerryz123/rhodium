#lang rfpl
// Annotates an existing Rhodium hierarchy and retains its generated Verilog golden.
// SPDX-License-Identifier: Apache-2.0

import:
  "circuit-pair.rhdl" as logical_fixture

def logical = logical_fixture.logical
def pair = logical.top
def left = child_instance(pair, "left")
def right = child_instance(pair, "right")
def crossed = child_instance(pair, "crossed")
def shell = instance_target(left)
def wrapped = child_instance(shell, "wrapped")
def adder = instance_target(wrapped)
def crossed_wires = instance_target(crossed)

def adder_macro = hard_macro(
  adder,
  width: um(40),
  height: um(24)
)
def shell_floorplan = floorplan(
  shell,
  width: um(40),
  height: um(24),
  placements: [
    place(wrapped, adder_macro, at: (um(0), um(0)))
  ]
)
def crossed_macro = hard_macro(
  crossed_wires,
  width: um(16),
  height: um(8)
)
def pair_floorplan = floorplan(
  pair,
  width: um(100),
  height: um(50),
  placements: [
    place(left, shell_floorplan, at: (um(0), um(0))),
    place(right, shell_floorplan, at: (um(50), um(0))),
    place(crossed, crossed_macro, at: (um(42), um(30)))
  ]
)

def floorplan_design = annotate(logical, pair_floorplan)
def design = floorplan_design.design

export:
  logical
  adder_macro
  shell_floorplan
  crossed_macro
  pair_floorplan
  floorplan_design
  design
