#lang rhodium
// Elaborates a linkless one-router NoC with three independent ingress and ejection terminals.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../noc/model/main.rhm" open
  "../../noc/authoring/main.rhm" open
  "../../noc/plan/main.rhm" open
  "../../noc/std/traffic/main.rhm" open
  lib("rhodium/std/ready-valid.rhdl") open
  "../../noc/rtl/main.rhdl" open

export:
  topology_spec
  lowered_topology
  injection_terminals
  ejection_terminals
  route_specs
  routes
  routing
  network_plan
  router_plan
  router_config
  OneRouterCrossbarFixture
  design

def router_ref = NodeRef("router")
def injection_specs = for List (index in 0..3):
  InjectionTerminalSpec(
    InjectionRef("input" ++ to_string(index)),
    router_ref
  )
def ejection_specs = for List (index in 0..3):
  EjectionTerminalSpec(
    EjectionRef("output" ++ to_string(index)),
    router_ref
  )
def topology_spec = TopologySpec(
  [router_ref],
  [],
  ~injections: injection_specs,
  ~ejections: ejection_specs
)
def lowered_topology = lower_topology(topology_spec)
def injection_terminals = lowered_topology.injection_bindings.map(
  fun (binding): binding.terminal
)
def ejection_terminals = lowered_topology.ejection_bindings.map(
  fun (binding): binding.terminal
)
def route_specs = all_pairs(topology_spec, ~include_local: #true)
def lowered_routes = lower_route_classes(lowered_topology, route_specs)
def routes = lowered_routes.route_classes

def routing = compile_routing(
  RoutingProblem(
    lowered_topology.topology,
    routes,
    RoutingRelation(fun (_route, _origin, _candidate): #false)
  )
)
unless routing is_a ValidatedRouting
| error(~who: #'OneRouterCrossbarFixture,
        "linkless crossbar routing must validate before hardware generation")

def network_plan = NetworkPlan(routing)
def router_plan = network_plan.router_plan(lowered_topology.node_id(router_ref))
def router_config = compile_simple_router(router_plan)
def Beat = RoutedBeat(Bits(8), router_config.route_decoder.route_width)

sync_circuit OneRouterCrossbarFixture():
  interface ingress[3](Decoupled(Beat), ~role: consumer)
  interface egress[3](Decoupled(Beat), ~role: producer)

  inst router(SimpleRouter(Bits(8), router_config))
  router.ingress <=> ingress
  for (index in 0..router_config.target_count):
    egress[index] <=> router.target[index].egress
    router.target[index].available <== router.target[index].egress.ready

def design = elaborate(OneRouterCrossbarFixture())
