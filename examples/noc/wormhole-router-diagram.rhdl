#lang rhodium
// Generates a flow-aware diagram of the packet-retaining phased-XY NoC router.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../noc/examples/mesh-phased-xy.rhm" as phased
  "../../noc/plan/main.rhm" open
  "../../noc/rtl/main.rhdl" open
  "../../rhodium/diagram/main.rhm" open

unless phased.phased_routing is_a ValidatedRouting
| error(~who: #'wormhole_router_diagram,
        "phased-XY routing must validate before diagram generation")

// A 2x2 corner has one injection, four incoming VCs, four outgoing VCs, and
// one ejection. Both phase VCs participate in the validated route relation.
def router_node = phased.phased_topology.node_id(
  phased.phased_mesh.node_at(0, 0)
)
def router_plan = RouterPlan(phased.phased_routing, router_node)
def router_config = compile_wormhole_router(router_plan)
def logical = elaborate_with_top(WormholeRouter(Bits(32), router_config))
def view = diagram(logical)
def router_diagram = view.module("WormholeRouter")
def json = diagram_module_to_json(router_diagram)
def dot = diagram_module_to_dot(router_diagram)

export:
  router_plan
  router_config
  logical
  view
  router_diagram
  json
  dot
