#lang rhodium
// Builds router-local route computers for every node in a validated two-hop NoC.
// SPDX-License-Identifier: Apache-2.0

import:
  "../../noc/model/main.rhm" open
  "../../noc/plan/main.rhm" open
  "../../noc/rtl/main.rhdl" open

def n0 = NodeId(0)
def n1 = NodeId(1)
def n2 = NodeId(2)
def first = PhysicalLink(LinkId(0), n0, n1, 2)
def second = PhysicalLink(LinkId(1), n1, n2, 2)
def topology = Topology([n0, n1, n2], [first, second])
def route = RouteClass(RouteClassId(0), n0, n2)

fun on_link(vc :: VCId, link :: PhysicalLink):
  link_id_equal(vc.link_id, link.id)

fun allows(_route_class :: RouteClass,
           origin :: Injection || HeldVC,
           candidate :: VCId):
  cond
  | origin is_a Injection:
      on_link(candidate, first)
  | origin is_a HeldVC:
      on_link(origin.vc, first) && on_link(candidate, second) && (origin.vc.index == candidate.index)
  | ~else: #false

def routing = compile_routing(
  RoutingProblem(topology, [route], RoutingRelation(allows))
)
unless routing is_a ValidatedRouting
| error(~who: #'RouteComputer,
        "example routing must pass validation before hardware generation")

def source_plan = RouterPlan(routing, n0)
def middle_plan = RouterPlan(routing, n1)
def destination_plan = RouterPlan(routing, n2)
def source_decoder = compile_route_decoder(source_plan)
def middle_decoder = compile_route_decoder(middle_plan)
def destination_decoder = compile_route_decoder(destination_plan)

circuit RouteComputerFixture():
  input source_route_key: Bits(source_decoder.route_width)
  input source_origin_key: Bits(source_decoder.origin_width)
  output source_target_mask: Mask(source_decoder.mask_width)
  output source_fallback_mask: Mask(source_decoder.mask_width)
  output source_valid: Bool

  input middle_route_key: Bits(middle_decoder.route_width)
  input middle_origin_key: Bits(middle_decoder.origin_width)
  output middle_target_mask: Mask(middle_decoder.mask_width)
  output middle_fallback_mask: Mask(middle_decoder.mask_width)
  output middle_valid: Bool

  input destination_route_key: Bits(destination_decoder.route_width)
  input destination_origin_key: Bits(destination_decoder.origin_width)
  output destination_target_mask: Mask(destination_decoder.mask_width)
  output destination_fallback_mask: Mask(destination_decoder.mask_width)
  output destination_valid: Bool

  inst source(RouteComputer(source_decoder))
  inst middle(RouteComputer(middle_decoder))
  inst destination(RouteComputer(destination_decoder))

  source.route_key <== source_route_key
  source.origin_key <== source_origin_key
  source_target_mask <== source.target_mask
  source_fallback_mask <== source.fallback_mask
  source_valid <== source.valid

  middle.route_key <== middle_route_key
  middle.origin_key <== middle_origin_key
  middle_target_mask <== middle.target_mask
  middle_fallback_mask <== middle.fallback_mask
  middle_valid <== middle.valid

  destination.route_key <== destination_route_key
  destination.origin_key <== destination_origin_key
  destination_target_mask <== destination.target_mask
  destination_fallback_mask <== destination.fallback_mask
  destination_valid <== destination.valid

def design = elaborate(RouteComputerFixture())

// Exact normalized SystemVerilog reference for the focused backend fixture.
def verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhodium_types
`define _TYPESCOPE_rhodium_types
  typedef struct packed {logic route_key; logic origin_key; } RouteLookupKey;
  typedef
    struct packed {logic [1:0] target_mask; logic [1:0] fallback_mask; logic valid; }
    RouteDecision;
  typedef struct packed {logic target_mask; logic fallback_mask; logic valid; }
    RouteDecision_1;
`endif // _TYPESCOPE_rhodium_types
module RouteComputerFixture(
  input        source_route_key,
               source_origin_key,
               middle_route_key,
               middle_origin_key,
               destination_route_key,
               destination_origin_key,
  output [1:0] source_target_mask,
               source_fallback_mask,
  output       source_valid,
  output [1:0] middle_target_mask,
               middle_fallback_mask,
  output       middle_valid,
               destination_target_mask,
               destination_fallback_mask,
               destination_valid
);

  RouteComputer source (
    .route_key     (source_route_key),
    .origin_key    (source_origin_key),
    .target_mask   (source_target_mask),
    .fallback_mask (source_fallback_mask),
    .valid         (source_valid)
  );
  RouteComputer_1 middle (
    .route_key     (middle_route_key),
    .origin_key    (middle_origin_key),
    .target_mask   (middle_target_mask),
    .fallback_mask (middle_fallback_mask),
    .valid         (middle_valid)
  );
  RouteComputer_2 destination (
    .route_key     (destination_route_key),
    .origin_key    (destination_origin_key),
    .target_mask   (destination_target_mask),
    .fallback_mask (destination_fallback_mask),
    .valid         (destination_valid)
  );
endmodule

module RouteComputer(
  input        route_key,
               origin_key,
  output [1:0] target_mask,
               fallback_mask,
  output       valid
);

  logic [4:0]          __rhodium_decode_6_result;
  wire  RouteLookupKey _GEN = '{route_key: route_key, origin_key: origin_key};
  wire  [1:0]          _GEN_0 = /*cast(bit[1:0])*/_GEN;
  always_comb begin
    case (_GEN_0)
      2'b00:
        __rhodium_decode_6_result = 5'h1F;
      default:
        __rhodium_decode_6_result = 5'h0;
    endcase
  end // always_comb
  wire  RouteDecision  _GEN_1 = /*cast(bit)*/__rhodium_decode_6_result;
  assign target_mask = _GEN_1.target_mask;
  assign fallback_mask = _GEN_1.fallback_mask;
  assign valid = _GEN_1.valid;
endmodule

module RouteComputer_1(
  input        route_key,
               origin_key,
  output [1:0] target_mask,
               fallback_mask,
  output       valid
);

  logic [4:0]          __rhodium_decode_6_result;
  wire  RouteLookupKey _GEN = '{route_key: route_key, origin_key: origin_key};
  wire  [1:0]          _GEN_0 = /*cast(bit[1:0])*/_GEN;
  always_comb begin
    case (_GEN_0)
      2'b00:
        __rhodium_decode_6_result = 5'hB;
      2'b01:
        __rhodium_decode_6_result = 5'h15;
      default:
        __rhodium_decode_6_result = 5'h0;
    endcase
  end // always_comb
  wire  RouteDecision  _GEN_1 = /*cast(bit)*/__rhodium_decode_6_result;
  assign target_mask = _GEN_1.target_mask;
  assign fallback_mask = _GEN_1.fallback_mask;
  assign valid = _GEN_1.valid;
endmodule

module RouteComputer_2(
  input  route_key,
         origin_key,
  output target_mask,
         fallback_mask,
         valid
);

  logic [2:0]           __rhodium_decode_6_result;
  wire  RouteLookupKey  _GEN = '{route_key: route_key, origin_key: origin_key};
  wire  [1:0]           _GEN_0 = /*cast(bit[1:0])*/_GEN;
  always_comb begin
    case (_GEN_0)
      2'b00:
        __rhodium_decode_6_result = 3'h7;
      2'b01:
        __rhodium_decode_6_result = 3'h7;
      default:
        __rhodium_decode_6_result = 3'h0;
    endcase
  end // always_comb
  wire  RouteDecision_1 _GEN_1 = /*cast(bit)*/__rhodium_decode_6_result;
  assign target_mask = _GEN_1.target_mask;
  assign fallback_mask = _GEN_1.fallback_mask;
  assign valid = _GEN_1.valid;
endmodule
}>>|

export:
  n0
  n1
  n2
  first
  second
  topology
  route
  routing
  source_plan
  middle_plan
  destination_plan
  source_decoder
  middle_decoder
  destination_decoder
  RouteComputerFixture
  design
  verilog_reference
