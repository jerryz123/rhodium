#lang rhodium
// Demonstrates a signed direct-form FIR filter with generated taps and explicit widths.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/shift-register.rhdl").shift_register
  lib("rhodium/std/reduction.rhdl").tree_reduce

sync_circuit FirFilter(sample_width :: PosInt,
                       coefficient_width :: PosInt,
                       coefficients :: List.of(Int)):
  unless coefficients.length() > 1
  | error(~who: #'FirFilter, "expected at least two coefficients")

  def tap_count = coefficients.length()
  def delay_count = tap_count - 1
  def product_width = sample_width + coefficient_width
  def accumulator_width = product_width + index_width(tap_count)

  input sample: SInt(sample_width)
  output filtered: SInt(accumulator_width)

  // The registers hold x[n - 1] through x[n - (tap_count - 1)].
  shift_register delays(sample, delay_count, ~init: sint(0, sample_width))

  // Expanding multiplication retains each complete signed product; the final
  // extension adds enough accumulator guard bits for the sum of all taps.
  def samples = [sample] ++ (for List (index in 0..delay_count): delays[index])
  def products = for List (tap in samples, coefficient in coefficients):
    (tap *& sint(coefficient, coefficient_width)).sext(accumulator_width)

  filtered <== tree_reduce(products, fun (left, right): left + right)

// The binomial coefficients form a small smoothing low-pass filter.
def design = elaborate(FirFilter(8, 3, [1, 3, 3, 1]))

def verilog_reference = @str|<<{
module FirFilter(
  input         clock,
                reset,
  input  [7:0]  sample,
  output [12:0] filtered
);

  reg  [2:0][7:0] delays;
  wire [10:0]     _GEN = {{3{delays[2'h0][7]}}, delays[2'h0]} * 11'h3;
  wire [10:0]     _GEN_0 = {{3{delays[2'h1][7]}}, delays[2'h1]} * 11'h3;
  always @(posedge clock) begin
    if (reset)
      delays <= '{8'h0, 8'h0, 8'h0};
    else begin
      delays[2'h2] <= delays[2'h1];
      delays[2'h1] <= delays[2'h0];
      delays[2'h0] <= sample;
    end
  end // always @(posedge)
  assign filtered =
    {{5{sample[7]}}, sample} + {{2{_GEN[10]}}, _GEN} + {{2{_GEN_0[10]}}, _GEN_0}
    + {{5{delays[2'h2][7]}}, delays[2'h2]};
endmodule
}>>|

export:
  FirFilter
  design
  verilog_reference
