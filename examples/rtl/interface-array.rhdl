#lang rhodium
// Demonstrates endpoint arrays, generic handles, and terminated interface sinks.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/ready-valid.rhdl") open

interface ByteExchange():
  role requester
  role responder

  requester -> responder:
    request: Bits(8)

  responder -> requester:
    response: Bits(8)

circuit InterfaceArrayAdapter(n :: PosInt):
  interface ingress[n](Decoupled(Bits(8)), ~role: consumer)
  interface egress[n](Decoupled(Bits(8)), ~role: producer)

  egress <=> ingress

circuit InterfaceArrayHierarchy(n :: PosInt):
  interface ingress[n](Decoupled(Bits(8)), ~role: consumer)
  interface egress[n](Decoupled(Bits(8)), ~role: producer)

  inst adapter(InterfaceArrayAdapter(n))
  adapter.ingress <=> ingress
  egress <=> adapter.egress

circuit InterfaceSequenceAdapter():
  interface ingress0(Decoupled(Bits(8)), ~role: consumer)
  interface ingress1(Decoupled(Bits(8)), ~role: consumer)
  interface egress[2](Decoupled(Bits(8)), ~role: producer)

  egress <=> (ingress0, ingress1)

// Generic handles are not specific to ready-valid flow. Each interface_link
// contributes a transparent local connection; handle-to-handle application
// composes the links before either external endpoint is attached.
circuit GenericHandleChain():
  interface ingress(ByteExchange(), ~role: responder)
  interface egress(ByteExchange(), ~role: requester)

  def path = interface_link(ByteExchange(), "first")
             |> interface_link(ByteExchange(), "second")
  ingress |> path |> egress

// Parallel handle composition gives one handle array-shaped ends. The same
// ordinary endpoint-array bulk connection terminates both sides of the path.
circuit ParallelHandleChain():
  interface ingress[2](Decoupled(Bits(8)), ~role: consumer)
  interface egress[2](Decoupled(Bits(8)), ~role: producer)

  def lanes = parallel_handles(Array(
    interface_link(Decoupled(Bits(8)), "lane"),
    interface_link(Decoupled(Bits(8)), "lane")
  ))
  def connected = ingress |> lanes
  egress <=> connected

// Closing each handle against its destination produces a one-ended sink.
// Parallel sink composition lets one endpoint array complete both lanes.
circuit ParallelSinkChain():
  interface ingress[2](Decoupled(Bits(8)), ~role: consumer)
  interface egress[2](Decoupled(Bits(8)), ~role: producer)

  def lanes = parallel_handles(Array(
    interface_link(Decoupled(Bits(8)), "lane") |> egress[0],
    interface_link(Decoupled(Bits(8)), "lane") |> egress[1]
  ))
  ingress |> lanes

def design = elaborate(InterfaceArrayAdapter(2))
def generic_handle_design = elaborate(GenericHandleChain())
def parallel_handle_design = elaborate(ParallelHandleChain())
def parallel_sink_design = elaborate(ParallelSinkChain())
def hierarchy_design = elaborate(InterfaceArrayHierarchy(2))
def sequence_design = elaborate(InterfaceSequenceAdapter())

def verilog_reference = @str|<<{
module InterfaceArrayAdapter(
  input  struct packed {logic valid; logic [7:0] bits; } ingress_0_in,
                                                         ingress_1_in,
  input  struct packed {logic ready; }                   egress_0_in,
                                                         egress_1_in,
  output struct packed {logic ready; }                   ingress_0_out,
                                                         ingress_1_out,
  output struct packed {logic valid; logic [7:0] bits; } egress_0_out,
                                                         egress_1_out
);

  assign ingress_0_out = egress_0_in;
  assign ingress_1_out = egress_1_in;
  assign egress_0_out = ingress_0_in;
  assign egress_1_out = ingress_1_in;
endmodule
}>>|

def generic_handle_verilog_reference = @str|<<{
module GenericHandleChain(
  input  struct packed {logic [7:0] request; }  ingress_in,
  input  struct packed {logic [7:0] response; } egress_in,
  output struct packed {logic [7:0] response; } ingress_out,
  output struct packed {logic [7:0] request; }  egress_out
);

  assign ingress_out = egress_in;
  assign egress_out = ingress_in;
endmodule
}>>|
def parallel_handle_verilog_reference = @str|<<{
module ParallelHandleChain(
  input  struct packed {logic valid; logic [7:0] bits; } ingress_0_in,
                                                         ingress_1_in,
  input  struct packed {logic ready; }                   egress_0_in,
                                                         egress_1_in,
  output struct packed {logic ready; }                   ingress_0_out,
                                                         ingress_1_out,
  output struct packed {logic valid; logic [7:0] bits; } egress_0_out,
                                                         egress_1_out
);

  assign ingress_0_out = egress_0_in;
  assign ingress_1_out = egress_1_in;
  assign egress_0_out = ingress_0_in;
  assign egress_1_out = ingress_1_in;
endmodule
}>>|
def parallel_sink_verilog_reference = @str|<<{
module ParallelSinkChain(
  input  struct packed {logic valid; logic [7:0] bits; } ingress_0_in,
                                                         ingress_1_in,
  input  struct packed {logic ready; }                   egress_0_in,
                                                         egress_1_in,
  output struct packed {logic ready; }                   ingress_0_out,
                                                         ingress_1_out,
  output struct packed {logic valid; logic [7:0] bits; } egress_0_out,
                                                         egress_1_out
);

  assign ingress_0_out = egress_0_in;
  assign ingress_1_out = egress_1_in;
  assign egress_0_out = ingress_0_in;
  assign egress_1_out = ingress_1_in;
endmodule
}>>|

def hierarchy_verilog_reference = @str|<<{
module InterfaceArrayHierarchy(
  input  struct packed {logic valid; logic [7:0] bits; } ingress_0_in,
                                                         ingress_1_in,
  input  struct packed {logic ready; }                   egress_0_in,
                                                         egress_1_in,
  output struct packed {logic ready; }                   ingress_0_out,
                                                         ingress_1_out,
  output struct packed {logic valid; logic [7:0] bits; } egress_0_out,
                                                         egress_1_out
);

  InterfaceArrayAdapter adapter (
    .ingress_0_in  (ingress_0_in),
    .ingress_1_in  (ingress_1_in),
    .egress_0_in   (egress_0_in),
    .egress_1_in   (egress_1_in),
    .ingress_0_out (ingress_0_out),
    .ingress_1_out (ingress_1_out),
    .egress_0_out  (egress_0_out),
    .egress_1_out  (egress_1_out)
  );
endmodule

module InterfaceArrayAdapter(
  input  struct packed {logic valid; logic [7:0] bits; } ingress_0_in,
                                                         ingress_1_in,
  input  struct packed {logic ready; }                   egress_0_in,
                                                         egress_1_in,
  output struct packed {logic ready; }                   ingress_0_out,
                                                         ingress_1_out,
  output struct packed {logic valid; logic [7:0] bits; } egress_0_out,
                                                         egress_1_out
);

  assign ingress_0_out = egress_0_in;
  assign ingress_1_out = egress_1_in;
  assign egress_0_out = ingress_0_in;
  assign egress_1_out = ingress_1_in;
endmodule
}>>|
def sequence_verilog_reference = @str|<<{
module InterfaceSequenceAdapter(
  input  struct packed {logic valid; logic [7:0] bits; } ingress0_in,
                                                         ingress1_in,
  input  struct packed {logic ready; }                   egress_0_in,
                                                         egress_1_in,
  output struct packed {logic ready; }                   ingress0_out,
                                                         ingress1_out,
  output struct packed {logic valid; logic [7:0] bits; } egress_0_out,
                                                         egress_1_out
);

  assign ingress0_out = egress_0_in;
  assign ingress1_out = egress_1_in;
  assign egress_0_out = ingress0_in;
  assign egress_1_out = ingress1_in;
endmodule
}>>|

export:
  ByteExchange
  InterfaceArrayAdapter
  InterfaceArrayHierarchy
  InterfaceSequenceAdapter
  GenericHandleChain
  ParallelHandleChain
  ParallelSinkChain
  design
  generic_handle_design
  parallel_handle_design
  parallel_sink_design
  hierarchy_design
  sequence_design
  verilog_reference
  generic_handle_verilog_reference
  parallel_handle_verilog_reference
  parallel_sink_verilog_reference
  hierarchy_verilog_reference
  sequence_verilog_reference
