#lang rhodium
// Demonstrates byte-masked writes through one shared synchronous memory port.
// SPDX-License-Identifier: Apache-2.0

sync_circuit MaskedSyncMemoryExample(depth :: PosInt):
  input address: Bits(index_width(depth))
  input enable: Bits(1)
  input write: Bits(1)
  input write_data: Bits(32)
  input write_mask: Bits(4)
  output read_data: Bits(32)

  sync_mem storage(depth, Bits(32), ~mask_granularity: 8):
    read_write

  storage.read_write.address <== address
  storage.read_write.enable <== enable
  storage.read_write.write <== write
  storage.read_write.write_data <== write_data
  storage.read_write.write_mask <== write_mask
  read_data <== storage.read_write.read_data

def design = elaborate(MaskedSyncMemoryExample(4))

def verilog_reference = @str|<<{
module storage_4x32(
  input  [1:0]  RW0_addr,
  input         RW0_en,
                RW0_clk,
                RW0_wmode,
  input  [31:0] RW0_wdata,
  output [31:0] RW0_rdata,
  input  [3:0]  RW0_wmask
);

  reg  [31:0] Memory[0:3];
  reg  [1:0]  _RW0_raddr_d0;
  reg         _RW0_ren_d0;
  reg         _RW0_rmode_d0;
  always @(posedge RW0_clk) begin
    _RW0_raddr_d0 <= RW0_addr;
    _RW0_ren_d0 <= RW0_en;
    _RW0_rmode_d0 <= RW0_wmode;
  end // always @(posedge)
  wire [31:0] _GEN;
  assign _GEN = _RW0_ren_d0 & _RW0_rmode_d0 == 1'h0 ? Memory[_RW0_raddr_d0] : 32'bx;
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[0] & RW0_wmode)
      Memory[RW0_addr][32'h0 +: 8] <= RW0_wdata[7:0];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[1] & RW0_wmode)
      Memory[RW0_addr][32'h8 +: 8] <= RW0_wdata[15:8];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[2] & RW0_wmode)
      Memory[RW0_addr][32'h10 +: 8] <= RW0_wdata[23:16];
  end // always @(posedge)
  always @(posedge RW0_clk) begin
    if (RW0_en & RW0_wmask[3] & RW0_wmode)
      Memory[RW0_addr][32'h18 +: 8] <= RW0_wdata[31:24];
  end // always @(posedge)
  assign RW0_rdata = _GEN;
endmodule

module MaskedSyncMemoryExample(
  input         clock,
                reset,
  input  [1:0]  address,
  input         enable,
                write,
  input  [31:0] write_data,
  input  [3:0]  write_mask,
  output [31:0] read_data
);

  storage_4x32 storage_ext (
    .RW0_addr  (address),
    .RW0_en    (enable),
    .RW0_clk   (clock),
    .RW0_wmode (write),
    .RW0_wdata (write_data),
    .RW0_rdata (read_data),
    .RW0_wmask (write_mask)
  );
endmodule
}>>|

export:
  MaskedSyncMemoryExample
  design
  verilog_reference
