#lang rhodium
// Implements a one-bit full adder with nominal Boolean ports and combinational logic.
// SPDX-License-Identifier: Apache-2.0

circuit FullAdder():
  input(a, b, cin): Bool
  output(sum, cout): Bool

  def a_xor_b = a ^ b
  sum <== a_xor_b ^ cin

  def a_and_b = a & b
  def b_and_cin = b & cin
  def a_and_cin = a & cin
  cout <== a_and_b ||| b_and_cin ||| a_and_cin

def design = elaborate(FullAdder())

def verilog_reference = @str|<<{
module FullAdder(
  input  a,
         b,
         cin,
  output sum,
         cout
);

  assign sum = a ^ b ^ cin;
  assign cout = a & b | b & cin | a & cin;
endmodule
}>>|

export:
  FullAdder
  design
  verilog_reference
