#lang rhodium
// Demonstrates literal and runtime composition of nested tagged-union values.
// SPDX-License-Identifier: Apache-2.0

tagged_union InnerMessage:
  Empty
  Word(Bits(8))

tagged_union OuterMessage:
  Idle
  Nested(InnerMessage)

def nested_literal = OuterMessage.Nested(
  InnerMessage.Word(bits(0x3C, 8))
)

circuit NestedTaggedUnion():
  input message: OuterMessage
  input word: Bits(8)
  output nested_word_valid: Bits(1)
  output nested_word: Bits(8)
  output rebuilt: OuterMessage

  def outer = message.view(OuterMessage.Nested)
  def inner = outer.payload.view(InnerMessage.Word)
  nested_word_valid <== outer.valid & inner.valid
  nested_word <== inner.payload
  rebuilt <== OuterMessage.Nested(InnerMessage.Word(word))

def design = elaborate(NestedTaggedUnion())

def verilog_reference = @str|<<{
module NestedTaggedUnion(
  input  [9:0] message,
  input  [7:0] word,
  output       nested_word_valid,
  output [7:0] nested_word,
  output [9:0] rebuilt
);

  assign nested_word_valid = message[9] & message[8];
  assign nested_word = message[7:0];
  assign rebuilt = {2'h3, word};
endmodule
}>>|

export:
  InnerMessage
  OuterMessage
  nested_literal
  NestedTaggedUnion
  design
  verilog_reference
