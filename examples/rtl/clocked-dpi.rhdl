#lang rhodium
// Demonstrates explicit DPI procedure effects and result-bearing DPI register state.
// SPDX-License-Identifier: Apache-2.0

dpi_import procedure rhodium_trace(value: Bits(8))
dpi_import function rhodium_step(value: Bits(8)) -> result: Bits(8)
dpi_import function rhodium_step_pair(value: Bits(8)) -> (out doubled: Bits(8), return incremented: Bits(8))

sync_circuit ClockedDPI():
  input enable: Bool
  input value: Bits(8)
  output result: Bits(8)
  output doubled: Bits(8)

  rhodium_trace.call(value, ~enable: enable)
  dpi_reg (dpi_doubled, dpi_incremented) = rhodium_step_pair(value, ~enable: enable)
  result <== dpi_incremented
  doubled <== dpi_doubled

sync_circuit AlwaysClockedDPI():
  input value: Bits(8)
  output result: Bits(8)

  rhodium_trace.call(value)
  dpi_reg step_result = rhodium_step(value)
  result <== step_result

circuit ExplicitClockedDPI():
  input clock: Clock
  input enable: Bool
  input value: Bits(8)
  output result: Bits(8)

  rhodium_trace.call(value, ~clock: clock, ~enable: enable)
  dpi_reg step_result = rhodium_step(value, ~clock: clock, ~enable: enable)
  result <== step_result

def design = elaborate(ClockedDPI())
def always_design = elaborate(AlwaysClockedDPI())
def explicit_design = elaborate(ExplicitClockedDPI())

def verilog_reference = @str|<<{
`ifndef __CIRCT_DPI_IMPORT_RHODIUM_TRACE
  import "DPI-C" context function void rhodium_trace(
    input byte value
  );


  `define __CIRCT_DPI_IMPORT_RHODIUM_TRACE
`endif // not def __CIRCT_DPI_IMPORT_RHODIUM_TRACE
`ifndef __CIRCT_DPI_IMPORT_RHODIUM_STEP_PAIR
  import "DPI-C" context function byte rhodium_step_pair(
    input  byte value,
    output byte doubled
  );


  `define __CIRCT_DPI_IMPORT_RHODIUM_STEP_PAIR
`endif // not def __CIRCT_DPI_IMPORT_RHODIUM_STEP_PAIR
module ClockedDPI(
  input        clock,
               reset,
               enable,
  input  [7:0] value,
  output [7:0] result,
               doubled
);

  logic [7:0] _rhodium_step_pair_0;
  logic [7:0] _rhodium_step_pair_1;
  always @(posedge clock) begin
    if (enable)
      rhodium_trace(value);
  end // always @(posedge)
  reg   [7:0] _GEN;
  reg   [7:0] _GEN_0;
  always @(posedge clock) begin
    if (enable) begin
      _rhodium_step_pair_1 = rhodium_step_pair(value, _rhodium_step_pair_0);
      _GEN <= _rhodium_step_pair_0;
      _GEN_0 <= _rhodium_step_pair_1;
    end
  end // always @(posedge)
  assign result = _GEN_0;
  assign doubled = _GEN;
endmodule
}>>|

def always_verilog_reference = @str|<<{
`ifndef __CIRCT_DPI_IMPORT_RHODIUM_TRACE
  import "DPI-C" context function void rhodium_trace(
    input byte value
  );


  `define __CIRCT_DPI_IMPORT_RHODIUM_TRACE
`endif // not def __CIRCT_DPI_IMPORT_RHODIUM_TRACE
`ifndef __CIRCT_DPI_IMPORT_RHODIUM_STEP
  import "DPI-C" context function byte rhodium_step(
    input byte value
  );


  `define __CIRCT_DPI_IMPORT_RHODIUM_STEP
`endif // not def __CIRCT_DPI_IMPORT_RHODIUM_STEP
module AlwaysClockedDPI(
  input        clock,
               reset,
  input  [7:0] value,
  output [7:0] result
);

  logic [7:0] _rhodium_step_0;
  always @(posedge clock) begin
    if (1'h1)
      rhodium_trace(value);
  end // always @(posedge)
  reg   [7:0] _GEN;
  always @(posedge clock) begin
    if (1'h1) begin
      _rhodium_step_0 = rhodium_step(value);
      _GEN <= _rhodium_step_0;
    end
  end // always @(posedge)
  assign result = _GEN;
endmodule
}>>|
def explicit_verilog_reference = @str|<<{
`ifndef __CIRCT_DPI_IMPORT_RHODIUM_TRACE
  import "DPI-C" context function void rhodium_trace(
    input byte value
  );


  `define __CIRCT_DPI_IMPORT_RHODIUM_TRACE
`endif // not def __CIRCT_DPI_IMPORT_RHODIUM_TRACE
`ifndef __CIRCT_DPI_IMPORT_RHODIUM_STEP
  import "DPI-C" context function byte rhodium_step(
    input byte value
  );


  `define __CIRCT_DPI_IMPORT_RHODIUM_STEP
`endif // not def __CIRCT_DPI_IMPORT_RHODIUM_STEP
module ExplicitClockedDPI(
  input        clock,
               enable,
  input  [7:0] value,
  output [7:0] result
);

  logic [7:0] _rhodium_step_0;
  always @(posedge clock) begin
    if (enable)
      rhodium_trace(value);
  end // always @(posedge)
  reg   [7:0] _GEN;
  always @(posedge clock) begin
    if (enable) begin
      _rhodium_step_0 = rhodium_step(value);
      _GEN <= _rhodium_step_0;
    end
  end // always @(posedge)
  assign result = _GEN;
endmodule
}>>|

export:
  ClockedDPI
  AlwaysClockedDPI
  ExplicitClockedDPI
  design
  always_design
  explicit_design
  verilog_reference
  always_verilog_reference
  explicit_verilog_reference
