#lang rhodium
// Demonstrates a nominal one-hot enum selecting named datapath result families.
// SPDX-License-Identifier: Apache-2.0

hardware_enum ResultSelect(~encoding: one_hot):
  Arithmetic
  Shift
  Compare
  Xor
  Or
  And

circuit OneHotEnumSelect():
  input select: ResultSelect
  input arithmetic_result: Bits(8)
  input shift_result: Bits(8)
  input compare_result: Bits(8)
  input xor_result: Bits(8)
  input or_result: Bits(8)
  input and_result: Bits(8)
  output result: Bits(8)

  result <== select.mux({
    ResultSelect.Arithmetic: arithmetic_result,
    ResultSelect.Shift: shift_result,
    ResultSelect.Compare: compare_result,
    ResultSelect.Xor: xor_result,
    ResultSelect.Or: or_result,
    ResultSelect.And: and_result
  })

def design = elaborate(OneHotEnumSelect())

def verilog_reference = @str|<<{
module OneHotEnumSelect(
  input  [5:0] select,
  input  [7:0] arithmetic_result,
               shift_result,
               compare_result,
               xor_result,
               or_result,
               and_result,
  output [7:0] result
);

  assign result =
    arithmetic_result & {8{select[0]}} | shift_result & {8{select[1]}} | compare_result
    & {8{select[2]}} | xor_result & {8{select[3]}} | or_result & {8{select[4]}}
    | and_result & {8{select[5]}};
endmodule
}>>|

export:
  ResultSelect
  OneHotEnumSelect
  design
  verilog_reference
