#lang rhodium
// Demonstrates inferred register types, immediate next values, reset values, and direct next-state drives.
// SPDX-License-Identifier: Apache-2.0

sync_circuit RegisterForms():
  input data: Bits(8)
  input initial: Bits(8)
  output delayed: Bits(8)
  output reset_delayed: Bits(8)
  output explicit_delayed: Bits(8)

  reg inferred(~next: data)
  reg inferred_reset(~init: initial, ~next: data)
  reg explicit(Bits(8))
  explicit <== data

  delayed <== inferred
  reset_delayed <== inferred_reset
  explicit_delayed <== explicit

def design = elaborate(RegisterForms())

def verilog_reference = @str|<<{
module RegisterForms(
  input        clock,
               reset,
  input  [7:0] data,
               initial_0,
  output [7:0] delayed,
               reset_delayed,
               explicit_delayed
);

  reg [7:0] inferred;
  reg [7:0] inferred_reset;
  reg [7:0] explicit;
  always @(posedge clock) begin
    inferred <= data;
    explicit <= data;
  end // always @(posedge)
  always @(posedge clock) begin
    if (reset)
      inferred_reset <= initial_0;
    else
      inferred_reset <= data;
  end // always @(posedge)
  assign delayed = inferred;
  assign reset_delayed = inferred_reset;
  assign explicit_delayed = explicit;
endmodule
}>>|

export:
  RegisterForms
  design
  verilog_reference
