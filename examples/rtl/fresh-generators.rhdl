#lang rhodium
/* Shows repeated calls reusing one circuit specialization during elaboration. */
// SPDX-License-Identifier: Apache-2.0

/* Adds the two width-sized operands with fixed-width wraparound. */
circuit Adder(width :: PosInt):
  input(a, b): Bits(width)
  output sum: Bits(width)
  sum <== a + b

/* Reuses one specialization across two generator calls without instantiating it. */
circuit Top(width :: PosInt):
  for:
    each ignored in [0, 1]
    Adder(width)

def program = elaborate(Top(8))
// Inspect the source inventory, including specializations not instantiated by the top.
def design = program.design

def verilog_reference = @str|<<{
module Top();
endmodule
}>>|

export:
  program
  Adder
  Top
  design
  verilog_reference
