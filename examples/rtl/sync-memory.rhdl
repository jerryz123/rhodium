#lang rhodium
// Demonstrates a circuit-shaped synchronous memory with fixed read and write ports.
// SPDX-License-Identifier: Apache-2.0

sync_circuit SyncMemoryExample(depth :: PosInt, width :: PosInt):
  input read_address: Bits(index_width(depth))
  input read_enable: Bits(1)
  input write_address: Bits(index_width(depth))
  input write_data: Bits(width)
  input write_enable: Bits(1)
  output read_data: Bits(width)

  sync_mem storage(depth, Bits(width)):
    read
    write

  storage.read.address <== read_address
  storage.read.enable <== read_enable
  read_data <== storage.read.data

  storage.write.address <== write_address
  storage.write.data <== write_data
  storage.write.enable <== write_enable

def design = elaborate(SyncMemoryExample(4, 8))

def verilog_reference = @str|<<{
module storage_4x8(
  input  [1:0] R0_addr,
  input        R0_en,
               R0_clk,
  output [7:0] R0_data,
  input  [1:0] W0_addr,
  input        W0_en,
               W0_clk,
  input  [7:0] W0_data
);

  reg [7:0] Memory[0:3];
  reg       _R0_en_d0;
  reg [1:0] _R0_addr_d0;
  always @(posedge R0_clk) begin
    _R0_en_d0 <= R0_en;
    _R0_addr_d0 <= R0_addr;
  end // always @(posedge)
  always @(posedge W0_clk) begin
    if (W0_en)
      Memory[W0_addr] <= W0_data;
  end // always @(posedge)
  assign R0_data = _R0_en_d0 ? Memory[_R0_addr_d0] : 8'bx;
endmodule

module SyncMemoryExample(
  input        clock,
               reset,
  input  [1:0] read_address,
  input        read_enable,
  input  [1:0] write_address,
  input  [7:0] write_data,
  input        write_enable,
  output [7:0] read_data
);

  storage_4x8 storage_ext (
    .R0_addr (read_address),
    .R0_en   (read_enable),
    .R0_clk  (clock),
    .R0_data (read_data),
    .W0_addr (write_address),
    .W0_en   (write_enable),
    .W0_clk  (clock),
    .W0_data (write_data)
  );
endmodule
}>>|

export:
  SyncMemoryExample
  design
  verilog_reference
