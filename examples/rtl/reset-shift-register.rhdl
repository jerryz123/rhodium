#lang rhodium
// Mirrors a Chisel ResetShiftRegister with ambient reset registers and conditional shifting.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/shift-register.rhdl").shift_register

sync_circuit ResetShiftRegister():
  input data_in: Bits(4)
  input shift: Bool
  output data_out: Bits(4)

  shift_register stages(data_in, 4, ~init: bits(0, 4), ~enable: shift)
  data_out <== stages[3]

def design = elaborate(ResetShiftRegister())

def verilog_reference = @str|<<{
module ResetShiftRegister(
  input        clock,
               reset,
  input  [3:0] data_in,
  input        shift,
  output [3:0] data_out
);

  reg [3:0][3:0] stages;
  always @(posedge clock) begin
    if (reset)
      stages <= '{4'h0, 4'h0, 4'h0, 4'h0};
    else
      stages <=
        shift ? {{stages[2'h2]}, {stages[2'h1]}, {stages[2'h0]}, {data_in}} : stages;
  end // always @(posedge)
  assign data_out = stages[2'h3];
endmodule
}>>|

export:
  ResetShiftRegister
  design
  verilog_reference
