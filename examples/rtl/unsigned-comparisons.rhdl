#lang rhodium
/* Demonstrates unsigned fixed-width ordering with nominal Boolean results. */
// SPDX-License-Identifier: Apache-2.0


/* Demonstrates unsigned fixed-width ordering with nominal Boolean results. */
circuit UnsignedComparisons(width :: PosInt):
  input(a, b): Bits(width)
  output(lt, gt, le, ge): Bool

  lt <== (a < b)
  gt <== (a > b)
  le <== (a <= b)
  ge <== (a >= b)

def program = elaborate(UnsignedComparisons(8))

def verilog_reference = @str|<<{
module UnsignedComparisons(
  input  [7:0] a,
               b,
  output       lt,
               gt,
               le,
               ge
);

  assign lt = a < b;
  assign gt = b < a;
  assign le = b >= a;
  assign ge = a >= b;
endmodule
}>>|

export:
  UnsignedComparisons
  program
  verilog_reference
