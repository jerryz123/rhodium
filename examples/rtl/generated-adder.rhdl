#lang rhodium
// Builds an n-bit ripple-carry adder from a host Array of FullAdder instances.
// SPDX-License-Identifier: Apache-2.0

import:
  "full-adder.rhdl".FullAdder

circuit Adder(n :: PosInt):
  input(A, B): Bits(n)
  input Cin: Bits(1)
  output Sum: Bits(n)
  output Cout: Bits(1)

  def FullAdderModule = FullAdder()

  // FAs is an ordinary host Array used only while elaborating the circuit.
  def FAs = for InstanceArray (_ in 0..n): inst adder(FullAdderModule)

  // carry and sum are runtime hardware vectors with driveable elements.
  wire carry: Vec(n + 1, Bool)
  wire sum: Vec(n, Bool)

  carry[0] <== Cin.into(Bool)

  for (i in 0..n):
    FAs[i].a <== A[i].into(Bool)
    FAs[i].b <== B[i].into(Bool)
    FAs[i].cin <== carry[i]
    carry[i + 1] <== FAs[i].cout
    sum[i] <== FAs[i].sum

  Sum <== sum.as_bits()
  Cout <== carry[n].as_bits()

def design = elaborate(Adder(8))

def verilog_reference = @str|<<{
module Adder(
  input  [7:0] A,
               B,
  input        Cin,
  output [7:0] Sum,
  output       Cout
);

  wire [7:0] _GEN;
  wire       _adder_7_sum;
  wire       _adder_6_sum;
  wire       _adder_6_cout;
  wire       _adder_5_sum;
  wire       _adder_5_cout;
  wire       _adder_4_sum;
  wire       _adder_4_cout;
  wire       _adder_3_sum;
  wire       _adder_3_cout;
  wire       _adder_2_sum;
  wire       _adder_2_cout;
  wire       _adder_1_sum;
  wire       _adder_1_cout;
  wire       _adder_sum;
  wire       _adder_cout;
  assign _GEN =
    {{_adder_7_sum},
     {_adder_6_sum},
     {_adder_5_sum},
     {_adder_4_sum},
     {_adder_3_sum},
     {_adder_2_sum},
     {_adder_1_sum},
     {_adder_sum}};
  FullAdder adder (
    .a    (A[0]),
    .b    (B[0]),
    .cin  (Cin),
    .sum  (_adder_sum),
    .cout (_adder_cout)
  );
  FullAdder adder_1 (
    .a    (A[1]),
    .b    (B[1]),
    .cin  (_adder_cout),
    .sum  (_adder_1_sum),
    .cout (_adder_1_cout)
  );
  FullAdder adder_2 (
    .a    (A[2]),
    .b    (B[2]),
    .cin  (_adder_1_cout),
    .sum  (_adder_2_sum),
    .cout (_adder_2_cout)
  );
  FullAdder adder_3 (
    .a    (A[3]),
    .b    (B[3]),
    .cin  (_adder_2_cout),
    .sum  (_adder_3_sum),
    .cout (_adder_3_cout)
  );
  FullAdder adder_4 (
    .a    (A[4]),
    .b    (B[4]),
    .cin  (_adder_3_cout),
    .sum  (_adder_4_sum),
    .cout (_adder_4_cout)
  );
  FullAdder adder_5 (
    .a    (A[5]),
    .b    (B[5]),
    .cin  (_adder_4_cout),
    .sum  (_adder_5_sum),
    .cout (_adder_5_cout)
  );
  FullAdder adder_6 (
    .a    (A[6]),
    .b    (B[6]),
    .cin  (_adder_5_cout),
    .sum  (_adder_6_sum),
    .cout (_adder_6_cout)
  );
  FullAdder adder_7 (
    .a    (A[7]),
    .b    (B[7]),
    .cin  (_adder_6_cout),
    .sum  (_adder_7_sum),
    .cout (Cout)
  );
  assign Sum = _GEN;
endmodule

module FullAdder(
  input  a,
         b,
         cin,
  output sum,
         cout
);

  assign sum = a ^ b ^ cin;
  assign cout = a & b | b & cin | a & cin;
endmodule
}>>|

export:
  Adder
  design
  verilog_reference
