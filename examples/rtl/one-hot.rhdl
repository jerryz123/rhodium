#lang rhodium
// Demonstrates typed one-hot selection, equality, and representation casts.
// SPDX-License-Identifier: Apache-2.0

def Grant = OneHot(4)

circuit OneHotRotate():
  input current: Grant
  output next_grant: Grant
  output current_bits: Bits(4)
  output is_last: Bool

  next_grant <== current.mux([
    Grant(1),
    Grant(2),
    Grant(3),
    Grant(0)
  ])
  current_bits <== current.as_bits()
  is_last <== current === Grant(3)

def design = elaborate(OneHotRotate())

def verilog_reference = @str|<<{
module OneHotRotate(
  input  [3:0] current,
  output [3:0] next_grant,
               current_bits,
  output       is_last
);

  assign next_grant =
    {2'h0, current[0], 1'h0} | {1'h0, current[1], 2'h0} | {current[2], 3'h0}
    | {3'h0, current[3]};
  assign current_bits = current;
  assign is_last = current == 4'h8;
endmodule
}>>|

export:
  Grant
  OneHotRotate
  design
  verilog_reference
