#lang rhodium
// Demonstrates positional, keyword, typed, defaulted, and synchronous generator parameters.
// SPDX-License-Identifier: Apache-2.0

circuit OrdinaryDefaults(width :: PosInt = 4 + 4,
                         ~extra: extra :: PosInt = 2 - 1):
  output result: Bits(width + extra)
  result <== bits(0, width + extra)

circuit OrdinaryTypedDefaults(width :: PosInt = 3 * 2,
                              ~extra: extra :: Nat = 1 + 1):
  output result: Bits(width + extra)
  result <== bits(0, width + extra)

circuit OrdinaryRequiredKeyword(~width: width :: PosInt):
  output result: Bits(width)
  result <== bits(0, width)

sync_circuit SyncDefaults(width :: PosInt = 2 + 3,
                          ~extra: extra :: PosInt = 1 + 1):
  output result: Bits(width + extra)
  result <== bits(0, width + extra)

sync_circuit SyncTypedDefaults(width :: PosInt = 2 * 2,
                               ~extra: extra :: Nat = 1 + 2):
  output result: Bits(width + extra)
  result <== bits(0, width + extra)

def ordinary_defaults_design = elaborate(OrdinaryDefaults())
def ordinary_overrides_design = elaborate(OrdinaryDefaults(3, ~extra: 4))
def ordinary_typed_defaults_design = elaborate(OrdinaryTypedDefaults())
def ordinary_required_keyword_design = elaborate(OrdinaryRequiredKeyword(~width: 9))
def sync_defaults_design = elaborate(SyncDefaults())
def sync_overrides_design = elaborate(SyncDefaults(6, ~extra: 2))
def sync_typed_defaults_design = elaborate(SyncTypedDefaults())

def ordinary_defaults_verilog_reference = @str|<<{
module OrdinaryDefaults(
  output [8:0] result
);

  assign result = 9'h0;
endmodule
}>>|
def ordinary_overrides_verilog_reference = @str|<<{
module OrdinaryDefaults(
  output [6:0] result
);

  assign result = 7'h0;
endmodule
}>>|
def ordinary_typed_defaults_verilog_reference = @str|<<{
module OrdinaryTypedDefaults(
  output [7:0] result
);

  assign result = 8'h0;
endmodule
}>>|
def ordinary_required_keyword_verilog_reference = @str|<<{
module OrdinaryRequiredKeyword(
  output [8:0] result
);

  assign result = 9'h0;
endmodule
}>>|
def sync_defaults_verilog_reference = @str|<<{
module SyncDefaults(
  input        clock,
               reset,
  output [6:0] result
);

  assign result = 7'h0;
endmodule
}>>|
def sync_overrides_verilog_reference = @str|<<{
module SyncDefaults(
  input        clock,
               reset,
  output [7:0] result
);

  assign result = 8'h0;
endmodule
}>>|
def sync_typed_defaults_verilog_reference = @str|<<{
module SyncTypedDefaults(
  input        clock,
               reset,
  output [6:0] result
);

  assign result = 7'h0;
endmodule
}>>|

export:
  OrdinaryDefaults
  OrdinaryTypedDefaults
  OrdinaryRequiredKeyword
  SyncDefaults
  SyncTypedDefaults
  ordinary_defaults_design
  ordinary_overrides_design
  ordinary_typed_defaults_design
  ordinary_required_keyword_design
  sync_defaults_design
  sync_overrides_design
  sync_typed_defaults_design
  ordinary_defaults_verilog_reference
  ordinary_overrides_verilog_reference
  ordinary_typed_defaults_verilog_reference
  ordinary_required_keyword_verilog_reference
  sync_defaults_verilog_reference
  sync_overrides_verilog_reference
  sync_typed_defaults_verilog_reference
