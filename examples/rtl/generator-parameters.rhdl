#lang rhodium
/* Demonstrates positional, keyword, typed, defaulted, and synchronous generator parameters. */
// SPDX-License-Identifier: Apache-2.0


/* Demonstrates host-evaluated positional and keyword defaults in a circuit generator. */
circuit OrdinaryDefaults(width :: PosInt = 4 + 4,
                         ~extra: extra :: PosInt = 2 - 1):
  output result: Bits(width + extra)
  result <== bits(0, width + extra)

/* Applies typed default generator arguments before constructing ports. */
circuit OrdinaryTypedDefaults(width :: PosInt = 3 * 2,
                              ~extra: extra :: Nat = 1 + 1):
  output result: Bits(width + extra)
  result <== bits(0, width + extra)

/* Builds ports from a required keyword width argument. */
circuit OrdinaryRequiredKeyword(~width: width :: PosInt):
  output result: Bits(width)
  result <== bits(0, width)

/* Applies host-evaluated defaults while constructing a synchronous circuit. */
sync_circuit SyncDefaults(width :: PosInt = 2 + 3,
                          ~extra: extra :: PosInt = 1 + 1):
  output result: Bits(width + extra)
  result <== bits(0, width + extra)

/* Validates typed generator defaults in the ambient synchronous domain. */
sync_circuit SyncTypedDefaults(width :: PosInt = 2 * 2,
                               ~extra: extra :: Nat = 1 + 2):
  output result: Bits(width + extra)
  result <== bits(0, width + extra)

def ordinary_defaults_program = elaborate(OrdinaryDefaults())
def ordinary_overrides_program = elaborate(OrdinaryDefaults(3, ~extra: 4))
def ordinary_typed_defaults_program = elaborate(OrdinaryTypedDefaults())
def ordinary_required_keyword_program = elaborate(OrdinaryRequiredKeyword(~width: 9))
def sync_defaults_program = elaborate(SyncDefaults())
def sync_overrides_program = elaborate(SyncDefaults(6, ~extra: 2))
def sync_typed_defaults_program = elaborate(SyncTypedDefaults())

def ordinary_defaults_verilog_reference = @str|<<{
module OrdinaryDefaults(
  output [8:0] result
);

  assign result = 9'h0;
endmodule
}>>|
def ordinary_overrides_verilog_reference = @str|<<{
module OrdinaryDefaults(
  output [6:0] result
);

  assign result = 7'h0;
endmodule
}>>|
def ordinary_typed_defaults_verilog_reference = @str|<<{
module OrdinaryTypedDefaults(
  output [7:0] result
);

  assign result = 8'h0;
endmodule
}>>|
def ordinary_required_keyword_verilog_reference = @str|<<{
module OrdinaryRequiredKeyword(
  output [8:0] result
);

  assign result = 9'h0;
endmodule
}>>|
def sync_defaults_verilog_reference = @str|<<{
module SyncDefaults(
  input        clock,
               reset,
  output [6:0] result
);

  assign result = 7'h0;
endmodule
}>>|
def sync_overrides_verilog_reference = @str|<<{
module SyncDefaults(
  input        clock,
               reset,
  output [7:0] result
);

  assign result = 8'h0;
endmodule
}>>|
def sync_typed_defaults_verilog_reference = @str|<<{
module SyncTypedDefaults(
  input        clock,
               reset,
  output [6:0] result
);

  assign result = 7'h0;
endmodule
}>>|

export:
  OrdinaryDefaults
  OrdinaryTypedDefaults
  OrdinaryRequiredKeyword
  SyncDefaults
  SyncTypedDefaults
  ordinary_defaults_program
  ordinary_overrides_program
  ordinary_typed_defaults_program
  ordinary_required_keyword_program
  sync_defaults_program
  sync_overrides_program
  sync_typed_defaults_program
  ordinary_defaults_verilog_reference
  ordinary_overrides_verilog_reference
  ordinary_typed_defaults_verilog_reference
  ordinary_required_keyword_verilog_reference
  sync_defaults_verilog_reference
  sync_overrides_verilog_reference
  sync_typed_defaults_verilog_reference
