#lang rhodium/base
// Demonstrates typed transforms over custom bidirectional interfaces without flow libraries.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/frontend/layers/interface.rhm") open

use_static

interface CommandChannel():
  role producer
  role consumer
  provider producer

  producer -> consumer:
    command: Bits(8)

  consumer -> producer:
    accepted: Bits(1)

interface RenamedChannel():
  role producer
  role consumer
  provider producer

  producer -> consumer:
    payload: Bits(8)

  consumer -> producer:
    ready: Bits(1)

interface EventChannel():
  role producer
  role consumer
  provider producer

  producer -> consumer:
    payload: Bits(8)

fun rename_channel()
  :: ((source :: Any) -> InterfaceTransformResult(source, Endpoint)):
  fun (source) :~ InterfaceTransformResult(source, Endpoint):
    def input_link :: Handle = interface_link(CommandChannel(), "rename_input")
    def output_link :: Handle = interface_link(RenamedChannel(), "rename_output")
    input_link.right.accepted <== output_link.left.ready
    output_link.left.payload <== input_link.right.command
    finish_interface_transform(
      source,
      interface_transform(input_link, output_link)
    )

fun duplicate_event(outputs :: PosInt)
  :: ((source :: Any) -> InterfaceTransformResult(source, InterfaceArrayFields)):
  fun (source) :~ InterfaceTransformResult(source, InterfaceArrayFields):
    def input_link :: Handle = interface_link(EventChannel(), "event_input")
    def output_links = for Array (index in 0..outputs):
      interface_link(EventChannel(), "event_output_" ++ to_string(index))
    for (index in 0..output_links.length()):
      def output_link :: Handle = output_links[index]
      output_link.left.payload <== input_link.right.payload
    finish_interface_transform(
      source,
      interface_transform(input_link, output_links)
    )

circuit CustomInterfaceTransforms():
  interface commands(CommandChannel(), ~role: consumer)
  interface renamed(RenamedChannel(), ~role: producer)
  interface event(EventChannel(), ~role: consumer)
  interface copies[2](EventChannel(), ~role: producer)

  def renamed_command = commands |> rename_channel()
  def renamed_payload = renamed_command.payload
  renamed_command |> renamed

  def duplicated = event |> duplicate_event(2)
  def first_copy = duplicated[0].payload
  copies <=> duplicated

  #void

circuit DetachedInterfaceTerminal():
  interface commands(CommandChannel(), ~role: consumer)
  interface renamed(RenamedChannel(), ~role: producer)

  def rename_sink = CommandChannel() |> rename_channel() |> renamed
  commands |> rename_sink

  #void

circuit CustomInterfaceBoundary():
  input command: Bits(8)
  input ready: Bits(1)
  output accepted: Bits(1)
  output payload: Bits(8)

  inject_interface(
    CommandChannel(),
    ~command: command,
    ~accepted: accepted
  ) |> rename_channel()
    |> eject_interface(~payload: payload, ~ready: ready)

def design = elaborate(CustomInterfaceTransforms())
def boundary_design = elaborate(CustomInterfaceBoundary())
def detached_terminal_design = elaborate(DetachedInterfaceTerminal())

def verilog_reference = @str|<<{
module CustomInterfaceTransforms(
  input  struct packed {logic [7:0] command; } commands_in,
  input  struct packed {logic ready; }         renamed_in,
  input  struct packed {logic [7:0] payload; } event_in,
  output struct packed {logic accepted; }      commands_out,
  output struct packed {logic [7:0] payload; } renamed_out,
                                               copies_0_out,
                                               copies_1_out
);

  assign commands_out = '{accepted: renamed_in.ready};
  assign renamed_out = '{payload: commands_in.command};
  assign copies_0_out = event_in;
  assign copies_1_out = event_in;
endmodule
}>>|

def boundary_verilog_reference = @str|<<{
module CustomInterfaceBoundary(
  input  [7:0] command,
  input        ready,
  output       accepted,
  output [7:0] payload
);

  assign accepted = ready;
  assign payload = command;
endmodule
}>>|

def detached_terminal_verilog_reference = @str|<<{
module DetachedInterfaceTerminal(
  input  struct packed {logic [7:0] command; } commands_in,
  input  struct packed {logic ready; }         renamed_in,
  output struct packed {logic accepted; }      commands_out,
  output struct packed {logic [7:0] payload; } renamed_out
);

  assign commands_out = '{accepted: renamed_in.ready};
  assign renamed_out = '{payload: commands_in.command};
endmodule
}>>|

export:
  CommandChannel
  RenamedChannel
  EventChannel
  rename_channel
  duplicate_event
  CustomInterfaceTransforms
  CustomInterfaceBoundary
  DetachedInterfaceTerminal
  design
  boundary_design
  detached_terminal_design
  verilog_reference
  boundary_verilog_reference
  detached_terminal_verilog_reference
