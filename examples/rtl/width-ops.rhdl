#lang rhodium
// Showcases concise width-changing operations over explicit kernel/core semantics.
// SPDX-License-Identifier: Apache-2.0

circuit WidthOps8():
  input a: Bits(8)
  input b: Bits(4)
  output joined: Bits(12)
  output(middle, narrowed): Bits(4)
  output widened: Bits(12)

  joined <== a ++ b
  middle <== a[2..6]
  widened <== a.zext(12)
  narrowed <== trunc(a, 4)

def design = elaborate(WidthOps8())

def verilog_reference = @str|<<{
module WidthOps8(
  input  [7:0]  a,
  input  [3:0]  b,
  output [11:0] joined,
  output [3:0]  middle,
                narrowed,
  output [11:0] widened
);

  assign joined = {a, b};
  assign middle = a[5:2];
  assign narrowed = a[3:0];
  assign widened = {4'h0, a};
endmodule
}>>|

export:
  WidthOps8
  design
  verilog_reference
