#lang rhodium
/* Showcases an imported hardware library and recursive host-generated structure. */
// SPDX-License-Identifier: Apache-2.0

import:
  "add-pair.rhm" open

/* Builds the requested number of add stages during host elaboration. */
circuit LayeredAdder(width :: PosInt, stages :: Nat):
  input(a, b): Bits(width)
  input bypass: Bool
  output sum: Bits(width)

  /* Recursively constructs the remaining fixed-width add stages. */
  fun add_stages(remaining :: Nat, value :: Bits(width)):
    if (remaining == 0)
    | value
    | add_stages(remaining - 1, add_pair(value, b))

  def staged_sum = add_stages(stages, a)
  sum <== mux(bypass, a, staged_sum)

def program = elaborate(LayeredAdder(8, 3))

def verilog_reference = @str|<<{
module LayeredAdder(
  input  [7:0] a,
               b,
  input        bypass,
  output [7:0] sum
);

  assign sum = bypass ? a : a + b * 8'h3;
endmodule
}>>|

export:
  LayeredAdder
  program
  verilog_reference
