#lang rhodium
// Builds a host-parameterized, zero-initialized vector shift register.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/shift-register.rhdl").shift_register

sync_circuit VecShiftRegisterParam(n :: PosInt, w :: PosInt):
  input data_in: Bits(w)
  output data_out: Bits(w)

  shift_register delays(data_in, n, ~init: bits(0, w))
  data_out <== delays[n - 1]

def design = elaborate(VecShiftRegisterParam(4, 4))

def verilog_reference = @str|<<{
module VecShiftRegisterParam(
  input        clock,
               reset,
  input  [3:0] data_in,
  output [3:0] data_out
);

  reg [3:0][3:0] delays;
  always @(posedge clock) begin
    if (reset)
      delays <= '{4'h0, 4'h0, 4'h0, 4'h0};
    else begin
      delays[2'h3] <= delays[2'h2];
      delays[2'h2] <= delays[2'h1];
      delays[2'h1] <= delays[2'h0];
      delays[2'h0] <= data_in;
    end
  end // always @(posedge)
  assign data_out = delays[2'h3];
endmodule
}>>|

export:
  VecShiftRegisterParam
  design
  verilog_reference
