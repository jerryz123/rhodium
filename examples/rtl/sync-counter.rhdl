#lang rhodium
/* Demonstrates sync circuits, ambient registers, and nested clock/reset propagation. */
// SPDX-License-Identifier: Apache-2.0


/* Updates the count under the declared increment and reset controls. */
sync_circuit Counter(width :: PosInt):
  output count: Bits(width)

  reg state(Bits(width), ~init: bits(0, width))
  state <== state + bits(1, width)
  count <== state

/* Instantiates a counter under the enclosing synchronous domain. */
sync_circuit CounterTop(width :: PosInt):
  output count: Bits(width)

  def CounterModule = Counter(width)
  inst counter(CounterModule)
  count <== counter.count

/* Increments state in the ambient clock domain without a reset value. */
sync_circuit ResetlessCounter(width :: PosInt):
  output count: Bits(width)

  reg state(Bits(width))
  state <== state + bits(1, width)
  count <== state

/* An ordinary parent can supply a sync child's domain explicitly. */
circuit ExplicitClockTop(width :: PosInt):
  input source_clock: Clock
  input source_reset: Reset
  output count: Bits(width)

  def CounterModule = Counter(width)
  inst counter(CounterModule,
               ~clock: source_clock,
               ~reset: source_reset)
  count <== counter.count

def program = elaborate(CounterTop(8))
def resetless_program = elaborate(ResetlessCounter(8))
def explicit_clock_program = elaborate(ExplicitClockTop(8))

def verilog_reference = @str|<<{
module CounterTop(
  input        clock,
               reset,
  output [7:0] count
);

  Counter counter (
    .clock (clock),
    .reset (reset),
    .count (count)
  );
endmodule

module Counter(
  input        clock,
               reset,
  output [7:0] count
);

  reg [7:0] state;
  always @(posedge clock) begin
    if (reset)
      state <= 8'h0;
    else
      state <= state + 8'h1;
  end // always @(posedge)
  assign count = state;
endmodule
}>>|

def resetless_verilog_reference = @str|<<{
module ResetlessCounter(
  input        clock,
               reset,
  output [7:0] count
);

  reg [7:0] state;
  always @(posedge clock)
    state <= state + 8'h1;
  assign count = state;
endmodule
}>>|
def explicit_clock_verilog_reference = @str|<<{
module ExplicitClockTop(
  input        source_clock,
               source_reset,
  output [7:0] count
);

  Counter counter (
    .clock (source_clock),
    .reset (source_reset),
    .count (count)
  );
endmodule

module Counter(
  input        clock,
               reset,
  output [7:0] count
);

  reg [7:0] state;
  always @(posedge clock) begin
    if (reset)
      state <= 8'h0;
    else
      state <= state + 8'h1;
  end // always @(posedge)
  assign count = state;
endmodule
}>>|

export:
  Counter
  CounterTop
  ResetlessCounter
  ExplicitClockTop
  program
  resetless_program
  explicit_clock_program
  verilog_reference
  resetless_verilog_reference
  explicit_clock_verilog_reference
