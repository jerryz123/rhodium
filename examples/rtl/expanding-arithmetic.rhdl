#lang rhodium
// Demonstrates lossless unsigned addition and signed and unsigned multiplication.
// SPDX-License-Identifier: Apache-2.0

circuit ExpandingArithmetic():
  input a: Bits(8)
  input b: Bits(4)
  input signed_a: SInt(8)
  input signed_b: SInt(4)
  output sum: Bits(9)
  output product: Bits(12)
  output signed_product: SInt(12)

  sum <== a +& b
  product <== a *& b
  signed_product <== signed_a *& signed_b

def design = elaborate(ExpandingArithmetic())

def verilog_reference = @str|<<{
module ExpandingArithmetic(
  input  [7:0]  a,
  input  [3:0]  b,
  input  [7:0]  signed_a,
  input  [3:0]  signed_b,
  output [8:0]  sum,
  output [11:0] product,
                signed_product
);

  assign sum = {1'h0, a} + {5'h0, b};
  assign product = {4'h0, a} * {8'h0, b};
  assign signed_product = {{4{signed_a[7]}}, signed_a} * {{8{signed_b[3]}}, signed_b};
endmodule
}>>|

export:
  ExpandingArithmetic
  design
  verilog_reference
