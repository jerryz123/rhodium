#lang rhodium
// Showcases binding-derived instances and dot access to elaborated child ports.
// SPDX-License-Identifier: Apache-2.0

circuit Adder(width :: PosInt):
  input(a, b): Bits(width)
  output sum: Bits(width)
  sum <== a + b

circuit TwoAdders():
  input(a, b, c): Bits(8)
  output(sum0, sum1): Bits(8)

  def AdderModule = Adder(8)
  inst u0(AdderModule)
  inst u1(AdderModule)
  u0.a <== a
  u0.b <== b
  u1.a <== a
  u1.b <== c
  sum0 <== u0.sum
  sum1 <== u1.sum

def design = elaborate(TwoAdders())

def verilog_reference = @str|<<{
module TwoAdders(
  input  [7:0] a,
               b,
               c,
  output [7:0] sum0,
               sum1
);

  Adder u0 (
    .a   (a),
    .b   (b),
    .sum (sum0)
  );
  Adder u1 (
    .a   (a),
    .b   (c),
    .sum (sum1)
  );
endmodule

module Adder(
  input  [7:0] a,
               b,
  output [7:0] sum
);

  assign sum = a + b;
endmodule
}>>|

export:
  Adder
  TwoAdders
  design
  verilog_reference
