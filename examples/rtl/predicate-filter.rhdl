#lang rhodium
// Elaborates stable host predicate policies inline through a Valid interface.
// SPDX-License-Identifier: Apache-2.0

import:
  rhombus/meta open
  lib("rhodium/std/ready-valid.rhdl") open

class SingleDigitPolicy(T :: DataType):
  implements StableCircuitParam

  override method same_stable_circuit_param(other :: StableCircuitParam):
    other is_a SingleDigitPolicy && T.type_equal(other.T) && other.T.type_equal(T)

  method apply(value :: Hardware.of(T)) :: Bool:
    value <= bits(9, T.width)

class LowBitSetPolicy(T :: DataType):
  implements StableCircuitParam

  override method same_stable_circuit_param(other :: StableCircuitParam):
    other is_a LowBitSetPolicy && T.type_equal(other.T) && other.T.type_equal(T)

  method apply(value :: Hardware.of(T)) :: Bool:
    value[0].into(Bool)

annot.macro 'PredicatePolicy':
  'SingleDigitPolicy || LowBitSetPolicy'

circuit SingleEvenFilter(T :: DataType,
                         first :: PredicatePolicy,
                         second :: PredicatePolicy):
  interface ingress(Valid(T), ~role: consumer)
  interface egress(Valid(T), ~role: producer)

  egress.valid <== ingress.valid & first.apply(ingress.bits) & second.apply(ingress.bits)
  egress.bits <== ingress.bits

def design = elaborate(
  SingleEvenFilter(Bits(8), SingleDigitPolicy(Bits(8)), LowBitSetPolicy(Bits(8)))
)

def verilog_reference = @str|<<{
module SingleEvenFilter(
  input  struct packed {logic valid; logic [7:0] bits; } ingress_in,
  output struct packed {logic valid; logic [7:0] bits; } egress_out
);

  assign egress_out =
    '{valid: (ingress_in.valid & ingress_in.bits < 8'hA & ingress_in.bits[0]),
      bits: ingress_in.bits};
endmodule
}>>|

export:
  SingleDigitPolicy
  LowBitSetPolicy
  SingleEvenFilter
  design
  verilog_reference
