#lang rhodium
// Builds a host-specialized SIMD microengine with typed instructions and generated lanes.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/bits.rhdl").Pow2Int

class EngineConfig(lanes :: PosInt,
                   width :: PosInt,
                   program_depth :: Pow2Int,
                   enable_multiply :: Boolean):
  implements StableCircuitParam

  constructor (lanes :: PosInt,
               width :: PosInt,
               program_depth :: Pow2Int,
               enable_multiply :: Boolean):
    unless program_depth > 1
    | error(~who: #'EngineConfig, "program depth must be at least two")
    super(lanes, width, program_depth, enable_multiply)

hardware_enum Opcode(~width: 4):
  Load = 0
  Add = 1
  Xor = 2
  ShiftLeft = 3
  Multiply = 8

bundle Instruction(T :: DataType):
  opcode: Opcode
  operand: T

interface ProgramLoader(Address :: DataType, Data :: DataType):
  role host
  role engine
  provider host

  host -> engine:
    address: Address
    data: Data
    write: Bool

  engine -> host:
    ready: Bool

sync_circuit Lane(width :: PosInt, enable_multiply :: Boolean):

  input load_seed: Bool
  input step: Bool
  input seed: Bits(width)
  input instruction: Instruction(Bits(width))
  output result: Bits(width)

  reg accumulator(~init: bits(0, width))

  // The host condition removes the case and multiplier during elaboration.
  // Lane results stay modular: expanding operators preserve overflow, then a
  // low-bit slice states which result bits the lane retains.
  def alu_cases = [
    [Opcode.Load, instruction.operand],
    [Opcode.Add, (accumulator +& instruction.operand)[0..width]],
    [Opcode.Xor, accumulator ^ instruction.operand],
    [Opcode.ShiftLeft, accumulator << instruction.operand]
  ] ++ (if enable_multiply
        | [[Opcode.Multiply, (accumulator *& instruction.operand)[0..width]]]
        | [])

  // This remains a hardware decision. The selected case changes every cycle.
  def alu_result = mux_lookup(
    instruction.opcode,
    ~default: accumulator,
    alu_cases
  )

  when load_seed:
    accumulator <== seed
  elsewhen step:
    accumulator <== alu_result

  result <== accumulator

sync_circuit TinySIMD(config :: EngineConfig):
  def address_width = index_width(config.program_depth)
  def instruction_width = config.width + enum_width(Opcode)
  def InstructionType = Instruction(Bits(config.width))

  input load_seed: Bool
  input step: Bool
  input seeds: Vec(config.lanes, Bits(config.width))
  output results: Vec(config.lanes, Bits(config.width))
  output pc_out: Bits(address_width)
  interface loader(
    ProgramLoader(Bits(address_width), Bits(instruction_width)),
    ~role: engine
  )

  // Program words stay packed in memory and become structured instructions
  // through an explicit equal-width representation cast at the read boundary.
  mem program(config.program_depth, Bits(instruction_width))
  reg pc(~init: bits(0, address_width))
  def instruction = program[pc].into(InstructionType)

  program.write(loader.address, loader.data, ~enable: loader.write)
  loader.ready <== Bool(#true)

  when step:
    // Power-of-two depth lets fixed-width overflow wrap directly to address 0.
    pc <== pc + bits(1, address_width)

  // One host comprehension elaborates, wires, and collects the physical lanes.
  // Its List exists only during elaboration; vec packs the returned hardware
  // results directly into the runtime output vector.
  def LaneModule = Lane(config.width, config.enable_multiply)
  def lane_results = for List (i in 0..config.lanes):
    inst lane(LaneModule)
    lane.load_seed <== load_seed
    lane.step <== step
    lane.seed <== seeds[i]
    lane.instruction <== instruction
    lane.result

  results <== vec(lane_results)
  pc_out <== pc

def showcase_config = EngineConfig(2, 8, 4, #true)
def design = elaborate(TinySIMD(showcase_config))
def no_multiply_design = elaborate(TinySIMD(EngineConfig(2, 8, 4, #false)))

def verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhodium_types
`define _TYPESCOPE_rhodium_types
  typedef struct packed {logic [3:0] opcode; logic [7:0] operand; } Instruction;
`endif // _TYPESCOPE_rhodium_types
module TinySIMD(
  input                                                                        clock,
                                                                               reset,
                                                                               load_seed,
                                                                               step,
  input  [1:0][7:0]                                                            seeds,
  input  struct packed {logic [1:0] address; logic [11:0] data; logic write; } loader_in,
  output [1:0][7:0]                                                            results,
  output [1:0]                                                                 pc_out,
  output struct packed {logic ready; }                                         loader_out
);

  wire             _GEN;
  wire [11:0]      _GEN_0;
  wire [1:0]       _GEN_1;
  wire [7:0]       _lane_1_result;
  wire [7:0]       _lane_result;
  wire             _GEN_2 = 1'h0;
  reg  [11:0]      program_0[0:3];
  always_ff @(posedge clock) begin
    if (_GEN_2) begin
    end
    else begin
      if (_GEN)
        program_0[_GEN_1] <= _GEN_0;
    end
  end // always_ff @(posedge)
  reg  [1:0]       pc;
  wire Instruction _GEN_3 = /*cast(bit)*/program_0[pc];
  assign _GEN_1 = loader_in.address;
  assign _GEN_0 = loader_in.data;
  assign _GEN = loader_in.write;
  Lane lane (
    .clock       (clock),
    .reset       (reset),
    .load_seed   (load_seed),
    .step        (step),
    .seed        (seeds[_GEN_2]),
    .instruction (_GEN_3),
    .result      (_lane_result)
  );
  Lane lane_1 (
    .clock       (clock),
    .reset       (reset),
    .load_seed   (load_seed),
    .step        (step),
    .seed        (seeds[1'h1]),
    .instruction (_GEN_3),
    .result      (_lane_1_result)
  );
  always @(posedge clock) begin
    if (reset)
      pc <= 2'h0;
    else
      pc <= step ? pc + 2'h1 : pc;
  end // always @(posedge)
  assign results = {{_lane_1_result}, {_lane_result}};
  assign pc_out = pc;
  assign loader_out = '{ready: 1'h1};
endmodule

module Lane(
  input              clock,
                     reset,
                     load_seed,
                     step,
  input  [7:0]       seed,
  input  Instruction instruction,
  output [7:0]       result
);

  reg [7:0] accumulator;
  always @(posedge clock) begin
    if (reset)
      accumulator <= 8'h0;
    else
      accumulator <=
        load_seed
          ? seed
          : step
              ? (instruction.opcode == 4'h0
                   ? instruction.operand
                   : instruction.opcode == 4'h1
                       ? accumulator + instruction.operand
                       : instruction.opcode == 4'h2
                           ? accumulator ^ instruction.operand
                           : instruction.opcode == 4'h3
                               ? accumulator << instruction.operand
                               : instruction.opcode == 4'h8
                                   ? accumulator * instruction.operand
                                   : accumulator)
              : accumulator;
  end // always @(posedge)
  assign result = accumulator;
endmodule
}>>|

def no_multiply_verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhodium_types
`define _TYPESCOPE_rhodium_types
  typedef struct packed {logic [3:0] opcode; logic [7:0] operand; } Instruction;
`endif // _TYPESCOPE_rhodium_types
module TinySIMD(
  input                                                                        clock,
                                                                               reset,
                                                                               load_seed,
                                                                               step,
  input  [1:0][7:0]                                                            seeds,
  input  struct packed {logic [1:0] address; logic [11:0] data; logic write; } loader_in,
  output [1:0][7:0]                                                            results,
  output [1:0]                                                                 pc_out,
  output struct packed {logic ready; }                                         loader_out
);

  wire             _GEN;
  wire [11:0]      _GEN_0;
  wire [1:0]       _GEN_1;
  wire [7:0]       _lane_1_result;
  wire [7:0]       _lane_result;
  wire             _GEN_2 = 1'h0;
  reg  [11:0]      program_0[0:3];
  always_ff @(posedge clock) begin
    if (_GEN_2) begin
    end
    else begin
      if (_GEN)
        program_0[_GEN_1] <= _GEN_0;
    end
  end // always_ff @(posedge)
  reg  [1:0]       pc;
  wire Instruction _GEN_3 = /*cast(bit)*/program_0[pc];
  assign _GEN_1 = loader_in.address;
  assign _GEN_0 = loader_in.data;
  assign _GEN = loader_in.write;
  Lane lane (
    .clock       (clock),
    .reset       (reset),
    .load_seed   (load_seed),
    .step        (step),
    .seed        (seeds[_GEN_2]),
    .instruction (_GEN_3),
    .result      (_lane_result)
  );
  Lane lane_1 (
    .clock       (clock),
    .reset       (reset),
    .load_seed   (load_seed),
    .step        (step),
    .seed        (seeds[1'h1]),
    .instruction (_GEN_3),
    .result      (_lane_1_result)
  );
  always @(posedge clock) begin
    if (reset)
      pc <= 2'h0;
    else
      pc <= step ? pc + 2'h1 : pc;
  end // always @(posedge)
  assign results = {{_lane_1_result}, {_lane_result}};
  assign pc_out = pc;
  assign loader_out = '{ready: 1'h1};
endmodule

module Lane(
  input              clock,
                     reset,
                     load_seed,
                     step,
  input  [7:0]       seed,
  input  Instruction instruction,
  output [7:0]       result
);

  reg [7:0] accumulator;
  always @(posedge clock) begin
    if (reset)
      accumulator <= 8'h0;
    else
      accumulator <=
        load_seed
          ? seed
          : step
              ? (instruction.opcode == 4'h0
                   ? instruction.operand
                   : instruction.opcode == 4'h1
                       ? accumulator + instruction.operand
                       : instruction.opcode == 4'h2
                           ? accumulator ^ instruction.operand
                           : instruction.opcode == 4'h3
                               ? accumulator << instruction.operand
                               : accumulator)
              : accumulator;
  end // always @(posedge)
  assign result = accumulator;
endmodule
}>>|

export:
  EngineConfig
  Opcode
  Instruction
  ProgramLoader
  Lane
  TinySIMD
  showcase_config
  design
  no_multiply_design
  verilog_reference
  no_multiply_verilog_reference
