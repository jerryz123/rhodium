#lang rhodium
// Demonstrates a host-sized memory with async reads and one synchronous write port.
// SPDX-License-Identifier: Apache-2.0

circuit AsyncReadMemory(depth :: PosInt, width :: PosInt):
  input clock: Clock
  input read_address: Bits(index_width(depth))
  input write_address: Bits(index_width(depth))
  input write_data: Bits(width)
  input write_enable: Bool
  output read_data: Bits(width)

  mem storage(depth, Bits(width))

  read_data <== storage[read_address]
  storage.write(write_address, write_data,
                ~enable: write_enable, ~clock: clock)

def design = elaborate(AsyncReadMemory(4, 8))

def verilog_reference = @str|<<{
module AsyncReadMemory(
  input        clock,
  input  [1:0] read_address,
               write_address,
  input  [7:0] write_data,
  input        write_enable,
  output [7:0] read_data
);

  wire       _GEN = 1'h0;
  reg  [7:0] storage[0:3];
  always_ff @(posedge clock) begin
    if (_GEN) begin
    end
    else begin
      if (write_enable)
        storage[write_address] <= write_data;
    end
  end // always_ff @(posedge)
  assign read_data = storage[read_address];
endmodule
}>>|

export:
  AsyncReadMemory
  design
  verilog_reference
