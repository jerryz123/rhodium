#lang rhodium
// Implements a four-stage shift register with synchronous reset and a hardware enable.
// SPDX-License-Identifier: Apache-2.0

circuit EnableShiftRegister():
  input data_in: Bits(4)
  input shift: Bool
  input clk: Clock
  input reset: Reset
  output data_out: Bits(4)

  reg r0(Bits(4), ~clock: clk, ~reset: reset,
         ~init: bits(0, 4))
  reg r1(Bits(4), ~clock: clk, ~reset: reset,
         ~init: bits(0, 4))
  reg r2(Bits(4), ~clock: clk, ~reset: reset,
         ~init: bits(0, 4))
  reg r3(Bits(4), ~clock: clk, ~reset: reset,
         ~init: bits(0, 4))

  when shift:
    r0 <== data_in
    r1 <== r0
    r2 <== r1
    r3 <== r2

  data_out <== r3

def design = elaborate(EnableShiftRegister())

def verilog_reference = @str|<<{
module EnableShiftRegister(
  input  [3:0] data_in,
  input        shift,
               clk,
               reset,
  output [3:0] data_out
);

  reg [3:0] r0;
  reg [3:0] r1;
  reg [3:0] r2;
  reg [3:0] r3;
  always @(posedge clk) begin
    if (reset) begin
      r0 <= 4'h0;
      r1 <= 4'h0;
      r2 <= 4'h0;
      r3 <= 4'h0;
    end
    else begin
      r0 <= shift ? data_in : r0;
      r1 <= shift ? r0 : r1;
      r2 <= shift ? r1 : r2;
      r3 <= shift ? r2 : r3;
    end
  end // always @(posedge)
  assign data_out = r3;
endmodule
}>>|

export:
  EnableShiftRegister
  design
  verilog_reference
