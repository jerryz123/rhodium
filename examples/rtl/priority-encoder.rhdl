#lang rhodium
// Demonstrates lower-index-first priority encoders over packed and aggregate data.
// SPDX-License-Identifier: Apache-2.0

circuit PriorityEncoderFive():
  input requests: Bits(5)
  output selected_index: Bits(3)
  output selected_oh: MaybeOneHot(5)
  output selected_two_index: Bits(1)
  output selected_two_oh: MaybeOneHot(2)
  output selected_single_index: Bits(1)
  output selected_single_oh: MaybeOneHot(1)

  selected_index <== priority_encoder(requests)
  selected_oh <== priority_encoder_oh(requests)
  selected_two_index <== priority_encoder(requests[0..2])
  selected_two_oh <== priority_encoder_oh(requests[0..2])
  selected_single_index <== priority_encoder(requests[0])
  selected_single_oh <== priority_encoder_oh(requests[0])

circuit PriorityEncoderShapes():
  input flags: Vec(5, Bool)
  input single: Bool
  output flags_index: Bits(3)
  output flags_oh: MaybeOneHot(5)
  output single_index: Bits(1)
  output single_oh: MaybeOneHot(1)

  flags_index <== priority_encoder(flags)
  flags_oh <== priority_encoder_oh(flags)
  single_index <== priority_encoder(single)
  single_oh <== priority_encoder_oh(single)

def five_design = elaborate(PriorityEncoderFive())
def shapes_design = elaborate(PriorityEncoderShapes())

def five_verilog_reference = @str|<<{
module PriorityEncoderFive(
  input  [4:0] requests,
  output [2:0] selected_index,
  output [4:0] selected_oh,
  output       selected_two_index,
  output [1:0] selected_two_oh,
  output       selected_single_index,
               selected_single_oh
);

  wire [3:0] _GEN = requests[3:0] | {requests[2:0], 1'h0};
  wire [3:0] _GEN_0 = _GEN | {_GEN[1:0], 2'h0};
  wire [3:0] _GEN_1 = requests[4:1] & ~_GEN_0;
  assign selected_index = {_GEN_1[3], |(_GEN_1[2:1]), |{_GEN_1[2], _GEN_1[0]}};
  assign selected_oh = requests & {~_GEN_0, 1'h1};
  assign selected_two_index = requests[1] & ~(requests[0]);
  assign selected_two_oh = requests[1:0] & {~(requests[0]), 1'h1};
  assign selected_single_index = 1'h0;
  assign selected_single_oh = requests[0];
endmodule
}>>|

def shapes_verilog_reference = @str|<<{
module PriorityEncoderShapes(
  input  [4:0] flags,
  input        single,
  output [2:0] flags_index,
  output [4:0] flags_oh,
  output       single_index,
               single_oh
);

  wire [4:0] _GEN = flags;
  wire [3:0] _GEN_0 = _GEN[3:0] | {_GEN[2:0], 1'h0};
  wire [3:0] _GEN_1 = _GEN_0 | {_GEN_0[1:0], 2'h0};
  wire [3:0] _GEN_2 = _GEN[4:1] & ~_GEN_1;
  assign flags_index = {_GEN_2[3], |(_GEN_2[2:1]), |{_GEN_2[2], _GEN_2[0]}};
  assign flags_oh = _GEN & {~_GEN_1, 1'h1};
  assign single_index = 1'h0;
  assign single_oh = single;
endmodule
}>>|

export:
  PriorityEncoderFive
  PriorityEncoderShapes
  five_design
  shapes_design
  five_verilog_reference
  shapes_verilog_reference
