#lang rhodium
// Implements same-width unsigned multiplication with modular fixed-width results.
// SPDX-License-Identifier: Apache-2.0

circuit Multiplier(width :: PosInt):
  input(a, b): Bits(width)
  output product: Bits(width)

  product <== a * b

def design = elaborate(Multiplier(8))

def verilog_reference = @str|<<{
module Multiplier(
  input  [7:0] a,
               b,
  output [7:0] product
);

  assign product = a * b;
endmodule
}>>|

export:
  Multiplier
  design
  verilog_reference
