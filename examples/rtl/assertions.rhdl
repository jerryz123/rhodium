#lang rhodium
// Demonstrates reset-suppressed assertions with branch-derived activation guards.
// SPDX-License-Identifier: Apache-2.0

sync_circuit Assertions():
  input always_condition: Bool
  input request: Bool
  input request_condition: Bool

  assert(always_condition, "always_holds")
  when request:
    assert(request_condition, "request_holds")

def design = elaborate(Assertions())

def verilog_reference = @str|<<{
module Assertions(
  input clock,
        reset,
        always_condition,
        request,
        request_condition
);

  `ifndef SYNTHESIS
    always_holds: assert property (@(posedge clock) disable iff (reset) always_condition);
  `endif // not def SYNTHESIS
  wire _GEN = ~(request & ~reset);
  `ifndef SYNTHESIS
    request_holds:
      assert property (@(posedge clock) disable iff (_GEN) request_condition);
  `endif // not def SYNTHESIS
endmodule
}>>|

export:
  Assertions
  design
  verilog_reference
