#lang rhodium
// Demonstrates a private child circuit that captures a host parameter.
// SPDX-License-Identifier: Apache-2.0

circuit Incrementer(width :: PosInt):
  input value_in: Bits(width)
  output value_out: Bits(width)

  circuit Increment():
    input value_in: Bits(width)
    output value_out: Bits(width)
    value_out <== value_in + bits(1, width)

  inst increment(Increment())
  increment.value_in <== value_in
  value_out <== increment.value_out

def design = elaborate(Incrementer(8))

def verilog_reference = @str|<<{
module Incrementer(
  input  [7:0] value_in,
  output [7:0] value_out
);

  Increment increment (
    .value_in  (value_in),
    .value_out (value_out)
  );
endmodule

module Increment(
  input  [7:0] value_in,
  output [7:0] value_out
);

  assign value_out = value_in + 8'h1;
endmodule
}>>|

export:
  Incrementer
  design
  verilog_reference
