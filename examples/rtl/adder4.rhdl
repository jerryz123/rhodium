#lang rhodium
// Builds a four-bit ripple-carry adder from one reusable FullAdder definition.
// SPDX-License-Identifier: Apache-2.0

import:
  "full-adder.rhdl".FullAdder

circuit Adder4():
  input(A, B): Bits(4)
  input Cin: Bits(1)
  output Sum: Bits(4)
  output Cout: Bits(1)

  def FullAdderModule = FullAdder()
  inst adder0(FullAdderModule)
  inst adder1(FullAdderModule)
  inst adder2(FullAdderModule)
  inst adder3(FullAdderModule)

  adder0.a <== A[0].into(Bool)
  adder0.b <== B[0].into(Bool)
  adder0.cin <== Cin.into(Bool)

  adder1.a <== A[1].into(Bool)
  adder1.b <== B[1].into(Bool)
  adder1.cin <== adder0.cout

  adder2.a <== A[2].into(Bool)
  adder2.b <== B[2].into(Bool)
  adder2.cin <== adder1.cout

  adder3.a <== A[3].into(Bool)
  adder3.b <== B[3].into(Bool)
  adder3.cin <== adder2.cout

  Sum <== concat(adder3.sum, adder2.sum, adder1.sum, adder0.sum)
  Cout <== adder3.cout.as_bits()

def design = elaborate(Adder4())

def verilog_reference = @str|<<{
module Adder4(
  input  [3:0] A,
               B,
  input        Cin,
  output [3:0] Sum,
  output       Cout
);

  wire _adder3_sum;
  wire _adder2_sum;
  wire _adder2_cout;
  wire _adder1_sum;
  wire _adder1_cout;
  wire _adder0_sum;
  wire _adder0_cout;
  FullAdder adder0 (
    .a    (A[0]),
    .b    (B[0]),
    .cin  (Cin),
    .sum  (_adder0_sum),
    .cout (_adder0_cout)
  );
  FullAdder adder1 (
    .a    (A[1]),
    .b    (B[1]),
    .cin  (_adder0_cout),
    .sum  (_adder1_sum),
    .cout (_adder1_cout)
  );
  FullAdder adder2 (
    .a    (A[2]),
    .b    (B[2]),
    .cin  (_adder1_cout),
    .sum  (_adder2_sum),
    .cout (_adder2_cout)
  );
  FullAdder adder3 (
    .a    (A[3]),
    .b    (B[3]),
    .cin  (_adder2_cout),
    .sum  (_adder3_sum),
    .cout (Cout)
  );
  assign Sum = {_adder3_sum, _adder2_sum, _adder1_sum, _adder0_sum};
endmodule

module FullAdder(
  input  a,
         b,
         cin,
  output sum,
         cout
);

  assign sum = a ^ b ^ cin;
  assign cout = a & b | b & cin | a & cin;
endmodule
}>>|

export:
  Adder4
  design
  verilog_reference
