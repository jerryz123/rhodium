#lang rhodium
/* Demonstrates explicit-role interfaces layered over directional record ports. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/ready-valid.rhdl") open

/* Forwards valid and payload toward egress and ready toward ingress. */
circuit ReadyValidAdapter(width :: PosInt):
  interface ingress(Decoupled(Bits(width)), ~role: consumer)
  interface egress(Decoupled(Bits(width)), ~role: producer)

  ingress |> egress

/* Produces the example payload and validity through a ready-valid interface. */
circuit ReadyValidSource(width :: PosInt):
  input valid: Bool
  input bits_in: Bits(width)
  output accepted: Bool
  interface tx(Decoupled(Bits(width)), ~role: producer)

  tx.valid <== valid
  tx.bits <== bits_in
  accepted <== tx.ready

/* Composes the source and adapter through their declared interface ports. */
circuit ReadyValidHierarchy(width :: PosInt):
  input valid: Bool
  input bits_in: Bits(width)
  output accepted: Bool
  interface tx(Decoupled(Bits(width)), ~role: producer)

  inst source(ReadyValidSource(width))
  source.valid <== valid
  source.bits_in <== bits_in
  accepted <== source.accepted
  source.tx |> tx

def program = elaborate(ReadyValidAdapter(8))
def hierarchy_program = elaborate(ReadyValidHierarchy(8))

def verilog_reference = @str|<<{
module ReadyValidAdapter(
  input  struct packed {logic valid; logic [7:0] bits; } ingress_in,
  input  struct packed {logic ready; }                   egress_in,
  output struct packed {logic ready; }                   ingress_out,
  output struct packed {logic valid; logic [7:0] bits; } egress_out
);

  assign ingress_out = egress_in;
  assign egress_out = ingress_in;
endmodule
}>>|

def hierarchy_verilog_reference = @str|<<{
module ReadyValidHierarchy(
  input                                                  valid,
  input  [7:0]                                           bits_in,
  input  struct packed {logic ready; }                   tx_in,
  output                                                 accepted,
  output struct packed {logic valid; logic [7:0] bits; } tx_out
);

  ReadyValidSource source (
    .valid    (valid),
    .bits_in  (bits_in),
    .tx_in    (tx_in),
    .accepted (accepted),
    .tx_out   (tx_out)
  );
endmodule

module ReadyValidSource(
  input                                                  valid,
  input  [7:0]                                           bits_in,
  input  struct packed {logic ready; }                   tx_in,
  output                                                 accepted,
  output struct packed {logic valid; logic [7:0] bits; } tx_out
);

  assign accepted = tx_in.ready;
  assign tx_out = '{valid: valid, bits: bits_in};
endmodule
}>>|

export:
  ReadyValidAdapter
  ReadyValidSource
  ReadyValidHierarchy
  program
  hierarchy_program
  verilog_reference
  hierarchy_verilog_reference
