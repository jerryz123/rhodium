#lang rhodium
// Demonstrates fixed-width logical shifts with host and hardware amounts.
// SPDX-License-Identifier: Apache-2.0

circuit ShiftOps8():
  input value: Bits(8)
  input amount: Bits(3)
  input wide_amount: Bits(12)
  output(left, right, left_wide, right_wide, left_three, right_three): Bits(8)

  left <== value << amount
  right <== value >> amount
  left_wide <== value << wide_amount
  right_wide <== value >> wide_amount
  left_three <== value << 3
  right_three <== value >> 3

def design = elaborate(ShiftOps8())

def verilog_reference = @str|<<{
module ShiftOps8(
  input  [7:0]  value,
  input  [2:0]  amount,
  input  [11:0] wide_amount,
  output [7:0]  left,
                right,
                left_wide,
                right_wide,
                left_three,
                right_three
);

  wire [7:0]  _GEN = {5'h0, amount};
  wire [11:0] _GEN_0 = {4'h0, value};
  wire [11:0] _GEN_1 = _GEN_0 << wide_amount;
  wire [11:0] _GEN_2 = _GEN_0 >> wide_amount;
  assign left = value << _GEN;
  assign right = value >> _GEN;
  assign left_wide = _GEN_1[7:0];
  assign right_wide = _GEN_2[7:0];
  assign left_three = {value[4:0], 3'h0};
  assign right_three = {3'h0, value[7:3]};
endmodule
}>>|

export:
  ShiftOps8
  design
  verilog_reference
