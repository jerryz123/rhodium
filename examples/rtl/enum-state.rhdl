#lang rhodium
// Demonstrates equivalent enum mux and switch forms plus explicit encodings.
// SPDX-License-Identifier: Apache-2.0

hardware_enum State:
  Idle
  Running
  Done

hardware_enum Opcode(~width: 4):
  Add = 0
  Sub = 1
  Load = 8

circuit StateMachineLookup():
  input clock: Clock
  input reset: Reset
  output state_out: State

  reg current(State, ~clock: clock, ~reset: reset, ~init: State.Idle)
  // The mandatory default recovers from State's unused two-bit encoding.
  current <== mux_lookup(current, ~default: State.Idle):
    State.Idle: State.Running
    State.Running: State.Done
    State.Done: State.Idle
  state_out <== current

// This statement form has the same transition and invalid-encoding behavior
// as StateMachineLookup, while allowing multiple assignments or effects per case.
circuit StateMachine():
  input clock: Clock
  input reset: Reset
  output state_out: State

  reg current(State, ~clock: clock, ~reset: reset, ~init: State.Idle)
  // The mandatory otherwise branch recovers from the unused two-bit encoding.
  switch current:
    case State.Idle:
      current <== State.Running
    case State.Running:
      current <== State.Done
    case State.Done:
      current <== State.Idle
    otherwise:
      current <== State.Idle
  state_out <== current

circuit OpcodeDecoder():
  input opcode: Opcode
  output is_load: Bool
  output next_opcode: Opcode
  is_load <== opcode === Opcode.Load
  next_opcode <== mux_lookup(opcode, ~default: Opcode.Add):
    Opcode.Add: Opcode.Sub
    Opcode.Sub: Opcode.Load
    Opcode.Load: Opcode.Add

def design = elaborate(StateMachine())
def lookup_design = elaborate(StateMachineLookup())
def opcode_design = elaborate(OpcodeDecoder())

def verilog_reference = @str|<<{
module StateMachine(
  input        clock,
               reset,
  output [1:0] state_out
);

  reg [1:0] current;
  always @(posedge clock) begin
    if (reset)
      current <= 2'h0;
    else
      current <= current == 2'h0 ? 2'h1 : {current == 2'h1, 1'h0};
  end // always @(posedge)
  assign state_out = current;
endmodule
}>>|

def lookup_verilog_reference = @str|<<{
module StateMachineLookup(
  input        clock,
               reset,
  output [1:0] state_out
);

  reg [1:0] current;
  always @(posedge clock) begin
    if (reset)
      current <= 2'h0;
    else
      current <= current == 2'h0 ? 2'h1 : {current == 2'h1, 1'h0};
  end // always @(posedge)
  assign state_out = current;
endmodule
}>>|

def opcode_verilog_reference = @str|<<{
module OpcodeDecoder(
  input  [3:0] opcode,
  output       is_load,
  output [3:0] next_opcode
);

  assign is_load = opcode == 4'h8;
  assign next_opcode = opcode == 4'h0 ? 4'h1 : {opcode == 4'h1, 3'h0};
endmodule
}>>|

export:
  State
  Opcode
  StateMachine
  StateMachineLookup
  OpcodeDecoder
  design
  lookup_design
  opcode_design
  verilog_reference
  lookup_verilog_reference
  opcode_verilog_reference
