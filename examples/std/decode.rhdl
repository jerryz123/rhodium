#lang rhodium
// Demonstrates a typed aggregate DecodeGen with input and output don't-cares.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/decode.rhdl") open

bundle Instruction():
  opcode: Bits(4)
  mode: Bool

hardware_enum AluOp:
  None
  Add
  Sub

bundle Control():
  alu: AluOp
  write: Bool

def add_input = pattern(Instruction()):
  opcode: bits(0, 4)
  mode: _
def sub_input = pattern(Instruction()):
  opcode: bits(1, 4)
  mode: _

def default_control = pattern(Control()):
  alu: AluOp.None
  write: _

def control_cases = decode_groups(Control()):
  [add_input]:
    alu: AluOp.Add
    write: Bool(#false)

  [sub_input]:
    alu: AluOp.Sub
    write: _

def control_decode = DecodeGen(
  control_cases,
  ~default: default_control
)

circuit InstructionDecoder():
  input encoded: Bits(5)
  output alu: AluOp
  output write: Bool

  def instruction = encoded.into(Instruction())
  def control = control_decode(instruction)
  alu <== control.alu
  write <== control.write

def design = elaborate(InstructionDecoder())

def verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhodium_types
`define _TYPESCOPE_rhodium_types
  typedef struct packed {logic [3:0] opcode; logic mode; } Instruction;
  typedef struct packed {logic [1:0] alu; logic write; } Control;
`endif // _TYPESCOPE_rhodium_types
module InstructionDecoder(
  input  [4:0] encoded,
  output [1:0] alu,
  output       write
);

  logic [2:0]   __rhodium_decode_4_result;
  always_comb begin
    casez (encoded)
      5'b0000z:
        __rhodium_decode_4_result = 3'h2;
      5'b0001z:
        __rhodium_decode_4_result = {2'h2, 1'bx};
      default:
        __rhodium_decode_4_result = {2'h0, 1'bx};
    endcase
  end // always_comb
  wire  Control _GEN = /*cast(bit)*/__rhodium_decode_4_result;
  assign alu = _GEN.alu;
  assign write = _GEN.write;
endmodule
}>>|

export:
  Instruction
  AluOp
  Control
  control_decode
  InstructionDecoder
  design
  verilog_reference
