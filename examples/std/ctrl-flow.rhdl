  ctrl_pipe_design
  ctrl_queue_design
  ctrl_queue_options_design
  ctrl_arbiter_design
  ctrl_rr_arbiter_design
  ctrl_demux_design
  ctrl_join_design
  ctrl_broadcast_design
  ctrl_chain_design
