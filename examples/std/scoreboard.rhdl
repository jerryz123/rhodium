#lang rhodium
// Materializes a three-entry occupancy scoreboard with set and clear assertions.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/scoreboard.rhdl") open

def design = elaborate(Scoreboard(3))

def verilog_reference = @str|<<{
module Scoreboard(
  input                                                  clock,
                                                         reset,
  input  struct packed {logic valid; logic [1:0] bits; } set_in,
                                                         clear_in,
  output [2:0]                                           busy
);

  reg  [2:0] state;
  wire [3:0] _GEN = 4'h1 << set_in.bits;
  wire [3:0] _GEN_0 = 4'h1 << clear_in.bits;
  wire       _GEN_1 = set_in.valid & ~reset;
  wire       _GEN_2 = ~_GEN_1;
  `ifndef SYNTHESIS
    scoreboard_set_index_in_range:
      assert property (@(posedge clock) disable iff (_GEN_2) set_in.bits != 2'h3);
  `endif // not def SYNTHESIS
  wire       _GEN_3 = ~_GEN_1;
  `ifndef SYNTHESIS
    scoreboard_set_free:
      assert property (@(posedge clock) disable iff (_GEN_3)
                         (state & _GEN[2:0]) == 3'h0 | clear_in.valid
                         & clear_in.bits == set_in.bits);
  `endif // not def SYNTHESIS
  wire       _GEN_4 = clear_in.valid & ~reset;
  wire       _GEN_5 = ~_GEN_4;
  `ifndef SYNTHESIS
    scoreboard_clear_index_in_range:
      assert property (@(posedge clock) disable iff (_GEN_5) clear_in.bits != 2'h3);
  `endif // not def SYNTHESIS
  wire       _GEN_6 = ~_GEN_4;
  `ifndef SYNTHESIS
    scoreboard_clear_busy:
      assert property (@(posedge clock) disable iff (_GEN_6)
                         (|(state & _GEN_0[2:0])) | set_in.valid
                         & set_in.bits == clear_in.bits);
  `endif // not def SYNTHESIS
  always @(posedge clock) begin
    if (reset)
      state <= 3'h0;
    else
      state <=
        set_in.valid | clear_in.valid
          ? (state | (set_in.valid ? _GEN[2:0] : 3'h0))
            & ~(clear_in.valid ? _GEN_0[2:0] : 3'h0)
          : state;
  end // always @(posedge)
  assign busy = state;
endmodule
}>>|

export:
  design
  verilog_reference
