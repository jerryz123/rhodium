#lang rhodium
/* Demonstrates packet-locked round-robin arbitration over variable flits. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("flow/main.rhdl") open

/* Demonstrates packet-locked round-robin arbitration over variable flits. */
sync_circuit PacketArbitration():
  def Flit = VariableFlit(Bits(8))
  interface ingress[3](Decoupled(Flit), ~role: consumer)
  interface egress(Decoupled(Flit), ~role: producer)

  ingress |> packet_rr_arbiter(flit => flit.tail) |> egress

def program = elaborate(PacketArbitration())

def verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhodium_types
`define _TYPESCOPE_rhodium_types
  typedef struct packed {logic head; logic tail; logic [7:0] payload; } VariableFlit;
  typedef struct packed {logic valid; logic [2:0] grant; logic [1:0] index; }
    CircularPriorityChoice;
`endif // _TYPESCOPE_rhodium_types
module PacketArbitration(
  input                                                   clock,
                                                          reset,
  input  struct packed {logic valid; VariableFlit bits; } ingress_0_in,
                                                          ingress_1_in,
                                                          ingress_2_in,
  input  struct packed {logic ready; }                    egress_in,
  output struct packed {logic ready; }                    ingress_0_out,
                                                          ingress_1_out,
                                                          ingress_2_out,
  output struct packed {logic valid; VariableFlit bits; } egress_out
);

  PacketRRArbiter packet_rr_stage (
    .clock         (clock),
    .reset         (reset),
    .ingress_0_in  (ingress_0_in),
    .ingress_1_in  (ingress_1_in),
    .ingress_2_in  (ingress_2_in),
    .ends_packet
      ({{ingress_2_in.bits.tail}, {ingress_1_in.bits.tail}, {ingress_0_in.bits.tail}}),
    .egress_in     (egress_in),
    .ingress_0_out (ingress_0_out),
    .ingress_1_out (ingress_1_out),
    .ingress_2_out (ingress_2_out),
    .egress_out    (egress_out),
    .chosen        (/* unused */)
  );
endmodule

module PacketRRArbiter(
  input                                                   clock,
                                                          reset,
  input  struct packed {logic valid; VariableFlit bits; } ingress_0_in,
                                                          ingress_1_in,
                                                          ingress_2_in,
  input  [2:0]                                            ends_packet,
  input  struct packed {logic ready; }                    egress_in,
  output struct packed {logic ready; }                    ingress_0_out,
                                                          ingress_1_out,
                                                          ingress_2_out,
  output struct packed {logic valid; VariableFlit bits; } egress_out,
  output [1:0]                                            chosen
);

  wire [2:0]        _selection_selected;
  reg  [1:0]        next_priority;
  `ifndef SYNTHESIS
    packet_rr_priority_in_range:
      assert property (@(posedge clock) disable iff (reset) next_priority != 2'h3);
  `endif // not def SYNTHESIS
  wire [2:0]        _GEN =
    {{ingress_2_in.valid}, {ingress_1_in.valid}, {ingress_0_in.valid}};
  wire [2:0]        _GEN_0 = _GEN & ~{&next_priority, next_priority[1], |next_priority};
  wire              _GEN_1 = |(_selection_selected & _GEN);
  wire              _GEN_2 =
    ends_packet[2'h0] & _selection_selected[0] | ends_packet[2'h1]
    & _selection_selected[1] | ends_packet[2'h2] & _selection_selected[2];
  wire [9:0]        _GEN_3 = /*cast(bit[9:0])*/ingress_0_in.bits;
  wire [9:0]        _GEN_4 = /*cast(bit[9:0])*/ingress_1_in.bits;
  wire [9:0]        _GEN_5 = /*cast(bit[9:0])*/ingress_2_in.bits;
  wire VariableFlit _GEN_6 =
    /*cast(bit)*/_GEN_3 & {10{_selection_selected[0]}} | _GEN_4
    & {10{_selection_selected[1]}} | _GEN_5 & {10{_selection_selected[2]}} | _GEN_3
    & {10{_selection_selected == 3'h0}};
  wire              _GEN_7 = _GEN_1 & egress_in.ready;
  wire              _GEN_8 = _GEN_7 & _GEN_2;
  RetainedSelection selection (
    .clock     (clock),
    .reset     (reset),
    .candidate
      ((|_GEN_0)
         ? _GEN_0 & {~(_GEN_0[1:0] | {_GEN_0[0], 1'h0}), 1'h1}
         : _GEN & {~(_GEN[1:0] | {_GEN[0], 1'h0}), 1'h1}),
    .capture   (_GEN_7 & ~_GEN_2),
    .release_0 (_GEN_8),
    .selected  (_selection_selected),
    .retained  (/* unused */),
    .held      (/* unused */)
  );
  always @(posedge clock) begin
    if (reset)
      next_priority <= 2'h0;
    else
      next_priority <=
        _GEN_8
          ? (_selection_selected[2:1] == 2'h2 ? 2'h0 : _selection_selected[2:1] + 2'h1)
          : next_priority;
  end // always @(posedge)
  assign ingress_0_out = '{ready: (egress_in.ready & _selection_selected[0])};
  assign ingress_1_out = '{ready: (egress_in.ready & _selection_selected[1])};
  assign ingress_2_out = '{ready: (egress_in.ready & _selection_selected[2])};
  assign egress_out = '{valid: _GEN_1, bits: _GEN_6};
  assign chosen = _selection_selected[2:1];
endmodule

module RetainedSelection(
  input        clock,
               reset,
  input  [2:0] candidate,
  input        capture,
               release_0,
  output [2:0] selected,
               retained,
  output       held
);

  reg        occupied;
  reg  [1:0] owner;
  wire [2:0] _GEN = {2'h0, occupied} << owner;
  wire [2:0] _GEN_0 = occupied ? _GEN : candidate;
  wire       _GEN_1 = ~(capture & ~reset);
  `ifndef SYNTHESIS
    retained_selection_capture_present:
      assert property (@(posedge clock) disable iff (_GEN_1) |_GEN_0);
  `endif // not def SYNTHESIS
  wire       _GEN_2 = capture & ~occupied;
  always @(posedge clock) begin
    if (reset)
      occupied <= 1'h0;
    else
      occupied <= ~release_0 & (_GEN_2 | occupied);
  end // always @(posedge)
  always @(posedge clock)
    owner <= release_0 | ~_GEN_2 ? owner : _GEN_0[2:1];
  assign selected = _GEN_0;
  assign retained = _GEN;
  assign held = occupied;
endmodule
}>>|

export:
  PacketArbitration
  program
  verilog_reference
