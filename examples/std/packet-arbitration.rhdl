#lang rhodium
/* Demonstrates packet-locked round-robin arbitration over variable flits. */
// SPDX-License-Identifier: Apache-2.0

import:
  lib("flow/main.rhdl") open

/* Demonstrates packet-locked round-robin arbitration over variable flits. */
sync_circuit PacketArbitration():
  def Flit = VariableFlit(Bits(8))
  interface ingress[3](Decoupled(Flit), ~role: consumer)
  interface egress(Decoupled(Flit), ~role: producer)

  ingress |> packet_rr_arbiter(flit => flit.tail) |> egress

def program = elaborate(PacketArbitration())

def verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhodium_types
`define _TYPESCOPE_rhodium_types
  typedef struct packed {logic head; logic tail; logic [7:0] payload; } VariableFlit;
  typedef struct packed {logic valid; logic [2:0] grant; logic [1:0] index; }
    CircularPriorityChoice;
`endif // _TYPESCOPE_rhodium_types
module PacketArbitration(
  input                                                   clock,
                                                          reset,
  input  struct packed {logic valid; VariableFlit bits; } ingress_0_in,
                                                          ingress_1_in,
                                                          ingress_2_in,
  input  struct packed {logic ready; }                    egress_in,
  output struct packed {logic ready; }                    ingress_0_out,
                                                          ingress_1_out,
                                                          ingress_2_out,
  output struct packed {logic valid; VariableFlit bits; } egress_out
);

  PacketRRArbiter packet_rr_stage (
    .clock         (clock),
    .reset         (reset),
    .ingress_0_in  (ingress_0_in),
    .ingress_1_in  (ingress_1_in),
    .ingress_2_in  (ingress_2_in),
    .ends_packet
      ({{ingress_2_in.bits.tail}, {ingress_1_in.bits.tail}, {ingress_0_in.bits.tail}}),
    .egress_in     (egress_in),
    .ingress_0_out (ingress_0_out),
    .ingress_1_out (ingress_1_out),
    .ingress_2_out (ingress_2_out),
    .egress_out    (egress_out),
    .chosen        (/* unused */)
  );
endmodule

module PacketRRArbiter(
  input                                                   clock,
                                                          reset,
  input  struct packed {logic valid; VariableFlit bits; } ingress_0_in,
                                                          ingress_1_in,
                                                          ingress_2_in,
  input  [2:0]                                            ends_packet,
  input  struct packed {logic ready; }                    egress_in,
  output struct packed {logic ready; }                    ingress_0_out,
                                                          ingress_1_out,
                                                          ingress_2_out,
  output struct packed {logic valid; VariableFlit bits; } egress_out,
  output [1:0]                                            chosen
);

  reg  [1:0]        next_priority;
  reg               locked;
  reg  [1:0]        owner;
  `ifndef SYNTHESIS
    packet_rr_priority_in_range:
      assert property (@(posedge clock) disable iff (reset) next_priority != 2'h3);
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    packet_rr_owner_in_range:
      assert property (@(posedge clock) disable iff (reset) ~locked | owner != 2'h3);
  `endif // not def SYNTHESIS
  wire [2:0]        _GEN =
    {{ingress_2_in.valid}, {ingress_1_in.valid}, {ingress_0_in.valid}};
  wire [2:0]        _GEN_0 = _GEN & ~{&next_priority, next_priority[1], |next_priority};
  wire [2:0]        _GEN_1 =
    (|_GEN_0)
      ? _GEN_0 & {~(_GEN_0[1:0] | {_GEN_0[0], 1'h0}), 1'h1}
      : _GEN & {~(_GEN[1:0] | {_GEN[0], 1'h0}), 1'h1};
  wire [3:0]        _GEN_2 = 4'h1 << owner;
  wire [2:0]        _GEN_3 = locked ? _GEN_2[2:0] : _GEN_1;
  wire [1:0]        _GEN_4 = locked ? owner : _GEN_1[2:1];
  wire              _GEN_5 = |(_GEN_3 & _GEN);
  wire [9:0]        _GEN_6 = /*cast(bit[9:0])*/ingress_0_in.bits;
  wire [9:0]        _GEN_7 = /*cast(bit[9:0])*/ingress_1_in.bits;
  wire [9:0]        _GEN_8 = /*cast(bit[9:0])*/ingress_2_in.bits;
  wire VariableFlit _GEN_9 =
    /*cast(bit)*/_GEN_6 & {10{_GEN_3[0]}} | _GEN_7 & {10{_GEN_3[1]}} | _GEN_8
    & {10{_GEN_3[2]}} | _GEN_6 & {10{_GEN_3 == 3'h0}};
  wire              _GEN_10 = _GEN_5 & egress_in.ready;
  wire              _GEN_11 =
    _GEN_10
    & (ends_packet[2'h0] & _GEN_3[0] | ends_packet[2'h1] & _GEN_3[1] | ends_packet[2'h2]
       & _GEN_3[2]);
  wire              _GEN_12 = _GEN_10 & ~locked;
  always @(posedge clock) begin
    if (reset) begin
      next_priority <= 2'h0;
      locked <= 1'h0;
      owner <= 2'h0;
    end
    else begin
      next_priority <= _GEN_11 ? (_GEN_4 == 2'h2 ? 2'h0 : _GEN_4 + 2'h1) : next_priority;
      locked <= ~_GEN_11 & (_GEN_12 | locked);
      owner <= _GEN_11 | ~_GEN_12 | locked ? owner : _GEN_1[2:1];
    end
  end // always @(posedge)
  assign ingress_0_out = '{ready: (egress_in.ready & _GEN_3[0])};
  assign ingress_1_out = '{ready: (egress_in.ready & _GEN_3[1])};
  assign ingress_2_out = '{ready: (egress_in.ready & _GEN_3[2])};
  assign egress_out = '{valid: _GEN_5, bits: _GEN_9};
  assign chosen = _GEN_4;
endmodule
}>>|

export:
  PacketArbitration
  program
  verilog_reference
