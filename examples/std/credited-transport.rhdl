#lang rhodium
// Demonstrates monitored and composed credited transport with sender and buffer adapters.

import:
  lib("flow/main.rhdl") open

interface RefinedCredited8() refines Credited(Bits(8), 2)

sync_circuit MonitoredCreditedTransmitter():
  input send: Bool
  input payload: Bits(8)
  interface link(Credited(Bits(8), 2), ~role: transmitter)

  link.valid <== send
  link.bits <== payload
  monitor_credited(link)

sync_circuit CreditedRoundTrip():
  input grant_enable: Bool
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  interface egress(Irrevocable(Bits(8)), ~role: producer)
  output credit_count: Bits(2)
  output count: Bits(2)
  output reserved: Bits(2)

  inst sender(CreditSender(Bits(8), 2))
  inst buffer(CreditBuffer(Bits(8), 2))
  ingress <=> sender.ingress
  sender.link <=> buffer.link
  buffer.grant_enable <== grant_enable
  egress <=> buffer.egress
  credit_count <== sender.credit_count
  count <== buffer.count
  reserved <== buffer.reserved

sync_circuit CreditedChainedRoundTrip():
  input grant_enable: Bool
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  interface egress(Irrevocable(Bits(8)), ~role: producer)

  ingress
    |> credit_sender(2)
    |> credit_buffer(2, ~grant_enable: grant_enable)
    |> egress

def design = elaborate(CreditedRoundTrip())
def chained_design = elaborate(CreditedChainedRoundTrip())
def monitor_design = elaborate(MonitoredCreditedTransmitter())

def verilog_reference = @str|<<{
module CreditedRoundTrip(
  input                                                  clock,
                                                         reset,
                                                         grant_enable,
  input  struct packed {logic valid; logic [7:0] bits; } ingress_in,
  input  struct packed {logic ready; }                   egress_in,
  output struct packed {logic ready; }                   ingress_out,
  output struct packed {logic valid; logic [7:0] bits; } egress_out,
  output [1:0]                                           credit_count,
                                                         count,
                                                         reserved
);

  wire struct packed {logic credit; } _buffer_link_out;
  wire struct packed {logic valid; logic [7:0] bits; } _sender_link_out;
  CreditSender sender (
    .clock        (clock),
    .reset        (reset),
    .ingress_in   (ingress_in),
    .link_in      (_buffer_link_out),
    .ingress_out  (ingress_out),
    .link_out     (_sender_link_out),
    .credit_count (credit_count)
  );
  CreditBuffer buffer (
    .clock        (clock),
    .reset        (reset),
    .grant_enable (grant_enable),
    .link_in      (_sender_link_out),
    .egress_in    (egress_in),
    .link_out     (_buffer_link_out),
    .egress_out   (egress_out),
    .count        (count),
    .reserved     (reserved)
  );
endmodule

module CreditSender(
  input                                                  clock,
                                                         reset,
  input  struct packed {logic valid; logic [7:0] bits; } ingress_in,
  input  struct packed {logic credit; }                  link_in,
  output struct packed {logic ready; }                   ingress_out,
  output struct packed {logic valid; logic [7:0] bits; } link_out,
  output [1:0]                                           credit_count
);

  wire _balance_empty;
  wire _GEN = ingress_in.valid & ~_balance_empty;
  CreditCounter balance (
    .clock     (clock),
    .reset     (reset),
    .increment (link_in.credit),
    .decrement (_GEN),
    .count     (credit_count),
    .empty     (_balance_empty),
    .full      (/* unused */)
  );
  assign ingress_out = '{ready: (~_balance_empty)};
  assign link_out = '{valid: _GEN, bits: ingress_in.bits};
endmodule

module CreditCounter(
  input        clock,
               reset,
               increment,
               decrement,
  output [1:0] count,
  output       empty,
               full
);

  reg  [1:0] state;
  wire       _GEN = state == 2'h0;
  wire       _GEN_0 = state == 2'h2;
  `ifndef SYNTHESIS
    credit_counter_underflow:
      assert property (@(posedge clock) disable iff (reset) ~decrement | ~_GEN);
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    credit_counter_overflow:
      assert property (@(posedge clock) disable iff (reset)
                         ~increment | decrement | ~_GEN_0);
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    credit_counter_in_range:
      assert property (@(posedge clock) disable iff (reset) state != 2'h3);
  `endif // not def SYNTHESIS
  always @(posedge clock) begin
    if (reset)
      state <= 2'h0;
    else
      state <= increment ^ decrement ? (increment ? state + 2'h1 : state - 2'h1) : state;
  end // always @(posedge)
  assign count = state;
  assign empty = _GEN;
  assign full = _GEN_0;
endmodule

module CreditBuffer(
  input                                                  clock,
                                                         reset,
                                                         grant_enable,
  input  struct packed {logic valid; logic [7:0] bits; } link_in,
  input  struct packed {logic ready; }                   egress_in,
  output struct packed {logic credit; }                  link_out,
  output struct packed {logic valid; logic [7:0] bits; } egress_out,
  output [1:0]                                           count,
                                                         reserved
);

  wire [1:0]                         _reservations_count;
  wire                               _reservations_full;
  wire struct packed {logic ready; } _storage_ingress_out;
  wire struct packed {logic valid; logic [7:0] bits; } _storage_egress_out;
  wire [1:0]                         _storage_count;
  wire                               _GEN = _storage_egress_out.valid & egress_in.ready;
  wire                               _GEN_0 = grant_enable & (~_reservations_full | _GEN);
  `ifndef SYNTHESIS
    credit_buffer_reserved_slot_available:
      assert property (@(posedge clock) disable iff (reset)
                         ~link_in.valid | _storage_ingress_out.ready);
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    credit_buffer_occupancy_reserved:
      assert property (@(posedge clock) disable iff (reset)
                         _reservations_count >= _storage_count);
  `endif // not def SYNTHESIS
  reg  [1:0]                         credit_balance;
  `ifndef SYNTHESIS
    credited_transfer_has_credit:
      assert property (@(posedge clock) disable iff (reset)
                         ~link_in.valid | (|credit_balance));
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    credited_grant_within_limit:
      assert property (@(posedge clock) disable iff (reset)
                         ~_GEN_0 | link_in.valid | credit_balance != 2'h2);
  `endif // not def SYNTHESIS
  `ifndef SYNTHESIS
    credited_balance_in_range:
      assert property (@(posedge clock) disable iff (reset) credit_balance != 2'h3);
  `endif // not def SYNTHESIS
  Queue storage (
    .clock       (clock),
    .reset       (reset),
    .ingress_in  (link_in),
    .egress_in   (egress_in),
    .ingress_out (_storage_ingress_out),
    .egress_out  (_storage_egress_out),
    .count       (_storage_count)
  );
  CreditCounter reservations (
    .clock     (clock),
    .reset     (reset),
    .increment (_GEN_0),
    .decrement (_GEN),
    .count     (_reservations_count),
    .empty     (/* unused */),
    .full      (_reservations_full)
  );
  always @(posedge clock) begin
    if (reset)
      credit_balance <= 2'h0;
    else
      credit_balance <=
        _GEN_0 ^ link_in.valid
          ? (_GEN_0 ? credit_balance + 2'h1 : credit_balance - 2'h1)
          : credit_balance;
  end // always @(posedge)
  assign link_out = '{credit: _GEN_0};
  assign egress_out = _storage_egress_out;
  assign count = _storage_count;
  assign reserved = _reservations_count;
endmodule

module Queue(
  input                                                  clock,
                                                         reset,
  input  struct packed {logic valid; logic [7:0] bits; } ingress_in,
  input  struct packed {logic ready; }                   egress_in,
  output struct packed {logic ready; }                   ingress_out,
  output struct packed {logic valid; logic [7:0] bits; } egress_out,
  output [1:0]                                           count
);

  wire [7:0] _GEN;
  wire       _GEN_0;
  wire       _write_pointer_value;
  wire       _read_pointer_value;
  wire       _GEN_1 = 1'h0;
  reg  [7:0] storage[0:1];
  always_ff @(posedge clock) begin
    if (_GEN_1) begin
    end
    else begin
      if (_GEN_0)
        storage[_write_pointer_value] <= _GEN;
    end
  end // always_ff @(posedge)
  reg  [1:0] occupancy;
  wire       _GEN_2 = occupancy == 2'h0;
  `ifndef SYNTHESIS
    queue_occupancy_in_range:
      assert property (@(posedge clock) disable iff (reset) occupancy != 2'h3);
  `endif // not def SYNTHESIS
  wire       _GEN_3 = occupancy != 2'h2 | egress_in.ready;
  assign _GEN_0 = ingress_in.valid & _GEN_3;
  wire       _GEN_4 = ~_GEN_2 & egress_in.ready;
  assign _GEN = ingress_in.bits;
  Counter read_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_4),
    .value  (_read_pointer_value),
    .wrap   (/* unused */)
  );
  Counter write_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_0),
    .value  (_write_pointer_value),
    .wrap   (/* unused */)
  );
  always @(posedge clock) begin
    if (reset)
      occupancy <= 2'h0;
    else
      occupancy <=
        _GEN_0 ^ _GEN_4 ? (_GEN_0 ? occupancy + 2'h1 : occupancy - 2'h1) : occupancy;
  end // always @(posedge)
  assign ingress_out = '{ready: _GEN_3};
  assign egress_out = '{valid: (~_GEN_2), bits: storage[_read_pointer_value]};
  assign count = occupancy;
endmodule

module Counter(
  input  clock,
         reset,
         enable,
  output value,
         wrap
);

  reg state;
  always @(posedge clock) begin
    if (reset)
      state <= 1'h0;
    else
      state <= enable ? ~state & state - 1'h1 : state;
  end // always @(posedge)
  assign value = state;
  assign wrap = enable & state;
endmodule
}>>|

def chained_verilog_reference = @str|<<{
module CreditedChainedRoundTrip(
  input                                                  clock,
                                                         reset,
                                                         grant_enable,
  input  struct packed {logic valid; logic [7:0] bits; } ingress_in,
  input  struct packed {logic ready; }                   egress_in,
  output struct packed {logic ready; }                   ingress_out,
  output struct packed {logic valid; logic [7:0] bits; } egress_out
);

  wire struct packed {logic credit; } _credit_buffer_stage_link_out;
  wire struct packed {logic valid; logic [7:0] bits; } _credit_sender_stage_link_out;
  CreditSender credit_sender_stage (
    .clock        (clock),
    .reset        (reset),
    .ingress_in   (ingress_in),
    .link_in      (_credit_buffer_stage_link_out),
    .ingress_out  (ingress_out),
    .link_out     (_credit_sender_stage_link_out),
    .credit_count (/* unused */)
  );
  CreditBuffer credit_buffer_stage (
    .clock        (clock),
    .reset        (reset),
    .grant_enable (grant_enable),
    .link_in      (_credit_sender_stage_link_out),
    .egress_in    (egress_in),
    .link_out     (_credit_buffer_stage_link_out),
    .egress_out   (egress_out),
    .count        (/* unused */),
    .reserved     (/* unused */)
  );
endmodule

