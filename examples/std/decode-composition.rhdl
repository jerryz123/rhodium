#lang rhodium
// Demonstrates independently extending a typed decode relation along every table axis.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/decode.rhdl") open

bundle Opcode():
  major: Bits(3)
  minor: Bits(2)

// The final selector adds two fields around the original Opcode domain.
bundle Instruction():
  opcode: Opcode()
  vector_mode: Bool
  privileged: Bool

hardware_enum Operation:
  Add
  Sub
  Xor
  Multiply
  Branch

bundle ExecuteControl():
  operation: Operation
  subtract: Bool

bundle SideEffectControl():
  writeback: Bool
  redirect: Bool

bundle Control():
  execute: ExecuteControl()
  side_effect: SideEffectControl()

def add_opcode = pattern(Opcode()):
  major: bits(0, 3)
  minor: bits(0, 2)

def sub_opcode = pattern(Opcode()):
  major: bits(0, 3)
  minor: bits(1, 2)

def xor_opcode = pattern(Opcode()):
  major: bits(1, 3)
  minor: bits(0, 2)

def multiply_opcode = pattern(Opcode()):
  major: bits(2, 3)
  minor: bits(0, 2)

def branch_opcode = pattern(Opcode()):
  major: bits(3, 3)
  minor: bits(0, 2)

// Axis 1: add rows with ordinary host-list composition. The base relation can
// remain unchanged when an extension contributes more recognized operations.
def base_execute_cases = decode_groups(ExecuteControl()):
  [add_opcode]:
    operation: Operation.Add
    subtract: Bool(#false)

  [sub_opcode]:
    operation: Operation.Sub
    subtract: Bool(#true)

  [xor_opcode]:
    operation: Operation.Xor

def extension_execute_cases = decode_groups(ExecuteControl()):
  [multiply_opcode]:
    operation: Operation.Multiply

  [branch_opcode]:
    operation: Operation.Branch

def execute_cases = base_execute_cases ++ extension_execute_cases

// Axis 2: author new output fields as a separate relation. PatternSet provides
// reusable input-set algebra, and decode_groups expands its disjoint terms into
// ordinary DecodeCase rows before zip_decode_cases aligns them by input cube.
def non_branch_opcodes = pattern_set(
  multiply_opcode,
  xor_opcode,
  sub_opcode,
  add_opcode
)
def side_effect_cases = decode_groups(SideEffectControl()):
  [branch_opcode]:
    writeback: Bool(#false)
    redirect: Bool(#true)

  group non_branch_opcodes:
    writeback: Bool(#true)
    redirect: Bool(#false)

def control_cases = zip_decode_cases(
  execute_cases,
  side_effect_cases,
  fun (execute, side_effect):
    pattern(Control()):
      execute: execute
      side_effect: side_effect
)

// Axis 3: embed the completed opcode relation in a wider input domain. These
// operations are scalar-only, while privilege intentionally remains irrelevant.
def instruction_cases = lift_decode_inputs(
  control_cases,
  fun (opcode):
    partial_pattern(Instruction()):
      opcode: opcode
      vector_mode: Bool(#false)
)

def instruction_decode = ValidDecodeGen(instruction_cases)

circuit ComposedInstructionDecoder():
  input instruction: Instruction()
  output valid: Bool
  output control: Control()

  def decoded :: DecodeResult(Control()) = instruction_decode(instruction)
  valid <== decoded.valid
  control <== decoded.value

def design = elaborate(ComposedInstructionDecoder())

// This normalized reference is generated by CIRCT's ExportVerilog pipeline.
def verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhodium_types
`define _TYPESCOPE_rhodium_types
  typedef struct packed {logic [2:0] major; logic [1:0] minor; } Opcode;
  typedef struct packed {Opcode opcode; logic vector_mode; logic privileged; }
    Instruction;
  typedef struct packed {logic [2:0] operation; logic subtract; } ExecuteControl;
  typedef struct packed {logic writeback; logic redirect; } SideEffectControl;
  typedef struct packed {ExecuteControl execute; SideEffectControl side_effect; } Control;
  typedef struct packed {logic valid; Control value; } DecodeResult;
`endif // _TYPESCOPE_rhodium_types
module ComposedInstructionDecoder(
  input  Instruction instruction,
  output             valid,
  output Control     control
);

  logic [6:0]        __rhodium_decode_3_result;
  wire  [6:0]        _GEN = /*cast(bit[6:0])*/instruction;
  always_comb begin
    casez (_GEN)
      7'b000000z:
        __rhodium_decode_3_result = 7'h42;
      7'b000010z:
        __rhodium_decode_3_result = 7'h4E;
      7'b001000z:
        __rhodium_decode_3_result = {4'hA, 1'bx, 2'h2};
      7'b010000z:
        __rhodium_decode_3_result = {4'hB, 1'bx, 2'h2};
      7'b011000z:
        __rhodium_decode_3_result = {4'hC, 1'bx, 2'h1};
      default:
        __rhodium_decode_3_result = {1'h0, {6{1'bx}}};
    endcase
  end // always_comb
  wire  DecodeResult _GEN_0 = /*cast(bit)*/__rhodium_decode_3_result;
  assign valid = _GEN_0.valid;
  assign control = _GEN_0.value;
endmodule
}>>|

export:
  Opcode
  Instruction
  Operation
  ExecuteControl
  SideEffectControl
  Control
  add_opcode
  sub_opcode
  xor_opcode
  multiply_opcode
  branch_opcode
  base_execute_cases
  extension_execute_cases
  execute_cases
  non_branch_opcodes
  side_effect_cases
  control_cases
  instruction_cases
  instruction_decode
  ComposedInstructionDecoder
  design
  verilog_reference
