#lang rhodium
// Demonstrates ready-valid weakening plus principled control/payload routing.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("rhodium/std/ready-valid.rhdl") open

circuit ReadyValidCompatibility():
  input decoupled_payload: Bits(8)
  input irrevocable_payload: Bits(8)
  output decoupled_split_payload: Bits(8)
  output irrevocable_split_payload: Bits(8)

  // A persistent offer safely satisfies the weaker Decoupled contract.
  interface irrevocable_in(Irrevocable(Bits(8)), ~role: consumer)
  interface decoupled_out(Decoupled(Bits(8)), ~role: producer)
  decoupled_out <=> irrevocable_in

  // A control endpoint plus a payload destination splits a full protocol.
  interface decoupled_in(Decoupled(Bits(8)), ~role: consumer)
  interface decoupled_ctrl_out(DecoupledCtrl(), ~role: producer)
  decoupled_ctrl_out <=> (decoupled_in, decoupled_split_payload)

  interface irrevocable_data_in(Irrevocable(Bits(8)), ~role: consumer)
  interface irrevocable_ctrl_out(IrrevocableCtrl(), ~role: producer)
  irrevocable_ctrl_out <=> (
    irrevocable_data_in,
    ~bits: irrevocable_split_payload
  )

  // A control endpoint plus a payload source merges into the direct refinement.
  interface decoupled_ctrl_in(DecoupledCtrl(), ~role: consumer)
  interface decoupled_extended_out(Decoupled(Bits(8)), ~role: producer)
  decoupled_extended_out <=> (decoupled_ctrl_in, decoupled_payload)

  interface irrevocable_ctrl_in(IrrevocableCtrl(), ~role: consumer)
  interface irrevocable_extended_out(Irrevocable(Bits(8)), ~role: producer)
  irrevocable_extended_out <=> (
    irrevocable_ctrl_in,
    ~bits: irrevocable_payload
  )

def design = elaborate(ReadyValidCompatibility())

def verilog_reference = @str|<<{
module ReadyValidCompatibility(
  input  [7:0]                                           decoupled_payload,
                                                         irrevocable_payload,
  input  struct packed {logic valid; logic [7:0] bits; } irrevocable_in_in,
  input  struct packed {logic ready; }                   decoupled_out_in,
  input  struct packed {logic valid; logic [7:0] bits; } decoupled_in_in,
  input  struct packed {logic ready; }                   decoupled_ctrl_out_in,
  input  struct packed {logic valid; logic [7:0] bits; } irrevocable_data_in_in,
  input  struct packed {logic ready; }                   irrevocable_ctrl_out_in,
  input  struct packed {logic valid; }                   decoupled_ctrl_in_in,
  input  struct packed {logic ready; }                   decoupled_extended_out_in,
  input  struct packed {logic valid; }                   irrevocable_ctrl_in_in,
  input  struct packed {logic ready; }                   irrevocable_extended_out_in,
  output [7:0]                                           decoupled_split_payload,
                                                         irrevocable_split_payload,
  output struct packed {logic ready; }                   irrevocable_in_out,
  output struct packed {logic valid; logic [7:0] bits; } decoupled_out_out,
  output struct packed {logic ready; }                   decoupled_in_out,
  output struct packed {logic valid; }                   decoupled_ctrl_out_out,
  output struct packed {logic ready; }                   irrevocable_data_in_out,
  output struct packed {logic valid; }                   irrevocable_ctrl_out_out,
  output struct packed {logic ready; }                   decoupled_ctrl_in_out,
  output struct packed {logic valid; logic [7:0] bits; } decoupled_extended_out_out,
  output struct packed {logic ready; }                   irrevocable_ctrl_in_out,
  output struct packed {logic valid; logic [7:0] bits; } irrevocable_extended_out_out
);

  assign decoupled_split_payload = decoupled_in_in.bits;
  assign irrevocable_split_payload = irrevocable_data_in_in.bits;
  assign irrevocable_in_out = decoupled_out_in;
  assign decoupled_out_out = irrevocable_in_in;
  assign decoupled_in_out = decoupled_ctrl_out_in;
  assign decoupled_ctrl_out_out = '{valid: decoupled_in_in.valid};
  assign irrevocable_data_in_out = irrevocable_ctrl_out_in;
  assign irrevocable_ctrl_out_out = '{valid: irrevocable_data_in_in.valid};
  assign decoupled_ctrl_in_out = decoupled_extended_out_in;
  assign decoupled_extended_out_out =
    '{valid: decoupled_ctrl_in_in.valid, bits: decoupled_payload};
  assign irrevocable_ctrl_in_out = irrevocable_extended_out_in;
  assign irrevocable_extended_out_out =
    '{valid: irrevocable_ctrl_in_in.valid, bits: irrevocable_payload};
endmodule
}>>|

export:
  ReadyValidCompatibility
  design
  verilog_reference
