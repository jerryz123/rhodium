#lang rhodium
// Demonstrates primitive generators and composable ready-valid handle/sink topologies.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("flow/main.rhdl") open

bundle MappedByte():
  data: Bits(8)
  tag: Bits(4)

bundle TaggedByte():
  data: Bits(8)
  from_second: Bool

bundle RoutedByte():
  data: Bits(8)
  destination: Bool

circuit MapFlowExample():
  interface ingress(Decoupled(Bits(8)), ~role: consumer)
  input tag: Bits(4)
  interface egress(Decoupled(MappedByte()), ~role: producer)

  (
    ingress |> map_flow(payload):
      MappedByte():
        data: payload
        tag: tag
  ) |> egress

// Filtering consumes rejected offers, while gating leaves disabled offers
// pending. Both conservatively expose Decoupled outputs after inspecting live
// sidebands.
circuit FilterFlowExample():
  interface ingress(Irrevocable(Bits(8)), ~role: consumer)
  input keep: Bool
  interface egress(Decoupled(Bits(8)), ~role: producer)

  ingress |> filter_flow(payload => keep & or_reduce(payload)) |> egress

circuit GateFlowExample():
  interface ingress(Irrevocable(Bits(8)), ~role: consumer)
  input enabled: Bool
  interface egress(Decoupled(Bits(8)), ~role: producer)

  ingress |> gate_flow(enabled) |> egress

// With concrete endpoints on the left, each handle is applied immediately and
// the final value is the only still-unconnected endpoint.
sync_circuit EndpointFirstTopology():
  interface ingress[2](Decoupled(Bits(8)), ~role: consumer)
  interface egress(Irrevocable(Bits(8)), ~role: producer)

  ingress |> rr_arbiter() |> pipe(1) |> egress

// With types on the left, the same operations construct one reusable handle:
// independently tag two lanes, arbitrate and buffer, atomically fork the
// winner, then project its fields through independent output paths.
sync_circuit FanInProjectTopology():
  interface ingress[2](Decoupled(Bits(8)), ~role: consumer)
  interface data_egress(Irrevocable(Bits(8)), ~role: producer)
  interface origin_egress(Decoupled(Bool), ~role: producer)

  def data_path = TaggedByte()
                  |> map_flow(tagged => tagged.data)
                  |> pipe(1)
  def path:
    Array(Bits(8), Bits(8)) |> parallel(
      map_flow(payload):
        TaggedByte():
          data: payload
          from_second: Bool(#false),
      map_flow(payload):
        TaggedByte():
          data: payload
          from_second: Bool(#true)
    ) |> rr_arbiter()
      |> pipe(1)
      |> atomic_fork(2)
      |> parallel(
           data_path |> data_egress,
           (TaggedByte() |> map_flow(tagged => tagged.from_second))
             |> origin_egress
         )
  ingress |> path

// Array-shaped inputs can also rendezvous through a heterogeneous zip. The
// queue makes the offer irrevocable; the payload-only routing and projection
// stages explicitly preserve that contract.
sync_circuit ZipRouteTopology():
  interface data_ingress(Decoupled(Bits(8)), ~role: consumer)
  interface destination_ingress(Decoupled(Bool), ~role: consumer)
  interface egress[2](Irrevocable(Bits(8)), ~role: producer)

  def path:
    (
      Array(Bits(8), Bool) |> zip_flow(data, destination):
        RoutedByte():
          data: data
          destination: destination
    ) |> queue(2)
      |> demux_flow(2, ~stable: #true, routed => routed.destination)
      |> parallel(
           (Irrevocable(RoutedByte()) |> map_flow(~stable: #true, routed => routed.data))
             |> egress[0],
           (Irrevocable(RoutedByte()) |> map_flow(~stable: #true, routed => routed.data))
             |> egress[1]
         )
  Array(data_ingress, destination_ingress) |> path

def rr_arbiter_design = elaborate(RRArbiter(Bits(8), 3))
def demux_design = elaborate(Demux(Bits(8), 3))
def join_design = elaborate(Join(Bits(8), 3))
def broadcast_design = elaborate(Broadcast(Bits(8), 3))
def atomic_fork_design = elaborate(AtomicFork(Bits(8), 3))
def flow_map_design = elaborate(MapFlowExample())
def filter_flow_design = elaborate(FilterFlowExample())
def gate_flow_design = elaborate(GateFlowExample())
def endpoint_first_design = elaborate(EndpointFirstTopology())
def fan_in_project_design = elaborate(FanInProjectTopology())
def zip_route_design = elaborate(ZipRouteTopology())

def rr_arbiter_verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhodium_types
`define _TYPESCOPE_rhodium_types
  typedef struct packed {logic valid; logic [2:0] grant; logic [1:0] index; }
    CircularPriorityChoice;
`endif // _TYPESCOPE_rhodium_types
module RRArbiter(
  input                                                  clock,
                                                         reset,
  input  struct packed {logic valid; logic [7:0] bits; } ingress_0_in,
                                                         ingress_1_in,
                                                         ingress_2_in,
  input  struct packed {logic ready; }                   egress_in,
  output struct packed {logic ready; }                   ingress_0_out,
                                                         ingress_1_out,
                                                         ingress_2_out,
  output struct packed {logic valid; logic [7:0] bits; } egress_out,
  output [1:0]                                           chosen
);

  reg  [1:0] next_priority;
  wire       _GEN = next_priority != 2'h3;
  `ifndef SYNTHESIS
    rr_priority_in_range: assert property (@(posedge clock) disable iff (reset) _GEN);
  `endif // not def SYNTHESIS
  wire [2:0] _GEN_0 =
    {{ingress_2_in.valid & _GEN},
     {ingress_1_in.valid & ~(next_priority[1])},
     {ingress_0_in.valid & next_priority == 2'h0}};
  wire [2:0] _GEN_1 = {{ingress_2_in.valid}, {ingress_1_in.valid}, {ingress_0_in.valid}};
  wire [2:0] _GEN_2 =
    (|_GEN_0)
      ? _GEN_0 & {~(_GEN_0[1:0] | {_GEN_0[0], 1'h0}), 1'h1}
      : _GEN_1 & {~(_GEN_1[1:0] | {_GEN_1[0], 1'h0}), 1'h1};
  wire       _GEN_3 = |_GEN_2;
  always @(posedge clock) begin
    if (reset)
      next_priority <= 2'h0;
    else
      next_priority <=
        _GEN_3 & egress_in.ready
          ? (_GEN_2[2:1] == 2'h2 ? 2'h0 : _GEN_2[2:1] + 2'h1)
          : next_priority;
  end // always @(posedge)
  assign ingress_0_out = '{ready: (egress_in.ready & _GEN_2[0])};
  assign ingress_1_out = '{ready: (egress_in.ready & _GEN_2[1])};
  assign ingress_2_out = '{ready: (egress_in.ready & _GEN_2[2])};
  assign egress_out =
    '{valid: _GEN_3,
      bits:
        (ingress_0_in.bits & {8{_GEN_2[0]}} | ingress_1_in.bits & {8{_GEN_2[1]}}
         | ingress_2_in.bits & {8{_GEN_2[2]}} | ingress_0_in.bits & {8{_GEN_2 == 3'h0}})};
  assign chosen = _GEN_2[2:1];
endmodule
}>>|

def demux_verilog_reference = @str|<<{
module Demux(
  input  struct packed {logic valid; logic [7:0] bits; } ingress_in,
  input  [1:0]                                           select,
  input  struct packed {logic ready; }                   egress_0_in,
                                                         egress_1_in,
                                                         egress_2_in,
  output struct packed {logic ready; }                   ingress_out,
  output struct packed {logic valid; logic [7:0] bits; } egress_0_out,
                                                         egress_1_out,
                                                         egress_2_out
);

  wire _GEN = select == 2'h0;
  wire _GEN_0 = select == 2'h1;
  wire _GEN_1 = select == 2'h2;
  assign ingress_out =
    '{ready:
        (|({{_GEN_1 & egress_2_in.ready},
            {_GEN_0 & egress_1_in.ready},
            {_GEN & egress_0_in.ready}}))};
  assign egress_0_out = '{valid: (ingress_in.valid & _GEN), bits: ingress_in.bits};
  assign egress_1_out = '{valid: (ingress_in.valid & _GEN_0), bits: ingress_in.bits};
  assign egress_2_out = '{valid: (ingress_in.valid & _GEN_1), bits: ingress_in.bits};
endmodule
}>>|

def join_verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhodium_types
`define _TYPESCOPE_rhodium_types
  typedef struct packed {logic all; logic [2:0] except; } AndExclusionReduction;
`endif // _TYPESCOPE_rhodium_types
module Join(
  input  struct packed {logic valid; logic [7:0] bits; }      ingress_0_in,
                                                              ingress_1_in,
                                                              ingress_2_in,
  input  struct packed {logic ready; }                        egress_in,
  output struct packed {logic ready; }                        ingress_0_out,
                                                              ingress_1_out,
                                                              ingress_2_out,
  output struct packed {logic valid; logic [2:0][7:0] bits; } egress_out
);

  wire _GEN = ingress_0_in.valid & ingress_1_in.valid;
  assign ingress_0_out =
    '{ready: (egress_in.ready & ingress_2_in.valid & ingress_1_in.valid)};
  assign ingress_1_out =
    '{ready: (egress_in.ready & ingress_2_in.valid & ingress_0_in.valid)};
  assign ingress_2_out = '{ready: (egress_in.ready & _GEN)};
  assign egress_out =
    '{valid: (_GEN & ingress_2_in.valid),
      bits: ({{ingress_2_in.bits}, {ingress_1_in.bits}, {ingress_0_in.bits}})};
endmodule
}>>|

def broadcast_verilog_reference = @str|<<{
module Broadcast(
  input                                                  clock,
                                                         reset,
  input  struct packed {logic valid; logic [7:0] bits; } ingress_in,
  input  struct packed {logic ready; }                   egress_0_in,
                                                         egress_1_in,
                                                         egress_2_in,
  output struct packed {logic ready; }                   ingress_out,
  output struct packed {logic valid; logic [7:0] bits; } egress_0_out,
                                                         egress_1_out,
                                                         egress_2_out
);

  reg  [2:0] pending;
  reg  [7:0] payload;
  wire       _GEN =
    pending == 3'h0
    | (&({{~pending[2'h2] | egress_2_in.ready},
          {~pending[2'h1] | egress_1_in.ready},
          {~pending[2'h0] | egress_0_in.ready}}));
  wire       _GEN_0 = ingress_in.valid & _GEN;
  wire       _GEN_1 = _GEN_0 | ~(pending[2'h0] & egress_0_in.ready) & pending[2'h0];
  wire       _GEN_2 = _GEN_0 | ~(pending[2'h1] & egress_1_in.ready) & pending[2'h1];
  wire       _GEN_3 = _GEN_0 | ~(pending[2'h2] & egress_2_in.ready) & pending[2'h2];
  always @(posedge clock) begin
    if (reset)
      pending <= '{1'h0, 1'h0, 1'h0};
    else begin
      pending[2'h2] <= _GEN_3;
      pending[2'h1] <= _GEN_2;
      pending[2'h0] <= _GEN_1;
    end
  end // always @(posedge)
  always @(posedge clock)
    payload <= _GEN_0 ? ingress_in.bits : payload;
  assign ingress_out = '{ready: _GEN};
  assign egress_0_out = '{valid: pending[2'h0], bits: payload};
  assign egress_1_out = '{valid: pending[2'h1], bits: payload};
  assign egress_2_out = '{valid: pending[2'h2], bits: payload};
endmodule
}>>|

def atomic_fork_verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhodium_types
`define _TYPESCOPE_rhodium_types
  typedef struct packed {logic all; logic [2:0] except; } AndExclusionReduction;
`endif // _TYPESCOPE_rhodium_types
module AtomicFork(
  input  struct packed {logic valid; logic [7:0] bits; } ingress_in,
  input  struct packed {logic ready; }                   egress_0_in,
                                                         egress_1_in,
                                                         egress_2_in,
  output struct packed {logic ready; }                   ingress_out,
  output struct packed {logic valid; logic [7:0] bits; } egress_0_out,
                                                         egress_1_out,
                                                         egress_2_out
);

  wire _GEN = egress_0_in.ready & egress_1_in.ready;
  assign ingress_out = '{ready: (_GEN & egress_2_in.ready)};
  assign egress_0_out =
    '{valid: (ingress_in.valid & egress_2_in.ready & egress_1_in.ready),
      bits: ingress_in.bits};
  assign egress_1_out =
    '{valid: (ingress_in.valid & egress_2_in.ready & egress_0_in.ready),
      bits: ingress_in.bits};
  assign egress_2_out = '{valid: (ingress_in.valid & _GEN), bits: ingress_in.bits};
endmodule
}>>|

def flow_map_verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhodium_types
`define _TYPESCOPE_rhodium_types
  typedef struct packed {logic [7:0] data; logic [3:0] tag; } MappedByte;
`endif // _TYPESCOPE_rhodium_types
module MapFlowExample(
  input  struct packed {logic valid; logic [7:0] bits; } ingress_in,
  input  [3:0]                                           tag,
  input  struct packed {logic ready; }                   egress_in,
  output struct packed {logic ready; }                   ingress_out,
  output struct packed {logic valid; MappedByte bits; }  egress_out
);

  wire MappedByte _GEN = '{data: ingress_in.bits, tag: tag};
  assign ingress_out = egress_in;
  assign egress_out = '{valid: ingress_in.valid, bits: _GEN};
endmodule
}>>|

def filter_flow_verilog_reference = @str|<<{
module FilterFlowExample(
  input  struct packed {logic valid; logic [7:0] bits; } ingress_in,
  input                                                  keep,
  input  struct packed {logic ready; }                   egress_in,
  output struct packed {logic ready; }                   ingress_out,
  output struct packed {logic valid; logic [7:0] bits; } egress_out
);

  wire _GEN = keep & (|ingress_in.bits);
  assign ingress_out = '{ready: (~_GEN | egress_in.ready)};
  assign egress_out = '{valid: (ingress_in.valid & _GEN), bits: ingress_in.bits};
endmodule
}>>|
def gate_flow_verilog_reference = @str|<<{
module GateFlowExample(
  input  struct packed {logic valid; logic [7:0] bits; } ingress_in,
  input                                                  enabled,
  input  struct packed {logic ready; }                   egress_in,
  output struct packed {logic ready; }                   ingress_out,
  output struct packed {logic valid; logic [7:0] bits; } egress_out
);

  assign ingress_out = '{ready: (egress_in.ready & enabled)};
  assign egress_out = '{valid: (ingress_in.valid & enabled), bits: ingress_in.bits};
endmodule
}>>|
def endpoint_first_verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhodium_types
`define _TYPESCOPE_rhodium_types
  typedef struct packed {logic valid; logic [1:0] grant; logic index; }
    CircularPriorityChoice;
`endif // _TYPESCOPE_rhodium_types
module EndpointFirstTopology(
  input                                                  clock,
                                                         reset,
  input  struct packed {logic valid; logic [7:0] bits; } ingress_0_in,
                                                         ingress_1_in,
  input  struct packed {logic ready; }                   egress_in,
  output struct packed {logic ready; }                   ingress_0_out,
                                                         ingress_1_out,
  output struct packed {logic valid; logic [7:0] bits; } egress_out
);

  wire struct packed {logic ready; } _pipe_stage_ingress_out;
  wire struct packed {logic valid; logic [7:0] bits; } _arbiter_stage_egress_out;
  RRArbiter arbiter_stage (
    .clock         (clock),
    .reset         (reset),
    .ingress_0_in  (ingress_0_in),
    .ingress_1_in  (ingress_1_in),
    .egress_in     (_pipe_stage_ingress_out),
    .ingress_0_out (ingress_0_out),
    .ingress_1_out (ingress_1_out),
    .egress_out    (_arbiter_stage_egress_out),
    .chosen        (/* unused */)
  );
  Pipe pipe_stage (
    .clock       (clock),
    .reset       (reset),
    .ingress_in  (_arbiter_stage_egress_out),
    .egress_in   (egress_in),
    .ingress_out (_pipe_stage_ingress_out),
    .egress_out  (egress_out)
  );
endmodule

module RRArbiter(
  input                                                  clock,
                                                         reset,
  input  struct packed {logic valid; logic [7:0] bits; } ingress_0_in,
                                                         ingress_1_in,
  input  struct packed {logic ready; }                   egress_in,
  output struct packed {logic ready; }                   ingress_0_out,
                                                         ingress_1_out,
  output struct packed {logic valid; logic [7:0] bits; } egress_out,
  output                                                 chosen
);

  reg        next_priority;
  wire [1:0] _GEN = {{ingress_1_in.valid}, {ingress_0_in.valid & ~next_priority}};
  wire [1:0] _GEN_0 = {{ingress_1_in.valid}, {ingress_0_in.valid}};
  wire [1:0] _GEN_1 = (|_GEN) ? _GEN & {~(_GEN[0]), 1'h1} : _GEN_0 & {~(_GEN_0[0]), 1'h1};
  wire       _GEN_2 = |_GEN_1;
  always @(posedge clock) begin
    if (reset)
      next_priority <= 1'h0;
    else
      next_priority <=
        _GEN_2 & egress_in.ready ? ~(_GEN_1[1]) & _GEN_1[1] - 1'h1 : next_priority;
  end // always @(posedge)
  assign ingress_0_out = '{ready: (egress_in.ready & _GEN_1[0])};
  assign ingress_1_out = '{ready: (egress_in.ready & _GEN_1[1])};
  assign egress_out =
    '{valid: _GEN_2,
      bits:
        (ingress_0_in.bits & {8{_GEN_1[0]}} | ingress_1_in.bits & {8{_GEN_1[1]}}
         | ingress_0_in.bits & {8{_GEN_1 == 2'h0}})};
  assign chosen = _GEN_1[1];
endmodule

module Pipe(
  input                                                  clock,
                                                         reset,
  input  struct packed {logic valid; logic [7:0] bits; } ingress_in,
  input  struct packed {logic ready; }                   egress_in,
  output struct packed {logic ready; }                   ingress_out,
  output struct packed {logic valid; logic [7:0] bits; } egress_out
);

  reg  [0:0]      stage_valid;
  reg  [0:0][7:0] stage_bits;
  wire            _GEN = ~stage_valid[1'h0] | egress_in.ready;
  wire            _GEN_0 = _GEN ? ingress_in.valid : stage_valid[1'h0];
  wire [7:0]      _GEN_1 =
    _GEN ? (ingress_in.valid ? ingress_in.bits : stage_bits[1'h0]) : stage_bits[1'h0];
  always @(posedge clock) begin
    if (reset)
      stage_valid <= '{1'h0};
    else
      stage_valid[1'h0] <= _GEN_0;
  end // always @(posedge)
  always @(posedge clock)
    stage_bits[1'h0] <= _GEN_1;
  assign ingress_out = '{ready: _GEN};
  assign egress_out = '{valid: stage_valid[1'h0], bits: stage_bits[1'h0]};
endmodule
}>>|
def fan_in_project_verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhodium_types
`define _TYPESCOPE_rhodium_types
  typedef struct packed {logic [7:0] data; logic from_second; } TaggedByte;
  typedef struct packed {logic valid; logic [1:0] grant; logic index; }
    CircularPriorityChoice;
  typedef struct packed {logic all; logic [1:0] except; } AndExclusionReduction;
`endif // _TYPESCOPE_rhodium_types
module FanInProjectTopology(
  input                                                  clock,
                                                         reset,
  input  struct packed {logic valid; logic [7:0] bits; } ingress_0_in,
                                                         ingress_1_in,
  input  struct packed {logic ready; }                   data_egress_in,
                                                         origin_egress_in,
  output struct packed {logic ready; }                   ingress_0_out,
                                                         ingress_1_out,
  output struct packed {logic valid; logic [7:0] bits; } data_egress_out,
  output struct packed {logic valid; logic bits; }       origin_egress_out
);

  wire struct packed {logic ready; } _fork_stage_ingress_out;
  wire struct packed {logic valid; TaggedByte bits; } _fork_stage_egress_0_out;
  wire struct packed {logic valid; TaggedByte bits; } _fork_stage_egress_1_out;
  wire struct packed {logic ready; } _pipe_stage_1_ingress_out;
  wire struct packed {logic valid; TaggedByte bits; } _pipe_stage_1_egress_out;
  wire struct packed {logic valid; TaggedByte bits; } _arbiter_stage_egress_out;
  wire struct packed {logic ready; } _pipe_stage_ingress_out;
  wire TaggedByte                    _GEN =
    '{data: ingress_0_in.bits, from_second: (1'h0)};
  wire TaggedByte                    _GEN_0 =
    '{data: ingress_1_in.bits, from_second: (1'h1)};
  wire struct packed {logic valid; TaggedByte bits; } _GEN_1 =
    '{valid: ingress_1_in.valid, bits: _GEN_0};
  wire struct packed {logic valid; TaggedByte bits; } _GEN_2 =
    '{valid: ingress_0_in.valid, bits: _GEN};
  wire struct packed {logic valid; logic [7:0] bits; } _GEN_3 =
    '{valid: _fork_stage_egress_0_out.valid, bits: _fork_stage_egress_0_out.bits.data};
  Pipe pipe_stage (
    .clock       (clock),
    .reset       (reset),
    .ingress_in  (_GEN_3),
    .egress_in   (data_egress_in),
    .ingress_out (_pipe_stage_ingress_out),
    .egress_out  (data_egress_out)
  );
  RRArbiter arbiter_stage (
    .clock         (clock),
    .reset         (reset),
    .ingress_0_in  (_GEN_2),
    .ingress_1_in  (_GEN_1),
    .egress_in     (_pipe_stage_1_ingress_out),
    .ingress_0_out (ingress_0_out),
    .ingress_1_out (ingress_1_out),
    .egress_out    (_arbiter_stage_egress_out),
    .chosen        (/* unused */)
  );
  Pipe_1 pipe_stage_1 (
    .clock       (clock),
    .reset       (reset),
    .ingress_in  (_arbiter_stage_egress_out),
    .egress_in   (_fork_stage_ingress_out),
    .ingress_out (_pipe_stage_1_ingress_out),
    .egress_out  (_pipe_stage_1_egress_out)
  );
  AtomicFork fork_stage (
    .ingress_in   (_pipe_stage_1_egress_out),
    .egress_0_in  (_pipe_stage_ingress_out),
    .egress_1_in  (origin_egress_in),
    .ingress_out  (_fork_stage_ingress_out),
    .egress_0_out (_fork_stage_egress_0_out),
    .egress_1_out (_fork_stage_egress_1_out)
  );
  assign origin_egress_out =
    '{valid: _fork_stage_egress_1_out.valid,
      bits: _fork_stage_egress_1_out.bits.from_second};
endmodule

module Pipe(
  input                                                  clock,
                                                         reset,
  input  struct packed {logic valid; logic [7:0] bits; } ingress_in,
  input  struct packed {logic ready; }                   egress_in,
  output struct packed {logic ready; }                   ingress_out,
  output struct packed {logic valid; logic [7:0] bits; } egress_out
);

  reg  [0:0]      stage_valid;
  reg  [0:0][7:0] stage_bits;
  wire            _GEN = ~stage_valid[1'h0] | egress_in.ready;
  wire            _GEN_0 = _GEN ? ingress_in.valid : stage_valid[1'h0];
  wire [7:0]      _GEN_1 =
    _GEN ? (ingress_in.valid ? ingress_in.bits : stage_bits[1'h0]) : stage_bits[1'h0];
  always @(posedge clock) begin
    if (reset)
      stage_valid <= '{1'h0};
    else
      stage_valid[1'h0] <= _GEN_0;
  end // always @(posedge)
  always @(posedge clock)
    stage_bits[1'h0] <= _GEN_1;
  assign ingress_out = '{ready: _GEN};
  assign egress_out = '{valid: stage_valid[1'h0], bits: stage_bits[1'h0]};
endmodule

module RRArbiter(
  input                                                 clock,
                                                        reset,
  input  struct packed {logic valid; TaggedByte bits; } ingress_0_in,
                                                        ingress_1_in,
  input  struct packed {logic ready; }                  egress_in,
  output struct packed {logic ready; }                  ingress_0_out,
                                                        ingress_1_out,
  output struct packed {logic valid; TaggedByte bits; } egress_out,
  output                                                chosen
);

  reg             next_priority;
  wire [1:0]      _GEN = {{ingress_1_in.valid}, {ingress_0_in.valid & ~next_priority}};
  wire [1:0]      _GEN_0 = {{ingress_1_in.valid}, {ingress_0_in.valid}};
  wire [1:0]      _GEN_1 =
    (|_GEN) ? _GEN & {~(_GEN[0]), 1'h1} : _GEN_0 & {~(_GEN_0[0]), 1'h1};
  wire            _GEN_2 = |_GEN_1;
  wire [8:0]      _GEN_3 = /*cast(bit[8:0])*/ingress_0_in.bits;
  wire [8:0]      _GEN_4 = /*cast(bit[8:0])*/ingress_1_in.bits;
  wire TaggedByte _GEN_5 =
    /*cast(bit)*/_GEN_3 & {9{_GEN_1[0]}} | _GEN_4 & {9{_GEN_1[1]}} | _GEN_3
    & {9{_GEN_1 == 2'h0}};
  always @(posedge clock) begin
    if (reset)
      next_priority <= 1'h0;
    else
      next_priority <=
        _GEN_2 & egress_in.ready ? ~(_GEN_1[1]) & _GEN_1[1] - 1'h1 : next_priority;
  end // always @(posedge)
  assign ingress_0_out = '{ready: (egress_in.ready & _GEN_1[0])};
  assign ingress_1_out = '{ready: (egress_in.ready & _GEN_1[1])};
  assign egress_out = '{valid: _GEN_2, bits: _GEN_5};
  assign chosen = _GEN_1[1];
endmodule

module Pipe_1(
  input                                                 clock,
                                                        reset,
  input  struct packed {logic valid; TaggedByte bits; } ingress_in,
  input  struct packed {logic ready; }                  egress_in,
  output struct packed {logic ready; }                  ingress_out,
  output struct packed {logic valid; TaggedByte bits; } egress_out
);

  reg  [0:0]           stage_valid;
  TaggedByte[0:0]      stage_bits;
  wire                 _GEN = ~stage_valid[1'h0] | egress_in.ready;
  wire                 _GEN_0 = _GEN ? ingress_in.valid : stage_valid[1'h0];
  wire TaggedByte      _GEN_1 =
    _GEN ? (ingress_in.valid ? ingress_in.bits : stage_bits[1'h0]) : stage_bits[1'h0];
  always @(posedge clock) begin
    if (reset)
      stage_valid <= '{1'h0};
    else
      stage_valid[1'h0] <= _GEN_0;
  end // always @(posedge)
  always @(posedge clock)
    stage_bits[1'h0] <= _GEN_1;
  assign ingress_out = '{ready: _GEN};
  assign egress_out = '{valid: stage_valid[1'h0], bits: stage_bits[1'h0]};
endmodule

module AtomicFork(
  input  struct packed {logic valid; TaggedByte bits; } ingress_in,
  input  struct packed {logic ready; }                  egress_0_in,
                                                        egress_1_in,
  output struct packed {logic ready; }                  ingress_out,
  output struct packed {logic valid; TaggedByte bits; } egress_0_out,
                                                        egress_1_out
);

  assign ingress_out = '{ready: (egress_0_in.ready & egress_1_in.ready)};
  assign egress_0_out =
    '{valid: (ingress_in.valid & egress_1_in.ready), bits: ingress_in.bits};
  assign egress_1_out =
    '{valid: (ingress_in.valid & egress_0_in.ready), bits: ingress_in.bits};
endmodule
}>>|
def zip_route_verilog_reference = @str|<<{
`ifndef _TYPESCOPE_rhodium_types
`define _TYPESCOPE_rhodium_types
  typedef struct packed {logic [7:0] data; logic destination; } RoutedByte;
`endif // _TYPESCOPE_rhodium_types
module ZipRouteTopology(
  input                                                  clock,
                                                         reset,
  input  struct packed {logic valid; logic [7:0] bits; } data_ingress_in,
  input  struct packed {logic valid; logic bits; }       destination_ingress_in,
  input  struct packed {logic ready; }                   egress_0_in,
                                                         egress_1_in,
  output struct packed {logic ready; }                   data_ingress_out,
                                                         destination_ingress_out,
  output struct packed {logic valid; logic [7:0] bits; } egress_0_out,
                                                         egress_1_out
);

  wire                               _GEN;
  wire                               _GEN_0;
  wire struct packed {logic ready; } _queue_stage_ingress_out;
  wire struct packed {logic valid; RoutedByte bits; } _queue_stage_egress_out;
  wire RoutedByte                    _GEN_1 =
    '{data: data_ingress_in.bits, destination: destination_ingress_in.bits};
  assign _GEN_0 = egress_0_in.ready;
  assign _GEN = egress_1_in.ready;
  wire struct packed {logic ready; } _GEN_2 =
    '{ready:
        (|({{_queue_stage_egress_out.bits.destination & _GEN},
            {~_queue_stage_egress_out.bits.destination & _GEN_0}}))};
  wire struct packed {logic valid; RoutedByte bits; } _GEN_3 =
    '{valid: (data_ingress_in.valid & destination_ingress_in.valid), bits: _GEN_1};
  Queue queue_stage (
    .clock       (clock),
    .reset       (reset),
    .ingress_in  (_GEN_3),
    .egress_in   (_GEN_2),
    .ingress_out (_queue_stage_ingress_out),
    .egress_out  (_queue_stage_egress_out),
    .count       (/* unused */)
  );
  assign data_ingress_out =
    '{ready: (_queue_stage_ingress_out.ready & destination_ingress_in.valid)};
  assign destination_ingress_out =
    '{ready: (_queue_stage_ingress_out.ready & data_ingress_in.valid)};
  assign egress_0_out =
    '{valid: (_queue_stage_egress_out.valid & ~_queue_stage_egress_out.bits.destination),
      bits: _queue_stage_egress_out.bits.data};
  assign egress_1_out =
    '{valid: (_queue_stage_egress_out.valid & _queue_stage_egress_out.bits.destination),
      bits: _queue_stage_egress_out.bits.data};
endmodule

module Queue(
  input                                                 clock,
                                                        reset,
  input  struct packed {logic valid; RoutedByte bits; } ingress_in,
  input  struct packed {logic ready; }                  egress_in,
  output struct packed {logic ready; }                  ingress_out,
  output struct packed {logic valid; RoutedByte bits; } egress_out,
  output [1:0]                                          count
);

  wire RoutedByte _GEN;
  wire            _GEN_0;
  wire            _write_pointer_value;
  wire            _read_pointer_value;
  wire            _GEN_1 = 1'h0;
  RoutedByte      storage[0:1];
  always_ff @(posedge clock) begin
    if (_GEN_1) begin
    end
    else begin
      if (_GEN_0)
        storage[_write_pointer_value] <= _GEN;
    end
  end // always_ff @(posedge)
  reg  [1:0]      occupancy;
  wire            _GEN_2 = occupancy == 2'h0;
  `ifndef SYNTHESIS
    queue_occupancy_in_range:
      assert property (@(posedge clock) disable iff (reset) occupancy != 2'h3);
  `endif // not def SYNTHESIS
  wire            _GEN_3 = occupancy != 2'h2;
  assign _GEN_0 = ingress_in.valid & _GEN_3;
  wire            _GEN_4 = ~_GEN_2 & egress_in.ready;
  assign _GEN = ingress_in.bits;
  Counter read_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_4),
    .value  (_read_pointer_value),
    .wrap   (/* unused */)
  );
  Counter write_pointer (
    .clock  (clock),
    .reset  (reset),
    .enable (_GEN_0),
    .value  (_write_pointer_value),
    .wrap   (/* unused */)
  );
  always @(posedge clock) begin
    if (reset)
      occupancy <= 2'h0;
    else
      occupancy <=
        _GEN_0 ^ _GEN_4 ? (_GEN_0 ? occupancy + 2'h1 : occupancy - 2'h1) : occupancy;
  end // always @(posedge)
  assign ingress_out = '{ready: _GEN_3};
  assign egress_out = '{valid: (~_GEN_2), bits: storage[_read_pointer_value]};
  assign count = occupancy;
endmodule

module Counter(
  input  clock,
         reset,
         enable,
  output value,
         wrap
);

  reg state;
  always @(posedge clock) begin
    if (reset)
      state <= 1'h0;
    else
      state <= enable ? ~state & state - 1'h1 : state;
  end // always @(posedge)
  assign value = state;
  assign wrap = enable & state;
endmodule
}>>|

