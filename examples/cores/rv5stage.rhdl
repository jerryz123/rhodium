#lang rhodium
// Materializes a complete compressed RV64 RV5Stage processor with private instruction and data caches.

import:
  lib("cores/rv5stage/rv5stage.rhdl") open
  lib("cores/rv5stage/chi/foundation.rhdl") open
  lib("cores/rv5stage/profile.rhm") open
  lib("chi/main.rhdl") open
  lib("riscv/isa/c.rhm") open
  lib("riscv/isa/xlen.rhm") open
  lib("riscv/rtl/pma.rhdl") open

def example_flit = CHIFlitParams()
def example_home = CHIHomeParams("example-home", 1, CHINodeKind.HNF, ~max_outstanding: 2)
def example_memory_attributes = RiscvPhysicalMemoryAttributes(#true, #true, #true, #true, #true, #false, #true, ~cache_block_zero: #true)
def example_chi_config = RV5StageCHIConfig(
  example_flit,
  [RV5StageCHIRegion(
     RiscvPhysicalMemoryRegion(
       AddressSet(0, (1 << example_flit.request_address_width) - 1),
       example_memory_attributes
     ),
     example_home
   )]
)
def example_profile = RVCoreProfile(
  ~xlen: XLen.X64,
  ~extensions: RV5StageExtensions(
    ~compressed: compressed_extensions(CompressedExtension.Zca, CompressedExtension.Zcb)
  ),
  ~mmu_mode: RV5StageMmuMode.Sv39
)
def design = elaborate(RV5Stage(example_profile, ~chi: example_chi_config, ~reset_address: 0))

export:
  design
