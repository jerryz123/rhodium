#lang rhodium
// Demonstrates RV64I instruction decoding connected directly to the reusable ALU.
// SPDX-License-Identifier: Apache-2.0

import:
  lib("cores/alu.rhdl") open
  lib("cores/rv5stage/decode/alu-ctrl.rhdl") open
  lib("riscv/isa/xlen.rhm") open

circuit DecodedALU():
  input instruction: Bits(32)
  input(left, right): Bits(64)
  output valid: Bool
  output result: Bits(64)

  inst decoder(RV64IAluInstructionDecoder())
  inst alu(ALU(XLen.X64))
  decoder.instruction <== instruction
  alu.left <== left
  alu.right <== right
  alu.control <== decoder.control
  valid <== decoder.valid
  result <== alu.result

def design = elaborate(DecodedALU())

export:
  DecodedALU
  design
